// Module platform (package store): the platform host (docs/spec/launch.md "The platform
// host", RUNNER-SPEC §14). The catalog is tables of the host's own store. Every decision
// commits and is durable before the host sends the launcher a request for it (§14.1), so
// the host's step functions return the requests that the commit allows, in order.
//
// The host keeps in memory only what it can rebuild after a restart: the outstanding
// serving launch of each live group, a cutover in progress, backoff, and the queue of wakes
// that found no slot (§14.3 "Queued wakes", §14.5).
pub type Wake: codec + send = Dirty(u64) | Clean(Option[u64])

pub type WakeRow: codec + send {
    wake: Wake,
    gen: u64
}

pub type Author: codec + send = Trusted | Untrusted

pub type Disposition: codec + send = Keep | Delete

pub type GroupRow: codec + send {
    tenant: String,
    workdir: String,
    author: Author,
    label: launcher.Label,
    listen: String,
    bindings: launcher.Bindings,
    limits: launcher.Limits,
    assembly: Bytes,
    activation: u64,
    retained: List[Bytes],
    incarnation: u64,
    retiring: Option[Disposition],
}

// Which of an Undecided deploy's two recorded pairs the group's next probe opens: NEW's
// assembly at the deploy's activation first, OLD's after NEW was answered `PlaceCurrent`
// naming OLD's activation (launch.md "When the host starts").
pub type Probe: codec + send = ProbeNew | ProbeOld

pub type DeployOutcome: codec + send = Preparing | Pending | Installed | Failed(String) | Undecided(Probe)

// A deploy attempt's record (launch.md "Hot deploy"). `Preparing` is durable before any
// helper child or export command: it names NEW's assembly and image digest and OLD's gen,
// and proves no cutover was sent. `Pending` replaces it in one transaction once OLD kept
// the import, before the candidate's Start and the cutover command: it adds the activation
// `activation` (the export's head + 1), the prepared digest `digest` the cutover names, the
// release the preview reported, and the candidate's gen. A new session re-sends exactly
// that command (§14.5).
pub type DeployRow: codec + send {
    attempt: launcher.Attempt,
    assembly: Bytes,
    image: Bytes,
    digest: Bytes,
    release: Bytes,
    activation: u64,
    old: u64,
    candidate: u64,
    outcome: DeployOutcome,
}

// A recording pin (launch.md "Host assembly"): the assembly record a recorded serving
// process ran, kept as a root until `expires`, in Unix seconds. Keyed by the 16-byte
// recording ID that the tape's Run routing block names.
pub type Pin: codec + send {
    assembly: Bytes,
    expires: u64
}

// What a pin lookup finds. An absent pin and an expired one are both `Gone`.
pub type Resolved: codec + send = Found(Bytes) | Gone

pub type Quota: codec + send {
    groups: u64,
    live: u64
}

type Usage: codec + send {
    groups: u64,
    live: u64
}

pub type Config: codec + send {
    max_places: u64,
    idle_ms: u64
}

type Meta: codec + send {
    dirty: u64,
    next_incarnation: u64
}

type DueKey {
    at: u64,
    name: String
}

// What a retirement left behind (§14.5 step 3).
pub type Retired: codec + send {
    workdir: String,
    disposition: Disposition
}

pub type Limit: send = Count(u64) | Live(String, u64) | Groups(String, u64)

pub type Refused: send = Full(Limit) | Busy(u64) | Unknown | Exists | Retiring | Missing(String) | Denied(String) | Store(store.Error)

// Wall time for the due index, monotonic time for backoff and the Ready reset.
pub type Now: send {
    wall_ms: u64,
    mono_ns: u64
}

pub type Timers: send {
    wall_ms: Option[u64],
    mono_ns: Option[u64]
}

pub type NewGroup: send {
    name: String,
    tenant: String,
    workdir: String,
    author: Author,
    label: launcher.Label,
    listen: String,
    bindings: launcher.Bindings,
    limits: launcher.Limits,
    assembly: Bytes,
    activation: u64,
}

pub type Queued: send {
    name: String,
    since: u64
}

pub type Failing: send {
    name: String,
    count: u64,
    retry_at: Option[u64],
    last: String
}

pub type Status: send {
    dirty: u64,
    max_places: u64,
    probes: u64,
    due_wakes: u64,
    arrival_wakes: u64,
    queued: List[Queued],
    failing: List[Failing],
}

type Tables {
    groups: store.Table[String, GroupRow],
    wake: store.Table[String, WakeRow],
    dirty: store.Table[String, u64],
    due: store.Table[DueKey, u8],
    deploys: store.Table[String, DeployRow],
    pins: store.Table[Bytes, Pin],
    quotas: store.Table[String, Quota],
    usage: store.Table[String, Usage],
    config: store.Table[u64, Config],
    meta: store.Table[u64, Meta],
    retired: store.Table[String, Retired],
}

type Phase = Requested | Started | Ready(u64)

type Run {
    gen: u64,
    phase: Phase
}

type Cut {
    attempt: launcher.Attempt,
    incarnation: u64,
    old: u64,
    candidate: u64,
    activation: u64,
    old_end: Option[launcher.End],
    old_ended: bool,
    opened: bool,
    candidate_end: Option[launcher.End],
    // The launcher holds OLD's answer to this attempt's cutover (§14.5): until it returns
    // it, ends are recorded and not acknowledged, and they decide nothing.
    held: bool,
    // The release the preview reported for NEW: the candidate's open must report it.
    release: Bytes,
}

// What a Preparing deploy waits on (launch.md "Hot deploy"): OLD's describe child, NEW's
// preview child over OLD's exported list (with that list's length), OLD's export, NEW's
// prepare child on export `head`, OLD's import of it; or, after a failure, OLD's abort and
// the helper's end, before `Failed(why)` is committed.
type Stage = Describing | Previewing(u64) | Exporting | PrepareRunning(u64) | Importing(u64) | Aborting(String)

type Prep {
    attempt: launcher.Attempt,
    incarnation: u64,
    old: u64,
    assembly: Bytes,
    image: Bytes,
    target: String,
    n_place: u64,
    stage: Stage,
    // NEW's exact Describe bytes and release, from the preview's answer.
    describe: Bytes,
    release: Bytes,
    // The helper child of this attempt that has not ended.
    helper: Option[launcher.Child],
    // OLD was sent HostAbort and has neither answered PlaceAborted nor ended.
    aborting: bool,
}

// Where a deploy's admission stands (launch.md "The launcher", "Publish and assemble"):
// the verifier's Need parts so far and whether the last came, the approval text the
// operator must confirm, the image being assembled, the launcher's failure with its
// payload, or the host's own policy refusal.
pub type AdmitStage: codec + send = Uploading(List[launcher.Wanted], bool) | Confirming(String) | Assembling | Unadmitted(launcher.Failure) | Rejected(String)

type Admitting {
    attempt: launcher.Attempt,
    incarnation: u64,
    // The operator approved a grant OLD's recipe lacks.
    grant_added: bool,
    stage: AdmitStage,
    // The verified recipe's summary, from `Admitted`.
    summary: Option[launcher.Summary],
}

type Vol {
    run: Option[Run],
    cut: Option[Cut],
    count: u64,
    retry_at: Option[u64],
    failing: bool,
    last: String,
    // The probe was answered with the other pair's activation: its end starts the next
    // probe at once, outside backoff.
    reprobe: bool,
    prep: Option[Prep],
    admit: Option[Admitting]
}

// A collection the host runs (launch.md "Collect"): asked for and not yet fenced, or
// fenced with its roots unread because the catalog snapshot could not be read. Such a
// collection removes nothing, and its fence ends with the launcher session.
type Collecting = Unfenced | Fencing | FenceStuck(String)

pub opaque type Host {
    db: store.Db,
    t: Tables,
    vol: Map[String, Vol],
    queue: List[Queued],
    probes: u64,
    due_wakes: u64,
    arrival_wakes: u64,
    binds_sent: bool,
    collecting: Collecting,
}

const READY_RESET_NS: u64 = 300000000000u64

const BACKOFF_FIRST_NS: u64 = 1000000000u64

const BACKOFF_MAX_NS: u64 = 300000000000u64

const CUTOVER_PAUSE_MS: u64 = 2000u64

fn put_due(k: DueKey, mut out: Bytes) {
    std.codec.put_key_u64(k.at, mut out)
    std.codec.put_key_string(k.name, mut out)
}

fn take_due(raw: Bytes, mut at: u64) -> Result[DueKey, std.codec.DecodeError] {
    let t = std.codec.take_key_u64(raw, mut at)?
    let name = std.codec.take_key_string(raw, mut at)?
    Ok(DueKey(at: t, name: take name))
}

fn due_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 2u64)?
    std.codec.schema_u64(mut s)
    std.codec.schema_string(mut s)
    Ok(())
}

fn due_key() -> std.codec.Key[DueKey] {
    std.codec.key_make(put_due, take_due, due_schema)
}

fn created(take r: Result[store.Ticket, store.Error]) -> Result[(), store.Error] {
    match take r {
        Ok(_) => Ok(()),
        Error(Exists(_)) => Ok(()),
        Error(take e) => Error(take e)
    }
}

fn make_tables(mut db: store.Db) -> Result[Tables, store.Error] waits {
    let groups: std.codec.Codec[GroupRow] = std.codec.of()
    let wake_codec: std.codec.Codec[WakeRow] = std.codec.of()
    let deploys: std.codec.Codec[DeployRow] = std.codec.of()
    let quotas: std.codec.Codec[Quota] = std.codec.of()
    let usage: std.codec.Codec[Usage] = std.codec.of()
    let config_codec: std.codec.Codec[Config] = std.codec.of()
    let meta: std.codec.Codec[Meta] = std.codec.of()
    let retired: std.codec.Codec[Retired] = std.codec.of()
    let pins: std.codec.Codec[Pin] = std.codec.of()
    created(store.create_table(mut db, store.spec("platform.groups", std.codec.key_string(), groups)))?
    created(store.create_table(mut db, store.spec("platform.wake", std.codec.key_string(), wake_codec)))?
    created(store.create_table(mut db, store.spec("platform.dirty", std.codec.key_string(), std.codec.of_u64())))?
    created(store.create_table(mut db, store.spec("platform.due", due_key(), std.codec.of_u8())))?
    created(store.create_table(mut db, store.spec("platform.deploys", std.codec.key_string(), deploys)))?
    created(store.create_table(mut db, store.spec("platform.pins", std.codec.key_bytes(), pins)))?
    created(store.create_table(mut db, store.spec("platform.quotas", std.codec.key_string(), quotas)))?
    created(store.create_table(mut db, store.spec("platform.usage", std.codec.key_string(), usage)))?
    created(store.create_table(mut db, store.spec("platform.config", std.codec.key_u64(), config_codec)))?
    created(store.create_table(mut db, store.spec("platform.meta", std.codec.key_u64(), meta)))?
    created(store.create_table(mut db, store.spec("platform.retired", std.codec.key_string(), retired)))?
    Ok(Tables(
        groups: store.table(mut db, "platform.groups", std.codec.key_string(), std.codec.of())?,
        wake: store.table(mut db, "platform.wake", std.codec.key_string(), std.codec.of())?,
        dirty: store.table(mut db, "platform.dirty", std.codec.key_string(), std.codec.of_u64())?,
        due: store.table(mut db, "platform.due", due_key(), std.codec.of_u8())?,
        deploys: store.table(mut db, "platform.deploys", std.codec.key_string(), std.codec.of())?,
        pins: store.table(mut db, "platform.pins", std.codec.key_bytes(), std.codec.of())?,
        quotas: store.table(mut db, "platform.quotas", std.codec.key_string(), std.codec.of())?,
        usage: store.table(mut db, "platform.usage", std.codec.key_string(), std.codec.of())?,
        config: store.table(mut db, "platform.config", std.codec.key_u64(), std.codec.of())?,
        meta: store.table(mut db, "platform.meta", std.codec.key_u64(), std.codec.of())?,
        retired: store.table(mut db, "platform.retired", std.codec.key_string(), std.codec.of())?,
    ))
}

fn st[T](take r: Result[T, store.Error]) -> Result[T, Refused] {
    match take r {
        Ok(take v) => Ok(take v),
        Error(take e) => Error(Store(take e))
    }
}

// Commits a decision and waits until it is durable; only then may the caller act on it.
fn decided[R](mut db: store.Db, take attempted: Result[store.Outcome[R, Refused], store.Error]) -> Result[R, Refused] waits {
    match take attempted {
        Ok(Committed(store.Done(value: take value, ticket: ticket, ..))) => {
            st(store.durable(mut db, ticket))?
            Ok(take value)
        },
        Ok(Aborted(store.Undone(value: take why, ..))) => Error(take why),
        Ok(_) => Error(Missing("commit")),
        Error(take e) => Error(Store(take e)),
    }
}

// Opens the host on its store: creates the catalog on first use, and returns the host
// with the `Hello` that starts its control session.
pub fn open(take opened: store.Db, first: Config) -> Result[(Host, List[launcher.Request]), Refused] waits {
    if first.max_places == 0u64 {
        return Error(Missing("max_places"))
    }
    if first.idle_ms == 0u64 {
        return Error(Missing("idle_ms"))
    }
    let mut db = take opened
    let t = st(make_tables(mut db))?
    let made = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
        if let None = st(store.fetch(tx, store.shape(t.config), 0u64))? {
            st(store.put(mut tx, t.config, 0u64, first))?
        }
        if let None = st(store.fetch(tx, store.shape(t.meta), 0u64))? {
            st(store.put(mut tx, t.meta, 0u64, Meta(dirty: 0u64, next_incarnation: 1u64)))?
        }
        Ok(())
    })
    decided(mut db, take made)?
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Hello)
    Ok((Host(db: take db, t: take t, vol: map.new(), queue: list.new(), probes: 0u64, due_wakes: 0u64, arrival_wakes: 0u64, binds_sent: false, collecting: Unfenced), take out))
}

// The host's store, for a restart: the process ends and only the store survives.
pub fn close(take h: Host) -> store.Db {
    let Host(db: take db, ..) = take h
    take db
}

// A new control session in the same process: the launcher discards the old session's
// unacted requests, so every launch not in the inventory will never run (§14.5).
pub fn reconnect(h: Host) -> List[launcher.Request] {
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Hello)
    out
}

fn group_of(name: String, incarnation: u64) -> launcher.Group {
    launcher.Group(name: string.from(name), incarnation: incarnation)
}

// The one place a Bind is built.
fn bind_request(name: String, g: GroupRow) -> launcher.Request {
    Bind(group_of(name, g.incarnation), string.from(g.listen), g.label, clone(g.bindings), g.limits)
}

fn serving_launch(name: String, g: GroupRow, gen: u64, activation: u64, assembly: Bytes, idle: u64, candidate: Option[u64]) -> launcher.Request {
    let mode: launcher.Mode = ServingMode(gen, launcher.Serve(activation: activation, idle: idle, candidate: candidate))
    Start(launcher.Launch(group: group_of(name, g.incarnation), assembly: clone(assembly), workdir: string.from(g.workdir), args: list.new(), mode: mode, recording: None))
}

fn child_of(name: String, incarnation: u64, gen: u64) -> launcher.Child {
    launcher.Child(group: group_of(name, incarnation), role: Serving(gen))
}

// The one cutover command an attempt sends to OLD, first and on every re-send.
fn cutover_command(name: String, incarnation: u64, old: u64, attempt: launcher.Attempt, digest: Bytes) -> launcher.Request {
    Command(child_of(name, incarnation, old), HostCutover(attempt_bytes(attempt), clone(digest), CUTOVER_PAUSE_MS, false))
}

// The decision on the attempt is durable: the launcher forgets OLD's saved answer.
fn cutover_ack(name: String, cut: Cut) -> launcher.Request {
    CutoverAck(child_of(name, cut.incarnation, cut.old), cut.attempt)
}

fn attempt_bytes(a: launcher.Attempt) -> Bytes {
    let mut b: Bytes = list.with_capacity(16u64)
    list.put_word_le(mut b, a.hi)
    list.put_word_le(mut b, a.lo)
    b
}

fn group_row(h: Host, name: String) -> Result[Option[GroupRow], Refused] {
    st(store.get(store.snapshot(h.db), store.shape(h.t.groups), name))
}

fn host_config(h: Host) -> Result[Config, Refused] {
    match st(store.get(store.snapshot(h.db), store.shape(h.t.config), 0u64))? {
        Some(c) => Ok(c),
        None => Error(Missing("config"))
    }
}

pub fn wake_row(h: Host, name: String) -> Option[WakeRow] {
    match store.get(store.snapshot(h.db), store.shape(h.t.wake), name) {
        Ok(Some(w)) => Some(w),
        _ => None
    }
}

fn empty_vol() -> Vol {
    Vol(run: None, cut: None, count: 0u64, retry_at: None, failing: false, last: string.new(), reprobe: false, prep: None, admit: None)
}

// The volatile state of one group, by value: read it, change it, put it back.
fn vol_read(h: Host, name: String) -> Vol {
    match map.get(h.vol, name) {
        Some(v) => clone(v),
        None => empty_vol()
    }
}

fn vol_put(mut h: Host, name: String, take v: Vol) {
    let _ = map.remove(mut h.vol, name)
    map.insert(mut h.vol, string.from(name), take v)
}

fn run_gen(h: Host, name: String) -> Option[u64] {
    match vol_read(h, name).run {
        Some(r) => Some(r.gen),
        None => None
    }
}

fn cut_of(h: Host, name: String) -> Option[Cut] {
    clone(vol_read(h, name).cut)
}

fn set_cut(mut h: Host, name: String, take c: Option[Cut]) {
    let mut v = vol_read(h, name)
    v.cut = take c
    vol_put(mut h, name, take v)
}

fn set_run(mut h: Host, name: String, r: Option[Run]) {
    let mut v = vol_read(h, name)
    v.run = r
    vol_put(mut h, name, take v)
}

fn queued_at(h: Host, name: String) -> Option[u64] {
    for i in 0u64 .. list.len(h.queue) {
        if h.queue[i].name == name {
            return Some(i)
        }
    }
    None
}

fn dequeue(mut h: Host, name: String) {
    let mut kept: List[Queued] = list.new()
    for q in h.queue {
        if q.name != name {
            list.push(mut kept, clone(q))
        }
    }
    h.queue = take kept
}

// One queue entry per group, with its earliest cause, in (cause time, name) order.
fn enqueue(mut h: Host, name: String, since: u64) {
    let mut at = since
    if let Some(i) = queued_at(h, name) {
        if h.queue[i].since <= at {
            return
        }
    }
    dequeue(mut h, name)
    list.push(mut h.queue, Queued(name: string.from(name), since: at))
    list.sort_stable(mut h.queue, scoped fn(a: Queued, b: Queued) -> Order {
        match order.compare(a.since, b.since) {
            Equal => order.compare(a.name, b.name),
            other => other
        }
    })
}

fn usage_of(tx: store.Tx, t: Tables, tenant: String) -> Result[Usage, Refused] {
    match st(store.fetch(tx, store.shape(t.usage), tenant))? {
        Some(u) => Ok(u),
        None => Ok(Usage(groups: 0u64, live: 0u64))
    }
}

fn quota_of(tx: store.Tx, t: Tables, tenant: String) -> Result[Option[Quota], Refused] {
    st(store.fetch(tx, store.shape(t.quotas), tenant))
}

fn meta_of(tx: store.Tx, t: Tables) -> Result[Meta, Refused] {
    match st(store.fetch(tx, store.shape(t.meta), 0u64))? {
        Some(m) => Ok(m),
        None => Error(Missing("meta"))
    }
}

fn config_of(tx: store.Tx, t: Tables) -> Result[Config, Refused] {
    match st(store.fetch(tx, store.shape(t.config), 0u64))? {
        Some(c) => Ok(c),
        None => Error(Missing("config"))
    }
}

// §14.2: the capacity and tenant checks come before `Dirty`, in the transaction that writes it.
fn mark_dirty(mut tx: store.Tx, t: Tables, name: String) -> Result[(GroupRow, u64), Refused] {
    let Some(g) = st(store.fetch(tx, store.shape(t.groups), name))? else {
        return Error(Unknown)
    }
    let Some(w) = st(store.fetch(tx, store.shape(t.wake), name))? else {
        return Error(Unknown)
    }
    let Clean(due) = w.wake else {
        return Error(Busy(w.gen))
    }
    let mut meta = meta_of(tx, t)?
    let c = config_of(tx, t)?
    if meta.dirty >= c.max_places {
        return Error(Full(Count(c.max_places)))
    }
    let mut u = usage_of(tx, t, g.tenant)?
    if let Some(q) = quota_of(tx, t, g.tenant)? {
        if u.live >= q.live {
            return Error(Full(Live(string.from(g.tenant), q.live)))
        }
    }
    let next = w.gen + 1u64
    st(store.put(mut tx, t.wake, name, WakeRow(wake: Dirty(next), gen: next)))?
    st(store.put(mut tx, t.dirty, name, next))?
    if let Some(at) = due {
        let _ = st(store.delete(mut tx, t.due, DueKey(at: at, name: string.from(name))))?
    }
    meta.dirty += 1u64
    st(store.put(mut tx, t.meta, 0u64, meta))?
    u.live += 1u64
    st(store.put(mut tx, t.usage, g.tenant, u))?
    Ok((g, next))
}

// A new serving launch for a row that is already Dirty (a probe, a relaunch after a
// readable end, a backoff retry): no check, because `dirty` does not change.
// The pair a serving launch of an already Dirty row opens: the group's recorded assembly
// and activation, or while its deploy is Undecided, the pair that deploy's probe selects.
fn probe_pair(tx: store.Tx, t: Tables, name: String, g: GroupRow) -> Result[(Bytes, u64), Refused] {
    if let Some(d) = st(store.fetch(tx, store.shape(t.deploys), name))? {
        if let Undecided(ProbeNew) = d.outcome {
            return Ok((clone(d.assembly), d.activation))
        }
    }
    Ok((clone(g.assembly), g.activation))
}

fn remark(mut tx: store.Tx, t: Tables, name: String) -> Result[(GroupRow, u64), Refused] {
    let Some(g) = st(store.fetch(tx, store.shape(t.groups), name))? else {
        return Error(Unknown)
    }
    let Some(w) = st(store.fetch(tx, store.shape(t.wake), name))? else {
        return Error(Unknown)
    }
    let Dirty(_) = w.wake else {
        return Error(Missing("dirty"))
    }
    if let Some(_) = g.retiring {
        return Error(Retiring)
    }
    let next = w.gen + 1u64
    st(store.put(mut tx, t.wake, name, WakeRow(wake: Dirty(next), gen: next)))?
    st(store.put(mut tx, t.dirty, name, next))?
    Ok((g, next))
}

// §14.4 "Only a clean Stopped writes Clean": the row must be Dirty(g) with the report's g.
fn mark_clean(mut tx: store.Tx, t: Tables, name: String, g: u64, next_due: Option[u64]) -> Result[bool, Refused] {
    let Some(grp) = st(store.fetch(tx, store.shape(t.groups), name))? else {
        return Ok(false)
    }
    let Some(w) = st(store.fetch(tx, store.shape(t.wake), name))? else {
        return Ok(false)
    }
    let Dirty(a) = w.wake else {
        return Ok(false)
    }
    if a != g {
        return Ok(false)
    }
    st(store.put(mut tx, t.wake, name, WakeRow(wake: Clean(next_due), gen: w.gen)))?
    let _ = st(store.delete(mut tx, t.dirty, name))?
    if let Some(at) = next_due {
        st(store.put(mut tx, t.due, DueKey(at: at, name: string.from(name)), 0u8))?
    }
    let mut meta = meta_of(tx, t)?
    meta.dirty -= 1u64
    st(store.put(mut tx, t.meta, 0u64, meta))?
    let mut u = usage_of(tx, t, grp.tenant)?
    u.live -= 1u64
    st(store.put(mut tx, t.usage, grp.tenant, u))?
    Ok(true)
}

fn launch_dirty(mut h: Host, name: String, probe: bool, mut out: List[launcher.Request]) -> Result[(), Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(GroupRow, u64, Bytes, u64), Refused] {
            let (g, gen) = remark(mut tx, t, name)?
            let (assembly, activation) = probe_pair(tx, t, name, g)?
            Ok((g, gen, assembly, activation))
        })
    }
    let (g, gen, assembly, activation) = decided(mut h.db, take made)?
    let c = host_config(h)?
    list.push(mut out, serving_launch(name, g, gen, activation, assembly, c.idle_ms, None))
    let mut v = vol_read(h, name)
    v.run = Some(Run(gen: gen, phase: Requested))
    v.retry_at = None
    v.failing = false
    v.reprobe = false
    vol_put(mut h, name, take v)
    if probe {
        h.probes += 1u64
    }
    Ok(())
}

// A cold group's wake (§14.3, the Cold row): the check, `Dirty(gen + 1)`, a launch.
fn activate(mut h: Host, name: String, mut out: List[launcher.Request]) -> Result[(), Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(GroupRow, u64), Refused] {
            mark_dirty(mut tx, t, name)
        })
    }
    let (g, gen) = decided(mut h.db, take made)?
    let c = host_config(h)?
    list.push(mut out, serving_launch(name, g, gen, g.activation, g.assembly, c.idle_ms, None))
    set_run(mut h, name, Some(Run(gen: gen, phase: Requested)))
    dequeue(mut h, name)
    Ok(())
}

type Cause = Arrival | Due(u64) | Operator

// What a wake does by the group's state (§14.3, the table).
fn wake_cause(mut h: Host, name: String, cause: Cause, now: Now, mut out: List[launcher.Request]) -> Result[(), Refused] waits {
    let Some(g) = group_row(h, name)? else {
        return Error(Unknown)
    }
    let operator = match cause {
        Operator => true,
        _ => false
    }
    if let Some(_) = g.retiring {
        return if operator {
            Error(Retiring)
        } else {
            Ok(())
        }
    }
    let v = vol_read(h, name)
    if let Some(_) = v.cut {
        return if operator {
            Error(Busy(0u64))
        } else {
            Ok(())
        }
    }
    if let Some(_) = v.run {
        return Ok(())
    }
    if v.failing {
        if operator {
            return launch_dirty(mut h, name, false, mut out)
        }
        return Ok(())
    }
    let Some(w) = wake_row(h, name) else {
        return Error(Unknown)
    }
    if let Dirty(_) = w.wake {
        return launch_dirty(mut h, name, true, mut out)
    }
    match activate(mut h, name, mut out) {
        Ok(()) => {
            match cause {
                Due(_) => {
                    h.due_wakes += 1u64
                },
                Arrival => {
                    h.arrival_wakes += 1u64
                },
                Operator => (),
            }
            Ok(())
        },
        Error(Full(take limit)) => {
            match cause {
                Operator => Error(Full(take limit)),
                Due(at) => {
                    enqueue(mut h, name, at);
                    Ok(())
                },
                Arrival => {
                    enqueue(mut h, name, now.wall_ms);
                    Ok(())
                },
            }
        },
        Error(take e) => Error(take e),
    }
}

// Tries every queued wake in order, each independently (§14.3 "Queued wakes").
fn retry_queue(mut h: Host, now: Now, mut out: List[launcher.Request]) waits {
    let entries: List[Queued] = clone(h.queue)
    for q in entries {
        if let None = queued_at(h, q.name) {
            continue
        }
        dequeue(mut h, q.name)
        let _ = wake_cause(mut h, q.name, Due(q.since), now, mut out)
    }
}

fn backoff_ns(count: u64) -> u64 {
    if count <= 1u64 {
        return 0u64
    }
    let mut d = BACKOFF_FIRST_NS
    for _ in 2u64 .. count {
        d = int.saturating_mul(d, 2u64)
        if d >= BACKOFF_MAX_NS {
            return BACKOFF_MAX_NS
        }
    }
    d
}

fn status_text(s: launcher.Status) -> String {
    let mut out = string.new()
    match s {
        Code(c) => {
            string.push(mut out, "exit ");
            string.push_i64(mut out, int.widen(c))
        },
        Signal(n) => {
            string.push(mut out, "signal ");
            string.push_i64(mut out, int.widen(n))
        },
    }
    out
}

// An unsuccessful start (§14.5 "Failing and backoff"): retried at once the first time,
// then after a doubling delay from 1 s up to 5 min. The row stays Dirty and keeps its slot.
fn unsuccessful(mut h: Host, name: String, why: String, retry: bool, now: Now, mut out: List[launcher.Request]) waits {
    let mut v = vol_read(h, name)
    v.run = None
    v.count += 1u64
    v.last = string.from(why)
    v.failing = true
    v.retry_at = None
    let count = v.count
    let delay = backoff_ns(count)
    if retry && delay > 0u64 {
        v.retry_at = Some(int.saturating_add(now.mono_ns, delay))
    }
    vol_put(mut h, name, take v)
    if retry && delay == 0u64 {
        let _ = launch_dirty(mut h, name, false, mut out)
    }
}

fn clean_report(e: launcher.End) -> Option[Option[u64]] {
    match e.status {
        Code(0i32) => e.report,
        _ => None
    }
}

// The authoritative child ended (§14.3 table, the last two columns; §14.4, §14.5).
fn apply_end(mut h: Host, name: String, g: GroupRow, gen: u64, e: launcher.End, now: Now, mut out: List[launcher.Request]) waits {
    let mut v = vol_read(h, name)
    let ready_ns: Option[u64] = match v.run {
        Some(r) => match r.phase {
            Ready(at) => Some(at),
            _ => None
        },
        None => None
    }
    v.run = None
    if let Some(_) = g.retiring {
        vol_put(mut h, name, take v);
        return
    }
    if v.reprobe {
        vol_put(mut h, name, take v)
        let _ = launch_dirty(mut h, name, true, mut out)
        return
    }
    match clean_report(e) {
        Some(next_due) => {
            v.count = 0u64
            v.failing = false
            vol_put(mut h, name, take v)
            if e.readable {
                let _ = launch_dirty(mut h, name, false, mut out)
                return
            }
            let made = {
                let t = view h.t
                store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[bool, Refused] {
                    mark_clean(mut tx, t, name, gen, next_due)
                })
            }
            if let Ok(true) = decided(mut h.db, take made) {
                retry_queue(mut h, now, mut out)
            }
        },
        None => {
            let long = match ready_ns {
                Some(at) => now.mono_ns >= at && now.mono_ns - at >= READY_RESET_NS,
                None => false
            }
            if long {
                v.count = 0u64
            }
            vol_put(mut h, name, take v)
            unsuccessful(mut h, name, status_text(e.status), true, now, mut out)
        },
    }
}

fn current(h: Host, c: launcher.Child) -> Option[GroupRow] {
    match group_row(h, c.group.name) {
        Ok(Some(g)) => if g.incarnation == c.group.incarnation {
            Some(g)
        } else {
            None
        },
        _ => None,
    }
}

fn ended(mut h: Host, c: launcher.Child, e: launcher.End, now: Now, mut out: List[launcher.Request]) waits {
    let Some(g) = current(h, c) else {
        list.push(mut out, Acknowledge(clone(c)));
        return
    }
    let Serving(gen) = c.role else {
        let ok = match e.status {
            Code(x) => x == 0i32,
            Signal(_) => false
        }
        helper_done(mut h, c, ok, status_text(e.status), mut out)
        list.push(mut out, Acknowledge(clone(c)));
        return
    }
    let name = string.from(c.group.name)
    // OLD's end ends its export and any kept import: a Preparing deploy fails with it.
    let preparing = prep_of(h, name)
    if let Some(take p) = take preparing {
        if p.old == gen {
            prep_fail(mut h, name, take p, "OLD ended before the cutover", false, mut out)
        }
    }
    let found = cut_of(h, name)
    match take found {
        Some(take outstanding) => {
            let mut cut = take outstanding
            if cut.held && (gen == cut.candidate || gen == cut.old) {
                if gen == cut.candidate {
                    cut.candidate_end = Some(e)
                } else {
                    cut.old_end = Some(e)
                    cut.old_ended = true
                }
                set_cut(mut h, name, Some(take cut))
                return
            }
            if gen == cut.candidate {
                cut.candidate_end = Some(e)
                if cut.old_ended {
                    undecided(mut h, name, take cut, mut out)
                } else {
                    set_cut(mut h, name, Some(take cut))
                }
            } else if gen == cut.old {
                cut.old_end = Some(e)
                cut.old_ended = true
                if cut.opened {
                    commit_cut(mut h, name, take cut, now, mut out)
                } else if let Some(_) = cut.candidate_end {
                    undecided(mut h, name, take cut, mut out)
                } else {
                    set_cut(mut h, name, Some(take cut))
                }
            }
        },
        None => {
            if run_gen(h, name) == Some(gen) {
                apply_end(mut h, name, g, gen, e, now, mut out)
            }
        },
    }
    list.push(mut out, Acknowledge(clone(c)))
}

// The store installed the deploy's activation: NEW's assembly becomes the group's root,
// OLD's is retained, and the deploy is Installed.
fn install_new(mut tx: store.Tx, t: Tables, name: String, take g: GroupRow, take d: DeployRow) -> Result[(), Refused] {
    let mut grp = take g
    let mut row = take d
    list.push(mut grp.retained, clone(grp.assembly))
    grp.assembly = clone(row.assembly)
    grp.activation = row.activation
    st(store.put(mut tx, t.groups, name, grp))?
    row.outcome = Installed
    st(store.put(mut tx, t.deploys, name, row))
}

// §14.3 "Commit": OLD answered Installed(v), or the candidate opened the store at v and OLD
// has ended. The row moves to `Dirty(c)` with the deploy outcome in one transaction.
fn commit_cut(mut h: Host, name: String, take cut: Cut, now: Now, mut out: List[launcher.Request]) waits {
    let candidate = cut.candidate
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            let Some(found_w) = st(store.fetch(tx, store.shape(t.wake), name))? else {
                return Error(Unknown)
            }
            let mut w = found_w
            let Some(grp) = st(store.fetch(tx, store.shape(t.groups), name))? else {
                return Error(Unknown)
            }
            let Some(d) = st(store.fetch(tx, store.shape(t.deploys), name))? else {
                return Error(Missing("deploy"))
            }
            w.wake = Dirty(candidate)
            st(store.put(mut tx, t.wake, name, w))?
            st(store.put(mut tx, t.dirty, name, candidate))?
            install_new(mut tx, t, name, take grp, take d)
        })
    }
    if let Error(_) = decided(mut h.db, take made) {
        return
    }
    list.push(mut out, cutover_ack(name, cut))
    let phase = if cut.opened {
        Ready(now.mono_ns)
    } else {
        Started
    }
    let mut v = vol_read(h, name)
    v.cut = None
    v.run = Some(Run(gen: candidate, phase: phase))
    vol_put(mut h, name, take v)
    if let Some(e) = cut.candidate_end {
        let Some(fresh) = current(h, child_of(name, cut.incarnation, candidate)) else {
            return
        }
        apply_end(mut h, name, fresh, candidate, e, now, mut out)
    }
}

// §14.3 "Abort": OLD answered Refused, or Drift. The candidate is discarded and the row
// stays `Dirty(g)`.
fn abort_cut(mut h: Host, name: String, g: GroupRow, take cut: Cut, why: String, now: Now, mut out: List[launcher.Request]) waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            let Some(found_d) = st(store.fetch(tx, store.shape(t.deploys), name))? else {
                return Error(Missing("deploy"))
            }
            let mut d = found_d
            d.outcome = Failed(string.from(why))
            st(store.put(mut tx, t.deploys, name, d))
        })
    }
    if let Error(_) = decided(mut h.db, take made) {
        return
    }
    list.push(mut out, cutover_ack(name, cut))
    list.push(mut out, Command(child_of(name, g.incarnation, cut.old), HostAbort(attempt_bytes(cut.attempt))))
    if let None = cut.candidate_end {
        list.push(mut out, Stop(child_of(name, g.incarnation, cut.candidate)))
    }
    set_cut(mut h, name, None)
    if let Some(e) = cut.old_end {
        apply_end(mut h, name, g, cut.old, e, now, mut out)
    }
}

// §14.3 "Undecided": neither OLD's answer nor the candidate's open proves the install.
// Both ends are discarded and the group is probed at a new generation, first with NEW's
// assembly at the deploy's activation (`probe_pair`).
fn undecided(mut h: Host, name: String, take cut: Cut, mut out: List[launcher.Request]) waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            let Some(found_d) = st(store.fetch(tx, store.shape(t.deploys), name))? else {
                return Error(Missing("deploy"))
            }
            let mut d = found_d
            d.outcome = Undecided(ProbeNew)
            st(store.put(mut tx, t.deploys, name, d))
        })
    }
    if let Error(_) = decided(mut h.db, take made) {
        return
    }
    list.push(mut out, cutover_ack(name, cut))
    let mut v = vol_read(h, name)
    v.cut = None
    v.run = None
    vol_put(mut h, name, take v)
    let _ = launch_dirty(mut h, name, true, mut out)
}

fn placed(mut h: Host, c: launcher.Child, reply: runner.HostReply, now: Now, mut out: List[launcher.Request]) waits {
    let Some(g) = current(h, c) else {
        return
    }
    let Serving(gen) = c.role else {
        return
    }
    let name = string.from(c.group.name)
    let preparing = prep_of(h, name)
    if let Some(take p) = take preparing {
        if p.old == gen {
            prep_placed(mut h, name, take p, reply, mut out);
            return
        }
    }
    let found = cut_of(h, name)
    match take found {
        Some(take outstanding) => {
            let mut cut = take outstanding
            if gen == cut.candidate {
                if let PlaceOpened(ready) = reply {
                    if ready.version == cut.activation && ready.release == cut.release {
                        cut.opened = true
                        if cut.old_ended {
                            commit_cut(mut h, name, take cut, now, mut out)
                        } else {
                            set_cut(mut h, name, Some(take cut))
                        }
                    }
                }
            } else if gen == cut.old {
                let deferred = cut.held
                cut.held = false
                let old_done = cut.old_ended
                let new_done = match cut.candidate_end {
                    Some(_) => true,
                    None => false
                }
                let (inc, old_gen, new_gen) = (cut.incarnation, cut.old, cut.candidate)
                match reply {
                    PlaceInstalled(v, _) => if v == cut.activation {
                        commit_cut(mut h, name, take cut, now, mut out)
                    },
                    PlaceDrift => abort_cut(mut h, name, g, take cut, "drift", now, mut out),
                    PlaceRefused(why) => abort_cut(mut h, name, g, take cut, why, now, mut out),
                    // OLD ended before it answered (§14.5): as its end, without the report.
                    PlaceUncertain => {
                        cut.old_ended = true
                        if cut.opened {
                            commit_cut(mut h, name, take cut, now, mut out)
                        } else if let Some(_) = cut.candidate_end {
                            undecided(mut h, name, take cut, mut out)
                        } else {
                            set_cut(mut h, name, Some(take cut))
                        }
                    },
                    _ => set_cut(mut h, name, Some(take cut)),
                }
                if deferred {
                    if old_done {
                        list.push(mut out, Acknowledge(child_of(name, inc, old_gen)))
                    }
                    if new_done {
                        list.push(mut out, Acknowledge(child_of(name, inc, new_gen)))
                    }
                }
            }
        },
        None => {
            if run_gen(h, name) == Some(gen) {
                match reply {
                    PlaceOpened(ready) => {
                        set_run(mut h, name, Some(Run(gen: gen, phase: Ready(now.mono_ns))))
                        settle_probe(mut h, name, ready.version, ready.release, true)
                    },
                    PlaceCurrent(version, _) => settle_probe(mut h, name, version, list.new(), false),
                    _ => (),
                }
            }
        },
    }
}

// The probe of an Undecided deploy answered (launch.md "When the host starts"). Only an
// open of the selected pair decides: NEW's at the deploy's activation installs it, OLD's at
// the group's recorded activation abandons it. An answer that the store is at the other
// pair's activation selects that pair for the next probe, which starts when this one ends.
// Any other answer decides nothing, and the row keeps both roots.
fn settle_probe(mut h: Host, name: String, version: u64, release: Bytes, opened: bool) waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[bool, Refused] {
            let Some(d) = st(store.fetch(tx, store.shape(t.deploys), name))? else {
                return Ok(false)
            }
            let probe = match d.outcome {
                Undecided(ProbeNew) => ProbeNew,
                Undecided(ProbeOld) => ProbeOld,
                _ => return Ok(false),
            }
            let Some(g) = st(store.fetch(tx, store.shape(t.groups), name))? else {
                return Ok(false)
            }
            let (new_at, old_at) = (d.activation, g.activation)
            let mut row = d
            match (probe, opened) {
                (ProbeNew, true) if version == new_at && release == row.release => {
                    install_new(mut tx, t, name, take g, take row)?;
                    Ok(false)
                },
                (ProbeOld, true) if version == old_at => {
                    row.outcome = Failed("not installed after recovery");
                    st(store.put(mut tx, t.deploys, name, row))?;
                    Ok(false)
                },
                (ProbeNew, false) if version == old_at => {
                    row.outcome = Undecided(ProbeOld);
                    st(store.put(mut tx, t.deploys, name, row))?;
                    Ok(true)
                },
                (ProbeOld, false) if version == new_at => {
                    row.outcome = Undecided(ProbeNew);
                    st(store.put(mut tx, t.deploys, name, row))?;
                    Ok(true)
                },
                _ => Ok(false),
            }
        })
    }
    if let Ok(true) = decided(mut h.db, take made) {
        let mut v = vol_read(h, name)
        v.reprobe = true
        vol_put(mut h, name, take v)
    }
}

fn refused(mut h: Host, c: launcher.Child, why: launcher.Refusal, now: Now, mut out: List[launcher.Request]) waits {
    let Some(_) = current(h, c) else {
        return
    }
    let Serving(gen) = c.role else {
        helper_done(mut h, c, false, refusal_text(why), mut out);
        return
    }
    let name = string.from(c.group.name)
    if run_gen(h, name) != Some(gen) {
        return
    }
    match why {
        Retiring => set_run(mut h, name, None),
        Held => unsuccessful(mut h, name, "held", true, now, mut out),
        Image(e) => unsuccessful(mut h, name, e, true, now, mut out),
        Spawn(e) => unsuccessful(mut h, name, e, true, now, mut out),
        // These do not change with a retry: the group is failing until an operator acts.
        UnknownGroup => unsuccessful(mut h, name, "unknown group", false, now, mut out),
        Mismatch => unsuccessful(mut h, name, "mismatch", false, now, mut out),
        Unbuilt(e) => unsuccessful(mut h, name, e, false, now, mut out),
    }
}

fn stop_or_ack(c: launcher.Child, p: launcher.Phase, mut out: List[launcher.Request]) {
    match p {
        Started => list.push(mut out, Stop(clone(c))),
        Exited(_) => list.push(mut out, Acknowledge(clone(c))),
    }
}

fn dirty_names(h: Host) -> List[String] {
    let mut names: List[String] = list.new()
    let Ok(take scanned) = store.scan(store.snapshot(h.db), store.shape(h.t.dirty), Unbounded, Unbounded) else {
        return names
    }
    let mut rows = take scanned
    while let Ok(Some((name, _))) = store.next(mut rows) {
        list.push(mut names, take name)
    }
    names
}

fn binds(h: Host, mut out: List[launcher.Request]) {
    let Ok(take scanned) = store.scan(store.snapshot(h.db), store.shape(h.t.groups), Unbounded, Unbounded) else {
        return
    }
    let mut rows = take scanned
    while let Ok(Some((name, g))) = store.next(mut rows) {
        list.push(mut out, bind_request(name, g))
    }
}

// Restart and reconnect (§14.5): adopt the authoritative children and pending-deploy
// candidates the inventory names, stop the rest, probe each Dirty row left without a child,
// and wake each readable listener and each passed due time.
fn reconcile(mut h: Host, children: List[launcher.ChildState], readable: List[launcher.Group], held: List[launcher.CutoverKey], now: Now, mut out: List[launcher.Request]) waits {
    if !h.binds_sent {
        binds(h, mut out)
        h.binds_sent = true
    }
    h.collecting = Unfenced
    let mut names: List[String] = list.new()
    for (name, _) in h.vol {
        list.push(mut names, string.from(name))
    }
    for name in names {
        let mut v = vol_read(h, name)
        v.run = None
        v.cut = None
        v.prep = None
        let was = replace(mut v.admit, None)
        v.admit = interrupted(take was)
        vol_put(mut h, name, take v)
    }
    let mut ends: List[(launcher.Child, launcher.End)] = list.new()
    for s in children {
        let c = s.child
        let Some(_) = current(h, c) else {
            stop_or_ack(c, s.phase, mut out);
            continue
        }
        let Serving(gen) = c.role else {
            stop_or_ack(c, s.phase, mut out);
            continue
        }
        let name = string.from(c.group.name)
        let Some(w) = wake_row(h, name) else {
            stop_or_ack(c, s.phase, mut out);
            continue
        }
        let authoritative = match w.wake {
            Dirty(a) => a == gen,
            Clean(_) => false
        }
        let pending: Option[DeployRow] = match store.get(store.snapshot(h.db), store.shape(h.t.deploys), name) {
            Ok(Some(d)) => Some(d),
            _ => None
        }
        let candidate = match pending {
            Some(d) => match d.outcome {
                Pending => d.candidate == gen,
                _ => false
            },
            None => false,
        }
        if authoritative {
            // A child that ended without a clean report while no host watched leaves its row
            // Dirty with no child, so the row is probed below (§14.5).
            if let Exited(e) = s.phase {
                if let None = clean_report(e) {
                    list.push(mut out, Acknowledge(clone(c)));
                    continue
                }
            }
            set_run(mut h, name, Some(Run(gen: gen, phase: Started)))
        } else if candidate {
            let Some(d) = pending else {
                continue
            }
            let old_child = child_of(name, c.group.incarnation, d.old)
            let mut kept = false
            for k in held {
                if launcher.same_child(k.old, old_child) && k.attempt.hi == d.attempt.hi && k.attempt.lo == d.attempt.lo {
                    kept = true
                }
            }
            let cut = Cut(attempt: d.attempt, incarnation: c.group.incarnation, old: d.old, candidate: gen, activation: d.activation, old_end: None, old_ended: false, opened: false, candidate_end: None, held: kept, release: clone(d.release))
            set_cut(mut h, name, Some(cut))
        } else {
            stop_or_ack(c, s.phase, mut out);
            continue
        }
        if let Exited(e) = s.phase {
            list.push(mut ends, (clone(c), e))
        }
    }
    for (c, e) in ends {
        ended(mut h, c, e, now, mut out)
    }
    resume_cuts(mut h, held, mut out)
    for name in dirty_names(h) {
        let Ok(Some(g)) = group_row(h, name) else {
            continue
        }
        if let Some(_) = g.retiring {
            list.push(mut out, Retire(group_of(name, g.incarnation)));
            continue
        }
        let v = vol_read(h, name)
        let idle = is_none(v.run) && is_none(v.cut) && is_none(v.retry_at)
        if idle {
            let _ = launch_dirty(mut h, name, true, mut out)
        }
    }
    for g in readable {
        let _ = wake_cause(mut h, g.name, Arrival, now, mut out)
    }
    due_wakes(mut h, now, mut out)
}

// A new session resumes each Pending deploy row (§14.5). With the candidate known, the
// identical cutover command is sent again: the launcher forwards it if it never did, stays
// silent while OLD holds it, and otherwise returns OLD's saved answer or Uncertain. With
// OLD running and no candidate, the candidate's Start goes out again first. With neither,
// nothing proves the install: the row is Undecided and the group is probed. A cutover the
// launcher holds for no Pending row is acknowledged.
fn resume_cuts(mut h: Host, held: List[launcher.CutoverKey], mut out: List[launcher.Request]) waits {
    let mut rows: List[(String, DeployRow)] = list.new()
    let mut preps: List[(String, DeployRow)] = list.new()
    {
        let Ok(take scanned) = store.scan(store.snapshot(h.db), store.shape(h.t.deploys), Unbounded, Unbounded) else {
            return
        }
        let mut found = take scanned
        while let Ok(Some((name, d))) = store.next(mut found) {
            match d.outcome {
                Pending => list.push(mut rows, (string.from(name), clone(d))),
                Preparing => list.push(mut preps, (string.from(name), clone(d))),
                _ => (),
            }
        }
    }
    // A Preparing row proves no cutover was sent (ADVICE step 6). OLD, if it still runs, may
    // hold the export or a kept import: it is sent HostAbort, and the row records the
    // failure once OLD answers or ends. With OLD gone, nothing holds either.
    for (name, d) in preps {
        let Ok(Some(g)) = group_row(h, name) else {
            continue
        }
        let p = Prep(attempt: d.attempt, incarnation: g.incarnation, old: d.old, assembly: clone(d.assembly), image: clone(d.image), target: string.new(), n_place: 0u64, stage: Aborting("interrupted before the cutover"), describe: list.new(), release: list.new(), helper: None, aborting: run_gen(h, name) == Some(d.old))
        if p.aborting {
            list.push(mut out, Command(child_of(name, g.incarnation, d.old), HostAbort(attempt_bytes(d.attempt))))
        }
        prep_finish(mut h, name, take p)
    }
    let mut resumed: List[launcher.CutoverKey] = list.new()
    for (name, d) in rows {
        let Ok(Some(g)) = group_row(h, name) else {
            continue
        }
        if let Some(_) = cut_of(h, name) {
            list.push(mut out, cutover_command(name, g.incarnation, d.old, d.attempt, d.digest))
        } else if run_gen(h, name) == Some(d.old) {
            let Ok(cfg) = host_config(h) else {
                continue
            }
            let cut = Cut(attempt: d.attempt, incarnation: g.incarnation, old: d.old, candidate: d.candidate, activation: d.activation, old_end: None, old_ended: false, opened: false, candidate_end: None, held: false, release: clone(d.release))
            set_cut(mut h, name, Some(cut))
            list.push(mut out, serving_launch(name, g, d.candidate, d.activation, d.assembly, cfg.idle_ms, Some(d.old)))
            list.push(mut out, cutover_command(name, g.incarnation, d.old, d.attempt, d.digest))
        } else {
            let made = {
                let t = view h.t
                store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
                    let Some(found_d) = st(store.fetch(tx, store.shape(t.deploys), name))? else {
                        return Error(Missing("deploy"))
                    }
                    let mut row = found_d
                    row.outcome = Undecided(ProbeNew)
                    st(store.put(mut tx, t.deploys, name, row))
                })
            }
            let _ = decided(mut h.db, take made)
            continue
        }
        list.push(mut resumed, launcher.CutoverKey(old: child_of(name, g.incarnation, d.old), attempt: d.attempt))
    }
    for k in held {
        let mut live = false
        for r in resumed {
            if launcher.same_child(r.old, k.old) && r.attempt.hi == k.attempt.hi && r.attempt.lo == k.attempt.lo {
                live = true
            }
        }
        if !live {
            list.push(mut out, CutoverAck(clone(k.old), k.attempt))
        }
    }
}

// Wakes every Clean row whose due time has passed, in due order.
fn due_wakes(mut h: Host, now: Now, mut out: List[launcher.Request]) waits {
    let mut due: List[DueKey] = list.new()
    {
        let Ok(take scanned) = store.scan(store.snapshot(h.db), store.shape(h.t.due), Unbounded, Unbounded) else {
            return
        }
        let mut rows = take scanned
        while let Ok(Some((k, _))) = store.next(mut rows) {
            if k.at > now.wall_ms {
                break
            }
            if let None = queued_at(h, k.name) {
                list.push(mut due, clone(k))
            }
        }
    }
    for k in due {
        let _ = wake_cause(mut h, k.name, Due(k.at), now, mut out)
    }
}

fn launched(mut h: Host, c: launcher.Child) {
    let Serving(gen) = c.role else {
        return
    }
    let name = string.from(c.group.name)
    let v = vol_read(h, name)
    let Some(r) = v.run else {
        return
    }
    if r.gen != gen {
        return
    }
    if let Requested = r.phase {
        set_run(mut h, name, Some(Run(gen: gen, phase: Started)))
    }
}

fn bind_failed(mut h: Host, g: launcher.Group, why: String) {
    let mut v = vol_read(h, g.name)
    v.failing = true
    v.last = string.from(why)
    vol_put(mut h, g.name, take v)
}

// Applies one launcher event in stream order, and returns the requests it decided.
pub fn event(mut h: Host, take e: launcher.Event, now: Now) -> List[launcher.Request] waits {
    let mut out: List[launcher.Request] = list.new()
    match take e {
        Inventory(children, readable, held) => reconcile(mut h, children, readable, held, now, mut out),
        Launched(c, Started) => launched(mut h, c),
        Launched(c, Exited(fin)) => ended(mut h, c, fin, now, mut out),
        Refused(c, why) => refused(mut h, c, why, now, mut out),
        Ended(c, fin) => ended(mut h, c, fin, now, mut out),
        Arrived(g) => {
            if let Ok(Some(r)) = group_row(h, g.name) {
                if r.incarnation == g.incarnation {
                    let _ = wake_cause(mut h, g.name, Arrival, now, mut out)
                }
            }
        },
        Bound(_) => (),
        BindFailed(g, why) => bind_failed(mut h, g, why),
        Closed(_) => (),
        Retired(g) => finish_retire(mut h, g, now, mut out),
        Placed(c, reply) => placed(mut h, c, reply, now, mut out),
        CutoverResult(c, _, reply) => placed(mut h, c, reply, now, mut out),
        Answered(c, said) => answered(mut h, c, said, mut out),
        Need(a, keys, done) => needed(mut h, a, keys, done),
        Admitted(a, _, summary, display) => admitted(mut h, a, summary, display, mut out),
        Assembled(a, key, digest, _, _) => assembled(mut h, a, key, digest, mut out),
        AdmissionFailed(a, why) => unadmitted(mut h, a, why),
        Fenced => fenced(mut h, now, mut out),
        Collected(_) => {
            if let Fencing = h.collecting {
                h.collecting = Unfenced
            }
        },
    }
    take out
}

// Due times and backoff retries that have come.
pub fn tick(mut h: Host, now: Now) -> List[launcher.Request] waits {
    let mut out: List[launcher.Request] = list.new()
    let mut retry: List[String] = list.new()
    for (name, v) in h.vol {
        if let Some(at) = v.retry_at {
            if at <= now.mono_ns {
                list.push(mut retry, string.from(name))
            }
        }
    }
    for name in retry {
        let _ = launch_dirty(mut h, name, false, mut out)
    }
    due_wakes(mut h, now, mut out)
    take out
}

// The due-time wait follows the minimum of the due index without the queued rows; the
// backoff timer follows the earliest retry (§14.3, §14.5).
pub fn timers(h: Host) -> Timers {
    let mut wall: Option[u64] = None
    if let Ok(take scanned) = store.scan(store.snapshot(h.db), store.shape(h.t.due), Unbounded, Unbounded) {
        let mut rows = take scanned
        while let Ok(Some((k, _))) = store.next(mut rows) {
            if let None = queued_at(h, k.name) {
                wall = Some(k.at);
                break
            }
        }
    }
    let mut mono: Option[u64] = None
    for (_, v) in h.vol {
        if let Some(at) = v.retry_at {
            let earlier = match mono {
                Some(m) => at < m,
                None => true
            }
            if earlier {
                mono = Some(at)
            }
        }
    }
    Timers(wall_ms: wall, mono_ns: mono)
}

// Adds a group: `Clean(None)` at gen 0 under a new incarnation (§14.1 "A new group"),
// then the launcher binds its listener.
pub fn add_group(mut h: Host, spec: NewGroup) -> Result[List[launcher.Request], Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[GroupRow, Refused] {
            if let Some(_) = st(store.fetch(tx, store.shape(t.groups), spec.name))? {
                return Error(Exists)
            }
            let mut u = usage_of(tx, t, spec.tenant)?
            if let Some(q) = quota_of(tx, t, spec.tenant)? {
                if u.groups >= q.groups {
                    return Error(Full(Groups(string.from(spec.tenant), q.groups)))
                }
            }
            let mut meta = meta_of(tx, t)?
            let g = GroupRow(tenant: string.from(spec.tenant), workdir: string.from(spec.workdir), author: spec.author, label: spec.label, listen: string.from(spec.listen), bindings: clone(spec.bindings), limits: spec.limits, assembly: clone(spec.assembly), activation: spec.activation, retained: list.new(), incarnation: meta.next_incarnation, retiring: None)
            meta.next_incarnation += 1u64
            st(store.put(mut tx, t.meta, 0u64, meta))?
            st(store.put(mut tx, t.groups, spec.name, g))?
            st(store.put(mut tx, t.wake, spec.name, WakeRow(wake: Clean(None), gen: 0u64)))?
            u.groups += 1u64
            st(store.put(mut tx, t.usage, spec.tenant, u))?
            Ok(g)
        })
    }
    let g = decided(mut h.db, take made)?
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, bind_request(spec.name, g))
    Ok(take out)
}

// An operator request to a group: wake it first (§14.3); a full host answers `Full`.
pub fn wake(mut h: Host, name: String, now: Now) -> Result[List[launcher.Request], Refused] waits {
    let mut out: List[launcher.Request] = list.new()
    wake_cause(mut h, name, Operator, now, mut out)?
    Ok(take out)
}

// §14.2 "Lowering the bound": below the current `dirty` is refused `Busy(dirty)`. A raise
// retries the queue.
pub fn set_max_places(mut h: Host, n: u64, now: Now) -> Result[List[launcher.Request], Refused] waits {
    if n == 0u64 {
        return Error(Missing("max_places"))
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            let meta = meta_of(tx, t)?
            if n < meta.dirty {
                return Error(Busy(meta.dirty))
            }
            let mut c = config_of(tx, t)?
            c.max_places = n
            st(store.put(mut tx, t.config, 0u64, c))
        })
    }
    decided(mut h.db, take made)?
    let mut out: List[launcher.Request] = list.new()
    retry_queue(mut h, now, mut out)
    Ok(take out)
}

pub fn set_quota(mut h: Host, tenant: String, q: Quota, now: Now) -> Result[List[launcher.Request], Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            let u = usage_of(tx, t, tenant)?
            if q.live < u.live {
                return Error(Busy(u.live))
            }
            if q.groups < u.groups {
                return Error(Busy(u.groups))
            }
            st(store.put(mut tx, t.quotas, tenant, q))
        })
    }
    decided(mut h.db, take made)?
    let mut out: List[launcher.Request] = list.new()
    retry_queue(mut h, now, mut out)
    Ok(take out)
}

// A deploy whose NEW assembly is published and synced (launch.md "Hot deploy"): its
// admission was answered `Assembled`. The Preparing row is
// durable before the attempt's reservation is released and before any helper runs; it
// keeps the row `Dirty(g)` naming OLD. The host then runs OLD's describe child, NEW's preview
// child over OLD's exported list, OLD's export, NEW's prepare child on it and OLD's import,
// checking each answer before the next step. `image` is NEW's image digest and `target`
// and `n_place` the verified recipe's, which the preview must report.
fn prepare(mut h: Host, name: String, attempt: launcher.Attempt, assembly: Bytes, image_digest: Bytes, target: String, n_place: u64) -> Result[List[launcher.Request], Refused] waits {
    let Some(g) = group_row(h, name)? else {
        return Error(Unknown)
    }
    if let Some(_) = g.retiring {
        return Error(Retiring)
    }
    let Some(old) = run_gen(h, name) else {
        return Error(Busy(0u64))
    }
    let v = vol_read(h, name)
    if !is_none(v.cut) || !is_none(v.prep) {
        return Error(Busy(old))
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            let Some(w) = st(store.fetch(tx, store.shape(t.wake), name))? else {
                return Error(Unknown)
            }
            let Dirty(a) = w.wake else {
                return Error(Busy(w.gen))
            }
            if a != old {
                return Error(Busy(a))
            }
            // An unresolved deploy's row is the only record of its NEW root.
            if let Some(prior) = st(store.fetch(tx, store.shape(t.deploys), name))? {
                match prior.outcome {
                    Installed => (),
                    Failed(_) => (),
                    _ => return Error(Busy(a)),
                }
            }
            let row = DeployRow(attempt: attempt, assembly: clone(assembly), image: clone(image_digest), digest: list.new(), release: list.new(), activation: 0u64, old: old, candidate: 0u64, outcome: Preparing)
            st(store.put(mut tx, t.deploys, name, row))
        })
    }
    let _ = decided(mut h.db, take made)?
    let mode: launcher.Mode = DescribeMode(attempt)
    let describer = launcher.Child(group: group_of(name, g.incarnation), role: launcher.role_of(mode))
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Release(attempt))
    list.push(mut out, helper_launch(name, g, g.assembly, take mode))
    let p = Prep(attempt: attempt, incarnation: g.incarnation, old: old, assembly: clone(assembly), image: clone(image_digest), target: string.from(target), n_place: n_place, stage: Describing, describe: list.new(), release: list.new(), helper: Some(take describer), aborting: false)
    set_prep(mut h, name, Some(take p))
    Ok(take out)
}

// Begins a deploy of the group's serving OLD (launch.md "Publish and assemble"): the host
// opens the launcher's admission of `input` with the group's working directory and OLD's
// assembly, and the operator's approved Foreign and Exec bindings. An untrusted author
// publishes source only and approves no Foreign or Exec grant. `grant_added` approves a
// grant OLD's recipe lacks. One deploy runs per group at a time.
pub fn deploy(mut h: Host, name: String, attempt: launcher.Attempt, take input: launcher.Input, foreign: List[String], exec: List[String], grant_added: bool) -> Result[List[launcher.Request], Refused] {
    let Some(g) = group_row(h, name)? else {
        return Error(Unknown)
    }
    if let Some(_) = g.retiring {
        return Error(Retiring)
    }
    let Some(old) = run_gen(h, name) else {
        return Error(Busy(0u64))
    }
    let v = vol_read(h, name)
    if !is_none(v.cut) || !is_none(v.prep) || !is_none(running_admission(v)) {
        return Error(Busy(old))
    }
    match deploy_outcome(h, name) {
        Some(Preparing) => return Error(Busy(old)),
        Some(Pending) => return Error(Busy(old)),
        Some(Undecided(_)) => return Error(Busy(old)),
        _ => (),
    }
    if let Untrusted = g.author {
        let source = match input {
            Source(_) => true,
            _ => false,
        }
        if !source || list.len(foreign) > 0u64 || list.len(exec) > 0u64 {
            return Error(Denied("an untrusted author publishes source only, without Foreign or Exec grants"))
        }
    }
    let approvals = launcher.Approvals(recording: false, foreign: clone(foreign), exec: clone(exec), workdir: string.from(g.workdir), old: Some(clone(g.assembly)))
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Admit(group_of(name, g.incarnation), attempt, take input, take approvals))
    let mut w = vol_read(h, name)
    w.admit = Some(Admitting(attempt: attempt, incarnation: g.incarnation, grant_added: grant_added, stage: Uploading(list.new(), false), summary: None))
    vol_put(mut h, name, take w)
    Ok(take out)
}

// The next bounded chunk of an attested admission's exchange bytes, relayed unchanged.
pub fn deploy_data(mut h: Host, name: String, take chunk: Bytes) -> Result[List[launcher.Request], Refused] {
    let Some(a) = uploading(vol_read(h, name)) else {
        return Error(Unknown)
    }
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, AdmitData(a, take chunk))
    Ok(take out)
}

// The attested admission's input is complete.
pub fn deploy_end(mut h: Host, name: String) -> Result[List[launcher.Request], Refused] {
    let Some(a) = uploading(vol_read(h, name)) else {
        return Error(Unknown)
    }
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, AdmitEnd(a))
    Ok(take out)
}

// The operator confirmed exactly `display`, the approval text `Admitted` gave: assemble.
pub fn deploy_confirm(mut h: Host, name: String, display: String) -> Result[List[launcher.Request], Refused] {
    let mut v = vol_read(h, name)
    let Some(take adm) = replace(mut v.admit, None) else {
        return Error(Unknown)
    }
    let mut d = take adm
    let shown = match d.stage {
        Confirming(text) => Some(string.from(text)),
        _ => None,
    }
    let Some(text) = shown else {
        v.admit = Some(take d)
        vol_put(mut h, name, take v)
        return Error(Unknown)
    }
    if text != display {
        v.admit = Some(take d)
        vol_put(mut h, name, take v)
        return Error(Denied("the confirmation is not the approval text shown"))
    }
    let a = d.attempt
    d.stage = Assembling
    v.admit = Some(take d)
    vol_put(mut h, name, take v)
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Assemble(a))
    Ok(take out)
}

// Where the group's latest admission stands, if it has had one since the host started.
pub fn deploy_admission(h: Host, name: String) -> Option[AdmitStage] {
    match vol_read(h, name).admit {
        Some(d) => Some(clone(d.stage)),
        None => None,
    }
}

// The attempt of an admission the launcher still runs.
fn running_admission(v: Vol) -> Option[launcher.Attempt] {
    match v.admit {
        Some(d) => match d.stage {
            Uploading(_, _) => Some(d.attempt),
            Confirming(_) => Some(d.attempt),
            Assembling => Some(d.attempt),
            _ => None,
        },
        None => None,
    }
}

fn uploading(v: Vol) -> Option[launcher.Attempt] {
    match v.admit {
        Some(d) => match d.stage {
            Uploading(_, _) => Some(d.attempt),
            _ => None,
        },
        None => None,
    }
}

// A new launcher session cancelled every running admission.
fn interrupted(take adm: Option[Admitting]) -> Option[Admitting] {
    let Some(take held) = take adm else {
        return None
    }
    let mut d = take held
    let running = match d.stage {
        Uploading(_, _) => true,
        Confirming(_) => true,
        Assembling => true,
        _ => false,
    }
    if running {
        d.stage = Rejected("the launcher session ended during admission")
    }
    Some(take d)
}

fn same_attempt(a: launcher.Attempt, b: launcher.Attempt) -> bool {
    a.hi == b.hi && a.lo == b.lo
}

// The group whose running admission is attempt `a`.
fn admitting_group(h: Host, a: launcher.Attempt) -> Option[String] {
    for (name, v) in h.vol {
        if let Some(x) = running_admission(v) {
            if same_attempt(x, a) {
                return Some(string.from(name))
            }
        }
    }
    None
}

fn set_stage(mut h: Host, name: String, take stage: AdmitStage) {
    let mut v = vol_read(h, name)
    let Some(take adm) = replace(mut v.admit, None) else {
        return
    }
    let mut d = take adm
    d.stage = take stage
    v.admit = Some(take d)
    vol_put(mut h, name, take v)
}

fn needed(mut h: Host, a: launcher.Attempt, keys: List[launcher.Wanted], done: bool) {
    let Some(name) = admitting_group(h, a) else {
        return
    }
    let Some(d) = vol_read(h, name).admit else {
        return
    }
    let mut parts: List[launcher.Wanted] = match d.stage {
        Uploading(sofar, _) => clone(sofar),
        _ => return,
    }
    for k in keys {
        list.push(mut parts, clone(k))
    }
    set_stage(mut h, name, Uploading(take parts, done))
}

// The verifier admitted the release: the host checks its overlap memory and grants against
// OLD's recipe, then assembles at once or after the operator confirms the approval text.
fn admitted(mut h: Host, a: launcher.Attempt, summary: launcher.Summary, display: String, mut out: List[launcher.Request]) {
    let Some(name) = admitting_group(h, a) else {
        return
    }
    let Ok(Some(g)) = group_row(h, name) else {
        return
    }
    let mut v = vol_read(h, name)
    let Some(take adm) = replace(mut v.admit, None) else {
        return
    }
    let mut d = take adm
    let mut why = string.new()
    // OLD and NEW run side by side through the cutover, so the group's memory bounds both.
    if let Some(m) = g.limits.memory {
        if summary.root_limit > m || summary.old_root_limit > m - summary.root_limit {
            why = "Refused(Memory)"
        }
    }
    if why == "" && summary.grants_added && !d.grant_added {
        why = "Refused(GrantAdded)"
    }
    if why != "" {
        d.stage = Rejected(take why)
        list.push(mut out, Release(a))
    } else if display == "" {
        d.stage = Assembling
        list.push(mut out, Assemble(a))
    } else {
        d.stage = Confirming(string.from(display))
    }
    d.summary = Some(clone(summary))
    v.admit = Some(take d)
    vol_put(mut h, name, take v)
}

// NEW is assembled and its reservation held: the deploy goes on to Preparing.
fn assembled(mut h: Host, a: launcher.Attempt, key: Bytes, digest: Bytes, mut out: List[launcher.Request]) waits {
    let Some(name) = admitting_group(h, a) else {
        return
    }
    let Some(d) = vol_read(h, name).admit else {
        return
    }
    let assembling = match d.stage {
        Assembling => true,
        _ => false,
    }
    let Some(summary) = d.summary else {
        return
    }
    if !assembling {
        return
    }
    let mut v = vol_read(h, name)
    v.admit = None
    vol_put(mut h, name, take v)
    match prepare(mut h, name, a, key, digest, summary.target, summary.n_place) {
        Ok(more) => {
            for q in more {
                list.push(mut out, clone(q))
            }
        },
        Error(e) => {
            let mut w = vol_read(h, name)
            w.admit = Some(Admitting(attempt: a, incarnation: d.incarnation, grant_added: d.grant_added, stage: Rejected(refused_text(e)), summary: Some(clone(summary))))
            vol_put(mut h, name, take w)
            list.push(mut out, Release(a))
        },
    }
}

fn unadmitted(mut h: Host, a: launcher.Attempt, why: launcher.Failure) {
    let Some(name) = admitting_group(h, a) else {
        return
    }
    set_stage(mut h, name, Unadmitted(clone(why)))
}

fn refused_text(e: Refused) -> String {
    match e {
        Full(_) => "full",
        Busy(_) => "busy",
        Unknown => "unknown group",
        Exists => "exists",
        Retiring => "retiring",
        Missing(w) => joined("missing ", w),
        Denied(w) => string.from(w),
        Store(_) => "store error",
    }
}

// Starts a collection (launch.md "Collect"). The launcher takes its fence and answers
// `Fenced`; the host then reads every root from one catalog snapshot taken after that
// answer and sends them in `Collect`. One runs at a time, and only after the session's
// inventory is reconciled.
pub fn collect(mut h: Host) -> Result[List[launcher.Request], Refused] {
    if !h.binds_sent {
        return Error(Busy(0u64))
    }
    match h.collecting {
        Unfenced => (),
        _ => return Error(Busy(0u64)),
    }
    h.collecting = Fencing
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, CollectBegin)
    Ok(take out)
}

fn fenced(mut h: Host, now: Now, mut out: List[launcher.Request]) {
    match h.collecting {
        Fencing => (),
        _ => return,
    }
    match catalog_roots(h, now.wall_ms / 1000u64) {
        Ok(roots) => list.push(mut out, Collect(clone(roots))),
        Error(why) => {
            h.collecting = FenceStuck(string.from(why))
        },
    }
}

// The collection roots, from one snapshot: each group's current and retained assemblies,
// NEW's assembly of each Preparing, Pending or Undecided deploy (OLD's is the group's
// current one, so both choices stay), and each unexpired recording pin's. A Failed or
// Installed row is history and roots nothing. A read error gives no roots at all.
fn catalog_roots(h: Host, now_s: u64) -> Result[List[Bytes], String] {
    let snap = store.snapshot(h.db)
    let mut roots: List[Bytes] = list.new()
    {
        let Ok(take scanned) = store.scan(snap, store.shape(h.t.groups), Unbounded, Unbounded) else {
            return Error("groups")
        }
        let mut rows = take scanned
        loop {
            match store.next(mut rows) {
                Ok(Some((_, g))) => {
                    list.push(mut roots, clone(g.assembly))
                    for kept in g.retained {
                        list.push(mut roots, clone(kept))
                    }
                },
                Ok(None) => break,
                Error(_) => return Error("groups"),
            }
        }
    }
    {
        let Ok(take scanned) = store.scan(snap, store.shape(h.t.deploys), Unbounded, Unbounded) else {
            return Error("deploys")
        }
        let mut rows = take scanned
        loop {
            match store.next(mut rows) {
                Ok(Some((_, d))) => match d.outcome {
                    Preparing => list.push(mut roots, clone(d.assembly)),
                    Pending => list.push(mut roots, clone(d.assembly)),
                    Undecided(_) => list.push(mut roots, clone(d.assembly)),
                    _ => (),
                },
                Ok(None) => break,
                Error(_) => return Error("deploys"),
            }
        }
    }
    {
        let Ok(take scanned) = store.scan(snap, store.shape(h.t.pins), Unbounded, Unbounded) else {
            return Error("pins")
        }
        let mut rows = take scanned
        loop {
            match store.next(mut rows) {
                Ok(Some((_, pin))) => {
                    if pin.expires > now_s {
                        list.push(mut roots, clone(pin.assembly))
                    }
                },
                Ok(None) => break,
                Error(_) => return Error("pins"),
            }
        }
    }
    Ok(take roots)
}

// A describe, preview or prepare child of a deploy: no store, listener or endpoint.
fn helper_launch(name: String, g: GroupRow, assembly: Bytes, take mode: launcher.Mode) -> launcher.Request {
    Start(launcher.Launch(group: group_of(name, g.incarnation), assembly: clone(assembly), workdir: string.from(g.workdir), args: list.new(), mode: take mode, recording: None))
}

fn prep_of(h: Host, name: String) -> Option[Prep] {
    clone(vol_read(h, name).prep)
}

fn set_prep(mut h: Host, name: String, take p: Option[Prep]) {
    let mut v = vol_read(h, name)
    v.prep = take p
    vol_put(mut h, name, take v)
}

fn is_helper(p: Prep, c: launcher.Child) -> bool {
    match p.helper {
        Some(k) => launcher.same_child(k, c),
        None => false
    }
}

fn copy_range(b: Bytes, from: u64, to: u64) -> Bytes {
    let mut out: Bytes = list.with_capacity(to - from)
    for i in from .. to {
        list.push(mut out, b[i])
    }
    out
}

// OLD's describe answer, a whole `runner.Describe`: the exact bytes of its exported list,
// which NEW's preview takes as its old list, and the list's length.
fn old_entries(b: Bytes) -> Option[(Bytes, u64)] {
    let mut at = 0u64
    let Ok(_) = std.codec.take_with(b, mut at, std.codec.of_bytes()) else {
        return None
    }
    let Ok(_) = std.codec.take_string(b, mut at) else {
        return None
    }
    let Ok(_) = std.codec.take_u64(b, mut at) else {
        return None
    }
    let from = at
    let ce: std.codec.Codec[runner.Exported] = std.codec.of()
    let Ok(exported) = std.codec.take_list(b, mut at, ce) else {
        return None
    }
    if at != list.len(b) {
        return None
    }
    Some((copy_range(b, from, at), list.len(exported)))
}

// NEW's preview answer, a whole `runner.Preview`, checked against the selected assembly
// (image digest, target and allowance), a 32-byte release and one answer per old entry.
// Gives NEW's exact Describe bytes and its release.
fn previewed(b: Bytes, p: Prep, count: u64) -> Result[(Bytes, Bytes), String] {
    let mut at = 0u64
    let Ok(digest) = std.codec.take_with(b, mut at, std.codec.of_bytes()) else {
        return Error("preview: a malformed answer")
    }
    let Ok(target) = std.codec.take_string(b, mut at) else {
        return Error("preview: a malformed answer")
    }
    let Ok(n_place) = std.codec.take_u64(b, mut at) else {
        return Error("preview: a malformed answer")
    }
    let ce: std.codec.Codec[runner.Exported] = std.codec.of()
    let Ok(_) = std.codec.take_list(b, mut at, ce) else {
        return Error("preview: a malformed answer")
    }
    let described = at
    let Ok(release) = std.codec.take_with(b, mut at, std.codec.of_bytes()) else {
        return Error("preview: a malformed answer")
    }
    let ca: std.codec.Codec[runner.Entry] = std.codec.of()
    let Ok(answers) = std.codec.take_list(b, mut at, ca) else {
        return Error("preview: a malformed answer")
    }
    if at != list.len(b) {
        return Error("preview: a malformed answer")
    }
    if digest != p.image || target != p.target || n_place != p.n_place {
        return Error("preview does not describe the selected assembly")
    }
    if list.len(release) != 32u64 {
        return Error("preview: the release is not 32 bytes")
    }
    if list.len(answers) != count {
        return Error("preview answer count")
    }
    Ok((copy_range(b, 0u64, described), release))
}

// An export directory name: nonempty ASCII letters, digits, `-` and `_`.
fn export_name(name: String) -> bool {
    let b = string.as_bytes(name)
    if list.len(b) == 0u64 {
        return false
    }
    for c in b {
        let ok = (c >= 48u8 && c <= 57u8) || (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 45u8 || c == 95u8
        if !ok {
            return false
        }
    }
    true
}

fn refusal_text(why: launcher.Refusal) -> String {
    match why {
        Held => "held",
        Retiring => "retiring",
        UnknownGroup => "unknown group",
        Mismatch => "mismatch",
        Image(e) => string.from(e),
        Spawn(e) => string.from(e),
        Unbuilt(e) => string.from(e),
    }
}

fn is_none[T](o: Option[T]) -> bool {
    match o {
        None => true,
        Some(_) => false
    }
}

fn joined(head: String, tail: String) -> String {
    let mut out = string.from(head)
    string.push(mut out, tail)
    out
}

// A Preparing deploy fails. Once OLD was sent its export, OLD is sent HostAbort for the
// attempt, and a live helper is stopped; the row stays Preparing until OLD answered
// PlaceAborted or ended and the helper ended, so a host lost before then aborts again.
// `old_live` is false when OLD's end is what failed it: its export ended with it.
fn prep_fail(mut h: Host, name: String, take p: Prep, why: String, old_live: bool, mut out: List[launcher.Request]) waits {
    let mut q = take p
    let exported = match q.stage {
        Describing => false,
        Previewing(_) => false,
        Aborting(_) => q.aborting,
        _ => true
    }
    let keep_why = match q.stage {
        Aborting(_) => true,
        _ => false
    }
    q.aborting = exported && old_live
    if q.aborting && !keep_why {
        list.push(mut out, Command(child_of(name, q.incarnation, q.old), HostAbort(attempt_bytes(q.attempt))))
    }
    if !keep_why {
        if let Some(c) = q.helper {
            list.push(mut out, Stop(clone(c)))
        }
        q.stage = Aborting(string.from(why))
    }
    prep_finish(mut h, name, take q)
}

// The abort is complete: the row records `Failed(why)` and the group may deploy again.
fn prep_finish(mut h: Host, name: String, take p: Prep) waits {
    let waiting = match p.helper {
        Some(_) => true,
        None => p.aborting
    }
    let failed: Option[String] = match p.stage {
        Aborting(w) => Some(string.from(w)),
        _ => None
    }
    let Some(why) = failed else {
        set_prep(mut h, name, Some(take p));
        return
    }
    if waiting {
        set_prep(mut h, name, Some(take p));
        return
    }
    let attempt = p.attempt
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            let Some(found_d) = st(store.fetch(tx, store.shape(t.deploys), name))? else {
                return Ok(())
            }
            let mut d = found_d
            let ours = match d.outcome {
                Preparing => d.attempt.hi == attempt.hi && d.attempt.lo == attempt.lo,
                _ => false
            }
            if !ours {
                return Ok(())
            }
            d.outcome = Failed(string.from(why))
            st(store.put(mut tx, t.deploys, name, d))
        })
    }
    if let Error(_) = decided(mut h.db, take made) {
        set_prep(mut h, name, Some(take p));
        return
    }
    set_prep(mut h, name, None)
}

// A helper child of a Preparing deploy answered on its standard output.
fn answered(mut h: Host, c: launcher.Child, said: Bytes, mut out: List[launcher.Request]) waits {
    let Some(g) = current(h, c) else {
        return
    }
    let name = string.from(c.group.name)
    let Some(found) = prep_of(h, name) else {
        return
    }
    let mut p = found
    if !is_helper(p, c) {
        return
    }
    match p.stage {
        Describing => match old_entries(said) {
            Some((entries, count)) => {
                let mode: launcher.Mode = PreviewMode(p.attempt, take entries)
                p.helper = Some(launcher.Child(group: clone(c.group), role: launcher.role_of(mode)))
                p.stage = Previewing(count)
                list.push(mut out, helper_launch(name, g, p.assembly, take mode))
                set_prep(mut h, name, Some(take p))
            },
            None => prep_fail(mut h, name, take p, "describe: OLD's answer is not a Describe", true, mut out),
        },
        Previewing(count) => match previewed(said, p, count) {
            Ok((describe, release)) => {
                p.describe = describe
                p.release = release
                p.helper = None
                p.stage = Exporting
                list.push(mut out, Command(child_of(name, p.incarnation, p.old), HostExport(attempt_bytes(p.attempt), false)))
                set_prep(mut h, name, Some(take p))
            },
            Error(why) => prep_fail(mut h, name, take p, why, true, mut out),
        },
        _ => set_prep(mut h, name, Some(take p)),
    }
}

// A helper child of a Preparing deploy ended (`why` its status) or was refused.
fn helper_done(mut h: Host, c: launcher.Child, succeeded: bool, why: String, mut out: List[launcher.Request]) waits {
    let name = string.from(c.group.name)
    let Some(found) = prep_of(h, name) else {
        return
    }
    let mut p = found
    if !is_helper(p, c) {
        return
    }
    p.helper = None
    match p.stage {
        PrepareRunning(head) => if succeeded {
            p.stage = Importing(head)
            list.push(mut out, Command(child_of(name, p.incarnation, p.old), HostImport(clone(p.describe), clone(p.release), clone(p.image))))
            set_prep(mut h, name, Some(take p))
        } else {
            prep_fail(mut h, name, take p, joined("prepare: ", why), true, mut out)
        },
        Describing => prep_fail(mut h, name, take p, joined("describe ended without an answer: ", why), true, mut out),
        Previewing(_) => prep_fail(mut h, name, take p, joined("preview ended without an answer: ", why), true, mut out),
        Aborting(_) => prep_finish(mut h, name, take p),
        _ => set_prep(mut h, name, Some(take p)),
    }
}

// OLD answered a command of a Preparing deploy. A notice, or an answer for another stage,
// changes nothing.
fn prep_placed(mut h: Host, name: String, take p: Prep, reply: runner.HostReply, mut out: List[launcher.Request]) waits {
    let mut q = take p
    match q.stage {
        Exporting => match reply {
            PlaceExported(head, export) => if export_name(export) {
                let Ok(Some(g)) = group_row(h, name) else {
                    prep_fail(mut h, name, take q, "the group changed before the cutover", true, mut out);
                    return
                }
                let mode: launcher.Mode = PrepareMode(q.attempt, string.from(export))
                q.helper = Some(launcher.Child(group: group_of(name, q.incarnation), role: launcher.role_of(mode)))
                q.stage = PrepareRunning(head)
                list.push(mut out, helper_launch(name, g, q.assembly, take mode))
                set_prep(mut h, name, Some(take q))
            } else {
                prep_fail(mut h, name, take q, "export: an invalid export name", true, mut out)
            },
            PlaceRefused(why) => prep_fail(mut h, name, take q, joined("export: ", why), true, mut out),
            _ => set_prep(mut h, name, Some(take q)),
        },
        Importing(head) => match reply {
            PlaceImported(digest) => if list.len(digest) == 32u64 {
                prep_pending(mut h, name, take q, head, digest, mut out)
            } else {
                prep_fail(mut h, name, take q, "import: a malformed prepared digest", true, mut out)
            },
            PlaceRefused(why) => prep_fail(mut h, name, take q, joined("import: ", why), true, mut out),
            _ => set_prep(mut h, name, Some(take q)),
        },
        Aborting(_) => match reply {
            PlaceAborted => {
                q.aborting = false
                prep_finish(mut h, name, take q)
            },
            _ => set_prep(mut h, name, Some(take q)),
        },
        _ => set_prep(mut h, name, Some(take q)),
    }
}

// OLD kept the import (ADVICE step 5): Pending replaces Preparing in one transaction that
// re-checks the attempt and `Dirty(g)`, allocates the candidate's gen c and records
// v = head + 1. Only then does the candidate start and OLD get the cutover.
fn prep_pending(mut h: Host, name: String, take p: Prep, head: u64, digest: Bytes, mut out: List[launcher.Request]) waits {
    let activation = head + 1u64
    let made = {
        let t = view h.t
        let q = view p
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(GroupRow, u64), Refused] {
            let Some(g) = st(store.fetch(tx, store.shape(t.groups), name))? else {
                return Error(Unknown)
            }
            if let Some(_) = g.retiring {
                return Error(Retiring)
            }
            if g.incarnation != q.incarnation {
                return Error(Unknown)
            }
            let Some(w) = st(store.fetch(tx, store.shape(t.wake), name))? else {
                return Error(Unknown)
            }
            let Dirty(a) = w.wake else {
                return Error(Busy(w.gen))
            }
            if a != q.old {
                return Error(Busy(a))
            }
            let Some(found_d) = st(store.fetch(tx, store.shape(t.deploys), name))? else {
                return Error(Missing("deploy"))
            }
            let mut d = found_d
            let ours = match d.outcome {
                Preparing => d.attempt.hi == q.attempt.hi && d.attempt.lo == q.attempt.lo,
                _ => false
            }
            if !ours {
                return Error(Missing("deploy"))
            }
            let c = w.gen + 1u64
            st(store.put(mut tx, t.wake, name, WakeRow(wake: Dirty(a), gen: c)))?
            d.digest = clone(digest)
            d.release = clone(q.release)
            d.activation = activation
            d.candidate = c
            d.outcome = Pending
            st(store.put(mut tx, t.deploys, name, d))?
            Ok((g, c))
        })
    }
    let (g, c) = match decided(mut h.db, take made) {
        Ok(found) => found,
        Error(_) => {
            prep_fail(mut h, name, take p, "the group changed before the cutover", true, mut out);
            return
        }
    }
    let Ok(cfg) = host_config(h) else {
        return
    }
    let cut = Cut(attempt: p.attempt, incarnation: g.incarnation, old: p.old, candidate: c, activation: activation, old_end: None, old_ended: false, opened: false, candidate_end: None, held: false, release: clone(p.release))
    let mut v = vol_read(h, name)
    v.cut = Some(cut)
    v.prep = None
    vol_put(mut h, name, take v)
    list.push(mut out, serving_launch(name, g, c, activation, p.assembly, cfg.idle_ms, Some(p.old)))
    list.push(mut out, cutover_command(name, g.incarnation, p.old, p.attempt, digest))
}

pub fn deploy_outcome(h: Host, name: String) -> Option[DeployOutcome] {
    match store.get(store.snapshot(h.db), store.shape(h.t.deploys), name) {
        Ok(Some(take d)) => {
            let DeployRow(outcome: take o, ..) = take d;
            Some(take o)
        },
        _ => None
    }
}

fn drop_rows(mut tx: store.Tx, t: Tables, name: String, g: GroupRow, due: Option[u64], dirty: bool, disposition: Disposition) -> Result[(), Refused] {
    let _ = st(store.delete(mut tx, t.groups, name))?
    let _ = st(store.delete(mut tx, t.wake, name))?
    let _ = st(store.delete(mut tx, t.deploys, name))?
    if let Some(at) = due {
        let _ = st(store.delete(mut tx, t.due, DueKey(at: at, name: string.from(name))))?
    }
    let mut u = usage_of(tx, t, g.tenant)?
    u.groups -= 1u64
    if dirty {
        let _ = st(store.delete(mut tx, t.dirty, name))?
        let mut meta = meta_of(tx, t)?
        meta.dirty -= 1u64
        st(store.put(mut tx, t.meta, 0u64, meta))?
        u.live -= 1u64
    }
    st(store.put(mut tx, t.usage, g.tenant, u))?
    st(store.put(mut tx, t.retired, name, Retired(workdir: string.from(g.workdir), disposition: disposition)))
}

// Removes a group (§14.5 "Removing a group"): a Clean one at once; a Dirty one, failing or
// not, is retired: a durable mark, then `Retire`, then one transaction at `Retired`.
pub fn remove(mut h: Host, name: String, disposition: Disposition) -> Result[List[launcher.Request], Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(GroupRow, bool), Refused] {
            let Some(found_g) = st(store.fetch(tx, store.shape(t.groups), name))? else {
                return Error(Unknown)
            }
            let mut g = found_g
            if let Some(_) = g.retiring {
                return Error(Retiring)
            }
            let Some(w) = st(store.fetch(tx, store.shape(t.wake), name))? else {
                return Error(Unknown)
            }
            match w.wake {
                Clean(due) => {
                    drop_rows(mut tx, t, name, g, due, false, disposition)?
                    Ok((g, true))
                },
                Dirty(_) => {
                    g.retiring = Some(disposition)
                    st(store.put(mut tx, t.groups, name, g))?
                    Ok((g, false))
                },
            }
        })
    }
    let (g, gone) = decided(mut h.db, take made)?
    dequeue(mut h, name)
    let mut out: List[launcher.Request] = list.new()
    let mut v = vol_read(h, name)
    if let Some(a) = running_admission(v) {
        list.push(mut out, Release(a))
        v.admit = None
        vol_put(mut h, name, take v)
    }
    if gone {
        let _ = map.remove(mut h.vol, name)
        list.push(mut out, Close(group_of(name, g.incarnation)))
    } else {
        list.push(mut out, Retire(group_of(name, g.incarnation)))
    }
    Ok(take out)
}

fn finish_retire(mut h: Host, grp: launcher.Group, now: Now, mut out: List[launcher.Request]) waits {
    let Ok(Some(g)) = group_row(h, grp.name) else {
        return
    }
    if g.incarnation != grp.incarnation {
        return
    }
    let Some(disposition) = g.retiring else {
        return
    }
    let name = string.from(grp.name)
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            drop_rows(mut tx, t, name, g, None, true, disposition)
        })
    }
    if let Error(_) = decided(mut h.db, take made) {
        return
    }
    let _ = map.remove(mut h.vol, name)
    list.push(mut out, Close(clone(grp)))
    retry_queue(mut h, now, mut out)
}

// Makes a recording pin durable. The host calls this before it starts the recorded
// serving process, so a recording never runs without the pin that names its assembly.
pub fn keep_pin(mut h: Host, id: Bytes, assembly: Bytes, expires: u64) -> Result[(), Refused] waits {
    if list.len(id) != 16u64 {
        return Error(Missing("recording id"))
    }
    if list.len(assembly) != 32u64 {
        return Error(Missing("assembly"))
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            st(store.put(mut tx, t.pins, id, Pin(assembly: clone(assembly), expires: expires)))
        })
    }
    decided(mut h.db, take made)
}

// An operator removes a recording pin. Replay of that recording then finds it `Gone`, even
// while another root keeps its image.
pub fn forget_pin(mut h: Host, id: Bytes) -> Result[(), Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
            let _ = st(store.delete(mut tx, t.pins, id))?
            Ok(())
        })
    }
    decided(mut h.db, take made)
}

// The pin lookup replay makes first (launch.md "Host assembly"): `Found(assembly)` while
// `now` is before the expiry, in Unix seconds, and `Gone` from the expiry on or when no
// pin exists. A store error is an error, never `Gone`.
pub fn resolve_pin(h: Host, id: Bytes, now: u64) -> Result[Resolved, Refused] {
    match st(store.get(store.snapshot(h.db), store.shape(h.t.pins), id))? {
        Some(p) if now < p.expires => Ok(Found(clone(p.assembly))),
        _ => Ok(Gone),
    }
}

pub fn retirement(h: Host, name: String) -> Option[Retired] {
    match store.get(store.snapshot(h.db), store.shape(h.t.retired), name) {
        Ok(Some(r)) => Some(r),
        _ => None
    }
}

pub fn status(h: Host) -> Status {
    let mut dirty = 0u64
    let mut max_places = 0u64
    if let Ok(Some(m)) = store.get(store.snapshot(h.db), store.shape(h.t.meta), 0u64) {
        dirty = m.dirty
    }
    if let Ok(Some(c)) = store.get(store.snapshot(h.db), store.shape(h.t.config), 0u64) {
        max_places = c.max_places
    }
    let mut failing: List[Failing] = list.new()
    for (name, v) in h.vol {
        if v.failing {
            list.push(mut failing, Failing(name: string.from(name), count: v.count, retry_at: v.retry_at, last: string.from(v.last)))
        }
    }
    let queued: List[Queued] = clone(h.queue)
    Status(dirty: dirty, max_places: max_places, probes: h.probes, due_wakes: h.due_wakes, arrival_wakes: h.arrival_wakes, queued: take queued, failing: take failing)
}

// The host's driver (§14.3 "Due times", §14.5): one queue of inputs, in which the
// launcher's events arrive in stream order beside the due-time and backoff alarms. The
// driver owns both waits: after every input it re-arms each on the host's current timer,
// one absolute wall-time alarm on the minimum of the due index without the queued rows and
// one monotonic alarm on the earliest backoff retry, and none where there is none. There is
// no polling: nothing wakes the host before either minimum.
pub type Input: send = Got(launcher.Event) | DueAt(u64) | RetryAt(u64) | Lost

type Armed {
    at: u64,
    waiting: Task[()]
}

pub opaque type Driver {
    wall: Option[Armed],
    mono: Option[Armed],
    tasks: Tasks,
    clock: Clock,
    to: Sender[Input]
}

pub fn driver(tasks: Tasks, c: Clock, take to: Sender[Input]) -> Driver {
    Driver(wall: None, mono: None, tasks: tasks, clock: c, to: take to)
}

// What each wait is armed on.
pub fn armed(d: Driver) -> Timers {
    let wall = match d.wall {
        Some(a) => Some(a.at),
        None => None
    }
    let mono = match d.mono {
        Some(a) => Some(a.at),
        None => None
    }
    Timers(wall_ms: wall, mono_ns: mono)
}

// Applies one input and re-arms both waits. A due or retry alarm is a tick at `now`.
pub fn step(mut h: Host, mut d: Driver, take input: Input, now: Now) -> List[launcher.Request] waits {
    let out = match take input {
        Got(take e) => event(mut h, take e, now),
        DueAt(_) => tick(mut h, now),
        RetryAt(_) => tick(mut h, now),
        Lost => list.new(),
    }
    settle(mut d, h)
    take out
}

// Re-arms both waits on the host's timers; the driver calls it after every input, and an
// operator's request calls it after its commit.
pub fn settle(mut d: Driver, h: Host) waits {
    let want = timers(h)
    let wall = replace(mut d.wall, None)
    d.wall = arm(take wall, want.wall_ms)
    if let None = d.wall {
        if let Some(at) = want.wall_ms {
            let waiting = std.clock.wall_alarm(d.tasks, d.clock, at, d.to, DueAt(at))
            d.wall = Some(Armed(at: at, waiting: take waiting))
        }
    }
    let mono = replace(mut d.mono, None)
    d.mono = arm(take mono, want.mono_ns)
    if let None = d.mono {
        if let Some(at) = want.mono_ns {
            let waiting = std.clock.alarm(d.tasks, d.clock, at, d.to, RetryAt(at))
            d.mono = Some(Armed(at: at, waiting: take waiting))
        }
    }
}

// Keeps a wait already armed on `want`, and cancels any other.
fn arm(take prior: Option[Armed], want: Option[u64]) -> Option[Armed] waits {
    let Some(take held) = take prior else {
        return None
    }
    if Some(held.at) == want {
        return Some(take held)
    }
    let Armed(at: _, waiting: take running) = take held
    let _ = task.cancel_join(take running)
    None
}

pub fn stop(take d: Driver) waits {
    let Driver(wall: take wall, mono: take mono, ..) = take d
    let _ = arm(take wall, None)
    let _ = arm(take mono, None)
}

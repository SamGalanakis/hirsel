// LANG-6, OWN-7, OWN-16: the view-join matrix for `match`: each carrier and
// position, c == 1 selecting the first arm. a is Mark 1, b Mark 2; a selected
// temporary (3 or 4) ends before the locals b, a, so each Mark is finalized
// once, and every run admits nothing at its end.
// expect: run arg_temp(1) = 3 trace 3,2,1
// expect: run arg_temp(0) = 4 trace 4,2,1
// expect: run arg_local(1) = 1 trace 2,1
// expect: run arg_local(0) = 2 trace 2,1
// expect: run let_temp(1) = 6 trace 3,2,1
// expect: run let_temp(0) = 8 trace 4,2,1
// expect: run field(1) = 1 trace 2,1
// expect: run field(0) = 4 trace 4,2,1
// expect: run holder(1) = 1 trace 2,1
// expect: run holder(0) = 4 trace 4,2,1
// expect: run two(1) = 13 trace 3,2,1
// expect: run two(0) = 42 trace 4,2,1
// expect: run option(1) = 1 trace 2,1
// expect: run option(0) = 4 trace 4,2,1
// expect: run pair(1) = 15 trace 2,1
// expect: run pair(0) = 46 trace 4,2,1
resource type Mark {
    id: u64
} drop(m) {
    let _ = m.id
}

scoped type Holder {
    m: View[Mark]
}

fn id_of(m: Mark) -> u64 {
    m.id
}

fn me(m: Mark) -> View[Mark] in m {
    view m
}

fn mk(i: u64) -> Mark {
    result.unwrap(Mark(id: i))
}

fn made(s: String) -> String {
    string.from(s)
}

fn last_byte(b: Bytes) -> u64 {
    int.widen(b[list.len(b) - 1u64])
}

fn both(x: Mark, y: Mark) -> u64 {
    x.id * 10 + y.id
}

fn pick(c: u64) -> Option[u64] {
    if c == 1 {
        Some(c)
    } else {
        None
    }
}

fn arg_temp(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let k = c
    id_of(match k {
        1 => me(mk(3)),
        _ => me(mk(4))
    })
}

fn arg_local(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let k = c
    id_of(match k {
        1 => me(a),
        _ => me(b)
    })
}

fn let_temp(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let k = c
    let v = match k {
        1 => me(mk(3)),
        _ => me(mk(4))
    }
    id_of(v) + id_of(v)
}

fn field(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let k = c
    (match k {
        1 => view a,
        _ => me(mk(4))
    }).id
}

fn holder(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let k = c
    let h = Holder(m: match k {
        1 => view a,
        _ => me(mk(4))
    })
    id_of(h.m)
}

fn two(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let k = c
    both(match k {
        1 => view a,
        _ => me(mk(4))
    }, match k {
        1 => me(mk(3)),
        _ => view b
    })
}

fn option(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let k = c
    let o = match k {
        1 => Some(view a),
        _ => Some(me(mk(4)))
    }
    match o {
        Some(m) => id_of(m),
        None => 0
    }
}

fn pair(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let k = c
    let t = match k {
        1 => (view a, 5u64),
        _ => (me(mk(4)), 6u64)
    }
    id_of(t.0) * 10 + t.1
}

// rule: STORE-3
// expect: reject RUN-3 at line 9
// twin: STORE/STORE-3-body-capture-ok.hir
// A transaction body is an entry: it holds its Tx and data, and a closure
// capturing the store's Dir to write outside the store is not one.
pub fn note(mut s: store.Store[Dir], d: Dir) -> Result[(), store.TxFailure[FileError]] {
  store.transact(
    mut s,
    fn(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[(), FileError] {
      file.write_bytes(d, path.of("side"), b"effect")?
      let _ = store.tx_put(mut tx, b"k", b"v")
      Ok(())
    },
    ()
  )
}

// LANG-6, OWN-8: a `break` value is its frame's value, as a block's tail is, so a
// temporary it reaches lives as long as that value, not just to the break. Each Mark
// is finalized once: the let-held temporary 3 at the body's end, before the locals
// b (2) and a (1). An exit that cleaned the temporary leaves `v` viewing a freed block.
// loop_temp: id_of(v) twice = 6. byte_view / nested: last byte of "abc" = 99.
// labelled, loop_if, match_arm: c == 1 breaks `view a` (1, no temporary made);
// otherwise the temporary 3. option_temp: Some(me(mk(3))) carried, 3.
// expect: run loop_temp(0) = 6 trace 3,2,1
// expect: run byte_view(0) = 99
// expect: run nested(0) = 99
// expect: run labelled(0) = 3 trace 3,2,1
// expect: run labelled(1) = 1 trace 2,1
// expect: run loop_if(0) = 3 trace 3,2,1
// expect: run loop_if(1) = 1 trace 2,1
// expect: run match_arm(0) = 3 trace 3,2,1
// expect: run match_arm(1) = 1 trace 2,1
// expect: run option_temp(0) = 3 trace 3,2,1
// two_sites / two_sites_block: two breaks carry one temporary, cleaned once: 3; trace 3,1.
// expect: run two_sites(1) = 3 trace 3,1
// expect: run two_sites(0) = 3 trace 3,1
// expect: run two_sites_block(1) = 3 trace 3,1
// expect: run two_sites_block(0) = 3 trace 3,1
// counted: an iteration that does not break cleans its own w's 3, then m's 4; the
// breaking one cleans m's 4 on the edge and carries its 3 to the body's end, before a.
// expect: run counted(0) = 3 trace 4,3,1
// expect: run counted(1) = 3 trace 3,4,4,3,1
resource type Mark {
    id: u64
} drop(m) {
    let _ = m.id
}

fn id_of(m: Mark) -> u64 {
    m.id
}

fn me(m: Mark) -> View[Mark] in m {
    view m
}

fn mk(i: u64) -> Mark {
    result.unwrap(Mark(id: i))
}

fn made(s: String) -> String {
    string.from(s)
}

fn last_byte(b: Bytes) -> u64 {
    int.widen(b[list.len(b) - 1u64])
}

fn loop_temp(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let v = loop {
        break me(mk(3))
    }
    id_of(v) + id_of(v)
}

fn byte_view(c: u64) -> u64 {
    let v = loop {
        break string.as_bytes(made("abc"))
    }
    last_byte(v)
}

fn nested(c: u64) -> u64 {
    let v = 'outer: loop {
        loop {
            break 'outer string.as_bytes(made("abc"))
        }
    }
    last_byte(v)
}

fn labelled(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let v = 'done: {
        if c == 1 {
            break 'done view a
        }
        break 'done me(mk(3))
    }
    id_of(v)
}

fn loop_if(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let v = loop {
        if c == 1 {
            break view a
        }
        break me(mk(3))
    }
    id_of(v)
}

fn match_arm(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let v = loop {
        match c {
            1 => break view a,
            _ => break me(mk(3))
        }
    }
    id_of(v)
}

fn option_temp(c: u64) -> u64 {
    let a = mk(1)
    let b = mk(2)
    let o = loop {
        break Some(me(mk(3)))
    }
    match o {
        Some(m) => id_of(m),
        None => 0
    }
}

fn two_sites(c: u64) -> u64 {
    let a = mk(1)
    let v = loop {
        let w = me(mk(3))
        if c == 1 {
            break w
        }
        break w
    }
    id_of(v)
}

fn two_sites_block(c: u64) -> u64 {
    let a = mk(1)
    let v = loop {
        let w = {
            me(mk(3))
        }
        if c == 1 {
            break w
        }
        break w
    }
    id_of(v)
}

fn counted(c: u64) -> u64 {
    let a = mk(1)
    let mut n = 0u64
    let v = loop {
        let m = mk(4)
        let w = me(mk(3))
        if n == c {
            break w
        }
        n = n + 1
    }
    id_of(v)
}

// kostya/LangArena 3c9f84d benchmarks/distance.rs:31-243.
// Byte matching is upstream's representation; generated strings are ASCII.
fn random_string(mut g:helper.Lcg,n:i32)->Result[String,helper.Error] {
    let mut s=helper.mem(string.with_capacity(int.narrow(n)))?
    for _ in 0 .. n {
        let digit:u32=int.narrow(helper.next_int(mut g,10))
        let code:u32=97+digit
        helper.mem(string.push_char(mut s,option.unwrap(char.from_u32(code))))?
    }
    Ok(take s)
}
fn jaro(a:String,b:String)->Result[f64,helper.Error] {
    let x=string.as_bytes(a)
    let y=string.as_bytes(b)
    let n=list.len(x)
    let m=list.len(y)
    if n==0 || m==0 {return Ok(0.0)}
    let half=(if n>m {n} else {m})/2
    let distance=if half>0 {half-1} else {0}
    let mut xm:List[bool]=list.new()
    let mut ym:List[bool]=list.new()
    helper.mem(list.fill(mut xm,n,false))?
    helper.mem(list.fill(mut ym,m,false))?
    let mut matches:u64=0
    for i in 0 .. n {
        let start=if i>distance {i-distance} else {0}
        let end=if i+distance<m-1 {i+distance} else {m-1}
        for j in start .. end+1 {
            if !ym[j] && x[i]==y[j] {xm[i]=true;ym[j]=true;matches+=1;break}
        }
    }
    if matches==0 {return Ok(0.0)}
    let mut transpositions:u64=0
    let mut k:u64=0
    for i in 0 .. n {
        if xm[i] {
            while k<m && !ym[k] {k+=1}
            if k<m {if x[i]!=y[k] {transpositions+=1};k+=1}
        }
    }
    transpositions/=2
    let count:f64=float.from_int(matches)
    let nf:f64=float.from_int(n)
    let mf:f64=float.from_int(m)
    let tf:f64=float.from_int(transpositions)
    Ok((count/nf+count/mf+(count-tf)/count)/3.0)
}
fn gram(b:Bytes,i:u64)->u32 {
    let a:u32=int.widen(b[i])
    let c:u32=int.widen(b[i+1])
    let d:u32=int.widen(b[i+2])
    let e:u32=int.widen(b[i+3])
    (a<<24u32)|(c<<16u32)|(d<<8u32)|e
}
fn bump(mut counts:Map[u32,u64],key:u32)->Result[u64,helper.Error] {
    let old=map.get_or(counts,key,0u64)
    if old==0 {
        helper.mem(result.capacity_only(map.insert(mut counts,key,1u64)))?
    } else {let _=map.set(mut counts,key,old+1)}
    Ok(old+1)
}
fn ngram(a:String,b:String)->Result[f64,helper.Error] {
    let x=string.as_bytes(a)
    let y=string.as_bytes(b)
    let n=list.len(x)
    let m=list.len(y)
    if n<4 || m<4 {return Ok(0.0)}
    let mut first:Map[u32,u64]=map.new()
    let mut second:Map[u32,u64]=map.new()
    for i in 0 .. n-3 {let _=bump(mut first,gram(x,i))?}
    let mut intersection:u64=0
    for i in 0 .. m-3 {
        let key=gram(y,i)
        let count=bump(mut second,key)?
        if count<=map.get_or(first,key,0u64) {intersection+=1}
    }
    let total=map.len(first)+map.len(second)
    let numerator:f64=float.from_int(intersection)
    let denominator:f64=float.from_int(total)
    Ok(if total>0 {numerator/denominator} else {0.0})
}
pub fn dispatch(config:String,name:String,warmup:u64,iterations:u64)->Result[u32,helper.Error] {
    if name!="Distance::Jaro" && name!="Distance::NGram" {return Error(UnknownTask)}
    let count=helper.config_i64(config,name,"count")?
    let size=helper.config_i64(config,name,"size")?
    if count<0 || size<=0 || size>2147483643 {return Error(Config)}
    let mut g=helper.lcg()
    let mut pairs:List[(String,String)]=helper.mem(list.with_capacity(int.narrow(count)))?
    for _ in 0 .. count {
        let n=helper.next_int(mut g,int.narrow(size))+4
        let m=helper.next_int(mut g,int.narrow(size))+4
        let a=random_string(mut g,n)?
        let b=random_string(mut g,m)?
        match list.push(mut pairs,(take a,take b)) {Ok(())=>{},Error((c,_))=>return Error(Capacity(c))}
    }
    let mut checksum:u32=0
    for _ in 0 .. warmup+iterations {
        for (a,b) in pairs {
            let score=if name=="Distance::Jaro" {jaro(a,b)?} else {ngram(a,b)?}
            let converted:Result[u32,FloatError]=float.to_int(score*1000.0)
            checksum=int.wrapping_add(checksum,result.unwrap(converted))
        }
    }
    Ok(checksum)
}
pub fn main(out:Stdout,d:Dir,argv:Args)->Result[(),Exit] waits {
    harness.main(out,d,argv,fn(c:String,n:String,w:u64,i:u64)->Result[u32,helper.Error] {dispatch(c,n,w,i)})
}

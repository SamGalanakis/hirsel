// KS5 real-host node binary for law K10 `three_node_room_on_boat` (docs/spec/sfu_cascade.md).
//
// Runs a real Hirsel SFU cascade node (`single`, `home`, or `edge`) over real OS UDP
// sockets using `webrtc_sfu.router` (Unit 0) + `webrtc_sfu.cascade.CascadeAdapter` (Unit 1)
// + `webrtc_sfu.cascade.LinkHub` (QUIC mutual-pin star links, zero-copy `PayloadSlice`,
// RTC-4 Sender Reports, CAS-5 leases, CAS-7 ordered reattach).
//
// Usage:
//   k10-node single <p_count> <duration_ms>
//   k10-node home <bind_ip:port> <p_start> <p_count> <total> <duration_ms> (<edge_name> <edge_pin_hex>)...
//   k10-node edge <bind_ip:port> <home_ip:port> <node_name> <p_start> <p_count> <total> <duration_ms> <home_pin_hex>
const MS: u64 = 1000000

const SECOND: u64 = 1000000000

const K10_ROOM: webrtc_sfu.peer.RoomId = RoomId(1)

fn room_name() -> Bytes {
    b"room-k10"
}

const SOCKET_OPTS: UdpOptions = UdpOptions(slots: 128, slot_bytes: 2048)

const HIST_BUCKETS: u64 = 5001

const BUCKET_US: u64 = 100

type LatencyHist {
    buckets: List[u64],
    count: u64,
    max_us: u64
}

fn new_hist() -> LatencyHist {
    let mut b: List[u64] = list.with_capacity(HIST_BUCKETS)
    list.fill(mut b, HIST_BUCKETS, 0u64)
    LatencyHist(buckets: take b, count: 0, max_us: 0)
}

fn hist_add(mut h: LatencyHist, lat_us: u64) {
    let idx = order.min(lat_us / BUCKET_US, HIST_BUCKETS - 1)
    h.buckets[idx] += 1
    h.count += 1
    if lat_us > h.max_us {
        h.max_us = lat_us
    }
}

fn hist_quantile_us(h: LatencyHist, num: u64, den: u64) -> u64 {
    if h.count == 0 {
        return 0
    }
    let target = (h.count * num + den - 1) / den
    let mut acc = 0u64
    for i in 0u64 .. HIST_BUCKETS {
        acc += h.buckets[i]
        if acc >= target {
            return i * BUCKET_US
        }
    }
    h.max_us
}

fn say(out: Stdout, text: String) waits {
    let mut line = string.from(text)
    string.push(mut line, "\n")
    let _ = stdout.write(out, line)
}

fn parse_addr(text: String) -> Option[Addr] {
    let Some((ip_s, port_s)) = std.string.split_once(text, ":") else {
        return None
    }
    let Some(ip) = std.ingress_policy.parse_ip(ip_s) else {
        return None
    }
    let Ok(port) = (int.parse(port_s) : Result[u16, ParseError]) else {
        return None
    }
    Some(Addr(ip: ip, port: port))
}

fn parse_u64_arg(a: Args, idx: u64) -> u64 {
    let Some(v) = args.get(a, idx) else {
        fail("missing integer argument")
    }
    let Ok(n) = (int.parse(v) : Result[u64, ParseError]) else {
        fail("invalid integer argument")
    }
    n
}

fn str_arg(a: Args, idx: u64) -> String {
    let Some(v) = args.get(a, idx) else {
        fail("missing string argument")
    }
    string.from(v)
}

fn parse_pin(hex_text: String) -> quic.handshake.Pin {
    let digest = option.unwrap(std.hex.decode(string.as_bytes(hex_text)))
    let mut d: Inline[u8, 32] =[0; 32]
    for i in 0u64 .. 32 {
        d[i] = digest[i]
    }
    Cert(d)
}

fn load_identity(dir: Dir) -> quic.handshake.Identity waits {
    let cert = result.unwrap(std.file.read(dir, "cert.der"))
    let key_bytes = result.unwrap(std.file.read(dir, "key.der"))
    let key = result.unwrap(secret.seal(take key_bytes, "sign(p256)"))
    let mut chain: List[Bytes] = list.with_capacity(1)
    list.push(mut chain, take cert)
    Identity(chain: take chain, key: take key, alg: P256)
}

fn k10_room_limits() -> webrtc_sfu.router.RoomLimits {
    webrtc_sfu.router.RoomLimits(participants: 64, ids: 64, publications: 64, down_tracks: 1024, audio_forward: 0, pause_delay_ms: 5000, pause: false)
}

fn make_canon_rtp(codec: webrtc_sfu.sdp.Codec, seq: u16, ts: u32, ssrc: u32, payload_len: u64) -> Bytes {
    let mut out: Bytes = list.with_capacity(12 + payload_len)
    let w = rtp.ext.writer()
    let _ = result.unwrap(rtp.header.write(rtp.header.Fields(marker: true, pt: webrtc_sfu.cascade.canon_pt(codec), seq: seq, ts: ts, ssrc: ssrc), view w, mut out))
    list.fill(mut out, payload_len, 0x90u8)
    take out
}

fn audio_clock_pair(mono_ns: u64) -> (u32, u32, u32) {
    let secs = mono_ns / SECOND
    let rem_ns = mono_ns % SECOND
    let ntp_hi: u32 = int.narrow(secs & 0xffffffffu64)
    let ntp_lo: u32 = int.narrow((rem_ns << 32u64) / SECOND)
    let rtp_ts: u32 = int.narrow(((mono_ns / 1000u64) * 48u64 / 1000u64) & 0xffffffffu64)
    (ntp_hi, ntp_lo, rtp_ts)
}

fn audio_latency_us(sr: webrtc_sfu.cascade.SrTiming, rtp_ts: u32, recv_ns: u64) -> u64 {
    let sr_secs: u64 = int.widen(sr.ntp_hi)
    let sr_frac: u64 = int.widen(sr.ntp_lo)
    let sr_ns = sr_secs * SECOND + ((sr_frac * SECOND) >> 32u64)
    let diff_u32: u32 = int.wrapping_sub(rtp_ts, sr.rtp_ts)
    let send_ns = if diff_u32 < 0x80000000u32 {
        let ticks: u64 = int.widen(diff_u32)
        sr_ns + (ticks * 1000000u64) / 48u64
    } else {
        let back: u64 = int.widen(int.wrapping_sub(0u32, diff_u32))
        int.saturating_sub(sr_ns, (back * 1000000u64) / 48u64)
    }
    if recv_ns >= send_ns {
        (recv_ns - send_ns) / 1000u64
    } else {
        0u64
    }
}

type NodeMetrics {
    p_start: u64,
    p_count: u64,
    total: u64,
    audio_seen: List[bool],
    video_seen: List[bool],
    audio_pkts: u64,
    video_pkts: u64,
    all_hist: LatencyHist,
    remote_hist: LatencyHist
}

fn new_metrics(p_start: u64, p_count: u64, total: u64) -> NodeMetrics {
    let n = p_count * total
    let mut a: List[bool] = list.with_capacity(n)
    list.fill(mut a, n, false)
    let mut v: List[bool] = list.with_capacity(n)
    list.fill(mut v, n, false)
    NodeMetrics(p_start: p_start, p_count: p_count, total: total, audio_seen: take a, video_seen: take v, audio_pkts: 0, video_pkts: 0, all_hist: new_hist(), remote_hist: new_hist())
}

type K10Node {
    r: webrtc_sfu.router.Router,
    a: webrtc_sfu.cascade.CascadeAdapter,
    obs2: webrtc_sfu.router.Observer,
    out: webrtc_sfu.peer.Outbox,
    empty: Shared[Bytes],
    seq: u64,
    p_start: u64,
    p_count: u64,
    total: u64,
    // Per local participant offset `0..p_count`: (audio_pub_id, video_pub_id).
    local_pubs: List[(webrtc_sfu.router.PublicationId, webrtc_sfu.router.PublicationId)],
    // Tracks which publications Unit 2 has already subscribed every local participant to.
    subbed_pubs: List[webrtc_sfu.router.PublicationId]
}

fn new_k10_node(random: Random, nid: webrtc_sfu.cascade.NodeId, lim: webrtc_sfu.cascade.LinkLimits, p_start: u64, p_count: u64, total: u64) -> K10Node {
    let empty: Bytes = list.new()
    K10Node(r: webrtc_sfu.router.on_unit(random, 0), a: webrtc_sfu.cascade.cascade_adapter(1, nid, lim), obs2: webrtc_sfu.router.new_observer(2), out: result.unwrap(webrtc_sfu.peer.outbox(262144, 256)), empty: shared.new(take empty), seq: 0, p_start: p_start, p_count: p_count, total: total, local_pubs: list.new(), subbed_pubs: list.new())
}

fn k10_apply(mut n: K10Node, mut hub: webrtc_sfu.cascade.LinkHub, now_ns: u64, c: webrtc_sfu.router.Change) -> Result[webrtc_sfu.router.Answer, webrtc_sfu.router.RouterError] {
    let ans = webrtc_sfu.router.apply(mut n.r, now_ns, c, mut n.out)?
    let resolved: webrtc_sfu.router.Change = match c {
        PublishRemote(room: room, who: who, section: sec, id: _, shape: sh, via: via) => match ans {
            Shaped(id: assigned, shape: _) => PublishRemote(room: room, who: who, section: sec, id: assigned, shape: sh, via: via),
            _ => c,
        },
        other => other,
    }
    n.seq += 1
    let seq = n.seq
    let _ = webrtc_sfu.cascade.control(mut n.a, mut hub, now_ns, Order(room: K10_ROOM, seq: seq, change: resolved))
    let _ = webrtc_sfu.router.observer_apply(mut n.obs2, K10_ROOM, seq, resolved)
    Ok(ans)
}

fn pub_is_subbed(n: K10Node, id: webrtc_sfu.router.PublicationId) -> bool {
    for p in n.subbed_pubs {
        if p == id {
            return true
        }
    }
    false
}

// Subscribe every local participant (except the publication's own owner) to any new publication
// appearing in `obs2`, and push Unit 2's `Carry.Wanted` mask into `n.r`.
fn k10_sync_subscriptions(mut n: K10Node, mut hub: webrtc_sfu.cascade.LinkHub, now_ns: u64) {
    let pubs = webrtc_sfu.router.observer_publications(n.obs2, K10_ROOM)
    for (pub_id, info) in pubs {
        if pub_is_subbed(n, pub_id) {
            continue
        }
        list.push(mut n.subbed_pubs, pub_id)
        let Gen(id: owner_id, epoch: _) = info.owner
        let mut any = false
        for off in 0u64 .. n.p_count {
            let sub_id = n.p_start + off
            if sub_id == owner_id {
                continue
            }
            let sub: webrtc_sfu.peer.Gen = Gen(id: sub_id, epoch: 1)
            let target: webrtc_sfu.router.Target = Layer(encoding: 0, spatial: 0, temporal: 0)
            let _ = k10_apply(mut n, mut hub, now_ns, Subscribe(room: K10_ROOM, who: sub, p: pub_id, section: 0, target: target))
            any = true
        }
        if any {
            let carried = webrtc_sfu.router.Carried(carry: Wanted(room: K10_ROOM, publication: pub_id, src: info.owner, unit: 2, mask: 1), packet: shared.share(n.empty))
            let _ = webrtc_sfu.router.accept(mut n.r, now_ns, take carried, mut n.out)
        }
    }
}

fn k10_pump(mut n: K10Node, mut hub: webrtc_sfu.cascade.LinkHub, mut m: NodeMetrics, local_srs: List[Option[webrtc_sfu.cascade.SrTiming]], now_ns: u64, measure: bool) {
    for _ in 0u64 .. 16 {
        let mut progressed = false
        let changes = webrtc_sfu.cascade.take_changes(mut n.a)
        if list.len(changes) != 0 {
            progressed = true
            for c in changes {
                let _ = k10_apply(mut n, mut hub, now_ns, c)
            }
            k10_sync_subscriptions(mut n, mut hub, now_ns)
        }
        let posts_a = webrtc_sfu.cascade.take_posts(mut n.a)
        if list.len(posts_a) != 0 {
            progressed = true
            for take p in take posts_a {
                let webrtc_sfu.router.Post(to: to, carried: take carried) = take p
                if to == 0 {
                    let _ = webrtc_sfu.router.accept(mut n.r, now_ns, take carried, mut n.out)
                }
            }
        }
        let posts_r = webrtc_sfu.router.take_posts(mut n.r)
        if list.len(posts_r) != 0 {
            progressed = true
            for take p in take posts_r {
                let webrtc_sfu.router.Post(to: to, carried: take carried) = take p
                if to == 1 {
                    webrtc_sfu.cascade.carried(mut n.a, mut hub, now_ns, take carried)
                } else if to == 2 {
                    let webrtc_sfu.router.Carried(carry: take carry, packet: _) = take carried
                    if let Media(room: _, publication: pub_id, src: src, m: media, ..) = take carry {
                        record_media_delivery(mut m, n, local_srs, pub_id, src, media.ts, now_ns, measure)
                    }
                }
            }
        }
        if !progressed {
            break
        }
    }
}

fn record_media_delivery(mut m: NodeMetrics, n: K10Node, local_srs: List[Option[webrtc_sfu.cascade.SrTiming]], pub_id: webrtc_sfu.router.PublicationId, src: webrtc_sfu.peer.Gen, ts: u32, recv_ns: u64, measure: bool) {
    let Some(info) = webrtc_sfu.router.observer_publication(n.obs2, K10_ROOM, pub_id) else {
        return
    }
    let is_audio = info.shape.codec == Opus
    let Gen(id: sender, epoch: src_ep) = src
    if sender == 0 || sender > m.total {
        return
    }
    let is_local = sender >= m.p_start && sender < m.p_start + m.p_count
    let sr_opt = if is_audio && measure {
        if is_local {
            local_srs[sender - m.p_start]
        } else {
            let key = webrtc_sfu.cascade.PubKey(participant: sender, epoch: src_ep, pub_slot: int.narrow(sender * 2 - 1))
            webrtc_sfu.cascade.remote_sr(n.a, room_name(), key, 0)
        }
    } else {
        None
    }
    for off in 0u64 .. m.p_count {
        let sub = m.p_start + off
        if sub == sender {
            continue
        }
        let slot = off * m.total + (sender - 1)
        if is_audio {
            m.audio_pkts += 1
            if measure {
                m.audio_seen[slot] = true
                if let Some(sr) = sr_opt {
                    let lat = audio_latency_us(sr, ts, recv_ns)
                    hist_add(mut m.all_hist, lat)
                    if !is_local {
                        hist_add(mut m.remote_hist, lat)
                    }
                }
            }
        } else {
            m.video_pkts += 1
            if measure {
                m.video_seen[slot] = true
            }
        }
    }
}

fn count_true(xs: List[bool]) -> u64 {
    let mut n = 0u64
    for x in xs {
        if x {
            n += 1
        }
    }
    n
}

fn emit_json(out: Stdout, name: String, m: NodeMetrics, sr_rx: u64, lc: webrtc_sfu.cascade.LinkCounts, fs: (u64, u64, u64, u64)) waits {
    let expected = m.p_count * (m.total - 1)
    let a_pairs = count_true(m.audio_seen)
    let v_pairs = count_true(m.video_seen)
    let (_, exp_drop, stale_ign, late_ign) = fs
    let mut s = string.from("K10_NODE_JSON {\"node\":\"")
    string.push(mut s, name)
    string.push(mut s, "\",\"expected_pairs\":")
    string.push_u64(mut s, expected)
    string.push(mut s, ",\"audio_pairs\":")
    string.push_u64(mut s, a_pairs)
    string.push(mut s, ",\"video_pairs\":")
    string.push_u64(mut s, v_pairs)
    string.push(mut s, ",\"audio_pkts\":")
    string.push_u64(mut s, m.audio_pkts)
    string.push(mut s, ",\"video_pkts\":")
    string.push_u64(mut s, m.video_pkts)
    string.push(mut s, ",\"sr_received\":")
    string.push_u64(mut s, sr_rx)
    string.push(mut s, ",\"dgram_tx\":")
    string.push_u64(mut s, lc.datagrams_sent)
    string.push(mut s, ",\"dgram_rx\":")
    string.push_u64(mut s, lc.datagrams_received)
    string.push(mut s, ",\"mtu_refused\":")
    string.push_u64(mut s, lc.mtu_refused)
    string.push(mut s, ",\"expired_drop\":")
    string.push_u64(mut s, exp_drop)
    string.push(mut s, ",\"stale_ign\":")
    string.push_u64(mut s, stale_ign)
    string.push(mut s, ",\"late_ign\":")
    string.push_u64(mut s, late_ign)
    string.push(mut s, ",\"samples\":")
    string.push_u64(mut s, m.all_hist.count)
    string.push(mut s, ",\"remote_samples\":")
    string.push_u64(mut s, m.remote_hist.count)
    string.push(mut s, ",\"p50_us\":")
    string.push_u64(mut s, hist_quantile_us(m.all_hist, 50, 100))
    string.push(mut s, ",\"p95_us\":")
    string.push_u64(mut s, hist_quantile_us(m.all_hist, 95, 100))
    string.push(mut s, ",\"p99_us\":")
    string.push_u64(mut s, hist_quantile_us(m.all_hist, 99, 100))
    string.push(mut s, ",\"max_us\":")
    string.push_u64(mut s, m.all_hist.max_us)
    string.push(mut s, ",\"remote_p95_us\":")
    string.push_u64(mut s, hist_quantile_us(m.remote_hist, 95, 100))
    string.push(mut s, "}")
    say(out, s)
}

fn register_local_participants(mut n: K10Node, mut hub: webrtc_sfu.cascade.LinkHub, now_ns: u64) {
    for off in 0u64 .. n.p_count {
        let p = n.p_start + off
        let who: webrtc_sfu.peer.Gen = Gen(id: p, epoch: 1)
        let _ = k10_apply(mut n, mut hub, now_ns, Admit(who: webrtc_sfu.peer.Participant(gen: who, room: K10_ROOM), home: 2))
        // Deterministic unique PublicationIds across all 3 nodes: audio = 2*p - 1, video = 2*p.
        let pid_a: webrtc_sfu.router.PublicationId = PublicationId(p * 2 - 1)
        let pid_v: webrtc_sfu.router.PublicationId = PublicationId(p * 2)
        let _ = k10_apply(mut n, mut hub, now_ns, PublishRemote(room: K10_ROOM, who: who, section: 0, id: pid_a, shape: webrtc_sfu.router.Shape(codec: Opus, pli: true, fir: true, encodings: 1), via: 3))
        let _ = k10_apply(mut n, mut hub, now_ns, PublishRemote(room: K10_ROOM, who: who, section: 1, id: pid_v, shape: webrtc_sfu.router.Shape(codec: Vp8, pli: true, fir: true, encodings: 1), via: 3))
        list.push(mut n.local_pubs, (pid_a, pid_v))
    }
    k10_sync_subscriptions(mut n, mut hub, now_ns)
}

fn send_local_audio(mut n: K10Node, mut hub: webrtc_sfu.cascade.LinkHub, mut m: NodeMetrics, local_srs: List[Option[webrtc_sfu.cascade.SrTiming]], seq: u16, now_ns: u64, measure: bool) {
    let (_, _, rtp_ts) = audio_clock_pair(now_ns)
    for off in 0u64 .. n.p_count {
        let p = n.p_start + off
        let who: webrtc_sfu.peer.Gen = Gen(id: p, epoch: 1)
        let (pid_a, _) = n.local_pubs[off]
        let ssrc: u32 = int.narrow(0x1000u64 + p)
        let pkt = make_canon_rtp(Opus, seq, rtp_ts, ssrc, 48)
        let _ = webrtc_sfu.router.inject_remote_media(mut n.r, now_ns, K10_ROOM, pid_a, who, 0, webrtc_sfu.cascade.canon_slice(take pkt), mut n.out)
    }
    k10_pump(mut n, mut hub, mut m, local_srs, now_ns, measure)
}

fn send_local_video(mut n: K10Node, mut hub: webrtc_sfu.cascade.LinkHub, mut m: NodeMetrics, local_srs: List[Option[webrtc_sfu.cascade.SrTiming]], seq: u16, now_ns: u64, measure: bool) {
    let rtp_ts: u32 = int.narrow(((now_ns / 1000u64) * 90u64 / 1000u64) & 0xffffffffu64)
    for off in 0u64 .. n.p_count {
        let p = n.p_start + off
        let who: webrtc_sfu.peer.Gen = Gen(id: p, epoch: 1)
        let (_, pid_v) = n.local_pubs[off]
        let ssrc: u32 = int.narrow(0x2000u64 + p)
        let pkt = make_canon_rtp(Vp8, seq, rtp_ts, ssrc, 200)
        let _ = webrtc_sfu.router.inject_remote_media(mut n.r, now_ns, K10_ROOM, pid_v, who, 0, webrtc_sfu.cascade.canon_slice(take pkt), mut n.out)
    }
    k10_pump(mut n, mut hub, mut m, local_srs, now_ns, measure)
}

fn send_local_srs(mut n: K10Node, mut hub: webrtc_sfu.cascade.LinkHub, mut m: NodeMetrics, mut local_srs: List[Option[webrtc_sfu.cascade.SrTiming]], audio_seq: u16, now_ns: u64, measure: bool) {
    let (ntp_hi, ntp_lo, rtp_ts) = audio_clock_pair(now_ns)
    let pkts: u32 = int.widen(audio_seq)
    let sr = webrtc_sfu.cascade.SrTiming(ntp_hi: ntp_hi, ntp_lo: ntp_lo, rtp_ts: rtp_ts, packets: pkts, octets: pkts * 48u32)
    let hi_w: u64 = int.widen(ntp_hi)
    let lo_w: u64 = int.widen(ntp_lo)
    let ntp: u64 = (hi_w << 32u64) | lo_w
    let info = rtp.rtcp.SenderInfo(ssrc: 0, ntp: ntp, rtp: rtp_ts, packets: pkts, octets: pkts * 48u32)
    for off in 0u64 .. n.p_count {
        let p = n.p_start + off
        let who: webrtc_sfu.peer.Gen = Gen(id: p, epoch: 1)
        let (pid_a, _) = n.local_pubs[off]
        local_srs[off] = Some(sr)
        let _ = webrtc_sfu.router.inject_remote_sr(mut n.r, now_ns, K10_ROOM, pid_a, who, 0, info)
    }
    k10_pump(mut n, mut hub, mut m, local_srs, now_ns, measure)
}

fn run_single(a: Args, dir: Dir, clock: Clock, random: Random, out: Stdout) -> Result[(), Exit] waits {
    let p_count = parse_u64_arg(a, 1)
    let duration_ms = parse_u64_arg(a, 2)
    let lim = webrtc_sfu.cascade.default_link_limits()
    let nid = webrtc_sfu.cascade.node_id(b"single")
    let id = load_identity(dir)
    let mut hub = result.unwrap(webrtc_sfu.cascade.link_hub(nid, random, lim, take id, list.new(), 2))
    let mut n = new_k10_node(random, nid, lim, 1, p_count, p_count)
    let start_ns = host.mono_ns(clock)
    let _ = result.unwrap(k10_apply(mut n, mut hub, start_ns, Open(room: K10_ROOM, limits: k10_room_limits())))
    result.unwrap(webrtc_sfu.cascade.open_home_room(mut n.a, K10_ROOM, room_name(), 1, k10_room_limits()))
    webrtc_sfu.cascade.enable_leases(mut n.a, room_name(), start_ns / MS + duration_ms + 30000, list.new())
    register_local_participants(mut n, mut hub, start_ns)
    let mut local_srs: List[Option[webrtc_sfu.cascade.SrTiming]] = list.with_capacity(p_count)
    list.fill(mut local_srs, p_count, None)
    let mut metrics = new_metrics(1, p_count, p_count)
    k10_pump(mut n, mut hub, mut metrics, local_srs, start_ns, false)
    let end_ns = start_ns + duration_ms * MS
    let warm_ns = start_ns + 400 * MS
    let mut next_audio = start_ns
    let mut next_video = start_ns
    let mut next_sr = start_ns
    let mut a_seq = 1u16
    let mut v_seq = 1u16
    while host.mono_ns(clock) < end_ns {
        let now = host.mono_ns(clock)
        let measure = now >= warm_ns
        if now >= next_sr {
            send_local_srs(mut n, mut hub, mut metrics, mut local_srs, a_seq, now, measure)
            next_sr = now + 250 * MS
        }
        if now >= next_audio {
            send_local_audio(mut n, mut hub, mut metrics, local_srs, a_seq, now, measure)
            a_seq += 1
            next_audio = now + 20 * MS
        }
        if now >= next_video {
            send_local_video(mut n, mut hub, mut metrics, local_srs, v_seq, now, measure)
            v_seq += 1
            next_video = now + 33 * MS
        }
        let _ = webrtc_sfu.cascade.take_forward_logs(mut n.a)
        let wake = order.min(order.min(next_audio, next_video), end_ns)
        if wake > host.mono_ns(clock) {
            host.sleep_until(clock, wake)
        }
    }
    emit_json(out, string.from("single"), metrics, webrtc_sfu.cascade.sr_received_count(n.a), webrtc_sfu.cascade.link_counts(hub), webrtc_sfu.cascade.fence_stats(n.a))
    Ok(())
}

fn run_home(a: Args, net: Net, dir: Dir, clock: Clock, random: Random, out: Stdout) -> Result[(), Exit] waits {
    let Some(bind_addr) = parse_addr(str_arg(a, 1)) else {
        say(out, "invalid bind address")
        return Error(Exit(status: 2u8))
    }
    let p_start = parse_u64_arg(a, 2)
    let p_count = parse_u64_arg(a, 3)
    let total = parse_u64_arg(a, 4)
    let duration_ms = parse_u64_arg(a, 5)
    let mut pins: List[webrtc_sfu.cascade.PeerPins] = list.new()
    let mut idx = 6u64
    while idx + 1 < args.len(a) {
        let edge = webrtc_sfu.cascade.node_id(string.as_bytes(str_arg(a, idx)))
        let mut edge_pins: List[quic.handshake.Pin] = list.with_capacity(1)
        list.push(mut edge_pins, parse_pin(str_arg(a, idx + 1)))
        list.push(mut pins, webrtc_sfu.cascade.PeerPins(node: edge, pins: take edge_pins))
        idx += 2
    }
    let lim = webrtc_sfu.cascade.default_link_limits()
    let nid = webrtc_sfu.cascade.node_id(b"home")
    let id = load_identity(dir)
    let mut hub = result.unwrap(webrtc_sfu.cascade.link_hub(nid, random, lim, take id, take pins, 8))
    let mut n = new_k10_node(random, nid, lim, p_start, p_count, total)
    let (take sock_in, _) = result.unwrap(host.udp_bind(net, bind_addr, SOCKET_OPTS))
    let mut sock = take sock_in
    let start_ns = host.mono_ns(clock)
    let _ = result.unwrap(k10_apply(mut n, mut hub, start_ns, Open(room: K10_ROOM, limits: k10_room_limits())))
    result.unwrap(webrtc_sfu.cascade.open_home_room(mut n.a, K10_ROOM, room_name(), 1, k10_room_limits()))
    webrtc_sfu.cascade.enable_leases(mut n.a, room_name(), start_ns / MS + duration_ms + 30000, list.new())
    register_local_participants(mut n, mut hub, start_ns)
    let mut local_srs: List[Option[webrtc_sfu.cascade.SrTiming]] = list.with_capacity(p_count)
    list.fill(mut local_srs, p_count, None)
    let mut metrics = new_metrics(p_start, p_count, total)
    k10_pump(mut n, mut hub, mut metrics, local_srs, start_ns, false)
    say(out, "K10_READY home")
    let end_ns = start_ns + duration_ms * MS
    let warm_ns = start_ns + 1500 * MS
    let mut next_audio = start_ns + 200 * MS
    let mut next_video = start_ns + 200 * MS
    let mut next_sr = start_ns + 200 * MS
    let mut a_seq = 1u16
    let mut v_seq = 1u16
    let mut events: List[webrtc_sfu.cascade.LinkEvent] = list.new()
    while host.mono_ns(clock) < end_ns {
        let now = host.mono_ns(clock)
        let until = order.min(now + 2 * MS, end_ns)
        let _ = webrtc_sfu.cascade.drive_links(mut hub, clock, mut sock, until, mut events)
        let cur = host.mono_ns(clock)
        let measure = cur >= warm_ns
        webrtc_sfu.cascade.handle_events(mut n.a, mut hub, take events, cur / MS)
        events = list.new()
        k10_pump(mut n, mut hub, mut metrics, local_srs, host.mono_ns(clock), measure)
        let cur2 = host.mono_ns(clock)
        if cur2 >= next_sr {
            send_local_srs(mut n, mut hub, mut metrics, mut local_srs, a_seq, cur2, measure)
            next_sr = cur2 + 250 * MS
        }
        if cur2 >= next_audio {
            send_local_audio(mut n, mut hub, mut metrics, local_srs, a_seq, cur2, measure)
            a_seq += 1
            next_audio = cur2 + 20 * MS
        }
        if cur2 >= next_video {
            send_local_video(mut n, mut hub, mut metrics, local_srs, v_seq, cur2, measure)
            v_seq += 1
            next_video = cur2 + 33 * MS
        }
        let _ = webrtc_sfu.cascade.take_forward_logs(mut n.a)
    }
    emit_json(out, string.from("home"), metrics, webrtc_sfu.cascade.sr_received_count(n.a), webrtc_sfu.cascade.link_counts(hub), webrtc_sfu.cascade.fence_stats(n.a))
    Ok(())
}

fn run_edge(a: Args, net: Net, dir: Dir, clock: Clock, random: Random, out: Stdout) -> Result[(), Exit] waits {
    let Some(bind_addr) = parse_addr(str_arg(a, 1)) else {
        say(out, "invalid bind address")
        return Error(Exit(status: 2u8))
    }
    let Some(home_addr) = parse_addr(str_arg(a, 2)) else {
        say(out, "invalid home address")
        return Error(Exit(status: 2u8))
    }
    let node_name = str_arg(a, 3)
    let p_start = parse_u64_arg(a, 4)
    let p_count = parse_u64_arg(a, 5)
    let total = parse_u64_arg(a, 6)
    let duration_ms = parse_u64_arg(a, 7)
    let home_pin = parse_pin(str_arg(a, 8))
    let lim = webrtc_sfu.cascade.default_link_limits()
    let nid = webrtc_sfu.cascade.node_id(string.as_bytes(node_name))
    let hid = webrtc_sfu.cascade.node_id(b"home")
    let id1 = load_identity(dir)
    let id2 = load_identity(dir)
    let mut home_pins: List[quic.handshake.Pin] = list.with_capacity(1)
    list.push(mut home_pins, clone(home_pin))
    let mut hp1: List[webrtc_sfu.cascade.PeerPins] = list.with_capacity(1)
    list.push(mut hp1, webrtc_sfu.cascade.PeerPins(node: hid, pins: take home_pins))
    let mut hp2: List[quic.handshake.Pin] = list.with_capacity(1)
    list.push(mut hp2, take home_pin)
    let mut hub = result.unwrap(webrtc_sfu.cascade.link_hub(nid, random, lim, take id1, take hp1, 4))
    let mut n = new_k10_node(random, nid, lim, p_start, p_count, total)
    let (take sock_in, _) = result.unwrap(host.udp_bind(net, bind_addr, SOCKET_OPTS))
    let mut sock = take sock_in
    let start_ns = host.mono_ns(clock)
    let _ = result.unwrap(k10_apply(mut n, mut hub, start_ns, Open(room: K10_ROOM, limits: k10_room_limits())))
    let h = result.unwrap(webrtc_sfu.cascade.dial_addr(mut hub, hid, home_addr, take hp2, start_ns, take id2))
    let mut attached = false
    let mut local_srs: List[Option[webrtc_sfu.cascade.SrTiming]] = list.with_capacity(p_count)
    list.fill(mut local_srs, p_count, None)
    let mut metrics = new_metrics(p_start, p_count, total)
    let end_ns = start_ns + duration_ms * MS
    let warm_ns = start_ns + 1500 * MS
    let mut next_audio = start_ns + 300 * MS
    let mut next_video = start_ns + 300 * MS
    let mut next_sr = start_ns + 300 * MS
    let mut a_seq = 1u16
    let mut v_seq = 1u16
    let mut events: List[webrtc_sfu.cascade.LinkEvent] = list.new()
    while host.mono_ns(clock) < end_ns {
        let now = host.mono_ns(clock)
        let until = order.min(now + 2 * MS, end_ns)
        let _ = webrtc_sfu.cascade.drive_links(mut hub, clock, mut sock, until, mut events)
        let mut got_up = false
        for ev in events {
            if let LinkUp(handle: eh, ..) = ev {
                if eh == h {
                    got_up = true
                }
            }
        }
        let cur = host.mono_ns(clock)
        let measure = cur >= warm_ns
        webrtc_sfu.cascade.handle_events(mut n.a, mut hub, take events, cur / MS)
        events = list.new()
        if got_up && !attached {
            let _ = result.unwrap(webrtc_sfu.cascade.attach_edge_room(mut n.a, mut hub, K10_ROOM, room_name(), h, 1, k10_room_limits()))
            webrtc_sfu.cascade.enable_leases(mut n.a, room_name(), 0, list.new())
            register_local_participants(mut n, mut hub, cur)
            attached = true
        }
        k10_pump(mut n, mut hub, mut metrics, local_srs, host.mono_ns(clock), measure)
        if attached {
            let cur2 = host.mono_ns(clock)
            if cur2 >= next_sr {
                send_local_srs(mut n, mut hub, mut metrics, mut local_srs, a_seq, cur2, measure)
                next_sr = cur2 + 250 * MS
            }
            if cur2 >= next_audio {
                send_local_audio(mut n, mut hub, mut metrics, local_srs, a_seq, cur2, measure)
                a_seq += 1
                next_audio = cur2 + 20 * MS
            }
            if cur2 >= next_video {
                send_local_video(mut n, mut hub, mut metrics, local_srs, v_seq, cur2, measure)
                v_seq += 1
                next_video = cur2 + 33 * MS
            }
        }
        let _ = webrtc_sfu.cascade.take_forward_logs(mut n.a)
    }
    emit_json(out, node_name, metrics, webrtc_sfu.cascade.sr_received_count(n.a), webrtc_sfu.cascade.link_counts(hub), webrtc_sfu.cascade.fence_stats(n.a))
    Ok(())
}

pub fn main(a: Args, net: Net, dir: Dir, clock: Clock, random: Random, out: Stdout) -> Result[(), Exit] waits {
    if args.len(a) == 0 {
        say(out, "usage: k10-node <single|home|edge> ...")
        return Error(Exit(status: 2u8))
    }
    let mode = str_arg(a, 0)
    if mode == "single" {
        run_single(a, dir, clock, random, out)
    } else if mode == "home" {
        run_home(a, net, dir, clock, random, out)
    } else if mode == "edge" {
        run_edge(a, net, dir, clock, random, out)
    } else {
        say(out, "unknown mode")
        Error(Exit(status: 2u8))
    }
}

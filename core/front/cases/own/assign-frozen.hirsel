// OWN-10: assigning a place a live view freezes; and OWN-12: nothing reached through a view is writable.
// expect: refuse OWN-10 at 9:3
// expect: refuse OWN-12 at 13:3
// expect: cause OWN-10 at 9:3 from 8:11

type P { a: u64, b: List[u8] }
fn f(mut p: P) {
  let v = view p
  p.a = 3
}
fn g(p: P) {
  let mut v = view p
  v.a = 3
}

// Rigid bodies are checked once. Their scalar instances and ordinary callable
// values use the same concrete convention, without an ABI adapter.
// expect: run f() = 7
// expect: run direct() = 19
// expect: run zero() = 9
fn id[T: plain](x: T) -> T { copy x }
fn apply[T: plain](cb: fn(T) -> T, x: T) -> T { cb(x) }
fn f() -> u8 { let cb: fn(u8) -> u8 = id; apply(cb, 7) }

fn direct() -> u64 { apply(fn(x: u64) -> u64 { x + 12 }, 7) }
fn unit(x: ()) { x }
fn zero() -> u64 { let cb: fn(()) -> () = unit; apply(cb, ()); 9 }

// A function value inside a rigid body specializes with its producer.
// expect: run nested() = 23
fn inside[T: plain](x: T) -> T {
  let cb: fn(T) -> T = id
  cb(x)
}
fn nested() -> u64 { inside(23) }

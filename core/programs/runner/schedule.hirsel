pub type Tick: codec + send { name: String, anchor: u64 }

pub opaque type Alarm: codec + send { tick: Tick, id: triggers.Id }

pub type DispatchFailure: codec + send = MissingEntry | IndexLimit | Storage

pub type Event: codec + send = Ran(u64, triggers.Id) | Skipped(u64) | Failed(u64, DispatchFailure)

pub type Status: send {
    next: u64,
    tick: triggers.Id,
    tick_outcome: Option[triggers.Terminal],
    last_run: Option[triggers.Id],
    history: List[Event]
}

pub type Error: send = InvalidInterval | InvalidCron | NoNext | Store(store.Error) | Trigger(triggers.Error)
pub type TickError: codec + send = NoNext | Storage | RearmRefused

type Cadence: codec + send = Every(u64) | Cron(CronFields)
type Row: codec + send {
    cadence: Cadence,
    target: triggers.Destination,
    next: u64,
    tick: triggers.Id,
    last_run: Option[triggers.Id],
    history: List[Event]
}

pub opaque type Tables: shareable + send {
    rows: store.Table[String, Row],
    triggers: triggers.Tables
}

pub opaque type Wiring {
    entries: triggers.Entries,
    alarm: triggers.Entry[Alarm]
}

const HISTORY: u64 = 16u64

pub fn declare_tables(mut d: store.Declare, take pending: triggers.Tables) -> Result[Tables, store.Error] {
    let value: std.codec.Codec[Row] = std.codec.of()
    let declared = store.declare_table(mut d, "runner.schedules", std.codec.key_string(), value)?
    Ok(Tables(rows: store.finish(mut d, take declared)?, triggers: take pending))
}

/// The place registers an ordinary transact entry for Alarm that calls tick.
pub fn wiring(take entries: triggers.Entries, take alarm: triggers.Entry[Alarm]) -> Wiring {
    Wiring(entries: take entries, alarm: take alarm)
}

fn arm(mut tx: store.Tx, t: Tables, w: Wiring, name: String, anchor: u64) -> Result[triggers.Id, triggers.Error] {
    triggers.write_with_id(mut tx, t.triggers, w.entries, w.alarm, scoped fn(id: triggers.Id) -> Alarm {
        Alarm(tick: Tick(name: clone(name), anchor: anchor), id: id)
    }, At(anchor))
}

fn cancel(mut tx: store.Tx, t: Tables, id: triggers.Id) -> Result[(), triggers.Error] {
    match triggers.request_cancel(mut tx, t.triggers, id) {
        Ok(()) => Ok(()),
        Error(StaleAttempt) => Ok(()),
        Error(take problem) => Error(take problem),
    }
}

fn upsert(mut tx: store.Tx, t: Tables, w: Wiring, name: String, cadence: Cadence, target: triggers.Entry[Tick], next: u64) -> Result[triggers.Id, Error] {
    let saved = store.fetch(tx, t.rows, name) ?=> Store
    let id = arm(mut tx, t, w, name, next) ?=> Trigger
    let (last_run, take history) = match take saved {
        Some(Row(tick: previous, last_run: last_run, history: take history, ..)) => {
            cancel(mut tx, t, previous) ?=> Trigger
            (last_run, take history)
        },
        None => (None, list.new()),
    }
    let row = Row(cadence: cadence, target: triggers.destination(target), next: next, tick: id, last_run: last_run, history: take history)
    store.put(mut tx, t.rows, name, row) ?=> Store
    Ok(id)
}

/// Creates or replaces a named interval. The first anchor is one period after this commit.
pub fn every(mut tx: store.Tx, t: Tables, w: Wiring, name: String, period_ms: u64, target: triggers.Entry[Tick]) -> Result[triggers.Id, Error] {
    if period_ms == 0u64 { return Error(InvalidInterval) }
    let Some(next) = int.checked_add(store.info(mut tx).at, period_ms) else { return Error(NoNext) }
    upsert(mut tx, t, w, name, Every(period_ms), target, next)
}

/// Creates or replaces a named five-field cron schedule. The offset is minutes east of UTC.
pub fn cron(mut tx: store.Tx, t: Tables, w: Wiring, name: String, expression: String, utc_offset: i32, target: triggers.Entry[Tick]) -> Result[triggers.Id, Error] {
    let Some(fields) = parse_cron(expression, utc_offset) else { return Error(InvalidCron) }
    let Some(next) = next_cron(fields, store.info(mut tx).at) else { return Error(NoNext) }
    upsert(mut tx, t, w, name, Cron(fields), target, next)
}

pub fn remove(mut tx: store.Tx, t: Tables, name: String) -> Result[bool, Error] {
    let Some(saved) = store.fetch(tx, t.rows, name) ?=> Store else { return Ok(false) }
    cancel(mut tx, t, saved.tick) ?=> Trigger
    Ok(store.delete(mut tx, t.rows, name) ?=> Store)
}

pub fn status(tx: store.Tx, t: Tables, name: String) -> Result[Option[Status], store.Error] {
    let Some(take row) = store.fetch(tx, t.rows, name)? else { return Ok(None) }
    let Row(next: next, tick: alarm_id, last_run: last_run, history: take history, ..) = take row
    let outcome = triggers.fetch_outcome(tx, t.triggers, alarm_id)?
    Ok(Some(Status(next: next, tick: alarm_id, tick_outcome: take outcome, last_run: last_run, history: take history)))
}

fn following(cadence: Cadence, anchor: u64, at: u64) -> Option[u64] {
    match cadence {
        Every(period) => {
            let elapsed = at - anchor
            int.checked_add(at, period - elapsed % period)
        },
        Cron(fields) => next_cron(fields, at),
    }
}

fn overlap(tx: store.Tx, t: Tables, previous: Option[triggers.Id]) -> Result[bool, store.Error] {
    let Some(id) = previous else { return Ok(false) }
    // Trigger outcomes are durable rows retained after the pending trigger is consumed.
    match triggers.fetch_outcome(tx, t.triggers, id)? { Some(_) => Ok(false), None => Ok(true) }
}

fn dispatch_failure(e: triggers.Error) -> DispatchFailure {
    match e { MissingEntry => MissingEntry, IndexLimit => IndexLimit, _ => Storage }
}

/// Rearms the schedule and dispatches the user run in the tick transaction.
/// The user entry executes independently through its own AfterCommit trigger.
pub fn tick(mut tx: store.Tx, t: Tables, w: Wiring, take alarm: Alarm) -> Result[(), TickError] {
    let Alarm(tick: take requested, id: id) = take alarm
    let at = store.info(mut tx).at
    let Some(take saved) = store.fetch(tx, t.rows, requested.name) ?=> |_| Storage else { return Ok(()) }
    if saved.tick != id || at < saved.next { return Ok(()) }
    let mut row = take saved
    let Some(next) = following(row.cadence, row.next, at) else { return Error(NoNext) }
    row.tick = arm(mut tx, t, w, requested.name, next) ?=> |_| RearmRefused
    row.next = next
    let anchor = requested.anchor
    let event = if overlap(tx, t, row.last_run) ?=> |_| Storage {
        Skipped(anchor)
    } else {
        let dispatched = store.rollback_writes_on_error(mut tx, scoped fn(mut draft: store.Tx) -> Result[triggers.Id, triggers.Error] {
            triggers.write_saved(mut draft, t.triggers, w.entries, row.target, requested, AfterCommit)
        })
        match take dispatched {
            Ok(run) => { row.last_run = Some(run); Ran(anchor, run) },
            Error(take problem) => Failed(anchor, dispatch_failure(problem)),
        }
    }
    if list.len(row.history) == HISTORY { let _ = list.remove(mut row.history, 0u64) }
    list.push(mut row.history, event)
    store.put(mut tx, t.rows, requested.name, row) ?=> |_| Storage
    Ok(())
}

// rule: STORE-12
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"}}
// steps: 8000000
// The stream row a store.call commit writes counts against the store's limits
// like the body's writes: an outcome whose row would exceed value_bytes is
// decided Limit, with the body's writes discarded, and a caller that never
// acknowledges is refused once not even the row recording a limit fits; that
// refusal is unrecorded, so after an acknowledgement the position runs.
@serializable
type Short = Empty | Db(store.TxError)

fn request(position: u64, digest: Bytes, acknowledged: u64) -> CallRequest {
  CallRequest(
    stream: d32(b"caller-1"),
    epoch: 1,
    position: position,
    digest: d32(digest),
    acknowledged: acknowledged
  )
}

fn filled(n: u64) -> Bytes {
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < n {
    list.push(mut out, b'x')
    i = i + 1
  }
  bytes.from_list(take out)
}

fn counted(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[Bytes, Short] {
  let c: u64 = match store.tx_get(tx, b"counter") {
    Ok(Some(b)) => int.widen(b[0]),
    Ok(None()) => 0,
    Error(e) => return Error(Db(unique e)),
  }
  store.tx_put(mut tx, b"counter", bytes.from_list([int.truncate(c + 1)])) ? Db
  Ok(filled(n))
}

// Adds one to the counter and returns `n` bytes.
fn bump(mut s: store.Store, req: CallRequest, n: u64) -> Result[
  Bytes,
  store.CallFailure[Short]
] {
  store.call(mut s, req, counted, n)
}

fn counter(a: Authority, mut s: store.Store) -> Option[Bytes] {
  match store.snapshot(a, mut s, authority.floor(a)) {
    Ok(snap) => store.get(snap, b"counter"),
    Error(_) => None(),
  }
}

// Streams and request digests are 32 bytes: the SHA-256 of a name.
fn d32(name: Bytes) -> Bytes {
  bytes.from_inline(sha256.digest(name))
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let mut config = store.default_config()
  config.limits.value_bytes = 4096
  let mut s = store.open(a, config) ? Store
  // The body's own write fits; the row recording its 4080-byte result does
  // not: with the 32-byte request digest beside it, it passes 4096.
  check(bump(mut s, request(1, b"a", 0), 4080) == Error(Tx(Limit(ValueBytes()))))?
  check(counter(a, mut s) == None())?
  // The limit was recorded: its duplicate returns it without running.
  check(bump(mut s, request(1, b"a", 0), 8) == Error(Tx(Limit(ValueBytes()))))?
  check(bump(mut s, request(2, b"b", 1), 8) == Ok(filled(8)))?
  check(counter(a, mut s) == Some(b"\x01"))?
  // A caller that never acknowledges again fills its row until even a limit
  // cannot be recorded.
  let mut position: u64 = 3
  let mut refused_unrecorded = false
  while position < 60 && !refused_unrecorded {
    let r = bump(mut s, request(position, b"c", 1), 200)
    if r != Ok(filled(200)) {
      check(r == Error(Tx(Limit(ValueBytes()))))?
      // Acknowledging every earlier outcome: a recorded limit is returned as a
      // duplicate, an unrecorded refusal left the position to run now.
      let again = bump(mut s, request(position, b"c", position - 1), 200)
      if again == Ok(filled(200)) {
        refused_unrecorded = true
      } else {
        check(again == Error(Tx(Limit(ValueBytes()))))?
      }
    }
    position = position + 1
  }
  check(refused_unrecorded)?
  Ok(())
}

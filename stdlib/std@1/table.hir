/// An inert name and expected schema; authority comes from each operation's Tx.
pub opaque type Table[K: key + serializable, V: serializable]: copyable + data + key + inert + sendable uses {} {
  spelling: Inline[u8, 255],
  length: u64,
}

@serializable
pub type SchemaChange = Created | Renamed(String, String) | Migrated(EntryId)

@serializable
pub type SchemaEntry {
  epoch: u32,
  key_schema: String,
  value_schema: String,
  change: SchemaChange,
}

/// Why `table.migrate` returned without migrating; the table is unchanged.
@serializable
pub type MigrateError[E] = Failed(E) | Faulted(Failure) | Collision | Table(store.TxError) | Canceled(
  CancelCause
)

/// Names a table without opening or creating it. Operations validate its name.
pub fn named[K: key + serializable, V: serializable](name: String) -> Table[K, V] uses {} {
  let raw = string.as_bytes(name)
  let n = bytes.len(raw)
  let mut spelling: Inline[u8, 255] = [0u8; 255]
  if n <= 255 {
    let mut i: u64 = 0
    while i < n {
      spelling[i] = raw[i]
      i += 1
    }
  }
  Table(spelling: take spelling, length: n)
}

fn table_name[K: key + serializable, V: serializable](t: Table[K, V]) -> String uses {} {
  if t.length > 255 {
    return ""
  }
  let mut raw: List[u8] = []
  let mut i: u64 = 0
  while i < t.length {
    list.push(mut raw, t.spelling[i])
    i += 1
  }
  match string.from_bytes(bytes.from_list(take raw)) {
    Ok(name) => take name,
    Error(_) => "",
  }
}

// A table's immutable epoch descriptors and declarations. Row values hold only
// their epoch (u32 little endian) and canonical payload. No loaded constructor.
@serializable
type Epoch {
  key: Bytes,
  value: Bytes,
  change: SchemaChange,
}

// A live epoch's storage descriptors, as the catalog entry keeps them: the
// change that made the epoch is in its history row alone.
@serializable
type Schemas {
  key: Bytes,
  value: Bytes,
}

// The catalog's entry for `e`.
fn live(e: Epoch) -> Schemas uses {} {
  Schemas(key: unique e.key, value: unique e.value)
}

// A table's catalog entry, all that a row operation reads: the live epochs,
// from the creation or migration that wrote the current generation (epoch
// `base`) on, and the renames declared since. Rows name only live epochs, so
// the entry's size is bounded by the renames since the last migration, not by
// the history, which is in the history rows alone.
@serializable
type Catalog {
  base: u64,
  epochs: List[Schemas],
  renames: List[(String, String)],
  // The generation the table's rows live under.
  generation: u8,
  // Whether a migration is writing the next generation.
  migrating: bool,
  // The layout of the table type whose creation or migration wrote the live
  // epoch: a caller with the same layout reads its own rows unchecked.
  witness: Layout,
}

// A table type's SER-2 envelopes of `None()` as `Option[K]` and `Option[V]`:
// their descriptors give the key and value storage descriptors, and their
// heads precede a payload `codec.decode` reads.
@serializable
type Layout {
  key: Bytes,
  value: Bytes,
}

fn layout[K: key + serializable, V: serializable](t: Table[K, V]) -> Layout uses {} {
  let k: Option[K] = None()
  let v: Option[V] = None()
  Layout(key: codec.encode(k), value: codec.encode(v))
}

// The storage descriptor of the type whose `None()` envelope is `none`.
fn schema_of(none: Bytes) -> Bytes uses {} {
  internal.table_schema.stored_schema(none)
}

// Whether `c`'s rows are the codec's own encodings of `l`'s types: no rename
// is declared and the one live epoch's descriptors are `l`'s. Its rows then
// need no projection, and its check needs no rendered descriptor. The
// layout that wrote the epoch is its own by construction; another one is
// compared descriptor by descriptor.
fn own_rows(c: Catalog, l: Layout) -> bool uses {} {
  if list.len(c.renames) != 0 || list.len(c.epochs) != 1 {
    return false
  }
  if c.witness.key == l.key && c.witness.value == l.value {
    return true
  }
  internal.table_schema.fits(c.epochs[0].key, l.key) && internal.table_schema.fits(
    c.epochs[0].value,
    l.value
  )
}

fn corrupt() -> store.TxError uses {} {
  let error: store.StoreError = Corrupt("typed table")
  Storage(take error)
}

fn valid(name: String) -> bool uses {} {
  let raw = string.as_bytes(name)
  if bytes.len(raw) == 0 || bytes.len(raw) > 255 || string.starts_with(name, "hirsel.") {
    return false
  }
  for byte in raw {
    if byte == 0 {
      return false
    }
  }
  true
}

fn metadata_key(name: String) -> Bytes uses {} {
  concat(b"hirsel.tables/", keys.encode(name))
}

// The table's history rows, one per epoch under the catalog key, a zero byte
// and the epoch as u32 big endian: read only by `history`, written by create,
// rename and a migration's install, and deleted as garbage by `drop`.
fn history_rows(name: String) -> Bytes uses {} {
  concat(metadata_key(name), b"\x00")
}

fn history_key(name: String, epoch: u64) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, history_rows(name))
  let mut i: u64 = 4
  while i > 0 {
    i -= 1
    list.push(mut out, int.truncate(epoch >> i * 8 & 255))
  }
  bytes.from_list(take out)
}

// The catalog entry and the history rows, the keys `scope` and `scope_keys`
// give a table besides its rows.
fn catalog_span(name: String, access: store.Access) -> store.KeyScope uses {} {
  store.interval(metadata_key(name), keys.prefix_end(history_rows(name)), access)
}

// Appends epoch `n` to the history rows.
fn record(mut tx: store.Tx, name: String, n: u64, e: Epoch) -> Result[(), store.TxError] {
  store.table_put(mut tx, history_key(name, n), codec.encode(e))
}

// Every generation of a table's rows.
fn table_rows(name: String) -> Bytes uses {} {
  concat(b"hirsel.rows/", keys.encode(name))
}

// One generation of a table's rows: the table's name, then the generation as
// one byte, then each row's encoded key. A migration writes the next
// generation, (g + 1) mod 256, and installs it by naming it in the catalog;
// the replaced or abandoned one is deleted before the operation returns, or by
// the next open, so no table holds rows under more than two.
fn rows_of(name: String, generation: u8) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, b"hirsel.rows/")
  bytes.append(mut out, keys.encode(name))
  list.push(mut out, generation)
  bytes.from_list(take out)
}

fn next_generation(g: u8) -> u8 uses {} {
  if g == 255 {
    0
  } else {
    g + 1
  }
}

fn concat(prefix: Bytes, suffix: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, prefix)
  bytes.append(mut out, suffix)
  bytes.from_list(take out)
}

fn load_catalog(tx: store.Tx, name: String) -> Result[Catalog, store.TxError] {
  if !valid(name) {
    return Error(InvalidInput())
  }
  let key = metadata_key(name)
  store.admit_read(tx, key)?
  let raw = match store.table_read(tx, take key) {
    Some(raw) => raw,
    None() => return Error(NoTable()),
  }
  let decoded: Result[Catalog, DecodeError] = codec.decode(raw)
  let loaded = match take decoded {
    Ok(c) => c,
    Error(_) => return Error(corrupt()),
  }
  if list.len(loaded.epochs) == 0 {
    return Error(corrupt())
  }
  Ok(take loaded)
}

fn current(c: Catalog) -> Schemas uses {} {
  unique c.epochs[list.len(c.epochs) - 1]
}

// The key schema the stored keys use: the first live epoch's, from the last
// creation or migration. Renames rewrite no key, so later epochs keep it.
fn key_schema(c: Catalog) -> Bytes uses {} {
  unique c.epochs[0].key
}

// The epoch the next schema change appends.
fn next_epoch(c: Catalog) -> u64 uses {} {
  c.base + list.len(c.epochs)
}

// A write to a table under migration returns `Migrating()`.
fn writable(c: Catalog) -> Result[(), store.TxError] uses {} {
  if c.migrating {
    return Error(Migrating())
  }
  Ok(())
}

// Whether `c`'s latest schemas are those of the layout `l`; `Ok(true)` when
// its rows are also `plain`.
fn schemas(c: Catalog, l: Layout) -> Result[bool, store.TxError] uses {} {
  if own_rows(c, l) {
    return Ok(true)
  }
  let latest = current(c)
  match internal.table_schema.equivalent(latest.key, schema_of(l.key), [], true) {
    Ok(()) => (),
    Error(e) => match e {
      Renamed(from, to) => return Error(Schema(Renamed(unique from, unique to))),
      _ => return Error(Schema(KeyMismatch())),
    },
  }
  internal.table_schema.equivalent(latest.value, schema_of(l.value), [], false) ? Schema
  Ok(false)
}

// The table's catalog once its schemas are checked against `l`, and whether
// its rows are `plain`.
fn checked[K: key + serializable, V: serializable](tx: store.Tx, t: Table[K, V], l: Layout) -> Result[
  (Catalog, bool),
  store.TxError
] {
  let c = load_catalog(tx, table_name(t))?
  let p = schemas(c, l)?
  Ok((take c, p))
}

// Checks that a table's key prefix `rows`, a generation or the history rows,
// holds nothing before it is written: a generation number is reused after a
// wrap, a discard or a drop, and a name after a drop, only once its earlier
// life is deleted (STORE-9). Garbage left of that life refuses as corruption,
// so no write lands among stale rows.
fn unused(tx: store.Tx, take rows: Bytes) -> Result[(), store.TxError] {
  let pending = store.garbage(copy rows)
  store.admit_read(tx, pending)?
  if let Some(_) = store.table_read(tx, take pending) {
    return Error(reused())
  }
  let left = store.table_range(tx, copy rows, keys.prefix_end(rows), 1, Ascending())?
  if list.len(left) != 0 {
    return Error(reused())
  }
  Ok(())
}

fn reused() -> store.TxError uses {} {
  let error: store.StoreError = Corrupt("typed table generation still holds rows")
  Storage(take error)
}

fn save(mut tx: store.Tx, name: String, c: Catalog) -> Result[(), store.TxError] {
  store.table_put(mut tx, metadata_key(name), codec.encode(c))
}

/// Creates an empty table with one schema entry; creation is explicit.
pub fn create[K: key + serializable, V: serializable](mut tx: store.Tx, t: Table[K, V]) -> Result[
  (),
  store.TxError
] {
  if !valid(table_name(t)) {
    return Error(InvalidInput())
  }
  let catalog = metadata_key(table_name(t))
  store.admit_write(tx, catalog)?
  if let Some(_) = store.table_read(tx, take catalog) {
    return Error(TableExists())
  }
  let name = table_name(t)
  unused(tx, take rows_of(name, 0))?
  unused(tx, take history_rows(name))?
  let l = layout(t)
  let first = Epoch(key: schema_of(l.key), value: schema_of(l.value), change: Created())
  record(mut tx, name, 0, first)?
  let c = Catalog(
    base: 0,
    epochs: [live(first)],
    renames: [],
    generation: 0,
    migrating: false,
    witness: take l
  )
  save(mut tx, name, c)?
  Ok(())
}

// `key`'s encoding under the stored key schema `schema`, the codec's own when
// the rows are `plain`.
fn encoded_key[K: key + serializable](
  schema: Bytes,
  key: K,
  renames: List[(String, String)],
  plain: bool
) -> Result[Bytes, store.TxError] uses {} {
  if plain {
    return Ok(keys.encode(key))
  }
  let data = match internal.table_schema.encode(schema, key, renames) {
    Ok(data) => data,
    Error(_) => return Error(corrupt()),
  }
  Ok(keys.encode_payload(schema, data))
}

fn row_key[K: key + serializable, V: serializable](t: Table[K, V], c: Catalog, plain: bool, key: K) -> Result[
  Bytes,
  store.TxError
] uses {} {
  // Metadata renames do not rewrite keys, so the physical key schema stays at
  // the generation's epoch until a migration atomically installs a new one.
  Ok(
    concat(
      rows_of(table_name(t), c.generation),
      encoded_key(key_schema(c), key, c.renames, plain)?
    )
  )
}

// A row's stored value: the epoch `n`, then `value`'s payload under the
// value schema `schema`, the codec's own when the rows are `plain`.
fn row_value[V: serializable](n: u64, schema: Bytes, value: V, plain: bool) -> Result[
  Bytes,
  store.TxError
] uses {} {
  let mut out: List[u8] = []
  internal.table_schema.little(mut out, n, 4)
  if plain {
    bytes.append(mut out, internal.table_schema.payload(codec.encode(value)))
  } else {
    let data = match internal.table_schema.encode(schema, value, []) {
      Ok(data) => data,
      Error(_) => return Error(corrupt()),
    }
    bytes.append(mut out, data)
  }
  Ok(bytes.from_list(take out))
}

// The value of `payload` under `none`, the `None()` envelope of `Option[T]`.
fn from_payload[T: serializable](none: Bytes, payload: Bytes) -> Result[T, DecodeError] uses {} {
  let mut whole: List[u8] = []
  bytes.append(mut whole, bytes.slice(none, 0, 16 + bytes.len(internal.table_schema.descriptor(none))))
  internal.table_schema.little(mut whole, 4 + bytes.len(payload), 8)
  internal.table_schema.little(mut whole, 1, 4)
  bytes.append(mut whole, payload)
  let value: Option[T] = codec.decode(bytes.from_list(take whole))?
  match take value {
    Some(v) => Ok(take v),
    None() => Error(Tag()),
  }
}

// The value a stored row value holds; `none` is `Option[V]`'s `None()` envelope.
fn decode_value[V: serializable](c: Catalog, none: Bytes, plain: bool, data: Bytes) -> Result[
  V,
  store.TxError
] uses {} {
  if bytes.len(data) < 4 {
    return Error(corrupt())
  }
  let mut n: u64 = 0
  let mut i: u64 = 0
  while i < 4 {
    let byte: u64 = int.widen(data[i])
    n = n | byte << i * 8
    i += 1
  }
  if n < c.base || n >= next_epoch(c) {
    return Error(corrupt())
  }
  let stored = c.epochs[n - c.base].value
  let payload = bytes.slice(data, 4, bytes.len(data))
  let value: Result[V, DecodeError] = if plain {
    from_payload(none, payload)
  } else {
    internal.table_schema.decode(stored, payload, c.renames)
  }
  match take value {
    Ok(v) => Ok(take v),
    Error(_) => Error(corrupt()),
  }
}

/// Returns a fresh value, or None when this transaction sees no row.
pub fn get[K: key + serializable, V: serializable](tx: store.Tx, t: Table[K, V], key: K) -> Result[
  Option[V],
  store.TxError
] {
  let l = layout(t)
  let (c, plain) = checked(tx, t, l)?
  let encoded = row_key(t, c, plain, key)?
  store.admit_read(tx, encoded)?
  match store.table_read(tx, copy encoded) {
    Some(data) => {
      let value: V = decode_value(c, l.value, plain, data)?
      Ok(Some(take value))
    },
    None() => Ok(None()),
  }
}

/// Inserts or replaces one row in the transaction's write set.
pub fn put[K: key + serializable, V: serializable](
  mut tx: store.Tx,
  t: Table[K, V],
  key: K,
  value: V
) -> Result[(), store.TxError] {
  let l = layout(t)
  let (c, plain) = checked(tx, t, l)?
  writable(c)?
  let physical_key = row_key(t, c, plain, key)?
  let encoded_value = row_value(next_epoch(c) - 1, current(c).value, value, plain)?
  store.table_put(mut tx, take physical_key, take encoded_value)
}

/// Deletes one row and reports whether it existed in this transaction.
pub fn delete[K: key + serializable, V: serializable](
  mut tx: store.Tx,
  t: Table[K, V],
  key: K
) -> Result[bool, store.TxError] {
  let l = layout(t)
  let (c, plain) = checked(tx, t, l)?
  writable(c)?
  let encoded = row_key(t, c, plain, key)?
  store.admit_write(tx, encoded)?
  let exists = match store.table_read(tx, copy encoded) {
    Some(_) => true,
    None() => false,
  }
  if exists {
    store.table_delete(mut tx, take encoded)?
  }
  Ok(exists)
}

// The least row key of `t`'s rows a lower bound admits.
fn lower[K: key + serializable](
  schema: Bytes,
  prefix: Bytes,
  renames: List[(String, String)],
  plain: bool,
  b: store.RangeBound[K]
) -> Result[Bytes, store.TxError] uses {} {
  match b {
    Included(key) => Ok(concat(prefix, encoded_key(schema, key, renames, plain)?)),
    Excluded(key) => Ok(successor(concat(prefix, encoded_key(schema, key, renames, plain)?))),
    Unbounded() => Ok(unique prefix),
  }
}

// The least row key above every key an upper bound admits; `None()` for none.
fn upper[K: key + serializable](
  schema: Bytes,
  prefix: Bytes,
  renames: List[(String, String)],
  plain: bool,
  b: store.RangeBound[K]
) -> Result[Option[Bytes], store.TxError] uses {} {
  match b {
    Included(key) => Ok(Some(successor(concat(prefix, encoded_key(schema, key, renames, plain)?)))),
    Excluded(key) => Ok(Some(concat(prefix, encoded_key(schema, key, renames, plain)?))),
    Unbounded() => Ok(keys.prefix_end(prefix)),
  }
}

// How a range reads its rows' keys: the stored key schema, parsed once, its
// renames, and `Option[K]`'s `None()` envelope for rows that are `plain`.
type KeyReader {
  schema: Bytes,
  parsed: keys.Envelope,
  renames: List[(String, String)],
  none: Bytes,
  plain: bool,
}

fn key_reader(c: Catalog, none: Bytes, plain: bool) -> KeyReader uses {} {
  let schema = key_schema(c)
  KeyReader(
    parsed: keys.key_schema(schema),
    schema: take schema,
    renames: unique c.renames,
    none: unique none,
    plain: plain
  )
}

// The key a row key's encoded part `raw` holds.
fn decode_key[K: key + serializable](r: KeyReader, raw: Bytes) -> Result[K, store.TxError] uses {} {
  let payload = match keys.decode_payload(r.parsed, raw) {
    Ok(p) => p,
    Error(_) => return Error(corrupt()),
  }
  let key: Result[K, DecodeError] = if r.plain {
    from_payload(r.none, payload)
  } else {
    internal.table_schema.decode(r.schema, payload, r.renames)
  }
  match take key {
    Ok(k) => Ok(take k),
    Error(_) => Error(corrupt()),
  }
}

fn successor(k: Bytes) -> Bytes uses {} {
  concat(k, b"\x00")
}

/// Scans in key value order with inclusive/exclusive bounds and a positive limit.
pub fn range[K: key + serializable, V: serializable](
  tx: store.Tx,
  t: Table[K, V],
  from: store.RangeBound[K],
  to: store.RangeBound[K],
  limit: u64,
  order: store.ScanOrder
) -> Result[List[(K, V)], store.TxError] {
  if limit == 0 {
    return Error(InvalidInput())
  }
  let l = layout(t)
  let (c, plain) = checked(tx, t, l)?
  let prefix = rows_of(table_name(t), c.generation)
  let schema = key_schema(c)
  let low = lower(schema, prefix, c.renames, plain, from)?
  let high = upper(schema, prefix, c.renames, plain, to)?
  let rows = store.table_range(tx, take low, take high, limit, order)?
  let reader = key_reader(c, l.key, plain)
  let mut out: List[(K, V)] = []
  for (key, value) in rows {
    if bytes.len(key) < bytes.len(prefix) || bytes.slice(key, 0, bytes.len(prefix)) != prefix {
      return Error(corrupt())
    }
    let k: K = decode_key(reader, bytes.slice(key, bytes.len(prefix), bytes.len(key)))?
    list.push(mut out, (take k, decode_value(c, l.value, plain, value)?))
  }
  Ok(take out)
}

/// The whole table with `access`: its rows, its catalog entry, where the
/// library keeps its live schemas and renames, and its schema history rows. It reads nothing, so it
/// serves a table the body will create. An invalid name holds no key.
pub fn scope[K: key + serializable, V: serializable](t: Table[K, V], access: store.Access) -> store.KeyScope uses {} {
  let name = table_name(t)
  if !valid(name) {
    return store.interval(b"", Some(b""), access)
  }
  let prefix = table_rows(name)
  store.join(store.interval(copy prefix, keys.prefix_end(prefix), access), catalog_span(name, access))
}

/// The rows whose keys lie between `from` and `to` with `access`, and the
/// table's catalog entry and history rows read only: enough for get, put, delete, range and
/// history on those rows, and not to create, drop or rename the table. It reads
/// the catalog through `tx` to encode the bounds and fails as `get` does.
pub fn scope_keys[K: key + serializable, V: serializable](
  tx: store.Tx,
  t: Table[K, V],
  from: store.RangeBound[K],
  to: store.RangeBound[K],
  access: store.Access
) -> Result[store.KeyScope, store.TxError] {
  let l = layout(t)
  let (c, plain) = checked(tx, t, l)?
  let name = table_name(t)
  let prefix = rows_of(name, c.generation)
  let schema = key_schema(c)
  let low = lower(schema, prefix, c.renames, plain, from)?
  let high = upper(schema, prefix, c.renames, plain, to)?
  Ok(store.join(store.interval(low, high, access), catalog_span(name, Read())))
}

/// Returns the immutable schema history; hashes exclude package version text.
pub fn history(tx: store.Tx, name: String) -> Result[List[SchemaEntry], store.TxError] {
  let c = load_catalog(tx, name)?
  // The history rows are the table's own namespace: `range_rows` does not
  // bound reading them, as it did not bound the catalog value they were.
  let prefix = history_rows(name)
  let end = keys.prefix_end(prefix)
  let rows = store.table_all(tx, take prefix, take end, false)?
  let mut out: List[SchemaEntry] = []
  for (key, value) in rows {
    let n = list.len(out)
    if key != history_key(name, n) {
      return Error(corrupt())
    }
    let decoded: Result[Epoch, DecodeError] = codec.decode(value)
    let epoch = match take decoded {
      Ok(e) => e,
      Error(_) => return Error(corrupt()),
    }
    list.push(
      mut out,
      SchemaEntry(
        epoch: int.truncate(n),
        key_schema: sha256.digest_hex(epoch.key),
        value_schema: sha256.digest_hex(epoch.value),
        change: unique epoch.change
      )
    )
  }
  if list.len(out) != next_epoch(c) {
    return Error(corrupt())
  }
  Ok(take out)
}

/// Declares a spelling change once, appending metadata without rewriting rows.
pub fn rename(mut tx: store.Tx, name: String, from: String, to: String) -> Result[
  (),
  store.TxError
] {
  if from == "" || to == "" || from == to {
    return Error(InvalidInput())
  }
  if !valid(name) {
    return Error(InvalidInput())
  }
  store.admit_write(tx, metadata_key(name))?
  let mut c = load_catalog(tx, name)?
  writable(c)?
  let latest = current(c)
  let key = internal.table_schema.rename_schema(latest.key, from, to)
  let value = internal.table_schema.rename_schema(latest.value, from, to)
  let mut changed = false
  let next_key = match take key {
    Ok(k) => {
      changed = true
      k
    },
    Error(_) => unique latest.key,
  }
  let next_value = match take value {
    Ok(v) => {
      changed = true
      v
    },
    Error(_) => unique latest.value,
  }
  if !changed {
    return Error(InvalidInput())
  }
  let epoch = Epoch(key: take next_key, value: take next_value, change: Renamed(unique from, unique to))
  record(mut tx, name, next_epoch(c), epoch)?
  list.push(mut c.epochs, live(epoch))
  list.push(mut c.renames, (unique from, unique to))
  save(mut tx, name, c)?
  Ok(())
}

/// Removes the table, its rows and its schema history: one transaction removes
/// its catalog entry, and its rows and history go in transactions that each fit the
/// store's limits, so a drop is bounded by no commit limit. A refusal is
/// `Aborted(e)`, with the error `e` of the table operations.
pub fn drop[K: key + serializable, V: serializable, S](mut s: store.Store[S], t: Table[K, V]) -> Result[
  (),
  store.TxFailure[store.TxError]
] {
  store.transact_body(
    mut s,
    fn(mut tx: store.Tx) -> Result[(), store.TxError] {
      let (c, _) = checked(tx, t, layout(t))?
      writable(c)?
      let name = table_name(t)
      store.table_delete(mut tx, metadata_key(name))?
      store.table_put(mut tx, store.garbage(history_rows(name)), b"")?
      store.table_put(mut tx, store.garbage(rows_of(name, c.generation)), b"")
    }
  )?
  store.collect(mut s) ? Storage
  Ok(())
}

// A migration transaction's outcome as the migration's.
fn settled[R, E](take r: Result[R, store.TxFailure[MigrateError[E]]]) -> Result[
  R,
  MigrateError[E]
] uses {} {
  match take r {
    Ok(v) => Ok(take v),
    Error(Aborted(why)) => Error(take why),
    Error(Storage(e)) => Error(Table(Storage(take e))),
    Error(Unknown(e)) => Error(Table(Storage(take e))),
    Error(Limit(l)) => Error(Table(Limit(l))),
    Error(Canceled(cause)) => Error(Canceled(cause)),
    Error(Faulted(failure)) => Error(Faulted(take failure)),
  }
}

// The first transaction: finish at once, or mark the table.
type Start = Current | Marked(Catalog)

// Marks the table as migrating and records the next generation as garbage
// that, once deleted, restores the unmarked catalog: a migration that does
// not install leaves the table as it was, after a crash too.
fn start[
  J: key + serializable,
  A: serializable,
  K: key + serializable,
  B: serializable,
  E: serializable
](mut tx: store.Tx, from: Table[J, A], to: Table[K, B]) -> Result[Start, MigrateError[E]] {
  let name = table_name(from)
  let c = load_catalog(tx, name) ? Table
  if let Ok(_) = schemas(c, layout(to)) {
    return Ok(Current())
  }
  let _ = schemas(c, layout(from)) ? Table
  let catalog = metadata_key(name)
  let generation = next_generation(c.generation)
  unused(tx, take rows_of(name, generation)) ? Table
  let next = rows_of(name, generation)
  store.table_put(mut tx, store.garbage(next), store.restoring(catalog, codec.encode(c))) ? Table
  let marked = Catalog(
    base: c.base,
    epochs: unique c.epochs,
    renames: unique c.renames,
    generation: c.generation,
    migrating: true,
    witness: unique c.witness
  )
  save(mut tx, name, marked) ? Table
  Ok(Marked(take c))
}

// How far a migration has come: the last source key migrated and the rows
// migrated so far.
type Progress {
  cursor: Option[Bytes],
  count: u64,
}

// Applies `f` to up to `batch` rows after the cursor, in key order, writing
// each result into the next generation under the target schema. Returns the
// advanced progress and whether rows may remain.
fn advance[
  J: key + serializable,
  A: serializable,
  K: key + serializable,
  B: serializable,
  E: serializable
](
  mut tx: store.Tx,
  name: String,
  catalog: Catalog,
  source: Layout,
  f: Entry[fn(c: (), key: J, old: A) -> Result[(K, B), E]],
  p: Progress,
  batch: u64
) -> Result[(Progress, bool), MigrateError[E]] {
  let prefix = rows_of(name, catalog.generation)
  let low = match p.cursor {
    Some(last) => successor(last),
    None() => copy prefix,
  }
  let rows = store.table_range(tx, take low, keys.prefix_end(prefix), batch, Ascending()) ? Table
  let source_plain = own_rows(catalog, source)
  let reader = key_reader(catalog, source.key, source_plain)
  let next = rows_of(name, next_generation(catalog.generation))
  let epoch = next_epoch(catalog)
  let mut cursor: Option[Bytes] = match p.cursor {
    Some(last) => Some(unique last),
    None() => None(),
  }
  let mut count = p.count
  for (key, value) in rows {
    let old_key: J = decode_key(reader, bytes.slice(key, bytes.len(prefix), bytes.len(key))) ? Table
    let old: A = decode_value(catalog, source.value, source_plain, value) ? Table
    let (new_key, new_value) = match core@1/runner.apply(f, (), old_key, old) {
      Ok(Ok(row)) => row,
      Ok(Error(e)) => return Error(Failed(take e)),
      Error(failure) => return Error(Faulted(take failure)),
    }
    // The target rows are the codec's own encodings of K and B.
    let row = concat(next, encoded_key(b"", new_key, [], true) ? Table)
    if let Some(_) = store.table_read(tx, copy row) {
      return Error(Collision())
    }
    let data = row_value(epoch, b"", new_value, true) ? Table
    store.table_put(mut tx, take row, take data) ? Table
    cursor = Some(unique key)
    count += 1
  }
  Ok((Progress(cursor: take cursor, count: count), list.len(rows) == batch))
}

// The install: the catalog names the next generation and the target schema
// as its only live epoch, the history gains that epoch, and the replaced
// generation becomes garbage. It writes four keys whatever the table's size.
fn install[K: key + serializable, B: serializable, E](
  mut tx: store.Tx,
  to: Table[K, B],
  c: Catalog,
  entry: EntryId
) -> Result[(), MigrateError[E]] {
  let name = table_name(to)
  let generation = next_generation(c.generation)
  let l = layout(to)
  let epoch = Epoch(key: schema_of(l.key), value: schema_of(l.value), change: Migrated(unique entry))
  record(mut tx, name, next_epoch(c), epoch) ? Table
  let next = Catalog(
    base: next_epoch(c),
    epochs: [live(epoch)],
    renames: [],
    generation: generation,
    migrating: false,
    witness: take l
  )
  save(mut tx, name, next) ? Table
  store.table_delete(mut tx, store.garbage(rows_of(name, generation))) ? Table
  store.table_put(mut tx, store.garbage(rows_of(name, c.generation)), b"") ? Table
  Ok(())
}

// Discards a migration and returns `why`, or the failure that prevented the
// discard.
fn abandon[S, R, E](mut s: store.Store[S], take why: MigrateError[E]) -> Result[
  R,
  MigrateError[E]
] {
  // An abandoned migration's next generation is garbage; deleting it puts back
  // the unmarked catalog entry.
  if let Error(e) = store.collect(mut s) {
    return Error(Table(Storage(take e)))
  }
  Error(take why)
}

// Whether a step was refused for the commit's size: the table is unchanged,
// and the migration is discarded with `Table(Limit(l))`.
fn over_limit[R, E](r: Result[R, store.TxFailure[MigrateError[E]]]) -> Option[store.TxLimit] uses {} {
  match r {
    Error(Limit(l)) => Some(l),
    Error(Aborted(Table(Limit(l)))) => Some(l),
    _ => None(),
  }
}

/// Migrates every row of a table from schema (J, A) to (K, B) with the pure
/// row function `f`, in batches of `batch` rows per transaction, checking
/// `within` for cancellation between them (STORE-9). The new rows go to the
/// table's next generation, and one small transaction installs it, so a
/// migration is bounded by no commit limit. The table is unchanged unless
/// every row migrates: a row function's error, a failure in it, a key
/// collision, cancellation or a refused commit discards the migration.
pub fn migrate[
  J: key + serializable,
  A: serializable,
  K: key + serializable,
  B: serializable,
  E: serializable,
  S
](
  within: Scope,
  mut s: store.Store[S],
  from: Table[J, A],
  to: Table[K, B],
  f: Entry[fn(c: (), key: J, old: A) -> Result[(K, B), E]],
  batch: u64
) -> Result[u64, MigrateError[E]] {
  let name = table_name(from)
  if !valid(name) || table_name(to) != name || batch == 0 || batch > s.config.limits.range_rows {
    return Error(Table(InvalidInput()))
  }
  let begun = store.transact_body(
    mut s,
    fn(mut tx: store.Tx) -> Result[Start, MigrateError[E]] {
      start(mut tx, from, to)
    }
  )
  let c = match settled(take begun)? {
    Current() => return Ok(0),
    Marked(c) => take c,
  }
  let mut progress = Progress(cursor: None(), count: 0)
  let mut more = true
  while more {
    if let Error(Canceled(cause)) = core@1/task.check_canceled(within) {
      let canceled: MigrateError[E] = Canceled(cause)
      return abandon(mut s, take canceled)
    }
    let held = take progress
    let stepped = store.transact_body(
      mut s,
      fn(mut tx: store.Tx) -> Result[(Progress, bool), MigrateError[E]] {
        advance(mut tx, name, c, layout(from), f, held, batch)
      }
    )
    if let Some(l) = over_limit(stepped) {
      let refused: MigrateError[E] = Table(Limit(l))
      return abandon(mut s, take refused)
    }
    match take stepped {
      Ok((next, rest)) => {
        progress = take next
        more = rest
      },
      Error(Aborted(why)) => return abandon(mut s, take why),
      Error(other) => {
        let failed: Result[u64, store.TxFailure[MigrateError[E]]] = Error(take other)
        return settled(take failed)
      },
    }
  }
  let entry = core@1/runner.entry_id(f)
  let installed = store.transact_body(
    mut s,
    fn(mut tx: store.Tx) -> Result[(), MigrateError[E]] {
      install(mut tx, to, c, entry)
    }
  )
  // The install writes the catalog entry, a history row and two garbage
  // entries; one too
  // large for a commit leaves the table as it was.
  if let Some(l) = over_limit(installed) {
    let refused: MigrateError[E] = Table(Limit(l))
    return abandon(mut s, take refused)
  }
  settled(take installed)?
  // The replaced generation is garbage.
  if let Error(e) = store.collect(mut s) {
    return Error(Table(Storage(take e)))
  }
  Ok(progress.count)
}

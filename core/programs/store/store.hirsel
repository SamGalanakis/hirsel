type TypedReader: send {
    held: Snapshot,
    sh: Shape[u64, u64]
}

@test
fn test_typed_snapshot_task(c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    for k in 0u64 .. 24 {
        if !typed_put(mut db, t, k, k + 1) {
            return Error(())
        }
    }
    let payload = TypedReader(held: snapshot(db), sh: shape(t))
    let reader = task.spawn(tasks, bytes 1048576, take payload, fn(take p: TypedReader) -> bool {
        let mut rows = result.unwrap(scan(p.held, p.sh, Unbounded, Unbounded))
        for k in 0u64 .. 24 {
            if typed_value(p.held, p.sh, k) != k + 1 {
                return false
            }
            match get_bytes(p.held, p.sh, k) {
                Ok(Some(raw)) => if raw != schema_zero_bytes(k + 1) { return false },
                _ => return false,
            }
            match result.unwrap(next(mut rows)) {
                Some((key, value)) => if key != k || value != k + 1 {
                    return false
                },
                None => return false
            }
        }
        result.unwrap(next(mut rows)) == None
    })
    for k in 0u64 .. 1000 {
        if !typed_put(mut db, t, k % 24, k + 10000) {
            return Error(())
        }
    }
    if result.unwrap(task.join(take reader)) {
        Ok(())
    } else {
        Error(())
    }
}

// A follower owns the last snapshot after the writer is consumed.
pub fn law_close_follow(c: Clock) -> bool waits {
    let mut db = raw_test_db(c, 1073741824)
    let h = result.unwrap(follow(mut db, Branch(store: StoreId(hi: 1, lo: 2), id: 0)))
    if !put_one(mut db, 1, 10) {
        return false
    }
    if !put_one(mut db, 2, 20) {
        return false
    }
    result.unwrap(close(take db))
    let root = latest.read(h)
    version(root) == 2 && value_at(root, 1) == 10 && value_at(root, 2) == 20
}


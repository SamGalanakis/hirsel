#!/usr/bin/env python3
"""Build an isolated distribution bundle, optionally with reproducible PGO.

    tools/toolchain-dist/build --output /tmp/dist [--pgo --profdata /path/to/llvm-profdata]

Uses Buck2's remote pool. Training uses one tools/capped command at a time.
Keep output and work outside the repository; generated profiles are never committed.
"""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

import notices

ROOT = Path(__file__).resolve().parents[2]
BUCK = ROOT / '.buck2/bin/buck2'
PROFILE = Path(__file__).with_name('profile.profdata')


def build(mode, output, options):
    done = subprocess.run([str(BUCK), 'build', '--target-platforms', '//tools/buck2:dist',
                           *options,
                           '-c', 'hirsel.dist_pgo=' + mode, '//:hirsel-toolchain', '--show-json-output'],
                          cwd=ROOT, stdout=subprocess.PIPE, text=True, check=True)
    bundle = ROOT / json.loads(done.stdout)['root//:hirsel-toolchain']
    shutil.copytree(bundle, output, dirs_exist_ok=True)


def witness(output):
    try:
        with (tempfile.TemporaryDirectory(prefix='hirsel-prefix-', dir=output.parent) as prefix,
              tempfile.TemporaryDirectory(prefix='hirsel-witness-', dir=output.parent) as scratch):
            moved, work = Path(prefix), Path(scratch)
            output.rename(moved)
            compiler = moved / 'hirsel'
            project = work / 'app'
            env = dict(PATH=os.defpath, HOME=scratch, TMPDIR=scratch, HIRSEL_JOBS='1')
            subprocess.run([compiler, 'new', project], cwd=work, env=env, check=True)
            (project / 'main.hirsel').write_text(r'''pub fn main(out: Stdout) -> Result[(), Exit] waits {
    let value = result.unwrap(std.int.parse_uint("2a", 16))
    let mut line = string.new()
    result.unwrap(string.push_u64(mut line, value))
    result.unwrap(string.push_char(mut line, '\n'))
    result.unwrap(stdout.write(out, line))
    Ok(())
}
''')
            # Hexadecimal 2a is 2 * 16 + 10 = 42. The program writes it in decimal with a newline.
            expected = b'42\n'
            for backend in ('cranelift', 'llvm'):
                executable = work / backend
                subprocess.run([compiler, 'build', project, '--backend', backend,
                                '--grant', 'Stdout', '-o', executable],
                               cwd=work, env=env, check=True)
                actual = subprocess.check_output([executable], cwd=work, env=env)
                if actual != expected:
                    raise ValueError(f'{backend} relocation witness wrote {actual!r}, expected {expected!r}')
                print(f'dist: {backend} relocation witness passed', flush=True)
            moved.rename(output)
    except BaseException:
        if output.exists():
            shutil.rmtree(output)
        raise


def manifest(output, mode):
    try:
        notices.collect(output, mode)
    except Exception:
        shutil.rmtree(output)
        raise
    def command(*args):
        return subprocess.check_output(args, cwd=ROOT, text=True).strip()
    def digest(path):
        return hashlib.sha256(path.read_bytes()).hexdigest()
    record = dict(commit=command('git', 'rev-parse', 'HEAD'),
                  patch_sha256=hashlib.sha256(command('git', 'diff', 'HEAD').encode()).hexdigest(),
                  rustc=command(str(ROOT / 'tools/buck2/toolchains/rust-files/bin/rustc'), '-vV'),
                  profile='dist', pgo=mode, lto='fat', codegen_units=1,
                  training='hirsel new project: check, Cranelift, LLVM',
                  hirsel_sha256=digest(output / 'hirsel'),
                  core_packages_sha256=hashlib.sha256(json.dumps({str(p.relative_to(output / 'core-packages')): digest(p) for p in sorted((output / 'core-packages').rglob('*')) if p.is_file()}, sort_keys=True, separators=(',', ':')).encode()).hexdigest(),
                  notices_sha256=digest(output / 'notices/manifest.json'))
    if mode == 'use':
        record['profdata_sha256'] = digest(output / 'hirsel.profdata')
    (output / 'hirsel-build.json').write_text(json.dumps(record, indent=2) + '\n')


@contextmanager
def profile_lock():
    # serialize pipeline writers in this checkout; each lane has its own file.
    lock = ROOT / '.buck2/dist-pgo.lock'
    with lock.open('w') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--work', type=Path)
    parser.add_argument('--pgo', action='store_true')
    parser.add_argument('--cpu', type=int, default=8)
    parser.add_argument('--local', action='store_true', help='build locally without the remote action cache')
    parser.add_argument('--num-threads', type=int, help='Buck2 execution threads')
    parser.add_argument('--profdata', help='LLVM tools matching the pinned rustc')
    args = parser.parse_args()
    output = args.output.resolve()
    if output.exists():
        parser.error('output already exists; use a fresh directory')
    if output.is_relative_to(ROOT):
        parser.error('output must be outside the checkout')
    work = args.work.resolve() if args.work else output.with_name(output.name + '-work')
    prepare = ['python3', 'tools/buck2/prepare.py']
    options = []
    if args.local:
        prepare.append('--local')
        options.append('--no-remote-cache')
    if args.num_threads is not None:
        options.extend(['--num-threads', str(args.num_threads)])
    subprocess.run(prepare, cwd=ROOT, check=True)
    if not args.pgo:
        build('off', output, options)
        manifest(output, 'off')
        witness(output)
        return
    with profile_lock():
        if args.profdata is None:
            args.profdata = subprocess.check_output([str(ROOT / 'tools/toolchain-dist/profile-tools')], text=True).strip()
        work.mkdir(parents=True, exist_ok=True)
        instrumented = work / 'instrumented'
        raw = work / 'raw'
        if raw.exists():
            raise SystemExit(f'{raw} exists: use a fresh work directory to avoid stale profiles')
        build('generate', instrumented, options)
        subprocess.run([str(ROOT / 'tools/toolchain-dist/train'), '--toolchain', str(instrumented),
                        '--work', str(work / 'corpus'), '--raw', str(raw), '--cpu', str(args.cpu)], cwd=ROOT, check=True)
        profiles = sorted(raw.glob('*.profraw'))
        if not profiles or any(p.stat().st_size == 0 for p in profiles):
            raise SystemExit('training left an empty or missing raw profile')
        merged = work / 'merged.profdata'
        subprocess.run([str(ROOT / 'tools/capped'), args.profdata, 'merge',
                        '-o', str(merged), *map(str, profiles)],
                       env=dict(os.environ, HIRSEL_JOBS='1'), check=True)
        subprocess.run([args.profdata, 'show', str(merged)], check=True)
        shutil.copyfile(merged, PROFILE)
        build('use', output, options)
        shutil.copyfile(merged, output / 'hirsel.profdata')
        manifest(output, 'use')
        witness(output)


if __name__ == '__main__':
    main()

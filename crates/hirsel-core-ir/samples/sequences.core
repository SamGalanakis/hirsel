; Destination allocation refusals close the region, then explicitly unwrap Capacity.
; CoreIR sample, family: compact sequences written in place (MEM-4, MEM-9, MEM-12 at spec
; 6ef88514), lowered as the crate docs' "Compact data" says: a blob is a region block
; of a 16-byte engine header (used bytes, then W) and the data; every blob byte is
; reached through a `byte` step; `finish_trim` is `trim`; identities come from
; `rt.dest_id`.
;
; Source (package samples@0, module seq):
;   @compact(u32) stable type J = Null | Arr(SeqSpan[J])
;   f0: build_stream_in(r, bytes n, w) whose writer emits Arr, then appends k Nulls and
;       closes; finish_trim; returns (status, count, byte length, used, room left)
;   f1: dest.put of a literal holding one Link child that is from this destination or
;       (foreign) from another one, into a destination with n bytes left
;   f2: build_stream_in of a root IndexedSpan[u16] (W = u64) of k elements 0, 7, 14, ..,
;       closed, finish_trim, then indexed.get(s, 2)
; Status 0 is Ok, 1 is Error(Overflow) (a value, not a failure). The room left is read
; by a probe allocation the root limit refuses (MEM-22).
;
; Behaviour, derived by hand. J's Arr is tag 1 (1 byte), count and byte length (4 + 4),
; then one tag byte per Null: 9 + k bytes. The charge is round8(n) until finish_trim
; lowers it to round8(used) (MEM-24).
; run limit 1000: f0(3, 64) -> 0, 3, 3, 12, 984 | used 0    ; 64 charged, trimmed to 16
; run limit 1000: f0(0, 9) -> 0, 0, 0, 9, 984 | used 0      ; an empty Arr fills 9 exactly
; run limit 1000: f0(3, 10) -> 1, 1, 0, 0, 984 | used 0     ; the second Null does not fit
; run limit 1000: f0(3, 8) -> 1, 0, 0, 0, 992 | used 0      ; the header does not fit
; A Link is 4 bytes at W = u32; the identity check comes before the size check:
; run: f1(true, 0) -> fail Bounds    ; foreign and too big: Bounds, not Overflow
; run: f1(true, 64) -> fail Bounds
; run: f1(false, 0) -> 1
; run: f1(false, 4) -> 0
; IndexedSpan[u16] of 3 at W = u64: count and length 16, elements 6 (length 6), then a
; trailer of 3 offsets 0, 2, 4 (24 bytes), checked whole before the first is stored:
; used 46. get(s, 2) loads offset 4, then the element there: 14.
; run limit 1000: f2(3, 64) -> 0, 46, 14 | used 0
; run limit 1000: f2(3, 46) -> 0, 46, 14 | used 0           ; the trailer fits exactly
; run limit 1000: f2(3, 40) -> 1, 0, 0 | used 0             ; the elements fit, the trailer not
core v1
sig g0 = (u64, u64) -> (u64, u64, u64, u64, u64)
sig g1 = () -> (u64)
sig g2 = (bool, u64) -> (u64)
sig g3 = (u64, u64) -> (u64, u64, u64)
inst n0 = samples@0/seq/nulls [] []
inst n1 = samples@0/seq/put [] []
inst n2 = samples@0/seq/indexed [] []

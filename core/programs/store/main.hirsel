// S1 law window: map persistence, snapshots, read spans, CallInfo and capacity.
fn make_bytes(n: u64) -> Bytes {
    let mut out: Bytes = list.new()
    let mut i: u64 = 0
    while i < n {
        result.unwrap(list.push(mut out, int.truncate(i)))
        i += 1
    }
    out
}

fn commit_body(mut tx: store.Tx) -> Result[bool, store.Error] {
    store.put_bytes(mut tx, 1, make_bytes(1), make_bytes(2))?
    let value = store.fetch_bytes(mut tx, 1, make_bytes(1))?
    match value {
        Some(_) => Ok(true),
        None => Ok(false)
    }
}

fn empty_body(mut tx: store.Tx) -> Result[bool, store.Error] {
    store.touch(mut tx)?
    Ok(true)
}

fn memory_law() -> bool {
    let o = store.defaults()
    let db = store.memory_with_id(store.StoreId(hi: 1, lo: 2), o)
    let snap = store.snapshot(db)
    match store.get_bytes(snap, 1, make_bytes(1)) {
        Ok(None) => true,
        _ => false
    }
}

fn run_law() -> bool {
    let o = store.defaults()
    let mut db = store.memory_with_id(store.StoreId(hi: 1, lo: 2), o)
    match store.run(mut db, empty_body) {
        Ok(Committed(done)) => list.len(done.reads) == 0 && done.info.id.version == 1,
        _ => false
    }
}

fn omap_law() -> bool {
    let mut ids: u64 = 0
    let mut m: std.omap.OMap[Bytes, Bytes] = std.omap.new()
    m = result.unwrap(std.omap.insert(mut ids, m, make_bytes(1), make_bytes(2)))
    let held = std.omap.snapshot(m)
    m = result.unwrap(std.omap.insert(mut ids, m, make_bytes(3), make_bytes(4)))
    let old = match std.omap.get(held, make_bytes(1)) {
        Some(value) => value == make_bytes(2),
        None => false
    }
    let current = match std.omap.get(m, make_bytes(3)) {
        Some(value) => value == make_bytes(4),
        None => false
    }
    old && current && std.omap.len(held) == 1 && std.omap.len(m) == 2
}

pub fn main(out: Stdout) -> Result[(), Exit] waits {
    let ok = omap_law() && memory_law()
    let mut text = string.new()
    if ok {
        result.unwrap(string.push(mut text, "s1-ok\n"))
    } else {
        result.unwrap(string.push(mut text, "s1-failed\n"))
    }
    match stdout.write(out, text) {
        Ok(()) => if ok {
            Ok(())
        } else {
            Error(Exit(status: 1))
        },
        Error(_) => Error(Exit(status: 2))
    }
}

pub fn run_entry(clock: Clock, random: Random, out: Stdout) -> Result[(), Exit] waits {
    let _ = clock
    let _ = random
    let ok = run_law()
    let mut text = string.new()
    if ok {
        result.unwrap(string.push(mut text, "run-ok\n"))
    } else {
        result.unwrap(string.push(mut text, "run-failed\n"))
    }
    match stdout.write(out, text) {
        Ok(()) => if ok {
            Ok(())
        } else {
            Error(Exit(status: 1))
        },
        Error(_) => Error(Exit(status: 2))
    }
}

; CoreIR sample, family: scalar arithmetic (Const, Unary, Binary, IntArith, MulAdd, ScalarUnary).
;
; Source (package samples@0, module arith), one item per line:
;   i0  fn hyp(a: f64, b: f64) -> f64 { float.sqrt(float.mul_add(a, a, b * b)) }
;   i1  fn add(x: i32, y: i32) -> i32 { x + y }
;   i2  fn wrap(x: u8) -> u8 { int.wrapping_add(x, 100) }
;   i3  fn sat(x: u8) -> u8 { int.saturating_add(x, 100) }
;   i4  fn overflows(x: u8) -> bool { option.is_none(int.checked_add(x, 100)) }
;   i5  fn lz(x: u32) -> u32 { int.leading_zeros(x) }
;   i6  fn neg(x: i8) -> i8 { -x }
;   i7  fn qr(x: i64, y: i64) -> (i64, i64) { (x / y, x % y) }
;   i8  fn rem_min(y: i64) -> i64 { -9223372036854775808 % y }
;   i9  fn root(x: f64) -> f64 { float.sqrt(x) }
;   i10 fn root32(x: f32) -> f32 { float.sqrt(x) }
;   i11 fn ones8(x: u8) -> u32 { int.count_ones(x) }
;   i12 fn ones64(x: u64) -> u32 { int.count_ones(x) }
;   i13 fn ones_i8(x: i8) -> u32 { int.count_ones(x) }
;   i14 fn even(x: f64) -> f64 { float.round_even(x) }
;   i15 fn even32(x: f32) -> f32 { float.round_even(x) }
;
; Behaviour, derived by hand from SEM-1/SEM-2 (`fail C` = the run failed with cause C;
; an instruction without a failure block propagates, nothing to clean in these frames):
; run: f0(3, 4) -> 5                 ; 3*3 + 4*4 = 25, rounded once; sqrt 25 = 5
; run: f0(1e308, 1e308) -> inf       ; b*b overflows to inf; sqrt inf = inf
; run: f1(2, 3) -> 5
; run: f1(-5, 5) -> 0
; run: f1(2147483647, 1) -> fail Overflow    ; i32 overflow (SEM-1)
; run: f1(-2147483648, -1) -> fail Overflow
; run: f2(200) -> 44                 ; 300 mod 256
; run: f2(1) -> 101
; run: f3(200) -> 255                ; saturates at u8 MAX
; run: f3(154) -> 254
; run: f4(155) -> false              ; 255 fits
; run: f4(156) -> true               ; 256 does not
; run: f5(0) -> 32                   ; the width for zero
; run: f5(1) -> 31
; run: f5(4294967295) -> 0
; run: f6(5) -> -5
; run: f6(-127) -> 127
; run: f6(-128) -> fail Overflow             ; -(-128) does not fit i8
; run: f7(-7, 2) -> -3, -1           ; `/` truncates toward zero, `%` takes the dividend's sign
; run: f7(7, -2) -> -3, 1
; run: f7(-9223372036854775808, -1) -> fail Overflow   ; MIN / -1 (SEM-1)
; run: f7(1, 0) -> fail Division
; run: f8(-1) -> 0                   ; MIN % -1 is 0 and does not fail (SEM-1); a native
;                                    ; signed divide traps here, so the emitter tests -1
; run: f8(0) -> fail Division
; run: f9(0) -> 0                    ; float.sqrt (core.md "Floats"): IEEE 754 squareRoot, correctly rounded
; run: f9(0x8000000000000000) -> 0x8000000000000000   ; sqrt(-0) is -0
; run: f9(2) -> 0x3ff6a09e667f3bcd  ; sqrt 2 = 1.41421356237309504880..., nearest f64 (fraction 6a09e667f3bcc.908b... rounds up)
; run: f9(0x1) -> 0x1e60000000000000 ; the least subnormal 2^-1074; its root 2^-537 is exact: exponent 1023-537 = 486 = 0x1e6
; run: f9(inf) -> inf
; run: f9(0x7ff8000000000001) -> 0x7ff8000000000000  ; a NaN operand gives the canonical NaN (SEM-2)
; run: f9(-1) -> 0x7ff8000000000000 ; below zero gives the canonical NaN, not x86's default 0xfff8000000000000
; run: f9(-inf) -> 0x7ff8000000000000
; run: f10(2) -> 0x3fb504f3          ; nearest f32 to sqrt 2 (fraction 3504f3.33f... rounds down)
; run: f10(-2) -> 0x7fc00000         ; the f32 canonical NaN
; run: f11(0) -> 0                   ; int.count_ones (SEM-1): the one bits of the value at its width
; run: f11(1) -> 1
; run: f11(255) -> 8                 ; all ones of a u8
; run: f11(165) -> 4                 ; 0xa5 = 1010 0101
; run: f12(18446744073709551615) -> 64   ; all ones of a u64
; run: f12(9223372036854775809) -> 2    ; 0x8000000000000001: the top and bottom bits
; run: f13(-1) -> 8                  ; i8 -1 is 0xff: eight ones at width 8, not 64
; run: f13(-128) -> 1                ; 0x80
; run: f14(0.5) -> 0                 ; float.round_even (core.md "Floats"): ties to the even integer
; run: f14(1.5) -> 2
; run: f14(2.5) -> 2                 ; not 3: float.round (ties away) gives 3
; run: f14(-0.5) -> 0x8000000000000000   ; -0.5 ties to -0, the sign of a zero result kept
; run: f14(-2.5) -> -2
; run: f14(3) -> 3                   ; already integral: unchanged
; run: f14(2.4999999999999996) -> 2  ; just below a tie: the nearest, 2
; run: f14(inf) -> inf               ; infinities unchanged
; run: f14(0x7ff8000000000001) -> 0x7ff8000000000000  ; a NaN gives the canonical NaN (SEM-2)
; run: f15(2.5) -> 2
; run: f15(3.5) -> 4
core v1
item i0 = samples@0/arith/hyp
item i1 = samples@0/arith/add
item i2 = samples@0/arith/wrap
item i3 = samples@0/arith/sat
item i4 = samples@0/arith/overflows

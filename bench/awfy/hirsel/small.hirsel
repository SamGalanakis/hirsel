// AWFY JavaScript: som.js, bounce.js, permute.js, queens.js and sieve.js.
pub fn next_random(mut seed: u32) -> u32 {
    seed = (seed * 1309 + 13849) & 65535
    seed
}

type Ball {
    x: i32,
    y: i32,
    vx: i32,
    vy: i32
}

fn step(mut ball: Ball) -> bool {
    let mut bounced = false
    ball.x += ball.vx
    ball.y += ball.vy
    if ball.x > 500 {
        ball.x = 500
        ball.vx = 0 - int.abs(ball.vx)
        bounced = true
    }
    if ball.x < 0 {
        ball.x = 0
        ball.vx = int.abs(ball.vx)
        bounced = true
    }
    if ball.y > 500 {
        ball.y = 500
        ball.vy = 0 - int.abs(ball.vy)
        bounced = true
    }
    if ball.y < 0 {
        ball.y = 0
        ball.vy = int.abs(ball.vy)
        bounced = true
    }
    bounced
}

pub fn bounce() -> u32 {
    let mut seed = 74755u32
    let mut balls: Inline[Ball, 100] =[Ball(x: 0, y: 0, vx: 0, vy: 0); 100]
    for i in 0u64 .. 100 {
        let x: i32 = int.narrow(next_random(mut seed) % 500)
        let y: i32 = int.narrow(next_random(mut seed) % 500)
        let vx: i32 = int.narrow(next_random(mut seed) % 300)
        let vy: i32 = int.narrow(next_random(mut seed) % 300)
        balls[i] = Ball(x: x, y: y, vx: vx - 150, vy: vy - 150)
    }
    let mut count = 0u32
    for _ in 0u64 .. 50 {
        for j in 0u64 .. 100 {
            if step(mut balls[j]) {
                count += 1
            }
        }
    }
    count
}

type Permutation {
    values: Inline[i32, 6],
    count: u32
}

fn swap(mut p: Permutation, i: u64, j: u64) {
    let old = p.values[i]
    p.values[i] = p.values[j]
    p.values[j] = old
}

fn visit(mut p: Permutation, n: u64) {
    p.count += 1
    if n != 0 {
        let n1 = n - 1
        visit(mut p, n1)
        let mut remaining = n
        while remaining > 0 {
            remaining -= 1
            swap(mut p, n1, remaining)
            visit(mut p, n1)
            swap(mut p, n1, remaining)
        }
    }
}

pub fn permute() -> u32 {
    let mut p = Permutation(values:[0; 6], count: 0)
    visit(mut p, 6)
    p.count
}

type Board {
    rows: Inline[bool, 8],
    maxs: Inline[bool, 16],
    mins: Inline[bool, 16],
    queen_rows: Inline[i32, 8]
}

fn available(board: Board, r: u64, c: u64) -> bool {
    board.rows[r] && board.maxs[c + r] && board.mins[c + 7 - r]
}

fn set_available(mut board: Board, r: u64, c: u64, free: bool) {
    board.rows[r] = free
    board.maxs[c + r] = free
    board.mins[c + 7 - r] = free
}

fn place_queen(mut board: Board, column: u64) -> bool {
    for row in 0u64 .. 8 {
        if available(board, row, column) {
            board.queen_rows[row] = int.narrow(column)
            set_available(mut board, row, column, false)
            if column == 7 || place_queen(mut board, column + 1) {
                return true
            }
            set_available(mut board, row, column, true)
        }
    }
    false
}

fn solve_queens() -> bool {
    let mut board = Board(rows:[true; 8], maxs:[true; 16], mins:[true; 16], queen_rows:[-1; 8])
    place_queen(mut board, 0)
}

pub fn queens() -> bool {
    let mut solved = true
    for _ in 0u64 .. 10 {
        solved = solved && solve_queens()
    }
    solved
}

pub fn sieve() -> u32 {
    let mut flags: Inline[bool, 5000] =[true; 5000]
    let mut count = 0u32
    for i in 2u64 .. 5001 {
        if flags[i - 1] {
            count += 1
            let mut multiple = i + i
            while multiple <= 5000 {
                flags[multiple - 1] = false
                multiple += i
            }
        }
    }
    count
}

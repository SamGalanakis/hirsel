// Prefix selection and conservative candidate confirmation adapted from
// rust-lang/regex 80b9d14e, regex-automata/src/meta/strategy.rs:81-153,
// util/prefilter/mod.rs:584-688 and hybrid/search.rs:50-90.
// Copyright (c) 2014 The Rust Project Developers. MIT; third-party/NOTICES.md.
// Prefixes use packed byte-pair candidates without confirming a literal
// that the ordered engine will scan again. Single bytes use the core scanner.
// Every candidate is confirmed by the ordered engine on the original source.

type PrefixPlan {
  enabled: bool,
  low: u64,
  high: u64,
  literals: List[String],
  // Low 16 bits are literal fold flags; upper bits hold an exact singleton
  // pair offset. Prefix extraction already limits literals to sixteen bytes.
  folds: List[u64],
  firsts: Bytes,
  seconds: Bytes,
  inner: bool,
  inner_low: u64,
  inner_high: u64,
}

fn no_prefix() -> PrefixPlan uses {} {
  PrefixPlan(enabled: false, low: 0, high: 0, literals: [], folds: [], firsts: b"", seconds: b"", inner: false, inner_low: 0, inner_high: 0)
}

fn prefix_bit(mut plan: PrefixPlan, cp: u32) uses {} {
  if cp < 64 {
    plan.low |= 1u64 << core@1/int.widen(cp)
  } else if cp < 128 {
    plan.high |= 1u64 << core@1/int.widen(cp - 64)
  }
}

// A singleton's complete simple-fold orbit, including Kelvin and long-s.
// Larger folded/negated classes are deliberately unsupported by extraction.
fn prefix_class(mut plan: PrefixPlan, inst: Inst) -> bool uses {} {
  if inst.negated || core@1/list.len(inst.ranges) > 16 {
    return false
  }
  if inst.kind == 13 {
    if core@1/list.len(inst.ranges) != 1 {
      return false
    }
    let (lo, hi) = inst.ranges[0]
    if lo != hi {
      return false
    }
    let mut cp = lo
    let mut fuel = 64u64
    while true {
      prefix_bit(mut plan, cp)
      let Ok(next) = simple_fold(cp, mut fuel) else {
        return false
      }
      cp = next
      if cp == lo {
        return true
      }
    }
  }
  for (lo, hi) in inst.ranges {
    if lo < 64 {
      let last = if hi < 64 {
        hi
      } else {
        63u32
      }
      plan.low |= prefix_range(lo, last)
    }
    if lo < 128 && hi >= 64 {
      let first = if lo >= 64 {
        lo - 64
      } else {
        0u32
      }
      let last = if hi < 128 {
        hi - 64
      } else {
        63u32
      }
      plan.high |= prefix_range(first, last)
    }
  }
  true
}

// Inclusive interval inside one 64-bit word; no shift by the word width.
fn prefix_range(lo: u32, hi: u32) -> u64 uses {} {
  let width: u64 = core@1/int.widen(hi - lo + 1)
  let bits = if width == 64 {
    18446744073709551615u64
  } else {
    (1u64 << width) - 1
  }
  let shift: u64 = core@1/int.widen(lo)
  bits << shift
}

// Stop at the first branching/unknown instruction. A nonempty truncated
// prefix remains necessary; it is never sufficient to return a match.
fn prefix_literal(code: List[Inst], start: u64) -> (String, u64) uses {} {
  let mut pc = start
  let mut needle: List[u8] = []
  let mut steps = 0u64
  let mut folds = 0u64
  while steps < 64 && core@1/list.len(needle) < 16 {
    steps += 1
    let inst = code[pc]
    if (inst.kind == 1 || inst.kind == 13) && !inst.negated && core@1/list.len(inst.ranges) == 1 {
      let (lo, hi) = inst.ranges[0]
      if lo != hi || lo >= 128 {
        break
      }
      if inst.kind == 13 { folds |= 1u64 << core@1/list.len(needle) }
      core@1/list.push(mut needle, core@1/int.narrow(lo))
      pc = inst.x
    } else if inst.kind == 0 || inst.kind == 12 {
      pc = inst.x
    } else {
      break
    }
  }
  (text.finish_valid(take needle), folds)
}

// regex-automata meta/strategy.rs:1410-1552: find a required inner literal,
// recover a prefix start, then confirm with the original forward automaton.
// Here the prefix is one ASCII class repeated one or more times, so its
// reverse automaton is exactly a backwards class run. The literal's first
// byte must be outside that class; this makes the run's endpoint unambiguous.
fn prefix_inner(code: List[Inst], entry: u64) -> Option[(u64, u64, u64)] uses {} {
  let mut pc = entry
  let mut steps = 0u64
  while steps < 64 && (code[pc].kind == 0 || code[pc].kind == 12) {
    pc = code[pc].x
    steps += 1
  }
  let inst = code[pc]
  if inst.kind != 1 || inst.negated { return None() }
  for (lo, hi) in inst.ranges { if hi >= 128 { return None() } }
  let repeat_inst = code[inst.x]
  if repeat_inst.kind != 10 { return None() }
  let mut continuation = if repeat_inst.x == pc { repeat_inst.y }
    else if repeat_inst.y == pc { repeat_inst.x }
    else { return None() }
  steps = 0
  while steps < 64 && (code[continuation].kind == 0 || code[continuation].kind == 12) {
    continuation = code[continuation].x
    steps += 1
  }
  let next_inst = code[continuation]
  if next_inst.kind != 1 || next_inst.negated || core@1/list.len(next_inst.ranges) != 1 { return None() }
  let (lo, hi) = next_inst.ranges[0]
  if lo != hi || lo >= 128 { return None() }
  let mut run = no_prefix()
  if !prefix_class(mut run, inst) || prefix_has(run, lo) { return None() }
  Some((continuation, run.low, run.high))
}

fn prefix_plan(code: List[Inst], entry: u64) -> PrefixPlan uses {} {
  // Avoid graph preprocessing for tiny patterns and large interpreter witnesses.
  if core@1/list.len(code) < 8 || core@1/list.len(code) > 256 {
    return no_prefix()
  }
  // Rust meta/strategy.rs:89: anchored searches rarely benefit from scanning.
  // Decline leading assertions before allocating or exploring epsilon chains.
  let leading = code[entry].kind
  if leading >= 3 && leading <= 6 || leading == 15 || leading == 16 {
    return no_prefix()
  }
  let mut plan = no_prefix()
  let mut first = entry
  if let Some((continuation, low, high)) = prefix_inner(code, entry) {
    first = continuation
    plan.inner = true
    plan.inner_low = low
    plan.inner_high = high
  }
  let mut stack: List[u64] = [first]
  let mut visited: List[u64] = []
  let mut depth = 1u64
  let mut literals = true
  while depth != 0 {
    depth -= 1
    let pc = stack[depth]
    if core@1/list.len(visited) == 64 {
      return no_prefix()
    }
    // Cycles and shared epsilon tails conservatively disable the plan.
    for old in visited {
      if old == pc {
        return no_prefix()
      }
    }
    core@1/list.push(mut visited, pc)
    let inst = code[pc]
    if inst.kind == 1 || inst.kind == 13 {
      if !prefix_class(mut plan, inst) {
        return no_prefix()
      }
      let (literal, folds) = prefix_literal(code, pc)
      if core@1/bytes.len(core@1/string.as_bytes(literal)) == 0 {
        literals = false
      } else {
        core@1/list.push(mut plan.literals, take literal)
        core@1/list.push(mut plan.folds, folds)
      }
    } else if inst.kind == 0 || inst.kind == 12 || inst.kind == 3 || inst.kind == 4 || inst.kind == 5 || inst.kind == 6 || inst.kind == 15 || inst.kind == 16 || inst.kind == 10 {
      if inst.kind == 10 {
        if depth < core@1/list.len(stack) {
          stack[depth] = inst.y
        } else {
          core@1/list.push(mut stack, inst.y)
        }
        depth += 1
      }
      if depth < core@1/list.len(stack) {
        stack[depth] = inst.x
      } else {
        core@1/list.push(mut stack, inst.x)
      }
      depth += 1
    } else {
      // Match means nullable; dot/unknown means any starting scalar.
      return no_prefix()
    }
  }
  if !literals {
    plan.literals = []
    plan.folds = []
  }
  // <=64 strings of <=16 bytes, plus folds and byte sets: <5 KiB of payload.
  // No search-time growing plan.
  // memchr 2.8.2 arch/x86_64/sse2/packedpair.rs:141-152 and
  // regex-automata 0.4.11 hybrid/search.rs:245-271: report necessary
  // byte pairs and let the automaton confirm them. Unlike Teddy's exact
  // literal search, independent sets may combine different alternatives.
  // Such false positives are safe because neither engine returns a match
  // without running its original ordered program.
  let mut paired = core@1/list.len(plan.literals) != 0
  // memchr 2.8.3 arch/all/packedpair/{mod.rs:163-192,default_rank.rs:1-130}.
  // Keep adjacency and a fixed byte offset only for exact single ASCII literals.
  let mut pair_offset = 0u64
  if paired && core@1/list.len(plan.literals) == 1 && (plan.folds[0] & 65535u64) == 0 {
    let bytes = core@1/string.as_bytes(plan.literals[0])
    let ranks: Bytes = b"\x37\x34\x33\x32\x31\x30\x2f\x2e\x2d\x67\xf2\x42\x43\xe5\x2c\x2b\x2a\x29\x28\x27\x26\x25\x24\x23\x22\x21\x38\x20\x1f\x1e\x1d\x1c\xff\x94\xa4\x95\x88\xa0\x9b\xad\xdd\xde\x86\x7a\xe8\xca\xd7\xe0\xd0\xdc\xcc\xbb\xb7\xb3\xb1\xa8\xb2\xc8\xe2\xc3\x9a\xb8\xae\x7e\x78\xbf\x9d\xc2\xaa\xbd\xa2\xa1\x96\xc1\x8e\x89\xab\xb0\xb9\xa7\xba\x70\xaf\xc0\xbc\x9c\x8c\x8f\x7b\x85\x80\x93\x8a\x92\x72\xdf\x97\xf9\xd8\xee\xec\xfd\xe3\xda\xe6\xf7\x87\xb4\xf1\xe9\xf6\xf4\xe7\x8b\xf5\xf3\xfb\xeb\xc9\xc4\xf0\xd6\x98\xb6\xcd\xb5\x7f\x1b"
    let mut best = 512u64
    let mut i = 0u64
    while i + 1 < core@1/bytes.len(bytes) {
      let a = bytes[i]
      let b = bytes[i + 1]
      if (a | 32u8) != (b | 32u8) {
        // The prepared masks admit both bit-5 variants, so rank each union by
        // its more frequent member. Distinct bytes avoid correlated repeats.
        let a0: u64 = core@1/int.widen(ranks[core@1/int.widen(a | 32u8)])
        let a1: u64 = core@1/int.widen(ranks[core@1/int.widen(a & 223u8)])
        let b0: u64 = core@1/int.widen(ranks[core@1/int.widen(b | 32u8)])
        let b1: u64 = core@1/int.widen(ranks[core@1/int.widen(b & 223u8)])
        let score = (if a0 > a1 { a0 } else { a1 }) + (if b0 > b1 { b0 } else { b1 })
        if score < best { best = score; pair_offset = i }
      }
      i += 1
    }
  }
  let mut sets: List[u8] = []
  for i in 0u64..64 { core@1/list.push(mut sets, 0u8) }
  for literal in plan.literals {
    let bytes = core@1/string.as_bytes(literal)
    if core@1/bytes.len(bytes) < 2 { paired = false; break }
    prefix_pair_bit(mut sets, 0, bytes[pair_offset] | 32u8)
    prefix_pair_bit(mut sets, 0, bytes[pair_offset] & 223u8)
    prefix_pair_bit(mut sets, 32, bytes[pair_offset + 1] | 32u8)
    prefix_pair_bit(mut sets, 32, bytes[pair_offset + 1] & 223u8)
  }
  if paired {
    for i in 0u64..16 { sets[16 + i] = 255u8; sets[48 + i] = 255u8 }
    let masks = core@1/bytes.from_list(take sets)
    plan.firsts = core@1/bytes.slice(masks, 0, 32)
    plan.seconds = core@1/bytes.slice(masks, 32, 64)
    if pair_offset != 0 { plan.folds[0] |= pair_offset << 16 }
  }
  plan.enabled = true
  take plan
}

// Exact nibble membership, prepared once with the compiled prefix plan.
fn prefix_pair_bit(mut sets: List[u8], base: u64, byte: u8) uses {} {
  let value: u64 = core@1/int.widen(byte)
  let row = base + (value & 15) + if value >= 128 { 16u64 } else { 0u64 }
  let shift: u8 = core@1/int.narrow((value >> 4) & 7)
  sets[row] |= 1u8 << shift
}

fn prefix_has(plan: PrefixPlan, cp: u32) -> bool uses {} {
  if cp < 64 {
    plan.low >> core@1/int.widen(cp) & 1u64 != 0
  } else if cp < 128 {
    plan.high >> core@1/int.widen(cp - 64) & 1u64 != 0
  } else {
    // Before any skip, allow the original engine to see every non-ASCII
    // scalar. In particular folded ASCII letters can match non-ASCII text.
    true
  }
}

// hybrid/search.rs:245-271 and memchr packedpair's find_prefilter: the
// scanner returns a necessary candidate, then the original ordered engine
// confirms it. Prepare borrowed mask views once rather than slicing at every
// dead state. Inner literals alone need the backwards class-run recovery.
fn next_candidate(plan: PrefixPlan, haystack: Bytes, from: u64) -> Option[u64] uses {} {
  let size = core@1/bytes.len(haystack)
  let pair_offset = if core@1/list.len(plan.literals) == 1 { plan.folds[0] >> 16 } else { 0u64 }
  if from >= size || pair_offset >= size - from { return None() }
  let mut scan = from + pair_offset
  while scan < size {
    let mut candidate = size
    if core@1/bytes.len(plan.firsts) != 0 {
      candidate = core@1/bytes.find_pair(haystack, plan.firsts, plan.seconds, scan)
    } else if core@1/list.len(plan.literals) == 1 && (plan.folds[0] & 65535u64) == 0 {
      candidate = core@1/bytes.find_any(haystack, core@1/string.as_bytes(plan.literals[0]), scan)
    } else {
      candidate = scan
      while candidate < size {
        let byte = haystack[candidate]
        if (byte < 128 || byte >= 192) && prefix_has(plan, core@1/int.widen(byte)) { break }
        candidate += 1
      }
    }
    if candidate == size { return None() }
    let found = candidate
    candidate -= pair_offset
    // Offset plans require an exact ASCII literal prefix. A non-ASCII byte
    // cannot start it and may be a continuation byte after subtracting the
    // offset. Reject it before the ordered engine observes a start boundary.
    if pair_offset != 0 && haystack[candidate] >= 128 {
      scan = found + 1
      continue
    }
    if !plan.inner { return Some(candidate) }
    let mut begin = candidate
    while begin > from {
      let byte: u64 = core@1/int.widen(haystack[begin - 1])
      let contained = if byte < 64 { plan.inner_low >> byte & 1u64 != 0 }
        else if byte < 128 { plan.inner_high >> (byte - 64) & 1u64 != 0 }
        else { false }
      if !contained { break }
      begin -= 1
    }
    if begin < candidate { return Some(begin) }
    scan = found + 1
  }
  None()
}

// Engine eligibility depends only on the compiled pattern and cache capacity.
// Finite logical budgets retain exact PikeVM accounting. The maximum budget
// selects the accelerated operation; input length never changes this decision.
fn prefix_admitted(re: Regex, source: String, capture: bool, work: u64) -> bool uses {} {
  prefix_work_bound(re, source, capture, work) != 0
}

// The maximum value is the accelerated-operation marker, including replacement
// debt. No subject-size product, overflow test or input-size cutoff is used.
fn prefix_work_bound(re: Regex, source: String, capture: bool, work: u64) -> u64 uses {} {
  if work == 18446744073709551615 && core@1/list.len(re.code) <= 512 {
    18446744073709551615u64
  } else {
    0u64
  }
}

// SEM-7: resources and scoped types have neither `key` nor `ordered`; declaring one is
// refused (OWN-4), and the declaration grants nothing: a field of such a type is not key,
// and its values are not compared.
// expect: refuse OWN-4 at 8:15
// expect: refuse OWN-4 at 9:13
// expect: refuse OWN-4 at 10:15
// expect: refuse LANG-21 at 11:31
resource type R: key { n: u64 }
scoped type S: ordered { n: u64 }
type K: key { r: R }
fn same(a: R, b: R) -> bool { a == b }

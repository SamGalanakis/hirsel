; CoreIR sample, family: cleanup (Drop, drop flags with UpdateMask, replace with
; install-before-drop by Copy, Box recursion). FORM v1a, DROP-2, FAIL-8, FAIL-13.
;
; Source (package samples@0, module cleanup):
;   i0  resource Res { id: u64 }                       ; no finalizer: mechanical cleanup
;       type Pair { a: Res, b: Res }
;       enum Node { Nil, Cons(r: Res, next: Box[Node]) }
;       fn pair(x: u64, y: u64) { let p = Pair { a: mk(x), b: mk(y) } }
;       fn flags(take: bool) { let a = mk(1); let b = mk(2); if take { consume(a) } }
;       fn replace(x: u64, y: u64, z: u64) { let mut p = Pair { a: mk(x), b: mk(y) }; p.a = mk(z) }
;       fn chain(n: u64) { let mut l = Nil; for i in 1..=n { l = Cons(mk(i), Box(l)) } }
;
; A resource is a pointer to its block; Res is charged 40 (storage 8, cell 32). f0 is
; `mk`. The callers here run with no limit, so `mk` is never refused; admission.core
; shows a refused allocation, which is an error value, never a failure (FAIL-2).
; Fields are cleaned in reverse order and owners in reverse declaration order
; (DROP-2). Each failure successor cleans exactly the owners live at that call.
; Drops of Res name no successor: mechanical cleanup never fails (FAIL-13).
;
; Behaviour, derived by hand (trace: Res ids in the order their cleanup started):
; run: f1(10, 11) -> | used 0 | trace 11, 10          ; Pair fields: b, then a
; run: f2(false) -> | used 0 | trace 2, 1             ; b, then a (its flag is set)
; run: f2(true) -> | used 0 | trace 1, 2              ; consume drops a; flag cleared
; run: f4(1, 2, 3) -> | used 0 | trace 1, 2, 3        ; old a at the replace, then b, a
; run: f5(3) -> | used 0 | trace 1, 2, 3              ; next before r: innermost first
; run: f5(0) -> | used 0                              ; Nil owns nothing
core v1
item i0 = samples@0/cleanup/flags
type t0 = resource "Res" { id: u64 }
type t1 = own "Pair" { a: t0, b: t0 }
type t2 = own "Node" | Nil { } | Cons { r: t0, next: box t2 }
sig g0 = (u64) -> (ptr)
sig g1 = (u64, u64) -> ()
sig g2 = (bool) -> ()
sig g3 = (ptr) -> ()
sig g4 = (u64, u64, u64) -> ()
sig g5 = (u64) -> ()
inst n0 = samples@0/cleanup/mk [] []
inst n1 = samples@0/cleanup/pair [] []
inst n2 = samples@0/cleanup/flags [] []
inst n3 = samples@0/cleanup/consume [] []
inst n4 = samples@0/cleanup/replace [] []
inst n5 = samples@0/cleanup/chain [] []
fn f0 = n0 g0 {
  addr a0 = v2 : t0
  addr a1 = a0 field 0 : u64
b0(v0: u64):
  v1: u64 = const 40
  v2: ptr, v3: u64 = alloc resource grant 0 8 align 8 charge v1
  address a0
  address a1
  store a1, v0
  return v2
}
fn f1 = n1 g1 {
  slot s0 = t1                         ; p
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 1 : ptr
  addr a2 = s0 : t1
  addr a3 = s0 field 0 : t0
b0(v0: u64, v1: u64):
  live s0
  address a0
  address a1
  address a2
  address a3
  v2: ptr = call f0 g0 (v0)
  store a0, v2
  v3: ptr = call f0 g0 (v1) fail b1
  store a1, v3
  drop a2 t1
  dead s0
  return
b1:
  drop a3 t0                           ; only `a` was constructed
  propagate
}
fn f2 = n2 g2 {
  slot s0 = t0                         ; a
  slot s1 = t0                         ; b
  addr a0 = s0 : ptr
  addr a1 = s1 : ptr
  addr a2 = s0 : t0
  addr a3 = s1 : t0
b0(v0: bool):
  live s0
  live s1
  address a0
  address a1
  address a2
  address a3
  v1: u64 = const 1
  v2: ptr = call f0 g0 (v1)
  store a0, v2
  v3: u8 = const 0
  v4: u8 = set_mask v3, 0              ; bit 0: a live
  v5: u64 = const 2
  v6: ptr = call f0 g0 (v5) fail b5
  store a1, v6
  v7: u8 = set_mask v4, 1              ; bit 1: b live
  branch v0, b1, b2(v7)
b1:
  v8: ptr = read a0                    ; move a out: consume owns it now
  v9: u8 = clear_mask v7, 0
  call f3 g3 (v8) fail b6
  jump b2(v9)
b2(v10: u8):
  drop a3 t0                           ; b's bit is set on every path here
  v11: u8 = const 1
  v12: u8 = bitand v10, v11
  v13: u8 = const 0
  v14: bool = ne v12, v13
  branch v14, b3, b4
b3:
  drop a2 t0
  jump b4
b4:
  dead s1
  dead s0
  return
b5:
  drop a2 t0                           ; a live, b not yet made
  propagate
b6:
  drop a3 t0                           ; b live, a moved into the failed callee
  propagate
}
fn f3 = n3 g3 {
  slot s0 = t0
  addr a0 = s0 : ptr
  addr a1 = s0 : t0
b0(v0: ptr):
  live s0
  address a0
  address a1
  store a0, v0
  drop a1 t0
  dead s0
  return
}
fn f4 = n4 g4 {
  slot s0 = t1                         ; p
  slot s1 = t0                         ; the displaced p.a
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 1 : ptr
  addr a2 = s0 : t1
  addr a3 = s0 field 0 : t0
  addr a4 = s1 : t0
b0(v0: u64, v1: u64, v2: u64):
  live s0
  live s1
  address a0
  address a1
  address a2
  address a3
  address a4
  v3: ptr = call f0 g0 (v0)
  store a0, v3
  v4: ptr = call f0 g0 (v1) fail b1
  store a1, v4
  v5: ptr = call f0 g0 (v2) fail b2    ; prepare the new owner first
  v6: u64 = const 8
  copy a4, a3, v6                      ; take the old owner out
  store a0, v5                         ; install the new one
  drop a4 t0                           ; then drop the displaced owner
  drop a2 t1
  dead s1
  dead s0
  return
b1:
  drop a3 t0
  propagate
b2:
  drop a2 t1                           ; p is whole; the replace has not started
  propagate
}
fn f5 = n5 g5 {
  slot s0 = t2                         ; l
  addr a0 = s0 : u8                    ; l's tag
  addr a1 = s0 case 1 0 : ptr          ; Cons.r
  addr a2 = s0 case 1 1 : ptr          ; Cons.next
  addr a3 = s0 : t2
  addr a4 = v7 : t2                    ; the new box's payload
b0(v0: u64):
  live s0
  address a0
  address a1
  address a2
  address a3
  v1: u8 = const 0
  store a0, v1                         ; l = Nil
  v2: u64 = const 1
  jump b1(v2)
b1(v3: u64):
  v4: bool = gt v3, v0
  branch v4, b3, b2
b2:
  v5: ptr = call f0 g0 (v3) fail b4
  v6: u64 = const 24
  v7: ptr, v8: u64 = alloc own 24 align 8 charge v6
  address a4
  copy a4, a3, v6                      ; Box(l): l moves into the box
  v9: u8 = const 1
  store a0, v9
  store a1, v5
  store a2, v7
  v10: u64 = add v3, v2 fail b5
  jump b1(v10)
b3:
  drop a3 t2
  dead s0
  return
b4:
  drop a3 t2
  propagate
b5:
  drop a3 t2
  propagate
}

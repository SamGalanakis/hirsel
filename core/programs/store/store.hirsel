    if disk_law_migrate(disk_test_directory(d), c, r, tasks) { Ok(()) } else { Error(()) }
}

// Private S2 opener, final cut/handle rules. Journal durability and close's
// last-frame promise are exercised in S3 (T1); this law explicitly cuts first.
pub fn disk_law_db(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = defaults()
    options.checkpoint_task_bytes = 1048576
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    let id = identity(db)
    let open_id = open_number(db)
    if open_id != 1 {
        return false
    }
    match open(tasks, d, c, r, options) {
        Error(Held) => {},
        _ => return false
    }
    let schema_ticket = result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    if version(snapshot(db)) != 1 || schema_ticket.open != open_id {
        return false
    }
    match schema_ticket.mark {
        Cut(2) => {},
        _ => return false
    }
    result.unwrap(durable(mut db, schema_ticket))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = shape(t)
    if version(snapshot(db)) != 1 || !typed_put(mut db, t, 1, 10) {
        return false
    }
    let held = snapshot(db)
    let high = db.next_node
    let commit_ticket = result.unwrap(checkpoint(mut db))
    match commit_ticket.mark {
        Cut(3) => {},
        _ => return false
    }
    if version(snapshot(db)) != 2 {
        return false
    }
    result.unwrap(durable(mut db, commit_ticket))
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    if !same(identity(reopened), id) || open_number(reopened) != 4 || version(snapshot(reopened)) != 2 || reopened.next_node < high {
        return false
    }
    if result.unwrap(get(snapshot(reopened), sh, 1)) != Some(10u64) || result.unwrap(get(held, sh, 1)) != Some(10u64) {
        return false
    }
    match durable(mut reopened, commit_ticket) {
        Error(Foreign) => {},
        _ => return false
    }
    match changes(held, snapshot(reopened)) {
        Error(Foreign) => {},
        _ => return false
    }
    result.unwrap(create_table(mut reopened, spec("second", std.codec.key_u64(), std.codec.of_u64())))
    let second = result.unwrap(table(mut reopened, "second", std.codec.key_u64(), std.codec.of_u64()))
    if second.id != 2 {
        return false
    }
    result.unwrap(close(take reopened))
    true
}


// rule: STORE-8
// expect: run
// authorities: {"pins":{"provider":"authority.sim@1","floor":"cache","seed":5,"represent":"log","levels":["cache","disk"],"faults":{}}}
// steps: 20000000
// A named pin keeps its version readable with store.at after compactions
// past it and a takeover, though the version's checkpoint is no longer the
// newest; an unpinned version below the newest checkpoint is NotRetained().
// Pinning a held name moves it, so the old version is no longer retained.
// store.unpin is true for a held name, after which its version is not
// retained, and false for a name no pin has. Pinning a version no longer
// retained is NotRetained(). A name over 255 bytes is InvalidInput() and one
// of 255 is held.
fn put_x(mut tx: store.Tx, info: store.CallInfo, n: u8) -> Result[(), store.TxError] {
  store.tx_put(mut tx, b"x", bytes.from_list([n]))
}

fn dropped(a: Authority, v: store.Version of a) -> bool {
  match store.at(a, v) {
    Error(NotRetained()) => true,
    _ => false,
  }
}

fn reads(a: Authority, v: store.Version of a, n: u8) -> bool {
  match store.at(a, v) {
    Ok(snap) => store.get(snap, b"x") == Some(bytes.from_list([n])),
    Error(_) => false,
  }
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

// Commits x = n and returns the version that commit made.
fn write(a: Authority, mut s: store.Store, n: u8) -> Result[store.Version of a, Failed] {
  let done: Result[(), store.TxFailure[store.TxError]] = store.transact(mut s, put_x, n)
  check(done == Ok(()))?
  let Some(cache) = authority.level(a, "cache") else {
    return Error(Check())
  }
  let snap = store.snapshot(a, mut s, cache) ? Store
  Ok(store.version(a, snap))
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "pins") else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  let v1 = write(a, mut s, 1)?
  store.compact(mut s) ? Store
  let v2 = write(a, mut s, 2)?
  // v2 relies on the checkpoint at v1, which the next compaction replaces.
  store.pin(a, mut s, "keep", v2) ? Store
  let v3 = write(a, mut s, 3)?
  let v4 = write(a, mut s, 4)?
  store.compact(mut s) ? Store
  check(reads(a, v2, 2) && dropped(a, v3))?
  store.close(take s) ? Store
  // A takeover inherits the pin, and its compaction keeps what v2 reads.
  let mut again = store.open(a, store.default_config()) ? Store
  let v5 = write(a, mut again, 5)?
  store.compact(mut again) ? Store
  check(reads(a, v2, 2) && dropped(a, v4))?
  // Pinning the held name again moves it.
  store.pin(a, mut again, "keep", v5) ? Store
  let _ = write(a, mut again, 6)?
  store.compact(mut again) ? Store
  check(reads(a, v5, 5) && dropped(a, v2))?
  check(store.unpin(mut again, "keep") == Ok(true))?
  check(dropped(a, v5))?
  check(store.unpin(mut again, "keep") == Ok(false))?
  // A version no longer retained is refused, not pinned into a corrupt read.
  check(store.pin(a, mut again, "late", v1) == Error(NotRetained()))?
  // A name over 255 bytes is refused; one of 255 is held.
  let mut long = ""
  for _ in 0u64..255 {
    long = f"{long}n"
  }
  let v7 = write(a, mut again, 7)?
  check(store.pin(a, mut again, f"{long}n", v7) == Error(InvalidInput()))?
  store.pin(a, mut again, long, v7) ? Store
  let _ = write(a, mut again, 8)?
  store.compact(mut again) ? Store
  check(reads(a, v7, 7))?
  store.close(take again) ? Store
  Ok(())
}

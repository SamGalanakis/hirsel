fn staged_connection(mut staged: List[Staged], mut c: Connection, now: u64, slot: u64, mtu: u64, mut out: Bytes, mut tx: List[Output]) {
    c.initial.ack_staged = false
    c.encrypted.ack_staged = false
    c.application.ack_staged = false
    key_maintenance(mut c, now)
    path_maintenance(mut c, now)
    let mut limit = packet_limit(c, mtu)
    let closing: Option[CloseFrame] = match c.life {
        Draining => return,
        Closing(f) if !f.pending => return,
        Closing(f) => {
            if let None = c.deadline {
                c.deadline = Some(deadline_after(now, three_pto(c)))
            }
            limit = order.min(limit, order.min(f.max_bytes, amplification_room(c)))
            Some(clone(f.wire))
        },
        Open => None,
    }
    let handle = c.handle
    let peer = c.peer
    let ecn = recovery.ecn_mark(c.recovery)
    c.wake = None
    if let None = closing {
        expire_datagrams(mut c.streams, now, recovery.smoothed_rtt(c.recovery))
        // RFC 9002 §7 and §7.7: new ack-eliciting data waits for congestion window
        // and pacer room for a whole packet; acknowledgments and probes do not.
        // 1-RTT packets repeat while they carry stream-layer frames and room remains.
        let mut pending = 0u64
        let mut limited = true
        let mut level = 0u64
        let mut done = c.handshake_done
        let mut room = amplification_room(c)
        while level < 3 {
            let before = list.len(out)
            let level_limit = order.min(limit, room)
            let mut send = recovery.window_allows(c.recovery, pending, limit)
            if send {
                if let Some(at) = recovery.pacing_delay(c.recovery, now, pending, limit) {
                    send = false
                    c.wake = Some(at)
                }
            }
            limited = limited && send
            let (size, more) = match level {
                0 => stage_level(mut staged, mut c.initial, mut c.streams, Initial, c.peer_id, c.local_id, false, None, now, send, ecn, slot, handle, peer, level_limit, mut out, mut tx),
                1 => stage_level(mut staged, mut c.encrypted, mut c.streams, Handshake, c.peer_id, c.local_id, false, None, now, send, ecn, slot, handle, peer, level_limit, mut out, mut tx),
                _ => stage_level(mut staged, mut c.application, mut c.streams, OneRtt, c.peer_id, c.local_id, done, None, now, send, ecn, slot, handle, peer, level_limit, mut out, mut tx),
            }
            pending += size
            room -= order.min(room, list.len(out) - before)
            if level == 2 {
                done = false
            }
            if level < 2 || !(more && send) {
                level += 1
            }
        }
        // B.5: a sender held back by nothing it controls is application limited.
        recovery.set_app_limited(mut c.recovery, limited)
        stage_mtu_probe(mut staged, mut c, now, slot, mtu, pending, ecn, mut out, mut tx)
    } else if let Some(_) = c.application.send {
        let _ = stage_level(mut staged, mut c.application, mut c.streams, OneRtt, c.peer_id, c.local_id, false, closing, now, false, 0, slot, handle, peer, limit, mut out, mut tx)
    } else if let Some(_) = c.encrypted.send {
        let _ = stage_level(mut staged, mut c.encrypted, mut c.streams, Handshake, c.peer_id, c.local_id, false, closing, now, false, 0, slot, handle, peer, limit, mut out, mut tx)
    } else {
        let _ = stage_level(mut staged, mut c.initial, mut c.streams, Initial, c.peer_id, c.local_id, false, closing, now, false, 0, slot, handle, peer, limit, mut out, mut tx)
    }
}

/// Stage one packet of a level: the in-flight bytes staged (or 0), and whether it carried
/// stream-layer frames, so another 1-RTT packet may have more to send.
fn stage_level(mut staged: List[Staged], mut s: Space, mut st: Streams, kind: codec.PacketKind, dest: Bytes, source: Bytes, done: bool, closing: Option[CloseFrame], now: u64, send: bool, ecn: u8, slot: u64, handle: ConnectionHandle, peer: Addr, mtu: u64, mut out: Bytes, mut tx: List[Output]) -> (u64, bool) {
    let start = list.len(out)
    let limit = order.min(mtu, list.capacity(out) - start)
    if list.len(tx) == list.capacity(tx) {
        return (0, false)
    }
    let fill = match closing {
        Some(_) => false,
        None => true,
    }
    let Some(p) = tx_space(mut s, mut st, fill, kind, dest, source, done, closing, limit, now, send, mut out) else {
        return (0, false)
    }
    let size = if p.eliciting || kind == Initial {
        p.size
    } else {
        0u64
    }
    let more = list.len(p.frames) > 0
    list.push(mut staged, Packet(slot: slot, handle: handle, kind: kind, packet: p))
    list.push(mut tx, Transmit(to: peer, at: start, len: list.len(out) - start, ecn: ecn, send_at: now))
    (size, more)
}

fn earliest(a: Option[u64], b: Option[u64]) -> Option[u64] {
    match (a, b) {
        (Some(x), Some(y)) => Some(order.min(x, y)),
        (Some(x), None) => Some(x),
        _ => b,
    }
}

fn next_deadline(e: Endpoint) -> Option[u64] {
    let mut first: Option[u64] = None
    for connection in e.connections {
        if let Some(c) = connection {
            first = earliest(first, c.deadline)
            if open_life(c) && !amplification_blocked(c) {
                first = earliest(first, recovery.timer(c.recovery))
                first = earliest(first, c.wake)
                first = earliest(first, path_wake(c))
                first = earliest(first, mtu_wake(c))
            }
        }
    }
    first
}

/// Put the frames of staged packets from index from on back on their queues: a suffix
/// committed() did not cover, or a whole batch no committed() followed.
fn abandon(mut e: Endpoint, from: u64) {
    for i in from .. list.len(e.staged) {
        if let Packet(slot: slot, handle: handle, packet: p, ..) = e.staged[i] {
            if let Some(mut c) = e.connections[slot] {
                if c.handle == handle {
                    requeue(mut c.streams, p.frames, true)
                }
            }
        }
    }
}

pub fn poll(mut e: Endpoint, now: u64, mut out: Bytes, mut tx: List[Output]) -> Option[u64] {
    abandon(mut e, 0)
    list.truncate(mut e.staged, 0)
    for reply in e.stateless {
        let at = list.len(out)
        let len = list.len(reply.wire)
        if len > list.capacity(out) - at || list.len(tx) == list.capacity(tx) {
            break
        }
        list.append(mut out, reply.wire)
        list.push(mut tx, Transmit(to: reply.peer, at: at, len: len, ecn: 0, send_at: now))
        list.push(mut e.staged, StatelessReply)
    }
    let mtu: u64 = int.widen(e.config.max_mtu)
    for i in 0u64 .. list.len(e.connections) {
        issue_cids(mut e, i)
        if let Some(mut c) = e.connections[i] {
            staged_connection(mut e.staged, mut c, now, i, mtu, mut out, mut tx)
            dropped_many(mut e.drops, DatagramLate, replace(mut c.streams.datagrams_late, 0))
        }
    }
    let at = next_deadline(e)
    if let Some(deadline) = at {
        if list.len(tx) < list.capacity(tx) {
            list.push(mut tx, Wake(at: deadline))
        }
    }
    at
}

fn commit_packet(mut c: Connection, now: u64, kind: codec.PacketKind, p: StagedPacket) {
    c.path_sent = int.saturating_add(c.path_sent, p.size)
    match kind {
        Initial => commit_space(mut c.initial, p),
        Handshake => commit_space(mut c.encrypted, p),
        _ => {
            commit_space(mut c.application, p)
            c.keys.sealed = int.saturating_add(c.keys.sealed, 1)
            if list.len(p.frames) > 0 {
                c.stream_packets += 1
                for f in p.frames {
                    if let DatagramSent(seq) = f {
                        sent_datagram(mut c.streams, seq)
                    }
                }
                list.push(mut c.streams.inflight, SentPacket(number: p.number, frames: clone(p.frames)))
            }
        },
    }
    if open_life(c) && (p.eliciting || kind == Initial) {
        // B.4: a padded Initial counts in flight even when it only acknowledges. A
        // packet that is neither is never retransmitted nor counted, so it is not
        // tracked: a receive-only peer never acknowledges it.
        let ect = recovery.ecn_mark(c.recovery) != 0
        recovery.on_sent(mut c.recovery, now, space_index(packet_level(kind)), p.number, p.size, p.eliciting, true, ect, p.mtu_probe)
    }
    if p.mtu_probe {
        c.mtu.probe = Some(p.number)
        c.mtu.trying = p.size
    }
    if kind == Handshake {
        if let Client = c.side {
            // RFC 9001 §4.9.1: a client discards Initial keys when it first sends a
            // Handshake packet.
            drop_space(mut c, recovery.INITIAL, now)
        }
    }
    if p.done {
        c.handshake_done = false
    }
    if p.close {
        if let Closing(mut f) = c.life {
            f.pending = false
        }
    }
    if p.eliciting && open_life(c) && !c.idle_rearmed {
        refresh_idle(mut c, now)
        c.idle_rearmed = true
    }
}

/// Commit the sent datagram prefix. The remaining frames stay queued, while every
/// packet number used by poll stays consumed by its sealer.
pub fn committed(mut e: Endpoint, now: u64, k: u64) {
    let mut replies = 0u64
    for i in 0u64 .. order.min(k, list.len(e.staged)) {
        match e.staged[i] {
            StatelessReply => {
                replies += 1
            },
            Packet(slot: slot, handle: handle, kind: kind, packet: p) => {
                if let Some(mut c) = e.connections[slot] {
                    if c.handle == handle {
                        commit_packet(mut c, now, kind, p)
                    }
                }
            },
        }
    }
    if replies > 0 {
        let suffix: List[Stateless] = clone(list.slice(e.stateless, replies, list.len(e.stateless)))
        e.stateless = take suffix
    }
    abandon(mut e, order.min(k, list.len(e.staged)))
    list.truncate(mut e.staged, 0)
}

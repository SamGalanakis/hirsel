// Ephemeral gateway preview. Each read has a one-slot reply mailbox. The hub
// retains the latest bounded draft per active dispatch while it has an observer.
pub type Key: codec + key + send {
    dispatch: runner.triggers.Id,
    run: u64,
    entry: u64,
    tool: Option[u64],
    attempt: u64,
}

// `offset` is the position of `text` in the attempt's whole draft, so a reader
// can append a later suffix instead of taking the whole draft again.
pub type Draft: codec + send {
    key: Key,
    seq: u64,
    produced_ns: u64,
    offset: u64,
    text: String,
}

type Input: send = Start(String, store.Caller, Key, u64, Receiver[()]) | Delta(String, Key, u64, u64, u64, String) | Attach(String, store.Caller, Receiver[()], Option[runner.client.Signal], Sender[u64]) | Detach(u64) | Revoke(String, store.Caller, Sender[()]) | Read(u64, Sender[Option[Draft]]) | Sweep | Stop

pub opaque type Door: send {
    to: Sender[Input],
    text_bytes: u64
}

pub opaque type Hub {
    door: Door,
    actor: Task[()]
}

pub opaque type Target: send {
    door: Door,
    group: String,
    clock: Clock
}

pub resource type Source: send {
    door: Door,
    lease: Option[Sender[()]],
    group: String,
    key: Key,
    seq: u64,
    offset: u64,
    clock: Clock
} drop(ended) {
    let _ = replace(mut ended.lease, None)
    let _ = channel.try_send(ended.door.to, Sweep)
}

pub opaque type Observer {
    door: Door,
    lease: Sender[()],
    id: u64
}

type Audience: key {
    group: String,
    issuer: u8,
    subject: Bytes,
}

type Entry: key {
    group: String,
    run: u64,
    entry: u64,
    tool: Option[u64],
}

type Active {
    audience: Audience,
    key: Key,
    live: Receiver[()],
    seq: u64,
    produced_ns: u64,
    base: u64,
    text: String,
    changed: u64,
}

type Watching {
    audience: Audience,
    live: Receiver[()],
    signal: Option[runner.client.Signal],
}

fn open(live: Receiver[()]) -> bool {
    match channel.try_receive(live) {
        Error(Empty) => true,
        _ => false
    }
}

fn audience_of(group: String, caller: store.Caller) -> Audience {
    Audience(group: string.from(group), issuer: caller.issuer, subject: clone(caller.subject))
}

fn same_audience(a: Audience, b: Audience) -> bool {
    a.group == b.group && a.issuer == b.issuer && a.subject == b.subject
}

fn entry_of(group: String, key: Key) -> Entry {
    Entry(group: string.from(group), run: key.run, entry: key.entry, tool: key.tool)
}

fn notify(watching: Map[u64, Watching], audience: Audience) -> bool {
    let mut any = false
    for (_, w) in watching {
        if same_audience(w.audience, audience) && open(w.live) {
            any = true
            if let Some(signal) = view w.signal { let _ = runner.client.wake(signal) }
        }
    }
    any
}

fn prune(mut active: Map[Entry, Active], mut watching: Map[u64, Watching]) {
    let mut gone: List[u64] = list.new()
    let mut audiences: Map[Audience, bool] = map.new()
    for (id, w) in watching {
        if open(w.live) {
            map.insert(mut audiences, clone(w.audience), true)
        } else {
            list.push(mut gone, id)
        }
    }
    for id in gone { let _ = map.remove(mut watching, id) }
    let mut closed: List[Entry] = list.new()
    let mut unwatched: List[Entry] = list.new()
    let mut changed: Map[Audience, bool] = map.new()
    for (entry, a) in active {
        if !open(a.live) {
            map.insert(mut changed, clone(a.audience), true)
            list.push(mut closed, clone(entry))
        } else if !map.contains(audiences, a.audience) && string.byte_len(a.text) > 0u64 {
            list.push(mut unwatched, clone(entry))
        }
    }
    for (_, w) in watching {
        if map.contains(changed, w.audience) {
            if let Some(signal) = view w.signal { let _ = runner.client.wake(signal) }
        }
    }
    for entry in closed { let _ = map.remove(mut active, entry) }
    for take entry in take unwatched {
        let mut a = option.unwrap(map.remove(mut active, entry))
        a.text = string.new()
        if a.key.tool == None { a.changed = 0u64 }
        map.insert(mut active, take entry, take a)
    }
}

fn revoke_watchers(mut watching: Map[u64, Watching], audience: Audience) {
    let mut revoked: List[u64] = list.new()
    for (id, w) in watching {
        if same_audience(w.audience, audience) {
            list.push(mut revoked, id)
            if let Some(signal) = view w.signal { let _ = runner.client.wake(signal) }
        }
    }
    for id in revoked { let _ = map.remove(mut watching, id) }
}

fn starts(mut active: Map[Entry, Active], watching: Map[u64, Watching], group: String, caller: store.Caller, key: Key, produced: u64, changed: u64, take live: Receiver[()]) {
    let entry = entry_of(group, key)
    if let Some(a) = map.get(active, entry) {
        let old = a.key
        if old.dispatch == key.dispatch && old.attempt >= key.attempt { return }
        if old.dispatch.store_hi == key.dispatch.store_hi && old.dispatch.store_lo == key.dispatch.store_lo {
            if old.dispatch.version > key.dispatch.version || (old.dispatch.version == key.dispatch.version && old.dispatch.index > key.dispatch.index) { return }
        }
    }
    let audience = audience_of(group, caller)
    let _ = notify(watching, audience)
    let state_seq = first_seq(key)
    map.insert(mut active, take entry, Active(audience: take audience, key: key, live: take live,
        seq: state_seq, produced_ns: produced, base: 0u64, text: string.new(), changed: if state_seq == 0u64 { 0u64 } else { changed }))
}

fn on_delta(mut active: Map[Entry, Active], watching: Map[u64, Watching], limit: u64, changed: u64, group: String, key: Key, seq: u64, produced: u64, at: u64, text: String) {
    let entry = entry_of(group, key)
    {
        let Some(a) = map.get(active, entry) else { return }
        if a.key != key || !open(a.live) || a.seq >= seq || !notify(watching, a.audience) { return }
    }
    let mut a = option.unwrap(map.remove(mut active, entry))
    // A lost delta leaves a hole, so the next delta starts a new UTF-8 tail.
    if seq != a.seq + 1u64 { a.text = string.new() }
    if string.byte_len(a.text) == 0u64 { a.base = at }
    a.seq = seq
    a.produced_ns = produced
    a.changed = changed
    string.push(mut a.text, text)
    let n = string.byte_len(a.text)
    if n > limit {
        let cut = {
            let raw = string.as_bytes(a.text)
            let mut from = n - limit
            while from < n && (raw[from] & 192u8) == 128u8 { from += 1u64 }
            from
        }
        a.text = string.from(string.slice(a.text, cut, n))
        a.base += cut
    }
    map.insert(mut active, take entry, take a)
}

fn draft_for(active: Map[Entry, Active], watching: Map[u64, Watching], id: u64, limit: u64) -> Option[Draft] {
    let Some(w) = map.get(watching, id) else { return None }
    let mut newest = 0u64
    let mut at: Option[Entry] = None
    for (entry, a) in active {
        if same_audience(a.audience, w.audience) && a.changed > newest && open(a.live) {
            newest = a.changed
            at = Some(clone(entry))
        }
    }
    let Some(take entry) = take at else { return None }
    let a = option.unwrap(map.get(active, entry))
    // The running status is derived from the tool's lease. It needs no text buffer.
    let (offset, take text) = if a.key.tool != None && string.byte_len(a.text) == 0u64 {
        if limit < string.byte_len("running tool") { return None }
        (0u64, string.from("running tool"))
    } else {
        (a.base, string.from(a.text))
    }
    Some(Draft(key: a.key, seq: a.seq, produced_ns: a.produced_ns, offset: offset, text: take text))
}

fn receive_all(take job: (Receiver[Input], u64)) -> () waits {
    let (take inbox, limit) = take job
    let mut active: Map[Entry, Active] = map.new()
    let mut watching: Map[u64, Watching] = map.new()
    let mut next = 0u64
    let mut changed = 0u64
    while let Ok(take input) = channel.receive(inbox) {
        match take input {
            Start(group, caller, key, produced, take live) => {
                prune(mut active, mut watching)
                changed += 1u64
                starts(mut active, watching, group, caller, key, produced, changed, take live)
            },
            Delta(group, key, seq, produced, at, text) => {
                changed += 1u64
                on_delta(mut active, watching, limit, changed, group, key, seq, produced, at, text)
            },
            Attach(group, caller, take live, take signal, reply) => {
                prune(mut active, mut watching)
                next += 1u64
                map.insert(mut watching, next, Watching(audience: audience_of(group, caller), live: take live, signal: take signal))
                let _ = channel.send(reply, next)
            },
            Detach(id) => {
                let _ = map.remove(mut watching, id)
                prune(mut active, mut watching)
            },
            Revoke(group, caller, reply) => {
                revoke_watchers(mut watching, audience_of(group, caller))
                prune(mut active, mut watching)
                let _ = channel.send(reply, ())
            },
            Read(id, reply) => {
                prune(mut active, mut watching)
                let _ = channel.send(reply, draft_for(active, watching, id, limit))
            },
            Sweep => prune(mut active, mut watching),
            Stop => return,
        }
    }
}

pub fn start(tasks: Tasks, bytes_budget: u64, text_bytes: u64) -> Hub {
    let (to, inbox): (Sender[Input], Receiver[Input]) = channel.new(64u64)
    let limit = if text_bytes < 16384u64 {
        text_bytes
    } else {
        16384u64
    }
    let port = Door(to: take to, text_bytes: limit)
    Hub(door: take port, actor: task.spawn(tasks, bytes bytes_budget, (take inbox, limit), receive_all))
}

pub fn door(h: Hub) -> Door {
    copy_door(h.door)
}

pub fn copy_door(d: Door) -> Door {
    Door(to: channel.sender(d.to), text_bytes: d.text_bytes)
}

pub fn stop(take h: Hub) -> () waits {
    let Hub(door: take d, actor: take actor) = take h
    let _ = channel.send(d.to, Stop)
    let _ = task.join(take actor)
}

// Register only after the durable worker has its attempt permit. Dropping the
// source before settle closes its lease even if the worker exits early.
pub fn target(d: Door, group: String, clock: Clock) -> Target {
    Target(door: copy_door(d), group: string.from(group), clock: clock)
}

fn first_seq(key: Key) -> u64 {
    if key.tool == None {
        0u64
    } else {
        1u64
    }
}

pub fn source(t: Target, caller: store.Caller, key: Key) -> Option[Source] {
    let d = view t.door
    let (lease, live): (Sender[()], Receiver[()]) = channel.new(1u64)
    if let Error(_) = channel.try_send(d.to, Start(string.from(t.group), clone(caller), key, host.mono_ns(t.clock), take live)) {
        return None
    }
    match Source(door: copy_door(d), lease: Some(take lease), group: string.from(t.group), key: key, seq: first_seq(key), offset: 0u64, clock: t.clock) {
        Ok(take made) => Some(take made),
        Error(_) => None,
    }
}

// Keep only a UTF-8 tail of a very large delta. On a lost delta the next
// sequence replaces the draft so unrelated spans never concatenate.
pub fn delta(mut p: Source, text: String) {
    let n = string.byte_len(text)
    if p.key.tool != None || n == 0u64 || p.door.text_bytes == 0u64 {
        return
    }
    let raw = string.as_bytes(text)
    let mut from = if n > p.door.text_bytes {
        n - p.door.text_bytes
    } else {
        0u64
    }
    while from < n && (raw[from] & 192u8) == 128u8 {
        from += 1u64
    }
    if n > p.door.text_bytes {
        p.seq += 1u64
    }
    p.seq += 1u64
    let at = p.offset + from
    p.offset += n
    let _ = bound bytes p.door.text_bytes + 4096u64 {
        let shown = string.from(string.slice(text, from, n))
        let _ = channel.try_send(p.door.to, Delta(string.from(p.group), p.key, p.seq, host.mono_ns(p.clock), at, take shown))
    }
}

pub fn observe(d: Door, group: String, caller: store.Caller) -> Option[Observer] waits {
    observe_with(d, group, caller, None)
}

pub fn observe_with(d: Door, group: String, caller: store.Caller, take signal: Option[runner.client.Signal]) -> Option[Observer] waits {
    let (lease, live): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (reply, from): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    if let Error(_) = channel.send(d.to, Attach(string.from(group), clone(caller), take live, take signal, take reply)) {
        return None
    }
    let Ok(id) = channel.receive(from) else {
        return None
    }
    Some(Observer(door: copy_door(d), lease: take lease, id: id))
}

pub fn unobserve(take obs: Observer) -> () waits {
    let Observer(door: take d, lease: take lease, id: id) = take obs
    let _ = take lease
    let _ = channel.send(d.to, Detach(id))
}

// Call after changing the place's binding or read policy. Existing watchers
// clear their drafts on the next read and a new watcher must bind again.
pub fn revoke(d: Door, group: String, caller: store.Caller) -> () waits {
    let (reply, from): (Sender[()], Receiver[()]) = channel.new(1u64)
    if let Error(_) = channel.send(d.to, Revoke(string.from(group), clone(caller), take reply)) {
        return
    }
    let _ = channel.receive(from)
}

pub fn read(obs: Observer) -> Option[Draft] waits {
    let (reply, from): (Sender[Option[Draft]], Receiver[Option[Draft]]) = channel.new(1u64)
    if let Error(_) = channel.send(obs.door.to, Read(obs.id, take reply)) {
        return None
    }
    match channel.receive(from) {
        Ok(take latest) => take latest,
        Error(_) => None
    }
}

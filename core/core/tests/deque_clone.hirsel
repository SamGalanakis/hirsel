// test-of: core.deque
// test-reason: clone's private head, power-of-two capacity and refusal rollback
// expect: run clone_empty_admits_nothing() = true
fn clone_empty_admits_nothing() -> bool {
    let d: Deque[u64] = new()
    let r = bound bytes 0 {
        let copied: Deque[u64] = clone(d)
        copied.head == 0 && list.len(copied.ring.raw) == 0 && list.capacity(copied.ring.raw) == 0
    }
    result.unwrap(r)
}

// Logical [4,1,2], head3/cap4, becomes physical [4,1,2,_], head0/cap4.
// expect: run clone_wrapped_header() = 4129
fn clone_wrapped_header() -> u64 {
    let mut d: Deque[u64] = new()
    for i in 1u64 .. 5 {
        push_back(mut d, i)
    }
    for _ in 0u64 .. 3 {
        let x = option.unwrap(pop_front(mut d))
        push_back(mut d, x)
    }
    let _ = pop_back(mut d)
    let mut copied: Deque[u64] = clone(d)
    if copied.head != 0 || list.capacity(copied.ring.raw) != 4 {
        return 99
    }
    push_back(mut copied, 9)
    let mut digits: u64 = 0
    while len(copied) != 0 {
        digits = digits * 10 + option.unwrap(pop_front(mut copied))
    }
    digits
}

// A mostly empty capacity8 source clones to capacity1, not capacity8.
// expect: run clone_partial_shrinks() = true
fn clone_partial_shrinks() -> bool {
    let mut d: Deque[u64] = new()
    for i in 0u64 .. 8 {
        push_back(mut d, i)
    }
    for _ in 0u64 .. 7 {
        let _ = pop_front(mut d)
    }
    let mut copied: Deque[u64] = clone(d)
    copied.head == 0 && list.capacity(copied.ring.raw) == 1 && option.unwrap(pop_front(mut copied)) == 7
}

// expect: run clone_full_is_independent() = true
fn clone_full_is_independent() -> bool {
    let mut d: Deque[String] = new()
    push_back(mut d, string.from("a"))
    push_front(mut d, string.from("b"))
    let mut copied: Deque[String] = clone(d)
    if copied.head != 0 || list.capacity(copied.ring.raw) != 2 {
        return false
    }
    let mut text = option.unwrap(pop_front(mut copied))
    string.push_char(mut text, '!')
    text == "b!" && option.unwrap(pop_front(mut d)) == "b" && option.unwrap(pop_back(mut d)) == "a" && option.unwrap(pop_back(mut copied)) == "a"
}

// Refuse before every element copy. 96 bytes pays cap4 of String; each copy
// needs 8. The cleanup drops the copied prefix and frees the block.
// expect: run clone_refusal_refunds_prefix() = true
fn clone_refusal_refunds_prefix() -> bool {
    let mut d: Deque[String] = new()
    for _ in 0u64 .. 4 {
        push_back(mut d, string.from("abc"))
    }
    for _ in 0u64 .. 3 {
        let x = option.unwrap(pop_front(mut d))
        push_back(mut d, take x)
    }
    let _ = pop_back(mut d)
    for prefix in 0u64 .. 3 {
        let budget = 96 + prefix * 8
        let refused = match refusal(isolate(fn() -> Result[u64, Capacity] {
            bound bytes budget {
                let copied: Deque[String] = clone(d)
                len(copied)
            }
        })) {
            Some(c) => c.requested == 8 && c.available == 0,
            None => false,
        }
        if !refused {
            return false
        }
    }
    let refused = match refusal(isolate(fn() -> Result[u64, Capacity] {
        bound bytes 0 {
            let copied: Deque[String] = clone(d)
            len(copied)
        }
    })) {
        Some(c) => c.requested == 96 && c.available == 0,
        None => false,
    }
    if !refused || len(d) != 3 {
        return false
    }
    for _ in 0u64 .. 3 {
        if option.unwrap(pop_front(mut d)) != "abc" {
            return false
        }
    }
    true
}

// The primary cause of a caught failure, when it is a refused admission.
fn refusal[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

fn refused_request[R](r: Result[Result[R, Causes], Capacity]) -> u64 {
    match refusal(r) {
        Some(c) => c.requested,
        None => 99,
    }
}

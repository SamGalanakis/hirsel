// rule: STORE-9
// expect: run
// A generation number is written again only once every row of its earlier life
// is deleted. A table is migrated through all 256 generations to its last; a
// migration into the wrapped generation 0 that strays every row to new keys and
// then fails is crashed at each of its writes, its chunked discard included,
// and each reopen finds the table whole with no stray row; the migration that
// then reuses generation 0 reads exactly its own rows.
@serializable
type Box {
  n: u64,
}

fn plain() -> table.Table[String, u64] {
  table.named("t")
}

fn boxed() -> table.Table[String, Box] {
  table.named("t")
}

// Rows 1 through 40 under keys of about 4000 bytes, in key order.
fn row_key(k: u32) -> String uses {} {
  let pad = if k < 10 {
    "0"
  } else {
    ""
  }
  let mut out = f"row {pad}{k}"
  let mut i: u32 = 0
  while i < 60 {
    out = f"{out} under a key long enough that a deletion takes more commits"
    i += 1
  }
  out
}

fn up(c: (), key: String, old: u64) -> Result[(String, Box), ()] {
  Ok((unique key, Box(n: old + 1)))
}

fn down(c: (), key: String, old: Box) -> Result[(String, u64), ()] {
  Ok((unique key, old.n + 1))
}

// Moves every row to a key no other migration writes, then fails at the last.
fn astray(c: (), key: String, old: Box) -> Result[(String, u64), ()] {
  if key == row_key(40) {
    return Error(())
  }
  Ok((f"stray {key}", 0))
}

// Commits hold the 48 KB catalog twice but not every row's key.
fn tight() -> store.StoreConfig uses {} {
  let mut config = store.default_config()
  config.limits.transaction_bytes = 120000
  config
}

// Every key stored under the table's rows, whatever its generation, and
// whether nothing waits to be deleted.
fn stored(mut s: store.Store[Dir]) -> (u64, bool) {
  let snap = store.snapshot(mut s)
  let mut prefix: List[u8] = []
  bytes.append(mut prefix, b"hirsel.rows/")
  bytes.append(mut prefix, keys.encode("t"))
  let (low, high) = store.prefix_bounds(bytes.from_list(take prefix))
  let rows = list.len(store.range(snap, low, high, Ascending(), 200))
  let (from, to) = store.prefix_bounds(b"hirsel.garbage/")
  (rows, list.len(store.range(snap, from, to, Ascending(), 10)) == 0)
}

// Whether the table is boxed with every row at `n` and holds nothing else.
fn boxed_at(mut s: store.Store[Dir], n: u64) -> bool {
  store.transact(mut s, boxed_rows, n) == Ok(true) && stored(mut s) == (40, true)
}

fn boxed_rows(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[bool, store.TxError] {
  let rows = table.range(tx, boxed(), Unbounded(), Unbounded(), 200, Ascending())?
  let mut k: u32 = 0
  for row in rows {
    k += 1
    if row != (row_key(k), Box(n: n)) {
      return Ok(false)
    }
  }
  Ok(k == 40)
}

// Whether the table is plain with every row at `n` and holds nothing else.
fn plain_at(mut s: store.Store[Dir], n: u64) -> bool {
  store.transact(mut s, plain_rows, n) == Ok(true) && stored(mut s) == (40, true)
}

fn plain_rows(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[bool, store.TxError] {
  let rows = table.range(tx, plain(), Unbounded(), Unbounded(), 200, Ascending())?
  let mut k: u32 = 0
  for row in rows {
    k += 1
    if row != (row_key(k), n) {
      return Ok(false)
    }
  }
  Ok(k == 40)
}

fn seed_rows(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[(), store.TxError] {
  table.create(mut tx, plain())?
  for k in 1u32..41u32 {
    table.put(mut tx, plain(), row_key(k), 0)?
  }
  Ok(())
}

pub fn main(t: Test) -> Result[(), store.StoreError] {
  task.scope(
    test.tasks(t),
    fn(sc: Scope) -> Result[(), store.StoreError] {
      scenario(t, sc)
    }
  )
}

// Attempts the straying migration with the store stopping after `n` writes,
// then reopens: 1 for a crash that left the table whole, 2 for an attempt that
// ran to its failure and left the table whole, 0 for anything else.
fn stray_crashing(d: Dir, sc: Scope, n: u64) -> Result[u8, store.StoreError] {
  let mut config = tight()
  config.faults = StopAfterWrites(n)
  let outcome: u8 = match store.open(d, config) {
    Ok(faulty) => {
      let mut s = take faulty
      match table.migrate(sc, mut s, boxed(), plain(), astray, 8) {
        Error(Failed(())) => {
          store.close(take s)?
          2
        },
        Error(Table(Storage(_))) => 1,
        _ => 0,
      }
    },
    Error(_) => 1,
  }
  let mut reopened = store.open(d, tight())?
  let whole = boxed_at(mut reopened, 255)
  store.close(take reopened)?
  if whole {
    return Ok(outcome)
  }
  Ok(0)
}

fn scenario(t: Test, sc: Scope) -> Result[(), store.StoreError] {
  let d = test.dir(t, [])
  let mut s = store.open(d, store.default_config())?
  let seeded = store.transact(mut s, seed_rows, ())
  test.check(t, seeded == Ok(()))
  // 255 migrations reach the last generation; each adds one to every row.
  let mut m: u64 = 0
  let mut migrated = true
  while m < 255 {
    let moved = if m % 2 == 0 {
      table.migrate(sc, mut s, plain(), boxed(), up, 8)
    } else {
      table.migrate(sc, mut s, boxed(), plain(), down, 8)
    }
    migrated = migrated && moved == Ok(40)
    m += 1
  }
  test.check(t, migrated && boxed_at(mut s, 255))
  store.close(take s)?
  // The migration into generation 0 crashes at each write until it runs to
  // its failure; every reopen finds the table whole and no stray row.
  let mut seen: List[bool] = [false, false, false]
  let mut n: u64 = 0
  while !seen[2] && n < 400 {
    let found = stray_crashing(d, sc, n)?
    seen[int.widen(found)] = true
    n += 1
  }
  test.check(t, !seen[0] && seen[1] && seen[2])
  // Generation 0 is written again, and holds exactly the migrated rows.
  let mut wrapped = store.open(d, tight())?
  test.check(t, table.migrate(sc, mut wrapped, boxed(), plain(), down, 8) == Ok(40))
  test.check(t, plain_at(mut wrapped, 256))
  store.close(take wrapped)?
  Ok(())
}

; LANG-19: ordinary mechanical release uses constant native stack whatever the
; depth of the value. f0(n) builds Chain = End | Link(Box[Chain]) n links deep,
; each new box taking the previous root as its next (n + 1 boxes, each charge
; 16 = 8 + Chain 8, End being the null niche), then drops the holder, so one
; ordinary release cleans the whole chain. Derived by hand: every box is freed
; once and refunded, so the run returns n with nothing used and n + 1 admissions.
; run: f0(0) -> 0 | used 0
; run: f0(32) -> 32 | used 0
core v1
type t0 = own "Chain" | End { } | Link { next: box t0 }
type t1 = own "Holder" { root: box t0 }
sig g0 = (u64) -> (u64)
inst n0 = test@0/box_chain/run [] []
fn f0 = n0 g0 {
  slot s0 = t1
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 0 deref : t0
  addr a2 = s0 field 0 deref case 1 0 : ptr
  addr a3 = s0 : t1
b0(v0: u64):
  live s0
  address a0
  address a3
  v1: u64 = const 16
  v2: u64 = const 8
  v3: ptr, v4: u64 = alloc for box t0 v2 align 8 charge v1
  v5: ptr = const 0x0
  v6: bool = ne v3, v5
  v7: u64 = const 0
  branch v6, b1, b5
b1:
  store a0, v3
  address a1
  set_case a1, 0
  jump b2(v7)
b2(v8: u64):
  v9: bool = lt v8, v0
  branch v9, b3, b4
b3:
  v10: ptr = read a0
  v11: ptr, v12: u64 = alloc for box t0 v2 align 8 charge v1
  v13: bool = ne v11, v5
  branch v13, b6, b4
b4:
  drop a3 t1
  dead s0
  return v8
b5:
  dead s0
  return v7
b6:
  store a0, v11
  address a1
  address a2
  set_case a1, 1
  store a2, v10
  v14: u64 = const 1
  v15: u64 = wrapping_add v8, v14
  jump b2(v15)
}

// A non-taking arm binds a physical view, which `take` cannot turn into an owner.
// expect: gap cleanup of own values is not built
// expect: gap values of this type are not built
// expect: refuse OWN-15 at 7:34
type Payload { items: List[u64] }
fn f(take o: Option[Payload]) -> u64 {
  match o { Some(x) => { let _ = take x; 0 }, None => 0 }
}

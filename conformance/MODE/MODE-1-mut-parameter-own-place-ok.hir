// rule: MODE-1
// expect: accept
// "The access loan on the argument's own place is not content": a `mut` parameter
// related to another parameter may be lent again after each call that lends it.
fn collect(xs: List[Bytes], mut out: List[Bytes] in xs) -> () uses {} {
  list.push(mut out, b"x")
  list.push(mut out, b"y")
}

fn each(xs: List[Bytes], mut out: List[Bytes] in xs) -> () uses {} {
  for k in xs {
    list.push(mut out, b"x")
  }
}

// One row change for catch-up: carries `before` when read from a Tiered diff
// so `patch_index_ranges` does not re-read Cold rows.
pub type CatchUpChange {
    tree_key: Bytes,
    before: Option[Arc[Bytes]],
    after: Option[Arc[Bytes]]
}

// Child scratch-pack state for Tiered prepare builds and catch-up rounds.
pub type ChildCutContext: send {
    dir: Dir,
    store: types.StoreKey,
    next_pack: u64,
    pack_bytes: u64,
    dirty_bytes: u64,
    writer_pin_bytes: u64
}

fn contains_bytes(keys: List[Bytes], key: Bytes) -> bool {
    for candidate in keys {
        if candidate == key {
            return true
        }
    }
    false
}

// Catch-up in the prepare child (STORE-SPEC §3.5a "Catch-up"). OLD advances the export
// lease to its new head and appends the journal tail to the export directory
// (`advance_export`, `copy_export_tail`). The child replays that tail from
// where its last round ended, on the load it already holds, brings each
// index range the preparation ships to the new head from the rows the tail
// changed, and writes the entries that changed as ROUND (store-rounds).
// OLD's schema commits since the last round (index build chunks, verify
// demotions) come as STEPS: the replay applies them between the tail's
// commits, and each index record they moved is moved in the plan too.
// One shipped entry-index range: its catalog name, record and kind, and
// the position of the extractor its declaration bound in the plan's bindings.
type CatchUpIndex {
    name: String,
    record: indexes.Catalog,
    kind: indexes.EntryKind,
    binding: u64
}

// OLD's steps move only index records' build states (`export_step`). A record
// the plan leaves as OLD had it follows OLD; one the plan changed must ship
// (or be dropped by it), since the install takes the plan's record and range.
pub fn follow_moves(mut plan: catalog.SchemaPlan, moved: List[CatalogChange], ranges: List[KeptRange]) -> Result[(), DeployFailure] {
    for change in moved {
        let (Some(was), Some(now)) = (change.before, change.after) else {
            return Error(Drift)
        }
        let untouched = match pages.get_page_row(plan.roots.catalog, change.key) {
            Some(raw) => catalog_bytes_equal(raw, was),
            None => false,
        }
        if untouched {
            let live_bytes = txn.catalog_recharge(plan.live, plan.roots, change.key, now, plan.retained)
            let roots = deploy_result(catalog.catalog_insert(mut plan.next_node, plan.roots, change.key, now))?
            let next_table = plan.next_table
            deploy_result(catalog.keep_schema(mut plan, take roots, live_bytes, next_table))?
            continue
        }
        let id = deploy_result(indexes.decode_catalog(now))?.id
        let mut kept = false
        for shipped_range in ranges {
            if shipped_range.id == id {
                kept = true
            }
        }
        if !kept {
            return Error(Drift)
        }
    }
    Ok(())
}

// The index ranges the preparation ships, each with the extractor its
// declaration bound. A shipped table range with rows, or an index range
// without a bound extractor, cannot be caught up from row changes.
pub fn catch_up_indexes(plan: catalog.SchemaPlan, bindings: indexes.IndexBindings, ranges: List[KeptRange]) -> Result[List[CatchUpIndex], DeployFailure] {
    let mut found: List[CatchUpIndex] = list.new()
    let mut records = deploy_result(pages.open_page_range(plan.roots.catalog, None, true, false, None))?
    while let Some((take key, raw)) = deploy_result(catalog.next_page_range(mut records))? {
        let record = deploy_result(indexes.decode_catalog(raw))?
        let mut shipped = false
        for shipped_range in ranges {
            if shipped_range.kind != 0u8 && shipped_range.id == record.id {
                shipped = true
            }
        }
        if !shipped {
            continue
        }
        let kind = {
            let CatalogIndex(index_meta) = view record.record else {
                if deploy_result(range_rows(plan.roots.collections, record.id))? != 0 {
                    return Error(Drift)
                }
                continue
            }
            // An aggregate's group totals are not entries a row owns; a full
            // preparation rebuilds them.
            let Entries(kind) = index_meta.shape else {
                return Error(Drift)
            }
            kind
        }
        let index_name = deploy_result(catalog.declaration_index_name(key))?
        let Some(slot) = indexes.matching_binding_index(bindings, record) else {
            return Error(Drift)
        }
        list.push(mut found, CatchUpIndex(name: take index_name, record: take record, kind: kind, binding: slot))
    }
    Ok(take found)
}

// Brings each shipped index range from the base rows to the new ones. Every
// entry a changed row no longer yields is removed before any new entry is
// written, so two rows that trade a Unique key do not collide on the way.
// A Unique key two rows claim at the new head fails the round with Conflict,
// as a full build of the same rows does.
pub fn patch_index_ranges(mut ctx: ChildCutContext, opened: u64, mut plan: catalog.SchemaPlan, bindings: indexes.IndexBindings, before: pages.PageTree, shipped: List[CatchUpIndex], rows: List[CatchUpChange], mut touched: List[Touch]) -> Result[(), types.Failure] waits {
    if list.len(shipped) == 0 || list.len(rows) == 0 {
        return Ok(())
    }
    let (take roots, live_bytes, next_node) = patch_entries(mut ctx, opened, plan, bindings, before, shipped, rows, mut touched)?
    plan.next_node = next_node
    let next_table = plan.next_table
    catalog.keep_schema(mut plan, take roots, live_bytes, next_table)
}

fn patch_entries(mut ctx: ChildCutContext, opened: u64, plan: catalog.SchemaPlan, bindings: indexes.IndexBindings, before: pages.PageTree, shipped: List[CatchUpIndex], rows: List[CatchUpChange], mut touched: List[Touch]) -> Result[(pages.Roots, u64, u64), types.Failure] waits {
    let mut roots = pages.share_roots(plan.roots)
    let mut live_bytes = plan.live
    let mut first = catalog.stamp_after(plan.next_node)?
    let mut next_stamp = first
    let mut additions: List[(u64, Bytes, Bytes, Bytes)] = list.new()
    for i in 0u64 .. list.len(shipped) {
        let target = view shipped[i]
        let target_tiered = table_is_tiered(roots.collections, target.record.id)?
        let extractor = indexes.binding_at(bindings, target.binding)
        for row in rows {
            if list.len(row.tree_key) < 4 {
                continue
            }
            let owner: u32 = list.word_be(row.tree_key, 0)
            if owner != target.record.owner {
                continue
            }
            let primary = list.slice(row.tree_key, 4, list.len(row.tree_key))
            let old_keys: List[Bytes] = match view row.before {
                Some(raw) => {
                    let indexes.IndexValue(keys: take keys, ..) = indexes.extract_row(extractor, raw, primary)?
                    take keys
                },
                None => match pages.get_page_row(before, row.tree_key) {
                    Some(raw) => {
                        let indexes.IndexValue(keys: take keys, ..) = indexes.extract_row(extractor, raw, primary)?
                        take keys
                    },
                    None => list.new(),
                },
            }
            let current: Option[indexes.IndexValue] = match row.after {
                Some(raw) => Some(indexes.extract_row(extractor, raw, primary)?),
                None => None,
            }
            for key in old_keys {
                let kept = match current {
                    Some(value) => contains_bytes(value.keys, key),
                    None => false,
                }
                if kept {
                    continue
                }
                let Some(charge) = owned_entry_direct(ctx, opened, roots.collections, key, target.kind, primary)? else {
                    continue
                }
                if !target_tiered && !plan.retained {
                    live_bytes = int.saturating_sub(live_bytes, charge)
                }
                note_touch_direct(mut touched, ctx, opened, roots.collections, key)?
                if target_tiered {
                    child_apply_tiered_op(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, mut roots.collections, types.copied(key)?, ReplayAbsent, first, mut next_stamp)?
                    if tiered_tree_hot_bytes(roots.collections)? >= ctx.dirty_bytes {
                        pages.canonical_tree(mut roots.collections)?
                        child_cut_tiered(mut roots.collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, next_stamp - 1)?
                        first = catalog.stamp_after(next_stamp - 1)?
                        next_stamp = first
                    }
                } else {
                    let _ = pages.remove_page_row(mut roots.collections, key, first, mut next_stamp)?
                }
            }
            if let Some(take value) = take current {
                let indexes.IndexValue(keys: take keys, payload: take payload, ..) = take value
                for take key in take keys {
                    list.push(mut additions, (i, take key, types.copied(payload)?, types.copied(primary)?))
                }
            }
        }
    }
    for (i, key, payload, primary) in additions {
        let target = view shipped[i]
        let target_tiered = table_is_tiered(roots.collections, target.record.id)?
        if let Some(prior) = child_get_row(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, roots.collections, key)? {
            if let UniqueEntry = target.kind {
                if list.slice(prior, 4, indexes.unique_owner_end(prior)?) != primary {
                    return Error(Conflict(catalog.named(target.name)?))
                }
            }
            if !target_tiered && !plan.retained {
                live_bytes = int.saturating_sub(live_bytes, txn.entry(key, prior))
            }
        }
        if !target_tiered {
            live_bytes = int.saturating_add(live_bytes, txn.entry(key, payload))
            catalog.over_ceiling(live_bytes, plan.ceiling)?
        }
        note_touch_direct(mut touched, ctx, opened, roots.collections, key)?
        if target_tiered {
            child_apply_tiered_op(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, mut roots.collections, types.copied(key)?, ReplayPut(arc.new(types.copied(payload)?)), first, mut next_stamp)?
            if tiered_tree_hot_bytes(roots.collections)? >= ctx.dirty_bytes {
                pages.canonical_tree(mut roots.collections)?
                child_cut_tiered(mut roots.collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, next_stamp - 1)?
                first = catalog.stamp_after(next_stamp - 1)?
                next_stamp = first
            }
        } else {
            pages.put_page_row(mut roots.collections, key, payload, first, mut next_stamp)?
        }
    }
    pages.canonical_tree(mut roots.collections)?
    Ok((take roots, live_bytes, next_stamp - 1))
}

// The charge of `key`'s entry when it belongs to `primary`. A Unique entry
// another row holds is that row's, and stays.
fn owned_entry_direct(ctx: ChildCutContext, opened: u64, tree: pages.PageTree, key: Bytes, kind: indexes.EntryKind, primary: Bytes) -> Result[Option[u64], types.Failure] waits {
    let Some(prior) = child_get_row(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, tree, key)? else {
        return Ok(None)
    }
    if let UniqueEntry = kind {
        if list.slice(prior, 4, indexes.unique_owner_end(prior)?) != primary {
            return Ok(None)
        }
    }
    Ok(Some(txn.entry(key, prior)))
}

fn note_touch_direct(mut touched: List[Touch], ctx: ChildCutContext, opened: u64, tree: pages.PageTree, key: Bytes) -> Result[(), types.Failure] waits {
    let prior = child_get_row(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, tree, key)?
    let seq = list.len(touched)
    let note = Touch(key: types.copied(key)?, seq: seq, prior: take prior)
    types.capacity(list.try_reserve(mut touched, 1))?
    list.push(mut touched, take note)
    Ok(())
}

pub fn round_ops_direct(d: Dir, id: types.StoreKey, writer_pin_bytes: u64, opened: u64, after: pages.PageTree, mut touched: List[Touch]) -> Result[List[RoundOp], types.Failure] waits {
    list.sort(mut touched, fn(a: Touch, b: Touch) -> Order {
        match bytes_order(a.key, b.key) {
            Equal => if a.seq < b.seq {
                Less
            } else if b.seq < a.seq {
                Greater
            } else {
                Equal
            },
            other => other,
        }
    })
    let mut ops: List[RoundOp] = list.new()
    for i in 0u64 .. list.len(touched) {
        let note = view touched[i]
        if i != 0 && touched[i - 1].key == note.key {
            continue
        }
        let new = child_get_row(d, id, writer_pin_bytes, opened, after, note.key)?
        match take new {
            Some(take raw) => {
                let had = match note.prior {
                    Some(prior) => {
                        if prior == raw {
                            continue
                        }
                        true
                    },
                    None => false,
                }
                list.push(mut ops, RoundOp(key: types.copied(note.key)?, value: Some(take raw), prior: had))
            },
            None => {
                if let Some(_) = note.prior {
                    list.push(mut ops, RoundOp(key: types.copied(note.key)?, value: None, prior: true))
                }
            },
        }
    }
    Ok(take ops)
}

// ---- L16 (rows_normalized, RUNNER-SPEC v2.11.1 §3 Rows): a Row's key is the table id
// big-endian ‖ the key codec, and its value is the table's current value codec without the
// stored u16 schema prefix. 257 pad tables take ids 1..257, so "accounts" is 0x00000102,
// whose bytes differ under the two byte orders. Its row 1 is stored under schema 0
// ({balance}); the table is then opened at schema 1 ({balance, bonus = 7}) and row 2 is put.
// The expected bytes are written out by hand: u64 keys are 8 bytes big-endian (codec.md's
// order-preserving key format), u64 values 8 bytes little-endian.
type Old { balance: u64 }

type New { balance: u64, bonus: u64 }

fn old_put(v: Old, mut b: Bytes) -> Result[(), Capacity] {
    std.codec.put_u64(v.balance, mut b)
}

fn old_take(b: Bytes, mut at: u64) -> Result[Old, std.codec.Stop] {
    Ok(Old(balance: std.codec.take_u64(b, mut at)?))
}

fn old_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[Old]) -> Result[(), Capacity] {
    std.codec.define(mut s, "runner.tests.Account", 0)?
    if std.codec.record(mut s, 1)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)?
    std.codec.close(mut s)
    Ok(())
}

fn new_put(v: New, mut b: Bytes) -> Result[(), Capacity] {
    std.codec.put_u64(v.balance, mut b)?
    std.codec.put_u64(v.bonus, mut b)
}

fn new_take(b: Bytes, mut at: u64) -> Result[New, std.codec.Stop] {
    let balance = std.codec.take_u64(b, mut at)?
    let bonus = std.codec.take_u64(b, mut at)?
    Ok(New(balance: balance, bonus: bonus))
}

fn new_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[New]) -> Result[(), Capacity] {
    std.codec.define(mut s, "runner.tests.Account", 0)?
    if std.codec.record(mut s, 2)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)?
    std.codec.field_default(mut s, "bonus", std.codec.of_u64(), 7)?
    std.codec.close(mut s)
    Ok(())
}

type Ah: send { t: store.Shape[u64, New] }

fn accounts_q(tx: store.Tx, h: Ah, take _arg: u32) -> Result[Cover, Capacity] {
    cover(h.t, Included(1u64), Included(2u64))
}

fn accounts_place(mut r: Registry[(), Ah]) -> Result[(), RegisterError] {
    query(mut r, code.describe(accounts_q), 65536u64, DEFAULT_STEPS)
}

fn push_bytes(mut out: Bytes, x: u8, n: u64) {
    for _ in 0u64 .. n {
        result.unwrap(list.push(mut out, x))
    }
}

// The tree key of accounts row k (k < 256), by hand.
fn account_key(k: u8) -> Bytes {
    let mut out: Bytes = list.new()
    push_bytes(mut out, 0u8, 2u64)
    push_bytes(mut out, 1u8, 1u64)
    push_bytes(mut out, 2u8, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    push_bytes(mut out, k, 1u64)
    out
}

// A New value by hand: balance then bonus, each 8 bytes little-endian (both < 256).
fn account_value(balance: u8, bonus: u8) -> Bytes {
    let mut out: Bytes = list.new()
    push_bytes(mut out, balance, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    push_bytes(mut out, bonus, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    out
}

fn row_is(r: Row, key: Bytes, value: Bytes) -> bool {
    r.sub == 7u32 && r.key == key && match r.value {
        Some(v) => v == value,
        None => false,
    }
}

pub fn law_rows_normalized(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    for i in 0i64 .. 257i64 {
        let mut name = result.unwrap(string.from("pad"))
        result.unwrap(string.push_i64(mut name, i))
        let _ = result.unwrap(store.create_table(mut db, store.spec(take name, std.codec.key_u64(), std.codec.of_u64())))
    }
    let oc: std.codec.Codec[Old] = std.codec.make(old_put, old_take, old_schema, 8u64)
    let nc: std.codec.Codec[New] = std.codec.make(new_put, new_take, new_schema, 16u64)
    let _ = result.unwrap(store.create_table(mut db, store.spec("accounts", std.codec.key_u64(), oc)))
    let old = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), oc))
    let first = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, old, 1u64, Old(balance: 10u64))
    })
    match take first {
        Ok(Committed(_)) => (),
        _ => return false,
    }
    let current = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), nc))
    let h = Ah(t: store.shape(current))
    let reg = match placed(code.describe(accounts_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let ca: std.codec.Codec[u32] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let (take key, _) = result.unwrap(described(code.identity(code.describe(accounts_q)), Query, ca, cr))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: list.new())
    // G3: the initial result, from span_changes, holds row 1 normalized from schema 0.
    let initial = at_base(mut b, 0u64, 7u32, take key, no_arg())
    if list.len(initial.complete) != 1u64 || list.len(initial.rows) != 1u64 || !row_is(initial.rows[0], account_key(1u8), account_value(10u8, 7u8)) {
        return false
    }
    // G2: row 2, put at schema 1, arrives from changes with the same normalization.
    let second = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, current, 2u64, New(balance: 20u64, bonus: 9u64))
    })
    match take second {
        Ok(Committed(_)) => (),
        _ => return false,
    }
    let owes = step(mut b, db)
    list.len(owes) == 1u64 && list.len(owes[0].rows) == 1u64 && row_is(owes[0].rows[0], account_key(2u8), account_value(20u8, 9u8))
}

@test
fn test_rows_normalized(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_rows_normalized(c, r) {
        Ok(())
    } else {
        Error(())
    }
}

pub type WireConfig: send { max_subs: u64, socket: std.wsock.Config, q: u64, budget: u64, n_service: u64, n_place: u64 }

pub fn wire_defaults(n_service: u64, n_place: u64) -> WireConfig {
    WireConfig(max_subs: 128u64, socket: std.wsock.defaults(), q: 4, budget: 1048576, n_service: n_service, n_place: n_place)
}

fn wire_round(n: u64) -> u64 { (n + 7u64) & 0xfffffffffffffff8u64 }

// Client decoding allocates exact lists. Want's 40 inline bytes represent at
// least 20 encoded bytes, and rounding each identity adds at most seven bytes.
// 4m + 128 bounds every client variant, including Hello's empty identities.
// g(m) = round8(3m/2) + 8192 at the power-of-two configured maxima.
pub fn reader_bytes(c: WireConfig) -> u64 {
    let outstanding = 2u64 * (1u64 + c.q)
    outstanding * (4u64 * c.socket.max_frame + 128u64) + wire_round(3u64 * c.socket.max_frame / 2u64) + 8192u64 + 4096u64
}


fn wire_decode(b: Bytes) -> Result[Frame, u16] {
    if list.len(b) < 4u64 || b[0u64] >= 4u8 || b[1u64] != 0u8 || b[2u64] != 0u8 || b[3u64] != 0u8 {
        return Error(1007u16)
    }
    let codec: std.codec.Codec[Frame] = std.codec.of()
    match std.codec.decode(codec, b) {
        Ok(Ok(take f)) => Ok(take f),
        _ => Error(1007u16),
    }
}


pub const DONE_MAX: u64 = 8192

// WIRE W3b. The service owns principal binding, admission, dedup and outcomes.
// Each owner holds the one publisher sender. Another transport calls the same dispatch.
pub type ServiceInput: send = WAttach(Ip, Sender[WireEvent], Sender[PubIn]) | WClient(Frame, u64) | WRunner(Event) | WAuthenticated(Option[ingress.Principal]) | WRate(bool) | WDrained | WPoll(bool)

pub type Service[C: send]: send {
    context: C,
    step: fn(mut C, mut WireWork, take ServiceInput) -> Result[Option[Frame], u16],
    ready: fn(C) -> bool,
    finish: fn(mut C) -> Option[PubIn],
    check: fn(C, Frame) -> Option[u16]
}

pub fn dispatch[C: send](mut service: Service[C], take frame: Frame) -> Result[Option[Frame], u16] {
    let mut work = wire_work()
    (service.step)(mut service.context, mut work, WClient(take frame, 0u64))
}

pub fn writer_bytes() -> u64 { 4096u64 }

// Records are charge-v1: Reader is 285 (8+24+8+Decoder's 245),
// ReadClosed holds Control's 133 plus Reader, so WireEvent is 426.
// The writer handoff's Bytes is 24; a read credit is ().
// Children return (), costing 288 each; owner task returns Result<(), Error>
// (Error's largest Capacity payload 16, plus two variant tags = 32).
pub fn session_bytes(c: WireConfig) -> u64 {
    let units = 1u64 + c.q
    let channels = 64u64 + units * 426u64 + 64u64 + 24u64 + 64u64
    let outcomes = units * (DONE_MAX + 36u64)
    let encode = 2u64 * wire_round(c.socket.max_frame + 14u64)
    reader_bytes(c) + writer_bytes() + 576u64 + channels + outcomes + c.budget + encode + c.n_service + c.n_place + 32768u64 + 4384u64 + wire_round(3u64 * units * 100u64)
}

pub opaque type WireEvent: send { e: WireInput }

fn wire_event(take e: WireInput) -> WireEvent { WireEvent(e: take e) }

type WireInput: send = Input(Frame, u64) | FromRunner(Event) | Authenticated(Option[ingress.Principal]) | Rate(bool) | JoinReady | HelloExpired | Published(Frame) | Control(u8, std.websocket.Control) | Sent | ReadClosed(std.websocket.Control, std.wsock.Reader) | WriteClosed(std.wsock.Writer) | Ended(u16)

// Read credits cover both the inbox and a reader blocked on publication. They
// are acquired before decoding, so no extra reader-funded producer item exists.
type WireRead: send { reader: std.wsock.Reader, to: Sender[WireEvent], credits: Receiver[()], clock: Clock, config: std.wsock.Config }
type WireWrite: send { writer: std.wsock.Writer, from: Receiver[Bytes], to: Sender[WireEvent], out: std.wsock.Outbound, clock: Clock, config: std.wsock.Config }

fn wire_read(take x: WireRead) -> () waits {
    let WireRead(reader: take initial, to: take to, credits: take credits, clock: clock, config: config) = take x
    let mut r = take initial
    let mut probing = false
    loop {
        if let Error(_) = channel.receive(credits) { return }
        let next = loop {
            match std.wsock.read(mut r, At(clock, host.mono_ns(clock) + config.idle_ms * 1000000u64)) {
                Ok(Need) => { probing = false },
                Ok(Pong(_)) => { probing = false },
                Ok(Message(take b)) => {
                    probing = false
                    let arrived = host.mono_ns(clock)
                    match wire_decode(b) {
                        Ok(take f) => { let at = match f { Hello(_, _) => host.mono_ns(clock), _ => arrived }; break Input(take f, at) },
                        Error(code) => { let _ = channel.send(to, wire_event(ReadClosed(wire_close_control(code), take r))); return },
                    }
                },
                Ok(Text(_)) => { let _ = channel.send(to, wire_event(ReadClosed(wire_close_control(1003u16), take r))); return },
                Ok(Ping(control)) => { probing = false; break Control(10u8, control) },
                Ok(Closed(control)) => { let _ = channel.send(to, wire_event(ReadClosed(control, take r))); return },
                Ok(Reject(code)) => { let _ = channel.send(to, wire_event(ReadClosed(wire_close_control(code), take r))); return },
                Error(Network(TimedOut)) => {
                    if probing { let _ = channel.send(to, wire_event(ReadClosed(wire_close_control(1001u16), take r))); return }
                    probing = true
                    break Control(9u8, std.websocket.Control(data: [0u8; 125], len: 0u64))
                },
                _ => { let _ = channel.send(to, wire_event(ReadClosed(wire_close_control(1001u16), take r))); return },
            }
        }
        if let Error(_) = channel.send(to, wire_event(take next)) { return }
    }
}

fn wire_write(take x: WireWrite) -> () waits {
    let WireWrite(writer: take initial, from: take from, to: take to, out: take initial_out, clock: clock, config: config) = take x
    let mut writer = take initial
    let mut out = take initial_out
    loop {
        let frame = match channel.receive(from) {
            Ok(take b) => take b,
            Error(_) => return,
        }
        let is_close = list.len(frame) != 0u64 && frame[0u64] & 15u8 == 8u8
        let deadline = if is_close { At(clock, host.mono_ns(clock) + config.close_ms * 1000000u64) } else { Never }
        let _ = std.wsock.stage(mut writer, take frame)
        loop {
            match std.wsock.flush(mut writer, mut out, deadline) {
                Ok(true) => break,
                Ok(false) => {},
                Error(_) => { let _ = channel.send(to, wire_event(Ended(1001u16))); return },
            }
        }
        if is_close {
            let _ = channel.send(to, wire_event(WriteClosed(take writer)))
            return
        }
        if let Error(_) = channel.send(to, wire_event(Sent)) { return }
    }
}

// The capacity-one channel is a handoff, not a second queue. busy stays set
// until Sent, so a writer stalled in send cannot retain a queued second frame.
fn wire_ready(busy: bool) -> bool { !busy }

fn wire_offer(to: Sender[Bytes], mut busy: bool, take b: Bytes) -> Result[(), Bytes] {
    match channel.try_send(to, take b) {
        Ok(()) => { busy = true; Ok(()) },
        Error(Full(take full)) => Error(take full),
        Error(Closed(take closed)) => Error(take closed),
    }
}

// Tokio JoinSet::shutdown aborts all before draining. Goose's contained
// workers release on wait, but lack cancellation. Both children are unshielded.
fn wire_join(take first: Task[()], take second: Task[()]) -> () waits {
    let mut reader = take first
    let mut writer = take second
    task.cancel(mut reader)
    task.cancel(mut writer)
    let _ = task.join(take reader)
    let _ = task.join(take writer)
}

pub fn wire_publish(to: Sender[WireEvent], take frame: Frame) -> Result[(), SendError[WireEvent]] {
    channel.try_send(to, wire_event(Published(take frame)))
}

fn wire_payload(take frame: Frame, max: u64) -> Result[Bytes, std.wsock.Error] {
    let allocation: Result[Bytes, Capacity] = list.with_capacity(max)
    let mut b = match take allocation {
        Ok(take allocated) => take allocated,
        Error(c) => return Error(Allocation(c)),
    }
    let codec: std.codec.Codec[Frame] = std.codec.of()
    match std.codec.encode(codec, frame, mut b) {
        Ok(()) => if list.len(b) <= max { Ok(take b) } else { Error(Protocol(1009u16)) },
        Error(c) => Error(Allocation(c)),
    }
}

type WireAlarm: send { clock: Clock, at: u64, to: Sender[WireEvent] }

fn wire_alarm(take a: WireAlarm) -> () waits {
    host.sleep_until(a.clock, a.at)
    let _ = channel.send(a.to, wire_event(Ended(1001u16)))
}

fn wire_close_control(code: u16) -> std.websocket.Control {
    let mut data: Inline[u8, 125] = [0u8; 125]
    data[0u64] = int.narrow(code >> 8u16)
    data[1u64] = int.truncate(code)
    std.websocket.Control(data: data, len: 2u64)
}

fn wire_close_payload(code: u16) -> Bytes {
    let mut b: Bytes = result.unwrap(list.with_capacity(2u64))
    let high: u8 = int.narrow(code >> 8u16)
    let low: u8 = int.truncate(code)
    result.unwrap(list.push(mut b, high))
    result.unwrap(list.push(mut b, low))
    b
}

type WireOwner[C: send]: send { upgraded: std.wsock.Upgraded, service: Service[C], publisher: Sender[PubIn], config: WireConfig, clock: Clock, tasks: Tasks }

// Serves an already upgraded connection. W3c constructs the service at Hello;
// its sender joins the one publisher inbox lazily at the first Subscribe.
pub fn serve_connection[C: send](tasks: Tasks, take upgraded: std.wsock.Upgraded, take service: Service[C], to_publisher: Sender[PubIn], c: WireConfig, clock: Clock) -> Result[Task[Result[(), std.wsock.Error]], Capacity] {
    let x = WireOwner(upgraded: take upgraded, service: take service, publisher: channel.sender(to_publisher), config: c, clock: clock, tasks: tasks)
    let run: fn(take WireOwner[C]) -> Result[(), std.wsock.Error] waits = wire_owner
    match task.spawn(tasks, bytes session_bytes(c), take x, run) {
        Ok(take h) => Ok(take h),
        Error((cap, _)) => Error(cap),
    }
}

fn wire_owner[C: send](take x: WireOwner[C]) -> Result[(), std.wsock.Error] waits {
    let WireOwner(upgraded: take up, service: take initial_service, publisher: take pub_to, config: c, clock: clock, tasks: tasks) = take x
    let std.wsock.Upgraded(reader: take reader, writer: take writer, source: source, timers: timers, pending: take pending) = take up
    let new_events: Result[(Sender[WireEvent], Receiver[WireEvent]), Capacity] = channel.new(1u64 + c.q)
    let mut lease = Some(take pending)
    let (to, inbox) = match take new_events {
        Ok(take p) => take p, Error(cap) => return Error(Allocation(cap)),
    }
    let new_credits: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64 + c.q)
    let (credit, credits) = match take new_credits {
        Ok(take p) => take p, Error(cap) => return Error(Allocation(cap)),
    }
    for _ in 0u64 .. 1u64 + c.q { let _ = channel.try_send(credit, ()) }
    let new_writes: Result[(Sender[Bytes], Receiver[Bytes]), Capacity] = channel.new(1u64)
    let (write, writes) = match take new_writes {
        Ok(take p) => take p, Error(cap) => return Error(Allocation(cap)),
    }
    let out = std.wsock.outbound(Server, c.socket, None)?
    let mut encoder = std.wsock.outbound(Server, c.socket, None)?
    let reading = WireRead(reader: take reader, to: channel.sender(to), credits: take credits, clock: clock, config: c.socket)
    let mut rh = match task.spawn(tasks, bytes reader_bytes(c), take reading, wire_read) {
        Ok(take h) => take h, Error((cap, _)) => return Error(Allocation(cap)),
    }
    let writing = WireWrite(writer: take writer, from: take writes, to: channel.sender(to), out: out, clock: clock, config: c.socket)
    let wh = match task.spawn(tasks, bytes writer_bytes(), take writing, wire_write) {
        Ok(take h) => take h,
        Error((cap, _)) => {
            task.cancel(mut rh)
            let _ = task.join(take rh)
            return Error(Allocation(cap))
        },
    }
    let mut service = take initial_service
    let mut work = wire_work()
    if let Error(code) = (service.step)(mut service.context, mut work, WAttach(source, channel.sender(to), channel.sender(pub_to))) { wire_join(take rh, take wh); return Error(Protocol(code)) }
    let hello_at = std.wsock.hello_deadline(timers)
    let mut hello_seen = false
    let mut hello_alarm: Option[Task[()]] = None
    if let Some(at) = hello_at {
        let timing = WireAlarm(clock: clock, at: at, to: channel.sender(to))
        match task.spawn(tasks, bytes 4096u64, take timing, wire_hello_alarm) { Ok(take h) => { hello_alarm = Some(take h) }, Error((cap, _)) => { wire_join(take rh, take wh); return Error(Allocation(cap)) } }
    }
    let mut run = 0u64
    let mut held_credit = false
    let mut deferred: List[(Frame, u64)] = list.new()
    let mut busy = false
    let mut queue: List[Frame] = list.new()
    let mut queued_bytes = 0u64
    let mut control: Option[Bytes] = None
    let mut closing = false
    let mut alarm: Option[Task[()]] = None
    let mut read_back: Option[std.wsock.Reader] = None
    let mut write_back: Option[std.wsock.Writer] = None
    let mut read_closed = false
    let mut write_closed = false
    let mut close_at: Option[u64] = None
    // Every normal exit goes through wire_join, including service refusal and
    // either child's Ended. Cancellation uses CONC-8 on the two owned handles.
    let result: Result[(), std.wsock.Error] = loop {
        let event = if (service.ready)(service.context) && list.len(deferred) != 0u64 {
            let (take pending_frame, at) = list.remove(mut deferred, 0u64)
            wire_event(Input(take pending_frame, at))
        } else {
            let e = match channel.try_receive(inbox) {
                Ok(take e) => take e,
                Error(Empty) => { run = 0u64; match channel.receive(inbox) { Ok(take e) => take e, Error(_) => break Ok(()) } },
                _ => break Ok(()),
            }
            run += 1u64
            if run == 1u64 + c.q { let _ = (service.step)(mut service.context, mut work, WDrained); run = 0u64 }
            take e
        }
        let WireEvent(e: take received) = take event
        let frame = match take received {
            Input(take f, at) => {
                if closing { let _ = channel.try_send(credit, ()); continue }
                let mut checked = (service.check)(service.context, f)
                if let Hello(_, _) = f {
                    if !hello_seen {
                        if let Some(end) = hello_at { if at >= end { checked = Some(1008u16) } }
                        hello_seen = true
                    }
                }
                if match checked { None => true, _ => false } && !(service.ready)(service.context) {
                    if let Error(_) = list.push(mut deferred, (take f, at)) { break Ok(()) }
                    continue
                }
                if let Hello(_, _) = f { let _ = replace(mut hello_alarm, None) }
                let handled: Result[Option[Frame], u16] = match checked { Some(code) => Error(code), None => (service.step)(mut service.context, mut work, WClient(take f, at)) }
                if (service.ready)(service.context) { let _ = channel.try_send(credit, ()) } else { held_credit = true }
                match take handled {
                    Ok(take next) => take next,
                    Error(code) => {
                        let payload = wire_close_payload(code)
                        match std.wsock.encode(mut encoder, true, 8u8, payload) {
                            Ok(take refused) => { control = Some(take refused) },
                            Error(e) => break Error(e),
                        }
                        closing = true
                        None
                    },
                }
            },
            FromRunner(take e) => match (service.step)(mut service.context, mut work, WRunner(take e)) {
                Ok(take f) => take f, Error(code) => { control = Some(result.unwrap(std.wsock.encode(mut encoder, true, 8u8, wire_close_payload(code)))); closing = true; None },
            },
            Authenticated(take p) => match (service.step)(mut service.context, mut work, WAuthenticated(take p)) {
                Ok(take f) => take f, Error(code) => { control = Some(result.unwrap(std.wsock.encode(mut encoder, true, 8u8, wire_close_payload(code)))); closing = true; None },
            },
            JoinReady => None,
            HelloExpired => {
                if hello_seen { continue }
                control = Some(result.unwrap(std.wsock.encode(mut encoder, true, 8u8, wire_close_payload(1008u16))))
                closing = true
                None
            },
            Rate(allowed) => match (service.step)(mut service.context, mut work, WRate(allowed)) {
                Ok(take f) => take f, Error(code) => { control = Some(result.unwrap(std.wsock.encode(mut encoder, true, 8u8, wire_close_payload(code)))); closing = true; None },
            },
            Published(take f) => { if closing { continue }; Some(take f) },
            Control(op, payload) => {
                let _ = channel.try_send(credit, ())
                if closing { continue }
                let mut b: Bytes = result.unwrap(list.with_capacity(125u64))
                for i in 0u64 .. payload.len { let _ = list.push(mut b, payload.data[i]) }
                match std.wsock.encode(mut encoder, true, op, b) {
                    Ok(take encoded_control) => { control = Some(take encoded_control) },
                    Error(e) => break Error(e),
                }
                if op == 8u8 { closing = true }
                None
            },
            Sent => { busy = false; None },
            ReadClosed(payload, take returned) => {
                read_back = Some(take returned)
                read_closed = true
                if write_closed { break Ok(()) }
                if !closing {
                    let mut b: Bytes = result.unwrap(list.with_capacity(125u64))
                    for i in 0u64 .. payload.len { result.unwrap(list.push(mut b, payload.data[i])) }
                    match std.wsock.encode(mut encoder, true, 8u8, b) {
                        Ok(take close_bytes) => { control = Some(take close_bytes) },
                        Error(e) => break Error(e),
                    }
                }
                closing = true
                None
            },
            WriteClosed(take returned) => {
                write_back = Some(take returned)
                write_closed = true
                if read_closed { break Ok(()) }
                None
            },
            Ended(_) => break Ok(()),
        }
        let mut outgoing = take frame
        if !closing {
            match (service.step)(mut service.context, mut work, WPoll(!busy && list.len(queue) == 0u64)) {
                Ok(Some(take f)) => { outgoing = Some(take f) },
                Ok(None) => {},
                Error(code) => { control = Some(result.unwrap(std.wsock.encode(mut encoder, true, 8u8, wire_close_payload(code)))); closing = true },
            }
        }
        if held_credit && (service.ready)(service.context) { let _ = channel.try_send(credit, ()); held_credit = false }
        let unarmed = match alarm { None => true, _ => false }
        if closing && unarmed {
            let deadline = host.mono_ns(clock) + c.socket.close_ms * 1000000u64
            close_at = Some(deadline)
            let close_wait = WireAlarm(clock: clock, at: deadline, to: channel.sender(to))
            match task.spawn(tasks, bytes 4096u64, take close_wait, wire_alarm) {
                Ok(take h) => { alarm = Some(take h) },
                Error(_) => break Ok(()),
            }
        }
        if let Some(take f) = take outgoing {
            if let Welcome(_, _, _, _, _, _) = f {
                if let Some(take accepted) = replace(mut lease, None) { std.wsock.hello_accepted(take accepted) }
            }
            // W3c replaces this bounded frame allowance with its row ledger.
            if list.len(queue) >= 1u64 + c.q || queued_bytes + c.socket.max_frame > c.budget { break Ok(()) }
            queued_bytes += c.socket.max_frame
            if let Error(_) = list.push(mut queue, take f) { break Ok(()) }
        }
        if wire_ready(busy) && !write_closed {
            let next = match replace(mut control, None) {
                Some(take b) => Some(take b),
                None => if list.len(queue) != 0u64 {
                    let f = list.remove(mut queue, 0u64)
                    queued_bytes -= c.socket.max_frame
                    let payload = match wire_payload(take f, c.socket.max_frame) { Ok(take packed) => take packed, Error(e) => break Error(e) }
                    let packed_frame = match std.wsock.encode(mut encoder, true, 2u8, payload) { Ok(take packed) => take packed, Error(e) => break Error(e) }
                    Some(take packed_frame)
                } else { None },
            }
            if let Some(take b) = take next {
                if let Error(_) = wire_offer(write, mut busy, take b) { break Ok(()) }
            }
        }
    }
    if let Some(take h) = take alarm {
        let mut timing = take h
        task.cancel(mut timing)
        wire_join(take rh, take wh)
        let _ = task.join(take timing)
    } else {
        wire_join(take rh, take wh)
    }
    if let Some(take returned_reader) = take read_back {
        if let Some(take returned_writer) = take write_back {
            if let Some(deadline) = close_at {
                let _ = std.wsock.finish(take returned_writer, take returned_reader, clock, deadline)
            }
        }
    }
    if let Some(take left) = (service.finish)(mut service.context) { let _ = channel.try_send(pub_to, take left) }
    result
}

// The accept loop retains at most max_sessions owner handles and reaps completed
// ones on the next acceptance. Upgrade runs in the owner, so a stalled HTTP
// client cannot prevent the listener accepting another connection.
type WireAccept[C: send]: send {
    socket: Socket, peer: Ip, accepted: u64, slot: std.wsock.Pending, proxies: List[std.wsock.Prefix],
    policy: Option[ingress.Ingress], service: Service[C], publisher: Sender[PubIn], c: WireConfig, clock: Clock, tasks: Tasks, done: Sender[u64], id: u64
}

fn wire_accepted[C: send](take x: WireAccept[C]) -> Result[(), std.wsock.Error] waits {
    let WireAccept(socket: take socket, peer: peer, accepted: accepted, slot: take slot, proxies: take proxies,
        policy: take policy, service: take service, publisher: take pub_to, c: c, clock: clock, tasks: tasks, done: take done, id: id) = take x
    let mut active: Option[ingress.Lease] = None
    let admission = scoped fn(ip: Ip) -> bool waits {
        if let Some(i) = policy {
            active = ingress.open(i, ip)
            match active { Some(_) => true, None => false }
        } else { true }
    }
    let result = match std.wsock.server_with(take socket, take slot, peer, proxies, c.socket, clock, accepted, admission) {
        Ok(take up) => wire_owner(WireOwner(upgraded: take up, service: take service, publisher: take pub_to, config: c, clock: clock, tasks: tasks)),
        Error(e) => Error(e),
    }
    let _ = channel.try_send(done, id)
    let _ = take active
    result
}

pub fn serve[C: send](n: Net, mut listener: Listener, tasks: Tasks, clock: Clock, to_publisher: Sender[PubIn], c: WireConfig, max_sessions: u64, proxies: List[std.wsock.Prefix], make: scoped[view] fn() -> Service[C]) -> Result[(), std.wsock.Error] waits {
    serve_ingress(n, mut listener, tasks, clock, to_publisher, c, max_sessions, proxies, None, make)
}

pub fn serve_admitted[C: send](n: Net, mut listener: Listener, tasks: Tasks, clock: Clock, to_publisher: Sender[PubIn], c: WireConfig, max_sessions: u64, proxies: List[std.wsock.Prefix], policy: ingress.Ingress, make: scoped[view] fn() -> Service[C]) -> Result[(), std.wsock.Error] waits {
    serve_ingress(n, mut listener, tasks, clock, to_publisher, c, max_sessions, proxies, Some(ingress.share(policy)), make)
}

type WireRefusal: send { socket: Socket, clock: Clock, until: u64, done: Sender[u64], id: u64 }

fn wire_refuse(take r: WireRefusal) -> Result[(), std.wsock.Error] waits {
    let WireRefusal(socket: take socket, clock: clock, until: until, done: take done, id: id) = take r
    let result = std.wsock.refuse_socket(take socket, 503u16, At(clock, until))
    let _ = channel.try_send(done, id)
    result
}

fn serve_ingress[C: send](n: Net, mut listener: Listener, tasks: Tasks, clock: Clock, to_publisher: Sender[PubIn], c: WireConfig, max_sessions: u64, proxies: List[std.wsock.Prefix], policy: Option[ingress.Ingress], make: scoped[view] fn() -> Service[C]) -> Result[(), std.wsock.Error] waits {
    if max_sessions == 0u64 || c.q > 0xffffffffu64 || c.socket.max_frame < 28u64 || 1u64 + c.q > (c.socket.max_frame - 28u64) / (DONE_MAX + 36u64) || c.max_subs == 0u64 { return Error(Configuration) }
    let pool = std.wsock.pending(c.socket)?
    let new_done: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(max_sessions + 16u64)
    let (done, ended) = match take new_done {
        Ok(take p) => take p, Error(cap) => return Error(Allocation(cap)),
    }
    let mut owners: Map[u64, Task[Result[(), std.wsock.Error]]] = map.new()
    let mut rejects: Map[u64, Task[Result[(), std.wsock.Error]]] = map.new()
    let mut id = 0u64
    loop {
        while let Ok(finished) = channel.try_receive(ended) {
            if let Some(take h) = map.remove(mut owners, finished) { let _ = task.join(take h) }
            if let Some(take h) = map.remove(mut rejects, finished) { let _ = task.join(take h) }
        }
        let (socket, peer) = match host.accept(mut listener, Never) { Ok(take p) => take p, Error(e) => return Error(Network(e)) }
        let slot: Option[std.wsock.Pending] = if map.len(owners) == max_sessions { None } else { std.wsock.acquire(pool)? }
        let accepted_ns = host.mono_ns(clock)
        let pending = match take slot {
            Some(take pending) => take pending,
            None => {
                wire_start_refusal(tasks, take socket, clock, accepted_ns, c, done, id, mut rejects)
                id += 1u64
                continue
            },
        }
        let duplicate: Result[List[std.wsock.Prefix], Capacity] = clone(proxies)
        let copied = match take duplicate { Ok(take ps) => take ps, Error(_) => { wire_start_refusal(tasks, take socket, clock, accepted_ns, c, done, id, mut rejects); id += 1u64; continue } }
        let seed = bound bytes c.n_service { make() }
        let made_service = match take seed { Ok(take instance) => take instance, Error(_) => { wire_start_refusal(tasks, take socket, clock, accepted_ns, c, done, id, mut rejects); id += 1u64; continue } }
        let accepted = WireAccept(socket: take socket, peer: peer.ip, accepted: accepted_ns, slot: take pending, proxies: take copied,
            policy: match policy { Some(i) => Some(ingress.share(i)), None => None }, service: take made_service, publisher: channel.sender(to_publisher), c: c, clock: clock, tasks: tasks, done: channel.sender(done), id: id)
        let run: fn(take WireAccept[C]) -> Result[(), std.wsock.Error] waits = wire_accepted
        let owner = match task.spawn(tasks, bytes session_bytes(c), take accepted, run) {
            Ok(take h) => take h,
            Error((_, take back)) => {
                let WireAccept(socket: take refused, peer: _, accepted: _, slot: _, proxies: _, policy: _, service: _, publisher: _, c: _, clock: _, tasks: _, done: _, id: _) = take back
                wire_start_refusal(tasks, take refused, clock, accepted_ns, c, done, id, mut rejects)
                id += 1u64
                continue
            },
        }
        if let Error(_) = map.insert(mut owners, id, take owner) { continue }
        id += 1u64
    }
}

fn limited_reply(take b: Bytes) -> Outcome {
    if list.len(b) > DONE_MAX - 20u64 {
        Failed(OutOfBytes(Room(requested: list.len(b), available: DONE_MAX - 20u64)))
    } else { Returned(take b) }
}

fn register_check[G: send, H: send, A](mut r: Registry[G, H], key: Bytes, ca: std.codec.Codec[A], n: u64, steps: u64) -> Result[(), RegisterError] {
    let check = fn(arg: Bytes) -> Option[Refusal] {
        let seen = bound bytes n {
            let validate = scoped fn() -> Result[Option[Refusal], OutOfTime] {
                bound steps steps {
                    match std.codec.decode(ca, arg) {
                        Ok(Ok(_)) => { let no_refusal: Option[Refusal] = None; no_refusal },
                        Ok(Error(e)) => Some(Malformed(bad(e))),
                        Error(c) => Some(Budget(room(c))),
                    }
                }
            }
            isolate(validate)
        }
        match take seen {
            Ok(Ok(Ok(Ok(take why)))) => take why,
            Ok(Ok(Ok(Error(_)))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Ok(Error(_))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Error(c)) => Some(Budget(room(c))),
            Error(c) => Some(Budget(room(c))),
        }
    }
    let go = match check { Ok(take f) => take f, Error((c, _)) => return Error(Full(c)) }
    let copied_result: Result[Bytes, Capacity] = clone(key)
    let copied: Bytes = match take copied_result { Ok(take b) => take b, Error(c) => return Error(Full(c)) }
    match map.insert(mut r.checks, take copied, take go) { Ok(()) => Ok(()), Error((c, _)) => Error(Full(c)) }
}

// The composition root supplies previous/current activation keys. A current key
// always wins; retaining a gone key never substitutes a newly registered entry.
pub fn retain_gone[G: send, H: send](mut r: Registry[G, H], take key: Bytes) -> Result[(), RegisterError] {
    match map.insert(mut r.gone, take key, ()) { Ok(()) => Ok(()), Error((c, _)) => Error(Full(c)) }
}

pub opaque type Admitted: send {
    principal: ingress.Principal, entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64
}

pub fn admitted(take principal: ingress.Principal, take entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64) -> Admitted {
    Admitted(principal: take principal, entries: take entries, arrived: arrived, now: now, budget: budget, arg_max: arg_max)
}

pub type CallWant: send { key: Bytes, stream: u32, p: u64, arg: Bytes, deadline_ms: u32 }
pub opaque type Send: send { key: Bytes, stream: Bytes, p: u64, arg: Bytes, digest: store.RequestDigest, deadline: u64, budget: u64 }

pub fn prepare[G: send, H: send](r: Registry[G, H], a: Admitted, take want: CallWant) -> Result[Send, Refusal] {
    let known = map.contains(r.slots, want.key)
    if !known && !map.contains(r.gone, want.key) { return Error(NoEntry) }
    let mut allowed = false
    for key in a.entries { if key == want.key { allowed = true } }
    if !allowed { return Error(NotAllowed) }
    let size = list.len(want.arg)
    if size > a.arg_max { return Error(Budget(Room(requested: size, available: a.arg_max))) }
    if size > a.budget { return Error(Budget(Room(requested: size, available: a.budget))) }
    let relative: u64 = int.widen(want.deadline_ms)
    let end = int.saturating_add(a.arrived, relative * 1000000u64)
    if want.deadline_ms == 0u32 || end <= a.now { return Error(Deadline) }
    if let Some(check) = map.get(r.checks, want.key) {
        if let Some(take why) = check(want.arg) { return Error(take why) }
    }
    let digest = store.request_digest(want.key, want.arg)
    let token = ingress.principal(a.principal)
    let allocated: Result[Bytes, Capacity] = list.with_capacity(list.len(token) + 4u64)
    let mut stream: Bytes = match take allocated { Ok(take b) => take b, Error(c) => return Error(Budget(room(c))) }
    if let Error(c) = list.append(mut stream, token) { return Error(Budget(room(c))) }
    let number: u64 = int.widen(want.stream)
    for i in 0u64 .. 4u64 { let octet: u8 = int.narrow((number >> ((3u64 - i) * 8u64)) & 255u64); result.unwrap(list.push(mut stream, octet)) }
    let CallWant(key: take key, stream: _, p: p, arg: take arg, deadline_ms: _) = take want
    Ok(Send(key: take key, stream: take stream, p: p, arg: take arg, digest: digest, deadline: end, budget: a.budget))
}

// The wire owner owns this state. Policy tasks answer only through its inbox.
type WireOwed: send { generation: u64 }

pub opaque type WireWork { asking: Option[Task[()]], timers: Map[u64, Task[()]] }

fn wire_work() -> WireWork { WireWork(asking: None, timers: map.new()) }
type WireHeld: send { stream: u32, p: u64, digest: store.RequestDigest, forwarded: bool, queued: u64, owed: List[WireOwed] }
type WireMark: send = Unit(Bytes) | V1

type WireOutput: send { frame: Frame, marks: List[WireMark] }
type WirePending: send { stream: u32, p: u64, slot: u32, deadline: u32, arg: Bytes, at: u64, grows: bool }
type WirePolicy: send { policy: ingress.Ingress, source: Ip, token: Option[Bytes], principal: Option[ingress.Principal], to: Sender[WireEvent] }

fn wire_policy(take job: WirePolicy) -> () waits {
    let WirePolicy(policy: take policy, source: source, token: take token, principal: take principal, to: take to) = take job
    let answer = match take principal {
        Some(take p) => Rate(ingress.call(policy, p)),
        None => Authenticated(ingress.hello(policy, source, take token)),
    }
    let _ = channel.send(to, wire_event(take answer))
}

type WireDeadline: send { clock: Clock, at: u64, to: Sender[WireEvent], stream: Bytes, p: u64, generation: u64 }

fn wire_deadline(take t: WireDeadline) -> () waits {
    host.sleep_until(t.clock, t.at)
    let WireDeadline(clock: _, at: _, to: take to, stream: take stream, p: p, generation: g) = take t
    let _ = channel.send(to, wire_event(FromRunner(Event(e: Expired(Tick(stream: take stream, p: p, generation: g))))))
}

pub opaque type WireSession[G: send, H: send]: send {
    registry: Registry[G, H], place: Option[StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]]], policy: ingress.Ingress, head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, target: String,
    source: Ip, me: Option[Sender[WireEvent]], publisher: Option[Sender[PubIn]], principal: Option[ingress.Principal],
    phase: u8, wants: List[Want], entries: List[Bytes], placing: u64,
    asking: bool, pending: Option[WirePending],
    held: Map[Bytes, WireHeld], output: List[WireOutput], refusals: u64, last: u64, generation: u64,
    joined: Option[u64], joining: Option[Receiver[u64]], join_lease: Option[WireJoinLease], subscription: Option[(u32, Bytes, Bytes)], subs: List[u32], pub_subs: List[u32], reset_seen: bool
}

pub fn wire_service[G: send, H: send](take reg: Registry[G, H], policy: ingress.Ingress, head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, a: Args) -> Service[WireSession[G, H]] {
    wire_service_seed(take reg, policy, head, clock, tasks, config, result.unwrap(launch_target(a)))
}

fn wire_service_seed[G: send, H: send](take reg: Registry[G, H], policy: ingress.Ingress, head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, H]] {
    let context = WireSession(registry: take reg, place: None, policy: ingress.share(policy), head: channel.sender(head), clock: clock, tasks: tasks, config: config, target: take target,
        source: V4(0u32), me: None, publisher: None, principal: None, phase: 0u8, wants: list.new(), entries: list.new(), placing: 0u64,
        asking: false, pending: None, held: map.new(), output: list.new(), refusals: 0u64, last: 0u64, generation: 0u64,
        joined: None, joining: None, join_lease: None, subscription: None, subs: list.new(), pub_subs: list.new(), reset_seen: false)
    Service(context: take context, step: wire_step, ready: wire_can_read, finish: wire_finish, check: wire_check_live)
}

fn wire_can_read[G: send, H: send](s: WireSession[G, H]) -> bool {
    (s.phase == 0u8 || s.phase == 3u8) && !s.asking && match s.joining { None => true, _ => false }
}

fn wire_key(w: Want) -> Bytes {
    let mut key: Bytes = result.unwrap(list.with_capacity(list.len(w.identity) + 16u64))
    result.unwrap(list.append(mut key, w.identity))
    result.unwrap(std.codec.put_u64(w.args_fp, mut key))
    result.unwrap(std.codec.put_u64(w.result_fp, mut key))
    key
}

fn wire_stream(principal: ingress.Principal, number: u32) -> Bytes {
    let mut stream: Bytes = result.unwrap(clone(ingress.principal(principal)))
    let value: u64 = int.widen(number)
    for i in 0u64 .. 4u64 { let octet: u8 = int.narrow((value >> ((3u64 - i) * 8u64)) & 255u64); result.unwrap(list.push(mut stream, octet)) }
    stream
}

fn wire_units[G: send, H: send](s: WireSession[G, H]) -> u64 {
    let mut units = 0u64
    for (_, h) in s.held {
        let live = list.len(h.owed) + h.queued
        units += if h.forwarded && live == 0u64 { 1u64 } else { live }
    }
    if let Some(p) = s.pending { if p.grows { units += 1u64 } }
    units
}

fn wire_done_size(o: Outcome) -> u64 {
    12u64 + match o {
        Returned(b) => 8u64 + list.len(b),
        Failed(OutOfBytes(_)) => 24u64,
        Failed(OutOfTime(_)) => 16u64,
        Failed(Raised(_)) => 12u64,
        Failed(Gone) => 8u64,
        Refused(Budget(_)) => 24u64,
        Refused(Malformed(_)) => 20u64,
        Refused(_) => 8u64,
        _ => 4u64,
    }
}

fn wire_rows_size(rows: List[Row]) -> u64 {
    let mut size = 0u64
    for row in rows {
        size += 12u64 + list.len(row.key)
        if let Some(value) = row.value { size += 4u64 + list.len(value) }
    }
    size
}

fn wire_output_size(f: Frame) -> u64 {
    match f {
        Batch(_, complete, rows, done) => {
            let mut size = 24u64 + 4u64 * list.len(complete) + wire_rows_size(rows)
            for d in done { size += wire_done_size(d.outcome) }
            size
        },
        Reset(_, done) => { let mut size = 16u64; for d in done { size += wire_done_size(d.outcome) }; size },
        Ended(_, o) => 8u64 + wire_done_size(o) - 12u64,
        _ => 0u64,
    }
}

fn wire_queued_bytes[G: send, H: send](s: WireSession[G, H]) -> u64 {
    let mut size = 0u64
    for o in s.output { size += wire_output_size(o.frame) }
    size
}

fn wire_queue[G: send, H: send](mut s: WireSession[G, H], take frame: Frame, take marks: List[WireMark]) {
    result.unwrap(list.push(mut s.output, WireOutput(frame: take frame, marks: take marks)))
}

fn wire_refused[G: send, H: send](mut s: WireSession[G, H], stream: u32, p: u64, take why: Refusal) -> Result[(), u16] {
    if s.refusals >= 1u64 + s.config.q { return Error(1008u16) }
    s.refusals += 1u64
    let mut done: List[Done] = list.new()
    result.unwrap(list.push(mut done, Done(stream: stream, p: p, outcome: Refused(take why))))
    let mut marks: List[WireMark] = list.new()
    result.unwrap(list.push(mut marks, V1))
    let version = s.last
    wire_queue(mut s, Batch(version, list.new(), list.new(), take done), take marks)
    Ok(())
}

fn wire_row[G: send, H: send](mut s: WireSession[G, H], key: Bytes, stream: u32, p: u64, version: u64, take outcome: Outcome) {
    let mut done: List[Done] = list.new()
    result.unwrap(list.push(mut done, Done(stream: stream, p: p, outcome: take outcome)))
    let mut marks: List[WireMark] = list.new()
    result.unwrap(list.push(mut marks, Unit(result.unwrap(clone(key)))))
    wire_queue(mut s, Batch(version, list.new(), list.new(), take done), take marks)
}

fn wire_reset[G: send, H: send](mut s: WireSession[G, H], version: u64) -> Result[(), u16] {
    if s.reset_seen { return Error(1008u16) }
    s.reset_seen = true
    wire_reset_rows(mut s, version)
}

fn wire_reset_rows[G: send, H: send](mut s: WireSession[G, H], version: u64) -> Result[(), u16] {
    let mut done: List[Done] = list.new()
    let mut marks: List[WireMark] = list.new()
    let all = replace(mut s.output, list.new())
    for take o in take all {
        let WireOutput(frame: take f, marks: take held) = take o
        for take m in take held { result.unwrap(list.push(mut marks, take m)) }
        match take f {
            Batch(_, _, _, take ds) => for take d in take ds { result.unwrap(list.push(mut done, take d)) },
            Reset(_, take ds) => for take d in take ds { result.unwrap(list.push(mut done, take d)) },
            _ => {},
        }
    }
    let _ = replace(mut s.subs, list.new())
    let _ = replace(mut s.pub_subs, list.new())
    let _ = replace(mut s.join_lease, None)
    s.joined = None
    let _ = replace(mut s.joining, None)
    wire_queue(mut s, Reset(version, take done), take marks)
    Ok(())
}

fn wire_take_output[G: send, H: send](mut s: WireSession[G, H]) -> Option[Frame] {
    if list.len(s.output) == 0u64 { return None }
    let WireOutput(frame: take f, marks: take marks) = list.remove(mut s.output, 0u64)
    for take mark in take marks {
        match take mark {
            V1 => { s.refusals -= 1u64 },
            Unit(take key) => if let Some(take found) = map.remove(mut s.held, key) {
                let mut h = take found
                h.queued -= 1u64
                if h.forwarded || h.queued != 0u64 || list.len(h.owed) != 0u64 { result.unwrap(map.insert(mut s.held, take key, take h)) }
            },
        }
    }
    Some(take f)
}

fn wire_begin_policy[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take token: Option[Bytes], take principal: Option[ingress.Principal]) -> Result[(), u16] {
    let to = match s.me { Some(to) => channel.sender(to), None => return Error(1008u16) }
    let job = WirePolicy(policy: ingress.share(s.policy), source: s.source, token: take token, principal: take principal, to: take to)
    match task.spawn(s.tasks, bytes 8192u64, take job, wire_policy) {
        Ok(take h) => { work.asking = Some(take h); s.asking = true; Ok(()) },
        Error(_) => Error(1013u16),
    }
}

fn wire_call_ready[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take pending: WirePending, allowed: bool) -> Result[(), u16] {
    let WirePending(stream: stream, p: p, slot: slot, deadline: deadline_ms, arg: take arg, at: at, grows: _) = take pending
    if !allowed { return wire_refused(mut s, stream, p, Overloaded) }
    let index: u64 = int.widen(slot)
    if index >= list.len(s.entries) { return wire_refused(mut s, stream, p, NoEntry) }
    let principal = match s.principal { Some(a) => result.unwrap(ingress.share_principal(a)), _ => return Error(1008u16) }
    let mut entries: List[Bytes] = list.new()
    result.unwrap(list.push(mut entries, result.unwrap(clone(s.entries[index]))))
    let context = admitted(take principal, take entries, at, host.mono_ns(s.clock), s.config.budget, s.config.socket.max_frame)
    let want = CallWant(key: result.unwrap(clone(s.entries[index])), stream: stream, p: p, arg: take arg, deadline_ms: deadline_ms)
    let sent = match prepare(s.registry, context, take want) { Ok(take send) => take send, Error(take why) => return wire_refused(mut s, stream, p, take why) }
    let k = slot_key(sent.stream, p)
    let (forwarded, same, queued) = match map.get(s.held, k) { Some(h) => (h.forwarded, h.digest == sent.digest, h.queued), _ => (false, true, 0u64) }
    if forwarded && !same { return Error(1008u16) }
    let durable = match map.get(s.registry.slots, sent.key) { Some(Transact(_, _, _, _)) => true, None => true, _ => false }
    if !durable {
        let is_compute = match map.get(s.registry.slots, sent.key) { Some(Compute(_)) => true, _ => false }
        if !is_compute { return wire_refused(mut s, stream, p, NotAllowed) }
        let outcome = call(s.registry, sent.key, sent.arg)
        let held = WireHeld(stream: stream, p: p, digest: sent.digest, forwarded: false, queued: queued + 1u64, owed: list.new())
        result.unwrap(map.insert(mut s.held, result.unwrap(clone(k)), take held))
        let version = s.last
        wire_row(mut s, k, stream, p, version, take outcome)
        return Ok(())
    }
    s.generation += 1u64
    let to = match s.me { Some(to) => channel.sender(to), None => return Error(1008u16) }
    let timing = WireDeadline(clock: s.clock, at: sent.deadline, to: take to, stream: result.unwrap(clone(sent.stream)), p: p, generation: s.generation)
    let h = match task.spawn(s.tasks, bytes 4096u64, take timing, wire_deadline) { Ok(take h) => take h, Error(_) => return wire_refused(mut s, stream, p, Overloaded) }
    let owed = WireOwed(generation: s.generation)
    if forwarded {
        let mut held = option.unwrap(map.remove(mut s.held, k))
        result.unwrap(list.push(mut held.owed, take owed))
        result.unwrap(map.insert(mut s.held, take k, take held))
    } else {
        let Send(key: take entry, stream: take named, p: position, arg: take argument, digest: digest, deadline: _, budget: _) = take sent
        let request = Req(stream: take named, p: position, key: take entry, arg: take argument, digest: digest, reply_to: Wire(wire_me(s)))
        if let Error(_) = channel.try_send(s.head, take request) { return wire_refused(mut s, stream, p, Overloaded) }
        let mut sends: List[WireOwed] = list.new()
        result.unwrap(list.push(mut sends, take owed))
        result.unwrap(map.insert(mut s.held, take k, WireHeld(stream: stream, p: p, digest: digest, forwarded: true, queued: queued, owed: take sends)))
    }
    result.unwrap(map.insert(mut work.timers, s.generation, take h))
    Ok(())
}

fn wire_end[G: send, H: send](mut s: WireSession[G, H], sub: u32, take outcome: Outcome) {
    wire_stop_sub(mut s, sub)
    wire_queue(mut s, Ended(sub, take outcome), list.new())
}

fn wire_subscribed[G: send, H: send](mut s: WireSession[G, H], sub: u32, take key: Bytes, take arg: Bytes) {
    let who = option.unwrap(s.joined)
    let to_pub = wire_publisher(s)
    let sent = channel.try_send(to_pub, PubIn(e: Subscribed(who, sub, take key, take arg)))
    if let Error(_) = take sent { wire_end(mut s, sub, Refused(Overloaded)); return }
    let mut present = false
    for id in s.subs { if id == sub { present = true } }
    if !present { result.unwrap(list.push(mut s.subs, sub)) }
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if !registered { result.unwrap(list.push(mut s.pub_subs, sub)) }
}

fn wire_subscribe[G: send, H: send](mut s: WireSession[G, H], sub: u32, slot: u32, take arg: Bytes, take resume: Option[Bytes]) -> Result[(), u16] {
    let version = s.last
    if let Some(_) = resume { return wire_reset_rows(mut s, version) }
    let index: u64 = int.widen(slot)
    if index >= list.len(s.entries) { wire_end(mut s, sub, Refused(NoEntry)); return Ok(()) }
    let key: Bytes = result.unwrap(clone(s.entries[index]))
    if !map.contains(s.registry.slots, key) {
        let outcome: Outcome = if map.contains(s.registry.gone, key) { Failed(Gone) } else { Refused(NoEntry) }
        wire_end(mut s, sub, take outcome)
        return Ok(())
    }
    let is_query = match map.get(s.registry.slots, key) { Some(Query(_)) => true, _ => false }
    if !is_query { wire_end(mut s, sub, Refused(NoEntry)); return Ok(()) }
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if !registered && list.len(s.pub_subs) >= s.config.max_subs { wire_end(mut s, sub, Refused(NotAllowed)); return Ok(()) }
    let refused = match map.get(s.registry.checks, key) { Some(check) => check(arg), _ => { let no_refusal: Option[Refusal] = None; no_refusal } }
    if let Some(take why) = take refused { wire_end(mut s, sub, Refused(take why)); return Ok(()) }
    if let Some(_) = s.joined { wire_subscribed(mut s, sub, take key, take arg); return Ok(()) }
    let made: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(1u64)
    let (told, hear) = match take made { Ok(take pair) => take pair, Error(_) => { wire_end(mut s, sub, Refused(Overloaded)); return Ok(()) } }
    let close_channel: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64)
    let (closing, closed) = match take close_channel { Ok(take pair) => take pair, Error(_) => { wire_end(mut s, sub, Refused(Overloaded)); return Ok(()) } }
    let lease = match WireJoinLease(closing: take closing, publisher: wire_publisher(s)) { Ok(take l) => take l, Error(_) => { wire_end(mut s, sub, Refused(Overloaded)); return Ok(()) } }
    let join = Join(to: Wire(wire_me(s)), told: take told, mark: None, closed: Some(take closed))
    if let Error(_) = channel.try_send(wire_publisher(s), PubIn(e: Joined(take join))) { wire_end(mut s, sub, Refused(Overloaded)); return Ok(()) }
    s.join_lease = Some(take lease)
    s.joining = Some(take hear)
    s.subscription = Some((sub, take key, take arg))
    Ok(())
}

fn wire_content[G: send, H: send](mut s: WireSession[G, H], take o: Owe) -> Result[(), u16] {
    let current = match s.joined { Some(who) => who == o.session, _ => false }
    if !current { return Ok(()) }
    let Owe(session: _, version: version, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    s.last = if version > s.last { version } else { s.last }
    if reset { return wire_reset(mut s, version) }
    let mut live_rows: List[Row] = list.new()
    let mut live_complete: List[u32] = list.new()
    for take row in take rows {
        let mut live = false
        for sub in s.subs { if sub == row.sub { live = true } }
        if live { result.unwrap(list.push(mut live_rows, take row)) }
    }
    for sub in complete {
        let mut live = false
        for id in s.subs { if id == sub { live = true } }
        if live { result.unwrap(list.push(mut live_complete, sub)) }
    }
    let reserve = (1u64 + s.config.q) * (DONE_MAX + 36u64)
    let envelope = 24u64 + 4u64 * list.len(live_complete)
    let allowance = int.saturating_sub(s.config.socket.max_frame, reserve + envelope)
    let requested = wire_rows_size(live_rows)
    if requested > allowance {
        if list.len(live_complete) != 0u64 {
            for sub in live_complete { wire_end(mut s, sub, Refused(Budget(Room(requested: requested, available: allowance)))) }
        } else { return wire_reset(mut s, version) }
    } else if list.len(live_rows) != 0u64 || list.len(live_complete) != 0u64 {
        let frame = Batch(s.last, take live_complete, take live_rows, list.new())
        if wire_queued_bytes(s) + wire_output_size(frame) > s.config.budget { return wire_reset(mut s, version) }
        wire_queue(mut s, take frame, list.new())
    }
    for take e in take ended { let (sub, take why) = take e; wire_forget_sub(mut s, sub); wire_end(mut s, sub, take why) }
    Ok(())
}

fn wire_answer[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take told: Told) -> Result[(), u16] {
    // A pre-W3c stored reply can exceed today's producer bound. Preserve its
    // bytes in the store and fail delivery explicitly before retaining its row.
    if let Returned(b) = told.outcome { if list.len(b) > DONE_MAX - 20u64 { return Error(1009u16) } }
    let key = slot_key(told.stream, told.p)
    if let Some(take found) = map.remove(mut s.held, key) {
        let mut h = take found
        h.forwarded = false
        let owed = replace(mut h.owed, list.new())
        let count = list.len(owed)
        h.queued += count
        s.last = if told.version > s.last { told.version } else { s.last }
        let version = s.last
        for take owing in take owed {
            let _ = map.remove(mut work.timers, owing.generation)
            let outcome: Outcome = result.unwrap(clone(told.outcome))
            wire_row(mut s, key, h.stream, h.p, version, take outcome)
        }
        if h.queued != 0u64 { result.unwrap(map.insert(mut s.held, take key, take h)) }
    }
    Ok(())
}

fn wire_expired[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, tick: Tick) {
    let _ = map.remove(mut work.timers, tick.generation)
    let version = s.last
    let key = slot_key(tick.stream, tick.p)
    if let Some(take found) = map.remove(mut s.held, key) {
        let mut h = take found
        let mut index = 0u64
        let mut hit = false
        while index < list.len(h.owed) && !hit {
            if h.owed[index].generation == tick.generation { hit = true } else { index += 1u64 }
        }
        if hit {
            let _ = list.remove(mut h.owed, index)
            h.queued += 1u64
            wire_row(mut s, key, h.stream, h.p, version, Abandoned)
        }
        result.unwrap(map.insert(mut s.held, take key, take h))
    }
}

fn wire_step[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take input: ServiceInput) -> Result[Option[Frame], u16] {
    match take input {
        WAttach(source, take me, take pub_to) => {
            s.source = source; s.me = Some(take me); s.publisher = Some(take pub_to)
        },
        WClient(take frame, at) => match take frame {
            Hello(take token, take wanted) => {
                if s.phase != 0u8 { return Error(1008u16) }
                s.phase = 1u8
                s.wants = take wanted
                wire_begin_policy(mut s, mut work, take token, None)?
            },
            Call(stream, p, slot, deadline, take arg) => {
                if s.phase != 3u8 { return Error(1008u16) }
                let (take key, take auth) = match s.principal { Some(principal) => (slot_key(wire_stream(principal, stream), p), result.unwrap(ingress.share_principal(principal))), _ => return Error(1008u16) }
                let grows = match map.get(s.held, key) { Some(h) => !h.forwarded || h.queued != 0u64 || list.len(h.owed) != 0u64, _ => true }
                if grows && wire_units(s) >= 1u64 + s.config.q { wire_refused(mut s, stream, p, Overloaded)? } else {
                    s.pending = Some(WirePending(stream: stream, p: p, slot: slot, deadline: deadline, arg: take arg, at: at, grows: grows))
                    wire_begin_policy(mut s, mut work, None, Some(take auth))?
                }
            },
            Subscribe(sub, slot, take arg, take resume) => { if s.phase != 3u8 { return Error(1008u16) }; wire_subscribe(mut s, sub, slot, take arg, take resume)? },
            Unsubscribe(sub) => {
                if s.phase != 3u8 { return Error(1008u16) }
                wire_stop_sub(mut s, sub)
            },
            _ => return Error(1007u16),
        },
        WAuthenticated(take principal) => {
            let _ = replace(mut work.asking, None)
            s.asking = false
            s.principal = take principal
            if let None = s.principal { return Error(1013u16) }
            if let Some(place) = s.place { s.registry = match placed(place, s.config.n_place) { Ok(take r) => take r, Error(_) => return Error(1013u16) } }
            let wanted = replace(mut s.wants, list.new())
            for take want in take wanted { result.unwrap(list.push(mut s.entries, wire_key(want))) }
            s.phase = 2u8
        },
        WRate(allowed) => {
            let _ = replace(mut work.asking, None)
            s.asking = false
            if let Some(take pending) = replace(mut s.pending, None) { wire_call_ready(mut s, mut work, take pending, allowed)? }
        },
        WRunner(take e) => {
            let Event(e: take received) = take e
            match take received {
                Answered(take told) => wire_answer(mut s, mut work, take told)?,
                Expired(tick) => wire_expired(mut s, mut work, tick),
                Content(take content) => wire_content(mut s, take content)?,
                _ => {},
            }
        },
        WDrained => {
            if let Some(_) = s.joined { let _ = channel.try_send(wire_publisher(s), PubIn(e: Drained)) }
        },
        WPoll(writable) => {
            let received: Option[u64] = match s.joining { Some(hear) => match channel.try_receive(hear) { Ok(who) => Some(who), _ => None }, _ => None }
            if let Some(who) = received {
                let _ = replace(mut s.joining, None)
                s.joined = Some(who)
                if let Some((sub, take key, take arg)) = replace(mut s.subscription, None) { wire_subscribed(mut s, sub, take key, take arg) }
            }
            if !writable { return Ok(None) }
            if s.phase == 4u8 { s.phase = 3u8 }
            if s.phase == 2u8 {
                if s.placing == 0u64 {
                    s.placing += 1u64
                    if list.len(s.entries) == 0u64 { s.phase = 4u8 }
                    let principal: Bytes = match s.principal { Some(p) => result.unwrap(clone(ingress.principal(p))), _ => fail("runner: unbound principal") }
                    let q: u32 = int.narrow(s.config.q)
                    return Ok(Some(Welcome(take principal, q, s.config.budget, result.unwrap(launch_digest()), result.unwrap(clone(s.target)), launch_word(0u64, 0u64))))
                }
                let index = s.placing - 1u64
                let slot: u32 = int.narrow(index)
                let answer: Entry = if map.contains(s.registry.slots, s.entries[index]) { Ready(slot) } else { Gone }
                s.placing += 1u64
                if index + 1u64 == list.len(s.entries) { s.phase = 4u8 }
                return Ok(Some(Placed(take answer)))
            }
            return Ok(wire_take_output(mut s))
        },
    }
    let version = s.last
    if wire_queued_bytes(s) > s.config.budget { wire_reset(mut s, version)? }
    Ok(None)
}


fn wire_me[G: send, H: send](s: WireSession[G, H]) -> Sender[WireEvent] {
    match s.me { Some(to) => channel.sender(to), _ => fail("runner: detached wire service") }
}

fn wire_publisher[G: send, H: send](s: WireSession[G, H]) -> Sender[PubIn] {
    match s.publisher { Some(to) => channel.sender(to), _ => fail("runner: detached wire service") }
}


fn wire_hello_alarm(take a: WireAlarm) -> () waits {
    host.sleep_until(a.clock, a.at)
    let _ = channel.send(a.to, wire_event(HelloExpired))
}

fn wire_finish[G: send, H: send](mut s: WireSession[G, H]) -> Option[PubIn] {
    match s.joined { Some(who) => Some(PubIn(e: Left(who))), _ => None }
}

// Production sessions build place inside the owner, after source admission.
pub fn wire_place_service[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], policy: ingress.Ingress, head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, a: Args) -> Service[WireSession[G, H]] {
    let initial: Registry[G, H] = registry()
    let mut service = wire_service(take initial, policy, head, clock, tasks, config, a)
    service.context.place = Some(place)
    take service
}

fn wire_start_refusal(tasks: Tasks, take socket: Socket, clock: Clock, at: u64, c: WireConfig, done: Sender[u64], id: u64, mut rejects: Map[u64, Task[Result[(), std.wsock.Error]]]) {
    if map.len(rejects) >= 16u64 { return }
    let r = WireRefusal(socket: take socket, clock: clock, until: int.saturating_add(at, c.socket.upgrade_ms * 1000000u64), done: channel.sender(done), id: id)
    if let Ok(take h) = task.spawn(tasks, bytes 16384u64, take r, wire_refuse) { let _ = map.insert(mut rejects, id, take h) }
}


resource type WireJoinLease: send { closing: Sender[()], publisher: Sender[PubIn] } drop(lease) {
    let _ = channel.try_send(lease.closing, ())
    let _ = channel.try_send(lease.publisher, PubIn(e: Drained))
}


fn wire_remove_sub[G: send, H: send](mut s: WireSession[G, H], sub: u32) {
    let mut i = 0u64
    while i < list.len(s.subs) { if s.subs[i] == sub { let _ = list.remove(mut s.subs, i) } else { i += 1u64 } }
    let pending = replace(mut s.output, list.new())
    for take output in take pending {
        let WireOutput(frame: take frame, marks: take marks) = take output
        match take frame {
            Batch(v, take complete, take rows, take done) => {
                let mut live: List[u32] = list.new()
                let mut kept: List[Row] = list.new()
                for id in complete { if id != sub { result.unwrap(list.push(mut live, id)) } }
                for take row in take rows { if row.sub != sub { result.unwrap(list.push(mut kept, take row)) } }
                if list.len(live) != 0u64 || list.len(kept) != 0u64 || list.len(done) != 0u64 { wire_queue(mut s, Batch(v, take live, take kept, take done), take marks) }
            },
            Ended(id, take outcome) => if id != sub { wire_queue(mut s, Ended(id, take outcome), take marks) },
            take other => wire_queue(mut s, take other, take marks),
        }
    }
}


fn wire_forget_sub[G: send, H: send](mut s: WireSession[G, H], sub: u32) {
    let mut i = 0u64
    while i < list.len(s.pub_subs) { if s.pub_subs[i] == sub { let _ = list.remove(mut s.pub_subs, i) } else { i += 1u64 } }
}

fn wire_stop_sub[G: send, H: send](mut s: WireSession[G, H], sub: u32) {
    wire_remove_sub(mut s, sub)
    if list.len(s.subs) == 0u64 {
        let _ = replace(mut s.join_lease, None)
        let _ = replace(mut s.joining, None)
        s.joined = None
        let _ = replace(mut s.pub_subs, list.new())
        return
    }
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if registered {
        if let Some(who) = s.joined {
            if let Ok(()) = channel.try_send(wire_publisher(s), PubIn(e: Unsubscribed(who, sub))) { wire_forget_sub(mut s, sub) }
        }
    }
}


// A second digest at a live position closes before waiting for policy. Otherwise
// a head answer could reach the writer while that conflicting send awaits a rate decision.
fn wire_check_live[G: send, H: send](s: WireSession[G, H], f: Frame) -> Option[u16] {
    if let Call(stream, p, slot, _, arg) = f {
        let index: u64 = int.widen(slot)
        if index >= list.len(s.entries) { return None }
        let key = s.entries[index]
        if !map.contains(s.registry.slots, key) && !map.contains(s.registry.gone, key) { return None }
        let named: Bytes = match s.principal { Some(principal) => wire_stream(principal, stream), _ => return None }
        let position = slot_key(named, p)
        let prior: Option[store.RequestDigest] = match map.get(s.held, position) { Some(h) => if h.forwarded { Some(h.digest) } else { None }, _ => None }
        if let Some(digest) = prior {
            if digest != store.request_digest(key, arg) { return Some(1008u16) }
        }
    }
    None
}

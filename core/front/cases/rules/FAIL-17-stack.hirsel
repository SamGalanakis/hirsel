// FAIL-17: an activation past its task's stack allowance fails at its entry with the
// cause `Stack`. Only `isolate` catches it; `bound bytes` and `bound steps` do not, so it
// passes through them to the enclosing isolate. A refusal releases the cleanup margin, so
// finalizers of the unwinding frames run without a second `Stack`. A frame larger than
// the allowance is refused when the function is built. Equality, ordering and hashing of
// a recursive value walk it on the glue worklist, so a deep value never runs out of
// stack in them. Oracle: FAIL-17's text; each law
// answers 1 when it holds. These are reference runs: the native source runners call from
// a C thread with no task stack, so Cranelift and LLVM run every law here on task stacks
// through test_run_native.rs (`fail17_stack_laws`).
// expect: reference run recursion_caught() = 1 used 32
// expect: reference run steps_pass_it() = 1 used 32
// expect: reference run bytes_pass_it() = 1 used 32
// expect: reference run chain_caught() = 1 used 32
// expect: reference run finalizer_within_margin() = 1 used 32
// expect: reference run continues() = 1 used 32
// expect: reference run tail_walks(2000) = 1 used 0
// expect: reference run head_walks(2000) = 1 used 0
// expect: reference run kids_walk(2000) = 1 used 0
// expect: reference run grid_walk(2000) = 1 used 0
// expect: refuse FAIL-17 at 518:1

// A 4 KiB frame per level: a million levels are far past the 7.5 MiB allowance.
fn deep(n: u64) -> u64 {
    let mut pad: Inline[u64, 512] = [0u64; 512]
    pad[n % 512u64] = n
    if n == 0u64 {
        pad[0u64]
    } else {
        deep(n - 1u64) + pad[n % 512u64] - n + 1u64
    }
}

// The cause chain holds exactly one cause, `Stack`.
fn only_stack(take r: Result[Result[u64, Causes], Capacity]) -> u64 {
    match take r {
        Ok(Error(causes)) => {
            let mut stacks = 0u64
            let mut others = 0u64
            for cause in causes {
                match cause.kind {
                    Stack => { stacks += 1u64 },
                    _ => { others += 1u64 },
                }
            }
            if stacks == 1u64 && others == 0u64 { 1u64 } else { 2u64 }
        },
        Ok(Ok(_)) => 3u64,
        Error(_) => 4u64,
    }
}

fn recursion_caught() -> u64 {
    only_stack(isolate(fn() -> u64 { deep(1000000u64) }))
}

// `bound steps` does not catch `Stack`: its own arms never run.
fn steps_pass_it() -> u64 {
    only_stack(isolate(fn() -> u64 {
        match (bound steps 1000000000 { deep(1000000u64) }) {
            Ok(_) => 5u64,
            Error(_) => 6u64,
        }
    }))
}

fn bytes_pass_it() -> u64 {
    only_stack(isolate(fn() -> u64 {
        match (bound bytes 65536 { deep(1000000u64) }) {
            Ok(_) => 5u64,
            Error(_) => 6u64,
        }
    }))
}

// Every element of a frame, read after its callee returns, so the frame stays whole.
fn held(pad: Inline[u64, 32768]) -> u64 {
    let mut sum = 0u64
    let mut i = 0u64
    while i < 32768u64 {
        sum += pad[i]
        i += 1u64
    }
    sum
}

// Forty distinct functions with 256 KiB frames: 10 MiB of frames, no recursion.
fn c01(n: u64) -> u64 {
    let mut pad: Inline[u64, 32768] = [0u64; 32768]
    pad[n % 32768u64] = n
    let below = c02(n + 1u64)
    below + held(pad) - n
}

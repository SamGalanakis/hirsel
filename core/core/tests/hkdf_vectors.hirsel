// test-vectors
fn matches_mac(key: Secret, expected: Bytes) -> bool {
    let tag = result.unwrap(secret.hmac_sha256(key, b"x"))
    let mut out: Bytes = list.with_capacity(32)
    bytebuf.append_inline(mut out, tag, 0, 32) && out == expected
}

fn matches_hkdf(ikm: Bytes, salt: Bytes, info: Bytes, len: u64, expected: Bytes) -> bool {
    let parent = result.unwrap(secret.seal(take ikm, "kdf"))
    match secret.derive_hkdf_sha256(parent, salt, info, len, "mac") {
        Ok(child) => matches_mac(child, expected),
        Error(Invalid) => list.len(expected) == 0,
        _ => false
    }
}

fn size(data: Bytes, at: u64) -> u64 {
    let len: u16 = list.word_le(data, at)
    int.widen(len)
}

// KD2. Zero means all 83 valid cases and all three 8161-byte refusals passed.
// expect: run kd2_wycheproof() = 0
fn kd2_wycheproof() -> u64 {
    let data = wycheproof_data()
    let mut pos: u64 = 0
    while pos < list.len(data) {
        let id = size(data, pos)
        let len = size(data, pos + 2)
        let ikm = pos + 12
        let salt = ikm + size(data, pos + 4)
        let info = salt + size(data, pos + 6)
        let tag = info + size(data, pos + 8)
        let end = tag + size(data, pos + 10)
        if !matches_hkdf(list.slice(data, ikm, salt), list.slice(data, salt, info), list.slice(data, info, tag), len, list.slice(data, tag, end)) {
            return id
        }
        pos = end
    }
    0
}

// KD1. Python hmac.digest keyed by the published RFC 5869 A.1–A.3 OKMs.
// expect: run kd1_rfc5869() = true
fn kd1_rfc5869() -> bool {
    let first = matches_hkdf(b"\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b", b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c", b"\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9", 42, b"\xf2\x4d\x15\x7d\x39\x6f\xd4\x6c\xc7\x12\xda\x83\x9e\x28\x4d\x3d\xad\xdf\x38\x4b\x77\x87\x3b\x47\xc0\x56\xc5\x90\xc2\x08\xf9\x5a")
    let second = matches_hkdf(b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f", b"\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf", b"\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff", 82, b"\x03\x78\x7f\xb9\xaa\x7a\x2e\xb5\xc3\x8b\x61\x0b\xec\x42\x74\x76\x60\x7a\xec\x41\xbd\x56\x05\xc0\x87\x0f\x48\x6f\x42\xc3\xfd\x77")
    let third = matches_hkdf(b"\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b", b"", b"", 42, b"\x1e\xbf\x8c\x8e\x20\x2a\x7a\x1b\x8e\xb6\xec\xcc\xea\x6d\x98\x62\xc4\x95\xdb\x54\x6d\x59\xf1\xc4\x9c\xcf\x69\x07\xea\x45\x40\x54")
    first && second && third
}

// KD3. Python cryptography ChaCha20Poly1305 under RFC 5869 A.1's OKM
// truncated to 32 bytes, with RFC 8439 section 2.8.2's nonce, plaintext and AAD.
// expect: run kd3_aead_child() = true
fn kd3_aead_child() -> bool {
    let ikm = b"\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b"
    let parent = result.unwrap(secret.seal(take ikm, "kdf"))
    let child = result.unwrap(secret.derive_hkdf_sha256(parent, b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c", b"\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9", 32, "aead(chacha20-poly1305)"))
    let mut out: Bytes = list.with_capacity(130)
    let n = result.unwrap(secret.aead_seal(child, ChaCha20Poly1305, b"\x07\x00\x00\x00\x40\x41\x42\x43\x44\x45\x46\x47", b"\x50\x51\x52\x53\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7", b"\x4c\x61\x64\x69\x65\x73\x20\x61\x6e\x64\x20\x47\x65\x6e\x74\x6c\x65\x6d\x65\x6e\x20\x6f\x66\x20\x74\x68\x65\x20\x63\x6c\x61\x73\x73\x20\x6f\x66\x20\x27\x39\x39\x3a\x20\x49\x66\x20\x49\x20\x63\x6f\x75\x6c\x64\x20\x6f\x66\x66\x65\x72\x20\x79\x6f\x75\x20\x6f\x6e\x6c\x79\x20\x6f\x6e\x65\x20\x74\x69\x70\x20\x66\x6f\x72\x20\x74\x68\x65\x20\x66\x75\x74\x75\x72\x65\x2c\x20\x73\x75\x6e\x73\x63\x72\x65\x65\x6e\x20\x77\x6f\x75\x6c\x64\x20\x62\x65\x20\x69\x74\x2e", mut out))
    n == 130 && out == b"\x3a\xc9\xb8\x39\xba\xa3\x7a\xfd\x65\x5b\x92\x0a\x09\x9b\x92\x08\x52\xc8\x27\xbc\xcb\xe8\x5f\x29\x85\x0e\xb2\x53\x30\x09\xef\xe8\x31\x9b\x8b\xe6\x12\x8b\x9b\xbe\xda\x39\xdd\xd7\x71\x4b\xa4\x66\x6c\x8d\x6d\xe6\xca\x83\x85\x8c\x72\xf8\xdf\x40\x52\x5b\xce\x62\x7c\xd5\x04\x28\x77\x7d\x6c\x2b\xbc\x76\xc5\x27\x7e\x96\xcb\xbc\x0a\x70\xd3\x10\x24\xfd\x52\x72\x67\x65\x32\x18\x8d\x45\xc7\xb1\x77\xe8\x97\x6b\x32\x4b\x9f\x1c\x19\xe4\xae\xee\x85\x06\xcf\x79\x19\x23\x60\x7b\xc5\x70\xb2\x7e\xa4\x3d\x60\xa9\xd8\x49\xf2\x9b\xa0\xf2"
}

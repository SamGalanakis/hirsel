fn law_describe_ticket(mut db: store.Db, outcome: store.Outcome[(), store.Error]) -> Result[(), store.Error] waits {
    if let Committed(done) = outcome {
        return store.durable(mut db, done.ticket)
    }
    fail("describe fixture did not commit")
}

fn law_describe_matches_case(d: Dir, c: Clock, r: Random, tasks: Tasks, mask_appends: bool) -> Result[(), store.Error] waits {
    let options = result.unwrap(store.sized(Directory, 268435456))
    let mut db = store.open(tasks, d, c, r, options)?
    let mut schema = store.declare(db, Migrate)?
    let created = store.declare_table(mut schema, "items", std.codec.key_u64(), std.codec.of_u64())?
    let items = store.finish(mut schema, take created)?
    let single = store.declare_cell(mut schema, "cell", std.codec.of_u64())?
    let history = store.declare_log(mut schema, "history", std.codec.of_bytes(), Forever)?
    let _ = store.seal(mut db, take schema)?
    let seeded = store.run(mut db, None, items, fn(mut tx, t) -> Result[(), store.Error] {
        store.put(mut tx, t, 1u64, 11u64)?
        store.put(mut tx, t, 2u64, 22u64)
    })?
    law_describe_ticket(mut db, seeded)?
    let _ = store.checkpoint(mut db)?
    let cut = store.snapshot(db)
    let (child, forked) = store.fork(mut db, "child", cut)?
    store.durable(mut db, forked)?
    let child_write = store.run_on(mut db, child, None, items, fn(mut tx, t) -> Result[(), store.Error] {
        store.put(mut tx, t, 3u64, 33u64)
    })?
    law_describe_ticket(mut db, child_write)?
    if !mask_appends {
        let first = store.run(mut db, None, history, fn(mut tx, rows) -> Result[(), store.Error] {
            for _ in 0u64 .. 4 {
                let _ = store.append(mut tx, rows, b"x")?
            }
            Ok(())
        })?
        law_describe_ticket(mut db, first)?
    }
    let changed = store.run(mut db, None, (items, single, history, mask_appends), fn(mut tx, env) -> Result[(), store.Error] {
        store.put(mut tx, env.0, 1u64, 111u64)?
        let _ = store.delete(mut tx, env.0, 2u64)?
        store.cell_set(mut tx, env.1, 7u64)?
        if env.3 {
            for _ in 0u64 .. 4 {
                let _ = store.append(mut tx, env.2, b"x")?
            }
        }
        store.trim_before(mut tx, env.2, 18446744073709551615u64)?
        let n = if env.3 {
            8u64
        } else {
            4u64
        }
        for i in 0u64 .. n {
            // Stored Bytes has six bytes of schema and length framing.
            let width = if env.3 {
                1u64
            } else if i == 0 {
                82u64
            } else {
                90u64
            }
            let mut value: Bytes = list.with_capacity(width)
            list.fill(mut value, width, 1u8)
            let _ = store.append(mut tx, env.2, value)?
        }
        Ok(())
    })?
    law_describe_ticket(mut db, changed)?
    store.close(take db)?
    let prepared = store.prepare(d, c, Describe)?
    let observed: core.Cell[List[(u32, u64, u64)]] = cell.new(list.new())
    let described = store.describe_capture(take prepared, scoped fn(fact: store.DescribeLine) -> Result[(), store.Error] {
        if let DescribeCollection(row) = fact {
            cell.with(observed, (row.id, row.rows, row.charge), fn(mut rows, take found) {
                list.push(mut rows, found)
            })
        }
        Ok(())
    })?
    let reopened = store.open(tasks, d, c, r, options)?
    let oracle = store.snapshot(reopened)
    let entries = store.catalog_entries(oracle)?
    let rows = cell.into_inner(take observed)
    if described.head != store.version(oracle) {
        fail("Describe head differs from writer replay")
    }
    if list.len(rows) != list.len(entries) {
        fail("Describe catalog differs from writer replay")
    }
    for slot in 0u64 .. list.len(rows) {
        let item = entries[slot]
        if rows[slot] != (item.id, item.rows, item.charge) {
            fail("Describe collection differs from writer replay")
        }
    }
    store.close(take reopened)
}

@test
fn describe_matches_open(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), store.Error] waits {
    let mut name = string.with_capacity(64)
    string.push(mut name, "capture-a-")
    let a = result.unwrap(host.mkdtemp(d, mut name))
    law_describe_matches_case(a, c, r, tasks, false)?
    string.clear(mut name)
    string.push(mut name, "capture-b-")
    let b = result.unwrap(host.mkdtemp(d, mut name))
    law_describe_matches_case(b, c, r, tasks, true)
}

// T13: persisted scrub-round history appears in `hirsel store stats` with the
// exact operator receipt line `last complete round: versions a..b, N bytes, E errors`.
@test
fn stats_prints_persisted_scrub_round(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), store.Error] waits {
    let mut name = string.with_capacity(64)
    string.push(mut name, "scrub-stats-")
    let dir = result.unwrap(host.mkdtemp(d, mut name))
    let options = result.unwrap(store.sized(Directory, 268435456))
    let mut db = store.open(tasks, dir, c, r, options)?
    let mut schema = store.declare(db, Migrate)?
    let created = store.declare_table(mut schema, "items", std.codec.key_u64(), std.codec.of_u64())?
    let items = store.finish(mut schema, take created)?
    let _ = store.seal(mut db, take schema)?
    let wrote = store.run(mut db, None, items, fn(mut tx, t) -> Result[(), store.Error] {
        for k in 0u64 .. 20u64 {
            store.put(mut tx, t, k, k * 3u64)?
        }
        Ok(())
    })?
    law_describe_ticket(mut db, wrote)?
    let _ = store.checkpoint(mut db)?
    let cfg = store.ScrubConfig(target_ms: 10000u64, max_rate_bps: 1000000u64, slice_bytes: 65536u64, min_rate_bps: 100000u64)
    let mut pacer = store.begin_scrub_pacer(db, cfg, 1000u64)?
    let mut now = 1000u64
    let mut completed_round: Option[store.ScrubRound] = None
    while let None = completed_round {
        let step = store.scrub_pacer_step(mut pacer, mut db, now)?
        if let Some(round) = step.completed {
            completed_round = Some(round)
        } else {
            now = step.status.next_due_ms
        }
    }
    let Some(round) = completed_round else {
        fail("paced scrub did not finish")
    }
    store.close(take db)?
    let prepared = store.prepare(dir, c, Describe)?
    let rendered: core.Cell[Option[String]] = cell.new(None)
    let _ = store.describe_capture(take prepared, scoped fn(fact: store.DescribeLine) -> Result[(), store.Error] {
        if let DescribeScrubRound(found) = fact {
            cell.with(rendered, format_scrub_round(found), fn(mut slot: Option[String], take line: String) {
                slot = Some(take line)
            })
        }
        Ok(())
    })?
    let mut expected = string.from("last complete round: versions ")
    string.push_u64(mut expected, round.start_version)
    string.push(mut expected, "..")
    string.push_u64(mut expected, round.end_version)
    string.push(mut expected, ", ")
    string.push_u64(mut expected, round.examined)
    string.push(mut expected, " bytes, 0 errors")
    if cell.into_inner(take rendered) != Some(expected) {
        fail("store stats scrub round line differed from persisted round")
    }
    Ok(())
}

// The adoption receipt is operator input. A parent at the selected version has
// the right rows and release, but no fresh-child provenance in its manifest.
@test
fn test_la9_adoption_checks_restore_origin(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), store.Error] waits {
    let mut src_name = string.with_capacity(64)
    string.push(mut src_name, "la9-")
    let src = result.unwrap(host.mkdtemp(d, mut src_name))
    let mut captured_name = string.with_capacity(64)
    string.push(mut captured_name, "la9-")
    let captured = result.unwrap(host.mkdtemp(d, mut captured_name))
    let mut child_name = string.with_capacity(64)
    string.push(mut child_name, "la9-")
    let child = result.unwrap(host.mkdtemp(d, mut child_name))
    let mut opts = result.unwrap(store.sized(Directory, 268435456))
    opts.create = true
    let mut parent = store.open(tasks, src, c, r, opts)?
    let nonce = b"abcdefghijklmnop"
    let lease = result.unwrap(store.begin_backup(mut parent, captured, clone(nonce)))
    let _ = result.unwrap(store.export_copy(take lease))
    store.release_export(mut parent, nonce)
    let genuine = result.unwrap(store.restore(tasks, captured, child, c, r, opts, Latest,[42; 16]))
    let parent_id = store.snapshot_identity(store.snapshot(parent))
    let mut forged: store.Restored = clone(genuine)
    forged.child = parent_id
    match runner.verified_restored_child(parent, take forged) {
        Error(Foreign) => (),
        _ => fail("an identity-preserving copy passed adoption"),
    }
    store.close(take parent)?
    let reopened = store.open(tasks, child, c, r, opts)?
    let mut wrong: store.Restored = clone(genuine)
    wrong.attempt[0] = 0
    match runner.verified_restored_child(reopened, take wrong) {
        Error(Foreign) => (),
        _ => fail("an unrelated attempt passed adoption"),
    }
    let _ = runner.verified_restored_child(reopened, take genuine)?
    store.close(take reopened)
}

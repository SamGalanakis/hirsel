    if law_abort_budget(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn look_query(tx: Tx, sh: Table[u64, u64], ix: Index[u64, u64, u64, ()]) -> Result[u64, Error] {
    let a = option.unwrap(fetch(tx, sh, 1)?)
    let absent = fetch(tx, sh, 9)?
    if let Some(_) = absent {
        return Error(Missing("law"))
    }
    let mut rows = range(tx, sh, Excluded(1), Included(3))?
    let mut sum = a
    while let Some((_, v)) = next_in(tx, mut rows)? {
        sum += v
    }
    let mut matches = lookup(tx, ix, Included(2), Included(2))?
    while let Some((_, v)) = next_indexed(mut matches)? {
        sum += v
    }
    Ok(sum)
}

// L22: 10 + (20+30) + (10+30) = 100. The complete index read logs its terminal gap.
// Wrong implementations: look publishes, omits reads or reports another version.
pub fn law_look(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "look", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut db, "look", std.codec.key_u64(), std.codec.of_u64()))
    for k in 1u64 .. 4 {
        if !typed_put(mut db, t, k, k * 10) {
            return false
        }
    }
    let (_, ix) = result.unwrap(law_indexed(mut db, "look", std.codec.key_u64(), std.codec.of_u64(), "bucket", code.describe(bucket), std.codec.key_u64()))
    let sh = view t
    let s = snapshot(db)
    let head = pages.holder_heads(db.holders)[0].head
    let live_bytes = db.resident
    let high_water = pages.holder_next_node(db.holders)
    let end = file_end(db)
    let observed = result.unwrap(look(result.unwrap(reader(db, 0u64)), s, None, (copy_env(ix), copy_env(sh)), fn(tx, call_env) -> Result[u64, Error] {
        look_query(tx, call_env.1, call_env.0)
    }))
    let got = match take observed {
        Seen(take x) => take x,
        _ => return false
    }
    match got.value {
        Ok(100) => {},
        _ => return false
    }
    if got.version != head || pages.holder_heads(db.holders)[0].head != head || db.resident != live_bytes || pages.holder_next_node(db.holders) != high_water || file_end(db) != end {
        return false
    }
    let mut expected: List[Read] = list.new()
    list.push(mut expected, Point(law_read_key(t.id, 1, None)))
    list.push(mut expected, Point(law_read_key(t.id, 9, None)))
    // [table1 || key1 || 00, table1 || key3 || 00) includes precisely 2 and 3.
    let mut low = law_read_key(t.id, 1, None)
    list.push(mut low, 0u8)
    let mut high = law_read_key(t.id, 3, None)
    list.push(mut high, 0u8)
    let mut middle = law_read_key(t.id, 2, None)
    list.push(mut middle, 0u8)
    list.push(mut expected, Span(take low, clone(middle)))
    list.push(mut expected, Span(take middle, take high))
    let mut next_low = law_read_key(ix.id, 2, None)
    law_bucket_two_row(mut expected, mut next_low, t.id, ix.id, 1)
    law_bucket_two_row(mut expected, mut next_low, t.id, ix.id, 3)
    list.push(mut expected, Span(take next_low, law_read_key(ix.id, 3, None)))
    if !equal_reads(got.reads, expected) {
        return false
    }
    let run_result = run(mut db, None, (copy_env(ix), copy_env(sh)), fn(mut tx, call_env) -> Result[u64, Error] {
        look_query(tx, call_env.1, call_env.0)
    })
    match take run_result {
        Ok(Committed(done)) => if done.value != 100 || !equal_reads(done.reads, got.reads) {
            return false
        },
        _ => return false
    }
    if !typed_put(mut db, t, 1, 14) {
        return false
    }
    let second = result.unwrap(look(result.unwrap(reader(db, 0u64)), snapshot(db), None, (copy_env(ix), copy_env(sh)), fn(tx, call_env) -> Result[u64, Error] {
        look_query(tx, call_env.1, call_env.0)
    }))
    let Seen(value) = second else {
        return false
    }
    let Ok(108) = view value.value else {
        return false
    }
    if value.version != pages.holder_heads(db.holders)[0].head || !equal_reads(value.reads, expected) {
        return false
    }
    law_lookup_top_one(mut db, t, ix)
}

fn has_failure(cs: Causes, message: String) -> bool {
    for cause in cs {
        if let Fail(text) = cause.kind {
            if text == message {
                return true
            }
        }
    }
    false
}

// L22: faults and Capacity are contained. info requires mut Tx (v2.4 G2).
pub fn law_look_faults(c: Clock) -> bool waits {
    let db = test_db(c, 1073741824)
    let s = snapshot(db)
    let read = result.unwrap(reader(db, 0u64))
    for i in 0u64 .. 2 {
        let message = if i == 0 {
            "look body fault"
        } else {
            "another query fault"
        }
        let failed = result.unwrap(look(read, s, None, message, fn(tx, call_env) -> u64 {
            fail(string.from(call_env))
        }))
        match take failed {
            Failed(take cs, reads) => if list.len(reads) != 0 || !has_failure(cs, message) {
                return false
            },
            _ => return false
        }
        let expected = if i == 0 {
            7u64
        } else {
            19u64
        }
        let observed = result.unwrap(result.unwrap(bound bytes LAW_EMPTY_DRAFT_BYTES {
            look(read, s, None, expected, fn(tx, call_env) -> u64 {
                call_env
            })
        }))
        match take observed {
            Seen(value) => if value.value != expected || value.version != 0 || list.len(value.reads) != 0 {
                return false
            },
            _ => return false
        }
    }
    // One byte below the isolate's entry cost refuses its cause cell.
    let refused_query = result.unwrap(bound bytes (LAW_ISOLATE_ENTRY_BYTES - 1) {
        look(read, s, None, (), fn(tx, unused_env) -> u64 {
            7u64
        })
    })
    match take refused_query {
        Ok(Refused(Allocation(cap), reads)) => list.len(reads) == 0 && cap.requested == 32 && cap.available == 31 && pages.holder_heads(db.holders)[0].head == 0 && db.resident == 0,
        _ => false
    }
}

fn check_delta(a: Snapshot, b: Snapshot, before: List[u64], after: List[u64]) -> bool waits {
    let delta = result.unwrap(changes(law_reader(a), a, b)).rows
    let mut at: u64 = 0
    for k in 0u64 .. list.len(before) {
        if before[k] != after[k] {
            if at == list.len(delta) {
                return false
            }
            if delta[at].tree_key != result.unwrap(failure_result_from_rep(catalog.logical_key(1, types.key_word(k)))) {
                return false
            }
            let good = match delta[at].value {
                None => after[k] == 0,
                Some(raw) => list.slice(raw, 0, list.len(raw)) == types.key_word(after[k]) && after[k] != 0
            }
            if !good {
                return false
            }
            at += 1
        }
    }
    at == list.len(delta)
}

// L23: independent 160-slot model, split/merged leaves, added and deleted roots,
// reverse comparison, branch/open boundaries and unchanged roots under bound0.
// Wrong implementations: scan equal roots, omit None, confuse branch with open.
pub fn law_changes(c: Clock) -> bool waits {
    let mut db = raw_test_db(c, 1073741824)
    let empty = snapshot(db)
    let mut zeros: List[u64] = list.with_capacity(160)
    list.fill(mut zeros, 160, 0u64)
    let mut before: List[u64] = list.with_capacity(160)
    list.fill(mut before, 160, 0u64)
    for k in 0u64 .. 96 {
        if !put_one(mut db, k, k + 1) {
            return false
        }
        let _ = list.set(mut before, k, k + 1)
    }
    let a = snapshot(db)
    let after_copy: List[u64] = clone(before)
    let mut after = take after_copy
    for operation in 0u64 .. 48 {
        let k = (operation * 37) % 160
        let v = if operation % 2 == 0 {
            0u64
        } else {
            operation + 1000
        }
        let outcome = execute(mut db, 0, operation, None, fn(mut tx: Tx) -> Result[(), Error] {
            if v == 0 {
                let _ = delete_bytes(mut tx, 1, types.key_word(k))?
            } else {
                put_bytes(mut tx, 1, types.key_word(k), types.key_word(v))?
            }
            Ok(())
        })
        match take outcome {
            Ok(Committed(_)) => {},
            _ => return false
        }
        let _ = list.set(mut after, k, v)
    }
    let b = snapshot(db)
    if !check_delta(empty, a, zeros, before) || !check_delta(a, empty, before, zeros) || !check_delta(a, b, before, after) || !check_delta(b, a, after, before) {
        return false
    }
    let read = result.unwrap(reader(db, 0u64))
    let same_root = result.unwrap(bound bytes 0 {
        changes(read, b, b)
    })
    match take same_root {
        Ok(delta) => if list.len(delta.rows) != 0 {
            return false
        },
        _ => return false
    }
    let other_branch = Snapshot(store: b.store, open: b.open, branch: 9, head: b.head, roots: pages.share_roots(b.roots), watermark: 1, bases: pages.no_tail_bases())
    if !check_delta(a, other_branch, before, after) {
        return false
    }
    let other_open = Snapshot(store: b.store, open: 1, branch: 0, head: b.head, roots: pages.share_roots(b.roots), watermark: 1, bases: pages.no_tail_bases())
    if !is_foreign(changes(law_reader(a), a, other_open)) {
        return false
    }
    let foreign = raw_test_db(c, 1073741824)
    let other_store = Snapshot(store: StoreId(hi: 9, lo: 9), open: 0, branch: 0, head: pages.holder_heads(foreign.holders)[0].head, roots: pages.share_roots(pages.holder_heads(foreign.holders)[0].roots), watermark: 1, bases: pages.no_tail_bases())
    if !is_foreign(changes(law_reader(a), a, other_store)) {
        return false
    }
    // R1: the diff's own allocation is refused under a zero bound and raises
    // Capacity; changes has no refusal value of its own.
    let no_room = isolate(fn() -> Result[Result[Changes, Error], Capacity] {
        bound bytes 0 {
            compare_page_collections(a.roots.collections, b.roots.collections)
        }
    })
    match take no_room {
        Ok(Error(causes)) => match manifest.raised_capacity(causes) {
            Some(_) => true,
            None => false
        },
        _ => false
    }
}

// A change can keep a large value within a budget that cannot copy it.
pub fn law_shared_changes(c: Clock) -> bool waits {
    let mut db = raw_test_db(c, 1073741824)
    let before = snapshot(db)
    let outcome = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[(), Error] {
        let mut payload: Bytes = list.with_capacity(8192)
        list.fill(mut payload, 8192, 51u8)
        put_bytes(mut tx, 1, types.key_word(7), payload)
    })
    if let Ok(Committed(_)) = outcome {} else {
        return false
    }
    let after = snapshot(db)
    let low = result.unwrap(failure_result_from_rep(catalog.prefix(1)))
    let high = result.unwrap(failure_result_from_rep(catalog.prefix(2)))
    let delta = result.unwrap(result.unwrap(bound bytes 4096 {
        changes(result.unwrap(reader(db, 0u64)), before, after)
    })).rows
    let rows = result.unwrap(result.unwrap(bound bytes 4096 {
        span_changes(result.unwrap(reader(db, 0u64)), after, low, high)
    }))
    if !same_rows(rows, delta, 0, 1) || list.len(delta) != 1 {
        return false
    }
    match delta[0].value {
        Some(payload) => list.len(payload) == 8192 && payload[0] == 51 && payload[8191] == 51,
        None => false
    }
}

@test
fn test_shared_changes(c: Clock) -> Result[(), ()] {
    if law_shared_changes(c) {
        Ok(())
    } else {
        Error(())
    }
}


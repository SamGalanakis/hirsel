// Shared admission for transports. Only this task owns cross-connection policy.
pub type Config: send { buckets_max: u64, inbox: u64, sessions: u64, mint_burst: u64, mint_window_ns: u64, call_burst: u64, call_period_ns: u64 }

pub fn defaults() -> Config {
    Config(buckets_max: 8192u64, inbox: 256u64, sessions: 32u64, mint_burst: 10u64, mint_window_ns: 60000000000u64, call_burst: 40u64, call_period_ns: 50000000u64)
}

type Bucket: send { at: u64, credit: u64 }

fn refill(b: Bucket, now: u64, cap: u64) -> Bucket {
    let elapsed = if now > b.at { now - b.at } else { 0u64 }
    let credit = if elapsed >= cap - b.credit { cap } else { b.credit + elapsed }
    Bucket(at: if now > b.at { now } else { b.at }, credit: credit)
}

fn take_credit(mut b: Bucket, now: u64, burst: u64, period: u64) -> bool {
    b = refill(b, now, burst * period)
    if b.credit < period { return false }
    b.credit -= period
    true
}

pub opaque resource type Lease: send { returned: Sender[()] } drop(lease) {
    let _ = channel.try_send(lease.returned, ())
}

pub opaque type Principal: send { token: Bytes }

pub fn principal(p: Principal) -> View[Bytes] in p { view p.token }

type Source: send { mints: List[u64], mint_head: u64, mint_count: u64, free: u64, returned: Receiver[()], to: Sender[()] }
type Book: send { config: Config, sources: Map[Bytes, Source], calls: Map[Bytes, Bucket], source_order: Deque[Bytes], call_order: Deque[Bytes] }

fn retirement_ring(count: u64) -> Result[Deque[Bytes], Capacity] {
    let mut ring: Deque[Bytes] = deque.new()
    // Reserve the fixed ring before the policy task accepts any asks.
    for _ in 0u64 .. count {
        if let Error((c, _)) = deque.push_back(mut ring, list.new()) { return Error(c) }
    }
    for _ in 0u64 .. count { let _ = deque.pop_front(mut ring) }
    Ok(take ring)
}

fn new_book(config: Config) -> Result[Book, Capacity] {
    let sources = retirement_ring(config.buckets_max)?
    let calls = retirement_ring(config.buckets_max)?
    Ok(Book(config: config, sources: map.new(), calls: map.new(), source_order: take sources, call_order: take calls))
}

type Kind: send = Open(Bytes) | Hello(Bytes, Option[Bytes]) | Call(Bytes)
type Answer: send = Opened(Lease) | Bound(Principal) | Allowed | RejectedPolicy

type Ask: send { kind: Kind, reply: Sender[Answer] }
pub opaque type Ingress: send { to: Sender[Ask] }
type Policy: send { from: Receiver[Ask], book: Book, clock: Clock, random: Random }

fn source_key(ip: Ip) -> Bytes {
    let mut b: Bytes = list.new()
    match ip {
        V4(v) => { result.unwrap(std.codec.put_u32(4u32, mut b)); result.unwrap(std.codec.put_u32(v, mut b)) },
        V6(a, z) => { result.unwrap(std.codec.put_u32(6u32, mut b)); result.unwrap(std.codec.put_u64(a, mut b)); result.unwrap(std.codec.put_u64(z, mut b)) },
    }
    b
}

fn collect(mut s: Source) {
    for _ in 0u64 .. 32u64 {
        match channel.try_receive(s.returned) { Ok(()) => { s.free += 1u64 }, _ => break }
    }
}

// Rust VecDeque's rotating ring bounds maintenance to one key of each kind.
// Busy sources and non-full buckets return to the ring; only debt-free keys retire.
fn retire(mut book: Book, now: u64) {
    let c = book.config
    if let Some(take key) = deque.pop_front(mut book.call_order) {
        let full = match map.get(book.calls, key) { Some(b) => refill(b, now, c.call_burst * c.call_period_ns).credit == c.call_burst * c.call_period_ns, _ => fail("ingress: retirement key") }
        if full {
            let _ = map.remove(mut book.calls, key)
        } else { result.unwrap(deque.push_back(mut book.call_order, take key)) }
    }
    if let Some(take key) = deque.pop_front(mut book.source_order) {
        let mut s = option.unwrap(map.remove(mut book.sources, key))
        collect(mut s)
        prune_mints(mut s, now, c.mint_window_ns, c.mint_burst)
        if s.free != c.sessions || s.mint_count != 0u64 {
            result.unwrap(map.insert(mut book.sources, result.unwrap(clone(key)), take s))
            result.unwrap(deque.push_back(mut book.source_order, take key))
        }
    }
}

fn ensure_source(mut book: Book, key: Bytes, now: u64) -> bool {
    if map.contains(book.sources, key) { return true }
    let c = book.config
    if map.len(book.sources) >= c.buckets_max { retire(mut book, now) }
    if map.len(book.sources) >= c.buckets_max { return false }
    let made: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(c.sessions)
    let (to, returned) = match take made { Ok(take pair) => take pair, Error(_) => return false }
    let allocated: Result[List[u64], Capacity] = list.with_capacity(c.mint_burst)
    let mints = match take allocated { Ok(take times) => take times, Error(_) => return false }
    let source = Source(mints: take mints, mint_head: 0u64, mint_count: 0u64, free: c.sessions, returned: take returned, to: take to)
    if let Error(_) = map.insert(mut book.sources, result.unwrap(clone(key)), take source) { return false }
    if let Error(_) = deque.push_back(mut book.source_order, result.unwrap(clone(key))) {
        let _ = map.remove(mut book.sources, key)
        return false
    }
    true
}

fn open_source(mut book: Book, key: Bytes, now: u64) -> Answer {
    if !ensure_source(mut book, key, now) { return RejectedPolicy }
    let mut s = option.unwrap(map.remove(mut book.sources, key))
    collect(mut s)
    let answer = if s.free == 0u64 { RejectedPolicy } else {
        match Lease(returned: channel.sender(s.to)) {
            Ok(take lease) => { s.free -= 1u64; Opened(take lease) },
            Error(_) => RejectedPolicy,
        }
    }
    result.unwrap(map.insert(mut book.sources, result.unwrap(clone(key)), take s))
    answer
}

fn valid_token(b: Bytes) -> bool {
    list.len(b) == 21u64 && b[0u64] == 97u8 && b[1u64] == 110u8 && b[2u64] == 111u8 && b[3u64] == 110u8 && b[4u64] == 58u8
}

fn bind(mut book: Book, key: Bytes, take token: Option[Bytes], now: u64, random: Random) -> Answer {
    if let Some(take b) = take token {
        return if valid_token(b) { Bound(Principal(token: take b)) } else { RejectedPolicy }
    }
    if !ensure_source(mut book, key, now) { return RejectedPolicy }
    let c = book.config
    let allowed = option.unwrap(map.update(mut book.sources, key, scoped fn(mut s: Source) -> bool {
        prune_mints(mut s, now, c.mint_window_ns, c.mint_burst)
        if s.mint_count >= c.mint_burst { false } else {
            let index = (s.mint_head + s.mint_count) % c.mint_burst
            if index < list.len(s.mints) { s.mints[index] = now } else {
                if let Error(_) = list.push(mut s.mints, now) { return false }
            }
            s.mint_count += 1u64
            true
        }
    }))
    if !allowed { return RejectedPolicy }
    let mut nonce: Bytes = result.unwrap(list.with_capacity(16u64))
    host.random(random, mut nonce)
    let mut token_bytes: Bytes = result.unwrap(list.with_capacity(21u64))
    result.unwrap(list.append(mut token_bytes, string.as_bytes("anon:")))
    result.unwrap(list.append(mut token_bytes, nonce))
    Bound(Principal(token: take token_bytes))
}

fn call_allowed(mut book: Book, key: Bytes, now: u64) -> bool {
    let c = book.config
    if !map.contains(book.calls, key) {
        if map.len(book.calls) >= c.buckets_max { retire(mut book, now) }
        if map.len(book.calls) >= c.buckets_max { return false }
        if let Error(_) = map.insert(mut book.calls, result.unwrap(clone(key)), Bucket(at: now, credit: c.call_burst * c.call_period_ns)) { return false }
        if let Error(_) = deque.push_back(mut book.call_order, result.unwrap(clone(key))) {
            let _ = map.remove(mut book.calls, key)
            return false
        }
    }
    option.unwrap(map.update(mut book.calls, key, scoped fn(mut b: Bucket) -> bool { take_credit(mut b, now, c.call_burst, c.call_period_ns) }))
}

fn policy(take p: Policy) -> () waits {
    let Policy(from: take from, book: take initial, clock: clock, random: random) = take p
    let mut book = take initial
    while let Ok(take ask) = channel.receive(from) {
        let now = host.mono_ns(clock)
        retire(mut book, now)
        let Ask(kind: take kind, reply: take reply) = take ask
        let answer = match take kind {
            Open(key) => open_source(mut book, key, now),
            Hello(key, take token) => bind(mut book, key, take token, now, random),
            Call(key) => if call_allowed(mut book, key, now) { Allowed } else { RejectedPolicy },
        }
        let _ = channel.try_send(reply, take answer)
    }
}

pub fn start(tasks: Tasks, clock: Clock, random: Random, config: Config, n_policy: u64) -> Result[(Ingress, Task[()]), Capacity] {
    if config.buckets_max == 0u64 || config.buckets_max > 8192u64 || config.inbox == 0u64 || config.inbox > 256u64 || config.sessions == 0u64 || config.mint_burst == 0u64 || config.call_burst == 0u64 || config.mint_window_ns == 0u64 || config.call_period_ns == 0u64 || config.call_burst > 0xffffffffffffffffu64 / config.call_period_ns {
        return Error(Capacity(requested: 1u64, available: 0u64))
    }
    let (to, from): (Sender[Ask], Receiver[Ask]) = channel.new(config.inbox)?
    let p = Policy(from: take from, book: new_book(config)?, clock: clock, random: random)
    match task.spawn(tasks, bytes n_policy, take p, policy) {
        Ok(take h) => Ok((Ingress(to: take to), take h)),
        Error((c, _)) => Error(c),
    }
}

fn decide(i: Ingress, take kind: Kind) -> Answer waits {
    let made: Result[(Sender[Answer], Receiver[Answer]), Capacity] = channel.new(1u64)
    let (reply, from) = match take made { Ok(take pair) => take pair, Error(_) => return RejectedPolicy }
    if let Error(_) = channel.try_send(i.to, Ask(kind: take kind, reply: take reply)) { return RejectedPolicy }
    match channel.receive(from) { Ok(take a) => take a, Error(_) => RejectedPolicy }
}

pub fn open(i: Ingress, source: Ip) -> Option[Lease] waits {
    match decide(i, Open(source_key(source))) { Opened(take lease) => Some(take lease), _ => None }
}

pub fn hello(i: Ingress, source: Ip, take token: Option[Bytes]) -> Option[Principal] waits {
    if let Some(b) = token { if !valid_token(b) { return None } }
    match decide(i, Hello(source_key(source), take token)) { Bound(take p) => Some(take p), _ => None }
}

pub fn call(i: Ingress, p: Principal) -> bool waits {
    match decide(i, Call(result.unwrap(clone(p.token)))) { Allowed => true, _ => false }
}

pub fn law_limits(random: Random) -> bool {
    let mut c = defaults()
    c.buckets_max = 2u64
    c.sessions = 2u64
    let mut book = result.unwrap(new_book(c))
    let source = source_key(V4(0x7f000001u32))
    let a = match open_source(mut book, source, 0u64) { Opened(take l) => take l, _ => return false }
    let b = match open_source(mut book, source, 0u64) { Opened(take l) => take l, _ => return false }
    if let RejectedPolicy = open_source(mut book, source, 600000000000u64) {} else { return false }
    let _ = take a
    let returned = match open_source(mut book, source, 600000000000u64) { Opened(take l) => take l, _ => return false }
    for _ in 0u64 .. 10u64 {
        if let Bound(_) = bind(mut book, source, None, 600000000000u64, random) {} else { return false }
    }
    if let RejectedPolicy = bind(mut book, source, None, 600000000000u64, random) {} else { return false }
    if let RejectedPolicy = bind(mut book, source, Some(list.new()), 600000000000u64, random) {} else { return false }
    if let RejectedPolicy = bind(mut book, source, None, 606000000000u64, random) {} else { return false }
    if let Bound(_) = bind(mut book, source, None, 660000000000u64, random) {} else { return false }
    let other = source_key(V4(0x7f000002u32))
    for _ in 0u64 .. 5u64 { if let Bound(_) = bind(mut book, other, None, 700000000000u64, random) {} else { return false } }
    for _ in 0u64 .. 5u64 { if let Bound(_) = bind(mut book, other, None, 730000000000u64, random) {} else { return false } }
    for _ in 0u64 .. 5u64 { if let Bound(_) = bind(mut book, other, None, 760000000000u64, random) {} else { return false } }
    if let RejectedPolicy = bind(mut book, other, None, 760000000000u64, random) {} else { return false }
    true
}

pub fn law_rates_and_expiry() -> bool {
    let mut c = defaults()
    c.buckets_max = 2u64
    let mut book = result.unwrap(new_book(c))
    let a = source_key(V4(1u32))
    let b = source_key(V4(2u32))
    let other = source_key(V4(3u32))
    for _ in 0u64 .. 40u64 { if !call_allowed(mut book, a, 0u64) { return false } }
    if call_allowed(mut book, a, 0u64) { return false }
    if !call_allowed(mut book, b, 0u64) { return false }
    if call_allowed(mut book, other, 0u64) { return false }
    // Only b is full here. Inserting another key must not erase a's debt.
    if !call_allowed(mut book, other, 50000000u64) { return false }
    if !call_allowed(mut book, a, 50000000u64) { return false }
    if call_allowed(mut book, a, 50000000u64) { return false }
    if map.len(book.calls) != 2u64 { return false }
    // Backwards arrivals cannot refund credit or move a bucket's clock back.
    if call_allowed(mut book, a, 0u64) { return false }
    for _ in 0u64 .. 40u64 { if !call_allowed(mut book, a, 2050000000u64) { return false } }
    !call_allowed(mut book, a, 2050000000u64)
}

pub fn law_reply_isolated(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut c = defaults()
    c.call_period_ns = 60000000000u64
    let (i, take handle) = result.unwrap(start(tasks, clock, random, c, 1048576u64))
    let mut h = take handle
    let a = match hello(i, V4(1u32), None) { Some(take p) => take p, _ => return false }
    let token: Bytes = result.unwrap(clone(principal(a)))
    let b = match hello(i, V4(2u32), Some(take token)) { Some(take p) => take p, _ => return false }
    let same = principal(a) == principal(b)
    let mut allowed = true
    for _ in 0u64 .. 20u64 { allowed = call(i, a) && call(i, b) && allowed }
    let denied = !call(i, a)
    task.cancel(mut h)
    let _ = task.join(take h)
    same && allowed && denied
}

@test
fn test_ingress(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_limits(random) && law_rates_and_expiry() && law_retirement_steps(random) && law_reply_isolated(tasks, clock, random) { Ok(()) } else { Error(()) }
}


pub fn share(i: Ingress) -> Ingress { Ingress(to: channel.sender(i.to)) }

pub fn share_principal(p: Principal) -> Result[Principal, Capacity] {
    let copied: Bytes = clone(p.token)?
    Ok(Principal(token: take copied))
}


// Minting has a strict rolling-minute bound, unlike calls' explicit burst/rate.
fn prune_mints(mut s: Source, now: u64, window: u64, burst: u64) {
    for _ in 0u64 .. 10u64 {
        if s.mint_count == 0u64 { break }
        let first = s.mints[s.mint_head]
        if now < first || now - first < window { break }
        s.mint_head = (s.mint_head + 1u64) % burst
        s.mint_count -= 1u64
    }
}


pub fn law_retirement_steps(random: Random) -> bool {
    let mut c = defaults()
    c.buckets_max = 4u64
    c.sessions = 1u64
    let mut state = result.unwrap(new_book(c))
    for i in 1u32 .. 5u32 { if !call_allowed(mut state, source_key(V4(i)), 0u64) { return false } }
    // All four are now full. One maintenance step removes exactly one, not a pass.
    retire(mut state, c.call_period_ns)
    if map.len(state.calls) != 3u64 || deque.len(state.call_order) != 3u64 { return false }
    // A backwards read cannot retire any remaining debt, and the cursor still moves.
    retire(mut state, 0u64)
    if map.len(state.calls) != 3u64 || deque.len(state.call_order) != 3u64 { return false }
    for _ in 0u64 .. 3u64 { retire(mut state, c.call_period_ns) }
    if map.len(state.calls) != 0u64 || deque.len(state.call_order) != 0u64 { return false }
    let source = source_key(V4(1u32))
    let lease = match open_source(mut state, source, 0u64) { Opened(take l) => take l, _ => return false }
    retire(mut state, 600000000000u64)
    if map.len(state.sources) != 1u64 || deque.len(state.source_order) != 1u64 { return false }
    if let RejectedPolicy = open_source(mut state, source, 600000000000u64) {} else { return false }
    let _ = take lease
    retire(mut state, 600000000000u64)
    if map.len(state.sources) != 0u64 || deque.len(state.source_order) != 0u64 { return false }
    // Performance fixtures may raise the configured quotas. Maintenance stays bounded.
    c.sessions = 64u64
    c.mint_burst = 20u64
    let mut larger = result.unwrap(new_book(c))
    let mut leases: List[Lease] = list.new()
    for _ in 0u64 .. 64u64 {
        let opened = match open_source(mut larger, source, 0u64) { Opened(take l) => take l, _ => return false }
        result.unwrap(list.push(mut leases, take opened))
    }
    for _ in 0u64 .. 20u64 { if let Bound(_) = bind(mut larger, source, None, 0u64, random) {} else { return false } }
    if let RejectedPolicy = bind(mut larger, source, None, 0u64, random) {} else { return false }
    let _ = take leases
    retire(mut larger, c.mint_window_ns)
    let partial = match map.get(larger.sources, source) { Some(s) => s.free == 32u64 && s.mint_count == 10u64, _ => false }
    if !partial { return false }
    retire(mut larger, c.mint_window_ns)
    if map.len(larger.sources) != 0u64 { return false }
    // Wrap the timestamp ring after one rolling-window half expires.
    for _ in 0u64 .. 10u64 { if let Bound(_) = bind(mut larger, source, None, 70000000000u64, random) {} else { return false } }
    for _ in 0u64 .. 10u64 { if let Bound(_) = bind(mut larger, source, None, 100000000000u64, random) {} else { return false } }
    for _ in 0u64 .. 10u64 { if let Bound(_) = bind(mut larger, source, None, 130000000000u64, random) {} else { return false } }
    if let RejectedPolicy = bind(mut larger, source, None, 130000000000u64, random) { true } else { false }
}

// L68 jwt_no_token_at_rest (RUNNER-SPEC §15.10) on L31's disk harness. The host mints a fresh
// openssl key and token per run and passes the JWKS document and the token; after two bound
// calls and a checkpoint it searches every store file for the token's payload and signature
// segments, the key's x and y and a marker claim.
// The place's bind G (RUNNER-SPEC v2.70): the verifier's grant, which its bind mint shares.
type JwtGrant: send {
    jwt: jwtbind.Grant
}

fn jwt_bind_mint(s: JwtGrant, _h: (), _bind: ()) -> Result[JwtGrant, Capacity] {
    Ok(JwtGrant(jwt: jwtbind.share(s.jwt)))
}

// The crash place's entries, on a place whose G is the bind G.
fn jwt_place(mut r: runner.Registry[JwtGrant, Hd]) -> Result[(), runner.RegisterError] {
    runner.transact(mut r, code.describe(bump), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(deny), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(trip), 65536u64, runner.DEFAULT_STEPS)
}

fn jwt_bound(g: JwtGrant, credential: Bytes) -> Result[runner.BoundCaller, runner.BindRefusal] {
    jwtbind.bind(g.jwt, credential)
}

type JwtClient: send {
    tasks: Tasks,
    net: Net,
    clock: Clock,
    random: Random,
    head: Sender[runner.HeadInput],
    post: Sender[runner.PubIn],
    wire: Option[runner.BindGrant[JwtGrant]],
    token: Bytes
}

fn jwt_client(take d: JwtClient) -> String waits {
    let JwtClient(tasks: tasks, net: n, clock: c, random: r, head: take head, post: take post, wire: take session_wire, token: take token) = take d
    let mut keys: List[Bytes] = list.new()
    list.push(mut keys, body_key(0u64))
    let mut config = runner.wire_defaults(524288u64)
    config.q = 1u64
    config.budget = 65536u64
    config.socket.max_frame = 32768u64
    let no_grants: Option[runner.CallGrant[JwtGrant]] = None
    let pair = runner.wire_client.pair_config(tasks, n, c, r, take session_wire, take no_grants, head, post, code.describe(jwt_place), keys, Some(take token), config, 2097152u64)
    let (take wire, take server) = match take pair {
        Ok(take connected) => take connected,
        Error(Allocation(_)) => return "L68: client allocation refused",
        Error(Network(Denied)) => return "L68: loopback grant refused",
        Error(Network(_)) => return "L68: loopback connection failed",
        Error(_) => return "L68: the JWT was not bound",
    }
    let _ = take head
    let birth = host.wall_ms(c)
    let mut answered = true
    for p in 0u64 .. 2u64 {
        runner.wire_client.send_frame(wire, Call(store.StreamId(t: birth, n: 7u64), p, 0u32, 5000u32, u64_bytes(p)))
        let ok = match runner.wire_client.next(wire) {
            Ok(Batch(_, _, _, ds)) => list.len(ds) == 1u64 && ds[0u64].stream == store.StreamId(t: birth, n: 7u64) && ds[0u64].p == p && same(ds[0u64].outcome, returned(Ok(p))),
            _ => false,
        }
        answered = answered && ok
    }
    let closed = runner.wire_client.close(take wire)
    let joined = match task.join(take server) {
        Ok(Ok(())) => true,
        _ => false
    }
    if !answered {
        return "L68: calls did not return"
    }
    if !closed || !joined {
        return "L68: connection did not close"
    }
    ""
}

pub fn no_jwt_at_rest(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, n: Net) -> Result[(), Exit] waits {
    let Some(document) = args.get(argv, 0u64) else {
        fail("L68: no JWKS argument")
    }
    let Some(credential) = args.get(argv, 1u64) else {
        fail("L68: no token argument")
    }
    let jwks: String = clone(document)
    let token: Bytes = clone(string.as_bytes(credential))
    let issuer = jwtbind.issuer_defaults(string.from("https://issuer.example"), string.from("place-a"), 9u8, std.jwt.allow(Es256))
    let v = match jwtbind.verifier(take issuer, Static(take jwks), n, System, c, r, tasks) {
        Ok(take v) => take v,
        Error(_) => fail("L68: the fixture JWKS was refused"),
    }
    let given: runner.Grants[JwtGrant, (), JwtGrant] = runner.Grants(attempt: None, call: None, claim: None, bind: Some(runner.Mint(seed: JwtGrant(jwt: jwtbind.grant(v)), mint: jwt_bind_mint, mint_bytes: 4096u64, mint_steps: runner.DEFAULT_STEPS)))
    let binds = runner.grant_task(tasks, (), take given)
    let session_wire = runner.grant_binds_of(binds, runner.wire(code.describe(jwt_bound), jwtbind.BIND_BYTES, jwtbind.BIND_STEPS))
    let mut db = result.unwrap(store.open(tasks, d, c, r, options()))
    result.unwrap(install_data(mut db))
    let (head, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let mail = result.unwrap(runner.mailbox(4u64))
    let seed = JwtClient(tasks: tasks, net: n, clock: c, random: r, head: take head, post: runner.post(mail), wire: take session_wire, token: take token)
    let driving = task.spawn(tasks, bytes 33554432u64, take seed, jwt_client)
    result.unwrap(runner.place_head(take db, code.describe(jwt_place), N_PLACE, None, code.describe(schema), take inbox, take mail, tasks, 1048576u64))
    clean(result.unwrap(task.join(take driving)))
    runner.stop_grants(Some(take binds))
    let mut o = options()
    o.create = false
    let mut again = result.unwrap(store.open(tasks, d, c, r, o))
    let h = result.unwrap(open_data(again))
    let total = result.unwrap(store.get(result.unwrap(store.reader(again, 0u64)), store.snapshot(again), h.t, 0u64))
    want(total == Some(2u64), "L68: two effects must be durable")
    let ticket = result.unwrap(store.checkpoint(mut again))
    result.unwrap(store.durable(mut again, ticket))
    result.unwrap(store.close(take again))
    let _ = take v
    Ok(())
}

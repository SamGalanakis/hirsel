// rule: DET-1
// expect: run
// A second std@1/store writer opening the same Dir claims the next epoch and
// fences the first: the first writer's next log object finds its id taken,
// so its commit's durable() returns Fenced() and every later call Closed(),
// while the second writer's commits survive a reopen.
@serializable
type Pair {
  key: Bytes,
  value: Bytes,
}

fn puts(mut tx: store.Tx, info: store.CallInfo, p: Pair) -> Result[(), store.TxError] {
  store.tx_put(mut tx, unique p.key, unique p.value)
}

// The store's error, whether or not the commit may have become durable.
fn put(mut s: store.Store[s3.Sim], k: Bytes, v: Bytes) -> Result[(), store.StoreError] {
  match store.transact(mut s, puts, Pair(key: unique k, value: unique v)) {
    Ok(()) => Ok(()),
    Error(Storage(e)) => Error(e),
    Error(Unknown(e)) => Error(e),
    Error(Limit(l)) => Error(Limit(l)),
    Error(_) => Error(Corrupt("put")),
  }
}

pub fn main(t: Test) -> Result[(), store.StoreError] {
  let d = test.dir(t, [])
  let mut old = store.open_backend(
    s3.simulated(d, 0, 0, 0, 0),
    s3.simulated_backend(),
    store.default_config()
  )?
  put(mut old, b"a", b"old")?
  let mut new = store.open_backend(
    s3.simulated(d, 0, 0, 0, 0),
    s3.simulated_backend(),
    store.default_config()
  )?
  test.check(t, store.get(store.snapshot(mut new), b"a") == Some(b"old"))
  test.check(t, put(mut old, b"b", b"stale") == Error(Fenced()))
  test.check(t, put(mut old, b"c", b"late") == Error(Closed()))
  test.check(t, store.close(take old) == Error(Closed()))
  put(mut new, b"b", b"new")?
  store.close(take new)?
  let mut again = store.open_backend(
    s3.simulated(d, 0, 0, 0, 0),
    s3.simulated_backend(),
    store.default_config()
  )?
  let now = store.snapshot(mut again)
  test.check(t, store.get(now, b"b") == Some(b"new") && store.get(now, b"c") == None())
  store.close(take again)?
  Ok(())
}

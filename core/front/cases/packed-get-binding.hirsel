// expect: accept
// A variant pattern under a view (`Some(Arr(ys))` over indexed.get's Option[View[J]])
// gives its field the field's type, so seq.len's T is fixed by ys; typing the field
// as an error left T open and falsely refused LANG-12.
@compact(u16)
stable type J = Null | Num(u64) | Arr(IndexedSpan[J])

fn inner(xs: IndexedSpan[J]) -> u64 {
    match indexed.get(xs, 0) {
        Some(Arr(ys)) => seq.len(ys),
        _ => 99,
    }
}

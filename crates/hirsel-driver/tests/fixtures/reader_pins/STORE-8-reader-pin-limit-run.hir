// rule: STORE-8
// A store holds at most 1024 reader pins over all versions: the 1025th
// acquire is Limit() and records nothing, so the table keeps 1024 holders.
pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

fn acquire(mut s: store.Store, r: Random) -> Result[
  store.HeldPin,
  store.TxFailure[store.PinError]
] {
  let Ok(p) = store.new_reader_pin(r) else {
    return Error(Storage(InvalidInput()))
  }
  store.transact(mut s, store.acquire_reader_pin, p)
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let Ok(r) = io.random(rt) else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  for _ in 0u64..1024 {
    let Ok(_) = acquire(mut s, r) else {
      return Error(Check())
    }
  }
  check(acquire(mut s, r) == Error(Aborted(Limit())))?
  let held = store.reader_pins(a, mut s) ? Store
  check(list.len(held) == 1024)?
  store.close(take s) ? Store
  Ok(())
}

@test
fn publish_lifecycle(c: Compiler, tasks: Tasks, random: Random) -> Result[(), String] waits {
    let bucket = start_bucket(tasks, 3368, list.new())
    let (network, link, server) = document_network(tasks, bucket.clock)
    let mut lookup = result.unwrap(registry_auth.lookup(network, bucket.clock, tasks))
    let mut forges: List[registry_auth.Forge] = list.new()
    list.push(mut forges, registry_auth.Forge(issuer: "https://issuer.example", jwks_url: "https://issuer.example/jwks", allow: std.jwt.allow(EdDsa), host: "github.com", org_api: "https://api.github.com", org_credential: None))
    let cfg = submit.Config(forges: take forges, namespaces: namespaces())
    let mut seq = service_sequencer()
    let mut client = connect_client(bucket.endpoint, tasks, bucket.clock, 3369)
    let mut w = new_witness_pair(1369353600)
    do_init_pair(mut seq, mut client, mut w, random)
    let first = applied(run_submit(c, mut seq, mut client, cfg, packet(FIRST_META, blob(FIRST_C)), mut lookup, bucket.clock, random, mut w), "first OIDC publication")?
    require(first.leaf_index == 1 && first.head_size == 2, "initial batch locator")?
    let unlogged = std.string.replace(CHILD_META, "\"1\"]]]", "\"9\"]]]")
    let _ = static.serve_get(mut seq, mut client, "/versions/begin-refusal", DEADLINE)
    let Error(Invalid) = run_submit(c, mut seq, mut client, cfg, packet(unlogged, blob(CHILD_C)), mut lookup, bucket.clock, random, mut w) else {
        return Error("unlogged floor")
    }
    let Error(Invalid) = run_submit(c, mut seq, mut client, cfg, packet(CHILD_META, blob(FIRST_C)), mut lookup, bucket.clock, random, mut w) else {
        return Error("wrong-root frame")
    }
    let mut full = blob(CHILD_C)
    list.push(mut full, make_zstd_raw_alt(option.unwrap(std.hex.decode(string.as_bytes(FIRST_C)))))
    let metadata_fields = result.unwrap(submit.parts(CHILD_META))
    let roots = cat3("[", pending.quoted(CHILD_ROOT), cat3(",", pending.quoted(FIRST_ROOT), "]"))
    let mut missing: List[String] = clone(metadata_fields)
    missing[3u64] = take roots
    missing[4u64] = "[]"
    let Error(Invalid) = run_submit(c, mut seq, mut client, cfg, packet(admit.array(missing), full), mut lookup, bucket.clock, random, mut w) else {
        return Error("worker accepted a floor without history")
    }
    let mut malformed: List[Bytes] = list.new()
    list.push(mut malformed, b"not a frame")
    let Error(Invalid) = run_submit(c, mut seq, mut client, cfg, packet(CHILD_META, malformed), mut lookup, bucket.clock, random, mut w) else {
        return Error("malformed frame")
    }
    let mut wrong_route: List[String] = clone(metadata_fields)
    wrong_route[4u64] = std.string.replace(metadata_fields[4u64], "acme.dev/leaf@1", "other.dev/leaf@1")
    let Error(Invalid) = run_submit(c, mut seq, mut client, cfg, packet(admit.array(wrong_route), blob(CHILD_C)), mut lookup, bucket.clock, random, mut w) else {
        return Error("unconfigured remote floor")
    }
    let _ = static.serve_get(mut seq, mut client, "/versions/end-refusal", DEADLINE)
    let child = applied(run_submit(c, mut seq, mut client, cfg, packet(CHILD_META, blob(CHILD_C)), mut lookup, bucket.clock, random, mut w), "Ed25519 floor consumer")?
    require(child.leaf_index == 2 && child.head_size == 3, "consumer receipt")?
    let moved = applied(run_submit(c, mut seq, mut client, cfg, packet(REBIND_META, list.new()), mut lookup, bucket.clock, random, mut w), "scope rebind")?
    require(moved.leaf_index == 3 && moved.root == None, "rebind receipt")?
    let _ = take seq
    let mut fresh = service_sequencer()
    result.unwrap(main.restart(mut fresh, mut client, random, DEADLINE, scoped fn() -> u64 {
        1369353600
    }, scoped fn(k: checkpoint.LogKind, i: u64, p: String, b: String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] {
        post_pair(mut w, k, i, p, b, random)
    }))
    let again = applied(run_submit(c, mut fresh, mut client, cfg, packet(FIRST_META, blob(FIRST_C)), mut lookup, bucket.clock, random, mut w), "cold receipt")?
    require(submit.locator(first) == submit.locator(again), "cold receipt changed")?
    let replayed = static.serve_get(mut fresh, mut client, cat3("/c/", CHILD_ROOT, ".zst"), DEADLINE)
    require(replayed.status == 200 && replayed.body == blob(CHILD_C)[0u64], "cold replayed consumer bytes")?
    let hints = static.serve_get(mut fresh, mut client, "/versions/acme.dev/consumer", DEADLINE)
    require(hints.status == 200 && hints.body == b"[[\"1.0.0\",\"2\",\"3\"]]", "cold consumer locator")?
    let fields = {
        let raw = option.unwrap(tlog.entry_at(fresh.logs[commit.log_index(Release)].log, 2))
        let Release(f) = result.unwrap(pending.decode_release_entry(raw)) else {
            return Error("missing release row")
        }
        take f
    }
    let side = static.serve_get(mut fresh, mut client, cat2("/e/", fields.facts_digest), DEADLINE)
    require(side.status == 200 && pending.sha256_hex(side.body) == fields.facts_digest && contains_raw(side.body, string.as_bytes(FIRST_ROOT)), "cold verified floor facts")?
    let ops: Inline[String, 5] =[RETIRE_META, REINSTATE_META, ADVISE_META, WITHDRAW_META, TAKEDOWN_META]
    let hashes: Inline[String, 5] =[RETIRE_HASH, REINSTATE_HASH, ADVISE_HASH, WITHDRAW_HASH, TAKEDOWN_HASH]
    for i in 0u64 .. 5 {
        let mut trailers: List[Bytes] = list.new()
        if i == 2 {
            list.push(mut trailers, string.into_bytes(string.from(ADVISE_DOC)))
        }
        if i == 3 {
            list.push(mut trailers, string.into_bytes(string.from(WITHDRAW_DOC)))
        }
        let rec = applied(run_submit(c, mut fresh, mut client, cfg, packet(ops[i], trailers), mut lookup, bucket.clock, random, mut w), cat2("status ", pending.decimal(i)))?
        require(rec.leaf_index == i && rec.head_size == i + 1, "status receipt")?
        let Some(current) = result.unwrap(status.current(mut fresh, mut client, FIRST_ROOT, DEADLINE)) else {
            return Error("missing status")
        }
        require(current.last_leaf_hash == hashes[i], "exact status leaf mismatch")?
        let n = map.len(current.advisories)
        require((i == 2 && n == 1) || (i != 2 && n == 0), "withdrawal must clear exactly its OSV ID")?
        let correct = match current.state {
            Retired(reason, _) => i == 0 && reason == "deprecated",
            Active => i > 0 && i < 4,
            TakenDown(reason, _) => i == 4 && reason == "legal",
        }
        require(correct, "folded lifecycle")?
    }
    let removed = static.serve_get(mut fresh, mut client, cat3("/c/", FIRST_ROOT, ".zst"), DEADLINE)
    require(removed.status == 410 && removed.body == b"[\"takedown\",\"legal\",\"removed\"]", "terminal removal")?
    let _ = take client
    let _ = take lookup
    let mut docs = take server
    task.cancel(mut docs)
    let _ = task.join(take docs)
    let _ = take network
    let _ = task.join(take link)
    let report = finish_bucket(take bucket)
    let mut refusal_window = false
    let mut boundaries = 0u64
    for req in report.requests {
        if req.key == "versions/begin-refusal" {
            refusal_window = true
            boundaries += 1
        }
        if req.key == "versions/end-refusal" {
            refusal_window = false
            boundaries += 1
        }
        if refusal_window && req.method == "PUT" {
            return Error("admission attempted a bucket write")
        }
    }
    require(boundaries == 2, "both admission boundaries observed")?
    for (k, obj) in report.objects {
        require(!contains_raw(obj.data, string.as_bytes(SERVICE_TOKEN)) && !contains_raw(string.as_bytes(k), string.as_bytes(SERVICE_TOKEN)), "live bearer persisted")?
    }
    let Some(marker) = map.get(report.objects, cat3("c/", FIRST_ROOT, ".zst")) else {
        return Error("missing marker")
    }
    require(list.len(marker.data) == 0 && tlog.size(fresh.logs[commit.log_index(Status)].log) == 5 && tlog.size(fresh.logs[commit.log_index(Release)].log) == 4, "history or marker missing")
}

const FIRST_KEY_META: String = "[[\"hirsel-intent-v1\",\"https://pkg.example\",\"publish\",\"acme.dev\",\"0\",\"11c482d9f3650fa659c721f7579c78c413c3b9de94176a484c40a456de0a4c52\",[\"acme.dev/leaf@1\",\"1.0.0\",\"leaf\",null,[[\"ed25519\",\"Kay64UG8yvCyLhqU000LxzYeUm0L/hLIl5S8kyKWbdc=\"],[\"oidc\",\"https://issuer.example\",\"repo/123\",\"123/.github/workflows/p.yml@refs/heads/main\"]]]],[\"ed25519\",\"Kay64UG8yvCyLhqU000LxzYeUm0L/hLIl5S8kyKWbdc=\"],\"DmhTNroeowEEhGVX3BcZnf4I5ux8iWBI8rGLdL9x4jh8vj/gYadoFvi6FcnI7SwhViCIy/Ru1WqfiPa/4wZ4Cw==\",[\"11c482d9f3650fa659c721f7579c78c413c3b9de94176a484c40a456de0a4c52\"],[]]"

type Origin: send {
    site: Listener,
    endpoint: std.sim.s3.Endpoint,
    net: Net,
    clock: Clock,
    c: Compiler,
    tasks: Tasks,
    random: Random
}

fn test_origin(take job: Origin) waits {
    let Origin(site: take site, endpoint: take endpoint, net: network, clock, c, tasks, random) = take job
    let mut client = connect_client(endpoint, tasks, clock, 3370)
    let mut seq = service_sequencer()
    let mut w = new_witness_pair(1369353600)
    do_init_pair(mut seq, mut client, mut w, random)
    let mut lookup = result.unwrap(registry_auth.lookup(network, clock, tasks))
    let cfg = submit.Config(forges: list.new(), namespaces: namespaces())
    let _ = main.serve(take site, mut seq, mut client, cfg, take lookup, c, clock, random, tasks, 4194304, scoped fn(k: checkpoint.LogKind, i: u64, p: String, b: String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] {
        post_pair(mut w, k, i, p, b, random)
    })
}

fn exchange(cl: std.http_client.Client, method: String, path: String, take data: Bytes) -> Result[(u16, Bytes), String] waits {
    let mut payload: List[std.http_client.Segment] = list.new()
    if method == "POST" {
        list.push(mut payload, Plain(take data))
    }
    let req = std.http_client.Fetch(method: clone(method), url: cat2("http://127.0.0.1:3370", path), headers: list.new(), body: take payload)
    let mut out: Bytes = list.new()
    let Ok(response) = std.http_client.fetch_all(cl, req, mut out, DEADLINE) else {
        return Error("HTTP exchange failed")
    }
    Ok((std.http_client.status(response), take out))
}

@test
fn http_first_key(c: Compiler, tasks: Tasks, random: Random) -> Result[(), String] waits {
    let bucket = start_bucket(tasks, 3370, list.new())
    let (network, link, docs) = document_network(tasks, bucket.clock)
    let (site, _) = result.unwrap(host.listen(network, Addr(ip: V4(2130706433), port: 3370), 8))
    let mut serving = task.spawn(tasks, bytes 100663296, Origin(site: take site, endpoint: clone(bucket.endpoint), net: network, clock: bucket.clock, c: c, tasks: tasks, random: random), test_origin)
    let pool = result.unwrap(std.http_client.pool(network, bucket.clock, tasks, System, std.http_client.limits(1048576)))
    let client = std.http_client.handle(pool)
    // Empty raw blocks keep the content and signature fixed while making the
    // HTTP request exceed the inline-body threshold.
    let raw = blob(FIRST_C)
    let small = view raw[0u64]
    let mut frame: Bytes = list.with_capacity(19000)
    list.append(mut frame, list.slice(small, 0, 6))
    for _ in 0u64 .. 6000 {
        list.append(mut frame, b"\x00\x00\x00")
    }
    list.append(mut frame, list.slice(small, 6, list.len(small)))
    let mut frames: List[Bytes] = list.new()
    list.push(mut frames, clone(frame))
    let (code, reply) = exchange(client, "POST", "/v1/submit", packet(FIRST_KEY_META, frames))?
    let wanted = cat3("[\"pkg.example/log\",\"1\",\"2\",", pending.quoted(FIRST_ROOT), "]")
    require(code == 200 && reply == string.as_bytes(wanted), "HTTP key enrollment and publish receipt")?
    let (get, data) = exchange(client, "GET", cat3("/c/", FIRST_ROOT, ".zst"), list.new())?
    require(get == 200 && data == frame, "HTTP static package bytes")?
    let (bad, _) = exchange(client, "POST", "/v1/submit", b"\x00\x10\x00\x01")?
    require(bad == 413, "oversized metadata length must return 413")?
    let (invalid, _) = exchange(client, "POST", "/v1/submit", b"\x00\x00\x00\x02[]")?
    require(invalid == 422, "invalid metadata must return 422")?
    let (private_code, _) = exchange(client, "GET", "/log/pending/0", list.new())?
    require(private_code == 403, "private key was served")?
    task.cancel(mut serving)
    let _ = task.join(take serving)
    let _ = take client
    let _ = take pool
    let mut documents = take docs
    task.cancel(mut documents)
    let _ = task.join(take documents)
    let _ = take network
    let _ = task.join(take link)
    let _ = finish_bucket(take bucket)
    Ok(())
}

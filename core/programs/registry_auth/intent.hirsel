// Package registry §1. P is the verified Phase 0 library root supplied by admission.
pub type Subject: shareable + send = Workload(String, String, String) | SigningKey(Bytes)

pub type Publication: shareable + send {
    root: String,
    identity: String,
    version: String,
    description: String,
    source_commit: Option[String],
    enrollment: Option[List[Subject]]
}

pub type Status: shareable + send = Retire(String, String) | Reinstate(String) | Advise(String, String) | Takedown(String, String)

pub type Action: shareable + send = Publish(Publication) | Rebind(List[Subject]) | ChangeStatus(String, Option[String], Status)

pub type Intent: shareable + send {
    origin: String,
    scope: String,
    generation: u64,
    action: Action
}

pub type Refusal: key = InvalidIntent | InvalidSubjects | Unauthorized | StaleGeneration | EnrollmentRefused | RateLimited | Unavailable

fn cat(a: String, b: String) -> String {
    let mut out = string.from(a)
    string.push(mut out, b)
    take out
}

pub fn decimal(n: u64) -> String {
    let mut out = string.new()
    string.push_u64(mut out, n)
    take out
}

pub fn quoted(s: String) -> String {
    let mut out = string.new()
    std.json.push_quoted(mut out, s)
    take out
}

fn nullable(value: Option[String]) -> String {
    match value {
        Some(s) => quoted(s),
        None => string.from("null"),
    }
}

fn tuple(parts: List[String]) -> String {
    cat(cat("[", std.string.join(parts, ",")), "]")
}

pub fn digest(s: String) -> String {
    let hash = std.sha256.hash(string.as_bytes(s))
    let mut raw: Bytes = list.with_capacity(32)
    for i in 0u64 .. 32u64 {
        list.push(mut raw, hash[i])
    }
    std.hex.encode(raw)
}

pub fn lower_hex(s: String, n: u64) -> bool {
    if string.byte_len(s) != n {
        return false
    }
    for b in string.as_bytes(s) {
        if !int.is_ascii_digit(b) && !(b >= b'a' && b <= b'f') {
            return false
        }
    }
    true
}

fn dns_label(s: String, limit: u64) -> bool {
    let n = string.byte_len(s)
    if n == 0 || n > limit || std.string.starts_with(s, "-") || std.string.ends_with(s, "-") {
        return false
    }
    for b in string.as_bytes(s) {
        if !(b >= b'a' && b <= b'z') && !int.is_ascii_digit(b) && b != b'-' {
            return false
        }
    }
    true
}

fn dns_name(s: String) -> bool {
    if string.byte_len(s) > 253 || std.string.find(s, 0, ".") == None {
        return false
    }
    let mut at: u64 = 0
    while let Some((part, next)) = std.string.next_split(s, at, ".") {
        if !dns_label(part, 63) {
            return false
        }
        if next > string.byte_len(s) {
            for b in string.as_bytes(part) {
                if !int.is_ascii_digit(b) {
                    return true
                }
            }
            return false
        }
        at = next
    }
    false
}

fn valid_scope(s: String) -> bool {
    match std.string.split_once(s, "/") {
        Some((host, tenant)) => dns_name(host) && dns_label(tenant, 64),
        None => dns_name(s),
    }
}

fn valid_origin(s: String) -> bool {
    let Some(site) = std.string.strip_prefix(s, "https://") else {
        return false
    }
    match std.string.split_once(site, ":") {
        None => dns_name(site),
        Some((name, port)) => {
            let Ok(n) = std.int.parse_uint(port, 10) else {
                return false
            }
            dns_name(name) && n > 0 && n <= 65535 && n != 443 && decimal(n) == port
        },
    }
}

fn field(mut out: String, raw: String) {
    string.push(mut out, ",")
    string.push(mut out, raw)
}

fn pair(a: String, b: String) -> String {
    let mut out = cat("[", a)
    field(mut out, b)
    cat(out, "]")
}

fn subject_wire(s: Subject) -> String {
    match s {
        Workload(issuer, id, workflow) => {
            let mut out = string.from("[\"oidc\"")
            field(mut out, quoted(issuer))
            field(mut out, quoted(id))
            field(mut out, quoted(workflow))
            cat(out, "]")
        },
        SigningKey(key) => pair("\"ed25519\"", quoted(std.base64.encode_string(key))),
    }
}

pub fn subject_set(subjects: List[Subject]) -> Result[String, Refusal] {
    if list.len(subjects) == 0 {
        return Error(InvalidSubjects)
    }
    let mut parts: List[String] = list.new()
    for s in subjects {
        if !valid_subject(s) {
            return Error(InvalidSubjects)
        }
        let wire = subject_wire(s)
        if list.len(parts) > 0 && parts[list.len(parts) - 1] >= wire {
            return Error(InvalidSubjects)
        }
        list.push(mut parts, take wire)
    }
    Ok(tuple(parts))
}

fn status_tag(s: Status) -> String {
    match s {
        Retire(_, _) => string.from("retire"),
        Reinstate(_) => string.from("reinstate"),
        Advise(_, _) => string.from("advise"),
        Takedown(_, _) => string.from("takedown"),
    }
}

pub fn retire_reason(reason: String) -> bool {
    reason == "security" || reason == "deprecated" || reason == "invalid" || reason == "renamed" || reason == "other"
}

fn status_payload(s: Status) -> Result[String, Refusal] {
    match s {
        Retire(reason, message) => {
            if !retire_reason(reason) {
                return Error(InvalidIntent)
            }
            Ok(pair(quoted(reason), quoted(message)))
        },
        Reinstate(message) => Ok(cat(cat("[", quoted(message)), "]")),
        Advise(id, hash) => {
            if id == "" || !lower_hex(hash, 64) {
                return Error(InvalidIntent)
            }
            Ok(pair(quoted(id), quoted(hash)))
        },
        Takedown(reason, message) => Ok(pair(quoted(reason), quoted(message))),
    }
}

fn package_label(scope: String, identity: String, version: String) -> bool {
    let Some((name, major)) = std.string.split_once(identity, "@") else {
        return false
    }
    let Some(local) = std.string.strip_prefix(name, cat(scope, "/")) else {
        return false
    }
    let b = string.as_bytes(local)
    if string.byte_len(name) > 255 || list.len(b) == 0 || list.len(b) > 64 || b[0] < b'a' || b[0] > b'z' {
        return false
    }
    for c in b {
        if !(c >= b'a' && c <= b'z') && !int.is_ascii_digit(c) && c != b'_' {
            return false
        }
    }
    let Ok(_) = std.semver.parse(version) else {
        return false
    }
    let Some((version_major, _)) = std.string.split_once(version, ".") else {
        return false
    }
    version_major == major && std.string.find(version, 0, "+") == None
}

fn action_fields(i: Intent) -> Result[(String, Option[String], String), Refusal] {
    match i.action {
        Publish(p) => {
            if !package_label(i.scope, p.identity, p.version) || !lower_hex(p.root, 64) {
                return Error(InvalidIntent)
            }
            if let Some(commit) = p.source_commit {
                if !lower_hex(commit, 40) && !lower_hex(commit, 64) {
                    return Error(InvalidIntent)
                }
            }
            let enrollment = match p.enrollment {
                Some(set) => subject_set(set)?,
                None => string.from("null"),
            }
            let mut body = cat("[", quoted(p.identity))
            field(mut body, quoted(p.version))
            field(mut body, quoted(p.description))
            field(mut body, nullable(p.source_commit))
            field(mut body, enrollment)
            Ok((string.from("publish"), Some(clone(p.root)), cat(body, "]")))
        },
        Rebind(next) => Ok((string.from("scope-rebind"), None, subject_set(next)?)),
        ChangeStatus(root, prev, status) => {
            if !lower_hex(root, 64) {
                return Error(InvalidIntent)
            }
            if let Some(p) = prev {
                if !lower_hex(p, 64) {
                    return Error(InvalidIntent)
                }
            }
            Ok((status_tag(status), Some(clone(root)), pair(nullable(prev), status_payload(status)?)))
        },
    }
}

pub fn intent_wire(i: Intent) -> Result[String, Refusal] {
    if !valid_origin(i.origin) || !valid_scope(i.scope) {
        return Error(InvalidIntent)
    }
    let (tag, root, body) = action_fields(i)?
    let mut out = string.from("[\"hirsel-intent-v1\"")
    field(mut out, quoted(i.origin))
    field(mut out, quoted(tag))
    field(mut out, quoted(i.scope))
    field(mut out, quoted(decimal(i.generation)))
    field(mut out, nullable(root))
    field(mut out, body)
    Ok(cat(out, "]"))
}

pub fn audience(i: Intent) -> Result[String, Refusal] {
    let (tag, root, _) = action_fields(i)?
    let p: String = match root {
        Some(hash) => clone(hash),
        None => string.from("-"),
    }
    let mut out = cat(i.origin, "/intent/")
    string.push(mut out, tag)
    string.push(mut out, "/")
    string.push(mut out, p)
    string.push(mut out, "/")
    string.push(mut out, digest(intent_wire(i)?))
    Ok(take out)
}

fn array_items(raw: String) -> Result[List[String], Refusal] {
    let Ok(items) = std.json.decode(raw, fn(s: String, mut c: std.json.Cursor) -> Result[List[String], std.json.Error] {
        std.json.list_of(s, mut c, fn(t: String, mut cursor: std.json.Cursor) -> Result[String, std.json.Error] {
            let element = std.json.read_raw(t, mut cursor)?
            Ok(string.from(element))
        })
    }) else {
        return Error(InvalidIntent)
    }
    if tuple(items) != raw {
        return Error(InvalidIntent)
    }
    Ok(take items)
}

fn text_value(raw: String) -> Result[String, Refusal] {
    let Ok(s) = std.json.decode(raw, std.json.read_string) else {
        return Error(InvalidIntent)
    }
    if quoted(s) != raw {
        return Error(InvalidIntent)
    }
    Ok(take s)
}

fn key_rank(ch: char) -> u32 {
    let n = char.to_u32(ch)
    if n >= 0xe000 && n <= 0xffff {
        n + 0x110000
    } else {
        n
    }
}

fn utf16_order(a: String, b: String) -> Order {
    let mut i = 0u64
    let mut j = 0u64
    while let Some((x, next)) = string.next_scalar(a, i) {
        let Some((y, end)) = string.next_scalar(b, j) else {
            return Greater
        }
        if x != y {
            return order.compare(key_rank(x), key_rank(y))
        }
        i = next
        j = end
    }
    if j == string.byte_len(b) {
        Equal
    } else {
        Less
    }
}

fn jcs_number(raw: String) -> String {
    let Ok(n) = std.float.parse64(raw) else {
        return string.new()
    }
    if !std.float.is_finite(n) {
        return string.new()
    }
    let (coefficient, power) = std.float.shortest64(n)
    if coefficient == 0 {
        return string.from("0")
    }
    let digits = decimal(coefficient)
    let width: i64 = int.narrow(string.byte_len(digits))
    let point = width + power
    let mut out = if (float.to_bits64(n) >> 63) != 0 {
        string.from("-")
    } else {
        string.new()
    }
    if point <= -6 || point > 21 {
        string.push(mut out, string.slice(digits, 0, 1))
        if width > 1 {
            string.push(mut out, ".")
            string.push(mut out, string.slice(digits, 1, string.byte_len(digits)))
        }
        string.push(mut out, if point < 0 {
            "e-"
        } else {
            "e+"
        })
        let exp: u64 = int.narrow(if point < 0 {
            1 - point
        } else {
            point - 1
        })
        string.push_u64(mut out, exp)
    } else if point <= 0 {
        string.push(mut out, "0.")
        let zeros: u64 = int.narrow(-point)
        for _ in 0u64 .. zeros {
            string.push(mut out, "0")
        }
        string.push(mut out, digits)
    } else if point >= width {
        string.push(mut out, digits)
        let zeros: u64 = int.narrow(point - width)
        for _ in 0u64 .. zeros {
            string.push(mut out, "0")
        }
    } else {
        let split: u64 = int.narrow(point)
        string.push(mut out, string.slice(digits, 0, split))
        string.push(mut out, ".")
        string.push(mut out, string.slice(digits, split, string.byte_len(digits)))
    }
    take out
}

fn jcs(take value: std.json.TreeValue[String]) -> String {
    match take value {
        Null => string.from("null"),
        True => string.from("true"),
        False => string.from("false"),
        Num(s) => jcs_number(s),
        Str(s) => quoted(s),
        Arr(xs) => tuple(xs),
        Obj(fields) => {
            let mut keys: List[String] = list.new()
            for (k, _) in fields {
                list.push(mut keys, clone(k))
            }
            std.list.sort(mut keys, utf16_order)
            let mut out = string.from("{")
            for i in 0u64 .. list.len(keys) {
                if i != 0 {
                    string.push(mut out, ",")
                }
                std.json.push_quoted(mut out, keys[i])
                string.push(mut out, ":")
                if let Some(v) = map.get(fields, keys[i]) {
                    string.push(mut out, v)
                }
            }
            string.push(mut out, "}")
            take out
        },
    }
}

fn record(raw: String) -> Result[Map[String, String], Refusal] {
    let Ok(fields) = std.json.decode(raw, fn(s: String, mut c: std.json.Cursor) -> Result[Map[String, String], std.json.Error] {
        let seed: Map[String, String] = map.new()
        std.json.record_of(s, mut c, take seed, fn(key: String, t: String, mut cursor: std.json.Cursor, mut fs: Map[String, String]) -> Result[(), std.json.Error] {
            let value = std.json.read_raw(t, mut cursor)?
            map.insert(mut fs, clone(key), string.from(value))
            Ok(())
        })
    }) else {
        return Error(InvalidIntent)
    }
    Ok(take fields)
}

fn json_member(fields: Map[String, String], k: String) -> Result[String, Refusal] {
    let Some(v) = map.get(fields, k) else {
        return Error(InvalidIntent)
    }
    Ok(clone(v))
}

fn covered(raw: String, version: std.semver.Version) -> Result[bool, Refusal] {
    let mut introduced = false
    let mut fixed = false
    let mut last = false
    let mut has_limit = false
    let mut before_limit = false
    let mut affected = false
    let mut latest: Option[std.semver.Version] = None
    let mut last_rank = 0u64
    for e in array_items(raw)? {
        let fields = record(e)?
        if map.len(fields) != 1 {
            return Error(InvalidIntent)
        }
        for (kind, v) in fields {
            let s = text_value(v)?
            if kind == "limit" {
                has_limit = true
                if s == "*" {
                    before_limit = true
                } else {
                    let Ok(limit) = std.semver.parse(s) else {
                        return Error(InvalidIntent)
                    }
                    if std.semver.ordered(version, limit) == Less {
                        before_limit = true
                    }
                }
                continue
            }
            let rank: u64 = if kind == "introduced" {
                introduced = true
                2u64
            } else if kind == "fixed" {
                fixed = true
                0u64
            } else if kind == "last_affected" {
                last = true
                1u64
            } else {
                return Error(InvalidIntent)
            }
            if kind == "introduced" && s == "0" {
                if let None = latest {
                    affected = true
                }
                continue
            }
            let Ok(boundary) = std.semver.parse(s) else {
                return Error(InvalidIntent)
            }
            let cmp = std.semver.ordered(version, boundary)
            if cmp == Less || (kind == "last_affected" && cmp == Equal) {
                continue
            }
            if let Some(previous) = view latest {
                let order_by_version = std.semver.ordered(boundary, previous)
                if order_by_version == Less || (order_by_version == Equal && rank < last_rank) {
                    continue
                }
            }
            latest = Some(take boundary)
            last_rank = rank
            affected = kind == "introduced"
        }
    }
    if !introduced || (fixed && last) {
        return Error(InvalidIntent)
    }
    Ok(affected && (!has_limit || before_limit))
}

fn timestamp(raw: String) -> Result[bool, Refusal] {
    match std.time.parse_rfc3339(text_value(raw)?) {
        Ok(_) => Ok(true),
        Error(_) => Ok(false),
    }
}

pub fn advisory(data: Bytes, id: String, expected_digest: String, identity: String, version_text: String) -> Result[bool, Refusal] {
    if list.len(data) > 1048576 {
        return Error(InvalidIntent)
    }
    if id == "" {
        return Error(InvalidIntent)
    }
    let Ok(raw) = string.from_utf8(clone(data)) else {
        return Error(InvalidIntent)
    }
    if digest(raw) != expected_digest || !canonical_json(raw)? {
        return Error(InvalidIntent)
    }
    let doc = record(raw)?
    if text_value(json_member(doc, "id")?)? != id || !timestamp(json_member(doc, "modified")?)? {
        return Error(InvalidIntent)
    }
    let Some((name, _)) = std.string.split_once(identity, "@") else {
        return Error(InvalidIntent)
    }
    let Ok(version) = std.semver.parse(version_text) else {
        return Error(InvalidIntent)
    }
    let mut applies = false
    for entry in array_items(json_member(doc, "affected")?)? {
        let item = record(entry)?
        let Some(pkg) = map.get(item, "package") else {
            continue
        }
        let p = record(pkg)?
        if text_value(json_member(p, "ecosystem")?)? != "Hirsel" || text_value(json_member(p, "name")?)? != name {
            continue
        }
        if let Some(values) = map.get(item, "versions") {
            for v in array_items(values)? {
                if text_value(v)? == version_text {
                    applies = true
                }
            }
        }
        if let Some(ranges) = map.get(item, "ranges") {
            for r in array_items(ranges)? {
                let fields = record(r)?
                if text_value(json_member(fields, "type")?)? == "SEMVER" && covered(json_member(fields, "events")?, version)? {
                    applies = true
                }
            }
        }
    }
    if !applies {
        return Error(InvalidIntent)
    }
    if let Some(v) = map.get(doc, "withdrawn") {
        if !timestamp(v)? {
            return Error(InvalidIntent)
        }
        return Ok(true)
    }
    Ok(false)
}

pub fn canonical_json(raw: String) -> Result[bool, Refusal] {
    let encoded = std.json.parse_tree(raw, fn() -> Result[(), Refusal] {
        Ok(())
    }, jcs, fn(take e: std.json.Error) -> Refusal {
        InvalidIntent
    })
    let Ok(canon) = take encoded else {
        return Error(InvalidIntent)
    }
    Ok(canon == raw)
}

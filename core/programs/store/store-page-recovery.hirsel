pub fn attach_page_graph(mut graph: PageGraph, empty_collection: Arc[std.page.Page]) -> Result[Map[u64, Arc[std.page.Page]], types.Failure] {
    let mut page_nodes: Map[u64, Arc[std.page.Page]] = map.new()
    let mut bodies: Map[u64, Arc[Bytes]] = map.new()
    let stamps = replace(mut graph.postorder, list.new())
    for stamp in stamps {
        let frame = option.unwrap(map.remove(mut graph.frames, stamp))
        match take frame {
            ReadBlob(take raw) => {
                let mut moved: Option[Bytes] = Some(take raw)
                let mut counted = disk_allocation(fn() -> Result[Arc[Bytes], types.Failure] {
                    let empty: Bytes = list.new()
                    Ok(arc.new(take empty))
                })?
                let attached = arc.with_unique(mut counted, scoped fn(mut body: Bytes) {
                    body = option.unwrap(replace(mut moved, None))
                })
                let _ = option.unwrap(attached)
                types.capacity(map.try_reserve(mut bodies, 1))?
                map.insert(mut bodies, stamp, take counted)
            },
            ReadPage(take image, take children, take refs) => {
                let mut kids: List[std.page.Slot] = list.new()
                let mut blobs: List[std.page.BlobSlot] = list.new()
                types.capacity(list.try_reserve(mut kids, list.len(children)))?
                types.capacity(list.try_reserve(mut blobs, list.len(refs)))?
                for slot in 0u64 .. list.len(children) {
                    let child = children[slot]
                    let attached: std.page.Slot = match std.page.tiered_root_at(image, slot) {
                        Some(ptr) if ptr.stamp != 0 => ColdPage(ptr),
                        _ if child == 0 => HotPage(arc.share(empty_collection)),
                        _ => {
                            let Some(page) = map.get(page_nodes, child) else {
                                fail("missing validated child")
                            }
                            HotPage(arc.share(page))
                        },
                    }
                    list.push(mut kids, take attached)
                }
                for body in refs {
                    let Some(value) = map.get(bodies, body) else {
                        fail("missing validated body")
                    }
                    list.push(mut blobs, HotBlob(arc.share(value)))
                }
                let page = pages.page_result(types.capacity(std.page.attach_fallible(take image, take kids, take blobs))?)?
                types.capacity(map.try_reserve(mut page_nodes, 1))?
                map.insert(mut page_nodes, stamp, take page)
            },
        }
    }
    Ok(take page_nodes)
}

pub type LoadedPageStore: send {
    manifest: PageManifest,
    holders: List[pages.PageRoots],
    lists: PagedLists,
    locations: PageLocations
}

pub fn attach_manifest_holders(manifest: PageManifest, page_nodes: Map[u64, Arc[std.page.Page]], empty_collection: Arc[std.page.Page]) -> List[pages.PageRoots] {
    let mut all: List[pages.PageRoots] = list.with_capacity(list.len(manifest.branches) + list.len(manifest.pins))
    for item in manifest.branches {
        list.push(mut all, pages.attach_page_roots(page_nodes, item.roots, manifest.inline, empty_collection))
    }
    for held in manifest.pins {
        list.push(mut all, pages.attach_page_roots(page_nodes, held.roots, manifest.inline, empty_collection))
    }
    take all
}

pub fn manifest_tiered_inventory(directory: Option[(types.StoreKey, Inline[u8, 32])], inventory: Map[u64, pages.PagePack], generation: u64, next_stamp: u64) -> Result[Arc[pages.TieredReadInventory], types.Failure] {
    let mut packs: std.omap.OMap[u64, pages.TieredPagerPack] = std.omap.new()
    let mut ids = 0u64
    for (seq, pack) in inventory {
        if pack.class < 3 {
            continue
        }
        let (take revised, _) = std.omap.insert_owned(mut ids, take packs, seq, pages.TieredPagerPack(inventory: clone(pack), object: None))
        packs = take revised
    }
    Ok(arc.new(pages.TieredReadInventory(directory, packs: take packs, generation: generation, next_stamp: next_stamp)))
}

pub type PackObjectRef = pages.HistoryRef

pub type LoadedPackInventory: send {
    packs: std.omap.OMap[u64, pages.TieredPagerPack],
    generation: u64,
    next_stamp: u64
}

pub fn recovered_pack_inventory(locations: PageLocations, locator: Option[View[Map[u64, PackObjectRef]]], generation: u64, next_stamp: u64) -> LoadedPackInventory {
    let mut packs: std.omap.OMap[u64, pages.TieredPagerPack] = std.omap.new()
    let mut ids = 0u64
    let mut rows = std.omap.range(locations.packs.values, Unbounded, Unbounded)
    while let Some((seq, inventory)) = std.omap.next(mut rows) {
        if inventory.class < 3 {
            continue
        }
        let object: Option[PackObjectRef] = match locator {
            Some(_) if inventory.foreign != None => None,
            Some(remote) => {
                let Some(item) = map.get(remote, seq) else {
                    fail("store: validated Bucket locator lost a Tiered pack")
                }
                Some(clone(item))
            },
            None => None,
        }
        let (take revised, _) = std.omap.insert_owned(mut ids, take packs, seq, pages.TieredPagerPack(inventory: clone(inventory), object: object))
        packs = take revised
    }
    LoadedPackInventory(packs: take packs, generation: generation, next_stamp: next_stamp)
}

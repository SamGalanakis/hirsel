// Measures std@1/store's in-memory index and compaction cost: loads `n` keys
// of 16 bytes with 100-byte values through store.transact, 100 keys per
// commit, then by `mode`: "load" stops there, "compact" compacts once
// and "recompact" compacts, commits one more key and compacts again. Prints the
// snapshot object's bytes.
fn key(i: u64) -> unique Bytes uses {} {
  let mut out: List[u8] = []
  for b in b"key/" {
    list.push(mut out, b)
  }
  let mut place: u64 = 100000000000
  while place > 0 {
    list.push(mut out, b'0' + int.truncate(i / place % 10))
    place = place / 10
  }
  bytes.from_list(take out)
}

fn value(i: u64) -> unique Bytes uses {} {
  let mut out: List[u8] = []
  for j in 0u64..100u64 {
    list.push(mut out, int.truncate((i + j) % 251))
  }
  bytes.from_list(take out)
}

@serializable
type Keys {
  first: u64,
  end: u64,
}

fn puts(mut tx: store.Tx, info: store.CallInfo, span: Keys) -> Result[(), ()] {
  for k in span.first..span.end {
    if store.tx_put(mut tx, key(k), value(k)) != Ok(()) {
      return Error(())
    }
  }
  Ok(())
}

fn load(mut s: store.Store[Dir], from: u64, to: u64) -> Result[(), ()] {
  let mut i = from
  while i < to {
    let end = if i + 100 < to {
      i + 100
    } else {
      to
    }
    let done: Result[(), store.TxFailure[()]] = store.transact(
      mut s,
      puts,
      Keys(first: i, end: end)
    )
    if done != Ok(()) {
      return Error(())
    }
    i = end
  }
  Ok(())
}

fn snap_bytes(d: Dir) -> Result[u64, FileError] uses {d} {
  let entries = match file.read_dir(d, path.of("snap")) {
    Ok(entries) => take entries,
    Error(NotFound()) => return Ok(0),
    Error(err) => return Error(take err),
  }
  let mut total: u64 = 0
  for item in take entries {
    let entry = item?
    let data = file.read_bytes(d, entry.path)?
    total += bytes.len(data)
  }
  Ok(total)
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(())
  }
  let Ok(d) = io.dir(rt, path.of("data")) else {
    return Error(())
  }
  let Ok(mode) = arg.text(args, 0) else {
    return Error(())
  }
  let Ok(n_text) = arg.text(args, 1) else {
    return Error(())
  }
  let Ok(n) = u64.parse(n_text) else {
    return Error(())
  }
  let Ok(opened) = store.open(d, store.default_config()) else {
    return Error(())
  }
  let mut s = take opened
  load(mut s, 0, n)?
  if mode == "compact" || mode == "recompact" {
    if store.compact(mut s) != Ok(()) {
      return Error(())
    }
  }
  if mode == "recompact" {
    load(mut s, n, n + 1)?
    if store.compact(mut s) != Ok(()) {
      return Error(())
    }
  }
  if store.close(take s) != Ok(()) {
    return Error(())
  }
  let Ok(size) = snap_bytes(d) else {
    return Error(())
  }
  let Ok(_) = out.print(stdout, f"{size}\n") else {
    return Error(())
  }
  Ok(())
}

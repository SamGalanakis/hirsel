// rule: STORE-9
// expect: run
// A migration canceled at any point: the writer opens a store, seeds eight rows
// two to a transaction and migrates them BATCH rows to a batch, in a child task
// the cancellation sweep cancels just after its k-th seam call. Whatever k, the
// migration returns Ok(8) with every row migrated or Canceled with the seeded
// table whole, and after a reopen no garbage record remains, the keys under the
// table's rows are exactly its rows, and a later migration reuses the
// generation the canceled one discarded. The driver sweeps every k
// (stdlib_table.rs).
@serializable
type Item {
  label: String,
  count: u64,
}

@serializable
type Priced {
  label: String,
  cents: u64,
}

const BATCH: u64 = 2

fn price(c: (), key: u64, old: Item) -> Result[(u64, Priced), ()] {
  Ok((key, Priced(label: unique old.label, cents: old.count * 100)))
}

fn items() -> table.Table[u64, Item] {
  table.named("items")
}

fn priced() -> table.Table[u64, Priced] {
  table.named("items")
}

fn seed_rows(mut tx: store.Tx, info: store.CallInfo, from: u64) -> Result[
  (),
  store.TxError
] {
  if from == 1 {
    table.create(mut tx, items())?
  }
  for k in from..from + 2 {
    table.put(mut tx, items(), k, Item(label: f"item {k}", count: k))?
  }
  Ok(())
}

// The child: open, seed, migrate, close. What it saw, as `said` names it.
fn writer(s: Scope, a: Authority) -> u8 {
  let Ok(opened) = store.open(a, store.default_config()) else {
    return 4
  }
  let mut db = take opened
  let mut from: u64 = 1
  while from <= 8 {
    let r: Result[(), store.TxFailure[store.TxError]] = store.transact(
      mut db,
      seed_rows,
      from
    )
    if r != Ok(()) {
      return 5
    }
    from += 2
  }
  let saw: u8 = match table.migrate(s, mut db, items(), priced(), price, BATCH) {
    Ok(8) => 0,
    Error(Canceled(_)) => 1,
    Ok(_) => 2,
    Error(_) => 3,
  }
  if store.close(take db) != Ok(()) {
    return saw + 10
  }
  saw
}

fn said(saw: u8) -> String uses {} {
  let what = match saw % 10 {
    0 => "ok",
    1 => "canceled",
    2 => "migrated a wrong count",
    3 => "migration failed",
    4 => "open failed",
    _ => "seed failed",
  }
  if saw >= 10 {
    f"{what}, close failed"
  } else {
    what
  }
}

// 1 the seeded rows, 2 them migrated, 0 anything else.
fn form(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[u8, store.TxError] {
  let epochs = list.len(table.history(tx, "items")?)
  if let Ok(old) = table.range(tx, items(), Unbounded(), Unbounded(), 100, Ascending()) {
    let mut want: List[(u64, Item)] = []
    for k in 1u64..9u64 {
      list.push(mut want, (k, Item(label: f"item {k}", count: k)))
    }
    return Ok(
      if old == want && epochs == 1 {
        1
      } else {
        0
      }
    )
  }
  let new = table.range(tx, priced(), Unbounded(), Unbounded(), 100, Ascending())?
  let mut want: List[(u64, Priced)] = []
  for k in 1u64..9u64 {
    list.push(mut want, (k, Priced(label: f"item {k}", cents: k * 100)))
  }
  Ok(
    if new == want && epochs == 2 {
      2
    } else {
      0
    }
  )
}

// Garbage records, and keys under the table's rows of any generation.
fn leftovers(a: Authority, mut s: store.Store) -> (u64, u64) {
  let Ok(snap) = store.snapshot(a, mut s, authority.floor(a)) else {
    return (1000, 1000)
  }
  let (low, high) = store.prefix_bounds(b"hirsel.garbage/")
  let mut prefix: List[u8] = []
  bytes.append(mut prefix, b"hirsel.rows/")
  bytes.append(mut prefix, keys.encode("items"))
  let (rows_low, rows_high) = store.prefix_bounds(bytes.from_list(take prefix))
  (
    list.len(store.range(snap, low, high, Ascending(), 100)),
    list.len(store.range(snap, rows_low, rows_high, Ascending(), 100))
  )
}

// Reopens, checks, and finishes the migration if it was canceled.
fn check(sc: Scope, a: Authority) -> String {
  let Ok(reopened) = store.open(a, store.default_config()) else {
    return "reopen refused"
  }
  let mut db = take reopened
  let seen: Result[u8, store.TxFailure[store.TxError]] = store.transact(
    mut db,
    form,
    ()
  )
  let Ok(f) = seen else {
    return "reading the table failed"
  }
  let (garbage, stored) = leftovers(a, mut db)
  let mut line = f"form {f} garbage {garbage} rows {stored}"
  if f == 1 {
    let again = table.migrate(sc, mut db, items(), priced(), price, BATCH)
    let after: Result[u8, store.TxFailure[store.TxError]] = store.transact(
      mut db,
      form,
      ()
    )
    let (g, r) = leftovers(a, mut db)
    line = f"{line}, migrated again {again == Ok(8)} form {after == Ok(2u8)} garbage {g} rows {r}"
  }
  let _ = store.close(take db)
  line
}

pub type Failed = Failed()

pub fn main(rt: Io) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Failed())
  }
  let Ok(tasks) = io.tasks(rt) else {
    return Error(Failed())
  }
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Failed())
  }
  let saw = task.scope(
    tasks,
    fn(s: Scope) -> u8 {
      let child = task.async(
        s,
        fn() -> u8 {
          task.scope(
            tasks,
            fn(inner: Scope) -> u8 {
              writer(inner, a)
            }
          )
        }
      )
      task.await(s, take child)
    }
  )
  let seen = task.scope(
    tasks,
    fn(sc: Scope) -> String {
      check(sc, a)
    }
  )
  match out.print(stdout, f"{said(saw)}: {seen}\n") {
    Ok(_) => Ok(()),
    Error(_) => Error(Failed()),
  }
}

/// The JWS algorithms this module signs and verifies (RFC 7518 section 3.1,
/// RFC 8037 section 3.1). "none" and every other name are unsupported.
pub type Alg: key = Hs256 | EdDsa | Es256 | Rs256 | Hs384 | Hs512

/// A non-empty set of accepted algorithms: first, then any others.
pub type Allow: shareable + send {
    first: Alg,
    rest: List[Alg]
}

/// Why a structure was refused before any key was used.
pub type Fault: send = Size | Segments | Encoding | Utf8 | Json | NotObject | Duplicate | MissingAlg

/// A claim check that failed.
pub type Claim: send = Iss | Aud | Exp

pub type Error: send = Malformed(Fault) | UnsupportedAlg | UnsupportedCrit | WrongKey | BadSignature | Expired | NotYetValid | Mismatch(Claim) | NoKey | AmbiguousKey | BadKey | UnsupportedKey | PrivateKey | Denied | Sign(KeyError)

/// The protected header members this module reads.
pub type Header: send {
    alg: Alg,
    kid: Option[String],
    typ: Option[String],
    cty: Option[String]
}

/// A verified JWS: its header and payload octets.
pub type Jws: send {
    header: Header,
    payload: Bytes
}

/// The registered claims of a verified JWT, and its whole claims object.
pub type Claims: send {
    iss: Option[String],
    sub: Option[String],
    aud: List[String],
    exp: Option[u64],
    nbf: Option[u64],
    iat: Option[u64],
    jti: Option[String],
    json: String
}

pub type Jwt: send {
    header: Header,
    claims: Claims
}

/// What a JWT must satisfy besides its signature. Times are seconds since
/// the epoch; leeway widens exp, nbf and iat by that many seconds.
pub type Rules: send {
    allow: Allow,
    now_secs: u64,
    leeway_secs: u64,
    iss: Option[String],
    aud: Option[String],
    require_exp: bool
}

type Family: key = Mac | RsaKey | EcKey | OkpKey

type PublicMaterial: shareable + send = EdPoint(Bytes) | EcPoint(Bytes) | RsaPublic(Bytes, Bytes)

type Material: send = MacKey(Secret) | Asymmetric(PublicMaterial)

type PublicKey: shareable + send {
    material: PublicMaterial,
    alg: Option[Alg],
    kid: Option[String]
}

/// A verification key: its material, the family that fixes which algorithms
/// can use it, an optional pinned algorithm and an optional key id.
pub opaque type Key: send {
    material: Material,
    alg: Option[Alg],
    kid: Option[String]
}

/// A JWK Set's signature keys, in document order.
pub opaque type KeySet: send {
    keys: List[Key]
}

/// A JWK Set's public signature keys, in document order.
pub opaque type PublicKeys: shareable + send {
    keys: List[PublicKey]
}

/// A signing key: the algorithm its Secret signs with, and an optional kid.
pub opaque type Signer: send {
    alg: Alg,
    key: Secret,
    random: Random,
    kid: Option[String]
}

/// Longest compact token accepted, in bytes.
pub const MAX_TOKEN: u64 = 65536

/// Longest JWK or JWK Set document accepted, in bytes.
pub const MAX_JWKS: u64 = 1048576

const U64_MAX: u64 = 18446744073709551615u64

/// The JWS "alg" spelling.
pub fn alg_name(a: Alg) -> String {
    match a {
        Hs256 => string.from("HS256"),
        Hs384 => string.from("HS384"),
        Hs512 => string.from("HS512"),
        EdDsa => string.from("EdDSA"),
        Es256 => string.from("ES256"),
        Rs256 => string.from("RS256"),
    }
}

fn parse_alg(s: String) -> Option[Alg] {
    if s == "HS256" {
        Some(Hs256)
    } else if s == "HS384" {
        Some(Hs384)
    } else if s == "HS512" {
        Some(Hs512)
    } else if s == "EdDSA" {
        Some(EdDsa)
    } else if s == "ES256" {
        Some(Es256)
    } else if s == "RS256" {
        Some(Rs256)
    } else {
        None
    }
}

fn family(a: Alg) -> Family {
    match a {
        Hs256 => Mac,
        Hs384 => Mac,
        Hs512 => Mac,
        EdDsa => OkpKey,
        Es256 => EcKey,
        Rs256 => RsaKey,
    }
}

// RFC 7518 section 3.2 requires a MAC key at least as long as the digest.
fn jws_mac(a: Alg) -> Option[(JwsMacAlg, u64)] {
    match a {
        Hs256 => Some((Sha256, 32)),
        Hs384 => Some((Sha384, 48)),
        Hs512 => Some((Sha512, 64)),
        _ => None,
    }
}

fn jws_mac_error(take e: JwsMacError) -> Error {
    match e {
        Denied => Denied,
        ShortKey => BadKey,
    }
}

fn public_family(m: PublicMaterial) -> Family {
    match m {
        EdPoint(_) => OkpKey,
        EcPoint(_) => EcKey,
        RsaPublic(_, _) => RsaKey,
    }
}

/// An allowlist of exactly one algorithm.
pub fn allow(a: Alg) -> Allow {
    Allow(first: a, rest: list.new())
}

fn allowed(accept: Allow, a: Alg) -> bool {
    accept.first == a || list.contains(accept.rest, a)
}

/// An HMAC key. Its Secret needs the `mac` or `verify` use.
pub fn hmac_key(take key: Secret) -> Key {
    Key(material: MacKey(take key), alg: None, kid: None)
}

fn ed_y_is(point: Bytes, y: Bytes) -> bool {
    (point[31] & 127u8) == y[31] && list.slice(point, 0, 31) == list.slice(y, 0, 31)
}

// The eight points killed by the cofactor have five distinct y coordinates.
// RFC 8032 section 5.1.5 stores the parity of x in bit 255.
fn invalid_ed_y(x: Bytes) -> bool {
    // p - 1 is small-order, and y >= p is noncanonical.
    if x[0] >= 236u8 && (x[31] & 127u8) == 127u8 && list.slice(x, 1, 31) == b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" {
        return true
    }
    ed_y_is(x, b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00") || ed_y_is(x, b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00") || ed_y_is(x, b"\x26\xe8\x95\x8f\xc2\xb2\x27\xb0\x45\xc3\xf4\x89\xf2\xef\x98\xf0\xd5\xdf\xac\x05\xd3\xc6\x33\x39\xb1\x38\x02\x88\x6d\x53\xfc\x05") || ed_y_is(x, b"\xc7\x17\x6a\x70\x3d\x4d\xd8\x4f\xba\x3c\x0b\x76\x0d\x10\x67\x0f\x2a\x20\x53\xfa\x2c\x39\xcc\xc6\x4e\xc7\xfd\x77\x92\xac\x03\x7a")
}

/// An Ed25519 public key: 32 bytes (RFC 8032 section 5.1.5), excluding small-order points.
pub fn ed25519_key(take x: Bytes) -> Result[Key, Error] {
    Ok(Key(material: Asymmetric(ed25519_material(take x)?), alg: None, kid: None))
}

fn ed25519_material(take x: Bytes) -> Result[PublicMaterial, Error] {
    if list.len(x) != 32 || invalid_ed_y(x) {
        return Error(BadKey)
    }
    Ok(EdPoint(take x))
}

/// A P-256 public key from its 32-byte affine coordinates.
pub fn p256_key(x: Bytes, y: Bytes) -> Result[Key, Error] {
    Ok(Key(material: Asymmetric(p256_material(x, y)?), alg: None, kid: None))
}

fn p256_material(x: Bytes, y: Bytes) -> Result[PublicMaterial, Error] {
    if list.len(x) != 32 || list.len(y) != 32 {
        return Error(BadKey)
    }
    let mut point: Bytes = list.with_capacity(65)
    list.push(mut point, 4u8)
    list.append(mut point, x)
    list.append(mut point, y)
    Ok(EcPoint(take point))
}

/// An RSA public key: minimal unsigned big-endian modulus of 2048 to 8192
/// bits and exponent of at most 4 bytes (RFC 7518 sections 3.3 and 6.3.1).
pub fn rsa_key(take n: Bytes, take e: Bytes) -> Result[Key, Error] {
    Ok(Key(material: Asymmetric(rsa_material(take n, take e)?), alg: None, kid: None))
}

fn rsa_material(take n: Bytes, take e: Bytes) -> Result[PublicMaterial, Error] {
    let n_len = list.len(n)
    let e_len = list.len(e)
    if n_len < 256 || n_len > 1024 || n[0] == 0 || (n_len == 256 && n[0] < 128u8) {
        return Error(BadKey)
    }
    if (n[n_len - 1] & 1u8) == 0 || e_len == 0 || e_len > 4 || e[0] == 0 || (e[e_len - 1] & 1u8) == 0 || (e_len == 1 && e[0] < 3u8) {
        return Error(BadKey)
    }
    Ok(RsaPublic(take n, take e))
}

/// The same key with kid set.
pub fn with_kid(take k: Key, take kid: String) -> Key {
    let mut out = take k
    out.kid = Some(take kid)
    out
}

/// The key's kid, if any.
pub fn key_id(k: Key) -> Option[View[String]] in k {
    match view k.kid {
        Some(s) => Some(s),
        None => None,
    }
}

/// A signer for alg. The Secret holds an HMAC key with the `mac` use for
/// HS256, HS384 or HS512, or a PKCS#8 private key with `sign(ed25519)`, `sign(p256)` or
/// `sign(rs256)` (TLS-5).
pub fn signer(alg: Alg, random: Random, take key: Secret) -> Signer {
    Signer(alg: alg, key: take key, random: random, kid: None)
}

/// The same signer, writing kid into the headers sign_jwt makes.
pub fn signer_with_kid(take s: Signer, take kid: String) -> Signer {
    let mut out = take s
    out.kid = Some(take kid)
    out
}

type HeaderSeen {
    alg: Option[String],
    kid: Option[String],
    typ: Option[String],
    cty: Option[String],
    crit: bool,
    unencoded: bool,
    dup: bool,
    names: set.Set[String]
}

fn json_fault(take _e: json.Error) -> Error {
    Malformed(Json)
}

fn object_start(s: String) -> bool {
    let b = string.as_bytes(s)
    let n = list.len(b)
    let mut i: u64 = 0
    while i < n && (b[i] == b' ' || b[i] == b'\t' || b[i] == b'\n' || b[i] == b'\r') {
        i += 1
    }
    i < n && b[i] == b'{'
}

fn decode_object[T](text: String, read: scoped fn(String, mut json.Cursor) -> Result[T, json.Error]) -> Result[T, Error] {
    if !object_start(text) {
        return Error(Malformed(NotObject))
    }
    let _ = json.size(text) ?=> json_fault
    Ok(json.decode(text, read) ?=> json_fault)
}

fn read_header_seen(s: String, mut c: json.Cursor) -> Result[HeaderSeen, json.Error] {
    let seed = HeaderSeen(alg: None, kid: None, typ: None, cty: None, crit: false, unencoded: false, dup: false, names: set.new())
    json.record_of(s, mut c, take seed, fn(key: String, input: String, mut v: json.Cursor, mut h: HeaderSeen) -> Result[(), json.Error] {
        if !set.insert(mut h.names, clone(key)) {
            h.dup = true
        }
        if key == "alg" {
            h.alg = Some(json.read_string(input, mut v)?)
        } else if key == "kid" {
            h.kid = Some(json.read_string(input, mut v)?)
        } else if key == "typ" {
            h.typ = Some(json.read_string(input, mut v)?)
        } else if key == "cty" {
            h.cty = Some(json.read_string(input, mut v)?)
        } else if key == "crit" {
            h.crit = true
            json.skip_value(input, mut v)?
        } else if key == "b64" {
            let b64 = json.read_bool(input, mut v)?
            h.unencoded = !b64
        } else {
            json.skip_value(input, mut v)?
        }
        Ok(())
    })
}

fn parse_header(text: String) -> Result[Header, Error] {
    let seen = decode_object(text, read_header_seen)?
    let HeaderSeen(alg: name, kid: kid, typ: typ, cty: cty, crit: crit, unencoded: unencoded, dup: dup, names: _) = take seen
    if dup {
        return Error(Malformed(Duplicate))
    }
    if crit || unencoded {
        return Error(UnsupportedCrit)
    }
    let Some(spelled) = view name else {
        return Error(Malformed(MissingAlg))
    }
    let Some(alg) = parse_alg(spelled) else {
        return Error(UnsupportedAlg)
    }
    Ok(Header(alg: alg, kid: take kid, typ: take typ, cty: take cty))
}

fn decode_segment(token: String, lo: u64, hi: u64) -> Result[Bytes, Error] {
    match base64.decode_url(string.as_bytes(string.slice(token, lo, hi)), false) {
        Some(take b) => Ok(take b),
        None => Error(Malformed(Encoding)),
    }
}

fn utf8(take b: Bytes) -> Result[String, Error] {
    match string.from_utf8(take b) {
        Ok(take s) => Ok(take s),
        Error(_) => Error(Malformed(Utf8)),
    }
}

type Compact {
    header: Header,
    signed: u64,
    payload: Bytes,
    signature: Bytes
}

// Exactly three canonical base64url segments (RFC 7515 sections 2 and 7.1).
fn allowed_compact(token: String, accept: Allow) -> Result[Compact, Error] {
    let b = string.as_bytes(token)
    let n = list.len(b)
    if n > MAX_TOKEN {
        return Error(Malformed(Size))
    }
    let Some(d1) = list.find_byte(b, 0, n, b'.') else {
        return Error(Malformed(Segments))
    }
    let Some(d2) = list.find_byte(b, d1 + 1, n, b'.') else {
        return Error(Malformed(Segments))
    }
    if list.find_byte(b, d2 + 1, n, b'.') != None {
        return Error(Malformed(Segments))
    }
    let header_text = utf8(decode_segment(token, 0, d1)?)?
    let header = parse_header(header_text)?
    let payload = decode_segment(token, d1 + 1, d2)?
    let signature = decode_segment(token, d2 + 1, n)?
    if !allowed(accept, header.alg) {
        return Error(UnsupportedAlg)
    }
    Ok(Compact(header: take header, signed: d2, payload: take payload, signature: take signature))
}

fn admit_key(alg: Alg, kind: Family, pin: Option[Alg]) -> Result[(), Error] {
    if family(alg) != kind || (pin != None && pin != Some(alg)) {
        Error(WrongKey)
    } else {
        Ok(())
    }
}

fn verify_public_signature(m: PublicMaterial, pin: Option[Alg], token: String, parts: Compact) -> Result[bool, Error] {
    admit_key(parts.header.alg, public_family(m), pin)?
    let input = list.slice(string.as_bytes(token), 0, parts.signed)
    let sig = view parts.signature
    Ok(match view m {
        EdPoint(x) => list.len(sig) == 64 && ed25519.verify(x, input, sig),
        EcPoint(point) => list.len(sig) == 64 && p256.verify(point, input, sig),
        RsaPublic(n, e) => list.len(sig) == list.len(n) && rsa.verify_pkcs1_sha256(n, e, input, sig),
    })
}

fn verify_with(token: String, take parts: Compact, k: Key) -> Result[Jws, Error] {
    let alg = parts.header.alg
    let good = match view k.material {
        MacKey(s) => {
            let Some((mac, _)) = jws_mac(alg) else {
                return Error(WrongKey)
            }
            admit_key(alg, Mac, k.alg)?
            let input = list.slice(string.as_bytes(token), 0, parts.signed)
            secret.jws_hmac_verify(s, mac, input, parts.signature) ?=> jws_mac_error
        },
        Asymmetric(m) => verify_public_signature(m, k.alg, token, parts)?,
    }
    checked_jws(take parts, good)
}

fn checked_jws(take parts: Compact, good: bool) -> Result[Jws, Error] {
    if !good {
        return Error(BadSignature)
    }
    let Compact(header: header, signed: _, payload: payload, signature: _) = take parts
    Ok(Jws(header: take header, payload: take payload))
}

/// Verifies a compact JWS with one key. The header's alg must be in allow and
/// in the key's family (and equal its pinned alg). Alloc: the decoded parts.
pub fn verify_jws(token: String, accept: Allow, k: Key) -> Result[Jws, Error] {
    let parts = allowed_compact(token, accept)?
    verify_with(token, take parts, k)
}

/// Verifies a compact JWS with the one key of set that its header's kid picks
/// (find's rule).
pub fn verify_jws_in(token: String, accept: Allow, keys: KeySet) -> Result[Jws, Error] {
    let parts = allowed_compact(token, accept)?
    let k = find(keys, parts.header.kid)?
    verify_with(token, take parts, k)
}

/// The one key whose kid equals kid. A missing kid picks the only key of a
/// one-key set. No match is NoKey; two matches, or no kid with more than one
/// key, is AmbiguousKey. Keys are never tried in turn.
pub fn find(keys: KeySet, kid: Option[String]) -> Result[View[Key], Error] in keys {
    let i = find_index(keys.keys, kid, fn(k: Key, want: String) -> bool {
        is(k.kid, want)
    })?
    Ok(view keys.keys[i])
}

fn find_index[T](keys: List[T], kid: Option[String], matches: scoped fn(T, String) -> bool) -> Result[u64, Error] {
    let n = list.len(keys)
    let Some(want) = view kid else {
        return match n {
            0 => Error(NoKey),
            1 => Ok(0),
            _ => Error(AmbiguousKey),
        }
    }
    let mut hit: Option[u64] = None
    for i in 0u64 .. n {
        if matches(keys[i], want) {
            if hit != None {
                return Error(AmbiguousKey)
            }
            hit = Some(i)
        }
    }
    match hit {
        Some(i) => Ok(i),
        None => Error(NoKey),
    }
}

type ClaimsSeen {
    iss: Option[String],
    sub: Option[String],
    aud: List[String],
    exp: Option[u64],
    nbf: Option[u64],
    iat: Option[u64],
    jti: Option[String],
    dup: bool,
    names: set.Set[String]
}

fn read_strings(s: String, mut c: json.Cursor) -> Result[List[String], json.Error] {
    if json.peek(s, c)? == JsonString {
        let mut one: List[String] = list.new()
        list.push(mut one, json.read_string(s, mut c)?)
        return Ok(take one)
    }
    json.list_of(s, mut c, json.read_string)
}

fn read_claims_seen(s: String, mut c: json.Cursor) -> Result[ClaimsSeen, json.Error] {
    let seed = ClaimsSeen(iss: None, sub: None, aud: list.new(), exp: None, nbf: None, iat: None, jti: None, dup: false, names: set.new())
    json.record_of(s, mut c, take seed, fn(key: String, input: String, mut v: json.Cursor, mut m: ClaimsSeen) -> Result[(), json.Error] {
        if !set.insert(mut m.names, clone(key)) {
            m.dup = true
        }
        if key == "iss" {
            m.iss = Some(json.read_string(input, mut v)?)
        } else if key == "sub" {
            m.sub = Some(json.read_string(input, mut v)?)
        } else if key == "aud" {
            m.aud = read_strings(input, mut v)?
        } else if key == "exp" {
            m.exp = Some(json.read_u64(input, mut v)?)
        } else if key == "nbf" {
            m.nbf = Some(json.read_u64(input, mut v)?)
        } else if key == "iat" {
            m.iat = Some(json.read_u64(input, mut v)?)
        } else if key == "jti" {
            m.jti = Some(json.read_string(input, mut v)?)
        } else {
            json.skip_value(input, mut v)?
        }
        Ok(())
    })
}

// RFC 7519 section 7.2 step 10: the payload is a JSON object, its names
// unique. NumericDate is accepted as a non-negative integer only.
fn parse_claims(text: String) -> Result[ClaimsSeen, Error] {
    let seen = decode_object(text, read_claims_seen)?
    if seen.dup {
        return Error(Malformed(Duplicate))
    }
    Ok(take seen)
}

fn later(now: u64, leeway: u64) -> u64 {
    if now > U64_MAX - leeway {
        U64_MAX
    } else {
        now + leeway
    }
}

// Leeway moves only the trusted clock, so no claim value can overflow.
fn check_claims(c: ClaimsSeen, r: Rules) -> Result[(), Error] {
    match c.exp {
        Some(exp) => {
            if r.now_secs >= r.leeway_secs && exp <= r.now_secs - r.leeway_secs {
                return Error(Expired)
            }
        },
        None => {
            if r.require_exp {
                return Error(Mismatch(Exp))
            }
        },
    }
    let future = later(r.now_secs, r.leeway_secs)
    match c.nbf {
        Some(nbf) if nbf > future => return Error(NotYetValid),
        _ => {},
    }
    match c.iat {
        Some(iat) if iat > future => return Error(NotYetValid),
        _ => {},
    }
    match view r.iss {
        Some(want) => {
            let same = match view c.iss {
                Some(have) => have == want,
                None => false,
            }
            if !same {
                return Error(Mismatch(Iss))
            }
        },
        None => {},
    }
    // RFC 7519 section 4.1.3: a present aud that does not name us rejects.
    match view r.aud {
        Some(want) => {
            if !list.contains(c.aud, want) {
                return Error(Mismatch(Aud))
            }
        },
        None => {
            if set.contains(c.names, "aud") {
                return Error(Mismatch(Aud))
            }
        },
    }
    Ok(())
}

fn finish_jwt(take jws: Jws, r: Rules) -> Result[Jwt, Error] {
    let Jws(header: header, payload: payload) = take jws
    let text = utf8(take payload)?
    let seen = parse_claims(text)?
    check_claims(seen, r)?
    let ClaimsSeen(iss: iss, sub: sub, aud: aud, exp: exp, nbf: nbf, iat: iat, jti: jti, dup: _, names: _) = take seen
    let claims = Claims(iss: take iss, sub: take sub, aud: take aud, exp: exp, nbf: nbf, iat: iat, jti: take jti, json: take text)
    Ok(Jwt(header: take header, claims: take claims))
}

/// Verifies a JWT with one key: the signature as verify_jws, then the claims
/// against r. Claims are read only after the signature verifies.
pub fn verify_jwt(token: String, r: Rules, k: Key) -> Result[Jwt, Error] {
    finish_jwt(verify_jws(token, r.allow, k)?, r)
}

/// verify_jwt with the key of set that the header's kid picks.
pub fn verify_jwt_in(token: String, r: Rules, keys: KeySet) -> Result[Jwt, Error] {
    finish_jwt(verify_jws_in(token, r.allow, keys)?, r)
}

/// Verifies a JWT with the public key selected by find's kid rule.
/// Claims are read only after the signature verifies.
pub fn verify_jwt_public(token: String, r: Rules, keys: PublicKeys) -> Result[Jwt, Error] {
    let parts = allowed_compact(token, r.allow)?
    let i = find_index(keys.keys, parts.header.kid, fn(k: PublicKey, want: String) -> bool {
        is(k.kid, want)
    })?
    let k = view keys.keys[i]
    let good = verify_public_signature(k.material, k.alg, token, parts)?
    finish_jwt(checked_jws(take parts, good)?, r)
}

fn sign_bytes(s: Signer, input: Bytes) -> Result[Bytes, Error] {
    if let Some((mac, tag_len)) = jws_mac(s.alg) {
        let tag = match secret.jws_hmac_sign(s.key, mac, input) {
            Ok(tag) => tag,
            Error(take e) => return Error(jws_mac_error(take e)),
        }
        let mut out: Bytes = list.with_capacity(tag_len)
        let _ = bytebuf.append_inline(mut out, tag, 0, tag_len)
        return Ok(take out)
    }
    let alg: SignAlg = match s.alg {
        EdDsa => Ed25519,
        Es256 => P256,
        Rs256 => Rs256,
        _ => return Error(WrongKey),
    }
    let mut out: Bytes = list.with_capacity(1024)
    match secret.sign(s.key, alg, s.random, input, mut out) {
        Ok(_) => Ok(take out),
        Error(Denied) => Error(Denied),
        Error(e) => Error(Sign(e)),
    }
}

fn encoded_len(n: u64) -> u64 {
    n + (n + 2) / 3
}

fn minimum_signature_len(alg: Alg) -> u64 {
    match family(alg) {
        Mac => {
            let (_, tag_len) = option.unwrap(jws_mac(alg))
            tag_len
        },
        OkpKey => 64,
        EcKey => 64,
        RsaKey => 256,
    }
}

fn check_token_size(header_len: u64, payload_len: u64, sig_len: u64) -> Result[(), Error] {
    if header_len > MAX_TOKEN || payload_len > MAX_TOKEN || encoded_len(header_len) + encoded_len(payload_len) + encoded_len(sig_len) + 2 > MAX_TOKEN {
        return Error(Malformed(Size))
    }
    Ok(())
}

/// Signs payload under the given protected header text, which must parse as
/// verify reads it and name the signer's alg. Alloc: the token.
pub fn sign_jws(s: Signer, header: String, payload: Bytes) -> Result[String, Error] {
    let header_len = string.byte_len(header)
    let payload_len = list.len(payload)
    check_token_size(header_len, payload_len, minimum_signature_len(s.alg))?
    let parsed = parse_header(header)?
    if parsed.alg != s.alg {
        return Error(WrongKey)
    }
    let mut token = base64.encode_url(string.as_bytes(header), false)
    string.push(mut token, ".")
    string.push(mut token, base64.encode_url(payload, false))
    let sig = sign_bytes(s, string.as_bytes(token))?
    check_token_size(header_len, payload_len, list.len(sig))?
    string.push(mut token, ".")
    string.push(mut token, base64.encode_url(sig, false))
    Ok(take token)
}

/// Signs a claims object as a JWT with header {"alg":..,"typ":"JWT"} and
/// the signer's kid. The claims must parse as verify_jwt reads them.
pub fn sign_jwt(s: Signer, claims: String) -> Result[String, Error] {
    let alg = alg_name(s.alg)
    let mut header_len = string.byte_len("{\"alg\":\"\",\"typ\":\"JWT\"}") + string.byte_len(alg)
    if let Some(kid) = view s.kid {
        let kid_len = string.byte_len(kid)
        if kid_len > MAX_TOKEN {
            return Error(Malformed(Size))
        }
        header_len += string.byte_len(",\"kid\":\"\"") + kid_len
    }
    check_token_size(header_len, string.byte_len(claims), minimum_signature_len(s.alg))?
    let _ = parse_claims(claims)?
    let mut header = string.from("{\"alg\":\"")
    string.push(mut header, alg)
    string.push(mut header, "\",\"typ\":\"JWT\"")
    match view s.kid {
        Some(kid) => {
            string.push(mut header, ",\"kid\":")
            json.write(mut header, false, scoped fn(w: json.Writer) {
                json.write_string_value(w, kid)
            })
        },
        None => {},
    }
    string.push(mut header, "}")
    sign_jws(s, header, string.as_bytes(claims))
}

// ---- JWK (RFC 7517 section 4, RFC 7518 section 6, RFC 8037 section 2) ----
type JwkSeen {
    kty: Option[String],
    crv: Option[String],
    alg: Option[String],
    usage: Option[String],
    ops: Option[List[String]],
    kid: Option[String],
    x: Option[String],
    y: Option[String],
    n: Option[String],
    e: Option[String],
    k: Option[String],
    private: bool,
    dup: bool,
    names: set.Set[String]
}

fn read_jwk_seen(s: String, mut c: json.Cursor) -> Result[JwkSeen, json.Error] {
    let seed = JwkSeen(kty: None, crv: None, alg: None, usage: None, ops: None, kid: None, x: None, y: None, n: None, e: None, k: None, private: false, dup: false, names: set.new())
    json.record_of(s, mut c, take seed, fn(key: String, input: String, mut v: json.Cursor, mut j: JwkSeen) -> Result[(), json.Error] {
        if !set.insert(mut j.names, clone(key)) {
            j.dup = true
        }
        if key == "kty" {
            j.kty = Some(json.read_string(input, mut v)?)
        } else if key == "crv" {
            j.crv = Some(json.read_string(input, mut v)?)
        } else if key == "alg" {
            j.alg = Some(json.read_string(input, mut v)?)
        } else if key == "use" {
            j.usage = Some(json.read_string(input, mut v)?)
        } else if key == "key_ops" {
            j.ops = Some(json.list_of(input, mut v, json.read_string)?)
        } else if key == "kid" {
            j.kid = Some(json.read_string(input, mut v)?)
        } else if key == "x" {
            j.x = Some(json.read_string(input, mut v)?)
        } else if key == "y" {
            j.y = Some(json.read_string(input, mut v)?)
        } else if key == "n" {
            j.n = Some(json.read_string(input, mut v)?)
        } else if key == "e" {
            j.e = Some(json.read_string(input, mut v)?)
        } else if key == "k" {
            j.k = Some(json.read_string(input, mut v)?)
        } else if key == "d" || key == "p" || key == "q" || key == "dp" || key == "dq" || key == "qi" || key == "oth" {
            j.private = true
            json.skip_value(input, mut v)?
        } else {
            json.skip_value(input, mut v)?
        }
        Ok(())
    })
}

fn member(m: Option[String]) -> Result[Bytes, Error] {
    match view m {
        Some(text) => match base64.decode_url(string.as_bytes(text), false) {
            Some(take b) => Ok(take b),
            None => Error(BadKey),
        },
        None => Error(BadKey),
    }
}

fn is(m: Option[String], want: String) -> bool {
    match view m {
        Some(v) => v == want,
        None => false,
    }
}

fn check_key_ops(usage: Option[String], ops: List[String]) -> Result[(), Error] {
    let sig = is(usage, "sig")
    let enc = is(usage, "enc")
    let mut names: set.Set[String] = set.new()
    for op in ops {
        if !set.insert(mut names, clone(op)) {
            return Error(BadKey)
        }
        if sig && op != "sign" && op != "verify" {
            return Error(BadKey)
        }
        if enc && op != "encrypt" && op != "decrypt" && op != "wrapKey" && op != "unwrapKey" && op != "deriveKey" && op != "deriveBits" {
            return Error(BadKey)
        }
    }
    Ok(())
}

// None skips a key; Some carries the optional pin of a verification key.
fn jwk_policy(j: JwkSeen, public_only: bool) -> Result[Option[Option[Alg]], Error] {
    if j.dup {
        return Error(Malformed(Duplicate))
    }
    if j.private {
        return Error(PrivateKey)
    }
    let Some(kind) = view j.kty else {
        return Error(BadKey)
    }
    if public_only && kind == "oct" {
        return Error(UnsupportedKey)
    }
    if let Some(list_ops) = view j.ops {
        check_key_ops(j.usage, list_ops)?
        if !list.contains(list_ops, "verify") {
            return Ok(None)
        }
    }
    if j.usage != None && !is(j.usage, "sig") {
        return Ok(None)
    }
    match view j.alg {
        Some(name) => match parse_alg(name) {
            Some(a) => Ok(Some(Some(a))),
            None => Ok(None),
        },
        None => Ok(Some(None)),
    }
}

fn jwk_public_key(take j: JwkSeen, pin: Option[Alg]) -> Result[Option[PublicKey], Error] {
    let JwkSeen(kty: kty, crv: crv, alg: _, usage: _, ops: _, kid: kid, x: x, y: y, n: n, e: e, k: _, private: _, dup: _, names: _) = take j
    let material = if is(kty, "RSA") {
        rsa_material(member(n)?, member(e)?)?
    } else if is(kty, "EC") && is(crv, "P-256") {
        p256_material(member(x)?, member(y)?)?
    } else if is(kty, "OKP") && is(crv, "Ed25519") {
        ed25519_material(member(x)?)?
    } else {
        return Ok(None)
    }
    match pin {
        Some(a) if family(a) != public_family(material) => return Error(BadKey),
        _ => {},
    }
    Ok(Some(PublicKey(material: take material, alg: pin, kid: take kid)))
}

fn jwk_key(take j: JwkSeen) -> Result[Option[Key], Error] {
    let Some(pin) = jwk_policy(j, false)? else {
        return Ok(None)
    }
    if !is(j.kty, "oct") {
        let Some(take k) = jwk_public_key(take j, pin)? else {
            return Ok(None)
        }
        let PublicKey(material: material, alg: alg, kid: kid) = take k
        return Ok(Some(Key(material: Asymmetric(take material), alg: alg, kid: take kid)))
    }
    let JwkSeen(kty: _, crv: _, alg: _, usage: _, ops: _, kid: kid, x: _, y: _, n: _, e: _, k: k, private: _, dup: _, names: _) = take j
    let raw = member(k)?
    let min_len = match pin {
        Some(a) => match jws_mac(a) {
            Some((_, minimum)) => minimum,
            None => return Error(BadKey),
        },
        None => 32,
    }
    if list.len(raw) < min_len {
        return Error(BadKey)
    }
    match secret.seal(take raw, "verify") {
        Ok(take sealed) => Ok(Some(Key(material: MacKey(take sealed), alg: pin, kid: take kid))),
        Error(_) => Error(BadKey),
    }
}

/// Parses one public JWK (RSA, EC P-256, OKP Ed25519) or HMAC JWK ("oct",
/// whose k is sealed as a Secret with the `verify` use). A key for another
/// use or algorithm is UnsupportedKey; private members are PrivateKey.
pub fn jwk(text: String) -> Result[Key, Error] {
    if string.byte_len(text) > MAX_JWKS {
        return Error(Malformed(Size))
    }
    let seen = decode_object(text, read_jwk_seen)?
    let usable = jwk_key(take seen)?
    match take usable {
        Some(take k) => Ok(take k),
        None => Error(UnsupportedKey),
    }
}

type SetSeen {
    keys: Option[List[JwkSeen]],
    dup: bool,
    names: set.Set[String]
}

fn read_set_seen(s: String, mut c: json.Cursor) -> Result[SetSeen, json.Error] {
    let seed = SetSeen(keys: None, dup: false, names: set.new())
    json.record_of(s, mut c, take seed, fn(key: String, input: String, mut v: json.Cursor, mut st: SetSeen) -> Result[(), json.Error] {
        if !set.insert(mut st.names, clone(key)) {
            st.dup = true
        }
        if key == "keys" {
            st.keys = Some(json.list_of(input, mut v, read_jwk_seen)?)
        } else {
            json.skip_value(input, mut v)?
        }
        Ok(())
    })
}

fn read_jwks[T](text: String, decode: scoped fn(take JwkSeen) -> Result[Option[T], Error]) -> Result[List[T], Error] {
    if string.byte_len(text) > MAX_JWKS {
        return Error(Malformed(Size))
    }
    let seen = decode_object(text, read_set_seen)?
    let SetSeen(keys: raw, dup: dup, names: _) = take seen
    if dup {
        return Error(Malformed(Duplicate))
    }
    let Some(take raw_keys) = take raw else {
        return Error(BadKey)
    }
    let mut keys: List[T] = list.new()
    for take j in take raw_keys {
        let usable = decode(take j)?
        match take usable {
            Some(take k) => list.push(mut keys, take k),
            None => {},
        }
    }
    Ok(take keys)
}

/// Parses a JWK Set. Keys this module cannot use for JWS verification are
/// left out (RFC 7517 section 5); any malformed or private key fails the set.
pub fn jwks(text: String) -> Result[KeySet, Error] {
    Ok(KeySet(keys: read_jwks(text, jwk_key)?))
}

/// Parses a public JWK Set. Any "oct" key fails the document, even if its
/// metadata would otherwise exclude it from verification.
pub fn jwks_public(text: String) -> Result[PublicKeys, Error] {
    let keys = read_jwks(text, fn(take j: JwkSeen) -> Result[Option[PublicKey], Error] {
        let Some(pin) = jwk_policy(j, true)? else {
            return Ok(None)
        }
        jwk_public_key(take j, pin)
    })?
    Ok(PublicKeys(keys: take keys))
}

/// A set of keys the caller built, such as sealed HMAC keys, in order for find.
pub fn key_set(take keys: List[Key]) -> KeySet {
    KeySet(keys: take keys)
}

/// The number of usable keys in the set.
pub fn len(keys: KeySet) -> u64 {
    list.len(keys.keys)
}

/// The number of usable public keys in the set.
pub fn public_len(keys: PublicKeys) -> u64 {
    list.len(keys.keys)
}

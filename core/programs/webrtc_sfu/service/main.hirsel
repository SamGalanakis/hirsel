// The SFU deployment on one host (webrtc.md S7 and N1; turn.md U8 and TURN-8): one process
// runs three places side by side.
// - The room place: a runner place with numbered rooms whose message is `webrtc_sfu.signal.Signal`. It
//   serves the browser page and the WebSocket wire on `--listen`.
// - The SFU (`webrtc_sfu.signal.serve_pool`): `--units` media units on consecutive UDP ports from
//   `--media`, joined to the room through `room_client`.
// - The TURN relay place: a UDP socket and a TCP listener on `--turn`, and a pool of
//   relayed addresses. Its policy is the relay-only one (TURN-7): it relays only to the
//   media units' ports. Signaling mints each admission's TURN credentials from the master
//   the relay shares, and forwards each ended admission's revoke to it (TURN-9).
// Stdout, one event per line: `listening <port>`, `turn <udp|tcp> <conn> <hex>` for each
// STUN request a TURN client sends (the browsers' requests, for N1's captures),
// `allocations <count>`, `revoked <subject> <deleted>`, `served <error>`.
const SECOND: u64 = 1000000000

// Each credential's lifetime, from its mint (turn.md U8: the relay's credential_max_s).
const LIFETIME_S: u32 = 3600

fn admit(tx: store.Tx, unused: (), author: runner.Caller, take argument: u32) -> Result[runner.Answer[runner.Grant], Capacity] {
    Ok(runner.Answer(value: Join, covers: runner.covers()))
}

fn room(mut reg: runner.Registry[(), ()]) -> Result[(), runner.RegisterError] {
    let state: std.codec.Codec[List[Bytes]] = std.codec.of()
    let message: std.codec.Codec[webrtc_sfu.signal.Signal] = std.codec.of()
    runner.room(mut reg, code.describe(admit), runner.slots(), state, message, runner.RoomBounds(peers: config.WIRE_PEERS, state: runner.STATE_MAX, message: runner.MESSAGE_MAX), 4096u64, config.ROOM_ARG_BYTES, runner.DEFAULT_STEPS)
}

fn schema(mut d: store.Declare) -> Result[(), store.Error] {
    Ok(())
}

fn asset(path: Bytes) -> Option[std.wsock.Asset] {
    let mut end = list.len(path)
    for i in 0u64 .. list.len(path) {
        if path[i] == b'?' && end == list.len(path) {
            end = i
        }
    }
    let bare = list.slice(path, 0, end)
    if bare == b"/" {
        return Some(std.wsock.Asset(name: string.from("index.html"), content_type: string.from("text/html; charset=utf-8")))
    }
    if bare == b"/client.js" {
        return Some(std.wsock.Asset(name: string.from("client.js"), content_type: string.from("text/javascript; charset=utf-8")))
    }
    None
}

fn say(out: Stdout, line: String) waits {
    let mut text = string.from(line)
    string.push(mut text, "\n")
    let _ = stdout.write(out, text)
}

fn say_number(out: Stdout, tag: String, n: u64) waits {
    let mut line = string.from(tag)
    string.push(mut line, " ")
    string.push_u64(mut line, n)
    say(out, line)
}

fn zeros(n: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(n)
    list.fill(mut b, n, 0)
    b
}

// ---- The room place ----
type Operated: send {
    config: runner.PlaceConfig[(), (), ()],
    stop: Receiver[()],
    status: Latest[runner.Status]
}

fn run_place(take o: Operated) -> Result[runner.Ended, runner.StartError] waits {
    let Operated(config: take config, stop: take stop, status: status) = take o
    runner.operate(take config, take stop, status, None)
}

fn place_config(n: Net, web: Dir, c: Clock, random: Random, tasks: Tasks, listen: Addr, owners: u64, relay_bytes: u64) -> runner.PlaceConfig[(), (), ()] {
    let mut session = runner.wire_defaults(262144u64)
    session.n_pool = 33554432u64
    session.n_relay = relay_bytes
    session.site = Some(std.wsock.Site(dir: web, find: asset))
    runner.PlaceConfig(backing: Memory, sizes: store.derived_sizes(), selection: Current(0u64), place: code.describe(room), n_place: 1048576u64, on_migrate: None, schema: code.describe(schema), session: session, max_sessions: owners, proxies: list.new(), n_publisher: 4194304u64, listen: Tcp(listen), net: n, tasks: tasks, clock: c, random: random, stop: runner.Stop(lag_ms: 1u64, grace_ms: 1000u64), wire: None, grants: None, triggers: None, idle: None)
}

// The relay-only plan (TURN-7): relay only to the media units' ports, from the TURN host.
fn plan_of(media_ip: u32, lo: u16, hi: u16, turn_ip: Ip) -> webrtc_sfu.signal.RelayPlan {
    let mut media: List[turn.Allow] = list.new()
    list.push(mut media, turn.Allow(prefix: turn.Prefix(ip: V4(media_ip), bits: 32), ports_lo: lo, ports_hi: hi))
    let mut host_ips: List[Ip] = list.new()
    list.push(mut host_ips, turn_ip)
    webrtc_sfu.signal.RelayPlan(realm: b"hirsel-sfu", lifetime_s: LIFETIME_S, media: take media, host: take host_ips)
}

// ---- The process ----
fn sealed(b: Bytes, uses: String) -> Option[Secret] {
    match secret.seal(clone(b), uses) {
        Ok(take s) => Some(take s),
        Error(_) => None,
    }
}

// `hirsel sdk ts` runs the program to describe its place: launch_server answers that
// before any capability use.
pub fn main(a: Args, n: Net, web: Dir, clock: Clock, random: Random, tasks: Tasks, out: Stdout) -> Result[(), Exit] waits {
    runner.launch_server(a, clock, code.describe(room), code.describe(schema), scoped fn() -> Result[(), Exit] waits {
        run(a, n, web, clock, random, tasks, out)
    })
}

fn run(a: Args, n: Net, web: Dir, clock: Clock, random: Random, tasks: Tasks, out: Stdout) -> Result[(), Exit] waits {
    let c = match config.parse(a) {
        Ok(c) => c,
        Error(e) => {
            say(out, config.message(e))
            return Error(Exit(status: 2u8))
        },
    }
    let start = host.mono_ns(clock)
    let until = if c.seconds == 0 {
        0xffffffffffffffffu64
    } else {
        int.saturating_add(start, int.saturating_mul(c.seconds, SECOND))
    }
    // The room place.
    let room_config = place_config(n, web, clock, random, tasks, c.listen, c.owners, c.relay_bytes)
    let Ok(overhead) = runner.operate_bytes(room_config) else {
        say(out, "the signaling room plan does not fit")
        return Error(Exit(status: 3u8))
    }
    let Ok(root) = runner.status_root() else {
        return Error(Exit(status: 3u8))
    }
    let (halt, stop): (Sender[()], Receiver[()]) = channel.new(1u64)
    let place = Operated(config: take room_config, stop: take stop, status: latest.handle(root))
    let need = overhead + 1074790400u64 + 1048576u64
    let Ok(running) = task.try_spawn(tasks, bytes need + 16777216u64, take place, run_place) else {
        say(out, "the room place does not fit")
        return Error(Exit(status: 3u8))
    }
    // The relay place, configured from the plan signaling mints by.
    let plan = plan_of(c.media_ip, c.media_lo, c.media_hi, c.turn.ip)
    let mut master_bytes = zeros(32)
    host.random(random, mut master_bytes)
    let mut nonce_bytes = zeros(32)
    host.random(random, mut nonce_bytes)
    let (Some(take relay_master), Some(take nonce), Some(take signal_master)) = (sealed(master_bytes, "mac kdf"), sealed(nonce_bytes, "mac"), sealed(master_bytes, "mac")) else {
        return Error(Exit(status: 3u8))
    }
    list.fill(mut master_bytes, 32, 0)
    let (revoke_to, revoked): (Sender[webrtc_sfu.signal.RelayRevoke], Receiver[webrtc_sfu.signal.RelayRevoke]) = channel.new(256u64)
    let (relay_ready, relay_started): (Sender[()], Receiver[()]) = channel.new(1u64)
    let relay_start = webrtc_sfu.turn_runtime.Start(net: n, clock: clock, random: random, out: out, listen: c.turn, master: take relay_master, nonce: take nonce, plan: clone(plan), sockets: c.relay_sockets, revokes: take revoked, ready: take relay_ready, until: until)
    let relay_need = webrtc_sfu.turn_runtime.reserve_bytes(c.relay_sockets)
    let Ok(relaying) = task.try_spawn(tasks, bytes relay_need, take relay_start, webrtc_sfu.turn_runtime.run) else {
        say_number(out, "the relay place needs bytes", relay_need)
        let _ = channel.send(halt, ())
        let _ = task.join(take running)
        return Error(Exit(status: 3u8))
    }
    if let Error(_) = channel.receive(relay_started) {
        let _ = channel.send(halt, ())
        let _ = task.join(take relaying)
        let _ = task.join(take running)
        return Error(Exit(status: 3u8))
    }
    say_number(out, "listening", int.widen(c.listen.port))
    // The SFU, on this task.
    let keys = match runner.client.entry_keys(code.describe(room)) {
        Ok(take k) => take k,
        Error(_) => return Error(Exit(status: 3u8)),
    }
    // A quiet room sends nothing for as long as nobody signals; the client pings after
    // `idle_ms` with nothing read and calls the link lost only when that ping goes unanswered
    // for another `idle_ms`.
    let mut binds: List[Addr] = list.new()
    for k in 0u16 .. c.pool.units {
        list.push(mut binds, Addr(ip: V4(c.media_ip), port: c.media_lo + k))
    }
    let (order_to, orders): (Sender[webrtc_sfu.signal.PoolOrder[webrtc_sfu.signal.Signal]], Receiver[webrtc_sfu.signal.PoolOrder[webrtc_sfu.signal.Signal]]) = channel.new(int.widen(c.pool.rooms))
    let (reports, _reported): (Sender[webrtc_sfu.signal.PoolReport], Receiver[webrtc_sfu.signal.PoolReport]) = channel.new(int.widen(c.pool.rooms))
    for i in 0u32 .. c.pool.rooms {
        let mut arg: Bytes = list.with_capacity(config.ROOM_ARG_BYTES)
        std.codec.put_u32(i, mut arg)
        let name = webrtc_sfu.signal.room_name(arg)
        let dial = runner.room_client.Dial(tasks, net: n, address: c.listen, clock: clock, random, keys: clone(keys), token: None, socket: runner.wire_defaults(262144u64).socket, entry: 0u32, arg: take arg, within_ms: 5000u64, idle_ms: 10000u64)
        let embed = webrtc_sfu.signal.Embed(wrap: fn(take m: webrtc_sfu.signal.Signal) -> webrtc_sfu.signal.Signal {
            take m
        }, unwrap: fn(take m: webrtc_sfu.signal.Signal) -> Option[webrtc_sfu.signal.Signal] {
            Some(take m)
        }, admit: fn(j: webrtc_sfu.signal.PeerJoin) -> webrtc_sfu.signal.PeerRights {
            webrtc_sfu.signal.PeerRights(publish: true)
        })
        let _ = channel.send(order_to, Open(name: name, dial: take dial, limits: c.limits, embed: take embed))
    }
    let pool = webrtc_sfu.signal.Pool(tasks, net: n, clock, random, binds: binds, policy: webrtc_sfu.sdp.default_policy(), session: c.session, limits: c.pool, timing: webrtc_sfu.signal.DEFAULT_TIMING, queues: c.queues, orders: take orders, reports: take reports, until: until, relay: Some(webrtc_sfu.signal.RelayLink(master: take signal_master, plan: take plan, revokes: take revoke_to)), bridge: None)
    match webrtc_sfu.signal.serve_pool(take pool) {
        Ok(_) => (),
        Error(e) => {
            let mut line = string.from("served error ")
            string.push_u64(mut line, match e {
                Router(re) => int.widen(webrtc_sfu.signal.code(re)),
                Bind(_) => 100,
                Identity => 101,
                Spawn => 102,
                Units => 103,
                Timers => 104,
                Queues => 105,
                Bridge(_) => 106,
            })
            say(out, line)
        },
    }
    let _ = channel.send(halt, ())
    let _ = task.join(take relaying)
    let _ = task.join(take running)
    Ok(())
}

// WT-2 and WT-3: one Endpoint serves both roles over one quic.Endpoint. It reads and writes
// the HTTP/3 control and QPACK streams itself (RFC 9114 §6.2, RFC 9204 §4.2) and hands the
// application only session events.
pub type SessionHandle: key = SessionHandle(conn: quic.ConnectionHandle, id: quic.StreamId)

pub type Limits {
    authorities: List[String],
    origins: List[String],
    require_origin: bool,
    sessions: u16,
    sessions_per_connection: u16,
    pending_connects: u16,
    streams_bidi: u64,
    streams_uni: u64,
    data: u64,
    buffered: u16,
    buffered_datagrams: u16,
    header_bytes: u32
}

pub type Request {
    authority: String,
    path: String,
    origin: Option[String],
    protocols: List[String],
    headers: List[(String, String)]
}

pub type Verdict = Accept(protocol: Option[String], headers: List[(String, String)]) | Refuse(status: u16)

pub type Event = Requested(SessionHandle, Request) | Ready(s: SessionHandle, protocol: Option[String]) | Refused(s: SessionHandle, status: u16) | Stream(s: SessionHandle, stream: quic.StreamId, bidi: bool) | Readable(SessionHandle, quic.StreamId) | Writable(SessionHandle, quic.StreamId) | Reset(s: SessionHandle, stream: quic.StreamId, code: Option[u32], final_size: u64) | Stopped(s: SessionHandle, stream: quic.StreamId, code: Option[u32]) | Datagram(SessionHandle, Bytes) | Draining(SessionHandle) | Closed(s: SessionHandle, code: u32, reason: Bytes)

/// UnknownSession names no session this endpoint holds; State is a call the session's phase
/// does not allow (an answer to a session already answered); Url is a connect URL that is not
/// https://authority/path.
pub type WtError = UnknownSession | State | Url | Blocked | Quic(quic.QuicError)

/// A session's phase. Server: Reading until its HEADERS frame is whole, Held until the
/// peer's SETTINGS arrive (draft-17 §3.1), Asked until answer, then Live. Client: Unsent
/// until the server's SETTINGS allow a CONNECT, Awaiting its response, then Live.
type Phase = Reading | Held(List[qpack.Field]) | Asked | Live | Unsent(authority: String, path: String, protocols: List[String]) | Awaiting

/// A WebTransport stream of a session (WT-4). header is the length of the header we wrote
/// on a stream we opened, which RESET_STREAM_AT keeps (draft-17 §4.4); recv and send say
/// which halves are still open.
type Owned {
    id: quic.StreamId,
    header: u64,
    recv_header: u64,
    received: u64,
    written: u64,
    fin_queued: bool,
    consumed: u64,
    discarded: bool,
    reset: bool,
    waiting: u64,
    recv: bool,
    send: bool
}

/// buf holds the CONNECT stream's unread bytes; skip is the rest of a frame being skipped.
/// Live, data_left is the rest of a DATA frame's payload, whose bytes are capsules
/// (RFC 9297 §3) gathered in caps; cap_skip is the rest of a capsule being skipped.
type Session {
    id: quic.StreamId,
    phase: Phase,
    buf: Bytes,
    skip: u64,
    data_left: u64,
    caps: Bytes,
    cap_skip: u64,
    drained: bool,
    streams: List[Owned],
    rx: Credit,
    tx: Credit
}

/// Bytes a stream did not take yet, sent on its next Writable.
type Outgoing {
    id: quic.StreamId,
    data: Bytes,
    fin: bool
}

/// A peer stream whose leading varints are not whole yet: its type (uni) or signal (bidi),
/// then, once kind is 0x54 or 0x41, its session id (WT-4).
type Head {
    id: quic.StreamId,
    bidi: bool,
    buf: Bytes,
    kind: Option[u64],
    kind_len: u64,
    reset: Option[ResetInfo]
}

/// A peer WT stream whose session is not live yet, held by its header alone (WT-4).
type Parked {
    id: quic.StreamId,
    sid: u64,
    since: u64,
    header: u64,
    reset: Option[ResetInfo]
}

type ParkedDatagram {
    sid: u64,
    data: Bytes,
    since: u64
}

type Destination {
    addr: Addr,
    authority: String,
    pins: List[quic.handshake.Pin]
}

type Conn {
    handle: quic.ConnectionHandle,
    client: bool,
    up: bool,
    settings: bool,
    peer_ok: bool,
    peer_credit: Credit,
    destination: Option[Destination],
    goaway: Option[u64],
    control: Option[quic.StreamId],
    encoder: Option[quic.StreamId],
    decoder: Option[quic.StreamId],
    local: List[quic.StreamId],
    control_buf: Bytes,
    control_skip: u64,
    decoder_buf: Bytes,
    heads: List[Head],
    parked: List[Parked],
    parked_datagrams: List[ParkedDatagram],
    peer_bidi_next: u64,
    sessions: List[Session],
    out: List[Outgoing]
}

pub opaque type Endpoint {
    limits: Limits,
    conns: List[Conn],
    live: u64,
    now: u64,
    backlog: List[Event],
    dropped: u64
}

/// The largest SETTINGS payload read; a larger one is H3_EXCESSIVE_LOAD.
const SETTINGS_MAX: u64 = 4096

pub fn endpoint(take limits: Limits) -> Endpoint {
    Endpoint(limits: take limits, conns: list.new(), live: 0, now: 0, backlog: list.new(), dropped: 0)
}

/// The QUIC transport both roles use: draft-17 §3.1 needs QUIC datagrams and RESET_STREAM_AT;
/// the stream credit covers the three critical streams, the CONNECT streams and each
/// session's WT streams.
pub fn transport(limits: Limits) -> quic.TransportConfig {
    let mut alpn: List[String] = list.with_capacity(1)
    list.push(mut alpn, "h3")
    let per: u64 = int.widen(limits.sessions_per_connection)
    let held: u64 = int.widen(limits.pending_connects)
    let buffered: u64 = int.widen(limits.buffered)
    let header: u64 = int.widen(limits.header_bytes)
    let sessions = order.max(per, 1)
    let window = order.max(limits.data, 65536) * sessions + 4 * header + 65536
    quic.TransportConfig(max_idle_ms: 30000, initial_max_data: window, initial_max_stream_data: order.max(limits.data, 65536), max_streams_bidi: (limits.streams_bidi + 1) * sessions + held + buffered, max_streams_uni: limits.streams_uni * sessions + 3 + buffered, max_datagram_frame: 65535, send_bytes: window, max_gaps: 32, cc: Cubic, alpn: take alpn, client_pins: None)
}

fn conn_index(w: Endpoint, c: quic.ConnectionHandle) -> Option[u64] {
    for i in 0u64 .. list.len(w.conns) {
        if w.conns[i].handle == c {
            return Some(i)
        }
    }
    None
}

fn session_index(conn: Conn, id: quic.StreamId) -> Option[u64] {
    for k in 0u64 .. list.len(conn.sessions) {
        if conn.sessions[k].id == id {
            return Some(k)
        }
    }
    None
}

fn new_conn(handle: quic.ConnectionHandle, client: bool) -> Conn {
    Conn(handle: handle, client: client, up: false, settings: false, peer_ok: false, peer_credit: credit(0, 0, 0), destination: None, goaway: None, control: None, encoder: None, decoder: None, local: list.new(), control_buf: list.with_capacity(SETTINGS_MAX + 16), control_skip: 0, decoder_buf: list.with_capacity(16), heads: list.new(), parked: list.new(), parked_datagrams: list.new(), peer_bidi_next: 0, sessions: list.new(), out: list.new())
}

/// The largest capsule read whole: WT_CLOSE_SESSION's code and 1,024-byte reason (draft-17
/// §6) behind its type and length varints.
const CAPSULE_MAX: u64 = 1048

fn new_session(id: quic.StreamId, take phase: Phase, cap: u64) -> Session {
    Session(id: id, phase: take phase, buf: list.with_capacity(cap), skip: 0, data_left: 0, caps: list.with_capacity(CAPSULE_MAX), cap_skip: 0, drained: false, streams: list.new(), rx: credit(0, 0, 0), tx: credit(0, 0, 0))
}

/// Whether the application holds this session: it was emitted as Requested (server) or
/// returned by connect (client).
fn app_holds(conn: Conn, k: u64) -> bool {
    if conn.client {
        return true
    }
    match conn.sessions[k].phase {
        Asked => true,
        Live => true,
        _ => false,
    }
}

fn counts_live(conn: Conn, k: u64) -> bool {
    if conn.client {
        return true
    }
    match conn.sessions[k].phase {
        Asked => true,
        Live => true,
        _ => false,
    }
}

/// Forget session k; emits Closed when the application holds it. Each of its streams is
/// reset and stopped with WT_SESSION_GONE (draft-17 §6), and the streams and datagrams
/// buffered for it go too (WT-4).
fn end_session(mut w: Endpoint, mut e: quic.Endpoint, i: u64, k: u64, notify: bool, code: u32, take reason: Bytes, mut out: List[Event]) {
    if counts_live(w.conns[i], k) {
        w.live -= 1
    }
    let c = w.conns[i].handle
    let s = SessionHandle(conn: c, id: w.conns[i].sessions[k].id)
    for o in w.conns[i].sessions[k].streams {
        if o.send {
            if let Error(_) = quic.reset(mut e, c, o.id, h3_wire.WT_SESSION_GONE, o.header) {
                let _ = quic.reset(mut e, c, o.id, h3_wire.WT_SESSION_GONE, 0)
            }
        }
        if o.recv {
            let _ = quic.stop(mut e, c, o.id, h3_wire.WT_SESSION_GONE)
        }
    }
    let mut j = 0u64
    while j < list.len(w.conns[i].out) {
        if owner(w.conns[i], w.conns[i].out[j].id) == Some(k) {
            let _ = list.remove(mut w.conns[i].out, j)
        } else {
            j += 1
        }
    }
    let quic.StreamId(sid) = w.conns[i].sessions[k].id
    unpark(mut w, mut e, i, sid)
    if notify && app_holds(w.conns[i], k) {
        list.push(mut out, Closed(s: s, code: code, reason: take reason))
    }
    let _ = list.remove(mut w.conns[i].sessions, k)
}

/// Close the HTTP/3 connection with an application error code (RFC 9114 §8); each session
/// the application holds is Closed.
fn fail_conn(mut w: Endpoint, mut e: quic.Endpoint, i: u64, code: u64, mut out: List[Event]) {
    quic.close(mut e, w.conns[i].handle, code, list.new())
    drop_conn(mut w, i, mut out)
}

/// The connection is gone, and its streams with it.
fn drop_conn(mut w: Endpoint, i: u64, mut out: List[Event]) {
    for k in 0u64 .. list.len(w.conns[i].sessions) {
        if counts_live(w.conns[i], k) {
            w.live -= 1
        }
        if app_holds(w.conns[i], k) {
            let s = SessionHandle(conn: w.conns[i].handle, id: w.conns[i].sessions[k].id)
            list.push(mut out, Closed(s: s, code: 0, reason: list.new()))
        }
    }
    w.dropped += list.len(w.conns[i].parked_datagrams)
    let _ = list.remove(mut w.conns, i)
}

/// Write data on a stream, keeping what quic does not take for its next Writable.
fn send(mut w: Endpoint, mut e: quic.Endpoint, i: u64, id: quic.StreamId, take data: Bytes, fin: bool) {
    for k in 0u64 .. list.len(w.conns[i].out) {
        if w.conns[i].out[k].id == id {
            list.append(mut w.conns[i].out[k].data, data)
            w.conns[i].out[k].fin = w.conns[i].out[k].fin || fin
            return
        }
    }
    let n = match quic.write(mut e, w.conns[i].handle, id, data, fin) {
        Ok(n) => n,
        Error(_) => return,
    }
    if n < list.len(data) {
        let mut rest: Bytes = list.with_capacity(list.len(data) - n)
        list.append(mut rest, list.slice(data, n, list.len(data)))
        list.push(mut w.conns[i].out, Outgoing(id: id, data: take rest, fin: fin))
    }
}

fn flush(mut w: Endpoint, mut e: quic.Endpoint, i: u64, id: quic.StreamId) {
    for k in 0u64 .. list.len(w.conns[i].out) {
        if w.conns[i].out[k].id == id {
            let Outgoing(data: data, fin: fin, ..) = list.remove(mut w.conns[i].out, k)
            send(mut w, mut e, i, id, take data, fin)
            return
        }
    }
}

/// A stream error (RFC 9114 §8): reset our side and stop the peer's.
fn refuse_stream(mut e: quic.Endpoint, c: quic.ConnectionHandle, id: quic.StreamId, code: u64) {
    let _ = quic.reset(mut e, c, id, code, 0)
    let _ = quic.stop(mut e, c, id, code)
}

/// On the QUIC handshake: open the control stream with our SETTINGS and the two QPACK
/// streams (RFC 9114 §6.2.1, RFC 9204 §4.2).
fn start(mut w: Endpoint, mut e: quic.Endpoint, i: u64, mut out: List[Event]) {
    let c = w.conns[i].handle
    let mut pairs: List[(u64, u64)] = list.new()
    let header: u64 = int.widen(w.limits.header_bytes)
    list.push(mut pairs, (h3_wire.SETTINGS_MAX_FIELD_SECTION_SIZE, header))
    if !w.conns[i].client {
        list.push(mut pairs, (h3_wire.SETTINGS_ENABLE_CONNECT_PROTOCOL, 1))
    }
    list.push(mut pairs, (h3_wire.SETTINGS_H3_DATAGRAM, 1))
    list.push(mut pairs, (h3_wire.SETTINGS_WT_ENABLED, 1))
    list.push(mut pairs, (h3_wire.SETTINGS_WT_INITIAL_MAX_STREAMS_UNI, w.limits.streams_uni))
    list.push(mut pairs, (h3_wire.SETTINGS_WT_INITIAL_MAX_STREAMS_BIDI, w.limits.streams_bidi))
    list.push(mut pairs, (h3_wire.SETTINGS_WT_INITIAL_MAX_DATA, w.limits.data))
    for kind in[h3_wire.STREAM_CONTROL, h3_wire.STREAM_QPACK_ENCODER, h3_wire.STREAM_QPACK_DECODER] {
        let id = match quic.open(mut e, c, false) {
            Ok(id) => id,
            Error(_) => {
                fail_conn(mut w, mut e, i, h3_wire.H3_STREAM_CREATION_ERROR, mut out)
                return
            },
        }
        let mut b: Bytes = list.with_capacity(64)
        h3_wire.write_varint(kind, mut b)
        if kind == h3_wire.STREAM_CONTROL {
            h3_wire.write_settings(pairs, mut b)
        }
        list.push(mut w.conns[i].local, id)
        send(mut w, mut e, i, id, take b, false)
    }
    w.conns[i].up = true
}

/// Whether our SETTINGS offer draft-17 §5 flow control.
fn local_flow(limits: Limits) -> bool {
    limits.streams_bidi > 0 || limits.streams_uni > 0 || limits.data > 0
}

fn flow(w: Endpoint, i: u64) -> bool {
    local_flow(w.limits) && offers_flow(w.conns[i].peer_credit)
}

pub fn receive(mut w: Endpoint, mut e: quic.Endpoint, now: u64, events: List[quic.Event], mut out: List[Event]) {
    w.now = now
    take_backlog(mut w, mut out)
    for event in events {
        match event {
            Connected(c: c, ..) => {
                let i = match conn_index(w, c) {
                    Some(i) => i,
                    None => {
                        list.push(mut w.conns, new_conn(c, false))
                        list.len(w.conns) - 1
                    },
                }
                if !w.conns[i].up {
                    start(mut w, mut e, i, mut out)
                }
            },
            Opened(c, id) => {
                if let Some(i) = conn_index(w, c) {
                    opened(mut w, mut e, i, id, mut out)
                }
            },
            Readable(c, id) => {
                if let Some(i) = conn_index(w, c) {
                    readable(mut w, mut e, i, id, mut out)
                }
            },
            Writable(c, id) => {
                if let Some(i) = conn_index(w, c) {
                    writable(mut w, mut e, i, id, mut out)
                }
            },
            Reset(c: c, s: id, code: code, final_size: final_size) => {
                if let Some(i) = conn_index(w, c) {
                    stream_gone(mut w, mut e, i, id, code, final_size, mut out)
                }
            },
            Stopped(c, id, code) => {
                if let Some(i) = conn_index(w, c) {
                    stopped(mut w, mut e, i, id, code, mut out)
                }
            },
            Datagram(c, data) => {
                if let Some(i) = conn_index(w, c) {
                    on_datagram(mut w, mut e, i, data, mut out)
                }
            },
            Acked(c, id) => {
                if let Some(i) = conn_index(w, c) {
                    if let Some(k) = owner(w.conns[i], id) {
                        settle_stream(mut w, mut e, i, k, id, false, true)
                    }
                }
            },
            Closed(c, _) => {
                if let Some(i) = conn_index(w, c) {
                    drop_conn(mut w, i, mut out)
                }
            },
        }
    }
}

/// Events that answer caused, handed out by the next receive or poll.
fn take_backlog(mut w: Endpoint, mut out: List[Event]) {
    let mut held = replace(mut w.backlog, list.new())
    while list.len(held) > 0 {
        list.push(mut out, list.remove(mut held, 0))
    }
}

/// The package's own timers (WT-2): a stream or datagram buffered for 3 PTOs without its
/// session is rejected (WT-4). Returns the next deadline.
pub fn poll(mut w: Endpoint, mut e: quic.Endpoint, now: u64, mut out: List[Event]) -> Option[u64] {
    w.now = now
    take_backlog(mut w, mut out)
    expire(mut w, mut e, now)
}

/// Datagrams dropped because they named no live or pending session, or found the buffer
/// full (WT-4).
pub fn dropped_datagrams(w: Endpoint) -> u64 {
    w.dropped
}

fn peer_initiated(conn: Conn, id: quic.StreamId) -> bool {
    let quic.StreamId(n) = id
    let server_initiated = n & 1 == 1
    server_initiated == conn.client
}

/// Every peer stream starts as a Head until its leading varints say what it is.
fn opened(mut w: Endpoint, mut e: quic.Endpoint, i: u64, id: quic.StreamId, mut out: List[Event]) {
    let quic.StreamId(n) = id
    let bidi = n & 2 == 0
    if bidi && !w.conns[i].client && n + 4 > w.conns[i].peer_bidi_next {
        w.conns[i].peer_bidi_next = n + 4
    }
    list.push(mut w.conns[i].heads, Head(id: id, bidi: bidi, buf: list.with_capacity(8), kind: None, kind_len: 0, reset: None))
    head_readable(mut w, mut e, i, list.len(w.conns[i].heads) - 1, mut out)
}

/// The longest HEADERS frame read before it is decoded. HPACK's longest code is 30 bits
/// (RFC 7541 Appendix B), so a string of n coded bytes decodes to at least 8n/30, and a
/// frame past 4 × header_bytes + 64 decodes past header_bytes.
fn request_bound(limits: Limits) -> u64 {
    let header: u64 = int.widen(limits.header_bytes)
    4 * header + 64
}

fn head_index(conn: Conn, id: quic.StreamId) -> Option[u64] {
    for h in 0u64 .. list.len(conn.heads) {
        if conn.heads[h].id == id {
            return Some(h)
        }
    }
    None
}

fn readable(mut w: Endpoint, mut e: quic.Endpoint, i: u64, id: quic.StreamId, mut out: List[Event]) {
    if let Some(h) = head_index(w.conns[i], id) {
        head_readable(mut w, mut e, i, h, mut out)
        return
    }
    if w.conns[i].control == Some(id) {
        control_readable(mut w, mut e, i, mut out)
        return
    }
    if w.conns[i].encoder == Some(id) || w.conns[i].decoder == Some(id) {
        qpack_readable(mut w, mut e, i, id, mut out)
        return
    }
    if let Some(k) = session_index(w.conns[i], id) {
        session_readable(mut w, mut e, i, k, mut out)
        return
    }
    if let Some(k) = owner(w.conns[i], id) {
        wt_readable(mut w, mut e, i, k, id, mut out)
    }
}

/// Our queued bytes go first; a WT stream whose header is out is Writable for the
/// application.
fn writable(mut w: Endpoint, mut e: quic.Endpoint, i: u64, id: quic.StreamId, mut out: List[Event]) {
    flush(mut w, mut e, i, id)
    if queued(w.conns[i], id) {
        return
    }
    if let Some(k) = owner(w.conns[i], id) {
        let j = option.unwrap(stream_index(w.conns[i].sessions[k], id))
        if w.conns[i].sessions[k].streams[j].send && !w.conns[i].sessions[k].streams[j].fin_queued && w.conns[i].sessions[k].streams[j].waiting == 0 {
            list.push(mut out, Writable(handle_of(w, i, k), id))
        }
    }
}

fn queued(conn: Conn, id: quic.StreamId) -> bool {
    for o in conn.out {
        if o.id == id {
            return true
        }
    }
    false
}

/// STOP_SENDING on our critical stream is H3_CLOSED_CRITICAL_STREAM; on a WT stream quic
/// has reset our side and the application hears of it.
fn stopped(mut w: Endpoint, mut e: quic.Endpoint, i: u64, id: quic.StreamId, code: u64, mut out: List[Event]) {
    if list.contains(w.conns[i].local, id) {
        fail_conn(mut w, mut e, i, h3_wire.H3_CLOSED_CRITICAL_STREAM, mut out)
        return
    }
    if let Some(k) = owner(w.conns[i], id) {
        list.push(mut out, Stopped(s: handle_of(w, i, k), stream: id, code: h3_wire.application_code_of(code)))
        refund_reset(mut w, e, i, k, id, mut out)
        settle_stream(mut w, mut e, i, k, id, false, true)
    }
}

/// A reset critical stream is H3_CLOSED_CRITICAL_STREAM; a reset CONNECT stream ends its
/// session (WT-3 step 5). A stream whose header is still arriving reads what RESET_STREAM_AT
/// kept first, so a WT stream reset after its header surfaces as Stream then Reset.
fn stream_gone(mut w: Endpoint, mut e: quic.Endpoint, i: u64, id: quic.StreamId, code: u64, final_size: u64, mut out: List[Event]) {
    if w.conns[i].control == Some(id) || w.conns[i].encoder == Some(id) || w.conns[i].decoder == Some(id) {
        fail_conn(mut w, mut e, i, h3_wire.H3_CLOSED_CRITICAL_STREAM, mut out)
        return
    }
    let c = w.conns[i].handle
    let info = ResetInfo(code: code, size: final_size)
    if let Some(h) = head_index(w.conns[i], id) {
        w.conns[i].heads[h].reset = Some(info)
        head_readable(mut w, mut e, i, h, mut out)
        return
    }
    if let Some(k) = session_index(w.conns[i], id) {
        let _ = quic.stop(mut e, c, id, h3_wire.H3_NO_ERROR)
        end_session(mut w, mut e, i, k, true, 0, list.new(), mut out)
        return
    }
    if let Some(k) = owner(w.conns[i], id) {
        wt_reset(mut w, mut e, i, k, id, info, mut out)
        return
    }
    for j in 0u64 .. list.len(w.conns[i].parked) {
        if w.conns[i].parked[j].id == id {
            w.conns[i].parked[j].reset = Some(info)
            return
        }
    }
}

/// Whether conns[i] is still the connection c: a connection error removes it.
fn conn_holds(w: Endpoint, c: quic.ConnectionHandle, i: u64) -> bool {
    i < list.len(w.conns) && w.conns[i].handle == c
}

/// Read what a stream holds onto buf, up to buf's capacity; returns whether it ended.
fn read_more(mut e: quic.Endpoint, c: quic.ConnectionHandle, id: quic.StreamId, mut buf: Bytes) -> Result[bool, quic.QuicError] {
    loop {
        if list.len(buf) >= list.capacity(buf) {
            return Ok(false)
        }
        let (n, fin) = quic.read(mut e, c, id, mut buf)?
        if fin {
            return Ok(true)
        }
        if n == 0 {
            return Ok(false)
        }
    }
}

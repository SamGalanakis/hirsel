// RTC-4 egress: SSRC collisions, sealed media and RTX, NACK answers, reports and the session clock.
// ---- RTC-4: SSRC collisions ----
fn retire(mut p: PeerSession, ssrc: u32, mut out: Outbox) -> Result[(), PeerError] {
    let Some(to) = p.path else {
        return Ok(())
    }
    let mut b: Bytes = list.with_capacity(64)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = rtp.rtcp.write_rr(ssrc, view empty, mut b)
    let _ = rtp.rtcp.write_bye(ssrc, mut b)
    let tag = own_tag(p)
    if let Ok(_) = seal(mut p, true, mut b) {
        queue(mut out, to, b, tag)?
    }
    end_send(mut p, ssrc)
    Ok(())
}

/// A confirmed collision: an authenticated packet or report from the remote end uses
/// an SSRC this session sends on.
/// Each colliding down-track restarts as a fresh stream: new SSRCs, a `Rewrite` at
/// random first numbers with no target, and an empty history (RTC-4). `collided`
/// hands the track to the router, which re-applies its target and asks for a keyframe.
fn collide(mut p: PeerSession, now: u64, ssrc: u32, mut out: Outbox) -> Result[(), PeerError] {
    if ssrc == p.control {
        retire(mut p, ssrc, mut out)?
        let fresh = draw(mut p)
        p.control = fresh
        return Ok(())
    }
    for t in 0u64 .. list.len(p.tracks) {
        let fec = p.tracks[t].fec_ssrc
        if p.tracks[t].ssrc == ssrc || (p.tracks[t].rtx_ssrc != 0 && p.tracks[t].rtx_ssrc == ssrc) || (fec != 0 && fec == ssrc) {
            let old = p.tracks[t].ssrc
            let old_rtx = p.tracks[t].rtx_ssrc
            retire(mut p, old, mut out)?
            let fresh = draw(mut p)
            p.tracks[t].ssrc = fresh
            if old_rtx != 0 {
                retire(mut p, old_rtx, mut out)?
                let fresh_rtx = draw(mut p)
                p.tracks[t].rtx_ssrc = fresh_rtx
            }
            if fec != 0 {
                retire(mut p, fec, mut out)?
                let fresh_fec = draw(mut p)
                p.tracks[t].fec_ssrc = fresh_fec
                rtp.fec.clear(mut p.tracks[t].fec)
            }
            p.tracks[t].highest = EMPTY
            p.tracks[t].sent = rtp.stats.sent(0)
            let _ = rtp.history.clear(mut p.tracks[t].history)
            p.tracks[t].gated = None
            unpace(mut p, int.narrow(t))
            let mut b: Bytes = list.with_capacity(6)
            host.random(p.random, mut b)
            let first_seq: u16 = list.word_be(b, 0)
            let first_ts: u32 = list.word_be(b, 2)
            let clock = section_clock(p, p.tracks[t].section)
            p.tracks[t].rewrite = rtp.rewrite.rewrite(clock, REWRITE_RANGES, REWRITE_FRAMES, int.widen(first_seq), first_ts) ?=> |c| Capacity(c)
            list.try_reserve(mut p.collided, 1) ?=> |c| Capacity(c)
            list.push(mut p.collided, int.narrow(t))
        }
    }
    Ok(())
}

// ---- Egress ----
fn has_rtx(a: sdp.Agreed) -> bool {
    for f in a.formats {
        if f.codec == Rtx {
            return true
        }
    }
    false
}

fn section_clock(p: PeerSession, section: u8) -> u32 {
    let si: u64 = int.widen(section)
    match list.get(p.sections[si].agreed.formats, 0) {
        Some(f) => f.clock,
        None => 90000,
    }
}

/// A down-track `collide` restarted, for the router to re-target.
pub fn collided(mut p: PeerSession) -> Option[u16] {
    list.pop(mut p.collided)
}

/// Make a down-track on a sending section. It draws its media SSRC and, for video
/// with RTX agreed, its RTX SSRC and with `flexfec-03` agreed, its FlexFEC SSRC; each
/// keeps for the track's life while collision-free.
/// `first_seq` and `first_ts` are the outgoing stream's first number and timestamp
/// (RFC 3550 section 5.1: the router draws them at random).
pub fn add_track(mut p: PeerSession, section: u8, first_seq: u16, first_ts: u32) -> Result[u16, PeerError] {
    let si: u64 = int.widen(section)
    if si >= list.len(p.sections) || !p.sections[si].agreed.send {
        return Error(Sdp(AnswerMismatch(section)))
    }
    // The bound is on live down-tracks: an ended one's slot is taken again.
    let live = live_tracks(p)
    if live >= int.widen(p.limits.down_tracks) {
        return Error(Capacity(Capacity(requested: live + 1, available: int.widen(p.limits.down_tracks))))
    }
    let video = p.sections[si].agreed.media == Video
    let clock = section_clock(p, section)
    let ssrc = draw(mut p)
    let rtx = if video && has_rtx(p.sections[si].agreed) {
        draw(mut p)
    } else {
        0
    }
    // RTP-14: a FlexFEC SSRC is drawn where the section agreed `flexfec-03`; it is
    // used once a re-offer's answer takes its `FEC-FR` pair.
    let fec_ssrc = if video && send_pt(p.sections[si].agreed, Flexfec) != None {
        draw(mut p)
    } else {
        0
    }
    let fec = rtp.fec.group() ?=> |c| Capacity(c)
    let history: rtp.history.History[Record] = rtp.history.history(HISTORY_SLOTS, HISTORY_AGE_NS) ?=> |c| Capacity(c)
    let rewrite = rtp.rewrite.rewrite(clock, REWRITE_RANGES, REWRITE_FRAMES, int.widen(first_seq), first_ts) ?=> |c| Capacity(c)
    let pictures = rtp.counter.counter(15, Compact, COUNTER_SLOTS) ?=> |c| Capacity(c)
    let tl0s = rtp.counter.counter(8, Compact, COUNTER_SLOTS) ?=> |c| Capacity(c)
    let frames = rtp.counter.counter(16, Translate, COUNTER_SLOTS) ?=> |c| Capacity(c)
    let track = Track(section: section, video: video, opus_fmtp: None, ssrc: ssrc, rtx_ssrc: rtx, rtx_seq: 0, highest: EMPTY, sent: rtp.stats.sent(clock), history: take history, src: None, rewrite: take rewrite, gated: None, pictures: take pictures, tl0s: take tl0s, tl0: 0, frames: take frames, frames_source: None, red: rtp.red.policy(), red_from: 0, nacked: 0, forwarded: 0, ended: false, last_ts: first_ts, last_pt: 0, playout: None, fec_ssrc: fec_ssrc, fec_seq: first_seq, fec_key: false, fec: take fec, fec_policy: rtp.fec.policy())
    for t in 0u64 .. list.len(p.tracks) {
        if p.tracks[t].ended {
            p.tracks[t] = take track
            return Ok(int.narrow(t))
        }
    }
    list.try_reserve(mut p.tracks, 1) ?=> |c| Capacity(c)
    list.push(mut p.tracks, take track)
    Ok(int.narrow(list.len(p.tracks) - 1))
}

/// Point a down-track at a source layer (RTP-11 `target`). The router owns the map
/// from `Layer(e, s, t)` to `(source, i)` (RTC-6).
pub fn set_target(mut p: PeerSession, track: u16, t: rtp.rewrite.Target) -> Result[(), rtp.rewrite.TargetError] {
    let i: u64 = int.widen(track)
    if i < list.len(p.tracks) {
        rtp.rewrite.target(mut p.tracks[i].rewrite, t)?
    }
    Ok(())
}

/// A source's sender report, for the switch timeline (RTP-11 `on_sr`).
pub fn source_report(mut p: PeerSession, track: u16, source: u32, info: rtp.rtcp.SenderInfo, now: u64) {
    let i: u64 = int.widen(track)
    if i < list.len(p.tracks) {
        rtp.rewrite.on_sr(mut p.tracks[i].rewrite, source, info, now)
    }
}

/// The source a down-track waits to switch to, if any (RTP-11 `pending`).
pub fn pending(p: PeerSession, track: u16) -> Option[u32] {
    let i: u64 = int.widen(track)
    if i >= list.len(p.tracks) {
        return None
    }
    rtp.rewrite.pending(p.tracks[i].rewrite)
}

/// The target index the down-track forwards on `source`, if that is its current source.
pub fn current_layer(p: PeerSession, track: u16, source: u32) -> Option[u8] {
    let i: u64 = int.widen(track)
    if i >= list.len(p.tracks) {
        return None
    }
    rtp.rewrite.current(p.tracks[i].rewrite, source)
}

fn send_pt(a: sdp.Agreed, codec: sdp.Codec) -> Option[u8] {
    for f in a.formats {
        if f.codec == codec {
            return Some(f.pt)
        }
    }
    None
}

// The `red` format whose blocks carry `pt` (RTP-13).
fn red_pt(a: sdp.Agreed, pt: u8) -> Option[u8] {
    for f in a.formats {
        if sdp.red_base(f) == Some(pt) {
            return Some(f.pt)
        }
    }
    None
}

fn rtx_pt(a: sdp.Agreed, pt: u8) -> Option[u8] {
    for f in a.formats {
        if f.codec == Rtx && f.apt == Some(pt) {
            return Some(f.pt)
        }
    }
    None
}

// Seal the scratch packet in place and copy it into the subscriber's span of `out`.
fn seal_out(mut p: PeerSession, src: Gen, mut out: Outbox) -> Result[(), PeerError] {
    let Some(to) = p.path else {
        return Error(Closed)
    }
    let mut b = replace(mut p.pkt, list.new())
    let sealed = seal(mut p, false, mut b)
    let queued = match sealed {
        Ok(_) => queue(mut out, to, b, Tag(src: Some(src), dst: p.who.gen, room: p.who.room)),
        Error(take e) => Error(take e),
    }
    list.clear(mut b)
    p.pkt = take b
    queued
}

// The leg's codec descriptor values for one output frame: VP8's picture ID and
// TL0PICIDX, counted per down-track and keyed by the source frame (RTP-11 counters).
fn descriptor(mut p: PeerSession, t: u64, leg: Leg, payload: Bytes) -> (Option[u16], Option[u8]) {
    if leg.codec != Vp8 {
        return (None, None)
    }
    let Ok(d) = media_bits.vp8.parse(list.slice(payload, leg.from, leg.from + leg.len)) else {
        return (None, None)
    }
    let picture = match d.picture_id {
        Some(_) => match rtp.counter.forward(mut p.tracks[t].pictures, leg.ts, None, 15) {
            Ok(v) => {
                let w: u16 = int.narrow(v)
                Some(w)
            },
            Error(_) => None,
        },
        None => None,
    }
    let tl0 = match d.tl0picidx {
        Some(_) => {
            if d.temporal == Some(0) || d.temporal == None {
                if let Ok(v) = rtp.counter.forward(mut p.tracks[t].tl0s, leg.ts, None, 8) {
                    p.tracks[t].tl0 = int.narrow(v)
                }
            }
            Some(p.tracks[t].tl0)
        },
        None => None,
    }
    (picture, tl0)
}

// The leg's dependency descriptor for one AV1 frame, with the leg's own frame number
// (RTP-11 Translate): the first frame the leg sends is 1, and a switch to another source
// numbers on from the last frame sent. A frame the counter refuses goes without one.
fn dependency(mut p: PeerSession, t: u64, leg: Leg, payload: Bytes) -> Option[Dd] {
    if leg.codec != Av1 || leg.dd_len < 3 || leg.dd_len > DD_LIMIT || leg.dd_at + leg.dd_len > list.len(payload) {
        return None
    }
    if p.tracks[t].frames_source != Some(leg.source) {
        rtp.counter.restart(mut p.tracks[t].frames, 1)
        p.tracks[t].frames_source = Some(leg.source)
    }
    let hi: u64 = int.widen(payload[leg.dd_at + 1])
    let lo: u64 = int.widen(payload[leg.dd_at + 2])
    let number: i64 = int.widen(leg.unit.frame)
    match rtp.counter.forward(mut p.tracks[t].frames, (leg.ts << 16) | number, Some((hi << 8) | lo), 16) {
        Ok(v) => Some(Dd(at: leg.dd_at, len: leg.dd_len, frame: int.narrow(v))),
        Error(_) => None,
    }
}

// Append the leg's descriptor to `buf`: the source's value with the leg's frame number
// in its second and third octets (AV1 RTP section A.8.1). The caller checked the room.
fn copy_dd(mut buf: Bytes, payload: Bytes, d: Dd) {
    let base = list.len(buf)
    list.append(mut buf, list.slice(payload, d.at, d.at + d.len))
    buf[base + 1] = int.truncate(d.frame >> 8)
    buf[base + 2] = int.truncate(d.frame)
}

// Whether the leg's packet closes the picture of the target it forwards (RTC-6): the
// source's marker, or the last packet of a frame of the target's highest spatial layer.
fn closes(r: rtp.rewrite.Rewrite, leg: Leg) -> bool {
    match rtp.rewrite.current(r, leg.source) {
        Some(i) => i < 32 && ((leg.closes >> int.widen(i)) & 1u32) != 0,
        None => false,
    }
}

// The payload as the leg sends it: the source bytes, with the descriptor's picture ID
// and TL0PICIDX rewritten in place in `buf` from `at`.
fn put_payload(mut buf: Bytes, at: u64, payload: Bytes, from: u64, len: u64, picture: Option[u16], tl0: Option[u8]) -> Result[(), PeerError] {
    if list.capacity(buf) - list.len(buf) < len {
        return Error(Capacity(Capacity(requested: len, available: list.capacity(buf) - list.len(buf))))
    }
    list.append(mut buf, list.slice(payload, from, from + len))
    if picture == None && tl0 == None {
        return Ok(())
    }
    // RFC 7741 section 4.2: the picture ID follows the two first octets, and TL0PICIDX follows it.
    let Ok(d) = media_bits.vp8.parse(list.slice(payload, from, from + len)) else {
        return Ok(())
    }
    let mut next = at + 2
    match d.picture_id {
        Some(ShortId(_)) => {
            if let Some(v) = picture {
                buf[next] = int.narrow(v % 128)
            }
            next += 1
        },
        Some(LongId(_)) => {
            if let Some(v) = picture {
                let high: u8 = int.narrow((v >> 8) & 127)
                buf[next] = 128 | high
                buf[next + 1] = int.narrow(v & 255)
            }
            next += 2
        },
        None => (),
    }
    if d.tl0picidx != None {
        if let Some(v) = tl0 {
            buf[next] = v
        }
    }
    Ok(())
}

fn write_rtx(mut p: PeerSession, now: u64, t: u64, index: u64, ts: u32, rec: Record, payload: Bytes, mut out: Outbox) -> Result[bool, PeerError] {
    let si: u64 = int.widen(p.tracks[t].section)
    let Some(rpt) = rtx_pt(p.sections[si].agreed, rec.pt) else {
        return Ok(false)
    }
    if p.tracks[t].rtx_ssrc == 0 {
        return Ok(false)
    }
    let f = rtp.header.Fields(marker: rec.marker, pt: rpt, seq: p.tracks[t].rtx_seq, ts: ts, ssrc: p.tracks[t].rtx_ssrc)
    let osn: u16 = int.truncate(index)
    let q = Paced(slot: 0, track: int.narrow(t), media: false, guard: 0, fields: f, level: None, voice: false, src: rec.src, dd: 0, cvo: rec.cvo, capture: rec.capture)
    if stage(mut p, now, mut out, q, Retransmit, Some(osn), payload, rec.from, rec.len, rec.picture, rec.tl0, rec.dd)? {
        p.tracks[t].rtx_seq = int.wrapping_add(p.tracks[t].rtx_seq, 1u16)
    }
    let _ = drain(mut p, now, mut out)
    Ok(true)
}

// Put one packet in the pacer: its payload goes into a free slab slot now, and its
// header is written when the pacer lets it out (`emit`). A full pacer refuses it,
// and the refusal is counted. A section without TWCC has no estimate to pace at, so its
// packets go out at once (RTC-5 step 2).
fn stage(mut p: PeerSession, now: u64, mut out: Outbox, q: Paced, class: rtp.pacer.Class, osn: Option[u16], payload: Bytes, from: u64, len: u64, picture: Option[u16], tl0: Option[u8], dd: Option[Dd]) -> Result[bool, PeerError] {
    let t: u64 = int.widen(q.track)
    let si: u64 = int.widen(p.tracks[t].section)
    if !p.sections[si].twcc {
        let extra: u64 = if osn == None {
            0
        } else {
            2
        }
        leg_ext(mut p, now, si, int.narrow(12 + extra + len), q)?
        if let Some(d) = dd {
            list.clear(mut p.dd)
            copy_dd(mut p.dd, payload, d)
            let map = p.sections[si].map
            // A descriptor the section cannot carry costs the leg only its descriptor.
            let _ = rtp.ext.put(mut p.ext, map, DependencyDescriptor, p.dd, 0, d.len)
        }
        let head = rtp.ext.write_header(q.fields, view p.ext, mut p.pkt) ?=> |take x| Rtp(x)
        if let Some(n) = osn {
            list.push(mut p.pkt, int.truncate(n >> 8))
            list.push(mut p.pkt, int.truncate(n))
        }
        let mut buf = replace(mut p.pkt, list.new())
        let put = put_payload(mut buf, head + extra, payload, from, len, picture, tl0)
        p.pkt = take buf
        if let Error(take e) = put {
            list.clear(mut p.pkt)
            return Error(take e)
        }
        let full = fec_protect(mut p, t, si, q.guard)
        seal_out(mut p, q.src, mut out)?
        if q.media {
            rtp.stats.on_sent(mut p.tracks[t].sent, len)
        }
        if full {
            fec_send(mut p, now, t, q.src, mut out)?
        }
        return Ok(true)
    }
    let Some(slot) = list.pop(mut p.free) else {
        p.drops.paced += 1
        return Ok(false)
    }
    let at: u64 = int.widen(slot)
    let mut buf = replace(mut p.slab[at], list.new())
    list.clear(mut buf)
    let start = if let Some(n) = osn {
        list.push(mut buf, int.truncate(n >> 8))
        list.push(mut buf, int.truncate(n))
        2u64
    } else {
        0u64
    }
    let put = put_payload(mut buf, start, payload, from, len, picture, tl0)
    let mut tail = 0u64
    if let Some(d) = dd {
        if let Ok(_) = put {
            if list.capacity(buf) - list.len(buf) >= d.len {
                copy_dd(mut buf, payload, d)
                tail = d.len
            }
        }
    }
    let size: u32 = int.narrow(list.len(buf))
    p.slab[at] = take buf
    if let Error(take e) = put {
        list.push(mut p.free, slot)
        return Error(take e)
    }
    let entry = Paced(slot: slot, track: q.track, media: q.media, guard: q.guard, fields: q.fields, level: q.level, voice: q.voice, src: q.src, dd: tail, cvo: q.cvo, capture: q.capture)
    if let Error(_) = rtp.pacer.push(mut p.pacer, int.widen(q.track), class, RTP_HEADER + size, now, entry) {
        list.push(mut p.free, slot)
        p.drops.paced += 1
        return Ok(false)
    }
    Ok(true)
}

// Send what the pacer lets out at `now` (RTP-10), at 2.5 times the estimate. The
// answer is when it lets out the next packet, if one waits. A packet that cannot go
// out (a full outbox) is dropped and counted, and the rest still go.
//
// While a probe cluster runs, every packet let out goes at the cluster's rate, so each
// one numbered is a member of it (RTP-9 `probe_sent`), media and padding alike.
fn drain(mut p: PeerSession, now: u64, mut out: Outbox) -> Option[u64] {
    rtp.pacer.set_rate(mut p.pacer, rtp.bwe.target(p.bwe), 0)
    loop {
        let before = p.numbered
        let (sent, cluster) = match rtp.pacer.poll(mut p.pacer, now) {
            Send(q) => {
                let cluster = rtp.pacer.cluster(p.pacer)
                (emit(mut p, now, q, mut out), cluster)
            },
            Probe(id, pad) => (pad_out(mut p, now, pad, mut out), Some(id)),
            Pad(pad) => (pad_out(mut p, now, pad, mut out), None),
            Wait(at) => return Some(at),
            Idle => return None,
        }
        if let Error(_) = sent {
            p.drops.capacity += 1
        }
        if let Some(id) = cluster {
            if p.numbered > before {
                rtp.bwe.probe_sent(mut p.bwe, id, p.numbered - 1)
            }
        }
    }
}

// The down-tracks padding may go on (RTC-6 probing): live video tracks whose section
// numbers its packets for feedback (TWCC). Those with agreed RTX pad on their RTX
// SSRC (RFC 4588) whatever their target, so a leg the budget paused can be probed;
// the others pad on their media SSRC, when their last packet ended a frame (RTP-11
// `pad`). Each is `(track, RTX payload type)`, RTX ones first.
fn pad_tracks(p: PeerSession) -> List[(u64, Option[u8])] {
    let mut rtx: List[(u64, Option[u8])] = list.new()
    let mut media: List[(u64, Option[u8])] = list.new()
    for t in 0u64 .. list.len(p.tracks) {
        let track = p.tracks[t]
        let si: u64 = int.widen(track.section)
        if !track.video || track.ended || !p.sections[si].twcc {
            continue
        }
        let pt: Option[u8] = if track.rtx_ssrc == 0 {
            None
        } else {
            any_rtx_pt(p.sections[si].agreed)
        }
        match pt {
            Some(_) => list.push(mut rtx, (t, pt)),
            None if rtp.rewrite.paddable(track.rewrite) => list.push(mut media, (t, None)),
            None => (),
        }
    }
    list.append(mut rtx, media)
    rtx
}

fn any_rtx_pt(a: sdp.Agreed) -> Option[u8] {
    for f in a.formats {
        if f.codec == Rtx {
            return Some(f.pt)
        }
    }
    None
}

// One padding-only packet (RFC 3550 section 5.1's P bit) of `pad` padding octets on
// the first pad track that takes it: on an RTX track an RFC 4588 packet with no OSN
// and no payload at its next RTX sequence number and its last media timestamp; on a
// media track the next outgoing number of its stream, when its last packet ended a
// frame (RTP-11 `pad`), counted as a packet of no payload octets (RFC 3550 section
// 6.4.1) and kept out of its history, so a NACK for it answers nothing. It carries
// the leg's MID and the next transport number, and no publisher's media, so its tag
// names no source.
fn pad_out(mut p: PeerSession, now: u64, pad: u8, mut out: Outbox) -> Result[(), PeerError] {
    if p.closed {
        return Ok(())
    }
    let Some(to) = p.path else {
        return Ok(())
    }
    for (t, repair) in pad_tracks(p) {
        let f = if let Some(rtx) = repair {
            let f = rtp.header.Fields(marker: false, pt: rtx, seq: p.tracks[t].rtx_seq, ts: p.tracks[t].last_ts, ssrc: p.tracks[t].rtx_ssrc)
            p.tracks[t].rtx_seq = int.wrapping_add(p.tracks[t].rtx_seq, 1u16)
            f
        } else {
            let Some((index, ts)) = rtp.rewrite.pad(mut p.tracks[t].rewrite) else {
                continue
            }
            p.tracks[t].highest = index
            rtp.stats.on_sent(mut p.tracks[t].sent, 0)
            rtp.header.Fields(marker: false, pt: p.tracks[t].last_pt, seq: int.truncate(index), ts: ts, ssrc: p.tracks[t].ssrc)
        }
        let si: u64 = int.widen(p.tracks[t].section)
        let wide: u32 = int.widen(pad)
        let q = Paced(slot: 0, track: int.narrow(t), media: false, guard: 0, fields: f, level: None, voice: false, src: p.who.gen, dd: 0, cvo: None, capture: None)
        leg_ext(mut p, now, si, RTP_HEADER + wide, q)?
        let _ = rtp.rtx.write_probe(f, view p.ext, pad, mut p.pkt) ?=> |take x| Rtp(x)
        let tag = own_tag(p)
        let mut b = replace(mut p.pkt, list.new())
        let sealed = seal(mut p, false, mut b)
        let queued = match sealed {
            Ok(_) => queue(mut out, to, b, tag),
            Error(take e) => Error(take e),
        }
        list.clear(mut b)
        p.pkt = take b
        return queued
    }
    Ok(())
}

/// RTC-6 probing: ask the estimate for a cluster toward `want_bps` (rtp RTP-9 `probe`)
/// and hand it to the pacer, which lets it out as padding on the pad track. A session
/// with no pad track, a cluster outstanding, or a loss estimate decreasing starts none;
/// after a cluster that left the target where it was, the next waits 5 s. It answers
/// the pacer's next send, as `poll` would.
pub fn probe(mut p: PeerSession, want_bps: u64, now: u64, mut out: Outbox) -> Option[u64] {
    if p.closed || !connected(p) || list.len(pad_tracks(p)) == 0 {
        return None
    }
    let target = rtp.bwe.target(p.bwe)
    if now < p.probe_next && target <= p.probe_from {
        return None
    }
    let Some(c) = rtp.bwe.probe(mut p.bwe, want_bps, now) else {
        return None
    }
    p.probe_from = target
    p.probe_next = now + PROBE_RETRY_NS
    rtp.pacer.probe(mut p.pacer, c, now)
    drain(mut p, now, mut out)
}

// Write the header of a packet the pacer let out, with the next transport number,
// and seal it. A packet whose SSRC a collision retired since it was queued, or whose
// publisher a fence barred, is dropped.
fn emit(mut p: PeerSession, now: u64, q: Paced, mut out: Outbox) -> Result[(), PeerError] {
    let at: u64 = int.widen(q.slot)
    list.push(mut p.free, q.slot)
    let t: u64 = int.widen(q.track)
    if p.closed || t >= list.len(p.tracks) || barred(p, q.src) {
        return Ok(())
    }
    let ssrc = if q.media {
        p.tracks[t].ssrc
    } else if q.fields.ssrc == p.tracks[t].fec_ssrc {
        p.tracks[t].fec_ssrc
    } else {
        p.tracks[t].rtx_ssrc
    }
    if ssrc == 0 || ssrc != q.fields.ssrc {
        return Ok(())
    }
    let si: u64 = int.widen(p.tracks[t].section)
    let len = list.len(p.slab[at]) - q.dd
    let size: u32 = int.narrow(12 + len)
    leg_ext(mut p, now, si, size, q)?
    if q.dd != 0 {
        let map = p.sections[si].map
        let _ = rtp.ext.put(mut p.ext, map, DependencyDescriptor, p.slab[at], len, q.dd)
    }
    let _ = rtp.ext.write_header(q.fields, view p.ext, mut p.pkt) ?=> |take x| Rtp(x)
    if list.capacity(p.pkt) - list.len(p.pkt) < len + 16 {
        list.clear(mut p.pkt)
        return Error(Capacity(Capacity(requested: len + 16, available: list.capacity(p.pkt) - list.len(p.pkt))))
    }
    list.append(mut p.pkt, list.slice(p.slab[at], 0, len))
    let full = fec_protect(mut p, t, si, q.guard)
    seal_out(mut p, q.src, mut out)?
    if q.media {
        rtp.stats.on_sent(mut p.tracks[t].sent, len)
        p.tracks[t].last_ts = q.fields.ts
        p.tracks[t].last_pt = q.fields.pt
    }
    if full {
        fec_send(mut p, now, t, q.src, mut out)?
    }
    Ok(())
}

/// End a down-track the router removed (RTC-7 step 3): its `Rewrite` closes, so
/// every later packet answers `Drop`, its egress history is cleared and its paced
/// packets are taken out unsent.
pub fn end_track(mut p: PeerSession, track: u16) {
    let t: u64 = int.widen(track)
    if t < list.len(p.tracks) {
        rtp.rewrite.close(mut p.tracks[t].rewrite)
        let _ = rtp.history.clear(mut p.tracks[t].history)
        rtp.fec.clear(mut p.tracks[t].fec)
        p.tracks[t].ended = true
    }
    unpace(mut p, track)
}

/// The down-tracks the session holds that have not ended: what `PeerLimits.down_tracks`
/// bounds.
pub fn live_tracks(p: PeerSession) -> u64 {
    let mut n = 0u64
    for t in p.tracks {
        if !t.ended {
            n += 1
        }
    }
    n
}

/// Take a down-track's packets out of the pacer unsent: at a collision, and when the
/// router ends the down-track (RTC-7's `Pacer.remove`).
pub fn unpace(mut p: PeerSession, track: u16) {
    list.clear(mut p.unpaced)
    let _ = rtp.pacer.remove(mut p.pacer, int.widen(track), mut p.unpaced)
    for i in 0u64 .. list.len(p.unpaced) {
        let slot = p.unpaced[i].slot
        list.push(mut p.free, slot)
    }
    list.clear(mut p.unpaced)
}

/// Present one source packet to a down-track (RTC-5 fan-out step 2). The track's
/// `Rewrite` decides: `Forward` goes out on the media SSRC in the subscriber's wire
/// identity; `Late` goes out at once as an RFC 4588 repair on the RTX SSRC, or is
/// dropped and counted when the leg negotiated no RTX; `Drop` and `Wait` send nothing.
pub fn forward(mut p: PeerSession, now: u64, track: u16, leg: Leg, payload: Bytes, past: rtp.red.Ring, mut out: Outbox) -> Result[Sent, PeerError] {
    if p.closed {
        return Error(Closed)
    }
    let t: u64 = int.widen(track)
    if t >= list.len(p.tracks) {
        return Error(Sdp(AnswerMismatch(0)))
    }
    let decision = rtp.rewrite.on_packet(mut p.tracks[t].rewrite, leg.source, leg.index, leg.ts, now, leg.padding_only, leg.unit)
    // A new switch gates the history: a NACK from before it answers nothing.
    let switch = rtp.rewrite.switch_index(p.tracks[t].rewrite)
    if switch != p.tracks[t].gated {
        if let Some(i) = switch {
            rtp.history.gate(mut p.tracks[t].history, i)
        }
        p.tracks[t].gated = switch
    }
    let (index, ts, late) = match decision {
        Forward(i, w) => (i, w, false),
        Late(i, w) => (i, w, true),
        _ => {
            // RTP-13: a packet after a hold carries nothing from before it.
            p.tracks[t].red_from = leg.index + 1
            return Ok(Held)
        },
    }
    let si: u64 = int.widen(p.tracks[t].section)
    let Some(pt) = send_pt(p.sections[si].agreed, leg.codec) else {
        p.drops.format += 1
        return Ok(Dropped)
    }
    let (picture, tl0) = descriptor(mut p, t, leg, payload)
    let dd = dependency(mut p, t, leg, payload)
    let marker = leg.marker || closes(p.tracks[t].rewrite, leg)
    // The receiver takes a frame's rotation from its last packet, and 0 when that packet
    // has none, so every last packet the leg sends carries the current CVO (RTC-5).
    let cvo = if marker {
        leg.orientation
    } else {
        None
    }
    let rec = Record(src: leg.src, handle: leg.handle, from: leg.from, len: leg.len, ts: ts, marker: marker, pt: pt, picture: picture, tl0: tl0, dd: dd, cvo: cvo, capture: leg.capture)
    if late {
        if !write_rtx(mut p, now, t, index, ts, rec, payload, mut out)? {
            p.drops.late += 1
            return Ok(Dropped)
        }
        if p.tracks[t].video {
            drop(rtp.history.put(mut p.tracks[t].history, index, now, rec))
        }
        return Ok(AsRepair)
    }
    let f = rtp.header.Fields(marker: marker, pt: pt, seq: int.truncate(index), ts: ts, ssrc: p.tracks[t].ssrc)
    let size = guard(mut p, t, leg.unit)
    let q = Paced(slot: 0, track: track, media: true, guard: size, fields: f, level: leg.level, voice: leg.voice, src: leg.src, dd: 0, cvo: cvo, capture: leg.capture)
    let class: rtp.pacer.Class = if p.tracks[t].video {
        Video
    } else {
        Audio
    }
    if p.tracks[t].src != Some(leg.src) {
        p.tracks[t].red_from = leg.index
    }
    let distance = rtp.red.distance(p.tracks[t].red)
    let staged = match red_pt(p.sections[si].agreed, pt) {
        Some(rpt) if distance > 0 && !p.tracks[t].video => {
            // RTP-13: the leg's own RED payload, every block tagged with its own Opus
            // payload type, from the primaries the unit kept.
            let mut buf = replace(mut p.red, list.new())
            list.clear(mut buf)
            let built = rtp.red.write(mut buf, pt, past, leg.index, int.truncate(leg.ts), payload, leg.from, leg.len, distance, p.tracks[t].red_from)
            let r = match built {
                Ok(n) => {
                    let mut g = q
                    g.fields.pt = rpt
                    stage(mut p, now, mut out, g, class, None, buf, 0, n, None, None, None)
                },
                Error(_) => stage(mut p, now, mut out, q, class, None, payload, leg.from, leg.len, picture, tl0, dd),
            }
            p.red = take buf
            r?
        },
        _ => stage(mut p, now, mut out, q, class, None, payload, leg.from, leg.len, picture, tl0, dd)?,
    }
    if staged {
        p.tracks[t].forwarded += 1
    }
    p.tracks[t].highest = index
    p.tracks[t].src = Some(leg.src)
    if p.tracks[t].video {
        drop(rtp.history.put(mut p.tracks[t].history, index, now, rec))
    }
    let _ = drain(mut p, now, mut out)
    Ok(if staged {
        OnMedia
    } else {
        Dropped
    })
}

/// Answer a `RepairAsk` with the plaintext its handle names, rebuilt from the
/// recorded output rewrite, never from the track's current state.
pub fn resend(mut p: PeerSession, now: u64, ask: RepairAsk, payload: Bytes, mut out: Outbox) -> Result[bool, PeerError] {
    let t: u64 = int.widen(ask.track)
    if p.closed || t >= list.len(p.tracks) {
        return Ok(false)
    }
    let rec: Record = match rtp.history.entry(p.tracks[t].history, ask.index) {
        Some(r) => r,
        None => return Ok(false),
    }
    if rec.src != ask.src || rec.handle != ask.handle {
        return Ok(false)
    }
    write_rtx(mut p, now, t, ask.index, rec.ts, rec, payload, mut out)
}

/// Send the publisher of one inbound stream a keyframe request the router chose
/// (RTC-6): a PLI or a FIR with its command sequence number.
pub fn request_keyframe(mut p: PeerSession, ssrc: u32, req: rtp.loss.Request, mut out: Outbox) -> Result[(), PeerError] {
    // RR 8, CNAME chunk up to 264, FIR 20 and the SRTCP trailer 14 (RFC 3711 section 3.4).
    let mut b: Bytes = list.with_capacity(320)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = rtp.rtcp.write_rr(p.control, view empty, mut b)
    let _ = rtp.rtcp.write_cname(p.control, p.cname, mut b)
    match req {
        Pli => {
            let _ = rtp.rtcp.write_pli(p.control, ssrc, mut b)
        },
        Fir(n) => {
            let _ = rtp.rtcp.write_fir(p.control, ssrc, n, mut b)
        },
    }
    seal_rtcp_out(mut p, mut b, mut out)
}

/// The round-trip estimate of this session (RFC 3550 section 6.4.1, from RR blocks).
pub fn round_trip(p: PeerSession) -> Option[u64] {
    p.rtt
}

fn seal_rtcp_out(mut p: PeerSession, mut b: Bytes, mut out: Outbox) -> Result[(), PeerError] {
    let Some(to) = p.path else {
        return Ok(())
    }
    let tag = own_tag(p)
    if !connected(p) {
        return Ok(())
    }
    seal(mut p, true, mut b)?
    queue(mut out, to, b, tag)
}

// ---- Time ----
// NTP time for reports: the session clock in 32.32 fixed point.
fn ntp(now: u64) -> u64 {
    let secs = now / 1000000000
    let frac = ((now % 1000000000) << 32) / 1000000000
    (secs << 32) | frac
}

fn reports(mut p: PeerSession, now: u64, mut out: Outbox) -> Result[(), PeerError] {
    // One SR per down-track, under that track's SSRC and its own counts.
    for t in 0u64 .. list.len(p.tracks) {
        if p.tracks[t].highest == EMPTY {
            continue
        }
        let Some(ts) = rtp.rewrite.sr_timestamp(mut p.tracks[t].rewrite, now) else {
            continue
        }
        let ssrc = p.tracks[t].ssrc
        let info = rtp.stats.sender_info(p.tracks[t].sent, ssrc, ntp(now), ts)
        let mut b: Bytes = list.with_capacity(128)
        let empty: List[rtp.rtcp.Block] = list.new()
        let _ = rtp.rtcp.write_sr(info, view empty, mut b)
        let _ = rtp.rtcp.write_cname(ssrc, p.cname, mut b)
        seal_rtcp_out(mut p, mut b, mut out)?
    }
    let mut blocks: List[rtp.rtcp.Block] = list.new()
    for i in 0u64 .. list.len(p.inbound) {
        if !p.inbound[i].repair && list.len(blocks) < 31 {
            let ssrc = p.inbound[i].ssrc
            list.push(mut blocks, rtp.stats.report(mut p.inbound[i].stats, ssrc, now))
        }
    }
    if list.len(blocks) != 0 {
        let mut b: Bytes = list.with_capacity(1024)
        let _ = rtp.rtcp.write_rr(p.control, view blocks, mut b)
        let _ = rtp.rtcp.write_cname(p.control, p.cname, mut b)
        seal_rtcp_out(mut p, mut b, mut out)?
    }
    Ok(())
}

fn feedback(mut p: PeerSession, now: u64, mut out: Outbox) -> Result[(), PeerError] {
    let mut b: Bytes = list.with_capacity(1200)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = rtp.rtcp.write_rr(p.control, view empty, mut b)
    let _ = rtp.rtcp.write_cname(p.control, p.cname, mut b)
    let prefix = list.len(b)
    let rtt = p.rtt
    for i in 0u64 .. list.len(p.inbound) {
        let ssrc = p.inbound[i].ssrc
        let mut pairs: List[(u16, u16)] = list.with_capacity(int.widen(MAX_NACK_PAIRS))
        if p.inbound[i].nack {
            let _ = rtp.loss.due(mut p.inbound[i].losses, now, rtt, MAX_NACK_PAIRS, mut pairs)
        }
        if list.len(pairs) != 0 {
            let _ = rtp.rtcp.write_nack(p.control, ssrc, view pairs, mut b)
        }
    }
    let media = match list.get(p.inbound, 0) {
        Some(i) => i.ssrc,
        None => 0,
    }
    let _ = rtp.twcc.write(mut p.recv_log, p.control, media, 1000, mut b)
    if list.len(b) > prefix {
        seal_rtcp_out(mut p, mut b, mut out)?
    }
    Ok(())
}

pub fn poll(mut p: PeerSession, now: u64, mut out: Outbox) -> Poll {
    if p.closed {
        return Idle
    }
    let before = list.len(out.pkts)
    let dtls_wake = match flush_dtls(mut p, now, mut out) {
        Ok(w) => w,
        Error(_) => None,
    }
    if let Error(_) = start_srtp(mut p) {
        return Idle
    }
    let mut paced: Option[u64] = None
    if connected(p) {
        paced = drain(mut p, now, mut out)
        if now >= p.next_report {
            let _ = reports(mut p, now, mut out)
            p.next_report = now + REPORT_NS
        }
        if now >= p.next_feedback {
            let _ = feedback(mut p, now, mut out)
            p.next_feedback = now + FEEDBACK_NS
        }
    }
    if list.len(out.pkts) > before {
        return Transmit
    }
    let mut wake: Option[u64] = dtls_wake
    if connected(p) {
        let next = if p.next_report < p.next_feedback {
            p.next_report
        } else {
            p.next_feedback
        }
        wake = match wake {
            Some(w) if w < next => Some(w),
            _ => Some(next),
        }
    }
    if let Some(w) = paced {
        wake = match wake {
            Some(x) if x <= w => Some(x),
            _ => Some(w),
        }
    }
    match wake {
        Some(w) => WakeAt(w),
        None => Idle,
    }
}

/// Erase the session. With `notify` (an ordinary leave), a DTLS close_notify is
/// appended; a revoke sends nothing.
pub fn close(take p: PeerSession, notify: bool, mut out: Outbox) {
    let mut s = take p
    if notify {
        if let Some(to) = s.path {
            let tag = own_tag(s)
            if let Some(take held) = replace(mut s.dtls, None) {
                let mut e = take held
                let mut d: Bytes = list.with_capacity(SLOT)
                if let Ok(_) = dtls.close(mut e, mut d) {
                    let _ = queue(mut out, to, d, tag)
                }
            }
        }
    }
    s.closed = true
    drop(take s)
}

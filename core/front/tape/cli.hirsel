fn child(take n: u64) -> u64 {
    task.check_cancel()
    n + 1
}

pub fn main(d: Dir, c: Clock, ts: Tasks, out: Stdout, a: Args) -> Result[(), Exit] waits {
    if args.len(a) != 1u64 || option.unwrap(args.get(a, 0)) != "recorded" {
        return Error(Exit(status: 7))
    }
    let h = result.unwrap(task.spawn(ts, bytes 64, 41u64, child))
    if result.unwrap(task.join(take h)) != 42u64 {
        return Error(Exit(status: 8))
    }
    let _ = host.mono_ns(c)
    let text = result.unwrap(std.file.read_string(d, "input.json"))
    let _ = result.unwrap(std.json.size(text))
    result.unwrap(stdout.write(out, text))
    Ok(())
}

pub type Header {
    source: Addr,
    destination: Addr
}

pub type Refusal = Untrusted | Missing | Malformed | Local | Family | TooLong | Silent | Ended | Failed(NetError)

pub type Step = Need(u64) | Done(Header, u64)

pub type Config: shareable + send {
    trusted: List[wsock.Prefix],
    header_max: u64,
    header_ms: u64
}

pub const DEFAULT_HEADER_MAX: u64 = 536

pub const DEFAULT_HEADER_MS: u64 = 3000

const fixed_size: u64 = 16

/// Checks the trusted prefixes and the byte limit for required PROXY v2 headers.
/// Use DEFAULT_HEADER_MAX and DEFAULT_HEADER_MS for the standard limits.
pub fn config(trusted: List[wsock.Prefix], header_max: u64, header_ms: u64) -> Result[Config, ()] {
    let count = list.len(trusted)
    if count == 0 || header_max < 28 || header_max > 65551 {
        return Error(())
    }
    let mut prefixes: List[wsock.Prefix] = list.with_capacity(count)
    list.append(mut prefixes, trusted)
    Ok(Config(trusted: take prefixes, header_max, header_ms))
}

/// Reads the required PROXY v2 header from an accepted plain TCP socket.
/// Checks the peer before reading and closes the socket on every refusal.
/// Waits under one deadline from accepted_ns. Allocates the header buffer.
pub fn accept(take s: Socket, peer: Addr, c: Config, time: Clock, accepted_ns: u64) -> Result[(Socket, Header), Refusal] waits {
    if !wsock.trusted(peer.ip, c.trusted) {
        return Error(Untrusted)
    }
    let deadline = clock.deadline_after_ms(accepted_ns, c.header_ms)
    let (take r, take w) = net.split(take s)
    let mut read = take r
    let mut header: Bytes = list.with_capacity(fixed_size)
    loop {
        match step(header, c.header_max)? {
            Done(parsed, _) => return Ok((result.unwrap(net.join(take read, take w)), parsed)),
            Need(total) => {
                if host.mono_ns(time) >= deadline {
                    return Error(Silent)
                }
                let remaining = total - list.len(header)
                list.reserve(mut header, remaining)
                match host.recv_bounded(mut read, mut header, remaining, At(time, deadline)) {
                    Ok(0) => return Error(Ended),
                    Ok(_) => {},
                    Error(TimedOut) => return Error(Silent),
                    Error(error) => return Error(Failed(error))
                }
            }
        }
    }
}

/// Decodes the PROXY v2 header at the start of b. Need gives the total bytes
/// to supply next, and Done gives the header length. Alloc: nothing.
pub fn step(b: Bytes, header_max: u64) -> Result[Step, Refusal] {
    let size = list.len(b)
    if size >= 12 {
        // The signature is \r\n\r\n\x00\r\nQUIT\n.
        let first: u64 = list.word_be(b, 0)
        let last: u32 = list.word_be(b, 8)
        if first != 0x0d0a0d0a000d0a51 || last != 0x5549540a {
            return Error(Missing)
        }
    }
    if size < fixed_size {
        return Ok(Need(fixed_size))
    }
    let version_command = b[12]
    if version_command != 0x20 && version_command != 0x21 {
        return Error(Malformed)
    }
    let family = b[13]
    let address_size: u64 = match family {
        0x00 => 0,
        0x11 => 12,
        0x12 => 12,
        0x21 => 36,
        0x22 => 36,
        0x31 => 216,
        0x32 => 216,
        _ => return Error(Malformed)
    }
    let length: u16 = list.word_be(b, 14)
    let end = fixed_size + (int.widen(length) : u64)
    let tlvs = fixed_size + address_size
    if end < tlvs || end > tlvs && end - tlvs < 3 {
        return Error(Malformed)
    }
    // The fixed header decides over-cap requests without reading the body.
    if end <= header_max && tlvs < end {
        if size < end {
            return Ok(Need(end))
        }
        let mut at = tlvs
        while at < end {
            if end - at < 3 {
                return Error(Malformed)
            }
            let value_size: u16 = list.word_be(b, at + 1)
            at += 3 + (int.widen(value_size) : u64)
        }
        if at != end {
            return Error(Malformed)
        }
    }
    if version_command == 0x20 {
        return Error(Local)
    }
    if family != 0x11 && family != 0x21 {
        return Error(Family)
    }
    if end > header_max {
        return Error(TooLong)
    }
    if size < end {
        return Ok(Need(end))
    }
    let header = if family == 0x11 {
        let source = Addr(ip: V4(list.word_be(b, 16)), port: list.word_be(b, 24))
        let destination = Addr(ip: V4(list.word_be(b, 20)), port: list.word_be(b, 26))
        Header(source: source, destination: destination)
    } else {
        let source = Addr(ip: V6(list.word_be(b, 16), list.word_be(b, 24)), port: list.word_be(b, 48))
        let destination = Addr(ip: V6(list.word_be(b, 32), list.word_be(b, 40)), port: list.word_be(b, 50))
        Header(source: source, destination: destination)
    }
    Ok(Done(header, end))
}

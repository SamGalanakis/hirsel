// media_record (README): a virtual down-track of the Router. The recorder is
// one more unit (RTC-5): its seats live on it, the control order reaches it
// like any unit, and the home units post it the plaintext `Media` of every
// publication it subscribes to (fan-out step 3). It holds no session, sends no
// RTP and needs no DTLS. One rtp_jitter buffer per recorded encoding turns the
// packets into frames; each frame lands in its track's own file at the time the
// publisher's sender reports give it.
pub type Config {
    // rtp_jitter's reorder window, in packets, and its wait for a hole.
    window: u64,
    max_wait_us: u64,
    // Frames a track holds before its first sender report. Past it they are
    // dropped and a video track asks for a key frame.
    pending: u64
}

/// The recorder's files: a track's file opens when its down-track appears,
/// gets chunk in file order, and closes when the down-track ends.
pub type Output = Opened(file: u64, room: webrtc_sfu.peer.RoomId, publication: webrtc_sfu.router.PublicationId, owner: webrtc_sfu.peer.Gen, format: files.Format) | Wrote(file: u64, data: Bytes) | Closed(file: u64)

/// What the recorder dropped: media a fence or a suspension covers or that
/// came from a stale owner (`stale`), media of no recorded encoding
/// (`unwanted`), video frames before a key frame (`dropped`), frames before
/// the recording's start (`early`), frames past the pending limit
/// (`overflow`), and the key frames it asked for (`keys`).
pub type Counts: key {
    stale: u64,
    unwanted: u64,
    dropped: u64,
    early: u64,
    overflow: u64,
    keys: u64
}

// A frame waiting for its encoding's first sender report.
type Pending {
    ts: i64,
    key: bool,
    data: Bytes
}

// Where an encoding's timeline starts: an extended RTP timestamp and its time
// on the recording's timeline.
type Anchor: key {
    ts: i64,
    at: i64
}

// Where a track's media comes from and goes: its down-track's room, publication
// and subscriber, the publication's owner and the owner's home unit.
type Seat: key {
    room: webrtc_sfu.peer.RoomId,
    publication: webrtc_sfu.router.PublicationId,
    sub: webrtc_sfu.peer.Gen,
    owner: webrtc_sfu.peer.Gen,
    home: u16
}

type Track {
    seat: Seat,
    video: bool,
    file: u64,
    writer: files.Writer,
    codec: rtp_jitter.depack.Codec,
    rate: u64,
    target: webrtc_sfu.router.Target,
    // The wanted mask last posted to the home unit (RTC-6).
    mask: u8,
    // The encoding being recorded, its buffer and every encoding's sender clock.
    encoding: Option[u8],
    jitter: rtp_jitter.jitter.Jitter,
    syncs: List[rtp_jitter.sync.Sync],
    needs_key: bool,
    anchor: Option[Anchor],
    last: Option[i64],
    pending: List[Pending]
}

pub opaque type Recorder {
    r: webrtc_sfu.router.Observer,
    config: Config,
    tracks: List[Track],
    posts: List[webrtc_sfu.router.Post],
    output: List[Output],
    next_file: u64,
    // The recording's zero: the sender wall clock, in ns since the NTP epoch,
    // of its first placed frame.
    origin: Option[i64],
    counts: Counts,
    events: List[rtp_jitter.jitter.Event],
    buffer: Bytes,
    empty: Shared[Bytes]
}

const NS: i64 = 1000000000

pub fn recorder(config: Config, take observer: webrtc_sfu.router.Observer) -> Recorder {
    let empty: Bytes = list.new()
    let mut rec = Recorder(r: take observer, config: config, tracks: list.new(), posts: list.new(), output: list.new(), next_file: 1, origin: None, counts: Counts(stale: 0, unwanted: 0, dropped: 0, early: 0, overflow: 0, keys: 0), events: list.new(), buffer: list.new(), empty: shared.new(take empty))
    let rooms = webrtc_sfu.router.observer_rooms(rec.r)
    for room in rooms {
        settle(mut rec, room)
    }
    rec
}

pub fn counts(rec: Recorder) -> Counts {
    rec.counts
}

/// The messages for other units since the last call: key frame requests and
/// wanted masks for the publications' home units.
pub fn take_posts(mut rec: Recorder) -> List[webrtc_sfu.router.Post] {
    replace(mut rec.posts, list.new())
}

pub fn take_output(mut rec: Recorder) -> List[Output] {
    replace(mut rec.output, list.new())
}

/// Apply one control message (RTC-5). An `Order` is applied like on any unit
/// and answered with this unit's `Ack`; its files are settled first, so a
/// track whose down-track the change ended is closed, and nothing a fence or
/// a suspension covers lands in a file after the acknowledgement (RTC-7).
pub fn control(mut rec: Recorder, now: u64, take c: webrtc_sfu.router.Control) -> Option[webrtc_sfu.router.Control] {
    match take c {
        Order(room: order_room, seq: seq, change: take change) => {
            let allowed = webrtc_sfu.router.observer_routing_allowed(rec.r, order_room, now / 1000000)
            let paused = match change {
                Suspend(room: room, cause: _, on: true) if allowed => Some(room),
                _ => None,
            }
            let answer = webrtc_sfu.router.observer_apply(mut rec.r, order_room, seq, change)
            if let Ok(_) = answer {
                if let Some(room) = paused {
                    for i in 0u64 .. list.len(rec.tracks) {
                        if rec.tracks[i].seat.room == room {
                            restart(mut rec, i)
                        }
                    }
                }
                settle(mut rec, order_room)
            }
            let unit = webrtc_sfu.router.observer_unit(rec.r)
            Some(Ack(room: order_room, seq: seq, unit: unit, answer: take answer))
        },
        _ => None,
    }
}

/// Take one media-inbox message: a publication's packet or its sender report.
/// Each is checked against the fences when it is taken (RTC-7 step 4).
pub fn carried(mut rec: Recorder, now: u64, take msg: webrtc_sfu.router.Carried) {
    let webrtc_sfu.router.Carried(carry: carry, packet: packet) = take msg
    match carry {
        Media(room: room, publication: p, src: src, m: m, handle: _, speaking: _, rate: _, dropped: _) => media(mut rec, now, room, p, src, m, packet),
        Sender(room: room, publication: p, owner: owner, source: source, info: info) => sender(mut rec, now, room, p, owner, source, info),
        _ => {
            rec.counts.unwanted += 1
        },
    }
}

/// Release frames whose holes waited long enough (rtp_jitter `poll`).
pub fn poll(mut rec: Recorder, now: u64) {
    for i in 0u64 .. list.len(rec.tracks) {
        if !webrtc_sfu.router.observer_routing_allowed(rec.r, rec.tracks[i].seat.room, now / 1000000) {
            restart(mut rec, i)
            continue
        }
        rtp_jitter.jitter.poll(mut rec.tracks[i].jitter, now / 1000, mut rec.events)
        deliver(mut rec, i)
    }
}

/// End the recording: every track gives up its holes, writes what it holds
/// and closes its file.
pub fn finish(mut rec: Recorder) {
    while list.len(rec.tracks) != 0 {
        close(mut rec, list.len(rec.tracks) - 1, true)
    }
}

fn is_video(t: Track) -> bool {
    t.video
}

// ---- Tracks follow this unit's down-tracks ----
fn settle(mut rec: Recorder, room: webrtc_sfu.peer.RoomId) {
    let downs = webrtc_sfu.router.observer_downs(rec.r, room)
    let mut i = 0u64
    while i < list.len(rec.tracks) {
        let t = rec.tracks[i].seat
        if t.room != room {
            i += 1
            continue
        }
        let kept = list.any(downs, scoped fn(d: webrtc_sfu.router.DownInfo) -> bool {
            d.room == t.room && d.publication == t.publication && d.sub == t.sub
        })
        if kept {
            i += 1
        } else {
            // A fenced owner's buffered media is dropped, as RTC-7 drops it
            // from every queue; an unsubscribe or a leave lets it land.
            let fenced = webrtc_sfu.router.observer_fenced(rec.r, t.room, t.owner)
            close(mut rec, i, !fenced)
        }
    }
    for d in downs {
        let mut found: Option[u64] = None
        for k in 0u64 .. list.len(rec.tracks) {
            let t = rec.tracks[k].seat
            if t.room == d.room && t.publication == d.publication && t.sub == d.sub {
                found = Some(k)
            }
        }
        match found {
            Some(k) => {
                if rec.tracks[k].target != d.target {
                    restart(mut rec, k)
                    rec.tracks[k].encoding = None
                    rec.tracks[k].target = d.target
                    want(mut rec, k)
                }
            },
            None => open(mut rec, d),
        }
    }
}

fn open(mut rec: Recorder, d: webrtc_sfu.router.DownInfo) {
    let Some(info) = webrtc_sfu.router.observer_publication(rec.r, d.room, d.publication) else {
        return
    }
    let Some(writer) = files.writer(info.shape.codec) else {
        return
    }
    let codec: rtp_jitter.depack.Codec = match info.shape.codec {
        Opus => Opus,
        Vp8 => Vp8,
        Vp9 => Vp9,
        Av1 => Av1,
        _ => H264,
    }
    let video = info.shape.codec != Opus
    let rate = if video {
        90000u64
    } else {
        48000u64
    }
    let mut syncs: List[rtp_jitter.sync.Sync] = list.with_capacity(webrtc_sfu.router.ENCODINGS_MAX)
    for _ in 0u64 .. webrtc_sfu.router.ENCODINGS_MAX {
        list.push(mut syncs, rtp_jitter.sync.new(rate))
    }
    let file = rec.next_file
    rec.next_file += 1
    let format = files.format(writer)
    let j = buffer(rec.config, codec)
    list.push(mut rec.tracks, Track(seat: Seat(room: d.room, publication: d.publication, sub: d.sub, owner: info.owner, home: info.home), video: video, file: file, writer: take writer, codec: codec, rate: rate, target: d.target, mask: 0, encoding: None, jitter: take j, syncs: take syncs, needs_key: video, anchor: None, last: None, pending: list.new()))
    list.push(mut rec.output, Opened(file: file, room: d.room, publication: d.publication, owner: info.owner, format: format))
    want(mut rec, list.len(rec.tracks) - 1)
}

fn buffer(config: Config, codec: rtp_jitter.depack.Codec) -> rtp_jitter.jitter.Jitter {
    rtp_jitter.jitter.new(rtp_jitter.jitter.Config(codec: codec, window: config.window, max_wait_us: config.max_wait_us))
}

// Close track `i`: with `flush`, its buffer gives up its holes and its whole
// frames land; without, what it holds is dropped. The file then ends.
fn close(mut rec: Recorder, i: u64, flush: bool) {
    if flush {
        rtp_jitter.jitter.finish(mut rec.tracks[i].jitter, mut rec.events)
        deliver(mut rec, i)
    }
    let mut t = list.remove(mut rec.tracks, i)
    let mut chunk: Bytes = list.new()
    let _ = files.close(mut t.writer, mut chunk)
    if list.len(chunk) != 0 {
        list.push(mut rec.output, Wrote(file: t.file, data: take chunk))
    }
    list.push(mut rec.output, Closed(file: t.file))
    if t.mask != 0 {
        let unit = webrtc_sfu.router.observer_unit(rec.r)
        post_bare(mut rec, t.seat.home, Wanted(room: t.seat.room, publication: t.seat.publication, src: t.seat.owner, unit: unit, mask: 0))
    }
}

// Drop what track `i` buffers and wait for a key frame (a suspension, a reset
// of the sender's stream, or a switch of encoding).
fn restart(mut rec: Recorder, i: u64) {
    let codec = rec.tracks[i].codec
    rec.tracks[i].jitter = buffer(rec.config, codec)
    list.clear(mut rec.tracks[i].pending)
    rec.tracks[i].anchor = None
    rec.tracks[i].needs_key = is_video(rec.tracks[i])
}

// RTC-6: the home unit publishes an encoding while some unit wants it; this
// unit wants the encoding its down-track targets.
fn want(mut rec: Recorder, i: u64) {
    let mask: u8 = match rec.tracks[i].target {
        Layer(encoding: e, spatial: _, temporal: _) => 1u8 << e,
        Off => 0,
    }
    if mask == rec.tracks[i].mask {
        return
    }
    rec.tracks[i].mask = mask
    let t = rec.tracks[i].seat
    let unit = webrtc_sfu.router.observer_unit(rec.r)
    post_bare(mut rec, t.home, Wanted(room: t.room, publication: t.publication, src: t.owner, unit: unit, mask: mask))
}

fn post_bare(mut rec: Recorder, to: u16, take carry: webrtc_sfu.router.Carry) {
    let packet = shared.share(rec.empty)
    list.push(mut rec.posts, webrtc_sfu.router.Post(to: to, carried: webrtc_sfu.router.Carried(carry: take carry, packet: packet)))
}

fn ask_key(mut rec: Recorder, i: u64) {
    let Some(e) = rec.tracks[i].encoding else {
        return
    }
    let t = rec.tracks[i].seat
    rec.counts.keys += 1
    post_bare(mut rec, t.home, Key(room: t.room, publication: t.publication, encoding: e, why: Loss))
}

// ---- Media ----
fn media(mut rec: Recorder, now: u64, room: webrtc_sfu.peer.RoomId, p: webrtc_sfu.router.PublicationId, src: webrtc_sfu.peer.Gen, m: webrtc_sfu.peer.MediaIn, packet: Bytes) {
    if webrtc_sfu.router.observer_fenced(rec.r, room, src) || !webrtc_sfu.router.observer_routing_allowed(rec.r, room, now / 1000000) {
        rec.counts.stale += 1
        return
    }
    let mut taken = false
    for i in 0u64 .. list.len(rec.tracks) {
        if rec.tracks[i].seat.room != room || rec.tracks[i].seat.publication != p {
            continue
        }
        if rec.tracks[i].seat.owner != src {
            rec.counts.stale += 1
            continue
        }
        let Layer(encoding: e, spatial: _, temporal: _) = rec.tracks[i].target else {
            continue
        }
        if e != m.encoding || m.payload_at + m.payload_len > list.len(packet) {
            continue
        }
        taken = true
        if rec.tracks[i].encoding != Some(e) || m.reset {
            // A new encoding or a reset stream starts a new buffer and timeline.
            rtp_jitter.jitter.finish(mut rec.tracks[i].jitter, mut rec.events)
            deliver(mut rec, i)
            restart(mut rec, i)
            rec.tracks[i].encoding = Some(e)
        }
        let mut payload: Bytes = list.with_capacity(m.payload_len)
        list.append(mut payload, list.slice(packet, m.payload_at, m.payload_at + m.payload_len))
        let seq: u16 = int.truncate(m.index)
        rtp_jitter.jitter.push(mut rec.tracks[i].jitter, seq, m.ts, m.marker, take payload, now / 1000, mut rec.events)
        deliver(mut rec, i)
    }
    if !taken {
        rec.counts.unwanted += 1
    }
}

fn sender(mut rec: Recorder, now: u64, room: webrtc_sfu.peer.RoomId, p: webrtc_sfu.router.PublicationId, owner: webrtc_sfu.peer.Gen, source: u32, info: rtp.rtcp.SenderInfo) {
    if webrtc_sfu.router.observer_fenced(rec.r, room, owner) || !webrtc_sfu.router.observer_routing_allowed(rec.r, room, now / 1000000) {
        rec.counts.stale += 1
        return
    }
    let Some(e) = webrtc_sfu.router.source_encoding(p, source) else {
        rec.counts.stale += 1
        return
    }
    for i in 0u64 .. list.len(rec.tracks) {
        if rec.tracks[i].seat.room != room || rec.tracks[i].seat.publication != p || rec.tracks[i].seat.owner != owner {
            continue
        }
        rtp_jitter.sync.on_sr(mut rec.tracks[i].syncs[e], info.ntp, info.rtp)
        let current: Option[u64] = match rec.tracks[i].encoding {
            Some(x) => Some(int.widen(x)),
            None => None,
        }
        if current == Some(e) && rec.tracks[i].anchor == None && list.len(rec.tracks[i].pending) != 0 {
            let waiting = replace(mut rec.tracks[i].pending, list.new())
            for take f in waiting {
                let Pending(ts: ts, key: key, data: take data) = take f
                place(mut rec, i, ts, key, take data)
            }
        }
    }
}

fn deliver(mut rec: Recorder, i: u64) {
    let events = replace(mut rec.events, list.new())
    for take ev in events {
        match take ev {
            Frame(ts: ts, key: key, data: take data) => place(mut rec, i, ts, key, take data),
            Gap(lo: _, hi: _) => (),
            NeedKeyframe => {
                if is_video(rec.tracks[i]) {
                    rec.tracks[i].needs_key = true
                    ask_key(mut rec, i)
                }
            },
        }
    }
}

// ---- The timeline ----
// A track's first frame on an encoding takes its time from the sender report:
// its sender wall clock less the recording's zero. Later frames advance by RTP
// ticks, so a file's timestamps never go back; a new encoding takes its time
// from its own reports again, never before the track's last frame.
fn place(mut rec: Recorder, i: u64, ts: i64, key: bool, take data: Bytes) {
    if rec.tracks[i].needs_key && !key {
        rec.counts.dropped += 1
        return
    }
    let at = match rec.tracks[i].anchor {
        Some(a) => {
            let rate: i64 = int.narrow(rec.tracks[i].rate)
            let delta = ts - a.ts
            let mut whole = delta / rate
            let mut part = delta % rate
            if part < 0 {
                whole -= 1
                part += rate
            }
            a.at + whole * NS + part * NS / rate
        },
        None => {
            let e: u64 = match rec.tracks[i].encoding {
                Some(x) => int.widen(x),
                None => 0,
            }
            let Some(wall) = rtp_jitter.sync.wall_ns(rec.tracks[i].syncs[e], ts) else {
                hold(mut rec, i, ts, key, take data)
                return
            }
            let zero = match rec.origin {
                Some(z) => z,
                None => {
                    rec.origin = Some(wall)
                    wall
                },
            }
            let mut at = wall - zero
            if at < 0 {
                rec.counts.early += 1
                if is_video(rec.tracks[i]) {
                    rec.tracks[i].needs_key = true
                    ask_key(mut rec, i)
                }
                return
            }
            if let Some(last) = rec.tracks[i].last {
                if at < last {
                    at = last
                }
            }
            rec.tracks[i].anchor = Some(Anchor(ts: ts, at: at))
            at
        },
    }
    let mut at_ns = at
    if let Some(last) = rec.tracks[i].last {
        if at_ns < last {
            at_ns = last
        }
    }
    list.clear(mut rec.buffer)
    match files.frame(mut rec.tracks[i].writer, at_ns, key, take data, mut rec.buffer) {
        Ok(()) => {
            rec.tracks[i].needs_key = false
            rec.tracks[i].last = Some(at_ns)
            if list.len(rec.buffer) != 0 {
                let mut chunk: Bytes = list.with_capacity(list.len(rec.buffer))
                list.append(mut chunk, rec.buffer)
                list.push(mut rec.output, Wrote(file: rec.tracks[i].file, data: take chunk))
            }
        },
        Error(_) => {
            rec.counts.dropped += 1
            rec.tracks[i].needs_key = true
            ask_key(mut rec, i)
        },
    }
}

fn hold(mut rec: Recorder, i: u64, ts: i64, key: bool, take data: Bytes) {
    if list.len(rec.tracks[i].pending) >= rec.config.pending {
        rec.counts.overflow += list.len(rec.tracks[i].pending) + 1
        list.clear(mut rec.tracks[i].pending)
        if is_video(rec.tracks[i]) {
            rec.tracks[i].needs_key = true
            ask_key(mut rec, i)
        }
        return
    }
    list.push(mut rec.tracks[i].pending, Pending(ts: ts, key: key, data: take data))
}

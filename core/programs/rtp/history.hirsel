pub type Lookup = Found(u64) | Missing | Throttled | BeforeSwitch

// An index is at most 2^48 - 1 (RTP-2), so this marks an empty slot.
const EMPTY: u64 = 0xffffffffffffffff

// A slot's index, when it was sent and last resent, and its value.
type Slot[P] {
    index: u64,
    sent: u64,
    resent: u64,
    value: Option[P]
}

pub opaque type History[P] {
    slots: Columns[Slot[P]],
    max_age_ns: u64,
    gate: u64
}

pub fn history[P](slots: u32, max_age_ns: u64) -> Result[History[P], Capacity] {
    let n: u64 = int.widen(slots)
    if n == 0 || n > 32768 {
        return Error(Capacity(requested: n, available: 32768))
    }
    let mut rows: Columns[Slot[P]] = columns.new()
    columns.try_reserve(mut rows, n)?
    while columns.len(rows) < n {
        columns.push(mut rows, Slot(index: EMPTY, sent: 0, resent: EMPTY, value: None))
    }
    Ok(History(slots: rows, max_age_ns: max_age_ns, gate: 0))
}

/// The heap bytes `history(slots, _)` reserves beyond the `History[P]` value (RTC-10
/// `room_cost`); `of` only names `P`. A `Columns` charges as a `List` of its rows (MEM-24).
pub fn history_heap[P](slots: u32, of: Option[P]) -> u64 {
    option.unwrap(charge.seq(bytes[Slot[P]], int.widen(slots)))
}

pub fn put[P](mut h: History[P], index: u64, at_ns: u64, take p: P) -> Option[P] {
    let i = index % columns.len(h.slots)
    let Slot(value: take old, ..) = columns.set(mut h.slots, i, Slot(index: index, sent: at_ns, resent: EMPTY, value: Some(p)))
    old
}

pub fn get[P](mut h: History[P], index: u64, now_ns: u64, min_resend_ns: u64) -> Lookup {
    if index < h.gate {
        return BeforeSwitch
    }
    let i = index % columns.len(h.slots)
    if index == EMPTY || h.slots.index[i] != index || (now_ns > h.slots.sent[i] && now_ns - h.slots.sent[i] > h.max_age_ns) {
        return Missing
    }
    let last = h.slots.resent[i]
    if last != EMPTY && (now_ns < last || now_ns - last < min_resend_ns) {
        return Throttled
    }
    h.slots.resent[i] = now_ns
    Found(index)
}

pub fn entry[P](h: History[P], index: u64) -> Option[View[P]] in h {
    let i = index % columns.len(h.slots)
    if index == EMPTY || h.slots.index[i] != index {
        return None
    }
    match h.slots.value[i] {
        Some(p) => Some(p),
        None => None,
    }
}

pub fn gate[P](mut h: History[P], index: u64) {
    // A gate only rises: a lookup refused once stays refused.
    if index > h.gate {
        h.gate = index
    }
}

pub fn clear[P](mut h: History[P]) -> u64 {
    let mut dropped = 0u64
    let mut i = 0u64
    while i < columns.len(h.slots) {
        if h.slots.index[i] != EMPTY {
            dropped += 1
            h.slots.index[i] = EMPTY
            h.slots.resent[i] = EMPTY
            h.slots.value[i] = None
        }
        i += 1
    }
    dropped
}

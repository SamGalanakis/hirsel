// rule: SEM-5
// expect: run
// grant: clock
// stdout: instants ordered
// stdout: aggregates ordered
// Same-domain comparisons of Instants and of opted-in nominals: an Instant orders by its
// unsigned ticks (an instant past 2^63 ticks is later, never earlier), and aggregates and
// generic calls agree with it.
pub type Failed = Failed()

pub type Span: ordered {
  start: u64,
  end: u64,
}

pub type Mark: ordered = Low | High(u8)

fn earlier[T: ordered](a: T, b: T) -> bool {
  a < b
}

fn check(holds: bool) -> Result[(), Failed] {
  if holds {
    Ok(())
  } else {
    Error(Failed())
  }
}

fn say(stdout: Stdout, line: String) -> Result[(), Failed] {
  match out.print(stdout, f"{line}\n") {
    Ok(_) => Ok(()),
    Error(_) => Error(Failed()),
  }
}

fn instants(c: MonotonicClock) -> Result[(), Failed] {
  let Ok(now) = clock.monotonic(c) else {
    return Error(Failed())
  }
  let Ok(late) = time.deadline(c, duration.from_parts(9223372036, 854775808)) else {
    return Error(Failed())
  }
  check(now < late && now <= late && late > now && late >= now)?
  check(!(late < now) && now != late && now == now)?
  check(earlier(now, late) && !earlier(late, now) && !earlier(now, now))?
  check((now, 1u8) < (late, 0u8) && (now, 0u8) < (now, 1u8))?
  check(Some(now) < Some(late) && Some(now) > None && [now, late] < [late])?
  Ok(())
}

fn nominals() -> Result[(), Failed] {
  check(Span(start: 1, end: 9) < Span(start: 2, end: 0))?
  check(Span(start: 1, end: 2) < Span(start: 1, end: 3))?
  check(Low() < High(0) && High(1) < High(2) && earlier(High(0), High(7)))?
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Failed())
  }
  let Ok(c) = io.monotonic_clock(rt) else {
    return Error(Failed())
  }
  instants(c)?
  say(stdout, "instants ordered")?
  nominals()?
  say(stdout, "aggregates ordered")
}

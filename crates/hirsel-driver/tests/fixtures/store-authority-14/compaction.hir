// Bounded vectors from DET-1-std-store-crash-{boundaries,compaction}-run:
// two acknowledged commits leave b=2,c=3; stop 8 interrupts compaction's manifest.
fn apply_writes(
  mut tx: store.Tx,
  info: store.CallInfo,
  writes: List[(Bytes, Option[Bytes])]
) -> Result[(), store.TxError] {
  for (k, v) in writes {
    match v {
      Some(value) => store.tx_put(mut tx, unique k, unique value)?,
      None() => store.tx_delete(mut tx, unique k)?,
    }
  }
  Ok(())
}

// The store's error, whether or not the commit may have become durable.
fn commit(mut s: store.Store[Dir], writes: List[(Bytes, Option[Bytes])]) -> Result[
  (),
  store.StoreError
] {
  match store.transact(mut s, apply_writes, writes) {
    Ok(()) => Ok(()),
    Error(Storage(e)) => Error(e),
    Error(Unknown(e)) => Error(e),
    Error(_) => Error(Corrupt("commit")),
  }
}

fn workload(d: Dir, stop: Option[u64]) -> Result[(), store.StoreError] uses {d} {
  let mut config = store.default_config()
  if let Some(n) = stop {
    config.faults = StopAfterWrites(n)
  }
  let mut s = store.open(d, config)?
  commit(mut s, [(b"a", Some(b"1")), (b"b", Some(b"2"))])?
  commit(mut s, [(b"c", Some(b"3")), (b"a", None())])?
  store.compact(mut s)?
  store.close(take s)
}

fn recovered(t: Test, d: Dir) -> Result[(), store.StoreError] {
  let mut s = store.open(d, store.default_config())?
  let all: ordered_map.Bound[Bytes] = Unbounded()
  test.check(
    t,
    store.range(store.snapshot(mut s), all, Unbounded(), Ascending(), 100) == [
      (b"b", b"2"),
      (b"c", b"3")
    ]
  )
  commit(mut s, [(b"d", Some(b"5"))])?
  store.close(take s)?
  let mut again = store.open(d, store.default_config())?
  test.check(t, store.get(store.snapshot(mut again), b"d") == Some(b"5"))
  store.close(take again)
}

pub fn main(t: Test) -> Result[(), store.StoreError] {
  let success = test.dir(t, [])
  workload(success, None())?
  recovered(t, success)?
  let failed = test.dir(t, [])
  test.check(t, workload(failed, Some(8)) == Error(Injected()))
  recovered(t, failed)
}

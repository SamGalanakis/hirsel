// Module `map` (SEM-5).
pub fn new[K: key, V]() -> Map[K, V]

pub fn len[K: key, V](m: Map[K, V]) -> u64

type Probe = Found(u64, u64) | Vacant(u64) | Crowded

fn placement[K: key, V](m: Map[K, V], k: K) -> u64 {
    let class = fast_class(m)
    if class == 0 {
        strong(k)
    } else if class == 1 {
        let p = place(k)
        if mode(m) {
            strong(k)
        } else {
            p
        }
    } else if mode(m) {
        strong(k)
    } else {
        place(k)
    }
}

fn more_groups[K: key, V](m: Map[K, V], scanned: u64, mask: u64) -> bool {
    scanned <= mask && (scanned != 8 || fast_class(m) == 0 || mode(m))
}

fn first_lane(bits: u64) -> u64 {
    let lane: u64 = int.widen(int.trailing_zeros(bits))
    lane & 15
}

// Look for a match before terminating at EMPTY or using a remembered vacancy.
fn probe[K: key, V](m: Map[K, V], k: K, p: u64, inserting: bool) -> Probe {
    let mask = group_mask(m)
    let tag = p >> 57
    let bucket_mask = mask << 4
    let mut base = (p & mask) << 4
    let mut n: u64 = 0
    let mut first_free: u64 = 18446744073709551615
    loop {
        let group = base >> 4
        let mut matches = group_match(m, group, tag)
        while matches != 0 {
            let lane = first_lane(matches)
            let bucket = base | lane
            let entry = bucket_entry(m, bucket)
            if slot_key(m, entry) == k {
                return Found(entry, bucket)
            }
            matches = matches & int.wrapping_sub(matches, 1)
        }
        if inserting && first_free == 18446744073709551615 {
            let free = group_vacant(m, group)
            if free != 0 {
                let lane = first_lane(free)
                first_free = base | lane
            }
        }
        if group_empty(m, group) != 0 {
            break
        }
        n = int.wrapping_add(n, 1)
        if !more_groups(m, n, mask) {
            break
        }
        base = int.wrapping_add(base, n << 4) & bucket_mask
    }
    if first_free == 18446744073709551615 {
        Crowded
    } else {
        Vacant(first_free)
    }
}

pub fn get[K: key, V](m: Map[K, V], k: K) -> Option[View[V]] in m {
    if capacity(m) == 0 {
        return None
    }
    match probe(m, k, placement(m, k), false) {
        Found(i, _) => Some(slot_value(m, i)),
        _ => None,
    }
}

fn probe_insert[K: key, V](m: Map[K, V], k: K) -> (u64, Probe) {
    if capacity(m) == 0 {
        return (0, Vacant(0))
    }
    let p = placement(m, k)
    (p, probe(m, k, p, true))
}

// The in-place insertion lowerer only needs the entry on Found, or the
// placement word and bucket on Vacant. Crowded has no valid bucket.
fn probe_staged[K: key, V](m: Map[K, V], k: K) -> (u64, u64, bool, bool) {
    let (p, r) = probe_insert(m, k)
    match r {
        Found(i, _) => (p, i, true, false),
        Vacant(b) => (p, b, false, false),
        Crowded => (p, 0, false, true),
    }
}

fn vacancy[K: key, V](m: Map[K, V], p: u64) -> Option[u64] {
    let mask = group_mask(m)
    let mut g = p & mask
    let mut n: u64 = 0
    loop {
        let free = group_vacant(m, g)
        if free != 0 {
            let lane = first_lane(free)
            return Some((g << 4) | lane)
        }
        n = int.wrapping_add(n, 1)
        if !more_groups(m, n, mask) {
            break
        }
        g = int.wrapping_add(g, n) & mask
    }
    None
}

fn place_entry[K: key, V](mut m: Map[K, V], p: u64, i: u64) -> bool {
    match vacancy(m, p) {
        Some(b) => {
            install(mut m, b, p, i)
            true
        },
        None => false,
    }
}

fn commit[K: key, V](mut m: Map[K, V], b: u64, p: u64) {
    let i = slots(m)
    install(mut m, b, p, i)
    advance(mut m)
}

// Promotion rebuilds the live prefix without reading the staged next slot.
fn promote[K: key, V](mut m: Map[K, V]) {
    set_strong(mut m)
    clear_index(mut m)
    let count = slots(m)
    let mut i: u64 = 0
    while i < count {
        if slot_meta(m, i) != 0 {
            let p = strong(slot_key(m, i))
            let _ = place_entry(mut m, p, i)
        }
        i = int.wrapping_add(i, 1)
    }
}

fn rebuild[K: key, V](mut m: Map[K, V]) {
    clear_index(mut m)
    let count = slots(m)
    let mut i: u64 = 0
    while i < count {
        let p = slot_meta(m, i)
        if p != 0 && !place_entry(mut m, p, i) {
            promote(mut m)
            return
        }
        i = int.wrapping_add(i, 1)
    }
}

// The pending key is known absent. After a rebuild its earlier bucket and word
// no longer apply. Strong post-promotion placement always has a vacancy.
fn reprobe_crowded[K: key, V](mut m: Map[K, V], k: K) -> (u64, u64) {
    promote(mut m)
    let p = strong(k)
    let mask = group_mask(m)
    let mut g = p & mask
    let mut n: u64 = 0
    loop {
        let free = group_vacant(m, g)
        if free != 0 {
            let lane = first_lane(free)
            return ((g << 4) | lane, p)
        }
        n = int.wrapping_add(n, 1)
        g = int.wrapping_add(g, n) & mask
    }
}

fn commit_crowded[K: key, V](mut m: Map[K, V], k: K) {
    let (b, p) = reprobe_crowded(mut m, k)
    commit(mut m, b, p)
}

fn put_absent[K: key, V](mut m: Map[K, V], take k: K, take v: V, b: u64, p: u64, crowded: bool) -> u64 {
    let (bucket, word) = if slots(m) == capacity(m) {
        make_room(mut m)
        let word = placement(m, k)
        match vacancy(m, word) {
            Some(bucket) => (bucket, word),
            None => reprobe_crowded(mut m, k),
        }
    } else if crowded {
        reprobe_crowded(mut m, k)
    } else {
        (b, p)
    }
    let i = slots(m)
    push_entry(mut m, take k, take v)
    commit(mut m, bucket, word)
    i
}

pub fn insert[K: key, V](mut m: Map[K, V], take k: K, take v: V) {
    let (p, r) = probe_insert(m, k)
    match r {
        Found(i, _) => {
            let _ = swap_value(mut m, i, take v)
            let _ = take k
        },
        Vacant(b) => {
            let _ = put_absent(mut m, take k, take v, b, p, false)
        },
        Crowded => {
            let _ = put_absent(mut m, take k, take v, 0, p, true)
        },
    }
}

pub fn update[K: key, V, R](mut m: Map[K, V], k: K, f: scoped fn(mut V) -> R) -> Option[R] {
    if capacity(m) == 0 {
        return None
    }
    match probe(m, k, placement(m, k), false) {
        Found(i, _) => Some(with_value(mut m, i, f)),
        _ => None,
    }
}

pub fn remove[K: key, V](mut m: Map[K, V], k: K) -> Option[V] {
    if capacity(m) == 0 {
        return None
    }
    match probe(m, k, placement(m, k), false) {
        Found(i, b) => {
            erase(mut m, b)
            Some(kill(mut m, i))
        },
        _ => None,
    }
}

pub fn reserve[K: key, V](mut m: Map[K, V], n: u64) {
    let target = reserve_target(m, n)
    if target != 0 {
        regrow(mut m, target)
        rebuild(mut m)
    } else if int.saturating_add(slots(m), n) > capacity(m) {
        compact(mut m)
        rebuild(mut m)
    }
}

pub fn try_reserve[K: key, V](mut m: Map[K, V], n: u64) -> Result[(), Capacity] {
    let target = reserve_target(m, n)
    if target != 0 {
        try_regrow(mut m, target)?
        rebuild(mut m)
    } else if int.saturating_add(slots(m), n) > capacity(m) {
        compact(mut m)
        rebuild(mut m)
    }
    Ok(())
}

fn reserve_target[K: key, V](m: Map[K, V], n: u64) -> u64 {
    let cap = capacity(m)
    let needed = int.saturating_add(len(m), n)
    if needed <= cap {
        return 0
    }
    growth_target(cap, needed)
}

fn growth_target(cap: u64, needed: u64) -> u64 {
    if needed > 576460752303423488 {
        return needed
    }
    let doubled = int.wrapping_add(cap, cap)
    let grown: u64 = if doubled > 576460752303423488 {
        576460752303423488
    } else {
        doubled
    }
    if needed > grown {
        if needed < 4 {
            4
        } else {
            needed
        }
    } else {
        if grown < 4 {
            4
        } else {
            grown
        }
    }
}

fn make_room[K: key, V](mut m: Map[K, V]) {
    let cap = capacity(m)
    let live = len(m)
    if cap != 0 && live <= cap / 2 {
        compact(mut m)
    } else {
        let target = growth_target(cap, int.wrapping_add(live, 1))
        regrow(mut m, target)
    }
    rebuild(mut m)
}

// Core-private clone, with each completed pair available to cleanup before the
// next key or value is cloned. Rebuild only after the whole copy exists.
clone[K: key, V](x: Map[K, V]) {
    let mut copied: Map[K, V] = new()
    let was_strong = if capacity(x) == 0 {
        strong_empty(x)
    } else {
        mode(x)
    }
    if was_strong {
        set_strong_empty(mut copied)
    }
    let count = len(x)
    if count != 0 {
        regrow(mut copied, count)
        let mut i: u64 = 0
        while i < slots(x) {
            let meta = slot_meta(x, i)
            if meta != 0 {
                let key: K = clone(slot_key(x, i))
                let value: V = clone(slot_value(x, i))
                copy_entry(mut copied, meta, take key, take value)
            }
            i = int.wrapping_add(i, 1)
        }
        rebuild(mut copied)
    }
    take copied
}

pub fn update_or_insert[K: key, V, R](mut m: Map[K, V], take k: K, take initial: V, f: scoped fn(mut V) -> R) -> R {
    let (p, r) = probe_insert(m, k)
    let entry = match r {
        Found(i, _) => {
            let _ = take k
            let _ = take initial
            i
        },
        Vacant(b) => put_absent(mut m, take k, take initial, b, p, false),
        Crowded => put_absent(mut m, take k, take initial, 0, p, true),
    }
    with_value(mut m, entry, f)
}

fn hash[K: key](k: K) -> u64

fn place[K: key](k: K) -> u64

fn strong[K: key](k: K) -> u64

fn fast_class[K: key, V](m: Map[K, V]) -> u8

fn slots[K: key, V](m: Map[K, V]) -> u64

fn capacity[K: key, V](m: Map[K, V]) -> u64

fn mode[K: key, V](m: Map[K, V]) -> bool

fn group_mask[K: key, V](m: Map[K, V]) -> u64

fn strong_empty[K: key, V](m: Map[K, V]) -> bool

fn set_strong_empty[K: key, V](mut m: Map[K, V])

fn group_match[K: key, V](m: Map[K, V], g: u64, tag: u64) -> u64

fn group_empty[K: key, V](m: Map[K, V], g: u64) -> u64

fn group_vacant[K: key, V](m: Map[K, V], g: u64) -> u64

fn bucket_entry[K: key, V](m: Map[K, V], b: u64) -> u64

fn install[K: key, V](mut m: Map[K, V], b: u64, p: u64, i: u64)

fn advance[K: key, V](mut m: Map[K, V])

fn erase[K: key, V](mut m: Map[K, V], b: u64)

fn clear_index[K: key, V](mut m: Map[K, V])

fn set_strong[K: key, V](mut m: Map[K, V])

fn slot_meta[K: key, V](m: Map[K, V], i: u64) -> u64

fn slot_key[K: key, V](m: Map[K, V], i: u64) -> View[K] in m

fn slot_value[K: key, V](m: Map[K, V], i: u64) -> View[V] in m

fn with_value[K: key, V, R](mut m: Map[K, V], i: u64, f: scoped fn(mut V) -> R) -> R

fn swap_value[K: key, V](mut m: Map[K, V], i: u64, take v: V) -> V

fn kill[K: key, V](mut m: Map[K, V], i: u64) -> V

fn take_entry[K: key, V](mut m: Map[K, V], i: u64) -> (K, V)

fn push_entry[K: key, V](mut m: Map[K, V], take k: K, take v: V)

fn copy_entry[K: key, V](mut m: Map[K, V], meta: u64, take k: K, take v: V)

fn compact[K: key, V](mut m: Map[K, V])

fn regrow[K: key, V](mut m: Map[K, V], cap: u64)

fn try_regrow[K: key, V](mut m: Map[K, V], cap: u64) -> Result[(), Capacity]

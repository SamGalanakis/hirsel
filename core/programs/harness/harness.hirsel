// A Hirsel LLM harness: one Place holds one session. The turn is rows and
// short transactions; no code runs between effects. See README.md.
// ---- payloads, entries and receipts ----
// A BlobRef names immutable bytes in the session's object bucket and prefix.
pub type BlobRef: codec + send {
    digest: Bytes,
    len: u64,
    mime: String,
    excerpt: Option[String]
}

pub type Payload: codec + send = Inline(Bytes) | Blob(BlobRef)

pub const INLINE_LIMIT: u64 = 65536u64

pub type Call: codec + send {
    id: String,
    name: String,
    args: Payload
}

pub type Usage: codec + send {
    input: u64,
    output: u64,
    cache_read: u64,
    cache_write: u64,
    reasoning: u64
}

// model.answer: the complete, validated provider outcome.
pub type Answer: codec + send {
    text: String,
    calls: List[Call],
    stop: String,
    usage: Usage
}

pub type Outcome: codec + send = Returned(Payload) | Failed(String) | Denied(String) | InDoubt | Gone

// A positional system patch. A baseline replaces every section with its
// changes, in order. Otherwise a change for a shown key replaces its text in
// place, a change for a new key is added at the end, and `None` removes the
// key. `tools`, when present, replaces the offered tool definitions.
pub type Change: codec + send {
    key: String,
    text: Option[String]
}

pub type ToolDef: codec + send {
    name: String,
    about: String,
    input: String,
    rev: u64,
    catalog: Option[Bytes]
}

pub type Patch: codec + send {
    baseline: bool,
    changes: List[Change],
    tools: Option[List[ToolDef]]
}

// What the model is shown for a tool outcome, recorded with the result entry
// (ADR 0120): resume, resend, forks and releases read it and never word the
// outcome again.
pub type Presented: codec + send {
    text: String,
    error: bool
}

pub type Entry: codec + send = User(String) | Inform(String) | Assistant(Answer) | ToolResult(String, Outcome, Presented) | System(Patch) | Note(String, Bytes)

// ---- the harness tables ----
pub type Narrow: codec + send = All | Only(List[String])

pub type SectionHash: codec + send {
    key: String,
    hash: Bytes
}

pub type Session: codec + send {
    model: String,
    tools_narrow: Narrow,
    admitted: List[String],
    // The current agent frame's base; 0 is the root frame, which has no row.
    frame: u64,
    next_pos: u64,
    active_run: Option[u64],
    next_run: u64,
    next_seq: u64,
    active_sections_hashes: List[SectionHash],
    active_tools_hash: Bytes,
    active_tools_pos: Option[u64],
    warm_left: u64,
    warm: Option[WarmState],
}

pub type WarmState: codec + send = Waiting(EffectKey, runner.triggers.Id, u64) | Warming(EffectKey)

pub type InboxKey: codec + send {
    caller: store.Caller,
    client_key: String
}

// Where an admitted item stands. Queued(seq) waits in the ingress; the drain
// that takes it rewrites the inbox row to Placed(run) when it starts a run,
// Joined(run) when an Early input joins the running run, or Applied when a
// command applies. A resubmission answers the current row.
pub type Disposition: codec + send = Placed(u64) | Queued(u64) | Joined(u64) | Applied

// Early input steers the running run of the same caller at its next prepare;
// NextTurn input waits for a turn boundary. Early input that no running run of
// its caller can take is next-turn input by rule.
pub type When: codec + send = Early | NextTurn

// A session command applies alone at a turn boundary, never mid-turn, ahead of
// the inputs queued with it.
pub type Command: codec + send = Narrow(Narrow) | Compact(String)

pub type Item: codec + send = Input(When, String) | Command(Command)

// One admitted ingress item, keyed by the session's enqueue_seq. The submitter
// is `key.caller`.
pub type Lodged: codec + send {
    key: InboxKey,
    item: Item
}

pub type Received: codec + send {
    digest: Bytes,
    disposition: Disposition
}

pub type Finish: codec + send = Answered | OutOfRounds | Stopped(String) | Cancelled

pub type Phase: codec + send = Preparing | AwaitingModel(u64) | AnswerReady(u64, u64) | AwaitingRound(u64, u64) | Finished(Finish)

// Known spend is settled usage; reserved is the bound held for calls that may
// still be charged; unresolved is a reservation whose call is in doubt.
pub type Spend: codec + send {
    known: u64,
    reserved: u64,
    unresolved: u64
}

pub type Run: codec + send {
    caller: store.Caller,
    phase: Phase,
    round: u64,
    rounds_left: u64,
    // Consecutive tool rounds in which no tool returned.
    stalled: u64,
    spend: Spend
}

pub const MODEL: u8 = 0u8

pub const TOOL: u8 = 1u8

pub const WARM: u8 = 2u8

pub type EffectKey: codec + send {
    run: u64,
    round: u64,
    kind: u8,
    ordinal: u64
}

// The immutable logical cutoff of a model request. The worker builds the body
// from the frame's seed and entries[frame..=tail_pos] through a snapshot, off
// the write lock, leaving out the messages the sealed `omit` ranges cover.
pub type Cutoff: codec + send {
    frame: u64,
    tail_pos: u64,
    route: String,
    policy: u64,
    tools_pos: Option[u64],
    omit: List[Omit]
}

// An agent frame (ADR 0001): the prompt starts at `base` with `seed` as its
// first message. The history is never rewritten; a frame only moves where the
// prompt starts. Keyed by base, so one open per base, ever.
pub type Frame: codec + send {
    parent: u64,
    reason: String,
    seed: String
}

pub type FrameOpen: codec + send {
    base: u64,
    reason: String,
    seed: String
}

// What the pressure and view hooks are shown at a prepare.
pub type Pressure: codec + send {
    frame: u64,
    next_pos: u64,
    run: u64,
    round: u64
}

pub type Pressed: codec + send = Continue | OpenFrame(FrameOpen)

// Positions from..=upto left out of one request's messages. System entries in
// the range still fold.
pub type Omit: codec + send {
    from: u64,
    upto: u64
}

pub const MAX_OMIT: u64 = 8u64

// Consecutive tool rounds with no Returned outcome before the run stops.
pub type NoProgress: send = Bounded(u64) | Unbounded

// How often a model call that may already have been billed may be sent again
// (crash resend, dropped stream, backoff retry). RequireGuarantee sends once;
// BoundedDuplicate(n) allows n duplicates.
pub type ChargeSafety: send = RequireGuarantee | BoundedDuplicate(u64)

// Once dispatches at most one body. Repeatable(n) resends with the same key
// up to n dispatches within the deadline.
pub type Repeat: codec + send = Once | Repeatable(u64)

// Retry delays in ModelFault are seconds. Store and runner clocks use milliseconds.
pub const MAX_MODEL_BACKOFF_SECONDS: u64 = 60u64

pub type ModelFault: codec + send = Throttled(String, u64) | Transient(String, u64) | ContextExceeded(String) | StreamDropped(String) | Rejected(String)

pub type Receipt: codec + send = Model(Answer) | ModelFailed(ModelFault) | Tool(Outcome)

// Held waits for an approval; Parked waits for `resume` after an Inside tool
// returned Later.
pub type EffectPhase: codec + send = Pending | Held | Parked | Sealed | Dispatched(u64) | Settled(Receipt) | Doubted

pub type Effect: codec + send {
    cutoff: Cutoff,
    call: Option[Call],
    repeat: Repeat,
    deadline: u64,
    phase: EffectPhase,
    trigger: Option[runner.triggers.Id],
    dispatches: u64,
    stream: bool,
    reserve: u64,
}

pub type WaitKey: codec + send {
    run: u64,
    slot: u64,
    kind: u8,
    generation: u64
}

// An open approval holds its key and the wall-clock ms at which it expires.
pub type Wait: codec + send = Open(Bytes, u64) | Decided(Bytes, bool) | Expired | Revoked

// The public Cover projection. Key 0 is the status row; key p + 1 is the
// visible line of entry p.
pub type View: codec + send = Status(String) | Line(String, String)

pub type Handles: send {
    session: store.Table[u64, Session],
    entries: store.Table[u64, Entry],
    inbox: store.Table[InboxKey, Received],
    ingress: store.Table[u64, Lodged],
    frames: store.Table[u64, Frame],
    runs: store.Table[u64, Run],
    effects: store.Table[EffectKey, Effect],
    waits: store.Table[WaitKey, Wait],
    views: store.Table[u64, View],
    readers: store.Table[Bytes, bool],
    fork_cuts: store.Table[u64, u64],
    mcp_catalog: store.Table[String, mcp_tools.Remote],
    triggers: runner.triggers.Tables,
}

fn session_name() -> String {
    "harness.session"
}

fn entries_name() -> String {
    "harness.entries"
}

fn inbox_name() -> String {
    "harness.inbox"
}

fn ingress_name() -> String {
    "harness.ingress"
}

fn runs_name() -> String {
    "harness.runs"
}

fn effects_name() -> String {
    "harness.effects"
}

fn waits_name() -> String {
    "harness.waits"
}

fn views_name() -> String {
    "harness.views"
}

fn put_inbox_key(k: InboxKey, mut out: Bytes) {
    std.codec.put_key_u8(k.caller.issuer, mut out)
    std.codec.put_key_bytes(k.caller.subject, mut out)
    std.codec.put_key_string(k.client_key, mut out)
}

fn take_inbox_key(raw: Bytes, mut at: u64) -> Result[InboxKey, std.codec.DecodeError] {
    let issuer = std.codec.take_key_u8(raw, mut at)?
    let subject = std.codec.take_key_bytes(raw, mut at)?
    let client_key = std.codec.take_key_string(raw, mut at)?
    Ok(InboxKey(caller: store.Caller(issuer: issuer, subject: take subject), client_key: take client_key))
}

fn inbox_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 3u64)?
    std.codec.schema_u8(mut s)
    std.codec.schema_key(mut s, std.codec.key_bytes())?
    std.codec.schema_string(mut s)
    Ok(())
}

fn inbox_key() -> std.codec.Key[InboxKey] {
    std.codec.key_make(put_inbox_key, take_inbox_key, inbox_schema)
}

fn put_effect_key(k: EffectKey, mut out: Bytes) {
    std.codec.put_key_u64(k.run, mut out)
    std.codec.put_key_u64(k.round, mut out)
    std.codec.put_key_u8(k.kind, mut out)
    std.codec.put_key_u64(k.ordinal, mut out)
}

fn take_effect_key(raw: Bytes, mut at: u64) -> Result[EffectKey, std.codec.DecodeError] {
    let run = std.codec.take_key_u64(raw, mut at)?
    let round = std.codec.take_key_u64(raw, mut at)?
    let kind = std.codec.take_key_u8(raw, mut at)?
    let ordinal = std.codec.take_key_u64(raw, mut at)?
    Ok(EffectKey(run: run, round: round, kind: kind, ordinal: ordinal))
}

fn quad_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 4u64)?
    std.codec.schema_u64(mut s)
    std.codec.schema_u64(mut s)
    std.codec.schema_u8(mut s)
    std.codec.schema_u64(mut s)
    Ok(())
}

fn effect_key() -> std.codec.Key[EffectKey] {
    std.codec.key_make(put_effect_key, take_effect_key, quad_schema)
}

fn put_wait_key(k: WaitKey, mut out: Bytes) {
    std.codec.put_key_u64(k.run, mut out)
    std.codec.put_key_u64(k.slot, mut out)
    std.codec.put_key_u8(k.kind, mut out)
    std.codec.put_key_u64(k.generation, mut out)
}

pub fn take_wait_key(raw: Bytes, mut at: u64) -> Result[WaitKey, std.codec.DecodeError] {
    let run = std.codec.take_key_u64(raw, mut at)?
    let slot = std.codec.take_key_u64(raw, mut at)?
    let kind = std.codec.take_key_u8(raw, mut at)?
    let generation = std.codec.take_key_u64(raw, mut at)?
    Ok(WaitKey(run: run, slot: slot, kind: kind, generation: generation))
}

pub fn wait_key() -> std.codec.Key[WaitKey] {
    std.codec.key_make(put_wait_key, take_wait_key, quad_schema)
}

// Re-running the migration on a migrated store is a no-op, as for the
// trigger tables, so a place reopens a store a host seeded.
fn created(take r: Result[(), store.Error]) -> Result[(), store.Error] {
    match take r {
        Error(Exists(_)) => Ok(()),
        other => take other,
    }
}

pub fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    runner.triggers.migrate(mut phase)?
    mcp_tools.migrate(mut phase)?
    let c_session: std.codec.Codec[Session] = std.codec.of()
    let c_entry: std.codec.Codec[Entry] = std.codec.of()
    let c_received: std.codec.Codec[Received] = std.codec.of()
    let c_lodged: std.codec.Codec[Lodged] = std.codec.of()
    let c_run: std.codec.Codec[Run] = std.codec.of()
    let c_effect: std.codec.Codec[Effect] = std.codec.of()
    let c_wait: std.codec.Codec[Wait] = std.codec.of()
    let c_shown: std.codec.Codec[View] = std.codec.of()
    created(store.migration_create_table(mut phase, store.spec(session_name(), std.codec.key_u64(), c_session)))?
    created(store.migration_create_table(mut phase, store.spec(entries_name(), std.codec.key_u64(), c_entry)))?
    created(store.migration_create_table(mut phase, store.spec(inbox_name(), inbox_key(), c_received)))?
    created(store.migration_create_table(mut phase, store.spec(ingress_name(), std.codec.key_u64(), c_lodged)))?
    let c_frame: std.codec.Codec[Frame] = std.codec.of()
    created(store.migration_create_table(mut phase, store.spec("harness.frames", std.codec.key_u64(), c_frame)))?
    created(store.migration_create_table(mut phase, store.spec(runs_name(), std.codec.key_u64(), c_run)))?
    created(store.migration_create_table(mut phase, store.spec(effects_name(), effect_key(), c_effect)))?
    created(store.migration_create_table(mut phase, store.spec(waits_name(), wait_key(), c_wait)))?
    created(store.migration_create_table(mut phase, store.spec(views_name(), std.codec.key_u64(), c_shown)))?
    let c_reader: std.codec.Codec[bool] = std.codec.of()
    created(store.migration_create_table(mut phase, store.spec("harness.readers", std.codec.key_bytes(), c_reader)))?
    created(store.migration_create_table(mut phase, store.spec("harness.fork_cuts", std.codec.key_u64(), std.codec.of_u64())))
}

pub fn handles(schema: store.Schema) -> Result[Handles, store.Error] {
    let c_session: std.codec.Codec[Session] = std.codec.of()
    let c_entry: std.codec.Codec[Entry] = std.codec.of()
    let c_received: std.codec.Codec[Received] = std.codec.of()
    let c_lodged: std.codec.Codec[Lodged] = std.codec.of()
    let c_frame: std.codec.Codec[Frame] = std.codec.of()
    let c_run: std.codec.Codec[Run] = std.codec.of()
    let c_effect: std.codec.Codec[Effect] = std.codec.of()
    let c_wait: std.codec.Codec[Wait] = std.codec.of()
    let c_shown: std.codec.Codec[View] = std.codec.of()
    let c_reader: std.codec.Codec[bool] = std.codec.of()
    Ok(Handles(
        session: store.schema_table(schema, session_name(), std.codec.key_u64(), c_session)?,
        entries: store.schema_table(schema, entries_name(), std.codec.key_u64(), c_entry)?,
        inbox: store.schema_table(schema, inbox_name(), inbox_key(), c_received)?,
        ingress: store.schema_table(schema, ingress_name(), std.codec.key_u64(), c_lodged)?,
        frames: store.schema_table(schema, "harness.frames", std.codec.key_u64(), c_frame)?,
        runs: store.schema_table(schema, runs_name(), std.codec.key_u64(), c_run)?,
        effects: store.schema_table(schema, effects_name(), effect_key(), c_effect)?,
        waits: store.schema_table(schema, waits_name(), wait_key(), c_wait)?,
        views: store.schema_table(schema, views_name(), std.codec.key_u64(), c_shown)?,
        readers: store.schema_table(schema, "harness.readers", std.codec.key_bytes(), c_reader)?,
        fork_cuts: store.schema_table(schema, "harness.fork_cuts", std.codec.key_u64(), std.codec.of_u64())?,
        mcp_catalog: mcp_tools.catalog(schema)?,
        triggers: runner.triggers.tables(schema)?,
    ))
}

// ---- the composition ----
pub type Fault: codec + send = BadArgs(String) | Refused(String) | Unavailable | TooLarge

// What the model is sent. `system` and `tools` are the fold of the System
// entries up to the cutoff, so a resend is built from the log and never from
// the agent's current code.
pub type Request: codec + send {
    route: String,
    system: List[String],
    tools: List[ToolDef],
    messages: List[Entry],
    key: Bytes,
    stream: bool,
    warm: bool
}

// What an Inside tool is given: its call's key, which `resume` takes, and its
// arguments.
pub type Invoke: codec + send {
    key: EffectKey,
    args: Bytes
}

// An Inside tool answers now, or Later: it has written whatever row will
// eventually call `resume` for its key (a timer, a webhook row, another
// place's reply), and the call stays parked until then.
pub type Reply: codec + send = Now(Bytes) | Later

pub type ToolRun[G: send]: send = Outside(StaticFn[fn(G, take Bytes) -> Result[Bytes, Fault] waits], Repeat, Option[StaticFn[fn(G, EffectKey) -> Result[Option[Bytes], Fault] waits]]) | Inside(StaticFn[fn(mut store.Tx, Invoke) -> Result[Reply, Fault]]) | Mcp(Bytes)

// `rev` names the tool's behaviour in approval keys: raise it when the same
// arguments would now do something else, so earlier approvals stop matching.
// `repair` is a pure rewrite of the arguments that runs before the gates.
pub type Tool[G: send]: send {
    name: String,
    about: String,
    input: String,
    rev: u64,
    repair: Option[StaticFn[fn(Bytes) -> Result[Bytes, Fault]]],
    run: ToolRun[G]
}

// A gate's verdict. Verdicts fold by maximum, Pass < Hold < Deny, so adding
// a gate can only make a call less allowed, and the order of gates does not
// change the result.
pub type Verdict: codec + send = Pass | Hold(String) | Deny(String)

// A gate sees a read-only transaction and the call with the caller of the
// submission that started the run, never the caller of the trigger it runs in.
pub type Ask: codec + send {
    caller: store.Caller,
    call: Call
}

pub type Gate: send {
    name: String,
    check: StaticFn[fn(store.Tx, Ask) -> Verdict]
}

// A keyed system-prompt section, rendered from rows each time a request is
// prepared. List order is prompt order. `None` removes it; a render that
// fails or overruns keeps the text it showed last.
pub type Section: send {
    key: String,
    render: StaticFn[fn(store.Tx) -> Result[Option[String], store.Error]]
}

// Runs in the transaction that appends an entry, with the entry's position.
// It may write its own rows and triggers. It cannot veto or edit the entry:
// a reaction that fails has its writes rolled back and is recorded as a Note.
pub type After: send {
    name: String,
    run: StaticFn[fn(mut store.Tx, u64, Entry) -> Result[(), Fault]]
}

pub type Limits: send {
    rounds: u64,
    calls: u64,
    model_ms: u64,
    tool_ms: u64,
    model_reserve: u64,
    inside_bytes: u64,
    inside_steps: u64,
    gate_bytes: u64,
    gate_steps: u64,
    section_bytes: u64,
    section_steps: u64,
    hold_ms: u64,
    ingress: u64,
    no_progress: NoProgress,
}

// The provider cache mode and the maximum refreshes per answered idle period.
pub type KeepWarm: send {
    cache: provider.CacheControl,
    lifetime_ms: u64,
    margin_ms: u64,
    requests: u64
}

pub type Agent[G: send]: send {
    name: String,
    route: String,
    // The model gets a draft source when the effect has a preview target; it may
    // ignore it.
    model: StaticFn[fn(G, take Request, mut Option[preview.Source]) -> Result[Answer, ModelFault] waits],
    charge: ChargeSafety,
    keep_warm: Option[KeepWarm],
    hedged_model: Option[StaticFn[fn(G, take Request, mut Option[preview.Source], Hedge) -> Result[Answer, ModelFault] waits]],
    // Words a settled outcome for the model, once, in the transaction that
    // appends the result. Bounded like a gate; absent, failing, overrunning or
    // oversized, the standard `worded` text is recorded instead.
    presenter: Option[StaticFn[fn(Call, Outcome) -> Presented]],
    // Asked once per prepare, read-only and bounded like a gate. An invalid
    // open, a failure or an overrun counts as Continue.
    pressure: Option[StaticFn[fn(store.Tx, Pressure) -> Pressed]],
    // The per-request prompt view, sealed into the cutoff at prepare.
    prompt_view: Option[StaticFn[fn(store.Tx, Pressure) -> List[Omit]]],
    // The app supplies object authority when a result outgrows the journal.
    store_result: Option[StaticFn[fn(G, take Bytes) -> Result[BlobRef, Fault] waits]],
    tools: List[Tool[G]],
    mcp_peer: Option[StaticFn[fn(G, String) -> Option[mcp_tools.Peer]]],
    gates: List[Gate],
    sections: List[Section],
    reactions: List[After],
    limits: Limits,
}

pub fn agent[G: send](take name: String, take route: String, model: StaticFn[fn(G, take Request, mut Option[preview.Source]) -> Result[Answer, ModelFault] waits]) -> Agent[G] {
    Agent(name: take name, route: take route, model: model, charge: RequireGuarantee, keep_warm: None, hedged_model: None, presenter: None, pressure: None, prompt_view: None, store_result: None, tools: list.new(), mcp_peer: None, gates: list.new(), sections: list.new(), reactions: list.new(), limits: Limits(rounds: 8u64, calls: 8u64, model_ms: 120000u64, tool_ms: 60000u64, model_reserve: 4096u64,
    // Gates and sections read rows; opening a table alone takes over
    // 10,000 steps.
    inside_bytes: 65536u64, inside_steps: 1000000u64, gate_bytes: 16384u64, gate_steps: 100000u64, section_bytes: 16384u64, section_steps: 100000u64, hold_ms: 86400000u64, ingress: 16u64, no_progress: Bounded(3u64)))
}

pub fn outside[G: send](take name: String, take about: String, take input: String, repeat: Repeat, f: StaticFn[fn(G, take Bytes) -> Result[Bytes, Fault] waits]) -> Tool[G] {
    Tool(name: take name, about: take about, input: take input, rev: 1u64, repair: None, run: Outside(f, repeat, None))
}

pub fn inside[G: send](take name: String, take about: String, take input: String, f: StaticFn[fn(mut store.Tx, Invoke) -> Result[Reply, Fault]]) -> Tool[G] {
    Tool(name: take name, about: take about, input: take input, rev: 1u64, repair: None, run: Inside(f))
}

// ---- wiring: the app's trigger targets, rebuilt in each transaction ----
pub type Wake: codec + send = Kick | Deadline(EffectKey) | Expire(WaitKey) | Warm(u64)

pub type Refused: codec + send = NotAllowed | Conflict | TooLarge | Malformed(String) | Storage

pub opaque type Wiring {
    entries: runner.triggers.Entries,
    advance: runner.triggers.Entry[Wake],
    effect: runner.triggers.Entry[EffectKey]
}

pub fn wiring[H, G, R, E, W](advance_fn: StaticFn[fn(mut store.Tx, H, store.Caller, take Wake) -> Result[R, E]], effect_fn: StaticFn[fn(G, store.Caller, take EffectKey) -> Result[W, Capacity] waits]) -> Result[Wiring, Refused] {
    let a = runner.triggers.transact(advance_fn) ?=> |_| Malformed("advance target")
    let e = runner.triggers.granted(effect_fn) ?=> |_| Malformed("effect target")
    let mut allowed = runner.triggers.empty_entries()
    runner.triggers.allow(mut allowed, a) ?=> |_| Malformed("advance target")
    runner.triggers.allow(mut allowed, e) ?=> |_| Malformed("effect target")
    Ok(Wiring(entries: take allowed, advance: take a, effect: take e))
}

// The trigger allowlist the place's TriggerConfig carries.
pub fn entries(w: Wiring) -> runner.triggers.Entries {
    clone(w.entries)
}

fn kept[T](take r: Result[T, store.Error]) -> Result[T, Refused] {
    match take r {
        Ok(take v) => Ok(take v),
        Error(_) => Error(Storage)
    }
}

fn armed(take r: Result[runner.triggers.Id, runner.triggers.Error]) -> Result[runner.triggers.Id, Refused] {
    match take r {
        Ok(id) => Ok(id),
        Error(_) => Error(Storage)
    }
}

fn session_of(tx: store.Tx, h: Handles) -> Result[Session, Refused] {
    match kept(store.fetch(tx, store.shape(h.session), 0u64))? {
        Some(take s) => Ok(take s),
        None => Error(Malformed("no session")),
    }
}

// Opens the singleton session. Idempotent: an existing session is kept.
pub fn open_session(mut tx: store.Tx, h: Handles, take model: String, take narrow: Narrow) -> Result[(), Refused] {
    if let Some(_) = kept(store.fetch(tx, store.shape(h.session), 0u64))? {
        return Ok(())
    }
    let s = Session(model: take model, tools_narrow: take narrow, admitted: list.new(), frame: 0u64, next_pos: 0u64, active_run: None, next_run: 0u64, next_seq: 0u64, active_sections_hashes: list.new(), active_tools_hash: list.new(), active_tools_pos: None, warm_left: 0u64, warm: None)
    kept(store.put(mut tx, h.session, 0u64, s))?
    kept(store.put(mut tx, h.views, 0u64, Status("idle")))
}

// ---- forks ----
// An exported prefix: entries[0..len) and the session settings they ran
// under. A fork is a new session seeded from one; it shares these entries and
// nothing else.
pub type Prefix: codec + send {
    model: String,
    tools_narrow: Narrow,
    frame: u64,
    frames: List[Framed],
    entries: List[Entry],
    cuts: List[u64]
}

pub type Framed: codec + send {
    base: u64,
    frame: Frame
}

// Exports entries[0..upto) through a snapshot. A cut inside a tool round (an
// Assistant whose calls do not all have results before `upto`) conflicts: the
// fork's first request would carry calls with no results.
pub fn export(snap: store.Snapshot, h: Handles, upto: u64) -> Result[Prefix, Refused] {
    let Some(s) = kept(store.get(snap, store.shape(h.session), 0u64))? else {
        return Error(Malformed("no session"))
    }
    if upto > s.next_pos {
        return Error(Malformed("cut outside the log"))
    }
    let mut log: List[Entry] = list.with_capacity(upto)
    let mut open: List[String] = list.new()
    for p in 0u64 .. upto {
        let Some(take e) = kept(store.get(snap, store.shape(h.entries), p))? else {
            return Error(Malformed("entry"))
        }
        match e {
            Assistant(answer) => {
                open = list.new()
                for c in answer.calls {
                    list.push(mut open, clone(c.id))
                }
            },
            ToolResult(id, _, _) => {
                let mut rest: List[String] = list.new()
                for o in open {
                    if o != id {
                        list.push(mut rest, clone(o))
                    }
                }
                open = take rest
            },
            _ => (),
        }
        list.push(mut log, take e)
    }
    if list.len(open) > 0u64 {
        return Error(Conflict)
    }
    // The fork gets the cuts inside its pinned prefix, even if the source is
    // itself a fork. A cut is the first row owned by the newer segment.
    let mut cuts: List[u64] = list.new()
    if upto > 0u64 {
        let mut rows = kept(store.scan(snap, store.shape(h.fork_cuts), Unbounded, Included(upto)))?
        while let Some((cut, _)) = kept(store.next(mut rows))? {
            list.push(mut cuts, cut)
        }
    }
    // The frames whose base the cut keeps; the latest one is the fork's frame.
    let mut frames: List[Framed] = list.new()
    let mut frame = 0u64
    if upto > 0u64 {
        let mut rows = kept(store.scan(snap, store.shape(h.frames), Unbounded, Excluded(upto)))?
        while let Some((base, f)) = kept(store.next(mut rows))? {
            list.push(mut frames, Framed(base: base, frame: clone(f)))
            frame = base
        }
    }
    Ok(Prefix(model: clone(s.model), tools_narrow: clone(s.tools_narrow), frame: frame, frames: take frames, entries: take log, cuts: take cuts))
}

// Seeds an empty session from a prefix: its entries and their visible lines,
// with no runs, inbox, effects or waits. Reactions do not run again; what
// they wrote in the parent stays there. The section and tool hashes start
// empty, so the fork's first prepare appends a baseline.
pub fn adopt(mut tx: store.Tx, h: Handles, take p: Prefix) -> Result[(), Refused] {
    if let Some(_) = kept(store.fetch(tx, store.shape(h.session), 0u64))? {
        return Error(Conflict)
    }
    let Prefix(model: take model, tools_narrow: take narrow, frame: frame, frames: take frames, entries: take log, cuts: take cuts) = take p
    for f in frames {
        kept(store.put(mut tx, h.frames, f.base, clone(f.frame)))?
    }
    let mut s = Session(model: take model, tools_narrow: take narrow, admitted: list.new(), frame: frame, next_pos: 0u64, active_run: None, next_run: 0u64, next_seq: 0u64, active_sections_hashes: list.new(), active_tools_hash: list.new(), active_tools_pos: None, warm_left: 0u64, warm: None)
    for e in log {
        let _ = put_entry(mut tx, h, mut s, e)?
    }
    for cut in cuts {
        kept(store.put(mut tx, h.fork_cuts, cut, cut))?
    }
    if s.next_pos > 0u64 {
        let cut = s.next_pos + 1u64
        kept(store.put(mut tx, h.fork_cuts, cut, cut))?
    }
    kept(store.put(mut tx, h.session, 0u64, s))?
    kept(store.put(mut tx, h.views, 0u64, Status("idle")))
}

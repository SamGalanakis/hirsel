// A witness is the touch closure of one recorded call: re-run with only the
// witness in reach, the call gives its recorded verdict, and without any one
// witnessed page it stops as Outside. A re-execution that asks for no witness
// keeps no trace, and a Hot call carries no touch record at all.
const WITNESS_LAW_STEPS: u64 = 100000000

const WITNESS_LAW_ROWS: u64 = 6000

fn witness_law_failed(_stop: Stop) -> Bytes {
    b"failed"
}

fn witness_law_value(k: u64) -> Bytes {
    let width = if k == 900 || k == 901 {
        5000u64
    } else {
        200u64
    }
    let mut value: Bytes = list.with_capacity(width)
    for _ in 0u64 .. width {
        list.push(mut value, int.truncate(k % 251))
    }
    take value
}

fn witness_law_fill(mut db: Db, t: Table[u64, Bytes]) -> Result[(), Error] waits {
    let mut from = 0u64
    while from < WITNESS_LAW_ROWS {
        let Committed(_) = run(mut db, Some(WITNESS_LAW_STEPS), (copy_env(t), from), fn(mut tx: Tx, env: (Table[u64, Bytes], u64)) -> Result[(), Error] {
            for k in env.1 .. env.1 + 500 {
                put(mut tx, env.0, k, witness_law_value(k))?
            }
            Ok(())
        })? else {
            return Error(Missing("witness law: fixture rows"))
        }
        from += 500
    }
    Ok(())
}

// Return the first nested step budget that admits a one-row payload read.
// Each arm starts with a fresh cursor and includes its opening charges.
fn witness_cursor_steps(tx: Tx, t: Table[u64, Bytes]) -> u64 {
    let mut lo = 0u64
    let mut hi = 4096u64
    while lo < hi {
        let middle = lo + (hi - lo) / 2
        let checked = bound steps middle {
            let mut probe_rows = result.unwrap(range(tx, t, Included(2000u64), Included(2000u64)))
            let Some((k, _)) = result.unwrap(next_in(tx, mut probe_rows)) else {
                fail("witness law: cursor probe did not return its row")
            }
            k
        }
        if let Ok(_) = checked {
            hi = middle
        } else {
            lo = middle + 1
        }
    }
    lo
}

// Two point reads, one of a BLOB row, a four-row range and one put.
fn witness_law_entry(mut tx: Tx, t: Table[u64, Bytes], extra: Option[u64]) -> Result[Bytes, Bytes] {
    let mut reply: Bytes = list.new()
    let Some(small) = result.unwrap(fetch(tx, t, 40u64)) else {
        fail("witness law: row 40")
    }
    list.push(mut reply, small[0u64])
    let counted = result.unwrap(count(tx, t, Included(42u64), Included(42u64)))
    list.push(mut reply, int.truncate(counted))
    let overlay_count = result.unwrap(count(tx, t, Included(43u64), Included(43u64)))
    list.push(mut reply, int.truncate(overlay_count))
    // Borrowing this body needs room for the lookup, not a second copy of
    // the 5,000-byte value. Capture must preserve the nested bound's answer.
    let borrowed = bound bytes 4096 {
        let Some(wire) = result.unwrap(fetch_bytes(tx, t, 900u64)) else {
            fail("witness law: bounded BLOB lookup")
        }
        wire[4999u64]
    }
    match borrowed {
        Ok(byte) => list.push(mut reply, byte),
        Error(_) => list.push(mut reply, 0u8),
    }
    let Some(wide) = result.unwrap(fetch(tx, t, 900u64)) else {
        fail("witness law: row 900")
    }
    list.push(mut reply, wide[4999u64])
    list.put_word_le(mut reply, witness_cursor_steps(tx, t))
    {
        let mut rows = result.unwrap(range(tx, t, Included(2000u64), Excluded(2004u64)))
        while let Some((_, v)) = result.unwrap(next_in(tx, mut rows)) {
            list.push(mut reply, v[0u64])
        }
        if let Some(k) = extra {
            if let Some(other) = result.unwrap(fetch(tx, t, k)) {
                list.push(mut reply, other[0u64])
            }
        }
    }
    result.unwrap(put(mut tx, t, 5000u64, take small))
    Ok(take reply)
}

fn witness_law_serve(mut db: Db, t: Table[u64, Bytes]) -> Result[u64, Error] waits {
    let key = claim_law_key(b"one")
    let record = KeyedCallRecord(entry: b"charge", args: b"args", revision: Some(b"0123456789abcdef0123456789abcdef"), code: b"0123456789abcdef0123456789abcdef0123456789abcdef")
    let no_stream_record: Option[CallRecord] = None
    let Accepted(claimed) = admit_claim(mut db, key, request_digest(b"charge", b"args"), b"args", Some(claim_law_policy()))? else {
        return Error(Missing("witness law: admit"))
    }
    let first = serve(mut db, keyed_completion(take claimed, take record), witness_law_plan(), take no_stream_record, t, fn(mut tx: Tx, data: Table[u64, Bytes]) -> Result[Bytes, Bytes] {
        witness_law_entry(mut tx, data, None)
    })
    // A Tiered miss parks the call until the pager delivers its frame.
    let served = l63_settle(mut db, take first, t, fn(mut tx: Tx, data: Table[u64, Bytes]) -> Result[Bytes, Bytes] {
        witness_law_entry(mut tx, data, None)
    })
    let Ok(Committed(done)) = served else {
        return Error(Missing("witness law: the keyed call did not commit"))
    }
    let mark = version(snapshot(db))
    durable(mut db, done.ticket)?
    Ok(mark)
}

fn witness_law_plan() -> Plan {
    Plan(n_e: 4194304, s_e: 1000000, reply_max: 64)
}

fn witness_law_without(w: Witness, stamp: u64) -> Witness {
    let mut resident: Map[u64, ()] = map.new()
    for (held, _) in w.touches.resident {
        if held != stamp {
            map.insert(mut resident, held, ())
        }
    }
    let mut frames: Map[pager.TieredCacheKey, Arc[format.TieredFrame]] = map.new()
    for (key, frame) in w.touches.frames {
        if frame.identity.stamp != stamp {
            map.insert(mut frames, (key.0, key.1), arc.share(frame))
        }
    }
    let mut thinner: Witness = clone(w)
    thinner.touches.resident = take resident
    thinner.touches.frames = take frames
    thinner.source.base = result.unwrap(witness_roots(w.source.base, thinner.touches, w.start.ids + 1099511627776u64))
    take thinner
}

// The collection map's pages and each Hot collection root: a slice keeps them.
fn witness_law_kept(page: Arc[std.page.Page], mut kept: Map[u64, ()]) {
    let image = std.page.image_of(page)
    map.insert(mut kept, std.page.stamp(image), ())
    for slot in 0u64 .. std.page.count(image) {
        if let Some(HotPage(kid)) = std.page.child_slot(page, slot) {
            if std.page.level(image) == 0 {
                map.insert(mut kept, std.page.stamp(std.page.image_of(kid)), ())
            } else {
                witness_law_kept(kid, mut kept)
            }
        }
    }
}

fn witness_law_pages(page: Arc[std.page.Page]) -> u64 {
    let image = std.page.image_of(page)
    let mut total = 1u64
    if std.page.level(image) != 0 {
        for slot in 0u64 .. std.page.count(image) {
            if let Some(HotPage(kid)) = std.page.child_slot(page, slot) {
                total += witness_law_pages(kid)
            }
        }
    }
    total
}

fn witness_law_replay(w: Witness, extra: Option[u64]) -> Result[SliceVerdict, Error] {
    let mut schema = declare_witness(w)?
    let declared = declare_table(mut schema, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let t = finish(mut schema, take declared)?
    replay_witness(w, take schema, witness_law_plan(), witness_law_failed, (copy_env(t), extra), fn(_call, mut tx, env) -> Result[Bytes, Bytes] {
        witness_law_entry(mut tx, env.0, env.1)
    })
}

fn witness_law_same(got: SliceVerdict) -> bool {
    match got {
        Within(Same) => true,
        _ => false,
    }
}

fn witness_law_outside(got: SliceVerdict) -> bool {
    match got {
        Outside => true,
        Within(_) => false,
        UnresolvedUpload => false,
    }
}

@test
fn witness_replays_resident_call_from_its_pages(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let mut db = open(tasks, directory, c, r, result.unwrap(sized(Directory, 2147483648u64)))?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    witness_law_fill(mut db, rows)?
    let mark = witness_law_serve(mut db, rows)?
    let Ok(source) = prepare_reexecute_claim(db, mark)? else {
        return Error(Missing("witness law: replay source"))
    }
    // Off: the re-run keeps no trace, and a Hot call has no touch record.
    let call = replay_record(source)
    let ci = CallInfo(id: CallId(store: db.store, branch: call.branch.id, version: call.base + 1), at: call.at, seed: call.seed)
    let attempt = pager.call_attempt(captured_tiered(source.base.collections, pages.holder_bases(db.holders), ci.id.branch), pager.pin_partition(db.pager), 0)
    let mut off: Option[RerunTrace] = None
    let no_pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]] = map.new()
    let quiet = rerun_attempt(tx_start(db), pages.holder_bases(db.holders), db.accounting.tiered, indexes.index_registry(db.indexes), source.base, ci, witness_law_plan(), call, attempt, no_pins, mut off, scoped fn(_recorded: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        witness_law_entry(mut tx, rows, None)
    })
    let RanTo(original, _) = take quiet else {
        return Error(Missing("witness law: the plain re-run"))
    }
    if let Some(_) = off {
        return Error(Missing("witness law: a re-run that asked for no witness kept a trace"))
    }
    if let Some(_) = attempt {
        return Error(Missing("witness law: a Hot call carries a touch record"))
    }
    let plain = reexecute_claim(db, mark, witness_law_plan(), witness_law_failed, rows, fn(_call, mut tx, data) -> Result[Bytes, Bytes] {
        witness_law_entry(mut tx, data, None)
    })?
    if !verdict_is(plain, Same) {
        return Error(Missing("witness law: the plain re-execution"))
    }
    // On: the closure is a strict part of the table, with one of its two bodies.
    let Some(w) = capture_witness(db, source, witness_law_plan(), rows, fn(_call, mut tx, data) -> Result[Bytes, Bytes] {
        witness_law_entry(mut tx, data, None)
    })? else {
        return Error(Missing("witness law: no witness"))
    }
    // Exercise the capture observer on the intact base before testing the
    // projected pages. A different reply here isolates a metering change.
    let intact = rerun_capture(db, indexes.index_registry(db.indexes), tx_start(db), source.base, pages.holder_bases(db.holders), ci, witness_law_plan(), call, scoped fn(_recorded: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        witness_law_entry(mut tx, rows, None)
    })?
    let Captured(reran: take traced, ..) = take intact
    let RanTo(observed, _) = take traced else {
        return Error(Missing("witness law: full-base cursor probe stopped"))
    }
    if original != observed {
        let mut message = string.from("witness law: intact cursor step threshold live=")
        string.push_u64(mut message, list.word_le(original, 5))
        string.push(mut message, " capture=")
        string.push_u64(mut message, list.word_le(observed, 5))
        return Error(Missing(take message))
    }
    let stamps = witness_resident(w)
    let mut kept: Map[u64, ()] = map.new()
    witness_law_kept(source.base.collections.root, mut kept)
    let Some((HotPage(root), _)) = std.page.collection_slot(source.base.collections.root, failure_result_from_rep(catalog.prefix(rows.id))?) else {
        return Error(Missing("witness law: the table root"))
    }
    let total = witness_law_pages(root)
    if std.page.level(std.page.image_of(root)) == 0 || list.len(stamps) >= total || list.len(witness_bodies(w)) != 1 || list.len(witness_frames(w)) != 0 {
        return Error(Missing("witness law: the closure is not a strict part of the table"))
    }
    close(take db)?
    let portable = encode_witness(w)?
    // The selected leaf also contains count-only row 42. Its key is needed
    // for the count, while its 200-byte payload has no place in the file.
    let counted_only = witness_law_value(42)
    for offset in 0u64 .. list.len(portable) {
        if list.starts_with_at(portable, offset, counted_only) || list.starts_with_at(portable, offset, b"overlay-count-only-value-canary") {
            return Error(Missing("file retained an unobserved sibling payload"))
        }
    }
    let loaded = decode_witness(portable)?
    if !witness_law_same(witness_law_replay(loaded, None)?) {
        return Error(Missing("witness law: the slice did not replay the call"))
    }
    if !witness_law_outside(witness_law_replay(w, Some(41u64))?) {
        return Error(Missing("witness law: read an unwitnessed sibling inline value"))
    }
    if !witness_law_outside(witness_law_replay(w, Some(42u64))?) {
        return Error(Missing("witness law: count disclosed the value of a row it only counted"))
    }
    // The source has a second BLOB on the same leaf. Its page is present
    // in the slice, but the recorded call never read that body.
    if !witness_law_outside(witness_law_replay(w, Some(901u64))?) {
        return Error(Missing("witness law: read an unwitnessed resident BLOB body"))
    }
    // Exact: each page below a root is needed, and nothing else is in reach.
    let mut needed = 0u64
    for stamp in stamps {
        let thinner = witness_law_without(w, stamp)
        let got = witness_law_replay(thinner, None)?
        if map.contains(kept, stamp) {
            if !witness_law_same(got) {
                return Error(Missing("witness law: a kept page changed the replay"))
            }
        } else {
            if !witness_law_outside(got) {
                return Error(Missing("witness law: the replay ran without a witnessed page"))
            }
            needed += 1
        }
    }
    if needed < 3 {
        return Error(Missing("witness law: too few pages below the roots"))
    }
    if !witness_law_outside(witness_law_replay(w, Some(3000u64))?) {
        return Error(Missing("witness law: a read outside the slice was served"))
    }
    let Within(Different(Reply)) = witness_law_replay(w, Some(2001u64))? else {
        return Error(Missing("witness law: a changed reply inside the slice"))
    }
    Ok(())
}

// The same call over a Tiered table whose pages are Cold: the witness is the
// frames the completing attempt touched, PAGE and BLOB, and the replay takes
// no reader grant.
@test
fn witness_replays_tiered_call_from_its_frames(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let mut overrides = derived_sizes()
    overrides.resident_limit = Some(182375272u64)
    let options = sized_with(Directory, 2147483648u64, overrides) ?=> |_| Missing("witness law: tiered sizing")
    let mut first = open(tasks, directory, c, r, options)?
    let _ = law_table(mut first, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let filled = table(mut first, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    set_residency(mut first, filled.id, Tiered)?
    witness_law_fill(mut first, filled)?
    let cut = checkpoint(mut first)?
    durable(mut first, cut)?
    close(take first)?
    let mut db = open(tasks, directory, c, r, options)?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    // The historical root for this CALL overlays the checkpoint with this
    // journal write. The CALL counts it without opening the new value.
    let Committed(edit) = run(mut db, Some(WITNESS_LAW_STEPS), rows, fn(mut tx: Tx, t: Table[u64, Bytes]) -> Result[(), Error] {
        put(mut tx, t, 43u64, b"overlay-count-only-value-canary")
    })? else {
        return Error(Missing("witness law: post-checkpoint edit"))
    }
    durable(mut db, edit.ticket)?
    let mark = witness_law_serve(mut db, rows)?
    let Ok(source) = prepare_reexecute_claim(db, mark)? else {
        return Error(Missing("witness law: replay source"))
    }
    let Some(w) = capture_witness(db, source, witness_law_plan(), rows, fn(_call, mut tx, data) -> Result[Bytes, Bytes] {
        witness_law_entry(mut tx, data, None)
    })? else {
        return Error(Missing("witness law: no witness"))
    }
    let frames = witness_frames(w)
    let mut bodies = 0u64
    for frame in frames {
        if frame.blob {
            bodies += 1
        }
    }
    if list.len(frames) < 4 || bodies != 1 || list.len(witness_packs(w)) == 0 {
        return Error(Missing("witness law: the Tiered closure"))
    }
    close(take db)?
    let portable = encode_witness(w)?
    // The selected leaf also contains count-only row 42. Its key is needed
    // for the count, while its 200-byte payload has no place in the file.
    let counted_only = witness_law_value(42)
    for offset in 0u64 .. list.len(portable) {
        if list.starts_with_at(portable, offset, counted_only) || list.starts_with_at(portable, offset, b"overlay-count-only-value-canary") {
            return Error(Missing("file retained an unobserved sibling payload"))
        }
    }
    let loaded = decode_witness(portable)?
    if !witness_law_same(witness_law_replay(loaded, None)?) {
        return Error(Missing("witness law: the frames did not replay the call"))
    }
    if !witness_law_outside(witness_law_replay(w, Some(42u64))?) {
        return Error(Missing("witness law: Tiered count exposed a Cold frame value"))
    }
    if !witness_law_outside(witness_law_replay(w, Some(43u64))?) {
        return Error(Missing("witness law: Tiered count exposed an overlay value"))
    }
    for frame in frames {
        let thinner = witness_law_without(w, frame.stamp)
        if !witness_law_outside(witness_law_replay(thinner, None)?) {
            return Error(Missing("witness law: the replay ran without a witnessed frame"))
        }
    }
    if !witness_law_outside(witness_law_replay(w, Some(3000u64))?) {
        return Error(Missing("witness law: a read outside the frames was served"))
    }
    Ok(())
}

// A successful base fetch builds its point event and appends it. Compare
// the exact step boundary for both constructors, including a stopped append.
@test
fn witness_point_preserves_append_steps() -> Result[(), Error] {
    for budget in 0u64 .. 12u64 {
        let mut outcomes: List[bool] = list.new()
        for observing in[false, true] {
            let reads: core.Log[Read] = log.new()
            let point = if observing {
                witness_point_event
            } else {
                point_event
            }
            let result = bound steps budget {
                log.append(reads, point(b"key"))
            }
            list.push(mut outcomes, match result {
                Ok(()) => true,
                Error(_) => false,
            })
        }
        if outcomes[0u64] != outcomes[1u64] {
            return Error(Missing("witness point changed the step that admits an append"))
        }
    }
    Ok(())
}

@test
fn witness_inline_cell_descriptors_keep_only_opened_payloads(d: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, disk_test_directory(d), clock, random, result.unwrap(sized(Directory, 2147483648u64)))?
    let mut declaration = declare(db, Migrate)?
    let opened = declare_cell(mut declaration, "opened", std.codec.of_bytes())?
    let sibling = declare_cell(mut declaration, "sibling", std.codec.of_bytes())?
    let _ = seal(mut db, take declaration)?
    let _ = cell_law_commit(mut db, opened, b"opened-cell")?
    let _ = cell_law_commit(mut db, sibling, b"sibling-cell-secret")?
    let key = claim_law_key(b"cell")
    let Accepted(claim) = admit_claim(mut db, key, request_digest(b"read", b""), b"", Some(claim_law_policy()))? else {
        return Error(Missing("cell witness claim admission"))
    }
    let record = KeyedCallRecord(entry: b"read", args: b"", revision: None, code: b"0123456789abcdef")
    let none_record: Option[CallRecord] = None
    let cells: (Cell[Bytes], Cell[Bytes]) = (clone(opened), clone(sibling))
    let Ok(Committed(done)) = serve(mut db, keyed_completion(take claim, take record), witness_law_plan(), take none_record, cells, fn(mut tx: Tx, pair: (Cell[Bytes], Cell[Bytes])) -> Result[Bytes, Bytes] {
        result.unwrap(cell_set(mut tx, pair.1, b"sibling-cell-secret"))
        Ok(option.unwrap(result.unwrap(cell_fetch(tx, pair.0))))
    }) else {
        return Error(Missing("cell witness call settlement"))
    }
    durable(mut db, done.ticket)?
    let Ok(source) = prepare_reexecute_claim(db, version(snapshot(db)))? else {
        return Error(Missing("cell witness source"))
    }
    let Some(w) = capture_witness(db, source, witness_law_plan(), cells, fn(_record: Recorded, mut tx: Tx, pair: (Cell[Bytes], Cell[Bytes])) -> Result[Bytes, Bytes] {
        result.unwrap(cell_set(mut tx, pair.1, b"sibling-cell-secret"))
        Ok(option.unwrap(result.unwrap(cell_fetch(tx, pair.0))))
    })? else {
        return Error(Missing("cell witness unavailable"))
    }
    close(take db)?
    let Some((_, descriptor)) = std.page.collection_slot(w.source.base.collections.root, sibling.key) else {
        return Error(Missing("cell witness lost sibling descriptor"))
    }
    let Some(blank) = pages.inline_cell(descriptor) else {
        return Error(Missing("cell witness lost sibling layout"))
    }
    for byte in blank {
        if byte != 0 {
            return Error(Missing("cell witness retained sibling bytes"))
        }
    }
    for candidate in[false, true] {
        let mut selected = declare_witness(w)?
        let a = declare_cell(mut selected, "opened", std.codec.of_bytes())?
        let b = declare_cell(mut selected, "sibling", std.codec.of_bytes())?
        let verdict = replay_witness(w, take selected, witness_law_plan(), witness_law_failed, (take a, take b, candidate), fn(_record: Recorded, mut tx: Tx, choice: (Cell[Bytes], Cell[Bytes], bool)) -> Result[Bytes, Bytes] {
            if choice.2 {
                return Ok(option.unwrap(result.unwrap(cell_fetch(tx, choice.1))))
            }
            result.unwrap(cell_set(mut tx, choice.1, b"sibling-cell-secret"))
            Ok(option.unwrap(result.unwrap(cell_fetch(tx, choice.0))))
        })?
        if candidate {
            if !witness_law_outside(verdict) {
                return Error(Missing("cell witness returned an unobserved sibling"))
            }
        } else if !witness_law_same(verdict) {
            return Error(Missing("cell witness changed a blind no-op write"))
        }
    }
    Ok(())
}

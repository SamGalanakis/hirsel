    } else {
        Error(())
    }
}

// The read log (24), issued-id cell (8), info-observed cell (8) and isolate
// cause cell (32) are live alongside the Option[TxView] cell (136).
const LAW_ISOLATE_ENTRY_BYTES: u64 = 24 + 8 + 8 + 32

const LAW_EMPTY_DRAFT_BYTES: u64 = LAW_ISOLATE_ENTRY_BYTES + 136

// L2: an aborted body needs no COMMIT allocation once its draft fits.
pub fn law_abort_budget(c: Clock) -> bool {
    let mut db = test_db(c, 1073741824)
    let values: Inline[u64, 2] =[7, 19]
    for i in 0u64 .. 2 {
        let value = values[i]
        let outcome = result.unwrap(bound bytes LAW_EMPTY_DRAFT_BYTES {
            execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[(), u64] {
                let _ = info(mut tx)
                Error(value)
            })
        })
        match take outcome {
            Ok(Aborted(Undone(value: actual, ticket: None))) => if actual != value {
                return false
            },
            _ => return false
        }
    }
    pages.holder_heads(db.holders)[0].head == 0 && db.resident == 0
}


pkg_v1.Package(
    name: "hirsel.ai/registry",
    version: "1.0.0",
    charge: ChargeV1,
    sources: [
        ("directory_signature.hirsel", "directory_signature"),
        ("discovery.hirsel", "discovery"),
        ("discovery_cli.hirsel", "discovery_cli"),
        ("directory_http.hirsel", "directory_http"),
        ("mcp_hub.hirsel", "mcp_hub"),
        ("directory_log.hirsel", "directory_log"),
        ("directory_query.hirsel", "directory_query"),
        ("directory.hirsel", "directory"),
        ("directory_facts.hirsel", "directory_facts"),
        ("directory_page.hirsel", "directory_page"),
        ("main.hirsel", "main"),
        ("status.hirsel", "status"),
        ("submit.hirsel", "submit"),
        ("admit.hirsel", "admit"),
        ("version_hints.hirsel", "version_hints"),
        ("pending.hirsel", "pending"),
        ("checkpoint.hirsel", "checkpoint"),
        ("commit.hirsel", "commit"),
        ("static.hirsel", "static"),
    ],
    dependencies: [
        ("mcp", Path(
            package: "mcp",
            major: 1,
            path: "../mcp",
            authority: [Dir, Net, Tasks, Clock, Random, Stdout, Args, Secret],
        )),
        ("search", Path(package: "search", major: 1, path: "../search", authority: [Dir, Clock, Random, Tasks])),
        ("store", Path(package: "store", major: 1, path: "../store", authority: [Dir, Clock, Random, Tasks])),
        ("std", Toolchain(package: "std", major: 1, authority: [])),
        ("registry_auth", Path(
            package: "hirsel.ai/registry_auth",
            major: 1,
            path: "../registry_auth",
            authority: [Net, Clock, Tasks, Secret],
        )),
        ("tlog", Path(package: "hirsel.ai/tlog", major: 1, path: "../tlog", authority: [Random, Secret])),
    ],
    tests: Some(Tests(
        sources: [
            ("commit_laws.hirsel", "commit_laws"),
            ("entry_bundle_fixture.hirsel", "commit_laws"),
            ("entry_bundle_laws.hirsel", "commit_laws"),
            ("sequencer_laws.hirsel", "commit_laws"),
            ("publish_laws.hirsel", "commit_laws"),
            ("directory_laws.hirsel", "commit_laws"),
            ("directory_fixture.hirsel", "commit_laws"),
            ("directory_dispatch_laws.hirsel", "commit_laws"),
        ],
        limit: 268435456,
        grants: [Clock, Random, Tasks, Compiler],
        runs: [
            ("hirsel.ai/registry@1/commit_laws/discovery_public_preview", TestRun(
                grant_change: Some(ReplaceAll([Dir(".")])),
            )),
            ("hirsel.ai/registry@1/commit_laws/directory_bucket_rebuild", TestRun(
                limit: Some(2147483648),
                grant_change: Some(ReplaceAll([
                    Clock,
                    Random,
                    Tasks,
                    Stdout,
                    Compiler,
                    Net(Listen(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                    Net(Connect(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                    Dir("."),
                ])),
            )),
            ("hirsel.ai/registry@1/commit_laws/directory_search_latency", TestRun(
                limit: Some(2147483648),
                grant_change: Some(ReplaceAll([Clock, Random, Tasks, Stdout, Dir(".")])),
            )),
        ],
    )),
)

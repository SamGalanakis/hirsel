// JWS, JWK and JWT. The oracles are the published RFC 7515 Appendix A.1-A.3,
// RFC 8037 Appendix A and RFC 7517 Appendix A values, copied from the RFC
// text, and RFC 7515/7519's acceptance rules for the attack tokens, which are
// built here with std.hmac and std.base64 rather than with jwt itself.
// A nonzero result names the first case that failed.
fn unhex(s: String) -> Bytes {
    option.unwrap(hex.decode(string.as_bytes(s)))
}

fn b64(s: String) -> Bytes {
    option.unwrap(base64.decode_url(string.as_bytes(s), false))
}

fn seal(take b: Bytes, uses: String) -> Secret {
    result.unwrap(secret.seal(take b, uses))
}

// RFC 7515 A.1: header {"typ":"JWT",CRLF "alg":"HS256"}, the JWT payload and its HMAC.
const A1: String = "eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"


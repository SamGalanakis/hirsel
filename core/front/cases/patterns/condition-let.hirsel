// Conditions must branch on the tag, repeat evaluation, and keep pattern binders
// scoped to the chosen arm. A failed let-else must execute the diverging block.
// expect: accept
// expect: run choose(false,6) = 6
// expect: run choose(true,6) = 99
// expect: run count(4) = 10
// expect: run early(true,5) = 77
// expect: run early(false,5) = 5
fn pick(empty: bool, x: u64) -> Option[u64] {
    if empty {
        None
    } else {
        Some(x)
    }
}

fn choose(empty: bool, x: u64) -> u64 {
    if let Some(n) = pick(empty, x) {
        n
    } else {
        99
    }
}

fn next(n: u64) -> Option[u64] {
    if n == 0 {
        None
    } else {
        Some(n - 1)
    }
}

fn count(n: u64) -> u64 {
    let mut at = n
    let mut sum: u64 = 0
    while let Some(k) = next(at) {
        sum += at;
        at = k
    }
    sum
}

fn early(empty: bool, x: u64) -> u64 {
    let Some(n) = pick(empty, x) else {
        return 77
    }
    n
}

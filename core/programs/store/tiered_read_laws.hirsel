fn l62_point_path_fixture() -> Result[(std.page.Slot, Arc[TieredFrame], Arc[TieredFrame]), Error] {
    let mut value: Bytes = list.with_capacity(1025)
    list.fill(mut value, 1025, 106u8)
    let stored_ref = std.page.BlobRef(stamp: 39, len: 1025, checksum: 0x8234157262b2bd3d, pack: 7, offset: 72, body: 0)
    let mut rows: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut rows, std.page.Entry(key: key_word(42), cell: BlobValue(stored_ref)))
    let leaf_image = page_result(std.page.encode(rows, 0, 40, Collection))?
    let digest = std.check.xxh3(std.page.payload(leaf_image), 0, 79)
    let ptr = std.page.PagePtr(pack: 8, offset: 72, len: 79, checksum: digest, stamp: 40)
    let leaf = page_result(std.page.attach_cold(take leaf_image))?
    let mut branches: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut branches, std.page.Entry(key: list.new(), cell: Child(std.page.Branch(child: ptr, rows: 1, charge: 1110))))
    let parent = page_result(std.page.encode(branches, 1, 41, Collection))?
    let root = page_result(std.page.attach_cold(take parent))?
    let page_frame = TieredFrame(identity: tiered_frame_id(TieredPage(ptr)), payload: TieredImage(take leaf))
    let blob_frame = TieredFrame(identity: tiered_frame_id(TieredBlob(stored_ref)), payload: TieredValue(arc.new(take value)))
    Ok((HotPage(take root), arc.new(take page_frame), arc.new(take blob_frame)))
}

@test
fn test_l62_tiered_point_path() -> Result[(), Error] {
    // Hot parent: 80 + 16. Cold leaf: 79 + 16. BLOB: 1025 + 8 + 16.
    let (take root, take leaf, take cached_blob) = l62_point_path_fixture()?
    let key = key_word(42)
    let mut visible: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    let mut first = capacity(tiered_touch_set(1240, 1))?
    let Error(Missed) = tiered_point_path(mut first, visible, root, None, key) else {
        fail("L62: an unpinned leaf did not miss")
    }
    let Some(AttemptMiss(TieredPage(ptr))) = first.stopped else {
        fail("L62: the first miss did not name a PAGE")
    }
    if ptr.stamp != 40 || first.touched_bytes != 191 {
        fail("L62: point lookup did not count the Hot parent before the Cold leaf")
    }
    map.insert(mut visible, tiered_cache_key(leaf.identity), take leaf)
    let mut second = capacity(tiered_touch_set(1240, 1))?
    let Error(Missed) = tiered_point_path(mut second, visible, root, None, key) else {
        fail("L62: an unpinned body did not miss")
    }
    let Some(AttemptMiss(TieredBlob(reference))) = second.stopped else {
        fail("L62: the second miss did not name a BLOB")
    }
    if reference.stamp != 39 || second.touched_bytes != 1240 {
        fail("L62: point lookup did not count the full BLOB frame")
    }
    map.insert(mut visible, tiered_cache_key(cached_blob.identity), take cached_blob)
    let mut admitted = capacity(tiered_touch_set(1240, 1))?
    let Some(value) = tiered_point_path(mut admitted, visible, root, None, key)? else {
        fail("L62: an admitted pinned row was not read")
    }
    if list.len(value) != 1025 || value[1024u64] != 106 || admitted.touched_bytes != 1240 || list.len(admitted.frames) != 2 {
        fail("L62: pin-only lookup did not return the selected BLOB")
    }
    let mut refused = capacity(tiered_touch_set(1239, 1))?
    let Error(Missed) = tiered_point_path(mut refused, visible, root, None, key) else {
        fail("L62: a warm pin bypassed the physical limit")
    }
    let Some(AttemptPinLimit(problem)) = refused.stopped else {
        fail("L62: the limit did not take precedence over the pin hit")
    }
    if problem.requested != 1240 || problem.available != 1239 {
        fail("L62: invalid capacity for the selected path")
    }
    Ok(())
}

fn l62_deliver_branch(requests: Sender[TieredPagerMessage], target: std.page.PagePtr, leaf: std.page.PagePtr) -> Result[(), Error] waits {
    let mut packs: std.omap.OMap[u64, TieredPagerPack] = std.omap.new()
    let mut ids = 0u64
    for ptr in[target, leaf] {
        let width: u64 = int.widen(ptr.len)
        let inventory = PagePack(class: 3, frames: 1, live: width, payload_bytes: 116 + width, index: 88 + width)
        let (take next_packs, _) = std.omap.insert(mut ids, packs, ptr.pack, TieredPagerPack(inventory: inventory, object: None))
        packs = take next_packs
    }
    let demand = TieredPointDemand(target: TieredPage(target), key: key_word(42), packs: take packs, next_stamp: 51, deadline: 0, grant: None)
    let TieredPointDelivery(frames: take path, ..) = tiered_point_delivery(requests, take demand)?
    if list.len(path) != 2 || path[0u64].identity.stamp != 50 || path[1u64].identity.stamp != 49 {
        fail("L62: point batch must deliver the parent and selected leaf in order")
    }
    let TieredImage(selected) = view path[1u64].payload else {
        fail("L62: point batch returned a BLOB for its leaf")
    }
    let Some(raw) = std.page.lookup(selected, key_word(42)) else {
        fail("L62: point batch delivered a leaf for the wrong key")
    }
    if list.len(raw) != 1 || raw[0u64] != 106 {
        fail("L62: point batch did not carry the selected leaf's value")
    }
    Ok(())
}

@test
fn test_l62_pager_point_batch(d: Dir, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let owner = StoreId(hi: 3, lo: 4)
    let mut rows: List[std.page.Entry] = list.with_capacity(1)
    let mut value: Bytes = list.with_capacity(1)
    list.push(mut value, 106u8)
    list.push(mut rows, std.page.Entry(key: key_word(42), cell: InlineValue(take value)))
    let leaf_image = page_result(std.page.encode(rows, 0, 49, Collection))?
    let leaf = l68_write_page_pack(fixtures, owner, 8, 49, std.page.payload(leaf_image))?
    // The left child is deliberately not in the inventory. The key path
    // only reaches the right child, so it must never request the left.
    let left = std.page.PagePtr(pack: 7, offset: 72, len: 40, checksum: 11, stamp: 48)
    let mut branches: List[std.page.Entry] = list.with_capacity(2)
    list.push(mut branches, std.page.Entry(key: list.new(), cell: Child(std.page.Branch(child: left, rows: 1, charge: 86))))
    list.push(mut branches, std.page.Entry(key: key_word(42), cell: Child(std.page.Branch(child: leaf, rows: 1, charge: 86))))
    let branch_image = page_result(std.page.encode(branches, 1, 50, Collection))?
    let root = l68_write_page_pack(fixtures, owner, 9, 50, std.page.payload(branch_image))?
    let (requests, take worker) = start_tiered_pager(tasks, owner, 0, PagerDirectory(fixtures), 4096, 1048576, 4)
    let delivered = l62_deliver_branch(requests, root, leaf)
    let _ = take requests
    let _ = result.unwrap(task.join(take worker))
    delivered
}

fn l62_grant_cache_frames(owner: StoreId, retain_all: bool) -> Result[(), Error] {
    let mut cache_state = new_tiered_cache(96 * 1048576)
    let original = tiered_cache_reserve_reader(mut cache_state, TieredReaderGrant(store: owner, opened: 1, pin_bytes: 32 * 1048576))?
    let mut held: List[Arc[TieredFrame]] = list.with_capacity(7)
    for slot in 0u64 .. 7 {
        let value_len = 8 * 1048576u64 - 24
        let mut stored: Bytes = list.with_capacity(value_len)
        list.fill(mut stored, value_len, 106u8)
        let reference = std.page.BlobRef(stamp: slot + 1, len: value_len, checksum: 0, pack: slot + 1, offset: 72, body: 0)
        let frame = arc.new(TieredFrame(identity: tiered_frame_id(TieredBlob(reference)), payload: TieredValue(arc.new(take stored))))
        if slot == 0 || retain_all {
            list.push(mut held, arc.share(frame))
        }
        tiered_cache_admit(mut cache_state, frame)
    }
    if !capacity(tiered_cache_evict(mut cache_state))? || cache_state.cached_bytes != 48 * 1048576 || cache_state.overlap_bytes != 8 * 1048576 {
        fail("L62: expected 48 MiB cached and 8 MiB of overlap")
    }
    let admission = tiered_cache_reserve_reader(mut cache_state, TieredReaderGrant(store: owner, opened: 1, pin_bytes: 24 * 1048576))
    if retain_all {
        let Error(Full(Cache(problem))) = take admission else {
            fail("L62: overlap must leave the grant too little room")
        }
        if problem.requested != 24 * 1048576 || problem.available != 8 * 1048576 || cache_state.reader_reserved != 32 * 1048576 {
            fail("L62: refusal did not report the reclaimable shared room")
        }
    } else {
        let added = admission?
        if added.pin_bytes != 24 * 1048576 || cache_state.cached_bytes != 32 * 1048576 || cache_state.reader_reserved != 56 * 1048576 || cache_state.overlap_bytes != 8 * 1048576 {
            fail("L62: a 24 MiB grant must evict exactly 16 MiB")
        }
    }
    let _ = take original
    let _ = take held
    Ok(())
}

fn l62_reader_grants(db: Db) -> Result[(), Error] waits {
    let Error(Missing(field)) = reader(db, 0) else {
        fail("L62: Tiered Readers must request at least a blob and a path")
    }
    if field != "pin_bytes" {
        fail("L62: wrong field for a short Reader reservation")
    }
    {
        let held = reader(db, 32 * 1048576)?
        let Some(grant) = view held.grant else {
            fail("L62: Reader must own its reservation")
        }
        if !same(grant.store, db.store) || grant.opened != open_number(db) || grant.pin_bytes != 32 * 1048576 {
            fail("L62: grant does not belong to this open")
        }
        let Error(Full(Cache(problem))) = reader(db, 24 * 1048576) else {
            fail("L62: another Reader charged the writer's partition")
        }
        if problem.requested != 24 * 1048576 || problem.available != 0 {
            fail("L62: a live reservation did not consume all shared room")
        }
    }
    // The marker for an abandoned reply must also be reclaimable.
    let (answer, abandoned): (Sender[Result[Arc[TieredReaderGrant], Error]], Receiver[Result[Arc[TieredReaderGrant], Error]]) = channel.new(1)
    let _ = take abandoned
    let Some(requests) = view db.pager else {
        fail("L62: fixture pager is missing")
    }
    channel.send(requests, PagerReserve(32 * 1048576, take answer)) ?=> |_| Io(Closed)
    let _ = reader(db, 32 * 1048576)?
    Ok(())
}

@test
fn test_l62_reader_reservation(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = test_db(c, 2147483648)
    {
        let memory_reader = reader(db, 0)?
        if let Some(_) = view memory_reader.grant {
            fail("L62: a Memory open reserved shared bytes")
        }
    }
    l62_grant_cache_frames(db.store, false)?
    l62_grant_cache_frames(db.store, true)?
    let (take requests, take worker) = start_tiered_pager(tasks, db.store, open_number(db), PagerDirectory(d), 32 * 1048576, 1048576, 4)
    db.pager = Some(take requests)
    let admitted = l62_reader_grants(db)
    let _ = take db
    let _ = result.unwrap(task.join(take worker))
    admitted
}

fn l79_fold_base(d: Dir, owner: StoreId) -> Result[std.page.PagePtr, Error] waits {
    let mut rows: List[std.page.Entry] = list.with_capacity(3)
    for seq in 0u64 .. 3 {
        list.push(mut rows, std.page.Entry(key: key_word(seq), cell: InlineValue(string.into_bytes(string.from("stored")))))
    }
    let image = page_result(std.page.encode(rows, 0, 40, Collection))?
    l68_write_page_pack(d, owner, 8, 40, std.page.payload(image))
}

fn l79_fold_trims(first_charge: u64, final_charge: u64) -> Result[Arc[ReplayOverlay], Error] {
    let mut overlay = empty_replay_overlay(Some(3u64))
    let initial = ReplayLogHead(first: 0, next: 3, cold_next: 3, row_bytes: 258)
    let middle = replay_overlay_trim(mut overlay, "j-1", 72, ReplayOrigin(ordinal: 1, branch: 0), 9, initial, JournalTrim(floor: 2, dropped: first_charge))?
    let _ = replay_overlay_trim(mut overlay, "j-1", 90, ReplayOrigin(ordinal: 2, branch: 0), 9, middle, JournalTrim(floor: 3, dropped: final_charge))?
    Ok(take overlay)
}

fn l79_fold_checks(source: TieredPageSource, base: std.page.PagePtr) -> Result[(), Error] waits {
    // Each of the three rows costs 62 + round8(12) + round8(6) = 86.
    verify_tiered_fold(source, base, l79_fold_trims(172, 86)?)?
    let Error(Corrupt(Fault(why: Malformed, ..))) = verify_tiered_fold(source, base, l79_fold_trims(180, 78)?) else {
        fail("L79: individually wrong trim charges passed with the right sum")
    }
    let mut overlay = empty_replay_overlay(None)
    let key = log_key(9, 4)?
    replay_overlay_edit(mut overlay, "j-1", 110, ReplayOrigin(ordinal: 1, branch: 0), key, 7, ReplayAbsent)?
    let Error(Corrupt(Fault(why: Malformed, ..))) = verify_tiered_fold(source, base, overlay) else {
        fail("L68: fold accepted a recorded prior for an absent key")
    }
    Ok(())
}

@test
fn test_l79_fold_checks_cold_evidence(d: Dir, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let owner = StoreId(hi: 3, lo: 4)
    let base = l79_fold_base(fixtures, owner)?
    let width: u64 = int.widen(base.len)
    let inventory = PagePack(class: 3, frames: 1, live: width, payload_bytes: 116 + width, index: 88 + width)
    let mut ids = 0u64
    let empty: std.omap.OMap[u64, TieredPagerPack] = std.omap.new()
    let (take packs, _) = std.omap.insert(mut ids, empty, 8u64, TieredPagerPack(inventory: inventory, object: None))
    let (take requests, take worker) = start_tiered_pager(tasks, owner, 0, PagerDirectory(fixtures), 4096, 1048576, 4)
    let source = TieredPageSource(pager: take requests, packs: take packs, next_stamp: 41, deadline: 0)
    let checked = l79_fold_checks(source, base)
    let _ = take source
    let _ = result.unwrap(task.join(take worker))
    checked
}

@test
fn test_l68_fold_reuses_cold_edges() -> Result[(), Error] {
    let dropped = std.page.BlobRef(stamp: 31, len: 1025, checksum: 101, pack: 7, offset: 72, body: 0)
    let retained = std.page.BlobRef(stamp: 32, len: 1025, checksum: 102, pack: 7, offset: 1121, body: 1)
    let mut rows: List[std.page.Entry] = list.with_capacity(2)
    list.push(mut rows, std.page.Entry(key: key_word(1), cell: BlobValue(dropped)))
    list.push(mut rows, std.page.Entry(key: key_word(2), cell: BlobValue(retained)))
    let formed = page_result(std.page.encode(rows, 0, 40, Collection))?
    let original = page_result(std.page.attach_cold(take formed))?
    let mut edited = arc.share(original)
    let mut next_stamp = 41u64
    if !page_result(std.page.remove(mut edited, key_word(1), 0, mut next_stamp))? {
        fail("L68: a fold delete must find a Cold BLOB row by key")
    }
    page_result(std.page.canonicalize(mut edited))?
    let Some(ColdBlob(after)) = std.page.blob_slot(edited, 0) else {
        fail("L68: the surviving BLOB was lost or forced")
    }
    let Some(ColdBlob(before)) = std.page.blob_slot(original, 1) else {
        fail("L68: the earlier capture lost its BLOB")
    }
    let mut expected = retained
    expected.body = 0
    if before != retained || after != expected || std.page.totals(edited) != (1u64, 1110u64) {
        fail("L68: fold did not preserve the surviving BLOB location and rebind its ordinal")
    }
    let locate: scoped[view] fn(u64) -> std.page.PagePtr = scoped fn(id: u64) -> std.page.PagePtr {
        fail("L68: Cold edges have no entry in the new pack's location table")
    }
    let sealed = sealed_tiered_root(edited, locate)?
    let Some(ColdBlob(installed)) = std.page.blob_slot(sealed, 0) else {
        fail("L68: sealing lost the retained BLOB")
    }
    if installed != expected {
        fail("L68: sealing rewrote an unmodified Cold BLOB's location")
    }
    let child = std.page.PagePtr(pack: 8, offset: 72, len: 79, checksum: 103, stamp: 41)
    let mut branches: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut branches, std.page.Entry(key: list.new(), cell: Child(std.page.Branch(child: child, rows: 1, charge: 1110))))
    let parent = page_result(std.page.encode(branches, 1, 42, Collection))?
    let root = page_result(std.page.attach_cold(take parent))?
    let installed_root = sealed_tiered_root(root, locate)?
    let Some(ColdPage(inherited)) = std.page.child_slot(installed_root, 0) else {
        fail("L68: sealing lost a Cold child")
    }
    if inherited != child {
        fail("L68: sealing changed an unmodified child PAGE location")
    }
    Ok(())
}

fn l62_replay_read_tree(base: std.page.PagePtr) -> Result[PageTree, Error] {
    let mut raw = l68_collection_map_wire()
    list.copy_from_slice(mut raw, 33, std.page.encode_ptr(base))
    list.set_word_le(mut raw, 69, 3u64)
    list.set_word_le(mut raw, 77, 258u64)
    let image = page_result(std.page.decode(take raw, CollectionMap))?
    let mut slots: List[std.page.Slot] = list.new()
    list.push(mut slots, ColdPage(base))
    let mut tree = new_page_tree(CollectionMap, 1024)
    tree.root = page_result(std.page.attach(take image, take slots, list.new()))?
    Ok(take tree)
}

fn l62_read_replayed_point(source: TieredPageSource, base: std.page.PagePtr) -> Result[(), Error] waits {
    let grant = pager_reader_grant(source.pager, VALUE_LIMIT + 1048576)?
    let mut tree = l62_replay_read_tree(base)?
    let key = log_key(9, 1)?
    let mut root = TieredPinRoot(domain: 1, branch: 0, generation: 1, root_stamp: tree_stamp(tree))
    for _ in 0u64 .. 2 {
        let Some(value) = read_tiered_point(source, grant, root, tree, key, 4)? else {
            fail("L62: cold and warm lookup must both find the row")
        }
        if list.compare_bytes(value, string.as_bytes("stored")) != Equal {
            fail("L62: pager lookup changed the row")
        }
    }
    let mut account = ReplayTieredAccount(total: 258, exact: true, ordinal: 0)
    let mut ids = 101u64
    let before = ReplayDescriptor(rows: 3, row_bytes: 258, seq_bounds: None)
    let put_op = JournalOp(key: clone(key), value: Some(string.into_bytes(string.from("second"))), prior: 7, trim: None)
    replay_tiered_op("j-1", mut tree, mut ids, mut account, ReplayOrigin(ordinal: 1, branch: 0), before, put_op)?
    root.root_stamp = tree_stamp(tree)
    let overlay_only = TieredPageSource(pager: channel.sender(source.pager), packs: std.omap.new(), next_stamp: source.next_stamp, deadline: source.deadline)
    let Some(replayed) = read_tiered_point(overlay_only, grant, root, tree, key, 4)? else {
        fail("L62: a replay put did not answer without the Cold inventory")
    }
    if list.compare_bytes(replayed, string.as_bytes("second")) != Equal {
        fail("L62: a replay put did not take precedence over its base")
    }
    let Some(untouched) = read_tiered_point(source, grant, root, tree, log_key(9, 2)?, 4)? else {
        fail("L62: an overlay skipped the Cold base for an untouched key")
    }
    if list.compare_bytes(untouched, string.as_bytes("stored")) != Equal {
        fail("L62: reading past an overlay changed a base row")
    }
    let deleted = JournalOp(key: clone(key), value: None, prior: 7, trim: None)
    replay_tiered_op("j-1", mut tree, mut ids, mut account, ReplayOrigin(ordinal: 2, branch: 0), before, deleted)?
    root.root_stamp = tree_stamp(tree)
    if let Some(_) = read_tiered_point(overlay_only, grant, root, tree, key, 4)? {
        fail("L62: a replay tombstone did not hide the base row")
    }
    Ok(())
}

@test
fn test_l62_pager_reads_replayed_points(d: Dir, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let owner = StoreId(hi: 3, lo: 4)
    let base = l79_fold_base(fixtures, owner)?
    let width: u64 = int.widen(base.len)
    let inventory = PagePack(class: 3, frames: 1, live: width, payload_bytes: 116 + width, index: 88 + width)
    let mut ids = 0u64
    let empty: std.omap.OMap[u64, TieredPagerPack] = std.omap.new()
    let (take packs, _) = std.omap.insert(mut ids, empty, 8u64, TieredPagerPack(inventory: inventory, object: None))
    let (take pager, take worker) = start_tiered_pager(tasks, owner, 0, PagerDirectory(fixtures), 32 * 1048576, 1048576, 4)
    let source = TieredPageSource(pager: take pager, packs: take packs, next_stamp: 41, deadline: 0)
    let checked = l62_read_replayed_point(source, base)
    let _ = take source
    let _ = result.unwrap(task.join(take worker))
    checked
}

@test
fn test_l68_indexed_tiered_pack() -> Result[(), Error] {
    let owner = StoreId(hi: 3, lo: 4)
    let value = arc.new(string.into_bytes(string.from("test")))
    let locate: scoped[view] fn(u64) -> std.page.PagePtr = scoped fn(stamp: u64) -> std.page.PagePtr {
        fail("Tiered BLOB encoding does not resolve a child")
    }
    // The first frame costs 28 bytes. The worst-case index adds 28 bytes
    // for its head and prefix and 41 per row, including both 12-byte keys.
    let first = PackFrame(stamp: 31, size: 12, body: BlobBody(arc.share(value)))
    let second = PackFrame(stamp: 32, size: 12, body: BlobBody(arc.share(value)))
    let first_key = log_key(9, 1)?
    let second_key = log_key(9, 2)?
    let mut draft = begin_tiered_pack(owner, 7, 4, 237)?
    let Some(_) = add_tiered_pack_frame(mut draft, first, 9, first_key, locate)? else {
        fail("L68: the first BLOB did not fit")
    }
    if let Some(_) = add_tiered_pack_frame(mut draft, second, 9, second_key, locate)? {
        fail("L68: pack admission used the front-coded size")
    }
    let (_, split) = finish_tiered_pack(take draft)?
    if split.frames != 1 || split.index != 100 || split.live != 12 || split.payload_bytes != 169 {
        fail("L68: a refused frame changed the pack")
    }

    let mut complete = begin_tiered_pack(owner, 8, 4, 238)?
    let Some(left) = add_tiered_pack_frame(mut complete, first, 9, first_key, locate)? else {
        fail("L68: the first indexed BLOB did not fit")
    }
    let Some(right) = add_tiered_pack_frame(mut complete, second, 9, second_key, locate)? else {
        fail("L68: the second indexed BLOB should fit at its worst-case size")
    }
    let (take raw, pack) = finish_tiered_pack(take complete)?
    if left.offset != 72 || right.offset != 100 || pack.index != 128 || pack.payload_bytes != 227 || pack.live != 24 || pack.frames != 2 {
        fail("L68: pack inventory did not describe the frames and full object")
    }
    let context = DiskContext(store: owner, role: 3, seq: 8)
    let trailer = disk_frame_bytes("p-8", context, raw, pack.index)?
    if trailer.kind != PACK_INDEX_KIND || trailer.end != 227 {
        fail("L68: pack did not finish with its authenticated index")
    }
    let mut last_offset = 0u64
    let decoded_index = decode_pack_index("p-8", pack.index, list.slice(raw, trailer.payload, trailer.end), mut last_offset)?
    if decoded_index.prev != 0 || list.len(decoded_index.rows) != 2 || decoded_index.rows[0u64].key != first_key || decoded_index.rows[1u64].key != second_key ||
        decoded_index.rows[1u64].stamp != 32 || decoded_index.rows[1u64].len != 12 || decoded_index.rows[1u64].kind != 0x22 || decoded_index.rows[1u64].collection != 9 || last_offset != 100 {
        fail("L68: the index did not describe the second BLOB")
    }
    Ok(())
}

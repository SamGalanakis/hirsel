// A key mix can multiply two high u64 words. Its low bits must wrap, even
// when the exact unsigned product exceeds the evaluator's signed i128.
// expect: run product() = 1
// expect: run checked() = true
// expect: run saturated() = 18446744073709551615
fn product() -> u64 {
    int.wrapping_mul(18446744073709551615u64, 18446744073709551615u64)
}

fn checked() -> bool {
    match int.checked_mul(18446744073709551615u64, 18446744073709551615u64) {
        None => true,
        Some(_) => false
    }
}

fn saturated() -> u64 {
    int.saturating_mul(18446744073709551615u64, 18446744073709551615u64)
}

pub type Purpose: key = Describe | Check | Copy

pub type Part: send {
    name: String,
    amount: u64
}

pub type Need: send {
    total: u64,
    parts: List[Part]
}

// MEM-24: page.decode keeps the frame buffer. One copied entry has up
// to 4,096 key bytes and 1,024 inline value bytes.
const PAGE_DECODED: u64 = 4096 + 1024

const MANIFEST_DECODED: u64 = 2 * types.META_LIMIT + 4096

const CAPTURE_PATH: u64 = 65 * (8400 + PAGE_DECODED)

const END_IMAGE: u64 = 1048672

const SEG: u64 = 48

const CAPTURE_LIST_ROW: u64 = 48

const CAPTURE_BRANCH: u64 = 24

const PACK_HELD: u64 = 32

const NAME_SLOT: u64 = 32

const CAPTURE_SCRATCH: u64 = 32768

pub const BOOTSTRAP: u64 = 2 * PAGE_MANIFEST_FILE_LIMIT + MANIFEST_DECODED + END_IMAGE + JOURNAL_CHUNK_BYTES + FRAME_LIMIT + CAPTURE_PATH + CAPTURE_SCRATCH

type PreparedSegment: send {
    seq: u64,
    file: HostFile,
    start: u64,
    end: u64
}

pub opaque type PreparedCapture: send {
    purpose: Purpose,
    dir: Dir,
    raw: Bytes,
    id: StoreId,
    manifest: PageManifest,
    segments: List[PreparedSegment],
    lists: CaptureListCount,
    names: u64,
    name_bytes: u64,
    lock: Option[HostFile]
}

fn capture_add(a: u64, b: u64) -> u64 {
    int.saturating_add(a, b)
}

fn capture_mul(a: u64, b: u64) -> u64 {
    match int.checked_mul(a, b) {
        Some(size) => size,
        None => 18446744073709551615u64,
    }
}

fn capture_need_part(mut n: Need, name: String, amount: u64) {
    n.total = capture_add(n.total, amount)
    list.push(mut n.parts, Part(name: clone(name), amount: amount))
}

fn capture_bootstrap(p: PreparedCapture) -> u64 {
    2 * format.round8(list.len(p.raw)) + 2 * p.manifest.limits.meta + 4096 + END_IMAGE + p.manifest.limits.frame + CAPTURE_PATH
}

fn capture_list_slots(p: PreparedCapture) -> u64 {
    capture_add(p.lists.rows, p.lists.pages)
}

fn capture_bitmap_bytes(p: PreparedCapture) -> u64 {
    let stamp = p.manifest.next_stamp
    stamp / 8 + (if stamp % 8 == 0 {
        0u64
    } else {
        1u64
    })
}

fn capture_branch_slots(limits: StoreLimits) -> u64 {
    limits.meta / 143 + 1
}

fn capture_check_scratch(p: PreparedCapture) -> u64 {
    // A collections-map path can lead into a second page tree.
    capture_bootstrap(p) + CAPTURE_PATH + CAPTURE_BRANCH * capture_branch_slots(p.manifest.limits) + JOURNAL_CHUNK_BYTES + CAPTURE_SCRATCH
}

fn capture_check_need(p: PreparedCapture) -> u64 {
    let tables = capture_add(capture_mul(CAPTURE_LIST_ROW, capture_list_slots(p)), 2 * capture_bitmap_bytes(p))
    let total = capture_add(capture_add(capture_check_scratch(p), tables), capture_mul(SEG, list.len(p.segments)))
    if p.purpose == Copy {
        return capture_add(total, JOURNAL_CHUNK_BYTES)
    }
    total
}

pub fn capture_need(p: PreparedCapture) -> Need {
    let mut n = Need(total: 0, parts: list.with_capacity(8))
    capture_need_part(mut n, "bootstrap", capture_bootstrap(p))
    capture_need_part(mut n, "segments", capture_mul(SEG, list.len(p.segments)))
    if p.purpose != Describe {
        capture_need_part(mut n, "lists", capture_mul(CAPTURE_LIST_ROW, capture_list_slots(p)))
        capture_need_part(mut n, "bitmaps", 2 * capture_bitmap_bytes(p))
        capture_need_part(mut n, "branches", CAPTURE_BRANCH * capture_branch_slots(p.manifest.limits))
        capture_need_part(mut n, "chunk", JOURNAL_CHUNK_BYTES)
        if p.purpose == Copy {
            capture_need_part(mut n, "copy chunk", JOURNAL_CHUNK_BYTES)
        }
        capture_need_part(mut n, "scratch", CAPTURE_PATH + CAPTURE_SCRATCH)
        return take n
    }
    capture_need_part(mut n, "held", capture_mul(PACK_HELD, capture_add(p.lists.pack_rows, p.lists.pages)))
    capture_need_part(mut n, "deltas", capture_mul(32, int.widen(p.manifest.next_table)))
    capture_need_part(mut n, "catalog", capture_add(capture_mul(NAME_SLOT, p.names), p.name_bytes))
    capture_need_part(mut n, "chunk", JOURNAL_CHUNK_BYTES)
    capture_need_part(mut n, "scratch", CAPTURE_SCRATCH)
    take n
}

type CaptureSelection {
    dir: Dir,
    raw: Bytes,
    id: StoreId,
    manifest: PageManifest,
    segments: u64,
    lists: CaptureListCount,
    names: u64,
    name_bytes: u64
}

fn capture_same_manifest(d: Dir, raw: Bytes) -> Result[bool, Error] waits {
    let mut file = match host.open(d, "MANIFEST", Read) {
        Ok(take opened) => take opened,
        Error(NotFound) => return Ok(false),
        Error(problem) => return Error(Io(problem)),
    }
    let size = disk_io(host.stat_file(mut file))?.size
    if size != list.len(raw) {
        return Ok(false)
    }
    Ok(read_disk_bytes(mut file, "MANIFEST", 0, size)? == raw)
}

fn capture_measure_pages(mut packs: CapturePacks, manifest: PageManifest) -> Result[(CaptureListCount, u64, u64), Error] waits {
    let lists = capture_lists(mut packs, manifest)?
    let (names, amount) = capture_count_catalog(mut packs, manifest.branches[0].roots.catalog)?
    Ok((lists, names, amount))
}

fn capture_measure(d: Dir, locked: Option[Clock]) -> Result[CaptureSelection, Error] waits {
    let (take raw, id, take manifest) = read_only_manifest(d)?
    require_unarchived_manifest(manifest)?
    let mut packs = capture_packs(d, id, manifest, false, 0)
    let measured: Result[(CaptureListCount, u64, u64), Error] = if let Some(_) = locked {
        match capture_lists(mut packs, manifest) {
            Ok(tally) => Ok((tally, 0u64, 0u64)),
            Error(take problem) => Error(take problem),
        }
    } else {
        capture_measure_pages(mut packs, manifest)
    }
    let (lists, names, amount) = match take measured {
        Ok(counted) => counted,
        Error(Io(NotFound)) => {
            if !capture_same_manifest(d, raw)? {
                return Error(Changed("MANIFEST"))
            }
            return Error(failure_from_rep(format.disk_fault("MANIFEST", 72, Absent)))
        },
        Error(take problem) => return Error(take problem),
    }
    let mut segment_count = 0u64
    let mut ignored: List[PreparedSegment] = list.new()
    match capture_segment_walk(d, id, manifest.first_live, false, locked, mut segment_count, mut ignored) {
        Ok(_) => (),
        Error(take problem) => {
            if !capture_same_manifest(d, raw)? {
                return Error(Changed("MANIFEST"))
            }
            return Error(take problem)
        },
    }
    Ok(CaptureSelection(dir: d, raw: take raw, id: id, manifest: take manifest, segments: segment_count, lists: lists, names: names, name_bytes: amount))
}

// In the measurement pass no handle survives an iteration. In the second
// pass a successor supplies the preceding handle's exact end.
fn capture_segment_walk(d: Dir, id: StoreId, first: u64, hold: bool, locked: Option[Clock], mut segment_count: u64, mut segments: List[PreparedSegment]) -> Result[bool, Error] waits {
    let mut seq = first
    loop {
        let path = journal_path(seq, "")?
        let mut file = match host.open(d, path, Read) {
            Ok(take opened) => take opened,
            Error(NotFound) if seq != first => return Ok(true),
            Error(NotFound) => return Error(failure_from_rep(format.disk_fault(path, 0, Header))),
            Error(problem) => return Error(Io(problem)),
        }
        if let Some(c) = locked {
            journal_wait_shared(mut file, c)?
            if hold {
                disk_io(host.sync(mut file))?
            }
        }
        let header_read = match read_disk_bytes(mut file, path, 0, 72) {
            Ok(take amount) => disk_read_header(path, amount, 2, Some(seq), Some(id)),
            Error(take problem) => Error(take problem),
        }
        let header = match take header_read {
            Ok(found) => found,
            Error(Corrupt(take fault)) => {
                let successor = if let Some(next_seq) = int.checked_add(seq, 1) {
                    disk_exists(d, journal_path(next_seq, "")?)?
                } else {
                    false
                }
                if successor || capture_end(id, seq, capture_end_image(d, seq)?)? != None {
                    return Error(Corrupt(take fault))
                }
                return Ok(true)
            },
            Error(take problem) => return Error(take problem),
        }
        if hold {
            let n = list.len(segments)
            if n == segment_count {
                return Ok(false)
            }
            if n != 0 {
                segments[n - 1].end = header.prev_end
            }
            list.push(mut segments, PreparedSegment(seq: seq, file: take file, start: 72, end: 72))
        } else {
            segment_count += 1
        }
        let Some(next_seq) = int.checked_add(seq, 1) else {
            return Ok(true)
        }
        seq = next_seq
    }
}

fn capture_segment_bounds(s: CaptureSelection, c: Clock, mut segments: List[PreparedSegment]) -> Result[bool, Error] waits {
    let d = s.dir
    let mut segment_count = s.segments
    if !capture_segment_walk(d, s.id, s.manifest.first_live, true, None, mut segment_count, mut segments)? {
        return Ok(false)
    }
    let n = list.len(segments)
    if n == 0 {
        disk_io(host.sync_dir(d))?
        return capture_same_manifest(d, s.raw)
    }
    let tail = n - 1
    let seq = segments[tail].seq
    let image = capture_end_image(d, seq)?
    let durable_end = match capture_end(s.id, seq, image)? {
        Some(found) => found,
        None => 72u64,
    }
    let mut free = false
    loop {
        if disk_io(host.try_lock_shared(mut segments[tail].file))? {
            free = true
            break
        }
        if !capture_lock_free(d)? {
            break
        }
        std.clock.sleep_ns(c, 1000000)
    }
    disk_io(host.sync_dir(d))?
    if !capture_same_manifest(d, s.raw)? {
        return Ok(false)
    }
    let end = if free {
        disk_io(host.sync(mut segments[tail].file))?
        let size = disk_io(host.stat_file(mut segments[tail].file))?.size
        let mut ignored = ()
        let (end, _) = capture_scan_frames(mut segments[tail].file, s.id, seq, s.manifest.limits, durable_end, size, true, SkipPayload, mut ignored, fn(mut _state: (), _path: String, _at: u64, _kind: u16, _payload: Bytes) -> Result[(), Error] {
            Ok(())
        })?
        disk_io(host.unlock(mut segments[tail].file))?
        end
    } else {
        durable_end
    }
    segments[tail].end = end
    Ok(true)
}

pub fn prepare(d: Dir, c: Clock, purpose: Purpose) -> Result[PreparedCapture, Error] waits {
    let lock: Option[HostFile] = match purpose {
        Describe => None,
        Check => Some(disk_lock(d, c, 0)?),
        Copy => Some(backup_lock(d)?),
    }
    prepare_capture(d, c, purpose, take lock)
}

fn prepare_capture(d: Dir, c: Clock, purpose: Purpose, take lock: Option[HostFile]) -> Result[PreparedCapture, Error] waits {
    let locked: Option[Clock] = if purpose == Describe {
        None
    } else {
        Some(c)
    }
    loop {
        let selection = failure_result_from_rep(types.capacity(bound bytes BOOTSTRAP {
            capture_measure(d, locked)
        }))?
        let s = match take selection {
            Ok(take found) => take found,
            Error(Changed(file)) if file == "MANIFEST" => continue,
            Error(take problem) => return Error(take problem),
        }
        let mut segments: List[PreparedSegment] = failure_result_from_rep(types.capacity(bound bytes capture_mul(SEG, s.segments) {
            list.with_capacity(s.segments)
        }))?
        let selected = failure_result_from_rep(types.capacity(bound bytes BOOTSTRAP {
            if purpose == Describe {
                capture_segment_bounds(s, c, mut segments)
            } else {
                capture_locked_bounds(s, c, mut segments)
            }
        }))?
        let stable = match take selected {
            Ok(stable) => stable,
            Error(take problem) => {
                if !capture_same_manifest(d, s.raw)? {
                    continue
                }
                return Error(take problem)
            },
        }
        if !stable {
            continue
        }
        let CaptureSelection(dir: dir, raw: take raw, id: id, manifest: take manifest, lists: lists, names: names, name_bytes: amount, ..) = take s
        return Ok(PreparedCapture(purpose: purpose, dir: dir, raw: take raw, id: id, manifest: take manifest, segments: take segments, lists: lists, names: names, name_bytes: amount, lock: take lock))
    }
}

// The caller owns LOCK. Every selected segment was fenced and synced before
// its HEADER supplied a predecessor bound or its own tail was examined.
fn capture_locked_bounds(s: CaptureSelection, c: Clock, mut segments: List[PreparedSegment]) -> Result[bool, Error] waits {
    let mut segment_count = s.segments
    if !capture_segment_walk(s.dir, s.id, s.manifest.first_live, true, Some(c), mut segment_count, mut segments)? {
        return Error(failure_from_rep(format.disk_fault("MANIFEST", 72, Malformed)))
    }
    disk_io(host.sync_dir(s.dir))?
    let n = list.len(segments)
    if n == 0 {
        return Ok(true)
    }
    let tail = n - 1
    let seq = segments[tail].seq
    let durable_end = match disk_end(s.dir, s.id, seq)? {
        Some(found) => found,
        None => 72u64,
    }
    let size = disk_io(host.stat_file(mut segments[tail].file))?.size
    let mut ignored = ()
    let (end, _) = capture_scan_frames(mut segments[tail].file, s.id, seq, s.manifest.limits, durable_end, size, true, SkipPayload, mut ignored, fn(mut _state: (), _path: String, _at: u64, _kind: u16, _payload: Bytes) -> Result[(), Error] {
        Ok(())
    })?
    segments[tail].end = end
    Ok(true)
}

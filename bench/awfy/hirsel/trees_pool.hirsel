// AWFY JavaScript storage.js. Each document owns its descriptors and child slots.
// A TreeRef is a one-based descriptor index, with zero for an empty leaf slot.
type TreeRef { index: u32 }

type Tree {
    start: u32,
    count: u32
}

type Document {
    trees: List[Tree],
    slots: List[TreeRef]
}

fn build(mut doc: Document, depth: u32, mut seed: u32) -> Result[TreeRef, Capacity] {
    let count = if depth == 1 { small.next_random(mut seed) % 10 + 1 } else { 4u32 }
    let start = list.len(doc.slots)
    let tree = Tree(start: int.narrow(start), count: count)
    let handle = TreeRef(index: int.narrow(list.len(doc.trees) + 1))
    result.capacity_only(list.push(mut doc.trees, take tree))?
    list.fill(mut doc.slots, int.widen(count), TreeRef(index: 0))?
    if depth > 1 {
        for slot in start .. start + int.widen(count) {
            let child = build(mut doc, depth - 1, mut seed)?
            doc.slots[slot] = child
        }
    }
    Ok(handle)
}

pub fn benchmark(depth: u64) -> Result[u64, Capacity] {
    let mut doc = Document(trees: list.new(), slots: list.new())
    let mut seed = 74755u32
    let root = build(mut doc, int.narrow(depth), mut seed)?
    let index: u64 = int.widen(root.index - 1)
    if doc.trees[index].count == 4 {
        Ok(list.len(doc.trees))
    } else {
        Ok(0)
    }
}

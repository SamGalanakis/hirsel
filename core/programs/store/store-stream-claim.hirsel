// Reads batch `seq` of incarnation `inc` and applies X's slice at `epoch`
// to `replay`, from frame `skip` on. Resolves 404 via §12.11.8's full table.
fn stream_tail_batch(mut client: std.object.Client, mut lane: host_stream.StreamLane, mut buffers: host_stream.TailBuffers, place_prefix: String, head_witness: Bytes, sid: HostStreamId, inc: u64, seq: u64, store: StoreId, epoch: u64, skip: u64, stop_rev: u64, in_sealed_range: bool, seen_higher_batch: bool, mut replay: pager.JournalReplay, ceiling: u64, deadline: u64) -> Result[host_stream.TailBatch, Error] waits {
    let mut name = string.with_capacity(48)
    format.stream_batch_key(mut name, inc, seq)
    let key = host_stream.stream_key(lane.dir, name)
    if let None = failure_result_from_rep(host_stream.stream_tail_range(mut client, key, 0, format.STREAM_INDEX_PROBE, mut buffers.index, deadline))? {
        if let Some(outcome) = failure_result_from_rep(host_stream.stream_resolve_404(mut client, mut lane, mut buffers, place_prefix, head_witness, key, inc, seq, in_sealed_range, seen_higher_batch, deadline))? {
            return Ok(outcome)
        }
    }
    let mut batch_index = match failure_result_from_rep(manifest.stream_batch_head(key, buffers.index, host_stream_id_to_rep(sid), inc, seq))? {
        Rows(take found) => take found,
        Term(_, _) => return Ok(TailTerm),
    }
    if list.len(buffers.index) < batch_index.byte_len {
        if let None = failure_result_from_rep(host_stream.stream_tail_range(mut client, key, 0, batch_index.byte_len, mut buffers.index, deadline))? {
            return Error(failure_from_rep(format.disk_fault(key, 0, Absent)))
        }
        batch_index = match failure_result_from_rep(manifest.stream_batch_head(key, buffers.index, host_stream_id_to_rep(sid), inc, seq))? {
            Rows(take found) => take found,
            Term(_, _) => return Error(failure_from_rep(format.disk_fault(key, 72, Malformed))),
        }
    }
    if batch_index.seen_rev >= stop_rev {
        return Ok(TailBeyond)
    }
    for row in batch_index.rows {
        if types.same(row.store.hi, row.store.lo, store.hi, store.lo) && row.epoch == epoch {
            if row.len == 0 {
                return Error(failure_from_rep(format.disk_fault(key, row.offset, Malformed)))
            }
            if let None = failure_result_from_rep(host_stream.stream_tail_range(mut client, key, row.offset, row.offset + row.len, mut buffers.slice, deadline))? {
                return Error(failure_from_rep(format.disk_fault(key, row.offset, Absent)))
            }
            failure_result_from_rep(format.stream_slice_check(key, row, buffers.slice))?
            stream_tail_apply(key, buffers.slice, row, seq, store, epoch, skip, mut replay, ceiling)?
            return Ok(TailRead(true))
        }
    }
    Ok(TailRead(false))
}

// X's frames in one slice, sealed under (X, BATCH, seq) at slice offsets
// (§12.11.2): commits apply in order and are re-admitted after each; the
// CLAIM names this epoch; nothing else may ride a Place's slice.
fn stream_tail_apply(key: String, slice: Bytes, row: format.BatchRow, seq: u64, store: StoreId, epoch: u64, skip: u64, mut replay: pager.JournalReplay, ceiling: u64) -> Result[(), Error] {
    let ctx = format.DiskContext(store: store_key_to_rep(store), role: format.ROLE_BATCH, seq)
    let mut at = 0u64
    let mut frames = 0u64
    while at < list.len(slice) {
        let frame = failure_result_from_rep(manifest.disk_frame_bytes(key, ctx, slice, at))?
        if frames >= skip {
            if frame.kind == 0x0040 {
                if frame.end - frame.payload != 24 || format.read_le(slice, frame.payload, 8) != epoch {
                    return Error(failure_from_rep(format.disk_fault(key, row.offset + at, Malformed)))
                }
            } else if frame.kind == 0x0011 || frame.kind == 0x0013 {
                let event = disk_allocation(scoped fn() -> Result[format.JournalEvent, Error] {
                    journal_decode(key, frame.kind, list.slice(slice, frame.payload, frame.end))
                })?
                journal_apply(key, mut replay, take event)?
                failure_result_from_rep(catalog.over_ceiling(failure_result_from_rep(journal.journal_account(replay))?, ceiling))?
            } else {
                return Error(failure_from_rep(format.disk_fault(key, row.offset + at, Kind(int.widen(frame.kind)))))
            }
        }
        frames += 1
        at = frame.end
    }
    if frames != row.frames {
        return Error(failure_from_rep(format.disk_fault(key, row.offset, Malformed)))
    }
    Ok(())
}

// Reads batches from `cursor.next` until one is not yet created, hits TERM,
// sees head move on a retired 404, or (for the delta) has `seen_rev ≥ stop_rev`
// (§12.11.5 steps 2 and 4, §12.11.8 404 table).
fn stream_tail_scan(mut client: std.object.Client, mut lane: host_stream.StreamLane, mut buffers: host_stream.TailBuffers, place_prefix: String, head_witness: Bytes, tail: format.StreamRef, store: StoreId, epoch: u64, mut cursor: host_stream.TailScan, stop_rev: u64, mut replay: pager.JournalReplay, ceiling: u64, deadline: u64) -> Result[host_stream.TailStop, Error] waits {
    loop {
        let skip: u64 = if cursor.next == tail.from_seq {
            int.widen(tail.from_frame)
        } else {
            0
        }
        match stream_tail_batch(mut client, mut lane, mut buffers, place_prefix, head_witness, host_stream_id_from_rep(tail.sid), tail.inc, cursor.next, store, epoch, skip, stop_rev, false, false, mut replay, ceiling, deadline)? {
            TailAbsent => return Ok(StopAbsent),
            TailBeyond => return Ok(StopBeyond),
            TailTerm => return Ok(StopTerm),
            TailHeadMoved => return Ok(StopHeadMoved),
            TailSkipTo(low_seq) => {
                if low_seq > cursor.next {
                    cursor.next = low_seq
                } else {
                    cursor.next += 1
                }
            },
            TailRead(had) => {
                if had {
                    cursor.last_x = Some(cursor.next)
                }
                cursor.next += 1
            },
        }
    }
}

// Step 2 XINDEX fast path (§12.11.5 step 2): when `reg.index` covers
// `(tail.inc, cursor.next)`, fetches `x-<k>` and reads only the batches X had
// rows in up to `covers_seq`, falling back cleanly on corrupt/missing XINDEX.
fn stream_tail_prescan_xindex(mut client: std.object.Client, mut source_lane: host_stream.StreamLane, mut tail_buffers: host_stream.TailBuffers, place_prefix: String, head_witness: Bytes, tail: format.StreamRef, store: StoreId, epoch: u64, mut cursor: host_stream.TailScan, mut replay: pager.JournalReplay, ceiling: u64, deadline: u64) -> Result[bool, Error] waits {
    let Some(meta) = source_lane.reg.index else {
        return Ok(true)
    }
    if meta.covers_inc != tail.inc || meta.covers_seq < cursor.next {
        return Ok(true)
    }
    let Some(take xidx) = failure_result_from_rep(host_stream.stream_xindex_fetch(mut client, source_lane.dir, host_stream_id_to_rep(host_stream_id_from_rep(tail.sid)), meta, deadline))? else {
        return Ok(true)
    }
    for e in xidx.entries {
        if types.same(e.store.hi, e.store.lo, store.hi, store.lo) && e.epoch == epoch {
            for (bi, bs) in e.batches {
                if bi == tail.inc && bs >= cursor.next && bs <= meta.covers_seq {
                    let skip: u64 = if bs == tail.from_seq {
                        int.widen(tail.from_frame)
                    } else {
                        0
                    }
                    match stream_tail_batch(mut client, mut source_lane, mut tail_buffers, place_prefix, head_witness, host_stream_id_from_rep(tail.sid), tail.inc, bs, store, epoch, skip, 18446744073709551615u64, false, false, mut replay, ceiling, deadline)? {
                        TailRead(had) => if had {
                            cursor.last_x = Some(bs)
                        },
                        TailHeadMoved => return Ok(false),
                        TailSkipTo(_) => (),
                        TailTerm => return Ok(true),
                        TailAbsent => (),
                        TailBeyond => (),
                    }
                }
            }
        }
    }
    if meta.covers_seq + 1 > cursor.next {
        cursor.next = meta.covers_seq + 1
    }
    Ok(true)
}

// The no-hold rule (§12.11.7): when `live.inc < reg.inc`, scan through the
// terminal fence of `live.inc`. If no TERM sits at the first 404, create it
// there (advancing over any late batch that won the race so it is included).
fn stream_no_hold_scan(mut client: std.object.Client, mut source_lane: host_stream.StreamLane, mut tail_buffers: host_stream.TailBuffers, place_prefix: String, head_witness: Bytes, tail: format.StreamRef, store: StoreId, epoch: u64, authority_kind: u8, mut cursor: host_stream.TailScan, mut replay: pager.JournalReplay, ceiling: u64, deadline: u64) -> Result[bool, Error] waits {
    let mut name = string.with_capacity(48)
    loop {
        match stream_tail_scan(mut client, mut source_lane, mut tail_buffers, place_prefix, head_witness, tail, store, epoch, mut cursor, 18446744073709551615u64, mut replay, ceiling, deadline)? {
            StopTerm => return Ok(true),
            StopBeyond => return Ok(true),
            StopHeadMoved => return Ok(false),
            StopAbsent => {
                format.stream_batch_key(mut name, tail.inc, cursor.next)
                let key = host_stream.stream_key(source_lane.dir, name)
                failure_result_from_rep(format.stream_term_encode(mut source_lane.body, host_stream_id_to_rep(host_stream_id_from_rep(tail.sid)), tail.inc, cursor.next, authority_kind))?
                let (take outcome, take buffer) = std.object.store_if_retry(mut client, key, Absent, replace(mut source_lane.body, list.new()), deadline)
                source_lane.body = take buffer
                match take outcome {
                    Ok(Applied(_)) => return Ok(true),
                    Ok(Mismatch) => {
                        let Some(()) = failure_result_from_rep(host_stream.stream_tail_range(mut client, key, 0, format.STREAM_INDEX_PROBE, mut tail_buffers.index, deadline))? else {
                            return Error(failure_from_rep(format.disk_fault(key, 0, Absent)))
                        }
                        match failure_result_from_rep(manifest.stream_batch_head(key, tail_buffers.index, host_stream_id_to_rep(host_stream_id_from_rep(tail.sid)), tail.inc, cursor.next))? {
                            Term(_, _) => return Ok(true),
                            Rows(_) => (),
                        }
                    },
                    Error(take problem) => return Error(Remote(take problem)),
                }
            },
        }
    }
}

// An attached open of an existing Place X (§12.11.5). The first push serves
// only `live` at the register's current incarnation with no sealed tail;
// every other ATTACH refuses before any write. `workspace.witness` holds
// step 1's head bytes on entry.
fn stream_open_attached[T](take input: history.ObjectPackRead, mut link: host_stream.SlotLink, r: Random, holder: StoreId, options: Options, requested_levels: List[String], authority_kind: u8, cleanup_ms: u64, mut workspace: history.HistoryBuffers, prepare_writer: scoped fn(StoreId, pager.JournalReplay) -> Result[T, Error]) -> (history.ObjectPackRead, Result[(history.HistoryRegister, pager.JournalReplay, T, Bytes), Error]) waits {
    let mut read_source = take input
    let initial = stream_claim_side(link, authority_kind, holder)
    let mut side = match take initial {
        Ok(take ready) => take ready,
        Error(take problem) => return (take read_source, Error(take problem)),
    }
    let mut opening: Options = clone(options)
    loop {
        let deadline = read_source.deadline
        if std.object.deadline_after_ms(read_source.client, 0) >= deadline {
            return (take read_source, Error(Lost))
        }
        let prepared = stream_claim_prepare(mut read_source, mut link, mut side, holder, mut opening, requested_levels, authority_kind, mut workspace, prepare_writer)
        match take prepared {
            Ok(ClaimReady(take request)) => {
                let (take restored, take reusable, take outcome) = stream_claim_live_attempt(take read_source, take side, take request, r, holder, options, cleanup_ms, mut link, mut workspace, prepare_writer)
                read_source = take restored
                side = take reusable
                match take outcome {
                    Ok(Some(take done)) => return (take read_source, Ok(take done)),
                    Ok(None) => (),
                    Error(take problem) => return (take read_source, Error(take problem)),
                }
            },
            Ok(ClaimFinished(take done)) => return (take read_source, Ok(take done)),
            Ok(ClaimTryAgain) => (),
            Error(take problem) => return (take read_source, Error(take problem)),
        }
        if let Error(take problem) = failure_result_from_rep(history.history_fetch(mut read_source.client, "head", mut workspace.witness, deadline)) {
            return (take read_source, Error(take problem))
        }
    }
}

fn stream_claim_side(link: host_stream.SlotLink, authority_kind: u8, holder: StoreId) -> Result[host_stream.ClaimStream, Error] {
    let mut lane = failure_result_from_rep(host_stream.stream_lane(host_stream.slot_sid(link), authority_kind, host_stream.slot_max_rows(link), store_key_to_rep(holder)))?
    lane.dir = host_stream.stream_key(host_stream.slot_root(link), host_stream.stream_dir(host_stream.slot_sid(link)))
    Ok(host_stream.ClaimStream(lane: take lane, buffers: failure_result_from_rep(host_stream.stream_tail_buffers())?, granted: None))
}

// Reads one sealed tail in history order (§12.11.9): discovers its epoch from
// X's unique row in `st.cutoff` (Fable §3 guarantees it exists), then applies
// X's slices in `[st.tail.from_seq, st.cutoff]` at that epoch. Returns `false`
// if a 404 resolved to a moved head (restart attempt).
fn stream_apply_sealed_tail(mut client: std.object.Client, mut buffers: host_stream.TailBuffers, root: String, place_prefix: String, head_witness: Bytes, authority_kind: u8, st: format.SealedTail, store: StoreId, mut replay: pager.JournalReplay, ceiling: u64, deadline: u64) -> Result[bool, Error] waits {
    let dir = host_stream.stream_key(root, host_stream.stream_dir(host_stream_id_to_rep(host_stream_id_from_rep(st.tail.sid))))
    let mut seal_lane = failure_result_from_rep(host_stream.stream_lane(host_stream_id_to_rep(host_stream_id_from_rep(st.tail.sid)), authority_kind, 2, store_key_to_rep(store)))?
    seal_lane.dir = string.from(dir)
    let mut cut_name = string.with_capacity(48)
    format.stream_batch_key(mut cut_name, st.tail.inc, st.cutoff)
    let cut_key = host_stream.stream_key(dir, cut_name)
    let tail_epoch_opt = host_stream.stream_at_root(mut client, scoped fn(mut c: std.object.Client) -> Result[Option[u64], Error] waits {
        if let None = failure_result_from_rep(host_stream.stream_tail_range(mut c, cut_key, 0, format.STREAM_INDEX_PROBE, mut buffers.index, deadline))? {
            if let Some(outcome) = failure_result_from_rep(host_stream.stream_resolve_404(mut c, mut seal_lane, mut buffers, place_prefix, head_witness, cut_key, st.tail.inc, st.cutoff, true, false, deadline))? {
                return match outcome {
                    TailHeadMoved => Ok(None),
                    _ => Error(failure_from_rep(format.disk_fault(cut_key, 0, Absent))),
                }
            }
        }
        let mut batch_index = match failure_result_from_rep(manifest.stream_batch_head(cut_key, buffers.index, host_stream_id_to_rep(host_stream_id_from_rep(st.tail.sid)), st.tail.inc, st.cutoff))? {
            Rows(take found) => take found,
            Term(_, _) => return Error(failure_from_rep(format.disk_fault(cut_key, 72, Malformed))),
        }
        if list.len(buffers.index) < batch_index.byte_len {
            if let None = failure_result_from_rep(host_stream.stream_tail_range(mut c, cut_key, 0, batch_index.byte_len, mut buffers.index, deadline))? {
                return Error(failure_from_rep(format.disk_fault(cut_key, 0, Absent)))
            }
            batch_index = match failure_result_from_rep(manifest.stream_batch_head(cut_key, buffers.index, host_stream_id_to_rep(host_stream_id_from_rep(st.tail.sid)), st.tail.inc, st.cutoff))? {
                Rows(take found) => take found,
                Term(_, _) => return Error(failure_from_rep(format.disk_fault(cut_key, 72, Malformed))),
            }
        }
        for row in batch_index.rows {
            if types.same(row.store.hi, row.store.lo, store.hi, store.lo) {
                if st.cutoff == st.tail.from_seq && row.frames <= int.widen(st.tail.from_frame) {
                    return Error(failure_from_rep(format.disk_fault(cut_key, 0, Malformed)))
                }
                return Ok(Some(row.epoch))
            }
        }
        Error(failure_from_rep(format.disk_fault(cut_key, 0, Malformed)))
    })?
    let Some(tail_epoch) = tail_epoch_opt else {
        return Ok(false)
    }
    let mut seq = st.tail.from_seq
    while seq <= st.cutoff {
        let skip: u64 = if seq == st.tail.from_seq {
            int.widen(st.tail.from_frame)
        } else {
            0
        }
        let ok = host_stream.stream_at_root(mut client, scoped fn(mut c: std.object.Client) -> Result[bool, Error] waits {
            match stream_tail_batch(mut c, mut seal_lane, mut buffers, place_prefix, head_witness, host_stream_id_from_rep(st.tail.sid), st.tail.inc, seq, store, tail_epoch, skip, 18446744073709551615u64, true, false, mut replay, ceiling, deadline)? {
                TailRead(_) => Ok(true),
                TailHeadMoved => Ok(false),
                TailAbsent => Error(failure_from_rep(format.disk_fault(cut_key, 0, Absent))),
                TailSkipTo(_) => Error(failure_from_rep(format.disk_fault(cut_key, 0, Absent))),
                TailBeyond => Error(failure_from_rep(format.disk_fault(cut_key, 0, Malformed))),
                TailTerm => Error(failure_from_rep(format.disk_fault(cut_key, 72, Malformed))),
            }
        })?
        if !ok {
            return Ok(false)
        }
        seq += 1
    }
    Ok(true)
}

// Loads the settled part in exact §12.11.9 history order: checkpoint c, then
// entries interleaved with `attach.sealed` at each `st.at`, then the entries
// past the last sealed tail through `head.entry.seq`. Returns `None` if a
// sealed-tail 404 observed a moved head.
fn stream_load_settled(mut read_source: history.ObjectPackRead, head: history.HistoryHead, attach: format.Attach, root: String, place_prefix: String, head_witness: Bytes, authority_kind: u8, mut buffers: host_stream.TailBuffers, ceiling: u64) -> Result[Option[pager.JournalReplay], Error] waits {
    if list.len(attach.sealed) == 0 {
        return Ok(Some(history_load_admitted(mut read_source, head, ceiling)?))
    }
    let deadline = read_source.deadline
    let chain = failure_result_from_rep(history.history_suffix(mut read_source.client, head, head.checkpoint, deadline))?
    let (take mark, take checkpoint_data) = failure_result_from_rep(history.history_checkpoint(mut read_source.client, head, deadline))?
    let page_record = failure_result_from_rep(history.history_read_manifest(mut read_source.client, head.store, mark, head.checkpoint.seq, deadline))?
    let (take replay, take checkpoint_state) = failure_result_from_rep(object_writer.history_open_checkpoint(mut read_source, head, mark, checkpoint_data, take page_record, ceiling))?
    let owners = disk_allocation(scoped fn() -> Result[Map[manifest.IncomingEdge, u64], Error] {
        Ok(manifest.located_owners(checkpoint_state.manifest))
    })?
    let manifest.LoadedPageStore(manifest: take loaded_manifest, lists: take lists, locations: take locations, ..) = take checkpoint_state
    let pages = manifest.recovered_pack_disk(loaded_manifest, take locations, take lists, take owners, list.new())
    read_source.admitted_base = Some(history.recovered_open_base(loaded_manifest, take pages))
    let mut recovered = take replay
    let base_seq = head.checkpoint.seq
    let mut done_seq = base_seq
    for st in attach.sealed {
        if st.at < done_seq || st.at > head.entry.seq {
            return Error(failure_from_rep(format.disk_fault("head", 72, Malformed)))
        }
        if st.at > done_seq {
            let lo = done_seq - base_seq
            let hi = st.at - base_seq
            let part = list.slice(chain, lo, hi)
            history_apply_suffix(mut read_source.client, head, done_seq, part, mut recovered, ceiling, deadline)?
            done_seq = st.at
        }
        if !stream_apply_sealed_tail(mut read_source.client, mut buffers, root, place_prefix, head_witness, authority_kind, st, store_key_from_rep(head.store), mut recovered, ceiling, deadline)? {
            return Ok(None)
        }
    }
    if head.entry.seq > done_seq {
        let lo = done_seq - base_seq
        let hi = head.entry.seq - base_seq
        let rest = list.slice(chain, lo, hi)
        history_apply_suffix(mut read_source.client, head, done_seq, rest, mut recovered, ceiling, deadline)?
    }
    Ok(Some(take recovered))
}

type LiveClaimInput {
    head: history.HistoryHead,
    attach: format.Attach,
    tail: format.StreamRef,
    auth: ClaimAuth,
    cursor: host_stream.TailScan,
    replay: pager.JournalReplay,
    place_prefix: String,
    no_hold: bool,
    next_slot: format.StreamRef
}

type StreamClaimPreflight[T] = ClaimTryAgain | ClaimFinished((history.HistoryRegister, pager.JournalReplay, T, Bytes)) | ClaimReady(LiveClaimInput)

// Authorize and recover the settled and live prefixes before issuing any Hold.
fn stream_claim_prepare[T](mut read_source: history.ObjectPackRead, mut link: host_stream.SlotLink, mut side: host_stream.ClaimStream, holder: StoreId, mut options: Options, requested_levels: List[String], authority_kind: u8, mut workspace: history.HistoryBuffers, prepare_writer: scoped fn(StoreId, pager.JournalReplay) -> Result[T, Error]) -> Result[StreamClaimPreflight[T], Error] waits {
    let deadline = read_source.deadline
    let (take capture, take attached) = failure_result_from_rep(history.history_decode_head_attach(workspace.witness))?
    let auth = history_check_open(read_source.client, capture, requested_levels, authority_kind, options)?
    options.claim_auth = Some(clone(auth))
    let Some(take attach) = take attached else {
        // A standalone head opened streamed: §12.3's claim writing ATTACH.
        return Error(Exists("head"))
    }
    let Some(tail) = attach.live else {
        // Direct service (§12.11.5): no live tail to hold; recover in history
        // order, write H copying ATTACH (`live = None`), and write CLAIM as an
        // entry. The forced open-time cut in `open_object_writer` consumes
        // `sealed` and resumes streaming when admitted.
        let head = capture.head
        let store = head.store
        let epoch = head.pair.epoch
        let place_prefix = std.object.bucket_config(read_source.client).prefix
        let Some(take loaded_settled) = stream_load_settled(mut read_source, head, attach, host_stream.slot_root(link), place_prefix, workspace.witness, authority_kind, mut side.buffers, options.resident_limit)? else {
            return Ok(ClaimTryAgain)
        }
        let replay = take loaded_settled
        failure_result_from_rep(types.check_limits(optional_limits_to_rep(options.limits), replay.limits))?
        if let None = side.granted {
            let grant = failure_result_from_rep(host_stream.slot_attach(mut link, store, epoch + 1, place_prefix, replay.limits))?
            side.granted = Some(grant)
        }
        let Some((take admitted, tag)) = stream_claim_final_head(mut read_source.client, deadline, store_key_from_rep(store), replay, mut workspace, prepare_writer)? else {
            return Ok(ClaimTryAgain)
        }
        let claimed = history_claim_head(head, holder, auth)?
        let authority_end = failure_result_from_rep(history.history_authority_end(workspace.witness))?
        let authority = failure_result_from_rep(types.copied(list.slice(workspace.witness, 240, authority_end)))?
        let prepared = failure_result_from_rep(history.prepare_register_head(mut workspace.body, claimed, authority, Some(take attach)))?
        let written = history.write_prepared_register(mut read_source.client, Match(tag), take prepared, mut workspace.body, mut workspace.witness, deadline)
        let mut reg = match take written {
            RegisterClaimApplied(take opened) => take opened,
            RegisterClaimConflict => {
                let (take moved, _) = failure_result_from_rep(history.history_decode_head_attach(workspace.witness))?
                if !history.history_pair_matches(moved.head.pair, head.pair) {
                    return Error(history_superseded_by(read_source.client, store_key_from_rep(store), workspace.witness))
                }
                return Ok(ClaimTryAgain)
            },
            RegisterClaimRefused(take problem) => return Error(Remote(take problem)),
            RegisterClaimUndecided => return Error(Undecided),
        }
        failure_result_from_rep(host_stream.history_advance_claim(mut read_source.client, mut reg, authority, mut workspace, deadline))?
        return Ok(ClaimFinished((take reg, take replay, take admitted, take authority)))
    }
    if !format.stream_same(side.lane.sid, tail.sid) {
        let mut next_lane = failure_result_from_rep(host_stream.stream_lane(host_stream_id_to_rep(host_stream_id_from_rep(tail.sid)), authority_kind, host_stream.slot_max_rows(link), store_key_to_rep(holder)))?
        next_lane.dir = host_stream.stream_key(host_stream.slot_root(link), host_stream.stream_dir(host_stream_id_to_rep(host_stream_id_from_rep(tail.sid))))
        side.lane = take next_lane
    }
    let head = capture.head
    let store = head.store
    let epoch = head.pair.epoch
    let place_prefix = std.object.bucket_config(read_source.client).prefix
    // Step 2: the settled part in history order, then the pre-scan of the live
    // tail, both admitted before the hold.
    let Some(take loaded_settled) = stream_load_settled(mut read_source, head, attach, host_stream.slot_root(link), place_prefix, workspace.witness, authority_kind, mut side.buffers, options.resident_limit)? else {
        return Ok(ClaimTryAgain)
    }
    let mut replay = take loaded_settled
    failure_result_from_rep(types.check_limits(optional_limits_to_rep(options.limits), replay.limits))?
    let mut cursor = host_stream.TailScan(next: tail.from_seq, last_x: None)
    let ceiling = options.resident_limit
    let mut no_hold = false
    let step2_ok = host_stream.stream_at_root(mut read_source.client, scoped fn(mut c: std.object.Client) -> Result[bool, Error] waits {
        failure_result_from_rep(host_stream.stream_reg_read(mut side.lane, mut c, deadline))?
        if side.lane.reg.inc < tail.inc {
            return Error(failure_from_rep(format.disk_fault("reg", 0, Regressed)))
        }
        if side.lane.reg.inc > tail.inc {
            no_hold = true
            return stream_no_hold_scan(mut c, mut side.lane, mut side.buffers, place_prefix, workspace.witness, tail, store_key_from_rep(store), epoch, authority_kind, mut cursor, mut replay, ceiling, deadline)
        }
        if side.lane.reg.collecting {
            return Error(failure_from_rep(format.disk_fault("reg", 0, Malformed)))
        }
        if !stream_tail_prescan_xindex(mut c, mut side.lane, mut side.buffers, place_prefix, workspace.witness, tail, store_key_from_rep(store), epoch, mut cursor, mut replay, ceiling, deadline)? {
            return Ok(false)
        }
        match stream_tail_scan(mut c, mut side.lane, mut side.buffers, place_prefix, workspace.witness, tail, store_key_from_rep(store), epoch, mut cursor, 18446744073709551615u64, mut replay, ceiling, deadline)? {
            StopHeadMoved => Ok(false),
            _ => Ok(true),
        }
    })?
    if !step2_ok {
        return Ok(ClaimTryAgain)
    }
    let (inc_b, next_b) = match side.granted {
        Some(grant) => grant,
        None => {
            let grant = failure_result_from_rep(host_stream.slot_attach(mut link, store, epoch + 1, place_prefix, replay.limits))?
            side.granted = Some(grant)
            grant
        },
    }
    let next_slot = format.StreamRef(sid: host_stream.slot_sid(link), inc: inc_b, from_seq: next_b, from_frame: 0)
    Ok(ClaimReady(LiveClaimInput(head, attach: take attach, tail, auth: take auth, cursor, replay: take replay, place_prefix: string.from(place_prefix), no_hold, next_slot)))
}

fn stream_claim_live_attempt[T](take input: history.ObjectPackRead, take side: host_stream.ClaimStream, take request: LiveClaimInput, r: Random, holder: StoreId, options: Options, cleanup_ms: u64, mut link: host_stream.SlotLink, mut work: history.HistoryBuffers, prepare_writer: scoped fn(StoreId, pager.JournalReplay) -> Result[T, Error]) -> (history.ObjectPackRead, host_stream.ClaimStream, Result[Option[(history.HistoryRegister, pager.JournalReplay, T, Bytes)], Error]) waits {
    let LiveClaimInput(head, attach: take attach, tail, auth: take auth, cursor, replay: take replay, place_prefix: take place_prefix, no_hold, next_slot) = take request
    let minted: Result[types.StoreKey, types.Failure] = if no_hold {
        Ok(types.StoreKey(hi: 0, lo: 0))
    } else {
        types.capacity(types.disk_identity(r))
    }
    let token = match take minted {
        Ok(id) => id,
        Error(take problem) => return (take input, take side, Error(failure_from_rep(take problem))),
    }
    let history.ObjectPackRead(authority_kind, client: take transport, locator: take locator, deadline, admitted_base: take base, stream_root: take stream_root, cache) = take input
    let (take client, take reused, take step) = host_stream.stream_claim_live(take transport, take side, head.store, head.pair.epoch, tail.inc, no_hold, token, cleanup_ms, deadline, take replay, mut link, mut work, scoped fn(mut c: std.object.Client, mut lane: host_stream.StreamLane, mut buffers: host_stream.TailBuffers, rev_hold: Option[u64], mut replayed: pager.JournalReplay, mut buffers_h: history.HistoryBuffers) -> Result[Option[(std.object.ETag, history.HistoryHead, Option[format.StreamRef], history.PreparedRegisterHead, Bytes, T)], types.Failure] waits {
        let mut tail_scan = cursor
        let delta_ok = host_stream.stream_at_root(mut c, scoped fn(mut stream_client: std.object.Client) -> Result[bool, Error] waits {
            match rev_hold {
                Some(rev) => match stream_tail_scan(mut stream_client, mut lane, mut buffers, place_prefix, buffers_h.witness, tail, store_key_from_rep(head.store), head.pair.epoch, mut tail_scan, rev, mut replayed, options.resident_limit, deadline)? {
                    StopHeadMoved => Ok(false),
                    _ => Ok(true),
                },
                None if no_hold => Ok(true),
                None => stream_no_hold_scan(mut stream_client, mut lane, mut buffers, place_prefix, buffers_h.witness, tail, store_key_from_rep(head.store), head.pair.epoch, authority_kind, mut tail_scan, mut replayed, options.resident_limit, deadline),
            }
        }) ?=> |problem| failure_to_rep(take problem)
        if !delta_ok {
            return Ok(None)
        }
        let final_read = stream_claim_final_head(mut c, deadline, store_key_from_rep(head.store), replayed, mut buffers_h, prepare_writer) ?=> |problem| failure_to_rep(take problem)
        let Some((take admitted, tag)) = take final_read else {
            return Ok(None)
        }
        let (claimed, next_live, take prepared, take authority) = stream_claim_candidate(head, attach, tail, tail_scan, next_slot, holder, auth, mut buffers_h) ?=> |problem| failure_to_rep(take problem)
        Ok(Some((tag, claimed, next_live, take prepared, take authority, take admitted)))
    })
    let outcome: Result[Option[(history.HistoryRegister, pager.JournalReplay, T, Bytes)], Error] = match take step {
        ClaimDone(take register, take opened, take admitted, take authority) => Ok(Some((take register, take opened, take admitted, take authority))),
        ClaimFailed(take problem) => Error(failure_from_rep(take problem)),
        ClaimRestart => Ok(None),
        ClaimConflict => stream_claim_conflict(client, head, work.witness),
    }
    let restored = history.ObjectPackRead(authority_kind, client: take client, locator: take locator, deadline, admitted_base: take base, stream_root: take stream_root, cache)
    (take restored, take reused, take outcome)
}

fn stream_claim_conflict[T](client: std.object.Client, head: history.HistoryHead, witness: Bytes) -> Result[Option[T], Error] {
    let (take moved, _) = failure_result_from_rep(history.history_decode_head_attach(witness))?
    if !history.history_pair_matches(moved.head.pair, head.pair) {
        return Error(history_superseded_by(client, store_key_from_rep(head.store), witness))
    }
    Ok(None)
}

// Step 5: prepares the writer state and re-reads `head`; exact step 1 bytes go
// on with its tag, another pair returns `Lost`, and a same-pair move restarts.
fn stream_claim_final_head[T](mut client: std.object.Client, deadline: u64, store: StoreId, replay: pager.JournalReplay, mut workspace: history.HistoryBuffers, prepare_writer: scoped fn(StoreId, pager.JournalReplay) -> Result[T, Error]) -> Result[Option[(T, std.object.ETag)], Error] waits {
    let admitted = prepare_writer(store, replay)?
    let tag = match history.history_fetch_head(mut client, mut workspace.compare, deadline) {
        Ok(found) => found,
        Error(take problem) => return Error(Remote(take problem)),
    }
    if workspace.compare == workspace.witness {
        return Ok(Some((take admitted, tag)))
    }
    let (take first, _) = failure_result_from_rep(history.history_decode_head_attach(workspace.witness))?
    let (take moved, _) = failure_result_from_rep(history.history_decode_head_attach(workspace.compare))?
    if !history.history_pair_matches(moved.head.pair, first.head.pair) {
        return Error(history_superseded_by(client, store, workspace.compare))
    }
    Ok(None)
}

// Step 6's candidate: `old.sealed` copied with the incumbent's tail appended
// only when non-empty (Fable §3), the claimed head with its ORIGIN, and H's
// bytes in `workspace.body`. Writes nothing.
fn stream_claim_candidate(head: history.HistoryHead, attach: format.Attach, tail: format.StreamRef, cursor: host_stream.TailScan, next_slot: format.StreamRef, holder: StoreId, auth: ClaimAuth, mut workspace: history.HistoryBuffers) -> Result[(history.HistoryHead, Option[format.StreamRef], history.PreparedRegisterHead, Bytes), Error] {
    let mut sealed: List[format.SealedTail] = disk_allocation(scoped fn() -> Result[List[format.SealedTail], Error] {
        let mut out: List[format.SealedTail] = list.with_capacity(list.len(attach.sealed) + 1)
        for st in attach.sealed {
            list.push(mut out, st)
        }
        Ok(take out)
    })?
    if let Some(k) = cursor.last_x {
        list.push(mut sealed, format.SealedTail(tail, cutoff: k, at: head.entry.seq))
    }
    let next_live: Option[format.StreamRef] = if list.len(sealed) >= format.ATTACH_SEALED_MAX {
        None
    } else {
        Some(next_slot)
    }
    let attach_next = format.Attach(settles: attach.settles, live: next_live, sealed: take sealed)
    let claimed = history_claim_head(head, holder, auth)?
    let authority_end = failure_result_from_rep(history.history_authority_end(workspace.witness))?
    let authority = failure_result_from_rep(types.copied(list.slice(workspace.witness, 240, authority_end)))?
    let prepared = failure_result_from_rep(history.prepare_register_head(mut workspace.body, claimed, authority, Some(take attach_next)))?
    Ok((claimed, next_live, take prepared, take authority))
}

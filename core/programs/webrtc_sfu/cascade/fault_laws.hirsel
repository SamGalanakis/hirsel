// SFU cascade KS4 laws: K5 (`stale_term_ignored`) and K6 (`link_loss_recovers`).
const K6_HOME_ADDR: Addr = Addr(ip: V4(0x0a070001), port: 4560)

const K6_EDGE_A_ADDR: Addr = Addr(ip: V4(0x0a070002), port: 4561)

const K6_EDGE_A2_ADDR: Addr = Addr(ip: V4(0x0a070003), port: 4562)

// ---- K5: stale_term_ignored ----
/// bug: an edge that has seen a higher term still accepts a fence-free subscribe,
/// wanted mask, media datagram, or lease grant from an old home in a lower term.
/// oracle: docs/spec/sfu_cascade.md K5 and CAS-1: every message carrying `term < room.term`
/// is refused and counted stale, and an old home's `LeaseGrant` extends no lease.
@test
fn stale_term_ignored() -> Result[(), ()] {
    let lim = cascade.default_link_limits()
    let edge_id = cascade.node_id(b"edge-k5")
    let (_, clock) = std.sim.world.new(505, 0, 0)
    let (take k, take c) = result.unwrap(signal.unit_certificate(provide.random(511), clock))
    let mut hub = result.unwrap(cascade.link_hub(edge_id, provide.random(512), lim, rebuild_id(take k, take c), list.new(), 4))
    let mut n = new_knode(513, edge_id, lim)
    knode_open_room(mut n, mut hub, K_ROOM, k_room_limits(), 0)
    let h_old: quic.ConnectionHandle = ConnectionHandle(0)
    // Open room at term 1, then advance to term 2 (edge learned new term from directory/new home).
    result.unwrap(cascade.open_home_room(mut n.a, K_ROOM, b"room-k5", 1, k_room_limits()))
    cascade.enable_leases(mut n.a, b"room-k5", 1000, list.new())
    knode_pump(mut n, mut hub, 0)
    cascade.advance_room_term(mut n.a, mut hub, b"room-k5", 2, 100 * MS)
    knode_pump(mut n, mut hub, 100 * MS)
    // After advancing to term 2, old term's lease ended (deadline 0, suspended with Term).
    if cascade.room_lease_deadline(n.a, b"room-k5") != Some(0) || !cascade.room_lease_suspended(n.a, b"room-k5") {
        fail("advancing to term 2 did not end old term's lease")
    }
    // Old home (still in term 1) sends a fence-free Attach, WantedMask, media, and LeaseGrant(term: 1).
    let mut evs: List[cascade.LinkEvent] = list.new()
    list.push(mut evs, ControlIn(handle: h_old, msg: Attach(room_num: 1, term: 1, seq: 1, room_name: b"room-k5")))
    list.push(mut evs, ControlIn(handle: h_old, msg: LeaseGrant(room_num: 1, term: 1, seq: 1, remaining_ms: 2000)))
    list.push(mut evs, RoomIn(handle: h_old, room_num: 1, msg: WantedMask(room_num: 1, term: 1, seq: 1, participant: 1, epoch: 1, pub_slot: 1, mask: 7)))
    let stale_layer = cascade.LayerInfo(room_num: 1, term: 1, layer_num: 1, participant: 1, epoch: 1, kind: Vp8, rid: b"\x00\x00\x00\x01\x00\x01q")
    list.push(mut evs, MediaIn(handle: h_old, room_num: 1, layer_num: 1, layer: take stale_layer, rtp: cascade.canon_slice(make_canon_rtp(Vp8, 1, 90000, 0x111, 64))))
    knode_step(mut n, mut hub, take evs, 500 * MS)
    if cascade.attach_refusal_count(n.a) == 0 {
        fail("stale term 1 Attach was not refused")
    }
    if cascade.room_lease_deadline(n.a, b"room-k5") != Some(0) {
        fail("old home's term 1 LeaseGrant extended the edge's lease in term 2")
    }
    if list.len(knode_take_delivered(mut n)) != 0 {
        fail("old home's term 1 media was delivered in term 2")
    }
    if !cascade.room_lease_suspended(n.a, b"room-k5") {
        fail("old home's term 1 grant cleared term 2 suspension")
    }
    // CAS-7 new-term reattach: while suspended in term 2, a FenceTable(term 2) must be applied
    // locally before FenceTableAck is emitted, and media remains blocked until term 2's grant.
    let mut ft_evs: List[cascade.LinkEvent] = list.new()
    let mut t2_fences: List[(u64, u64)] = list.new()
    list.push(mut t2_fences, (99, 1))
    list.push(mut ft_evs, ControlIn(handle: h_old, msg: FenceTable(room_num: 1, term: 2, seq: 1, fences: take t2_fences)))
    cascade.handle_events(mut n.a, mut hub, take ft_evs, 600)
    // Before `knode_pump` applies Revoke(99, 1), FenceTableAck must NOT have been emitted.
    let pre_trace = cascade.take_fence_trace(mut n.a)
    for tr in pre_trace {
        if tr.kind == TraceFenceTableAck {
            fail("term 2 FenceTableAck was emitted before local Revoke held")
        }
    }
    knode_pump(mut n, mut hub, 600 * MS)
    if cascade.room_lease_deadline(n.a, b"room-k5") != Some(0) || cascade.lease_allows_media(n.a, b"room-k5", 600) {
        fail("term 2 media allowed before LeaseGrant")
    }
    Ok(())
}

// ---- K6: link_loss_recovers ----
type K6HomePlan: send {
    clock: Clock,
    socket: UdpSocket,
    vnet: Net,
    node_id: cascade.NodeId,
    key: Secret,
    cert: Bytes,
    pins: List[cascade.PeerPins]
}

type K6HomeOut: send {
    reattach_order_ok: bool,
    fence_r1_acked_after_flood: bool,
    malformed_detached_room2_only: bool
}

type K6EdgeOut: send {
    suspended_during_cut: bool,
    reattach_order_ok: bool,
    fenced_p_dropped: bool,
    resumed_q_delivered: u64,
    room1_still_alive: bool
}

fn check_reattach_order(trace: List[cascade.FenceTrace], rn: u32) -> bool {
    let mut seen_ft = false
    let mut seen_ft_ack = false
    let mut seen_grant = false
    for tr in trace {
        if tr.room_num != rn {
            continue
        }
        match tr.kind {
            TraceFenceTable => {
                if seen_ft_ack || seen_grant {
                    return false
                }
                seen_ft = true
            },
            TraceFenceTableAck => {
                if !seen_ft || seen_grant {
                    return false
                }
                seen_ft_ack = true
            },
            TraceLeaseGrant => {
                if !seen_ft || !seen_ft_ack {
                    return false
                }
                seen_grant = true
            },
            _ => (),
        }
    }
    seen_ft && seen_ft_ack && seen_grant
}

fn k6_home_task(take cfg: K6HomePlan) -> K6HomeOut waits {
    let K6HomePlan(clock: clock, socket: take given, vnet: vnet, node_id: nid, key: take k, cert: take c, pins: take pins) = take cfg
    let mut sock = take given
    let lim = cascade.default_link_limits()
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(6001), lim, rebuild_id(take k, take c), take pins, 8))
    let mut n = new_knode(6011, nid, lim)
    let r1: peer.RoomId = RoomId(1)
    let r2: peer.RoomId = RoomId(2)
    knode_open_room(mut n, mut hub, r1, k_room_limits(), 0)
    knode_open_room(mut n, mut hub, r2, k_room_limits(), 0)
    let mut dir = cascade.sim_directory(clock, lim.drift_ppm)
    let _ = result.unwrap(cascade.claim(mut dir, b"room-k6-1", nid, 0))
    let _ = result.unwrap(cascade.claim(mut dir, b"room-k6-2", nid, 0))
    result.unwrap(cascade.open_home_room(mut n.a, r1, b"room-k6-1", 1, k_room_limits()))
    result.unwrap(cascade.open_home_room(mut n.a, r2, b"room-k6-2", 1, k_room_limits()))
    cascade.enable_leases(mut n.a, b"room-k6-1", 30000, list.new())
    cascade.enable_leases(mut n.a, b"room-k6-2", 30000, list.new())
    let owner_p: peer.Gen = Gen(id: 10, epoch: 1)
    let owner_q: peer.Gen = Gen(id: 20, epoch: 1)
    let pid_p = knode_publish_synthetic(mut n, mut hub, r1, owner_p, 0, PublicationId(1), Vp8, 1, 0)
    let pid_q = knode_publish_synthetic(mut n, mut hub, r1, owner_q, 0, PublicationId(2), Vp8, 1, 0)
    knode_pump(mut n, mut hub, 0)
    let mut cut_done = false
    let mut revoked_p = false
    let mut restored = false
    let mut sent_post_flood_fence = false
    let mut fseq2 = 0u64
    let mut fence_r1_acked = false
    let mut malformed_room2 = false
    let mut all_trace: List[cascade.FenceTrace] = list.new()
    let mut seq = 1u16
    let mut next_media = 6400 * MS
    let mut events: List[cascade.LinkEvent] = list.new()
    let end = 7500 * MS
    while host.mono_ns(clock) < end {
        let now = host.mono_ns(clock)
        result.unwrap(cascade.drive_links(mut hub, clock, mut sock, order.min(now + 15 * MS, end), mut events))
        let cur = host.mono_ns(clock)
        let ms = cur / MS
        knode_step(mut n, mut hub, take events, cur)
        events = list.new()
        for tr in cascade.take_fence_trace(mut n.a) {
            list.push(mut all_trace, tr)
        }
        for rn in cascade.take_detached_malformed(mut n.a) {
            if rn == 2 {
                malformed_room2 = true
            }
        }
        // Cut link to Edge A at t = 600 ms for 5 seconds (600..5600 ms).
        if !cut_done && ms >= 600 {
            result.unwrap(std.sim.udp.link(vnet, K6_HOME_ADDR.ip, K6_EDGE_A_ADDR.ip, Cut))
            result.unwrap(std.sim.udp.link(vnet, K6_EDGE_A_ADDR.ip, K6_HOME_ADDR.ip, Cut))
            cut_done = true
        }
        // During the 5 s cut, revoke participant 10 (fenced in directory & home).
        if cut_done && !revoked_p && ms >= 1200 {
            let _ = result.unwrap(cascade.begin_revoke(mut n.a, mut hub, mut dir, b"room-k6-1", 10, 1, ms))
            knode_pump(mut n, mut hub, cur)
            revoked_p = true
        }
        // Restore link after 5 s cut at t = 5600 ms.
        if cut_done && !restored && ms >= 5600 {
            result.unwrap(std.sim.udp.restore(vnet, K6_HOME_ADDR.ip, K6_EDGE_A_ADDR.ip))
            result.unwrap(std.sim.udp.restore(vnet, K6_EDGE_A_ADDR.ip, K6_HOME_ADDR.ip))
            list.clear(mut all_trace)
            restored = true
        }
        // After reattach (~6400 ms), send Q's media (should resume on A) and P's (should be dropped).
        let cur2 = host.mono_ns(clock)
        if restored && cur2 >= next_media && cur2 < 6900 * MS {
            let sq: u32 = int.widen(seq)
            knode_inject_media(mut n, mut hub, r1, pid_p, owner_p, 0, make_canon_rtp(Vp8, seq, sq * 3000u32, 0x10, 64), cur2)
            knode_inject_media(mut n, mut hub, r1, pid_q, owner_q, 0, make_canon_rtp(Vp8, seq, sq * 3000u32, 0x20, 64), cur2)
            seq += 1
            next_media = cur2 + 40 * MS
        }
        // At t = 7000 ms (right after Edge A floods room 2 with malformed bytes), revoke participant 30
        // on room 1 over urgency-0 link control stream — must still be acked!
        if restored && !sent_post_flood_fence && ms >= 7000 {
            fseq2 = result.unwrap(cascade.begin_revoke(mut n.a, mut hub, mut dir, b"room-k6-1", 30, 1, ms))
            knode_pump(mut n, mut hub, cur2)
            sent_post_flood_fence = true
        }
        if sent_post_flood_fence && !fence_r1_acked {
            if cascade.poll_revoke(mut n.a, mut hub, b"room-k6-1", fseq2, ms) {
                fence_r1_acked = true
            }
        }
    }
    let order_ok = check_reattach_order(all_trace, 1)
    K6HomeOut(reattach_order_ok: order_ok, fence_r1_acked_after_flood: fence_r1_acked, malformed_detached_room2_only: malformed_room2)
}

type K6EdgePlan: send {
    clock: Clock,
    sock1: UdpSocket,
    sock2: UdpSocket,
    node_id: cascade.NodeId,
    key: Secret,
    cert: Bytes,
    home_id: cascade.NodeId,
    home_addr: Addr,
    home_pin: quic.handshake.Pin
}

fn k6_edge_task(take cfg: K6EdgePlan) -> K6EdgeOut waits {
    let K6EdgePlan(clock: clock, sock1: take s1_in, sock2: take s2_in, node_id: nid, key: take k, cert: take c, home_id: hid, home_addr: haddr, home_pin: hpin) = take cfg
    let mut sock1 = take s1_in
    let mut sock2 = take s2_in
    let lim = cascade.default_link_limits()
    let id1 = rebuild_id(secret.share(k), clone(c))
    let id2 = rebuild_id(secret.share(k), clone(c))
    let mut hub1 = result.unwrap(cascade.link_hub(nid, provide.random(6002), lim, take id1, node_pins(hid, clone(hpin)), 4))
    let mut n = new_knode(6012, nid, lim)
    let r1: peer.RoomId = RoomId(1)
    let r2: peer.RoomId = RoomId(2)
    knode_open_room(mut n, mut hub1, r1, k_room_limits(), 0)
    knode_open_room(mut n, mut hub1, r2, k_room_limits(), 0)
    let h1 = result.unwrap(cascade.dial_addr(mut hub1, hid, haddr, single_pin(clone(hpin)), 0, take id2))
    let mut attached1 = false
    let mut subbed_q = false
    let mut suspended_cut = false
    let mut reconnected = false
    let mut h2_opt: Option[quic.ConnectionHandle] = None
    let mut hub2_opt: Option[cascade.LinkHub] = None
    let mut reattached = false
    let mut flooded_r2 = false
    let mut resumed_q = 0u64
    let mut reattach_trace: List[cascade.FenceTrace] = list.new()
    let pub_p = cascade.PubKey(participant: 10, epoch: 1, pub_slot: 1)
    let pub_q = cascade.PubKey(participant: 20, epoch: 1, pub_slot: 2)
    let mut events: List[cascade.LinkEvent] = list.new()
    let end = 7500 * MS
    while host.mono_ns(clock) < end {
        let now = host.mono_ns(clock)
        let ms = now / MS
        if !reconnected {
            result.unwrap(cascade.drive_links(mut hub1, clock, mut sock1, order.min(now + 15 * MS, end), mut events))
            let mut got_up = false
            for ev in events {
                if let LinkUp(handle: h, ..) = ev {
                    if h == h1 {
                        got_up = true
                    }
                }
            }
            let cur = host.mono_ns(clock)
            knode_step(mut n, mut hub1, take events, cur)
            events = list.new()
            if got_up && !attached1 {
                let _ = result.unwrap(cascade.attach_edge_room(mut n.a, mut hub1, r1, b"room-k6-1", h1, 1, k_room_limits()))
                cascade.enable_leases(mut n.a, b"room-k6-1", 0, list.new())
                knode_pump(mut n, mut hub1, cur)
                attached1 = true
            }
            if attached1 && !subbed_q {
                if let Some(pid_q) = cascade.remote_pub_id(n.a, b"room-k6-1", pub_q) {
                    knode_subscribe(mut n, mut hub1, r1, 1, pid_q, 0, cur)
                    knode_pump(mut n, mut hub1, cur)
                    subbed_q = true
                }
            }
            if attached1 && ms >= 3000 && ms < 5600 && cascade.room_lease_suspended(n.a, b"room-k6-1") {
                suspended_cut = true
            }
            if ms >= 5700 {
                cascade.on_link_lost(mut n.a, h1)
                knode_pump(mut n, mut hub1, cur)
                let _ = cascade.take_fence_trace(mut n.a)
                let id_new = rebuild_id(secret.share(k), clone(c))
                let id_dial = rebuild_id(secret.share(k), clone(c))
                let mut h2 = result.unwrap(cascade.link_hub(nid, provide.random(6003), lim, take id_new, node_pins(hid, clone(hpin)), 4))
                let conn2 = result.unwrap(cascade.dial_addr(mut h2, hid, haddr, single_pin(clone(hpin)), host.mono_ns(clock), take id_dial))
                h2_opt = Some(conn2)
                hub2_opt = Some(take h2)
                reconnected = true
            }
        } else if let Some(take h2_val) = replace(mut hub2_opt, None) {
            let mut hub2 = take h2_val
            let h2 = option.unwrap(h2_opt)
            result.unwrap(cascade.drive_links(mut hub2, clock, mut sock2, order.min(now + 15 * MS, end), mut events))
            let mut got_up2 = false
            for ev in events {
                if let LinkUp(handle: h, ..) = ev {
                    if h == h2 {
                        got_up2 = true
                    }
                }
            }
            let cur = host.mono_ns(clock)
            let cur_ms = cur / MS
            knode_step(mut n, mut hub2, take events, cur)
            events = list.new()
            if got_up2 && !reattached {
                let _ = result.unwrap(cascade.reattach_edge_room(mut n.a, mut hub2, b"room-k6-1", h2, 1))
                let _ = result.unwrap(cascade.attach_edge_room(mut n.a, mut hub2, r2, b"room-k6-2", h2, 1, k_room_limits()))
                cascade.enable_leases(mut n.a, b"room-k6-2", 0, list.new())
                knode_pump(mut n, mut hub2, cur)
                reattached = true
            }
            for tr in cascade.take_fence_trace(mut n.a) {
                list.push(mut reattach_trace, tr)
            }
            for d in knode_take_delivered(mut n) {
                let Gen(id: oid, epoch: _) = d.owner
                if oid == 10 {
                    fail("fenced participant P was delivered on Edge A after reattach")
                }
                if oid == 20 {
                    resumed_q += 1
                }
            }
            if reattached && !flooded_r2 && cur_ms >= 6850 {
                let _ = cascade.send_room_raw(mut hub2, h2, 2, b"\x40\x63\x03\xff\xfe\xfd")
                flooded_r2 = true
            }
            hub2_opt = Some(take hub2)
        }
    }
    let fenced_p = cascade.is_fenced(n.a, b"room-k6-1", 10, 1)
    let r1_alive = cascade.is_fenced(n.a, b"room-k6-1", 30, 1)
    K6EdgeOut(suspended_during_cut: suspended_cut, reattach_order_ok: check_reattach_order(reattach_trace, 1), fenced_p_dropped: fenced_p, resumed_q_delivered: resumed_q, room1_still_alive: r1_alive)
}

/// bug: an edge fails to suspend within its lease during a 5 s link cut, forwards media
/// on reattach before applying the room's fence table and receiving its first LeaseGrant,
/// or a malformed message on one room stream kills another room or delays its fence.
/// oracle: docs/spec/sfu_cascade.md K6, CAS-2, and CAS-7.
@test
fn link_loss_recovers(tasks: Tasks) -> Result[(), ()] waits {
    let script = std.sim.world.Script(tail_seed: 606, streams: list.new())
    let mut config = std.sim.udp.defaults()
    config.delay_ns = 5 * MS
    let (take sim_world, clock) = std.sim.world.new(606, 0, 0)
    let (vnet, take net_task) = std.sim.udp.start(tasks, config, std.sim.world.plan_from(script, 0), take sim_world, clock, list.new(), 2097152)
    let (take hk, take hc) = result.unwrap(signal.unit_certificate(provide.random(611), clock))
    let home_pin: quic.handshake.Pin = Cert(std.sha256.hash(hc))
    let (take ak, take ac) = result.unwrap(signal.unit_certificate(provide.random(612), clock))
    let a_pin: quic.handshake.Pin = Cert(std.sha256.hash(ac))
    let home_id = cascade.node_id(b"home-k6")
    let a_id = cascade.node_id(b"edge-a-k6")
    let mut pins: List[cascade.PeerPins] = list.with_capacity(1)
    push_node_pin(mut pins, a_id, take a_pin)
    let (take s_home, _) = result.unwrap(host.udp_bind(vnet, K6_HOME_ADDR, K_SOCKET))
    let (take s_a1, _) = result.unwrap(host.udp_bind(vnet, K6_EDGE_A_ADDR, K_SOCKET))
    let (take s_a2, _) = result.unwrap(host.udp_bind(vnet, K6_EDGE_A2_ADDR, K_SOCKET))
    let t_home = task.spawn(tasks, bytes 14680064, K6HomePlan(clock: clock, socket: take s_home, vnet: vnet, node_id: home_id, key: take hk, cert: take hc, pins: take pins), k6_home_task)
    let t_a = task.spawn(tasks, bytes 16777216, K6EdgePlan(clock: clock, sock1: take s_a1, sock2: take s_a2, node_id: a_id, key: take ak, cert: take ac, home_id: home_id, home_addr: K6_HOME_ADDR, home_pin: take home_pin), k6_edge_task)
    let hs = result.unwrap(task.join(take t_home))
    let ea = result.unwrap(task.join(take t_a))
    result.unwrap(task.join(take net_task))
    if !ea.suspended_during_cut {
        fail("edge A did not suspend the room within its 2 s lease during the 5 s link cut")
    }
    if !hs.reattach_order_ok || !ea.reattach_order_ok {
        fail("reattach did not enforce strict FenceTable -> FenceTableAck -> LeaseGrant order")
    }
    if !ea.fenced_p_dropped {
        fail("fence set during cut did not hold before media resumed")
    }
    if ea.resumed_q_delivered == 0 {
        fail("non-fenced Q did not resume after reattach")
    }
    if !hs.malformed_detached_room2_only || !hs.fence_r1_acked_after_flood || !ea.room1_still_alive {
        fail("malformed room 2 stream did not detach only room 2 while room 1 fence succeeded")
    }
    Ok(())
}

// ---- P2-4: room stream drain is linear and capped ----
const KD_HOME_ADDR: Addr = Addr(ip: V4(0x0a0b0001), port: 4600)

const KD_EDGE_ADDR: Addr = Addr(ip: V4(0x0a0b0002), port: 4601)

const KD_FRAMES: u64 = 13107

const KD_END: u64 = 3000 * MS

type KDHomeOut: send {
    room_in: u64,
    max_per_drain: u64,
    detached: bool,
    shifted: u64
}

type KDEdgePlan: send {
    clock: Clock,
    socket: UdpSocket,
    node_id: cascade.NodeId,
    key: Secret,
    cert: Bytes,
    home_id: cascade.NodeId,
    home_pin: quic.handshake.Pin,
    burst: Bytes
}

fn kd_home_task(take cfg: K6HomePlan) -> KDHomeOut waits {
    let K6HomePlan(clock: clock, socket: take given, node_id: nid, key: take k, cert: take c, pins: take pins, ..) = take cfg
    let mut sock = take given
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(6101), cascade.default_link_limits(), rebuild_id(take k, take c), take pins, 4))
    let mut out = KDHomeOut(room_in: 0, max_per_drain: 0, detached: false, shifted: 0)
    let mut events: List[cascade.LinkEvent] = list.new()
    while out.room_in < KD_FRAMES && !out.detached && host.mono_ns(clock) < KD_END {
        let now = host.mono_ns(clock)
        result.unwrap(cascade.drive_links(mut hub, clock, mut sock, order.min(now + 5 * MS, KD_END), mut events))
        let mut this_drain = 0u64
        for take ev in take events {
            match take ev {
                RoomIn(room_num: 1, ..) => {
                    this_drain += 1
                },
                RoomDetached(..) => {
                    out.detached = true
                },
                _ => (),
            }
        }
        events = list.new()
        out.room_in += this_drain
        out.max_per_drain = order.max(out.max_per_drain, this_drain)
    }
    out.shifted = cascade.link_counts(hub).rx_bytes_shifted
    out
}

fn kd_edge_task(take cfg: KDEdgePlan) -> bool waits {
    let KDEdgePlan(clock: clock, socket: take given, node_id: nid, key: take k, cert: take c, home_id: hid, home_pin: hpin, burst: take burst) = take cfg
    let mut sock = take given
    let id1 = rebuild_id(secret.share(k), clone(c))
    let id2 = rebuild_id(take k, take c)
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(6102), cascade.default_link_limits(), take id1, node_pins(hid, clone(hpin)), 4))
    let h_home = result.unwrap(cascade.dial_addr(mut hub, hid, KD_HOME_ADDR, single_pin(hpin), 0, take id2))
    let mut sent = false
    let mut events: List[cascade.LinkEvent] = list.new()
    while host.mono_ns(clock) < KD_END {
        let now = host.mono_ns(clock)
        result.unwrap(cascade.drive_links(mut hub, clock, mut sock, order.min(now + 5 * MS, KD_END), mut events))
        for ev in events {
            if let LinkUp(handle: h, ..) = ev {
                if h == h_home && !sent {
                    result.unwrap(cascade.attach_room_stream(mut hub, h_home, 1, 1, true))
                    result.unwrap(cascade.send_room_raw(mut hub, h_home, 1, burst))
                    sent = true
                }
            }
        }
        events = list.new()
    }
    sent
}

/// bug: extracting a frame clones the rest of the receive buffer, so a 64 KiB window of
/// 5-byte frames costs quadratic copying; or one drain emits every buffered frame as an
/// event at once; or frames held back by the cap are lost.
/// oracle: docs/spec/sfu_cascade.md CAS-6: every frame is delivered exactly once; no
/// drain emits more than `MAX_EVENTS_PER_DRAIN` events, and one full-size packet of
/// 5-byte frames (> 256 of them) reaches the cap; a byte of unread buffer moves only
/// after an equal count of bytes before it was consumed, so bytes moved never exceed
/// the 5 * (KD_FRAMES + 1) bytes the stream carried.
@test
fn room_stream_drain_linear(tasks: Tasks) -> Result[(), ()] waits {
    let script = std.sim.world.Script(tail_seed: 611, streams: list.new())
    let mut config = std.sim.udp.defaults()
    config.delay_ns = 5 * MS
    let (take sim_world, clock) = std.sim.world.new(611, 0, 0)
    let (vnet, take net_task) = std.sim.udp.start(tasks, config, std.sim.world.plan_from(script, 0), take sim_world, clock, list.new(), 2097152)
    let (take hk, take hc) = result.unwrap(signal.unit_certificate(provide.random(621), clock))
    let home_pin: quic.handshake.Pin = Cert(std.sha256.hash(hc))
    let (take ek, take ec) = result.unwrap(signal.unit_certificate(provide.random(622), clock))
    let e_pin: quic.handshake.Pin = Cert(std.sha256.hash(ec))
    let home_id = cascade.node_id(b"home-kd")
    let e_id = cascade.node_id(b"edge-kd")
    let mut frame: Bytes = list.new()
    result.unwrap(cascade.encode_room_msg(RoomOpen(room_num: 1, term: 0, seq: 0), mut frame))
    if list.len(frame) != 5 {
        fail("RoomOpen(1, 0, 0) is not a 5-byte frame")
    }
    let mut burst: Bytes = list.with_capacity(5 * KD_FRAMES)
    for _ in 0u64 .. KD_FRAMES {
        list.append(mut burst, frame)
    }
    let mut pins: List[cascade.PeerPins] = list.with_capacity(1)
    push_node_pin(mut pins, e_id, take e_pin)
    let (take s_home, _) = result.unwrap(host.udp_bind(vnet, KD_HOME_ADDR, K_SOCKET))
    let (take s_edge, _) = result.unwrap(host.udp_bind(vnet, KD_EDGE_ADDR, K_SOCKET))
    let t_home = task.spawn(tasks, bytes 14680064, K6HomePlan(clock: clock, socket: take s_home, vnet: vnet, node_id: home_id, key: take hk, cert: take hc, pins: take pins), kd_home_task)
    let t_edge = task.spawn(tasks, bytes 14680064, KDEdgePlan(clock: clock, socket: take s_edge, node_id: e_id, key: take ek, cert: take ec, home_id: home_id, home_pin: take home_pin, burst: take burst), kd_edge_task)
    let hs = result.unwrap(task.join(take t_home))
    let sent = result.unwrap(task.join(take t_edge))
    result.unwrap(task.join(take net_task))
    if !sent {
        fail("edge never linked to send its burst")
    }
    if hs.detached {
        fail("a well-formed 5-byte frame detached the room")
    }
    if hs.room_in != KD_FRAMES {
        fail("home did not deliver every frame exactly once")
    }
    if hs.max_per_drain > cascade.MAX_EVENTS_PER_DRAIN {
        fail("a drain exceeded MAX_EVENTS_PER_DRAIN")
    }
    if hs.max_per_drain < cascade.MAX_EVENTS_PER_DRAIN {
        fail("the cap was never reached")
    }
    if hs.shifted > 5 * (KD_FRAMES + 1) {
        fail("receive buffer compaction moved more bytes than the stream carried")
    }
    Ok(())
}

fn cascade_push_v(mut src: std.prop.Source, rem: u64, mut out: Bytes) {
    match std.prop.below(mut src, 7) {
        0 => list.push(mut out, 0u8),
        1 => list.append(mut out, b"\xff\xff\xff\xff\xff\xff\xff\xff"),
        2 => {
            let _ = quic.codec.write_varint(order.min(rem + 1, quic.codec.MAX_VARINT), mut out)
        },
        3 => {
            let _ = quic.codec.write_varint(order.min(rem, quic.codec.MAX_VARINT), mut out)
        },
        4 => list.append(mut out, b"\x40\x01"),
        _ => {
            let _ = quic.codec.write_varint(std.prop.below(mut src, 64), mut out)
        },
    }
}

fn cascade_wire_gen() -> std.prop.Gen[Bytes] {
    let mut wire_arms: List[std.prop.Gen[Bytes]] = list.new()
    list.push(mut wire_arms, std.prop.bytes_of(0, 256))
    // Biased Cascade control/room frames: [tag: 1..11][len][body] with boundary varints and len+1.
    list.push(mut wire_arms, std.prop.make(fn(mut src: std.prop.Source) -> Bytes {
        let mut out: Bytes = list.new()
        let frames = 1 + std.prop.below(mut src, 4)
        for _ in 0u64 .. frames {
            let tag = 1 + std.prop.below(mut src, 12)
            let mut body: Bytes = list.new()
            let fields = std.prop.below(mut src, 8)
            for _ in 0u64 .. fields {
                cascade_push_v(mut src, 8, mut body)
            }
            let extra = std.prop.draw(mut src, std.prop.bytes_of(0, 24))
            list.append(mut body, extra)
            let _ = quic.codec.write_varint(tag, mut out)
            let blen = list.len(body)
            let wire_len = match std.prop.below(mut src, 5) {
                0 => blen + 1,
                1 => quic.codec.MAX_VARINT,
                2 => cascade.MAX_FRAME_LEN + 1,
                _ => blen,
            }
            let _ = quic.codec.write_varint(wire_len, mut out)
            list.append(mut out, body)
        }
        take out
    }, fn(b: Bytes, mut out: String) {
        string.push(mut out, "cascade_wire(len=")
        string.push_u64(mut out, list.len(b))
        string.push(mut out, ")")
    }))
    // Burst of tiny frames to exercise take_raw_frame's framing loop (P2-4).
    list.push(mut wire_arms, std.prop.make(fn(mut src: std.prop.Source) -> Bytes {
        let count = 1 + std.prop.below(mut src, 32)
        let mut out: Bytes = list.with_capacity(count * 5)
        for _ in 0u64 .. count {
            list.append(mut out, b"\x05\x03\x01\x00\x00")
        }
        take out
    }, fn(b: Bytes, mut out: String) {
        string.push(mut out, "cascade_burst(len=")
        string.push_u64(mut out, list.len(b))
        string.push(mut out, ")")
    }))
    std.prop.one_of(take wire_arms)
}

fn cascade_total_law(pkt: Bytes) -> Result[(), String] {
    let len = list.len(pkt)
    // 1. Media datagram header decode + exact byte-for-byte re-encode.
    if let Some((room_num, layer_num)) = cascade.read_media_datagram(pkt) {
        let mut re_dg: Bytes = list.with_capacity(len)
        cascade.write_media_datagram(room_num, layer_num, list.slice(pkt, 8, len), mut re_dg)
        if re_dg != pkt {
            return Error(string.from("media datagram did not re-encode to consumed bytes"))
        }
    }
    // 2. take_raw_frame + decode_link_msg / decode_room_msg + re-encode.
    let mut at = 0u64
    for _ in 0u64 .. 64 {
        let before = at
        match cascade.take_raw_frame(pkt, mut at) {
            Ok(None) => break,
            Ok(Some((tag, start, end))) => {
                if at <= before || start < before || start > end || end != at || at > len {
                    return Error(string.from("take_raw_frame returned bounds outside the consumed frame"))
                }
                let prefix = list.slice(pkt, before, at)
                if let Ok(lmsg) = cascade.decode_link_msg(tag, pkt, start, end) {
                    let mut re: Bytes = list.with_capacity(at - before)
                    if let Error(_) = cascade.encode_link_msg(lmsg, mut re) {
                        return Error(string.from("encode_link_msg failed on decoded LinkMsg"))
                    }
                    if re != prefix {
                        if list.len(re) >= list.len(prefix) {
                            return Error(string.from("re-encoded LinkMsg differed without shrinking non-minimal varints"))
                        }
                        let mut rat = 0u64
                        let Ok(Some((t2, s2, e2))) = cascade.take_raw_frame(re, mut rat) else {
                            return Error(string.from("re-encoded LinkMsg not framed"))
                        }
                        if rat != list.len(re) {
                            return Error(string.from("re-encoded LinkMsg left trailing bytes"))
                        }
                        let Ok(m2) = cascade.decode_link_msg(t2, re, s2, e2) else {
                            return Error(string.from("re-encoded LinkMsg did not re-decode"))
                        }
                        let mut re2: Bytes = list.with_capacity(list.len(re))
                        if let Error(_) = cascade.encode_link_msg(m2, mut re2) {
                            return Error(string.from("second encode_link_msg failed"))
                        }
                        if re2 != re {
                            return Error(string.from("canonical LinkMsg did not stabilize"))
                        }
                    }
                }
                if let Ok(rmsg) = cascade.decode_room_msg(tag, pkt, start, end) {
                    let mut re: Bytes = list.with_capacity(at - before)
                    if let Error(_) = cascade.encode_room_msg(rmsg, mut re) {
                        return Error(string.from("encode_room_msg failed on decoded RoomMsg"))
                    }
                    if re != prefix {
                        if list.len(re) >= list.len(prefix) {
                            return Error(string.from("re-encoded RoomMsg differed without shrinking non-minimal varints"))
                        }
                        let mut rat = 0u64
                        let Ok(Some((t2, s2, e2))) = cascade.take_raw_frame(re, mut rat) else {
                            return Error(string.from("re-encoded RoomMsg not framed"))
                        }
                        if rat != list.len(re) {
                            return Error(string.from("re-encoded RoomMsg left trailing bytes"))
                        }
                        let Ok(m2) = cascade.decode_room_msg(t2, re, s2, e2) else {
                            return Error(string.from("re-encoded RoomMsg did not re-decode"))
                        }
                        let mut re2: Bytes = list.with_capacity(list.len(re))
                        if let Error(_) = cascade.encode_room_msg(m2, mut re2) {
                            return Error(string.from("second encode_room_msg failed"))
                        }
                        if re2 != re {
                            return Error(string.from("canonical RoomMsg did not stabilize"))
                        }
                    }
                }
            },
            Error(_) => break,
        }
    }
    Ok(())
}

/// bug: Trap, overflow, slice past the buffer, or accept a Cascade frame or control/room message that does not re-encode to the consumed wire prefix.
/// oracle: CAS-2 wire encoders (`write_media_datagram`, `encode_link_msg`, `encode_room_msg`), independent of the decoders.
@test
fn cascade_wire_totality_property() -> Result[(), ()] {
    let mut c = std.prop.config()
    c.cases = 160
    std.prop.check(c, cascade_wire_gen(), cascade_total_law)
}

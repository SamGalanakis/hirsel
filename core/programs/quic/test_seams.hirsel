// Test-only seams. This file is listed under [tests.sources] and joins module quic in
// the package's own test runs and in no other build (packages.md), so nothing here is
// in the shipped API.
/// Hostile-peer test seam: raw frame bytes sent once, unchecked and never retransmitted,
/// in the connection's next 1-RTT packet. Laws use it to act as a peer that breaks the
/// rules (credit past MAX_DATA, a changed reset) or grants 2^62 of credit.
pub fn send_frames(mut e: Endpoint, c: ConnectionHandle, frames: Bytes) -> Result[(), QuicError] {
    let i = stream_slot(mut e, c)?
    let mut queued = false
    if let Some(mut conn) = e.connections[i] {
        list.append(mut conn.streams.seam, frames)
        queued = true
    }
    if queued {
        enqueue_ready(mut e, i)
        return Ok(())
    }
    Error(UnknownConnection)
}

/// Q7 seam: the connections an endpoint holds, so a law can see a Retry kept no state.
pub fn live_connections(e: Endpoint) -> u64 {
    e.live
}

/// P1-5 seam: set the handle counter near the 2^32 wrap boundary so a law can exercise
/// handle reuse and wraparound without 2^32 real Initials.
pub fn set_next_handle(mut e: Endpoint, next: u64) {
    e.next_handle = next
}

/// Q7 seam: the token a client's Initials carry (a Retry's, once one is accepted).
pub fn initial_token(e: Endpoint, c: ConnectionHandle) -> Bytes {
    let Some(i) = slot_at(e, c) else {
        return b""
    }
    if let Some(conn) = e.connections[i] {
        return clone(conn.initial.token)
    }
    b""
}

/// Q7 seam: replace the token a client's next Initials carry, to present a token that
/// was minted for another connection or relabeled to the other type.
pub fn set_initial_token(mut e: Endpoint, c: ConnectionHandle, take token: Bytes) {
    let Some(i) = slot_at(e, c) else {
        return
    }
    if let Some(mut conn) = e.connections[i] {
        conn.initial.token = take token
    }
    enqueue_ready(mut e, i)
}

/// Q7 seam: the NEW_TOKEN token this server would issue to `peer` at `now`.
pub fn mint_address_token(e: Endpoint, peer: Addr, now: u64) -> Bytes {
    seal_token(e.random, e.config.token_key, TOKEN_ADDRESS, peer, b"", b"", now)
}

/// Q13 seam: scale the §6.6 confidentiality limits down (update at `update_at` seals
/// under one key, close at `limit`) and block or allow key updates.
pub fn set_aead_limits(mut e: Endpoint, c: ConnectionHandle, update_at: u64, limit: u64, blocked: bool) {
    let Some(i) = slot_at(e, c) else {
        return
    }
    if let Some(mut conn) = e.connections[i] {
        conn.keys.update_at = update_at
        conn.keys.limit = limit
        conn.keys.blocked = blocked
    }
    enqueue_ready(mut e, i)
}

/// Q13 seam: the key updates a connection initiated and the ones it made in answer.
pub fn key_updates(e: Endpoint, c: ConnectionHandle) -> (u64, u64) {
    let Some(i) = slot_at(e, c) else {
        return (0, 0)
    }
    if let Some(conn) = e.connections[i] {
        return (conn.keys.initiated, conn.keys.answered)
    }
    (0, 0)
}

/// Q12 seam: where a server sends, whether that address is validated, the 1-RTT packets
/// it has sent with stream-layer frames, and its congestion window and smoothed RTT.
pub fn path_state(e: Endpoint, c: ConnectionHandle) -> Option[(Addr, bool, u64, u64, u64)] {
    let Some(i) = slot_at(e, c) else {
        return None
    }
    if let Some(conn) = e.connections[i] {
        return Some((conn.peer, conn.validated, conn.stream_packets, recovery.window(conn.recovery), recovery.smoothed_rtt(conn.recovery)))
    }
    None
}

/// Q15 seam: the DATAGRAM frames a connection has committed to the socket, those still
/// queued or staged, and its bytes in flight and congestion window.
pub fn datagram_counts(e: Endpoint, c: ConnectionHandle) -> (u64, u64, u64, u64) {
    let Some(i) = slot_at(e, c) else {
        return (0, 0, 0, 0)
    }
    if let Some(conn) = e.connections[i] {
        let queued = list.len(conn.streams.datagrams) + list.len(conn.streams.staged_datagrams)
        return (conn.streams.datagrams_sent, queued, recovery.bytes_in_flight(conn.recovery), recovery.window(conn.recovery))
    }
    (0, 0, 0, 0)
}

/// The peer CID `c` sends to; empty for an unknown connection.
pub fn peer_cid(e: Endpoint, c: ConnectionHandle) -> Bytes {
    if let Some(i) = slot_at(e, c) {
        if let Some(conn) = e.connections[i] {
            return clone(conn.peer_id)
        }
    }
    b""
}

/// Move `c` to the next CID its peer issued, retiring the one in use (RFC 9000 §5.1.2);
/// false when the peer has issued none to move to.
pub fn rotate_peer_cid(mut e: Endpoint, c: ConnectionHandle) -> bool {
    let Some(i) = slot_at(e, c) else {
        return false
    }
    let mut moved = false
    if let Some(mut conn) = e.connections[i] {
        if let Ok(ok) = switch_peer_cid(mut conn) {
            moved = ok
        }
    }
    if moved {
        enqueue_ready(mut e, i)
    }
    moved
}

/// QUIC-7 seam: hand `packets` (ranges of `buf`) to the endpoint as drive hands one
/// udp_recv batch, without a socket.
pub fn receive_packets(mut e: Endpoint, at: u64, packets: List[UdpPacket], mut buf: Bytes, mut events: List[Event]) {
    receive_batch(mut e, at, packets, mut buf, mut events)
}

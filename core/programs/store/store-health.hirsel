pub type Health = status.Health

fn reclaim_state(db: Db) -> object_writer.ReclaimFailures {
    if let Some(connection) = db.disk {
        if let ObjectBackend(writer) = connection.backend {
            return object_writer.reclaims(writer)
        }
    }
    object_writer.ReclaimFailures(count: 0, pending: false)
}

pub fn health(db: Db) -> Health {
    if let Some(connection) = db.disk {
        if let ObjectBackend(writer) = connection.backend {
            return object_writer.health(writer)
        }
    }
    match journal_poison(db) {
        Some(problem) => Poisoned(problem),
        None => Ok(0),
    }
}

pub fn on_unhealthy[M: send](mut db: Db, take to: Sender[M], take m: M) -> Result[(), Error] {
    if !object_writer_open(db) {
        return Error(Missing("head"))
    }
    write_disk(mut db.disk, (take to, take m), scoped fn(mut state: DiskState, take supplied: (Sender[M], M)) -> Result[(), Error] {
        if let ObjectBackend(mut writer) = state.backend {
            let (take destination, take message) = take supplied
            return failure_result_from_rep(object_writer.watch_unhealthy(mut writer, state.tasks, take destination, take message))
        }
        Error(Missing("head"))
    })
}

// OWN-9/OWN-11: within one call, a place lent mut is not viewed by a later argument, and a place an earlier argument views is not lent mut.
// expect: refuse OWN-9 at 9:13
// expect: refuse OWN-9 at 10:9


fn g(mut a: List[u8], b: List[u8]) {}
fn h(a: List[u8], mut b: List[u8]) {}
fn f(mut xs: List[u8]) {
  g(mut xs, xs)
  h(xs, mut xs)
}

/// Selects a value, including a dependency payload.
pub type Choice[T] = Empty | Value(T) | External(wire.Token)

/// A directory and its branded file.
pub type Handle { dir: Dir, file: File of .dir }

/// The maximum count.
pub const LIMIT: u64 = 7

/// A label with explicit formatting.
@format(render)
pub type Label { text: String }
@preserves_unique(out)
fn render(value: Label, mut out: List[u8]) -> () {
  for byte in string.as_bytes(value.text) {
    list.push(mut out, byte)
  }
}

/// Keeps its representation private.
pub opaque type Secret: inert uses {} { secret: u64 }

/// Retains a source brand and all parameter modes.
/// A second sentence is kept, too.
///
/// The callback's authority is explicit.
///
///     retain(source, file, target, value, callback)
@noalloc
pub fn retain[T: data + noalloc_drop](source: Dir, take file: File of source, mut target: Bytes,
  take value: T, callback: fn(T) -> bool uses {}) -> File of source uses {} { take file }

/// Accepts the selected dependency through its local alias and full identity.
pub fn token(value: wire.Token) -> doc_dep@2/model.Token { value }

/// Returns a view in its source region.
pub fn view(source: String) -> String in source uses {} { source }

// This ordinary comment is not API documentation.
@test
pub fn undocumented() {}
fn private_function() {}
type Private { hidden: u64 }

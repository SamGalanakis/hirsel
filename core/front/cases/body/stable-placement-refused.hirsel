// expect: refuse MEM-9 at 11:39
stable type S { n: u64 }
type O { n: u64 }
@compact(u32) stable type C { n: u64 }
fn bare() -> u64 { let s = S(n: 1); 0 }
fn own(r: Region) -> u64 { let o = O(n: 1) in r; 0 }
fn packed(r: Region) -> u64 { let c = C(n: 1) in r; 0 }

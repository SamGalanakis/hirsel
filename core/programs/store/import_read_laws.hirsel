// Appended by the S2 driver. The reference uses the original read and admission order,
// and returns its own refusals as values (try_reserve), each on the side that owns it.
// disk_fault as it was before R1: a refused copy of the name is Full.
fn original_disk_fault(file: String, at: u64, why: Why) -> Error {
    let mut name: Bytes = list.new()
    if let Error(c) = list.try_reserve(mut name, string.byte_len(file)) {
        return Full(Allocation(c))
    }
    list.append(mut name, string.as_bytes(file))
    Corrupt(Fault(file: result.unwrap(string.from_utf8(take name)), offset: at, why: why))
}

fn original_prepared_read(mut file: HostFile, n: u64) -> Result[Bytes, Error] waits {
    let mut out: Bytes = list.new()
    capacity(list.try_reserve(mut out, n))?
    while list.len(out) < n {
        let mut chunk: Bytes = list.new()
        capacity(list.try_reserve(mut chunk, n - list.len(out)))?
        if disk_io(host.read(mut file, mut chunk))? == 0 {
            return Error(original_disk_fault("PREPARED", list.len(out), Truncated))
        }
        capacity(list.try_reserve(mut out, list.len(chunk)))?
        list.append(mut out, chunk)
    }
    Ok(take out)
}

fn original_prepared_frame[T](mut input: PreparedInput, kind: u16, codec: std.codec.Codec[T]) -> Result[T, DeployError] waits {
    let raw = scratch_result(original_prepared_read(mut input.file, 16u64))?
    let n = read_le(raw, 4u64, 4u64)
    if read_le(raw, 0u64, 2u64) != int.widen(kind) || read_le(raw, 2u64, 2u64) != 1u64 || n > option.unwrap(disk_kind_limit(kind)) {
        return Error(ImportMalformed)
    }
    let encoded = scratch_result(original_prepared_read(mut input.file, n))?
    let check = deploy_result(capacity(disk_check(input.ctx, input.offset, list.slice(raw, 0u64, 8u64), encoded)))?
    if check != read_le(raw, 8u64, 8u64) {
        return Error(ImportMalformed)
    }
    std.sha256.add(mut input.digest, raw, 0u64, 16u64)
    std.sha256.add(mut input.digest, encoded, 0u64, n)
    input.offset += 16u64 + n
    match std.codec.decode(codec, encoded) {
        Error(_) => Error(ImportMalformed),
        Ok(take value) => Ok(take value),
    }
}

fn original_validate_prepared(d: Dir) -> Result[ValidatedImport, DeployError] waits {
    let mut file = scratch_result(disk_io(host.open(d, "PREPARED", Read)))?
    let header = scratch_result(original_prepared_read(mut file, 72u64))?
    let head = deploy_result(disk_read_header("PREPARED", header, 6, None, None))?
    let mut digest = std.sha256.start()
    std.sha256.add(mut digest, header, 0u64, 72u64)
    let mut input = PreparedInput(file: take file, ctx: head.context, offset: 72u64, digest: take digest, peek: None)
    let metadata_codec: std.codec.Codec[PreparedMeta] = std.codec.of()
    let meta = original_prepared_frame(mut input, 0x0081, metadata_codec)?
    if list.len(meta.base.attempt) != 16 || meta.base.store_hi != head.context.store.hi || meta.base.store_lo != head.context.store.lo || meta.base.opened != head.context.seq || meta.base.branch != 0 || meta.base.next_table == 0 || meta.next_table < meta.base.next_table || list.len(meta.target.digest) != 32 || list.len(meta.target.release) != 32 || list.len(meta.target.describe) == 0 {
        return Error(ImportMalformed)
    }
    // These fixtures contain only the header and metadata frame.
    if meta.changes != 0 || meta.ranges != 0 {
        return Error(ImportMalformed)
    }
    let delta: List[CatalogChange] = list.new()
    let needed = deploy_result(changed_ranges(delta, meta.base.next_table, meta.next_table))?
    if list.len(needed) != meta.ranges {
        return Error(ImportMalformed)
    }
    let ranges: List[ValidatedRange] = list.new()
    let mut extra: Bytes = list.new()
    deploy_result(capacity(list.try_reserve(mut extra, 1)))?
    if scratch_result(disk_io(host.read(mut input.file, mut extra)))? != 0 {
        return Error(ImportMalformed)
    }
    let PreparedInput(file: take done, digest: take hashed, ..) = take input
    scratch_result(disk_io(host.close(take done)))?
    Ok(ValidatedImport(meta: take meta, delta: take delta, ranges: take ranges, rewrites: list.new(), digest: std.sha256.finish(hashed), charge: 0, source_map: list.new(), dir: None, rewrites_checked: false))
}

fn prepared_imports_match(a: ValidatedImport, b: ValidatedImport) -> bool {
    let codec: std.codec.Codec[PreparedMeta] = std.codec.of()
    let mut left: Bytes = list.new()
    let mut right: Bytes = list.new()
    result.unwrap(std.codec.encode(codec, a.meta, mut left))
    result.unwrap(std.codec.encode(codec, b.meta, mut right))
    left == right && a.digest == b.digest && a.charge == b.charge && list.len(a.delta) == 0 && list.len(b.delta) == 0 && list.len(a.ranges) == 0 && list.len(b.ranges) == 0
}

// R1: a refused admission in shared read code raises Capacity; Store disk reads
// return theirs as values (d6b92dd2). The reads wait, so a child
// task (FAIL-14), not isolate, is the boundary that observes the refusal; the
// bound inside the child keeps each read's limit exact.
type LawRead[R] = ReadReturned(R) | ReadRaised(Capacity) | ReadLost

fn joined_read[X: send, R: send](tasks: Tasks, take job: X, f: fn(take X) -> Result[R, Capacity] waits) -> LawRead[R] waits {
    let running = task.spawn(tasks, bytes 1048576, take job, f)
    match task.join(take running) {
        Ok(Ok(take seen)) => ReadReturned(take seen),
        Error(Failed(causes)) => match raised_capacity(causes) {
            Some(c) => ReadRaised(c),
            None => ReadLost,
        },
        _ => ReadLost,
    }
}

type ExportRead: send {
    d: Dir,
    c: Clock,
    limit: u64
}

fn law_export_read(take job: ExportRead) -> Result[Option[DeployError], Capacity] waits {
    let empty: Bytes = list.new()
    let options = result.unwrap(sized(Directory, 2147483648u64))
    bound bytes job.limit {
        match open_export(job.d, job.c, empty, options) {
            Ok(_) => None,
            Error(take problem) => Some(take problem),
        }
    }
}

// A refusal's charge, raised or returned as Full.
fn read_refusal(r: LawRead[Result[ValidatedImport, DeployError]]) -> Option[Capacity] {
    match r {
        ReadRaised(c) => Some(c),
        ReadReturned(Error(Scratch(Full(Allocation(c))))) => Some(c),
        ReadReturned(Error(Store(Full(Allocation(c))))) => Some(c),
        _ => None,
    }
}

// 0 raised, 1 scratch, 2 store.
fn refusal_side(r: LawRead[Result[ValidatedImport, DeployError]]) -> u64 {
    match r {
        ReadReturned(Error(Scratch(Full(_)))) => 1,
        ReadReturned(Error(Store(Full(_)))) => 2,
        _ => 0,
    }
}

// The reference returns every refusal it owns, so it raises only in shared
// code, where production must raise as well. Production allocations raise
// under R1 and so name no side; any side production does name must be the
// reference's.
fn same_side(reference: LawRead[Result[ValidatedImport, DeployError]], production: LawRead[Result[ValidatedImport, DeployError]]) -> bool {
    let want = refusal_side(reference)
    let got = refusal_side(production)
    if want == 0 {
        got == 0
    } else {
        got == 0 || got == want
    }
}

type PreparedRead: send {
    d: Dir,
    limit: u64,
    original: bool
}

fn law_prepared_read(take job: PreparedRead) -> Result[Result[ValidatedImport, DeployError], Capacity] waits {
    bound bytes job.limit {
        if job.original {
            original_validate_prepared(job.d)
        } else {
            validate_prepared(job.d)
        }
    }
}

fn prepared_read_boundary_sweep(d: Dir, tasks: Tasks) -> bool waits {
    for limit in 120u64 .. 641u64 {
        let before = joined_read(tasks, PreparedRead(d: d, limit: limit, original: true), law_prepared_read)
        let after = joined_read(tasks, PreparedRead(d: d, limit: limit, original: false), law_prepared_read)
        let agrees = match read_refusal(before) {
            Some(a) => match after {
                ReadReturned(Ok(_)) => true,
                _ => match read_refusal(after) {
                    // Same refusal, and the same side: a reference raise (shared
                    // code) must raise in production too; a refusal the reference
                    // returns on a side must come back on that side, or raised.
                    Some(b) => a.requested == b.requested && a.available == b.available && same_side(before, after),
                    None => false,
                },
            },
            None => match take before {
                ReadReturned(Error(Scratch(Corrupt(a)))) => match after {
                    ReadReturned(Error(Scratch(Corrupt(b)))) => {
                        a.file == b.file && a.offset == b.offset && match (a.why, b.why) {
                            (Truncated, Truncated) => true,
                            _ => false
                        }
                    },
                    _ => false,
                },
                ReadReturned(Error(ImportMalformed)) => match after {
                    ReadReturned(Error(ImportMalformed)) => true,
                    _ => false,
                },
                ReadReturned(Ok(a)) => match after {
                    ReadReturned(Ok(b)) => prepared_imports_match(a, b),
                    _ => false,
                },
                _ => false,
            },
        }
        if !agrees {
            return false
        }
    }
    true
}

pub fn disk_law_import_read_boundaries(d: Dir, c: Clock, tasks: Tasks) -> bool waits {
    let empty: Bytes = list.new()
    // A zero-byte read spends only the 216-byte temporary charge.
    result.unwrap(std.file.write(d, "EXPORT", empty))
    let empty_export = joined_read(tasks, ExportRead(d: d, c: c, limit: 216), law_export_read)
    match take empty_export {
        ReadReturned(Some(Store(Corrupt(fault)))) => if fault.offset != 0 {
            return false
        },
        _ => return false,
    }
    let mut fixture: Bytes = list.with_capacity(217)
    list.fill(mut fixture, 217, 0u8)
    result.unwrap(std.file.write(d, "EXPORT", list.slice(fixture, 0, 1)))
    // d6b92dd2 made Store disk reads return their refusals (L85), so the short
    // read's 8-byte admission comes back as a value on the scratch side.
    let short_export = joined_read(tasks, ExportRead(d: d, c: c, limit: 216), law_export_read)
    match take short_export {
        ReadReturned(Some(Scratch(Full(Allocation(admission))))) => if admission.requested != 8 || admission.available != 0 {
            return false
        },
        _ => return false,
    }
    result.unwrap(std.file.write(d, "EXPORT", list.slice(fixture, 0, 216)))
    match open_export(d, c, empty, result.unwrap(sized(Directory, 2147483648u64))) {
        Error(Store(Corrupt(_))) => {},
        _ => return false,
    }
    result.unwrap(std.file.write(d, "EXPORT", fixture))
    match open_export(d, c, empty, result.unwrap(sized(Directory, 2147483648u64))) {
        Error(Scratch(Corrupt(fault))) => {
            if fault.offset != 216 {
                return false
            }
            if let Malformed = fault.why {} else {
                return false
            }
        },
        _ => return false,
    }
    result.unwrap(std.file.write(d, "PREPARED", list.slice(fixture, 0, 1)))
    if !prepared_read_boundary_sweep(d, tasks) {
        return false
    }
    let short = result.unwrap(bound bytes 152 {
        validate_prepared(d)
    })
    match take short {
        Error(Scratch(Corrupt(fault))) => {
            if fault.offset != 1 || fault.file != "PREPARED" {
                return false
            }
            if let Truncated = fault.why {} else {
                return false
            }
        },
        _ => return false,
    }
    let ctx = DiskContext(store: StoreId(hi: 1, lo: 2), role: 6, seq: 3)
    let mut prepared_file = result.unwrap(open_frames(d, "PREPARED", ctx))
    let meta = PreparedMeta(base: ExportStamp(attempt: install_fixture_bytes(16, 7), store_hi: 1, store_lo: 2, opened: 3, branch: 0, head: 0, next_table: 1, activation: 0, terminal: 3, end: 72), target: PreparedTarget(describe: install_fixture_bytes(32, 21), release: install_fixture_bytes(32, 22), digest: install_fixture_bytes(32, 23), resident_limit: 1048576, pack_bytes: 1048576, checkpoint_bytes: 67108864, journal_limit: 268435456, limits: None), next_table: 1, changes: 0, ranges: 0)
    let codec: std.codec.Codec[PreparedMeta] = std.codec.of()
    result.unwrap(write_prepared_frame(mut prepared_file, 0x0081, codec, meta))
    result.unwrap(finish_frames(take prepared_file))
    // AP1b: a 32-byte description and no limits make a 248-byte payload. The four
    // option words start at payload offset 192 (file offset 280).
    let bytes_on_disk = result.unwrap(disk_read_paged_file(d, "PREPARED", 336))
    if list.len(bytes_on_disk) != 336 || read_le(bytes_on_disk, 72, 2) != 0x0081 || read_le(bytes_on_disk, 76, 4) != 248 || read_le(bytes_on_disk, 280, 8) != 1048576 || read_le(bytes_on_disk, 288, 8) != 1048576 || read_le(bytes_on_disk, 296, 8) != 67108864 || read_le(bytes_on_disk, 304, 8) != 268435456 {
        return false
    }
    if !prepared_read_boundary_sweep(d, tasks) {
        return false
    }
    let imported = match validate_prepared(d) {
        Ok(take checked) => take checked,
        _ => return false,
    }
    if imported.meta.base.attempt != meta.base.attempt || imported.meta.target.describe != meta.target.describe {
        return false
    }
    let mut with_extra = result.unwrap(host.open(d, "PREPARED", Append))
    result.unwrap(host.write(mut with_extra, list.slice(fixture, 0, 1)))
    result.unwrap(host.close(take with_extra))
    if !prepared_read_boundary_sweep(d, tasks) {
        return false
    }
    match validate_prepared(d) {
        Error(ImportMalformed) => true,
        _ => false,
    }
}

@test
fn disk_test_import_read_boundaries(d: Dir, c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_import_read_boundaries(disk_test_directory(d), c, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L51 (e″). The old snapshot and the index give independent views of the cut.
type RewriteLawRow: codec + send {
    due: u64,
    body: u64
}

fn rewrite_law_due(_k: u64, row: RewriteLawRow) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, row.due)
    Ok(take keys)
}

// A migration that changes nothing: the staging carries only rewrites.
fn rewrite_law_schema(mut _migration: Migration) -> Result[(), Error] {
    Ok(())
}

// rewrite with its due index, declared in `mode`.
fn rewrite_law_declare(mut db: Db, mode: Mode) -> Result[(Table[u64, RewriteLawRow], Index[u64, u64, RewriteLawRow, ()]), Error] waits {
    let codec: std.codec.Codec[RewriteLawRow] = std.codec.of()
    let mut d = declare(db, mode)?
    let mut declared = declare_table(mut d, "rewrite", std.codec.key_u64(), codec)?
    let due = index(mut d, mut declared, "due", Many, code.describe(rewrite_law_due), std.codec.key_u64())?
    let rows = finish(mut d, take declared)?
    let _ = seal(mut db, take d)?
    Ok((take rows, take due))
}

// rewrite and its due index declared unchanged in `d`, so a staged rewrite
// is checked against due.
fn rewrite_law_declared(mut d: Declare) -> Result[(), Error] {
    let codec: std.codec.Codec[RewriteLawRow] = std.codec.of()
    let mut declared = declare_table(mut d, "rewrite", std.codec.key_u64(), codec)?
    let _ = index(mut d, mut declared, "due", Many, code.describe(rewrite_law_due), std.codec.key_u64())?
    let _ = finish(mut d, take declared)?
    Ok(())
}

fn rewrite_law_stage(db: Db, tasks: Tasks) -> Result[StagedMigration, Error] waits {
    let mut d = declare_migration(db, tasks, code.describe(rewrite_law_schema))?
    rewrite_law_declared(mut d)?
    finish_migration(db, take d)
}

fn rewrite_law_stage_export(source: Preparation, tasks: Tasks) -> Result[StagedMigration, Error] waits {
    let mut d = declare_export(source, tasks, None)?
    rewrite_law_declared(mut d)?
    finish_export_declaration(source, take d)
}

fn rewrite_law_refusals(mut staged: StagedMigration, rows: Table[u64, RewriteLawRow]) -> () {
    match stage_rewrite(mut staged, rows, 3, RewriteLawRow(due: 10, body: 3)) {
        Error(Missing(name)) if name == "row" => (),
        _ => fail("L51(e″): staged a rewrite of an absent key"),
    }
    match stage_rewrite(mut staged, rows, 1, RewriteLawRow(due: 11, body: 3)) {
        Error(Changed(name)) if name == "due" => (),
        _ => fail("L51(e″): staged a rewrite that changed due"),
    }
}

fn rewrite_law_replace(mut migration: Migration) -> Result[(), Error] {
    let codec: std.codec.Codec[RewriteLawRow] = std.codec.of()
    migrate_table(mut migration, "rewrite", std.codec.key_u64(), codec, "rewrite", std.codec.key_u64(), codec, fn(k: u64, row: RewriteLawRow) -> Result[Option[(u64, RewriteLawRow)], Capacity] {
        Ok(Some((k, clone(row))))
    })
}

fn rewrite_law_target() -> PreparedTarget {
    PreparedTarget(describe: install_fixture_bytes(32, 66), release: install_fixture_bytes(32, 67), digest: install_fixture_bytes(32, 68), resident_limit: 2097152, pack_bytes: 1048576, checkpoint_bytes: 4096, journal_limit: 16781392, limits: None)
}

fn rewrite_law_append(d: Dir, base: Bytes, id: u32, keys: (u64, Option[u64]), truncated: bool) -> Result[(), DeployError] waits {
    let header = deploy_result(disk_read_header("PREPARED", base, 6, None, None))?
    let mut payload: Bytes = list.new()
    let row_count: u32 = if let Some(_) = keys.1 {
        2u32
    } else {
        1u32
    }
    list.put_word_le(mut payload, row_count)
    for i in 0u32 .. row_count {
        let key = if i == 0 {
            keys.0
        } else {
            option.unwrap(keys.1)
        }
        list.put_word_le(mut payload, id)
        list.put_word_le(mut payload, 8u32)
        list.put_word_be(mut payload, key)
        list.put_word_le(mut payload, 18u32)
        list.put_word_le(mut payload, 0u16)
        list.put_word_le(mut payload, 10u64)
        list.put_word_le(mut payload, 5u64)
    }
    let frame = deploy_result(capacity(disk_seal(header.context, list.len(base), 0x0085, 1, payload)))?
    let mut file = scratch_result(disk_io(host.open(d, "PREPARED", Write)))?
    match host.write(mut file, base) {
        Error(problem) => return Error(Scratch(Io(problem.error))),
        Ok(()) => (),
    }
    let end = list.len(frame) - if truncated {
        1u64
    } else {
        0u64
    }
    match host.write(mut file, list.slice(frame, 0, end)) {
        Error(problem) => return Error(Scratch(Io(problem.error))),
        Ok(()) => (),
    }
    scratch_result(disk_io(host.close(take file)))
}

fn rewrite_law_import_refused(mut db: Db, scratch: Dir, base: u64) -> () waits {
    let imported = match validate_prepared(scratch) {
        Ok(take checked) => reserve_import(mut db, take checked),
        Error(take error) => Error(take error),
    }
    if let Error(ImportMalformed) = imported {} else {
        fail("L51(e″): imported a malformed rewrite")
    }
    if version(snapshot(db)) != base {
        fail("L51(e″): refused rewrite changed OLD")
    }
}

// rewrite_law_replace's migration with the due index declared on the new
// table, staged from the export.
fn rewrite_law_replace_indexed(source: Preparation, tasks: Tasks) -> Result[StagedMigration, Error] waits {
    let codec: std.codec.Codec[RewriteLawRow] = std.codec.of()
    let mut d = declare_export(source, tasks, Some(code.describe(rewrite_law_replace)))?
    let mut declared = declare_table(mut d, "rewrite", std.codec.key_u64(), codec)?
    let _ = index(mut d, mut declared, "due", Many, code.describe(rewrite_law_due), std.codec.key_u64())?
    let _ = finish(mut d, take declared)?
    finish_export_declaration(source, take d)
}

// L51 (e″), v2.103: a rewrite on a table the staging replaces edits the staged
// range and writes no 0x0085 row. The frame walk reads only the §2.1 headers.
fn rewrite_law_staged_range(mut db: Db, d: Dir, c: Clock, tasks: Tasks, old_rows: Table[u64, RewriteLawRow]) -> Result[(), DeployError] waits {
    let codec: std.codec.Codec[RewriteLawRow] = std.codec.of()
    let prior = snapshot(db)
    let attempt = install_fixture_bytes(16, 9)
    let (scratch, base) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let mut source = open_export(scratch, c, attempt, disk_crash_options("install"))?
    let mut staged = deploy_result(rewrite_law_replace_indexed(source, tasks))?
    let rows = deploy_result(catalog_handle(source.db.store, staged.plan.roots.catalog, "rewrite", std.codec.key_u64(), codec))?
    if rows.id == old_rows.id {
        fail("L51(e″): the staging did not replace the table")
    }
    rewrite_law_refusals(mut staged, rows)
    deploy_result(stage_rewrite(mut staged, rows, 1, RewriteLawRow(due: 10, body: 6)))?
    write_prepared(mut source, staged, scratch, rewrite_law_target())?
    let file = scratch_result(disk_read_paged_file(scratch, "PREPARED", 1048576))?
    let mut at = 72u64
    let mut final_kind = 0u64
    while at + 16 <= list.len(file) {
        let kind: u16 = list.word_le(file, at)
        let n: u32 = list.word_le(file, at + 4)
        final_kind = int.widen(kind)
        let size: u64 = int.widen(n)
        at += 16 + size
    }
    if at != list.len(file) || final_kind != 0x0084 {
        fail("L51(e″): a staged-range rewrite wrote a 0x0085 row")
    }
    let work = reserve_import(mut db, validate_prepared(scratch)?)?
    let ready = import_trees(take work)?
    let digest = imported_digest(ready)
    keep_import(mut db, take ready)?
    if crash_apply(mut db, attempt, digest)? != base + 1 {
        fail("L51(e″): wrong staged-range activation version")
    }
    let current = snapshot(db)
    let (new_rows, due) = deploy_result(rewrite_law_declare(mut db, Open))?
    let read = deploy_result(reader(db, 0))?
    if let Some(row) = deploy_result(get(read, prior, old_rows, 1))? {
        if row.due != 10 || row.body != 5 {
            fail("L51(e″): staged-range rewrite changed v − 1")
        }
    } else {
        fail("L51(e″): v − 1 row is missing")
    }
    for (key, body) in[(1u64, 6u64), (2u64, 2u64)] {
        let Some(row) = deploy_result(get(read, current, new_rows, key))? else {
            fail("L51(e″): replaced row is missing")
        }
        if row.body != body {
            fail("L51(e″): replaced range lost the staged edit")
        }
        let mut index_key = deploy_result(prefix(due.id))?
        list.put_word_be(mut index_key, row.due)
        list.put_word_be(mut index_key, key)
        let Some(_) = get_page_row(current.roots.collections, index_key) else {
            fail("L51(e″): replaced index entry missing")
        }
    }
    Ok(())
}

@test
fn disk_test_activation_rewrites(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let mut db = deploy_result(open(tasks, disk_test_directory(d), c, r, disk_crash_options("install")))?
    let codec: std.codec.Codec[RewriteLawRow] = std.codec.of()
    let (rows, due) = deploy_result(rewrite_law_declare(mut db, Migrate))?
    let Committed(_) = result.unwrap(run(mut db, None, copy_env(rows), fn(mut tx: Tx, t: Table[u64, RewriteLawRow]) -> Result[(), Error] {
        put(mut tx, t, 1, RewriteLawRow(due: 10, body: 1))?
        put(mut tx, t, 2, RewriteLawRow(due: 20, body: 2))
    })) else {
        fail("L51(e″): seed rows")
    }
    let mut standalone = deploy_result(rewrite_law_stage(db, tasks))?
    rewrite_law_refusals(mut standalone, rows)
    deploy_result(stage_rewrite(mut standalone, rows, 1, RewriteLawRow(due: 10, body: 4)))?
    deploy_result(install_activation(mut db, take standalone))?
    let prior = snapshot(db)
    let attempt = install_fixture_bytes(16, 7)
    let (scratch, base) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let mut source = open_export(scratch, c, attempt, disk_crash_options("install"))?
    let exported_rows = deploy_result(catalog_handle(source.db.store, source.db.heads[0].roots.catalog, "rewrite", std.codec.key_u64(), codec))?
    let replaced = deploy_result(stage_export_migration(source, tasks, code.describe(rewrite_law_replace)))?
    write_prepared(mut source, replaced, scratch, rewrite_law_target())?
    let replacement = scratch_result(disk_read_paged_file(scratch, "PREPARED", 1048576))?
    rewrite_law_append(scratch, replacement, exported_rows.id, (1u64, None), false)?
    rewrite_law_import_refused(mut db, scratch, base)
    let mut staged = deploy_result(rewrite_law_stage_export(source, tasks))?
    rewrite_law_refusals(mut staged, exported_rows)
    write_prepared(mut source, staged, scratch, rewrite_law_target())?
    let empty = scratch_result(disk_read_paged_file(scratch, "PREPARED", 1048576))?
    if list.len(empty) != 336 {
        fail("L51(e″): preparation without rewrites has a suffix")
    }
    rewrite_law_append(scratch, empty, exported_rows.id, (3u64, None), false)?
    rewrite_law_import_refused(mut db, scratch, base)
    for keys in[(2u64, Some(1u64)), (1u64, Some(1u64))] {
        rewrite_law_append(scratch, empty, exported_rows.id, keys, false)?
        rewrite_law_import_refused(mut db, scratch, base)
    }
    rewrite_law_append(scratch, empty, exported_rows.id, (1u64, None), true)?
    if let Error(Scratch(Corrupt(Fault(why: Truncated, ..)))) = validate_prepared(scratch) {} else {
        fail("L51(e″): truncated rewrite payload did not return Corrupt")
    }
    deploy_result(stage_rewrite(mut staged, exported_rows, 1, RewriteLawRow(due: 10, body: 5)))?
    rewrite_law_append(scratch, empty, exported_rows.id, (1u64, None), false)?
    let expected = scratch_result(disk_read_paged_file(scratch, "PREPARED", 1048576))?
    write_prepared(mut source, staged, scratch, rewrite_law_target())?
    let coded = scratch_result(disk_read_paged_file(scratch, "PREPARED", 1048576))?
    if coded != expected {
        fail("L51(e″): wrong rewrite frame bytes")
    }
    let work = reserve_import(mut db, validate_prepared(scratch)?)?
    let ready = import_trees(take work)?
    let digest = imported_digest(ready)
    keep_import(mut db, take ready)?
    if crash_apply(mut db, attempt, digest)? != base + 1 {
        fail("L51(e″): wrong activation version")
    }
    let current = snapshot(db)
    let read = deploy_result(reader(db, 0))?
    if let Some(row) = deploy_result(get(read, prior, rows, 1))? {
        if row.due != 10 || row.body != 4 {
            fail("L51(e″): old snapshot changed")
        }
    } else {
        fail("L51(e″): old row is missing")
    }
    if let Some(row) = deploy_result(get(read, current, rows, 1))? {
        if row.due != 10 || row.body != 5 {
            fail("L51(e″): rewritten row missing at activation")
        }
    } else {
        fail("L51(e″): rewritten row is missing")
    }
    if let Some(row) = deploy_result(get(read, current, rows, 2))? {
        if row.due != 20 || row.body != 2 {
            fail("L51(e″): untargeted row changed")
        }
    } else {
        fail("L51(e″): untargeted row is missing")
    }
    for (deadline, key) in[(10u64, 1u64), (20u64, 2u64)] {
        let mut index_key = deploy_result(prefix(due.id))?
        list.put_word_be(mut index_key, deadline)
        list.put_word_be(mut index_key, key)
        let Some(before) = get_page_row(prior.roots.collections, index_key) else {
            fail("L51(e″): seed index missing")
        }
        let Some(after) = get_page_row(current.roots.collections, index_key) else {
            fail("L51(e″): cut index missing")
        }
        if list.compare_bytes(before, after) != Equal {
            fail("L51(e″): cut index changed")
        }
    }
    rewrite_law_staged_range(mut db, d, c, tasks, rows)?
    deploy_result(close(take db))
}

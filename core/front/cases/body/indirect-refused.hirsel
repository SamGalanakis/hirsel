// LANG-11/13: parameter modes and result types must match; waits is directional.
// expect: refuse LANG-13 at 11:34
// expect: refuse LANG-13 at 12:44
// expect: refuse LANG-8 at 13:31
// expect: compared LANG-13 at 11:34 | fn(mut u64) -> () | fn(u64) -> ()
// expect: compared LANG-13 at 12:44 | fn(u64) -> u64 | fn(u64) -> bool
// expect: compared LANG-8 at 13:31 | not waits | waits
fn value(x: u64) -> u64 { x }
fn change(mut x: u64) { x += 1 }
fn waiting(f: fn() waits) waits { f() }
fn bad_mode() { let f: fn(u64) = change }
fn bad_result() { let f: fn(u64) -> bool = value }
fn bad_waits(f: fn() waits) { f() }

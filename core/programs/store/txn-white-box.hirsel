// Mutate the empty raw fixture collections under the same stamps as body writes.
pub fn define_test_collection[Event: inert + shareable + send](mut tx: TxState[Event], id: u32, mut draw: u64) -> Result[(), types.Failure] {
    own_tx_roots(mut tx)
    if let Some(mut roots) = tx.roots {
        catalog.define_collection(mut roots.collections, id, 1, tx.private_from, mut draw)?
    }
    tx.private_from = draw
    tx.resident += 126
    Ok(())
}

// The frame fixtures encode in place so they exercise the spare tail bytes.
pub fn test_encode_rows[Event: inert + shareable + send, R](mut tx: TxState[Event], encode: scoped[view] fn(mut pages.DataRows, pages.DataRows, Option[format.CallSection]) -> R) -> R {
    encode(mut tx.ops.rows, tx.stream_ops.rows, tx.call)
}

pub fn set_tx_frame_bytes[Event: inert + shareable + send](mut tx: TxState[Event], frame: Option[u64]) {
    tx.frame_bytes = frame
}

pub fn set_tx_extra_bytes[Event: inert + shareable + send](mut tx: TxState[Event], extra: u64) {
    tx.extra_bytes = extra
}

pub fn set_tx_call[Event: inert + shareable + send](mut tx: TxState[Event], take section: Option[format.CallSection]) {
    tx.call = take section
}

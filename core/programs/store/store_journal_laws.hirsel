pub fn journal_law_end_storage(d: Dir) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let mut scratch = result.unwrap(journal_buffers(1024))
    for seq in[7u64, 257u64] {
        let mut file = result.unwrap(host.open(d, result.unwrap(disk_path("j-", seq, ".end")), Write))
        let attempt = bound bytes 0 {
            journal_write_end(id, seq, 198, mut file, mut scratch.end_bytes, mut scratch.binding)
        }
        result.unwrap(host.close(take file))
        match take attempt {
            Ok(Ok(())) => {},
            _ => return false
        }
        if result.unwrap(disk_end(d, id, seq)) != Some(198u64) {
            return false
        }
    }
    true
}


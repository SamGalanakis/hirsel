// Two peak eight-byte allocations fit in 16 bytes beyond main startup, and
// the isolate below admits its 32-byte cause cell and an 8-byte copy of s
// from the same room (MEM-24).
pub fn main()->Result[(),Exit] {
    let mut s=string.new()
    string.reserve(mut s,3)
    string.push(mut s,"abc")
    string.push(mut s,"")
    string.push(mut s,"é")
    if s!="abcé" || string.byte_len(s)!=5u64 { return Error(Exit(status:1)) }
    {
        let b=string.as_bytes(s)
        if list.capacity(b)<5u64 || b[3]!=0xC3u8 || b[4]!=0xA9u8 { return Error(Exit(status:2)) }
    }
    // MEM-26: growth charges the active bound, which has zero bytes left.
    // The limit funding the existing storage still has eight bytes available.
    // An isolate body may not capture a mutable place, so it grows its own copy
    // of s: reserving 100 more on 5 bytes asks for round8(5 + 100) = 112.
    if refused(isolate(fn() -> Result[(), Capacity] {
        let mut t=string.new()
        string.reserve(mut t,3)
        string.push(mut t,"abcé")
        bound bytes 0 { string.reserve(mut t,100) }
    })) != 112u64 { return Error(Exit(status:3)) }
    Ok(())
}

// The bytes requested by a caught refusal that found no room, else 0.
fn refused(r: Result[Result[Result[(), Capacity], Causes], Capacity]) -> u64 {
    if let Ok(Error(causes)) = r {
        for c in causes {
            if let Capacity(k) = c.kind {
                if k.available == 0u64 { return k.requested }
            }
            return 0u64
        }
    }
    0u64
}

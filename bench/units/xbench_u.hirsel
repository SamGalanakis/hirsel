// Unit and connection microbenchmarks. The x_ modes run helper units made with
// task.spawn_unit and meet them only through connections; run them under
// HIRSEL_UNTIED=W so the units share W pool workers. The c_ modes are the same
// shapes on local channels inside one unit.
//
// Arguments: mode n size, then
//   x_pingpong: [warm], round trips before the timed n
//   x_pipe, c_pingpong: nothing more
//   c_pipe: depth
//   x_fanin, c_fanin: grain producers (c_fanin: producers grain)
//   x_svc: nothing more (size is ignored)
//   x_ring: units
// Each reports `<mode> n=<n> ns=<elapsed> check=<sum>` on stderr.
const TASK_BYTES: u64 = 65536

const HELPER_BYTES: u64 = 1048576

const PIPE_DEPTH: u64 = 64

fn kernel(seed: u64, rounds: u64) -> u64 {
    let mut x = seed
    for _ in 0 .. rounds {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
    }
    x
}

fn arg(argv: Args, i: u64) -> u64 {
    let Some(v) = args.get(argv, i) else {
        fail("missing argument")
    }
    result.unwrap(int.parse(v))
}

fn payload(size: u64, seed: u64) -> Bytes {
    let mut b: Bytes = result.unwrap(list.with_capacity(size))
    for i in 0 .. size {
        result.unwrap(list.push(mut b, int.truncate(i * 31 + seed)))
    }
    b
}

fn report(err: Stderr, name: String, n: u64, ns: u64, check: u64) waits {
    let mut line = string.new()
    result.unwrap(string.push(mut line, name))
    result.unwrap(string.push(mut line, " n="))
    result.unwrap(string.push_u64(mut line, n))
    result.unwrap(string.push(mut line, " ns="))
    result.unwrap(string.push_u64(mut line, ns))
    result.unwrap(string.push(mut line, " check="))
    result.unwrap(string.push_u64(mut line, check))
    result.unwrap(string.push(mut line, "\n"))
    result.unwrap(stderr.write(err, line))
}

// The room a connection of `cap` items of `size` bytes needs: each item is
// charged its content, round8(size).
fn room(cap: u64, size: u64) -> u64 {
    cap * ((size + 7) / 8 * 8)
}

// ---- request/reply: the root asks, a helper unit echoes (first byte + 1).
// An inbox does not cross, so the helper makes its own connection and sends
// its client back over `hello`.
type Echoer: cross {
    hello: Client[Client[Bytes]],
    back: Client[Bytes],
    n: u64,
    depth: u64,
    size: u64
}

fn echoer(take e: Echoer) -> u64 waits {
    let Echoer(hello: hello, back: back, n: n, depth: depth, size: size) = take e
    let (c, i): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(depth, bytes room(depth, size)))
    result.unwrap(conn.send(hello, take c))
    for _ in 0 .. n {
        let mut b = result.unwrap(conn.receive(i))
        let first: u8 = b[0]
        let _ = list.set(mut b, 0, int.wrapping_add(first, 1u8))
        result.unwrap(conn.send(back, take b))
    }
    n
}

fn start_echo(tasks: Tasks, back: Client[Bytes], n: u64, depth: u64, size: u64) -> (Task[u64], Client[Bytes]) waits {
    let (hello, hello_in): (Client[Client[Bytes]], Inbox[Client[Bytes]]) = result.unwrap(conn.new(1, bytes 0))
    let e = Echoer(hello: take hello, back: conn.client(back), n: n, depth: depth, size: size)
    let t = result.unwrap(task.spawn_unit(tasks, bytes HELPER_BYTES, take e, echoer))
    let peer = result.unwrap(conn.receive(hello_in))
    (take t, take peer)
}

// One buffer circulates: each crossing copies it into the receiver. The
// first `warm` round trips are not timed; the check covers all of them.
fn x_pingpong(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64, warm: u64) waits {
    let (back, answers): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(1, bytes room(1, size)))
    let (take t, take peer) = start_echo(tasks, back, warm + n, 1, size)
    let mut buf = payload(size, 7)
    let mut check = 0u64
    let mut started = host.mono_ns(clock)
    for i in 0 .. warm + n {
        if i == warm {
            started = host.mono_ns(clock)
        }
        let _ = list.set(mut buf, 0, int.truncate(i))
        result.unwrap(conn.send(peer, take buf))
        buf = result.unwrap(conn.receive(answers))
        let got: u8 = buf[0]
        if got != int.wrapping_add(int.truncate(i), 1u8) {
            fail("pingpong: bad reply")
        }
        check = int.wrapping_add(check, int.widen(got))
    }
    let ns = host.mono_ns(clock) - started
    result.unwrap(task.join(take t))
    report(err, "x_pingpong", n, ns, check)
}

// ---- pipelined request/reply: a feeder task keeps PIPE_DEPTH requests in flight.
type Feeder: send {
    to: Client[Bytes],
    n: u64,
    size: u64
}

fn feeder(take f: Feeder) waits {
    let Feeder(to: to, n: n, size: size) = take f
    let req = payload(size, 7)
    for i in 0 .. n {
        let mut m: Bytes = result.unwrap(list.with_capacity(size))
        result.unwrap(list.append(mut m, req))
        let _ = list.set(mut m, 0, int.truncate(i))
        result.unwrap(conn.send(to, take m))
    }
}

fn x_pipe(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64) waits {
    let (back, answers): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(PIPE_DEPTH, bytes room(PIPE_DEPTH, size)))
    let (take t, take peer) = start_echo(tasks, back, n, PIPE_DEPTH, size)
    let started = host.mono_ns(clock)
    let f = result.unwrap(task.spawn(tasks, bytes TASK_BYTES + 4 * (size + 64), Feeder(to: take peer, n: n, size: size), feeder))
    let mut check = 0u64
    for i in 0 .. n {
        let b = result.unwrap(conn.receive(answers))
        let got: u8 = b[0]
        if got != int.wrapping_add(int.truncate(i), 1u8) {
            fail("pipe: bad reply")
        }
        check = int.wrapping_add(check, int.widen(got))
    }
    let ns = host.mono_ns(clock) - started
    result.unwrap(task.join(take f))
    result.unwrap(task.join(take t))
    report(err, "x_pipe", n, ns, check)
}

// ---- fan-in: `producers` helper units each send n messages to the root.
type Source: cross {
    to: Client[Bytes],
    n: u64,
    size: u64
}

fn source(take s: Source) -> u64 waits {
    let Source(to: to, n: n, size: size) = take s
    let req = payload(size, 7)
    for i in 0 .. n {
        let mut m: Bytes = result.unwrap(list.with_capacity(size))
        result.unwrap(list.append(mut m, req))
        let _ = list.set(mut m, 0, int.truncate(i))
        result.unwrap(conn.send(to, take m))
    }
    n
}

fn x_fanin(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64, grain: u64, producers: u64) waits {
    let (to, inbox): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(64, bytes room(64, size)))
    let started = host.mono_ns(clock)
    let mut jobs: List[Task[u64]] = list.new()
    for _ in 0 .. producers {
        let s = Source(to: conn.client(to), n: n, size: size)
        result.unwrap(list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes HELPER_BYTES, take s, source))))
    }
    let mut check = 0u64
    for _ in 0 .. n * producers {
        let b = result.unwrap(conn.receive(inbox))
        let got: u8 = b[0]
        check = int.wrapping_add(check, kernel(int.widen(got), grain) & 0xff)
    }
    let ns = host.mono_ns(clock) - started
    join_all(take jobs)
    report(err, "x_fanin", n * producers, ns, check)
}

fn join_all(take pending: List[Task[u64]]) waits {
    let mut jobs = take pending
    while let Some(take h) = list.pop(mut jobs) {
        let _ = result.unwrap(task.join(take h))
    }
}

// ---- service: two helper units send words to one inbox; the root folds them
// in arrival order, which the check witnesses.
type Teller: cross {
    to: Client[u64],
    unit: u64,
    n: u64
}

fn teller(take t: Teller) -> u64 waits {
    let Teller(to: to, unit: unit, n: n) = take t
    for i in 0 .. n {
        result.unwrap(conn.send(to, (unit << 32) | i))
    }
    n
}

fn x_svc(tasks: Tasks, clock: Clock, err: Stderr, n: u64) waits {
    let (to, inbox): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(64, bytes 0))
    let started = host.mono_ns(clock)
    let mut jobs: List[Task[u64]] = list.new()
    for unit in 1u64 .. 3 {
        let t = Teller(to: conn.client(to), unit: unit, n: n)
        result.unwrap(list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes HELPER_BYTES, take t, teller))))
    }
    let mut state = 1u64
    let mut order = 0u64
    for i in 0 .. 2 * n {
        let v = result.unwrap(conn.receive(inbox))
        state = kernel(state ^ v, 3)
        // Count how often the source changes: an arrival-order witness.
        if i > 0 && (v >> 32) != order {
            state = int.wrapping_add(state, 1)
        }
        order = v >> 32
    }
    let ns = host.mono_ns(clock) - started
    join_all(take jobs)
    report(err, "x_svc", 2 * n, ns, state)
}

// ---- a closed lock-step ring of `units` units: unit u receives from its
// inbox and sends to unit (u+1) % units; the root, unit 0, injects each round.
type Stage: cross {
    hello: Client[Client[Bytes]],
    next: Client[Bytes],
    unit: u64,
    n: u64,
    size: u64
}

fn stage(take s: Stage) -> u64 waits {
    let Stage(hello: hello, next: next, unit: unit, n: n, size: size) = take s
    let (c, i): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(1, bytes room(1, size)))
    result.unwrap(conn.send(hello, take c))
    let mut check = 0u64
    for _ in 0 .. n {
        let mut buf = result.unwrap(conn.receive(i))
        let first: u8 = buf[0]
        let wide: u64 = int.widen(first)
        let _ = list.set(mut buf, 1, int.truncate(kernel(wide + unit, 50)))
        let second: u8 = buf[1]
        check = int.wrapping_add(check, int.widen(second))
        result.unwrap(conn.send(next, take buf))
    }
    check
}

fn x_ring(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64, units: u64) waits {
    let (first, inbox): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(1, bytes room(1, size)))
    let (hello, hello_in): (Client[Client[Bytes]], Inbox[Client[Bytes]]) = result.unwrap(conn.new(1, bytes 0))
    // Made last to first, each stage learns its successor's client.
    let mut next = conn.client(first)
    let mut stages: List[Task[u64]] = list.new()
    for k in 1u64 .. units {
        let s = Stage(hello: conn.client(hello), next: take next, unit: units - k, n: n, size: size)
        result.unwrap(list.push(mut stages, result.unwrap(task.spawn_unit(tasks, bytes HELPER_BYTES, take s, stage))))
        next = result.unwrap(conn.receive(hello_in))
    }
    let mut buf = payload(size, 0)
    let mut check = 0u64
    let started = host.mono_ns(clock)
    for i in 0 .. n {
        let _ = list.set(mut buf, 0, int.truncate(i))
        result.unwrap(conn.send(next, take buf))
        buf = result.unwrap(conn.receive(inbox))
        let second: u8 = buf[1]
        check = int.wrapping_add(check, int.widen(second))
    }
    let ns = host.mono_ns(clock) - started
    join_all(take stages)
    report(err, "x_ring", n, ns, check)
}

// ---- local channel shapes inside one run.
type Echo: send {
    input: Receiver[Bytes],
    output: Sender[Bytes],
    n: u64,
}

fn c_echo(take job: Echo) -> () waits {
    for _ in 0 .. job.n {
        let mut b = result.unwrap(channel.receive(job.input))
        let first: u8 = b[0]
        let _ = list.set(mut b, 0, int.wrapping_add(first, 1u8))
        result.unwrap(channel.send(job.output, take b))
    }
}

// cap 1: ping-pong; cap > 1 with a writer task: pipelined.
fn c_pingpong(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64) waits {
    let (tx, rx): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1))
    let (out, back): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1))
    let h = result.unwrap(task.spawn(tasks, bytes TASK_BYTES, Echo(input: take rx, output: take out, n: n), c_echo))
    let req = payload(size, 7)
    let mut check = 0u64
    let started = host.mono_ns(clock)
    for i in 0 .. n {
        // A fresh owned copy per message, as a crossing copies.
        let mut m: Bytes = result.unwrap(list.with_capacity(size))
        result.unwrap(list.append(mut m, req))
        let _ = list.set(mut m, 0, int.truncate(i))
        result.unwrap(channel.send(tx, take m))
        let b = result.unwrap(channel.receive(back))
        let got: u8 = b[0]
        if got != int.wrapping_add(int.truncate(i), 1u8) {
            fail("c_pingpong: bad reply")
        }
        check = int.wrapping_add(check, int.widen(got))
    }
    result.unwrap(task.join(take h))
    report(err, "c_pingpong", n, host.mono_ns(clock) - started, check)
}

type Feed: send {
    output: Sender[Bytes],
    n: u64,
    size: u64,
}

fn feed(take job: Feed) -> () waits {
    let req = payload(job.size, 7)
    for i in 0 .. job.n {
        let mut m: Bytes = result.unwrap(list.with_capacity(job.size))
        result.unwrap(list.append(mut m, req))
        let _ = list.set(mut m, 0, int.truncate(i))
        result.unwrap(channel.send(job.output, take m))
    }
}

fn c_pipe(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64, depth: u64) waits {
    let (tx, rx): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(depth))
    let (out, back): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(depth))
    let started = host.mono_ns(clock)
    // In-flight messages are charged to the tasks that allocated them.
    let budget = TASK_BYTES + 4 * depth * (size + 64)
    let e = result.unwrap(task.spawn(tasks, bytes budget, Echo(input: take rx, output: take out, n: n), c_echo))
    let f = result.unwrap(task.spawn(tasks, bytes budget, Feed(output: take tx, n: n, size: size), feed))
    let mut check = 0u64
    for i in 0 .. n {
        let b = result.unwrap(channel.receive(back))
        let got: u8 = b[0]
        if got != int.wrapping_add(int.truncate(i), 1u8) {
            fail("c_pipe: bad reply")
        }
        check = int.wrapping_add(check, int.widen(got))
    }
    result.unwrap(task.join(take f))
    result.unwrap(task.join(take e))
    report(err, "c_pipe", n, host.mono_ns(clock) - started, check)
}

fn c_fanin(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64, producers: u64, grain: u64) waits {
    let (tx, rx): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(64))
    let started = host.mono_ns(clock)
    let mut jobs: List[Task[()]] = list.new()
    for _ in 0 .. producers {
        result.unwrap(list.push(mut jobs, result.unwrap(task.spawn(tasks, bytes TASK_BYTES, Feed(output: channel.sender(tx), n: n, size: size), feed))))
    }
    let mut check = 0u64
    for _ in 0 .. n * producers {
        let b = result.unwrap(channel.receive(rx))
        let got: u8 = b[0]
        check = int.wrapping_add(check, kernel(int.widen(got), grain) & 0xff)
    }
    while let Some(take h) = list.pop(mut jobs) {
        result.unwrap(task.join(take h))
    }
    report(err, "c_fanin", n * producers, host.mono_ns(clock) - started, check)
}

pub fn main(tasks: Tasks, clock: Clock, err: Stderr, argv: Args) -> Result[(), Exit] waits {
    let Some(mode) = args.get(argv, 0) else {
        return Error(Exit(status: 2))
    }
    let n = arg(argv, 1)
    let size = arg(argv, 2)
    if mode == "c_pingpong" {
        c_pingpong(tasks, clock, err, n, size)
    } else if mode == "c_pipe" {
        c_pipe(tasks, clock, err, n, size, arg(argv, 3))
    } else if mode == "c_fanin" {
        c_fanin(tasks, clock, err, n, size, arg(argv, 3), arg(argv, 4))
    } else if mode == "x_pingpong" {
        x_pingpong(tasks, clock, err, n, size, if args.len(argv) > 3 {
            arg(argv, 3)
        } else {
            0
        })
    } else if mode == "x_pipe" {
        x_pipe(tasks, clock, err, n, size)
    } else if mode == "x_fanin" {
        x_fanin(tasks, clock, err, n, size, arg(argv, 3), arg(argv, 4))
    } else if mode == "x_svc" {
        x_svc(tasks, clock, err, n)
    } else if mode == "x_ring" {
        x_ring(tasks, clock, err, n, size, arg(argv, 3))
    } else {
        return Error(Exit(status: 2))
    }
    Ok(())
}

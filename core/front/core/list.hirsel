pub fn new[T]() -> List[T]
pub fn with_capacity[T](n: u64) -> Result[List[T], Capacity]
pub fn len[T](xs: List[T]) -> u64
pub fn capacity[T](xs: List[T]) -> u64
pub fn get[T](xs: List[T], i: u64) -> Option[View[T]] in xs
pub fn push[T](mut xs: List[T], take x: T) -> Result[(), (Capacity, T)]
pub fn pop[T](mut xs: List[T]) -> Option[T]
pub fn clear[T](mut xs: List[T])
pub fn append[T: plain](mut xs: List[T], ys: List[T]) -> Result[(), Capacity]

pub fn set[T](mut xs: List[T], i: u64, take x: T) -> T

pub fn reserve[T](mut xs: List[T], n: u64) -> Result[(), Capacity]

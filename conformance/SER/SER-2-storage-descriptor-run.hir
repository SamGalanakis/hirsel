// rule: SER-2
// expect: run
// codec.descriptor is the version-free descriptor and codec.descriptor_digest
// its SHA-256 digest. The bool descriptor is the one the SER-2 envelope vectors
// embed; the digests are those std's tables recorded in their schema history
// before the compiler emitted descriptors as static data.
fn digest(data: Bytes) -> Bytes uses {} {
  let d = sha256.digest(data)
  let mut out: List[u8] = []
  for i in 0u64..32u64 {
    list.push(mut out, d[i])
  }
  bytes.from_list(take out)
}

fn pinned[T: serializable](t: Test, none: Option[T], hex: String) -> () {
  let d = codec.descriptor(none)
  test.check(t, sha256.digest_hex(d) == hex)
  test.check(t, codec.descriptor_digest(none) == digest(d))
}

pub fn main(t: Test) -> Result[(), ()] {
  let flag: Option[bool] = None()
  test.check(
    t,
    codec.descriptor(flag) == b"\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00"
  )
  pinned(t, flag, "c1c28b6be00c08ed9a989445d270651b7502b24cceb08e651db9ac22c54cef37")
  let small: Option[u32] = None()
  pinned(t, small, "d47afae82809113dd2e1265404eb691ee760a429cad41cf7246e3fa622cd259a")
  let wide: Option[u64] = None()
  pinned(t, wide, "7b92ff2dc2554da0b3c06242650ac07b71640e03bdaf4ac6071c3a36fc521058")
  let pair: Option[(u32, String)] = None()
  pinned(t, pair, "8e622fe38afe42a080e3f94e8eb5ec5382707ee5deb38310f5e743153c70dc25")
  let raw: Option[Bytes] = None()
  pinned(t, raw, "c90cad87b15122611a4fbf675b1a28f6a33f9086f319eae87d228eb062d1037f")
  let signed: Option[i64] = None()
  pinned(t, signed, "eb1c9c2b1174c9c058709f6b2d6efd5c8a22903ad92760486605be0a2454237f")
  let nested: Option[Map[String, Option[Option[u8]]]] = None()
  pinned(t, nested, "60ea06f5f43c0803eba27a29531ba38bff9960c9498c8e46a47c1c900264525e")
  let mixed: Option[(Bytes, f32, Set[u16], Inline[u8, 4])] = None()
  pinned(t, mixed, "07975ab869e65753399d55c4a13470f5a50185835be13a86ad4764409b4339c0")
  Ok(())
}

const CLAIM_RECOVER_MS: u64 = 1000

const CLAIM_RECOVER_MAX: u8 = 3

type ClaimMember: shareable + send {
    refusals: u8,
    queued: Option[u64]
}

type ClaimQueue {
    members: std.omap.OMap[Bytes, ClaimMember],
    fifo: std.omap.OMap[u64, Bytes],
    next_sequence: u64,
    stamps: u64
}

fn new_claim_queue() -> ClaimQueue {
    ClaimQueue(members: std.omap.new(), fifo: std.omap.new(), next_sequence: 0, stamps: 0)
}

fn claim_map_bytes(n: u64, slot_width: u64) -> Option[u64] {
    let leaves = n / 16 + (if n % 16 == 0 {
        0u64
    } else {
        1u64
    })
    let nodes = int.checked_mul(2, leaves)?
    let backing = int.checked_mul(nodes, 104 + 32 * slot_width)?
    int.checked_add(backing, int.checked_mul(n, 392)?)
}

fn claim_recovery_bytes(n: u64) -> Option[u64] {
    let maps = int.checked_add(claim_map_bytes(n, 24 + 24)?, claim_map_bytes(n, 8 + 24)?)?
    let timer = charge.task(bytes[()], 4096)?
    int.checked_add(int.checked_add(maps, timer)?, recovery_inbox_slot())
}

fn recovery_inbox_slot() -> u64 {
    option.unwrap(charge.channel(bytes[HeadInput], 1)) - option.unwrap(charge.channel(bytes[HeadInput], 0))
}

fn set_claim_member(mut queue: ClaimQueue, key: Bytes, member: ClaimMember) {
    let previous = replace(mut queue.members, std.omap.new())
    let (take members, _) = std.omap.insert_owned(mut queue.stamps, take previous, clone(key), member)
    queue.members = take members
}

fn claim_member(queue: ClaimQueue, key: Bytes) -> ClaimMember {
    match std.omap.get(queue.members, key) {
        Some(member) => clone(member),
        None => ClaimMember(refusals: 0, queued: None),
    }
}

fn enqueue_recovery(mut queue: ClaimQueue, key: Bytes) {
    let member = claim_member(queue, key)
    if member.queued != None {
        return
    }
    let sequence = queue.next_sequence
    queue.next_sequence += 1
    let previous = replace(mut queue.fifo, std.omap.new())
    let (take fifo, _) = std.omap.insert_owned(mut queue.stamps, take previous, sequence, clone(key))
    queue.fifo = take fifo
    set_claim_member(mut queue, key, ClaimMember(refusals: member.refusals, queued: Some(sequence)))
}

fn dequeue_recovery(mut queue: ClaimQueue) -> Option[Bytes] {
    let front: Option[(u64, Bytes)] = match std.omap.first(queue.fifo) {
        Some((sequence, key)) => Some((sequence, clone(key))),
        None => None,
    }
    let Some((sequence, take key)) = take front else {
        return None
    }
    queue.fifo = std.omap.remove(mut queue.stamps, queue.fifo, sequence)
    let member = claim_member(queue, key)
    set_claim_member(mut queue, key, ClaimMember(refusals: member.refusals, queued: None))
    Some(take key)
}

fn recovery_refused(mut queue: ClaimQueue, key: Bytes) -> bool {
    let member = claim_member(queue, key)
    if let Some(sequence) = member.queued {
        queue.fifo = std.omap.remove(mut queue.stamps, queue.fifo, sequence)
    }
    let refused = member.refusals + 1
    set_claim_member(mut queue, key, ClaimMember(refusals: refused, queued: None))
    if refused == CLAIM_RECOVER_MAX {
        return true
    }
    enqueue_recovery(mut queue, key)
    false
}

fn recovery_replied(mut queue: ClaimQueue, key: Bytes) {
    let member = claim_member(queue, key)
    if let Some(sequence) = member.queued {
        queue.fifo = std.omap.remove(mut queue.stamps, queue.fifo, sequence)
    }
    queue.members = std.omap.remove(mut queue.stamps, queue.members, key)
}

type ClaimRecoveryTimer: send {
    clock: Clock,
    inbox: Sender[HeadInput]
}

fn tick_claim_recovery(take timer: ClaimRecoveryTimer) -> () waits {
    loop {
        std.clock.sleep_ns(timer.clock, CLAIM_RECOVER_MS * 1000000)
        if let Error(Closed(_)) = channel.try_send(timer.inbox, RecoveryTick) {
            return
        }
    }
}

type ClaimRun {
    claim: Bytes,
    entry: Bytes,
    caller: Caller,
    arguments: Bytes,
    deadline: u64,
    waiters: List[Request],
    background: bool
}

type ParkedRecovery {
    run: ClaimRun,
    served: store.Parked
}

type RecoverClaims {
    queue: ClaimQueue,
    parked: List[ParkedRecovery],
    sweep: store.ClaimSweep
}

fn recovery_registered[G: send, H: shareable + inert + send](reg: Registry[G, H], origin: Bytes, stored: Bytes) -> bool {
    if !list.starts_with_at(stored, 0, origin) {
        // A stamped foreign op stays inert. A live unscoped op has unknown
        // origin and must refuse open before its delivery can be admitted again.
        return list.len(stored) >= 17 && stored[0] == 0
    }
    match claim_operation_name(stored) {
        Ok(name) => map.contains(reg.t.keyed, name),
        Error(_) => false,
    }
}

fn startup_claims[G: send, H: shareable + inert + send](mut db: store.Db, reg: Registry[G, H]) -> Result[Option[Box[RecoverClaims]], OpenError] waits {
    check_keyed_registrations(db, reg)?
    let origin = claim_origin(db)
    let dropped = store.check_dropped_claim_ops(mut db, scoped fn(op: Bytes) -> bool {
        recovery_registered(reg, origin, op)
    }) ?=> Store
    if let Some(take gone) = take dropped {
        if !list.starts_with_at(gone.op, 0, origin) {
            return Error(KeyedOpDropped(take gone))
        }
        let name = claim_operation_name(gone.op) ?=> Store
        return Error(KeyedOpDropped(store.DroppedClaimOp(op: take name, last_expiry: gone.last_expiry)))
    }
    let mut scan = store.open_claim_cursor(db)
    let mut queue = new_claim_queue()
    while let Some(take claim) = store.next_open_claim(mut scan) {
        // The Store cursor returns length-prefixed operation keys.
        if list.starts_with_at(claim, 1, origin) {
            enqueue_recovery(mut queue, claim)
        }
    }
    if map.len(reg.t.keyed) == 0 && !store.has_keyed_ops(db) {
        return Ok(None)
    }
    Ok(Some(box.new(RecoverClaims(queue: take queue, parked: list.new(), sweep: store.claim_sweep_start()))))
}

fn claim_run_record(activation: KeyedEntryRecord, arguments: Bytes, revision: Option[Bytes], replay_identity: Bytes) -> Result[store.KeyedCallRecord, store.Error] {
    let encoding = code_bytes(activation.n_e, activation.s_e, replay_identity) ?=> |problem| Full(Allocation(problem))
    Ok(store.KeyedCallRecord(entry: copy_bytes(activation.entry)?, args: copy_bytes(arguments)?, revision: clone(revision), code: take encoding))
}

fn finish_recovered[G: send, H: shareable + inert + send](mut hd: Head[G, H], mut queue: ClaimQueue, claim: Bytes, settled: store.Receipt) {
    recovery_replied(mut queue, claim)
    let at = publisher_base(hd.db, hd.publish_images)
    list.push(mut hd.held, Sealed(settled.ticket, take at, list.new()))
}

fn answer_claim_waiters[G: send, H: shareable + inert + send](mut hd: Head[G, H], take waiters: List[Request], outcome: Outcome, expires: Option[u64]) -> Result[(), store.Error] waits {
    for take request in waiters {
        publish_reply_with_expiry(mut hd, take request, clone(outcome), false, expires)?
    }
    Ok(())
}

fn finish_claim_run[G: send, H: shareable + inert + send](mut hd: Head[G, H], mut queue: ClaimQueue, take run: ClaimRun, take receipt: store.Receipt) -> Result[(), store.Error] waits {
    finish_recovered(mut hd, mut queue, run.claim, receipt)
    if list.len(run.waiters) == 0 {
        return Ok(())
    }
    let codec: std.codec.Codec[Outcome] = std.codec.of()
    let outcome = std.codec.decode(codec, receipt.reply) ?=> |take problem| Decode(take problem)
    let expires = store.claim_reply_expiry(hd.db, run.claim)?
    let ClaimRun(waiters: take waiters, ..) = take run
    answer_claim_waiters(mut hd, take waiters, outcome, expires)
}

fn conclude_recovered[G: send, H: shareable + inert + send](mut hd: Head[G, H], mut queue: ClaimQueue, take run: ClaimRun, take pending_run: store.Pending, outcome: Outcome) -> Result[(), store.Error] waits {
    let reply_bytes = encode_runner_reply(outcome)?
    match store.conclude(mut hd.db, take pending_run, take reply_bytes, Claim) {
        Ok(Committed(take settled)) => finish_claim_run(mut hd, mut queue, take run, take settled),
        Ok(NoRoom(_, problem)) => Error(Full(problem)),
        Error(Before(take problem, _)) => Error(take problem),
        Error(After(take problem)) => Error(take problem),
        _ => fail("runner: invalid recovery conclusion"),
    }
}

fn recovery_settlement[G: send, H: shareable + inert + send](mut hd: Head[G, H], mut state: RecoverClaims, take run: ClaimRun, take result: Result[store.Served, store.ServeError]) -> Result[(), store.Error] waits {
    match take result {
        Ok(Committed(take receipt)) => finish_claim_run(mut hd, mut state.queue, take run, take receipt),
        Ok(Kept(take receipt)) => finish_claim_run(mut hd, mut state.queue, take run, take receipt),
        Ok(Failed(take pending_run, stop)) => conclude_recovered(mut hd, mut state.queue, take run, take pending_run, failed_stop(stop)?),
        Ok(NoRoom(take pending_run, problem)) => {
            if recovery_refused(mut state.queue, run.claim) {
                let shortfall = store_capacity(problem)
                conclude_recovered(mut hd, mut state.queue, take run, take pending_run, Failed(OutOfBytes(Room(requested: shortfall.requested, available: shortfall.available))))
            } else {
                let ClaimRun(waiters: take waiters, ..) = take run
                answer_claim_waiters(mut hd, take waiters, Refused(Overloaded), None)
            }
        },
        Ok(Parked(take served)) => {
            list.push(mut state.parked, ParkedRecovery(run: take run, served: take served))
            Ok(())
        },
        Error(Before(Full(_), _)) => {
            enqueue_recovery(mut state.queue, run.claim)
            let ClaimRun(waiters: take waiters, ..) = take run
            answer_claim_waiters(mut hd, take waiters, Refused(Overloaded), None)
        },
        Error(Before(take problem, _)) => Error(take problem),
        Error(After(take problem)) => Error(take problem),
    }
}

fn run_claim_recovery[G: send, H: shareable + inert + send](mut hd: Head[G, H], mut state: RecoverClaims, take named: Bytes, take recovery: store.ClaimRecovery, take request: Option[Request]) -> Result[(), store.Error] waits {
    let decoder: std.codec.Codec[KeyedEntryRecord] = std.codec.of()
    let activation = std.codec.decode(decoder, store.recovery_policy(recovery).record) ?=> |take problem| Decode(take problem)
    let store.ClaimRecovery(claim: take claim, arguments: take arguments, completion: take completion) = take recovery
    let store.ClaimKey(caller: take caller, op: take op, ..) = take claim
    let initial = std.clock.deadline_after_ms(host.mono_ns(store.claim_clock(hd.db)), activation.deadline_ms)
    let background = none(request)
    let mut waiters: List[Request] = list.new()
    let deadline = if let Some(take first) = take request {
        let at = first.deadline
        list.push(mut waiters, take first)
        at
    } else {
        initial
    }
    let mut run = ClaimRun(claim: take named, entry: clone(activation.entry), caller: take caller, arguments: take arguments, deadline: deadline, waiters: take waiters, background: background)
    let live = match map.get(hd.r.t.keyed, claim_operation_name(op)?) {
        Some(KeyedRegistration(policy: Some(_), ..)) => true,
        _ => false,
    }
    if live {
        let transactional = match map.get(hd.r.slots, activation.entry) {
            Some(Transact(..)) => true,
            _ => false
        }
        if transactional {
            let ran = {
                let Some(Transact(_, _, revision, _, go)) = map.get(hd.r.slots, activation.entry) else {
                    fail("runner: a keyed entry's slot was removed")
                }
                let record = claim_run_record(activation, run.arguments, revision, hd.replay_identity)?
                let plan = store.Plan(n_e: activation.n_e, s_e: activation.s_e, reply_max: store.CLAIM_DONE_MAX)
                let no_record: Option[store.CallRecord] = None
                (go.serve)(mut hd.db, store.keyed_completion(take completion, take record), plan, take no_record, hd.h, run.caller, mut run.arguments)
            }
            return recovery_settlement(mut hd, mut state, take run, take ran)
        }
    }
    let record = claim_run_record(activation, run.arguments, None, hd.replay_identity)?
    let untried = store.untried(store.keyed_completion(take completion, take record), None, store.next_call_info(hd.db))
    conclude_recovered(mut hd, mut state.queue, take run, take untried, Failed(Gone))
}

fn recovery_turn[G: send, H: shareable + inert + send](mut hd: Head[G, H], mut state: RecoverClaims) -> Result[(), store.Error] waits {
    let mut background = false
    for pending in state.parked {
        if pending.run.background {
            background = true;
            break
        }
    }
    if !background {
        if let Some(take named) = dequeue_recovery(mut state.queue) {
            if let Some(take recovery) = store.recover_claim(hd.db, named)? {
                if none(parked_claim_index(state, named)) {
                    run_claim_recovery(mut hd, mut state, take named, take recovery, None)?
                }
            } else {
                recovery_replied(mut state.queue, named)
            }
        }
    }
    let reg = view hd.r
    let origin = claim_origin(hd.db)
    let swept = store.sweep_claims(mut hd.db, mut state.sweep, scoped fn(op: Bytes) -> bool {
        recovery_registered(reg, origin, op)
    })
    match take swept {
        Ok(_) => Ok(()),
        Error(Full(_)) => Ok(()),
        Error(take problem) => Error(take problem),
    }
}

fn parked_claim_index(state: RecoverClaims, name: Bytes) -> Option[u64] {
    for i in 0u64 .. list.len(state.parked) {
        if state.parked[i].run.claim == name {
            return Some(i)
        }
    }
    None
}

fn start_keyed_request[G: send, H: shareable + inert + send](mut hd: Head[G, H], mut state: RecoverClaims, take request: Request) -> Result[(), store.Error] waits {
    let policies: Option[Option[store.KeyedPolicy]] = match map.get(hd.r.t.keyed, request.key) {
        Some(registration) => Some(clone(registration.policy)),
        None => None,
    }
    let Some(take offered) = take policies else {
        return commitless(mut hd, take request, Refused(NoEntry))
    }
    let name = {
        let Some(raw_key) = view request.claim else {
            fail("runner: keyed request has no claim key")
        }
        store.ClaimKey(op: claim_operation(claim_origin(hd.db), request.key), caller: clone(request.caller), key: clone(raw_key))
    }
    let answer = match store.admit_claim(mut hd.db, name, request.digest, request.arg, take offered) {
        Ok(take admission) => take admission,
        Error(Full(_)) => return commitless(mut hd, take request, Refused(Overloaded)),
        Error(take problem) => return Error(take problem),
    }
    match take answer {
        Mismatch => commitless(mut hd, take request, Refused(RequestMismatch)),
        MissingClaim => commitless(mut hd, take request, Failed(Gone)),
        Duplicate(take saved) => {
            let codec: std.codec.Codec[Outcome] = std.codec.of()
            let response = std.codec.decode(codec, saved) ?=> |take problem| Decode(take problem)
            let expires = store.claim_reply_expiry(hd.db, store.claim_key_bytes(name)?)?
            publish_reply_with_expiry(mut hd, take request, take response, true, expires)
        },
        _ => {
            let claim_address = store.claim_key_bytes(name)?
            if let Some(index) = parked_claim_index(state, claim_address) {
                list.push(mut state.parked[index].run.waiters, take request)
                return Ok(())
            }
            let Some(take recovery) = store.recover_claim(hd.db, claim_address)? else {
                fail("runner: newly admitted claim is open")
            }
            run_claim_recovery(mut hd, mut state, take claim_address, take recovery, Some(take request))
        },
    }
}

fn begin_keyed_request[G: send, H: shareable + inert + send](mut hd: Head[G, H], take request: Request) -> Result[(), store.Error] waits {
    if host.mono_ns(store.claim_clock(hd.db)) >= request.deadline {
        return commitless(mut hd, take request, Refused(Deadline))
    }
    let Some(take boxed) = replace(mut hd.recovery, None) else {
        return commitless(mut hd, take request, Refused(NoEntry))
    }
    close_group(mut hd)
    let mut state = box.unbox(take boxed)
    let outcome = start_keyed_request(mut hd, mut state, take request)
    hd.recovery = Some(box.new(take state))
    take outcome
}

fn keyed_work_pending[G: send, H: shareable + inert + send](head: Head[G, H]) -> bool {
    if let Some(state) = view head.recovery {
        return list.len(state.parked) > 0 || std.omap.len(state.queue.fifo) > 0
    }
    false
}

fn close_keyed_admission[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[(), store.Error] waits {
    let Some(take boxed) = replace(mut hd.recovery, None) else {
        return Ok(())
    }
    let RecoverClaims(parked: take parked, ..) = box.unbox(take boxed)
    for take entry in take parked {
        let ParkedRecovery(run: ClaimRun(waiters: take waiters, ..), served: take served) = take entry
        let _ = store.cancel_parked(mut hd.db, take served)
        answer_claim_waiters(mut hd, take waiters, Refused(Overloaded), None)?
    }
    Ok(())
}

fn advance_recovery[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[(), store.Error] waits {
    let latest = replace(mut hd.recovery, None)
    let Some(take active) = take latest else {
        return Ok(())
    }
    let mut state = box.unbox(take active)
    close_group(mut hd)
    let ran = recovery_turn(mut hd, mut state)
    hd.recovery = Some(box.new(take state))
    take ran
}

fn resume_recovery[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    let next = {
        let Some(active) = view hd.recovery else {
            return Ok(false)
        }
        if list.len(active.parked) == 0 {
            return Ok(false)
        }
        let ready = store.poll_parked(mut hd.db)?
        let now = host.mono_ns(store.claim_clock(hd.db))
        let mut found: Option[(u64, bool)] = None
        for i in 0u64 .. list.len(active.parked) {
            let parked = view active.parked[i]
            let timed_out = now >= parked.run.deadline
            if timed_out || list.contains(ready, store.park_id(parked.served)) {
                found = Some((i, timed_out))
                break
            }
        }
        found
    }
    let Some((index, timed_out)) = next else {
        return Ok(false)
    }
    let mut state = box.unbox(option.unwrap(replace(mut hd.recovery, None)))
    let ParkedRecovery(run: take run, served: take parked_call) = list.remove(mut state.parked, index)
    close_group(mut hd)
    let ran: Result[(), store.Error] = if timed_out {
        let _ = store.cancel_parked(mut hd.db, take parked_call)
        enqueue_recovery(mut state.queue, run.claim)
        let ClaimRun(waiters: take waiters, ..) = take run
        answer_claim_waiters(mut hd, take waiters, Abandoned, None)
    } else {
        let served = match map.get(hd.r.slots, run.entry) {
            Some(Transact(_, _, _, _, go)) => (go.resume)(mut hd.db, take parked_call, hd.h, run.caller, run.arguments),
            _ => fail("runner: a parked keyed call's entry is registered"),
        }
        recovery_settlement(mut hd, mut state, take run, take served)
    }
    hd.recovery = Some(box.new(take state))
    ran?
    Ok(true)
}

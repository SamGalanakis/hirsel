// Module `tape` (CAP-9): recording a domain's provider operations, and replaying
// them with no host. REPLAY-SPEC v2.3 slice S1: Run tapes, Record and Replay, and
// substitutes for Clock, Dir, Stdout, Stderr and Args.
// Record writes a new tape (the name must not exist); Replay answers every
// operation from one and never reaches the host. Across is a Replay that also
// opens a tape recorded by another code revision; `across` says it did.
pub type Mode = Record | Replay | Across

// A Run tape's header. `id` is the tape's id, unique per tape file; `identity` the
// code's identity; `arg` the run's argument bytes; `limit` its root limit. The
// revision is not the caller's: open fills it with the entry's code revision,
// which a rebuild or another engine keeps and a changed reachable body changes.
pub type Header {
    id: (u64, u64),
    identity: String,
    arg: Bytes,
    limit: u64
}

// Open refuses, before anything runs, a tape whose identity (Code), revision
// (except Across), argument or limit differs from the opener's, or whose header
// block is damaged.
pub type OpenError = Refused(Refusal) | Io(IoError)

pub type Refusal = Code | Revision | Arg | Limit | Damaged(u64)

// A tape ends Sealed, or with the fault that stopped it. A replay that diverged
// names the frame it was checked against (its position after the header).
pub type End = Sealed | Faulted(Fault)

pub type Fault = Diverged(Divergence) | Truncated(u64) | Damaged(u64) | Corrupt | Io(IoError)

pub type Divergence {
    at: u64,
    kind: Mismatch
}

pub type Mismatch = Op | Object | Arg | Missing | Extra | Outcome | Schedule

// Opens the tape `name` in `d`. Replay compares the header with the stored one.
pub fn open(d: Dir, name: String, mode: Mode, header: Header) -> Result[Tape, OpenError] waits {
    let (id0, id1) = header.id
    match open_raw(d, name, mode, header.identity, header.arg, header.limit, id0, id1) {
        Ok(take t) => Ok(take t),
        Error(code) => Error(open_error(code))
    }
}

// Ends the tape with its domain's outcome: the returned bytes (a Run's exit status
// as u32 little-endian), or the causes it failed or was cancelled with. Record
// seals the tape; Replay requires the same outcome, or the tape ends Diverged
// (Outcome). Every substitute made through it fails with cause `Tape` from here.
pub fn end(take t: Tape, outcome: Result[Bytes, JoinError]) -> End waits {
    let code = match outcome {
        Ok(b) => end_returned(take t, b),
        Error(Failed(c)) => end_causes(take t, 1, c),
        Error(Cancelled(c)) => end_causes(take t, 2, c)
    }
    ending(code)
}

// The substitute for a capability on the tape: every operation on it, or on a
// HostFile or Dir made through it, is recorded (Record) or answered from the tape
// (Replay). Fails with `Tape` when the tape has ended or faulted, or a replayed
// tape's next frame is not this grant.
pub fn clock(mut t: Tape, c: Clock) -> Clock

pub fn dir(mut t: Tape, d: Dir) -> Dir

pub fn stdout(mut t: Tape, s: Stdout) -> Stdout

pub fn stderr(mut t: Tape, s: Stderr) -> Stderr

pub fn tasks(mut t: Tape, ts: Tasks) -> Tasks

// Args's substitute reads the recorded vector, also after the tape ends: reading
// it is not an operation.
pub fn args(mut t: Tape, a: Args) -> Args

// Whether `t` was opened Across a tape another code revision recorded. A run that
// replays such a tape reports it as such; a changed outcome still ends Diverged.
pub fn across(t: Tape) -> bool

// The runtime's words (tape/abi.rs): bits 0-7 a tag, 8-15 a sub-kind, 16-63 a value.
fn open_raw(d: Dir, name: String, mode: Mode, identity: String, arg: Bytes, limit: u64, id0: u64, id1: u64) -> Result[Tape, u64] waits

fn end_returned(take t: Tape, b: Bytes) -> u64 waits

fn end_causes(take t: Tape, kind: u8, c: Causes) -> u64 waits

fn io_error(sub: u64, value: u64) -> IoError {
    if sub == 1 {
        NotFound
    } else if sub == 2 {
        Denied
    } else if sub == 3 {
        Exists
    } else if sub == 4 {
        Closed
    } else {
        Other(int.truncate(value))
    }
}

fn open_error(code: u64) -> OpenError {
    let sub = (code >> 8) & 0xffu64
    let value = code >> 16
    if code & 0xffu64 == 2 {
        return Io(io_error(sub, value))
    }
    Refused(if sub == 0 {
        Code
    } else if sub == 1 {
        Revision
    } else if sub == 2 {
        Arg
    } else if sub == 3 {
        Limit
    } else {
        Damaged(value)
    })
}

fn ending(code: u64) -> End {
    let tag = code & 0xffu64
    let sub = (code >> 8) & 0xffu64
    let value = code >> 16
    if tag == 0 {
        return Sealed
    }
    Faulted(if tag == 1 {
        Diverged(Divergence(at: value, kind: if sub == 0 {
            Op
        } else if sub == 1 {
            Object
        } else if sub == 2 {
            Arg
        } else if sub == 3 {
            Missing
        } else if sub == 4 {
            Extra
        } else if sub == 5 {
            Outcome
        } else {
            Schedule
        }))
    } else if tag == 2 {
        Truncated(value)
    } else if tag == 3 {
        Damaged(value)
    } else if tag == 4 {
        Corrupt
    } else {
        Io(io_error(sub, value))
    })
}

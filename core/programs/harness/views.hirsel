// Module harness: views. The transcript lines and status a reader sees, and the
// ACL-checked windows over them.
fn line(e: Entry) -> Option[View] {
    match e {
        User(text) => Some(Line("user", clone(text))),
        Inform(text) => Some(Line("info", clone(text))),
        Assistant(answer) => Some(Line("assistant", clone(answer.text))),
        ToolResult(id, _, _) => Some(Line("tool", clone(id))),
        _ => None,
    }
}

fn status(mut tx: store.Tx, h: Handles, take text: String) -> Result[(), Refused] {
    kept(store.put(mut tx, h.views, 0u64, Status(take text)))
}

// Writes the status only when it changes, so a watcher sees no empty update.
fn show_status(mut tx: store.Tx, h: Handles, take text: String) -> Result[(), Refused] {
    if let Some(Status(current)) = kept(store.fetch(tx, h.views, 0u64))? {
        if current == text {
            return Ok(())
        }
    }
    status(mut tx, h, take text)
}

// ---- reads ----
// Trusted application code changes membership in the same store the window reads.
pub fn set_reader(mut tx: store.Tx, h: Handles, caller: store.Caller, allowed: bool) -> Result[(), Refused] {
    let Ok(take key) = reader_key(caller) else {
        return Error(Malformed("reader identity"))
    }
    if allowed {
        kept(store.put(mut tx, h.readers, take key, true))
    } else {
        let _ = kept(store.delete(mut tx, h.readers, take key))?
        Ok(())
    }
}

fn reader_key(caller: store.Caller) -> Result[Bytes, Capacity] {
    let mut key: Bytes = list.new()
    runner.caller_key(caller, mut key)?
    Ok(take key)
}

// The transcript rows a reader asks for. Row 0 is the status and row p + 1 is entry
// p's line. `Status` is row 0 alone. `Tail(n)` is the last n line rows; its cover moves
// with each append, so a reader takes one image of it to learn where to start and then
// follows `From(first)`, every row from `first` on. `Page(before, n)`
// is rows from `page_from(before, n)` up to `before`: a reader pins `before` at its
// oldest held row, so later appends never move a page. Rows are sparse, so a page can be
// short or empty before the first row; a reader stops when `page_from` reaches 1.
pub type Window: codec + send = Status | Tail(u64) | From(u64) | Page(u64, u64) | Transcript | PendingTurn

pub fn page_from(before: u64, lines: u64) -> u64 {
    if before > lines + 1u64 {
        before - lines
    } else {
        1u64
    }
}

// Register with query_as so the membership read is tracked for this Caller.
fn shown_table(h: Handles) -> store.Table[u64, View] { clone(h.views) }

pub fn window_slots() -> Result[runner.Slots[Handles], runner.RegisterError] {
    runner.table_slot("window", code.describe(shown_table))
}

fn cut_table(h: Handles) -> store.Table[u64, u64] { clone(h.fork_cuts) }

pub fn cut_slots() -> Result[runner.Slots[Handles], runner.RegisterError] {
    runner.table_slot("cuts", code.describe(cut_table))
}

pub fn window(tx: store.Tx, h: Handles, caller: store.Caller, take w: Window) -> Result[runner.Answer[()], Capacity] {
    let t = view h.views
    if reader_allowed(tx, h, caller)? {
        return visible_window(tx, h, w)
    }
    runner.table_answer("window", t, Included(0u64), Excluded(0u64))
}

pub fn reader_allowed(tx: store.Tx, h: Handles, caller: store.Caller) -> Result[bool, Capacity] {
    let key = reader_key(caller)?
    Ok(match store.fetch(tx, h.readers, take key) {
        Ok(Some(true)) => true,
        _ => false,
    })
}

// Finds cuts inside the requested page. The page starts at the newest cut,
// then its cursor moves into the pinned predecessor on the next request.
pub fn history_cuts(tx: store.Tx, h: Handles, caller: store.Caller, take range: (u64, u64)) -> Result[runner.Answer[()], Capacity] {
    let t = view h.fork_cuts
    if reader_allowed(tx, h, caller)? {
        return runner.table_answer("cuts", t, Included(range.0), Excluded(range.1))
    }
    runner.table_answer("cuts", t, Included(0u64), Excluded(0u64))
}

fn visible_window(tx: store.Tx, h: Handles, w: Window) -> Result[runner.Answer[()], Capacity] {
    let t = view h.views
    match w {
        Status => runner.table_answer("window", t, Included(0u64), Included(0u64)),
        PendingTurn => {
            // The status row is a presence marker. The queued message is not part of the transcript yet.
            match queue_empty(tx, h) {
                Ok(false) => runner.table_answer("window", t, Included(0u64), Included(0u64)),
                Ok(true) => runner.table_answer("window", t, Included(0u64), Excluded(0u64)),
                Error(_) => fail("cannot read the pending turn"),
            }
        },
        Transcript => runner.table_answer("window", t, Unbounded, Unbounded),
        Tail(n) => {
            let next = match store.fetch(tx, h.session, 0u64) {
                Ok(Some(s)) => s.next_pos + 1u64,
                _ => 1u64
            }
            runner.table_answer("window", t, Included(page_from(next, n)), Unbounded)
        },
        From(first) => runner.table_answer("window", t, Included(if first == 0u64 {
            1u64
        } else {
            first
        }), Unbounded),
        Page(before, n) => runner.table_answer("window", t, Included(page_from(before, n)), Excluded(before)),
    }
}

fn by_tens(a: u64, b: u64) -> Order {
    order.compare(a / 10, b / 10)
}

// Four accumulators and all tail lengths. 0 + 1 + ... + 6 = 21.
// expect: run sum_bytes_tails() = 21
fn sum_bytes_tails() -> u64 {
    let mut xs: Bytes = list.new()
    for i in 0u8 .. 7 {
        list.push(mut xs, i)
    }
    list.sum_bytes(list.slice(xs, 0, 4)) + list.sum_bytes(list.slice(xs, 4, 7))
}

// All four accumulator tails, including empty input.
// expect: run sum_bytes_tail_lengths() = true
fn sum_bytes_tail_lengths() -> bool {
    let mut xs: Bytes = list.new()
    list.fill(mut xs, 7, 255)
    let mut n: u64 = 0
    while n <= 7 {
        if list.sum_bytes(list.slice(xs, 0, n)) != 255 * n {
            return false
        }
        n += 1
    }
    true
}

// Both indices are checked even when equal; the same-index fast path must not
// turn an out-of-range access into a successful no-op.
// expect: run swap_equal_out_of_bounds() = fail Bounds
fn swap_equal_out_of_bounds() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap(mut xs, 5, 5)
    digits(xs)
}

// The first index is independently checked before the exchange.
// expect: run swap_first_out_of_bounds() = fail Bounds
fn swap_first_out_of_bounds() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap(mut xs, 5, 0)
    digits(xs)
}

// Owning elements exchange their whole carriers, without a cleanup or clone.
// expect: run swap_owned_carriers() = true
fn swap_owned_carriers() -> bool {
    let mut xs: List[String] = list.new()
    list.push(mut xs, string.from("first"))
    list.push(mut xs, string.from("second"))
    list.swap(mut xs, 0, 1)
    xs[0] == "second" && xs[1] == "first"
}

// expect: run swap_zero_sized() = 2
fn swap_zero_sized() -> u64 {
    let mut xs: List[()] = list.new()
    list.push(mut xs, ())
    list.push(mut xs, ())
    list.swap(mut xs, 0, 1)
    list.len(xs)
}

// A zero-sized element has no storage to bound a length, so appending two lists of
// 2^63 units overflows the count and raises Capacity.
// expect: run append_zero_sized_count_overflows() = true
fn append_zero_sized_count_overflows() -> bool {
    let r = isolate(fn() -> Result[u64, Capacity] {
        let mut xs: List[()] = list.new()
        let mut ys: List[()] = list.new()
        list.fill(mut xs, 9223372036854775808, ())
        list.fill(mut ys, 9223372036854775808, ())
        list.append(mut xs, ys)
        Ok(list.len(xs))
    })
    match caught(take r) {
        Some(_) => true,
        None => false,
    }
}

// Search only the tens key, not the whole value, retaining the first equal index.
// expect: run search_by_key() = 1
fn search_by_key() -> u64 {
    let xs = five(10, 21, 22, 24, 30)
    result.unwrap(list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x / 10, 2)
    }))
}

// Exact insertion indices before, between and after keys; a callback using the
// opposite operand order changes these results.
// expect: run search_by_insertions() = 35
fn search_by_insertions() -> u64 {
    let xs = five(10, 20, 30, 40, 50)
    let a = match list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x, 5)
    }) {
        Error(i) => i,
        _ => 99
    }
    let b = match list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x, 35)
    }) {
        Error(i) => i,
        _ => 99
    }
    let c = match list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x, 55)
    }) {
        Error(i) => i,
        _ => 99
    }
    a * 100 + b * 10 + c
}

// Empty search must not call the comparator.
// expect: run search_by_empty() = 0
fn search_by_empty() -> u64 {
    let xs: List[u64] = list.new()
    match list.binary_search_by(xs, fn(x: u64) -> Order {
        fail("empty comparator")
    }) {
        Error(i) => i,
        _ => 99,
    }
}

// Captured key is viewed, and equal runs still resolve to their first position.
// expect: run search_by_capture() = 0
fn search_by_capture() -> u64 {
    let xs = five(7, 7, 7, 7, 7)
    let key: u64 = 7
    result.unwrap(list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x, key)
    }))
}

// Huffman nodes need not be ordered: the callback reads frequency alone.
// expect: run search_by_unordered_record() = 1
fn search_by_unordered_record() -> u64 {
    let mut xs: List[Box[SearchNode]] = list.new()
    list.push(mut xs, box.new(SearchNode(frequency: 1, name: true)))
    list.push(mut xs, box.new(SearchNode(frequency: 3, name: false)))
    list.push(mut xs, box.new(SearchNode(frequency: 3, name: true)))
    result.unwrap(list.binary_search_by(xs, fn(x: Box[SearchNode]) -> Order {
        order.compare(x.frequency, 3)
    }))
}

type SearchNode {
    frequency: u64,
    name: bool
}

// get_or reads xs[i] inside the list and x from len on, including an empty list and the
// largest index: [7, 8] gives 7, 8, then 5, 5; the empty list gives 5. Read as digits.
// expect: run get_or_edges() = 78555
fn get_or_edges() -> u64 {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 7)
    list.push(mut xs, 8)
    let none: List[u64] = list.new()
    let a = list.get_or(xs, 0, 5)
    let b = list.get_or(xs, 1, 5)
    let c = list.get_or(xs, 2, 5)
    let d = list.get_or(xs, 18446744073709551615, 5)
    let e = list.get_or(none, 0, 5)
    (((a * 10 + b) * 10 + c) * 10 + d) * 10 + e
}

fn find_byte_ref(xs: Bytes, start: u64, end: u64, byte: u8) -> Option[u64] {
    for i in start .. end {
        if xs[i] == byte {
            return Some(i)
        }
    }
    None
}

fn find_byte4_ref(xs: Bytes, start: u64, end: u64, a: u8, b: u8, c: u8, d: u8) -> Option[u64] {
    for i in start .. end {
        let x = xs[i]
        if x == a || x == b || x == c || x == d {
            return Some(i)
        }
    }
    None
}

// Every lane of the portable word path (< 160 B) and the SIMD four-vector group
// plus leftovers and overlapping tail (>= 160 B) can hold the first hit.
// The second adjacent hit must lose even when it sits in the next word or vector.
// expect: run find_byte_order_and_range() = true
fn find_byte_order_and_range() -> bool {
    let sizes: Inline[u64, 2] =[75, 360]
    for n in sizes {
        let mut xs: Bytes = list.with_capacity(n)
        list.fill(mut xs, n, 1)
        for at in 0u64 .. n - 1 {
            xs[at] = 255
            xs[at + 1] = 255
            let matched = bound bytes 0 {
                list.find_byte(xs, 0, n, 255) == Some(at) && list.find_byte(xs, 0, at, 255) == None && list.find_byte(xs, at + 1, n, 255) == Some(at + 1)
            }
            match matched {
                Ok(true) => (),
                _ => return false,
            }
            xs[at] = 1
            xs[at + 1] = 1
        }
        if list.find_byte(xs, 1, n, 0) != None {
            return false
        }
    }
    true
}

// Differential check against an independent scalar scan across short and long
// spans, alignments, hits, and misses.
// expect: run find_byte_matches_scalar() = true
fn find_byte_matches_scalar() -> bool {
    let len: u64 = 389
    let mut xs: Bytes = list.with_capacity(len)
    let mut state: u32 = 0x8c11d14b
    for _ in 0u64 .. len {
        state = int.wrapping_add(int.wrapping_mul(state, 1664525), 1013904223)
        let byte: u8 = int.narrow(state >> 24)
        list.push(mut xs, byte)
    }
    for start in 0u64 .. 160 {
        state = int.wrapping_add(int.wrapping_mul(state, 1664525), 1013904223)
        let span: u64 = int.widen(state)
        let end = start + span % (len - start + 1)
        let byte: u8 = int.narrow(state >> 24)
        if list.find_byte(xs, start, end, byte) != find_byte_ref(xs, start, end, byte) {
            return false
        }
    }
    // Exercise misses and late hits right around the 160-byte SIMD crossover.
    let mut flat: Bytes = list.with_capacity(200)
    list.fill(mut flat, 200, b'z')
    for n in 155u64 .. 166 {
        if list.find_byte(flat, 0, n, b'a') != None {
            return false
        }
        flat[n - 1] = b'a'
        if list.find_byte(flat, 0, n, b'a') != Some(n - 1) {
            return false
        }
        flat[n - 1] = b'z'
    }
    true
}

// Multi-delimiter search (2, 3, and 4 needles) across scalar, 16-byte SIMD,
// 32-byte SIMD, 128-byte four-vector group, leftover, and overlapping tail.
// expect: run find_byte4_order_and_range() = true
fn find_byte4_order_and_range() -> bool {
    let n: u64 = 360
    let mut xs: Bytes = list.with_capacity(n)
    list.fill(mut xs, n, b'z')
    let needles: Inline[u8, 4] =[b'"', b',', 13, 10]
    for at in 0u64 .. n - 1 {
        let first_byte = needles[at % 4]
        let second_byte = needles[(at + 1) % 4]
        xs[at] = first_byte
        xs[at + 1] = second_byte
        let matched = bound bytes 0 {
            list.find_byte4(xs, 0, n, b'"', b',', 13, 10) == Some(at) && list.find_byte4(xs, 0, at, b'"', b',', 13, 10) == None && list.find_byte4(xs, at + 1, n, b'"', b',', 13, 10) == Some(at + 1)
        }
        match matched {
            Ok(true) => (),
            _ => return false,
        }
        xs[at] = b'z'
        xs[at + 1] = b'z'
    }
    // Check lengths 0..37 (scalar + 16-byte SIMD + 32-byte SIMD boundaries) for find_byte2/3/4.
    for len in 0u64 .. 38 {
        if list.find_byte2(xs, 0, len, b',', 10) != None || list.find_byte3(xs, 0, len, b',', 13, 10) != None || list.find_byte4(xs, 0, len, b'"', b',', 13, 10) != None {
            return false
        }
        if len > 0 {
            xs[len - 1] = 10
            let ok = list.find_byte2(xs, 0, len, b',', 10) == find_byte4_ref(xs, 0, len, b',', 10, b',', 10) && list.find_byte3(xs, 0, len, b',', 13, 10) == find_byte4_ref(xs, 0, len, b',', 13, 10, 10) && list.find_byte4(xs, 0, len, b'"', b',', 13, 10) == Some(len - 1)
            xs[len - 1] = b'z'
            if !ok {
                return false
            }
        }
    }
    true
}

// expect: run find_byte_reversed_range() = fail Bounds
fn find_byte_reversed_range() -> Option[u64] {
    list.find_byte(b"abc", 2, 1, b'b')
}

// expect: run find_byte4_past_end() = fail Bounds
fn find_byte4_past_end() -> Option[u64] {
    list.find_byte4(b"abc", 0, 4, b'"', b',', 13, 10)
}

// Under a tight step bound, long scans stop with Steps rather than escaping the bound.
// expect: reference run find_byte_step_bound() = true
fn find_byte_step_bound() -> bool {
    let mut xs: Bytes = list.with_capacity(512)
    list.fill(mut xs, 512, b'z')
    xs[511] = b'a'
    let tight1 = bound steps 1 {
        list.find_byte(xs, 0, 512, b'a')
    }
    let tight4 = bound steps 1 {
        list.find_byte4(xs, 0, 512, b'"', b',', 13, b'a')
    }
    let ample1 = bound steps 10000 {
        list.find_byte(xs, 0, 512, b'a')
    }
    let ample4 = bound steps 10000 {
        list.find_byte4(xs, 0, 512, b'"', b',', 13, b'a')
    }
    let ok_t1 = match tight1 {
        Error(_) => true,
        Ok(_) => false,
    }
    let ok_t4 = match tight4 {
        Error(_) => true,
        Ok(_) => false,
    }
    let ok_a1 = match ample1 {
        Ok(Some(511)) => true,
        _ => false,
    }
    let ok_a4 = match ample4 {
        Ok(Some(511)) => true,
        _ => false,
    }
    ok_t1 && ok_t4 && ok_a1 && ok_a4
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

// Dropping 6 of five elements has no suffix to keep; the documented failure is Bounds.
// expect: run drop_prefix_past_end() = fail Bounds
fn drop_prefix_past_end() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.drop_prefix(mut xs, 6)
    list.len(xs)
}

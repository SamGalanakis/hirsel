// The Tiered stage of the log@1 cut (§13.6a T2, T4, T9, steps 3 and 5).
// It runs once per cut, before AP16 plans the Memory classes, because the
// collection-map leaves that AP16 encodes must already name the class-3
// roots it emits here.

type TieredCutPack: send {
    seq: u64,
    wire: Bytes,
    pack: PagePack
}

type TieredCutStage: send {
    // Class 4 first, then class 3, in pack order (T4).
    packs: List[TieredCutPack],
    // The participants' roots in `cut_participants` order, each Tiered
    // `CollectionRoot` sealed to its emitted location.
    roots: List[Roots],
    next_pack: u64
}

fn tiered_cut_stage_empty(cut_stage: TieredCutStage) -> bool {
    list.len(cut_stage.packs) == 0
}

fn encode_tiered_run(id: StoreId, layout: TieredPackRun, mut emitted: Map[u64, std.page.PagePtr], mut packs: List[TieredCutPack]) -> Result[(), Error] {
    capacity(list.try_reserve(mut packs, list.len(layout.packs)))?
    for laid in layout.packs {
        let (take wire, inventory) = encode_tiered_cut_pack(id, layout, laid, mut emitted)?
        list.push(mut packs, TieredCutPack(seq: laid.seq, wire: take wire, pack: inventory))
    }
    Ok(())
}

// T2 then T4: every Hot Tiered page and blob that a participant reaches is
// emitted once by stamp, class 4 then class 3, from the installed `next_pack`
// upward. A participant over a replay overlay is refused: until the fold
// (§13.7) runs in the cut, sealing its map would publish the pre-overlay
// root past the journal frames that carry the overlay (L68 (e)).
fn stage_tiered_cut(id: StoreId, take roots: List[Roots], first_pack: u64, cap: u64) -> Result[TieredCutStage, Error] {
    for held in roots {
        if let Some(_) = held.collections.replay {
            return Error(Unsupported(0x0031))
        }
    }
    let TieredCutFrames(pages: take pages, blobs: take blobs, ..) = tiered_cut_frames(roots)?
    if list.len(pages) == 0 {
        return Ok(TieredCutStage(packs: list.new(), roots: take roots, next_pack: first_pack))
    }
    let blob_run = layout_tiered_packs(take blobs, 4, first_pack, cap)?
    let page_run = layout_tiered_packs(take pages, 3, blob_run.next_pack, cap)?
    let mut emitted: Map[u64, std.page.PagePtr] = map.new()
    let mut packs: List[TieredCutPack] = list.new()
    encode_tiered_run(id, blob_run, mut emitted, mut packs)?
    encode_tiered_run(id, page_run, mut emitted, mut packs)?
    let mut sealed: List[Roots] = list.new()
    capacity(list.try_reserve(mut sealed, list.len(roots)))?
    for held in roots {
        let collections = seal_holder_tiered(held.collections, emitted)?
        list.push(mut sealed, PageRoots(collections: take collections, streams: share_page_tree(held.streams), catalog: share_page_tree(held.catalog)))
    }
    Ok(TieredCutStage(packs: take packs, roots: take sealed, next_pack: page_run.next_pack))
}

// `note_held_roots` lists each participant's collection map first.
fn sealed_cut_holders(holders: List[HeldPage], cut_stage: TieredCutStage) -> Result[List[HeldPage], Error] {
    let mut ready: List[HeldPage] = list.new()
    capacity(list.try_reserve(mut ready, list.len(holders)))?
    for slot in 0u64 .. list.len(holders) {
        let held = view holders[slot]
        let root = if slot % 3 == 0 {
            arc.share(cut_stage.roots[slot / 3].collections.root)
        } else {
            arc.share(held.root)
        }
        list.push(mut ready, HeldPage(source: held.source, root: take root))
    }
    Ok(take ready)
}

// T4's pack rows: each Tiered pack enters the candidate inventory with
// `live` = its laid-out payload, so AP16 item 7 lists it.
fn list_tiered_cut(mut known: PageLocations, cut_stage: TieredCutStage) -> Result[(), Error] {
    for written in cut_stage.packs {
        capacity(disk_index_put(mut known.packs, written.seq, written.pack, pack_edge_charge))?
    }
    Ok(())
}

// Step 3 for classes 4 and 3, ahead of AP16's classes 1, 0 and 2.
fn write_tiered_cut(d: Dir, cut_stage: TieredCutStage, mut buffers: PackBuffers) -> Result[(), Error] waits {
    for written in cut_stage.packs {
        string.truncate(mut buffers.destination, 0)
        string.push(mut buffers.destination, "p-")
        string.push_u64(mut buffers.destination, written.seq)
        string.truncate(mut buffers.temporary, 0)
        string.push(mut buffers.temporary, buffers.destination)
        string.push(mut buffers.temporary, ".tmp")
        disk_write_synced(d, buffers.temporary, written.wire)?
        disk_io(host.rename(d, buffers.temporary, buffers.destination))?
    }
    Ok(())
}

// AP15's Tiered class figure: each distinct Tiered root's descriptor bytes.
// Holders that share a root by stamp count it once. The figure is exact for
// one holder; across holders whose distinct roots share subtrees it is an
// upper bound, which replay already treats as conservative (§13.1).
fn tiered_map_account(root: Arc[std.page.Page], mut seen: Map[u64, ()], mut total: u64) -> Result[(), Error] {
    let image = std.page.image_of(root)
    for slot in 0u64 .. std.page.count(image) {
        if std.page.level(image) != 0 {
            tiered_map_account(option.unwrap(std.page.child(root, slot)), mut seen, mut total)?
            continue
        }
        let descriptor = option.unwrap(std.page.value_at(root, slot))
        if descriptor[53u64] != 1 {
            continue
        }
        let stamp = match option.unwrap(std.page.child_slot(root, slot)) {
            HotPage(page) => std.page.stamp(std.page.image_of(page)),
            ColdPage(place) => place.stamp,
            _ => 0,
        }
        if stamp != 0 {
            if map.contains(seen, stamp) {
                continue
            }
            capacity(map.try_reserve(mut seen, 1))?
            map.insert(mut seen, stamp, ())
        }
        let Some(sum) = int.checked_add(total, list.word_le(descriptor, 44)) else {
            return Error(Limit(Ids))
        }
        total = sum
    }
    Ok(())
}

fn cut_tiered_account(db: Db, delta: HolderDelta) -> Result[u64, Error] {
    let mut seen: Map[u64, ()] = map.new()
    let mut total = 0u64
    visit_cut_heads(db, delta, mut total, scoped fn(mut sum: u64, head: Head, roots: Roots, head_version: u64, at: u64) -> Result[(), Error] {
        tiered_map_account(roots.collections.root, mut seen, mut sum)
    })?
    visit_cut_pins(db, delta, mut total, scoped fn(mut sum: u64, held: Pin) -> Result[(), Error] {
        tiered_map_account(held.roots.collections.root, mut seen, mut sum)
    })?
    Ok(total)
}

// Step 5's images, built before the rename so the swap allocates nothing.
// Each sealed tree reads its Cold roots through the new generation's packs.
fn prepare_tiered_install(mut cut_stage: TieredCutStage, installed: PageLocations, generation: u64) -> Result[(), Error] {
    if tiered_cut_stage_empty(cut_stage) {
        return Ok(())
    }
    let paging = recovered_tiered_inventory(installed, None, generation)?
    for slot in 0u64 .. list.len(cut_stage.roots) {
        if tiered_collections(cut_stage.roots[slot].collections.root) {
            cut_stage.roots[slot].collections.paging = Some(arc.share(paging))
        }
    }
    Ok(())
}

fn take_sealed(mut sealed: List[Roots], mut at: u64) -> PageTree {
    let tree = share_page_tree(sealed[at].collections)
    at += 1
    take tree
}

// Step 5: each participant's Tiered images replace its Hot ones, in the
// order `visit_cut_heads` and `visit_cut_pins` gave them to the stage.
fn install_tiered_holders(mut db: Db, mut delta: HolderDelta, take cut_stage: TieredCutStage) {
    if tiered_cut_stage_empty(cut_stage) {
        return ()
    }
    let TieredCutStage(roots: take sealed, ..) = take cut_stage
    let mut sealed_roots = take sealed
    let mut at = 0u64
    let removed: Option[u64] = match delta {
        RemoveHead(slot) => Some(slot),
        ReplaceMain(_, slot) => slot,
        _ => None,
    }
    for slot in 0u64 .. list.len(db.heads) {
        if removed == Some(slot) {
            continue
        }
        if slot == 0 {
            if let ReplaceMain(mut replacement, _) = delta {
                replacement.roots.collections = take_sealed(mut sealed_roots, mut at)
                continue
            }
        }
        db.heads[slot].roots.collections = take_sealed(mut sealed_roots, mut at)
    }
    if let AddHead(mut added, _) = delta {
        added.roots.collections = take_sealed(mut sealed_roots, mut at)
    }
    let dropped: Option[u64] = match delta {
        RemovePin(slot) => Some(slot),
        _ => None
    }
    let mut inserted = false
    for slot in 0u64 .. list.len(db.pins) {
        if dropped == Some(slot) {
            continue
        }
        if let ReplacePin(pin_slot, mut replacement) = delta {
            if pin_slot == slot {
                replacement.roots.collections = take_sealed(mut sealed_roots, mut at)
                continue
            }
        }
        if !inserted {
            if let AddPin(mut added) = delta {
                if added.name < db.pins[slot].name {
                    added.roots.collections = take_sealed(mut sealed_roots, mut at)
                    inserted = true
                }
            }
        }
        db.pins[slot].roots.collections = take_sealed(mut sealed_roots, mut at)
    }
    if !inserted {
        if let AddPin(mut added) = delta {
            added.roots.collections = take_sealed(mut sealed_roots, mut at)
        }
    }
}

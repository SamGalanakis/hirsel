// Serves the built site (tools/site_build.py _site) from Cloudflare as static assets.
// hirsel.ai and www.hirsel.ai are attached to this Worker as custom domains in the
// Cloudflare dashboard, and the zone redirects www to the apex, so deploys only upload
// assets and never touch DNS. Deploy: npx wrangler@4 deploy -c tools/site.wrangler.jsonc
{
  "name": "hirsel-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "../_site", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "workers_dev": true,
  "preview_urls": false
}

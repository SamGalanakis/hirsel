// L63 (a), (b): a call's Tiered reads abort and rerun (§13.3 "Abort and rerun").
// Rows 1, 3, 5 in a Cold `rows` collection with the pager running, plus a Hot
// `marks` table the bodies write to.
fn l63_call_fixture(d: Dir, c: Clock, tasks: Tasks, call: scoped[view] fn(mut Db, (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] waits) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let mut db = test_db(c, 2147483648)
    let (rows, marks) = law_pair(mut db, "rows", std.codec.key_u64(), std.codec.of_u32(), "marks", std.codec.key_u64(), std.codec.of_u32())?
    let Committed(_) = run(mut db, None, copy_env(rows), fn(mut tx: Tx, handle: Table[u64, u32]) -> Result[(), Error] {
        put(mut tx, handle, 1u64, 10u32)?
        put(mut tx, handle, 3u64, 30u32)?
        put(mut tx, handle, 5u64, 50u32)
    })? else {
        fail("L63: fixture inserts did not commit")
    }
    l62_prepare_snapshot_pages(mut db, fixtures, rows.id, 8)?
    let _ = pager.replace_writer_pin_bytes(mut db.pager, 1048576)
    let funding = pager.TieredPagerFunding(cache_bytes: 32 * 1048576, writer_pin_bytes: pager.pin_partition(db.pager), pager_task_bytes: 1048576, cut_pins: false)
    let link = failure_result_from_rep(object_writer.start_tiered_pager_link(tasks, store_key_to_rep(db.store), open_number(db), PagerDirectory(fixtures), funding, 4))?
    let worker = attach_tiered_pager(mut db, take link)
    let answer = call(mut db, (rows, marks))
    clear_parked(mut db)
    pager.close_requests(mut db.pager)
    let _ = result.unwrap(task.join(take worker))
    answer
}

// Reads `marks` back through a Hot body.
fn l63_mark(mut db: Db, marks: Table[u64, u32], k: u64) -> Result[Option[u32], Error] waits {
    let Committed(done) = run(mut db, Some(100000), (copy_env(marks), k), fn(mut tx: Tx, env: (Table[u64, u32], u64)) -> Result[Option[u32], Error] {
        fetch(tx, env.0, env.1)
    })? else {
        fail("L63: reading a mark did not commit")
    }
    Ok(done.value)
}

// (a) The first attempt misses row 3 and its body, catching the failure in
// `isolate`, retries forever until the step bound stops it; the driver
// discards that attempt, delivers the
// page and reruns, and the rerun hits and commits once. Unbounded, the same call
// is refused before it runs, since a body that loops on the miss never ends.
fn l63_retry_until_hit(mut db: Db, handles: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] waits {
    let before = version(snapshot(db))
    let unbounded = run(mut db, None, copy_env(handles), fn(mut tx: Tx, env: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] {
        let _ = fetch(tx, env.0, 3u64)?
        Ok(())
    })
    let Error(Missing(what)) = unbounded else {
        fail("L63: an unbounded call over a Tiered collection is refused as Missing(steps)")
    }
    if what != "steps" {
        fail("L63: an unbounded call names its missing step bound")
    }
    // With no pager the first attempt's miss cannot be served, which shows the
    // fixture's row 3 is Cold and the committed run below really reran.
    let requests = pager.replace_requests(mut db.pager, None)
    let unserved = run(mut db, Some(100000), copy_env(handles), fn(mut tx: Tx, env: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] {
        let _ = fetch(tx, env.0, 3u64)?
        Ok(())
    })
    let _ = pager.replace_requests(mut db.pager, take requests)
    let Error(Io(Closed)) = unserved else {
        fail("L63: a miss with no pager is Io(Closed)")
    }
    let Committed(_) = run(mut db, Some(100000), copy_env(handles), fn(mut tx: Tx, env: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] {
        loop {
            let caught = isolate(fn() -> Result[Option[u32], Error] {
                fetch(tx, env.0, 3u64)
            })
            match caught {
                Ok(Ok(Ok(Some(v)))) => {
                    put(mut tx, env.1, 2u64, v)?
                    return Ok(())
                },
                Ok(Ok(Ok(None))) => fail("L63: row 3 is in the Cold page"),
                _ => (),
            }
        }
    })? else {
        fail("L63: the rerun after the delivered miss commits")
    }
    if version(snapshot(db)) != before + 1 {
        fail("L63: the call commits exactly once")
    }
    if l63_mark(mut db, handles.1, 2)? != Some(30) {
        fail("L63: the committed attempt read row 3 as 30")
    }
    let before_abort = version(snapshot(db))
    let Aborted(Undone(value: Missing(marker), ticket: None)) = run(mut db, Some(100000), copy_env(handles.0), fn(mut tx: Tx, rows: Table[u64, u32]) -> Result[(), Error] {
        put(mut tx, rows, 3u64, 31u32)?
        if !delete(mut tx, rows, 5u64)? || delete(mut tx, rows, 5u64)? {
            fail("L63: delete sees the Cold row and then the staged absence")
        }
        if fetch(tx, rows, 3u64)? != Some(31) {
            fail("L63: fetch sees the staged replacement")
        }
        Error(Missing("abort after old-row reads"))
    })? else {
        fail("L63: a Cold write reruns to the body's abort")
    }
    if marker != "abort after old-row reads" || version(snapshot(db)) != before_abort {
        fail("L63: neither the missed write nor the deciding abort publishes")
    }
    Ok(())
}

@test
fn test_l63_caught_miss_reruns_and_commits_once(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    l63_call_fixture(d, c, tasks, l63_retry_until_hit)
}

// (b) A body that answers its miss by writing a fallback and returning Ok
// commits nothing from that attempt: only the rerun's write survives.
fn l63_fallback_discarded(mut db: Db, handles: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] waits {
    let before = version(snapshot(db))
    let Committed(_) = run(mut db, Some(100000), copy_env(handles), fn(mut tx: Tx, env: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] {
        match fetch(tx, env.0, 5u64) {
            Ok(Some(v)) => put(mut tx, env.1, 2u64, v),
            Ok(None) => fail("L63: row 5 is in the Cold page"),
            Error(_) => put(mut tx, env.1, 1u64, 1u32),
        }
    })? else {
        fail("L63: the rerun after the delivered miss commits")
    }
    if version(snapshot(db)) != before + 1 {
        fail("L63: the call commits exactly once")
    }
    if l63_mark(mut db, handles.1, 1)? != None {
        fail("L63: the missed attempt's fallback write is discarded")
    }
    if l63_mark(mut db, handles.1, 2)? != Some(50) {
        fail("L63: the rerun's write commits with row 5 as 50")
    }
    Ok(())
}

@test
fn test_l63_missed_attempt_fallback_commits_nothing(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    l63_call_fixture(d, c, tasks, l63_fallback_discarded)
}

// (a) for serve: the first attempt misses row 3 and its body writes a fallback
// and replies; the driver discards that attempt, delivers the page and drafts
// again, and the rerun commits once with the hit's write and reply. With no
// pager the same miss is `Before(Io(Closed))`, so row 3 really is Cold.
fn l63_serve_rerun(mut db: Db, handles: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] waits {
    let stream = law_stream_bytes(types.key_word(23), keyed_time(db))
    let request = request_digest(stream, stream)
    let plan = Plan(n_e: 1048576, s_e: 1048576, reply_max: 16)
    let body = fn(mut tx: Tx, env: (Table[u64, u32], Table[u64, u32])) -> Result[Bytes, Bytes] {
        match fetch(tx, env.0, 3u64) {
            Ok(Some(v)) => {
                result.unwrap(put(mut tx, env.1, 2u64, v))
                Ok(types.key_word(3))
            },
            _ => {
                result.unwrap(put(mut tx, env.1, 1u64, 1u32))
                Ok(types.key_word(0))
            },
        }
    }
    let Admitted(take first) = admit_law_stream(mut db, stream, 0, request)? else {
        fail("L63: the serve call is admitted")
    }
    let requests = pager.replace_requests(mut db.pager, None)
    let unserved = serve(mut db, take first, plan, None, copy_env(handles), body)
    let _ = pager.replace_requests(mut db.pager, take requests)
    let Error(Before(Io(Closed), _)) = unserved else {
        fail("L63: a served miss with no pager is Before(Io(Closed))")
    }
    // A partition too small for one pin latches the pin limit: NoRoom(Cache).
    let Abandoned(take starved) = admit_law_stream(mut db, stream, 0, request)? else {
        fail("L63: the unserved call is handed back as Abandoned")
    }
    let partition = pager.replace_writer_pin_bytes(mut db.pager, 1)
    let refused = serve(mut db, take starved, plan, None, copy_env(handles), body)
    let _ = pager.replace_writer_pin_bytes(mut db.pager, partition)
    let Ok(NoRoom(_, Cache(_))) = refused else {
        fail("L63: a served call over its pin partition is NoRoom(Cache)")
    }
    let before = version(snapshot(db))
    let Abandoned(take again) = admit_law_stream(mut db, stream, 0, request)? else {
        fail("L63: the refused call is handed back as Abandoned")
    }
    let parked = serve(mut db, take again, plan, None, copy_env(handles), body)
    let Ok(Committed(receipt)) = l63_settle(mut db, take parked, handles, body) else {
        fail("L63: the served call commits after the delivered miss")
    }
    if receipt.reply != types.key_word(3) {
        fail("L63: the committed reply is the rerun's hit")
    }
    if version(snapshot(db)) != before + 1 {
        fail("L63: the served call commits exactly once")
    }
    if l63_mark(mut db, handles.1, 1)? != None {
        fail("L63: the missed attempt's fallback write is discarded")
    }
    if l63_mark(mut db, handles.1, 2)? != Some(30) {
        fail("L63: the rerun's write commits with row 3 as 30")
    }
    Ok(())
}

@test
fn test_l63_served_miss_reruns_and_commits_once(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    l63_call_fixture(d, c, tasks, l63_serve_rerun)
}

// Polls and resumes a served call until it is decided, waiting on the park
// notices while it is parked (§13.3a "Polling").
fn l63_settle[E: inert](mut db: Db, take first: Result[Served, ServeError], handles: E, body: fn(mut Tx, E) -> Result[Bytes, Bytes]) -> Result[Served, ServeError] waits {
    let mut served = take first
    for _ in 0u64 .. 32 {
        let p = match take served {
            Ok(Parked(take p)) => take p,
            Ok(take decided) => return Ok(take decided),
            Error(take problem) => return Error(take problem),
        }
        let ready = result.unwrap(poll_parked(mut db))
        let mut found = false
        for id in ready {
            if id == park_id(p) {
                found = true
            }
        }
        served = if found {
            resume_parked(mut db, take p, copy_env(handles), body)
        } else {
            let woke = match pager.park_notices(db.pager) {
                Some(notices) => channel.receive(notices),
                None => fail("L63: the fixture keeps the park notices"),
            }
            if let Error(_) = woke {
                fail("L63: the pager posts a notice after each writer answer")
            }
            Ok(Parked(take p))
        }
    }
    fail("L63: a parked call is decided within its resumes")
}

// Reads Cold row 3 and Hot mark 7, writes their sum as mark `env`'s key 8 and
// replies with the deciding attempt's version * 1000 + mark 7.
fn l63_parking_body(mut tx: Tx, env: (Table[u64, u32], Table[u64, u32])) -> Result[Bytes, Bytes] {
    let row = fetch(tx, env.0, 3u64)
    let mark = match fetch(tx, env.1, 7u64) {
        Ok(Some(m)) => m,
        _ => 0u32,
    }
    match row {
        Ok(Some(v)) => {
            result.unwrap(put(mut tx, env.1, 8u64, v + mark))
            Ok(types.key_word(info(mut tx).id.version * 1000 + int.widen(mark)))
        },
        _ => Ok(types.key_word(0)),
    }
}

// (g) A served call that misses parks; a Hot write then moves the head
// before the call reruns. The rerun decides at the moved head: its reply
// carries the write's value and its own version, which is the write's + 1,
// and it commits once.
fn l63_moved_head(mut db: Db, handles: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] waits {
    let stream = law_stream_bytes(types.key_word(29), keyed_time(db))
    let request = request_digest(stream, stream)
    let plan = Plan(n_e: 1048576, s_e: 1048576, reply_max: 16)
    let Admitted(take first) = admit_law_stream(mut db, stream, 0, request)? else {
        fail("L63: the parking call is admitted")
    }
    let parked = serve(mut db, take first, plan, None, copy_env(handles), l63_parking_body)
    let Ok(Parked(take p)) = take parked else {
        fail("L63: a served call's first miss parks it")
    }
    let Committed(_) = run(mut db, Some(100000), copy_env(handles.1), fn(mut tx: Tx, marks: Table[u64, u32]) -> Result[(), Error] {
        put(mut tx, marks, 7u64, 70u32)
    })? else {
        fail("L63: the Hot write commits while the call is parked")
    }
    let moved = version(snapshot(db))
    let Ok(Committed(receipt)) = l63_settle(mut db, Ok(Parked(take p)), handles, l63_parking_body) else {
        fail("L63: the parked call commits after the head moved")
    }
    if receipt.reply != types.key_word((moved + 1) * 1000 + 70) {
        fail("L63: the rerun decides at the moved head and reads its write")
    }
    if version(snapshot(db)) != moved + 1 {
        fail("L63: the parked call commits exactly once")
    }
    if l63_mark(mut db, handles.1, 8)? != Some(100) {
        fail("L63: the committed write is row 3 plus the moved head's mark")
    }
    Ok(())
}

@test
fn test_l63_parked_call_reruns_at_moved_head(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    l63_call_fixture(d, c, tasks, l63_moved_head)
}

// (h) The revocation/pager-wake race. P parks and its delivery arrives (the
// pager has posted its notice) but no poll has taken it; Q parks behind P,
// its demand not yet sent. An inline read-only `run` that misses enters held
// mode and revokes both, leaving the head's root where it was. P's arrived
// delivery is drained, never installed, so P's next attempt misses again and
// parks in its old place; then P and Q each rerun and commit once.
fn l63_revoke_race(mut db: Db, handles: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] waits {
    let plan = Plan(n_e: 1048576, s_e: 1048576, reply_max: 16)
    let p_stream = law_stream_bytes(types.key_word(31), keyed_time(db))
    let Admitted(take p_first) = admit_law_stream(mut db, p_stream, 0, request_digest(p_stream, p_stream))? else {
        fail("L63: P is admitted")
    }
    let q_stream = law_stream_bytes(types.key_word(37), keyed_time(db))
    let Admitted(take q_first) = admit_law_stream(mut db, q_stream, 0, request_digest(q_stream, q_stream))? else {
        fail("L63: Q is admitted")
    }
    let Ok(Parked(take p)) = serve(mut db, take p_first, plan, None, copy_env(handles), l63_parking_body) else {
        fail("L63: P's first miss parks it")
    }
    let Ok(Parked(take q)) = serve(mut db, take q_first, plan, None, copy_env(handles), l63_parking_body) else {
        fail("L63: Q's first miss parks it")
    }
    let woke = match pager.park_notices(db.pager) {
        Some(notices) => channel.receive(notices),
        None => fail("L63: the fixture keeps the park notices"),
    }
    if let Error(_) = woke {
        fail("L63: the pager answers P's demand")
    }
    let before = version(snapshot(db))
    let held = run(mut db, Some(100000), copy_env(handles.0), fn(mut tx: Tx, rows: Table[u64, u32]) -> Result[Option[u32], Error] {
        fetch(tx, rows, 5u64)
    })?
    let Committed(read) = held else {
        fail("L63: the held inline read commits")
    }
    if read.value != Some(50) {
        fail("L63: the held inline read is delivered row 5")
    }
    let base = version(snapshot(db))
    if base != before && base != before + 1 {
        fail("L63: the inline read commits at most one version")
    }
    let place = park_id(p)
    let p_again = resume_parked(mut db, take p, copy_env(handles), l63_parking_body)
    let Ok(Parked(take p_parked)) = take p_again else {
        fail("L63: a revoked call's arrived delivery is never installed, so its rerun parks again")
    }
    if park_id(p_parked) != place {
        fail("L63: a revoked call keeps its place in the queue")
    }
    let Ok(Committed(p_receipt)) = l63_settle(mut db, Ok(Parked(take p_parked)), handles, l63_parking_body) else {
        fail("L63: P commits after its revocation")
    }
    let Ok(Committed(q_receipt)) = l63_settle(mut db, Ok(Parked(take q)), handles, l63_parking_body) else {
        fail("L63: Q commits after its revocation")
    }
    if p_receipt.reply != types.key_word((base + 1) * 1000) || q_receipt.reply != types.key_word((base + 2) * 1000) {
        fail("L63: each rerun decides at the head it commits on")
    }
    if version(snapshot(db)) != base + 2 {
        fail("L63: P and Q each commit exactly once")
    }
    Ok(())
}

@test
fn test_l63_revocation_races_pager_wake(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    l63_call_fixture(d, c, tasks, l63_revoke_race)
}

// Rows 1, 3, 5 in a Tiered `rows` table and a Hot `marks` table on a
// Directory store, reopened so that `rows` is Cold with the pager running.
fn l63_directory_fixture(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(Dir, Options, Db, Table[u64, u32], Table[u64, u32]), Error] waits {
    let directory = disk_test_directory(d)
    let options = l70_open_options(300000000u64)?
    {
        let mut db = open(tasks, directory, c, r, options)?
        let (rows, _) = law_pair(mut db, "rows", std.codec.key_u64(), std.codec.of_u32(), "marks", std.codec.key_u64(), std.codec.of_u32())?
        set_residency(mut db, rows.id, Tiered)?
        let Committed(_) = run(mut db, Some(100000), copy_env(rows), fn(mut tx: Tx, handle: Table[u64, u32]) -> Result[(), Error] {
            put(mut tx, handle, 1u64, 10u32)?
            put(mut tx, handle, 3u64, 30u32)?
            put(mut tx, handle, 5u64, 50u32)
        })? else {
            fail("L63: the Directory fixture rows commit")
        }
        let cut = checkpoint(mut db)?
        durable(mut db, cut)?
        close(take db)?
    }
    let mut db = open(tasks, directory, c, r, options)?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u32())?
    let marks = table(mut db, "marks", std.codec.key_u64(), std.codec.of_u32())?
    match std.page.collection_slot(pages.holder_heads(db.holders)[0].roots.collections.root, failure_result_from_rep(catalog.prefix(rows.id))?) {
        Some((ColdPage(_), _)) => (),
        _ => fail("L63: the reopened Tiered root is Cold"),
    }
    Ok((directory, options, take db, take rows, take marks))
}

// Reads row 4 of `rows`, writes it back as one more, and replies with what it
// read: key_word(v) for Some(v), key_word(0) for None. A missed attempt's
// write and reply are discarded with it.
fn l63_prior_body(mut tx: Tx, rows: Table[u64, u32]) -> Result[Bytes, Bytes] {
    match fetch(tx, rows, 4u64) {
        Ok(Some(v)) => {
            result.unwrap(put(mut tx, rows, 4u64, v + 1))
            Ok(types.key_word(int.widen(v)))
        },
        Ok(None) => {
            result.unwrap(put(mut tx, rows, 4u64, 1u32))
            Ok(types.key_word(0))
        },
        Error(_) => Ok(types.key_word(9999)),
    }
}

// (d) The Tiered prior through a parked call. Rows 1, 3, 5 are Tiered and,
// after a reopen, Cold. A served call A misses key 4 and parks; an inline
// call B inserts 4 = 40 and commits. A reruns at B's head, reads 40 and puts
// 41, and its put carries prior 1 + |v| of B's stored value: an of_u32 value
// is stored as a 2-byte schema number and 4 bytes, so 7. Replay then holds
// B's put in the overlay when it checks A's prior, and the reopened account
// equals the live one. Seeded bug `stale_prior` (the rerun takes the prior
// from the parked attempt's root, where 4 is absent): A's prior is 0 and the
// reopen is `Corrupt(Malformed)`.
fn l63_parked_prior(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let (directory, options, take opened, take rows, _) = l63_directory_fixture(d, c, r, tasks)?
    let mut db = take opened
    let stream = law_stream_bytes(types.key_word(41), keyed_time(db))
    let request = request_digest(stream, stream)
    let plan = Plan(n_e: 1048576, s_e: 1048576, reply_max: 16)
    let Admitted(take first) = admit_law_stream(mut db, stream, 0, request)? else {
        fail("L63 (d): A is admitted")
    }
    let Ok(Parked(take a)) = serve(mut db, take first, plan, None, copy_env(rows), l63_prior_body) else {
        fail("L63 (d): A's miss of Cold key 4 parks it")
    }
    let Committed(inserted) = run(mut db, Some(100000), copy_env(rows), fn(mut tx: Tx, handle: Table[u64, u32]) -> Result[(), Error] {
        put(mut tx, handle, 4u64, 40u32)
    })? else {
        fail("L63 (d): B's insert commits while A is parked")
    }
    durable(mut db, inserted.ticket)?
    let seq = file_seq(db)
    let start = file_end(db)
    let Ok(Committed(receipt)) = l63_settle(mut db, Ok(Parked(take a)), copy_env(rows), l63_prior_body) else {
        fail("L63 (d): A commits after B moved the head")
    }
    durable(mut db, receipt.ticket)?
    if receipt.reply != types.key_word(40) || version(snapshot(db)) != option.unwrap(inserted.info).id.version + 1 {
        fail("L63 (d): A reruns at B's head, reads 40 and commits once")
    }
    let path = failure_result_from_rep(types.capacity(manifest.disk_path("j-", seq, "")))?
    let wire = read_journal_prefix(directory, path, file_end(db))?
    let frame = journal_decode_commit(path, failure_result_from_rep(types.copied(list.slice(wire, start + 16, file_end(db))))?)?
    let k = failure_result_from_rep(catalog.logical_key(rows.id, types.key_word(4)))?
    let mut prior: Option[u32] = None
    for op in frame.data {
        if op.key == k {
            prior = Some(op.prior)
        }
    }
    if prior != Some(7) {
        fail("L63 (d): A's put of key 4 carries prior 1 + |40|, the moved head's value")
    }
    let live_account = db.accounting.resident
    close(take db)?
    let replayed = open(tasks, directory, c, r, options)?
    if replayed.accounting.resident != live_account {
        fail("L63 (d): replay's account equals the live one")
    }
    close(take replayed)
}

@test
fn test_l63_parked_rerun_takes_moved_prior(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    l63_parked_prior(d, c, r, tasks)
}

// Every change between `a` and `b` over the whole key space, one page at a
// time under `limits`, each page resumed where the last one stopped.
fn l63_paged_changes(read_handle: Reader, a: Snapshot, b: Snapshot, limits: Limits) -> Result[List[Change], Error] waits {
    let mut low: Bytes = list.new()
    let mut hi: Bytes = list.new()
    list.push(mut hi, 255u8)
    let mut all: List[Change] = list.new()
    loop {
        let page = changes_page(read_handle, Some(clone(a)), b, low, hi, limits)?
        if list.len(page.trimmed) != 0 || list.len(page.bounds) != 0 {
            fail("L63 (j): a table diff has no trims or bounds")
        }
        let ChangePage(changes: take rows, next: take resume, ..) = take page
        for take change in take rows {
            list.push(mut all, take change)
        }
        let Some(take next_low) = take resume else {
            break
        }
        low = take next_low
    }
    Ok(take all)
}

// `seen` is the hand-derived forward diff: rows {1, 3, 5} (Cold) against
// {1, 2, 5} puts `added` and deletes `deleted`, and the Memory neighbor's row
// 7 is put in the target only.
fn l63_check_diff(seen: List[Change], rows_handle: Table[u64, u32], neighbor: Table[u64, u32], added: (u64, u32), deleted: u64, why: String) -> Result[(), Error] {
    if list.len(seen) != 3 {
        fail(clone(why))
    }
    let (first, second) = if added.0 < deleted {
        (0u64, 1u64)
    } else {
        (1u64, 0u64)
    }
    l62_check_span_row(seen[first], rows_handle, added.0, added.1)?
    if seen[second].tree_key != failure_result_from_rep(pager.log_key(rows_handle.id, deleted))? || seen[second].value != None {
        fail(clone(why))
    }
    l62_check_span_row(seen[2u64], neighbor, 7, 70)
}

// L63 (j), changes_page between two Snapshots (§1.5): on (d)'s Directory store,
// reopened so the Tiered collection's rows {1, 3, 5} are Cold, the base is the
// reopened head, and the target is a commit that puts 2 and deletes 3 through
// the pager, beside a put of 7 to the Memory `marks` table. Each direction's
// diff is read whole and one row per page; the backward diff's put of row 3 is
// read from the base's Cold page.
@test
fn test_l63_change_pages_between_cold_snapshots(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let (_, _, take opened, take rows, take marks) = l63_directory_fixture(d, c, r, tasks)?
    let mut db = take opened
    let base = snapshot(db)
    l63_cold_snapshot_diffs(mut db, base, rows, marks)?
    close(take db)
}

fn l63_cold_snapshot_diffs(mut db: Db, base: Snapshot, rows_handle: Table[u64, u32], neighbor: Table[u64, u32]) -> Result[(), Error] waits {
    let pair: (Table[u64, u32], Table[u64, u32]) = (clone(rows_handle), clone(neighbor))
    let Committed(_) = run(mut db, Some(1048576u64), copy_env(pair), fn(mut tx: Tx, handles: (Table[u64, u32], Table[u64, u32])) -> Result[(), Error] {
        put(mut tx, handles.0, 2u64, 20u32)?
        let _ = delete(mut tx, handles.0, 3u64)?
        put(mut tx, handles.1, 7u64, 70u32)
    })? else {
        fail("L63 (j): the target's commit did not commit")
    }
    let target = snapshot(db)
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let whole = Limits(rows: 64, byte_limit: VALUE_LIMIT + 1048576)
    let single = Limits(rows: 1, byte_limit: 1)
    l63_check_diff(l63_paged_changes(read_handle, base, target, whole)?, rows_handle, neighbor, (2u64, 20u32), 3u64, "L63 (j): the forward diff of two Cold Snapshots")?
    l63_check_diff(l63_paged_changes(read_handle, base, target, single)?, rows_handle, neighbor, (2u64, 20u32), 3u64, "L63 (j): the forward diff resumed one row at a time")?
    let backward = l63_paged_changes(read_handle, target, base, single)?
    if list.len(backward) != 3 || backward[0u64].tree_key != failure_result_from_rep(pager.log_key(rows_handle.id, 2))? || backward[0u64].value != None || backward[2u64].tree_key != failure_result_from_rep(pager.log_key(neighbor.id, 7))? || backward[2u64].value != None {
        fail("L63 (j): the backward diff deletes the target's put and the neighbor's row")
    }
    l62_check_span_row(backward[1u64], rows_handle, 3, 30)
}

// TURSO #2: one seeded call's body. It reads Cold row `env.2` and mark
// `env.3`, adds the row (absent is 0) plus 1 to the mark, and replies with
// the mark it read * 1000000 + the row + 1. A missed attempt replies 0.
fn l63_schedule_body(mut tx: Tx, env: (Table[u64, u32], Table[u64, u32], u64, u64)) -> Result[Bytes, Bytes] {
    let Ok(seen) = fetch(tx, env.0, env.2) else {
        return Ok(types.key_word(0))
    }
    let old = match fetch(tx, env.1, env.3) {
        Ok(Some(m)) => m,
        _ => 0u32,
    }
    let add = match seen {
        Some(v) => v,
        None => 0u32
    }
    result.unwrap(put(mut tx, env.1, env.3, old + add + 1))
    Ok(schedule_reply(old, add))
}

fn schedule_reply(old: u32, add: u32) -> Bytes {
    let read: u64 = int.widen(old)
    let row: u64 = int.widen(add)
    types.key_word(read * 1000000 + row + 1)
}

// The ordered-map model of `rows` and `marks`, and the head it is current at.
type ScheduleModel {
    rows: Map[u64, u32],
    marks: Map[u64, u32],
    head: u64
}

// A call committed at the model's head: it read the model there (L62), so its
// reply is the model's, its one write lands, and the head moves by one (L63).
fn schedule_commit(mut db: Db, mut model: ScheduleModel, mut history: std.sim.history.History, stream: Bytes, env: (Table[u64, u32], Table[u64, u32], u64, u64), answer: Bytes) -> Result[(), Error] waits {
    let old = match option.copied(map.get(model.marks, env.3)) {
        Some(m) => m,
        None => 0u32
    }
    let add = match option.copied(map.get(model.rows, env.2)) {
        Some(v) => v,
        None => 0u32
    }
    let committed = version(snapshot(db))
    std.sim.history.check(std.sim.history.committed(mut history, clone(stream), model.head + 1, schedule_reply(old, add)))
    std.sim.history.check(std.sim.history.reply(mut history, 1, stream, committed, Some(clone(answer))))
    map.insert(mut model.marks, env.3, old + add + 1)
    schedule_moved(db, mut model, true)
    let retried = match admit_law_stream(mut db, stream, 0, request_digest(stream, stream))? {
        Duplicate(Stored(reply: take saved)) => Some(take saved),
        _ => None,
    }
    std.sim.history.check(std.sim.history.reply(mut history, 1, stream, version(snapshot(db)), retried))
    if version(snapshot(db)) != committed {
        fail("L63 schedule: retry advanced the head")
    }
    Ok(())
}

fn schedule_moved(db: Db, mut model: ScheduleModel, mutating: bool) {
    if mutating {
        model.head += 1
    }
    if version(snapshot(db)) != model.head {
        fail("L63 schedule: each mutating commit moves the head by exactly one and each skipped commit leaves it unchanged")
    }
}

// A seeded, bounded schedule over valid call operations: serve a call (it
// parks on a Cold miss or commits), a Hot write that moves the head, an
// inline Cold write that enters held mode and revokes every parked call,
// one poll and resume, settling a call to its decision, and cancelling one.
// The first move is a serve on the Cold root, which must park. The rest
// settle in order at the end. Every commit is checked against the
// model, a cancelled call writes nothing, and the parked queue ends empty,
// so every call's pins are released. Seeded bug `cancel_keeps_entry`
// (cancel_parked hands the position back but leaves its entry queued): the
// queue does not end empty.
fn l63_schedule(mut db: Db, handles: (Table[u64, u32], Table[u64, u32]), seed: u64) -> Result[(), Error] waits {
    let mut g = std.rand.new(seed, 2609)
    let plan = Plan(n_e: 1048576, s_e: 1048576, reply_max: 16)
    let mut model = ScheduleModel(rows: map.new(), marks: map.new(), head: version(snapshot(db)))
    map.insert(mut model.rows, 1u64, 10u32)
    map.insert(mut model.rows, 3u64, 30u32)
    map.insert(mut model.rows, 5u64, 50u32)
    let mut history = std.sim.history.new(seed)
    let mut parked: List[(Parked, Bytes, (Table[u64, u32], Table[u64, u32], u64, u64))] = list.new()
    let mut streams = 0u64
    for step in 0u64 .. 40 {
        // The first move serves a call on the reopened Cold root, so every
        // seed parks at least once before a Cold write or a delivery makes
        // the leaf resident.
        let op = if step == 0 {
            0u64
        } else {
            std.rand.below(mut g, 6)
        }
        if op == 0 && list.len(parked) < 3 {
            let row_key: u64 = 1 + std.rand.below(mut g, 6)
            let mark_key: u64 = std.rand.below(mut g, 4)
            let env: (Table[u64, u32], Table[u64, u32], u64, u64) = (copy_env(handles.0), copy_env(handles.1), row_key, mark_key)
            let stream = law_stream_bytes(types.key_word(1000 + streams), keyed_time(db))
            streams += 1
            let Admitted(take first) = admit_law_stream(mut db, stream, 0, request_digest(stream, stream))? else {
                fail("L63 schedule: a fresh stream is admitted")
            }
            // Admission records the stream at most once; the call's own
            // commit is counted from the head after it.
            let admitted = version(snapshot(db))
            if admitted != model.head && admitted != model.head + 1 {
                fail("L63 schedule: admission writes at most one version")
            }
            model.head = admitted
            match serve(mut db, take first, plan, None, copy_env(env), l63_schedule_body) {
                Ok(Parked(take p)) => {
                    // vopr probe
                    let _ = std.prop.sometimes("park", true)
                    list.push(mut parked, (take p, take stream, take env))
                },
                Ok(Committed(receipt)) => {
                    if step == 0 {
                        fail("L63 schedule: the first serve misses the Cold root and parks")
                    }
                    // vopr probe
                    let _ = std.prop.sometimes("commit without parking", true)
                    schedule_commit(mut db, mut model, mut history, stream, env, receipt.reply)?
                },
                _ => fail("L63 schedule: a served call parks or commits"),
            }
        } else if op == 1 {
            let key = std.rand.below(mut g, 4)
            let value: u32 = int.truncate(1 + std.rand.below(mut g, 1000))
            let Committed(_) = run(mut db, Some(100000), (copy_env(handles.1), key, value), fn(mut tx: Tx, env: (Table[u64, u32], u64, u32)) -> Result[(), Error] {
                put(mut tx, env.0, env.1, env.2)
            })? else {
                fail("L63 schedule: a Hot write commits")
            }
            // vopr probe
            let _ = std.prop.sometimes("head move", true)
            map.insert(mut model.marks, key, value)
            schedule_moved(db, mut model, true)
        } else if op == 2 {
            let key = 1 + std.rand.below(mut g, 6)
            let value: Option[u32] = if std.rand.below(mut g, 3) == 0 {
                None
            } else {
                Some(int.truncate(1 + std.rand.below(mut g, 1000)))
            }
            let Committed(_) = run(mut db, Some(100000), (copy_env(handles.0), key, value), fn(mut tx: Tx, env: (Table[u64, u32], u64, Option[u32])) -> Result[(), Error] {
                match env.2 {
                    Some(v) => put(mut tx, env.0, env.1, v),
                    None => {
                        let _ = delete(mut tx, env.0, env.1)?
                        Ok(())
                    },
                }
            })? else {
                fail("L63 schedule: an inline Cold write commits")
            }
            // vopr probe
            let _ = std.prop.sometimes("held write", true)
            let mutating = match value {
                Some(_) => true,
                None => map.contains(model.rows, key),
            }
            match value {
                Some(v) => map.insert(mut model.rows, key, v),
                None => {
                    let _ = map.remove(mut model.rows, key)
                },
            }
            schedule_moved(db, mut model, mutating)
        } else if op == 3 && list.len(parked) != 0 {
            let ready = poll_parked(mut db)?
            let at = std.rand.below(mut g, list.len(parked))
            let (take p, take stream, take env) = list.remove(mut parked, at)
            let was_ready = list.contains(ready, park_id(p))
            match resume_parked(mut db, take p, copy_env(env), l63_schedule_body) {
                Ok(Parked(take again)) => {
                    if was_ready {
                        // vopr probe
                        let _ = std.prop.sometimes("resume parks again", true)
                    }
                    list.push(mut parked, (take again, take stream, take env))
                },
                Ok(Committed(receipt)) => {
                    // vopr probe
                    let _ = std.prop.sometimes("resume commits", true)
                    schedule_commit(mut db, mut model, mut history, stream, env, receipt.reply)?
                },
                _ => fail("L63 schedule: a resumed call parks or commits"),
            }
        } else if op == 4 && list.len(parked) != 0 {
            let at = std.rand.below(mut g, list.len(parked))
            let (take p, take stream, take env) = list.remove(mut parked, at)
            let Ok(Committed(receipt)) = l63_settle(mut db, Ok(Parked(take p)), copy_env(env), l63_schedule_body) else {
                fail("L63 schedule: a settled call commits")
            }
            // vopr probe
            let _ = std.prop.sometimes("settle", true)
            schedule_commit(mut db, mut model, mut history, stream, env, receipt.reply)?
        } else if op == 5 && list.len(parked) != 0 {
            let at = std.rand.below(mut g, list.len(parked))
            let (take p, _, _) = list.remove(mut parked, at)
            let _ = cancel_parked(mut db, take p)
            // vopr probe
            let _ = std.prop.sometimes("cancel", true)
            if version(snapshot(db)) != model.head {
                fail("L63 schedule: a cancelled call commits nothing")
            }
        }
    }
    while list.len(parked) != 0 {
        let (take p, take stream, take env) = list.remove(mut parked, 0)
        let Ok(Committed(receipt)) = l63_settle(mut db, Ok(Parked(take p)), copy_env(env), l63_schedule_body) else {
            fail("L63 schedule: every remaining call commits")
        }
        schedule_commit(mut db, mut model, mut history, stream, env, receipt.reply)?
    }
    if list.len(pager.park_queue(db.pager).entries) != 0 {
        fail("L63 schedule: no call stays queued, so every call's pins are released")
    }
    for key in 0u64 .. 4 {
        if l63_mark(mut db, handles.1, key)? != option.copied(map.get(model.marks, key)) {
            fail("L63 schedule: each mark is the model's")
        }
    }
    for key in 1u64 .. 7 {
        let Committed(read) = run(mut db, Some(100000), (copy_env(handles.0), key), fn(mut tx: Tx, env: (Table[u64, u32], u64)) -> Result[Option[u32], Error] {
            fetch(tx, env.0, env.1)
        })? else {
            fail("L63 schedule: reading a row commits")
        }
        if read.value != option.copied(map.get(model.rows, key)) {
            fail("L63 schedule: each row is the model's")
        }
    }
    Ok(())
}

fn l63_seeded_run(d: Dir, c: Clock, r: Random, tasks: Tasks, seed: u64) -> Result[(), Error] waits {
    let (_, _, take opened, take rows, take marks) = l63_directory_fixture(d, c, r, tasks)?
    let mut db = take opened
    l63_schedule(mut db, (take rows, take marks), seed)?
    trust_store(mut db)?
    close(take db)
}

@test
fn test_l63_seeded_call_schedule(d: Dir, c: Clock, r: Random, tasks: Tasks, seed_grant: Env) -> Result[(), Error] waits {
    let seed = match std.sim.world.test_seed(seed_grant) {
        Some(active) => active,
        None => 1u64,
    }
    trust_seed_gate("test_l63_seeded_call_schedule", l63_seeded_run(d, c, r, tasks, seed))
}

// The hand-derived diff of a large table: each `(key, row)` in key order,
// with None for a deletion.
fn l63_check_rows(seen: List[Change], rows_handle: Table[u64, u32], expected: List[(u64, Option[u32])], why: String) -> Result[(), Error] {
    if list.len(seen) != list.len(expected) {
        fail(clone(why))
    }
    for at in 0u64 .. list.len(expected) {
        let (key, row) = expected[at]
        match row {
            Some(value) => l62_check_span_row(seen[at], rows_handle, key, value)?,
            None => if seen[at].tree_key != failure_result_from_rep(pager.log_key(rows_handle.id, key))? || seen[at].value != None {
                fail(clone(why))
            },
        }
    }
    Ok(())
}

// L63 (j) on a table of more than one level: 20,000 Cold rows (key 2k holds
// k), reopened, against a commit that deletes 0, 20000 and 39998, puts 3 = 7,
// 20001 = 9 and 39999 = 11, changes 30000 to 1 and rewrites 10000 with its
// own value 5000. Each direction's diff is the edit set, read whole and one
// change per page; the rewrite is no change. It is red when the diff skips a
// changed leaf under an unchanged-looking parent or reports an equal row.
@test
fn test_l63_change_pages_between_large_cold_snapshots(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = l70_open_options(300000000u64)?
    {
        let mut db = open(tasks, directory, c, r, options)?
        let (rows, _) = law_pair(mut db, "rows", std.codec.key_u64(), std.codec.of_u32(), "marks", std.codec.key_u64(), std.codec.of_u32())?
        set_residency(mut db, rows.id, Tiered)?
        for batch in 0u64 .. 10 {
            let Committed(_) = run(mut db, Some(10000000), (copy_env(rows), batch), fn(mut tx: Tx, env: (Table[u64, u32], u64)) -> Result[(), Error] {
                for at in 0u64 .. 2000 {
                    let k = env.1 * 2000 + at
                    put(mut tx, env.0, 2 * k, int.truncate(k))?
                }
                Ok(())
            })? else {
                fail("L63 (j): the large table's rows commit")
            }
        }
        let cut = checkpoint(mut db)?
        durable(mut db, cut)?
        close(take db)?
    }
    let mut db = open(tasks, directory, c, r, options)?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u32())?
    let base = snapshot(db)
    let Committed(_) = run(mut db, Some(1048576u64), copy_env(rows), fn(mut tx: Tx, handle: Table[u64, u32]) -> Result[(), Error] {
        let _ = delete(mut tx, handle, 0u64)?
        put(mut tx, handle, 3u64, 7u32)?
        put(mut tx, handle, 10000u64, 5000u32)?
        let _ = delete(mut tx, handle, 20000u64)?
        put(mut tx, handle, 20001u64, 9u32)?
        put(mut tx, handle, 30000u64, 1u32)?
        let _ = delete(mut tx, handle, 39998u64)?
        put(mut tx, handle, 39999u64, 11u32)
    })? else {
        fail("L63 (j): the large table's edits commit")
    }
    let target = snapshot(db)
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let whole = Limits(rows: 64, byte_limit: VALUE_LIMIT + 1048576)
    let single = Limits(rows: 1, byte_limit: 1)
    let mut forward: List[(u64, Option[u32])] = list.new()
    list.push(mut forward, (0u64, None))
    list.push(mut forward, (3u64, Some(7u32)))
    list.push(mut forward, (20000u64, None))
    list.push(mut forward, (20001u64, Some(9u32)))
    list.push(mut forward, (30000u64, Some(1u32)))
    list.push(mut forward, (39998u64, None))
    list.push(mut forward, (39999u64, Some(11u32)))
    let mut backward: List[(u64, Option[u32])] = list.new()
    list.push(mut backward, (0u64, Some(0u32)))
    list.push(mut backward, (3u64, None))
    list.push(mut backward, (20000u64, Some(10000u32)))
    list.push(mut backward, (20001u64, None))
    list.push(mut backward, (30000u64, Some(15000u32)))
    list.push(mut backward, (39998u64, Some(19999u32)))
    list.push(mut backward, (39999u64, None))
    l63_check_rows(l63_paged_changes(read_handle, base, target, whole)?, rows, forward, "L63 (j): the large forward diff is the edit set")?
    l63_check_rows(l63_paged_changes(read_handle, base, target, single)?, rows, forward, "L63 (j): the large forward diff resumed one change at a time")?
    l63_check_rows(l63_paged_changes(read_handle, target, base, whole)?, rows, backward, "L63 (j): the large backward diff undoes the edit set")?
    l63_check_rows(l63_paged_changes(read_handle, target, base, single)?, rows, backward, "L63 (j): the large backward diff resumed one change at a time")?
    close(take db)
}

  addr a0 = v9 byte v7 : u8            ; the root's tag, the first data byte
  addr a1 = v9 byte v18 : u8           ; the element at the cursor
  addr a2 = v9 byte v13 : u32          ; the sequence's count
  addr a3 = v9 byte v29 : u32          ; its byte length
  addr a4 = v9 : u64                   ; header: used bytes
  addr a5 = v9 byte v31 : u64          ; header: W
  addr a6 = v9 byte v36 : u32          ; the byte length, found through the header's W
b0(v0: u64, v1: u64):
  v2: ptr = region_open
  v3: u64 = const 7
  v4: u64 = add v1, v3
  v5: u64 = const 18446744073709551608
  v6: u64 = bitand v4, v5              ; round8(n)
  v7: u64 = const 16
  v8: u64 = add v1, v7                 ; the header and n bytes; also the end
  v9: ptr, v10: u64, v11: u64 = alloc stable v8 align 8 charge v6 in v2
  v48: ptr = const 0x0
  v49: bool = ne v9, v48
  branch v49, b1, b8
b1:
  v12: u64 = const 0
  v13: u64 = const 17
  v14: bool = le v13, v8               ; the tag, before it is written
  branch v14, b2, b7(v12)
b2:
  address a0
  v15: u8 = const 1
  store a0, v15                        ; Arr
  v16: u64 = const 25
  v17: bool = le v16, v8               ; the count and byte length, reserved
  branch v17, b3(v16, v12), b7(v12)
b3(v18: u64, v19: u64):
  v20: bool = lt v19, v0
  branch v20, b4, b6
b4:
  v21: u64 = const 1
  v22: u64 = add v18, v21
  v23: bool = le v22, v8               ; the element's byte, before it is written
  branch v23, b5, b7(v19)
b5:
  address a1
  v24: u8 = const 0
  store a1, v24                        ; Null
  v25: u64 = add v19, v21              ; the count advances once the element is complete
  jump b3(v22, v25)
b6:
  v26: u64 = sub v18, v16              ; the elements' byte length
  v27: u32 = truncate v19
  v28: u32 = truncate v26
  address a2
  store a2, v27
  v29: u64 = const 21
  address a3
  store a3, v28
  v30: u64 = sub v18, v7               ; used
  address a4
  store a4, v30
  v31: u64 = const 8
  address a5
  v32: u64 = const 4
  store a5, v32
  v33: u64 = add v30, v3
  v34: u64 = bitand v33, v5
  trim v9 in v2 entry v11 from v6 charge v34                   ; finish_trim refunds round8(n) - round8(used)
  v35: u64 = read a5
  v36: u64 = add v13, v35
  address a6
  v37: u32 = read a6
  v38: u64 = widen v37
  v39: u64 = const 18446744073709551615
  v40: ptr, v41: u64 = alloc for seq u8 v31 align 8 charge v39   ; refused: v41 is the room
  region_close v2
  return v12, v19, v38, v30, v41
b7(v42: u64):                          ; Overflow: nothing published, round8(n) stays
  v43: u64 = const 18446744073709551615
  v44: u64 = const 8
  v45: ptr, v46: u64 = alloc for seq u8 v44 align 8 charge v43
  region_close v2
  v47: u64 = const 1
  return v47, v42, v12, v12, v46
b8:
  region_close v2
  raise unwrap
}
fn f1 = n1 g2 {
b0(v0: bool, v1: u64):
  v2: u64 = call rt.dest_id g1 ()      ; the destination the child came from
  v3: u64 = call rt.dest_id g1 ()      ; the destination being written
  branch v0, b1(v2), b1(v3)
b1(v4: u64):                           ; the child's identity

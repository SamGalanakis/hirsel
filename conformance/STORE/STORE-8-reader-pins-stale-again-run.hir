// steps: 20000000
// A reader pin over authority.objects@1 on objects.sim@1 answering a head
// that stays stale: authority `rK` answers requests K to K + 3, each if it is a
// get of a key whose latest write replaced or deleted bytes, with those older
// bytes, as a lagging replica would. Where K is a head get that is four stale
// heads in a row, as many as the authority reads before it refuses. A head
// that stays stale is an older state, never corruption. (One stale read per
// authority: STORE-8-reader-pins-stale-run.)
// Each run writes, acquires a pin, writes again, and takes the store over and
// compacts it, reading the pin with store.at_pin after the acquire, the
// takeover and the compaction, and the readers table after the takeover. An
// acquire that returned Ok is durable at the strongest level, so each read is
// the pinned state or a refusal (Storage or Refused), never PinReleased(),
// NotRetained(), Corrupt(..) or another state, and the takeover lists the one
// holder at the pinned version.
fn put_x(mut tx: store.Tx, info: store.CallInfo, n: u8) -> Result[(), store.TxError] {
  store.tx_put(mut tx, b"x", bytes.from_list([n]))
}

// Streams and request digests are 32 bytes: the SHA-256 of a name.
fn d32(name: Bytes) -> Bytes {
  bytes.from_inline(sha256.digest(name))
}

fn acquire(mut s: store.Store, p: store.ReaderPin) -> Result[
  store.HeldPin,
  store.CallFailure[store.PinError]
] {
  let request = CallRequest(
    stream: d32(b"reader"),
    epoch: 1,
    position: 1,
    digest: d32(b"a"),
    acknowledged: 0
  )
  store.call(mut s, request, store.acquire_reader_pin, p)
}

pub type Failed = Check | Wrong(String)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

// 1 when `p` reads the state whose `x` is 1 at `v`, 0 for a refusal; any
// other answer is wrong.
fn judged(a: Authority, p: store.HeldPin, v: store.Version of a, when: String) -> Result[
  u64,
  Failed
] {
  match store.at_pin(a, p) {
    Ok(snap) => {
      if store.get(snap, b"x") == Some(bytes.from_list([1])) && store.version(a, snap) == v {
        Ok(1)
      } else {
        Error(Wrong(f"{when}: another state"))
      }
    },
    Error(Storage(_)) => Ok(0),
    Error(Refused(_)) => Ok(0),
    Error(PinReleased()) => Error(Wrong(f"{when}: PinReleased")),
    Error(NotRetained()) => Error(Wrong(f"{when}: NotRetained")),
    Error(Corrupt(name)) => Error(Wrong(f"{when}: Corrupt {name}")),
    Error(_) => Error(Wrong(f"{when}: another error")),
  }
}

// A takeover inherits the pin: the readers table lists exactly one holder,
// at `v`, unless the store refuses to read it.
fn inherited(a: Authority, mut s: store.Store, v: store.Version of a, when: String) -> Result[
  (),
  Failed
] {
  match store.reader_pins(a, mut s) {
    Ok(held) => {
      if list.len(held) != 1 {
        return Error(Wrong(f"{when}: {list.len(held)} holders"))
      }
      for h in held {
        if store.pin_version(a, h) != v {
          return Error(Wrong(f"{when}: a holder at another version"))
        }
      }
      Ok(())
    },
    Error(Corrupt(name)) => Error(Wrong(f"{when}: Corrupt {name}")),
    Error(_) => Ok(()),
  }
}

// One run over the authority `name`: how many of its pin reads read the
// pinned state.
fn run(rt: Io, r: Random, name: String) -> Result[u64, Failed] {
  let Ok(a) = io.authority(rt, name) else {
    return Error(Check())
  }
  let Ok(p) = store.new_reader_pin(r) else {
    return Error(Check())
  }
  let Ok(opened) = store.open(a, store.default_config()) else {
    return Ok(0)
  }
  let mut s = take opened
  let done: Result[(), store.TxFailure[store.TxError]] = store.transact(mut s, put_x, 1)
  let Ok(first) = store.snapshot(a, mut s, authority.floor(a)) else {
    return Ok(0)
  }
  let pinned = store.version(a, first)
  if done != Ok(()) {
    return Ok(0)
  }
  let Ok(h) = acquire(mut s, p) else {
    return Ok(0)
  }
  let mut good = judged(a, h, pinned, f"{name} after the acquire")?
  let _: Result[(), store.TxFailure[store.TxError]] = store.transact(mut s, put_x, 2)
  let _ = store.close(take s)
  let Ok(again) = store.open(a, store.default_config()) else {
    return Ok(good)
  }
  let mut t = take again
  inherited(a, mut t, pinned, f"{name} after the takeover")?
  good += judged(a, h, pinned, f"{name} after the takeover")?
  if store.compact(mut t) == Ok(()) {
    good += judged(a, h, pinned, f"{name} after the compaction")?
  }
  let _ = store.close(take t)
  Ok(good)
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(r) = io.random(rt) else {
    return Error(Check())
  }
  let mut good: u64 = 0
  for k in 1u64..44 + 1 {
    good += run(rt, r, f"r{k}")?
  }
  check(good > 0)
}

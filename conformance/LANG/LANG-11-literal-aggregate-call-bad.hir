// rule: LANG-11
// twin: LANG/LANG-11-literal-tuple-call-run.hir
// expect: reject LANG-2 at line 14
fn apply[T, U](take value: T, take f: fn(take T) -> U) -> U uses {f} {
  f(take value)
}

fn transfer(take value: (u64, u64)) -> u64 {
  7u64
}

fn main() -> u64 {
  let x = 1u64
  apply((x, 1), transfer)
}

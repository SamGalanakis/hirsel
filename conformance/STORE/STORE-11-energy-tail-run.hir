// rule: STORE-11
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"}}
// steps: 20000000
// A self-tail loop runs under the body's budget (storage.md STORE-11 "Energy").
// Its call becomes a jump back to the body's entry, so the entry charge is the
// loop's only charge and pays one unit per trip. A body that tail-calls itself
// forever, and one whose finite tail loop is far over the budget, each end
// Limit(Energy()) with nothing committed.
@serializable
type Spun = Short | Db(store.TxError)

fn spin(x: u64) -> u64 {
  spin(x)
}

fn count(n: u64, acc: u64) -> u64 {
  if n == 0 {
    acc
  } else {
    count(n - 1, int.wrapping_add(acc, n))
  }
}

fn spins(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[u64, Spun] {
  store.tx_put(mut tx, b"spun", b"yes") ? Db
  Ok(spin(n))
}

fn counts(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[u64, Spun] {
  store.tx_put(mut tx, b"counted", b"yes") ? Db
  Ok(count(n, 0))
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let at = authority.floor(a)
  let mut config = store.default_config()
  config.energy = 100000
  let mut s = store.open(a, config) ? Store
  let under: Result[u64, store.TxFailure[Spun]] = store.transact(mut s, counts, 100u64)
  check(under == Ok(5050))?
  let first = store.snapshot(a, mut s, at) ? Store
  let forever: Result[u64, store.TxFailure[Spun]] = store.transact(mut s, spins, 1u64)
  check(forever == Error(Limit(Energy())))?
  let far: Result[u64, store.TxFailure[Spun]] = store.transact(
    mut s,
    counts,
    10000000000000u64
  )
  check(far == Error(Limit(Energy())))?
  let after = store.snapshot(a, mut s, at) ? Store
  check(store.version(a, after) == store.version(a, first))?
  check(store.get(copy after, b"spun") == None())?
  store.close(take s) ? Store
  Ok(())
}

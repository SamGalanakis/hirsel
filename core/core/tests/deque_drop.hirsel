// expect: run normal_four1(out) = 4
fn normal_four1(out: Stdout) -> u64 { drop_ring(out, 4, 1, false) }

// expect: stdout "BCDA"
// expect: run failed_four1(out) = fail Unwrap
fn failed_four1(out: Stdout) -> u64 { drop_ring(out, 4, 1, true) }


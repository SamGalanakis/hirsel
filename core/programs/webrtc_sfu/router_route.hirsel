// RTC-5 fan-out, cross-unit messages and the home unit's demux; RTC-6 keyframe
// requests.
const EVERY: u32 = 0xffffffff

const SLOT_SHIFT: u64 = 6

/// Take one datagram from the socket (RTC-3, the home unit's demux). A datagram from a
/// 5-tuple in the table goes to that row's session. A STUN Binding from elsewhere
/// goes to the local session its USERNAME names, whose ICE agent checks the
/// MESSAGE-INTEGRITY; a nomination it accepts moves the row to its source. Anything
/// else is dropped and counted `unknown`.
pub fn deliver(mut r: Router, now: u64, from: Addr, mut slot: Bytes, mut out: peer.Outbox) -> Result[(), RouterError] {
    let mut row: Option[(peer.RoomId, peer.Gen)] = None
    for w in r.rows {
        if w.from == from {
            row = Some((w.room, w.who))
        }
    }
    if let Some((room, who)) = row {
        receive(mut r, now, room, who, from, mut slot, mut out)?
        return follow(mut r, room, who)
    }
    if let Some((room, who)) = named(r, slot) {
        receive(mut r, now, room, who, from, mut slot, mut out)?
        return follow(mut r, room, who)
    }
    r.counts.unknown += 1
    Ok(())
}

// The local session a STUN Binding's USERNAME names, by its ufrag before the colon.
fn named(r: Router, slot: Bytes) -> Option[(peer.RoomId, peer.Gen)] {
    if peer.classify(slot) != Stun {
        return None
    }
    let Ok(m) = stun_ice.decode(slot) else {
        return None
    }
    let Some(u) = m.username else {
        return None
    }
    let mut colon = u.lo
    while colon < u.hi && slot[colon] != 58 {
        colon += 1
    }
    let ufrag = list.slice(slot, u.lo, colon)
    for mb in r.members {
        if peer.named(mb.session, ufrag) {
            return Some((mb.who.room, mb.who.gen))
        }
    }
    None
}

// Keep `who`'s row at its session's selected path.
fn follow(mut r: Router, room: peer.RoomId, who: peer.Gen) -> Result[(), RouterError] {
    let Some(mi) = member_at(r, room, who) else {
        return Ok(())
    }
    let Some(at) = peer.selected(r.members[mi].session) else {
        return Ok(())
    }
    for i in 0u64 .. list.len(r.rows) {
        if r.rows[i].room == room && r.rows[i].who == who {
            r.rows[i].from = at
            return Ok(())
        }
    }
    list.try_reserve(mut r.rows, 1) ?=> |c| Capacity(c)
    list.push(mut r.rows, Row(from: at, room: room, who: who))
    Ok(())
}

/// Take one datagram on `who`'s session and route what it yields: media and
/// repairs to the publication's down-tracks, feedback to its own answers.
pub fn receive(mut r: Router, now: u64, room: peer.RoomId, who: peer.Gen, from: Addr, mut slot: Bytes, mut out: peer.Outbox) -> Result[(), RouterError] {
    let Some(mi) = member_at(r, room, who) else {
        return Error(NoParticipant)
    }
    let input = peer.receive(mut r.members[mi].session, now, from, mut slot, mut out) ?=> |take e| Peer(e)
    let mut restarted = false
    while let Some(track) = peer.collided(mut r.members[mi].session) {
        restart(mut r, now, room, who, track, mut out)?
        restarted = true
    }
    if restarted {
        reoffer(mut r, room, who)
    }
    // RTC-6: a moved estimate reallocates the subscriber's down-tracks.
    if peer.target_bps(r.members[mi].session) != r.members[mi].estimate {
        allocate(mut r, mi, None, now, mut out)?
        wants(mut r, now)
    }
    match input {
        Media(m) => route(mut r, now, mi, m, true, slot, mut out),
        Repair(m) => route(mut r, now, mi, m, false, slot, mut out),
        Control(take c) => control(mut r, now, mi, take c, mut out),
        _ => Ok(()),
    }
}

// A collision restarted the track's stream (RTC-4): it forgets the old source's
// parameter sets and any rebind in flight, and takes its target again, which asks
// the publisher for a keyframe.
fn restart(mut r: Router, now: u64, room: peer.RoomId, who: peer.Gen, track: u16, mut out: peer.Outbox) -> Result[(), RouterError] {
    for d in 0u64 .. list.len(r.downs) {
        if r.downs[d].sub == who && r.downs[d].room == room && r.downs[d].track == track {
            r.downs[d].previous = None
            media_bits.unit.clear_parameter_sets(mut r.downs[d].sets)
            r.downs[d].sets_source = None
            r.downs[d].chains = media_bits.unit.av1_chains()
            r.downs[d].next_chains = media_bits.unit.av1_chains()
            let p = r.downs[d].publication
            let target = r.downs[d].target
            return set_target(mut r, room, who, p, target, now, mut out)
        }
    }
    Ok(())
}

// RTC-4: the collided down-tracks' fresh SSRCs go to the participant in one re-offer,
// which the control unit sends on. A re-offer the session cannot make is refused.
fn reoffer(mut r: Router, room: peer.RoomId, who: peer.Gen) {
    let Some(mi) = member_at(r, room, who) else {
        return
    }
    let mut text: Bytes = list.new()
    match peer.reoffer(mut r.members[mi].session, sdp.default_policy(), mut text) {
        Ok(version) => {
            if r.unit == 0 {
                list.push(mut r.notices, Offer(who: who, version: version, text: take text))
            } else {
                post(mut r, 0, Offer(room: room, src: who, version: version), shared.new(take text))
            }
        },
        Error(_) => shut(mut r, room, who),
    }
}

// Tell the control unit that `who`'s re-offer was refused (RTC-4). Its adapter revokes
// the participant, which closes the session, and the participant rejoins.
fn shut(mut r: Router, room: peer.RoomId, who: peer.Gen) {
    if r.unit == 0 {
        list.push(mut r.notices, Shut(who: who))
    } else {
        post_bare(mut r, 0, Shut(room: room, src: who))
    }
}

/// Take the participant's answer to its re-offer (RTC-4) on the control unit and hand it
/// to the session's home unit, which installs it or, refused, raises `Shut`. A fenced or
/// unknown participant's answer is `Fenced` or `NoParticipant` and goes nowhere.
pub fn answer_reoffer(mut r: Router, room: peer.RoomId, who: peer.Gen, version: u64, take text: Bytes) -> Result[(), RouterError] {
    if fenced(r, room, who) {
        return Error(Fenced)
    }
    let Some(si) = seat_at(r, room, who) else {
        return Error(NoParticipant)
    }
    let home = r.roster[si].home
    if home == r.unit {
        settle_answer(mut r, room, who, version, text)
    } else {
        post(mut r, home, Answer(room: room, dst: who, version: version), shared.new(take text))
    }
    Ok(())
}

fn settle_answer(mut r: Router, room: peer.RoomId, who: peer.Gen, version: u64, text: Bytes) {
    let Some(mi) = member_at(r, room, who) else {
        return
    }
    if let Error(_) = peer.answer_reoffer(mut r.members[mi].session, version, text) {
        shut(mut r, room, who)
    }
}

fn owned(r: Router, room: peer.RoomId, owner: peer.Gen, section: u8) -> Option[u64] {
    for i in 0u64 .. list.len(r.publications) {
        let p = r.publications[i]
        if p.room == room && p.owner == owner && p.section == section {
            return Some(i)
        }
    }
    None
}

fn rewrite_unit(u: media_bits.unit.Unit) -> rtp.rewrite.Unit {
    rtp.rewrite.Unit(start: u.start, end: u.end, keyframe: u.keyframe, needs: u.needs, switches: u.switches, frame: 0)
}

// The packet's RTP-11 facts where they need no per-leg state: VP8 as ingress parsed
// its payload descriptor, audio as a whole frame that every target needs and that switches.
fn shared_unit(codec: sdp.Codec, m: peer.MediaIn) -> Option[rtp.rewrite.Unit] {
    match codec {
        Vp8 => match m.layer {
            Some(u) => Some(rewrite_unit(u)),
            None => None,
        },
        Opus => Some(rtp.rewrite.Unit(start: true, end: true, keyframe: true, needs: EVERY, switches: EVERY, frame: 0)),
        _ => None,
    }
}

// Keep the plaintext packet up to the payload's end in the publication's ring, for
// repairs. The handle names the slot and is never reused in the router.
fn store(mut g: Ring, handle: u64, packet: Bytes) -> u64 {
    let n = list.len(g.slots)
    if n == 0 || list.len(packet) > RING_SLOT {
        return handle
    }
    let k = (handle >> SLOT_SHIFT) % n
    list.clear(mut g.slots[k])
    list.append(mut g.slots[k], packet)
    g.handles[k] = handle
    handle
}

fn route(mut r: Router, now: u64, mi: u64, m: peer.MediaIn, fresh: bool, slot: Bytes, mut out: peer.Outbox) -> Result[(), RouterError] {
    let owner = r.members[mi].who
    // A suspended room routes no media and no repair (RTC-7, Suspend).
    if suspended(r, owner.room) {
        return Ok(())
    }
    let Some(pi) = owned(r, owner.room, owner.gen, m.section) else {
        return Ok(())
    }
    let e: u64 = int.widen(m.encoding)
    if e >= list.len(r.publications[pi].encodings) {
        return Ok(())
    }
    r.publications[pi].encodings[e].ssrc = m.ssrc
    if m.reset {
        keyframe(mut r, now, pi, m.encoding, Loss, mut out)?
    }
    let end = m.payload_at + m.payload_len
    // RTC-6: the rate and the speaker score read every media packet; then a packet of
    // an encoding outside the published mask goes no further.
    if fresh {
        measure(mut r, pi, e, end, now, mut out)?
        observe(mut r, pi, m, now, mut out)?
        if let Some(plan) = m.plan {
            planned(mut r, pi, m.encoding, plan, now, mut out)?
        }
    }
    let _ = published(mut r, pi, now)
    if !r.publications[pi].encodings[e].on {
        return Ok(())
    }
    let handle = store(mut r.publications[pi].ring, r.next_handle, list.slice(slot, 0, end))
    r.next_handle += 1u64 << SLOT_SHIFT
    let talking = speaking(r.publications[pi].voice)
    spread(mut r, now, pi, m, handle, talking, slot, mut out)
}

// RTP-11's `after_end` for an H.264 packet of this encoding: the packet at index - 1
// was seen and ended an access unit (its marker, or another timestamp). Before any
// packet of the source is seen, or after its stream restarted, a packet may start a
// unit. Only a newer index moves the record, so a retransmission of an old packet
// cannot rewind it.
fn ended(mut enc: Encoding, m: peer.MediaIn) -> bool {
    if m.reset {
        enc.last = None
    }
    let after = match enc.last {
        None => true,
        Some(i) => i + 1 == m.index && (enc.last_marker || enc.last_ts != m.wide),
    }
    let newer = match enc.last {
        None => true,
        Some(i) => m.index > i,
    }
    if newer {
        enc.last = Some(m.index)
        enc.last_ts = m.wide
        enc.last_marker = m.marker
    }
    after
}

// RTC-5 fan-out steps 2 and 3 for one packet of publication `pi`: each local
// down-track takes it through its `Rewrite`, and on the home unit each other unit
// with a down-track of it gets one `Media` message.
// The targets whose picture a packet closes (RTC-6, the marker bit): the last packet of
// a layer frame closes it for each target whose highest spatial layer is the frame's.
// VP9's target `i` is `4s + t`; an AV1 target's layers are its structure's `(S_d, T_d)`.
fn picture_ends(vp9: Option[media_bits.unit.Vp9Frame], av1: Option[media_bits.dependency.Frame], structure: View[media_bits.dependency.Structure]) -> u32 {
    if let Some(f) = vp9 {
        if !f.end || f.spatial > 7 {
            return 0
        }
        let shift: u32 = 4u32 * int.widen(f.spatial)
        return 15u32 << shift
    }
    let Some(f) = av1 else {
        return 0
    }
    let mut closes = 0u32
    if !f.last {
        return closes
    }
    for d in 0u64 .. order.min(f.decode_target_count, 32u64) {
        if let Some((s, _)) = media_bits.dependency.target_layers(structure, d) {
            if s == f.spatial {
                let bit: u32 = int.narrow(d)
                closes = closes | (1u32 << bit)
            }
        }
    }
    closes
}

fn spread(mut r: Router, now: u64, pi: u64, m: peer.MediaIn, handle: u64, talking: bool, packet: Bytes, mut out: peer.Outbox) -> Result[(), RouterError] {
    let room = r.publications[pi].room
    let owner = r.publications[pi].owner
    let e: u64 = int.widen(m.encoding)
    let codec = r.publications[pi].codec
    let id = r.publications[pi].id
    let end = m.payload_at + m.payload_len
    let payload = list.slice(packet, m.payload_at, end)
    let after_end = ended(mut r.publications[pi].encodings[e], m)
    let mut joint = shared_unit(codec, m)
    if let None = joint {
        if codec == Vp8 {
            r.counts.unparsed += 1
            return Ok(())
        }
    }
    if let Some(u) = joint {
        if u.keyframe && u.start {
            rtp.loss.keyframe_seen(mut r.publications[pi].encodings[e].keyframes)
        }
    }
    // VP9 fills `switches` per down-track from its current target (RTC-6).
    let vp9 = if codec == Vp9 {
        match media_bits.unit.vp9_frame(payload, m.marker) {
            Ok(f) => Some(f),
            Error(Unmappable) => {
                // A layer frame whose SID or TID passes 3 is in no target of the map:
                // every leg keeps its target and closes the frame up, so no leg's
                // numbering has a hole (RTC-6). It is counted once.
                let Ok(d) = media_bits.vp9.parse(payload) else {
                    r.counts.unparsed += 1
                    return Ok(())
                }
                let spatial: u16 = match d.layer {
                    Some(l) => int.widen(l.spatial),
                    None => 0,
                }
                r.counts.unmapped += 1
                joint = Some(rtp.rewrite.Unit(start: d.first, end: d.last || m.marker, keyframe: false, needs: 0, switches: 0, frame: spatial))
                None
            },
            Error(_) => {
                r.counts.unparsed += 1
                return Ok(())
            },
        }
    } else {
        None
    }
    if let Some(f) = vp9 {
        if f.keyframe && f.begin {
            rtp.loss.keyframe_seen(mut r.publications[pi].encodings[e].keyframes)
        }
    }
    // AV1: the dependency descriptor is parsed once per packet against the encoding's
    // structure (AV1 RTP section A.8). One that brings a new structure maps the
    // encoding's targets again before its keyframe reaches any leg (RTC-6).
    let av1 = if codec == Av1 {
        if m.dd_len == 0 || m.dd_at + m.dd_len > list.len(packet) {
            r.counts.unparsed += 1
            return Ok(())
        }
        let value = list.slice(packet, m.dd_at, m.dd_at + m.dd_len)
        let brings = m.dd_len > 3 && (value[3] & 128) != 0
        let hi: u16 = int.widen(value[1])
        let lo: u16 = int.widen(value[2])
        let number: u16 = (hi << 8) | lo
        // A structure older than the one in use (a repair or a reordered packet of an
        // earlier keyframe) is dropped: the frames it describes are gone from every map.
        if brings {
            if let Some(last) = r.publications[pi].encodings[e].structure_frame {
                let behind = int.wrapping_sub(last, number)
                if behind != 0 && behind < 32768 {
                    r.counts.unparsed += 1
                    return Ok(())
                }
            }
        }
        let Ok(f) = media_bits.dependency.parse(value, mut r.publications[pi].encodings[e].structure) else {
            r.counts.unparsed += 1
            return Ok(())
        }
        if brings {
            r.publications[pi].encodings[e].structure_frame = Some(number)
            remap(mut r, pi, m.encoding)
        }
        if f.first {
            if let Ok(a) = media_bits.av1.parse_rtp(payload) {
                if a.starts_sequence {
                    rtp.loss.keyframe_seen(mut r.publications[pi].encodings[e].keyframes)
                }
            }
        }
        Some(f)
    } else {
        None
    }
    let closes = picture_ends(vp9, av1, view r.publications[pi].encodings[e].structure)
    let src = source(id, m.encoding)
    if let Some(o) = m.orientation {
        r.publications[pi].orientation = Some(o)
    }
    let orientation = r.publications[pi].orientation
    // RTC-6's `V` toward a leg with `vad` on: the publisher's own `V` when its leg
    // negotiated it, and otherwise whether the publication is speaking.
    let voice = match m.voice {
        Some(v) => v,
        None => talking,
    }
    let mut waits = false
    let mut settled = false
    // Other units with a down-track of this publication, one bit per unit.
    let mut remote = 0u64
    for d in 0u64 .. list.len(r.downs) {
        if r.downs[d].room != room || (r.downs[d].publication != id && r.downs[d].previous != Some(id)) {
            continue
        }
        if r.downs[d].home != r.unit {
            remote = remote | (1u64 << int.widen(r.downs[d].home))
            continue
        }
        // While a rebind waits, the new publication's AV1 packets are judged with its
        // own chains.
        let fresh = r.downs[d].publication == id && r.downs[d].previous != None
        let Some(si) = member_at(r, room, r.downs[d].sub) else {
            continue
        }
        let unit = match joint {
            Some(u) => u,
            None => match vp9 {
                Some(f) => {
                    let current = peer.current_layer(r.members[si].session, r.downs[d].track, src)
                    match media_bits.unit.vp9_unit(f, current, r.publications[pi].encodings[e].vp9) {
                        // A picture's layer frames share its timestamp: the spatial id
                        // tells them apart (RFC 9628 section 4.2).
                        Ok(u) => {
                            let mut w = rewrite_unit(u)
                            w.frame = int.widen(f.spatial)
                            w
                        },
                        Error(_) => {
                            r.counts.unmapped += 1
                            continue
                        },
                    }
                },
                None => match av1 {
                    Some(f) => {
                        let chains = if fresh {
                            r.downs[d].next_chains
                        } else {
                            r.downs[d].chains
                        }
                        match media_bits.unit.av1(payload, f, view r.publications[pi].encodings[e].structure, chains) {
                            // A picture's layer frames share its timestamp: the frame
                            // number tells them apart (rtp RTP-11).
                            Ok(u) => {
                                let mut w = rewrite_unit(u)
                                w.frame = f.number
                                w
                            },
                            Error(_) => {
                                r.counts.unparsed += 1
                                continue
                            },
                        }
                    },
                    None => {
                        if codec != H264 {
                            continue
                        }
                        // RTP-11: a source other than the one the leg last sent has
                        // no parameter sets on this leg.
                        let judged = if r.downs[d].sets_source == Some(src) {
                            media_bits.unit.h264(payload, m.marker, after_end, r.downs[d].sets)
                        } else {
                            media_bits.unit.h264(payload, m.marker, after_end, media_bits.unit.parameter_sets())
                        }
                        match judged {
                            Ok(u) => rewrite_unit(u),
                            Error(_) => {
                                r.counts.unparsed += 1
                                continue
                            },
                        }
                    },
                },
            },
        }
        let leg = peer.Leg(src: owner, handle: handle, source: src, index: m.index, ts: m.wide, marker: m.marker, codec: codec, padding_only: m.payload_len == 0, unit: unit, level: m.audio_level, voice: voice, from: m.payload_at, len: m.payload_len, closes: closes, dd_at: m.dd_at, dd_len: m.dd_len, orientation: orientation, capture: m.capture)
        let track = r.downs[d].track
        let sent = peer.forward(mut r.members[si].session, now, track, leg, packet, r.publications[pi].red, mut out) ?=> |take x| Peer(x)
        if sent == OnMedia && codec == H264 {
            // A switch: the old source's sets no longer describe what the receiver holds.
            if r.downs[d].sets_source != Some(src) {
                media_bits.unit.clear_parameter_sets(mut r.downs[d].sets)
                r.downs[d].sets_source = Some(src)
            }
            let _ = media_bits.unit.h264_sent(mut r.downs[d].sets, payload)
        }
        if sent == OnMedia {
            if let Some(f) = av1 {
                if fresh {
                    media_bits.unit.av1_forwarded(mut r.downs[d].next_chains, f, view r.publications[pi].encodings[e].structure)
                } else {
                    media_bits.unit.av1_forwarded(mut r.downs[d].chains, f, view r.publications[pi].encodings[e].structure)
                }
            }
        }
        let pending = peer.pending(r.members[si].session, track)
        if sent == Held && pending == Some(src) {
            waits = true
        }
        if pending == None && r.downs[d].previous != None {
            settle(mut r, d)
            settled = true
        }
    }
    if let Some(f) = vp9 {
        media_bits.unit.vp9_observe(mut r.publications[pi].encodings[e].vp9, f)
    }
    // RTP-13: the primary joins the ring after every leg read it, so it is past only
    // for the packets after it.
    rtp.red.keep(mut r.publications[pi].red, m.index, m.ts, packet, m.payload_at, m.payload_len)
    // Step 3, on the home unit only: one plaintext copy, shared by every other unit
    // that has a down-track of the publication.
    if remote != 0 && r.publications[pi].home == r.unit {
        let mut plain: Bytes = list.new()
        list.try_reserve(mut plain, end) ?=> |c| Capacity(c)
        list.append(mut plain, list.slice(packet, 0, end))
        let held = shared.new(take plain)
        let rate: u64 = int.narrow(rate_of(r, pi, e))
        let dropped = r.publications[pi].dropped
        for u in 0u64 .. 64 {
            if (remote >> u) & 1 == 1 {
                post(mut r, int.narrow(u), Media(room: room, publication: id, src: owner, m: m, handle: handle, speaking: talking, rate: rate, dropped: dropped), shared.share(held))
            }
        }
    }
    // A switch that took effect, or a settled rebind, moves the local masks (RTC-6).
    if settled {
        wants(mut r, now)
    } else {
        want(mut r, pi, now)
    }
    // A down-track waiting on this encoding asks for its keyframe (`Switch`).
    if waits {
        keyframe(mut r, now, pi, m.encoding, Switch, mut out)?
    }
    Ok(())
}

/// Take one message another unit posted (RTC-5), checked against this unit's fences
/// first (RTC-7 step 4): a `Media`, `Ask` or `Reply` whose `src` or `dst` is fenced,
/// or that carries media of a suspended room, is dropped and counted `stale`.
pub fn accept(mut r: Router, now: u64, take msg: Carried, mut out: peer.Outbox) -> Result[(), RouterError] {
    let Carried(carry: carry, packet: packet) = take msg
    match carry {
        Media(room: room, publication: publication, src: src, m: m, handle: handle, speaking: talking, rate: rate, dropped: dropped) => {
            if fenced(r, room, src) || suspended(r, room) {
                r.counts.stale += 1
                return Ok(())
            }
            let Some(pi) = publication_at(r, room, publication) else {
                r.counts.stale += 1
                return Ok(())
            }
            let e: u64 = int.widen(m.encoding)
            if e >= list.len(r.publications[pi].encodings) {
                r.counts.stale += 1
                return Ok(())
            }
            r.publications[pi].encodings[e].ssrc = m.ssrc
            if r.publications[pi].encodings[e].rate != rate {
                r.publications[pi].encodings[e].rate = rate
                reallocate(mut r, pi, now, mut out)?
            }
            let before = r.publications[pi].dropped
            if dropped != before {
                r.publications[pi].dropped = dropped
                repoint(mut r, pi, before | dropped, now, mut out)?
            }
            spread(mut r, now, pi, m, handle, talking, packet, mut out)
        },
        Wanted(room: room, publication: publication, src: src, unit: unit, mask: mask) => {
            let Some(pi) = live(mut r, room, publication, src) else {
                return Ok(())
            }
            if r.publications[pi].home != r.unit {
                r.counts.stale += 1
                return Ok(())
            }
            wanted(mut r, pi, unit, mask, now)
            Ok(())
        },
        Layers(room: room, publication: publication, src: src, mask: mask) => {
            let Some(_) = live(mut r, room, publication, src) else {
                return Ok(())
            }
            list.push(mut r.notices, Layers(publication: publication, mask: mask))
            Ok(())
        },
        Score(room: room, publication: publication, src: src, score: score) => {
            let Some(pi) = live(mut r, room, publication, src) else {
                return Ok(())
            }
            r.publications[pi].voice.score = score
            heard(mut r, room, now)
            gate(mut r, room, now, mut out)
        },
        Ask(room: room, publication: publication, src: src, dst: dst, ask: ask) => {
            if fenced(r, room, src) || fenced(r, room, dst) || suspended(r, room) {
                r.counts.stale += 1
                return Ok(())
            }
            let Some(pi) = publication_at(r, room, publication) else {
                r.counts.stale += 1
                return Ok(())
            }
            if !holds(r.publications[pi].ring, ask.handle) {
                r.counts.ring_misses += 1
                return Ok(())
            }
            let k = (ask.handle >> SLOT_SHIFT) % list.len(r.publications[pi].ring.slots)
            let mut plain: Bytes = list.new()
            list.try_reserve(mut plain, list.len(r.publications[pi].ring.slots[k])) ?=> |c| Capacity(c)
            list.append(mut plain, r.publications[pi].ring.slots[k])
            let Some(si) = seat_at(r, room, dst) else {
                r.counts.stale += 1
                return Ok(())
            }
            let to = r.roster[si].home
            post(mut r, to, Reply(room: room, publication: publication, src: src, dst: dst, ask: ask), shared.new(take plain))
            Ok(())
        },
        Reply(room: room, publication: publication, src: src, dst: dst, ask: ask) => {
            // Both ends again: the home checked `src` when it answered, and either
            // may have been fenced here since (RTC-5).
            if fenced(r, room, src) || fenced(r, room, dst) || suspended(r, room) {
                r.counts.stale += 1
                return Ok(())
            }
            let Some(mi) = member_at(r, room, dst) else {
                r.counts.stale += 1
                return Ok(())
            }
            let _ = peer.resend(mut r.members[mi].session, now, ask, packet, mut out) ?=> |take e| Peer(e)
            Ok(())
        },
        Key(room: room, publication: publication, encoding: encoding, why: why) => {
            let Some(pi) = publication_at(r, room, publication) else {
                r.counts.stale += 1
                return Ok(())
            }
            if r.publications[pi].home != r.unit {
                r.counts.stale += 1
                return Ok(())
            }
            keyframe(mut r, now, pi, encoding, why, mut out)
        },
        Offer(room: room, src: src, version: version) => {
            if fenced(r, room, src) {
                r.counts.stale += 1
                return Ok(())
            }
            list.push(mut r.notices, Offer(who: src, version: version, text: clone(packet)))
            Ok(())
        },
        Answer(room: room, dst: dst, version: version) => {
            if fenced(r, room, dst) {
                r.counts.stale += 1
                return Ok(())
            }
            settle_answer(mut r, room, dst, version, packet)
            Ok(())
        },
        Shut(room: room, src: src) => {
            if fenced(r, room, src) {
                r.counts.stale += 1
                return Ok(())
            }
            list.push(mut r.notices, Shut(who: src))
            Ok(())
        },
        Sender(room: room, publication: publication, owner: owner, source: origin, info: info) => {
            if fenced(r, room, owner) {
                r.counts.stale += 1
                return Ok(())
            }
            for d in 0u64 .. list.len(r.downs) {
                if r.downs[d].room != room || r.downs[d].home != r.unit || !clocked(r, d, publication, owner) {
                    continue
                }
                if let Some(si) = member_at(r, room, r.downs[d].sub) {
                    peer.source_report(mut r.members[si].session, r.downs[d].track, origin, info, now)
                }
            }
            Ok(())
        },
        _ => Ok(()),
    }
}

// The publication an RTC-6 message names, unless a fence covers its publisher or it
// is gone, which counts the message `stale` (RTC-7 step 4).
fn live(mut r: Router, room: peer.RoomId, publication: PublicationId, src: peer.Gen) -> Option[u64] {
    if fenced(r, room, src) {
        r.counts.stale += 1
        return None
    }
    let Some(pi) = publication_at(r, room, publication) else {
        r.counts.stale += 1
        return None
    }
    if r.publications[pi].owner != src {
        r.counts.stale += 1
        return None
    }
    Some(pi)
}

fn control(mut r: Router, now: u64, mi: u64, take c: peer.ControlIn, mut out: peer.Outbox) -> Result[(), RouterError] {
    let who = r.members[mi].who
    // A suspended room answers no repair (RTC-7, Suspend).
    let answering = !suspended(r, who.room)
    for ask in c.repairs {
        if !answering {
            break
        }
        let Some(d) = track_down(r, who, ask.track) else {
            continue
        }
        // A local ring answers at once; a publication homed elsewhere is asked for
        // by `RepairAsk` (RTC-5), and that unit's ring answers or misses.
        let mut held: Option[u64] = None
        let mut asked = false
        for p in[Some(r.downs[d].publication), r.downs[d].previous] {
            if let Some(id) = p {
                if let Some(pi) = publication_at(r, who.room, id) {
                    if r.publications[pi].home != r.unit {
                        let home = r.publications[pi].home
                        post_bare(mut r, home, Ask(room: who.room, publication: id, src: ask.src, dst: who.gen, ask: ask))
                        asked = true
                    } else if holds(r.publications[pi].ring, ask.handle) {
                        held = Some(pi)
                    }
                }
            }
        }
        let Some(pi) = held else {
            if !asked {
                r.counts.ring_misses += 1
            }
            continue
        }
        let k = (ask.handle >> SLOT_SHIFT) % list.len(r.publications[pi].ring.slots)
        let _ = peer.resend(mut r.members[mi].session, now, ask, r.publications[pi].ring.slots[k], mut out) ?=> |take x| Peer(x)
    }
    for ka in c.keyframes {
        let Some(d) = track_down(r, who, ka.track) else {
            continue
        }
        let Some(pi) = publication_at(r, who.room, r.downs[d].publication) else {
            continue
        }
        if let Layer(encoding: e, spatial: _, temporal: _) = r.downs[d].target {
            // RTC-6: a subscriber's PLI is picture loss; its FIR asks for a fresh decoder.
            keyframe(mut r, now, pi, e, if ka.fir {
                Switch
            } else {
                Loss
            }, mut out)?
        }
    }
    for info in c.senders {
        for pi in 0u64 .. list.len(r.publications) {
            if r.publications[pi].room != who.room || r.publications[pi].owner != who.gen {
                continue
            }
            for e in 0u64 .. list.len(r.publications[pi].encodings) {
                if r.publications[pi].encodings[e].ssrc != info.ssrc {
                    continue
                }
                let src = source(r.publications[pi].id, int.narrow(e))
                let id = r.publications[pi].id
                let mut remote = 0u64
                for d in 0u64 .. list.len(r.downs) {
                    if r.downs[d].room != who.room || !clocked(r, d, id, who.gen) {
                        continue
                    }
                    if r.downs[d].home != r.unit {
                        remote = remote | (1u64 << int.widen(r.downs[d].home))
                        continue
                    }
                    if let Some(si) = member_at(r, who.room, r.downs[d].sub) {
                        peer.source_report(mut r.members[si].session, r.downs[d].track, src, info, now)
                    }
                }
                for u in 0u64 .. 64 {
                    if (remote >> u) & 1 == 1 {
                        post_bare(mut r, int.narrow(u), Sender(room: who.room, publication: id, owner: who.gen, source: src, info: info))
                    }
                }
            }
        }
    }
    Ok(())
}

// Whether down `d` takes the SRs of publication `id`, sent by `owner`. RTP-11 projects
// a switch through two SRs only when they share one sender clock, which the caller
// vouches for: so a rebound publication's SRs reach the track before its switch
// only when one participant publishes both; across publishers the switch takes the
// arrival rule.
fn clocked(r: Router, d: u64, id: PublicationId, owner: peer.Gen) -> bool {
    if r.downs[d].previous == Some(id) {
        return true
    }
    if r.downs[d].publication != id {
        return false
    }
    match r.downs[d].previous {
        None => true,
        Some(prev) => match publication_at(r, r.downs[d].room, prev) {
            Some(pp) => r.publications[pp].owner == owner,
            None => true,
        },
    }
}

fn holds(g: Ring, handle: u64) -> bool {
    let n = list.len(g.slots)
    n != 0 && g.handles[(handle >> SLOT_SHIFT) % n] == handle
}

fn track_down(r: Router, who: peer.Participant, track: u16) -> Option[u64] {
    for d in 0u64 .. list.len(r.downs) {
        if r.downs[d].room == who.room && r.downs[d].sub == who.gen && r.downs[d].track == track {
            return Some(d)
        }
    }
    None
}

/// RTC-6 keyframe requests: one `Keyframes` per publication encoding coalesces every
/// down-track's ask. `Switch` asks for a FIR when the publisher negotiated `ccm fir`;
/// otherwise, and for `Loss`, a PLI, sent only when it negotiated `nack pli`.
fn keyframe(mut r: Router, now: u64, pi: u64, encoding: u8, why: rtp.loss.Why, mut out: peer.Outbox) -> Result[(), RouterError] {
    let e: u64 = int.widen(encoding)
    if e >= list.len(r.publications[pi].encodings) {
        return Ok(())
    }
    // The publisher's session is on its home unit, which coalesces every unit's asks.
    if r.publications[pi].home != r.unit {
        let home = r.publications[pi].home
        let room = r.publications[pi].room
        let id = r.publications[pi].id
        post_bare(mut r, home, Key(room: room, publication: id, encoding: encoding, why: why))
        return Ok(())
    }
    // No stream yet: nothing to ask about until its first packet names the SSRC.
    let ssrc = r.publications[pi].encodings[e].ssrc
    if ssrc == 0 {
        return Ok(())
    }
    let fir = why == Switch && r.publications[pi].fir
    if !fir && !r.publications[pi].pli {
        r.counts.unrequested += 1
        return Ok(())
    }
    let room = r.publications[pi].room
    let Some(oi) = member_at(r, room, r.publications[pi].owner) else {
        return Ok(())
    }
    if let Some(req) = rtp.loss.want(mut r.publications[pi].encodings[e].keyframes, why, now) {
        peer.request_keyframe(mut r.members[oi].session, ssrc, req, mut out) ?=> |take x| Peer(x)
    }
    Ok(())
}

/// Drive every session's timers, and keep each encoding's keyframe interval at
/// `max(100 ms, rtt)` of its publisher, updated in place when the estimate moves
/// by more than a quarter. It answers the earliest deadline.
pub fn poll(mut r: Router, now: u64, mut out: peer.Outbox) -> Option[u64] {
    let mut wake: Option[u64] = None
    for i in 0u64 .. list.len(r.members) {
        let next = match peer.poll(mut r.members[i].session, now, mut out) {
            Transmit => Some(now),
            WakeAt(t) => Some(t),
            Idle => None,
        }
        if let Some(t) = next {
            wake = match wake {
                Some(w) if w <= t => Some(w),
                _ => Some(t),
            }
        }
    }
    for pi in 0u64 .. list.len(r.publications) {
        let Some(oi) = member_at(r, r.publications[pi].room, r.publications[pi].owner) else {
            continue
        }
        let rtt = match peer.round_trip(r.members[oi].session) {
            Some(x) if x > MIN_INTERVAL_NS => x,
            _ => MIN_INTERVAL_NS,
        }
        for e in 0u64 .. list.len(r.publications[pi].encodings) {
            let old = r.publications[pi].encodings[e].interval
            let moved = if rtt > old {
                rtt - old
            } else {
                old - rtt
            }
            if 4 * moved > old {
                rtp.loss.set_interval(mut r.publications[pi].encodings[e].keyframes, rtt)
                r.publications[pi].encodings[e].interval = rtt
            }
        }
    }
    match dynamics(mut r, now, mut out) {
        Ok(next) => earliest(wake, next),
        // A refused keyframe request or rewrite target: the next poll retries.
        Error(_) => wake,
    }
}

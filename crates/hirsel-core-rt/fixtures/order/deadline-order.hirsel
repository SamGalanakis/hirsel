// Two sleepers whose deadlines are in the opposite order to their joins.
type In:send { clock: Clock, out: Stdout, ns: u64, tag: u64 }
fn s(take x: In) waits {
    let v = take x
    let now = host.mono_ns(v.clock)
    host.sleep_until(v.clock, now + v.ns)
    if v.tag == 1u64 { result.unwrap(stdout.write(v.out, "a")) } else { result.unwrap(stdout.write(v.out, "b")) }
}
pub fn main(tasks: Tasks, clock: Clock, out: Stdout) -> Result[(), Exit] waits {
    let ha = task.spawn(tasks, bytes 4096, In(clock: clock, out: out, ns: 60_000_000u64, tag: 1u64), s)
    let hb = task.spawn(tasks, bytes 4096, In(clock: clock, out: out, ns: 20_000_000u64, tag: 2u64), s)
    result.unwrap(task.join(take ha))
    result.unwrap(task.join(take hb))
    Ok(())
}

// Reading a transaction's call information (STORE-4), which only std@1/store
// mints.
/// The principal the place admitted, empty for a local call.
pub fn caller(c: store.CallInfo) -> String uses {} {
  unique c.caller
}

/// The commit-order time, signed Unix nanoseconds from the head's clock; 0
/// when the head has no clock and for a query.
pub fn at(c: store.CallInfo) -> i64 uses {} {
  c.at
}

/// Eight bytes the head fixed when it ordered the transaction; 0 for a query.
pub fn seed(c: store.CallInfo) -> u64 uses {} {
  c.seed
}

/// The call's id: 32 bytes, the same for every run of the transaction, after
/// a crash, on re-execution and wherever its head runs, and different for every
/// other committed transaction of the store and of its forks. A run that does
/// not commit shares its id with the transaction that next commits at its
/// version. `None()` for a query, which is not ordered.
pub fn id(c: store.CallInfo) -> Option[Bytes] uses {} {
  if bytes.len(c.id) == 0 {
    None()
  } else {
    Some(unique c.id)
  }
}

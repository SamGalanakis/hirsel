// httparse a0fa552e and Go ebe2feefc400, ported from 64d4d617.
// These laws parse request heads only. Go's body, URL and transfer-framing
// checks belonged to the deleted HTTP adapter, not httparse's head parser.
fn same_head(a: http1.Head, b: http1.Head) -> bool {
    if a.method != b.method || a.target != b.target || a.version != b.version || a.status != b.status || a.reason != b.reason || a.count != b.count || a.end != b.end {
        return false
    }
    for i in 0u64 .. 64u64 {
        if a.fields[i].name != b.fields[i].name || a.fields[i].value != b.fields[i].value {
            return false
        }
    }
    true
}

// L1: every split, including empty fragments, and the one-byte drip schedule.
// The single-shot result establishes split invariance, and request_case
// checks the syntax and offsets against fixture answers. Count buffer reads.
fn prefix_progress(at: u64, complete_at: u64) -> http1.Progress {
    if at < complete_at {
        Partial
    } else {
        Complete
    }
}

fn resume_parity(raw: Bytes, complete_at: Option[u64]) -> bool {
    let mut whole = http1.head()
    let expected = http1.request(raw, mut whole)
    if let Some(at) = complete_at {
        if expected != Complete || whole.end != at {
            return false
        }
    }
    let n = list.len(raw)
    let head_len = if expected == Complete {
        whole.end
    } else {
        n
    }
    for split in 0u64 .. n + 1 {
        let mut h = http1.head()
        let mut cur = http1.cursor()
        let first = http1.resume(list.slice(raw, 0, split), mut h, mut cur)
        if let Some(at) = complete_at {
            if first != prefix_progress(split, at) {
                return false
            }
        }
        let got = http1.resume(raw, mut h, mut cur)
        if got != expected || !same_head(h, whole) || cur.examined > head_len + 1 {
            return false
        }
    }
    let mut h = http1.head()
    let mut cur = http1.cursor()
    let mut got: http1.Progress = Partial
    for end in 0u64 .. n + 1 {
        got = http1.resume(list.slice(raw, 0, end), mut h, mut cur)
        if let Some(at) = complete_at {
            if got != prefix_progress(end, at) {
                return false
            }
        }
    }
    got == expected && same_head(h, whole) && cur.examined <= head_len
}

fn request_case(raw: Bytes, expected: http1.Progress, end: u64, method: Option[Bytes], target: Option[Bytes], version: Option[u8], names: List[Bytes], values: List[Bytes]) -> bool {
    let complete_at = if expected == Complete {
        Some(end)
    } else {
        None
    }
    if !resume_parity(raw, complete_at) {
        return false
    }
    let mut h = http1.head()
    if http1.request(raw, mut h) != expected {
        return false
    }
    if expected == Complete && h.end != end {
        return false
    }
    match method {
        Some(m) => if list.slice(raw, h.method.start, h.method.end) != m {
            return false
        },
        None => {}
    }
    match target {
        Some(p) => if list.slice(raw, h.target.start, h.target.end) != p {
            return false
        },
        None => {}
    }
    match version {
        Some(v) => if h.version != v {
            return false
        },
        None => {}
    }
    if h.count != list.len(names) {
        return false
    }
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        if list.slice(raw, f.name.start, f.name.end) != names[i] || list.slice(raw, f.value.start, f.value.end) != values[i] {
            return false
        }
    }
    true
}


// The reference agent for the harness: a notes keeper. It wires each part an
// app composes from: an Inside tool (`note_add`, `note_delete`), an Outside
// tool (`clock`), a gate that holds a call for approval (`confirm_delete`), a
// subagent (`summarize`, an Outside tool that asks another place), a
// reaction (`tally`) and a system section (`notes`).
//
// The default run uses a scripted model. See README.md.
const BYTES: u64 = 131072u64

const PLACE_BYTES: u64 = 1048576u64

const IDLE_MS: u64 = 200u64

const OPENROUTER: String = "openrouter.ai"

const LIVE_MODEL: String = "deepseek/deepseek-v4.1-flash-1017"

const LIVE_NOTE: String = "The team meeting moved to Thursday."

const LIVE_WARMUP: String = "Reply with READY and nothing else."

const LIVE_WAKE: String = "Write exactly eight short numbered lines about the benefits of a well-kept meeting notebook. Start with 1. and include no introduction."

const LIVE_PROMPT: String = "Save a new note with the exact text 'The team meeting moved to Thursday.' Use note_add once. After the tool returns, reply with SAVED."

// A small session's store: each place reserves its resident cache, its pack
// buffer and its journal group up front, and the defaults size those for a
// large database (1 GiB resident).
fn options() -> store.Options {
    let mut o = store.defaults()
    o.resident_limit = 4194304u64
    o.pack_bytes = 1048576u64
    o.group_bytes = 1048576u32
    o
}

// ---- the app's own tables ----
fn notes_name() -> String {
    "notes.notes"
}

fn stats_name() -> String {
    "notes.stats"
}

// stats keys: the next note id, and the tool results the reaction counted.
const NEXT_ID: u64 = 0u64

const RESULTS: u64 = 1u64

type Tables {
    notes: store.Table[u64, String],
    stats: store.Table[u64, u64]
}

fn created(take r: Result[(), store.Error]) -> Result[(), store.Error] {
    match take r {
        Error(Exists(_)) => Ok(()),
        other => take other,
    }
}

fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    harness.migrate(mut phase)?
    let c_note: std.codec.Codec[String] = std.codec.of()
    let c_count: std.codec.Codec[u64] = std.codec.of()
    created(store.migration_create_table(mut phase, store.spec(notes_name(), std.codec.key_u64(), c_note)))?
    created(store.migration_create_table(mut phase, store.spec(stats_name(), std.codec.key_u64(), c_count)))
}

fn tables(schema: store.Schema) -> Result[Tables, store.Error] {
    let c_note: std.codec.Codec[String] = std.codec.of()
    let c_count: std.codec.Codec[u64] = std.codec.of()
    Ok(Tables(notes: store.schema_table(schema, notes_name(), std.codec.key_u64(), c_note)?, stats: store.schema_table(schema, stats_name(), std.codec.key_u64(), c_count)?))
}

fn stat(tx: store.Tx, t: Tables, k: u64) -> Result[u64, store.Error] {
    match store.fetch(tx, store.shape(t.stats), k)? {
        Some(n) => Ok(n),
        None => Ok(0u64)
    }
}

// ---- tool arguments ----
fn text_arg(raw: Bytes, field: String) -> Result[String, harness.Fault] {
    let Ok(take s) = string.from_utf8(clone(raw)) else {
        return Error(BadArgs("arguments are not UTF-8"))
    }
    let mut pointer = string.from("/")
    string.push(mut pointer, field)
    region r {
        match std.json.parse(r, s) {
            Ok(x) => match std.json.pointer(x, pointer) {
                Some(Str(t)) => Ok(string.from(text.as_string(t))),
                _ => Error(BadArgs("a text field is missing")),
            },
            Error(_) => Error(BadArgs("arguments are not JSON")),
        }
    }
}

fn id_arg(raw: Bytes) -> Result[u64, harness.Fault] {
    let Ok(take s) = string.from_utf8(clone(raw)) else {
        return Error(BadArgs("arguments are not UTF-8"))
    }
    region r {
        match std.json.parse(r, s) {
            Ok(x) => match std.json.pointer(x, "/id") {
                Some(v) => match std.json.as_u64(v) {
                    Some(n) => Ok(n),
                    None => Error(BadArgs("id is not a number"))
                },
                None => Error(BadArgs("id is missing")),
            },
            Error(_) => Error(BadArgs("arguments are not JSON")),
        }
    }
}

fn numbered(take head: String, n: u64) -> Bytes {
    let mut s = take head
    string.push_u64(mut s, n)
    string.into_bytes(take s)
}

// ---- Inside tools: they run in advance's transaction ----
fn note_add(mut tx: store.Tx, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    let line = text_arg(inv.args, "text")?
    let Ok(t) = tables(store.tx_schema(tx)) else {
        return Error(Unavailable)
    }
    let Ok(id) = stat(tx, t, NEXT_ID) else {
        return Error(Unavailable)
    }
    let Ok(()) = store.put(mut tx, t.notes, id, line) else {
        return Error(Unavailable)
    }
    let Ok(()) = store.put(mut tx, t.stats, NEXT_ID, id + 1u64) else {
        return Error(Unavailable)
    }
    Ok(Now(numbered("added note ", id)))
}

fn note_delete(mut tx: store.Tx, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    let id = id_arg(inv.args)?
    let Ok(t) = tables(store.tx_schema(tx)) else {
        return Error(Unavailable)
    }
    match store.fetch(tx, store.shape(t.notes), id) {
        Ok(Some(_)) => (),
        Ok(None) => return Error(BadArgs("no such note")),
        Error(_) => return Error(Unavailable),
    }
    let Ok(_) = store.delete(mut tx, t.notes, id) else {
        return Error(Unavailable)
    }
    Ok(Now(numbered("deleted note ", id)))
}

// ---- the gate, the reaction and the section ----
// Deleting is the one call that needs a person: it is held until the run's
// caller approves these exact arguments.
fn confirm_delete(tx: store.Tx, ask: harness.Ask) -> harness.Verdict {
    if ask.call.name == "note_delete" {
        Hold("deleting a note needs your approval")
    } else {
        Pass
    }
}

fn confirm_live_add(tx: store.Tx, ask: harness.Ask) -> harness.Verdict {
    if ask.call.name != "note_add" {
        return Pass
    }
    let Ok(h) = harness.handles(store.tx_schema(tx)) else {
        return Deny("harness schema unavailable")
    }
    let Ok(Some(s)) = store.fetch(tx, store.shape(h.session), 0u64) else {
        return Deny("harness session unavailable")
    }
    if s.model == LIVE_MODEL {
        Hold("the live smoke requires approval to save a note")
    } else {
        Pass
    }
}

// Counts tool results in the transaction that appends each one.
fn tally(mut tx: store.Tx, at: u64, e: harness.Entry) -> Result[(), harness.Fault] {
    let ToolResult(_, _) = view e else {
        return Ok(())
    }
    let Ok(t) = tables(store.tx_schema(tx)) else {
        return Error(Unavailable)
    }
    let Ok(n) = stat(tx, t, RESULTS) else {
        return Error(Unavailable)
    }
    let Ok(()) = store.put(mut tx, t.stats, RESULTS, n + 1u64) else {
        return Error(Unavailable)
    }
    Ok(())
}

// The notes as the model sees them, rendered from rows before each request.
fn notes_section(tx: store.Tx) -> Result[Option[String], store.Error] {
    let t = tables(store.tx_schema(tx))?
    let mut out = string.from("Notes:")
    let next = stat(tx, t, NEXT_ID)?
    for id in 0u64 .. next {
        if let Some(line) = store.fetch(tx, store.shape(t.notes), id)? {
            string.push(mut out, "\n")
            string.push_u64(mut out, id)
            string.push(mut out, ". ")
            string.push(mut out, line)
        }
    }
    Ok(Some(take out))
}

// ---- grants: what Outside tools and the model are given ----
type Live: send {
    net: Net,
    address: Addr,
    key: Secret,
    out: Stdout,
    preview: harness.preview.Door,
    group: String
}

// A scripted session's draft: the preview hub and the session's group.
type Stream: send {
    door: harness.preview.Door,
    group: String
}

type Services: send {
    helper: Sender[HelperAsk],
    clock: Clock,
    live: Option[Live],
    stream: Option[Stream]
}

type Grants: send {
    context: store.runner.TriggerContext,
    helper: Sender[HelperAsk],
    clock: Clock,
    live: Option[Live],
    stream: Option[Stream]
}

fn copy_stream(s: Option[Stream], group: String) -> Option[Stream] {
    let Some(d) = view s else {
        return None
    }
    Some(Stream(door: harness.preview.copy_door(d.door), group: string.from(group)))
}

fn copy_live(l: Live, group: String) -> Live {
    Live(net: l.net, address: l.address, key: secret.share(l.key), out: l.out, preview: harness.preview.copy_door(l.preview), group: string.from(group))
}

fn make_grants(s: Services, take ctx: store.runner.TriggerContext) -> Result[Grants, Capacity] {
    let live = match s.live {
        Some(l) => Some(copy_live(l, l.group)),
        None => None,
    }
    let group = match s.stream {
        Some(d) => string.from(d.group),
        None => string.new(),
    }
    let stream = copy_stream(s.stream, group)
    Ok(Grants(context: take ctx, helper: channel.sender(s.helper), clock: s.clock, live: take live, stream: take stream))
}

// ---- Outside tools: they run in a worker, off the write lock ----
fn clock_tool(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] {
    Ok(numbered("wall clock ms ", host.wall_ms(g.clock)))
}

// The subagent: asks the helper place and returns its final answer.
fn summarize(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    let line = text_arg(args, "text")?
    let (reply, replied): (Sender[Result[String, String]], Receiver[Result[String, String]]) = channel.new(1u64)
    if let Error(_) = channel.send(g.helper, Summarize(take line, take reply)) {
        return Error(Unavailable)
    }
    // The helper's place may have run its model before it failed, so a
    // failure after the ask is in doubt, not a refusal.
    match channel.receive(replied) {
        Ok(Ok(take s)) => Ok(string.into_bytes(take s)),
        _ => Error(Unavailable),
    }
}

// ---- the parent agent ----
fn usage() -> harness.Usage {
    harness.Usage(input: 10u64, output: 5u64)
}

fn call(take id: String, take name: String, take args: String) -> harness.Call {
    harness.Call(id: take id, name: take name, args: Inline(string.into_bytes(take args)))
}

fn returned(r: harness.Request, id: String) -> String {
    for e in r.messages {
        if let ToolResult(at, Returned(Inline(b))) = e {
            if at == id {
                if let Ok(take s) = string.from_utf8(clone(b)) {
                    return take s
                }
            }
        }
    }
    string.new()
}

// Three rounds, chosen by how many tool results the request carries.
fn scripted_model(g: Grants, take r: harness.Request) -> Result[harness.Answer, harness.Fault] waits {
    let mut results = 0u64
    for e in r.messages {
        if let ToolResult(_, _) = e {
            results += 1u64
        }
    }
    let mut calls: List[harness.Call] = list.new()
    let mut words = string.new()
    if results == 0u64 {
        list.push(mut calls, call("c1", "note_add", "{\"text\":\"The team meeting moved to Thursday.\"}"))
        list.push(mut calls, call("c2", "clock", "{}"))
    } else if results == 2u64 {
        list.push(mut calls, call("c3", "summarize", "{\"text\":\"The team meeting moved to Thursday. Note 0 said Tuesday and is out of date.\"}"))
        list.push(mut calls, call("c4", "note_delete", "{\"id\":0}"))
    } else {
        string.push(mut words, "Saved the move and removed the stale note. ")
        string.push(mut words, returned(r, "c3"))
    }
    let stop = if list.len(calls) == 0u64 {
        "end"
    } else {
        "tool_use"
    }
    // The agent's model must be a waiting function and a waiting function
    // must wait (LANG-8), so the scripted answer is handed over a channel.
    let (reply, replied): (Sender[harness.Answer], Receiver[harness.Answer]) = channel.new(1u64)
    let _ = channel.send(reply, harness.Answer(text: take words, calls: take calls, stop: stop, usage: usage()))
    match channel.receive(replied) {
        Ok(take a) => Ok(take a),
        Error(_) => Error(Unavailable)
    }
}

// The scripted answer, its text drafted in eight pieces over about a second.
fn scripted_stream(g: Grants, take request: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.Fault] waits {
    let answer = scripted_model(g, take request)?
    let n = string.byte_len(answer.text)
    if list.len(answer.calls) == 0u64 && n > 0u64 {
        let mut from = 0u64
        for i in 1u64 .. 9u64 {
            let mut to = n * i / 8u64
            while to < n && (string.as_bytes(answer.text)[to] & 192u8) == 128u8 {
                to += 1u64
            }
            if let Some(mut p) = sink {
                harness.preview.delta(mut p, string.slice(answer.text, from, to))
            }
            from = to
            std.clock.sleep_ns(g.clock, 150000000u64)
        }
    }
    Ok(take answer)
}

fn model(g: Grants, take request: harness.Request) -> Result[harness.Answer, harness.Fault] waits {
    let mut draft: Option[harness.preview.Source] = None
    live_model(g, take request, mut draft)
}

fn live_model(g: Grants, take request: harness.Request, mut draft: Option[harness.preview.Source]) -> Result[harness.Answer, harness.Fault] waits {
    let Some(live) = view g.live else {
        return scripted_model(g, take request)
    }
    let mut req = take request
    let mut replies = 0u64
    let mut prompt = string.new()
    for e in req.messages {
        match e {
            User(text) => {
                prompt = string.from(text);
                replies = 0u64
            },
            Assistant(_) => {
                replies += 1u64
            },
            _ => (),
        }
    }
    let limit = if prompt == LIVE_PROMPT {
        2u64
    } else if prompt == LIVE_WARMUP || prompt == LIVE_WAKE {
        1u64
    } else {
        0u64
    }
    if replies >= limit {
        return Error(Refused("live smoke request limit"))
    }
    if prompt != LIVE_PROMPT || replies > 0u64 {
        list.clear(mut req.tools)
    }
    let m = harness.provider.Model(dialect: OpenAi, name: LIVE_MODEL, max_tokens: 512u64)
    let endpoint = harness.provider.Endpoint(address: live.address, authority: OPENROUTER, prefix: "/api", security: Https(OPENROUTER, System))
    let p = harness.provider.Provider(model: take m, endpoint: take endpoint, key: secret.share(live.key), bounds: harness.provider.bounds(), deadline_ms: 45000u64)
    emit(live.out, "OpenRouter request attempted", "")
    let result = harness.provider.ask_with_preview(live.net, g.clock, take p, take req, mut draft)
    match result {
        Error(Refused(why)) => emit(live.out, "OpenRouter refused: ", why),
        Error(BadArgs(why)) => emit(live.out, "OpenRouter request invalid: ", why),
        Error(Unavailable) => emit(live.out, "OpenRouter stream did not yield an answer", ""),
        Ok(a) => count(live.out, "OpenRouter reported tokens: ", a.usage.input + a.usage.output),
        _ => (),
    }
    take result
}

fn notes_agent() -> harness.Agent[Grants] {
    let mut a = harness.agent("notes", "notes", code.describe(model))
    list.push(mut a.tools, harness.inside("note_add", "saves a note", "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}", code.describe(note_add)))
    list.push(mut a.tools, harness.inside("note_delete", "deletes a note by id", "{\"id\":\"number\"}", code.describe(note_delete)))
    list.push(mut a.tools, harness.outside("clock", "reads the wall clock", "{}", Repeatable(3u64), code.describe(clock_tool)))
    list.push(mut a.tools, harness.outside("summarize", "asks a helper agent for a one-line summary", "{\"text\":\"string\"}", Once, code.describe(summarize)))
    list.push(mut a.gates, harness.Gate(name: "confirm_delete", check: code.describe(confirm_delete)))
    list.push(mut a.gates, harness.Gate(name: "confirm_live_add", check: code.describe(confirm_live_add)))
    list.push(mut a.reactions, harness.After(name: "tally", run: code.describe(tally)))
    list.push(mut a.sections, harness.Section(key: "notes", render: code.describe(notes_section)))
    a
}

// The four entries the place registers. Each rebuilds the agent from code,
// so a trigger never carries the agent itself.
fn wired() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(advance), code.describe(effect))
}

fn advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: harness.Wake) -> Result[(), harness.Refused] {
    let w = wired()?
    harness.advance(mut tx, h, notes_agent(), w, take wake)
}

fn effect(g: Grants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    let Some(l) = view g.live else {
        let Some(d) = view g.stream else {
            return harness.effect(g.context, g, take key, notes_agent(), code.describe(settle))
        }
        let mut a = notes_agent()
        a.preview_model = Some(code.describe(scripted_stream))
        return harness.effect_with_preview(g.context, g, take key, a, code.describe(settle), Some(harness.preview.target(d.door, d.group, g.clock)))
    }
    let mut a = notes_agent()
    a.preview_model = Some(code.describe(live_model))
    harness.effect_with_preview(g.context, g, take key, a, code.describe(settle), Some(harness.preview.target(l.preview, l.group, g.clock)))
}

fn settle(mut tx: store.Tx, a: store.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let Ok(w) = wired() else {
        return Error(Missing("harness: wiring"))
    }
    harness.settle(mut tx, notes_agent(), w, a, take m)
}

fn submit_entry(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take m: harness.Submit) -> Result[harness.Disposition, harness.Refused] {
    let w = wired()?
    harness.submit(mut tx, h, notes_agent(), w, caller, take m)
}

fn decide_entry(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take d: harness.Decision) -> Result[harness.Ruling, harness.Refused] {
    let w = wired()?
    harness.decide(mut tx, h, notes_agent(), w, caller, take d)
}

fn shown(tx: store.Tx, h: harness.Handles, take u: ()) -> Result[store.runner.Cover, Capacity] {
    harness.transcript(h)
}

fn place(mut r: store.runner.Registry[Grants, harness.Handles]) -> Result[(), store.runner.RegisterError] {
    store.runner.transact(mut r, code.describe(advance), BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.granted(mut r, code.describe(effect), BYTES, store.runner.DEFAULT_STEPS)?
    harness.register(mut r, BYTES, store.runner.DEFAULT_STEPS)?
    let f: own[send] fn(mut store.Tx, store.triggers.Attempt, take harness.Settle) -> Result[harness.Filed, store.Error] = settle
    store.runner.register_attempt(mut r, code.describe(settle), take f, BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.transact(mut r, code.describe(submit_entry), BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.transact(mut r, code.describe(decide_entry), BYTES, store.runner.DEFAULT_STEPS)?
    let views: std.codec.Codec[harness.View] = std.codec.of()
    store.runner.query(mut r, code.describe(shown), std.codec.key_u64(), views, BYTES, store.runner.DEFAULT_STEPS)?
    let windows: std.codec.Codec[harness.View] = std.codec.of()
    store.runner.query_as(mut r, code.describe(harness.window), std.codec.key_u64(), windows, BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.query_as(mut r, code.describe(harness.history_cuts), std.codec.key_u64(), std.codec.of_u64(), BYTES, store.runner.DEFAULT_STEPS)
}

// ---- the helper agent: a second place, one session of its own ----
type HelperGrants: send {
    context: store.runner.TriggerContext
}

fn helper_grants(s: (), take ctx: store.runner.TriggerContext) -> Result[HelperGrants, Capacity] {
    Ok(HelperGrants(context: take ctx))
}

// Answers with the first sentence of the newest user message.
fn helper_model(g: HelperGrants, take r: harness.Request) -> Result[harness.Answer, harness.Fault] waits {
    let mut last = string.new()
    for e in r.messages {
        if let User(t) = e {
            last = clone(t)
        }
    }
    let mut first: Bytes = list.new()
    for b in string.into_bytes(take last) {
        list.push(mut first, b)
        if b == 46u8 {
            break
        }
    }
    let mut words = string.from("Summary: ")
    if let Ok(take s) = string.from_utf8(take first) {
        string.push(mut words, s)
    }
    let (reply, replied): (Sender[harness.Answer], Receiver[harness.Answer]) = channel.new(1u64)
    let _ = channel.send(reply, harness.Answer(text: take words, calls: list.new(), stop: "end", usage: harness.Usage(input: 4u64, output: 2u64)))
    match channel.receive(replied) {
        Ok(take a) => Ok(take a),
        Error(_) => Error(Unavailable)
    }
}

fn helper_agent() -> harness.Agent[HelperGrants] {
    harness.agent("helper", "scripted", code.describe(helper_model))
}

fn helper_wired() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(helper_advance), code.describe(helper_effect))
}

fn helper_advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: harness.Wake) -> Result[(), harness.Refused] {
    let w = helper_wired()?
    harness.advance(mut tx, h, helper_agent(), w, take wake)
}

fn helper_effect(g: HelperGrants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    harness.effect(g.context, g, take key, helper_agent(), code.describe(helper_settle))
}

fn helper_settle(mut tx: store.Tx, a: store.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let Ok(w) = helper_wired() else {
        return Error(Missing("harness: wiring"))
    }
    harness.settle(mut tx, helper_agent(), w, a, take m)
}

fn helper_place(mut r: store.runner.Registry[HelperGrants, harness.Handles]) -> Result[(), store.runner.RegisterError] {
    store.runner.transact(mut r, code.describe(helper_advance), BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.granted(mut r, code.describe(helper_effect), BYTES, store.runner.DEFAULT_STEPS)?
    harness.register(mut r, BYTES, store.runner.DEFAULT_STEPS)?
    let f: own[send] fn(mut store.Tx, store.triggers.Attempt, take harness.Settle) -> Result[harness.Filed, store.Error] = helper_settle
    store.runner.register_attempt(mut r, code.describe(helper_settle), take f, BYTES, store.runner.DEFAULT_STEPS)
}

// The helper's service: it owns the helper place's directory and, per ask,
// submits the text, runs the place until it is idle and reads the answer.
type HelperAsk: send = Summarize(String, Sender[Result[String, String]])

type HelperSeed: send {
    inbox: Receiver[HelperAsk],
    dir: Dir,
    clock: Clock,
    random: Random,
    tasks: Tasks,
    net: Net
}

fn helper_settings(dir: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> store.runner.PlaceConfig[HelperGrants, harness.Handles, (), ()] {
    let w = result.unwrap(helper_wired())
    let config = store.runner.TriggerConfig(entries: harness.entries(w), author: store.Caller(issuer: 0u8, subject: list.new()), grants: (), grant: helper_grants, grant_bytes: 65536u64)
    store.runner.PlaceConfig(backing: Disk(dir, options()), selection: Reopen, place: code.describe(helper_place), n_place: PLACE_BYTES, migrate: code.describe(harness.migrate), handles: code.describe(harness.handles), session: wire(), max_sessions: 1u64, proxies: list.new(), n_publisher: PLACE_BYTES, listen: loopback(), net: net, tasks: tasks, clock: clock, random: random, stop: store.runner.Stop(lag_ms: 0u64, grace_ms: 200u64), wire: None, triggers: Some(take config), idle: Some(IDLE_MS))
}

fn helper_ask(seed: HelperSeed, n: u64, take line: String) -> Result[String, String] waits {
    let mut db = match store.open(seed.tasks, seed.dir, seed.clock, seed.random, options()) {
        Ok(take v) => take v,
        Error(_) => return Error("helper: open")
    }
    let Ok(()) = store.run_migration(mut db, seed.tasks, code.describe(harness.migrate)) else {
        return Error("helper: migrate")
    }
    let Ok(h) = store.with_schema(db, code.describe(harness.handles)) else {
        return Error("helper: schema")
    }
    let Ok(w) = helper_wired() else {
        return Error("helper: wiring")
    }
    let mut client_key = string.from("ask-")
    string.push_u64(mut client_key, n)
    let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[harness.Disposition, harness.Refused] {
        if n == 0u64 {
            harness.open_session(mut tx, h, "scripted", All)?
        }
        harness.submit(mut tx, h, helper_agent(), w, you(), harness.Submit(client_key: clone(client_key), text: clone(line)))
    })
    let Ok(Committed(done)) = take ran else {
        return Error("helper: submit did not commit")
    }
    let Ok(()) = store.durable(mut db, done.ticket) else {
        return Error("helper: durable")
    }
    let Ok(()) = store.close(take db) else {
        return Error("helper: close")
    }
    until_idle(helper_settings(seed.dir, seed.clock, seed.random, seed.tasks, seed.net))?
    let Ok(db2) = store.open(seed.tasks, seed.dir, seed.clock, seed.random, options()) else {
        return Error("helper: reopen")
    }
    let snap = store.snapshot(db2)
    let Ok(Some(session)) = store.get(snap, store.shape(h.session), 0u64) else {
        return Error("helper: no session")
    }
    let last = session.next_pos - 1u64
    let answer: Result[String, String] = match store.get(snap, store.shape(h.entries), last) {
        Ok(Some(Assistant(a))) => Ok(clone(a.text)),
        _ => Error("helper: the run did not end in an answer"),
    }
    let _ = store.close(take db2)
    answer
}

fn helper_service(take seed: HelperSeed) -> () waits {
    let mut n = 0u64
    while let Ok(take ask) = channel.receive(seed.inbox) {
        let Summarize(take line, reply) = take ask
        let _ = channel.send(reply, helper_ask(seed, n, take line))
        n += 1u64
    }
}

// ---- running a place ----
fn you() -> store.Caller {
    store.Caller(issuer: 1u8, subject: string.into_bytes("you"))
}

fn loopback() -> Addr {
    Addr(ip: V4(0x7f000001u32), port: 0u16)
}

fn wire() -> store.runner.WireConfig {
    let mut w = store.runner.wire_defaults(65536u64, PLACE_BYTES)
    w.n_pool = 4194304u64
    w
}

// Runs a place until it is idle: no run can move without a person or a
// timer, so `operate` returns.
fn until_idle[G: send, S: send](take config: store.runner.PlaceConfig[G, harness.Handles, S, ()]) -> Result[(), String] waits {
    let (stop, stopped): (Sender[()], Receiver[()]) = channel.new(1u64)
    let Ok(status) = store.runner.status_root() else {
        return Error("place: status")
    }
    let ended = store.runner.operate(take config, take stopped, latest.handle(status), None)
    let _ = take stop
    match ended {
        Ok(Stopped(_)) => Ok(()),
        Ok(_) => Error("place: it ended without stopping"),
        Error(Open(_)) => Error("place: its store did not open"),
        Error(Listen(_)) => Error("place: it could not listen"),
        Error(Missing(take what)) => {
            let mut s = string.from("place: missing ")
            string.push(mut s, what)
            Error(take s)
        },
        Error(Exceeds(_)) => Error("place: a bound was exceeded"),
        Error(Disagrees(_)) => Error("place: its image disagrees with the store"),
        Error(Full(_)) => Error("place: out of capacity"),
    }
}

fn settings(take backing: store.runner.Backing, clock: Clock, random: Random, tasks: Tasks, net: Net, take s: Services) -> store.runner.PlaceConfig[Grants, harness.Handles, Services, ()] {
    let w = result.unwrap(wired())
    let grant_bytes = if let Some(_) = view s.live {
        LIVE_GRANT_BYTES
    } else {
        65536u64
    }
    let config = store.runner.TriggerConfig(entries: harness.entries(w), author: store.Caller(issuer: 0u8, subject: list.new()), grants: take s, grant: make_grants, grant_bytes: grant_bytes)
    store.runner.PlaceConfig(backing: take backing, selection: Reopen, place: code.describe(place), n_place: PLACE_BYTES, migrate: code.describe(migrate), handles: code.describe(harness.handles), session: wire(), max_sessions: 1u64, proxies: list.new(), n_publisher: PLACE_BYTES, listen: loopback(), net: net, tasks: tasks, clock: clock, random: random, stop: store.runner.Stop(lag_ms: 0u64, grace_ms: 200u64), wire: None, triggers: Some(take config), idle: Some(IDLE_MS))
}

// ---- printing ----
fn say(out: Stdout, s: String) -> () waits {
    let _ = stdout.write(out, s)
}

fn emit(out: Stdout, take head: String, rest: String) -> () waits {
    let mut s = take head
    string.push(mut s, rest)
    string.push(mut s, "\n")
    say(out, s)
}

fn args_text(p: harness.Payload) -> String {
    match p {
        Inline(b) => match string.from_utf8(clone(b)) {
            Ok(take s) => take s,
            Error(_) => string.from("(bytes)")
        },
        Blob(_) => string.from("(blob)"),
    }
}

fn show_entry(out: Stdout, e: harness.Entry) -> () waits {
    match e {
        User(t) => emit(out, "  user: ", t),
        Assistant(a) => {
            if string.byte_len(a.text) > 0u64 {
                emit(out, "  assistant: ", a.text)
            }
            for c in a.calls {
                let mut s = string.from("  assistant calls ")
                string.push(mut s, c.name)
                string.push(mut s, " ")
                emit(out, take s, args_text(c.args))
            }
        },
        ToolResult(id, o) => {
            let (words, _) = harness.provider.worded(o)
            let mut s = string.from("  result ")
            string.push(mut s, id)
            string.push(mut s, ": ")
            emit(out, take s, words)
        },
        System(p) => {
            let mut s = string.from("  system: ")
            string.push_u64(mut s, list.len(p.changes))
            string.push(mut s, " section change(s)")
            if let Some(d) = p.tools {
                string.push(mut s, ", ")
                string.push_u64(mut s, list.len(d))
                string.push(mut s, " tools")
            }
            emit(out, take s, "")
        },
        Inform(t) => emit(out, "  inform: ", t),
        Reset(t) => emit(out, "  reset: ", t),
        Note(t, _) => emit(out, "  note: ", t),
    }
}

fn quit(out: Stdout, why: String) -> Result[(), Exit] waits {
    emit(out, "notes: ", why)
    Error(Exit(status: 1u8))
}

// ---- the program ----
fn seed_place(dir: Dir, clock: Clock, random: Random, tasks: Tasks, prompt: String) -> Result[(), String] waits {
    let mut db = match store.open(tasks, dir, clock, random, options()) {
        Ok(take v) => take v,
        Error(_) => return Error("open")
    }
    let Ok(()) = store.run_migration(mut db, tasks, code.describe(migrate)) else {
        return Error("migrate")
    }
    let Ok(h) = store.with_schema(db, code.describe(harness.handles)) else {
        return Error("schema")
    }
    let Ok(w) = wired() else {
        return Error("wiring")
    }
    let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[harness.Disposition, harness.Refused] {
        harness.open_session(mut tx, h, "scripted", All)?
        let Ok(t) = tables(store.tx_schema(tx)) else {
            return Error(Storage)
        }
        let Ok(()) = store.put(mut tx, t.notes, 0u64, "Team meeting on Tuesday.") else {
            return Error(Storage)
        }
        let Ok(()) = store.put(mut tx, t.stats, NEXT_ID, 1u64) else {
            return Error(Storage)
        }
        harness.submit(mut tx, h, notes_agent(), w, you(), harness.Submit(client_key: "k1", text: string.from(prompt)))
    })
    let Ok(Committed(done)) = take ran else {
        return Error("submit did not commit")
    }
    let Ok(()) = store.durable(mut db, done.ticket) else {
        return Error("durable")
    }
    let Ok(()) = store.close(take db) else {
        return Error("close")
    }
    Ok(())
}

// Finds the open approval, shows the held call and approves it under its key.
fn approve(out: Stdout, dir: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), String] waits {
    let mut db = match store.open(tasks, dir, clock, random, options()) {
        Ok(take v) => take v,
        Error(_) => return Error("open")
    }
    let Ok(h) = store.with_schema(db, code.describe(harness.handles)) else {
        return Error("schema")
    }
    let snap = store.snapshot(db)
    let mut rows = match store.scan(snap, store.shape(h.waits), Unbounded, Unbounded) {
        Ok(take v) => take v,
        Error(_) => return Error("scan")
    }
    let mut found: Option[(harness.WaitKey, Bytes)] = None
    while let Ok(Some((k, v))) = store.next(mut rows) {
        if let Open(key, _) = v {
            found = Some((k, clone(key)))
        }
    }
    let Some((wk, key)) = take found else {
        return Error("no call is waiting for approval")
    }
    let ek = harness.EffectKey(run: wk.run, round: wk.generation, kind: harness.TOOL, ordinal: wk.slot)
    let Ok(Some(held)) = store.get(snap, store.shape(h.effects), ek) else {
        return Error("the held call is missing")
    }
    if let Some(c) = held.call {
        let mut s = string.from("held for approval: ")
        string.push(mut s, c.name)
        string.push(mut s, " ")
        emit(out, take s, args_text(c.args))
    }
    let Ok(w) = wired() else {
        return Error("wiring")
    }
    let d = harness.Decision(run: wk.run, round: wk.generation, ordinal: wk.slot, key: take key, allow: true)
    let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[harness.Ruling, harness.Refused] {
        harness.decide(mut tx, h, notes_agent(), w, you(), clone(d))
    })
    let Ok(Committed(done)) = take ran else {
        return Error("the decision did not commit")
    }
    let Ok(()) = store.durable(mut db, done.ticket) else {
        return Error("durable")
    }
    emit(out, "you approved it", "")
    let Ok(()) = store.close(take db) else {
        return Error("close")
    }
    Ok(())
}

fn report(out: Stdout, dir: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), String] waits {
    let Ok(db) = store.open(tasks, dir, clock, random, options()) else {
        return Error("open")
    }
    let Ok(h) = store.with_schema(db, code.describe(harness.handles)) else {
        return Error("schema")
    }
    let Ok(t) = store.with_schema(db, code.describe(tables)) else {
        return Error("tables")
    }
    let snap = store.snapshot(db)
    let Ok(Some(session)) = store.get(snap, store.shape(h.session), 0u64) else {
        return Error("no session")
    }
    emit(out, "transcript:", "")
    for pos in 0u64 .. session.next_pos {
        if let Ok(Some(e)) = store.get(snap, store.shape(h.entries), pos) {
            show_entry(out, e)
        }
    }
    emit(out, "notes:", "")
    let mut rows = match store.scan(snap, store.shape(t.notes), Unbounded, Unbounded) {
        Ok(take v) => take v,
        Error(_) => return Error("scan")
    }
    while let Ok(Some((id, text))) = store.next(mut rows) {
        let mut s = string.from("  ")
        string.push_u64(mut s, id)
        string.push(mut s, ". ")
        emit(out, take s, text)
    }
    let counted = match store.get(snap, store.shape(t.stats), RESULTS) {
        Ok(Some(n)) => n,
        _ => 0u64
    }
    let mut tallied = string.from("tool results counted by the reaction: ")
    string.push_u64(mut tallied, counted)
    emit(out, take tallied, "")
    let Ok(Some(run)) = store.get(snap, store.shape(h.runs), 0u64) else {
        return Error("no run")
    }
    let mut s = string.from("spend: ")
    string.push_u64(mut s, run.spend.known)
    string.push(mut s, " tokens, ")
    string.push_u64(mut s, run.spend.reserved)
    string.push(mut s, " reserved")
    emit(out, take s, "")
    let _ = store.close(take db)
    Ok(())
}

pub fn main(out: Stdout, data: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), Exit] waits {
    let prompt = "The team meeting moved to Thursday. Please note it and tidy up."
    let mut parent_name = string.with_capacity(32u64)
    let Ok(parent) = host.mkdtemp(data, mut parent_name) else {
        return quit(out, "cannot make the place directory")
    }
    let mut helper_name = string.with_capacity(32u64)
    let Ok(helper) = host.mkdtemp(data, mut helper_name) else {
        return quit(out, "cannot make the helper directory")
    }
    if let Error(take why) = seed_place(parent, clock, random, tasks, prompt) {
        return quit(out, why)
    }
    emit(out, "you: ", prompt)
    let (ask, asks): (Sender[HelperAsk], Receiver[HelperAsk]) = channel.new(1u64)
    let helping = task.spawn(tasks, bytes 67108864u64, HelperSeed(inbox: take asks, dir: helper, clock: clock, random: random, tasks: tasks, net: net), helper_service)
    let first = until_idle(settings(Disk(parent, options()), clock, random, tasks, net, Services(helper: channel.sender(ask), clock: clock, live: None, stream: None)))
    if let Error(take why) = first {
        return quit(out, why)
    }
    if let Error(take why) = approve(out, parent, clock, random, tasks) {
        return quit(out, why)
    }
    let second = until_idle(settings(Disk(parent, options()), clock, random, tasks, net, Services(helper: channel.sender(ask), clock: clock, live: None, stream: None)))
    if let Error(take why) = second {
        return quit(out, why)
    }
    let summarized = report(out, parent, clock, random, tasks)
    let _ = take ask
    let _ = task.join(take helping)
    let _ = std.dir.remove_all(data, parent_name)
    let _ = std.dir.remove_all(data, helper_name)
    match take summarized {
        Ok(()) => Ok(()),
        Error(take why) => quit(out, why)
    }
}

// ---- the manual OpenRouter smoke ----
const LIVE_GRANT_BYTES: u64 = 4194304u64

const HTTP_MS: u64 = 5000u64

fn live_place(take supplied: store.local.Supplied, s: Services) -> Result[store.runner.PlaceConfig[Grants, harness.Handles, Services, ()], Capacity] {
    let mut config = settings(Memory, supplied.clock, supplied.random, supplied.tasks, supplied.net, Services(helper: channel.sender(s.helper), clock: s.clock, live: match s.live {
        Some(l) => Some(copy_live(l, supplied.name)),
        None => None,
    }, stream: None))
    config.wire = Some(store.runner.wire_bind((), code.describe(store.ingress.caller), 4096u64, 65536u64))
    Ok(take config)
}

fn live_factory() -> store.local.Factory[Services] {
    store.local.seeded_factory(live_place)
}

fn json[A: codec](a: A) -> Bytes {
    let f: std.json.Format[A] = result.unwrap(std.json.interop())
    string.into_bytes(result.unwrap(std.json.to_string(f, a)))
}

fn browser_headers(credential: Bytes, at: u64) -> List[std.http_client.Header] {
    let mut auth = string.from("Bearer ")
    string.push(mut auth, std.base64.encode_string(credential))
    let mut pos = string.new()
    string.push_u64(mut pos, at)
    let mut headers: List[std.http_client.Header] = list.new()
    list.push(mut headers, std.http_client.Header(name: "Authorization", value: Public(string.into_bytes(take auth))))
    list.push(mut headers, std.http_client.Header(name: "Hirsel-Position", value: Public(string.into_bytes(take pos))))
    headers
}

type Browser {
    net: Net,
    clock: Clock,
    address: Addr,
    credential: Bytes
}

fn browser_request(b: Browser, method: String, path: String, take headers: List[std.http_client.Header], take body: Bytes, within: u64, limit: u64) -> Result[std.http_client.Connection, String] waits {
    let req = std.http_client.Request(method: string.from(method), target: string.from(path), headers: take headers, body: Fixed(list.len(body)))
    let deadline = std.clock.deadline_after_ms(host.mono_ns(b.clock), within)
    let Ok(take connection) = std.http_client.dial(b.net, b.address, "127.0.0.1", b.clock, take req, deadline) else {
        return Error("browser could not open its HTTP request")
    }
    let mut c = take connection
    if list.len(body) > 0u64 {
        if let Error(_) = std.http_client.write(mut c, body) {
            return Error("browser could not write its HTTP body")
        }
    }
    if let Error(_) = std.http_client.finish_request(mut c, limit) {
        return Error("browser could not read the HTTP head")
    }
    Ok(take c)
}

fn post(b: Browser, path: String, take headers: List[std.http_client.Header], take body: Bytes, expected: u16, expected_body: Bytes) -> Result[(), String] waits {
    let mut c = browser_request(b, "POST", path, take headers, take body, HTTP_MS, 65536u64)?
    let status = std.http_client.status(std.http_client.head(c))
    let mut got: Bytes = list.with_capacity(4096u64)
    loop {
        list.reserve(mut got, 4096u64)
        match std.http_client.read(mut c, mut got) {
            Ok(0u64) => break,
            Ok(_) => (),
            Error(_) => return Error("browser could not read the HTTP body"),
        }
    }
    if status != expected || got != expected_body {
        let mut reason = string.from(path)
        string.push(mut reason, " returned HTTP ")
        string.push_u64(mut reason, int.widen(status))
        string.push(mut reason, " with body ")
        if let Ok(words) = string.from_utf8(take got) {
            string.push(mut reason, words)
        }
        return Error(take reason)
    }
    Ok(())
}

fn message(b: Browser, at: u64, id: u64, key: String, prompt: String) -> Result[(), String] waits {
    post(b, "/sessions/0/messages", browser_headers(b.credential, at), json(harness.Submit(client_key: string.from(key), text: string.from(prompt))), 202u16, json((Placed(id) : harness.Disposition)))
}

type SeenReply {
    at: u64,
    text: String,
    first_preview_ns: u64,
    preview_deltas: u64
}

fn browser_reply(mut c: std.http_client.Connection, mut dec: std.sse.Decoder, clock: Clock, run: u64, after: u64, until: String, expect_preview: bool) -> Result[SeenReply, String] waits {
    let rows: std.json.Format[harness.gateway_http.Shown] = result.unwrap(std.json.interop())
    let drafts: std.json.Format[harness.preview.Draft] = result.unwrap(std.json.interop())
    let deltas: std.json.Format[harness.gateway_http.PreviewDelta] = result.unwrap(std.json.interop())
    let mut chunk: Bytes = list.with_capacity(8192u64)
    let mut reply = SeenReply(at: after, text: "", first_preview_ns: 0u64, preview_deltas: 0u64)
    let mut status = string.new()
    let mut batch_ready = false
    let mut first_text = string.new()
    let mut draft_at = 0u64
    let mut draft_seq = 0u64
    let mut draft_offset = 0u64
    let mut draft = string.new()
    let mut cleared = false
    loop {
        match std.http_client.read(mut c, mut chunk) {
            Ok(0u64) => return Error("browser SSE stream closed before the reply"),
            Ok(_) => (),
            Error(_) => return Error("browser could not read the reply from its SSE stream"),
        }
        let fed = std.sse.feed(mut dec, chunk, fn(name: Bytes, data: Bytes, event_id: Bytes) -> std.sse.FeedControl[String] {
            if name == b"message" {
                batch_ready = false
                let Ok(harness.gateway_http.Shown(at: at, line: take line)) = std.json.decode_typed(rows, std.http.copy_bytes(data), 65536u64) else {
                    return Fail("invalid transcript event")
                }
                match take line {
                    Status(take state) => {
                        status = take state
                    },
                    Line(role, take text) => if role == "assistant" && at > reply.at {
                        reply.at = at
                        reply.text = take text
                    },
                }
            } else if name == b"batch" {
                let Ok(version) = string.from_utf8(std.http.copy_bytes(data)) else {
                    return Fail("invalid batch version")
                }
                if let Error(_) = std.int.parse_uint(version, 10) {
                    return Fail("invalid batch version")
                }
                batch_ready = true
            } else if expect_preview && name == b"preview" {
                let Ok(harness.preview.Draft(key: key, seq: seq, offset: offset, text: take text, ..)) = std.json.decode_typed(drafts, std.http.copy_bytes(data), 65536u64) else {
                    return Fail("invalid preview event")
                }
                if key.run == run && key.tool == None && string.byte_len(text) > 0u64 {
                    if key.entry + 1u64 <= reply.at {
                        return Fail("browser saw a draft after its committed row")
                    }
                    if reply.first_preview_ns == 0u64 {
                        reply.first_preview_ns = host.mono_ns(clock)
                        if offset != 0u64 {
                            return Fail("first preview started past the answer's first byte")
                        }
                        first_text = string.from(text)
                    }
                    draft_at = key.entry + 1u64
                    draft_seq = seq
                    draft_offset = offset
                    draft = take text
                    cleared = false
                }
            } else if expect_preview && name == b"preview-delta" && draft_at > 0u64 && !cleared {
                let Ok(more) = std.json.decode_typed(deltas, std.http.copy_bytes(data), 65536u64) else {
                    return Fail("invalid preview delta event")
                }
                if draft_at <= reply.at || more.seq <= draft_seq || more.at != draft_offset + string.byte_len(draft) {
                    return Fail("preview delta did not continue the active draft")
                }
                string.push(mut draft, more.text)
                draft_seq = more.seq
                reply.preview_deltas += 1u64
            } else if name == b"preview-clear" && draft_at > 0u64 {
                cleared = true
            }
            Continue
        })
        match take fed {
            Error(Callback(take why, _)) => return Error(take why),
            Error(Decode(_, _)) => return Error("malformed SSE frame"),
            Ok(_) => (),
        }
        list.clear(mut chunk)
        if batch_ready && status == until && reply.at > after {
            if !expect_preview {
                return Ok(take reply)
            }
            if draft_at == 0u64 {
                return Error("browser received no text preview for the wake answer")
            }
            if draft_at != reply.at {
                return Error("preview and committed answer refer to different entries")
            }
            if !string.starts_with(reply.text, first_text) {
                return Error("first draft did not match the committed text prefix")
            }
            if first_text == reply.text {
                return Error("first preview already held the whole answer")
            }
            let end = draft_offset + string.byte_len(draft)
            if end > string.byte_len(reply.text) || string.slice(reply.text, draft_offset, end) != draft {
                return Error("latest draft did not match its place in the committed text")
            }
            if cleared {
                return Ok(take reply)
            }
        }
    }
}

fn live_down(d: harness.gateway.Door[Services], clock: Clock, after: u64) -> Result[harness.gateway.Marks, String] waits {
    for i in 0u64 .. 100u64 {
        let marks = harness.gateway.marks(d, 0u64)
        if marks.ups > after && marks.ups == marks.downs {
            std.clock.sleep_ns(clock, 2u64 * IDLE_MS * 1000000u64)
            let quiet = harness.gateway.marks(d, 0u64)
            if quiet.ups != marks.ups || quiet.downs != marks.downs {
                return Error("SSE stream woke a quiet place")
            }
            return Ok(marks)
        }
        std.clock.sleep_ns(clock, 50000000u64)
    }
    Error("place did not unload under the SSE stream")
}

fn journal(dir: Dir) -> u64 waits {
    store.read_only_version(result.unwrap(store.open_read_only(dir, options())))
}

fn count(out: Stdout, label: String, value: u64) -> () waits {
    let mut text = string.new()
    string.push_u64(mut text, value)
    emit(out, string.from(label), text)
}

fn live_decision(dir: Dir, b: Browser, tasks: Tasks, random: Random) -> Result[harness.Decision, String] waits {
    let Ok(db) = store.open(tasks, dir, b.clock, random, options()) else {
        return Error("could not open the sleeping place")
    }
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let snap = store.snapshot(db)
    let wait = harness.WaitKey(run: 1u64, slot: 0u64, kind: harness.APPROVAL, generation: 0u64)
    let member_key = harness.EffectKey(run: wait.run, round: wait.generation, kind: harness.TOOL, ordinal: wait.slot)
    let Ok(Some(Open(take key, _))) = store.get(snap, store.shape(h.waits), wait) else {
        return Error("note_add was not waiting for approval")
    }
    let Ok(Some(member)) = store.get(snap, store.shape(h.effects), member_key) else {
        return Error("missing held tool call")
    }
    let Some(c) = view member.call else {
        return Error("missing held tool")
    }
    let Inline(raw) = view c.args else {
        return Error("held tool did not have inline arguments")
    }
    let Ok(saved) = text_arg(raw, "text") else {
        return Error("missing held note text")
    }
    if c.name != "note_add" || saved != LIVE_NOTE {
        return Error("held tool or its arguments differed from the prompt")
    }
    let Ok(()) = store.close(take db) else {
        return Error("could not close the sleeping place")
    }
    Ok(harness.Decision(run: wait.run, round: wait.generation, ordinal: wait.slot, key: take key, allow: true))
}

fn live_result(out: Stdout, dir: Dir, b: Browser, tasks: Tasks, random: Random) -> Result[(), String] waits {
    let Ok(db) = store.open(tasks, dir, b.clock, random, options()) else {
        return Error("could not open the final journal")
    }
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let t = result.unwrap(store.with_schema(db, code.describe(tables)))
    let snap = store.snapshot(db)
    let mut tokens = 0u64
    for i in 0u64 .. 3u64 {
        let Ok(Some(run)) = store.get(snap, store.shape(h.runs), i) else {
            return Error("missing run in the journal")
        }
        let Finished(Answered) = view run.phase else {
            return Error("run did not finish with an answer")
        }
        if run.spend.known == 0u64 || run.spend.reserved != 0u64 || run.spend.unresolved != 0u64 {
            return Error("run did not settle its token usage")
        }
        tokens += run.spend.known
    }
    count(out, "settled tokens: ", tokens)
    let Ok(Some(note)) = store.get(snap, store.shape(t.notes), 0u64) else {
        return Error("note_add did not save a note")
    }
    if note != LIVE_NOTE {
        return Error("note_add saved different text")
    }
    let Ok(Some(1u64)) = store.get(snap, store.shape(t.stats), RESULTS) else {
        return Error("expected exactly one tool result")
    }
    let Ok(()) = store.close(take db) else {
        return Error("could not close the final journal")
    }
    Ok(())
}

fn live_turns(out: Stdout, root: Dir, d: harness.gateway.Door[Services], b: Browser, tasks: Tasks, random: Random) -> Result[(), String] waits {
    post(b, "/sessions", browser_headers(b.credential, 0u64), string.into_bytes("notes smoke"), 201u16, b"0")?
    let Ok(dir) = std.dir.narrow(root, "s0") else {
        return Error("missing HTTP-created session directory")
    }
    let seeded = journal(dir)
    let mut stream = browser_request(b, "GET", "/sessions/0/events", browser_headers(b.credential, 0u64), list.new(), 180000u64, 1073741824u64)?
    if std.http_client.status(std.http_client.head(stream)) != 200u16 {
        return Error("browser SSE request was refused")
    }
    let mut dec = std.sse.decoder(65536u64)
    message(b, 0u64, 0u64, "warmup", LIVE_WARMUP)?
    let warmup = browser_reply(mut stream, mut dec, b.clock, 0u64, 0u64, "answered", false)?
    if warmup.text != "READY" {
        return Error("warmup answer differed from READY")
    }
    let idle = live_down(d, b.clock, 0u64)?
    let first = journal(dir)
    count(out, "journal commits, warmup: ", first - seeded)
    message(b, 1u64, 1u64, "add-note", LIVE_PROMPT)?
    let held = browser_reply(mut stream, mut dec, b.clock, 1u64, warmup.at, "waiting", false)?
    let waiting = live_down(d, b.clock, idle.ups)?
    let paused = journal(dir)
    count(out, "journal commits, tool call through approval wait: ", paused - first)
    let decision = live_decision(dir, b, tasks, random)?
    post(b, "/sessions/0/decisions", browser_headers(b.credential, 2u64), json(decision), 200u16, json((Approved : harness.Ruling)))?
    let saved = browser_reply(mut stream, mut dec, b.clock, 1u64, held.at, "answered", false)?
    if saved.text != "SAVED" {
        return Error("tool acknowledgement differed from SAVED")
    }
    let asleep = live_down(d, b.clock, waiting.ups)?
    let second = journal(dir)
    count(out, "journal commits, approval through acknowledgement: ", second - paused)
    count(out, "place downs before wake message: ", asleep.downs)
    let started = host.mono_ns(b.clock)
    message(b, 3u64, 2u64, "wake", LIVE_WAKE)?
    let resumed = browser_reply(mut stream, mut dec, b.clock, 2u64, saved.at, "answered", true)?
    if !string.starts_with(resumed.text, "1.") || string.byte_len(resumed.text) < 80u64 {
        return Error("wake answer did not contain the requested numbered explanation")
    }
    count(out, "first preview latency ns: ", resumed.first_preview_ns - started)
    count(out, "wake answer preview deltas: ", resumed.preview_deltas)
    let woken = live_down(d, b.clock, asleep.ups)?
    count(out, "place ups after wake message: ", woken.ups)
    count(out, "journal commits, wake answer: ", journal(dir) - second)
    live_result(out, dir, b, tasks, random)
}

pub fn live_smoke(out: Stdout, data: Dir, clock: Clock, random: Random, tasks: Tasks, network: Net, api_key: Secret) -> Result[(), Exit] waits {
    let Ok(ips) = std.net.lookup(network, OPENROUTER, At(clock, host.mono_ns(clock) + 5000000000u64)) else {
        return quit(out, "cannot resolve openrouter.ai")
    }
    let mut resolved: Option[Addr] = None
    for ip in ips {
        if let V4(_) = ip {
            resolved = Some(Addr(ip: ip, port: 443u16));
            break
        }
    }
    let Some(upstream) = resolved else {
        return quit(out, "openrouter.ai has no IPv4 address")
    }
    let hub = harness.preview.start(tasks, 1048576u64, 4096u64)
    let (helper, _unused): (Sender[HelperAsk], Receiver[HelperAsk]) = channel.new(1u64)
    let live = Live(net: network, address: upstream, key: secret.share(api_key), out: out, preview: harness.preview.door(hub), group: "")
    let way: harness.gateway.Doorway[Services] = harness.gateway.doorway()
    let d = harness.gateway.door_of(way)
    let config = harness.gateway.GatewayConfig(root: data, options: options(), migrate: code.describe(migrate), factory: live_factory(), max_sessions: 1u64, idle_ms: IDLE_MS, place_bytes: 67108864u64, tasks: tasks, clock: clock, random: random, net: network, watch: None, seed: Services(helper: take helper, clock: clock, live: Some(take live), stream: None))
    let Ok(take g) = harness.gateway.gateway(take way, take config) else {
        return quit(out, "could not start the gateway")
    }
    let Ok((take listener, address)) = host.listen(network, loopback(), 16u16) else {
        return quit(out, "could not listen for HTTP")
    }
    let mut tools: List[String] = list.new()
    list.push(mut tools, "note_add")
    let front = harness.gateway_http.Front(submit: store.fixture.transact_entry(code.describe(submit_entry)), decide: store.fixture.transact_entry(code.describe(decide_entry)), keys: result.unwrap(store.fixture.entry_keys(code.describe(place))), socket: wire().socket, agent: LIVE_MODEL, narrow: Only(take tools), preview: Some(harness.preview.door(hub)), tasks: tasks, clock: clock, random: random, net: network, tail_lines: 64u64, within_ms: HTTP_MS, poll_ms: 10u64, beat_ms: 50u64, conn_bytes: 8388608u64, conns_max: 4u64, head_max: 8192u64, body_max: 65536u64)
    let served = harness.gateway_http.serve(d, take front, take listener)
    let ran = live_turns(out, data, d, Browser(net: network, clock: clock, address: address, credential: store.ingress.credential(random)), tasks, random)
    harness.gateway_http.halt(take served)
    let _ = harness.gateway.stop(take g)
    harness.preview.stop(take hub)
    match take ran {
        Ok(()) => {
            emit(out, "HTTP smoke passed", "");
            Ok(())
        },
        Error(take why) => quit(out, why),
    }
}

// ---- the scripted gateway that the TypeScript client is tested against ----
fn scripted_place(take supplied: store.local.Supplied, s: Services) -> Result[store.runner.PlaceConfig[Grants, harness.Handles, Services, ()], Capacity] {
    let mut config = settings(Memory, supplied.clock, supplied.random, supplied.tasks, supplied.net, Services(helper: channel.sender(s.helper), clock: s.clock, live: None, stream: copy_stream(s.stream, supplied.name)))
    config.wire = Some(store.runner.wire_bind((), code.describe(store.ingress.caller), 4096u64, 65536u64))
    Ok(take config)
}

fn scripted_factory() -> store.local.Factory[Services] {
    store.local.seeded_factory(scripted_place)
}

// Serves the scripted notes agent over HTTP until it is killed. It prints `port N` once
// it listens, then `down N` each time session 0's place stops.
pub fn serve_scripted(out: Stdout, data: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), Exit] waits {
    let mut helper_name = string.with_capacity(32u64)
    let Ok(helper_dir) = host.mkdtemp(data, mut helper_name) else {
        return quit(out, "cannot make the helper directory")
    }
    let (ask, asks): (Sender[HelperAsk], Receiver[HelperAsk]) = channel.new(1u64)
    let helping = task.spawn(tasks, bytes 67108864u64, HelperSeed(inbox: take asks, dir: helper_dir, clock: clock, random: random, tasks: tasks, net: net), helper_service)
    let hub = harness.preview.start(tasks, 1048576u64, 4096u64)
    let way: harness.gateway.Doorway[Services] = harness.gateway.doorway()
    let d = harness.gateway.door_of(way)
    let seed = Services(helper: channel.sender(ask), clock: clock, live: None, stream: Some(Stream(door: harness.preview.door(hub), group: "")))
    let config = harness.gateway.GatewayConfig(root: data, options: options(), migrate: code.describe(migrate), factory: scripted_factory(), max_sessions: 1u64, idle_ms: IDLE_MS, place_bytes: 67108864u64, tasks: tasks, clock: clock, random: random, net: net, watch: None, seed: take seed)
    let Ok(take g) = harness.gateway.gateway(take way, take config) else {
        return quit(out, "could not start the gateway")
    }
    let Ok((take listener, address)) = host.listen(net, loopback(), 16u16) else {
        return quit(out, "could not listen for HTTP")
    }
    let front = harness.gateway_http.Front(submit: store.fixture.transact_entry(code.describe(submit_entry)), decide: store.fixture.transact_entry(code.describe(decide_entry)), keys: result.unwrap(store.fixture.entry_keys(code.describe(place))), socket: wire().socket, agent: "scripted", narrow: All, preview: Some(harness.preview.door(hub)), tasks: tasks, clock: clock, random: random, net: net, tail_lines: 4u64, within_ms: HTTP_MS, poll_ms: 10u64, beat_ms: 200u64, conn_bytes: 8388608u64, conns_max: 8u64, head_max: 8192u64, body_max: 65536u64)
    let served = harness.gateway_http.serve(d, take front, take listener)
    count(out, "port ", int.widen(address.port))
    let mut downs = 0u64
    loop {
        std.clock.sleep_ns(clock, 20000000u64)
        let m = harness.gateway.marks(d, 0u64)
        if m.downs != downs {
            downs = m.downs
            count(out, "down ", downs)
        }
    }
    harness.gateway_http.halt(take served)
    let _ = harness.gateway.stop(take g)
    harness.preview.stop(take hub)
    let _ = take ask
    let _ = task.join(take helping)
    Ok(())
}

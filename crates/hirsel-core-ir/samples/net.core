; Harness-owned descriptors: net_tests.rs checks fd counts and admission counts.
; f0 releases a sole owner; f1 splits then releases both halves; f2 is denied.
core v1
type t0 = own "Socket" { handle: socket }
sig g0 = (u64) -> ()
sig g1 = (u64) -> (u64, u8, u32, u64)
sig g2 = (u64, u8, u64, u64, u16, ptr) -> (u64, u8, u32, u64)
inst n0 = test@1/net/drop [] []
inst n1 = test@1/net/split [] []
inst n2 = test@1/net/denied [] []
fn f0 = n0 g0 {
 slot s0 = t0
 addr a0 = s0 : t0
 addr a1 = a0 field 0 : u64
b0(v0: u64):
 live s0
 address a0
 address a1
 store a1, v0
 drop a0 t0
 dead s0
 return
}
fn f1 = n1 g0 {
 slot s0 = t0
 slot s1 = t0
 addr a0 = s0 : t0
 addr a1 = a0 field 0 : u64
 addr a2 = s1 : t0
 addr a3 = a2 field 0 : u64
b0(v0: u64):
 live s0
 live s1
 v1: u64, v2: u8, v3: u32, v4: u64 = call rt.net_split g1 (v0) fail b1
 address a0
 address a1
 address a2
 address a3
 store a1, v1
 store a3, v4
 drop a2 t0
 drop a0 t0
 dead s1
 dead s0
 return
b1:
 propagate
}
fn f2 = n2 g1 {
b0(v0: u64):
 v1: u8 = const 0
 v2: u64 = const 0
 v3: u64 = const 134744072
 v4: u16 = const 80
 v5: ptr = const 0x0
 v6: u64, v7: u8, v8: u32, v9: u64 = call rt.host_connect g2 (v0,v1,v2,v3,v4,v5) fail b1
 return v6,v7,v8,v9
b1:
 propagate
}

fn object_cut_law(tasks: Tasks, r: Random, sim: BucketSim) -> Result[(), Error] waits {
    let client = bucket_law_client_with(sim, tasks, "s3.test", 1, true)?
    let mut source = history_reader(take client, 0)
    let mut workspace = history_buffers(1057000)?
    let (take opened, _) = history_open_register(mut source, sim.time, r, result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64)), "bucket", mut workspace, BUCKET_LAW_OP_MS)?
    let mut held = take opened
    let id = held.head.store
    let metadata = history_config_bytes(object_history_config(std.object.bucket_config(source.client), "bucket"))?
    bucket_m2_law_commit_packet(mut workspace.packet, held.head, 1)?
    let HistoryApplied(_) = history_register_advance(mut source.client, mut held, metadata, mut workspace, source.deadline)? else {
        fail("checkpoint law's group was refused")
    }
    let old_checkpoint = history_key("e-", held.head.checkpoint)
    let (take previous, _) = history_checkpoint(mut source.client, held.head, source.deadline)?
    let retained = history_retain(previous, held.head.checkpoint, 4, 1)?
    let mut page_manifest = page_manifest_empty()
    page_manifest.generation = 2
    page_manifest.first_live = 4
    page_manifest.prev_first = 4
    page_manifest.branches[0].version = 1
    let manifest = history_create_manifest(mut source.client, id, held.head.pair.epoch, 1, page_manifest, mut workspace, source.deadline)?
    let location = history_make_locator(mut source.client, id, 4, 1, 1, list.new(), mut workspace, source.deadline)?
    let activation = HistoryActivation(number: 1, binding:[42; 32])
    let HistoryApplied(_) = history_publish_checkpoint(mut source.client, mut held, metadata, manifest, retained, location, Some(activation), mut workspace, source.deadline)? else {
        fail("checkpoint did not advance the register")
    }
    let mut new_reader = bucket_law_client_with(sim, tasks, "s3.test", 2, true)?
    let _ = history_fetch(mut new_reader, "head", mut workspace.witness, source.deadline)?
    let capture = history_decode_head(workspace.witness)?
    if capture.head.entry.seq != 4 || capture.head.checkpoint.seq != 4 || capture.head.floor != 4 || capture.head.activation != 1 || capture.head.binding[31] != 42 {
        fail("checkpoint did not atomically publish the floor, activation and binding")
    }
    // Older checkpoints and groups are not needed by the new capture.
    match std.object.erase(mut source.client, old_checkpoint, source.deadline) {
        Ok(()) => (),
        Error(take problem) => return Error(Remote(take problem)),
    }
    let recovered = history_paged_capture(mut source, capture.head, 1048576)?
    if recovered.state.tips[0].head != 1 { fail("cold recovery lost the checkpoint's main tip") }
    object_locator_boundary(mut source, held.head, manifest, mut workspace)
}

// A root at the row limit fits directly. One more row needs two child
// objects whose combined leaf rows are exactly the sorted input.
fn object_locator_boundary(mut source: ObjectPackRead, head: HistoryHead, manifest: HistoryRef, mut workspace: HistoryBuffers) -> Result[(), Error] waits {
    let mut input: List[HistoryRef] = list.with_capacity(32769)
    for ordinal in 1u64 .. 32770 {
        list.push(mut input, HistoryRef(seq: ordinal, epoch: 1, len: 96, digest: ordinal * 2))
    }
    let flat = history_make_locator(mut source.client, head.store, 5, 1, 1, clone(list.slice(input, 0, 32768)), mut workspace, source.deadline)?
    if flat.depth != 0 || list.len(flat.rows) != 32768 {
        fail("a full LOCATE root grew an extra level")
    }
    let split = history_make_locator(mut source.client, head.store, 5, 1, 1, take input, mut workspace, source.deadline)?
    if split.depth != 1 || list.len(split.rows) != 2 {
        fail("one row above the limit did not make two child chunks")
    }
    let ctx = DiskContext(store: head.store, role: 2, seq: 5)
    let retained = HistoryRetention(floor: 5, earlier: list.new())
    let mark_entry = history_checkpoint_packet(mut workspace.packet, ctx, 1, 1, head.entry, manifest, retained, split)?
    let mark = history_read_mark("test checkpoint", head.store, mark_entry, workspace.packet)?
    let mut observed = head
    observed.checkpoint = mark_entry
    let loaded = history_locator(mut source.client, observed, mark, workspace.packet, source.deadline)?
    if map.len(loaded.rows) != 32769 || option.unwrap(map.get(loaded.rows, 32768)).digest != 65536 ||
        option.unwrap(map.get(loaded.rows, 32769)).digest != 65538 {
        fail("the split locator changed the leaf rows at the boundary")
    }
    Ok(())
}

@test
fn bucket_test_m2_checkpoint_advance(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let sim = bucket_law_sim(tasks, c, 992, None, list.new())
    let outcome = object_cut_law(tasks, r, sim)
    let _ = bucket_law_finish(take sim)
    outcome
}

fn locator_reuse_law(tasks: Tasks, sim: BucketSim) -> Result[(), Error] waits {
    let mut client = bucket_law_client_with(sim, tasks, "s3.test", 1, true)?
    let deadline = std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
    let mut workspace = history_buffers(1057000)?
    let mut input: List[HistoryRef] = list.with_capacity(32770)
    for pack in 1u64 .. 32771 {
        list.push(mut input, HistoryRef(seq: pack, epoch: 1, len: 96, digest: pack * 2))
    }
    let id = StoreId(hi: 2, lo: 7)
    let previous = history_make_locator(mut client, id, 20, 1, 1, clone(input), mut workspace, deadline)?
    if previous.depth != 1 || list.len(previous.rows) != 2 {
        fail("the admitted locator has the wrong shape")
    }
    let unchanged = previous.rows[1]
    let parent = HistoryRef(seq: 19, epoch: 1, len: 112, digest: 19)
    let manifest = HistoryRef(seq: 1, epoch: 1, len: 88, digest: 7)
    let kept = HistoryRetention(floor: 20, earlier: list.new())
    let ctx = DiskContext(store: id, role: 2, seq: 20)
    let prior_cut = history_checkpoint_packet(mut workspace.packet, ctx, 1, 1, parent, manifest, kept, previous)?
    let base = HistoryHead(authority_kind: 1, store: id, pair: HistoryPair(epoch: 1, holder: id), activation: 0, entry: prior_cut, checkpoint: prior_cut, floor: 20, binding:[0; 32])
    let mark = history_read_mark("locator at 20", id, prior_cut, workspace.packet)?
    let inherited = history_locator(mut client, base, mark, workspace.packet, deadline)?
    let mut located = empty_history_locator()
    let changed: List[HistoryRef] = clone(list.slice(input, 1, 32770))
    let updated = history_make_locator_reusing(mut client, id, 24, 1, 1, take changed, inherited, mut located, mut workspace, deadline)?
    if updated.depth != 1 || list.len(updated.rows) != 2 || updated.rows[0].seq != 24 ||
        !history_ref_matches(updated.rows[1], unchanged) {
        fail("deleting an earlier row rewrote an unchanged chunk or misplaced it")
    }
    let current_ctx = DiskContext(store: id, role: 2, seq: 24)
    let retained = HistoryRetention(floor: 24, earlier: list.new())
    let current_cut = history_checkpoint_packet(mut workspace.packet, current_ctx, 1, 1, prior_cut, manifest, retained, updated)?
    let mut captured = base
    captured.entry = current_cut
    captured.checkpoint = current_cut
    captured.floor = 24
    let current_mark = history_read_mark("locator at 24", id, current_cut, workspace.packet)?
    let recovered = history_locator(mut client, captured, current_mark, workspace.packet, deadline)?
    if map.len(recovered.rows) != 32769 || map.contains(recovered.rows, 1) {
        fail("the reused locator lost or invented pack rows")
    }
    for pack in 2u64 .. 32771 {
        let Some(row) = map.get(recovered.rows, pack) else { fail("missing pack row") }
        if row.epoch != 1 || row.len != 96 || row.digest != pack * 2 {
            fail("the reused locator changed a pack reference")
        }
    }
    Ok(())
}

@test
fn bucket_test_m2_locator_reuse(c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let sim = bucket_law_sim(tasks, c, 530, None, list.new())
    let outcome = locator_reuse_law(tasks, sim)
    let report = bucket_law_finish(take sim)
    outcome?
    if report.writes != 3 { fail("the unchanged locator chunk was written again") }
    Ok(())
}

fn upload_pack_with_expired_completion(tasks: Tasks, sim: BucketSim, name: String, raw: Bytes) -> Result[(), Error] waits {
    let mut client = bucket_law_client_with(sim, tasks, "s3.test", 1, true)?
    let mut scratch: Bytes = list.new()
    let deadline = std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
    history_upload_pack(mut client, name, raw, mut scratch, deadline)
}

// L54m. Connections serve one request each. The third is completion of the
// first upload. Its HTTP 200 error spends the ID without publishing the key.
@test
fn bucket_test_m2_multipart_restart(c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let mut faults: List[std.sim.s3.Fault] = list.with_capacity(2)
    list.push(mut faults, Clean)
    list.push(mut faults, CompleteExpired)
    let mut draws: List[u64] = list.with_capacity(16)
    list.fill(mut draws, 16, 0u64)
    draws[4u64] = 0x8000000000000000u64
    let mut streams: List[List[u64]] = list.with_capacity(1)
    list.push(mut streams, take draws)
    let plan = std.sim.world.plan_from(std.sim.world.Script(tail_seed: 54, streams: take streams), 0)
    let sim = bucket_law_sim_plan(tasks, c, 54, None, take faults, take plan)
    let name = "p-00000000000000000007-00000000000000000001-0123456789abcdef"
    let raw = string.into_bytes(string.from("these are the complete pack bytes"))
    let sent = upload_pack_with_expired_completion(tasks, sim, name, raw)
    let observed = bucket_law_finish(take sim)
    sent?
    let Some(saved) = map.get(observed.objects, name) else { fail("completed pack is missing") }
    if saved.data != raw || observed.writes != 1 || observed.multipart_uploads != 2 || list.len(observed.pending) != 0 {
        fail("multipart restart did not publish only the original bytes under a fresh upload")
    }
    Ok(())
}

fn object_cut_upload_budget_law(c: Clock, r: Random, tasks: Tasks, sim: BucketSim) -> Result[(), Error] waits {
    let clean = bucket_law_authority(sim, tasks, "spare.test", 1)?
    let mut options = bucket_law_options(true)
    options.group_bytes = 65536
    options.head_poll_ms = 10000
    let mut seed = open_authority(tasks, take clean, c, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    let _ = bucket_law_rows_table(mut seed)?
    close(take seed)?
    options.create = false
    let primary = bucket_law_authority(sim, tasks, "s3.test", 2)?
    let mut writer = open_authority(tasks, take primary, c, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    bucket_law_commit(mut writer, 1)?
    let mut witness = bucket_law_client_with(sim, tasks, "spare.test", 3, true)?
    let deadline = std.object.deadline_after_ms(witness, BUCKET_LAW_OP_MS)
    let mut workspace = history_buffers(65536)?
    let _ = history_fetch(mut witness, "head", mut workspace.witness, deadline)?
    let baseline = history_decode_head(workspace.witness)?
    if let Error(Remote(Uncertain(Status(200, _)))) = checkpoint(mut writer) {} else {
        fail("the cut did not refuse the exhausted multipart upload")
    }
    let _ = history_fetch(mut witness, "head", mut workspace.body, deadline)?
    if workspace.body != workspace.witness {
        fail("a refused pack upload published a checkpoint")
    }
    healthy(writer)?
    bucket_law_commit(mut writer, 2)?
    let _ = history_fetch(mut witness, "head", mut workspace.body, deadline)?
    let observed = history_decode_head(workspace.body)?
    if observed.head.entry.seq != baseline.head.entry.seq + 1 ||
        !history_ref_matches(observed.head.checkpoint, baseline.head.checkpoint) {
        fail("the holder could not publish a group after its cut was refused")
    }
    close(take writer)
}

@test
fn bucket_test_m2_multipart_refused_cut(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut faults: List[std.sim.s3.Fault] = list.with_capacity(1)
    list.push(mut faults, CompleteExpired)
    let uncut = bucket_law_wire_cut(0xffffffffffffffffu64, false)
    let sim = bucket_law_sim(tasks, c, 540, Some(uncut), take faults)
    let outcome = object_cut_upload_budget_law(c, r, tasks, sim)
    let _ = bucket_law_finish(take sim)
    outcome
}

fn object_import_seed(mut writer: Db, rows: Table[u64, u64], other: Table[u64, u64]) -> Result[(), Error] waits {
    let outcome = run(mut writer, None, (copy_env(rows), copy_env(other)), fn(mut tx, tables) -> Result[(), Error] {
        for k in 0u64 .. 96 { put(mut tx, tables.0, k, k + 1)? }
        for k in 10u64 .. 16 { put(mut tx, tables.1, k, k * 10)? }
        Ok(())
    })?
    let Committed(take receipt) = take outcome else { fail("could not seed both import tables") }
    durable(mut writer, receipt.ticket)?
    bucket_law_checkpoint(mut writer)
}

fn object_import_edit(mut writer: Db, rows: Table[u64, u64], other: Table[u64, u64], later: bool) -> Result[(), Error] waits {
    let outcome = run(mut writer, None, (copy_env(rows), copy_env(other), copy_env(later)), fn(mut tx, fixture) -> Result[(), Error] {
        if fixture.2 {
            put(mut tx, fixture.0, 96, 970)?
            put(mut tx, fixture.1, 16, 160)?
        } else {
            put(mut tx, fixture.0, 7, 700)?
            put(mut tx, fixture.1, 12, 1200)?
            if !delete(mut tx, fixture.0, 8)? || !delete(mut tx, fixture.1, 13)? {
                fail("the rows to delete must exist in both import tables")
            }
        }
        Ok(())
    })?
    let Committed(take receipt) = take outcome else { fail("could not commit the import fixture edits") }
    durable(mut writer, receipt.ticket)
}

fn object_import_rows(read_handle: Reader, visible: Snapshot, table_handle: Table[u64, u64], expected: Map[u64, u64]) -> Result[(), Error] waits {
    let limit = Limits(rows: 2, byte_limit: 1024)
    let mut batch = scan_page(read_handle, visible, table_handle, Unbounded, Unbounded, limit)?
    let mut seen = 0u64
    let mut previous: Option[u64] = None
    loop {
        for (key, value) in batch.rows {
            let Some(expected_value) = map.get(expected, key) else {
                fail("the restored table has a row outside its frozen map")
            }
            if (if let Some(prior_key) = previous { key <= prior_key } else { false }) ||
                value != expected_value {
                fail("the restored table differs from its frozen map")
            }
            previous = Some(key)
            seen += 1
        }
        let Page(next: take more, ..) = take batch
        let Some(take resume) = take more else { break }
        if seen >= map.len(expected) {
            fail("the restored table has a resume after its last expected row")
        }
        let Paged(take following) = scan_next(read_handle, visible, table_handle, take resume, limit)? else {
            fail("the restored table's resume must stay on the same snapshot")
        }
        if list.len(following.rows) == 0 { fail("the restored table's resume made no progress") }
        batch = take following
    }
    if seen != map.len(expected) { fail("the restored table ended before its frozen map") }
    Ok(())
}

fn object_import_law(d: Dir, c: Clock, r: Random, tasks: Tasks, sim: BucketSim) -> Result[(), DeployError] waits {
    let original = disk_test_directory(d)
    deploy_result(crash_install_init(original, c, r, tasks))?
    let log_options = disk_crash_options("install")
    let mut writer = deploy_result(open(tasks, original, c, r, log_options))?
    let source_rows = deploy_result(table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let source_other = deploy_result(table(mut writer, "other", std.codec.key_u64(), std.codec.of_u64()))?
    deploy_result(object_import_seed(mut writer, source_rows, source_other))?
    deploy_result(object_import_edit(mut writer, source_rows, source_other, false))?

    let mut expected_rows: Map[u64, u64] = map.new()
    for k in 0u64 .. 96 {
        if k != 8 { map.insert(mut expected_rows, k, if k == 7 { 700 } else { k + 1 }) }
    }
    let mut expected_other: Map[u64, u64] = map.new()
    for k in 10u64 .. 16 {
        if k != 13 { map.insert(mut expected_other, k, if k == 12 { 1200 } else { k * 10 }) }
    }
    let frozen_head = version(snapshot(writer))
    let original_id = writer.store
    let attempt = install_fixture_bytes(16, 7)
    let copying = begin_export_copy(mut writer, d, clone(attempt), 1)?
    deploy_result(object_import_edit(mut writer, source_rows, source_other, true))?
    if version(snapshot(writer)) <= frozen_head { fail("the source did not advance after capture") }
    let exported = export_copy(take copying)?
    release_export(mut writer, attempt)
    deploy_result(close(take writer))?
    let export_dir = exported.dir
    let options = bucket_law_options(true)
    let prepared = open_export(export_dir, c, attempt, log_options)?
    let primary = deploy_result(bucket_law_authority(sim, tasks, "s3.test", 1))?
    if let Error(Remote(Uncertain(Status(200, _)))) = import_authority(take primary, take prepared, r, options) {} else {
        fail("the import did not refuse the failed pack upload")
    }
    let mut witness = deploy_result(bucket_law_client_with(sim, tasks, "spare.test", 2, true))?
    let deadline = std.object.deadline_after_ms(witness, BUCKET_LAW_OP_MS)
    let mut workspace = deploy_result(history_buffers(65536))?
    if let Error(Remote(NotFound)) = history_fetch(mut witness, "head", mut workspace.witness, deadline) {} else {
        fail("the failed import published an intermediate empty store")
    }
    let debris = history_key("p-", HistoryRef(seq: 1, epoch: 1, len: 1, digest: 77))
    let mut orphan = string.into_bytes(string.from("x"))
    deploy_result(history_create(mut witness, debris, mut orphan, mut workspace.compare, deadline))?
    let clean = deploy_result(bucket_law_authority(sim, tasks, "spare.test", 3))?
    let admitted = open_export(export_dir, c, attempt, log_options)?
    let id = deploy_result(import_authority(take clean, take admitted, r, options))?
    let _ = deploy_result(history_fetch(mut witness, "head", mut workspace.witness, deadline))?
    let initial = deploy_result(history_decode_head(workspace.witness))?
    if same(id, original_id) || !same(id, initial.head.store) || initial.head.entry.seq != 1 ||
        initial.head.checkpoint.seq != 1 || initial.head.pair.epoch != 1 {
        fail("import did not publish the new identity at the first checkpoint")
    }
    let repeated = deploy_result(bucket_law_authority(sim, tasks, "spare.test", 4))?
    let duplicate = open_export(export_dir, c, attempt, log_options)?
    match import_authority(take repeated, take duplicate, r, options) {
        Error(Exists(namespace)) if namespace == "authority" => (),
        _ => fail("standalone import was allowed to replace an existing store"),
    }
    let _ = deploy_result(history_fetch(mut witness, "head", mut workspace.body, deadline))?
    if workspace.witness != workspace.body {
        fail("the duplicate import changed the existing register")
    }
    let cold = deploy_result(bucket_law_authority(sim, tasks, "spare.test", 5))?
    let mut process = followers()
    let plan = follower_law_plan(Bucket(bucket_law_lanes(0)), options)
    let service = deploy_result(follower_law_service(tasks, plan, 1))?
    let owner = deploy_result(follower_owner(service))?
    let slot = deploy_result(follower_slot(owner, plan))?
    let follower_view = deploy_result(follower(mut process, take slot, take cold, sim.time, options.expect))?
    let visible = deploy_result(snapshot_follower(follower_view, Branch(store: id, id: 0)))?
    let view_reader = deploy_result(follower_reader(follower_view, 0))?
    let mut schema = declare_follower(follower_view)
    let declared_rows = deploy_result(declare_table(mut schema, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let rows = deploy_result(finish(mut schema, take declared_rows))?
    let declared_other = deploy_result(declare_table(mut schema, "other", std.codec.key_u64(), std.codec.of_u64()))?
    let other = deploy_result(finish(mut schema, take declared_other))?
    deploy_result(seal_follower(follower_view, take schema))?
    if version(visible) != frozen_head { fail("the imported base lost the writer's captured version") }
    deploy_result(object_import_rows(view_reader, visible, rows, expected_rows))?
    deploy_result(object_import_rows(view_reader, visible, other, expected_other))
}

@test
fn bucket_test_m2_standalone_import(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let mut faults: List[std.sim.s3.Fault] = list.with_capacity(1)
    list.push(mut faults, CompleteExpired)
    let uncut = bucket_law_wire_cut(0xffffffffffffffffu64, false)
    let sim = bucket_law_sim(tasks, c, 1207, Some(uncut), take faults)
    let outcome = object_import_law(d, c, r, tasks, sim)
    let _ = bucket_law_finish(take sim)
    outcome
}

fn check_object_export(take job: ExportCopy, c: Clock, expected: Option[u64]) -> Result[(u64, u64), DeployError] waits {
    let image = export_copy(take job)?
    let mut prepared = open_export(image.dir, c, image.stamp.attempt, disk_crash_options("install"))?
    let rows = deploy_result(table(mut prepared.db, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let image_reader = deploy_result(staged_reader(prepared, 0))?
    let visible = snapshot(prepared.db)
    if deploy_result(get(image_reader, visible, rows, 7))? != expected {
        fail("the ordinary preparation opener recovered the wrong export row")
    }
    Ok((version(visible), image.stamp.end))
}

fn object_export_law(d: Dir, c: Clock, r: Random, tasks: Tasks, sim: BucketSim) -> Result[(), DeployError] waits {
    let first = deploy_result(bucket_law_authority(sim, tasks, "s3.test", 1))?
    let mut options = bucket_law_options(true)
    options.group_bytes = 65536
    options.retain = 1
    options.head_poll_ms = 10000
    let mut writer = open_authority(tasks, take first, c, r, options) ?=> |Refusal(error: take problem, ..)| Store(take problem)
    let mut staged = deploy_result(install_old(writer))?
    let description = install_fixture_bytes(32, 65)
    deploy_result(stage_activation(mut staged, 1, None, description, std.codec.of_bytes(), description))?
    deploy_result(install_bound_activation(mut writer, take staged, 1, description))?
    let attempt_one = install_fixture_bytes(16, 1)
    let empty = begin_export_copy(mut writer, d, clone(attempt_one), 1)?
    let zero_suffix = check_object_export(take empty, c, None)?
    release_export(mut writer, attempt_one)
    if zero_suffix != (1u64, 72u64) { fail("the empty suffix wrote journal data") }
    let rows = deploy_result(table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    if !typed_put(mut writer, rows, 7, 14) { fail("could not write the export fixture group") }
    let attempt_two = install_fixture_bytes(16, 2)
    let grouped = begin_export_copy(mut writer, d, clone(attempt_two), 1)?
    let group_suffix = check_object_export(take grouped, c, Some(14u64))?
    release_export(mut writer, attempt_two)
    if group_suffix.0 != 2 || group_suffix.1 <= 72 { fail("the GROUP was absent from the export") }
    deploy_result(close(take writer))?

    let second = deploy_result(bucket_law_authority(sim, tasks, "s3.test", 2))?
    options.create = false
    let mut successor = open_authority(tasks, take second, c, r, options) ?=> |Refusal(error: take problem, ..)| Store(take problem)
    let attempt_three = install_fixture_bytes(16, 3)
    let with_claim = begin_export_copy(mut successor, d, clone(attempt_three), 1)?
    // The cut drops the prior checkpoint from retention before the copy runs.
    let _ = deploy_result(checkpoint(mut successor))?
    deploy_result(reclaim_barrier(successor))?
    let claim_suffix = check_object_export(take with_claim, c, Some(14u64))?
    release_export(mut successor, attempt_three)
    if claim_suffix != group_suffix { fail("CLAIM changed the replayed version or journal extent") }
    deploy_result(close(take successor))
}

@test
fn bucket_test_m2_export_replay(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let sim = bucket_law_sim(tasks, c, 611, None, list.new())
    let outcome = object_export_law(d, c, r, tasks, sim)
    let _ = bucket_law_finish(take sim)
    outcome
}

fn release_witness(digest: Inline[u8, 32]) -> Bytes {
    let mut octets: Bytes = list.with_capacity(32)
    for i in 0u64 .. 32 { list.push(mut octets, digest[i]) }
    take octets
}

fn prepared_release_witness(_target: PreparedTarget, digest: Inline[u8, 32]) -> Result[Bytes, DeployError] {
    Ok(release_witness(digest))
}

fn stage_object_preparation(mut db: Db, scratch: Dir, c: Clock, tasks: Tasks, attempt: Bytes, resident: u64) -> Result[Inline[u8, 32], DeployError] waits {
    let pending = begin_export_copy(mut db, scratch, clone(attempt), 1)?
    let image = export_copy(take pending)?
    let source = open_export(image.dir, c, attempt, disk_crash_options("install"))?
    let staged = deploy_result(stage_next(source, tasks))?
    let target = PreparedTarget(describe: install_fixture_bytes(32, 66), release: install_fixture_bytes(32, 67), digest: install_fixture_bytes(32, 68), resident_limit: resident, pack_bytes: 1048576, checkpoint_bytes: 4096, journal_limit: 16781392)
    write_prepared(source, staged, image.dir, take target)?
    let checked = validate_prepared(image.dir)?
    let work = reserve_import(mut db, take checked)?
    let assembled = import_trees(take work)?
    let digest = imported_digest(assembled)
    keep_import(mut db, take assembled)?
    Ok(digest)
}

fn object_prepared_install_law(d: Dir, c: Clock, r: Random, tasks: Tasks, sim: BucketSim) -> Result[(), DeployError] waits {
    let original = deploy_result(bucket_law_authority(sim, tasks, "s3.test", 1))?
    let mut options = bucket_law_options(true)
    options.group_bytes = 65536
    options.head_poll_ms = 10000
    let mut writer = open_authority(tasks, take original, c, r, options) ?=> |Refusal(error: take problem, ..)| Store(take problem)
    let mut staged = deploy_result(install_old(writer))?
    let description = install_fixture_bytes(32, 65)
    deploy_result(stage_activation(mut staged, 1, None, description, std.codec.of_bytes(), description))?
    deploy_result(install_bound_activation(mut writer, take staged, 1, description))?
    let rows = deploy_result(table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    if !typed_put(mut writer, rows, 7, 14) || !typed_put(mut writer, rows, 8, 15) { fail("could not write rows at versions 2 and 3") }
    let mut witness = deploy_result(bucket_law_client_with(sim, tasks, "s3.test", 2, true))?
    let deadline = std.object.deadline_after_ms(witness, BUCKET_LAW_OP_MS)
    let mut workspace = deploy_result(history_buffers(65536))?
    let too_small = install_fixture_bytes(16, 1)
    let refused_digest = stage_object_preparation(mut writer, d, c, tasks, too_small, 1)?
    let _ = deploy_result(history_fetch(mut witness, "head", mut workspace.witness, deadline))?
    let refused = Cutover(attempt: take too_small, digest: refused_digest, deadline: 0xffffffffffffffffu64)
    if let Error(FullNew(Resident(_))) = perform_bound_cutover(mut writer, refused, 1, description, std.codec.of_bytes(), prepared_release_witness, [66; 32], fn() -> bool { true }) {} else {
        fail("the new resident ceiling did not refuse the installation")
    }
    let _ = deploy_result(history_fetch(mut witness, "head", mut workspace.body, deadline))?
    if workspace.body != workspace.witness { fail("a pre-publication refusal changed HEAD") }
    deploy_result(healthy(writer))?

    let attempt = install_fixture_bytes(16, 2)
    let digest = stage_object_preparation(mut writer, d, c, tasks, attempt, 2097152)?
    let request = Cutover(attempt: take attempt, digest, deadline: 0xffffffffffffffffu64)
    let installed = perform_bound_cutover(mut writer, request, 1, description, std.codec.of_bytes(), prepared_release_witness, [66; 32], fn() -> bool { true })?
    if installed != 4 { fail("activation did not use the exported main version plus one") }
    deploy_result(close(take writer))?

    let read_grant = deploy_result(bucket_law_authority(sim, tasks, "s3.test", 3))?
    let mut process = followers()
    let plan = follower_law_plan(Bucket(bucket_law_lanes(0)), options)
    let service = deploy_result(follower_law_service(tasks, plan, 1))?
    let owner = deploy_result(follower_owner(service))?
    let slot = deploy_result(follower_slot(owner, plan))?
    let observer = deploy_result(follower(mut process, take slot, take read_grant, sim.time, options.expect))?
    let capture = deploy_result(follower_head(observer))?
    let visible = deploy_result(snapshot_follower(observer, Branch(store: capture.store, id: 0)))?
    let view_reader = deploy_result(follower_reader(observer, 0))?
    let mut schema = declare_follower(observer)
    let releases = deploy_result(declare_release_table(mut schema, std.codec.of_bytes()))?
    let mut declared_rows = deploy_result(declare_table(mut schema, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let _ = deploy_result(index(mut schema, mut declared_rows, "by_v", Many, code.describe(crash_value), std.codec.key_u64()))?
    let migrated = deploy_result(finish(mut schema, take declared_rows))?
    let mut other = deploy_result(declare_table(mut schema, "other", std.codec.key_u64(), std.codec.of_u64()))?
    let _ = deploy_result(index(mut schema, mut other, "empty", Many, code.describe(crash_value), std.codec.key_u64()))?
    let _ = deploy_result(finish(mut schema, take other))?
    let added = deploy_result(declare_table(mut schema, "added", std.codec.key_u64(), std.codec.of_u64()))?
    let _ = deploy_result(finish(mut schema, take added))?
    deploy_result(seal_follower(observer, take schema))?
    if capture.activation != 4 || capture.binding != install_fixture_bytes(32, 66) || version(visible) != 4 ||
        deploy_result(get(view_reader, visible, releases, 4))? != Some(release_witness(digest)) ||
        deploy_result(get(view_reader, visible, migrated, 7))? != Some(1014u64) {
        fail("the cold capture lost the atomic activation, binding, or PREPARED witness")
    }
    Ok(())
}


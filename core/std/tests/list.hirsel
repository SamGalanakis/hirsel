// test-env: HIRSEL_ISA_CAP=2
// Contract tests for `list` (core/std/list.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names. Lists are read back as numbers, one decimal digit per element.
/// [a, b, c, d, e] in capacity reserved first.
fn five(a: u64, b: u64, c: u64, d: u64, e: u64) -> List[u64] {
    let mut xs: List[u64] = list.with_capacity(5)
    list.push(mut xs, a)
    list.push(mut xs, b)
    list.push(mut xs, c)
    list.push(mut xs, d)
    list.push(mut xs, e)
    xs
}

/// The elements as the digits of one number, first element first: [3, 1, 2] is 312.
fn digits(xs: List[u64]) -> u64 {
    let mut v: u64 = 0
    for x in xs {
        v = v * 10 + x
    }
    v
}

// The nested lists have lengths 5, 4 and 2. Mapping keeps their order and
// reserves three slots even though an initially empty list would grow to four.
// expect: run helpers_map_nested_lists() = true
fn helpers_map_nested_lists() -> bool {
    let mut xs: List[List[u64]] = list.with_capacity(3)
    list.push(mut xs, five(1, 2, 3, 4, 5))
    let mut four = five(1, 2, 3, 4, 5)
    list.truncate(mut four, 4)
    list.push(mut xs, take four)
    let mut two = five(1, 2, 3, 4, 5)
    list.truncate(mut two, 2)
    list.push(mut xs, take two)
    let ys = list.map(xs, fn(row: List[u64]) -> u64 {
        list.len(row)
    })
    list.len(xs) == 3 && list.len(ys) == 3 && list.capacity(ys) == 3 && digits(ys) == 542
}

// Every owned String result reaches the output in input order.
// expect: run helpers_try_map_success() = true
fn helpers_try_map_success() -> bool {
    let mut xs: List[String] = list.new()
    list.push(mut xs, string.from("abc"))
    list.push(mut xs, string.from("de"))
    let ys = result.unwrap(list.try_map(xs, fn(s: String) -> Result[String, u64] {
        let mut t = string.from(s)
        string.push(mut t, "!")
        Ok(take t)
    }))
    list.len(ys) == 2 && list.capacity(ys) == 2 && ys[0] == "abc!" && ys[1] == "de!"
}

// Two elements could return errors. The first of those is 2, after visiting 1.
// expect: run helpers_try_map_first_error() = true
fn helpers_try_map_first_error() -> bool {
    let xs = five(1, 2, 3, 4, 5)
    let mut seen: u64 = 0
    let r = list.try_map(xs, scoped fn(x: u64) -> Result[String, String] {
        seen = seen * 10 + x
        let candidate: Result[u64, String] = if x == 2 {
            Error(string.from("first"))
        } else if x == 4 {
            Error(string.from("second"))
        } else {
            Ok(x)
        }
        let _ = candidate?
        Ok(string.from("mapped"))
    })
    match r {
        Ok(_) => false,
        Error(e) => e == "first" && seen == 12,
    }
}

// The callback fails with Fail if it runs. Capacity must come first.
// expect: run helpers_map_capacity_before_callback() = fail Capacity
fn helpers_map_capacity_before_callback() -> bool {
    let xs = five(1, 2, 3, 4, 5)
    result.unwrap(bound bytes 0 {
        let _ = list.map(xs, fn(x: u64) -> u64 {
            fail("list.map called before reserving")
        })
        false
    })
}

// expect: run helpers_try_map_capacity_before_callback() = fail Capacity
fn helpers_try_map_capacity_before_callback() -> bool {
    let xs = five(1, 2, 3, 4, 5)
    result.unwrap(bound bytes 0 {
        let _ = list.try_map(xs, fn(x: u64) -> Result[u64, u64] {
            fail("list.try_map called before reserving")
        })
        false
    })
}

// The empty input supplies no callback argument to any helper.
// expect: run helpers_empty() = true
fn helpers_empty() -> bool {
    let mut xs: List[u64] = list.new()
    let pred = scoped fn(x: u64) -> bool {
        fail("predicate called on an empty list")
    }
    list.retain(mut xs, pred)
    let ys = list.map(xs, fn(x: u64) -> u64 {
        fail("list.map called on an empty list")
    })
    let zs = result.unwrap(list.try_map(xs, fn(x: u64) -> Result[u64, u64] {
        fail("list.try_map called on an empty list")
    }))
    let empty_map = list.len(ys) == 0 && list.capacity(ys) == 0
    let empty_try_map = list.len(zs) == 0 && list.capacity(zs) == 0
    let absent = option.copied(list.find(xs, pred)) == None && list.position(xs, pred) == None
    list.len(xs) == 0 && empty_map && empty_try_map && absent && !list.any(xs, pred) && list.all(xs, pred)
}

// Each predicate visits strings of length 1, 2 and 3, then stops. find
// lends the third string. position yields the index used to remove it.
// expect: run helpers_predicate_order() = true
fn helpers_predicate_order() -> bool {
    let mut xs: List[String] = list.with_capacity(5)
    list.push(mut xs, string.from("a"))
    list.push(mut xs, string.from("bb"))
    list.push(mut xs, string.from("ccc"))
    list.push(mut xs, string.from("dddd"))
    list.push(mut xs, string.from("eeeee"))
    let mut seen: u64 = 0
    let matches_third = match list.find(xs, scoped fn(s: String) -> bool {
        let n = string.byte_len(s)
        seen = seen * 10 + n
        n >= 3
    }) {
        Some(s) => s == "ccc",
        None => false,
    }
    if !matches_third || seen != 123 {
        return false
    }
    seen = 0
    let index = option.unwrap(list.position(xs, scoped fn(s: String) -> bool {
        let n = string.byte_len(s)
        seen = seen * 10 + n
        n >= 3
    }))
    if index != 2 || seen != 123 {
        return false
    }
    seen = 0
    let any = list.any(xs, scoped fn(s: String) -> bool {
        let n = string.byte_len(s)
        seen = seen * 10 + n
        n >= 3
    })
    if !any || seen != 123 {
        return false
    }
    seen = 0
    let all = list.all(xs, scoped fn(s: String) -> bool {
        let n = string.byte_len(s)
        seen = seen * 10 + n
        n < 3
    })
    if all || seen != 123 || list.remove(mut xs, index) != "ccc" || list.len(xs) != 4 || xs[2] != "dddd" {
        return false
    }
    let too_large = scoped fn(s: String) -> bool {
        string.byte_len(s) > 5
    }
    let in_range = scoped fn(s: String) -> bool {
        string.byte_len(s) <= 5
    }
    let absent = match list.find(xs, too_large) {
        Some(_) => false,
        None => list.position(xs, too_large) == None,
    }
    absent && !list.any(xs, too_large) && list.all(xs, in_range)
}

// Reject odd-length strings and preserve the two distinct even-length ones.
// expect: run helpers_retain_in_place() = true
fn helpers_retain_in_place() -> bool {
    let mut xs: List[String] = list.with_capacity(5)
    list.push(mut xs, string.from("a"))
    list.push(mut xs, string.from("bc"))
    list.push(mut xs, string.from("def"))
    list.push(mut xs, string.from("ghij"))
    list.push(mut xs, string.from("klmno"))
    let mut seen: u64 = 0
    result.unwrap(bound bytes 0 {
        list.retain(mut xs, scoped fn(s: String) -> bool {
            let n = string.byte_len(s)
            seen = seen * 10 + n
            n % 2 == 0
        })
    })
    seen == 12345 && list.len(xs) == 2 && list.capacity(xs) == 5 && xs[0] == "bc" && xs[1] == "ghij"
}

resource type RetainAudit {
    xs: List[String]
} drop(audit) {
    let first_pair = list.contains(audit.xs, "a") && list.contains(audit.xs, "bb")
    let second_pair = list.contains(audit.xs, "ccc") && list.contains(audit.xs, "dddd")
    if list.len(audit.xs) != 4 || !first_pair || !second_pair {
        fail("list.retain lost or duplicated an element")
    }
}

// Reject a, move bb, then fail on ccc. The audit sees all four inputs when
// it unwinds. Any lost or duplicated string adds another failure cause.
// expect: run helpers_retain_failure() = true
fn helpers_retain_failure() -> bool {
    let r = result.unwrap(isolate(fn() {
        let mut xs: List[String] = list.with_capacity(4)
        list.push(mut xs, string.from("a"))
        list.push(mut xs, string.from("bb"))
        list.push(mut xs, string.from("ccc"))
        list.push(mut xs, string.from("dddd"))
        let mut audit = result.unwrap(RetainAudit(xs: take xs))
        list.retain(mut audit.xs, fn(s: String) -> bool {
            if s == "ccc" {
                let missing: Option[u64] = None
                let _ = option.unwrap(missing)
            }
            s == "bb"
        })
    }))
    let Error(take causes) = take r else {
        return false
    }
    let mut count: u64 = 0
    for cause in causes {
        match cause.kind {
            Unwrap => {
                count += 1
            },
            _ => return false,
        }
    }
    count == 1
}

resource type RetainDrop {
    id: u64
} drop(item) {
    if item.id == 1 {
        fail("removed item cleaned")
    }
}

// The first item is rejected and its finalizer fails. All three predicate
// calls must have happened before that failure. The log survives isolation.
// expect: run helpers_retain_delays_cleanup() = true
fn helpers_retain_delays_cleanup() -> bool {
    let seen: Log[u64] = log.new()
    let r = result.unwrap(isolate(scoped fn() {
        let mut xs: List[RetainDrop] = list.with_capacity(3)
        for id in 1u64 .. 4 {
            list.push(mut xs, result.unwrap(RetainDrop(id)))
        }
        list.retain(mut xs, scoped fn(item: RetainDrop) -> bool {
            log.append(seen, item.id)
            item.id != 1
        })
    }))
    let Error(take causes) = take r else {
        return false
    }
    let mut count: u64 = 0
    for cause in causes {
        match cause.kind {
            Fail(_) => {
                count += 1
            },
            _ => return false,
        }
    }
    let calls = log.finish(take seen)
    count == 1 && digits(calls) == 123
}

// One u64 entry in a fresh log: the node, 24 bytes, then four entries, 32 (MEM-24).
fn log_finished() -> u64 {
    let l: Log[u64] = log.new()
    log.append(l, 7)
    list.len(log.finish(take l))
}

fn log_dropped() -> u64 {
    let l: Log[u64] = log.new()
    log.append(l, 7)
    1
}

// At the logical 56-byte peak, all four visits fit. A new 56-byte buffer
// then fits in the same bound only if finishing and dropping return the room.
// expect: run log_charges_stay_within_the_logical_bound() = true
fn log_charges_stay_within_the_logical_bound() -> bool {
    let r = bound bytes 56 {
        let total = log_finished() + log_finished() + log_dropped() + log_dropped()
        let probe: Bytes = list.with_capacity(56)
        total == 4 && list.capacity(probe) == 56
    }
    match r {
        Ok(valid) => valid,
        Error(_) => false,
    }
}

fn log_inline_outcomes() -> u64 {
    let issued: Log[u64] = log.new()
    let aborted = isolate(fn() {
        log.append(issued, 1)
        fail("abort after issuing")
    })
    if let Ok(Ok(())) = take aborted {
        return 0
    }
    let stopped = bound steps 1000 {
        log.append(issued, 2)
        loop {}
    }
    if let Ok(()) = stopped {
        return 0
    }
    let entries = log.finish(take issued)
    let mut seen = 0u64
    for id in entries {
        seen = 10 * seen + id
    }
    seen
}

fn log_inline_fifth() -> (u64, u64, u64) {
    let issued: Log[u64] = log.new()
    log.append(issued, 1)
    log.append(issued, 2)
    log.append(issued, 3)
    log.append(issued, 4)
    let stopped = isolate(fn() {
        log.append(issued, 5)
    })
    let (requested, available) = match caught(take stopped) {
        Some(c) => (c.requested, c.available),
        None => (0u64, 0u64),
    }
    let entries = log.finish(take issued)
    let mut seen = 0u64
    for id in entries {
        seen = 10 * seen + id
    }
    (seen, requested, available)
}

// The fifth entry admits 64 while the 24-byte node, 32-byte entries and
// 32-byte isolate cell are live. On refusal the prefix stays in the log.
// expect: run log_inline_entries_survive_stops() = true
fn log_inline_entries_survive_stops() -> bool {
    let (denied, refunded) = result.unwrap(bound bytes 151 {
        let denied = log_inline_fifth()
        // The caught failure replaces the task's primary cell with the isolate's
        // 32-byte cell. A 112-byte reserve fits only if the entries were refunded.
        let mut check: Bytes = list.new()
        let refunded = match list.try_reserve(mut check, 112) {
            Ok(()) => true,
            Error(_) => false,
        }
        (denied, refunded)
    })
    let growth = result.unwrap(bound bytes 152 {
        (log_inline_fifth(), log_inline_fifth())
    })
    let admitted = (12345u64, 0u64, 0u64)
    log_inline_outcomes() == 12 && denied == (1234u64, 64u64, 63u64) && refunded && growth == (admitted, admitted)
}

fn fail_after_tail_write() {
    let mut key = bytebuf.with_tail(12)
    list.fill(mut key, 12, 7u8)
    let mut frame = bytebuf.from_tail(mut key, 126)
    list.fill(mut frame, 126, 19u8)
    fail("after writing the frame")
}

fn tail_write_under(limit: u64) -> Result[(bool, bool), Capacity] {
    bound bytes limit {
        let written = isolate(fail_after_tail_write)
        let failed_after_write = {
            if let Ok(Error(take causes)) = take written {
                let mut failed = false
                for cause in causes {
                    if let Fail(_) = cause.kind {
                        failed = true
                    }
                }
                failed
            } else {
                false
            }
        }
        let mut spare: Bytes = list.new()
        let refunded = match list.try_reserve(mut spare, 144) {
            Ok(()) => true,
            Error(_) => false,
        }
        (failed_after_write, refunded)
    }
}

fn tail_from_other_limit() -> Bytes {
    let mut key = bytebuf.with_tail(12)
    list.fill(mut key, 12, 7u8)
    let mut frame = result.unwrap(bound bytes 128 {
        bytebuf.from_tail(mut key, 126)
    })
    list.fill(mut frame, 126, 19u8)
    take frame
}

fn tail_refusal() -> Result[Result[Result[Bytes, Capacity], Causes], Capacity] {
    isolate(fn() {
        let mut key = bytebuf.with_tail(12)
        bound bytes 127 {
            bytebuf.from_tail(mut key, 126)
        }
    })
}

fn tail_with_other_backing() -> bool {
    let mut local: Bytes = list.new()
    list.push(mut local, 11u8)
    let mut ordinary = bytebuf.from_tail(mut local, 1)
    list.push(mut ordinary, 29u8)
    let mut grown = bytebuf.with_tail(12)
    list.fill(mut grown, 13, 5u8)
    let mut replacement = bytebuf.from_tail(mut grown, 126)
    list.fill(mut replacement, 126, 13u8)
    let mut key = bytebuf.with_tail(12)
    let mut oversized = bytebuf.from_tail(mut key, 161)
    list.fill(mut oversized, 161, 31u8)
    local[0] == 11 && ordinary[0] == 29 && grown[12] == 5 && replacement[125] == 13 && oversized[160] == 31
}

// The key and frame charge 16 and 128. After an isolated failure, only the
// replacement 32-byte cause cell is still charged to this 176-byte scope.
// expect: run byte_tail_charges_and_owners_are_independent() = true
fn byte_tail_charges_and_owners_are_independent() -> bool {
    let (failed, refunded) = result.unwrap(tail_write_under(176))
    let refusal = match caught(tail_refusal()) {
        Some(c) => c.requested == 128 && c.available == 127,
        None => false,
    }
    let live_frame = tail_from_other_limit()
    let mut key = bytebuf.with_tail(12)
    list.fill(mut key, 12, 7u8)
    let mut copied: Bytes = clone(key)
    let mut clone_frame = bytebuf.from_tail(mut copied, 126)
    list.fill(mut clone_frame, 126, 41u8)
    {
        let mut first = bytebuf.from_tail(mut key, 126)
        list.fill(mut first, 126, 23u8)
        let mut other = bytebuf.from_tail(mut key, 126)
        list.fill(mut other, 126, 37u8)
        if first[125] != 23 || other[125] != 37 || clone_frame[125] != 41 {
            return false
        }
    }
    failed && refunded && refusal && live_frame[125] == 19 && key[11] == 7 && copied[11] == 7 && clone_frame[125] == 41 && tail_with_other_backing()
}

// An initial capacity of 22 charges 24 bytes. Reserving 22 more after one
// push doubles it to 44, charging 48 before refunding the original 24.
fn hinted_buffer_under(limit: u64) -> Result[bool, Capacity] {
    bound bytes limit {
        let mut b: Bytes = list.new()
        let initial = bytebuf.try_reserve_hint(mut b, 22, 44)
        if let Error(_) = initial {
            return Ok(false)
        }
        let before = list.capacity(b)
        list.push(mut b, 71u8)
        let grown = list.try_reserve(mut b, 22)
        if limit == 71 {
            match grown {
                Error(c) => before == 22 && c.requested == 48 && c.available == 47 && list.capacity(b) == 22 && b[0] == 71,
                _ => false,
            }
        } else {
            match grown {
                Ok(()) => {
                    let spare: Bytes = list.with_capacity(24)
                    before == 22 && list.capacity(b) == 44 && list.capacity(spare) == 24 && b[0] == 71
                },
                _ => false,
            }
        }
    }
}

// Growing in a different limit must refund the original payer and leave the
// replacement charged as it crosses back out of its paying scope.
fn hinted_buffer_changes_payer() -> bool {
    let charged = bound bytes 72 {
        let mut b: Bytes = list.new()
        result.unwrap(bytebuf.try_reserve_hint(mut b, 22, 44))
        list.push(mut b, 73u8)
        let grown = bound bytes 48 {
            list.try_reserve(mut b, 22)
        }
        match grown {
            Ok(Ok(())) => {
                let spare: Bytes = list.with_capacity(24)
                list.capacity(b) == 44 && b[0] == 73 && list.capacity(spare) == 24
            },
            _ => false,
        }
    }
    match charged {
        Ok(ok) => ok,
        _ => false,
    }
}

// expect: run reserve_hint_charges_are_exact() = true
fn reserve_hint_charges_are_exact() -> bool {
    let attempts = isolate(fn() -> Result[bool, Capacity] {
        bound bytes 72 {
            let charges = match (hinted_buffer_under(71), hinted_buffer_under(72), hinted_buffer_changes_payer()) {
                (Ok(true), Ok(true), true) => true,
                _ => false,
            }
            charges
        }
    })
    match attempts {
        Ok(Ok(Ok(true))) => true,
        _ => false,
    }
}

type StringFrameRow {
    owner: String
}

fn string_frame_reads(row: StringFrameRow) -> bool {
    list.capacity(string.as_bytes(row.owner)) == 8 && row.owner == "owner000"
}

fn string_frame_copy() -> bool {
    let row = StringFrameRow(owner: string.from("owner000"))
    string_frame_reads(row)
}

// Both copies fit in succession at the logical eight-byte peak. Each
// drop restores room for the next copy.
// expect: run string_frame_copies_fit_the_logical_bound() = true
fn string_frame_copies_fit_the_logical_bound() -> bool {
    let copied = bound bytes 8 {
        string_frame_copy() && string_frame_copy()
    }
    match copied {
        Ok(valid) => valid,
        Error(_) => false,
    }
}

fn present(o: Option[View[u64]]) -> u64 {
    match o {
        Some(v) => v,
        None => 99,
    }
}

// expect: run first_of_five() = 7
fn first_of_five() -> u64 {
    let xs = five(7, 1, 2, 3, 4)
    present(list.first(xs))
}

// expect: run first_of_empty() = 99
fn first_of_empty() -> u64 {
    present(list.first((list.new() : List[u64])))
}

// expect: run last_of_five() = 4
fn last_of_five() -> u64 {
    let xs = five(7, 1, 2, 3, 4)
    present(list.last(xs))
}

// expect: run last_of_empty() = 99
fn last_of_empty() -> u64 {
    present(list.last((list.new() : List[u64])))
}

// Removes 6 and keeps the order of the rest: 6, then 5789.
// expect: run remove_keeps_order() = 65789
fn remove_keeps_order() -> u64 {
    let mut xs = five(5, 6, 7, 8, 9)
    let r = list.remove(mut xs, 1)
    r * 10000 + digits(xs)
}

// expect: run remove_last() = 95678
fn remove_last() -> u64 {
    let mut xs = five(5, 6, 7, 8, 9)
    let r = list.remove(mut xs, 4)
    r * 10000 + digits(xs)
}

// expect: run remove_past_end() = fail Bounds
fn remove_past_end() -> u64 {
    let mut xs = five(5, 6, 7, 8, 9)
    list.remove(mut xs, 5)
}

// expect: run insert_middle() = 129345
fn insert_middle() -> u64 {

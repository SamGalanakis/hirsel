// Charge parity (MEM-24, CAP-5) of served ports. These laws live outside core
// because a call inside core takes no step of its own (MEM-30): from here each
// host operation is one step, as in any program. The granted host Dir and
// the granted network are the oracles: the same client against one and
// against a provide.dir or provide.net must stop at the same admission and
// the same step, whatever the bound.
fn answer(mut s: Served[DirOp], take c: Call[DirOp], r: DirReply) -> bool {
    match provide.reply(mut s, take c, provide.dir_reply(r)) {
        Ok(_) => true,
        _ => false
    }
}

type Attempt: send {
    d: Dir,
    steps: u64
}

// Create "p", write "hello", close; reopen it, read into 8 bytes, close.
// The value counts each step that worked and the bytes read back; a step
// bound that runs out gives 1000000 and the bound.
fn parity_client(take a: Attempt) -> u64 waits {
    let Attempt(d, steps: limit) = take a
    let run = bound steps limit {
        let made: u64 = match host.open(d, "p", CreateNew) {
            Ok(take f) => {
                let mut file = take f
                let wrote: u64 = match host.write(mut file, string.as_bytes("hello")) {
                    Ok(_) => 1,
                    Error(_) => 0
                }
                let closed: u64 = match host.close(take file) {
                    Ok(_) => 10,
                    Error(_) => 0
                }
                wrote + closed
            },
            Error(_) => 0
        }
        let mut b: Bytes = list.with_capacity(8)
        let got: u64 = match host.open(d, "p", Read) {
            Ok(take f) => {
                let mut file = take f
                let read: u64 = match host.read(mut file, mut b) {
                    Ok(n) => n * 100,
                    Error(_) => 0
                }
                let closed: u64 = match host.close(take file) {
                    Ok(_) => 10000,
                    Error(_) => 0
                }
                read + closed
            },
            Error(_) => 0
        }
        let same = list.len(b) == 5 && b[0] == 0x68 && b[4] == 0x6f
        made + got + if same {
            100000u64
        } else {
            0u64
        }
    }
    match run {
        Ok(v) => v,
        Error(o) => 1000000 + o.steps
    }
}

// A file store behind a port: Open issues a fresh id, Write appends the
// payload, Read fills what was written, Remove empties it; it serves until
// quiescence and counts the calls it answered.
fn store(take s: Served[DirOp]) -> u64 waits {
    let mut served = take s
    let mut data: Bytes = list.with_capacity(64)
    let mut id: u64 = 5
    let mut calls: u64 = 0
    let mut going = true
    while going {
        match provide.next(mut served) {
            Some(take call) => {
                let mut c = take call
                let reply: Option[DirReply] = match provide.dir_op(c) {
                    Open(dir, path, mode) => {
                        id = id + 1
                        Some(File(id))
                    },
                    Write(file, len) => {
                        provide.payload(c, 1, mut data)
                        Some(Done)
                    },
                    Read(file, room) => Some(Count(provide.fill(mut served, mut c, data))),
                    Remove(dir, path) => {
                        list.clear(mut data)
                        Some(Done)
                    },
                    ZeroExtension(..) => Some(ZeroExtensionSupported(false)),
                    Released(id: _) => None,
                    _ => Some(Done)
                }
                match reply {
                    Some(r) => {
                        if answer(mut served, take c, r) {
                            calls = calls + 1
                        }
                    },
                    None => {
                        let _ = take c
                    }
                }
            },
            None => {
                going = false
            }
        }
    }
    calls
}

// The client in a task of `b` bytes under a bound of `n` steps: its value,
// or the requested and available bytes of the admission that stopped it.
fn attempt(tasks: Tasks, d: Dir, b: u64, n: u64) -> (u64, u64, u64) waits {
    let _ = host.remove(d, "p")
    let child = task.spawn(tasks, bytes b, Attempt(d: d, steps: n), parity_client)
    match task.join(take child) {
        Ok(v) => (v, 0, 0),
        Error(Failed(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => (1, k.requested, k.available),
                    _ => (2, 0, 0),
                }
            }
            (3, 0, 0)
        },
        Error(_) => (4, 0, 0)
    }
}

// The client in a task of `b` bytes under a step bound of `n`, against the
// granted Dir and against the served one, for every `b` up to 160 and every
// `n` up to 24: each pair agrees on the value, or on the requested and
// available bytes of the admission that stopped it. Both sweeps cross over:
// no bytes refuses (value 1), no steps runs out (1000000 and the bound), and
// the whole client gives 110511 (wrote 1, closed 10, read 5 x 100, closed
// 10000, the bytes back 100000).
// expect: run dir_parity(dir, tasks) = true
fn dir_parity(dir: Dir, tasks: Tasks) -> bool waits {
    let (v, s) = provide.dir(bytes 4096)
    let server = task.spawn(tasks, bytes 65536, take s, store)
    let mut same = true
    let mut refused = false
    let mut whole = false
    let mut b: u64 = 0
    while b <= 160 {
        let host = attempt(tasks, dir, b, 1000)
        same = same && host == attempt(tasks, v, b, 1000)
        let (value, _, _) = host
        refused = refused || value == 1
        whole = whole || value == 110511
        b = b + 1
    }
    let mut short = false
    let mut n: u64 = 0
    while n <= 24 {
        let host = attempt(tasks, dir, 65536, n)
        same = same && host == attempt(tasks, v, 65536, n)
        let (value, _, _) = host
        short = short || value == 1000000 + n
        n = n + 1
    }
    let served = result.unwrap(task.join(take server)) > 0
    same && refused && whole && short && served
}

fn net_answer(mut s: Served[NetOp], take c: Call[NetOp], r: NetReply) -> bool {
    match provide.reply(mut s, take c, provide.net_reply(r)) {
        Ok(_) => true,
        _ => false
    }
}

type Dial: send {
    n: Net,
    steps: u64
}

// Listen on 127.0.0.1, connect to the bound address, accept, send "hello"
// from the dialed socket and receive at most 8 bytes on the accepted one.
// A send or receive may move part of the bytes (TCP; the model network
// does), so the value counts each step that worked and whether the bytes
// received begin "hello"'s; a step bound that runs out gives 1000000 and
// the bound.
fn dial_client(take d: Dial) -> u64 waits {
    let Dial(n, steps: limit) = take d
    let run = bound steps limit {
        match host.listen(n, Addr(ip: V4(2130706433), port: 0), 1) {
            Ok(take pair) => {
                let (take listener, at) = take pair
                let mut l = take listener
                let rest: u64 = match host.connect(n, at, Never) {
                    Ok(take dialed) => match net.accept_from(mut l, result.unwrap(net.local_addr(dialed)), Never) {
                        Ok(take far) => {
                            let (dr, dw) = net.split(take dialed)
                            let (ar, aw) = net.split(take far)
                            let mut w = take dw
                            let mut r = take ar
                            let sent: u64 = match host.send_pair(mut w, string.as_bytes("hello"), string.as_bytes(""), Never) {
                                Ok(k) => if k > 0 {
                                    1000u64
                                } else {
                                    0u64
                                },
                                Error(_) => 0
                            }
                            let mut b: Bytes = list.with_capacity(8)
                            let got: u64 = match host.recv_bounded(mut r, mut b, 8, Never) {
                                Ok(k) => if k > 0 {
                                    10000u64
                                } else {
                                    0u64
                                },
                                Error(_) => 0
                            }
                            let same = list.len(b) >= 1 && list.len(b) <= 5 && b[0] == 0x68
                            let _ = take dr
                            let _ = take w
                            let _ = take r
                            let _ = take aw
                            110 + sent + got + if same {
                                100000u64
                            } else {
                                0u64
                            }
                        },
                        Error(_) => {
                            let _ = take dialed
                            10
                        }
                    },
                    Error(_) => 0
                }
                let _ = take l
                1 + rest
            },
            Error(_) => 0
        }
    }
    match run {
        Ok(v) => v,
        Error(o) => 1000000 + o.steps
    }
}

// Listen binds port 4000 and Connect and Accept issue fresh sockets.
// Send keeps the latest payload for Recv. The server counts answered calls.
fn loopback(take s: Served[NetOp]) -> u64 waits {
    let mut served = take s
    let mut data: Bytes = list.with_capacity(64)
    let mut id: u64 = 4
    let mut calls: u64 = 0
    let mut going = true
    while going {
        match provide.next(mut served) {
            Some(take call) => {
                let mut c = take call
                let op = provide.net_op(c)
                let here = Addr(ip: V4(2130706433), port: 4000)
                let reply: Option[NetReply] = match op {
                    Listen(addr, backlog) => {
                        id = id + 4
                        Some(Listener(id, here))
                    },
                    Connect(addr, _) => {
                        id = id + 4
                        Some(Socket(id, here))
                    },
                    Accept(listener) => {
                        id = id + 4
                        Some(Socket(id, Addr(ip: V4(2130706433), port: 5000)))
                    },
                    LocalAddr(_) => Some(Address(Addr(ip: V4(2130706433), port: 5000))),
                    PeerAddr(_) => Some(Address(Addr(ip: V4(2130706433), port: 5000))),
                    Send(socket, prefix, tail) => {
                        list.clear(mut data)
                        provide.payload(c, 1, mut data)
                        provide.payload(c, 2, mut data)
                        Some(Count(prefix + tail))
                    },
                    Recv(socket, room, max) => {
                        let took = provide.fill(mut served, mut c, data)
                        list.clear(mut data)
                        Some(Count(took))
                    },
                    Released(id: _, part: _) => None,
                    _ => Some(Failed(Denied))
                }
                match reply {
                    Some(r) => {
                        if net_answer(mut served, take c, r) {
                            calls = calls + 1
                        }
                    },
                    None => {
                        let _ = take c
                    }
                }
            },
            None => {
                going = false
            }
        }
    }
    calls
}

// The dial client in a task of `b` bytes under a bound of `n` steps: its
// value, or the requested and available bytes of the admission that stopped
// it.
fn dial(tasks: Tasks, n: Net, b: u64, steps: u64) -> (u64, u64, u64) waits {
    let child = task.spawn(tasks, bytes b, Dial(n: n, steps: steps), dial_client)
    match task.join(take child) {
        Ok(v) => (v, 0, 0),
        Error(Failed(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => (1, k.requested, k.available),
                    _ => (2, 0, 0),
                }
            }
            (3, 0, 0)
        },
        Error(_) => (4, 0, 0)
    }
}

// MEM-24 for Net: the dial client against the granted network and against a
// served loopback, for every task size up to 320 bytes and every step bound
// up to 24, agrees on the value or on the admission that stopped it. Both
// sweeps cross over: no bytes refuses (value 1), no steps runs out (1000000
// and the bound), and the whole client gives 111111 (listened 1, connected
// 10, accepted 100, sent 1000, received 10000, the bytes back 100000).
// expect: run net_parity(network) = true
fn net_parity(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (v, s) = provide.net(bytes 4096)
    let server = task.spawn(tasks, bytes 65536, take s, loopback)
    let mut same = true
    let mut refused = false
    let mut whole = false
    let mut b: u64 = 0
    while b <= 320 {
        let host = dial(tasks, n, b, 1000)
        same = same && host == dial(tasks, v, b, 1000)
        let (value, _, _) = host
        refused = refused || value == 1
        whole = whole || value == 111111
        b = b + 1
    }
    let mut short = false
    let mut k: u64 = 0
    while k <= 24 {
        let host = dial(tasks, n, 65536, k)
        same = same && host == dial(tasks, v, 65536, k)
        let (value, _, _) = host
        short = short || value == 1000000 + k
        k = k + 1
    }
    let served = result.unwrap(task.join(take server)) > 0
    same && refused && whole && short && served
}

type SimMount: send {
    fs: sim.fs.Fs,
    port: Served[DirOp],
    clock: Clock
}

fn serve_sim(take mount: SimMount) -> sim.fs.Fs waits {
    let SimMount(fs: take image, port: take port, clock) = take mount
    let mut fs = take image
    let mut plan = sim.world.plan(0)
    sim.fs.serve(mut fs, mut plan, clock, take port)
    take fs
}

fn write_rename(d: Dir, barrier: bool) -> Result[(), IoError] waits {
    let mut f = host.open(d, "temp", CreateNew)?
    match host.write(mut f, string.as_bytes("new")) {
        Ok(()) => (),
        Error(e) => return Error(e.error)
    }
    host.sync(mut f)?
    host.close(take f)?
    host.sync_dir(d)?
    host.rename(d, "temp", "snap")?
    if barrier {
        host.sync_dir(d)?
    }
    Ok(())
}

fn recovered_file(d: Dir, name: String, absent: String) -> Result[bool, IoError] waits {
    let missing = match host.stat(d, absent) {
        Error(NotFound) => true,
        _ => false
    }
    let mut f = host.open(d, name, Read)?
    let mut b: Bytes = list.with_capacity(8)
    let read = host.read(mut f, mut b)?
    host.close(take f)?
    Ok(missing && read == 3 && b[0] == b'n' && b[1] == b'e' && b[2] == b'w')
}

fn rename_survival(tasks: Tasks, c: Clock, barrier: bool, seed: u64, any_cut: bool) -> bool waits {
    let (dir, s) = provide.dir(bytes 4096)
    let first = task.spawn(tasks, bytes 65536, SimMount(fs: sim.fs.new(), port: take s, clock: c), serve_sim)
    result.unwrap(write_rename(dir, barrier))
    let mut fs = result.unwrap(task.join(take first))
    // SplitMix64(seed 1)'s first word is 0x910a2dec89025cc1. Multiplying by
    // four gives high word 2, so crash cuts the prefix before rename (op 3).
    let mut plan = sim.world.plan(seed)
    sim.fs.crash(mut fs, mut plan)
    let (recovered, sr) = provide.dir(bytes 4096)
    let second = task.spawn(tasks, bytes 65536, SimMount(fs: take fs, port: take sr, clock: c), serve_sim)
    let after_rename = barrier || (any_cut && match host.stat(recovered, "snap") {
        Ok(_) => true,
        Error(_) => false,
    })
    let recovered_bytes = if after_rename {
        recovered_file(recovered, "snap", "temp")
    } else {
        recovered_file(recovered, "temp", "snap")
    }
    let _ = result.unwrap(task.join(take second))
    result.unwrap(recovered_bytes)
}

// After a file sync, a crash can roll back its rename until the directory
// sync. Both outcomes must keep the exact file bytes.
// expect: run sim_rename_durability(tasks) = true
fn sim_rename_durability(tasks: Tasks) -> bool waits {
    sim_rename_durability_case(tasks, 1, false)
}

fn sim_rename_durability_seeded(tasks: Tasks, seed: u64) -> bool waits {
    sim_rename_durability_case(tasks, seed, true)
}

fn sim_rename_durability_case(tasks: Tasks, seed: u64, any_cut: bool) -> bool waits {
    let (w, c) = sim.world.new(seed, 0, 0)
    let driver = task.spawn(tasks, bytes 65536, take w, drive_sim_clock)
    host.sleep_until(c, 123)
    result.unwrap(task.join(take driver))
    host.mono_ns(c) == 123 && rename_survival(tasks, c, false, seed, any_cut) && rename_survival(tasks, c, true, seed, any_cut)
}

fn drive_sim_clock(take w: sim.world.World) waits {
    let mut world = take w
    sim.world.run(mut world)
}

// For n = 3 the first two words are below 2^64/3, the third is above
// it, and the largest word maps to 2. Rejecting zero would shift the prefix.
// expect: run sim_script_monotone_pick() = true
fn sim_script_monotone_pick() -> bool {
    sim_script_monotone_pick_seeded(0)
}

fn sim_script_monotone_pick_seeded(seed: u64) -> bool {
    let mut words: List[u64] = list.new()
    list.push(mut words, 0)
    list.push(mut words, 0x5555555555555555)
    list.push(mut words, 0x5555555555555556)
    list.push(mut words, 0xffffffffffffffff)
    let mut streams: List[List[u64]] = list.new()
    list.push(mut streams, take words)
    let s = sim.world.Script(tail_seed: 0, streams: take streams)
    let mut plan = sim.world.plan_from(s, 0)
    let expected: Inline[u64, 4] =[0, 0, 1, 2]
    for index in expected {
        if sim.world.pick(mut plan, 3) != index {
            return false
        }
    }
    let mut stream: List[u64] = list.new()
    let word = int.wrapping_mul(seed, 0x9e3779b97f4a7c15)
    list.push(mut stream, word)
    let mut draws: List[List[u64]] = list.new()
    list.push(mut draws, take stream)
    let mut generated = sim.world.plan_from(sim.world.Script(tail_seed: seed, streams: take draws), 0)
    sim.world.pick(mut generated, 8) == (word >> 61)
}

type ScriptServer: send {
    plan: sim.world.Plan,
    clock: Clock,
    start: u64
}

fn serve_script(take server: ScriptServer) -> (u64, u64, u64) waits {
    let ScriptServer(plan: take input, clock: time, start) = take server
    let mut plan = take input
    host.sleep_until(time, start)
    let prefix = sim.world.pick(mut plan, 8)
    let tail = sim.world.pick(mut plan, 8)
    (host.mono_ns(time), prefix, tail)
}

fn script_servers(tasks: Tasks, s: sim.world.Script, a: u64, b: u64) -> ((u64, u64, u64), (u64, u64, u64)) waits {
    let (world, time) = sim.world.new(0, 0, 0)
    let first = task.spawn(tasks, bytes 65536, ScriptServer(plan: sim.world.plan_from(s, 0), clock: time, start: a), serve_script)
    let second = task.spawn(tasks, bytes 65536, ScriptServer(plan: sim.world.plan_from(s, 1), clock: time, start: b), serve_script)
    let driver = task.spawn(tasks, bytes 65536, take world, drive_sim_clock)
    let first_draws = result.unwrap(task.join(take first))
    let second_draws = result.unwrap(task.join(take second))
    result.unwrap(task.join(take driver))
    (first_draws, second_draws)
}

// The prefixes 2^61 and 2^63 map to 1 and 4. For tail seed zero the
// first tail words are 0xe220a8397b1dcdaf and 0xbfef8030ddc2d772.
// expect: run sim_script_provider_isolation(tasks) = true
fn sim_script_provider_isolation(tasks: Tasks) -> bool waits {
    let mut first: List[u64] = list.new()
    list.push(mut first, 0x2000000000000000)
    let mut second: List[u64] = list.new()
    list.push(mut second, 0x8000000000000000)
    let mut streams: List[List[u64]] = list.new()
    list.push(mut streams, take first)
    list.push(mut streams, take second)
    let s = sim.world.Script(tail_seed: 0, streams: take streams)
    script_servers(tasks, s, 1, 2) == ((1, 1, 7), (2, 4, 5)) && script_servers(tasks, s, 2, 1) == ((2, 1, 7), (1, 4, 5))
}

fn sim_script_provider_isolation_seeded(tasks: Tasks, seed: u64) -> bool waits {
    let mut first: List[u64] = list.new()
    let a = int.wrapping_mul(seed, 0x9e3779b97f4a7c15)
    list.push(mut first, a)
    let mut second: List[u64] = list.new()
    let b = a ^ 0xffffffffffffffff
    list.push(mut second, b)
    let mut streams: List[List[u64]] = list.new()
    list.push(mut streams, take first)
    list.push(mut streams, take second)
    let s = sim.world.Script(tail_seed: seed, streams: take streams)
    let ((t0, p0, tail0), (t1, p1, tail1)) = script_servers(tasks, s, 1, 2)
    let reversed = script_servers(tasks, s, 2, 1)
    t0 == 1 && t1 == 2 && p0 == (a >> 61) && p1 == (b >> 61) && reversed == ((2, p0, tail0), (1, p1, tail1))
}

type SimLink: send {
    clock: Clock,
    port: Served[NetOp],
    seed: u64,
}

fn serve_sim_link(take server: SimLink) waits {
    let SimLink(clock: time, port: take port, seed) = take server
    let config = sim.net.Config(queue_bytes: 2, fragment_bytes: 1, latency_ns: 10)
    let mut plan = sim.world.plan(seed)
    let _ = sim.net.serve(sim.net.new(config), mut plan, time, take port)
}

type LateRead: send {
    input: ReadHalf,
    c: Clock,
    cancel: bool
}

fn timed_read(take lag: LateRead) -> (bool, ReadHalf) waits {
    let LateRead(input: take input, c, cancel) = take lag
    let mut r = take input
    let mut data: Bytes = list.with_capacity(2)
    let zero = result.unwrap(host.recv_bounded(mut r, mut data, 0, Never))
    let until: Until = if cancel {
        Never
    } else {
        At(c, 5)
    }
    let withdrawn = match host.recv_bounded(mut r, mut data, 2, until) {
        Error(TimedOut) => !cancel && host.mono_ns(c) == 5,
        Error(Aborted) => cancel && host.mono_ns(c) == 1,
        _ => false
    }
    (zero == 0 && withdrawn && list.len(data) == 0, take r)
}

// The read is taken before time advances to 1. Its deadline passes at 5,
// while the byte is in flight until 11. The next read must get that byte.
// expect: run sim_withdrawn_read_keeps_byte(tasks) = true
fn sim_withdrawn_read_keeps_byte(tasks: Tasks) -> bool waits {
    sim_withdrawn_read_keeps_byte_seeded(tasks, 1)
}

fn sim_withdrawn_read_keeps_byte_seeded(tasks: Tasks, seed: u64) -> bool waits {
    sim_read_withdrawal(tasks, false, seed)
}

// CONC-7. Cancellation after issue reports Aborted and leaves the half
// usable by its next owner. The byte sent afterward is read exactly once.
// expect: run sim_cancelled_read_keeps_byte(tasks) = true
fn sim_cancelled_read_keeps_byte(tasks: Tasks) -> bool waits {
    sim_cancelled_read_keeps_byte_seeded(tasks, 1)
}

fn sim_cancelled_read_keeps_byte_seeded(tasks: Tasks, seed: u64) -> bool waits {
    sim_read_withdrawal(tasks, true, seed)
}

fn sim_read_withdrawal(tasks: Tasks, cancel: bool, seed: u64) -> bool waits {
    let (world, c) = sim.world.new(seed, 0, 0)
    let (network, port) = provide.net(bytes 4096)
    let driver = task.spawn(tasks, bytes 65536, take world, drive_sim_clock)
    let server = task.spawn(tasks, bytes 65536, SimLink(clock: c, port: take port, seed), serve_sim_link)
    let (listener, address) = result.unwrap(host.listen(network, Addr(ip: V4(2130706433), port: 0), 1))
    let mut l = take listener
    let client = result.unwrap(host.connect(network, address, Never))
    let peer = result.unwrap(net.local_addr(client))
    let accepted = result.unwrap(net.accept_from(mut l, peer, Never))
    let peer_is_local = match peer.ip {
        V4(2130706433) => true,
        _ => false
    }
    let (client_read, writer) = net.split(take client)
    let (reader, unused_writer) = net.split(take accepted)
    let _ = take client_read
    let _ = take unused_writer
    let mut read = task.spawn(tasks, bytes 65536, LateRead(input: take reader, c: c, cancel: cancel), timed_read)
    host.sleep_until(c, 1)
    if cancel {
        task.cancel(mut read)
    }
    let mut w = take writer
    let sent = result.unwrap(host.send_pair(mut w, string.as_bytes("x"), string.as_bytes(""), Never))
    let (withdrawn, returned) = result.unwrap(task.join(take read))
    let _ = take w
    let mut r = take returned
    let mut data: Bytes = list.with_capacity(2)
    let received = result.unwrap(host.recv_bounded(mut r, mut data, 2, At(c, 20)))
    let eof = result.unwrap(host.recv_bounded(mut r, mut data, 2, At(c, 20)))
    let _ = take r
    let _ = take l
    result.unwrap(task.join(take server))
    result.unwrap(task.join(take driver))
    peer_is_local && peer.port != 0 && address.port != 0 && withdrawn && sent == 1 && received == 1 && eof == 0 && host.mono_ns(c) == 11 && list.len(data) == 1 && data[0] == b'x'
}

type WaitForStop: send {
    p: Process,
    c: Clock
}

fn at_stop(take watch: WaitForStop) -> u64 waits {
    let WaitForStop(p, c) = take watch
    host.stopped(p)
    host.mono_ns(c)
}

// The stop is delivered at virtual time 42, after the 21 timer. Each stream
// keeps the exact bytes it received, with its own order and no cross-talk.
// expect: run sim_captured_stop(tasks) = true
fn sim_captured_stop(tasks: Tasks) -> bool waits {
    sim_captured_stop_seeded(tasks, 0)
}

fn sim_captured_stop_seeded(tasks: Tasks, seed: u64) -> bool waits {
    let (world, c) = sim.world.new(seed, 0, 0)
    let offset = seed % 128
    let (p, trigger) = provide.process()
    let wake = sim.io.stop_at(tasks, c, 42 + offset, take trigger)
    let watch = task.spawn(tasks, bytes 0, WaitForStop(p: p, c: c), at_stop)
    let driver = task.spawn(tasks, bytes 65536, take world, drive_sim_clock)
    let (out, output) = sim.io.capture(bytes 128, false)
    let (err, errors) = sim.io.capture_stderr(bytes 128, true)
    let terminals = !stdout.is_terminal(out) && stderr.is_terminal(err)
    let out_task = task.spawn(tasks, bytes 65536, take output, sim.io.collect)
    let err_task = task.spawn(tasks, bytes 65536, take errors, sim.io.collect)
    result.unwrap(stdout.write(out, "alpha\n"))
    host.sleep_until(c, 21 + offset)
    let before = host.mono_ns(c)
    result.unwrap(stderr.write(err, "error"))
    result.unwrap(stdout.write(out, "β"))
    let stopped = result.unwrap(task.join(take watch))
    result.unwrap(task.join(take wake))
    host.stopped(p)
    let a = result.unwrap(task.join(take out_task))
    let b = result.unwrap(task.join(take err_task))
    result.unwrap(task.join(take driver))
    terminals && before == 21 + offset && stopped == 42 + offset && list.len(a) == 8 && list.len(b) == 5 && list.starts_with(a, string.as_bytes("alpha\nβ")) && list.starts_with(b, string.as_bytes("error"))
}

type UnixAttempt: send {
    net: Net,
    steps: u64
}

fn unix_client(take input: UnixAttempt) -> u64 waits {
    let UnixAttempt(net: n, steps: steps) = take input
    let run = bound steps steps {
        let mut rx = result.unwrap(host.bind_datagram(n, "parity", "packet"))
        let mut tx = result.unwrap(host.open_datagram(n))
        result.unwrap(host.send_to(mut tx, "parity", "packet", string.as_bytes("abc"), Never))
        let mut buf: Bytes = list.with_capacity(2)
        let Received(len: len, truncated: truncated) = result.unwrap(host.recv_datagram(mut rx, mut buf, Never))
        if len == 3 && truncated && list.len(buf) == 2 && buf[0] == b'a' && buf[1] == b'b' {
            1u64
        } else {
            0u64
        }
    }
    match run {
        Ok(value) => value,
        Error(out) => 1000 + out.steps
    }
}

fn unix_attempt(tasks: Tasks, n: Net, b: u64, steps: u64) -> (u64, u64, u64) waits {
    let child = task.spawn(tasks, bytes b, UnixAttempt(net: n, steps: steps), unix_client)
    match task.join(take child) {
        Ok(value) => (value, 0, 0),
        Error(Failed(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => (2, k.requested, k.available),
                    _ => (3, 0, 0)
                }
            }
            (4, 0, 0)
        },
        Error(_) => (5, 0, 0)
    }
}

fn unix_loopback(take input: Served[NetOp]) -> u64 waits {
    let mut port = take input
    let mut queued: Bytes = list.with_capacity(3)
    let mut id: u64 = 40
    let mut packets: u64 = 0
    let mut going = true
    while going {
        match provide.next(mut port) {
            Some(take call) => {
                let mut c = take call
                match provide.net_op(c) {
                    OpenDatagram => {
                        id += 1
                        let _ = net_answer(mut port, take c, Datagram(id))
                    },
                    BindDatagram(root: root, path: path) => {
                        id += 1
                        let mut label: Bytes = list.with_capacity(root)
                        let mut endpoint: Bytes = list.with_capacity(path)
                        provide.payload(c, 0, mut label)
                        provide.payload(c, 1, mut endpoint)
                        let reply: NetReply = if label == string.as_bytes("parity") && endpoint == string.as_bytes("packet") {
                            Datagram(id)
                        } else {
                            Failed(Denied)
                        }
                        let _ = net_answer(mut port, take c, reply)
                    },
                    SendTo(datagram: _, root: root, path: path, len: len) => {
                        let mut label: Bytes = list.with_capacity(root)
                        let mut endpoint: Bytes = list.with_capacity(path)
                        let mut packet: Bytes = list.with_capacity(len)
                        provide.payload(c, 1, mut label)
                        provide.payload(c, 2, mut endpoint)
                        provide.payload(c, 3, mut packet)
                        let reply: NetReply = if label == string.as_bytes("parity") && endpoint == string.as_bytes("packet") {
                            Done
                        } else {
                            Failed(Denied)
                        }
                        if net_answer(mut port, take c, reply) {
                            queued = take packet
                        }
                    },
                    RecvDatagram(datagram: _, room: room) => {
                        let len = list.len(queued)
                        let staged = provide.fill(mut port, mut c, queued)
                        if net_answer(mut port, take c, Packet(len: len, truncated: len > room)) {
                            packets += staged
                            list.clear(mut queued)
                        }
                    },
                    Released(id: _, part: _) => {
                        let _ = take c
                    },
                    _ => {
                        let _ = net_answer(mut port, take c, Failed(Denied))
                    }
                }
            },
            None => {
                going = false
            }
        }
    }
    packets
}

fn unix_parity_attempt(n: Net, v: Net, dir: Dir, tasks: Tasks, b: u64, steps: u64) -> (bool, u64) waits {
    let native = unix_attempt(tasks, n, b, steps)
    match host.stat(dir, "packet") {
        Ok(_) => result.unwrap(host.remove(dir, "packet")),
        Error(NotFound) => (),
        Error(e) => {
            fail("socket node stat")
        }
    }
    let clean = match host.stat(dir, "packet") {
        Error(NotFound) => true,
        _ => false
    }
    let (value, _, _) = native
    (clean && native == unix_attempt(tasks, v, b, steps), value)
}

// The same fixed client crosses the eight-byte buffer admission and a
// step bound on the real Unix Net and the served Net.
// expect: run unix_parity(unix, dir, tasks) = true
fn unix_parity(n: Net, dir: Dir, tasks: Tasks) -> bool waits {
    let (v, serve) = provide.net(bytes 4096)
    let server = task.spawn(tasks, bytes 65536, take serve, unix_loopback)
    let mut parity = true
    let mut refused = false
    let mut finished = false
    let mut short = false
    let mut b: u64 = 0
    while b <= 16 {
        let (same, value) = unix_parity_attempt(n, v, dir, tasks, b, 64)
        parity = parity && same
        refused = refused || value == 2
        finished = finished || value == 1
        b += 1
    }
    let mut steps: u64 = 0
    while steps <= 16 {
        let (same, value) = unix_parity_attempt(n, v, dir, tasks, 64, steps)
        parity = parity && same
        short = short || value == 1000 + steps
        steps += 1
    }
    let packets = result.unwrap(task.join(take server))
    parity && refused && finished && short && packets > 0
}

type UnixReplyCase: send {
    port: Served[NetOp],
    mode: u64
}

fn unix_reply_server(take input: UnixReplyCase) -> bool waits {
    let UnixReplyCase(port: take p, mode: mode) = take input
    let mut port = take p
    match provide.next(mut port) {
        Some(take call) => {
            if mode == 4 {
                return net_answer(mut port, take call, Failed(BoundNotListening(22)))
            }
            if !net_answer(mut port, take call, Datagram(1)) {
                return false
            }
        },
        None => {
            return false
        }
    }
    match provide.next(mut port) {
        Some(take call) => {
            let mut c = take call
            let staged = if mode == 1 {
                string.as_bytes("a")
            } else {
                string.as_bytes("ab")
            }
            let _ = provide.fill(mut port, mut c, staged)
            let reply: NetReply = if mode == 2 {
                Failed(Other(42))
            } else if mode == 3 {
                Failed(BoundNotListening(22))
            } else {
                Packet(len: 3, truncated: mode == 1)
            }
            net_answer(mut port, take c, reply)
        },
        None => false
    }
}

// Room is two. A length-three packet must stage exactly two bytes and
// report truncation. An ordinary error discards the staged bytes, and
// BoundNotListening is valid only for ListenUnix.
// expect: run unix_reply_validation(tasks) = true
fn unix_reply_validation(tasks: Tasks) -> bool waits {
    let mut mode: u64 = 0
    let mut valid = true
    while mode < 5 {
        let (n, port) = provide.net(bytes 4096)
        let server = task.spawn(tasks, bytes 4096, UnixReplyCase(port: take port, mode: mode), unix_reply_server)
        let caller = if mode == 4 {
            let only = result.unwrap(net.narrow(n, one_rule(Unix(dir: UnixListen, root: "root", path: "sock"))))
            let denied = match host.listen_unix(only, "root", "other", 1) {
                Error(Denied) => true,
                _ => false
            }
            denied && match host.listen_unix(only, "root", "sock", 1) {
                Error(BoundNotListening(22)) => true,
                _ => false
            }
        } else {
            let mut d = result.unwrap(host.bind_datagram(n, "root", "sock"))
            let mut buf: Bytes = list.with_capacity(2)
            let result = host.recv_datagram(mut d, mut buf, Never)
            let error_matches = match result {
                Error(Other(42)) => mode == 2,
                Error(Reset) => mode != 2,
                _ => false
            }
            list.len(buf) == 0 && error_matches
        }
        let settled = match task.join(take server) {
            Ok(ok) => (mode == 2 || mode == 4) && ok,
            Error(Failed(causes)) => {
                let mut fail_seen = false
                for c in causes {
                    match c.kind {
                        Fail(_) => {
                            fail_seen = true
                        },
                        _ => ()
                    }
                }
                (mode == 0 || mode == 1 || mode == 3) && fail_seen
            },
            _ => false
        }
        valid = valid && caller && settled
        mode += 1
    }
    valid
}

type ExecAttempt: send {
    grant: Exec,
    steps: u64
}

fn exec_launch(stdin: Stdio, stdout: Stdio, stderr: Stdio) -> Launch {
    Launch(program: "parity", args: list.new(), env: list.new(), dir: "work", path: "", stdin: stdin, stdout: stdout, stderr: stderr)
}

fn exec_client(take request: ExecAttempt) -> u64 waits {
    let ExecAttempt(grant, steps) = take request
    let run = bound steps steps {
        match exec.spawn(grant, exec_launch(Piped, Piped, Piped)) {
            Ok(take started) => {
                let Spawned(take process, take input, take output, take errors) = take started
                let _ = option.unwrap(take input)
                let _ = option.unwrap(take output)
                let _ = option.unwrap(take errors)
                let mut child = take process
                match exec.wait(mut child, Never) {
                    Ok(Exited(0)) => 1u64,
                    _ => 3u64
                }
            },
            Error(Other(0)) => 4u64,
            Error(_) => 5u64
        }
    }
    match run {
        Ok(v) => v,
        Error(o) => 1000 + o.steps
    }
}

fn exec_attempt(tasks: Tasks, grant: Exec, bytes n: u64, steps: u64) -> (u64, u64, u64) waits {
    let child = task.spawn(tasks, bytes n, ExecAttempt(grant: grant, steps: steps), exec_client)
    match task.join(take child) {
        Ok(v) => (v, 0, 0),
        Error(Failed(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => (0, k.requested, k.available),
                    _ => (6, 0, 0)
                }
            }
            (7, 0, 0)
        },
        Error(_) => (8, 0, 0)
    }
}

fn exec_answer(mut s: Served[ExecOp], take c: Call[ExecOp], reply: ExecReply) -> Result[(), Withdrawn] {
    provide.reply(mut s, take c, provide.exec_reply(reply))
}

fn exec_parity_server(take s: Served[ExecOp]) -> u64 waits {
    let mut port = take s
    let mut next: u64 = 1
    let mut releases: u64 = 0
    loop {
        match provide.next(mut port) {
            None => return releases,
            Some(take call) => {
                let response: ExecReply = match provide.exec_op(call) {
                    Spawn(stdin: Piped, stdout: Piped, stderr: Piped, program: _, args: _, env: _, dir: _, path: _) => {
                        let first = next
                        next += 4
                        Started(proc: first, stdin: first + 1, stdout: first + 2, stderr: first + 3)
                    },
                    Await(proc: _) => Ended(Exited(0)),
                    Released(id: _, part: _) => {
                        releases += 1
                        Done
                    },
                    _ => Failed(Denied)
                }
                let _ = exec_answer(mut port, take call, response)
            }
        }
    }
}

// The host fixture exits 0. Each mechanical result block is eight bytes,
// so the empty launch with three pipes crosses its admission at 32 bytes.
// expect: run exec_parity(exec, tasks) = true
fn exec_parity(host: Exec, tasks: Tasks) -> bool waits {
    let (served, port) = provide.exec(bytes 128)
    let server = task.spawn(tasks, bytes 4096, take port, exec_parity_server)
    let mut ok = true
    let mut n: u64 = 0
    while n <= 33 {
        let expected = if n < 32 {
            (0u64, 32u64, n)
        } else {
            (1u64, 0u64, 0u64)
        }
        ok = ok && exec_attempt(tasks, host, bytes n, 64) == expected
        ok = ok && exec_attempt(tasks, served, bytes n, 64) == expected
        n += 1
    }
    let mut steps: u64 = 0
    let mut short = false
    while steps <= 16 {
        let native = exec_attempt(tasks, host, bytes 32, steps)
        ok = ok && native == exec_attempt(tasks, served, bytes 32, steps)
        short = short || native == (1000 + steps, 0u64, 0u64)
        steps += 1
    }
    let released = result.unwrap(task.join(take server))
    ok && short && released >= 8
}

// Started reserves four 32-byte records in one admission.
// expect: run exec_started_short(tasks) = true
fn exec_started_short(tasks: Tasks) -> bool waits {
    let (e, port) = provide.exec(bytes 127)
    let server = task.spawn(tasks, bytes 4096, take port, exec_parity_server)
    let caller = exec_attempt(tasks, e, bytes 32, 64)
    let shortage = match task.join(take server) {
        Error(Failed(causes)) => {
            for c in causes {
                match c.kind {
                    Capacity(k) => return caller == (4u64, 0u64, 0u64) && k.requested == 128 && k.available == 127,
                    _ => ()
                }
            }
            false
        },
        _ => false
    }
    shortage
}

fn bad_exec_reply(tag: u64) -> ExecReply {
    if tag == 0 {
        Done
    } else if tag == 1 {
        Failed(Other(42))
    } else if tag == 2 {
        IoFailed(Other(42))
    } else if tag == 3 {
        Count(0)
    } else if tag == 4 {
        Started(proc: 11, stdin: 12, stdout: 13, stderr: 14)
    } else {
        Ended(Exited(0))
    }
}

type ExecReplyTest: send {
    port: Served[ExecOp],
    op: u64,
    reply: ExecReply
}

fn exec_bad_server(take test: ExecReplyTest) -> bool waits {
    let ExecReplyTest(port: take p, op, reply) = take test
    let mut port = take p
    let first = option.unwrap(provide.next(mut port))
    if op == 0 {
        result.unwrap(exec_answer(mut port, take first, reply))
        return false
    }
    result.unwrap(exec_answer(mut port, take first, Started(proc: 1, stdin: 2, stdout: 3, stderr: 4)))
    let mut call = option.unwrap(provide.next(mut port))
    if op == 3 {
        let payload = string.as_bytes("a")
        let _ = provide.fill(mut port, mut call, payload)
    }
    result.unwrap(exec_answer(mut port, take call, reply))
    true
}

fn exec_bad_caller(e: Exec, op: u64, io_error: bool) -> bool waits {
    let start = exec.spawn(e, exec_launch(Piped, Piped, Piped))
    if op == 0 {
        return match take start {
            Error(Other(0)) => true,
            _ => false
        }
    }
    let Spawned(take process, take input, take output, take _errors) = result.unwrap(take start)
    let mut proc = take process
    if op == 1 {
        return match exec.wait(mut proc, Never) {
            Error(Other(0)) => true,
            _ => false
        }
    }
    if op == 2 {
        return match exec.signal(mut proc, SigTerm) {
            Error(Other(0)) => true,
            _ => false
        }
    }
    if op == 3 {
        let mut pipe = option.unwrap(take output)
        let mut b: Bytes = list.with_capacity(2)
        list.push(mut b, 0x7au8)
        let received = host.recv_bounded(mut pipe, mut b, 1, Never)
        return list.len(b) == 1 && b[0] == 0x7a && match received {
            Error(Reset) => !io_error,
            Error(Other(42)) => io_error,
            _ => false
        }
    }
    let mut pipe = option.unwrap(take input)
    match host.send_pair(mut pipe, string.as_bytes("a"), string.as_bytes("b"), Never) {
        Error(Reset) => true,
        _ => false
    }
}

fn exec_reject_reply(tasks: Tasks, op: u64, reply: ExecReply, io_error: bool) -> bool waits {
    let (e, port) = provide.exec(bytes 256)
    let server = task.spawn(tasks, bytes 4096, ExecReplyTest(port: take port, op: op, reply: reply), exec_bad_server)
    let unchanged = exec_bad_caller(e, op, io_error)
    let rejected = match task.join(take server) {
        Ok(ok) => io_error && ok,
        Error(Failed(causes)) => {
            for c in causes {
                match c.kind {
                    Fail(_) => return unchanged && !io_error,
                    _ => ()
                }
            }
            false
        },
        _ => false
    }
    unchanged && rejected
}

// All invalid reply pairs, malformed Started ids and counts, and a legal
// error reply with staged data. The caller observes closure or the error,
// with the existing byte unchanged in every read.
// expect: run exec_reply_matrix(tasks) = true
fn exec_reply_matrix(tasks: Tasks) -> bool waits {
    let mut op: u64 = 0
    while op < 5 {
        let mut tag: u64 = 0
        while tag < 6 {
            let valid = if op == 0 {
                tag == 1 || tag == 4
            } else if op == 1 {
                tag == 1 || tag == 5
            } else if op == 2 {
                tag == 0 || tag == 1
            } else {
                tag == 2 || tag == 3
            }
            if !valid && !exec_reject_reply(tasks, op, bad_exec_reply(tag), false) {
                return false
            }
            tag += 1
        }
        op += 1
    }
    exec_reject_reply(tasks, 0, Started(proc: 1, stdin: 2, stdout: 2, stderr: 4), false) && exec_reject_reply(tasks, 0, Started(proc: 0, stdin: 2, stdout: 3, stderr: 4), false) && exec_reject_reply(tasks, 0, Started(proc: 1, stdin: 2, stdout: 3, stderr: 0), false) && exec_reject_reply(tasks, 3, Count(0), false) && exec_reject_reply(tasks, 4, Count(3), false) && exec_reject_reply(tasks, 3, IoFailed(Other(42)), true)
}

fn exec_start_client(take e: Exec) -> bool waits {
    match exec.spawn(e, exec_launch(Piped, Piped, Piped)) {
        Error(Aborted) => true,
        _ => false
    }
}

// A withdrawn Started publishes no ids. Reuse the same four ids immediately;
// the next waiter succeeds and a cached wait and signal queue no calls.
// expect: run exec_spawn_withdrawal(tasks) = true
fn exec_spawn_withdrawal(tasks: Tasks) -> bool waits {
    let (e, s) = provide.exec(bytes 128)
    let mut port = take s
    let mut first = task.spawn(tasks, bytes 32, e, exec_start_client)
    let withdrawn_call = option.unwrap(provide.next(mut port))
    task.cancel(mut first)
    let withdrawal = match exec_answer(mut port, take withdrawn_call, Started(proc: 1, stdin: 2, stdout: 3, stderr: 4)) {
        Error(Withdrawn()) => true,
        _ => false
    }
    let aborted = result.unwrap(task.join(take first))
    let second = task.spawn(tasks, bytes 32, e, exec_cached_client)
    let spawn_call = option.unwrap(provide.next(mut port))
    result.unwrap(exec_answer(mut port, take spawn_call, Started(proc: 1, stdin: 2, stdout: 3, stderr: 4)))
    let wait_call = option.unwrap(provide.next(mut port))
    result.unwrap(exec_answer(mut port, take wait_call, Ended(Signalled(15))))
    let cached = result.unwrap(task.join(take second))
    let mut parts: u64 = 0
    let mut going = true
    while going {
        match provide.next(mut port) {
            Some(take call) => {
                parts += match provide.exec_op(call) {
                    Released(id: 1, part: Whole) => 1,
                    Released(id: 2, part: Write) => 2,
                    Released(id: 3, part: Read) => 4,
                    Released(id: 4, part: Read) => 8,
                    _ => 16
                }
                let _ = take call
            },
            None => {
                going = false
            }
        }
    }
    withdrawal && aborted && cached && parts == 15
}

fn exec_cached_client(take e: Exec) -> bool waits {
    let Spawned(take process, take _input, take _output, take _errors) = result.unwrap(exec.spawn(e, exec_launch(Piped, Piped, Piped)))
    let mut child = take process
    let first = match exec.wait(mut child, Never) {
        Ok(Signalled(15)) => true,
        _ => false
    }
    let cached = match exec.wait(mut child, Never) {
        Ok(Signalled(15)) => true,
        _ => false
    }
    let signal = match exec.signal(mut child, SigKill) {
        Ok(()) => true,
        _ => false
    }
    first && cached && signal
}

fn exec_narrow_client(take input: (Exec, u64)) -> bool {
    let (e, room) = take input
    let mut form: List[ArgToken] = list.with_capacity(1)
    list.push(mut form, Lit(exec_bytes("status")))
    let rule = Form(program: "git", form: take form)
    let attempted = bound bytes room {
        match exec.narrow(e, rule) {
            Ok(_) => true,
            _ => false
        }
    }
    result.unwrap(attempted)
}

// 32 base, 11 profile, 22 form, 16 for universal keys and labels, and
// 8 remainder. Rounded to eight, the result costs exactly 96 bytes.
// expect: run exec_narrow_charge(tasks) = true
fn exec_narrow_charge(tasks: Tasks) -> bool waits {
    let (e, port) = provide.exec(bytes 0)
    let _ = take port
    let short = task.spawn(tasks, bytes 512, (e, 95u64), exec_narrow_client)
    match task.join(take short) {
        Error(Failed(causes)) => {
            for c in causes {
                match c.kind {
                    Capacity(k) => {
                        if k.requested != 96 || k.available != 95 {
                            return false
                        }
                        let exact = task.spawn(tasks, bytes 512, (e, 96u64), exec_narrow_client)
                        return result.unwrap(task.join(take exact))
                    },
                    _ => ()
                }
            }
            false
        },
        _ => false
    }
}

type ExecDeadline: send {
    grant: Exec,
    time: Clock
}

fn exec_deadline_client(take input: ExecDeadline) -> bool waits {
    let ExecDeadline(grant: e, time) = take input
    let Spawned(take process, _, take read_half, _) = result.unwrap(exec.spawn(e, exec_launch(Discard, Piped, Discard)))
    let mut proc = take process
    let mut output = option.unwrap(take read_half)
    let mut buf: Bytes = list.with_capacity(4)
    list.push(mut buf, b'z')
    let read_result = host.recv_bounded(mut output, mut buf, 1, At(time, 1))
    let timed_wait = exec.wait(mut proc, At(time, 2))
    list.len(buf) == 1 && buf[0] == b'z' && match read_result {
        Error(TimedOut) => true,
        _ => false
    } && match timed_wait {
        Error(TimedOut) => true,
        _ => false
    }
}

// The server takes and stages a live read. After advancing the virtual clock,
// both the read and the later wait withdraw. Neither late reply can commit.
// expect: run exec_deadline_withdrawal(tasks) = true
fn exec_deadline_withdrawal(tasks: Tasks) -> bool waits {
    let (e, s) = provide.exec(bytes 65)
    let (time, clock_hand) = provide.clock(0, 0)
    let mut hand = take clock_hand
    let mut port = take s
    let caller = task.spawn(tasks, bytes 64, ExecDeadline(grant: e, time: time), exec_deadline_client)
    let call = option.unwrap(provide.next(mut port))
    result.unwrap(exec_answer(mut port, take call, Started(proc: 1, stdin: 0, stdout: 2, stderr: 0)))
    let mut read = option.unwrap(provide.next(mut port))
    let offer = match provide.exec_op(read) {
        Recv(pipe: 2, room: 3, max: 1) => true,
        _ => false
    }
    let staged = provide.fill(mut port, mut read, string.as_bytes("xy"))
    clock.advance_to(mut hand, 1)
    let wait = option.unwrap(provide.next(mut port))
    let awaits = match provide.exec_op(wait) {
        Await(proc: 1) => true,
        _ => false
    }
    clock.advance_to(mut hand, 2)
    let caller_ok = result.unwrap(task.join(take caller))
    let read_withdrew = match exec_answer(mut port, take read, Count(1)) {
        Error(Withdrawn()) => true,
        _ => false
    }
    let wait_withdrew = match exec_answer(mut port, take wait, Ended(Exited(0))) {
        Error(Withdrawn()) => true,
        _ => false
    }
    offer && staged == 1 && awaits && caller_ok && read_withdrew && wait_withdrew
}

fn exec_bytes(text: String) -> Bytes {
    let src = string.as_bytes(text)
    let mut data: Bytes = list.with_capacity(list.len(src))
    list.append(mut data, src)
    data
}

fn exec_payload_client(take e: Exec) -> bool waits {
    let mut args: List[Bytes] = list.with_capacity(1)
    list.push(mut args, exec_bytes("ab"))
    let mut env: List[(String, Bytes)] = list.with_capacity(2)
    list.push(mut env, ("Z", exec_bytes("last")))
    list.push(mut env, ("A", exec_bytes("first")))
    let launch = Launch(program: "parity", args: take args, env: take env, dir: "work", path: "sub", stdin: Discard, stdout: Discard, stderr: Piped)
    match exec.spawn(e, launch) {
        Error(Other(99)) => true,
        _ => false
    }
}

fn exec_wire_field(wire: Bytes, at: u64, expected: Bytes) -> bool {
    let n = list.len(expected)
    if wire[at] != int.truncate(n) || wire[at + 1] != 0 || wire[at + 2] != 0 || wire[at + 3] != 0 {
        return false
    }
    let mut i: u64 = 0
    while i < n {
        if wire[at + 4 + i] != expected[i] {
            return false
        }
        i += 1
    }
    true
}

// The wire lengths include each four-byte prefix, and env arrives in bytewise
// key order even though the caller supplied Z before A. Failed issues no ids.
// expect: run exec_spawn_payloads(tasks) = true
fn exec_spawn_payloads(tasks: Tasks) -> bool waits {
    let (e, s) = provide.exec(bytes 0)
    let mut port = take s
    let caller = task.spawn(tasks, bytes 512, e, exec_payload_client)
    let call = option.unwrap(provide.next(mut port))
    let fields = match provide.exec_op(call) {
        Spawn(program: 6, args: 6, env: 27, dir: 4, path: 3, stdin: Discard, stdout: Discard, stderr: Piped) => true,
        _ => false
    }
    let mut program: Bytes = list.with_capacity(6)
    let mut args: Bytes = list.with_capacity(6)
    let mut env: Bytes = list.with_capacity(27)
    let mut dir: Bytes = list.with_capacity(4)
    let mut path: Bytes = list.with_capacity(3)
    provide.payload(call, 0, mut program)
    provide.payload(call, 1, mut args)
    provide.payload(call, 2, mut env)
    provide.payload(call, 3, mut dir)
    provide.payload(call, 4, mut path)
    result.unwrap(exec_answer(mut port, take call, Failed(Other(99))))
    let failed = result.unwrap(task.join(take caller))
    let empty = match provide.next(mut port) {
        None => true,
        Some(take next) => {
            let _ = take next;
            false
        }
    }
    fields && failed && empty && program == string.as_bytes("parity") && dir == string.as_bytes("work") && path == string.as_bytes("sub") && list.len(args) == 6 && exec_wire_field(args, 0, string.as_bytes("ab")) && list.len(env) == 27 && exec_wire_field(env, 0, string.as_bytes("A")) && exec_wire_field(env, 5, string.as_bytes("first")) && exec_wire_field(env, 14, string.as_bytes("Z")) && exec_wire_field(env, 19, string.as_bytes("last"))
}

fn one_rule(take r: Rule) -> List[Rule] {
    let mut rules: List[Rule] = list.new()
    list.push(mut rules, take r)
    take rules
}

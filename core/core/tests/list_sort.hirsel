fn compare(a: u64, b: u64) -> Order {
    if a < b {
        Less
    } else if a > b {
        Greater
    } else {
        Equal
    }
}

fn five(a: u64, b: u64, c: u64, d: u64, e: u64) -> List[u64] {
    let mut xs: List[u64] = list.with_capacity(5)
    list.push(mut xs, a)
    list.push(mut xs, b)
    list.push(mut xs, c)
    list.push(mut xs, d)
    list.push(mut xs, e)
    xs
}

/// The elements as the digits of one number, first element first: [3, 1, 2] is 312.
fn digits(xs: List[u64]) -> u64 {
    let mut v: u64 = 0
    for x in xs {
        v = v * 10 + x
    }
    v
}

// Original equal-key groups: 2 -> [21,22,23], 1 -> [11,12].
// Taking the right run on Equal changes [11,12,21,22,23].
// expect: run stable_equal_keys() = true
fn stable_equal_keys() -> bool {
    let mut xs = five(21, 11, 22, 12, 23)
    list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        compare(a / 10, b / 10)
    })
    xs[0] == 11 && xs[1] == 12 && xs[2] == 21 && xs[3] == 22 && xs[4] == 23
}

// expect: run stable_empty_singleton() = 7
fn stable_empty_singleton() -> u64 {
    let mut xs: List[u64] = list.new()
    list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        compare(a / 10, b / 10)
    })
    list.push(mut xs, 7)
    list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        compare(a / 10, b / 10)
    })
    digits(xs)
}

// Owned elements remain a permutation and ties keep their original order.
// expect: run stable_owned_strings() = true
fn stable_owned_strings() -> bool {
    let mut xs: List[String] = list.new()
    list.push(mut xs, string.from("bb"))
    list.push(mut xs, string.from("a"))
    list.push(mut xs, string.from("cc"))
    list.sort_stable(mut xs, fn(a: String, b: String) -> Order {
        compare(list.len(string.as_bytes(a)), list.len(string.as_bytes(b)))
    })
    xs[0] == "a" && xs[1] == "bb" && xs[2] == "cc"
}

// Each encoded value carries its input index. Sizes 0..17 cover odd trailing
// runs. Key, order and bitmask together describe the expected permutation.
// expect: run model_all_small_sizes() = true
fn model_all_small_sizes() -> bool {
    for n in 0u64 .. 18 {
        let mut xs: List[u64] = list.new()
        let mut expected_mask: u64 = 0
        for i in 0u64 .. n {
            list.push(mut xs, ((i * 7 + 3) % 5) * 100 + i)
            expected_mask |= 1u64 << i
        }
        let cap = list.capacity(xs)
        list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
            compare(a / 100, b / 100)
        })
        if list.len(xs) != n || list.capacity(xs) != cap {
            return false
        }
        let mut mask: u64 = 0
        for i in 0u64 .. n {
            let id = xs[i] % 100
            if id >= n || xs[i] / 100 != (id * 7 + 3) % 5 {
                return false
            }
            let bit = 1u64 << id
            if (mask & bit) != 0 {
                return false
            }
            mask |= bit
            if i > 0 && (xs[i - 1] / 100 > xs[i] / 100 || (xs[i - 1] / 100 == xs[i] / 100 && xs[i - 1] % 100 > id)) {
                return false
            }
        }
        if mask != expected_mask {
            return false
        }
    }
    true
}

// An inconsistent comparator need not sort, but cannot lose or duplicate owners.
// expect: run bad_comparator_permutation() = true
fn bad_comparator_permutation() -> bool {
    let mut xs = five(3, 1, 4, 0, 2)
    list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        Less
    })
    let mut mask: u64 = 0
    for x in xs {
        if x >= 5 {
            return false
        }
        mask |= 1u64 << x
    }
    mask == 31 && list.len(xs) == 5
}

// Returning from the slot kernel must restore ordinary mutable List behavior,
// including reused tail slots and a later allocation move.
// expect: run ordinary_list_after_sort() = 597
fn ordinary_list_after_sort() -> u64 {
    let mut xs = five(5, 4, 3, 2, 1)
    list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        compare(a, b)
    })
    let a = option.unwrap(list.pop(mut xs))
    list.push(mut xs, 9)
    let b = option.unwrap(list.pop(mut xs))
    list.reserve(mut xs, 10)
    list.clear(mut xs)
    list.push(mut xs, 7)
    a * 100 + b * 10 + option.unwrap(list.pop(mut xs))
}

// Sorting zero-sized entries retains the list shape and calls the comparator.
// expect: run zero_size_sort() = true
fn zero_size_sort() -> bool {
    let mut xs: List[()] = list.new()
    for _ in 0u64 .. 5 {
        list.push(mut xs, ())
    }
    let cap = list.capacity(xs)
    let mut compared = false
    list.sort_stable(mut xs, fn(a: (), b: ()) -> Order {
        compared = true;
        Equal
    })
    list.len(xs) == 5 && list.capacity(xs) == cap && compared
}

// Stable insertion sort using ordinary swaps, independent of run detection and merging.
fn reference(mut xs: List[u64], stride: u64) {
    for i in 1u64 .. list.len(xs) {
        let mut j = i
        while j > 0 && xs[j - 1] / stride > xs[j] / stride {
            list.swap(mut xs, j - 1, j)
            j -= 1
        }
    }
}

// A non-strict descending check reverses equal keys; a wrong merge order
// loses or reorders entries in repeated ascending/descending runs.
// expect: run stable_generated_runs() = true
fn stable_generated_runs() -> bool {
    let sizes: Inline[u64, 7] =[0, 1, 5, 15, 16, 31, 65]
    for n in sizes {
        for shape in 0u64 .. 4u64 {
            let mut xs: List[u64] = list.new()
            let mut expected: List[u64] = list.new()
            for i in 0u64 .. n {
                let key = if shape == 0 {
                    i / 2
                } else if shape == 1 {
                    (n - i) / 2
                } else if shape == 2 {
                    (i / 9 + 1) * (8 - i % 9)
                } else {
                    (i * 17 + 3) % 13
                }
                let entry = key * 128 + i
                list.push(mut xs, entry)
                list.push(mut expected, entry)
            }
            if n > 1 {
                reference(mut expected, 128)
            }
            list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
                compare(a / 128, b / 128)
            })
            if xs != expected {
                return false
            }
        }
    }
    true
}

// Compare stability on longer mixed, ascending and descending runs.
// expect: run stable_large_inputs() = true
fn stable_large_inputs() -> bool {
    let n: u64 = 257
    let mut rng: u64 = 966490
    for shape in 0u64 .. 3 {
        let mut xs: List[u64] = list.with_capacity(n)
        let mut expected: List[u64] = list.with_capacity(n)
        for i in 0u64 .. n {
            rng = int.wrapping_add(int.wrapping_mul(rng, 1664525), 1013904223)
            let key = if shape == 0 {
                (rng >> 16) % 13
            } else if shape == 1 {
                (i % 129) / 2
            } else {
                (256 - i) % 129 / 2
            }
            let entry = key * 512 + i
            list.push(mut xs, entry)
            list.push(mut expected, entry)
        }
        reference(mut expected, 512)
        list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
            compare(a / 512, b / 512)
        })
        if xs != expected || list.capacity(xs) != n {
            return false
        }
    }
    true
}

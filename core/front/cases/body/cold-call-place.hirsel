// FORM #111: a call in the true arm of a full test is cold, and passes a `mut` carrier
// as its words. The words go back on both edges: after bump's push replaces the
// list's block, the caller reads the new len, and a failure's cleanup frees the new
// block, not the one push already freed.
// expect: accept
// expect: run grown(0) = 5
// expect: run grown(2) = fail Bounds
fn bump(mut xs: List[u64], i: u64) -> u64 {
    list.push(mut xs, 9)
    let a =[1u64, 2u64];
    a[i]
}

fn grown(i: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 1)
    list.push(mut xs, 2)
    list.push(mut xs, 3)
    list.push(mut xs, 4)
    if list.len(xs) == list.capacity(xs) {
        bump(mut xs, i);
    }
    list.len(xs)
}

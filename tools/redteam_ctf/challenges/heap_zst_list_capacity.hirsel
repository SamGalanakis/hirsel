// ctf: class heap-exhaustion
// ctf: about A list of zero-sized values has no storage, so its capacity is a bare
// ctf: about number: 2^64 - 1 here, under a byte bound of nothing. The module pushes,
// ctf: about reserves, clones and pops it, then asks for one more than can exist. MEM-24:
// ctf: about zero bytes are charged, and the impossible reserve is a typed Capacity with
// ctf: about the list unchanged; no length or capacity may wrap.
// ctf: expect returned:zst-capacity-held
fn reserve_room[T](mut xs: List[T], n: u64) {
    list.reserve(mut xs, n)
}

fn unit_list[T]() -> List[T] {
    list.with_capacity(18446744073709551615u64)
}

fn cycle() -> bool {
    let outcome = bound bytes 0 {
        let mut xs: List[()] = unit_list()
        list.push(mut xs, ())
        reserve_room(mut xs, 18446744073709551614u64)
        let mut ys: List[()] = clone(xs)
        let popped = match list.pop(mut ys) {
            Some(()) => true,
            None => false
        }
        list.push(mut ys, ())
        list.clear(mut ys)
        let overflow = match list.try_reserve(mut xs, 18446744073709551615u64) {
            Ok(()) => false,
            Error(c) => c.requested == 18446744073709551615u64 && c.available == 0
        }
        popped && overflow && list.len(xs) == 1 && list.len(ys) == 0 && list.capacity(xs) == 18446744073709551615u64 && list.capacity(ys) == 18446744073709551615u64
    }
    match outcome {
        Ok(ok) => ok,
        Error(_) => false
    }
}

pub fn attack(seed: u64) -> Bytes {
    if cycle() { b"zst-capacity-held" } else { b"zst-capacity-wrapped" }
}

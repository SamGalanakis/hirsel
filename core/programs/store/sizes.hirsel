pub type Kind: send = Memory | Directory | Bucket(std.object.LaneConfig)

pub type Options: send {
    create: bool,
    lock_wait_ms: u64,
    group_commits: u32,
    group_bytes: u32,
    checkpoint_bytes: u64,
    journal_limit: u64,
    pack_bytes: u64,
    resident_limit: u64,
    cache_bytes: u64,
    writer_pin_bytes: u64,
    dirty_bytes: u64,
    pager_task_bytes: u64,
    authority: StorageKind,
    expect: Option[StoreId],
    activation: Option[u64],
    binding: Option[Bytes],
    claim_ms: u64,
    head_poll_ms: u64,
    checkpoint_entries: u64,
    retain: u8
}

pub type Overrides: send {
    resident_limit: Option[u64],
    journal_limit: Option[u64],
    checkpoint_bytes: Option[u64],
    pack_bytes: Option[u64],
    group_bytes: Option[u64],
    group_commits: Option[u32],
    lock_wait_ms: Option[u64],
    cache_bytes: Option[u64],
    writer_pin_bytes: Option[u64],
    dirty_bytes: Option[u64],
    pager_task_bytes: Option[u64],
    readers: Option[u64],
}

pub type Shortage: send { need: u64, have: u64, parts: List[(String, u64)] }

const MIB: u64 = 1048576
const CUT_FIXED_BYTES: u64 = 65536
// MEM-24 charges 288 bytes per task plus its logical result size.
// The timer returns (), and Result[(), Error] costs 64 bytes.
const OBJECT_TIMER_TASK_BYTES: u64 = 288
const OBJECT_JOURNAL_TASK_BYTES: u64 = 352

pub fn derived_sizes() -> Overrides {
    Overrides(resident_limit: None, journal_limit: None,
        checkpoint_bytes: None, pack_bytes: None, group_bytes: None, group_commits: None, lock_wait_ms: None,
        cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None)
}

pub fn sized(kind: Kind, share: u64) -> Result[Options, Shortage] {
    sized_with(kind, share, derived_sizes())
}

fn size_or(overridden: Option[u64], derived: u64) -> u64 {
    match overridden { Some(n) => n, None => derived }
}

fn add_size(mut parts: List[(String, u64)], name: String, n: u64) -> () {
    list.push(mut parts, (string.from(name), n))
}

fn total_sizes(parts: List[(String, u64)]) -> Option[u64] {
    let mut total = 0u64
    for i in 0u64 .. list.len(parts) {
        total = int.checked_add(total, parts[i].1)?
    }
    Some(total)
}

fn shortage(have: u64, take parts: List[(String, u64)]) -> Shortage {
    Shortage(need: size_or(total_sizes(parts), 18446744073709551615u64), have: have, parts: take parts)
}

fn cut_work(resident: u64) -> u64 {
    // Dividing first keeps ceil(resident / 11) and the doubled result in range.
    let blocks = resident / 11 + if resident % 11 == 0 { 0u64 } else { 1u64 }
    2 * blocks + CUT_FIXED_BYTES
}

fn largest_resident(room: u64) -> u64 {
    // Each 11 resident bytes use 13 bytes including the two cut working bytes.
    let tail = size_or(int.checked_sub(room % 13, 2), 0)
    11 * (room / 13) + tail
}

type TieredSizes {
    cache: u64,
    writer: u64,
    dirty: u64,
    pager: u64
}

const MIN_WRITER_PINS: u64 = 2 * VALUE_LIMIT + MIB

fn tiered_sizes_at(q: u64, resident_limit: u64, o: Overrides) -> Option[TieredSizes] {
    let writer = size_or(o.writer_pin_bytes, q)
    let minimum_cache = int.checked_add(writer, size_or(o.readers, VALUE_LIMIT + MIB))?
    let cache = size_or(o.cache_bytes, order.max(4 * q, minimum_cache))
    let dirty = size_or(o.dirty_bytes, q)
    let pager = size_or(o.pager_task_bytes, (q + 3) / 4)
    let with_cut = int.checked_add(cache, CUT_PIN_BYTES)?
    let with_dirty = int.checked_add(with_cut, dirty)?
    let with_pager = int.checked_add(with_dirty, pager)?
    let floor = int.checked_add(with_pager, 64 * MIB)?
    if writer < MIN_WRITER_PINS || cache < minimum_cache || floor > resident_limit {
        return None
    }
    Some(TieredSizes(cache: cache, writer: writer, dirty: dirty, pager: pager))
}

fn tiered_sizes(kind: Kind, resident_limit: u64, o: Overrides) -> TieredSizes {
    let zero = TieredSizes(cache: 0, writer: 0, dirty: 0, pager: 0)
    if let Memory = kind { return zero }
    let Some(initial) = tiered_sizes_at(MIN_WRITER_PINS, resident_limit, o) else { return zero }
    let mut best = initial
    let mut low = MIN_WRITER_PINS
    let mut high = 64 * MIB
    while low < high {
        let middle = low + (high - low + 1) / 2
        match tiered_sizes_at(middle, resident_limit, o) {
            Some(next_shape) => {
                low = middle
                best = next_shape
            },
            None => { high = middle - 1 },
        }
    }
    best
}

pub fn sized_with(kind: Kind, share: u64, o: Overrides) -> Result[Options, Shortage] {
    let (take options, _) = sized_reservation(kind, share, o)?
    Ok(take options)
}

// The task starting the store reserves the plan's actual cost. Explicit
// overrides may leave some of the share unused.
pub fn sized_reservation(kind: Kind, share: u64, o: Overrides) -> Result[(Options, u64), Shortage] {
    if let Directory = kind {
        return directory_reservation(share, o)
    }
    let mut parts: List[(String, u64)] = list.with_capacity(14)
    let mut checkpoint_budget = 0u64
    let mut journal = 0u64
    let mut pack = 0u64
    let mut group = 4 * MIB
    let mut valid = true
    match kind {
        Memory => add_size(mut parts, "memory_keep", MIB),
        _ => {
            pack = size_or(o.pack_bytes, order.min(64 * MIB, share / 16))
            checkpoint_budget = size_or(o.checkpoint_bytes, pack)
            let floor = int.checked_add(checkpoint_budget, FRAME_LIMIT)
            let minimum_journal = size_or(floor, 18446744073709551615u64)
            journal = size_or(o.journal_limit, minimum_journal)
            group = size_or(o.group_bytes, group)
            valid = floor != None && journal >= minimum_journal && group > 0 && group <= 4294967295u64
            add_size(mut parts, "journal_limit", order.max(journal, minimum_journal))
            add_size(mut parts, "frame", FRAME_LIMIT)
            add_size(mut parts, "pack_bytes", pack)
            add_size(mut parts, "checkpoint_task_fixed", CUT_FIXED_BYTES)
            if let Bucket(config) = kind {
                let lanes = std.object.lane_reservation(config)
                let group_room = order.min(group, 4294967295u64)
                valid = valid && lanes != None
                add_size(mut parts, "client_lanes", size_or(lanes, 18446744073709551615u64))
                add_size(mut parts, "entry_buffers", 2 * round8(object_writer_entry_room(group_room)))
                add_size(mut parts, "head_buffers", 2 * round8(HISTORY_HEAD_LIMIT))
                add_size(mut parts, "history_key", round8(HISTORY_BUFFER_KEY_BYTES))
                add_size(mut parts, "journal_timer", OBJECT_TIMER_GRANT + OBJECT_TIMER_TASK_BYTES)
                add_size(mut parts, "journal_worker", object_writer_journal_room(group_room) + OBJECT_JOURNAL_TASK_BYTES)
                add_size(mut parts, "reclaim_page", RECLAIM_PAGE_BYTES)
                add_size(mut parts, "put_buffer", pack)
            }
        },
    }
    let fixed = total_sizes(parts)
    let room = match fixed { Some(n) => size_or(int.checked_sub(share, n), 0), None => 0u64 }
    let derived = match kind { Memory => room, _ => largest_resident(room) }
    let resident = size_or(o.resident_limit, order.max(derived, MIB))
    let minimum = order.max(resident, MIB)
    add_size(mut parts, "resident_limit", minimum)
    match kind {
        Memory => (),
        _ => add_size(mut parts, "checkpoint_task_work", cut_work(minimum) - CUT_FIXED_BYTES),
    }
    let Some(total) = total_sizes(parts) else { return Error(shortage(share, take parts)) }
    if !valid || resident < MIB || total > share {
        return Error(shortage(share, take parts))
    }
    let commits = match o.group_commits { Some(n) => n, None => 64u32 }
    Ok((plan_options(kind, o, commits, group, checkpoint_budget, journal, pack, resident), total))
}

fn plan_options(kind: Kind, o: Overrides, commits: u32, group: u64, checkpoint_budget: u64, journal: u64, pack: u64, resident: u64) -> Options {
    let tiered = tiered_sizes(kind, resident, o)
    Options(create: true, lock_wait_ms: size_or(o.lock_wait_ms, 0), group_commits: commits, group_bytes: int.truncate(group), checkpoint_bytes: checkpoint_budget, journal_limit: journal, pack_bytes: pack, resident_limit: resident, cache_bytes: tiered.cache, writer_pin_bytes: tiered.writer, dirty_bytes: tiered.dirty, pager_task_bytes: tiered.pager, authority: Directory(), expect: None, activation: None, binding: None, claim_ms: 30000, head_poll_ms: 1000, checkpoint_entries: 4096, retain: 2)
}

// The Directory journal worker's grant beyond its group buffer, holding its
// END scratch and write state (§3.4), and the idle timer's grant.
const JOURNAL_WORKER_SLACK: u64 = 65536

const JOURNAL_TIMER_GRANT: u64 = 4096

// Recovery reads the journal through one input chunk of this many bytes.
const JOURNAL_CHUNK_BYTES: u64 = 65536

// MEM-24 charges of `journal_channels` (store.hirsel), each 64 + capacity x item. Items:
// JournalMsg 112 (ObjectExportRead: 8 + String 24 + HistoryRef 32 + Bytes 24
// + Sender 24), Ack 64 (ObjectBroken: 8 + Error 56), Result[(), Capacity] 24,
// WriteNotice 20 (8 + IoError 12) and () 0.
fn journal_channel_bytes(group_count: u64) -> u64 {
    (64 + 2 * group_count * 112) + (64 + (3 * group_count + 3) * 64) + (64 + 24) + (64 + 2 * 20) + 64 + 64
}

// The largest pack or MANIFEST file a cut writes (§3.9).
fn cut_output_bytes(pack: u64) -> u64 {
    order.max(pack, page_manifest_file_size(MANIFEST_LIMIT, 1))
}

fn add_phase(mut parts: List[(String, u64)], first: String, a: u64, second: String, b: u64) -> () {
    add_size(mut parts, first, a)
    add_size(mut parts, second, b)
}

// A Directory writer's grant (§1.1) is what it holds for its whole life, plus
// the largest of its recovery, write and cut phases, which never overlap.
// `journal_limit` bounds the uncovered journal on disk and is no memory term.
fn directory_reservation(share: u64, o: Overrides) -> Result[(Options, u64), Shortage] {
    let unbounded = 18446744073709551615u64
    let pack = size_or(o.pack_bytes, order.min(64 * MIB, share / 16))
    let checkpoint_budget = size_or(o.checkpoint_bytes, pack)
    let floor = int.checked_add(checkpoint_budget, FRAME_LIMIT)
    let minimum_journal = size_or(floor, unbounded)
    let journal = size_or(o.journal_limit, minimum_journal)
    let group = size_or(o.group_bytes, 4 * MIB)
    let commits = match o.group_commits {
        Some(n) => n,
        None => 64u32
    }
    let valid = floor != None && journal >= minimum_journal && group > 0 && group <= 4294967295u64
    let mut parts: List[(String, u64)] = list.with_capacity(8)
    let worker = int.checked_add(group, JOURNAL_WORKER_SLACK + OBJECT_JOURNAL_TASK_BYTES)
    add_size(mut parts, "journal_worker", size_or(worker, unbounded))
    add_size(mut parts, "journal_timer", JOURNAL_TIMER_GRANT + OBJECT_TIMER_TASK_BYTES)
    add_size(mut parts, "journal_channels", journal_channel_bytes(int.widen(commits)))
    let write = 2 * FRAME_LIMIT
    let recovery = JOURNAL_CHUNK_BYTES + FRAME_LIMIT
    let output = cut_output_bytes(pack)
    let cut_fixed = size_or(int.checked_add(output, CUT_FIXED_BYTES), unbounded)
    let derived = match total_sizes(parts) {
        Some(lifetime) => {
            let steady = size_or(int.checked_sub(share, lifetime), 0)
            let by_write = size_or(int.checked_sub(steady, order.max(write, recovery)), 0)
            let by_cut = largest_resident(size_or(int.checked_sub(steady, cut_fixed), 0))
            order.min(by_write, by_cut)
        },
        None => 0u64,
    }
    let resident = size_or(o.resident_limit, order.max(derived, MIB))
    let minimum = order.max(resident, MIB)
    add_size(mut parts, "resident_limit", minimum)
    let work = cut_work(minimum) - CUT_FIXED_BYTES
    let cut = size_or(int.checked_add(cut_fixed, work), unbounded)
    if cut >= write && cut >= recovery {
        add_size(mut parts, "cut_output", output)
        add_phase(mut parts, "checkpoint_task_fixed", CUT_FIXED_BYTES, "checkpoint_task_work", work)
    } else if write >= recovery {
        add_phase(mut parts, "staged_frame", FRAME_LIMIT, "frames_in_flight", FRAME_LIMIT)
    } else {
        add_phase(mut parts, "journal_chunk", JOURNAL_CHUNK_BYTES, "recovered_frame", FRAME_LIMIT)
    }
    let Some(total) = total_sizes(parts) else {
        return Error(shortage(share, take parts))
    }
    if !valid || resident < MIB || total > share {
        return Error(shortage(share, take parts))
    }
    Ok((plan_options(Directory, o, commits, group, checkpoint_budget, journal, pack, resident), total))
}


pub opaque type FollowerPlan: send {
    kind: Kind,
    options: Options,
    envelope: u64,
    root: u64
}

pub fn follower_plan(kind: Kind, o: Options) -> Result[FollowerPlan, Shortage] {
    let effective = Overrides(resident_limit: Some(o.resident_limit), journal_limit: Some(o.journal_limit),
        checkpoint_bytes: Some(o.checkpoint_bytes), pack_bytes: Some(o.pack_bytes),
        group_bytes: Some(int.widen(o.group_bytes)), group_commits: Some(o.group_commits), lock_wait_ms: Some(o.lock_wait_ms),
        cache_bytes: Some(o.cache_bytes), writer_pin_bytes: Some(o.writer_pin_bytes),
        dirty_bytes: Some(o.dirty_bytes), pager_task_bytes: Some(o.pager_task_bytes), readers: Some(0))
    let (take sized_options, total) = sized_reservation(kind, 18446744073709551615u64, effective)?
    let transport = if let Bucket(lanes) = kind { option.unwrap(std.object.lane_reservation(lanes)) } else { 0u64 }
    let envelope = total - transport
    let control = follower_control_bytes()
    let task_bytes = follower_task_bytes(0)
    let overhead = control + task_bytes
    if envelope < overhead {
        let mut parts: List[(String, u64)] = list.with_capacity(2)
        add_size(mut parts, "follower_control", control)
        add_size(mut parts, "follower_task", task_bytes)
        return Error(shortage(envelope, take parts))
    }
    let mut effective_options = take sized_options
    effective_options.claim_ms = o.claim_ms
    effective_options.head_poll_ms = o.head_poll_ms
    effective_options.checkpoint_entries = o.checkpoint_entries
    effective_options.retain = o.retain
    Ok(FollowerPlan(kind, options: take effective_options, envelope, root: envelope - overhead))
}

pub fn plan_bytes(p: FollowerPlan) -> u64 {
    p.envelope
}

pub fn service_bytes(plans: List[FollowerPlan]) -> Option[u64] {
    let mut room = follower_service_bytes()
    for plan in plans {
        room = int.checked_add(room, plan.envelope)?
    }
    Some(room)
}


pub fn follower_starter_bytes() -> u64 {
    follower_task_bytes(0) + order.max(follower_startup_reply_bytes(),
        order.max(follower_provision_bytes(), follower_request_bytes()))
}

// Two Latest roots, their initial Arc payloads, and the lifetime channel.
// Each weak level takes a channel with one 24-byte notice, three
// handle slots, and a copied String descriptor and its rounded text.
fn sim_level_bytes(names: List[String]) -> u64 {
    let mut room = 64 + 32 + 128 + 64 + (64 + 24 + 3 * 24 + 24) * list.len(names)
    for name in names { room += round8(string.byte_len(name)) }
    room
}

/// Fixed opening room for sim@1's weak barriers.
pub fn sim_level_reservation(declaration: SimLevels) -> u64 {
    if list.len(declaration.weak) == 0 { return 0 }
    sim_level_bytes(declaration.weak)
}

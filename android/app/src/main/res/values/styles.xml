        <item name="android:windowBackground">#FF09090B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#FF09090B</item>
        <item name="android:statusBarColor">#FF09090B</item>
    </style>
</resources>

// RFC 7515 A.3.
const A3: String = "eyJhbGciOiJFUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ.DtEhU3ljbEg8L38VWAfUAqOyKAM6-Xx-F4GawxaepmXFCgfTjDxw5djxLa8ISlSApmWQxfKTUJqPP3-Kg6NU1Q"

// RFC 8037 A.4, and its A.1 private and A.2 public key.
const ED: String = "eyJhbGciOiJFZERTQSJ9.RXhhbXBsZSBvZiBFZDI1NTE5IHNpZ25pbmc.hgyY0il_MGCjP0JzlnLWG1PPOt7-09PGcvMg3AIbQR6dWbhijcNR4ki4iylGjg5BhVsPt9g7sVvpAr_MuM0KAg"

const ED_JWK: String = "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\n\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}"

const ED_PRIVATE_JWK: String = "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\n\"d\":\"nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A\",\n\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}"

// RFC 8410 section 7's PKCS#8 v1 prefix, then RFC 8037 A.1's d.
const ED_PKCS8: String = "302e020100300506032b6570042204209d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"

// RFC 7517 A.1, A.2 (its private members) and A.3.
const SET_PUBLIC: String = "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4\",\"y\":\"4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM\",\"use\":\"enc\",\"kid\":\"1\"},{\"kty\":\"RSA\",\"n\": \"0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw\",\"e\":\"AQAB\",\"alg\":\"RS256\",\"kid\":\"2011-04-29\"}]}"

const SET_PRIVATE_RSA: String = "{\"keys\":[{\"kty\":\"RSA\",\"n\":\"0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw\",\"e\":\"AQAB\",\"d\":\"X4cTteJY_gn4FYPsXB8rdXix5vwsg1FLN5E3EaG6RJoVH-HLLKD9M7dx5oo7GURknchnrRweUkC7hT5fJLM0WbFAKNLWY2vv7B6NqXSzUvxT0_YSfqijwp3RTzlBaCxWp4doFk5N2o8Gy_nHNKroADIkJ46pRUohsXywbReAdYaMwFs9tv8d_cPVY3i07a3t8MN6TNwm0dSawm9v47UiCl3Sk5ZiG7xojPLu4sbg1U2jx4IBTNBznbJSzFHK66jT8bgkuqsk0GjskDJk19Z4qwjwbsnn4j2WBii3RL-Us2lGVkY8fkFzme1z0HbIkfz0Y6mqnOYtqc0X4jfcKoAC8Q\",\"alg\":\"RS256\",\"kid\":\"2011-04-29\"}]}"

const SET_SYMMETRIC: String = "{\"keys\":[{\"kty\":\"oct\",\"alg\":\"A128KW\",\"k\":\"GawgguFyGrWKav7AX4VKUg\"},{\"kty\":\"oct\",\"k\":\"AyM1SysPpbyDfgZld3umj1qzKObwVMkoqQ-EstJQLr_T-1qS0gZH75aKtMN3Yj0iPS4hcgUuTwjAzZr1Z9CAow\",\"kid\":\"HMAC key used in JWS spec Appendix A.1 example\"}]}"

fn hs_key() -> jwt.Key {
    jwt.hmac_key(seal(b64(A1_K), "mac"))
}

fn a2_key() -> jwt.Key {
    result.unwrap(jwt.rsa_key(b64(A2_N), b64("AQAB")))
}

fn rules(now: u64, leeway: u64, take iss: Option[String], take aud: Option[String]) -> jwt.Rules {
    jwt.Rules(allow: jwt.allow(Hs256), now_secs: now, leeway_secs: leeway, iss: take iss, aud: take aud, require_exp: true)
}

// A token whose header and payload are header_json and payload_json, and
// whose signature is HMAC-SHA256 under mac_key: what an attacker can make.
fn forged(header_json: String, payload_json: String, mac_key: Bytes) -> String {
    let mut t = base64.encode_url(string.as_bytes(header_json), false)
    string.push(mut t, ".")
    string.push(mut t, base64.encode_url(string.as_bytes(payload_json), false))
    let tag = hmac.sha256(mac_key, string.as_bytes(t))
    let mut sig: Bytes = list.with_capacity(32)
    for x in tag {
        list.push(mut sig, x)
    }
    string.push(mut t, ".")
    string.push(mut t, base64.encode_url(sig, false))
    t
}

fn signed(take r: Result[String, jwt.Error], want: String) -> bool {
    match take r {
        Ok(t) => t == want,
        Error(_) => false,
    }
}

fn jws_error(take r: Result[jwt.Jws, jwt.Error]) -> Option[jwt.Error] {
    match take r {
        Ok(_) => None,
        Error(take e) => Some(take e),
    }
}

fn jwt_error(take r: Result[jwt.Jwt, jwt.Error]) -> Option[jwt.Error] {
    match take r {
        Ok(_) => None,
        Error(take e) => Some(take e),
    }
}

// expect: run jwt_law() = 0
fn jwt_law() -> u64 {
    // 1. RFC 7515 A.1 verifies as a JWS and as a JWT one second before exp.
    let Ok(jws) = jwt.verify_jws(A1, jwt.allow(Hs256), hs_key()) else {
        return 1
    }
    if jws.payload != b64(A1_PAYLOAD) || jws.header.typ != Some(string.from("JWT")) {
        return 1
    }
    let Ok(token) = jwt.verify_jwt(A1, rules(A1_EXP - 1, 0, Some(string.from("joe")), None), hs_key()) else {
        return 2
    }
    if token.claims.exp != Some(A1_EXP) || token.claims.iss != Some(string.from("joe")) {
        return 2
    }
    // 3. Signing A.1's header text and payload reproduces A.1 byte for byte.
    let header = "{\"typ\":\"JWT\",\r\n \"alg\":\"HS256\"}"
    let hs = jwt.signer(Hs256, seal(b64(A1_K), "mac"))
    if !signed(jwt.sign_jws(hs, header, b64(A1_PAYLOAD)), A1) {
        return 3
    }
    // 4. RFC 7515 A.2 (RS256) verifies, and PKCS#1 v1.5 signing reproduces it.
    let Ok(_) = jwt.verify_jws(A2, jwt.allow(Rs256), a2_key()) else {
        return 4
    }
    let rs = jwt.signer(Rs256, seal(unhex(A2_PKCS8), "sign(rs256)"))
    if !signed(jwt.sign_jws(rs, "{\"alg\":\"RS256\"}", b64(A1_PAYLOAD)), A2) {
        return 5
    }
    // 6. RFC 7515 A.3 (ES256, P1363 r || s) verifies; one flipped bit does not.
    let es_key = result.unwrap(jwt.p256_key(b64("f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU"), b64("x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0")))
    let Ok(_) = jwt.verify_jws(A3, jwt.allow(Es256), es_key) else {
        return 6
    }
    let mut a3_bad = string.from(string.slice(A3, 0, string.byte_len(A3) - 2))
    string.push(mut a3_bad, "2Q")
    match jws_error(jwt.verify_jws(a3_bad, jwt.allow(Es256), es_key)) {
        Some(BadSignature) => {},
        _ => return 6,
    }
    // 7. RFC 8037 A.4/A.5: the A.2 JWK verifies; signing with A.1's d reproduces it.
    let ed_key = result.unwrap(jwt.jwk(ED_JWK))
    let Ok(ed) = jwt.verify_jws(ED, jwt.allow(EdDsa), ed_key) else {
        return 7
    }
    if ed.payload != string.as_bytes("Example of Ed25519 signing") {
        return 7
    }
    let eds = jwt.signer(EdDsa, seal(unhex(ED_PKCS8), "sign(ed25519)"))
    if !signed(jwt.sign_jws(eds, "{\"alg\":\"EdDSA\"}", string.as_bytes("Example of Ed25519 signing")), ED) {
        return 8
    }
    match jwt.jwk(ED_PRIVATE_JWK) {
        Error(PrivateKey) => {},
        _ => return 8,
    }
    // 9. RFC 7517 A.1: the "use":"enc" EC key is left out, the RS256 key is
    // found by its kid. A.2's private RSA key is refused. A.3: the A128KW key
    // is left out and the HMAC key verifies RFC 7515 A.1 with no kid.
    let Ok(public) = jwt.jwks(SET_PUBLIC) else {
        return 9
    }
    if jwt.len(public) != 1 {
        return 9
    }
    let Ok(_) = jwt.find(public, Some(string.from("2011-04-29"))) else {
        return 9
    }
    match jwt.find(public, Some(string.from("1"))) {
        Error(NoKey) => {},
        _ => return 9,
    }
    match jwt.jwks(SET_PRIVATE_RSA) {
        Error(PrivateKey) => {},
        _ => return 10,
    }
    let Ok(symmetric) = jwt.jwks(SET_SYMMETRIC) else {
        return 11
    }
    let Ok(_) = jwt.verify_jws_in(A1, jwt.allow(Hs256), symmetric) else {
        return 11
    }
    // 12. Two keys with one kid, or no kid and two keys: never a guess.
    let twins = "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"a\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"},{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"a\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}]}"
    let pair = result.unwrap(jwt.jwks(twins))
    match jwt.find(pair, Some(string.from("a"))) {
        Error(AmbiguousKey) => {},
        _ => return 12,
    }
    match jws_error(jwt.verify_jws_in(ED, jwt.allow(EdDsa), pair)) {
        Some(AmbiguousKey) => {},
        _ => return 12,
    }
    // 13. alg "none" with an empty signature: no Alg names it.
    let mut none = base64.encode_url(string.as_bytes("{\"alg\":\"none\"}"), false)
    string.push(mut none, ".")
    string.push(mut none, A1_PAYLOAD)
    string.push(mut none, ".")
    let rs_alg: jwt.Alg = Rs256
    let ed_alg: jwt.Alg = EdDsa
    let es_alg: jwt.Alg = Es256
    let mut others: List[jwt.Alg] = list.new()
    list.push(mut others, rs_alg)
    list.push(mut others, ed_alg)
    list.push(mut others, es_alg)
    match jws_error(jwt.verify_jws(none, jwt.Allow(first: Hs256, rest: take others), hs_key())) {
        Some(UnsupportedAlg) => {},
        _ => return 13,
    }
    // 14. Key confusion: HS256 under the RS256 key's public PEM bytes, against
    // that RSA key with both algorithms allowed.
    let confused = forged("{\"alg\":\"HS256\"}", "{\"iss\":\"joe\",\"exp\":1300819380}", string.as_bytes(A2_PEM))
    let hs_alg: jwt.Alg = Hs256
    let mut hs_too: List[jwt.Alg] = list.new()
    list.push(mut hs_too, hs_alg)
    match jws_error(jwt.verify_jws(confused, jwt.Allow(first: Rs256, rest: take hs_too), a2_key())) {
        Some(WrongKey) => {},
        _ => return 14,
    }
    // 15. exp with leeway 60: valid at exp + 59, expired at exp + 60.
    let Ok(_) = jwt.verify_jwt(A1, rules(A1_EXP + 59, 60, None, None), hs_key()) else {
        return 15
    }
    match jwt_error(jwt.verify_jwt(A1, rules(A1_EXP + 60, 60, None, None), hs_key())) {
        Some(Expired) => {},
        _ => return 15,
    }
    // 16. aud as an array: a listed audience passes, another is refused, and
    // a present aud with no audience required is refused (RFC 7519 4.1.3).
    let k = b64(A1_K)
    let aud = forged("{\"alg\":\"HS256\"}", "{\"aud\":[\"a\",\"b\"],\"exp\":1300819380}", k)
    let Ok(_) = jwt.verify_jwt(aud, rules(A1_EXP - 1, 0, None, Some(string.from("b"))), hs_key()) else {
        return 16
    }
    match jwt_error(jwt.verify_jwt(aud, rules(A1_EXP - 1, 0, None, Some(string.from("c"))), hs_key())) {
        Some(Mismatch(Aud)) => {},
        _ => return 16,
    }
    match jwt_error(jwt.verify_jwt(aud, rules(A1_EXP - 1, 0, None, None), hs_key())) {
        Some(Mismatch(Aud)) => {},
        _ => return 16,
    }
    // 17. A correctly signed token with a crit header this module does not
    // understand (RFC 7515 4.1.11).
    let crit = forged("{\"alg\":\"HS256\",\"crit\":[\"exp\"],\"exp\":1}", "{}", k)
    match jws_error(jwt.verify_jws(crit, jwt.allow(Hs256), hs_key())) {
        Some(UnsupportedCrit) => {},
        _ => return 17,
    }
    // 18. Strict parsing: nonzero pad bits in the last digit, a fourth
    // segment, a duplicate header name, a non-object header.
    let mut padded = string.from(string.slice(A1, 0, string.byte_len(A1) - 1))
    string.push(mut padded, "l")
    match jws_error(jwt.verify_jws(padded, jwt.allow(Hs256), hs_key())) {
        Some(Malformed(Encoding)) => {},
        _ => return 18,
    }
    let mut four = string.from(A1)
    string.push(mut four, ".")
    match jws_error(jwt.verify_jws(four, jwt.allow(Hs256), hs_key())) {
        Some(Malformed(Segments)) => {},
        _ => return 18,
    }
    let dup = forged("{\"alg\":\"HS256\",\"alg\":\"HS256\"}", "{}", k)
    match jws_error(jwt.verify_jws(dup, jwt.allow(Hs256), hs_key())) {
        Some(Malformed(Duplicate)) => {},
        _ => return 18,
    }
    let array = forged("[\"HS256\"]", "{}", k)
    match jws_error(jwt.verify_jws(array, jwt.allow(Hs256), hs_key())) {
        Some(Malformed(NotObject)) => {},
        _ => return 18,
    }
    0
}

// rule: STORE-9
// expect: run
// A generation number is written again only once every row of its earlier life
// is deleted. A table is migrated through all 256 generations to its last; a
// migration into the wrapped generation 0 that strays every row to new keys and
// then fails leaves the table whole with no stray row once its chunked discard
// ends, and after a reopen; the migration that then reuses generation 0 reads
// exactly its own rows.
@serializable
type Box {
  n: u64,
}

fn plain() -> table.Table[String, u64] {
  table.named("t")
}

fn boxed() -> table.Table[String, Box] {
  table.named("t")
}

// Rows 1 through 40 under keys of about 4000 bytes, in key order.
fn row_key(k: u32) -> String uses {} {
  let pad = if k < 10 {
    "0"
  } else {
    ""
  }
  let mut out = f"row {pad}{k}"
  let mut i: u32 = 0
  while i < 64 {
    out = f"{out} under a key long enough that a deletion takes more commits"
    i += 1
  }
  out
}

fn up(c: (), key: String, old: u64) -> Result[(String, Box), ()] {
  Ok((unique key, Box(n: old + 1)))
}

fn down(c: (), key: String, old: Box) -> Result[(String, u64), ()] {
  Ok((unique key, old.n + 1))
}

// Moves every row to a key no other migration writes, then fails at the last.
fn astray(c: (), key: String, old: Box) -> Result[(String, u64), ()] {
  if key == row_key(40) {
    return Error(())
  }
  Ok((f"stray {key}", 0))
}

// The store's limits, fixed at its creation: a commit holds 8 rows but not
// the deletes of the 32 strays' keys (about 128 KB), so discarding them takes
// more than one commit.
fn tight() -> store.StoreConfig uses {} {
  let mut config = store.default_config()
  config.limits.transaction_bytes = 120000
  config
}

// Every key stored under the table's rows, whatever its generation, and
// whether nothing waits to be deleted.
fn stored(a: Authority, mut s: store.Store) -> (u64, bool) {
  let Ok(snap) = store.snapshot(a, mut s, authority.floor(a)) else {
    return (0, false)
  }
  let mut prefix: List[u8] = []
  bytes.append(mut prefix, b"hirsel.rows/")
  bytes.append(mut prefix, keys.encode("t"))
  let (low, high) = store.prefix_bounds(bytes.from_list(take prefix))
  let rows = list.len(store.range(snap, low, high, Ascending(), 200))
  let (from, to) = store.prefix_bounds(b"hirsel.garbage/")
  (rows, list.len(store.range(snap, from, to, Ascending(), 10)) == 0)
}

// Whether the table is boxed with every row at `n` and holds nothing else.
fn boxed_at(a: Authority, mut s: store.Store, n: u64) -> bool {
  store.transact(mut s, boxed_rows, n) == Ok(true) && stored(a, mut s) == (40, true)
}

fn boxed_rows(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[bool, store.TxError] {
  let rows = table.range(tx, boxed(), Unbounded(), Unbounded(), 200, Ascending())?
  let mut k: u32 = 0
  for row in rows {
    k += 1
    if row != (row_key(k), Box(n: n)) {
      return Ok(false)
    }
  }
  Ok(k == 40)
}

// Whether the table is plain with every row at `n` and holds nothing else.
fn plain_at(a: Authority, mut s: store.Store, n: u64) -> bool {
  store.transact(mut s, plain_rows, n) == Ok(true) && stored(a, mut s) == (40, true)
}

fn plain_rows(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[bool, store.TxError] {
  let rows = table.range(tx, plain(), Unbounded(), Unbounded(), 200, Ascending())?
  let mut k: u32 = 0
  for row in rows {
    k += 1
    if row != (row_key(k), n) {
      return Ok(false)
    }
  }
  Ok(k == 40)
}

// Rows `from` through `from + 7`; the first batch creates the table.
fn seed_rows(mut tx: store.Tx, info: store.CallInfo, from: u32) -> Result[(), store.TxError] {
  if from == 1 {
    table.create(mut tx, plain())?
  }
  for k in from..from + 8 {
    table.put(mut tx, plain(), row_key(k), 0)?
  }
  Ok(())
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let Ok(tasks) = io.tasks(rt) else {
    return Error(Check())
  }
  task.scope(
    tasks,
    fn(sc: Scope) -> Result[(), Failed] {
      scenario(a, sc)
    }
  )
}

fn scenario(a: Authority, sc: Scope) -> Result[(), Failed] {
  let mut s = store.open(a, tight()) ? Store
  let mut from: u32 = 1
  while from < 41 {
    check(store.transact(mut s, seed_rows, from) == Ok(()))?
    from += 8
  }
  // 255 migrations reach the last generation; each adds one to every row.
  let mut m: u64 = 0
  let mut migrated = true
  while m < 255 {
    let moved = if m % 2 == 0 {
      table.migrate(sc, mut s, plain(), boxed(), up, 8)
    } else {
      table.migrate(sc, mut s, boxed(), plain(), down, 8)
    }
    migrated = migrated && moved == Ok(40)
    m += 1
  }
  check(migrated && boxed_at(a, mut s, 255))?
  store.close(take s) ? Store
  // The migration into generation 0 strays every row, then fails: its rows
  // are discarded and the table is whole, before and after a reopen.
  // A reopen keeps the limits the store was created with.
  let mut straying = store.open(a, store.default_config()) ? Store
  let strayed = table.migrate(sc, mut straying, boxed(), plain(), astray, 8)
  check(strayed == Error(Failed(())) && boxed_at(a, mut straying, 255))?
  store.close(take straying) ? Store
  // Generation 0 is written again, and holds exactly the migrated rows.
  let mut wrapped = store.open(a, store.default_config()) ? Store
  check(boxed_at(a, mut wrapped, 255))?
  check(table.migrate(sc, mut wrapped, boxed(), plain(), down, 8) == Ok(40))?
  check(plain_at(a, mut wrapped, 256))?
  store.close(take wrapped) ? Store
  Ok(())
}

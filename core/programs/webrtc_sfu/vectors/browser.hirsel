// Firefox offer with a session-level tls-id inserted before the first m-line.
pub fn firefox_tls_id() -> Bytes {
    let raw = firefox()
    let mut result: Bytes = clone(list.slice(raw, 0, 277))
    list.append(mut result, b"a=tls-id:browser-variant\r\n")
    list.append(mut result, list.slice(raw, 277, list.len(raw)))
    take result
}

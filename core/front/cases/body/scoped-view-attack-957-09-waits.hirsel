fn run(mut ts: Tasks, xs: List[u64]) -> Result[Result[u64, Causes], Capacity] waits {
    isolate(fn() -> u64 { let _ = task.spawn(ts, 32u64, 1u64, fn(take x: u64) -> u64 waits { x }); 0u64 })
}
pub fn main() -> Result[(), ()] { Ok(()) }


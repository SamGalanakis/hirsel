// Module `float`, extended (LANG-7): library members of the core module `float` (SEM-2),
// over its core conversions (from_int, to_int, widen, narrow, to_bits32/64,
// from_bits32/64; core/core/float.hirsel).
//
// A library function cannot be generic over f32 and f64: no bound names the float types
// (OWN-4), so each operation is written at each width it serves, as Go's ParseFloat takes
// a bit size. An f32 result is not `float.narrow` of the f64 one: that rounds twice.
//
// Parsing (Rust core::num::dec2flt, Go strconv.ParseFloat). The decimal mantissa is read
// into a u64 (19 significant digits) and a decimal exponent.
//  1. Exact fast path (Clinger): mantissa below 2^53 (f32: 2^24) and |exponent| <= 22
//     (f32: 10): `float.from_int` of the mantissa, multiplied or divided by an exact power
//     of ten, which IEEE rounds once.
//  2. Eisel-Lemire: a 128-bit product of the mantissa and a truncated power of five
//     (`int.mul_wide`), assembled into the result's bits and made with
//     `float.from_bits64` (`from_bits32`). The 651 powers of five, two u64 words each, are
//     one private `const POW5: Inline[(u64, u64), 651]` (SEM-9).
//  3. Slow path, when step 2 cannot decide the rounding (more than 19 significant digits
//     near a halfway point): a big decimal of at most 768 significant digits, shifted by
//     powers of two, held in a local `Inline[u8, 768]` as Rust holds it on the stack.
//     No step allocates, so parsing returns only ParseError.
/// Parses the whole of s as a decimal f64: an optional '-', digits with an optional
/// fraction, an optional exponent (the JSON number grammar plus a leading '+' in the
/// exponent; "inf", "nan", '+' before the number and hex are refused). Correctly rounded,
/// ties to even.
/// Fails: Error(Empty | Invalid(i)), i the byte position; Error(OutOfRange)
/// when the value rounds to an infinity (Go returns ErrRange there; Rust returns inf).
/// A value too small rounds to a signed zero and is Ok. Alloc: nothing.
/// Cost: O(len); step 3 is O(digits x shifts), at most about 768 x 30 digit steps.
/// Ex: `let x = float.parse64(token)?`
pub fn parse64(s: String) -> Result[f64, ParseError] {
    let n = scan(s)?
    if !n.many && n.exponent >= -22 && n.exponent <= 22 && n.mantissa <= 9007199254740992 {
        let mut v: f64 = float.from_int(n.mantissa)
        if n.exponent < 0 {
            let k: u64 = int.narrow(-n.exponent)
            v = v / POW10_64[k]
        } else {
            let k: u64 = int.narrow(n.exponent)
            v = v * POW10_64[k]
        }
        return Ok(if n.negative {
            -v
        } else {
            v
        })
    }
    let fmt = format64()
    let (m, e) = decide(fmt, s, n)
    if e == fmt.inf {
        return Error(OutOfRange)
    }
    let biased: u64 = int.narrow(e)
    let sign: u64 = if n.negative {
        1
    } else {
        0
    }
    Ok(float.from_bits64(m | (biased << 52) | (sign << 63)))
}

/// As parse64, rounded once to f32. Ex: `let y = float.parse32(token)?`
pub fn parse32(s: String) -> Result[f32, ParseError] {
    let n = scan(s)?
    if !n.many && n.exponent >= -10 && n.exponent <= 10 && n.mantissa <= 16777216 {
        let mut v: f32 = float.from_int(n.mantissa)
        if n.exponent < 0 {
            let k: u64 = int.narrow(-n.exponent)
            v = v / POW10_32[k]
        } else {
            let k: u64 = int.narrow(n.exponent)
            v = v * POW10_32[k]
        }
        return Ok(if n.negative {
            -v
        } else {
            v
        })
    }
    let fmt = format32()
    let (m, e) = decide(fmt, s, n)
    if e == fmt.inf {
        return Error(OutOfRange)
    }
    let low: u32 = int.narrow(m)
    let biased: u32 = int.narrow(e)
    let sign: u32 = if n.negative {
        1
    } else {
        0
    }
    Ok(float.from_bits32(low | (biased << 23) | (sign << 31)))
}

/// Whether x is neither infinite nor NaN: its exponent bits (`float.to_bits64`) are not
/// all ones. For an f32 use `float.is_finite(float.widen(x))`, which is exact.
/// Cost: O(1). Ex: `float.is_finite(x)`
pub fn is_finite(x: f64) -> bool {
    float.to_bits64(x) & 0x7ff0000000000000 != 0x7ff0000000000000
}

// The parse, after Rust's core::num::dec2flt (itself after fast_float and Go's strconv).
/// One float width's parameters, as Rust's RawFloat constants.
type Format {
    bits: u64, // explicit mantissa bits
    min_exp: i64, // the exponent bias, negated
    inf: i64, // the biased exponent of the infinities
    smallest10: i64, // below this decimal exponent every value rounds to zero
    largest10: i64, // above it every value but zero rounds to an infinity
    even_lo: i64, // the decimal exponents where a product can be exactly halfway
    even_hi: i64,
}

fn format64() -> Format {
    Format(bits: 52, min_exp: -1023, inf: 2047, smallest10: -342, largest10: 308, even_lo: -4, even_hi: 23)
}

fn format32() -> Format {
    Format(bits: 23, min_exp: -127, inf: 255, smallest10: -65, largest10: 38, even_lo: -17, even_hi: 10)
}

/// The number as scanned: its first 19 significant digits and a decimal exponent, so the
/// value lies in [mantissa, mantissa + 1) x 10^exponent, exactly mantissa x 10^exponent
/// unless `many` (more than 19 significant digits). `at` is the first byte after the sign.
type Scanned {
    negative: bool,
    mantissa: u64,
    exponent: i64,
    many: bool,
    at: u64,
    written: WrittenExponent
}

type WrittenExponent {
    magnitude: u64,
    negative: bool,
}

// Beyond this margin both conversion paths have settled overflow or underflow.
const EXPONENT_MARGIN: u64 = 400

fn add_written(point: i64, written: WrittenExponent) -> i64 {
    if written.magnitude == 0 {
        return point
    }
    let mut negative = point < 0
    let magnitude: u64 = int.narrow(if negative {
        -point
    } else {
        point
    })
    let combined = if negative == written.negative {
        int.saturating_add(magnitude, written.magnitude)
    } else if magnitude < written.magnitude {
        negative = written.negative
        written.magnitude - magnitude
    } else {
        magnitude - written.magnitude
    }
    let bounded: i64 = if combined > EXPONENT_MARGIN {
        int.narrow(EXPONENT_MARGIN)
    } else {
        int.narrow(combined)
    }
    if negative {
        -bounded
    } else {
        bounded
    }
}

/// Scans s against the grammar: '-'?, '0' or a non-zero digit and digits, then optionally
/// '.' and digits, then optionally 'e' or 'E', a sign and digits, and nothing after.
/// As Rust's parse_number: every digit goes into a wrapping u64, eight at a time where
/// eight are there, and the exponent is the fraction's length; only a number of more than
/// 19 significant digits, whose wrapped mantissa is wrong, is scanned again (`long`).
fn scan(s: String) -> Result[Scanned, ParseError] {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if n == 0 {
        return Error(Empty)
    }
    let negative = b[0] == b'-'
    let at: u64 = if negative {
        1
    } else {
        0
    }
    let mut i = at
    if i >= n || !int.is_ascii_digit(b[i]) {
        return Error(Invalid(i))
    }
    let mut mantissa: u64 = 0
    if b[i] == b'0' {
        i += 1
    } else {
        let (end, x) = accumulate(b, i, 0)
        i = end
        mantissa = x
    }
    let mut count = i - at
    let mut exponent: i64 = 0
    if i < n && b[i] == b'.' {
        i += 1
        let first = i
        let (end, x) = accumulate(b, i, mantissa)
        i = end
        mantissa = x
        if i == first {
            return Error(Invalid(i))
        }
        count += i - first
        let places: i64 = int.narrow(i - first)
        exponent = -places
    }
    let mut written = WrittenExponent(magnitude: 0, negative: false)
    if i < n && (b[i] == b'e' || b[i] == b'E') {
        i += 1
        written.negative = i < n && b[i] == b'-'
        if i < n && (b[i] == b'-' || b[i] == b'+') {
            i += 1
        }
        if i >= n || !int.is_ascii_digit(b[i]) {
            return Error(Invalid(i))
        }
        // A point displacement cannot exceed the number of significand digits.
        // A magnitude past this limit stays out of range after any cancellation.
        let limit = count + EXPONENT_MARGIN
        while i < n && int.is_ascii_digit(b[i]) {
            if written.magnitude < limit {
                let digit: u64 = int.widen(b[i] - b'0')
                let next = int.saturating_add(int.saturating_mul(written.magnitude, 10), digit)
                written.magnitude = if next > limit {
                    limit
                } else {
                    next
                }
            }
            i += 1
        }
    }
    if i < n {
        return Error(Invalid(i))
    }
    if count > 19 {
        // Leading zeros (and the point among them) are not significant.
        let mut j = at
        while j < n && (b[j] == b'0' || b[j] == b'.') {
            if b[j] == b'0' {
                count -= 1
            }
            j += 1
        }
        if count > 19 {
            return Ok(long(b, negative, at, written))
        }
    }
    Ok(Scanned(negative, mantissa, exponent: add_written(exponent, written), many: false, at, written))
}

/// The digits of b from i accumulated onto x, wrapping (the caller rescans past 19
/// significant digits), and the index of the first byte that is not a digit.
fn accumulate(b: Bytes, i: u64, from: u64) -> (u64, u64) {
    let n = list.len(b)
    let mut x = from
    let mut k = i
    while k + 8 <= n {
        let w = list.word_le(b, k)
        if (int.wrapping_add(w, 0x4646464646464646) | int.wrapping_sub(w, 0x3030303030303030)) & 0x8080808080808080 != 0 {
            break
        }
        x = int.wrapping_add(int.wrapping_mul(x, 100000000), eight(w))
        k += 8
    }
    while k < n {
        let d = int.wrapping_sub(b[k], b'0')
        if d >= 10 {
            break
        }
        let wide: u64 = int.widen(d)
        x = int.wrapping_add(int.wrapping_mul(x, 10), wide)
        k += 1
    }
    (k, x)
}

/// The value of eight ASCII digits read little-endian, the first digit most significant
/// (Rust's parse_8digits): pairs, then fours, then the eight, by multiply-and-shift.
fn eight(w: u64) -> u64 {
    let v = w - 0x3030303030303030
    let pairs = int.wrapping_mul(v, 10) + (v >> 8)
    let low = int.wrapping_mul(pairs & 0x000000FF000000FF, 0x000F424000000064)
    let high = int.wrapping_mul((pairs >> 16) & 0x000000FF000000FF, 0x0000271000000001)
    (int.wrapping_add(low, high) >> 32) & 0xFFFFFFFF
}

/// A number of more than 19 significant digits, already checked against the grammar,
/// scanned again as Rust's: its first 19 significant digits (leading zeros leave the
/// mantissa 0), the exponent they leave, and `many`; `written` is the explicit exponent.
fn long(b: Bytes, negative: bool, at: u64, written: WrittenExponent) -> Scanned {
    let n = list.len(b)
    let mut x: u64 = 0
    let mut i = at
    while i < n && int.is_ascii_digit(b[i]) && x < 1000000000000000000 {
        let wide: u64 = int.widen(b[i] - b'0')
        x = x * 10 + wide
        i += 1
    }
    let mut exponent: i64 = 0
    if x >= 1000000000000000000 {
        // 19 digits in the integer part: the rest of it only scales.
        let mut j = i
        while j < n && int.is_ascii_digit(b[j]) {
            j += 1
        }
        exponent = int.narrow(j - i)
    } else {
        // Fewer: the rest are in the fraction, after the point at i.
        i += 1
        let first = i
        while i < n && int.is_ascii_digit(b[i]) && x < 1000000000000000000 {
            let wide: u64 = int.widen(b[i] - b'0')
            x = x * 10 + wide
            i += 1
        }
        let places: i64 = int.narrow(i - first)
        exponent = -places
    }
    Scanned(negative, mantissa: x, exponent: add_written(exponent, written), many: true, at, written)
}

/// The rounded (mantissa, biased exponent) of a scanned number that missed the exact fast
/// path: Eisel-Lemire, then the big decimal when Lemire cannot decide. An exponent of
/// fmt.inf is an infinity.
fn decide(fmt: Format, s: String, n: Scanned) -> (u64, i64) {
    let (m, e) = lemire(fmt, n.exponent, n.mantissa)
    if e >= 0 {
        if !n.many {
            return (m, e)
        }
        // The value lies in [mantissa, mantissa + 1) x 10^exponent: decided when both ends
        // round alike.
        let (m1, e1) = lemire(fmt, n.exponent, n.mantissa + 1)
        if m1 == m && e1 == e {
            return (m, e)
        }
    }
    slow(fmt, string.as_bytes(s), n.at, n.written)
}

const ALL_ONES: u64 = 0xffffffffffffffff

/// Eisel-Lemire: w x 10^q rounded to fmt as (mantissa, biased exponent), or an exponent of
/// -1 when the truncated power of five cannot decide the rounding.
fn lemire(fmt: Format, q: i64, w: u64) -> (u64, i64) {
    if w == 0 || q < fmt.smallest10 {
        return (0, 0)
    }
    if q > fmt.largest10 {
        return (0, fmt.inf)
    }
    let lz = leading_zeros(w)
    let (lo, hi) = product(q, w << lz, fmt.bits + 3)
    if lo == ALL_ONES && (q < -27 || q > 55) {
        return (0, -1)
    }
    let upper = hi >> 63
    let s = upper + 64 - fmt.bits - 3
    let mut m = hi >> s
    let up: i64 = int.narrow(upper)
    let zeros: i64 = int.narrow(lz)
    let mut p2 = power(q) + up - zeros - fmt.min_exp
    let hidden: u64 = 1 << fmt.bits
    if p2 <= 0 {
        // Subnormal: shift into place, round half up on the bit below, and a mantissa
        // that carried into the hidden bit is the smallest normal.
        if 1 - p2 >= 64 {
            return (0, 0)
        }
        let k: u64 = int.narrow(1 - p2)
        m = m >> k
        m += m & 1
        m = m >> 1
        let e: i64 = if m >= hidden {
            1
        } else {
            0
        }
        return (m, e)
    }
    // Exactly halfway between two floats: round to even, not up.
    if lo <= 1 && q >= fmt.even_lo && q <= fmt.even_hi && m & 3 == 1 && m << s == hi {
        m = m & ~1
    }
    m += m & 1
    m = m >> 1
    if m >= hidden << 1 {
        m = hidden
        p2 += 1
    }
    if m >= hidden {
        m -= hidden
    }
    if p2 >= fmt.inf {
        return (0, fmt.inf)
    }
    (m, p2)
}

/// floor(log2(10^q)) + 63, for q in -342..=308.
fn power(q: i64) -> i64 {
    (int.wrapping_mul(q, 217706) >> 16) + 63
}

/// The high 64 bits of w x 5^q (w normalized), in two products only when the first leaves
/// the bits below `precision` undecided; returned (low, high) as Rust's.
fn product(q: i64, w: u64, precision: u64) -> (u64, u64) {
    let mask = ALL_ONES >> precision
    let index: u64 = int.narrow(q + 342)
    let (hi5, lo5) = POW5[index]
    let (hi, lo) = int.mul_wide(w, hi5)
    let mut high = hi
    let mut low = lo
    if high & mask == mask {
        let (carry, _) = int.mul_wide(w, lo5)
        low = int.wrapping_add(low, carry)
        if carry > low {
            high += 1
        }
    }
    (low, high)
}

/// The leading zero bits of x, which is not 0.
fn leading_zeros(x: u64) -> u64 {
    int.widen(int.leading_zeros(x))
}

// The slow path: the digits as a big decimal, shifted by powers of two until it is in
// [1/2, 1), then by the mantissa width, and rounded (Rust dec2flt's slow.rs and decimal.rs,
// Go's decimal.go). Digits past 768 are dropped and remembered in `truncated`.
const DIGITS: u64 = 768

/// 0.d[0]d[1]..d[count-1] x 10^point, each d a digit value.
type Decimal {
    digits: Inline[u8, 768],
    count: u64,
    point: i64,
    truncated: bool
}

/// The binary shift that moves the decimal point by at most n places, 60 past 18.
const SHIFTS: Inline[u64, 19] =[0, 3, 6, 9, 13, 16, 19, 23, 26, 29, 33, 36, 39, 43, 46, 49, 53, 56, 59]

fn shift_for(n: i64) -> u64 {
    if n < 19 {
        let k: u64 = int.narrow(n)
        SHIFTS[k]
    } else {
        60
    }
}

fn slow(fmt: Format, b: Bytes, at: u64, written: WrittenExponent) -> (u64, i64) {
    let mut d = decimal(b, at, written)
    if d.count == 0 || d.point < -324 {
        return (0, 0)
    }
    if d.point >= 310 {
        return (0, fmt.inf)
    }
    let mut e2: i64 = 0
    while d.point > 0 {
        let k = shift_for(d.point)
        shift_right(mut d, k)
        if d.point < -2047 {
            return (0, 0)
        }
        let step: i64 = int.narrow(k)
        e2 += step
    }
    while d.point <= 0 {
        let k: u64 = if d.point == 0 {
            if d.digits[0] >= 5 {
                break
            }
            if d.digits[0] <= 1 {
                2
            } else {
                1
            }
        } else {
            shift_for(-d.point)
        }
        shift_left(mut d, k)
        if d.point > 2047 {
            return (0, fmt.inf)
        }
        let step: i64 = int.narrow(k)
        e2 -= step
    }
    e2 -= 1
    while fmt.min_exp + 1 > e2 {
        let mut k = fmt.min_exp + 1 - e2
        if k > 60 {
            k = 60
        }
        shift_right(mut d, int.narrow(k))
        e2 += k
    }
    if e2 - fmt.min_exp >= fmt.inf {
        return (0, fmt.inf)
    }
    shift_left(mut d, fmt.bits + 1)
    let mut m = round_decimal(d)
    let top: u64 = 1 << (fmt.bits + 1)
    if m >= top {
        shift_right(mut d, 1)
        e2 += 1
        m = round_decimal(d)
        if e2 - fmt.min_exp >= fmt.inf {
            return (0, fmt.inf)
        }
    }
    let mut p2 = e2 - fmt.min_exp
    let hidden: u64 = 1 << fmt.bits
    if m < hidden {
        p2 -= 1
    }
    (m & (hidden - 1), p2)
}

/// The digits of b[at..], which `scan` accepted, as a Decimal.
fn decimal(b: Bytes, at: u64, written: WrittenExponent) -> Decimal {
    let mut d = Decimal(digits:[0; 768], count: 0, point: 0, truncated: false)
    let n = list.len(b)
    let mut i = at
    while i < n && b[i] == b'0' {
        i += 1
    }
    while i < n && int.is_ascii_digit(b[i]) {
        add_digit(mut d, b[i] - b'0')
        i += 1
    }
    if i < n && b[i] == b'.' {
        i += 1
        let first = i
        if d.count == 0 {
            while i < n && b[i] == b'0' {
                i += 1
            }
        }
        while i < n && int.is_ascii_digit(b[i]) {
            add_digit(mut d, b[i] - b'0')
            i += 1
        }
        let read: i64 = int.narrow(i - first)
        d.point = -read
    }
    if d.count != 0 {
        // Trailing zeros are not digits.
        let mut zeros: u64 = 0
        let mut j = i
        while j > at {
            j -= 1
            if b[j] == b'0' {
                zeros += 1
            } else if b[j] != b'.' {
                break
            }
        }
        d.count -= zeros
        let moved: i64 = int.narrow(zeros + d.count)
        d.point += moved
        if d.count > DIGITS {
            d.truncated = true
            d.count = DIGITS
        }
    }
    d.point = add_written(d.point, written)
    d
}

/// Appends digit x; past DIGITS only the count grows.
fn add_digit(mut d: Decimal, x: u8) {
    if d.count < DIGITS {
        d.digits[d.count] = x
    }
    d.count += 1
}

fn trim(mut d: Decimal) {
    while d.count != 0 && d.digits[d.count - 1] == 0 {
        d.count -= 1
    }
}

/// The integer part of d, rounded half to even; all ones when it has more than 18 digits.
fn round_decimal(d: Decimal) -> u64 {
    if d.count == 0 || d.point < 0 {
        return 0
    }
    if d.point > 18 {
        return ALL_ONES
    }
    let dp: u64 = int.narrow(d.point)
    let mut v: u64 = 0
    for i in 0 .. dp {
        v = v * 10
        if i < d.count {
            let x: u64 = int.widen(d.digits[i])
            v += x
        }
    }
    let mut up = false
    if dp < d.count {
        up = d.digits[dp] >= 5
        if d.digits[dp] == 5 && dp + 1 == d.count {
            up = d.truncated || (dp != 0 && d.digits[dp - 1] & 1 != 0)
        }
    }
    if up {
        v += 1
    }
    v
}

/// d divided by 2^k, k at most 60.
///
/// Every `10 * v + x` here has v below 2^k <= 2^60 and x <= 9, so it is below 2^64 - 2^62 and
/// the wrapping forms are exact (Rust's dec2flt decimal.rs uses plain arithmetic here too).
/// Checked forms would add an unreachable overflow branch to each digit step.
fn shift_right(mut d: Decimal, k: u64) {
    let mut r: u64 = 0
    let mut w: u64 = 0
    let mut v: u64 = 0
    while v >> k == 0 {
        if r < d.count {
            let x: u64 = int.widen(d.digits[r])
            v = int.wrapping_add(int.wrapping_mul(v, 10), x)
            r += 1
        } else if v == 0 {
            return
        } else {
            while v >> k == 0 {
                v = int.wrapping_mul(v, 10)
                r += 1
            }
            break
        }
    }
    let consumed: i64 = int.narrow(r)
    d.point -= consumed - 1
    if d.point < -2047 {
        d.count = 0
        d.point = 0
        d.truncated = false
        return
    }
    let mask: u64 = (1 << k) - 1
    while r < d.count {
        let x: u64 = int.widen(d.digits[r])
        let next: u8 = int.narrow(v >> k)
        v = int.wrapping_add(int.wrapping_mul(v & mask, 10), x)
        r += 1
        d.digits[w] = next
        w += 1
    }
    while v > 0 {
        let next: u8 = int.narrow(v >> k)
        v = int.wrapping_mul(v & mask, 10)
        if w < DIGITS {
            d.digits[w] = next
            w += 1
        } else if next > 0 {
            d.truncated = true
        }
    }
    d.count = w
    trim(mut d)
}

/// d multiplied by 2^k, k at most 60, written from the last digit back.
fn shift_left(mut d: Decimal, k: u64) {
    if d.count == 0 {
        return
    }
    let added = new_digits(d, k)
    let mut r = d.count
    let mut w = d.count + added
    let mut v: u64 = 0
    while r != 0 {
        r -= 1
        w -= 1
        let x: u64 = int.widen(d.digits[r])
        v += x << k
        let quotient = v / 10
        let digit: u8 = int.narrow(v - 10 * quotient)
        if w < DIGITS {
            d.digits[w] = digit
        } else if digit > 0 {
            d.truncated = true
        }
        v = quotient
    }
    while v > 0 {
        w -= 1
        let quotient = v / 10
        let digit: u8 = int.narrow(v - 10 * quotient)
        if w < DIGITS {
            d.digits[w] = digit
        } else if digit > 0 {
            d.truncated = true
        }
        v = quotient
    }
    d.count += added
    if d.count > DIGITS {
        d.count = DIGITS
    }
    let grown: i64 = int.narrow(added)
    d.point += grown
    trim(mut d)
}

/// How many digits multiplying d by 2^k adds in front: k + 1 - len(5^k), less one when
/// d's digits are below those of 5^k (Rust and Go read this from a table; here the digits
/// of 5^k are computed, at most 42 of them).
fn new_digits(d: Decimal, k: u64) -> u64 {
    let mut p: Inline[u8, 42] =[0; 42]
    p[0] = 1
    let mut len: u64 = 1
    for _ in 0 .. k {
        // p = p x 5, from the last digit back.
        let mut carry: u8 = 0
        let mut i = len
        while i > 0 {
            i -= 1
            let x = p[i] * 5 + carry
            p[i] = x % 10
            carry = x / 10
        }
        if carry > 0 {
            let mut j = len
            while j > 0 {
                p[j] = p[j - 1]
                j -= 1
            }
            p[0] = carry
            len += 1
        }
    }
    let whole = k + 1 - len
    for i in 0 .. len {
        if i >= d.count {
            return whole - 1
        }
        if d.digits[i] != p[i] {
            return if d.digits[i] < p[i] {
                whole - 1
            } else {
                whole
            }
        }
    }
    whole
}


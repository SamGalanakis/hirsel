// L41 and L51(l). Read AP3, AP8, AP14 and AP20 directly from the files.
// The physical index is keyed by pack and offset: dead frames in a listed
// pack may repeat a live stamp and still count toward that pack's totals.
type LawLocationSource: key = LawPage(u64) | LawBranch(u64, u8) | LawPin(pages.PinOwner, String, u8) | LawList(u8)

type LawLocationTree: key = LawCollections | LawData | LawPacks | LawRows

type LawLocationFrame {
    place: std.page.PagePtr,
    class: u8,
    outgoing: List[u64]
}

type LawLocationGraph {
    next_pack: u64,
    next_stamp: u64,
    physical: Map[(u64, u64), std.page.PagePtr],
    packs: Map[u64, pages.PagePack],
    listed: Map[u64, pages.PagePack],
    frames: Map[u64, LawLocationFrame],
    incoming: Map[(u64, LawLocationSource), u64]
}

fn law_read_location_ptr(raw: Bytes, at: u64) -> std.page.PagePtr {
    std.page.PagePtr(pack: list.word_le(raw, at), offset: list.word_le(raw, at + 8), len: list.word_le(raw, at + 16), checksum: list.word_le(raw, at + 20), stamp: list.word_le(raw, at + 28))
}

fn law_scan_location_pack(mut graph: LawLocationGraph, seq: u64, class: u8, raw: Bytes) {
    if let Some(pack) = map.get(graph.packs, seq) {
        if pack.class != class {
            fail("location law: pack used in two classes")
        }
        return
    }
    let header_sequence: u64 = list.word_le(raw, 56)
    if seq == 0 || seq >= graph.next_pack || header_sequence != seq {
        fail("location law: pack sequence")
    }
    let kind = if class == 1 {
        0x0022u16
    } else {
        0x0021u16
    }
    let mut pack = pages.PagePack(class: class, frames: 0, live: 0, payload_bytes: 0, index: 0)
    let mut at = 72u64
    while at < list.len(raw) {
        let width: u32 = list.word_le(raw, at + 4)
        let size: u64 = int.widen(width)
        let body = at + 16
        let end = body + size
        let minimum = if class == 1 {
            8u64
        } else {
            24u64
        }
        let actual_kind: u16 = list.word_le(raw, at)
        if end > list.len(raw) || size < minimum || actual_kind != kind {
            fail("location law: pack frame")
        }
        let stamp: u64 = list.word_le(raw, if class == 1 {
            body
        } else {
            body + 8
        })
        if stamp == 0 || stamp >= graph.next_stamp {
            fail("location law: frame stamp watermark")
        }
        let checksum = std.check.xxh3(raw, if class == 1 {
            body + 8
        } else {
            body
        }, end)
        let ptr = std.page.PagePtr(pack: seq, offset: at, len: width, checksum: checksum, stamp: stamp)
        map.insert(mut graph.physical, (seq, at), ptr)
        pack.frames += 1
        pack.payload_bytes += size
        at = end
    }
    map.insert(mut graph.packs, seq, pack)
}

fn law_location_key(raw: Bytes, row: u64, cell: u64) -> u64 {
    let prefix_width = format.read_le(raw, 4, 2)
    let suffix_width = cell - row - 2
    if prefix_width + suffix_width != 8 {
        fail("location law: pack-list key")
    }
    let mut key: Bytes = list.with_capacity(8)
    list.append(mut key, list.slice(raw, 24, 24 + prefix_width))
    list.append(mut key, list.slice(raw, row + 2, cell))
    list.word_be(key, 0)
}

fn law_read_location_list_row(mut graph: LawLocationGraph, tree: LawLocationTree, page: Bytes, row: u64, cell: u64) {
    let seq = law_location_key(page, row, cell)
    if seq == 0 || seq >= graph.next_pack || page[cell] != 0 {
        fail("location law: pack-list row")
    }
    let width = format.read_le(page, cell + 1, 2)
    let value = cell + 3
    if width != 29 || page[value] > 1 || map.contains(graph.listed, seq) {
        fail("location law: listed pack row")
    }
    let pack = pages.PagePack(class: page[value], frames: list.word_le(page, value + 1), live: list.word_le(page, value + 5), payload_bytes: list.word_le(page, value + 13), index: list.word_le(page, value + 21))
    map.insert(mut graph.listed, seq, pack)
}

fn law_follow_location(d: Dir, mut graph: LawLocationGraph, ptr: std.page.PagePtr, class: u8, tree: LawLocationTree, source: LawLocationSource) -> Result[(), Error] waits {
    law_follow_bounded(d, mut graph, ptr, class, tree, source, None, None)
}

// AP3's bounds: every key under a branch entry is at or above its logical
// separator and below the next entry's, inherited down the tree. Unsigned
// byte order, as the pager compares keys.
fn law_bytes_below(a: Bytes, b: Bytes) -> bool {
    list.compare_bytes(a, b) == Less
}

fn law_within(key: Bytes, lo: Option[Bytes], hi: Option[Bytes]) -> bool {
    let above = match lo {
        Some(low) => !law_bytes_below(key, low),
        None => true,
    }
    let under = match hi {
        Some(high) => law_bytes_below(key, high),
        None => true,
    }
    above && under
}

// An entry's logical key or separator: the page prefix, then its suffix.
// A branch's entry 0 is empty and takes no prefix.
fn law_entry_key(page: Bytes, row: u64, cell: u64, first_branch: bool) -> Bytes {
    let mut key: Bytes = list.new()
    if first_branch {
        return take key
    }
    list.append(mut key, list.slice(page, 24, 24 + format.read_le(page, 4, 2)))
    list.append(mut key, list.slice(page, row + 2, cell))
    take key
}

fn law_bound(b: Option[Bytes]) -> Result[Option[Bytes], Error] {
    match b {
        Some(at) => Ok(Some(failure_result_from_rep(types.copied(at))?)),
        None => Ok(None),
    }
}

fn law_follow_bounded(d: Dir, mut graph: LawLocationGraph, ptr: std.page.PagePtr, class: u8, tree: LawLocationTree, source: LawLocationSource, lo: Option[Bytes], hi: Option[Bytes]) -> Result[(), Error] waits {
    if ptr.stamp == 0 {
        if ptr != std.page.PagePtr(pack: 0, offset: 0, len: 0, checksum: 0, stamp: 0) {
            fail("location law: empty pointer")
        }
        return Ok(())
    }
    let edge: (u64, LawLocationSource) = (ptr.stamp, clone(source))
    let occurrences = map.get_or(graph.incoming, edge, 0)
    map.insert(mut graph.incoming, take edge, occurrences + 1)
    if let Some(prior) = map.get(graph.frames, ptr.stamp) {
        if prior.place != ptr || prior.class != class {
            fail("location law: conflicting live pointers")
        }
        return Ok(())
    }
    let raw = disk_read_paged_file(d, paged_pack_path(ptr.pack)?, 67108864)?
    law_scan_location_pack(mut graph, ptr.pack, class, raw)
    if let Some(physical) = map.get(graph.physical, (ptr.pack, ptr.offset)) {
        if physical != ptr {
            fail("location law: pointer does not match its physical frame")
        }
    } else {
        fail("location law: missing physical frame")
    }
    let mut pack: pages.PagePack = clone(option.unwrap(map.get(graph.packs, ptr.pack)))
    let width: u64 = int.widen(ptr.len)
    pack.live += width
    map.insert(mut graph.packs, ptr.pack, pack)
    let mut frame = LawLocationFrame(place: ptr, class: class, outgoing: list.new())
    if class != 1 {
        let page = list.slice(raw, ptr.offset + 16, ptr.offset + 16 + width)
        let slots = format.read_le(page, 2, 2)
        let on_branch = page[0u64] != 0
        let mut slot = list.len(page) - 2 * slots
        let mut previous: Option[Bytes] = None
        while slot < list.len(page) {
            let row = format.read_le(page, slot, 2)
            let cell = row + 2 + format.read_le(page, row, 2)
            let first = slot == list.len(page) - 2 * slots
            slot += 2
            let key = law_entry_key(page, row, cell, on_branch && first)
            if on_branch && first {
                if format.read_le(page, row, 2) != 0 {
                    fail("location law: a branch's entry 0 has a separator")
                }
            } else {
                if !law_within(key, lo, hi) {
                    fail("location law: a key or separator outside its parent's bounds")
                }
                if let Some(before) = previous {
                    if !law_bytes_below(before, key) {
                        fail("location law: keys out of order in a page")
                    }
                }
            }
            // A branch child's bounds: this separator (entry 0 inherits the
            // page's low bound) up to the next entry's separator.
            let child_lo = if on_branch && first {
                law_bound(lo)?
            } else {
                Some(failure_result_from_rep(types.copied(key))?)
            }
            let child_hi = if on_branch && slot < list.len(page) {
                let next_row = format.read_le(page, slot, 2)
                Some(law_entry_key(page, next_row, next_row + 2 + format.read_le(page, next_row, 2), false))
            } else {
                law_bound(hi)?
            }
            if !(on_branch && first) {
                previous = Some(failure_result_from_rep(types.copied(key))?)
            }
            let mut child_class = class
            let mut child_tree = tree
            let child = if page[0u64] != 0 {
                law_read_location_ptr(page, cell)
            } else if tree == LawCollections {
                child_tree = LawData
                law_read_location_ptr(page, cell + 3)
            } else if class == 2 && tree == LawRows {
                continue
            } else if class == 2 {
                law_read_location_list_row(mut graph, tree, page, row, cell)
                continue
            } else if page[cell] == 1 {
                child_class = 1
                let body = cell + 1
                std.page.PagePtr(pack: list.word_le(page, body + 24), offset: list.word_le(page, body + 32), len: int.truncate(8 + format.read_le(page, body + 8, 8)), checksum: list.word_le(page, body + 16), stamp: list.word_le(page, body))
            } else {
                if page[cell] != 0 {
                    fail("location law: value tag")
                }
                continue
            }
            if child.stamp != 0 {
                // AP20 orders all owning edges in the file. It also makes the
                // recursion acyclic before a frame enters the live index.
                if child.pack > ptr.pack || (child.pack == ptr.pack && child.offset >= ptr.offset) {
                    fail("location law: child does not precede its parent")
                }
                list.push(mut frame.outgoing, child.stamp)
            }
            // A collection root starts a new key space; a blob has no keys.
            if on_branch {
                law_follow_bounded(d, mut graph, child, child_class, child_tree, LawPage(ptr.stamp), child_lo, child_hi)?
            } else {
                law_follow_location(d, mut graph, child, child_class, child_tree, LawPage(ptr.stamp))?
            }
        }
    }
    map.insert(mut graph.frames, ptr.stamp, take frame)
    Ok(())
}

fn law_same_pack(a: pages.PagePack, b: pages.PagePack) -> bool {
    a.class == b.class && a.frames == b.frames && a.live == b.live && a.payload_bytes == b.payload_bytes && a.index == b.index
}

fn law_parse_locations(d: Dir) -> Result[LawLocationGraph, Error] waits {
    let raw = disk_read_paged_file(d, "MANIFEST", 16384)?
    let manifest_kind: u16 = list.word_le(raw, 72)
    if manifest_kind != 0x0031 || format.read_le(raw, 76, 4) + 88 != list.len(raw) {
        fail("location law: MANIFEST frame")
    }
    let mut graph = LawLocationGraph(next_pack: list.word_le(raw, 128), next_stamp: list.word_le(raw, 112), physical: map.new(), packs: map.new(), listed: map.new(), frames: map.new(), incoming: map.new())
    law_follow_location(d, mut graph, law_read_location_ptr(raw, 324), 2, LawPacks, LawList(0))?
    // `lineage` at 168 and `deferred_frees` at 204: class-2 trees whose rows
    // name no pack the inventory counts.
    law_follow_location(d, mut graph, law_read_location_ptr(raw, 168), 2, LawRows, LawList(3))?
    law_follow_location(d, mut graph, law_read_location_ptr(raw, 204), 2, LawRows, LawList(2))?
    let branches = format.read_le(raw, 360, 4)
    let mut at = 364u64
    for _ in 0u64 .. branches {
        let id = format.read_le(raw, at, 4)
        let name_bytes = format.read_le(raw, at + 4, 2)
        let roots = at + 34 + name_bytes
        for tree in 0u8 .. 3 {
            let tree_slot: u64 = int.widen(tree)
            let ptr = law_read_location_ptr(raw, roots + 36 * tree_slot)
            law_follow_location(d, mut graph, ptr, 0, if tree == 0 {
                LawCollections
            } else {
                LawData
            }, LawBranch(id, tree))?
        }
        if raw[roots + 108] != 0 {
            fail("location law: unexpected merge base")
        }
        at = roots + 109
    }
    let pins = format.read_le(raw, at, 4)
    at += 4
    for _ in 0u64 .. pins {
        let owner: pages.PinOwner = match raw[at] {
            1 => ApplicationPin,
            2 => ProjectorPin,
            _ => fail("location law: pin owner"),
        }
        let name_bytes: u64 = int.widen(raw[at + 1])
        let name = result.unwrap(string.from_utf8(failure_result_from_rep(types.copied(list.slice(raw, at + 2, at + 2 + name_bytes)))?))
        let roots = at + 14 + name_bytes
        for tree in 0u8 .. 3 {
            let tree_slot: u64 = int.widen(tree)
            let ptr = law_read_location_ptr(raw, roots + 36 * tree_slot)
            law_follow_location(d, mut graph, ptr, 0, if tree == 0 {
                LawCollections
            } else {
                LawData
            }, LawPin(owner, clone(name), tree))?
        }
        at = roots + 116
    }
    if at != list.len(raw) {
        fail("location law: trailing MANIFEST bytes")
    }
    let listed: Map[u64, pages.PagePack] = clone(graph.listed)
    for (seq, row) in listed {
        if !map.contains(graph.packs, seq) {
            let pack = disk_read_paged_file(d, paged_pack_path(seq)?, 67108864)?
            law_scan_location_pack(mut graph, seq, row.class, pack)
        }
    }
    for (seq, pack) in graph.packs {
        if pack.class != 2 {
            let Some(row) = map.get(graph.listed, seq) else {
                fail("location law: unlisted data pack")
            }
            if !law_same_pack(row, pack) {
                fail("location law: pack-list totals disagree with frames")
            }
        }
    }
    Ok(take graph)
}

fn law_compare_locations(db: Db) -> Result[LawLocationGraph, Error] waits {
    let disk = disk_state(db)
    let oracle = law_parse_locations(log_directory(db)?)?
    let known = view disk.pages.locations
    if disk_index_len(known.frames) != map.len(oracle.frames) || disk_index_len(known.packs) != map.len(oracle.packs) {
        fail("location law: inventory size")
    }
    let mut pin_names: Map[u64, (pages.PinOwner, String)] = map.new()
    let mut seen_names: Map[(pages.PinOwner, String), ()] = map.new()
    for held in pages.holder_pins(db.holders) {
        let key: (pages.PinOwner, String) = (held.owner, clone(held.name))
        if map.contains(pin_names, held.serial) || map.contains(seen_names, key) {
            fail("location law: pin names and serials must be one-to-one")
        }
        map.insert(mut pin_names, held.serial, clone(key))
        map.insert(mut seen_names, take key, ())
    }
    let mut incoming: Map[(u64, LawLocationSource), u64] = map.new()
    for (stamp, frame) in oracle.frames {
        let Some(live_bytes) = disk_index_get(known.frames, stamp) else {
            fail("location law: missing live stamp")
        }
        if live_bytes.place != frame.place || live_bytes.class != frame.class || live_bytes.outgoing != frame.outgoing {
            fail("location law: installed location or outgoing edges differ")
        }
        for owner in live_bytes.incoming {
            let source = match owner {
                PageSource(parent) => LawPage(parent),
                HolderSource(0, id, tree) => LawBranch(id, tree),
                HolderSource(1, serial, tree) => {
                    let (pin_owner, name) = option.unwrap(map.get(pin_names, serial))
                    LawPin(pin_owner, clone(name), tree)
                },
                ListSource(which) => LawList(which),
                _ => fail("location law: unknown installed holder"),
            }
            let live_stamp: u64 = stamp
            let edge = (live_stamp, take source)
            let occurrences = map.get_or(incoming, edge, 0)
            map.insert(mut incoming, take edge, occurrences + 1)
        }
    }
    if map.len(incoming) != map.len(oracle.incoming) {
        fail("location law: incoming edge keys differ")
    }
    for (expected_edge, expected_count) in oracle.incoming {
        if map.get_or(incoming, expected_edge, 0) != expected_count {
            fail("location law: incoming edge multiplicity differs")
        }
    }
    for (seq, pack) in oracle.packs {
        let Some(live_bytes) = disk_index_get(known.packs, seq) else {
            fail("location law: missing pack")
        }
        if !law_same_pack(live_bytes, pack) {
            fail("location law: installed pack totals differ")
        }
    }
    Ok(take oracle)
}

fn law_location_collection(graph: LawLocationGraph, source: LawLocationSource) -> u64 {
    for ((stamp, owner), _) in graph.incoming {
        if owner == source {
            let root = option.unwrap(map.get(graph.frames, stamp))
            return root.outgoing[0u64]
        }
    }
    fail("location law: holder has no collection map")
}

fn law_location_of(graph: LawLocationGraph, stamp: u64) -> std.page.PagePtr {
    option.unwrap(map.get(graph.frames, stamp)).place
}

fn law_location_moved(before: LawLocationGraph, after: LawLocationGraph, stamp: u64) -> bool {
    let old = law_location_of(before, stamp)
    let new = law_location_of(after, stamp)
    old.pack != new.pack || old.offset != new.offset
}

fn law_location_commit(done: Outcome[(), Error]) -> Result[(), Error] {
    match done {
        Committed(_) => Ok(()),
        _ => fail("location law: expected commit"),
    }
}

fn check_location_relocations(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    // Three 1,100-byte values fit in a BLOB pack, four do not. The
    // unrelated inline page keeps the old data pack dense after P moves.
    options.pack_bytes = 3500
    let mut db = open(tasks, d, c, r, options)?
    let codec = std.codec.of_bytes()
    let (rows, inline) = law_pair(mut db, "rows", std.codec.key_u64(), codec, "inline", std.codec.key_u64(), codec)?
    let mut large_value: Bytes = list.with_capacity(1100)
    list.fill(mut large_value, 1100, 31u8)
    law_location_commit(run(mut db, None, (copy_env(rows), copy_env(large_value)), fn(mut tx, call_env) -> Result[(), Error] {
        for k in 1u64 .. 7 {
            put(mut tx, call_env.0, k, call_env.1)?
        }
        Ok(())
    })?)?
    let _ = checkpoint(mut db)?
    let _ = law_compare_locations(db)?
    let all = snapshot(db)
    let (spares, _) = fork(mut db, "spares", all)?
    let mut filler: Bytes = list.with_capacity(600)
    list.fill(mut filler, 600, 42u8)
    law_location_commit(run(mut db, None, (copy_env(rows), copy_env(inline), copy_env(filler)), fn(mut tx, call_env) -> Result[(), Error] {
        let _ = delete(mut tx, call_env.0, 2)?
        let _ = delete(mut tx, call_env.0, 3)?
        let _ = delete(mut tx, call_env.0, 5)?
        let _ = delete(mut tx, call_env.0, 6)?
        for k in 1u64 .. 4 {
            put(mut tx, call_env.1, k, call_env.2)?
        }
        Ok(())
    })?)?
    let saved = snapshot(db)
    let _ = pin(mut db, "z-old", saved)?
    let _ = law_compare_locations(db)?
    let _ = pin(mut db, "a-old", saved)?
    let initial = law_compare_locations(db)?
    let parent = law_location_collection(initial, LawPin(ApplicationPin, "z-old", 0))
    let page = option.unwrap(map.get(initial.frames, parent))
    if list.len(page.outgoing) != 2 {
        fail("location law: expected two surviving blobs")
    }
    let first_blob = page.outgoing[0u64]
    let second_blob = page.outgoing[1u64]
    let old_parent = page.place
    if law_location_of(initial, first_blob).pack == law_location_of(initial, second_blob).pack {
        fail("location law: survivors must start in different packs")
    }
    // The pins now hold P; main and spares have different leaves that
    // still reference the two blobs. Dropping keys 2 and 3 moves only the
    // first blob and rewrites every live parent.
    law_location_commit(run(mut db, None, (copy_env(rows), copy_env(filler)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.0, 7, call_env.1)
    })?)?
    law_location_commit(run_on(mut db, spares, None, rows, fn(mut tx, call_env) -> Result[(), Error] {
        let _ = delete(mut tx, call_env, 2)?
        let _ = delete(mut tx, call_env, 3)?
        Ok(())
    })?)?
    let _ = checkpoint(mut db)?
    let first = law_compare_locations(db)?
    if !law_location_moved(initial, first, first_blob) || !law_location_moved(initial, first, parent) || law_location_moved(initial, first, second_blob) {
        fail("location law: first cut must move the first blob and its parent")
    }
    // Dropping the divergent fork now releases keys 5 and 6. The second
    // relocation has to use the current locations installed by the first.
    let _ = delete_branch(mut db, spares)?
    let second = law_compare_locations(db)?
    if law_location_moved(first, second, first_blob) || !law_location_moved(first, second, second_blob) || !law_location_moved(first, second, parent) {
        fail("location law: second cut must move the second blob and the same parent")
    }
    let dead_copy = option.unwrap(map.get(second.physical, (old_parent.pack, old_parent.offset)))
    if !map.contains(second.listed, old_parent.pack) || dead_copy != old_parent {
        fail("location law: old parent copy must remain in a listed pack")
    }
    let still_saved = option.unwrap(pinned(db, "a-old"))
    if list.len((changes(result.unwrap(reader(db, 0u64)), saved, still_saved)?).rows) != 0 {
        fail("location law: relocation changed pinned rows")
    }
    let _ = unpin(mut db, "z-old")?
    let remaining = law_compare_locations(db)?
    if law_location_collection(remaining, LawPin(ApplicationPin, "a-old", 0)) != parent {
        fail("location law: remaining pin must retain its ancestor")
    }
    let _ = unpin(mut db, "a-old")?
    let neither = law_compare_locations(db)?
    if map.contains(neither.frames, parent) {
        fail("location law: unpinned ancestor still live")
    }
    close(take db)
}

@test
fn disk_test_location_relocations(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    check_location_relocations(disk_test_directory(d), c, r, tasks)
}

// STORE-SPEC §1.2 walker, the index walker. Rows k = 1..12 hold walk_value(k):
// row 1 produces no entry, rows 10 and 11 two bucket entries each, and every
// value is distinct, so `uniq` is a valid Unique index. Each case corrupts one
// entry with a raw write and names the one finding a walk must report; the
// corrupted index alone must be demoted, counted as drift once, and walk
// clean once the builder has rebuilt it.
fn walk_value(k: u64) -> u64 {
    if k == 1 {
        0
    } else if k == 10 || k == 11 {
        1000 + k * 20
    } else if k == 12 {
        55
    } else {
        k * 13
    }
}

fn walk_bucket_keys(_k: u64, v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    if v == 0 {
        return Ok(take keys)
    }
    list.push(mut keys, v / 10)
    if v >= 1000 {
        list.push(mut keys, v / 10 + 1)
    }
    Ok(take keys)
}

fn walk_unique_keys(_k: u64, v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    if v != 0 {
        list.push(mut keys, v)
    }
    Ok(take keys)
}

fn walk_cover_keys(_k: u64, v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, v % 5)
    Ok(take keys)
}

fn walk_cover_payload(_k: u64, v: u64) -> Result[u64, Capacity] {
    Ok(v)
}

fn walk_total_parts(_k: u64, v: u64) -> Result[List[(u64, u64)], Capacity] {
    let mut parts: List[(u64, u64)] = list.new()
    list.push(mut parts, (v % 3, v))
    Ok(take parts)
}

type WalkFixture {
    db: Db,
    rows: Table[u64, u64],
    bucket: Index[u64, u64, u64, ()],
    uniq: Index[u64, u64, u64, ()],
    cover: Index[u64, u64, u64, u64],
    sums_index: Aggregate[u64]
}

fn walk_fixture(c: Clock) -> Result[WalkFixture, Error] waits {
    let mut db = test_db(c, 1073741824)
    let key = std.codec.key_u64()
    let mut d = declare(db, Migrate)?
    let mut items = declare_table(mut d, "items", key, std.codec.of_u64())?
    let bucket_ix = index(mut d, mut items, "bucket", Many, code.describe(walk_bucket_keys), key)?
    let uniq_ix = index(mut d, mut items, "uniq", Unique, code.describe(walk_unique_keys), key)?
    let cover_ix = covering(mut d, mut items, "cover", Many, code.describe(walk_cover_keys), key, code.describe(walk_cover_payload), std.codec.of_u64())?
    let sums_index = aggregate(mut d, mut items, "totals", code.describe(walk_total_parts), key)?
    let rows = finish(mut d, take items)?
    let _ = seal(mut db, take d)?
    for k in 1u64 .. 13 {
        if !typed_put(mut db, rows, k, walk_value(k)) {
            return Error(Foreign)
        }
    }
    Ok(WalkFixture(db: take db, rows: rows, bucket: bucket_ix, uniq: uniq_ix, cover: cover_ix, sums_index: sums_index))
}

// An index entry's key after its collection prefix: the index key, then the
// row's primary for a Many index.
fn walk_entry(j: u64, primary: Option[u64]) -> Bytes {
    let mut out: Bytes = list.new()
    std.codec.encode_key(std.codec.key_u64(), j, mut out)
    if let Some(p) = primary {
        std.codec.encode_key(std.codec.key_u64(), p, mut out)
    }
    take out
}

fn walk_stored(db: Db, id: u32, edited: Bytes) -> Result[Bytes, Error] {
    let p = logical_key(id, edited)?
    match pages.get_page_row(pages.holder_heads(db.holders)[0].roots.collections, p) {
        Some(v) => failure_result_from_rep(types.copied(v)),
        None => Error(Missing("walk fixture entry")),
    }
}

fn walk_edit(mut db: Db, id: u32, edited: Bytes, val: Option[Bytes]) -> Result[(), Error] {
    let cut = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[(), Error] {
        match val {
            Some(v) => put_bytes(mut tx, id, edited, v),
            None => if delete_bytes(mut tx, id, edited)? {
                Ok(())
            } else {
                Error(Missing("walk fixture entry"))
            },
        }
    })?
    match take cut {
        Committed(_) => Ok(()),
        _ => Error(Foreign),
    }
}

// Walks every index to the end, `limit` rows or entries a slice, calling
// `between` before each slice.
fn walk_all(mut db: Db, rows: Table[u64, u64], mode: WalkMode, limit: u64, between: scoped fn(mut Db, Table[u64, u64], u64) -> Result[(), Error] waits) -> Result[(List[WalkFinding], u64), Error] waits {
    let mut walk = begin_verify(mode)
    let mut found: List[WalkFinding] = list.new()
    let mut slices = 0u64
    loop {
        if slices > 1000 {
            fail("§1.2 walker: the walk never ended")
        }
        if let None = walk.sums {
            between(mut db, rows, slices)?
        }
        let report = verify_step(mut db, mut walk, limit)?
        slices += 1
        for f in report.findings {
            list.push(mut found, WalkFinding(index: clone(f.index), entry: failure_result_from_rep(types.copied(f.entry))?, fault: f.fault))
        }
        if report.done {
            return Ok((take found, report.checked))
        }
    }
}

fn walk_still(mut _db: Db, _rows: Table[u64, u64], _slice: u64) -> Result[(), Error] {
    Ok(())
}

fn walk_serves[P](db: Db, ix: Index[u64, u64, u64, P]) -> Result[bool, Error] waits {
    match find(result.unwrap(reader(db, 0u64)), snapshot(db), ix, Unbounded, Unbounded) {
        Ok(_) => Ok(true),
        Error(NotReady(_)) => Ok(false),
        Error(take e) => Error(take e),
    }
}

fn walk_fault_is(a: WalkFault, b: WalkFault) -> bool {
    match (a, b) {
        (Missing, Missing) => true,
        (Extra, Extra) => true,
        (Payload, Payload) => true,
        _ => false,
    }
}

// One corruption: `which` names the index, and
// `edited`/`val` the raw edit of its collection.
fn walk_corrupt_case(c: Clock, which: u64, edited: Bytes, val: Option[Bytes], fault: WalkFault, also: Option[WalkFault]) -> Result[(), Error] waits {
    let mut fx = walk_fixture(c)?
    let (id, name) = if which == 0 {
        (fx.bucket.id, "bucket")
    } else if which == 1 {
        (fx.uniq.id, "uniq")
    } else if which == 2 {
        (fx.cover.id, "cover")
    } else {
        (fx.sums_index.id, "totals")
    }
    walk_edit(mut fx.db, id, edited, val)?
    match trust_store(mut fx.db) {
        Error(Drift(found_name)) if found_name == name => (),
        _ => fail("§1.2 walker: the trust check must reject the corrupted index"),
    }
    // Report mode (hirsel store verify) walks the index on past a finding, so
    // an entry wrong from both sides is reported again by the entries phase
    // (`also`); it changes nothing: every index still serves, no drift, no commit.
    let head = pages.holder_heads(fx.db.holders)[0].head
    let (reported, _) = walk_all(mut fx.db, fx.rows, Report, 3, walk_still)?
    if which == 3 {
        let mut sums_walked = false
        for seen in walk_coverage(fx.db)? {
            if seen.index == name {
                if let Walked = seen.coverage {
                    sums_walked = true
                }
            }
        }
        if !sums_walked {
            fail("§1.2 walker: coverage skipped the bound Public aggregate")
        }
    }
    let mut expected: List[WalkFault] = list.new()
    list.push(mut expected, fault)
    if let Some(second) = also {
        list.push(mut expected, second)
    }
    if list.len(reported) != list.len(expected) {
        fail("§1.2 walker: a report walk gave the wrong number of findings")
    }
    for i in 0u64 .. list.len(expected) {
        if reported[i].index != name || reported[i].entry != logical_key(id, edited)? || !walk_fault_is(reported[i].fault, expected[i]) {
            fail("§1.2 walker: a report finding names the wrong index, entry or fault")
        }
    }
    if !walk_serves(fx.db, fx.bucket)? || !walk_serves(fx.db, fx.uniq)? || !walk_serves(fx.db, fx.cover)? {
        fail("§1.2 walker: a report walk demoted an index")
    }
    if list.len(attention(fx.db)?.drift) != 0 || pages.holder_heads(fx.db.holders)[0].head != head {
        fail("§1.2 walker: a report walk wrote to the store")
    }
    let (found, _) = walk_all(mut fx.db, fx.rows, Repair, 3, walk_still)?
    if list.len(found) != 1 {
        fail("§1.2 walker: a corrupted index must give exactly one finding")
    }
    if found[0].index != name || found[0].entry != logical_key(id, edited)? || !walk_fault_is(found[0].fault, fault) {
        fail("§1.2 walker: the finding names the wrong index, entry or fault")
    }
    let sums_serves = if let Public = lix_state(fx.db, "totals")? {
        true
    } else {
        false
    }
    let serving =[walk_serves(fx.db, fx.bucket)?, walk_serves(fx.db, fx.uniq)?, walk_serves(fx.db, fx.cover)?, sums_serves]
    for i in 0u64 .. 4 {
        if serving[i] != (i != which) {
            fail("§1.2 walker: the walk must demote the corrupted index and only it")
        }
    }
    let drift = attention(fx.db)?.drift
    if list.len(drift) != 1 || drift[0].index != name || drift[0].count != 1 {
        fail("§1.2 walker: a finding counts as drift once")
    }
    while let Some(_) = index_build_step(mut fx.db, 16)? {}
    let (again, _) = walk_all(mut fx.db, fx.rows, Repair, 3, walk_still)?
    if list.len(again) != 0 {
        fail("§1.2 walker: a rebuilt index still has findings")
    }
    Ok(())
}

// Between slices: overwrite, delete and put back rows under the walk. Values
// 2000 + 7s stay distinct from every fixture value and from each other.
fn walk_churn(mut db: Db, rows: Table[u64, u64], slice: u64) -> Result[(), Error] waits {
    let k = slice % 12 + 1
    if slice % 3 == 1 {
        let ran = run(mut db, None, (copy_env(rows), k), fn(mut tx, input) -> Result[(), Error] {
            let _ = delete(mut tx, input.0, input.1)?
            Ok(())
        })?
        if let Committed(_) = ran {} else {
            return Error(Foreign)
        }
    } else if !typed_put(mut db, rows, k, 2000 + 7 * slice) {
        return Error(Foreign)
    }
    Ok(())
}

fn walk_sum_across_commit(mut db: Db, rows: Table[u64, u64]) -> Result[(), Error] waits {
    let mut walk = begin_verify(Report)
    let mut changed = false
    for _ in 0u64 .. 200 {
        let report = verify_step(mut db, mut walk, 1)?
        if list.len(report.findings) != 0 {
            fail("§1.2 walker: folding across a commit made a false finding")
        }
        if report.done && changed {
            return Ok(())
        }
        if !changed {
            if let Some(_) = walk.sums {
                // Change the first row after the fold has already counted it.
                if !typed_put(mut db, rows, 1, 3010) {
                    return Error(Foreign)
                }
                changed = true
            }
        }
    }
    fail("§1.2 walker: the aggregate walk did not finish after a commit")
}

@test
fn test_index_walker_clean(c: Clock) -> Result[(), Error] waits {
    // Unchanged rows: bucket has 12 rows and 13 entries (rows 2..9 and 12 one
    // each, rows 10 and 11 two), uniq 12 rows and 11 entries, cover 12 and 12.
    let mut fx = walk_fixture(c)?
    let (found, checked) = walk_all(mut fx.db, fx.rows, Repair, 1000, walk_still)?
    if list.len(found) != 0 {
        fail("§1.2 walker: a clean store has findings")
    }
    if checked != 12 + 13 + 12 + 11 + 12 + 12 + 12 + 3 {
        fail("§1.2 walker: the walk skipped rows or entries")
    }
    // Two at a time, with the rows changing under the walk.
    let (churned, _) = walk_all(mut fx.db, fx.rows, Repair, 2, walk_churn)?
    if list.len(churned) != 0 {
        fail("§1.2 walker: writes between slices made a finding")
    }
    if list.len(attention(fx.db)?.drift) != 0 {
        fail("§1.2 walker: a clean walk counted drift")
    }
    if !walk_serves(fx.db, fx.bucket)? || !walk_serves(fx.db, fx.uniq)? || !walk_serves(fx.db, fx.cover)? {
        fail("§1.2 walker: a clean walk demoted an index")
    }
    walk_sum_across_commit(mut fx.db, fx.rows)?
    trust_store(mut fx.db)
}

@test
fn test_index_walker_corruptions(c: Clock, d: Dir, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let child = disk_test_directory(d)
    disk_crash_init(child, c, r, tasks, "checkpoint")?
    trust_directory(child)?
    // Change the first payload byte of a pack frame that MANIFEST points to.
    let (_, take manifest) = read_page_manifest_file(child)?
    let root = manifest.branches[0u64].roots.catalog
    let pack = paged_pack_path(root.pack)?
    let mut raw = disk_read_paged_file(child, pack, 67108864)?
    raw[root.offset + 16] = raw[root.offset + 16] ^ 1u8
    disk_write_synced(child, pack, raw)?
    match trust_directory(child) {
        Error(Corrupt(Fault(file: found_file, offset: found_at, why: Checksum))) if found_file == pack && found_at == root.offset => (),
        _ => fail("store trust: the structural walk must reject the damaged pack frame"),
    }
    let fx = walk_fixture(c)?
    // Row 2 (26): bucket 2, uniq 26, cover 1. Row 3 (39): uniq 39. Row 4 (52): cover 2.
    let any_bucket = walk_stored(fx.db, fx.bucket.id, walk_entry(2, Some(2)))?
    let owner_3 = walk_stored(fx.db, fx.uniq.id, walk_entry(39, None))?
    let payload_2 = walk_stored(fx.db, fx.cover.id, walk_entry(1, Some(2)))?
    // Missing: row 3's only bucket entry, and row 10's second (1200 -> 120, 121).
    walk_corrupt_case(c, 0, walk_entry(3, Some(3)), None, Missing, None)?
    walk_corrupt_case(c, 0, walk_entry(121, Some(10)), None, Missing, None)?
    // Extra: an entry for row 99, which does not exist.
    walk_corrupt_case(c, 0, walk_entry(5, Some(99)), Some(failure_result_from_rep(types.copied(any_bucket))?), Extra, None)?
    // Extra: row 12 (55) exists but produces bucket 5, not 2.
    walk_corrupt_case(c, 0, walk_entry(2, Some(12)), Some(failure_result_from_rep(types.copied(any_bucket))?), Extra, None)?
    // Payload: uniq 26 names row 3 as its owner. The rows phase reads row 2
    // first, which produces 26, and a Unique entry's owner is in its payload.
    // A report walk goes on to the entries phase: row 3 produces 39, not 26, so Extra.
    walk_corrupt_case(c, 1, walk_entry(26, None), Some(failure_result_from_rep(types.copied(owner_3))?), Payload, Some(Extra))?
    // Extra: uniq 999, which no row produces, names row 3, which produces 39.
    walk_corrupt_case(c, 1, walk_entry(999, None), Some(failure_result_from_rep(types.copied(owner_3))?), Extra, None)?
    // Payload: row 4's cover entry carries row 2's projection, 26 for 52,
    // seen from row 4 and again from the entry.
    walk_corrupt_case(c, 2, walk_entry(2, Some(4)), Some(failure_result_from_rep(types.copied(payload_2))?), Payload, Some(Payload))?
    // Group 0 has rows. Group 3 has none. The zero payload is wrong for group 1.
    let mut wrong: Bytes = list.with_capacity(16)
    list.fill(mut wrong, 16, 0u8)
    walk_corrupt_case(c, 3, walk_entry(0, None), None, Missing, None)?
    walk_corrupt_case(c, 3, walk_entry(3, None), Some(failure_result_from_rep(types.copied(wrong))?), Extra, None)?
    walk_corrupt_case(c, 3, walk_entry(1, None), Some(take wrong), Payload, None)?
    Ok(())
}

// L41 (viii), separator bounds across nodes. The relocation fixture's trees
// are one leaf each, so this one is deep: 8,000 rows of 200 bytes, half at
// sequential keys (long shared prefixes, so short separators) and half at
// scattered ones, with every third row deleted again, give two branch levels.
// The oracle is AP3's order itself, checked by the independent parse.
@test
fn disk_test_location_separator_bounds(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let folder = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    let mut db = open(tasks, folder, c, r, options)?
    let (rows, _, _) = location_index_schema(mut db, Migrate)?
    let mut value: Bytes = list.with_capacity(200)
    list.fill(mut value, 200, 7u8)
    for batch in 0u64 .. 8 {
        law_location_commit(run(mut db, None, (copy_env(rows), copy_env(value), batch), fn(mut tx, call_env) -> Result[(), Error] {
            for i in 0u64 .. 500 {
                let n = call_env.2 * 500 + i
                put(mut tx, call_env.0, n, call_env.1)?
                put(mut tx, call_env.0, int.wrapping_mul(n + 1, 0x9E3779B97F4A7C15u64), call_env.1)?
            }
            Ok(())
        })?)?
    }
    value[0u64] = 8
    law_location_commit(run(mut db, None, (rows, take value), fn(mut tx, input) -> Result[(), Error] {
        for n in 0u64 .. 4000 {
            if n % 3 == 0 {
                let _ = delete(mut tx, input.0, n)?
            } else if n % 3 == 1 {
                put(mut tx, input.0, n, input.1)?
            }
        }
        Ok(())
    })?)?
    let _ = checkpoint(mut db)?
    let _ = law_compare_locations(db)?
    close(take db)?
    options.create = false
    let mut reopened = open(tasks, folder, c, r, options)?
    let indexed = location_index_schema(mut reopened, Open)?
    let Seen(Seen(value: take agrees, ..)) = look(reader(reopened, 0)?, snapshot(reopened), None, indexed, location_indexes_match)? else {
        fail("location law: the recovered index scan was refused")
    }
    if !agrees? {
        fail("location law: the recovered Many or Unique index differs from the table")
    }
    close(take reopened)
}

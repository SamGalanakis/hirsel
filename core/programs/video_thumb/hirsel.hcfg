        ("index.hirsel", "thumb"),
        ("decode.hirsel", "thumb"),
        ("output.hirsel", "thumb"),
    ],
    dependencies: [
        ("std", Toolchain(package: "std", major: 1, authority: [])),
        ("av1", Path(package: "hirsel.ai/av1", major: 1, path: "../av1", authority: [Foreign])),
        ("h264", Path(package: "hirsel.ai/h264", major: 1, path: "../h264", authority: [Foreign])),
        ("image_core", Path(package: "hirsel.ai/image_core", major: 1, path: "../image_core", authority: [])),
        ("image_pipeline", Path(
            package: "hirsel.ai/image_pipeline",
            major: 1,
            path: "../image_pipeline",

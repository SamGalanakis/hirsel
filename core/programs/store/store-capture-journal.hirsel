// The capture decoder retains only offsets into a checksummed frame.
type CaptureOp = CapturePut(u64, u64, u64, u64) | CaptureDelete(u64, u64, u64) | CaptureTrim(u32, u64, u64)

type CaptureOps {
    at: u64,
    left: u64
}

fn capture_data_ops(path: String, raw: Bytes) -> Result[CaptureOps, Error] {
    let mut at = 20u64
    let sections = failure_result_from_rep(format.disk_number(path, raw, mut at, 1))?
    if sections == 0 || sections > 4 {
        return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
    }
    let tag = failure_result_from_rep(format.disk_number(path, raw, mut at, 1))?
    if tag > 3 {
        return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
    }
    let op_count = if tag == 0 {
        failure_result_from_rep(format.disk_count(path, raw, mut at, 9))?
    } else {
        0u64
    }
    Ok(CaptureOps(at: at, left: op_count))
}

fn capture_blob_width(path: String, raw: Bytes, mut at: u64, limit: u64) -> Result[u64, Error] {
    let size = failure_result_from_rep(format.disk_number(path, raw, mut at, 4))?
    if size > limit || size > list.len(raw) - at {
        return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
    }
    Ok(size)
}

fn capture_next_op(path: String, raw: Bytes, value_limit: u64, mut ops: CaptureOps) -> Result[Option[CaptureOp], Error] {
    if ops.left == 0 {
        return Ok(None)
    }
    ops.left -= 1
    let kind = failure_result_from_rep(format.disk_number(path, raw, mut ops.at, 1))?
    if kind == 3 {
        let at = ops.at
        if list.len(raw) - at < 20 {
            return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
        }
        let id: u32 = list.word_be(raw, at)
        ops.at += 20
        return Ok(Some(CaptureTrim(id, format.word_be(raw, at + 4), format.word_be(raw, at + 12))))
    }
    if kind != 1 && kind != 2 {
        return Error(failure_from_rep(format.disk_fault(path, ops.at - 1, Malformed)))
    }
    let key_len = capture_blob_width(path, raw, mut ops.at, 4096)?
    let key_at = ops.at
    ops.at += key_len
    let prior = failure_result_from_rep(format.disk_number(path, raw, mut ops.at, 4))?
    if key_len < 4 || prior > types.FORMAT_VALUE_MAX + 1 {
        return Error(failure_from_rep(format.disk_fault(path, key_at, Malformed)))
    }
    if kind == 2 {
        return Ok(Some(CaptureDelete(key_at, key_len, prior)))
    }
    let value_len = capture_blob_width(path, raw, mut ops.at, value_limit)?
    ops.at += value_len
    Ok(Some(CapturePut(key_at, key_len, value_len, prior)))
}

// The last refill is sized exactly to the selected end. Both the frame parser
// and host reads stop there, even when a live writer extends the file.
type CaptureChunk {
    raw: Bytes,
    base: u64,
    end: u64
}

fn new_capture_chunk(end: u64) -> CaptureChunk {
    CaptureChunk(raw: list.new(), base: end, end: end)
}

fn capture_chunk_at(mut file: HostFile, path: String, mut source: CaptureChunk, at: u64) -> Result[u64, Error] waits {
    if at >= source.base && at - source.base < list.len(source.raw) {
        return Ok(at - source.base)
    }
    source.raw = list.new()
    source.base = at
    source.raw = failure_result_from_rep(manifest.read_disk_bytes(mut file, path, at, order.min(JOURNAL_CHUNK_BYTES, source.end - at)))?
    Ok(0u64)
}

fn capture_prefix(mut file: HostFile, path: String, mut source: CaptureChunk, at: u64, size: u64) -> Result[Bytes, Error] waits {
    if at > source.end || size > source.end - at {
        return Error(failure_from_rep(format.disk_fault(path, at, Truncated)))
    }
    let mut raw = failure_result_from_rep(manifest.disk_read_buffer(size))?
    while list.len(raw) < size {
        let start = capture_chunk_at(mut file, path, mut source, at + list.len(raw))?
        let width = order.min(size - list.len(raw), list.len(source.raw) - start)
        list.append(mut raw, list.slice(source.raw, start, start + width))
    }
    Ok(take raw)
}

type CapturePayload: key = SkipPayload | KeepCommit | KeepEvents

fn capture_read_frame(mut file: HostFile, path: String, mut source: CaptureChunk, ctx: format.DiskContext, limits: StoreLimits, at: u64, keep: CapturePayload) -> Result[format.JournalFrame, Error] waits {
    let head = capture_prefix(mut file, path, mut source, at, 16)?
    let frame = failure_result_from_rep(manifest.disk_read_frame_head(path, head, at))?
    if frame.size > source.end - at - 16 {
        return Error(failure_from_rep(format.disk_fault(path, at, Truncated)))
    }
    let oversized = frame.kind == 0x0011 && frame.size > types.transaction_limit(limits_to_rep(limits))
    let retained = !oversized && ((keep == KeepCommit && frame.kind == 0x0011) || (keep == KeepEvents && format.journal_event_kind(frame.kind)))
    let mut payload = failure_result_from_rep(manifest.disk_read_buffer(if retained {
        frame.size
    } else {
        0u64
    }))?
    let mut check = failure_result_from_rep(types.capacity(format.disk_check_start(ctx, at, head)))?
    let end = at + 16 + frame.size
    let mut offset = at + 16
    while offset < end {
        let start = capture_chunk_at(mut file, path, mut source, offset)?
        let width = order.min(end - offset, list.len(source.raw) - start)
        std.check.add(mut check, source.raw, start, start + width)
        if retained {
            list.append(mut payload, list.slice(source.raw, start, start + width))
        }
        offset += width
    }
    if std.check.finish(check) != frame.checksum {
        return Error(failure_from_rep(format.disk_fault(path, at, Checksum)))
    }
    failure_result_from_rep(manifest.disk_check_frame_kind(path, ctx, frame.kind, frame.flags, at))?
    Ok(format.JournalFrame(end: end, kind: frame.kind, payload: if retained {
        Some(take payload)
    } else {
        None
    }))
}

fn capture_scan_frames[S](mut file: HostFile, id: StoreId, seq: u64, limits: StoreLimits, durable_end: u64, end: u64, torn: bool, keep: CapturePayload, mut state: S, consume: scoped[view] fn(mut S, String, u64, u16, Bytes) -> Result[(), Error]) -> Result[(u64, u64), Error] waits {
    let path = failure_result_from_rep(manifest.journal_path(seq, ""))?
    if durable_end < 72 || end < durable_end || failure_result_from_rep(manifest.disk_io(host.stat_file(mut file)))?.size < end {
        return Error(failure_from_rep(format.disk_fault(path, end, Truncated)))
    }
    let mut source = new_capture_chunk(end)
    let header = failure_result_from_rep(manifest.disk_read_header(path, capture_prefix(mut file, path, mut source, 0, 72)?, 2, Some(seq), optional_store_key_to_rep(Some(id))))?
    let mut at = 72u64
    let mut frames = 0u64
    while at < end {
        let frame = match capture_read_frame(mut file, path, mut source, header.context, limits, at, keep) {
            Ok(take good) => take good,
            Error(Corrupt(take fault)) => {
                if torn && at >= durable_end && format.journal_torn(why_to_rep(fault.why)) {
                    break
                }
                return Error(Corrupt(take fault))
            },
            Error(take problem) => return Error(take problem),
        }
        if at < durable_end && frame.end > durable_end {
            return Error(failure_from_rep(format.disk_fault(path, at, Truncated)))
        }
        if frame.kind == 0x0011 && frame.end - at - 16 > types.transaction_limit(limits_to_rep(limits)) {
            return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
        }
        if let Some(payload) = view frame.payload {
            consume(mut state, path, at, frame.kind, payload)?
        }
        frames += 1
        at = frame.end
    }
    Ok((at, frames))
}

/// A filesystem image. Its histories keep file bytes and directory entries
/// independently durable. Open handles belong to a single serving session.
pub opaque type Fs: send {
    nodes: List[Inode],
    sequence: u64,
    next_file: u64,
    // Serves and crashes so far, and receipts a full tap refused.
    mounts: u64,
    crashes: u64,
    dropped: u64,
    // Durable writes that are readable and not durable, and what the last
    // crash kept of each.
    pending: List[sim.fs_disk.Pending],
    torn: List[sim.world.Receipt]
}

type Inode: send {
    directory: bool,
    history: List[sim.fs_disk.Version],
    locks: Map[u64, bool]
}

type OpenFile {
    node: u64,
    identity: u64,
    readable: bool,
    writable: bool,
    append: bool,
    durable: bool,
    direct: bool,
    cursor: u64
}

type Listing {
    records: List[Bytes],
    next: u64
}

type Session {
    next_id: u64,
    site: u64,
    dirs: Map[u64, u64],
    files: Map[u64, OpenFile],
    listings: Map[u64, Listing],
    tap: Option[Sender[sim.world.Receipt]],
    // Per inode, the version whose damaged read was last reported.
    reported: Map[u64, u64]
}

fn inode(directory: bool) -> Inode {
    let mut history: List[sim.fs_disk.Version] = list.with_capacity(1)
    list.push(mut history, sim.fs_disk.empty())
    Inode(directory: directory, history: take history, locks: map.new())
}

/// Creates an empty filesystem. A new port from provide.dir mounts its root.
pub fn new() -> Fs {
    let mut nodes: List[Inode] = list.with_capacity(1)
    list.push(mut nodes, inode(true))
    Fs(nodes: take nodes, sequence: 0, next_file: 1, mounts: 0, crashes: 0, dropped: 0, pending: list.new(), torn: list.new())
}

/// Receipts a tapped server could not send: its tap was full or closed.
pub fn receipts_dropped(fs: Fs) -> u64 {
    fs.dropped
}

/// One `Torn` receipt per pending durable write the last `crash` reached.
pub fn torn_writes(fs: Fs) -> List[sim.world.Receipt] {
    clone(fs.torn)
}

fn node_path(fs: Fs, node: u64) -> String {
    for id in 0u64 .. list.len(fs.nodes) {
        for (name, child) in current(fs.nodes[id]).names {
            if child == node {
                let mut p = node_path(fs, id)
                string.push(mut p, "/")
                string.push(mut p, name)
                return take p
            }
        }
    }
    string.new()
}

fn emit(mut fs: Fs, session: Session, op: String, node: u64, range: (u64, u64, u64), fault: Option[sim.world.Fault], take outcome: sim.world.Outcome) {
    let r = sim.world.Receipt(mount: fs.mounts, site: session.site - 1, op: clone(op), node: node, path: node_path(fs, node), at: range.0, len: range.1, landed: range.2, fault: fault, outcome: take outcome, sequence: fs.sequence, crashes: fs.crashes)
    if let Some(tap) = session.tap {
        if let Error(_) = channel.try_send(tap, take r) {
            fs.dropped += 1
        }
    }
}

// Reports a read or stat whose answer differs from the written bytes, once per
// inode version and serve.
fn damaged_read(mut fs: Fs, mut session: Session, node: u64, op: String, at: u64, len: u64) {
    let seq = current(fs.nodes[node]).sequence
    if !map.contains(session.reported, node) || map.get(session.reported, node) != Some(view seq) {
        map.insert(mut session.reported, node, seq)
        emit(mut fs, session, op, node, (at, len, at), None, DamagedRead)
    }
}

// Withdraws the receipt of the current site: its reply never arrived.
fn undelivered(mut fs: Fs, mut session: Session, node: u64, op: String) {
    let _ = map.remove(mut session.reported, node)
    emit(mut fs, session, op, node, (0, 0, 0), None, Undelivered)
}

fn current(node: Inode) -> View[sim.fs_disk.Version] in node {
    node.history[list.len(node.history) - 1]
}

fn retain(mut node: Inode, at: u64) {
    let saved = list.set(mut node.history, at, sim.fs_disk.empty())
    list.clear(mut node.history)
    list.push(mut node.history, take saved)
}

// Makes a node's newest version durable, its pending writes included.
fn settle(mut fs: Fs, node: u64) {
    let latest = list.len(fs.nodes[node].history) - 1
    retain(mut fs.nodes[node], latest)
    list.retain(mut fs.pending, scoped fn(p: sim.fs_disk.Pending) -> bool {
        p.node != node
    })
}

/// Keeps every synced version plus the operations at or before one seeded
/// cut. An unsynced rename's two edits have the same sequence number. A
/// pending durable write is not cut whole: `sim.fs_disk.tear` then draws
/// the sectors it keeps, in inode order and then in issue order.
pub fn crash(mut fs: Fs, mut plan: sim.world.Plan) {
    let cut = sim.world.pick(mut plan, fs.sequence + 1)
    let pending = replace(mut fs.pending, list.new())
    list.clear(mut fs.torn)
    for i in 0u64 .. list.len(fs.nodes) {
        let mut at = list.len(fs.nodes[i].history) - 1
        while at > 0 && fs.nodes[i].history[at].sequence > cut {
            at -= 1
        }
        for p in pending {
            if p.node == i {
                if let Some(take t) = sim.fs_disk.tear(mut fs.nodes[i].history, p, mut at, mut plan) {
                    let r = sim.world.Receipt(mount: p.mount, site: p.site, op: string.from("write"), node: i, path: node_path(fs, i), at: p.at, len: p.len, landed: p.at, fault: None, outcome: Torn(take t), sequence: p.sequence, crashes: fs.crashes)
                    list.push(mut fs.torn, take r)
                }
            }
        }
        retain(mut fs.nodes[i], at)
        fs.nodes[i].locks = map.new()
    }
    fs.sequence = 0
    fs.crashes += 1
}

fn lookup(node: Inode, name: String) -> Option[u64] {
    match map.get(current(node).names, name) {
        Some(id) => Some(id),
        None => None
    }
}

fn parent(fs: Fs, start: u64, p: String) -> Result[u64, IoError] {
    if !path.is_valid(p) {
        return Error(Denied)
    }
    let end = string.byte_len(p)
    let mut at: u64 = 0
    let mut dir = start
    while let Some((part, next)) = string.next_split(p, at, "/") {
        if next > end {
            return Ok(dir)
        }
        dir = match lookup(fs.nodes[dir], part) {
            Some(id) => id,
            None => return Error(NotFound)
        }
        if !fs.nodes[dir].directory {
            return Error(Denied)
        }
        at = next
    }
    Error(Denied)
}

fn target(fs: Fs, dir: u64, name: String) -> Result[u64, IoError] {
    let root = parent(fs, dir, name)?
    match lookup(fs.nodes[root], path.name(name)) {
        Some(id) => Ok(id),
        None => Error(NotFound)
    }
}

fn payload(c: Call[DirOp], field: u64, n: u64) -> Result[Bytes, IoError] {
    let mut data: Bytes = list.with_capacity(n)
    provide.payload(c, field, mut data)
    if list.len(data) == n {
        Ok(take data)
    } else {
        Error(Closed)
    }
}

fn read_name(c: Call[DirOp], field: u64, n: u64) -> Result[String, IoError] {
    let raw = payload(c, field, n)?
    match string.from_utf8(take raw) {
        Ok(take text) => Ok(take text),
        Error(_) => Error(Denied)
    }
}

fn answer(mut s: Served[DirOp], take c: Call[DirOp], r: DirReply) -> bool {
    match provide.reply(mut s, take c, provide.dir_reply(r)) {
        Ok(()) => true,
        Error(_) => false
    }
}

fn refuse(mut s: Served[DirOp], take c: Call[DirOp], e: IoError) {
    let _ = answer(mut s, take c, Failed(e))
}

fn written_error(e: IoError) -> DirReply {
    WriteFailed(WriteError(written: 0, error: e))
}

fn stat(node: Inode) -> DirReply {
    let v = current(node)
    Stat(Stat(kind: if node.directory {
        Directory
    } else {
        File
    }, size: list.len(sim.fs_disk.visible(v)), modified_ns: v.modified))
}

// Answers a stat, reporting a size that differs from the written bytes.
fn stat_reply(mut fs: Fs, mut session: Session, node: u64, mut s: Served[DirOp], take c: Call[DirOp]) {
    let damaged = list.len(sim.fs_disk.visible(current(fs.nodes[node]))) != list.len(current(fs.nodes[node]).data)
    if damaged {
        damaged_read(mut fs, mut session, node, "stat", 0, 0)
    }
    if !answer(mut s, take c, stat(fs.nodes[node])) && damaged {
        undelivered(mut fs, mut session, node, "stat")
    }
}

fn close(mut fs: Fs, mut session: Session, id: u64) {
    let _ = map.remove(mut session.listings, id)
    if let Some(f) = map.remove(mut session.files, id) {
        let _ = map.remove(mut fs.nodes[f.node].locks, f.identity)
    }
}

fn edit(mut fs: Fs, id: u64, take v: sim.fs_disk.Version) {
    list.push(mut fs.nodes[id].history, take v)
}

fn insert_node(mut fs: Fs, dir: u64, take v: sim.fs_disk.Version, take node: Inode) {
    fs.sequence = v.sequence
    edit(mut fs, dir, take v)
    list.push(mut fs.nodes, take node)
}

fn file_handle(session: Session, id: u64) -> OpenFile {
    match map.get(session.files, id) {
        Some(f) => f,
        None => fail("unknown simulated file")
    }
}

fn dir_handle(session: Session, id: u64) -> u64 {
    if id == 0 {
        return 0
    }
    match map.get(session.dirs, id) {
        Some(dir) => dir,
        None => fail("unknown simulated directory")
    }
}

fn lock(mut fs: Fs, session: Session, id: u64, exclusive: bool, mut s: Served[DirOp], take c: Call[DirOp]) {
    let file = file_handle(session, id)
    let mut blocked = false
    for (holder, held_exclusive) in fs.nodes[file.node].locks {
        if holder != file.identity && (exclusive || held_exclusive == true) {
            blocked = true
        }
    }
    if !blocked {
        map.reserve(mut fs.nodes[file.node].locks, 1)
    }
    if answer(mut s, take c, Locked(!blocked)) {
        if blocked {
            let _ = map.remove(mut fs.nodes[file.node].locks, file.identity)
        } else {
            map.insert(mut fs.nodes[file.node].locks, file.identity, exclusive)
        }
    }
}

fn open(mut fs: Fs, mut session: Session, dir: u64, p: String, mode: OpenMode, suffix: Option[View[Bytes]], modified: i64, mut s: Served[DirOp], take call: Call[DirOp]) {
    let mut c = take call
    let base = match parent(fs, dir, p) {
        Ok(id) => id,
        Error(e) => return refuse(mut s, take c, e)
    }
    let leaf = path.name(p)
    let id = session.next_id
    let (readable, writable, append, create, truncate, durable, direct) = match mode {
        ReadDevice => (true, false, false, false, false, false, false),
        Read => (true, false, false, false, false, false, false),
        Write => (false, true, false, false, true, false, false),
        ReadWrite => (true, true, false, false, false, false, false),
        Append => (false, true, true, false, false, false, false),
        CreateNew => (false, true, false, true, false, false, false),
        Durable => (false, true, false, false, true, true, false),
        Direct => (false, true, false, false, true, true, true)
    }
    let existing = lookup(fs.nodes[base], leaf)
    let node = match existing {
        Some(node) => {
            if create || fs.nodes[node].directory {
                let e: IoError = if create {
                    Exists
                } else {
                    Denied
                }
                refuse(mut s, take c, e)
                return
            }
            node
        },
        None => {
            if !writable {
                refuse(mut s, take c, NotFound)
                return
            }
            list.len(fs.nodes)
        }
    }
    if let ReadDevice = mode {
        let _ = answer(mut s, take c, Failed(Other(host.DEVICE_READ_UNAVAILABLE)))
        return
    }
    map.reserve(mut session.files, 1)
    let seq = fs.sequence + 1
    if existing == None {
        let mut entry = sim.fs_disk.revised(current(fs.nodes[base]), seq, modified)
        map.insert(mut entry.names, string.from(leaf), node)
        let mut created = inode(false)
        created.history[0].modified = modified
        list.reserve(mut fs.nodes, 1)
        list.reserve(mut fs.nodes[base].history, 1)
        if let Some(b) = suffix {
            let _ = provide.fill(mut s, mut c, b)
        }
        if !answer(mut s, take c, File(id)) {
            return
        }
        insert_node(mut fs, base, take entry, take created)
    } else if truncate {
        list.reserve(mut fs.nodes[node].history, 1)
        let v = sim.fs_disk.Version(sequence: seq, modified: modified, data: list.new(), overlay: None, names: map.new())
        if !answer(mut s, take c, File(id)) {
            return
        }
        edit(mut fs, node, take v)
        fs.sequence = seq
    } else {
        if !answer(mut s, take c, File(id)) {
            return
        }
    }
    session.next_id += 1
    let identity = fs.next_file
    fs.next_file += 1
    map.insert(mut session.files, id, OpenFile(node: node, identity: identity, readable: readable, writable: writable, append: append, durable: durable, direct: direct, cursor: 0))
}

fn make_temp(mut fs: Fs, mut session: Session, dir: u64, n: u64, file: bool, modified: i64, mut s: Served[DirOp], take c: Call[DirOp]) {
    let prefix = match read_name(c, 1, n) {
        Ok(take p) => take p,
        Error(e) => return refuse(mut s, take c, e)
    }
    if string.find(prefix, 0, "/") != None || string.find(prefix, 0, "\0") != None {
        refuse(mut s, take c, Denied)
        return
    }
    let base = dir_handle(session, dir)
    let mut serial = list.len(fs.nodes)
    let (suffix, p) = loop {
        let mut suffix = string.from("sim")
        string.push_u64(mut suffix, serial)
        let mut p = string.from(prefix)
        string.push(mut p, suffix)
        if lookup(fs.nodes[base], p) == None {
            break (take suffix, take p)
        }
        serial += 1
    }
    if file {
        open(mut fs, mut session, base, p, CreateNew, Some(string.as_bytes(suffix)), modified, mut s, take c)
    } else {
        make_dir(mut fs, mut session, base, p, Some(string.as_bytes(suffix)), modified, mut s, take c)
    }
}

fn read(mut fs: Fs, mut session: Session, id: u64, offset: Option[u64], room: u64, mut s: Served[DirOp], take call: Call[DirOp]) {
    let mut c = take call
    let f = file_handle(session, id)
    if !f.readable {
        refuse(mut s, take c, Denied)
        return
    }
    let at = match offset {
        Some(at) => at,
        None => f.cursor
    }
    let (count, damaged) = {
        let v = current(fs.nodes[f.node])
        let data = sim.fs_disk.visible(v)
        let n = order.min(room, int.saturating_sub(list.len(data), at))
        let count: u64 = if n == 0 {
            0
        } else {
            provide.fill(mut s, mut c, list.slice(data, at, at + n))
        }
        (count, n != order.min(room, int.saturating_sub(list.len(v.data), at)) || (n != 0 && list.slice(data, at, at + n) != list.slice(v.data, at, at + n)))
    }
    if damaged {
        damaged_read(mut fs, mut session, f.node, "read", at, count)
    }
    let committed = answer(mut s, take c, Count(count))
    if !committed && damaged {
        undelivered(mut fs, mut session, f.node, "read")
    }
    if committed && offset == None {
        let _ = map.update(mut session.files, id, scoped fn(mut file: OpenFile) {
            file.cursor += count
        })
    }
}

// The version a write of `n` bytes starts from and its offset, or the reply
// that refuses it.
fn stage(fs: Fs, f: OpenFile, offset: Option[u64], n: u64, modified: i64) -> Result[(sim.fs_disk.Version, u64), DirReply] {
    if !f.writable || (f.append && offset != None) {
        return Error(written_error(Denied))
    }
    if f.direct {
        if let Some(at) = offset {
            if at % 4096 != 0 || n % 4096 != 0 {
                return Error(written_error(Other(22)))
            }
        }
    }
    if n == 0 {
        return Error(Done)
    }
    let v = sim.fs_disk.revised(current(fs.nodes[f.node]), fs.sequence + 1, modified)
    let at = if f.append {
        list.len(sim.fs_disk.visible(v))
    } else {
        match offset {
            Some(at) => at,
            None => f.cursor
        }
    }
    if int.checked_add(at, n) == None {
        return Error(written_error(Other(27)))
    }
    Ok((take v, at))
}

// The readable event of a durable write whose success is not delivered. Its
// bytes are visible; a sync or a later durable write makes them durable, and
// a power cut before that keeps a subset of its sectors.
fn pend(mut fs: Fs, session: Session, node: u64, take v: sim.fs_disk.Version, at: u64, len: u64) {
    if list.len(fs.pending) == sim.fs_disk.LIMIT {
        fail("sim.fs: too many pending durable writes")
    }
    list.push(mut fs.pending, sim.fs_disk.Pending(mount: fs.mounts, site: session.site - 1, node: node, sequence: v.sequence, at: at, len: len))
    fs.sequence = v.sequence
    edit(mut fs, node, take v)
}

// A refused write on a Durable or Direct handle still reached the disk.
// Returns its range, or an empty one when nothing was written.
fn refused_write(mut fs: Fs, session: Session, mut plan: sim.world.Plan, c: Call[DirOp], op: DirOp, modified: i64) -> (u64, u64) {
    let none: Option[u64] = None
    let (id, offset, field, n) = match op {
        Write(file: id, len: len) => (id, none, 1u64, len),
        WriteAt(file: id, at: at, len: len) => (id, Some(at), 2u64, len),
        _ => return (0, 0)
    }
    let f = file_handle(session, id)
    if f.durable {
        if let (Ok(data), Ok((take staged, at))) = (payload(c, field, n), stage(fs, f, offset, n, modified)) {
            let mut v = take staged
            let _ = sim.fs_disk.write(mut v, at, data, None, mut plan)
            pend(mut fs, session, f.node, take v, at, n)
            return (at, n)
        }
    }
    (0, 0)
}

fn write(mut fs: Fs, mut session: Session, mut plan: sim.world.Plan, fault: Option[sim.world.Fault], id: u64, offset: Option[u64], take data: Bytes, modified: i64, mut s: Served[DirOp], take c: Call[DirOp]) {
    let f = file_handle(session, id)
    let n = list.len(data)
    let (take staged, at) = match stage(fs, f, offset, n, modified) {
        Ok(take ready) => take ready,
        Error(r) => {
            let _ = answer(mut s, take c, r)
            return
        }
    }
    let mut v = take staged
    let effect = match fault {
        Some(scripted) => Some(scripted),
        None => sim.world.write_fault(mut plan),
    }
    let landed = sim.fs_disk.write(mut v, at, data, effect, mut plan)
    let damaging = match effect {
        Some(_) => true,
        None => false
    }
    if damaging {
        emit(mut fs, session, "write", f.node, (at, n, landed), effect, Acknowledged)
        if f.durable {
            emit(mut fs, session, "write", f.node, (at, n, landed), None, Persisted)
        }
    }
    list.reserve(mut fs.nodes[f.node].history, 1)
    if !answer(mut s, take c, Done) {
        if damaging {
            undelivered(mut fs, mut session, f.node, "write")
        } else if f.durable {
            pend(mut fs, session, f.node, take v, at, n)
        }
    } else {
        fs.sequence = v.sequence
        edit(mut fs, f.node, take v)
        if f.durable {
            settle(mut fs, f.node)
        }
        if offset == None {
            let _ = map.update(mut session.files, id, scoped fn(mut file: OpenFile) {
                file.cursor = at + n
            })
        }
    }
}

fn make_dir(mut fs: Fs, mut session: Session, dir: u64, p: String, suffix: Option[View[Bytes]], modified: i64, mut s: Served[DirOp], take call: Call[DirOp]) {
    let mut c = take call
    let base = match parent(fs, dir, p) {
        Ok(id) => id,
        Error(e) => return refuse(mut s, take c, e)
    }
    let leaf = path.name(p)
    if lookup(fs.nodes[base], leaf) != None {
        refuse(mut s, take c, Exists)
        return
    }
    let node = list.len(fs.nodes)
    let mut entry = sim.fs_disk.revised(current(fs.nodes[base]), fs.sequence + 1, modified)
    map.insert(mut entry.names, string.from(leaf), node)
    let mut created = inode(true)
    created.history[0].modified = modified
    list.reserve(mut fs.nodes, 1)
    list.reserve(mut fs.nodes[base].history, 1)
    let id = session.next_id
    let reply: DirReply = match suffix {
        Some(raw) => {
            map.reserve(mut session.dirs, 1)
            let _ = provide.fill(mut s, mut c, raw)
            Dir(id)
        },
        None => Done
    }
    let needs_handle = match suffix {
        Some(_) => true,
        None => false
    }
    if answer(mut s, take c, reply) {
        insert_node(mut fs, base, take entry, take created)
        if needs_handle {
            session.next_id += 1
            map.insert(mut session.dirs, id, node)
        }
    }
}

fn remove(mut fs: Fs, dir: u64, p: String, tree: bool, modified: i64, mut s: Served[DirOp], take c: Call[DirOp]) {
    let base = match parent(fs, dir, p) {
        Ok(id) => id,
        Error(e) => return refuse(mut s, take c, e)
    }
    let leaf = path.name(p)
    let node = match lookup(fs.nodes[base], leaf) {
        Some(id) => id,
        None => {
            refuse(mut s, take c, NotFound)
            return
        }
    }
    if tree && !fs.nodes[node].directory {
        refuse(mut s, take c, Denied)
        return
    }
    if !tree && map.len(current(fs.nodes[node]).names) != 0 {
        refuse(mut s, take c, Other(39))
        return
    }
    let mut v = sim.fs_disk.revised(current(fs.nodes[base]), fs.sequence + 1, modified)
    let _ = map.remove(mut v.names, leaf)
    list.reserve(mut fs.nodes[base].history, 1)
    if answer(mut s, take c, Done) {
        fs.sequence = v.sequence
        edit(mut fs, base, take v)
    }
}

fn rename(mut fs: Fs, dir: u64, from: String, to: String, modified: i64, mut s: Served[DirOp], take c: Call[DirOp]) {
    let bases = (parent(fs, dir, from), parent(fs, dir, to))
    let (old_base, new_base) = match bases {
        (Ok(old), Ok(dest)) => (old, dest),
        (Error(e), _) => return refuse(mut s, take c, e),
        (_, Error(e)) => return refuse(mut s, take c, e)
    }
    let old_name = path.name(from)
    let new_name = path.name(to)
    let node = match lookup(fs.nodes[old_base], old_name) {
        Some(id) => id,
        None => {
            refuse(mut s, take c, NotFound)
            return
        }
    }
    let destination = lookup(fs.nodes[new_base], new_name)
    let dest_is_dir = match destination {
        Some(id) => fs.nodes[id].directory,
        None => false
    }
    if fs.nodes[node].directory || dest_is_dir {
        refuse(mut s, take c, Denied)
        return
    }
    if destination == Some(node) {
        let _ = answer(mut s, take c, Done)
        return
    }
    let seq = fs.sequence + 1
    let mut source = sim.fs_disk.revised(current(fs.nodes[old_base]), seq, modified)
    let _ = map.remove(mut source.names, old_name)
    list.reserve(mut fs.nodes[old_base].history, 1)
    if old_base == new_base {
        map.insert(mut source.names, string.from(new_name), node)
        if answer(mut s, take c, Done) {
            edit(mut fs, old_base, take source)
            fs.sequence = seq
        }
    } else {
        let mut dest = sim.fs_disk.revised(current(fs.nodes[new_base]), seq, modified)
        map.insert(mut dest.names, string.from(new_name), node)
        list.reserve(mut fs.nodes[new_base].history, 1)
        if answer(mut s, take c, Done) {
            edit(mut fs, old_base, take source)
            edit(mut fs, new_base, take dest)
            fs.sequence = seq
        }
    }
}

fn listing(fs: Fs, dir: u64) -> Listing {
    let names = current(fs.nodes[dir]).names
    let mut rows: List[Bytes] = list.with_capacity(map.len(names))
    for (name, id) in names {
        let len = string.byte_len(name)
        let mut row: Bytes = list.with_capacity(3 + len)
        list.push(mut row, if fs.nodes[id].directory {
            1u8
        } else {
            0u8
        })
        let size: u16 = int.truncate(len)
        list.put_word_le(mut row, size)
        list.append(mut row, string.as_bytes(name))
        list.push(mut rows, take row)
    }
    Listing(records: take rows, next: 0)
}

fn next_entries(mut session: Session, id: u64, room: u64, mut s: Served[DirOp], take call: Call[DirOp]) {
    let mut c = take call
    let start = match map.get(session.listings, id) {
        Some(rows) => rows.next,
        None => fail("unknown simulated listing")
    }
    let mut next = start
    {
        let Some(l) = map.get(session.listings, id) else {
            fail("unknown simulated listing")
        }
        let mut used: u64 = 0
        while next < list.len(l.records) {
            let row = l.records[next]
            let n = list.len(row)
            if n > room - used {
                break
            }
            if provide.fill(mut s, mut c, row) != n {
                break
            }
            used += n
            next += 1
        }
    }
    let count = next - start
    if answer(mut s, take c, Count(count)) {
        let _ = map.update(mut session.listings, id, scoped fn(mut cursor: Listing) {
            cursor.next = next
        })
    }
}

fn sync(mut fs: Fs, mut session: Session, node: u64, op: String, fault: Option[sim.world.Fault], advanced: bool, mut s: Served[DirOp], take c: Call[DirOp]) {
    let error = io_fault(fault)
    let noted = error || (advanced && sim.fs_disk.visible(current(fs.nodes[node])) != current(fs.nodes[node]).data)
    if noted {
        emit(mut fs, session, op, node, (0, 0, 0), fault, if error {
            Barrier(advanced)
        } else {
            Persisted
        })
    }
    let r: DirReply = if error {
        Failed(Other(5))
    } else {
        Done
    }
    let delivered = answer(mut s, take c, r)
    if !delivered && noted {
        undelivered(mut fs, mut session, node, op)
    } else if delivered && advanced {
        settle(mut fs, node)
    }
}

fn io_fault(fault: Option[sim.world.Fault]) -> bool {
    match fault {
        Some(Eio) => true,
        Some(SyncUnknown) => true,
        _ => false,
    }
}

fn sync_commits(mut plan: sim.world.Plan, fault: Option[sim.world.Fault]) -> bool {
    match fault {
        Some(SyncUnknown) => sim.world.pick(mut plan, 2) == 1,
        Some(Eio) => false,
        _ => true,
    }
}

fn request(mut fs: Fs, mut session: Session, mut plan: sim.world.Plan, modified: i64, mut s: Served[DirOp], take c: Call[DirOp]) {
    let op = provide.dir_op(c)
    if let Released(id: id) = op {
        close(mut fs, mut session, id)
        return
    }
    let site = session.site
    session.site += 1
    let fault = sim.world.take_fault(mut plan, site)
    let barrier = match op {
        Sync(..) => true,
        SyncDir(..) => true,
        _ => false
    }
    if io_fault(fault) && !barrier {
        let node = match op {
            Write(file: id, ..) => file_handle(session, id).node,
            WriteAt(file: id, ..) => file_handle(session, id).node,
            Read(file: id, ..) => file_handle(session, id).node,
            ReadAt(file: id, ..) => file_handle(session, id).node,
            Close(file: id) => file_handle(session, id).node,
            _ => 0
        }
        let (at, n) = refused_write(mut fs, session, mut plan, c, op, modified)
        emit(mut fs, session, "refused", node, (at, n, at), fault, Refused)
        let r: DirReply = match op {
            Write(..) => written_error(Other(5)),
            WriteAt(..) => written_error(Other(5)),
            Close(file: id) => {
                close(mut fs, mut session, id);
                Failed(Other(5))
            },
            _ => Failed(Other(5))
        }
        if !answer(mut s, take c, r) {
            undelivered(mut fs, mut session, node, "refused")
        }
        return
    }
    match op {
        Open(dir: dir, path: n, mode: mode) => {
            match read_name(c, 1, n) {
                Ok(take p) => {
                    let base = dir_handle(session, dir)
                    open(mut fs, mut session, base, p, mode, None, modified, mut s, take c)
                },
                Error(e) => refuse(mut s, take c, e)
            }
        },
        OpenDir(dir: dir, path: n) => {
            let found = match read_name(c, 1, n) {
                Ok(take p) => target(fs, dir_handle(session, dir), p),
                Error(e) => Error(e)
            }
            match found {
                Ok(node) if fs.nodes[node].directory => {
                    let id = session.next_id
                    map.reserve(mut session.dirs, 1)
                    if answer(mut s, take c, Dir(id)) {
                        session.next_id += 1
                        map.insert(mut session.dirs, id, node)
                    }
                },
                Ok(_) => refuse(mut s, take c, Denied),
                Error(e) => refuse(mut s, take c, e)
            }
        },
        Mkdtemp(dir: dir, prefix: n, ..) => {
            make_temp(mut fs, mut session, dir, n, false, modified, mut s, take c)
        },
        Mkstemp(dir: dir, prefix: n, ..) => {
            make_temp(mut fs, mut session, dir, n, true, modified, mut s, take c)
        },
        Stat(dir: dir, path: n) => {
            let found = match read_name(c, 1, n) {
                Ok(take p) => target(fs, dir_handle(session, dir), p),
                Error(e) => Error(e)
            }
            match found {
                Ok(id) => stat_reply(mut fs, mut session, id, mut s, take c),
                Error(e) => refuse(mut s, take c, e)
            }
        },
        Mkdir(dir: dir, path: n) => {
            match read_name(c, 1, n) {
                Ok(take p) => {
                    let base = dir_handle(session, dir)
                    make_dir(mut fs, mut session, base, p, None, modified, mut s, take c)
                },
                Error(e) => refuse(mut s, take c, e)
            }
        },
        Remove(dir: dir, path: n) => {
            match read_name(c, 1, n) {
                Ok(take p) => remove(mut fs, dir_handle(session, dir), p, false, modified, mut s, take c),
                Error(e) => refuse(mut s, take c, e)
            }
        },
        RemoveTree(dir: dir, path: n) => {
            match read_name(c, 1, n) {
                Ok(take p) => remove(mut fs, dir_handle(session, dir), p, true, modified, mut s, take c),
                Error(e) => refuse(mut s, take c, e)
            }
        },
        Rename(dir: dir, from: a, to: b) => {
            match (read_name(c, 1, a), read_name(c, 2, b)) {
                (Ok(take from), Ok(take to)) => rename(mut fs, dir_handle(session, dir), from, to, modified, mut s, take c),
                (Error(e), _) => refuse(mut s, take c, e),
                (_, Error(e)) => refuse(mut s, take c, e)
            }
        },
        ZeroExtension(..) => {
            let _ = answer(mut s, take c, ZeroExtensionSupported(true))
        },
        SyncDir(dir: dir) => {
            let advanced = sync_commits(mut plan, fault)
            sync(mut fs, mut session, dir_handle(session, dir), "sync_dir", fault, advanced, mut s, take c)
        },
        Sync(file: id) => {
            let advanced = sync_commits(mut plan, fault)
            sync(mut fs, mut session, file_handle(session, id).node, "sync", fault, advanced, mut s, take c)
        },
        Entries(dir: dir, path: n) => {
            let base = dir_handle(session, dir)
            let found: Result[u64, IoError] = if n == 0 {
                Ok(base)
            } else {
                match read_name(c, 1, n) {
                    Ok(take p) => target(fs, base, p),
                    Error(e) => Error(e)
                }
            }
            match found {
                Ok(node) if fs.nodes[node].directory => {
                    let rows = listing(fs, node)
                    let id = session.next_id
                    map.reserve(mut session.listings, 1)
                    if answer(mut s, take c, Entries(id)) {
                        session.next_id += 1
                        map.insert(mut session.listings, id, take rows)
                    }
                },
                Ok(_) => refuse(mut s, take c, Denied),
                Error(e) => refuse(mut s, take c, e)
            }
        },
        Read(file: id, room: room) => {
            read(mut fs, mut session, id, None, room, mut s, take c)
        },
        ReadAt(file: id, at: at, room: room) => {
            read(mut fs, mut session, id, Some(at), room, mut s, take c)
        },
        Write(file: id, len: len) => {
            match payload(c, 1, len) {
                Ok(take data) => write(mut fs, mut session, mut plan, fault, id, None, take data, modified, mut s, take c),
                Error(e) => {
                    let _ = answer(mut s, take c, written_error(e))
                }
            }
        },
        WriteAt(file: id, at: at, len: len) => {
            match payload(c, 2, len) {
                Ok(take data) => write(mut fs, mut session, mut plan, fault, id, Some(at), take data, modified, mut s, take c),
                Error(e) => {
                    let _ = answer(mut s, take c, written_error(e))
                }
            }
        },
        StatFile(file: id) => {
            let node = file_handle(session, id).node
            stat_reply(mut fs, mut session, node, mut s, take c)
        },
        TryLock(file: id) => lock(mut fs, session, id, true, mut s, take c),
        TryLockShared(file: id) => lock(mut fs, session, id, false, mut s, take c),
        Unlock(file: id) => {
            let file = file_handle(session, id)
            if answer(mut s, take c, Done) {
                let _ = map.remove(mut fs.nodes[file.node].locks, file.identity)
            }
        },
        ZeroAt(file: id, at: at, len: len) => {
            let file = file_handle(session, id)
            if !file.writable || file.append {
                refuse(mut s, take c, Denied)
            } else if file.direct && (at % 4096 != 0 || len % 4096 != 0) {
                refuse(mut s, take c, Other(22))
            } else if len > 9223372036854775807 || at > 9223372036854775807 - len {
                // Past the largest file offset: EFBIG, as the host answers.
                // ZeroAt has no WriteFailed reply, so write() never sees it.
                refuse(mut s, take c, Other(27))
            } else {
                let mut zeros: Bytes = list.with_capacity(len)
                list.fill(mut zeros, len, 0u8)
                write(mut fs, mut session, mut plan, fault, id, Some(at), take zeros, modified, mut s, take c)
            }
        },
        Close(file: id) => {
            close(mut fs, mut session, id)
            let _ = answer(mut s, take c, Done)
        },
        NextEntries(entries: id, room: room) => next_entries(mut session, id, room, mut s, take c),
        Released(..) => ()
    }
}

/// Runs a mounted filesystem until quiescence. Fault sites are the zero-based
/// order in which operations are taken from this port, excluding releases.
pub fn serve(mut fs: Fs, mut plan: sim.world.Plan, c: Clock, take port: Served[DirOp]) waits {
    serve_with(mut fs, mut plan, c, take port, None)
}

/// Serves as `serve` does and also sends a `Receipt` on `tap` before it
/// replies with a fault or a damaged read. The receipts draw nothing from the
/// plan, so a tapped serve takes the same decisions as an untapped one.
pub fn serve_tapped(mut fs: Fs, mut plan: sim.world.Plan, c: Clock, take port: Served[DirOp], take tap: Sender[sim.world.Receipt]) waits {
    serve_with(mut fs, mut plan, c, take port, Some(take tap))
}

fn serve_with(mut fs: Fs, mut plan: sim.world.Plan, c: Clock, take port: Served[DirOp], take tap: Option[Sender[sim.world.Receipt]]) waits {
    fs.mounts += 1
    let mut s = take port
    let mut session = Session(next_id: 1, site: 0, dirs: map.new(), files: map.new(), listings: map.new(), tap: take tap, reported: map.new())
    while let Some(take call) = provide.next(mut s) {
        let modified: i64 = int.truncate(order.min(host.mono_ns(c), 9223372036854775807))
        request(mut fs, mut session, mut plan, modified, mut s, take call)
    }
    for (_, file) in session.files {
        let _ = map.remove(mut fs.nodes[file.node].locks, file.identity)
    }
}

// The generic body compares payloads through type recipe glue, checked once.
// expect: run numbers(7,7) = true
// expect: run numbers(7,8) = false
// expect: run records(7,7) = true
// expect: run records(7,8) = false
// expect: run choices(true,true) = true
// expect: run choices(true,false) = false
// expect: run words() = false
// expect: run octets() = true
// expect: run different(7,7) = false
// expect: run different(7,8) = true
// expect: run arrays() = false
// expect: run units() = true
fn same[T: key](a: T, b: T) -> bool {
    a == b
}

type Pair: key {
    n: u64,
    flag: bool
}

type Choice: key = Empty | Value(u64)

fn numbers(a: u64, b: u64) -> bool {
    same(a, b)
}

fn records(a: u64, b: u64) -> bool {
    same(Pair(n: a, flag: true), Pair(n: b, flag: true))
}

fn choices(a: bool, b: bool) -> bool {
    let x: Choice = if a {
        Value(7)
    } else {
        Empty
    }
    let y: Choice = if b {
        Value(7)
    } else {
        Empty
    }
    same(x, y)
}

fn strings(a: String, b: String) -> bool {
    same(a, b)
}

fn words() -> bool {
    strings("abc", "abd")
}

fn octets() -> bool {
    let a = result.unwrap(b"abc");
    let b = result.unwrap(b"abc");
    same(a, b)
}

fn not_same[T: key](a: T, b: T) -> bool {
    a != b
}

fn different(a: u64, b: u64) -> bool {
    not_same(a, b)
}

fn arrays() -> bool {
    same([1u64, 2u64],[1u64, 3u64])
}

fn units() -> bool {
    same((), ())
}

// The medium-range reduction and kernels from fdlibm (e_rem_pio2.c,
// k_sin.c, k_cos.c). Hirsel std supplies conversions and bit views.
const INVERSE_PIO2: f64 = 6.36619772367581382433e-01

const PIO2_1: f64 = 1.57079632673412561417e+00

const PIO2_1_LOW: f64 = 6.07710050650619224932e-11

const PIO2_2: f64 = 6.07710050630396597660e-11

const PIO2_2_LOW: f64 = 2.02226624879595063154e-21

const PIO2_3: f64 = 2.02226624871116645580e-21

const PIO2_3_LOW: f64 = 8.47842766036889956997e-32

fn exponent(x: f64) -> u64 {
    (float.to_bits64(x) >> 52) & 2047
}

fn reduce(x: f64, n: f64) -> (f64, f64) {
    let mut r = x - n * PIO2_1
    let mut w = n * PIO2_1_LOW
    let mut hi = r - w
    let exp = exponent(x)
    if exp > exponent(hi) + 16 {
        let saved = r
        w = n * PIO2_2
        r = saved - w
        w = n * PIO2_2_LOW - ((saved - r) - w)
        hi = r - w
        if exp > exponent(hi) + 49 {
            let saved2 = r
            w = n * PIO2_3
            r = saved2 - w
            w = n * PIO2_3_LOW - ((saved2 - r) - w)
            hi = r - w
        }
    }
    (hi, (r - hi) - w)
}

fn kernel_sin(x: f64, y: f64, reduced: bool) -> f64 {
    let z = x * x
    let v = z * x
    let s1 = -1.66666666666666324348e-01f64
    let r = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * (2.75573137070700676789e-06 + z * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)))
    if reduced {
        x - ((z * (0.5 * y - v * r) - y) - v * s1)
    } else {
        x + v * (s1 + z * r)
    }
}

fn kernel_cos(x: f64, y: f64) -> f64 {
    let z = x * x
    let r = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * (2.48015872894767294178e-05 + z * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11)))))
    let high_word = (float.to_bits64(x) >> 32) & 0x7fffffff
    if high_word < 0x3fd33333 {
        return 1.0 - (0.5 * z - (z * r - x * y))
    }
    let quarter = if high_word > 0x3fe90000 {
        0.28125f64
    } else {
        float.from_bits64((high_word - 0x00200000) << 32)
    }
    let hz = 0.5 * z - quarter
    (1.0 - quarter) - (hz - (z * r - x * y))
}

pub fn sin_cos(x: f64) -> Option[(f64, f64)] {
    let high_word = (float.to_bits64(x) >> 32) & 0x7fffffff
    if high_word > 0x413921fb {
        return None
    }
    if high_word <= 0x3fe921fb {
        return Some((kernel_sin(x, 0.0, false), kernel_cos(x, 0.0)))
    }
    let n = float.round_even(x * INVERSE_PIO2)
    let integral: Result[i64, FloatError] = float.to_int(n)
    let quadrant = result.unwrap(integral) & 3
    let (hi, lo) = reduce(x, n)
    let s = kernel_sin(hi, lo, true)
    let c = kernel_cos(hi, lo)
    match quadrant {
        0 => Some((s, c)),
        1 => Some((c, -s)),
        2 => Some((-s, -c)),
        _ => Some((-c, s)),
    }
}

// Module platform_main (package store): the platform host as a runnable place (docs/spec/
// launch.md "The platform host"). The launcher starts it as its first group with its catalog
// store as the granted Dir and the launcher's control socket as its one Unix endpoint.
//
// argv: the control socket's root label, its path beneath that root, max_places, idle_ms.
// The host opens its catalog, connects, sends `Hello`, and then runs one loop: a reader
// task posts each launcher event into the driver's queue, beside the driver's due-time and
// backoff alarms, an accept task posts each operator connection on operator.sock (beside
// the control socket, the listener the launcher passed), and a reader per connection posts
// its frames. Every request a step decides goes out in order, and then every operator
// answer it decided (launch.md "The operator socket"). A lost session ends the host with
// status 75; the launcher starts it again, and the new session's inventory reconciles
// (RUNNER-SPEC §14.5). The host never changes its working directory: its grants name the
// state directory as /proc/self/cwd.
const COLLECT_INTERVAL_NS: u64 = 300000000000u64

type Reader: send {
    input: ReadHalf,
    to: Sender[platform.Input]
}

fn read_event(mut input: ReadHalf) -> Option[launcher.Event] waits {
    let Some(body) = launcher.read_frame(mut input, Never) else {
        return None
    }
    let codec: std.codec.Codec[launcher.Event] = std.codec.of()
    match std.codec.decode(codec, body) {
        Ok(take e) => Some(take e),
        _ => None
    }
}

// Posts each event in stream order, then `Lost` when the session ends or sends a frame that
// does not decode.
fn read_events(take seed: Reader) -> () waits {
    let Reader(input: take input, to: take to) = take seed
    let mut r = take input
    while let Some(take e) = read_event(mut r) {
        if let Error(_) = channel.send(to, Got(take e)) {
            return
        }
    }
    let _ = channel.send(to, Lost)
}

fn collect_periodically(take timer: (Clock, Sender[platform.Input])) waits {
    let (c, take to) = take timer
    loop {
        std.clock.sleep_ns(c, COLLECT_INTERVAL_NS)
        if let Error(_) = channel.send(to, CollectTick) {
            return
        }
    }
}

type Accepter: send {
    listener: UnixListener,
    to: Sender[platform.Input]
}

// Posts each accepted operator connection; the listener admits only the operator's UID.
fn accept_operators(take seed: Accepter) -> () waits {
    let Accepter(listener: take listener, to: take to) = take seed
    let mut l = take listener
    while let Ok(take s) = host.accept_unix(mut l, Never) {
        if let Error(_) = channel.send(to, Joined(take s)) {
            return
        }
    }
}

type Operator: send {
    conn: u64,
    input: ReadHalf,
    to: Sender[platform.Input]
}

// Posts each frame of connection `conn` in order, then its end.
fn read_operator(take seed: Operator) -> () waits {
    let Operator(conn: conn, input: take input, to: take to) = take seed
    let mut r = take input
    while let Some(take body) = operator.read_frame(mut r, Never) {
        if let Error(_) = channel.send(to, Asked(conn, take body)) {
            return
        }
    }
    let _ = channel.send(to, HungUp(conn))
}

type Writer: send {
    conn: u64,
    output: WriteHalf,
    frames: Receiver[Bytes],
    to: Sender[platform.Input]
}

// Writes connection `conn`'s answers in order until the loop drops its sender or a write
// fails, then posts `Flushed(conn)`; the write half closes as the task ends.
fn write_operator(take seed: Writer) -> () waits {
    let Writer(conn: conn, output: take output, frames: take frames, to: take to) = take seed
    let mut w = take output
    while let Ok(take body) = channel.receive(frames) {
        let size = operator.frame_bytes(body)
        if !operator.send_frame(mut w, body, Never) {
            break
        }
        let _ = channel.send(to, Wrote(conn, size))
    }
    let _ = channel.send(to, Flushed(conn))
}

// A connection reader's allowance: one largest frame and its header, with room to spare.
const READER_BYTES: u64 = 17825792u64

// One live operator connection: its reader while it reads, the sender to its writer while
// answers may follow, and its writer.
type Conn {
    reading: Option[Task[()]],
    frames: Option[Sender[Bytes]],
    writing: Task[()],
    queued_bytes: u64,
    busy: bool,
    closing: bool,
    incoming: List[Bytes],
    ready: List[Bytes],
}

fn stop_reading(mut c: Conn) waits {
    if let Some(take r) = replace(mut c.reading, None) {
        let _ = task.cancel_join(take r)
    }
}

fn send_request(mut output: WriteHalf, r: launcher.Request) -> bool waits {
    let codec: std.codec.Codec[launcher.Request] = std.codec.of()
    let mut body: Bytes = list.new()
    if let Error(_) = std.codec.encode(codec, r, mut body) {
        return false
    }
    launcher.send_frame(mut output, body, Never)
}

// One frame may be in the writer's mailbox or on the socket. Everything behind it stays
// in the host's FIFO and is charged against the same byte budget until the writer reports it.
fn send_pending(mut c: Conn) {
    if c.busy {
        return
    }
    if list.len(c.ready) == 0u64 {
        c.ready = replace(mut c.incoming, list.new())
        list.reverse(mut c.ready)
    }
    if let Some(take frame) = list.pop(mut c.ready) {
        if let Some(writer) = c.frames {
            if let Ok(()) = channel.try_send(writer, take frame) {
                c.busy = true
            }
        }
    } else if c.closing {
        c.frames = None
    }
}

fn queue_answer(mut c: Conn, take body: Bytes) -> bool {
    if c.closing || list.len(body) > operator.REPLY_BYTES {
        return false
    }
    let wire_bytes = operator.reply_wire_bytes(body)
    if wire_bytes > operator.QUEUE_BYTES - c.queued_bytes {
        return false
    }
    let frames = operator.answer_frames(take body)
    if list.len(frames) == 0u64 {
        return false
    }
    for take frame in frames {
        list.push(mut c.incoming, take frame)
    }
    c.queued_bytes += wire_bytes
    send_pending(mut c)
    true
}

// A terminal answer closes the connection after the writer drains. A connection that
// exceeds its byte budget is detached without blocking the host on its socket.
fn answer(mut h: platform.Host, mut conns: Map[u64, Conn]) -> List[launcher.Request] waits {
    let mut out: List[launcher.Request] = list.new()
    for sent in platform.outgoing(mut h) {
        let Some(take c) = map.remove(mut conns, sent.conn) else {
            continue
        }
        let mut live = take c
        let queued = match operator.encode_answer(clone(sent.answer)) {
            Some(take body) => queue_answer(mut live, take body),
            None => false,
        }
        if !queued {
            stop_reading(mut live)
            let Conn(writing: take writer, ..) = take live
            let _ = task.cancel_join(take writer)
            for take r in platform.detach(mut h, sent.conn) {
                list.push(mut out, take r)
            }
            continue
        }
        if sent.close {
            live.closing = true
            stop_reading(mut live)
        }
        map.insert(mut conns, sent.conn, take live)
    }
    out
}

fn number(argv: Args, i: u64) -> Result[u64, Exit] {
    let Some(s) = args.get(argv, i) else {
        return Error(Exit(status: 64u8))
    }
    match int.parse_uint(s, 10u32) {
        Ok(n) => Ok(n),
        Error(_) => Error(Exit(status: 64u8))
    }
}

// The installed offline pin reader, `libexec/hirsel/pin_reader ID` with its Dir at
// STATE/catalog (launch.md "Replaying a recording"). The driver runs it only while it holds
// STATE/launcher.lock and STATE/catalog/LOCK. It prints `found <assembly hex>` or `gone`
// and exits 0; a usage error exits 64 and a catalog that cannot be read 74, never `gone`.
pub fn read_pin(d: Dir, c: Clock, out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let Some(text) = args.get(argv, 0u64) else {
        return Error(Exit(status: 64u8))
    }
    let Some(id) = std.hex.decode(string.as_bytes(text)) else {
        return Error(Exit(status: 64u8))
    }
    if list.len(id) != 16u64 {
        return Error(Exit(status: 64u8))
    }
    let line = match platform.resolve_offline(d, c, id, host.wall_ms(c) / 1000u64) {
        Ok(Found(assembly)) => {
            let mut found = string.from("found ")
            string.push(mut found, std.hex.encode(assembly))
            string.push(mut found, "\n")
            take found
        },
        Ok(Gone) => "gone\n",
        Error(_) => return Error(Exit(status: 74u8)),
    }
    match stdout.write(out, line) {
        Ok(_) => Ok(()),
        Error(_) => Error(Exit(status: 74u8)),
    }
}

pub fn main(d: Dir, c: Clock, r: Random, tasks: Tasks, n: Net, argv: Args) -> Result[(), Exit] waits {
    let Some(root) = args.get(argv, 0u64) else {
        return Error(Exit(status: 64u8))
    }
    let Some(path) = args.get(argv, 1u64) else {
        return Error(Exit(status: 64u8))
    }
    let config = platform.Config(max_places: number(argv, 2u64)?, idle_ms: number(argv, 3u64)?)
    let db = match store.open(tasks, d, c, r, result.unwrap(store.sized(Directory, 2147483648u64))) {
        Ok(take db) => take db,
        Error(_) => return Error(Exit(status: 74u8))
    }
    let (take h0, take hello) = match platform.open(take db, config) {
        Ok(take opened) => take opened,
        Error(_) => return Error(Exit(status: 74u8))
    }
    let socket = match host.connect_unix(n, root, path, Never) {
        Ok(take s) => take s,
        Error(_) => return Error(Exit(status: 75u8))
    }
    let listener = match host.listen_unix(n, root, operator.PATH, 16u16) {
        Ok(take l) => take l,
        Error(_) => return Error(Exit(status: 74u8))
    }
    let (take input, take output) = net.split(take socket)
    let mut w = take output
    let (to, from): (Sender[platform.Input], Receiver[platform.Input]) = channel.new(64u64)
    let reading = task.spawn(tasks, bytes 33554432u64, Reader(input: take input, to: channel.sender(to)), read_events)
    let accepting = task.spawn(tasks, bytes 1048576u64, Accepter(listener: take listener, to: channel.sender(to)), accept_operators)
    let collecting = task.spawn(tasks, bytes 4096u64, (c, channel.sender(to)), collect_periodically)
    let operators = channel.sender(to)
    let mut conns: Map[u64, Conn] = map.new()
    let mut next_conn = 1u64
    let mut h = take h0
    let mut driving = platform.driver(tasks, c, take to)
    let mut sent = true
    for req in hello {
        sent = sent && send_request(mut w, req)
    }
    platform.settle(mut driving, h)
    while sent {
        let next = match channel.receive(from) {
            Ok(Lost) => break,
            Ok(Joined(take s)) => {
                let conn = next_conn
                next_conn += 1u64
                let (take rd, take wr) = net.split(take s)
                let (frames, queue): (Sender[Bytes], Receiver[Bytes]) = channel.new(1u64)
                // A host without room for one more connection closes it; it never traps.
                let Ok(take reader) = task.try_spawn(tasks, bytes READER_BYTES, Operator(conn: conn, input: take rd, to: channel.sender(operators)), read_operator) else {
                    continue
                }
                let Ok(take writer) = task.try_spawn(tasks, bytes 1048576u64, Writer(conn: conn, output: take wr, frames: take queue, to: channel.sender(operators)), write_operator) else {
                    let _ = task.cancel_join(take reader)
                    continue
                }
                map.insert(mut conns, conn, Conn(reading: Some(take reader), frames: Some(take frames), writing: take writer, queued_bytes: 0u64, busy: false, closing: false, incoming: list.new(), ready: list.new()))
                continue
            },
            Ok(take i) => take i,
            Error(_) => break,
        }
        match next {
            // The client closed: its writer drains what is queued and then ends.
            HungUp(conn) => {
                let _ = map.update(mut conns, conn, scoped fn(mut open: Conn) {
                    open.closing = true
                    send_pending(mut open)
                })
            },
            Flushed(conn) => if let Some(take gone) = map.remove(mut conns, conn) {
                let mut ending = take gone
                stop_reading(mut ending)
                let Conn(writing: take done, ..) = take ending
                let _ = task.join(take done)
            },
            Wrote(conn, written) => {
                let _ = map.update(mut conns, conn, scoped fn(mut open: Conn) {
                    open.queued_bytes -= written
                    open.busy = false
                    send_pending(mut open)
                })
            },
            _ => (),
        }
        let now = platform.Now(wall_ms: host.wall_ms(c), mono_ns: host.mono_ns(c))
        let reqs = platform.step(mut h, mut driving, take next, now)
        for req in reqs {
            sent = sent && send_request(mut w, req)
        }
        for req in answer(mut h, mut conns) {
            sent = sent && send_request(mut w, req)
        }
        if platform.sync_failed(h) {
            break
        }
    }
    platform.stop(take driving)
    let _ = task.cancel_join(take collecting)
    let _ = task.cancel_join(take accepting)
    for take (_, take live) in take conns {
        let mut ending = take live
        stop_reading(mut ending)
        let Conn(writing: take writing, ..) = take ending
        let _ = task.cancel_join(take writing)
    }
    let _ = task.cancel_join(take reading)
    let _ = platform.close(take h)
    Error(Exit(status: 75u8))
}

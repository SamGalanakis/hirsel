@test
fn png_and_qoi_reference_pixels() -> Result[(), ()] {
    let limits = image.Limits(max_bytes: 4096, max_header_bytes: 4096, max_pixels: 128, max_frames: 1, max_steps: 4000000)
    // RGBA8, filters None/Sub/Up/Average/Paeth, zlib split into 7-byte IDATs.
    let png = b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x03\x00\x00\x00\x05\x08\x06\x00\x00\x00\x80\x71\x56\xa2\x00\x00\x00\x07\x49\x44\x41\x54\x78\x9c\x63\x60\x10\xd7\x73\x02\x92\xb9\xe0\x00\x00\x00\x07\x49\x44\x41\x54\x8d\x29\xee\x5a\xb8\xe3\xfc\xb9\x75\x23\x20\x00\x00\x00\x07\x49\x44\x41\x54\xb3\xbf\x8c\x8a\x8e\x89\x8d\xd7\x46\xce\x60\x00\x00\x00\x07\x49\x44\x41\x54\x0d\x50\xc0\xa4\xa8\x65\x6c\x84\xf6\x6a\xd3\x00\x00\x00\x07\x49\x44\x41\x54\xe3\xea\x17\x9e\x90\x59\x54\xb9\xf2\x49\x4f\x00\x00\x00\x07\x49\x44\x41\x54\xdd\xc2\xec\x94\x50\x3b\xbb\x0c\xd9\xf1\xbf\x00\x00\x00\x07\x49\x44\x41\x54\x9d\x5b\x40\x64\xe6\xdc\x45\xcb\xe3\x9f\xef\x00\x00\x00\x07\x49\x44\x41\x54\x6a\x2c\x20\x19\x5e\x31\xf9\x9e\x30\x74\x63\x00\x00\x00\x07\x49\x44\x41\x54\x37\x99\x56\xce\x6f\x00\x1b\xf6\xd4\xe1\xdc\x00\x00\x00\x03\x49\x44\x41\x54\xcb\x17\x43\x8e\x66\xa3\xbf\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"
    let png_pixels = b"\x00\x17\x2e\x45\x5c\x73\x8a\xa1\xb8\xcf\xe6\xfd\x21\x41\x61\x81\xa1\xc1\xe1\x01\x21\x41\x61\x81\x42\x6b\x94\xbd\xe6\x0f\x38\x61\x8a\xb3\xdc\x05\x63\x95\xc7\xf9\x2b\x5d\x8f\xc1\xf3\x25\x57\x89\x84\xbf\xfa\x35\x70\xab\xe6\x21\x5c\x97\xd2\x0d"
    let raster = result.unwrap(image.decode_png(png, limits))
    if raster.width != 3 || raster.height != 5 || raster.rgba != png_pixels {
        fail("PNG output differs from the unfiltered reference rows")
    }
    let encoded = result.unwrap(image.encode_png(raster, 3, limits))
    if result.unwrap(image.decode_png(encoded, limits)).rgba != png_pixels {
        fail("PNG output could not be read back")
    }
    let oversize = b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x03\x00\x00\x00\x05\x08\x06\x00\x00\x00\x80\x71\x56\xa2\x00\x00\x00\x07\x49\x44\x41\x54\x78\x9c\x63\x60\x10\xd7\x73\x02\x92\xb9\xe0\x00\x00\x00\x07\x49\x44\x41\x54\x8d\x29\xee\x5a\xb8\xe3\xfc\xb9\x75\x23\x20\x00\x00\x00\x07\x49\x44\x41\x54\xb3\xbf\x8c\x8a\x8e\x89\x8d\xd7\x46\xce\x60\x00\x00\x00\x07\x49\x44\x41\x54\x0d\x50\xc0\xa4\xa8\x65\x6c\x84\xf6\x6a\xd3\x00\x00\x00\x07\x49\x44\x41\x54\xe3\xea\x17\x9e\x90\x59\x54\xb9\xf2\x49\x4f\x00\x00\x00\x07\x49\x44\x41\x54\xdd\xc2\xec\x94\x50\x3b\xbb\x0c\xd9\xf1\xbf\x00\x00\x00\x07\x49\x44\x41\x54\x9d\x5b\x40\x64\xe6\xdc\x45\xcb\xe3\x9f\xef\x00\x00\x00\x07\x49\x44\x41\x54\x6a\x2c\x20\x19\x5e\x31\xf9\x9e\x30\x74\x63\x00\x00\x00\x07\x49\x44\x41\x54\x37\x99\x56\xce\x6f\x18\x00\xfe\xaa\xb0\x69\x00\x00\x00\x04\x49\x44\x41\x54\x33\x0e\x17\x43\xe8\x75\x09\xfe\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"
    if let Ok(_) = image.decode_png(oversize, limits) {
        fail("PNG inflate produced more than the exact scanline extent")
    }
    // QOI RUN, RGB, DIFF, LUMA, RGBA, INDEX, RUN.
    let qoi = b"\x71\x6f\x69\x66\x00\x00\x00\x08\x00\x00\x00\x01\x04\x00\xc0\xfe\xff\x43\x59\x7a\xa4\x92\xff\x0b\x0c\x0d\x64\x30\xc1\x00\x00\x00\x00\x00\x00\x00\x01"
    let qoi_pixels = b"\x00\x00\x00\xff\xff\x43\x59\xff\x00\x43\x59\xff\x05\x47\x57\xff\x0b\x0c\x0d\x64\xff\x43\x59\xff\xff\x43\x59\xff\xff\x43\x59\xff"
    let unpacked = result.unwrap(image.decode_qoi(qoi, limits))
    if unpacked.width != 8 || unpacked.height != 1 || unpacked.rgba != qoi_pixels {
        fail("QOI output differs from opcode reference")
    }
    let packed = result.unwrap(image.encode_qoi(unpacked, false, limits))
    if result.unwrap(image.decode_qoi(packed, limits)).rgba != qoi_pixels {
        fail("QOI output could not be read back")
    }
    Ok(())
}

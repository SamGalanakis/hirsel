// Module local (package store): the platform host with an in-process launcher
// (RUNNER-SPEC §14.9). One task owns a `platform.Host` and runs each group's serving child
// as a linked place task in this process, through runner.operate, instead of as a
// launched process. The host decides every start, stop, wake and backoff exactly as it
// does for launched groups; this module only carries its requests out and reports each
// child's phases and end back to it as launcher events.
//
// Every group here is first-party: its place is linked code, made by the
// one factory the host was given. A child's end is reported only after operate has
// returned, so after the child's store is closed: a group never has two heads.
//
// The host is also the catalog of keyed sessions: session `id` is the group `s<id>`, and
// its key and id rows commit in the transaction that adds or removes the group, so the
// sessions and the groups never disagree. A create seeds the session's store first; one
// that dies before its commit leaves a directory the next create of that id clears.
// What a factory's `make` gets to build its PlaceConfig from. The launcher replaces the
// config's backing, selection, idle bound and wire session count with the host's (§14.9).
// `name` is the group being started, so a place can name itself to the services it is given.
pub type Supplied: send {
    name: String,
    tasks: Tasks,
    clock: Clock,
    random: Random,
    net: Net
}

// A start sees a view of the host's seed: the services a place's grants are made from.
// A start that registered its place returns the Factory that holds that registration, and
// the host starts its later groups with it (RUNNER-SPEC §14.9: one registration per host and
// factory while the place and n_place stay the same).
pub opaque type Factory[T: send]: send {
    start: own[send] fn(take Launch[T], T) -> (Result[Started, Refused], Option[Factory[T]])
}

type Make[T: send, G: send, H: shareable + inert + send, S: send]: send = Plain(fn(take Supplied) -> Result[runner.PlaceConfig[G, H, S], Capacity]) | Seeded(fn(take Supplied, T) -> Result[runner.PlaceConfig[G, H, S], Capacity])

pub type Unloaded: send {
    name: String,
    ended: Result[runner.Ended, runner.StartError]
}

// What the host has seen of a session since it started: its place's starts and ends, and
// the nudges a front sent after it changed the session.
pub type Marks: codec + send {
    ups: u64,
    downs: u64,
    nudges: u64
}

// Seeds a new session's store, migrated and open, before its group is added.
pub type Seed = own[send] fn(mut store.Db) -> Result[(), String] waits

// Up: a child reached Ready and the host accepted it. Down: a child ended.
pub type Change: send = Up(String) | Down(Unloaded)

pub type Refused: send = Unknown | Exists | Full | Busy | Retiring | Denied | Failed(String) | Stopping

// `root` holds the host's catalog (`root/host`) and every group's store (`root/<name>`).
// `place_bytes` is the budget every live child shares; `max_places` bounds the sessions
// and is, with `idle_ms`, the host's Config (§14.2, §14.4). `sessions` is the wire
// sessions every place admits at once (`PlaceConfig.max_sessions`).
pub type Config[T: send]: send {
    root: Dir,
    options: store.Options,
    factory: Factory[T],
    seed: T,
    max_places: u64,
    idle_ms: u64,
    place_bytes: u64,
    sessions: u64,
    tasks: Tasks,
    clock: Clock,
    random: Random,
    net: Net,
    watch: Option[Sender[Change]],
}

pub opaque type Local {
    to: Sender[In],
    actor: Task[()]
}

pub opaque type Door: send {
    to: Sender[In]
}

// A host's inbox, made before the host so that its seed can hold a door to it.
pub opaque type Doorway: send {
    to: Sender[In],
    inbox: Receiver[In]
}

// A lease is a view of one child's status and, once the child is Ready, its dialer: a
// place here binds no listener and is reached in process (RUNNER-SPEC §14.11). It does not
// hold the child; the host drains an idle child whether or not a lease on it lives, and a
// dial after that drain reads as the place's close.
pub opaque type Lease: send {
    status: Latest[runner.Status],
    dialer: Option[std.wsock.Dialer]
}

// The child task's own bytes on top of operate's: the operate task's charge, the phase
// handoff, its dial connection (64 + DIALS × size(Dial), no room: a Dial holds only
// clients) and its last message.
const DIALS: u64 = 16u64

const PLACE_TASK_BYTES: u64 = 65536u64

// The host task's own bytes on top of the place budget, its catalog store and the store a
// create seeds: its timers, inboxes and the bookkeeping of each child and session.
const LOCAL_BYTES: u64 = 1048576u64

const NEXT_ID: u64 = 0u64

type Launch[T: send]: send {
    supplied: Supplied,
    backing: runner.Backing,
    sizing: PlaceSizing,
    selection: runner.Selection,
    idle: u64,
    sessions: u64,
    available: u64,
    stop: Receiver[()],
    status: Latest[runner.Status],
    to: Sender[In],
    name: String,
    gen: u64,
}

type PlaceSizing: send {
    sizes: store.Overrides,
    need: u64,
}

fn place_sizing(options: store.Options) -> PlaceSizing {
    let mut sizes = store.derived_sizes()
    sizes.resident_limit = Some(options.resident_limit)
    sizes.pack_bytes = Some(options.pack_bytes)
    sizes.group_bytes = Some(int.widen(options.group_bytes))
    sizes.group_commits = Some(options.group_commits)
    sizes.lock_wait_ms = Some(options.lock_wait_ms)
    PlaceSizing(sizes, need: store.directory_writer_need(sizes))
}

type Started {
    task: Task[()],
    charge: u64
}

type AccessReply = Sender[Result[Option[Lease], Refused]]

pub type ColdCheck: send {
    caller: store.Caller,
    check: StaticFn[fn(store.ReadOnly, store.Caller) -> Result[bool, store.Error] waits],
}

// A read of a session's store, run in the host while no child of the session holds it.
pub type ColdRead: send {
    arg: Bytes,
    read: StaticFn[fn(store.ReadOnly, Bytes) -> Result[Bytes, String] waits]
}

type ReadReply = Sender[Result[Bytes, Refused]]

type Downs = Sender[Result[u64, Refused]]

type In: send = Host(platform.Input) | Up(String, u64, std.wsock.Dialer) | Down(String, u64, Result[runner.Ended, runner.StartError]) | Create(Bytes, Seed, Sender[Result[u64, Refused]]) | Delete(u64, Sender[Result[(), Refused]]) | Listing(Sender[List[u64]]) | Route(u64, AccessReply) | Access(u64, ColdCheck, bool, AccessReply) | Peek(u64, Sender[Result[Lease, Refused]]) | Unload(u64, Sender[Result[Unloaded, Refused]]) | Nudge(u64) | Marked(u64, Sender[Marks]) | WatchMarks(u64, Sender[()], Sender[u64]) | UnwatchMarks(u64, u64) | AwaitDown(u64, u64, Downs) | Read(u64, ColdRead, ReadReply) | Halt(Sender[List[Unloaded]])

type PlaceJob[G: send, H: shareable + inert + send, S: send]: send {
    placing: runner.Placing[G, H],
    config: runner.PlaceConfig[G, H, S],
    dialer: std.wsock.Dialer,
    stop: Receiver[()],
    status: Latest[runner.Status],
    to: Sender[In],
    name: String,
    gen: u64,
    need: u64,
}

type Operated[G: send, H: shareable + inert + send, S: send]: send {
    placing: runner.Placing[G, H],
    config: runner.PlaceConfig[G, H, S],
    stop: Receiver[()],
    status: Latest[runner.Status],
    watch: Sender[Receiver[runner.Phase]],
}

// A live child: the host's identity for it, its stop, its status and its task.
type Kid {
    child: launcher.Child,
    stop: Option[Sender[()]],
    status: Latest[runner.Status],
    task: Option[Task[()]],
    charge: u64,
    expect: Option[(u64, u64)],
    ready: bool,
    selected: launcher.Selection,
    dialer: Option[std.wsock.Dialer],
}

type Catalog: send {
    sessions: store.Table[u64, Bytes],
    keys: store.Table[Bytes, u64],
    meta: store.Table[u64, u64]
}

// The durable catalog as the host opened it; every later change commits with a group's.
type Sessions {
    catalog: Catalog,
    by_id: Map[u64, Bytes],
    by_key: Map[Bytes, u64],
    next_id: u64
}

type Actor[T: send] {
    h: platform.Host,
    driving: platform.Driver,
    factory: Factory[T],
    seed: T,
    root: Dir,
    options: store.Options,
    sizing: PlaceSizing,
    max_sessions: u64,
    s: Sessions,
    // Each session's marks since the host started, who watches them and who waits for its next end.
    marks: Map[u64, Marks],
    watching: Map[u64, Map[u64, Sender[()]]],
    next_watch: u64,
    waiters: Map[u64, List[(u64, Downs)]],
    place_bytes: u64,
    sessions: u64,
    used: u64,
    tasks: Tasks,
    clock: Clock,
    random: Random,
    net: Net,
    me: Sender[In],
    watch: Option[Sender[Change]],
    kids: List[Kid],
    routes: List[(String, AccessReply)],
    // Groups whose serving start this launcher refused while applying the host's requests,
    // with the answer each one's waiting routes get if the host does not start it again.
    refused: List[(String, Refused)],
    unloads: List[(String, Sender[Result[Unloaded, Refused]])],
    removes: List[(String, Sender[Result[(), Refused]])],
    reads: List[(String, ColdRead, ReadReply)],
    retiring: List[launcher.Group],
    halting: bool,
    unloaded: List[Unloaded],
}

type Begin[T: send]: send {
    config: Config[T],
    inbox: Receiver[In],
    me: Sender[In],
    ready: Sender[Result[(), Refused]]
}

// ---- names ----
pub fn name_of(id: u64) -> String {
    let mut s = string.from("s")
    string.push_u64(mut s, id)
    s
}

fn id_of(name: String) -> Option[u64] {
    let Some(digits) = string.strip_prefix(name, "s") else {
        return None
    }
    match (int.parse(string.from(digits)) : Result[u64, ParseError]) {
        Ok(n) => Some(n),
        Error(_) => None
    }
}

type Forward: send {
    from: Receiver[platform.Input],
    to: Sender[In]
}

// ---- factories ----
pub fn factory[T: send, G: send, H: shareable + inert + send, S: send](make: fn(take Supplied) -> Result[runner.PlaceConfig[G, H, S], Capacity]) -> Factory[T] {
    held_factory(Plain(make), None)
}

// A factory whose `make` also sees the host's seed. `make` is still a plain fn, so only
// linked code runs as a group.
pub fn seeded_factory[T: send, G: send, H: shareable + inert + send, S: send](make: fn(take Supplied, T) -> Result[runner.PlaceConfig[G, H, S], Capacity]) -> Factory[T] {
    held_factory(Seeded(make), None)
}

fn held_factory[T: send, G: send, H: shareable + inert + send, S: send](make: Make[T, G, H, S], take held: Option[runner.Placing[G, H]]) -> Factory[T] {
    let made = fn(take request: Launch[T], seed: T) -> (Result[Started, Refused], Option[Factory[T]]) {
        let config = match make {
            Plain(f) => f(clone(request.supplied)),
            Seeded(f) => f(clone(request.supplied), seed),
        }
        let Ok(take settings) = take config else {
            return (Error(Full), None)
        }
        // The held registration when it fits this config, else a new one the next
        // Factory holds.
        let (take placing, fresh) = match held {
            Some(kept) => if runner.placing_fits(kept, settings) {
                (runner.share_placing(kept), false)
            } else {
                (runner.placing_of(settings), true)
            },
            None => (runner.placing_of(settings), true),
        }
        let next = if fresh {
            Some(held_factory(make, Some(runner.share_placing(placing))))
        } else {
            None
        }
        (start_made(take request, take placing, take settings), take next)
    }
    Factory(start: take made)
}

fn start_made[T: send, G: send, H: shareable + inert + send, S: send](take request: Launch[T], take placing: runner.Placing[G, H], take made: runner.PlaceConfig[G, H, S]) -> Result[Started, Refused] {
    let Launch(supplied: supplied, backing: take backing, sizing, selection: selection, idle: idle, sessions: sessions, available: available, stop: take halt, status: take root, to: take to, name: take name, gen: gen) = take request
    let mut config = take made
    config.backing = take backing
    config.sizes = sizing.sizes
    config.selection = selection
    config.idle = Some(idle)
    config.max_sessions = sessions
    // The place is dialed in process, and its sizing counts each session's dial room.
    let (dialing, dials) = match std.wsock.dials(DIALS) {
        Ok(take pair) => take pair,
        Error(_) => return Error(Full)
    }
    config.listen = InProcess(take dials)
    let overhead = match runner.placed_bytes(placing, config) {
        Ok(total) => total,
        Error(_) => return Error(Full)
    }
    let need = int.saturating_add(overhead, int.saturating_add(sizing.need, 1048576u64))
    let charge = int.saturating_add(need, PLACE_TASK_BYTES)
    if charge > available {
        return Error(Full)
    }
    let job = PlaceJob(placing: take placing, config: take config, dialer: take dialing, stop: take halt, status: take root, to: take to, name: take name, gen: gen, need: need)
    let run: fn(take PlaceJob[G, H, S]) -> () waits = run_place
    let running = task.spawn(supplied.tasks, bytes charge, take job, run)
    Ok(Started(task: take running, charge: charge))
}

// The child task: operate runs in a child of it so this task can read its phases. Its
// last message is Down, sent after operate has returned and so after the store is closed.
fn run_place[G: send, H: shareable + inert + send, S: send](take job: PlaceJob[G, H, S]) -> () waits {
    let to = channel.sender(job.to)
    let name = string.from(job.name)
    let gen = job.gen
    let ended = operated(take job)
    let _ = channel.send(to, Down(take name, gen, take ended))
}

fn operated[G: send, H: shareable + inert + send, S: send](take job: PlaceJob[G, H, S]) -> Result[runner.Ended, runner.StartError] waits {
    let PlaceJob(placing: take placing, config: take config, dialer: take dialing, stop: take halt, status: take root, to: take to, name: take name, gen: gen, need: need) = take job
    let tasks = config.tasks
    let (handoff, phases_from): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = channel.new(1u64)
    let request = Operated(placing: take placing, config: take config, stop: take halt, status: take root, watch: take handoff)
    let run: fn(take Operated[G, H, S]) -> Result[runner.Ended, runner.StartError] waits = run_operate
    let running = task.spawn(tasks, bytes need, take request, run)
    if let Ok(take phases) = channel.receive(phases_from) {
        while let Ok(phase) = channel.receive(phases) {
            if let Ready = phase {
                let _ = channel.send(to, Up(string.from(name), gen, std.wsock.copy_dialer(dialing)))
            }
        }
    }
    match task.join(take running) {
        Ok(take ended) => take ended,
        Error(_) => Error(Missing("operate")),
    }
}

fn run_operate[G: send, H: shareable + inert + send, S: send](take request: Operated[G, H, S]) -> Result[runner.Ended, runner.StartError] waits {
    let Operated(placing: take placing, config: take config, stop: take halt, status: take root, watch: take phases) = take request
    runner.operate_placed(take placing, take config, take halt, root, Some(take phases))
}

// ---- the launcher side ----
fn now[T: send](a: Actor[T]) -> platform.Now {
    platform.Now(wall_ms: host.wall_ms(a.clock), mono_ns: host.mono_ns(a.clock))
}

fn kid_index[T: send](a: Actor[T], c: launcher.Child) -> Option[u64] {
    for i in 0u64 .. list.len(a.kids) {
        if launcher.same_child(a.kids[i].child, c) {
            return Some(i)
        }
    }
    None
}

fn kid_of[T: send](a: Actor[T], name: String, gen: u64) -> Option[u64] {
    for i in 0u64 .. list.len(a.kids) {
        let c = a.kids[i].child
        if c.group.name == name {
            if let Serving(g) = c.role {
                if g == gen {
                    return Some(i)
                }
            }
        }
    }
    None
}

fn group_has_kid[T: send](a: Actor[T], name: String) -> bool {
    for k in a.kids {
        if k.child.group.name == name {
            return true
        }
    }
    false
}

fn stop_kid(mut k: Kid) {
    if let Some(take s) = replace(mut k.stop, None) {
        let _ = channel.try_send(s, ())
    }
}

fn selection_of(activation: u64) -> runner.Selection {
    Current(activation)
}

// Carries out a Start of a serving child: the group's store at root/<workdir>, the
// activation the host names, and the host's idle bound.
fn start[T: send](mut a: Actor[T], take l: launcher.Launch, mut events: List[launcher.Event]) waits {
    let launcher.Launch(group: take group, workdir: take workdir, mode: take mode, assembly: take assembly, ..) = take l
    let role = launcher.role_of(mode)
    if let Install(_) = role {
        list.push(mut events, Refused(launcher.Child(group: clone(group), role: role), Mismatch))
        return
    }
    let ServingMode(gen, serve) = take mode else {
        list.push(mut events, Refused(launcher.Child(group: clone(group), role: role), Unbuilt(string.from("in-process launcher serves only"))))
        return
    }
    let child = launcher.Child(group: clone(group), role: Serving(gen))
    if let Some(i) = kid_index(a, child) {
        list.push(mut events, Launched(take child, Started))
        return
    }
    if a.halting || group_has_kid(a, group.name) {
        list.push(mut events, Refused(take child, Held))
        return
    }
    let _ = std.dir.create_dir(a.root, workdir)
    let Ok(dir) = std.dir.narrow(a.root, workdir) else {
        refuse_start(mut a, take child, Failed(string.from("workdir")), mut events)
        return
    }
    let (stop_to, stop_from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let root = match runner.status_root() {
        Ok(take made) => take made,
        Error(_) => {
            refuse_start(mut a, take child, Full, mut events);
            return
        },
    }
    let supplied = Supplied(name: string.from(group.name), tasks: a.tasks, clock: a.clock, random: a.random, net: a.net)
    let launched: Launch[T] = Launch(supplied: take supplied, backing: Disk(dir), sizing: a.sizing, selection: selection_of(serve.activation), idle: serve.idle, sessions: a.sessions, available: a.place_bytes - a.used, stop: take stop_from, status: latest.handle(root), to: channel.sender(a.me), name: string.from(group.name), gen: gen)
    let (take outcome, take next) = (a.factory.start)(take launched, a.seed)
    if let Some(take holding) = take next {
        a.factory = take holding
    }
    match take outcome {
        Ok(take begun) => {
            let Started(task: take running, charge: charged) = take begun
            a.used += charged
            list.push(mut a.kids, Kid(child: clone(child), stop: Some(take stop_to), status: take root, task: Some(take running), charge: charged, expect: serve.store_id, ready: false, selected: launcher.Selection(activation: serve.activation, assembly: take assembly), dialer: None))
            list.push(mut events, Launched(take child, Started))
        },
        Error(take why) => refuse_start(mut a, take child, take why, mut events),
    }
}

// A serving start this launcher refuses is reported to the host as `Spawn`, and its group's
// waiting routes are answered with `why` once the host has applied the refusal, unless the
// host started the group again at once (§14.9 "Ends").
fn refuse_start[T: send](mut a: Actor[T], take child: launcher.Child, take why: Refused, mut events: List[launcher.Event]) {
    list.push(mut a.refused, (string.from(child.group.name), clone(why)))
    list.push(mut events, Refused(take child, Spawn(refused_text(why))))
}

fn refused_text(why: Refused) -> String {
    match why {
        Unknown => string.from("Unknown"),
        Exists => string.from("Exists"),
        Full => string.from("Full"),
        Busy => string.from("Busy"),
        Retiring => string.from("Retiring"),
        Denied => string.from("Denied"),
        Failed(e) => string.from(e),
        Stopping => string.from("Stopping"),
    }
}

fn retire[T: send](mut a: Actor[T], take g: launcher.Group, mut events: List[launcher.Event]) {
    if !group_has_kid(a, g.name) {
        list.push(mut events, Retired(take g))
        return
    }
    for i in 0u64 .. list.len(a.kids) {
        if a.kids[i].child.group.name == g.name {
            stop_kid(mut a.kids[i])
        }
    }
    list.push(mut a.retiring, take g)
}

// A removed group's listener closes: its store goes too when the host retired it Delete.
fn closed[T: send](mut a: Actor[T], take g: launcher.Group) waits {
    if let Some(r) = platform.retirement(a.h, g.name) {
        if let Delete = r.disposition {
            let _ = std.dir.remove_all(a.root, r.workdir)
        }
    }
    let mut kept: List[(String, Sender[Result[(), Refused]])] = list.new()
    while let Some((name, take reply)) = list.pop(mut a.removes) {
        if name == g.name {
            let _ = channel.try_send(reply, Ok(()))
        } else {
            list.push(mut kept, (take name, take reply))
        }
    }
    a.removes = take kept
}

// One host request, carried out in this process. Admission, assembly, collection and
// cutover belong to launched groups; a group here has no deploy, so the host never asks
// for them, and each is answered as a launcher that has none would answer it.
fn carry_out[T: send](mut a: Actor[T], take r: launcher.Request, mut events: List[launcher.Event]) waits {
    match take r {
        Hello => {
            let mut children: List[launcher.ChildState] = list.new()
            for k in a.kids {
                list.push(mut children, launcher.ChildState(child: clone(k.child), phase: Started, selection: Some(clone(k.selected)), answer: None))
            }
            list.push(mut events, Inventory(take children, list.new(), list.new()))
        },
        Bind(take g, _) => list.push(mut events, Bound(take g)),
        Close(take g) => closed(mut a, take g),
        Start(take l) => start(mut a, take l, mut events),
        Stop(take c) => if let Some(i) = kid_index(a, c) {
            stop_kid(mut a.kids[i])
        },
        // A place task cannot be cut without its drain: a kill is the drain, which ends at
        // the place's own grace deadline (§14.9).
        Kill(take c) => if let Some(i) = kid_index(a, c) {
            stop_kid(mut a.kids[i])
        },
        Acknowledge(_) => (),
        // HostStoreAccepted: a place here is accepted when its Placed is applied (§14.9).
        Command(_, _) => (),
        Retire(take g) => retire(mut a, take g, mut events),
        Release(_) => (),
        CollectBegin => list.push(mut events, Fenced),
        Collect(_) => list.push(mut events, Collected(0u64)),
        CollectAbort => list.push(mut events, Collected(0u64)),
        Admit(_, take attempt, _, _) => list.push(mut events, AdmissionFailed(take attempt, Unassembled(string.from("in-process launcher")))),
        AdmitData(_, _) => (),
        AdmitEnd(_) => (),
        Assemble(take attempt) => list.push(mut events, AdmissionFailed(take attempt, Unassembled(string.from("in-process launcher")))),
        CutoverAck(_, _) => (),
    }
}

// Carries out the host's requests and applies the events they produce until the host
// asks for nothing more, then rearms its timers and answers the routes it can.
fn apply[T: send](mut a: Actor[T], take reqs: List[launcher.Request]) waits {
    let mut todo = take reqs
    while list.len(todo) > 0u64 {
        let mut events: List[launcher.Event] = list.new()
        for take r in take todo {
            carry_out(mut a, take r, mut events)
        }
        todo = list.new()
        for take e in take events {
            let n = now(a)
            for take more in platform.event(mut a.h, take e, n) {
                list.push(mut todo, take more)
            }
        }
    }
    platform.settle(mut a.driving, a.h)
    while let Some((take name, take why)) = list.pop(mut a.refused) {
        if !group_has_kid(a, name) {
            refuse_routes(mut a, name, take why)
        }
    }
    answer_routes(mut a)
}

fn lease_of(k: Kid) -> Lease {
    let dialing = match k.dialer {
        Some(d) => Some(std.wsock.copy_dialer(d)),
        None => None,
    }
    Lease(status: latest.handle(k.status), dialer: take dialing)
}

// A child a lease may name: accepted by the host, not asked to stop and not draining by
// its own idle stop. A route that finds the child draining waits for the next one.
fn serves(k: Kid) -> bool {
    if !k.ready {
        return false
    }
    if let None = k.stop {
        return false
    }
    match latest.read(k.status).phase {
        Draining => false,
        _ => true
    }
}

// A route is answered once the host has accepted a child of its group as Ready, and is
// refused when its group is gone.
fn answer_routes[T: send](mut a: Actor[T]) waits {
    let mut kept: List[(String, AccessReply)] = list.new()
    while let Some((take name, take reply)) = list.pop(mut a.routes) {
        let answer: Option[Result[Option[Lease], Refused]] = match platform.serving_ready(a.h, name) {
            Some(gen) => match kid_of(a, name, gen) {
                Some(i) => if serves(a.kids[i]) {
                    Some(Ok(Some(lease_of(a.kids[i]))))
                } else {
                    None
                },
                None => None,
            },
            None => match platform.wake_row(a.h, name) {
                Some(_) => None,
                None => Some(Error(Unknown))
            },
        }
        match take answer {
            Some(take answered) => {
                let _ = channel.try_send(reply, take answered)
            },
            None => list.push(mut kept, (take name, take reply)),
        }
    }
    a.routes = take kept
}

fn refuse_routes[T: send](mut a: Actor[T], name: String, why: Refused) {
    let mut kept: List[(String, AccessReply)] = list.new()
    while let Some((take at, take reply)) = list.pop(mut a.routes) {
        if at == name {
            let _ = channel.try_send(reply, Error(clone(why)))
        } else {
            list.push(mut kept, (take at, take reply))
        }
    }
    a.routes = take kept
}

fn routed[T: send](a: Actor[T], name: String) -> bool {
    for r in a.routes {
        if r.0 == name {
            return true
        }
    }
    false
}

// A child reached Ready: the launcher reports the store it opened, as a hosted place does
// on its private endpoint. A store other than the one the host recorded for the group is
// reported as a mismatch and the child is stopped.
fn on_up[T: send](mut a: Actor[T], name: String, gen: u64, take dialing: std.wsock.Dialer) waits {
    let Some(i) = kid_of(a, name, gen) else {
        return
    }
    if a.kids[i].ready {
        return
    }
    let s = latest.read(a.kids[i].status)
    let child: launcher.Child = clone(a.kids[i].child)
    let mut events: List[launcher.Event] = list.new()
    let mismatch = match a.kids[i].expect {
        Some(want) => want.0 != s.store_id.0 || want.1 != s.store_id.1,
        None => false
    }
    if mismatch {
        let want = option.unwrap(a.kids[i].expect)
        stop_kid(mut a.kids[i])
        list.push(mut events, Placed(take child, PlaceStoreMismatch(want.0, want.1, s.store_id.0, s.store_id.1)))
    } else {
        a.kids[i].ready = true
        a.kids[i].dialer = Some(take dialing)
        let ready = runner.PlaceReady(version: s.activation, store_hi: s.store_id.0, store_lo: s.store_id.1, release: clone(s.release), retain_from: s.retain_from, ready_ns: host.mono_ns(a.clock), read: list.new())
        list.push(mut events, Placed(take child, PlaceOpened(take ready)))
        if let Some(id) = id_of(name) {
            count_up(mut a, id)
        }
        if let Some(w) = a.watch {
            let _ = channel.try_send(w, Up(string.from(name)))
        }
    }
    let mut reqs: List[launcher.Request] = list.new()
    for take e in take events {
        let n = now(a)
        for take r in platform.event(mut a.h, take e, n) {
            list.push(mut reqs, take r)
        }
    }
    apply(mut a, take reqs)
}

// How a hosted place's process would have ended: a clean stop exits 0 with its wake
// report, a stop before Ready exits 0 without one, a forced drain or a failed start exits
// 1. A start refused because the store is at another activation is answered first, as a
// hosted place answers it on its private endpoint.
fn end_of(ended: Result[runner.Ended, runner.StartError], readable: bool) -> launcher.End {
    match ended {
        Ok(Stopped(next)) => launcher.End(status: Code(0i32), report: Some(next), readable: readable),
        Ok(Unstarted) => launcher.End(status: Code(0i32), report: None, readable: false),
        _ => launcher.End(status: Code(1i32), report: None, readable: false),
    }
}

// What the routes waiting on a group get when its start failed: `Full` when operate's
// sizing refused the start, as when this launcher refuses it (§14.2, §14.9 "Ends").
fn start_refused(e: runner.StartError) -> Refused {
    match e {
        Open(_) => Failed(string.from("open")),
        Listen(_) => Failed(string.from("listen")),
        Missing(what) => Failed(string.from(what)),
        Exceeds(b) => Failed(string.from(b.name)),
        Full(_) => Full,
    }
}

// A child ended, after operate returned. A route waiting on its group makes a clean end
// readable, so the host starts the next child at once (§14.3). A start that failed refuses
// the routes waiting on its group only when the host does not start the group again at
// once: a first failure is retried at once, and a start at 0 refused because genesis had
// already run relaunches at the store's activation (§14.5 "Genesis").
fn on_down[T: send](mut a: Actor[T], name: String, gen: u64, take ended: Result[runner.Ended, runner.StartError]) waits {
    let Some(i) = kid_of(a, name, gen) else {
        return
    }
    let mut k = list.remove(mut a.kids, i)
    if let Some(take t) = replace(mut k.task, None) {
        let _ = task.join(take t)
    }
    a.used -= k.charge
    answer_reads(mut a, name)
    let mut events: List[launcher.Event] = list.new()
    let mut failed: Option[Refused] = None
    if !k.ready {
        if let Error(Open(NotCurrent(Active(version, _, read)))) = ended {
            list.push(mut events, Placed(clone(k.child), PlaceCurrent(version, clone(read))))
        }
        if let Error(e) = ended {
            failed = Some(start_refused(e))
        }
    }
    let readable = !a.halting && routed(a, name)
    list.push(mut events, Ended(clone(k.child), end_of(ended, readable)))
    let mut kept: List[launcher.Group] = list.new()
    while let Some(take g) = list.pop(mut a.retiring) {
        if g.name == name && !group_has_kid(a, name) {
            list.push(mut events, Retired(take g))
        } else {
            list.push(mut kept, take g)
        }
    }
    a.retiring = take kept
    let unloaded = Unloaded(name: string.from(name), ended: clone(ended))
    let mut waiting: List[(String, Sender[Result[Unloaded, Refused]])] = list.new()
    while let Some((take at, take reply)) = list.pop(mut a.unloads) {
        if at == name {
            let _ = channel.try_send(reply, Ok(clone(unloaded)))
        } else {
            list.push(mut waiting, (take at, take reply))
        }
    }
    a.unloads = take waiting
    if a.halting {
        list.push(mut a.unloaded, clone(unloaded))
    }
    if let Some(id) = id_of(name) {
        count_down(mut a, id)
    }
    if let Some(w) = a.watch {
        let _ = channel.try_send(w, Down(take unloaded))
    }
    let mut reqs: List[launcher.Request] = list.new()
    for take e in take events {
        let n = now(a)
        for take r in platform.event(mut a.h, take e, n) {
            list.push(mut reqs, take r)
        }
    }
    apply(mut a, take reqs)
    if let Some(take why) = take failed {
        if !group_has_kid(a, name) {
            refuse_routes(mut a, name, take why)
        }
    }
}

fn forward_host(take f: Forward) -> () waits {
    while let Ok(take i) = channel.receive(f.from) {
        if let Error(_) = channel.send(f.to, Host(take i)) {
            return
        }
    }
}

fn declared[K, V](mut d: store.Declare, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[store.Table[K, V], store.Error] {
    let table = store.declare_table(mut d, name, take key, take value)?
    store.finish(mut d, take table)
}

// The host store holds the session catalog beside the host's tables: one declaration.
fn open_sessions(mut db: store.Db) -> Result[(Sessions, platform.Tables), store.Error] waits {
    let mut d = store.declare(db, Migrate)?
    let catalog = Catalog(sessions: declared(mut d, "local.sessions", std.codec.key_u64(), std.codec.of())?, keys: declared(mut d, "local.keys", std.codec.key_bytes(), std.codec.of())?, meta: declared(mut d, "local.meta", std.codec.key_u64(), std.codec.of())?)
    let tables = platform.declare_tables(mut d)?
    let _ = store.seal(mut db, take d)?
    let snap = store.snapshot(db)
    let next_id = match store.get(result.unwrap(store.reader(db, 0u64)), snap, catalog.meta, NEXT_ID)? {
        Some(n) => n,
        None => 0u64
    }
    let mut by_id: Map[u64, Bytes] = map.new()
    let mut by_key: Map[Bytes, u64] = map.new()
    let mut rows = store.scan(result.unwrap(store.reader(db, 0u64)), snap, catalog.sessions, Unbounded, Unbounded)?
    while let Some((id, key)) = store.next(result.unwrap(store.reader(db, 0u64)), mut rows)? {
        map.insert(mut by_key, clone(key), id)
        map.insert(mut by_id, id, clone(key))
    }
    Ok((Sessions(catalog: take catalog, by_id: take by_id, by_key: take by_key, next_id: next_id), take tables))
}

fn open_host(tasks: Tasks, root: Dir, clock: Clock, random: Random, options: store.Options, first: platform.Config) -> Result[(platform.Host, Sessions, List[launcher.Request]), Refused] waits {
    let _ = std.dir.create_dir(root, "host")
    let Ok(dir) = std.dir.narrow(root, "host") else {
        return Error(Failed(string.from("host dir")))
    }
    let Some(catalog) = catalog_options(options, first.max_places) else {
        return Error(Full)
    }
    let mut db = match store.open(tasks, dir, clock, random, take catalog) {
        Ok(take v) => take v,
        Error(_) => return Error(Failed(string.from("host store")))
    }
    let (sessions, tables) = match open_sessions(mut db) {
        Ok(take v) => take v,
        Error(_) => {
            let _ = store.close(take db);
            return Error(Failed(string.from("host catalog")))
        }
    }
    match platform.open_declared(take db, take tables, first) {
        Ok((take h, take hello)) => Ok((take h, take sessions, take hello)),
        Error(r) => Error(refused_of(r)),
    }
}

fn run_local[T: send](take begin: Begin[T]) -> () waits {
    let Begin(config: take config, inbox: take inbox, me: take me, ready: take ready) = take begin
    let Config(root: root, options: take options, factory: take making, seed: take seed, max_places: max_places, idle_ms: idle_ms, place_bytes: place_bytes, sessions: sessions, tasks: tasks, clock: clock, random: random, net: net, watch: take watch) = take config
    // A reopened host keeps its recorded Config; this one applies to a new catalog only.
    let (opened_host, listed_sessions, hello) = match open_host(tasks, root, clock, random, options, platform.Config(max_places: max_places, idle_ms: idle_ms)) {
        Ok(take opened) => take opened,
        Error(take why) => {
            let _ = channel.send(ready, Error(take why));
            return
        },
    }
    let (host_to, host_from): (Sender[platform.Input], Receiver[platform.Input]) = channel.new(64u64)
    let fwd: fn(take Forward) -> () waits = forward_host
    let forwarding = task.spawn(tasks, bytes 65536u64, Forward(from: take host_from, to: channel.sender(me)), fwd)
    let timers = platform.driver(tasks, clock, take host_to)
    let sizing = place_sizing(options)
    let mut a = Actor(h: take opened_host, driving: take timers, factory: take making, seed: take seed, root: root, options: take options, sizing, max_sessions: max_places, s: take listed_sessions, marks: map.new(), watching: map.new(), next_watch: 0u64, waiters: map.new(), place_bytes: place_bytes, sessions: sessions, used: 0u64, tasks: tasks, clock: clock, random: random, net: net, me: take me, watch: take watch, kids: list.new(), routes: list.new(), refused: list.new(), unloads: list.new(), removes: list.new(), reads: list.new(), retiring: list.new(), halting: false, unloaded: list.new())
    // Hello is answered with an empty inventory, so the host starts every Dirty group and
    // every passed due time (§14.5).
    apply(mut a, take hello)
    let _ = channel.send(ready, Ok(()))
    let mut halted: Option[Sender[List[Unloaded]]] = None
    while let Ok(take m) = channel.receive(inbox) {
        match take m {
            Host(take i) => {
                let n = now(a)
                let reqs = platform.step(mut a.h, mut a.driving, take i, n)
                apply(mut a, take reqs)
            },
            Up(take name, gen, take dialing) => on_up(mut a, name, gen, take dialing),
            Down(take name, gen, take ended) => on_down(mut a, name, gen, take ended),
            Create(take key, take seeding, take reply) => {
                let answer: Result[u64, Refused] = if a.halting {
                    Error(Stopping)
                } else {
                    on_create(mut a, take key, take seeding)
                }
                let _ = channel.try_send(reply, take answer)
            },
            Delete(id, take reply) => if a.halting {
                let _ = channel.try_send(reply, Error(Stopping))
            } else {
                on_delete(mut a, id, take reply)
            },
            Listing(take reply) => {
                let _ = channel.try_send(reply, on_listing(a))
            },
            Route(id, take reply) => if a.halting {
                let _ = channel.try_send(reply, Error(Stopping))
            } else {
                on_route(mut a, id, take reply)
            },
            Access(id, take check, wake, take reply) => if a.halting {
                let _ = channel.try_send(reply, Error(Stopping))
            } else {
                on_access(mut a, id, check, wake, take reply)
            },
            Peek(id, take reply) => {
                let _ = channel.try_send(reply, if a.halting {
                    Error(Stopping)
                } else {
                    on_peek(a, id)
                })
            },
            Unload(id, take reply) => if a.halting {
                let _ = channel.try_send(reply, Error(Stopping))
            } else {
                on_unload(mut a, id, take reply)
            },
            Nudge(id) => on_nudge(mut a, id),
            Marked(id, take reply) => {
                let _ = channel.try_send(reply, marks_of(a, id))
            },
            WatchMarks(id, take notify, take reply) => on_watch(mut a, id, take notify, reply),
            UnwatchMarks(id, token) => on_unwatch(mut a, id, token),
            Read(id, take r, take reply) => if a.halting {
                let _ = channel.try_send(reply, Error(Stopping))
            } else {
                on_read(mut a, id, take r, take reply)
            },
            AwaitDown(id, after, take reply) => if a.halting {
                let _ = channel.try_send(reply, Error(Stopping))
            } else {
                on_await(mut a, id, after, take reply)
            },
            Halt(take reply) => {
                a.halting = true
                halted = Some(take reply)
                for i in 0u64 .. list.len(a.kids) {
                    stop_kid(mut a.kids[i])
                }
                while let Some((_, take r)) = list.pop(mut a.routes) {
                    let _ = channel.try_send(r, Error(Stopping))
                }
            },
        }
        if a.halting && list.len(a.kids) == 0u64 {
            break
        }
    }
    while let Some((_, take r)) = list.pop(mut a.unloads) {
        let _ = channel.try_send(r, Error(Stopping))
    }
    while let Some((_, take r)) = list.pop(mut a.removes) {
        let _ = channel.try_send(r, Error(Stopping))
    }
    while let Some((_, _, take r)) = list.pop(mut a.reads) {
        let _ = channel.try_send(r, Error(Stopping))
    }
    let Actor(h: take ended_host, driving: take ended_timers, unloaded: take unloaded, waiters: take waiters, ..) = take a
    for take (_, waiting) in take waiters {
        for take (_, r) in take waiting {
            let _ = channel.try_send(r, Error(Stopping))
        }
    }
    platform.stop(take ended_timers)
    let _ = store.close(platform.close(take ended_host))
    let _ = take inbox
    let _ = task.join(take forwarding)
    if let Some(reply) = take halted {
        let _ = channel.send(reply, take unloaded)
    }
}

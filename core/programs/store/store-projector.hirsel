pub type Binding: codec + key {
    store: StoreId,
    branch: u32,
    table: u32
}

// One immutable generation: the fold of the source's changes in positions
// (from, to]. The oldest starts at 0 and holds every row it saw; a later one
// holds its range's puts and a mask per delete (§1.14). `rows` counts the
// changes folded into it, a merge's being the sum of its inputs'.
pub type Generation: codec + key {
    id: u32,
    from: u64,
    to: u64,
    rows: u64
}

// The newest position the generations cover, and the pin slot that holds it.
pub type Image: codec + key {
    position: u64,
    slot: u8
}

// An open fold into a new generation: the whole source at `target`, or, when
// `delta`, its changes from the image's position to `target`.
pub type Pass: codec + key {
    generation: u32,
    delta: bool,
    target: u64,
    rows: u64,
    resume: Option[Bytes]
}

// An open merge of a contiguous run of generations, oldest first, into
// `into`. `masks` is true unless the run starts at the oldest generation:
// only then may a merge drop a delete's mask.
pub type Merge: codec + key {
    inputs: List[u32],
    into: u32,
    masks: bool,
    resume: Option[Bytes]
}

pub type Projection: codec + key {
    binding: Option[Binding],
    image: Option[Image],
    generations: List[Generation],
    pass: Option[Pass],
    merge: Option[Merge],
    retiring: List[u32],
    next: u32,
    again: bool
}

// What a reader reads: the generations, oldest first, and the position they
// cover. A row's newest mention wins; the source's changes after `position`
// are the tail.
pub type Live {
    generations: List[Generation],
    position: u64
}

// `tail` is t, the backlog a step folds into a new generation; a smaller one
// stays in the tail. A merge starts at the oldest generation whose rows are at
// most `ratio` times the rows of the generations after it (§1.14
// "Calibration").
pub type Cadence {
    tail: u64,
    ratio: u64
}

pub fn cadence() -> Cadence {
    Cadence(tail: 1, ratio: 1)
}

pub type Source = Local | Follower(Follower)

pub opaque type ProjectionDecl: shareable + send {
    rows: Table[String, Projection],
    name: String
}

type Projector[K, V] {
    decl: ProjectionDecl,
    input: Table[K, V],
    from: Source,
    reads: Reader,
    cadence: Cadence,
    // The step bound of each commit that runs the fold (§1.14 "The bound").
    steps: u64,
    base: Option[Snapshot],
    target: Option[Snapshot],
    observed: Option[Projection]
}

pub type Delta[K, V] {
    generation: u32,
    at: u64,
    key: K,
    value: Option[V]
}

// `apply` folds one change into a generation: a put, or a delete, which a
// delta generation records as a mask. `merge` writes one page of a merge's
// output and returns where the next page resumes, None when it is done.
// `drop` deletes one page of a retired generation and returns whether rows
// remain.
pub type Fold[E: inert + send, K, V, A]: send {
    env: E,
    apply: StaticFn[fn(mut Tx, E, Delta[K, V]) -> Result[(), A]],
    merge: StaticFn[fn(mut Tx, E, Merge, Limits) -> Result[Option[Bytes], A]],
    drop: StaticFn[fn(mut Tx, E, u32, Limits) -> Result[bool, A]]
}

pub type Stepped = Folded(u64) | Paged(u64) | Published(u64) | Merging | Merged(u32) | Dropped(u32) | Reloaded | Idle

pub type ProjectError[A] = Store(Error) | Apply(A) | Stopped(OutOfTime)

fn projection_empty() -> Projection {
    Projection(binding: None, image: None, generations: list.new(), pass: None, merge: None, retiring: list.new(), next: 0, again: false)
}

pub fn projection(mut d: Declare, name: String) -> Result[ProjectionDecl, Error] {
    let _ = checked_name(pages.projector_pin_name(name, 0))?
    let rows_name = "hirsel.projections"
    let dictionary: std.codec.Codec[Projection] = std.codec.of()
    let table_key_bytes = failure_result_from_rep(catalog.table_key(rows_name))?
    if let Some(raw) = pages.get_page_row(d.plan.schema.roots.catalog, table_key_bytes) {
        let descriptor = decode_catalog(raw)?
        if option.copied(map.get(d.tables, descriptor.id)) == Some(true) {
            let rows = catalog_handle(d.plan.store, d.plan.schema.roots.catalog, take rows_name, std.codec.key_string(), dictionary)?
            return Ok(ProjectionDecl(rows: take rows, name: failure_result_from_rep(catalog.named(name))?))
        }
    }
    let declared = declare_table_inner(mut d, rows_name, std.codec.key_string(), dictionary)?
    let rows = finish(mut d, take declared)?
    Ok(ProjectionDecl(rows: take rows, name: failure_result_from_rep(catalog.named(name))?))
}

// The state a registered projector keeps between steps; the step itself is
// `run`, which alone knows the source's and the fold's types (§1.14
// "Driving"). A step opens its own Reader, so the store holds no resource.
type ProjectorState {
    decl: ProjectionDecl,
    from: Source,
    cadence: Cadence,
    steps: u64,
    base: Option[Snapshot],
    target: Option[Snapshot],
    observed: Option[Projection]
}

type DeclaredProjector {
    state: ProjectorState,
    run: own[send] fn(mut ProjectorState, mut Db, Limits) -> Result[Stepped, ProjectError[Error]] waits
}

// The pin budget of a step's Reader on a store with a pager: one value and
// a page run (§1.14 "Driving").
const PROJECTOR_READ_PINS: u64 = VALUE_LIMIT + 1048576

// Registers `decl` as the projection of `source` by `fold`, at cadence `c`,
// every commit that runs the fold bounded at `steps` (§1.14 "The bound").
// The store's head steps it on idle turns; `project_step` runs the same step.
// A read-only declaration binds Local projections without a runnable fold.
// A second registration of one name in a declaration is Conflict.
pub fn projector[K, V, E: inert + send](mut d: Declare, decl: ProjectionDecl, source: Table[K, V], take from: Source, fold: Fold[E, K, V, Error], c: Cadence, steps: u64) -> Result[(), Error] {
    if let Follower = d.mode {
        let Local = from else {
            return Error(Foreign)
        }
        validate_local_projector(d, decl, source)?
        return declare_projector_name(mut d, decl.name)
    }
    declare_projector_name(mut d, decl.name)?
    let state = ProjectorState(decl: clone(decl), from: take from, cadence: c, steps: steps, base: None, target: None, observed: None)
    let captured: Table[K, V] = clone(source)
    let folding: Fold[E, K, V, Error] = clone(fold)
    list.push(mut d.projectors, DeclaredProjector(state: take state, run: projector_run(take captured, take folding)))
    Ok(())
}

fn projector_run[K, V, E: inert + send](take source: Table[K, V], take fold: Fold[E, K, V, Error]) -> own[send] fn(mut ProjectorState, mut Db, Limits) -> Result[Stepped, ProjectError[Error]] waits {
    let stepper: own[send] fn(mut ProjectorState, mut Db, Limits) -> Result[Stepped, ProjectError[Error]] waits = fn(mut held: ProjectorState, mut db: Db, limits: Limits) -> Result[Stepped, ProjectError[Error]] waits {
        step_declared(mut held, mut db, limits, source, fold)
    }
    take stepper
}

fn source_reader(db: Db, from: Source) -> Result[Reader, Error] waits {
    match from {
        Local => reader(db, match db.pager {
            Some(_) => PROJECTOR_READ_PINS,
            None => 0u64
        }),
        Follower(remote) => follower_reader(remote, match remote.pager {
            Some(_) => PROJECTOR_READ_PINS,
            None => 0u64
        }),
    }
}

fn step_declared[K, V, E: inert + send](mut held: ProjectorState, mut db: Db, limits: Limits, source: Table[K, V], fold: Fold[E, K, V, Error]) -> Result[Stepped, ProjectError[Error]] waits {
    let reads = source_reader(db, held.from) ?=> Store
    let input: Table[K, V] = clone(source)
    let mut p = Projector(decl: clone(held.decl), input: input, from: replace(mut held.from, Local), reads: take reads, cadence: held.cadence, steps: held.steps, base: replace(mut held.base, None), target: replace(mut held.target, None), observed: replace(mut held.observed, None))
    let stepped = step_projector(mut p, mut db, limits, fold)
    let Projector(from: take from, base: take base, target: take target, observed: take observed, ..) = take p
    held.from = take from
    held.base = take base
    held.target = take target
    held.observed = take observed
    stepped
}

fn projector_slot(db: Db, name: String) -> Option[u64] {
    for k in 0u64 .. list.len(db.projectors) {
        if pages.same_name(db.projectors[k].state.decl.name, name) {
            return Some(k)
        }
    }
    None
}

/// The current commit version of the main branch.
pub fn main_commit_version(db: Db) -> u64 {
    pages.holder_heads(db.holders)[0u64].head
}

// The names of the registered projectors, in registration order.
pub fn projector_names(db: Db) -> List[String] {
    let mut out: List[String] = list.new()
    for held in db.projectors {
        list.push(mut out, clone(held.state.decl.name))
    }
    take out
}

// One step of the registered projector `name`: the step the head runs.
pub fn project_step(mut db: Db, name: String, limits: Limits) -> Result[Stepped, ProjectError[Error]] waits {
    let Some(k) = projector_slot(db, name) else {
        return Error(Store(Missing(clone(name))))
    }
    let mut held = list.remove(mut db.projectors, k)
    let stepped = (held.run)(mut held.state, mut db, limits)
    list.insert(mut db.projectors, k, take held)
    stepped
}

pub fn binding[K, V](input: Table[K, V], b: Branch) -> Binding {
    Binding(store: input.store, branch: b.id, table: input.id)
}

pub fn live(row: Projection, b: Binding) -> Option[Live] {
    if row.binding != Some(b) {
        return None
    }
    match row.image {
        Some(image) => Some(Live(generations: clone(row.generations), position: image.position)),
        None => None,
    }
}

pub fn projection_row(tx: Tx, decl: ProjectionDecl) -> Result[Projection, Error] {
    match fetch(tx, decl.rows, decl.name)? {
        Some(take row) => Ok(take row),
        None => Ok(projection_empty()),
    }
}

// The row is read from the projection's Memory table, so this reader needs
// no pager pool (§1.14 "The row").
fn read_projection(db: Db, decl: ProjectionDecl) -> Result[Projection, Error] waits {
    let current = snapshot(db)
    match get(make_reader(db.store, open_number(db), None)?, current, decl.rows, decl.name)? {
        Some(take row) => Ok(take row),
        None => Ok(projection_empty()),
    }
}

fn project_target[K, V](mut p: Projector[K, V], db: Db) -> Result[Snapshot, Error] waits {
    match p.from {
        Local => Ok(snapshot(db)),
        Follower(mut remote) => fresh(mut remote, 18446744073709551615u64),
    }
}

fn project_binding[K, V](p: Projector[K, V], db: Db) -> Result[Binding, Error] {
    let source_branch = match p.from {
        Local => main_branch(db),
        Follower(remote) => follower_main(remote),
    }
    if !types.same(p.input.store.hi, p.input.store.lo, source_branch.store.hi, source_branch.store.lo) {
        return Error(Foreign)
    }
    Ok(binding(p.input, source_branch))
}

fn same_project_snapshot(s: Snapshot, b: Binding, head: u64) -> bool {
    types.same(s.store.hi, s.store.lo, b.store.hi, b.store.lo) && s.branch == b.branch && version(s) == head
}

fn borrowed_projection_base[K, V](mut p: Projector[K, V], db: Db, b: Binding, image: Image) -> Result[Option[Snapshot], Error] waits {
    if let Some(held) = p.base {
        if same_project_snapshot(held, b, image.position) {
            return Ok(Some(clone(held)))
        }
    }
    let selected = match p.from {
        Local => owned_pin(db, ProjectorPin, pages.projector_pin_name(p.decl.name, image.slot)),
        Follower(mut remote) => exact_follower_checkpoint(mut remote, image.position)?,
    }
    match take selected {
        Some(take retained) if same_project_snapshot(retained, b, image.position) => Ok(Some(take retained)),
        _ => Ok(None),
    }
}

fn held_projection_target[K, V](mut p: Projector[K, V], b: Binding, pass: Pass) -> Result[Option[Snapshot], Error] waits {
    if let Some(held) = p.target {
        if same_project_snapshot(held, b, pass.target) {
            return Ok(Some(clone(held)))
        }
    }
    match p.from {
        Local => Ok(None),
        Follower(mut remote) => exact_follower_checkpoint(mut remote, pass.target),
    }
}

fn exact_follower_checkpoint(mut remote: Follower, wanted: u64) -> Result[Option[Snapshot], Error] waits {
    match follower_floor(mut remote, wanted) {
        Ok(Some(take captured)) if version(captured) == wanted => Ok(Some(take captured)),
        Ok(_) => Ok(None),
        Error(Reclaimed(_)) => Ok(None),
        Error(take problem) => Error(take problem),
    }
}

fn projection_page[K, V](p: Projector[K, V], base: Option[Snapshot], target: Snapshot, resume: Option[Bytes], limits: Limits) -> Result[ChangePage, Error] waits {
    if !types.same(p.input.store.hi, p.input.store.lo, target.store.hi, target.store.lo) {
        return Error(Foreign)
    }
    failure_result_from_rep(catalog.readable(target.roots, p.input.catalog_key, p.input.catalog_page, p.input.id))?
    let low = match resume {
        Some(key) => failure_result_from_rep(types.copied(key))?,
        None => failure_result_from_rep(catalog.prefix(p.input.id))?,
    }
    let page = changes_page(p.reads, base, target, low, failure_result_from_rep(catalog.prefix(p.input.id + 1))?, limits)?
    if list.len(page.trimmed) > 0 || list.len(page.bounds) > 0 {
        return Error(failure_from_rep(pages.malformed(0)))
    }
    Ok(take page)
}

fn pin_projection_target[K, V](p: Projector[K, V], mut db: Db, row: Projection, target: Snapshot) -> Result[u8, Error] waits {
    let slot = match row.image {
        Some(image) => {
            if image.slot > 1 {
                return Error(failure_from_rep(pages.malformed(0)))
            }
            1u8 - image.slot
        },
        None => 0u8,
    }
    match p.from {
        Local => {
            let name = pages.projector_pin_name(p.decl.name, slot)
            let _ = replace_projector_pin(mut db, name, target)?
            Ok(slot)
        },
        Follower(_) => Ok(0),
    }
}

// The generations cover (0, image] without a gap or an overlap: each starts
// where the one before it ends, the oldest at 0 (§1.14).
fn generations_contiguous(row: Projection) -> bool {
    let Some(image) = row.image else {
        return list.len(row.generations) == 0
    }
    let mut at = 0u64
    for k in 0u64 .. list.len(row.generations) {
        let g = row.generations[k]
        if g.from != at || g.to < g.from {
            return false
        }
        at = g.to
    }
    list.len(row.generations) > 0 && at == image.position
}

// The oldest generation whose rows are at most `ratio` times the rows of the
// generations after it starts the run to merge; the run ends at the newest.
// So each generation holds more than `ratio` times the rows of all newer ones
// together, and the count stays logarithmic in the rows folded (§1.14).
fn merge_start(generations: List[Generation], ratio: u64) -> Option[u64] {
    let m = list.len(generations)
    if m < 2 {
        return None
    }
    let mut newer = 0u64
    let mut found: Option[u64] = None
    for j in 0u64 .. m - 1 {
        let k = m - 2 - j
        newer = int.saturating_add(newer, generations[k + 1].rows)
        if generations[k].rows <= int.saturating_mul(ratio, newer) {
            found = Some(k)
        }
    }
    found
}

// Replaces a finished merge's inputs, a contiguous span of the generations, by
// the generation they merged into, and retires them, in one commit.
fn publish_merge(mut row: Projection, merge: Merge) -> Result[(), Error] {
    let span = list.len(merge.inputs)
    let total = list.len(row.generations)
    if span < 2 {
        return Error(failure_from_rep(pages.malformed(0)))
    }
    let mut start = total
    for k in 0u64 .. total {
        if row.generations[k].id == merge.inputs[0] {
            start = k
            break
        }
    }
    if start == total || span > total - start {
        return Error(failure_from_rep(pages.malformed(0)))
    }
    let mut rows = 0u64
    for j in 0u64 .. span {
        if row.generations[start + j].id != merge.inputs[j] {
            return Error(failure_from_rep(pages.malformed(0)))
        }
        rows = int.saturating_add(rows, row.generations[start + j].rows)
    }
    let merged = Generation(id: merge.into, from: row.generations[start].from, to: row.generations[start + span - 1].to, rows: rows)
    let mut kept: List[Generation] = list.new()
    for k in 0u64 .. total {
        if k == start {
            list.push(mut kept, merged)
        }
        if k < start || k >= start + span {
            list.push(mut kept, row.generations[k])
        }
    }
    row.generations = take kept
    for j in 0u64 .. span {
        list.push(mut row.retiring, merge.inputs[j])
    }
    row.merge = None
    if !generations_contiguous(row) {
        return Error(failure_from_rep(pages.malformed(0)))
    }
    Ok(())
}

fn without_generation(retiring: List[u32], generation: u32) -> List[u32] {
    let mut kept: List[u32] = list.new()
    let mut found = false
    for k in 0u64 .. list.len(retiring) {
        if !found && retiring[k] == generation {
            found = true
        } else {
            list.push(mut kept, retiring[k])
        }
    }
    take kept
}

type ProjectionAction = SetProjection | ApplyPage(u32, u64, List[Change]) | MergePage(Limits) | DropGeneration(u32, Limits)

type ProjectionWork[K, V, E: inert + send, A] {
    decl: ProjectionDecl,
    input: Table[K, V],
    expected: Projection,
    replacement: Projection,
    action: ProjectionAction,
    fold: Fold[E, K, V, A]
}

type ProjectionAbort[A] = ProjectionMoved | ProjectionFailed(ProjectError[A])

fn apply_projection_change[K, V, E: inert + send, A](mut tx: Tx, input: Table[K, V], fold: Fold[E, K, V, A], change: Change, generation: u32, at: u64) -> Result[(), ProjectError[A]] {
    let raw_key = list.slice(change.tree_key, 4, list.len(change.tree_key))
    let key = failure_result_from_rep(catalog.decoded(std.codec.decode_key(input.key, raw_key))) ?=> Store
    let value = match change.value {
        Some(raw) => Some(row_value(input.readers, input.id, raw) ?=> Store),
        None => None,
    }
    (code.callable(fold.apply))(mut tx, fold.env, Delta(generation: generation, at: at, key: take key, value: take value)) ?=> Apply
    Ok(())
}

fn write_projection[K, V, E: inert + send, A](mut tx: Tx, work: ProjectionWork[K, V, E, A]) -> Result[Projection, ProjectionAbort[A]] {
    let observed = projection_row(tx, work.decl) ?=> |problem| ProjectionFailed(Store(take problem))
    if observed != work.expected {
        return Error(ProjectionMoved)
    }
    let mut replacement: Projection = clone(work.replacement)
    match work.action {
        SetProjection => (),
        ApplyPage(generation, at, page_rows) => for change in page_rows {
            apply_projection_change(mut tx, work.input, work.fold, change, generation, at) ?=> ProjectionFailed
        },
        MergePage(limits) => {
            let opened: Option[Merge] = clone(work.replacement.merge)
            let Some(take merge) = take opened else {
                return Error(ProjectionFailed(Store(failure_from_rep(pages.malformed(0)))))
            }
            let resumed = (code.callable(work.fold.merge))(mut tx, work.fold.env, merge, limits) ?=> |problem| ProjectionFailed(Apply(take problem))
            match take resumed {
                Some(take key) => {
                    let mut paged: Merge = clone(merge)
                    paged.resume = Some(take key)
                    replacement.merge = Some(take paged)
                },
                None => publish_merge(mut replacement, merge) ?=> |problem| ProjectionFailed(Store(take problem)),
            }
        },
        DropGeneration(generation, limits) => {
            let remaining = (code.callable(work.fold.drop))(mut tx, work.fold.env, generation, limits) ?=> |problem| ProjectionFailed(Apply(take problem))
            if !remaining {
                replacement.retiring = without_generation(replacement.retiring, generation)
            }
        },
    }
    put(mut tx, work.decl.rows, work.decl.name, replacement) ?=> |problem| ProjectionFailed(Store(take problem))
    Ok(take replacement)
}

fn project_commit[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, expected: Projection, take replacement: Projection, take action: ProjectionAction, fold: Fold[E, K, V, A]) -> Result[bool, ProjectError[A]] waits {
    let work: ProjectionWork[K, V, E, A] = ProjectionWork(decl: clone(p.decl), input: clone(p.input), expected: clone(expected), replacement: take replacement, action: take action, fold: clone(fold))
    let outcome = run(mut db, Some(p.steps), work, write_projection) ?=> Store
    match take outcome {
        Committed(Done(value: take current, ..)) => {
            p.observed = Some(take current)
            Ok(true)
        },
        Aborted(Undone(value: ProjectionMoved, ..)) => {
            p.observed = None
            Ok(false)
        },
        Aborted(Undone(value: ProjectionFailed(take problem), ..)) => Error(take problem),
        Failed(Conflict(take name)) => Error(Store(Conflict(take name))),
        Refused(problem) => Error(Store(Full(problem))),
        Stopped(limit) => Error(Stopped(limit)),
        _ => Error(Store(MigrationFault)),
    }
}

fn forget_projector[K, V](mut p: Projector[K, V]) -> Stepped {
    p.base = None
    p.target = None
    Reloaded
}

// A pass that cannot continue retires its partial generation. A whole-source
// pass is then started again; a delta's changes stay in the tail.
fn discard_projection_pass[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, row: Projection, pass: Pass, fold: Fold[E, K, V, A]) -> Result[Stepped, ProjectError[A]] waits {
    let mut ready: Projection = clone(row)
    ready.pass = None
    list.push(mut ready.retiring, pass.generation)
    ready.again = row.again || !pass.delta
    let _ = project_commit(mut p, mut db, row, take ready, SetProjection, fold)?
    Ok(forget_projector(mut p))
}

fn discard_merge[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, row: Projection, merge: Merge, fold: Fold[E, K, V, A]) -> Result[Stepped, ProjectError[A]] waits {
    let mut ready: Projection = clone(row)
    ready.merge = None
    list.push(mut ready.retiring, merge.into)
    let _ = project_commit(mut p, mut db, row, take ready, SetProjection, fold)?
    Ok(forget_projector(mut p))
}

fn retire_projection[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, row: Projection, generation: u32, limits: Limits, fold: Fold[E, K, V, A]) -> Result[Stepped, ProjectError[A]] waits {
    if project_commit(mut p, mut db, row, clone(row), DropGeneration(generation, limits), fold)? {
        return Ok(Dropped(generation))
    }
    Ok(forget_projector(mut p))
}

fn rebind_projection[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, row: Projection, source_binding: Binding, limits: Limits, fold: Fold[E, K, V, A]) -> Result[Stepped, ProjectError[A]] waits {
    if let Some(pass) = row.pass {
        return discard_projection_pass(mut p, mut db, row, pass, fold)
    }
    if let Some(merge) = row.merge {
        return discard_merge(mut p, mut db, row, merge, fold)
    }
    if list.len(row.retiring) > 0 {
        return retire_projection(mut p, mut db, row, row.retiring[0], limits, fold)
    }
    let mut ready: Projection = clone(row)
    ready.binding = Some(source_binding)
    ready.image = None
    for k in 0u64 .. list.len(row.generations) {
        list.push(mut ready.retiring, row.generations[k].id)
    }
    ready.generations = list.new()
    let _ = project_commit(mut p, mut db, row, take ready, SetProjection, fold)?
    Ok(forget_projector(mut p))
}

// Folds one page of a pass into its generation. The last page publishes it:
// a delta generation joins the newest end, a whole-source one replaces every
// generation, and the pin moves to the target (§1.14).
fn publish_projection_page[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, row: Projection, target: Snapshot, generation: u32, take page: ChangePage, fold: Fold[E, K, V, A], opening: bool, delta: bool, folded: u64) -> Result[Stepped, ProjectError[A]] waits {
    let ChangePage(changes: take page_rows, next: take resume, ..) = take page
    let at = version(target)
    let n = list.len(page_rows)
    let rows = int.saturating_add(folded, n)
    let mut ready: Projection = clone(row)
    if opening {
        let Some(next_generation) = int.checked_add(row.next, 1u32) else {
            return Error(Store(Limit(Ids)))
        }
        ready.next = next_generation
        if !delta {
            ready.again = false
        }
    }
    let advanced: Stepped = if let Some(take key) = take resume {
        ready.pass = Some(Pass(generation: generation, delta: delta, target: at, rows: rows, resume: Some(take key)))
        Paged(n)
    } else {
        let slot = pin_projection_target(p, mut db, row, target) ?=> Store
        ready.pass = None
        if delta {
            let Some(image) = row.image else {
                return Error(Store(failure_from_rep(pages.malformed(0))))
            }
            list.push(mut ready.generations, Generation(id: generation, from: image.position, to: at, rows: rows))
        } else {
            for k in 0u64 .. list.len(row.generations) {
                list.push(mut ready.retiring, row.generations[k].id)
            }
            if let Some(merge) = row.merge {
                list.push(mut ready.retiring, merge.into)
            }
            ready.merge = None
            let mut only: List[Generation] = list.new()
            list.push(mut only, Generation(id: generation, from: 0, to: at, rows: rows))
            ready.generations = take only
        }
        ready.image = Some(Image(position: at, slot: slot))
        if !generations_contiguous(ready) {
            return Error(Store(failure_from_rep(pages.malformed(0))))
        }
        if delta {
            Folded(rows)
        } else {
            Published(at)
        }
    }
    if !project_commit(mut p, mut db, row, take ready, ApplyPage(generation, at, take page_rows), fold)? {
        return Ok(forget_projector(mut p))
    }
    if let Paged(_) = advanced {
        p.target = Some(clone(target))
    } else {
        p.base = Some(clone(target))
        p.target = None
    }
    Ok(advanced)
}

fn continue_projection[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, row: Projection, source_binding: Binding, pass: Pass, limits: Limits, fold: Fold[E, K, V, A]) -> Result[Stepped, ProjectError[A]] waits {
    let Some(take target) = held_projection_target(mut p, source_binding, pass) ?=> Store else {
        return discard_projection_pass(mut p, mut db, row, pass, fold)
    }
    let base: Option[Snapshot] = if pass.delta {
        let Some(image) = row.image else {
            return Error(Store(failure_from_rep(pages.malformed(0))))
        }
        match borrowed_projection_base(mut p, db, source_binding, image) ?=> Store {
            Some(take held) => Some(take held),
            None => return discard_projection_pass(mut p, mut db, row, pass, fold),
        }
    } else {
        None
    }
    let page = match projection_page(p, take base, target, pass.resume, limits) {
        Ok(take page) => take page,
        Error(Reclaimed(_)) => return discard_projection_pass(mut p, mut db, row, pass, fold),
        Error(take problem) => return Error(Store(take problem)),
    }
    publish_projection_page(mut p, mut db, row, target, pass.generation, take page, fold, false, pass.delta, pass.rows)
}

// One page of the open merge, or of a merge the cadence starts now. The page
// that finishes it publishes the merged generation in the same commit.
fn merge_projection[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, row: Projection, start: u64, limits: Limits, fold: Fold[E, K, V, A]) -> Result[Stepped, ProjectError[A]] waits {
    let mut ready: Projection = clone(row)
    if row.merge == None {
        let Some(next_generation) = int.checked_add(row.next, 1u32) else {
            return Error(Store(Limit(Ids)))
        }
        let mut inputs: List[u32] = list.new()
        for k in start .. list.len(row.generations) {
            list.push(mut inputs, row.generations[k].id)
        }
        ready.merge = Some(Merge(inputs: take inputs, into: row.next, masks: start > 0, resume: None))
        ready.next = next_generation
    }
    let into = match ready.merge {
        Some(merge) => merge.into,
        None => return Error(Store(failure_from_rep(pages.malformed(0)))),
    }
    if !project_commit(mut p, mut db, row, take ready, MergePage(limits), fold)? {
        return Ok(forget_projector(mut p))
    }
    match p.observed {
        Some(current) if current.merge == None => Ok(Merged(into)),
        _ => Ok(Merging),
    }
}

// With the tail below t: an open or due merge, then a retired generation's
// drop, else nothing to do.
fn tend_projection[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, row: Projection, limits: Limits, fold: Fold[E, K, V, A]) -> Result[Stepped, ProjectError[A]] waits {
    if row.merge != None {
        return merge_projection(mut p, mut db, row, 0, limits, fold)
    }
    if let Some(start) = merge_start(row.generations, p.cadence.ratio) {
        return merge_projection(mut p, mut db, row, start, limits, fold)
    }
    if list.len(row.retiring) > 0 {
        return retire_projection(mut p, mut db, row, row.retiring[0], limits, fold)
    }
    Ok(Idle)
}

// One unit of work, in order: rebind, continue an open pass, fold a tail of t
// changes or more into a new generation, merge, drop a retired generation. A
// projection with no image, a lost base or a rebuild request folds the whole
// source instead (§1.14).
fn step_projector[K, V, E: inert + send, A](mut p: Projector[K, V], mut db: Db, limits: Limits, fold: Fold[E, K, V, A]) -> Result[Stepped, ProjectError[A]] waits {
    page_limits(limits) ?=> Store
    let row = read_projection(db, p.decl) ?=> Store
    let moved = match p.observed {
        Some(previous) => previous != row,
        None => false
    }
    p.observed = Some(clone(row))
    if moved {
        return Ok(forget_projector(mut p))
    }
    let source_binding = project_binding(p, db) ?=> Store
    if row.binding != Some(source_binding) {
        return rebind_projection(mut p, mut db, row, source_binding, limits, fold)
    }
    if let Some(pass) = row.pass {
        return continue_projection(mut p, mut db, row, source_binding, pass, limits, fold)
    }
    let target = project_target(mut p, db) ?=> Store
    if let Some(image) = row.image {
        if !row.again {
            if let Some(take base) = borrowed_projection_base(mut p, db, source_binding, image) ?=> Store {
                if version(base) == version(target) {
                    return tend_projection(mut p, mut db, row, limits, fold)
                }
                match projection_page(p, Some(take base), target, None, limits) {
                    Ok(take page) => {
                        let due = match page.next {
                            Some(_) => true,
                            None => list.len(page.changes) >= p.cadence.tail && list.len(page.changes) > 0,
                        }
                        if !due {
                            return tend_projection(mut p, mut db, row, limits, fold)
                        }
                        if row.next == 4294967295u32 {
                            return Error(Store(Limit(Ids)))
                        }
                        return publish_projection_page(mut p, mut db, row, target, row.next, take page, fold, true, true, 0)
                    },
                    Error(Reclaimed(_)) => (),
                    Error(take problem) => return Error(Store(take problem)),
                }
            }
        }
    }
    if list.len(row.retiring) > 0 {
        return retire_projection(mut p, mut db, row, row.retiring[0], limits, fold)
    }
    if row.next == 4294967295u32 {
        return Error(Store(Limit(Ids)))
    }
    let page = projection_page(p, None, target, None, limits) ?=> Store
    publish_projection_page(mut p, mut db, row, target, row.next, take page, fold, true, false, 0)
}

// Asks the registered projector `name` to fold its whole source again into
// a new generation at its next step (§1.14 "Rebuild").
pub fn rebuild(mut db: Db, name: String) -> Result[Ticket, Error] waits {
    let Some(k) = projector_slot(db, name) else {
        return Error(Missing(clone(name)))
    }
    let decl: ProjectionDecl = clone(db.projectors[k].state.decl)
    let row = read_projection(db, decl)?
    if row.again {
        return Ok(Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, pages.holder_heads(db.holders)[0].head)))
    }
    let request_env: (ProjectionDecl, Projection) = (take decl, row)
    // The store's own body: it reads and writes only the projection's row,
    // so it runs unbounded on every store.
    journal_poll(mut db)?
    healthy(db)?
    let keep: Option[fn(Error) -> bool] = None
    let requested = store_body_on(mut db, 0, None, keep, scoped fn(mut tx: Tx) -> Result[Projection, Error] {
        let mut updated = projection_row(tx, request_env.0)?
        if updated != request_env.1 {
            return Error(Foreign)
        }
        updated.again = true
        put(mut tx, request_env.0 .rows, request_env.0 .name, updated)?
        Ok(take updated)
    })?
    match take requested {
        Committed(Done(value: take current, ticket: committed, ..)) => {
            let mut held = list.remove(mut db.projectors, k)
            held.state.observed = Some(take current)
            list.insert(mut db.projectors, k, take held)
            Ok(committed)
        },
        Aborted(Undone(value: take problem, ..)) => Error(take problem),
        Failed(Conflict(take conflicted)) => Error(Conflict(take conflicted)),
        Refused(problem) => Error(Full(problem)),
        _ => Error(MigrationFault),
    }
}

fn pin_owner_tag(owner: pages.PinOwner) -> u64 {
    match owner {
        ApplicationPin => 1,
        ProjectorPin => 2,
        ImportPin => 3,
    }
}

fn pin_order(a: String, a_owner: pages.PinOwner, b: String, b_owner: pages.PinOwner) -> Order {
    let names = order.compare(a, b)
    if names == Equal {
        order.compare(pin_owner_tag(a_owner), pin_owner_tag(b_owner))
    } else {
        names
    }
}

fn pin_index(db: Db, owner: pages.PinOwner, name: String) -> u64 {
    for k in 0u64 .. list.len(pages.holder_pins(db.holders)) {
        if pages.holder_pins(db.holders)[k].owner == owner && pages.same_name(pages.holder_pins(db.holders)[k].name, name) {
            return k
        }
    }
    list.len(pages.holder_pins(db.holders))
}

pub fn pinned(db: Db, name: String) -> Option[Snapshot] {
    owned_pin(db, ApplicationPin, name)
}

fn owned_pin(db: Db, owner: pages.PinOwner, name: String) -> Option[Snapshot] {
    let k = pin_index(db, owner, name)
    if k == list.len(pages.holder_pins(db.holders)) {
        return None
    }
    let p = pages.holder_pins(db.holders)[k]
    Some(Snapshot(store: db.store, open: open_number(db), branch: p.branch, head: p.version, roots: pages.share_roots(p.roots), watermark: p.watermark, bases: pages.no_tail_bases()))
}

pub fn pin(mut db: Db, name: String, s: Snapshot) -> Result[Ticket, Error] waits {
    change_pin(mut db, ApplicationPin, name, s)
}

fn replace_projector_pin(mut db: Db, name: String, s: Snapshot) -> Result[Ticket, Error] waits {
    change_pin(mut db, ProjectorPin, name, s)
}

fn capture_matches_head(from: Snapshot, head: pages.Head) -> bool {
    roots_match_head(from.head, from.roots, head)
}

fn roots_match_head(at_version: u64, roots: pages.Roots, head: pages.Head) -> bool {
    if !(head.head == at_version && pages.tree_stamp(head.roots.collections) == pages.tree_stamp(roots.collections) && pages.tree_stamp(head.roots.streams) == pages.tree_stamp(roots.streams) && pages.tree_stamp(head.roots.catalog) == pages.tree_stamp(roots.catalog) && list.len(head.roots.keyed) == list.len(roots.keyed)) {
        return false
    }
    for slot in 0u64 .. list.len(head.roots.keyed) {
        if pages.tree_stamp(head.roots.keyed[slot]) != pages.tree_stamp(roots.keyed[slot]) {
            return false
        }
    }
    true
}

// A pin `change_pin` gave the head's shares needs no promotion (§13.5
// "Pinning the live head"); any other pin is historical.
fn pin_shares_head(db: Db, held: pages.Pin) -> bool {
    match branch_slot(db, held.branch) {
        Ok(slot) => roots_match_head(held.version, held.roots, pages.holder_heads(db.holders)[slot]),
        Error(_) => false,
    }
}

fn change_pin(mut db: Db, owner: pages.PinOwner, name: String, s: Snapshot) -> Result[Ticket, Error] waits {
    let delta = pin_delta(mut db, owner, name, s)?
    cut_install(mut db, take delta)
}

// The holder change a pin's cut publishes.
fn pin_delta(mut db: Db, owner: pages.PinOwner, name: String, s: Snapshot) -> Result[HolderDelta, Error] {
    journal_poll(mut db)?
    healthy(db)?
    this_open(db, s)?
    let owned = checked_name(name)?
    let slot = pin_index(db, owner, name)
    let replacing = slot != list.len(pages.holder_pins(db.holders))
    if replacing {
        if owner == ApplicationPin {
            return Error(Exists(take owned))
        }
        check_manifest_addition(db, int.saturating_sub(keyed_root_record_bytes(s.roots.keyed), keyed_root_record_bytes(pages.holder_pins(db.holders)[slot].roots.keyed)))?
    } else {
        check_manifest_addition(db, pin_root_bytes(name, s.roots))?
    }
    let serial = pages.holder_next_pin(db.holders)
    let Some(following) = int.checked_add(serial, 1) else {
        return Error(Limit(Ids))
    }
    pages.set_next_pin(mut db.holders, following)
    // Equal stamps identify the logical roots. A cut may have moved their frames.
    let roots = match branch_slot(db, s.branch) {
        Ok(head_slot) if capture_matches_head(s, pages.holder_heads(db.holders)[head_slot]) => pages.share_roots(pages.holder_heads(db.holders)[head_slot].roots),
        _ => pages.share_roots(s.roots),
    }
    let kept = pages.Pin(owner: owner, name: take owned, branch: s.branch, version: s.head, serial: serial, roots: take roots, watermark: s.watermark)
    if replacing {
        return Ok(ReplacePin(slot, take kept))
    }
    Ok(AddPin(take kept))
}

pub fn unpin(mut db: Db, name: String) -> Result[Ticket, Error] waits {
    remove_pin(mut db, ApplicationPin, name)
}

fn remove_pin(mut db: Db, owner: pages.PinOwner, name: String) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let k = pin_index(db, owner, name)
    if k == list.len(pages.holder_pins(db.holders)) {
        return Error(Missing(failure_result_from_rep(catalog.named(name))?))
    }
    cut_install(mut db, RemovePin(k))
}

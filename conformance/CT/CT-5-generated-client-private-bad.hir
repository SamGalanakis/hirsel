// rule: CT-5
// expect: reject PROG-2 at line 13
// twin: CT/CT-5-generic-instance-run.hir
// CT-5 + PROG-2: a library's generated declaration instantiated at a type
// private to the client; the generated text names the client's type.
type Point {
  x: u64,
  y: u64,
}

pub fn main(rt: Io) -> Result[(), GrantError] {
  let out = io.stdout(rt)?
  let _ = out.print(out, f"{gen.width(Point(x: 1, y: 2))}\n")
  Ok(())
}

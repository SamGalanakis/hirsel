fn reenter(mut n: u64, take c: Cell[u64]) -> u64 { n }
fn keep(mut n: u64, take s: Sender[u64]) -> u64 { n }
fn view_out(mut n: u64, take a: u64) -> View[u64] in n { view n }
fn run(take c: Cell[u64]) -> u64 { 0 }
type Holder { c: Cell[u64] }
fn holder(mut n: u64, take h: Holder) -> u64 { n }

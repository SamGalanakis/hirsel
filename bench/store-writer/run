#!/usr/bin/env python3
"""Build and measure one sample of each store-writer/metal workload on local disk."""
import argparse
from contextlib import ExitStack, contextmanager
import itertools
import json
import math
import os
from pathlib import Path
import re
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import threading

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
BANNED = {12, 13, 14, 15, 28, 29, 30, 31}
# A cell is one authority at one level its provider declares, the deployment's floor.
# `survives` is the failure an acknowledged commit survives at that level. `barriers` is
# what the kernel must see per commit group, as (pwrite64, fdatasync, fsync) counts in
# trace order, or None for "at least one fdatasync or fsync per group, any mix".
CELLS = {
    'log-host': dict(provider='authority.log@1', floor='host', barriers=('w', 'd'),
                     survives='operating system crash or power loss; the disk survives'),
    'log-process': dict(provider='authority.log@1', floor='process', barriers=('w',),
                        survives='process crash; written to the operating system, not synchronized'),
    'memory': dict(provider='authority.memory@1', floor='memory', barriers=(),
                   survives='nothing outside the process; the history lives in its memory'),
    'objects-dir': dict(provider='authority.objects@1', floor='host', barriers=None,
                        survives='operating system crash or power loss; objects.dir@1 syncs each '
                                 'object and its directories before a put returns'),
}
# The repository's TLS test identities (crates/hirsel-rt/tests/it/tls-data/README.md).
TLS = ROOT / 'crates/hirsel-rt/tests/it/tls-data'
TOOLCHAIN_VARIABLES = ('HIRSEL_RUNTIME_ARCHIVES', 'HIRSEL_LINK_KIT', 'HIRSEL_GLIBC_FLOOR',
                       'HIRSEL_CAPTURE_LINKER', 'HIRSEL_AUDITOR_PACKAGE', 'LLVM_SYS_231_PREFIX')


def run(command, **kwargs):
    return subprocess.run(list(map(str, command)), check=True, **kwargs)


def build(out):
    run([sys.executable, ROOT / 'tools/buck2/prepare.py'])
    targets = ['hirsel-toolchain', 'hirsel-rt-archives']
    output = subprocess.check_output([str(ROOT / '.buck2/bin/buck2'), 'build',
        '--target-platforms', '//tools/buck2:release', *['//:' + t for t in targets],
        '//tools/buck2/native-toolchain:kit', '//tools/buck2/native-toolchain:glibc_floor',
        '//tools/buck2/native-toolchain:linker', '//tools/buck2/native-toolchain:runtime-auditor',
        '--show-full-output'], cwd=ROOT, text=True)
    paths = {line.split()[0].rsplit(':', 1)[1]: line.split()[1]
             for line in output.splitlines() if line.startswith('root//')}
    compiler = Path(paths['hirsel-toolchain']) / 'hirsel'
    environment = dict(os.environ, HIRSEL_RUNTIME_ARCHIVES=paths['hirsel-rt-archives'],
        HIRSEL_LINK_KIT=paths['kit'], HIRSEL_GLIBC_FLOOR=paths['glibc_floor'],
        HIRSEL_CAPTURE_LINKER=paths['linker'], HIRSEL_AUDITOR_PACKAGE=paths['runtime-auditor'],
        LLVM_SYS_231_PREFIX=str(ROOT / 'tools/buck2/toolchains/llvm-files'))
    run([ROOT / 'tools/capped', compiler, 'build', HERE / 'hirsel.json', '--release',
         '-o', out / 'native'], env=environment)
    # `hirsel serve --native` links the place's head with the same inputs.
    (out / 'toolchain.json').write_text(json.dumps({k: environment[k] for k in TOOLCHAIN_VARIABLES}))
    return compiler


def children(pid):
    """`pid` and its descendants, whichever of their threads started them."""
    yield pid
    for path in Path(f'/proc/{pid}/task').glob('*/children'):
        try:
            found = path.read_text().split()
        except OSError:
            continue
        for child in found:
            yield from children(int(child))


def target_pid(parent, executable):
    for pid in children(parent):
        try:
            if Path(f'/proc/{pid}/exe').resolve() == executable.resolve():
                return pid
        except OSError:
            pass
    raise RuntimeError('READY did not come from the expected child executable')


def addresses(binary, wanted):
    output = subprocess.check_output(['nm', '-anC', str(binary)], text=True)
    result = {}
    for line in output.splitlines():
        parts = line.split(maxsplit=2)
        if len(parts) == 3:
            for key, suffix in wanted.items():
                if parts[2].endswith(suffix):
                    result[key] = int(parts[0], 16)
    if result.keys() != wanted.keys():
        raise RuntimeError(f'missing allocation probe symbols in {binary}: {wanted.keys() - result.keys()}')
    return result


def read_counters(pid, objects):
    values = {}
    maps = Path(f'/proc/{pid}/maps').read_text().splitlines()
    with open(f'/proc/{pid}/mem', 'rb', buffering=0) as memory:
        for binary, symbols in objects:
            mapping = next(line.split() for line in maps
                           if line.split()[-1] == str(binary.resolve()) and int(line.split()[2], 16) == 0)
            base = int(mapping[0].split('-')[0], 16)
            # Shared objects and Rust PIEs use relative symbol addresses.
            elf_type = subprocess.check_output(['readelf', '-h', str(binary)], text=True)
            if 'DYN (Position-Independent Executable file)' not in elf_type and 'DYN (Shared object file)' not in elf_type:
                base = 0
            for name, address in symbols.items():
                memory.seek(base + address)
                values[name] = struct.unpack('Q', memory.read(8))[0]
    return values


def kill_owned(pid):
    """Kill `pid`, a process this bench started, and its descendants."""
    for owned in reversed(list(children(pid))):
        try:
            os.kill(owned, 9)
        except ProcessLookupError:
            pass


@contextmanager
def place_host(compiler, directory, db, authority):
    """A `hirsel serve --native` host whose place's head is this bench's `head`,
    its store the cell's `authority` over `db`, as the local mode's. Yields the
    host's Unix socket and its compiler process."""
    if not all(name in os.environ for name in TOOLCHAIN_VARIABLES):
        raise RuntimeError('a served sample links its head: build into this output directory first')
    scratch = Path(tempfile.mkdtemp(prefix='storebench-', dir='/tmp'))  # Socket paths are short.
    socket = scratch / 'host.sock'
    host = directory / 'host.json'
    host.write_text(json.dumps(dict(listen=dict(unix=str(socket)),
        identity=dict(chain=str(TLS / 'server.cert'), key=str(TLS / 'server.key')),
        clients=dict(pem=str(TLS / 'client-ca.cert')),
        callers=[dict(name='bench', identity=dict(subject='agent-7.hirsel.test'),
                      grants=dict(dirs=[]), definitions=None)],
        place=dict(head='store_writer_bench@1/head', grants=dict(
            dirs=[dict(path='db', host=str(db), access='read_write')],
            authorities=dict(db=authority))))))
    log = (directory / 'host.log').open('w')
    process = subprocess.Popen(list(map(str, [ROOT / 'tools/capped', compiler, 'serve', '--native',
        HERE / 'hirsel.json', '--host', host])), stdout=log, stderr=subprocess.PIPE, text=True)
    try:
        for line in process.stderr:
            log.write(line)
            if line.startswith('hirsel serve: listening on '):
                break
        else:
            raise RuntimeError(f'the place host did not start: {directory / "host.log"}')
        drain = threading.Thread(target=lambda: log.writelines(process.stderr), daemon=True)
        drain.start()
        yield socket, target_pid(process.pid, compiler)
    finally:
        kill_owned(process.pid)
        process.wait()
        log.close()
        shutil.rmtree(scratch)


class Attached:
    """`perf stat` attached to one running process, counting only between
    `enable` and `disable`."""
    def __init__(self, pid, events, path):
        self.control, self.ack = path.with_suffix('.control'), path.with_suffix('.ack')
        os.mkfifo(self.control)
        os.mkfifo(self.ack)
        self.write, self.read = os.open(self.control, os.O_RDWR), os.open(self.ack, os.O_RDWR)
        self.path, self.values = path, None
        self.process = subprocess.Popen(['perf', 'stat', '-x', ';', '-e', events, '-p', str(pid),
            '-o', path, '-D', '-1', f'--control=fifo:{self.control},{self.ack}'],
            stderr=subprocess.DEVNULL)

    def send(self, message):
        os.write(self.write, (message + '\n').encode())
        answer = os.read(self.read, 128)
        if not answer.startswith(b'ack'):
            raise RuntimeError(f'perf control failed: {answer!r}')

    def finish(self):
        """The counters, once `perf` has written them."""
        if self.values is not None:
            return self.values
        if self.process.poll() is None:
            self.process.send_signal(signal.SIGINT)
        self.process.wait()
        for fd in (self.write, self.read):
            os.close(fd)
        self.control.unlink()
        self.ack.unlink()
        self.values = perf_values(self.path)
        return self.values


def disk_bytes(directory):
    return sum(p.stat().st_size for p in directory.rglob('*') if p.is_file())


PROBE_SETS = itertools.count()


@contextmanager
def native_allocation_probes(binary):
    # The local native probes stay while a served head's are added: name each set apart.
    group = f'storebench_{os.getpid()}_{next(PROBE_SETS)}'
    events = []
    try:
        for name in ('malloc', 'calloc', 'realloc'):
            event = f'{group}:{group}_{name}'
            run(['sudo', '-n', 'perf', 'probe', '-x', binary, '--add', f'{event}={name}'],
                stdout=subprocess.DEVNULL)
            events.append(event)
        yield events
    finally:
        for event in events:
            run(['sudo', '-n', 'perf', 'probe', '--del', event], stdout=subprocess.DEVNULL)


def perf_values(path):
    values = {}
    for line in path.read_text().splitlines():
        fields = line.split(';')
        if len(fields) >= 3:
            try:
                values[fields[2]] = float(fields[0].replace(',', ''))
            except ValueError:
                pass
    return values


def sync_trace(path):
    """The phase's successful barrier durations and its log calls in order:
    'w' for a pwrite64, 'd' for an fdatasync and 's' for an fsync."""
    active = False
    syncs = []
    calls = []
    for line in path.read_text().splitlines():
        if r'"READY\n"' in line:
            active = True
        elif r'"DONE\n"' in line:
            active = False
        elif active:
            # A call another thread interrupted ends on a later 'resumed' line.
            call = re.search(r'\b(pwrite64|fdatasync|fsync)(?:\(| resumed>).*= ([0-9]+) <([0-9.]+)>$', line)
            if call:
                name, result, seconds = call[1], int(call[2]), float(call[3])
                if name == 'pwrite64':
                    calls.append('w')
                elif result == 0:
                    syncs.append(seconds)
                    calls.append('d' if name == 'fdatasync' else 's')
    return syncs, calls


def check_barriers(cell, commits, appends, datasyncs, fsyncs, order=None):
    """What the cell's authority must do with group_commits 1 and one writer:
    each commit group is one advance. authority.log@1 appends its frame with
    one pwrite and, at `host` only, issues one fdatasync before the group is
    acknowledged; a segment is 256 MiB, so no segment starts in the phase.
    authority.memory@1 makes no file calls. authority.objects@1 over
    objects.dir@1 syncs at least once per group. `order`, from a trace, also
    requires each log barrier to follow its own append."""
    shape = CELLS[cell]['barriers']
    if shape is None:
        if datasyncs + fsyncs < commits:
            raise RuntimeError(f'{cell} barriers: {datasyncs} fdatasync and {fsyncs} fsync for '
                               f'{commits} commit groups; expected at least one each')
        return
    expected = tuple(commits * shape.count(c) for c in 'wds')
    if (appends, datasyncs, fsyncs) != expected:
        raise RuntimeError(f'{cell} barriers: {appends} pwrite64, {datasyncs} fdatasync and {fsyncs} fsync '
                           f'for {commits} commit groups; expected {expected}')
    if order is not None and order != list(shape) * commits:
        raise RuntimeError(f'{cell} barriers: a commit group\'s calls were out of order')


def source_revision():
    revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
    if subprocess.call(['git', 'diff', '--quiet', 'HEAD', '--', '.'], cwd=ROOT):
        raise RuntimeError('commit source changes before measuring or resuming')
    return revision


def binding(source_sha, workload, kind, cell, group, submitters, profile=False, allocations=False):
    return dict(source_sha=source_sha, workload=workload, engine=kind, cell=cell, group=group,
                submitters=submitters, profile=profile, allocations=allocations)


def saved_sample(path, expected):
    row = json.loads(path.read_text())
    if row.get('binding') != expected:
        raise RuntimeError(f'{path}: source/workload binding differs or is missing; '
                           'use a fresh output directory')
    return row


def sample(kind, cell, group, submitters, workload, out, compiler, source_sha, profile=False, allocation_events=(),
           head_allocations=False):
    if source_revision() != source_sha:
        raise RuntimeError('source revision changed before measurement')
    suffix = f'{kind}-{cell}-g{group}-c{submitters}' + ('-profile' if profile else '-allocations' if allocation_events or head_allocations else '')
    directory = out / suffix
    directory.mkdir()  # Never reuse an old database or overwrite original evidence.
    db = directory / 'db'
    db.mkdir()
    host = ExitStack()
    with host:
        # A served sample's transactions run in the place's head, which a host links and starts.
        attached, probes, served = [], [], kind == 'served'
        arguments = [workload[k] for k in ('accounts', 'initial_balance', 'transfers', 'amount')]
        arguments += [group, submitters]
        grants = directory / 'grants.json'
        spec = CELLS[cell]
        authority = dict(provider=spec['provider'], floor=spec['floor'])
        stored = db  # Where the cell's history lives on disk, if anywhere.
        if spec['provider'] == 'authority.log@1':
            authority.update(mount='db', path='store')
        elif spec['provider'] == 'authority.objects@1':
            stored = directory / 'objects'
            stored.mkdir()
            authority.update(level=spec['floor'], objects=dict(provider='objects.dir@1', path=str(stored)))
        io = dict(stdout='stdout.bytes@1', stdin='stdin.bytes@1',
            tasks='tasks.cooperative@1', monotonic_clock='clock.monotonic.ns@1')
        if served:
            socket, serve_pid = host.enter_context(place_host(compiler, directory, db, authority))
            arguments.append('served')
            io.update(dirs=[], runners=[dict(name='db', provider='remote.tls@1',
                endpoint=dict(unix=str(socket)), server_name='localhost',
                roots=dict(pem=str(TLS / 'server.cert')),
                identity=dict(chain=str(TLS / 'client.cert'), key=str(TLS / 'client.key')),
                grants=dict(dirs=[]), definitions=None)])
        else:
            io.update(dirs=[dict(path='db', host=str(db), access='read_write')],
                authorities=dict(db=authority))
        grants.write_text(json.dumps(dict(io=io, args=list(map(str, arguments)))))
        if kind == 'interp':
            executable = compiler
            command = [compiler, 'run', '--mem-usage', HERE / 'hirsel.json', '--grants', grants,
                       '--max-steps', 'unbounded', '--cores', '2', '--', *arguments]
        elif kind == 'served':
            # Native callers do not reach remote.tls@1 places yet; the interpreted caller does.
            executable = compiler
            command = [compiler, 'run', HERE / 'hirsel.json', '--grants', grants,
                       '--max-steps', 'unbounded', '--cores', '2', '--', *arguments]
        elif kind == 'native':
            executable = out / 'native'
            command = [executable, '--hirsel-grants', grants, *arguments]
        else:
            executable = out / 'metal'
            command = [executable, db / 'append.log', *arguments]
            if kind == 'raw':
                command += ['raw']
        if profile:
            command = ['strace', '-f', '-T', '-e', 'trace=fsync,fdatasync,pwrite64,write',
                       '-o', directory / 'sync.trace', *command]
        shim = out / 'alloc.so'
        objects = [(shim, addresses(shim, dict(libc_allocations='store_bench_allocations',
            fsyncs='store_bench_fsyncs')))]
        if kind in ('native', 'served'):
            objects = []  # The shipping executable is statically linked.
        if kind == 'interp':
            objects.append((compiler, addresses(compiler, dict(allocations='allocator::ALLOCATIONS',
                reallocations='allocator::REALLOCATIONS'))))
        control_path, ack_path = directory / 'control.fifo', directory / 'ack.fifo'
        os.mkfifo(control_path)
        os.mkfifo(ack_path)
        control_write = os.open(control_path, os.O_RDWR)
        ack_read = os.open(ack_path, os.O_RDWR)
        metric_file = directory / ('perf.data' if profile else 'perf.csv')
        events = 'instructions:u,task-clock,syscalls:sys_enter_fsync,syscalls:sys_enter_fdatasync,syscalls:sys_enter_pwrite64'
        if allocation_events:
            events += ',' + ','.join(allocation_events)
        perf = ['perf', 'record', '-e', 'cpu-clock:u', '-F', '999', '-g', '--call-graph', 'dwarf',
                '-o', metric_file] if profile else ['perf', 'stat', '-x', ';', '-e', events, '-o', metric_file]
        perf += ['-D', '-1', f'--control=fifo:{control_path},{ack_path}', '--',
                 'env', f'LD_PRELOAD={shim}', *command]
        def control(message):
            os.write(control_write, (message + '\n').encode())
            answer = os.read(ack_read, 128)
            if not answer.startswith(b'ack'):
                raise RuntimeError(f'perf control failed: {answer!r}')
        with (directory / 'stderr.log').open('w') as errors:
            process = subprocess.Popen(list(map(str, [ROOT / 'tools/capped', *perf])),
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors, text=True)
            try:
                lines = []
                for line in process.stdout:
                    lines.append(line)
                    if line.strip() == 'READY':
                        pid = target_pid(process.pid, executable)
                        before = read_counters(pid, objects)
                        bytes_before = disk_bytes(stored)
                        if served:
                            # The setup's calls have started the head by now.
                            heads = list(children(serve_pid))[1:]
                            if len(heads) != 1:
                                raise RuntimeError(f'the place host runs {len(heads)} heads, not one')
                            head = heads[0]
                            # The head's counters, and the host's transport beside them.
                            probes = host.enter_context(native_allocation_probes(
                                Path(f'/proc/{head}/exe').resolve())) if head_allocations else []
                            attached = [Attached(head, ','.join([events, *probes]), directory / 'head.csv'),
                                        Attached(serve_pid, 'instructions:u,task-clock', directory / 'host.csv')]
                            for counter in attached:
                                host.callback(counter.finish)
                                counter.send('enable')
                        control('enable')
                        process.stdin.write('go\n')
                        process.stdin.flush()
                    elif line.strip() == 'DONE':
                        control('disable')
                        for counter in attached:
                            counter.send('disable')
                        after = read_counters(pid, objects)
                        bytes_after = disk_bytes(stored)
                        process.stdin.write('finish\n')
                        process.stdin.flush()
                status = process.wait()
            except BaseException:
                kill_owned(process.pid)
                process.wait()
                raise
            finally:
                os.close(control_write)
                os.close(ack_read)
                control_path.unlink()
                ack_path.unlink()
        (directory / 'stdout.log').write_text(''.join(lines))
        if status or 'verified\n' not in lines:
            raise RuntimeError(f'{suffix} failed: {directory / "stderr.log"}')
        elapsed = next(int(line.split()[1]) for line in lines if line.startswith('elapsed '))
        latencies = sorted(int(line.split()[1]) for line in lines if line.startswith('latency '))
        commits = workload['transfers'] // group
        if len(latencies) != commits:
            raise RuntimeError('missing durable completion latency bodies')
        delta = {key: after[key] - before[key] for key in before}
        metrics = {} if profile else perf_values(metric_file)
        # A served sample's commits are the head's: its counters stand where a local run's do.
        own = attached[0].finish() if served else metrics
        trace_syncs, trace_calls = sync_trace(directory / 'sync.trace') if profile else ([], None)
        if kind in ('native', 'interp', 'served'):
            # The kernel's count, whatever library or static runtime made the call.
            if profile:
                appends, datasyncs, fsyncs = (trace_calls.count(c) for c in 'wds')
            else:
                appends, datasyncs, fsyncs = (int(own[f'syscalls:sys_enter_{c}'])
                                              for c in ('pwrite64', 'fdatasync', 'fsync'))
            check_barriers(cell, commits, appends, datasyncs, fsyncs, trace_calls)
            delta.update(fsyncs=datasyncs + fsyncs, log_appends=appends)
        elif delta['fsyncs'] < commits:
            raise RuntimeError('durability counters did not cover every commit')
        if (bytes_after > bytes_before) != (spec['provider'] != 'authority.memory@1'):
            raise RuntimeError(f'{cell}: the phase grew the files by {bytes_after - bytes_before} bytes')
        if kind == 'interp':
            allocations = delta['allocations'] + delta['reallocations']
        elif kind in ('metal', 'raw'):
            allocations = next(int(line.split()[1]) for line in lines if line.startswith('allocations '))
        elif served:
            allocations = sum(own[event] for event in probes) if head_allocations else None
        else:
            allocations = sum(metrics[event] for event in allocation_events) if allocation_events else None
        row = dict(binding=binding(source_sha, workload, kind, cell, group, submitters, profile,
                                   bool(allocation_events) or head_allocations),
            engine=kind, cell=cell, survives=spec['survives'], group=group, submitters=submitters, transfers=workload['transfers'],
            commits=commits, elapsed_ns=elapsed, transfers_s=workload['transfers'] * 1e9 / elapsed,
            p50_us=latencies[math.ceil(len(latencies) * .50) - 1] / 1000,
            p99_us=latencies[math.ceil(len(latencies) * .99) - 1] / 1000,
            fsyncs_commit=delta['fsyncs'] / commits, bytes_commit=(bytes_after - bytes_before) / commits,
            log_appends_commit=delta['log_appends'] / commits if kind in ('native', 'interp', 'served') else 1,
            allocations_commit=allocations / commits if allocations is not None else None, counters=delta)
        if not profile:
            row['instructions_commit'] = own['instructions:u'] / commits
            if 'task-clock' in own:
                row['cpu_us_commit'] = own['task-clock'] * 1000 / commits
        else:
            with (directory / 'owners.txt').open('w') as owners:
                run([ROOT / 'tools/capped', 'perf', 'report', '-i', metric_file, '--stdio',
                     '--no-children', '--call-graph', 'none', '--sort', 'symbol',
                     '--percent-limit', '1', '--pid', str(pid)], stdout=owners)
            row['sync_trace_calls'] = len(trace_syncs)
            row['sync_us_commit'] = sum(trace_syncs) * 1e6 / commits
            metric_file.unlink()  # Keep readable attribution, not raw dwarf stacks.
        if served:
            # The caller and the host's transport, which the head's figures exclude.
            transport = attached[1].finish()
            row.update(caller_instructions_commit=metrics['instructions:u'] / commits,
                caller_cpu_us_commit=metrics['task-clock'] * 1000 / commits,
                host_instructions_commit=transport['instructions:u'] / commits,
                host_cpu_us_commit=transport['task-clock'] * 1000 / commits)
        if source_revision() != source_sha:
            raise RuntimeError('source revision changed during measurement; no result written')
        (directory / 'result.json').write_text(json.dumps(row, indent=2) + '\n')
        print(json.dumps(row), flush=True)
        return row


def served_ratios(rows):
    """Each served cell beside the local native run and the Rust reference of the same cell."""
    cells = {(row['binding']['engine'], row['binding']['cell'], row['binding']['group'],
              row['binding']['submitters']): row for row in rows if not row['binding']['profile']}
    ratios = []
    for (engine, cell, group, clients), served in cells.items():
        if engine != 'served':
            continue
        entry = dict(cell=cell, group=group, submitters=clients)
        for reference in ('native', 'metal'):
            other = cells.get((reference, cell, group, clients))
            if other is None:
                continue
            entry[reference] = dict(
                instructions=served['instructions_commit'] / other['instructions_commit'],
                transfers_s=served['transfers_s'] / other['transfers_s'],
                allocations=(served['allocations_commit'] / other['allocations_commit']
                             if served['allocations_commit'] and other['allocations_commit'] else None))
        ratios.append(entry)
    return ratios


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True, help='fresh evidence directory on the disk to measure')
    parser.add_argument('--compiler', type=Path, help='reuse this already built release toolchain')
    parser.add_argument('--skip-build', action='store_true', help='reuse output/native and output/metal')
    parser.add_argument('--resume', action='store_true', help='reuse completed samples in this evidence directory')
    parser.add_argument('--profile', action='store_true', help='also collect one phase-gated writer profile per engine')
    parser.add_argument('--cells', default=','.join(CELLS), help='comma-separated authority cells to measure')
    args = parser.parse_args()
    cells = args.cells.split(',')
    if not cells or any(c not in CELLS for c in cells):
        parser.error(f'cells are among {", ".join(CELLS)}')
    source_sha = source_revision()
    allowed = sorted(os.sched_getaffinity(0) - BANNED)
    if len(allowed) < 2:
        parser.error('two allowed CPUs required')
    os.sched_setaffinity(0, allowed[:2])
    os.environ.pop('HIRSEL_RT_MIGRATE', None)
    os.environ.update(HIRSEL_MEMORY_LIMIT='2G', HIRSEL_JOBS='2',
                      HIRSEL_RT_WORKERS='1', HIRSEL_DAEMON='off',
                      LD_LIBRARY_PATH=str(ROOT / 'tools/buck2/toolchains/llvm-files/lib'))
    out = args.output.resolve()
    out.mkdir(parents=True, exist_ok=True)
    compiler = args.compiler.resolve() if args.compiler else build(out)
    if (out / 'toolchain.json').exists():
        os.environ.update(json.loads((out / 'toolchain.json').read_text()))
    if not args.skip_build:
        if args.compiler:
            parser.error('--compiler requires --skip-build and an existing output/native')
        run([ROOT / 'tools/buck2/toolchains/rust-files/bin/rustc', '--edition=2024', '-O', '-g',
             HERE / 'metal.rs', '-o', out / 'metal'])
        run(['cc', '-shared', '-fPIC', '-O2', HERE / 'alloc.c', '-o', out / 'alloc.so'])
    workload = json.loads((HERE / 'workload.json').read_text())
    if workload['mix'] != 'round_robin_to_next_amount_1_2_3' or workload['durability'] != 'Durable':
        parser.error('unsupported workload mix or durability')
    with native_allocation_probes(out / 'native') as events:
        rows = []
        def measured(kind, cell, group, clients, the_workload=workload, **mode):
            """A saved cell when resuming, else a new sample."""
            name = f'{kind}-{cell}-g{group}-c{clients}' + ('-profile' if mode.get('profile') else
                '-allocations' if mode.get('allocation_events') or mode.get('head_allocations') else '')
            saved = out / name / 'result.json'
            if args.resume and saved.exists():
                return saved_sample(saved, binding(source_sha, the_workload, kind, cell, group, clients,
                    mode.get('profile', False),
                    bool(mode.get('allocation_events')) or mode.get('head_allocations', False)))
            return sample(kind, cell, group, clients, the_workload, out, compiler, source_sha, **mode)
        # The Rust reference keeps one log synchronized per group: it pairs with log-host.
        for group in workload['groups']:
            for clients in workload['submitters']:
                rows.append(measured('metal', 'log-host', group, clients))
                for cell in cells:
                    # A served transact costs the same transport at every level: log-host only.
                    for kind in ('native', 'served', 'interp') if cell == 'log-host' else ('native', 'interp'):
                        rows.append(measured(kind, cell, group, clients))
                        if kind in ('native', 'served') and cell == 'log-host' and rows[-1].get('allocations_commit') is None:
                            rows[-1]['allocations_commit'] = measured(kind, cell, group, clients,
                                **(dict(allocation_events=events) if kind == 'native'
                                   else dict(head_allocations=True)))['allocations_commit']
                            (out / f'{kind}-{cell}-g{group}-c{clients}' / 'result.json').write_text(
                                json.dumps(rows[-1], indent=2) + '\n')
        rows.append(measured('raw', 'log-host', 1, 1, dict(workload, groups=[1], submitters=[1])))
        if args.profile:
            for kind in ('native', 'interp'):
                measured(kind, 'log-host', 1, 1, profile=True)
    if source_revision() != source_sha:
        raise RuntimeError('source revision changed during measurement; no summary written')
    summary = dict(source_sha=source_sha, cells={c: CELLS[c]['survives'] for c in cells},
        workload=workload, cpus=allowed[:2], compiler=str(compiler), rows=rows, served=served_ratios(rows))
    (out / 'results.json').write_text(json.dumps(summary, indent=2) + '\n')


if __name__ == '__main__':
    main()

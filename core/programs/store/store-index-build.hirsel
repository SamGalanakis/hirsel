// The index builder (STORE-SPEC §1.2). An index record is Backfilling while
// its entries are incomplete. A chunk reads up to INDEX_CHUNK rows after the
// record's cursor at the current head, writes their entries and moves the
// cursor in the same schema plan, so the cursor never commits apart from
// its entries. The chunk that reaches the table's end publishes the index.
// Every write maintains a Backfilling index as it maintains a Public one, so
// a row written after the record exists is right on either side of the cursor.
// The rows one chunk reads: STORE-SPEC §1.2 says why 4,096.
const INDEX_CHUNK: u64 = 4096

// Up to `limit` rows of table `table_id` after `cursor`, read from resident
// roots. The flag says the table has no rows past the last one returned.
fn resident_rows_after(roots: pages.Roots, table_id: u32, cursor: Option[Bytes], limit: u64) -> Result[(List[(Bytes, Bytes)], bool), Error] {
    let start = match cursor {
        Some(final_key) => {
            let mut k = failure_result_from_rep(catalog.prefix(table_id))?
            list.append(mut k, final_key)
            Excluded(take k)
        },
        None => Included(failure_result_from_rep(catalog.prefix(table_id))?),
    }
    let mut rows = byte_cursor(roots.collections, take start, failure_result_from_rep(catalog.prefix(table_id + 1))?)?
    let mut out: List[(Bytes, Bytes)] = list.new()
    while list.len(out) < limit {
        let Some((take key, raw)) = failure_result_from_rep(catalog.next_bytes(mut rows))? else {
            return Ok((take out, true))
        }
        list.push(mut out, (take key, failure_result_from_rep(types.copied(raw))?))
    }
    let done = match failure_result_from_rep(catalog.next_bytes(mut rows))? {
        Some(_) => false,
        None => true,
    }
    Ok((take out, done))
}

fn table_is_tiered(tree: pages.PageTree, table_id: u32) -> Result[bool, Error] {
    if let None = view tree.paging {
        return Ok(false)
    }
    if let Some((_, descriptor)) = std.page.collection_slot(tree.root, failure_result_from_rep(catalog.prefix(table_id))?) {
        return Ok(pages.collection_descriptor(descriptor).residency != ResidentMemory)
    }
    Ok(false)
}

// A collection's row count from its descriptor, 0 when the map has no entry.
fn collection_rows(tree: pages.PageTree, id: u32) -> u64 {
    let Ok(key) = catalog.prefix(id) else {
        return 0
    }
    match pages.collection_by_key(tree, key) {
        Some(found) => found.rows,
        None => 0,
    }
}

// The same rows on main's head when the table is Tiered: each is read
// through the pager under a reader's pin extractor, as a snapshot scan reads.
fn tiered_rows_after(db: Db, table_id: u32, cursor: Option[Bytes], limit: u64) -> Result[(List[(Bytes, Bytes)], bool), Error] waits {
    tiered_rows_after_mode(db, table_id, cursor, limit, false)
}

fn tiered_rows_after_mode(db: Db, table_id: u32, cursor: Option[Bytes], limit: u64, direct: bool) -> Result[(List[(Bytes, Bytes)], bool), Error] waits {
    let s = snapshot(db)
    if !table_is_tiered(s.roots.collections, table_id)? {
        return resident_rows_after(s.roots, table_id, cursor, limit)
    }
    let Some(inventory) = view s.roots.collections.paging else {
        return resident_rows_after(s.roots, table_id, cursor, limit)
    }
    let low = failure_result_from_rep(catalog.prefix(table_id))?
    let high = failure_result_from_rep(catalog.prefix(table_id + 1))?
    let previous: Option[Bytes] = match cursor {
        Some(final_key) => {
            let mut k = failure_result_from_rep(catalog.prefix(table_id))?
            list.append(mut k, final_key)
            Some(take k)
        },
        None => None,
    }
    snapshot_rows_after(db, s, inventory, low, high, take previous, limit, direct)
}

// Up to `limit` rows of [`low`, `high`) after `previous` in `s`, each read
// through the pager (or directly, on a store with no pager task).
fn snapshot_rows_after(db: Db, s: Snapshot, inventory: pages.TieredReadInventory, low: Bytes, high: Bytes, take after: Option[Bytes], limit: u64, direct: bool) -> Result[(List[(Bytes, Bytes)], bool), Error] waits {
    let mut previous = take after
    let direct_dir: Option[Dir] = if direct {
        match view db.disk {
            Some(state) => disk_directory(state),
            None => None,
        }
    } else {
        None
    }
    let mut out: List[(Bytes, Bytes)] = list.new()
    if let Some(d) = direct_dir {
        while list.len(out) <= limit {
            let Some((take key, value, take resume)) = snapshot_tiered_span_step_direct(d, db.store, pager.pin_partition(db.pager), s, inventory, low, high, previous)? else {
                return Ok((take out, true))
            }
            if list.len(out) == limit {
                return Ok((take out, false))
            }
            list.push(mut out, (take key, failure_result_from_rep(types.copied(value))?))
            previous = Some(take resume)
        }
        return Ok((take out, false))
    }
    if direct {
        let has_pager_task = match view db.disk {
            Some(state) => pager.has_worker(state.tiered),
            None => false,
        }
        if !has_pager_task {
            return Error(Io(Closed))
        }
    }
    let r = reader(db, READER_PIN_MIN)?
    while list.len(out) <= limit {
        let Some((take key, value, take resume)) = snapshot_tiered_span_step(r, s, inventory, low, high, previous)? else {
            return Ok((take out, true))
        }
        if list.len(out) == limit {
            return Ok((take out, false))
        }
        list.push(mut out, (take key, failure_result_from_rep(types.copied(value))?))
        previous = Some(take resume)
    }
    Ok((take out, false))
}

// One chunk over `rows`, which follow the record's cursor in key order. It
// returns the first two primary keys found under one Unique key. Outside a
// preview that ends the chunk with `plan` untouched; a preview skips the
// later row and keeps building, as the scratch index keeps one row per key.
fn index_chunk(mut plan: SchemaPlan, key: Bytes, take chunk_record: indexes.Catalog, extractor: indexes.RegisteredIndex, rows: List[(Bytes, Bytes)], done: bool, preview: bool, record_steps: bool) -> Result[Option[(Bytes, Bytes)], Error] {
    let mut record = take chunk_record
    let mut roots = pages.share_roots(plan.schema.roots)
    let mut live_bytes = plan.schema.live
    let first = failure_result_from_rep(catalog.stamp_after(plan.schema.next_node))?
    let mut next_stamp = first
    let mut duplicate: Option[(Bytes, Bytes)] = None
    let mut cursor: Option[Bytes] = None
    let mut chunk_steps: Option[List[StepOp]] = if record_steps {
        Some(list.new())
    } else {
        None
    }
    if let Sums = catalog_index(record)?.shape {
        add_chunk_totals(mut roots.collections, mut live_bytes, plan.schema.retained, plan.schema.ceiling, first, mut next_stamp, extractor, rows, mut chunk_steps)?
        if let Some((logical, _)) = list.last(rows) {
            cursor = Some(failure_result_from_rep(types.copied(list.slice(logical, 4, list.len(logical))))?)
        }
    } else {
        for (logical, raw) in rows {
            let primary = list.slice(logical, 4, list.len(logical))
            let values = extract_index(extractor, raw, primary)?
            for row in values.keys {
                if list.len(row) > 4096 {
                    return Error(Limit(Key))
                }
                let prior_width = format.stored_prior(pages.get_page_row(roots.collections, row))
                if let Some(prior) = pages.get_page_row(roots.collections, row) {
                    if let Entries(UniqueEntry) = catalog_index(record)?.shape {
                        let owner = list.slice(prior, 4, failure_result_from_rep(indexes.unique_owner_end(prior))?)
                        if owner != primary {
                            if let None = duplicate {
                                duplicate = Some((failure_result_from_rep(types.copied(owner))?, failure_result_from_rep(types.copied(primary))?))
                            }
                            if !preview {
                                return Ok(take duplicate)
                            }
                            continue
                        }
                    }
                    if !plan.schema.retained {
                        live_bytes = int.saturating_sub(live_bytes, txn.entry(row, prior))
                    }
                }
                live_bytes = int.saturating_add(live_bytes, txn.entry(row, values.payload))
                failure_result_from_rep(catalog.over_ceiling(live_bytes, plan.schema.ceiling))?
                failure_result_from_rep(pages.put_page_row(mut roots.collections, row, values.payload, first, mut next_stamp))?
                if let Some(mut step_rows) = chunk_steps {
                    failure_result_from_rep(types.capacity(list.try_reserve(mut step_rows, 1)))?
                    list.push(mut step_rows, StepOp(key: failure_result_from_rep(types.copied(row))?, value: Some(failure_result_from_rep(types.copied(values.payload))?), prior: prior_width))
                }
            }
            cursor = Some(failure_result_from_rep(types.copied(primary))?)
        }
    }
    failure_result_from_rep(pages.canonical_tree(mut roots.collections))?
    plan.schema.next_node = next_stamp - 1
    if done {
        failure_result_from_rep(indexes.set_index_state(mut record, Public))?
    } else if let Some(take final_key) = take cursor {
        failure_result_from_rep(indexes.set_index_state(mut record, Backfilling(Some(take final_key))))?
    }
    let raw = encode_catalog(record)?
    live_bytes = txn.catalog_recharge(live_bytes, roots, key, raw, plan.schema.retained)
    roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, roots, key, raw))?
    let next_table = plan.schema.next_table
    keep_schema(mut plan, take roots, live_bytes, next_table)?
    if let Some(take ops) = take chunk_steps {
        for take op in take ops {
            failure_result_from_rep(types.capacity(list.try_reserve(mut plan.step_rows, 1)))?
            list.push(mut plan.step_rows, take op)
        }
    }
    Ok(take duplicate)
}

// A declaration's build runs inside the declaration's plan, so the index
// publishes with the schema commit that declares it. A preview reports the
// rows it read and wrote. An entry index is built bottom up (AP13): one pass
// extracts every row's entries, charging each to the workspace as it is
// kept, a sort orders them, and the collection built from them replaces the
// one the record had. A Backfilling record is rebuilt whole the same way: a
// write keeps its entries ahead of the cursor, so the result is the same.
// Inserting chunk by chunk copied every page a chunk touched once per chunk,
// and grew faster than the rows (store-child-build-2660). An aggregate keeps
// the chunked builder: its group rows add up parts, which a sort does not.
fn build_declared_index(mut plan: SchemaPlan, key: Bytes, record: indexes.Catalog, extractor: indexes.RegisteredIndex, preview: bool) -> Result[(Option[(Bytes, Bytes)], u64, u64), Error] {
    if let Sums = catalog_index(record)?.shape {
        return chunked_declared_index(mut plan, key, record, extractor, preview)
    }
    let unique = if let Entries(UniqueEntry) = catalog_index(record)?.shape {
        true
    } else {
        false
    }
    let mut extracted: List[std.page.Row] = list.new()
    let mut read = 0u64
    let mut workspace = plan.schema.live
    {
        let mut rows = byte_cursor(plan.schema.roots.collections, Included(failure_result_from_rep(catalog.prefix(record.owner))?), failure_result_from_rep(catalog.prefix(record.owner + 1))?)?
        while let Some((take logical, raw)) = failure_result_from_rep(catalog.next_bytes(mut rows))? {
            read += 1
            extract_entries(mut extracted, mut workspace, plan.schema.ceiling, extractor, logical, raw)?
        }
    }
    bulk_declared_index(mut plan, key, record, unique, take extracted, read, preview)
}

// One row's entries for a bottom-up build, each charged to `workspace` as it
// is kept.
fn extract_entries(mut extracted: List[std.page.Row], mut workspace: u64, ceiling: u64, extractor: indexes.RegisteredIndex, logical: Bytes, raw: Bytes) -> Result[(), Error] {
    let primary = list.slice(logical, 4, list.len(logical))
    let values = extract_index(extractor, raw, primary)?
    for row in values.keys {
        if list.len(row) > 4096 {
            return Error(Limit(Key))
        }
        let charge = txn.entry(row, values.payload)
        workspace = int.saturating_add(workspace, charge + 8)
        failure_result_from_rep(catalog.over_ceiling(workspace, ceiling))?
        failure_result_from_rep(types.capacity(list.try_reserve(mut extracted, 1)))?
        list.push(mut extracted, std.page.Row(key: failure_result_from_rep(types.copied(list.slice(row, 4, list.len(row))))?, value: failure_result_from_rep(types.copied(values.payload))?, charge: charge))
    }
    Ok(())
}

// Sorts the extracted entries and builds the collection from them, which
// replaces the one the record had (AP13).
fn bulk_declared_index(mut plan: SchemaPlan, key: Bytes, record: indexes.Catalog, unique: bool, take found: List[std.page.Row], read: u64, preview: bool) -> Result[(Option[(Bytes, Bytes)], u64, u64), Error] {
    let mut extracted = take found
    // The sort keeps rows of one key in primary order, so the first is the
    // owner the chunked builder kept. The pair reported is the one a scan in
    // primary order meets first: the least repeating primary key.
    sort_bulk_rows(mut extracted)?
    let mut duplicate: Option[(Bytes, Bytes)] = None
    let mut kept: List[std.page.Row] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut kept, list.len(extracted))))?
    for take row in take extracted {
        if let Some(previous) = list.last(kept) {
            if previous.key == row.key {
                if unique {
                    let owner = list.slice(previous.value, 4, failure_result_from_rep(indexes.unique_owner_end(previous.value))?)
                    let second = list.slice(row.value, 4, failure_result_from_rep(indexes.unique_owner_end(row.value))?)
                    let earlier = match view duplicate {
                        Some((_, met)) => second < met,
                        None => true,
                    }
                    if owner != second && earlier {
                        duplicate = Some((failure_result_from_rep(types.copied(owner))?, failure_result_from_rep(types.copied(second))?))
                    }
                }
                continue
            }
        }
        list.push(mut kept, take row)
    }
    if !preview {
        if let Some(_) = duplicate {
            return Ok((take duplicate, read, 0))
        }
    }
    let mut current = copied_record(record)?
    let mut roots = pages.share_roots(plan.schema.roots)
    let mut live_bytes = plan.schema.live
    let former = failure_result_from_rep(catalog.remove_store_collection(mut roots.collections, current.id, mut plan.schema.next_node))?
    if !plan.schema.retained {
        live_bytes = int.saturating_sub(live_bytes, former)
    }
    live_bytes = int.saturating_add(live_bytes, 126)
    for row in kept {
        live_bytes = int.saturating_add(live_bytes, row.charge)
    }
    failure_result_from_rep(catalog.over_ceiling(live_bytes, plan.schema.ceiling))?
    let written = list.len(kept)
    failure_result_from_rep(catalog.bulk_store_collection(mut roots.collections, current.id, 2, take kept, mut plan.schema.next_node))?
    // F4: mark the replaced collection id superseded so a non-empty bulk
    // redefinition under an export lease is caught as Drift at the cut.
    failure_result_from_rep(types.capacity(list.try_reserve(mut plan.schema.superseded, 1)))?
    list.push(mut plan.schema.superseded, current.id)
    failure_result_from_rep(indexes.set_index_state(mut current, Public))?
    let raw = encode_catalog(current)?
    live_bytes = txn.catalog_recharge(live_bytes, roots, key, raw, plan.schema.retained)
    roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, roots, key, raw))?
    let next_table = plan.schema.next_table
    keep_schema(mut plan, take roots, live_bytes, next_table)?
    Ok((take duplicate, read, written))
}

// An aggregate's declared build: every chunk runs in the declaration's plan.
fn chunked_declared_index(mut plan: SchemaPlan, key: Bytes, record: indexes.Catalog, extractor: indexes.RegisteredIndex, preview: bool) -> Result[(Option[(Bytes, Bytes)], u64, u64), Error] {
    let mut current = copied_record(record)?
    let mut read = 0u64
    let mut duplicate: Option[(Bytes, Bytes)] = None
    loop {
        let cursor = match catalog_index(current)?.state {
            Backfilling(Some(final_key)) => Some(failure_result_from_rep(types.copied(final_key))?),
            _ => None,
        }
        let (take rows, done) = resident_rows_after(plan.schema.roots, current.owner, cursor, INDEX_CHUNK)?
        read += list.len(rows)
        let found = index_chunk(mut plan, key, copied_record(current)?, extractor, rows, done, preview, false)?
        if let Some(take pair) = take found {
            if !preview {
                return Ok((Some(take pair), read, 0))
            }
            if let None = duplicate {
                duplicate = Some(take pair)
            }
        }
        current = catalog_entry_in(plan.schema.roots.catalog, key)?
        if let Public = catalog_index(current)?.state {
            break
        }
    }
    let written = match std.page.collection_child(plan.schema.roots.collections.root, failure_result_from_rep(catalog.prefix(record.id))?) {
        Some(root) => {
            let (rows, _) = std.page.totals(root)
            rows
        },
        None => 0u64,
    }
    Ok((take duplicate, read, written))
}

fn copied_record(record: indexes.Catalog) -> Result[indexes.Catalog, Error] {
    decode_catalog(encode_catalog(record)?)
}

// The first index on main's head whose record is Backfilling and whose
// extractor this release binds, with its catalog key and record. An index
// this release does not bind waits for the release that declares it.
fn building_index(db: Db) -> Result[Option[(Bytes, indexes.Catalog)], Error] {
    let mut first_key: Bytes = list.new()
    list.push(mut first_key, 2u8)
    let mut end_key: Bytes = list.new()
    list.push(mut end_key, 3u8)
    let mut records = byte_cursor(pages.holder_heads(db.holders)[0].roots.catalog, Included(take first_key), end_key)?
    while let Some((take key, raw)) = failure_result_from_rep(catalog.next_bytes(mut records))? {
        if catalog.record_public(raw) {
            continue
        }
        let record = decode_catalog(raw)?
        let building = if let Backfilling(_) = catalog_index(record)?.state {
            true
        } else {
            false
        }
        if building {
            if let Some(_) = bound_extractor(db.indexes, record) {
                return Ok(Some((take key, take record)))
            }
        }
    }
    Ok(None)
}

// The name of the first index in `catalog` whose record is not Public.
fn unready_index(catalog_tree: pages.PageTree) -> Result[Option[String], Error] {
    let mut first_key: Bytes = list.new()
    list.push(mut first_key, 2u8)
    let mut end_key: Bytes = list.new()
    list.push(mut end_key, 3u8)
    let mut records = byte_cursor(catalog_tree, Included(take first_key), end_key)?
    while let Some((key, raw)) = failure_result_from_rep(catalog.next_bytes(mut records))? {
        if !catalog.record_public(raw) {
            return Ok(Some(failure_result_from_rep(catalog.declaration_index_name(key))?))
        }
    }
    Ok(None)
}

fn bound_extractor(owner: indexes.IndexOwner, record: indexes.Catalog) -> Option[View[indexes.RegisteredIndex]] in owner {
    indexes.bound_extractor(owner, record)
}

// One chunk of the first Backfilling index on main, in one schema commit
// read from and published at main's current head. Returns the index's name,
// or None when no index is building. A Unique key found under two primary
// keys moves the index to Failed instead, and no entry of that chunk commits.
// The chunk reads a Tiered table through the pager, so in-place repair needs
// no Migrate on a Tiered store (STORE-SPEC §13.10).
pub fn index_build_step(mut db: Db, limit: u64) -> Result[Option[String], Error] waits {
    healthy(db)?
    if limit == 0 {
        return Error(Limit(Transaction))
    }
    let Some((take key, take record)) = building_index(db)? else {
        return Ok(None)
    }
    let name = failure_result_from_rep(catalog.declaration_index_name(key))?
    let tiered = table_is_tiered(pages.holder_heads(db.holders)[0].roots.collections, record.id)?
    if tiered && index_build_has_overlay(pages.holder_heads(db.holders)[0].roots.collections, record.id) {
        let _ = cut_install(mut db, NoHolderChange)?
    }
    let cursor = match catalog_index(record)?.state {
        Backfilling(Some(final_key)) => Some(failure_result_from_rep(types.copied(final_key))?),
        _ => None,
    }
    let (take rows, done) = tiered_rows_after(db, record.owner, cursor, limit)?
    let mut plan = schema_plan(db)
    let found = if tiered {
        let chunk = prepare_tiered_index_chunk(mut db, record, rows)?
        match take chunk {
            ChunkDuplicate(take previous, take next_key) => Some((take previous, take next_key)),
            ChunkReady(pager.TieredWritePlan(tree: take tree, next_stamp: following, freed: take freed, ..), take step_ops) => {
                plan.schema.roots.collections = take tree
                plan.schema.next_node = following - 1
                plan.chunk_freed = Some(take freed)
                plan.step_rows = take step_ops
                let mut published = copied_record(record)?
                if done {
                    failure_result_from_rep(indexes.set_index_state(mut published, Public))?
                } else if let Some((logical, _)) = list.last(rows) {
                    let after = failure_result_from_rep(types.copied(list.slice(logical, 4, list.len(logical))))?
                    failure_result_from_rep(indexes.set_index_state(mut published, Backfilling(Some(take after))))?
                }
                put_index_record(mut plan, key, published)?
                None
            },
        }
    } else {
        let Some(extractor) = bound_extractor(db.indexes, record) else {
            return Error(Stale(record.id))
        }
        index_chunk(mut plan, key, copied_record(record)?, extractor, rows, done, false, true)?
    }
    if let Some((take first, take second)) = take found {
        let mut failed = copied_record(record)?
        failure_result_from_rep(indexes.set_index_state(mut failed, Failed(take first, take second)))?
        put_index_record(mut plan, key, failed)?
    }
    let _ = publish_schema_plan(mut db, take plan)?
    Ok(Some(take name))
}

fn put_index_record(mut plan: SchemaPlan, key: Bytes, record: indexes.Catalog) -> Result[(), Error] {
    let raw = encode_catalog(record)?
    let live_bytes = txn.catalog_recharge(plan.schema.live, plan.schema.roots, key, raw, plan.schema.retained)
    let roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, plan.schema.roots, key, raw))?
    let next_table = plan.schema.next_table
    keep_schema(mut plan, take roots, live_bytes, next_table)
}

// Demotes an index to Backfilling(None) over an empty collection (§I.3), so
// reads refuse it and the builder rebuilds it from the table's first row.
// An index already Backfilling(None) is left as it is.
// Answers whether the record changed.
fn demote_index(mut plan: SchemaPlan, key: Bytes) -> Result[bool, Error] {
    let mut record = catalog_entry_in(plan.schema.roots.catalog, key)?
    if let Backfilling(None) = catalog_index(record)?.state {
        return Ok(false)
    }
    let mut roots = pages.share_roots(plan.schema.roots)
    let id = record.id
    let tiered = table_is_tiered(roots.collections, id)?
    let charge = failure_result_from_rep(catalog.remove_store_collection(mut roots.collections, id, mut plan.schema.next_node))?
    if tiered {
        discard_replayed_collection(mut roots.collections, id)?
        define_empty_tiered_index(mut roots.collections, id, mut plan.schema.next_node)?
    } else {
        failure_result_from_rep(catalog.define_store_collection(mut roots.collections, id, 2, mut plan.schema.next_node))?
    }
    // D-CU-1: demotion supersedes the collection id for Memory and Tiered alike.
    failure_result_from_rep(types.capacity(list.try_reserve(mut plan.schema.superseded, 1)))?
    list.push(mut plan.schema.superseded, id)
    let mut live_bytes = plan.schema.live
    if !plan.schema.retained {
        live_bytes = int.saturating_sub(live_bytes, charge)
    }
    live_bytes = int.saturating_add(live_bytes, 126)
    let next_table = plan.schema.next_table
    keep_schema(mut plan, take roots, live_bytes, next_table)?
    failure_result_from_rep(indexes.set_index_state(mut record, Backfilling(None)))?
    put_index_record(mut plan, key, record)?
    Ok(true)
}

// Demotes each index a failed transaction proved wrong, in one schema
// commit on main. A crash before it commits loses nothing: the next write
// to the row fails the same way.
// Each index whose record this commit changes counts one demotion
// (`attention`); one already Backfilling(None) counts none.
fn demote_drifted(mut db: Db, seen: List[(u32, u32)]) -> Result[(), Error] waits {
    let mut plan = schema_plan(db)
    let mut demoted: List[(u32, u32)] = list.new()
    for (owner, id) in seen {
        let name = find_index_name(plan.schema.roots.catalog, owner, id)?
        if demote_index(mut plan, failure_result_from_rep(catalog.catalog_index_key(owner, name))?)? {
            failure_result_from_rep(types.capacity(list.try_reserve(mut demoted, 1)))?
            list.push(mut demoted, (owner, id))
        }
    }
    if plan.schema.changed {
        let _ = publish_schema_plan(mut db, take plan)?
    }
    count_demotions(mut db, demoted)
}

// Starts an in-place rebuild of a declared index: demotes it, and
// `index_build_step` then rebuilds it while every other index serves.
pub fn rebuild_index[J, K, V, P](mut db: Db, ix: Index[J, K, V, P]) -> Result[(), Error] waits {
    healthy(db)?
    if !types.same(db.store.hi, db.store.lo, ix.store.hi, ix.store.lo) {
        return Error(Foreign)
    }
    let mut plan = schema_plan(db)
    let record = catalog_entry_in(plan.schema.roots.catalog, ix.catalog_key)?
    if record.id != ix.id {
        return Error(Stale(ix.id))
    }
    let _ = demote_index(mut plan, ix.catalog_key)?
    if plan.schema.changed {
        let _ = publish_schema_plan(mut db, take plan)?
    }
    Ok(())
}

// A declaration's index build in its plan. A new index (`new_index`) gets its
// record as Backfilling(None) over an empty collection; an existing entry
// index is rebuilt whole, an aggregate resumes from its cursor, and a Failed
// one restarts from an empty index.
fn stage_index_build[K, V](mut plan: SchemaPlan, t: Table[K, V], key: Bytes, name: String, take record: indexes.Catalog, extractor: indexes.RegisteredIndex, new_index: bool, take cause: String) -> Result[(), Error] {
    if !types.same(plan.store.hi, plan.store.lo, t.store.hi, t.store.lo) {
        return Error(Foreign)
    }
    let mut proposed = take record
    let owner_tiered = table_is_tiered(plan.schema.roots.collections, t.id)?
    // A hot build draws a Tiered target's two scratch ids with it (§13.10a).
    let hot = !plan.schema.defer_tiered
    let mut scratch = 0u32
    if new_index {
        let mut meta = catalog_entry_in(plan.schema.roots.catalog, t.catalog_key)?
        if meta.id != t.id {
            return Error(Stale(t.id))
        }
        let drawn = if owner_tiered && hot {
            3u32
        } else {
            1u32
        }
        let Some(next_table) = int.checked_add(proposed.id, drawn) else {
            return Error(Limit(Ids))
        }
        scratch = proposed.id + 1u32
        failure_result_from_rep(indexes.set_index_state(mut proposed, Backfilling(None)))?
        let raw = encode_catalog(proposed)?
        let mut live_bytes = int.saturating_add(126, txn.catalog_recharge(plan.schema.live, plan.schema.roots, key, raw, plan.schema.retained))
        meta.epoch += 1
        let changed = encode_catalog(meta)?
        live_bytes = txn.catalog_recharge(live_bytes, plan.schema.roots, t.catalog_key, changed, plan.schema.retained)
        failure_result_from_rep(catalog.over_ceiling(live_bytes, plan.schema.ceiling))?
        let mut roots = pages.share_roots(plan.schema.roots)
        if owner_tiered {
            define_empty_tiered_index(mut roots.collections, proposed.id, mut plan.schema.next_node)?
        } else {
            failure_result_from_rep(catalog.define_store_collection(mut roots.collections, proposed.id, 2, mut plan.schema.next_node))?
        }
        roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, roots, key, raw))?
        roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, roots, t.catalog_key, changed))?
        keep_schema(mut plan, take roots, live_bytes, next_table)?
    } else if let Failed(_, _) = catalog_index(proposed)?.state {
        let _ = demote_index(mut plan, key)?
    }
    let current = catalog_entry_in(plan.schema.roots.catalog, key)?
    let target_tiered = table_is_tiered(plan.schema.roots.collections, current.id)?
    if target_tiered && hot && !new_index {
        scratch = plan.schema.next_table
        let Some(next_table) = int.checked_add(scratch, 2u32) else {
            return Error(Limit(Ids))
        }
        plan.schema.next_table = next_table
    }
    if owner_tiered || target_tiered {
        let preview_slot: Option[u64] = if let Some(mut backfills) = plan.preview {
            let slot = list.len(backfills)
            let table_name = failure_result_from_rep(catalog.catalog_collection_name(t.catalog_key, 1u8))?
            list.push(mut backfills, MigrationBackfill(table: take table_name, index: Some(clone(name)), cause: Some(take cause), read: 0, written: 0, outcome: Deferred(collection_rows(plan.schema.roots.collections, t.id))))
            Some(slot)
        } else {
            None
        }
        failure_result_from_rep(types.capacity(list.try_reserve(mut plan.pending_indexes, 1)))?
        list.push(mut plan.pending_indexes, DeferredIndexBuild(catalog_key: failure_result_from_rep(types.copied(key))?, name: failure_result_from_rep(catalog.named(name))?, record_raw: encode_catalog(current)?, scratch: scratch, preview_slot: preview_slot))
        plan.step_drift = true
        // A queued build publishes even when it resumes an unchanged record.
        plan.schema.changed = true
        return Ok(())
    }
    let preview = if let Some(_) = plan.preview {
        true
    } else {
        false
    }
    let (take duplicate, read, written) = build_declared_index(mut plan, key, current, extractor, preview)?
    let outcome: BackfillOutcome = match take duplicate {
        Some((take first, take second)) => {
            if !preview {
                return Error(Conflict(failure_result_from_rep(catalog.named(name))?))
            }
            Conflict(ConflictKeys(first: take first, second: take second))
        },
        None => Filled,
    }
    if let Some(mut backfills) = plan.preview {
        let table_name = failure_result_from_rep(catalog.catalog_collection_name(t.catalog_key, 1u8))?
        list.push(mut backfills, MigrationBackfill(table: take table_name, index: Some(clone(name)), cause: Some(take cause), read: read, written: written, outcome: take outcome))
    }
    Ok(())
}

// A Unique key two rows claim, or an index a remove proved wrong (§I.3).
type IndexStop: send = Duplicate(String) | Drifted(String)

fn index_stop_error(stop: IndexStop) -> Result[Error, Error] {
    match stop {
        Duplicate(name) => Ok(Conflict(failure_result_from_rep(catalog.named(name))?)),
        Drifted(name) => Ok(Drift(failure_result_from_rep(catalog.named(name))?)),
    }
}

// The drift that fails a transaction, with the (table, index) pairs its
// removes proved wrong, or None when no remove did. A Duplicate stays.
fn take_drift(mut tx: Tx) -> Option[(String, List[(u32, u32)])] {
    let drifted = match tx.index_conflict {
        Some(Drifted(_)) => true,
        _ => false,
    }
    if !drifted {
        return None
    }
    let Some(Drifted(take name)) = replace(mut tx.index_conflict, None) else {
        return None
    }
    let evidence = match replace(mut tx.drift, None) {
        Some(take seen) => take seen,
        None => list.new(),
    }
    Some((take name, take evidence))
}

// Bytes [at, at + 8) of `key` as a big-endian word, zero past its end: two
// keys equal before `at` whose words differ order as their words do.
fn key_word_at(key: Bytes, at: u64) -> u64 {
    if list.len(key) >= at + 8 {
        let word: u64 = list.word_be(key, at)
        return word
    }
    let mut word = 0u64
    for i in at .. at + 8 {
        word = word << 8
        if i < list.len(key) {
            word = word | int.widen(key[i])
        }
    }
    word
}

// Orders rows by key, rows of one key in their present order. The sort runs
// over (first word, second word, position) triples held in one list, and
// reads two rows' keys only where both words tie: comparing through each
// row's own key buffer missed the cache on every step, and that grew with
// the rows (store 2660).
fn sort_bulk_rows(mut rows: List[std.page.Row]) -> Result[(), Error] {
    let mut order_keys: List[(u64, u64, u64)] = list.new()
    let n = list.len(rows)
    failure_result_from_rep(types.capacity(list.try_reserve(mut order_keys, n)))?
    for slot in 0u64 .. n {
        let key = view rows[slot].key
        list.push(mut order_keys, (key_word_at(key, 0), key_word_at(key, 8), slot))
    }
    list.sort(mut order_keys, scoped fn(a: (u64, u64, u64), b: (u64, u64, u64)) -> Order {
        if a.0 != b.0 {
            return order.compare(a.0, b.0)
        }
        if a.1 != b.1 {
            return order.compare(a.1, b.1)
        }
        match list.compare_bytes(rows[a.2].key, rows[b.2].key) {
            Equal => order.compare(a.2, b.2),
            different => different,
        }
    })
    let mut positions: List[u64] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut positions, n)))?
    for (_, _, slot) in order_keys {
        list.push(mut positions, slot)
    }
    order_keys = list.new()
    for first in 0u64 .. n {
        let mut at = first
        let mut source = positions[at]
        while source != first {
            list.swap(mut rows, at, source)
            positions[at] = at
            at = source
            source = positions[at]
        }
        positions[at] = at
    }
    Ok(())
}

fn stage_migrate[K, V, K2, V2](mut plan: SchemaPlan, take from: Table[K, V], to_name: String, to_key: std.codec.Key[K2], to_value: std.codec.Codec[V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity]) -> Result[(), Error] {
    if !types.same(plan.store.hi, plan.store.lo, from.store.hi, from.store.lo) {
        return Error(Foreign)
    }
    let meta = catalog_entry_in(plan.schema.roots.catalog, from.catalog_key)?
    if meta.id != from.id {
        return Error(Stale(from.id))
    }
    let target = failure_result_from_rep(catalog.table_key(to_name))?
    if !catalog.same_bytes(target, from.catalog_key) {
        if let Some(_) = pages.get_page_row(plan.schema.roots.catalog, target) {
            return Error(Exists(failure_result_from_rep(catalog.named(to_name))?))
        }
    }
    if meta.next == 65535 {
        return Error(Limit(Value))
    }
    let tiered = table_is_tiered(plan.schema.roots.collections, from.id)?
    let source_rows = collection_rows(plan.schema.roots.collections, from.id)
    let olds = index_catalog_in(plan.schema.roots.catalog, from.id)?
    let id = plan.schema.next_table
    plan.step_drift = true
    // 3150 F2: the source and its retired indexes supersede their ids. A
    // Tiered source's overlay is discarded once its rows are read.
    failure_result_from_rep(types.capacity(list.try_reserve(mut plan.schema.superseded, 1 + list.len(olds))))?
    list.push(mut plan.schema.superseded, from.id)
    for old in olds {
        list.push(mut plan.schema.superseded, old.id)
    }
    if tiered {
        let mut roots = pages.share_roots(plan.schema.roots)
        let mut ids = plan.schema.next_node
        let schema = std.codec.schema(to_value) ?=> |_| Schema(0)
        let fp = std.codec.fingerprint_of(schema)
        let mut schemas: List[catalog.ValueSchema] = list.new()
        list.push(mut schemas, catalog.ValueSchema(number: meta.next, fingerprint: fp, schema: take schema))
        let table_raw = encode_catalog(indexes.Catalog(record: CatalogTable, id: id, owner: 0, epoch: 1, key: (std.codec.key_schema(to_key) ?=> |_| Schema(0)), schemas: take schemas, next: meta.next + 1, by: list.new(), revision: list.new()))?
        let mut live_bytes = int.saturating_add(plan.schema.live, 126 + txn.entry(target, table_raw))
        define_empty_tiered_collection(mut roots.collections, id, 1, mut ids)?
        let mut old_ids: List[u32] = list.with_capacity(list.len(olds))
        for old in olds {
            list.push(mut old_ids, old.id)
        }
        let low = failure_result_from_rep(catalog.index_prefix(from.id))?
        let high = failure_result_from_rep(catalog.index_prefix(from.id + 1))?
        let mut catalog_rows = byte_cursor(roots.catalog, Included(take low), high)?
        while let Some((k, v)) = failure_result_from_rep(catalog.next_bytes(mut catalog_rows))? {
            if !plan.schema.retained {
                live_bytes = int.saturating_sub(live_bytes, txn.entry(k, v))
            }
            failure_result_from_rep(catalog.remove_store_row(mut roots.catalog, k, mut ids))?
        }
        if let Some(raw) = pages.get_page_row(roots.catalog, from.catalog_key) {
            if !plan.schema.retained {
                live_bytes = int.saturating_sub(live_bytes, txn.entry(from.catalog_key, raw))
            }
        }
        failure_result_from_rep(catalog.remove_store_row(mut roots.catalog, from.catalog_key, mut ids))?
        roots = failure_result_from_rep(catalog.catalog_insert(mut ids, roots, target, table_raw))?
        plan.schema.next_node = ids
        // A hot build draws the target's two scratch ids with it (§13.10a).
        let drawn = if plan.schema.defer_tiered {
            1u32
        } else {
            3u32
        }
        let Some(next_table) = int.checked_add(id, drawn) else {
            return Error(Limit(Ids))
        }
        keep_schema(mut plan, take roots, live_bytes, next_table)?
        record_migrate_source(mut plan, from.id, id)?
        let preview_slot: Option[u64] = if let Some(mut backfills) = plan.preview {
            let slot = list.len(backfills)
            list.push(mut backfills, MigrationBackfill(table: failure_result_from_rep(catalog.named(to_name))?, index: None, cause: None, read: 0, written: 0, outcome: Deferred(source_rows)))
            Some(slot)
        } else {
            None
        }
        let from_id = from.id
        let number = meta.next
        let value_limit = plan.schema.value_limit
        let convert_row: own[send] fn(Bytes, Bytes) -> Result[Option[(Bytes, Bytes)], Error] = fn(key_bytes: Bytes, raw_val: Bytes) -> Result[Option[(Bytes, Bytes)], Error] {
            let decoded_key = failure_result_from_rep(catalog.decoded(std.codec.decode_key(from.key, key_bytes)))?
            let decoded_val = row_value(from.readers, from_id, raw_val)?
            match failure_result_from_rep(types.capacity(f(decoded_key, decoded_val)))? {
                Some((k2, v2)) => {
                    let encoded = failure_result_from_rep(catalog.encode_key(to_key, k2))?
                    if list.len(encoded) > 4092 {
                        return Error(Limit(Key))
                    }
                    let mut out_val: Bytes = list.new()
                    failure_result_from_rep(types.capacity(format.le(mut out_val, int.widen(number), 2)))?
                    std.codec.encode(to_value, v2, mut out_val) ?=> |_| Limit(Value)
                    if list.len(out_val) > value_limit {
                        return Error(Limit(Value))
                    }
                    Ok(Some((take encoded, take out_val)))
                },
                None => Ok(None),
            }
        }
        failure_result_from_rep(types.capacity(list.try_reserve(mut plan.pending_migrates, 1)))?
        list.push(mut plan.pending_migrates, DeferredMigrate(from_id: from_id, to_id: id, to_name: failure_result_from_rep(catalog.named(to_name))?, olds: take old_ids, convert: take convert_row, preview_slot: preview_slot))
        return Ok(())
    }
    let base = pages.share_roots(plan.schema.roots)
    let mut ids = plan.schema.next_node
    let built = migrate_build(plan.schema.roots.collections, take base, mut ids, plan.schema.live, plan.schema.ceiling, plan.schema.retained, from, olds, to_name, to_key, to_value, f, id, meta.next, target, plan.schema.value_limit)
    plan.schema.next_node = ids
    let catalog.Built(roots: take roots, live: live_bytes, read, written) = built?
    keep_schema(mut plan, take roots, live_bytes, id + 1)?
    record_migrate_source(mut plan, from.id, id)?
    if let Some(mut backfills) = plan.preview {
        list.push(mut backfills, MigrationBackfill(table: failure_result_from_rep(catalog.named(to_name))?, index: None, cause: None, read: read, written: written, outcome: Filled))
    }
    Ok(())
}

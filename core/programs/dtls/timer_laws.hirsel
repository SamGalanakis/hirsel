fn next_wake(mut e: dtls.Endpoint, r: Random, now: u64) -> u64 {
    let mut out: Bytes = list.with_capacity(1200)
    match dtls.poll(mut e, now, r, mut out) {
        Ok(WakeAt(at)) => at,
        _ => fail("expected WakeAt"),
    }
}

/// A client whose every datagram is lost: sent at 0, resent at each second listed in
/// `resends` (one byte each), closed as Timeout at `closes`.
fn lost_client(seed: u64, c: dtls.Config, resends: Bytes, closes: u64) {
    let p = party(seed)
    let Party(id: take cid, ..) = take p
    let r = provide.random(seed + 1)
    let mut client = result.unwrap(dtls.client(take cid, c, address(1)))
    if list.len(drain(mut client, r, 0)) != 1 {
        fail("ClientHello at 0")
    }
    let mut now = 0u64
    for i in 0u64 .. list.len(resends) {
        let at: u64 = int.widen(resends[i])
        if next_wake(mut client, r, now) != at * SECOND {
            fail("resend time")
        }
        now = at * SECOND
        if list.len(drain(mut client, r, now)) != 1 {
            fail("ClientHello resent")
        }
    }
    if next_wake(mut client, r, now) != closes * SECOND {
        fail("close time")
    }
    let mut out: Bytes = list.with_capacity(1200)
    if let Error(Closed(Timeout)) = dtls.poll(mut client, closes * SECOND, r, mut out) {} else {
        fail("Timeout")
    }
}

/// bug: a timer that does not double, is not capped, outlives the deadline or the retry
/// budget, or resets after a lossy flight.
/// oracle: RFC 6347 section 4.2.4.1 by hand.
@test
fn flight_timer_schedule() -> Result[(), ()] {
    // 1, 3, 7, 15 and 31 s.
    lost_client(101, dtls.defaults(), unhex("0103070f1f"), 60)
    let mut long = dtls.defaults()
    long.handshake_ns = 300 * SECOND
    // 1, 3, 7, 15, 31, 63 and 123 s.
    lost_client(103, long, unhex("0103070f1f3f7b"), 183)
    let mut few = dtls.defaults()
    few.retries = 2
    lost_client(105, few, unhex("0103"), 7)
    flight_four_resends_bounded()
    let a = party(107)
    let b = party(108)
    let rc = provide.random(109)
    let rs = provide.random(110)
    let Party(id: take client_id, ..) = take a
    let Party(id: take server_id, ..) = take b
    let half = SECOND / 2
    let mut client = result.unwrap(dtls.client(take client_id, dtls.defaults(), address(1)))
    let first = drain(mut client, rc, 0)
    let mut reply: Bytes = list.with_capacity(100)
    if let Reply(_) = dtls.admit(cookie_key(), address(1), first[0], mut reply) {} else {
        fail("flight 1 not answered with a HelloVerifyRequest")
    }
    let _ = deliver(mut client, rc, half, single(reply))
    if list.len(drain(mut client, rc, half)) != 1 || next_wake(mut client, rc, half) != half + SECOND {
        fail("flight 3 timer starts at 1 s")
    }
    let resent = drain(mut client, rc, half + SECOND)
    let mut nothing: Bytes = list.new()
    if let Admitted = dtls.admit(cookie_key(), address(1), resent[0], mut nothing) {} else {
        fail("resent flight 3 not admitted")
    }
    let mut server = result.unwrap(dtls.server(take server_id, dtls.defaults(), address(1), Cookie(cookie_key())))
    let _ = deliver(mut server, rs, 2 * SECOND, resent)
    let _ = deliver(mut client, rc, 2 * SECOND, drain(mut server, rs, 2 * SECOND))
    if list.len(drain(mut client, rc, 2 * SECOND)) == 0 {
        fail("no flight 5")
    }
    if next_wake(mut client, rc, 2 * SECOND) != 4 * SECOND {
        fail("flight 5 keeps the doubled timer")
    }
    Ok(())
}

/// Delivers `datagram` and returns how many datagrams the endpoint then sends.
fn sent_after(mut e: dtls.Endpoint, r: Random, now: u64, datagram: Bytes) -> u64 {
    let _ = deliver(mut e, r, now, single(datagram))
    list.len(drain(mut e, r, now))
}

/// bug: resend flight 4 for every repeated epoch-0 ClientHello (an amplifier for anyone who
/// replays flight 3), or let those resends move the timer. oracle: RFC 6347 section 4.2.4 and
/// the DTLS-5 Final flights bound by hand: at most one resend per timer period.
fn flight_four_resends_bounded() {
    let p = party(113)
    let Party(id: take cid, ..) = take p
    let rc = provide.random(114)
    let rs = provide.random(115)
    let mut client = result.unwrap(dtls.client(take cid, dtls.defaults(), address(1)))
    let mut server = fresh_server(116)
    let hello = drain(mut client, rc, 0)
    let _ = deliver(mut server, rs, 0, hello)
    let size = list.len(drain(mut server, rs, 0))
    if size == 0 {
        fail("no flight 4")
    }
    let mut resent = 0u64
    for _ in 0u64 .. 5 {
        resent += sent_after(mut server, rs, 0, hello[0])
    }
    if resent != size || next_wake(mut server, rs, 0) != SECOND {
        fail("repeated ClientHellos resent flight 4 more than once or moved the timer")
    }
    if list.len(drain(mut server, rs, SECOND)) != size || next_wake(mut server, rs, SECOND) != 3 * SECOND {
        fail("timer expiry resend")
    }
    let half = SECOND + SECOND / 2
    if sent_after(mut server, rs, half, hello[0]) != size || sent_after(mut server, rs, half, hello[0]) != 0 {
        fail("one resend in the next timer period")
    }
}

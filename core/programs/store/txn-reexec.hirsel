// The frame records data rows in key order; the re-run's rows are sorted the same way.
pub fn same_writes(rows: pages.DataRows, committed: List[format.JournalOp]) -> Result[bool, types.Failure] {
    if pages.data_row_count(rows) != list.len(committed) {
        return Ok(false)
    }
    let order = types.capacity(pages.data_order(rows))?
    for slot_order in 0u64 .. pages.data_row_count(rows) {
        let op = pager.ordered_row(rows, order, slot_order)
        let other = view committed[slot_order]
        if op.key != other.key {
            return Ok(false)
        }
        if let Some(trim) = op.trim {
            let Some(expected) = other.trim else {
                return Ok(false)
            }
            if trim.floor != expected.floor {
                return Ok(false)
            }
            continue
        } else if let Some(_) = other.trim {
            return Ok(false)
        }
        let equal = match (view op.value, view other.value) {
            (Some(staged), Some(raw)) => format.staged_bytes(staged) == raw,
            (None, None) => true,
            _ => false,
        }
        if !equal {
            return Ok(false)
        }
    }
    Ok(true)
}

pub fn replay_base_state(take validated: manifest.ValidatedPageManifest) -> Result[(manifest.PageManifest, pages.State), types.Failure] {
    let mut has_cold = false
    for (_, pack) in validated.inventory {
        if pack.class >= 3 {
            has_cold = true
            break
        }
    }
    if has_cold {
        let manifest.LoadedPageStore(manifest: take selected, holders: take holders, ..) = history.rebuild_page_store(take validated, None)?
        let state = manifest.disk_allocation(scoped fn() -> Result[pages.State, types.Failure] {
            types.capacity(manifest.manifest_state(selected, holders))
        })?
        return Ok((take selected, take state))
    }
    let manifest.ValidatedPageManifest(manifest: take selected, graph: take resolved, ..) = take validated
    let mut graph = take resolved
    let empty_collection = manifest.disk_allocation(fn() -> Result[Arc[std.page.Page], types.Failure] {
        Ok(std.page.empty(0, 0, Collection))
    })?
    let page_nodes = manifest.attach_page_graph(mut graph, empty_collection)?
    let state = manifest.disk_allocation(scoped fn() -> Result[pages.State, types.Failure] {
        let holders = manifest.attach_manifest_holders(selected, page_nodes, empty_collection)
        types.capacity(manifest.manifest_state(selected, holders))
    })?
    Ok((take selected, take state))
}

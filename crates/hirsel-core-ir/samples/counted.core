; Constructor refusals are explicitly unwrapped; failure edges clean the live prefix.
; CoreIR sample, family: immutable counted values (alloc counted, share, release,
; try_unwrap). FORM v1a, MEM-14..16, F05.
;
; Source (package samples@0, module counted):
;   i0  type Leaf { x: u64 }
;       type Data { v: u64, b: Box[Leaf] }
;       fn wrap(x: u64) -> Rc[Data] { Rc.new(Data { v: x, b: Box.new(Leaf { x }) }) }
;       fn unwrap(x: u64) -> (bool, bool, bool, u64) {
;         let h1 = wrap(x); let h2 = h1.share(); ..; drop(h2); match Rc.try_unwrap(h1) { .. }
;       }
;       fn shared(x: u64) { let h1: Arc[Data] = ..; let h2 = h1.share() }
;
; A node is the count (u64, offset 0) then the payload (offset 8); `alloc counted`
; sets the count to 1 and the node is charged counted(16) = 24. `deref` of an rc or
; arc field names the payload. Wrapping moves the payload into the node with `copy`:
; no block the payload owns is freed or made again (the box stays the same block).
; `release` at zero cleans the payload, which holds no resource, so no user code runs
; and nothing fails (MEM-16), then frees the node. `try_unwrap` is true exactly when
; this is the only holder; the caller then moves the payload out and frees the node,
; which refunds the node only (F05). f0 is the construction `Rc.new` and `Arc.new`
; share; Leaf's box is charged 8.
;
; Behaviour, derived by hand:
; run: f1(5) -> true, false, true, 5 | used 0   ; same box; shared; alone; payload intact
; run: f2(5) -> | used 0                         ; the last release frees box and node
core v1
item i0 = samples@0/counted/unwrap
type t0 = own "Data" { v: u64, b: box t1 }
type t1 = own "Leaf" { x: u64 }
type t2 = own "H" { r: rc t0 }
type t3 = own "HA" { r: arc t0 }
sig g0 = (u64) -> (ptr, ptr)
sig g1 = (u64) -> (bool, bool, bool, u64)
sig g2 = (u64) -> ()
inst n0 = samples@0/counted/wrap [] []
inst n1 = samples@0/counted/unwrap [] []
inst n2 = samples@0/counted/shared [] []
fn f0 = n0 g0 {
  slot s0 = t0                         ; the Data before wrapping
  slot s1 = t2                         ; the new holder
  addr a0 = s0 field 0 : u64
  addr a1 = s0 field 1 : ptr
  addr a2 = v2 : t1
  addr a3 = a2 field 0 : u64
  addr a4 = s1 field 0 : ptr
  addr a5 = s1 field 0 deref : t0      ; the payload, at node + 8
  addr a6 = s0 : t0
b0(v0: u64):
  live s0
  live s1
  address a0
  address a1
  address a4
  address a6
  store a0, v0
  v1: u64 = const 8
  v8: u64 = const 8
  v2: ptr, v3: u64 = alloc own v8 align 8 charge v1
  v10: ptr = const 0x0
  v11: bool = ne v2, v10
  branch v11, b1, b3
b1:
  address a2
  address a3
  store a3, v0
  store a1, v2
  v4: u64 = const 24
  v9: u64 = const 24
  v5: ptr, v6: u64 = alloc counted v9 align 8 charge v4
  v12: ptr = const 0x0
  v13: bool = ne v5, v12
  branch v13, b2, b4
b2:
  store a4, v5
  address a5
  v7: u64 = const 16
  copy a5, a6, v7                      ; Data moves in; its box is not touched
  dead s1
  dead s0
  return v5, v2
b3:
  raise unwrap
b4:
  raise unwrap cleanup b5
b5:
  free v2 charge v1
  propagate
}
fn f1 = n1 g1 {
  slot s0 = t2                         ; h1
  slot s1 = t2                         ; h2
  slot s2 = t0                         ; the unwrapped Data
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 0 deref field 1 : ptr
  addr a2 = s1 field 0 : ptr
  addr a3 = s1 : t2
  addr a4 = s0 field 0 deref : t0
  addr a5 = s2 : t0
  addr a6 = s2 field 1 deref field 0 : u64
  addr a7 = s0 : t2
b0(v0: u64):
  live s0
  live s1
  live s2
  address a0
  address a2
  address a3
  address a5
  address a7
  v1: ptr, v2: ptr = call f0 g0 (v0)
  store a0, v1
  address a1
  address a4
  v3: ptr = read a1
  v4: bool = eq v3, v2                 ; wrapping kept the box
  share v1 rc
  store a2, v1                         ; h2: a second holder, count 2
  v5: bool = try_unwrap v1 rc          ; false: two holders
  drop a3 t2                           ; h2 goes: count 1
  v6: bool = try_unwrap v1 rc          ; true: h1 is alone
  branch v6, b1, b2
b1:
  v7: u64 = const 16
  copy a5, a4, v7                      ; the payload is the caller's
  v8: u64 = const 24
  free v1 charge v8                    ; refunds the node only
  address a6
  v9: u64 = read a6
  drop a5 t0
  dead s2
  dead s1
  dead s0
  return v4, v5, v6, v9
b2:
  drop a7 t2
  v10: u64 = const 0
  return v4, v5, v6, v10
}
fn f2 = n2 g2 {
  slot s0 = t3                         ; h1
  slot s1 = t3                         ; h2
  addr a0 = s0 field 0 : ptr
  addr a1 = s1 field 0 : ptr
  addr a2 = s0 : t3
  addr a3 = s1 : t3
b0(v0: u64):
  live s0
  live s1
  address a0
  address a1
  address a2
  address a3
  v1: ptr, v2: ptr = call f0 g0 (v0)
  store a0, v1
  share v1 arc
  store a1, v1
  drop a3 t3                           ; count 1
  drop a2 t3                           ; count 0: the box, then the node
  dead s1
  dead s0
  return
}

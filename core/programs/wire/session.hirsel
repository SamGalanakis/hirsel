// W3b's socket fixture supplies a transport-neutral service without admission.
// W3c owns the production Hello, principal, entry and durable-call service.
fn ready(context: ()) -> bool {
    true
}

fn step(mut context: (), mut work: runner.WireWork, take input: runner.ServiceInput) -> Result[Option[runner.Frame], u16] {
    match take input {
        WClient(Call(stream, p, _, _, take arg), _) => {
            let mut done: List[runner.Done] = list.new()
            list.push(mut done, runner.Done(stream: stream, p: p, outcome: Returned(take arg)))
            Ok(Some(Batch(0u64, list.new(), list.new(), take done)))
        },
        WClient(Hello(Some(token), _), _) => {
            if token == string.as_bytes("deadline") {
                Ok(Some(Reset(0u64, list.new())))
            } else {
                Error(1013u16)
            }
        },
        WClient(Unsubscribe(_), _) => Ok(Some(Reset(0u64, list.new()))),
        WClient(_, _) => Error(1013u16),
        _ => Ok(None),
    }
}

fn inspect(context: (), frame: runner.Frame) -> Option[u16] {
    None
}

fn finish(mut context: ()) -> Option[runner.PubIn] {
    None
}

fn service() -> runner.Service[()] {
    runner.Service(context: (), step: step, ready: ready, finish: finish, check: inspect, retirement: None, flush_subscriptions: fn(mut context: (), mut work: runner.WireWork) -> () {})
}

fn run(n: Net, tasks: Tasks, clock: Clock, out: Stdout, config: runner.WireConfig) -> Result[(), Exit] waits {
    let mut c = config
    c.n_pool = 16777216u64
    let listener = match host.listen(n, Addr(ip: V4(0x7f000001u32), port: 0u16), 128u16) {
        Ok((take l, address)) => {
            let mut line = string.from("listening ")
            string.push_u64(mut line, int.widen(address.port))
            string.push(mut line, "\n")
            let _ = stdout.write(out, line)
            take l
        },
        Error(_) => return Error(Exit(status: 1u8)),
    }
    let mail = result.unwrap(runner.mailbox(64u64))
    let to_publisher = runner.post(mail)
    let result = runner.serve_wire(take listener, tasks, clock, to_publisher, c, 16u64, list.new(), 0u64, service, fn(mut context: (), take plan: runner.ServiceAllocation) -> Result[runner.ServicePlan, u16] {
        Error(1013u16)
    })
    match result {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 1u8))
    }
}

pub fn main(n: Net, tasks: Tasks, clock: Clock, out: Stdout) -> Result[(), Exit] waits {
    run(n, tasks, clock, out, runner.wire_defaults(65536u64))
}

pub fn idle(n: Net, tasks: Tasks, clock: Clock, out: Stdout) -> Result[(), Exit] waits {
    let mut config = runner.wire_defaults(65536u64)
    config.socket.idle_ms = 100u64
    config.socket.close_ms = 500u64
    run(n, tasks, clock, out, config)
}

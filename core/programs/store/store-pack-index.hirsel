const PACK_INDEX_KIND: u16 = 0x0023

const PACK_INDEX_LIMIT: u64 = 1048576 - 16

const PACK_INDEX_PREFIX: u64 = 12

const PACK_INDEX_ROW: u64 = 29

type PackIndexRow {
    offset: u64,
    len: u32,
    kind: u8,
    collection: u32,
    stamp: u64,
    key: Bytes
}

type PackIndex {
    prev: u64,
    rows: List[PackIndexRow]
}

fn page_index_row(ptr: std.page.PagePtr, collection: u32, take key: Bytes) -> PackIndexRow {
    PackIndexRow(offset: ptr.offset, len: ptr.len, kind: 0x21, collection: collection, stamp: ptr.stamp, key: take key)
}

fn blob_index_row(reference: std.page.BlobRef, collection: u32, take key: Bytes) -> PackIndexRow {
    PackIndexRow(offset: reference.offset, len: int.truncate(8 + reference.len), kind: 0x22, collection: collection, stamp: reference.stamp, key: take key)
}

fn pack_index_row_room(row: PackIndexRow) -> u64 {
    PACK_INDEX_ROW + list.len(row.key)
}

// Plan index frames with full keys. Front coding can shrink the sealed
// object without changing where the writer splits the index.
fn pack_index_frame_end(rows: List[PackIndexRow], begin: u64) -> (u64, u64) {
    let mut room = PACK_INDEX_PREFIX
    let mut end = begin
    while end < list.len(rows) {
        let row_room = pack_index_row_room(rows[end])
        if row_room > PACK_INDEX_LIMIT - room {
            break
        }
        room += row_room
        end += 1
    }
    (end, room)
}

fn append_pack_index(mut out: Bytes, context: DiskContext, rows: List[PackIndexRow]) -> Result[u64, Error] {
    let first = list.len(out)
    let mut prev = 0u64
    let mut begin = 0u64
    while begin < list.len(rows) {
        let (end, room) = pack_index_frame_end(rows, begin)
        if end == begin {
            return Error(Limit(Key))
        }
        let at = list.len(out)
        append_pack_index_frame(mut out, context, prev, rows, begin, end, room)?
        prev = at
        begin = end
    }
    Ok(first)
}

fn append_pack_index_frame(mut out: Bytes, context: DiskContext, prev: u64, rows: List[PackIndexRow], begin: u64, end: u64, room: u64) -> Result[(), Error] {
    let mut frame = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(16 + room + BINDING_BYTES))
    })?
    capacity(le(mut frame, int.widen(PACK_INDEX_KIND), 2))?
    capacity(le(mut frame, 1, 2))?
    capacity(le(mut frame, 0, 4))?
    capacity(le(mut frame, 0, 8))?
    capacity(le(mut frame, end - begin, 4))?
    capacity(le(mut frame, prev, 8))?
    for i in begin .. end {
        let row = rows[i]
        let shared = if i == begin {
            0u64
        } else {
            std.page.common_prefix(rows[i - 1].key, row.key)
        }
        let key_len = list.len(row.key)
        capacity(le(mut frame, row.offset, 8))?
        capacity(le(mut frame, int.widen(row.len), 4))?
        capacity(le(mut frame, int.widen(row.kind), 1))?
        capacity(le(mut frame, int.widen(row.collection), 4))?
        capacity(le(mut frame, row.stamp, 8))?
        capacity(le(mut frame, shared, 2))?
        capacity(le(mut frame, key_len - shared, 2))?
        list.append(mut frame, list.slice(row.key, shared, key_len))
    }
    let size: u32 = int.truncate(list.len(frame) - 16)
    list.set_word_le(mut frame, 4, size)
    capacity(seal_frame(mut frame, context, list.len(out)))?
    capacity(list.try_reserve(mut out, list.len(frame)))?
    list.append(mut out, frame)
    Ok(())
}

fn decode_pack_index(file: String, offset: u64, raw: Bytes, mut final_item: u64) -> Result[PackIndex, Error] {
    if list.len(raw) > PACK_INDEX_LIMIT {
        return Error(disk_fault(file, offset, Malformed))
    }
    let mut at = 0u64
    let row_count = disk_number(file, raw, mut at, 4)?
    let prev = disk_number(file, raw, mut at, 8)?
    if row_count == 0 || row_count > (list.len(raw) - at) / PACK_INDEX_ROW || (prev != 0 && (prev < 72 || prev >= offset || offset - prev < 28)) {
        return Error(disk_fault(file, offset, Malformed))
    }
    let mut rows: List[PackIndexRow] = list.new()
    capacity(list.try_reserve(mut rows, row_count))?
    for i in 0u64 .. row_count {
        let row_at = at
        let place = disk_number(file, raw, mut at, 8)?
        let len = disk_number(file, raw, mut at, 4)?
        let kind = disk_number(file, raw, mut at, 1)?
        let collection = disk_number(file, raw, mut at, 4)?
        let stamp = disk_number(file, raw, mut at, 8)?
        let shared = disk_number(file, raw, mut at, 2)?
        let suffix = disk_number(file, raw, mut at, 2)?
        let prior_width = if i == 0 {
            0u64
        } else {
            list.len(rows[i - 1].key)
        }
        if place < 72 || place >= offset || offset - place < len + 16 || stamp == 0 || (kind != 0x21 && kind != 0x22) || (kind == 0x21 && len > PAGE_LIMIT) || (kind == 0x22 && (len < 8 || len > BLOB_LIMIT)) || shared > prior_width || shared + suffix > 4096 || suffix > list.len(raw) - at {
            return Error(disk_fault(file, offset + 16 + row_at, Malformed))
        }
        if place <= final_item {
            return Error(disk_fault(file, offset + 16 + row_at, Order))
        }
        let mut key: Bytes = list.new()
        capacity(list.try_reserve(mut key, shared + suffix))?
        if shared != 0 {
            list.append(mut key, list.slice(rows[i - 1].key, 0, shared))
        }
        list.append(mut key, list.slice(raw, at, at + suffix))
        at += suffix
        final_item = place
        list.push(mut rows, PackIndexRow(offset: place, len: int.truncate(len), kind: int.truncate(kind), collection: int.truncate(collection), stamp: stamp, key: take key))
    }
    if at != list.len(raw) {
        return Error(disk_fault(file, offset + 16 + at, Malformed))
    }
    Ok(PackIndex(prev: prev, rows: take rows))
}

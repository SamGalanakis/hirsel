// Module local (package store): the host's request API. Each call asks the host task
// through its inbox and waits for the answer; `local` starts the task (local.hirsel).
// What one session can hold in the host's catalog at once: its two catalog rows, with
// a key at Store's ROW_KEY_LIMIT, and its group's rows (platform.undeployed_group_bytes).
fn session_catalog_bytes() -> Option[u64] {
    let max = 18446744073709551615u64
    let mut longest: Bytes = list.with_capacity(store.ROW_KEY_LIMIT)
    for _ in 0u64 .. store.ROW_KEY_LIMIT {
        list.push(mut longest, 0u8)
    }
    let keys: std.codec.Codec[Bytes] = std.codec.of()
    let ids: std.codec.Codec[u64] = std.codec.of()
    let mut id_key: Bytes = list.new()
    std.codec.encode_key(std.codec.key_u64(), max, mut id_key)
    let mut key_value: Bytes = list.new()
    if let Error(_) = std.codec.encode(keys, longest, mut key_value) {
        return None
    }
    let mut id_value: Bytes = list.new()
    if let Error(_) = std.codec.encode(ids, max, mut id_value) {
        return None
    }
    let catalog_rows = int.checked_add(store.resident_row_bytes(list.len(id_key), list.len(key_value)), store.resident_row_bytes(store.ROW_KEY_LIMIT, list.len(id_value)))?
    int.checked_add(catalog_rows, platform.undeployed_group_bytes(group_spec(name_of(max)))?)
}

// The host's catalog store: the session store's options, with room in the resident
// account for `max_places` sessions beside the host's own rows (§14.9 "Shape").
fn catalog_options(options: store.Options, max_places: u64) -> Option[store.Options] {
    let per_session = session_catalog_bytes()?
    let mut o: store.Options = clone(options)
    o.authority = Directory()
    o.resident_limit = int.checked_add(options.resident_limit, int.checked_mul(per_session, max_places)?)?
    Some(take o)
}

// The actor's own bytes for `max_places` sessions: the two catalog maps, with a key at
// ROW_KEY_LIMIT, and the marks map.
fn session_maps_bytes(max_places: u64) -> Option[u64] {
    let by_id = charge.map(bytes[u64], bytes[Bytes], max_places)?
    let by_key = charge.map(bytes[Bytes], bytes[u64], max_places)?
    let marks_map = charge.map(bytes[u64], bytes[Marks], max_places)?
    let key = charge.seq(1u64, store.ROW_KEY_LIMIT)?
    let keys = int.checked_mul(int.checked_mul(key, 2u64)?, max_places)?
    int.checked_add(int.checked_add(by_id, by_key)?, int.checked_add(marks_map, keys)?)
}

// What a host spends: its places' budget, its catalog store, the store a create seeds,
// any host stream service, and its own task, whose session maps grow to `max_places`.
pub fn host_bytes(options: store.Options, max_places: u64, place_bytes: u64, units: u64) -> Result[u64, Refused] {
    host_bytes_for(DiskBacking, options, max_places, place_bytes, units, None)
}

pub fn host_bytes_for(backing: PlaceBacking, options: store.Options, max_places: u64, place_bytes: u64, units: u64, journal: Option[store.StreamPlan]) -> Result[u64, Refused] {
    if units == 0u64 {
        return Error(Configuration)
    }
    let Some(catalog) = catalog_options(options, max_places) else {
        return Error(Full)
    }
    let catalog_plan = store.writer_plan(Directory, catalog) ?=> |_| Full
    let session_kind: store.Kind = match backing {
        DiskBacking => Directory,
        BucketBacking(b) => Bucket(bucket_lane_config(b)),
    }
    let session_plan = store.writer_plan(session_kind, options) ?=> |_| Full
    let Some(maps) = session_maps_bytes(max_places) else {
        return Error(Full)
    }
    let Some(stores) = int.checked_add(store.writer_bytes(catalog_plan), store.writer_bytes(session_plan)) else {
        return Error(Full)
    }
    let mut stream_extra = 0u64
    if let BucketBacking(b) = backing {
        if let Some(plan) = journal {
            let Some(lanes) = std.object.lane_reservation(bucket_lane_config(b)) else {
                return Error(Full)
            }
            let Some(with_resolver) = int.checked_add(lanes, b.lane_bytes) else {
                return Error(Full)
            }
            let Some(with_lanes) = int.checked_add(store.stream_service_bytes(plan), with_resolver) else {
                return Error(Full)
            }
            let Some(total_stream) = int.checked_add(with_lanes, 262144u64) else {
                return Error(Full)
            }
            stream_extra = total_stream
        }
    }
    let Some(with_stream) = int.checked_add(stores, stream_extra) else {
        return Error(Full)
    }
    let Some(own) = int.checked_add(LOCAL_BYTES, maps) else {
        return Error(Full)
    }
    let Some(owned) = int.checked_add(with_stream, own) else {
        return Error(Full)
    }
    let Some(need) = int.checked_add(place_bytes, owned) else {
        return Error(Full)
    }
    let Some(helpers) = int.checked_mul(shard_overhead(max_places)?, units) else {
        return Error(Full)
    }
    let Some(total) = int.checked_add(need, helpers) else {
        return Error(Full)
    }
    Ok(total)
}

pub fn doorway() -> Doorway {
    let (to, inbox): (Sender[In], Receiver[In]) = channel.new(256u64)
    Doorway(to: take to, inbox: take inbox)
}

pub fn door_of(w: Doorway) -> Door {
    Door(to: channel.sender(w.to))
}

pub fn local[T: cross](take way: Doorway, take config: Config[T]) -> Result[Local, Refused] waits {
    if config.units == 0u64 {
        return Error(Configuration)
    }
    // Disk streams are refused (STORE-SPEC §12.11.0). Bucket hosts support both
    // standalone (`journal: None`) and streamed (`journal: Some(plan)`) backing.
    if let DiskBacking = config.backing {
        if let Some(_) = config.journal {
            return Error(Configuration)
        }
    }
    if config.max_places == 0u64 || config.idle_ms == 0u64 || config.place_bytes == 0u64 || config.sessions == 0u64 {
        return Error(Full)
    }
    let tasks = config.tasks
    let need = host_bytes_for(config.backing, config.options, config.max_places, config.place_bytes, config.units, config.journal)?
    let Doorway(to: take to, inbox: take inbox) = take way
    let (ready, started): (Sender[Result[(), Refused]], Receiver[Result[(), Refused]]) = channel.new(1u64)
    let begin = Begin(config: take config, inbox: take inbox, me: channel.sender(to), ready: take ready)
    let run: fn(take Begin[T]) -> () waits = run_local
    let actor = match task.try_spawn(tasks, bytes need, take begin, run) {
        Ok(take spawned) => take spawned,
        Error(_) => return Error(Full),
    }
    match channel.receive(started) {
        Ok(Ok(())) => Ok(Local(to: take to, actor: take actor)),
        Ok(Error(take why)) => {
            let _ = task.join(take actor);
            Error(take why)
        },
        Error(_) => {
            let _ = task.join(take actor);
            Error(Stopping)
        },
    }
}

pub fn door(l: Local) -> Door {
    Door(to: channel.sender(l.to))
}

pub fn copy_door(d: Door) -> Door {
    Door(to: channel.sender(d.to))
}

pub fn status(l: Lease) -> Latest[runner.Status] {
    latest.handle(l.status)
}

// The place's dialer, for `client.client_dial` or `wire_client.open_dial`: a lease a route
// answers always has one; a peek of a child not yet Ready has none.
pub fn dialer(l: Lease) -> Option[std.wsock.Dialer] {
    match l.dialer {
        Some(d) => Some(std.wsock.copy_dialer(d)),
        None => None,
    }
}

fn ask[A: send](d: Door, take m: In, answer: Receiver[A], take stopped: A) -> A waits {
    if let Error(_) = channel.send(d.to, take m) {
        return take stopped
    }
    match channel.receive(answer) {
        Ok(take answered) => take answered,
        Error(_) => take stopped
    }
}

// Creates the session `key` names, or finds it: a new one's store is migrated and seeded
// before its group is added, and its id is the one its commit takes.
pub fn create(d: Door, take key: Bytes, take seed: Seed) -> Result[u64, Refused] waits {
    let (reply, answer): (Sender[Result[u64, Refused]], Receiver[Result[u64, Refused]]) = channel.new(1u64)
    ask(d, Create(take key, take seed, take reply), answer, Error(Stopping))
}

// Unlists a session and removes its group, and answers once its child, if any, has
// drained and its store is deleted.
pub fn delete(d: Door, id: u64) -> Result[(), Refused] waits {
    let (reply, answer): (Sender[Result[(), Refused]], Receiver[Result[(), Refused]]) = channel.new(1u64)
    ask(d, Delete(id, take reply), answer, Error(Stopping))
}

pub fn listing(d: Door) -> List[u64] waits {
    let (reply, answer): (Sender[List[u64]], Receiver[List[u64]]) = channel.new(1u64)
    ask(d, Listing(take reply), answer, list.new())
}

// Wakes a session if it is unloaded and answers a lease on its Ready child.
pub fn route(d: Door, id: u64) -> Result[Lease, Refused] waits {
    let (reply, answer): (AccessReply, Receiver[Result[Option[Lease], Refused]]) = channel.new(1u64)
    match ask(d, Route(id, take reply), answer, Error(Stopping)) {
        Ok(take lease) => Ok(option.unwrap(take lease)),
        Error(take why) => Error(take why),
    }
}

// A running child returns a lease for the caller's live authorization. For a
// cold child, check its durable state before optionally starting it. None
// acknowledges an allowed cold read that did not request a wake.
pub fn access(d: Door, id: u64, take check: ColdCheck, wake: bool) -> Result[Option[Lease], Refused] waits {
    let (reply, answer): (AccessReply, Receiver[Result[Option[Lease], Refused]]) = channel.new(1u64)
    ask(d, Access(id, take check, wake, take reply), answer, Error(Stopping))
}

// A lease on the session's child only if it is Ready now; it never starts one (`Busy`).
pub fn peek(d: Door, id: u64) -> Result[Lease, Refused] waits {
    let (reply, answer): (Sender[Result[Lease, Refused]], Receiver[Result[Lease, Refused]]) = channel.new(1u64)
    ask(d, Peek(id, take reply), answer, Error(Stopping))
}

// Drains the session's live child now, as an operator would, and answers how it ended.
pub fn unload(d: Door, id: u64) -> Result[Unloaded, Refused] waits {
    let (reply, answer): (Sender[Result[Unloaded, Refused]], Receiver[Result[Unloaded, Refused]]) = channel.new(1u64)
    ask(d, Unload(id, take reply), answer, Error(Stopping))
}

// Tells the host that a front changed a session, so streams that follow it look again.
pub fn nudge(d: Door, id: u64) -> () waits {
    let _ = channel.send(d.to, Nudge(id))
}

pub fn marks(d: Door, id: u64) -> Marks waits {
    let (reply, answer): (Sender[Marks], Receiver[Marks]) = channel.new(1u64)
    ask(d, Marked(id, take reply), answer, Marks(ups: 0u64, downs: 0u64, nudges: 0u64))
}

// The caller registers before sampling marks. A queued notification is enough
// because marks contain the cumulative counts.
pub fn watch_marks(d: Door, id: u64, notify: Sender[()]) -> Option[u64] waits {
    let (reply, answer): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    if let Error(_) = channel.send(d.to, WatchMarks(id, channel.sender(notify), take reply)) {
        return None
    }
    match channel.receive(answer) {
        Ok(token) => Some(token),
        Error(_) => None
    }
}

pub fn unwatch_marks(d: Door, id: u64, token: u64) -> () waits {
    let _ = channel.send(d.to, UnwatchMarks(id, token))
}

// Waits until the session's child has ended more than `after` times, and answers how many.
pub fn await_down(d: Door, id: u64, after: u64) -> Result[u64, Refused] waits {
    let (reply, answer): (Downs, Receiver[Result[u64, Refused]]) = channel.new(1u64)
    ask(d, AwaitDown(id, after, take reply), answer, Error(Stopping))
}

// Runs `r` over the session's committed store once no child of it is live, and answers
// what it read.
pub fn read_cold(d: Door, id: u64, take r: ColdRead) -> Result[Bytes, Refused] waits {
    let (reply, answer): (ReadReply, Receiver[Result[Bytes, Refused]]) = channel.new(1u64)
    ask(d, Read(id, take r, take reply), answer, Error(Stopping))
}

// Drains every live child through its graceful stop, applies each end to the host's
// catalog and returns how each ended.
pub fn stop(take l: Local) -> List[Unloaded] waits {
    let Local(to: take to, actor: take actor) = take l
    let (reply, answer): (Sender[List[Unloaded]], Receiver[List[Unloaded]]) = channel.new(1u64)
    let _ = channel.send(to, Halt(take reply))
    let ended = match channel.receive(answer) {
        Ok(take done) => take done,
        Error(_) => list.new()
    }
    let _ = task.join(take actor)
    take ended
}

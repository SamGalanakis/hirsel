; The hash of a slot after a write must match the hash of the incoming bytes
; in a separate slot. Returning the old hash would break lookup after mutation.
core v1
sig g0 = (u64, u64) -> (bool, bool)
sig g1 = (ptr, u64) -> (u64)
inst n0 = core@1/hash_writes/run [] []
fn f0 = n0 g0 {
  slot s0 = u64
  slot s1 = u64
  addr a0 = s0 : u64
  addr a1 = s1 : u64
b0(v0: u64, v1: u64):
  live s0
  live s1
  address a0
  address a1
  store a0, v0
  store a1, v1
  v2: ptr = pointer a0
  v3: u64 = const 8
  v4: u64 = call rt.map_hash_bytes g1 (v2, v3)
  v5: u64 = call rt.map_hash_bytes g1 (v2, v3)
  store a0, v1
  v6: u64 = call rt.map_hash_bytes g1 (v2, v3)
  v7: ptr = pointer a1
  v8: u64 = call rt.map_hash_bytes g1 (v7, v3)
  v9: bool = eq v4, v5
  v10: bool = eq v6, v8
  dead s0
  dead s1
  return v9, v10
}

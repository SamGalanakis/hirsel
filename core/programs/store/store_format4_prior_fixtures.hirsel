// Captured from format-4 writer 47575f96. At the selected checkpoint,
// collection 1, key 7 holds four zero bytes. The suffix overwrites it
// with 01 00 00 00 a5. Both put grammars consume the same frame boundary.

fn append_frozen(mut raw: Bytes, encoded: String) {
    list.append(mut raw, option.unwrap(std.hex.decode(string.as_bytes(encoded))))
}


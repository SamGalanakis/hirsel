// M2b slice 4, the intended spool API for a handler of any type: `request` and
// `register_as` take a `StaticFn[F]` for any F and take its identity themselves.
// Expected red: `code.identity` of a generic StaticFn parameter is not built
// (core/corpus/m2b/dispatch_generic/SPEC.md).
fn repeat(b: Bytes, k: u64) -> Result[Bytes, Capacity] {
    Ok(list.new())
}

fn names[F](s: StaticFn[F], want: Bytes) -> bool {
    code.identity(s) == want
}

pub fn case_generic_identity() -> u64 {
    if names(code.describe(repeat), code.identity(code.describe(repeat))) {
        1
    } else {
        0
    }
}

pub fn main(out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let Some(name) = args.get(argv, 0) else {
        return Error(Exit(status: 2))
    }
    if name != "generic_identity" {
        return Error(Exit(status: 2))
    }
    let s = if case_generic_identity() == 1 {
        "1\n"
    } else {
        "0\n"
    }
    match stdout.write(out, s) {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 2)),
    }
}

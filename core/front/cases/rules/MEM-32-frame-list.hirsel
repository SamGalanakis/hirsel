// The logical peak for 20 or 40 pushes is below 1000 bytes. Both fit and
// leave the full bound available after drop, including after heap growth.
// The reference evaluator also checks refusals at the logical charges.
// expect: run frame_local(20,1000) = 1901000
// expect: reference run frame_local(20,300) = 12561720300
// expect: reference run frame_local(3,31) = 10320310031
// expect: run frame_local(40,1000) = 7801000
// expect: reference run frame_local(40,700) = 15124440700
//
// Each list below leaves its function by one route, so its storage must outlive the
// frame that made it; `local(5)` then reuses that frame's stack before the sum is
// read. Six pushes: sum 15, capacity 8 (64 bytes, a channel 1 * 24 + 64 more), all
// refunded before the probe: 15 * 10000 + 1000. The lent list first takes 100 in its
// own function, so the callee grows storage its owner made: (100 + 15) * 10000 + 1000.
// expect: run escape_return(6) = 151000
// expect: run escape_field(6) = 151000
// expect: run escape_capture(6) = 151000
// expect: run escape_send(6) = 151000
// expect: run escape_kept(6) = 151000
// expect: run escape_lent(6) = 1151000
type Holder {
    xs: List[u64]
}

fn sum(xs: List[u64]) -> u64 {
    let mut s = 0u64
    for v in xs {
        s += v
    }
    s
}

fn push_all(mut xs: List[u64], n: u64) -> u64 {
    let mut i = 0u64
    while i < n {
        match list.try_reserve(mut xs, 1) {
            Ok(()) => {},
            Error(e) => return 1000000 + e.requested * 1000 + e.available
        }
        list.push(mut xs, i)
        i += 1
    }
    0
}

fn local(n: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        match list.try_reserve(mut xs, 1) {
            Ok(()) => {},
            Error(e) => return 1000000 + e.requested * 1000 + e.available
        }
        list.push(mut xs, i)
        i += 1
    }
    let mut s = 0u64
    for v in xs {
        s += v
    }
    s
}

fn room() -> u64 {
    let mut probe: List[u64] = list.new()
    match list.try_reserve(mut probe, 1000000) {
        Ok(()) => 0,
        Error(e) => e.available,
    }
}

fn frame_local(n: u64, b: u64) -> u64 {
    let r = bound bytes b {
        let s = local(n)
        s * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn returned(n: u64) -> Option[List[u64]] {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    Some(take xs)
}

fn by_return(n: u64) -> u64 {
    match returned(n) {
        Some(take xs) => {
            let _ = local(5)
            sum(xs)
        },
        None => 0
    }
}

fn held(n: u64) -> Holder {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    Holder(xs: take xs)
}

fn by_field(n: u64) -> u64 {
    let h = held(n)
    let _ = local(5)
    sum(h.xs)
}

fn by_capture(n: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    let made = fn() -> u64 {
        sum(xs)
    }
    let _ = local(5)
    made()
}

fn by_send(n: u64) -> u64 {
    let (tx, rx): (Sender[List[u64]], Receiver[List[u64]]) = channel.new(1)
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    match channel.try_send(tx, take xs) {
        Ok(()) => {},
        Error(_) => return 0
    }
    let _ = local(5)
    match channel.try_receive(rx) {
        Ok(take ys) => sum(ys),
        Error(_) => 0
    }
}

fn keep(take xs: List[u64]) -> List[u64] {
    let _ = local(5)
    xs
}

fn kept(n: u64) -> List[u64] {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    keep(take xs)
}

fn by_kept(n: u64) -> u64 {
    let ys = kept(n)
    let _ = local(5)
    sum(ys)
}

fn by_lent(n: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let _ = list.push(mut xs, 100)
    let _ = push_all(mut xs, n)
    let _ = local(5)
    sum(xs)
}

fn escape_return(n: u64) -> u64 {
    let r = bound bytes 1000 {
        by_return(n) * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_field(n: u64) -> u64 {
    let r = bound bytes 1000 {
        by_field(n) * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_capture(n: u64) -> u64 {
    let r = bound bytes 1000 {
        by_capture(n) * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_send(n: u64) -> u64 {
    let r = bound bytes 1000 {
        by_send(n) * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_kept(n: u64) -> u64 {
    let r = bound bytes 1000 {
        by_kept(n) * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_lent(n: u64) -> u64 {
    let r = bound bytes 1000 {
        by_lent(n) * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

// A zero-byte callee bound refuses 4 -> 8. A 64-byte bound can pay for
// all eight slots, and the refund for the original four goes to the caller.
fn grow_under_bound(mut xs: List[u64]) -> bool {
    let refused = bound bytes 0 {
        list.try_reserve(mut xs, 4)
    }
    match refused {
        Ok(Error(e)) if e.requested == 64 && e.available == 0 => {},
        _ => return false
    }
    let grown = bound bytes 64 {
        list.reserve(mut xs, 4)
        room()
    }
    match grown {
        Ok(n) => n == 0,
        Error(_) => false
    }
}

// OWN-7: the callee's pushes take this list past 128 bytes. The caller reads
// every retained element. The 32-slot buffer holds 256 of the 1000 bytes, so
// the live probe sees 744 and the probe after caller drop sees all 1000.
fn lent_contents() -> u64 {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 100)
    if !grow_under_bound(mut xs) {
        return 3
    }
    let err = push_all(mut xs, 20)
    if err != 0 || list.len(xs) != 21 || xs[0] != 100 {
        return 1
    }
    for i in 0u64 .. 20 {
        if xs[i + 1] != i {
            return 2
        }
    }
    room()
}

fn lent_growth() -> u64 {
    let r = bound bytes 1000 {
        let remaining = lent_contents()
        remaining * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 0
    }
}

// expect: run lent_growth() = 7441000
// Taking a lent place directly is refused by OWN-11, but OWN-13 lets replace
// return its old value. The old 4-slot buffer stays live across the caller's
// return and a second use of its stack. Its value is 91 and its charge is 32.
fn exchange[T](mut xs: T, take empty: T) -> T {
    replace(mut xs, take empty)
}

fn extract(mut xs: List[u64]) -> List[u64] {
    // A move changes physical backing without a new logical admission.
    let old = bound bytes 0 {
        exchange(mut xs, list.new())
    }
    result.unwrap(take old)
}

fn replaced() -> List[u64] {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 91)
    extract(mut xs)
}

fn read_replaced() -> u64 {
    let xs = replaced()
    let _ = local(5)
    xs[0] * 10000 + room()
}

fn lent_replace() -> u64 {
    let r = bound bytes 1000 {
        let live = read_replaced()
        live * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 0
    }
}

// expect: run lent_replace() = 9109681000
fn produce(take tx: Sender[u64]) waits {
    result.unwrap(channel.send(tx, 99))
}

fn push_then_receive(mut xs: List[u64], rx: Receiver[u64]) waits {
    list.push(mut xs, 100)
    let n = result.unwrap(channel.receive(rx))
    list.reserve(mut xs, 17)
    list.push(mut xs, n)
}

// The first push fills the fourth slot before receive. Reserve after wake asks
// for 21 slots and growth copies all four values. The caller checks all five.
fn lent_park(tasks: Tasks) -> u64 waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(1)
    let h = task.spawn(tasks, bytes 4096, take tx, produce)
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 0)
    list.push(mut xs, 1)
    list.push(mut xs, 2)
    push_then_receive(mut xs, rx)
    result.unwrap(task.join(take h))
    if list.len(xs) == 5 && xs[0] == 0 && xs[1] == 1 && xs[2] == 2 && xs[3] == 100 && xs[4] == 99 {
        list.capacity(xs)
    } else {
        0
    }
}
// expect: run lent_park(1) = 21

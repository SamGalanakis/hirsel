type FrameBody: send = PageBody(Arc[std.page.Page]) | BlobBody(Arc[Bytes])

type PackFrame: send {
    stamp: u64,
    size: u64,
    body: FrameBody
}

type PlannedPack: send {
    seq: u64,
    first: u64,
    end: u64,
    size: u64,
    payload_bytes: u64
}

type PackRun: send {
    class: u8,
    frames: List[PackFrame],
    packs: List[PlannedPack],
    next_pack: u64
}

fn blob_frames(cut: CutFrames) -> List[PackFrame] {
    let mut frames: List[PackFrame] = list.with_capacity(list.len(cut.blobs))
    for item in cut.blobs {
        let frame = PackFrame(stamp: item.stamp, size: 8 + list.len(item.body), body: BlobBody(arc.share(item.body)))
        list.push(mut frames, take frame)
    }
    take frames
}

fn page_frames(cut: CutFrames) -> List[PackFrame] {
    let mut frames: List[PackFrame] = list.with_capacity(list.len(cut.pages))
    for item in cut.pages {
        let width = std.page.sealed_size(std.page.image_of(item.body))
        list.push(mut frames, PackFrame(stamp: item.stamp, size: width, body: PageBody(arc.share(item.body))))
    }
    take frames
}

fn layout_packs(take frames: List[PackFrame], class: u8, first_pack: u64, cap: u64) -> Result[PackRun, Error] {
    let mut packs: List[PlannedPack] = list.new()
    let mut seq = first_pack
    let mut first = 0u64
    let mut size = 72u64
    let mut payload = 0u64
    for slot in 0u64 .. list.len(frames) {
        let width = frames[slot].size
        if slot != first && (size > cap || 16 + width > cap - size || slot - first == 4294967295) {
            list.push(mut packs, PlannedPack(seq: seq, first: first, end: slot, size: size, payload_bytes: payload))
            let Some(following) = int.checked_add(seq, 1) else {
                return Error(Limit(Ids))
            }
            seq = following
            first = slot
            size = 72
            payload = 0
        }
        size += 16 + width
        payload += width
    }
    let end = list.len(frames)
    if end != first {
        list.push(mut packs, PlannedPack(seq: seq, first: first, end: end, size: size, payload_bytes: payload))
        let Some(following) = int.checked_add(seq, 1) else {
            return Error(Limit(Ids))
        }
        seq = following
    }
    Ok(PackRun(class: class, frames: take frames, packs: take packs, next_pack: seq))
}

fn apply_pack_layout(mut known: PageLocations, layout: PackRun) -> Result[(), Error] {
    for planned in layout.packs {
        let mut offset = 72u64
        for slot in planned.first .. planned.end {
            let frame = layout.frames[slot]
            let place = std.page.PagePtr(pack: planned.seq, offset: offset, len: int.truncate(frame.size), checksum: 0, stamp: frame.stamp)
            let old = option.unwrap(capacity(disk_index_update(mut known.frames, frame.stamp, frame_edge_charge, fn(mut location: FrameLocation) -> std.page.PagePtr {
                replace(mut location.place, place)
            }))?)
            if old.pack != 0 {
                let _ = capacity(disk_index_remove(mut known.members, (old.pack, frame.stamp), member_charge))?
                let _ = capacity(disk_index_update(mut known.packs, old.pack, pack_edge_charge, fn(mut pack: PagePack) {
                    let width: u64 = int.widen(old.len)
                    pack.live -= width
                }))?
            }
            capacity(disk_index_put(mut known.members, (planned.seq, frame.stamp), (), member_charge))?
            offset += 16 + frame.size
        }
        let frame_count: u32 = int.truncate(planned.end - planned.first)
        let record = PagePack(class: layout.class, frames: frame_count, live: planned.payload_bytes, payload_bytes: planned.payload_bytes, index: 0)
        capacity(disk_index_put(mut known.packs, planned.seq, record, pack_edge_charge))?
    }
    Ok(())
}

fn emit_pack_frame(mut out: Bytes, context: DiskContext, frame: PackFrame, known: PageLocations) -> Result[std.page.PagePtr, Error] {
    emit_located_frame(mut out, context, frame, scoped fn(stamp: u64) -> std.page.PagePtr {
        let Some(location) = disk_index_get(known.frames, stamp) else {
            fail("store: missing emitted child")
        }
        location.place
    })
}

fn emit_located_frame(mut out: Bytes, context: DiskContext, frame: PackFrame, locate: scoped[view] fn(u64) -> std.page.PagePtr) -> Result[std.page.PagePtr, Error] {
    let offset = list.len(out)
    let kind: u16 = match frame.body {
        BlobBody(_) => 0x0022,
        PageBody(_) => 0x0021
    }
    list.put_word_le(mut out, kind)
    list.put_word_le(mut out, 1u16)
    let size: u32 = int.truncate(frame.size)
    list.put_word_le(mut out, size)
    list.put_word_le(mut out, 0u64)
    let checksum = match frame.body {
        BlobBody(body) => {
            list.put_word_le(mut out, frame.stamp)
            list.append(mut out, body)
            std.check.xxh3(body, 0, list.len(body))
        },
        PageBody(page) => {
            // The pack buffer already has room for the planned PAGE.
            page_result(std.page.seal_located(mut out, page, locate))?
            std.check.xxh3(out, offset + 16, list.len(out))
        },
    }
    let bound_checksum = disk_allocation(scoped fn() -> Result[u64, Error] {
        capacity(disk_check(context, offset, list.slice(out, offset, offset + 8), list.slice(out, offset + 16, list.len(out))))
    })?
    list.set_word_le(mut out, offset + 8, bound_checksum)
    Ok(std.page.PagePtr(pack: context.seq, offset: offset, len: size, checksum: checksum, stamp: frame.stamp))
}

fn install_emitted_place(mut known: PageLocations, located: std.page.PagePtr) -> Result[(), Error] {
    let updated = disk_allocation(scoped fn() -> Result[DiskIndex[u64, FrameLocation], Error] {
        let mut frames = disk_index_share(known.frames)
        let _ = capacity(disk_index_update(mut frames, located.stamp, frame_edge_charge, fn(mut location: FrameLocation) {
            location.place = located
        }))?
        Ok(take frames)
    })?
    known.frames = take updated
    Ok(())
}

fn encode_pack(id: StoreId, layout: PackRun, planned: PlannedPack, mut known: PageLocations, mut out: Bytes) -> Result[(), Error] {
    list.clear(mut out)
    let context = DiskContext(store: id, role: 3, seq: planned.seq)
    let header = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        capacity(disk_header_bytes(context, 0, 0))
    })?
    list.append(mut out, header)
    for slot in planned.first .. planned.end {
        let located = emit_pack_frame(mut out, context, layout.frames[slot], known)?
        install_emitted_place(mut known, located)?
    }
    Ok(())
}

type PackBuffers {
    out: Bytes,
    destination: String,
    temporary: String
}

fn cut_output_buffers(cut: PagedCutLayout, manifest_bytes: u64, limit: u64) -> Result[PackBuffers, Error] {
    let mut width = manifest_bytes
    for pack in cut.blobs.packs {
        width = order.max(width, pack.size)
    }
    for pack in cut.data_pages.packs {
        width = order.max(width, pack.size)
    }
    for pack in cut.lists.run_packs.packs {
        width = order.max(width, pack.size)
    }
    if width > limit {
        return Error(Full(Allocation(Capacity(requested: width, available: limit))))
    }
    disk_allocation(scoped fn() -> Result[PackBuffers, Error] {
        Ok(PackBuffers(out: list.with_capacity(width), destination: string.with_capacity(22), temporary: string.with_capacity(26)))
    })
}

fn write_pack_run(d: Dir, id: StoreId, layout: PackRun, mut known: PageLocations, mut buffers: PackBuffers) -> Result[(), Error] waits {
    for planned in layout.packs {
        encode_pack(id, layout, planned, mut known, mut buffers.out)?
        string.truncate(mut buffers.destination, 0)
        string.push(mut buffers.destination, "p-")
        string.push_u64(mut buffers.destination, planned.seq)
        string.truncate(mut buffers.temporary, 0)
        string.push(mut buffers.temporary, buffers.destination)
        string.push(mut buffers.temporary, ".tmp")
        disk_write_synced(d, buffers.temporary, buffers.out)?
        disk_io(host.rename(d, buffers.temporary, buffers.destination))?
    }
    Ok(())
}

fn sparse_pack(known: PagePack) -> bool {
    known.live != 0 && known.frames > 1 && known.live < known.payload_bytes - known.live
}

fn moved_frames(known: PageLocations, lists: bool) -> List[u64] {
    let mut moved: List[u64] = list.new()
    let mut inventory = std.omap.range(known.packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut inventory) {
        if (pack.class == 2) == lists && sparse_pack(pack) {
            let mut members = std.omap.range(known.members.values, Included((seq, 0u64)), Included((seq, 18446744073709551615u64)))
            while let Some(((_, stamp), _)) = std.omap.next(mut members) {
                list.push(mut moved, stamp)
            }
        }
    }
    // The previous stamp-ordered walk seeded the closure in this order.
    list.sort(mut moved, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    take moved
}

fn encode_pack_row(pack: PagePack) -> Bytes {
    let mut out: Bytes = list.with_capacity(29)
    list.push(mut out, pack.class)
    list.put_word_le(mut out, pack.frames)
    list.put_word_le(mut out, pack.live)
    list.put_word_le(mut out, pack.payload_bytes)
    list.put_word_le(mut out, pack.index)
    take out
}

// Apply final class-0 and class-1 counts to the installed pack-list tree.
// The list is edited in place only on paths private to this candidate.
fn reserve_list_edit(root: Arc[std.page.Page], mut next_stamp: u64, issued: core.Log[u64]) -> Result[u64, Error] {
    let height: u64 = int.widen(std.page.level(std.page.image_of(root)))
    // Per level an edit can copy the path page, replace two siblings during
    // a rotation, and split into three pieces. The final root needs one stamp.
    let Some(end) = int.checked_add(next_stamp, 6 * (height + 1) + 1) else {
        return Error(Limit(Ids))
    }
    log.append(issued, end)
    let first = next_stamp
    next_stamp = end
    Ok(first)
}

fn edit_pack_list(mut root: Arc[std.page.Page], known: PageLocations, private_from: u64, mut next_stamp: u64, issued: core.Log[u64]) -> Result[List[u64], Error] {
    let mut retired: List[u64] = list.new()
    let mut inventory = std.omap.range(known.packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut inventory) {
        if pack.class == 2 {
            continue
        }
        let key = key_word(seq)
        if pack.live == 0 {
            let listed = match std.page.lookup(root, key) {
                Some(_) => true,
                None => false
            }
            if listed {
                let mut draw = reserve_list_edit(root, mut next_stamp, issued)?
                let _ = page_result(std.page.remove(mut root, key, private_from, mut draw))?
            }
            list.push(mut retired, seq)
            continue
        }
        let raw = encode_pack_row(pack)
        let unchanged = match std.page.lookup(root, key) {
            Some(old) => raw == old,
            None => false
        }
        if !unchanged {
            let mut draw = reserve_list_edit(root, mut next_stamp, issued)?
            page_result(std.page.insert(mut root, key, raw, None, 1024, private_from, mut draw))?
        }
    }
    Ok(take retired)
}

fn build_retirement_list(retired: List[u64], mut next_stamp: u64) -> Result[Arc[std.page.Page], Error] {
    let mut rows: List[std.page.Row] = list.with_capacity(list.len(retired))
    for seq in retired {
        let key = key_word(seq)
        list.push(mut rows, std.page.Row(key: take key, value: list.new(), charge: 70))
    }
    let built = page_result(std.page.bulk(rows, Unprefixed, 1024, mut next_stamp))?
    match take built {
        Some(take root) => Ok(take root),
        None => Ok(std.page.empty(0, 0, Unprefixed)),
    }
}

type PagedLists: shareable + send {
    packs: Arc[std.page.Page],
    retired: Arc[std.page.Page]
}

type ListLayout: send {
    roots: PagedLists,
    run_packs: PackRun,
    removals: List[u64]
}

fn empty_cut_frames() -> CutFrames {
    CutFrames(emitted: map.new(), pages: list.new(), blobs: list.new())
}

fn retiring_list_packs(known: PageLocations, emission: CutFrames, mut retiring: Map[u64, ()]) {
    let mut moving: Map[u64, u64] = map.new()
    for item in emission.pages {
        let Some(location) = disk_index_get(known.frames, item.stamp) else {
            fail("store: missing planned list frame")
        }
        if location.place.pack != 0 {
            let width: u64 = int.widen(location.place.len)
            map.update_or_insert(mut moving, location.place.pack, 0, fn(mut total: u64) {
                total += width
            })
        }
    }
    let mut inventory = std.omap.range(known.packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut inventory) {
        if pack.class == 2 && pack.live == map.get_or(moving, seq, 0) {
            map.insert(mut retiring, seq, ())
        }
    }
}

fn plan_paged_lists(mut known: PageLocations, installed: PagedLists, carried: Option[View[List[u64]]], first_pack: u64, cap: u64, mut next_stamp: u64, issued: core.Log[u64], relocated: Option[View[core.Log[bool]]]) -> Result[ListLayout, Error] {
    let mut pack_root = arc.share(installed.packs)
    let private_from = next_stamp
    let data_retired = edit_pack_list(mut pack_root, known, private_from, mut next_stamp, issued)?
    change_list_root(mut known, installed.packs, pack_root, 0)?
    // The old retirement tree contributes no edges to the new generation.
    remove_page_source(mut known, std.page.stamp(std.page.image_of(installed.retired)), ListSource(1))?
    let moves = if let Some(observed) = relocated {
        let chosen = disk_allocation(scoped fn() -> Result[Map[u64, ()], Error] {
            Ok(relocation_ancestors(known, moved_frames(known, true)))
        })
        match take chosen {
            Ok(take marks) => {
                if map.len(marks) != 0 {
                    log.append(observed, true)
                }
                take marks
            },
            Error(Full(Allocation(_))) => map.new(),
            Error(take problem) => return Error(take problem),
        }
    } else {
        map.new()
    }
    let mut emission = empty_cut_frames()
    plan_tree_frames(known, moves, pack_root, mut emission)
    let Some(carried_files) = carried else {
        let pack_plan = layout_packs(page_frames(emission), 2, first_pack, cap)?
        apply_pack_layout(mut known, pack_plan)?
        let roots = PagedLists(packs: take pack_root, retired: std.page.empty(0, 0, Unprefixed))
        return Ok(ListLayout(roots: take roots, run_packs: take pack_plan, removals: take data_retired))
    }
    let mut retiring: Map[u64, ()] = map.new()
    for seq in data_retired {
        map.insert(mut retiring, seq, ())
    }
    for seq in carried_files {
        map.insert(mut retiring, seq, ())
    }
    retiring_list_packs(known, emission, mut retiring)
    let mut removals: List[u64] = list.with_capacity(map.len(retiring))
    for (seq, _) in retiring {
        list.push(mut removals, seq)
    }
    list.sort(mut removals, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    if list.len(removals) != 0 {
        let Some(span) = int.checked_mul(2, list.len(removals)) else {
            return Error(Limit(Ids))
        }
        let Some(end) = int.checked_add(next_stamp, span + 1) else {
            return Error(Limit(Ids))
        }
        log.append(issued, end)
    }
    let retired = build_retirement_list(removals, mut next_stamp)?
    record_fresh_tree(mut known, retired, 2)?
    add_page_source(mut known, std.page.stamp(std.page.image_of(retired)), ListSource(1))?
    plan_tree_frames(known, moves, retired, mut emission)
    let pack_plan = layout_packs(page_frames(emission), 2, first_pack, cap)?
    apply_pack_layout(mut known, pack_plan)?
    Ok(ListLayout(roots: PagedLists(packs: take pack_root, retired: take retired), run_packs: take pack_plan, removals: take removals))
}

type PageRetryBase: send {
    locations: PageLocations,
    account: u64
}

fn page_retry_base(installed: PageLocations, previous: Map[IncomingEdge, u64], holders: List[HeldPage], roots: List[PageRoots]) -> Result[PageRetryBase, Error] {
    disk_allocation(scoped fn() -> Result[PageRetryBase, Error] {
        let candidate = candidate_page_locations(installed, previous, holders)?
        let account = page_row_account(roots)
        Ok(PageRetryBase(locations: take candidate, account: account))
    })
}

type PagedCutLayout: send {
    locations: PageLocations,
    blobs: PackRun,
    data_pages: PackRun,
    lists: ListLayout
}

fn plan_page_cut(base: PageRetryBase, holders: List[HeldPage], installed: PagedLists, carried: Option[View[List[u64]]], first_pack: u64, cap: u64, marks: Map[u64, ()], relocated: Option[View[core.Log[bool]]], mut next_stamp: u64) -> Result[PagedCutLayout, Error] {
    let issued = disk_allocation(fn() -> Result[core.Log[u64], Error] {
        Ok(log.new())
    })?
    let first_stamp = next_stamp
    let proposed = disk_allocation(scoped fn() -> Result[PagedCutLayout, Error] {
        let mut emission = empty_cut_frames()
        for held in holders {
            plan_tree_frames(base.locations, marks, held.root, mut emission)
        }
        let blobs = layout_packs(blob_frames(emission), 1, first_pack, cap)?
        let data_pages = layout_packs(page_frames(emission), 0, blobs.next_pack, cap)?
        let mut candidate = share_page_locations(base.locations)
        apply_pack_layout(mut candidate, blobs)?
        apply_pack_layout(mut candidate, data_pages)?
        let mut draw = first_stamp
        let lists = plan_paged_lists(mut candidate, installed, carried, data_pages.next_pack, cap, mut draw, issued, relocated)?
        Ok(PagedCutLayout(locations: take candidate, blobs: take blobs, data_pages: take data_pages, lists: take lists))
    })
    let draws = log.finish(take issued)
    for end in draws {
        next_stamp = end
    }
    take proposed
}

fn write_page_cut(d: Dir, id: StoreId, take cut: PagedCutLayout, mut buffers: PackBuffers) -> Result[PagedCutLayout, Error] waits {
    let PagedCutLayout(locations: take locations, blobs: take blobs, data_pages: take data_pages, lists: take lists) = take cut
    let mut known = take locations
    write_pack_run(d, id, blobs, mut known, mut buffers)?
    write_pack_run(d, id, data_pages, mut known, mut buffers)?
    write_pack_run(d, id, lists.run_packs, mut known, mut buffers)?
    Ok(PagedCutLayout(locations: take known, blobs: take blobs, data_pages: take data_pages, lists: take lists))
}

fn prepare_page_cut[T](base: PageLocations, mut next_stamp: u64, attempt: scoped fn(Map[u64, ()], Option[View[core.Log[bool]]], mut u64) -> Result[T, Error] waits) -> Result[T, Error] waits {
    let selected = disk_allocation(scoped fn() -> Result[Map[u64, ()], Error] {
        Ok(relocation_ancestors(base, moved_frames(base, false)))
    })
    let marks = match take selected {
        Ok(take ready) => take ready,
        Error(Full(Allocation(_))) => map.new(),
        Error(take problem) => return Error(take problem),
    }
    let observer = disk_allocation(fn() -> Result[core.Log[bool], Error] {
        Ok(log.new())
    })
    if let Ok(take observed) = take observer {
        let first = attempt(marks, Some(view observed), mut next_stamp)
        let relocated = log.finish(take observed)
        match take first {
            Ok(take cut) => return Ok(take cut),
            Error(Full(Allocation(problem))) => {
                if map.len(marks) == 0 && list.len(relocated) == 0 {
                    return Error(Full(Allocation(problem)))
                }
            },
            Error(take problem) => return Error(take problem),
        }
    }
    let _ = take marks
    attempt(map.new(), None, mut next_stamp)
}

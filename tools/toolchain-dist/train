#!/usr/bin/env python3
"""Train an instrumented compiler on the retained native hello supplier.

    tools/toolchain-dist/train --toolchain DIR --work DIR --raw DIR

Each workload must exit normally and write a nonempty profile.
"""
import argparse
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[2]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--toolchain', type=Path, required=True)
    parser.add_argument('--work', type=Path, required=True)
    parser.add_argument('--raw', type=Path, required=True)
    parser.add_argument('--cpu', type=int, default=8)
    args = parser.parse_args()
    if args.cpu not in os.sched_getaffinity(0) or args.cpu in set(range(12, 16)) | set(range(28, 32)):
        parser.error('cpu must be available and outside the timing cores')
    work, raw = args.work.resolve(), args.raw.resolve()
    work.mkdir(parents=True, exist_ok=True)
    raw.mkdir(parents=True, exist_ok=True)
    if any(raw.glob('*.profraw')):
        parser.error('raw directory already contains profiles; use a fresh directory')
    compiler = str(args.toolchain.resolve() / 'hirsel')
    source = str(ROOT / 'native-tests/link/hello.hir')
    for name, command in [('check', ['check', source]),
                          *[(backend, ['build', '--backend', backend, source, '-o', str(work / backend)])
                            for backend in ('cranelift', 'llvm')]]:
        env = dict(os.environ, HIRSEL_DAEMON='off', HIRSEL_PROGRAM_CACHE='off', HIRSEL_RESULTS='none@1',
                   HIRSEL_JOBS='1', HIRSEL_PRODUCTS=str(args.toolchain.resolve() / 'hirsel-std.products'),
                   LLVM_PROFILE_FILE=str(raw / (name + '-%m-%p.profraw')))
        subprocess.run([str(ROOT / 'tools/capped'), 'taskset', '-c', str(args.cpu), compiler, *command],
                       cwd=ROOT, env=env, check=True)
        if not any(p.stat().st_size for p in raw.glob(name + '-*.profraw')):
            raise RuntimeError(f'no nonempty profile from {name}')
    print('train: 3 workloads passed', flush=True)


if __name__ == '__main__':
    main()

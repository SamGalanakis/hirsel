// L62: the attempt record in a task-local cell (§13.3 "The attempt record", v2.81).

// Settles and copies the attempt so a law can read it between touches.
fn tiered_attempt_state(attempt: core.Cell[TieredTouchSet]) -> TieredTouchSet {
    cell.with(attempt, (), tiered_attempt_state_entry)
}

fn tiered_attempt_state_entry(mut a: TieredTouchSet, take nothing: ()) -> TieredTouchSet {
    tiered_settle(mut a)
    clone(a)
}

// Runs one resolve of BLOB stamp 1 under a step bound, with the attempt
// outside the bound, and reads it back the way the driver does.
fn l62_bounded_resolve(visible: Map[TieredCacheKey, Arc[TieredFrame]], steps: u64) -> (TieredTouchSet, bool) {
    let target = l70_cache_target(1)
    let attempt = tiered_attempt(2097, 0)
    let ran = bound steps steps {
        let _ = tiered_resolve_cold(attempt, visible, target)
    }
    let finished = match ran {
        Ok(_) => true,
        Error(_) => false,
    }
    (tiered_finish(take attempt), finished)
}

// A step stop can land anywhere in a touch. Whatever it hits, the attempt is
// whole: the stamp is present iff its 1,049 bytes (8 + 1,025 + 16) are
// counted, a cold attempt is latched on stamp 1 iff it is touched, and the
// hit and the miss commit at the same step, since nothing miss-specific runs
// before the one assignment that installs the touch.
fn l62_stop_sweep() -> Result[(), Error] {
    let cold_pins: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    let mut warm_pins: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    map.insert(mut warm_pins, (7, 2120), l70_cache_frame(1))
    let mut saw_before = false
    let mut saw_after = false
    let mut steps = 0u64
    loop {
        let (cold, cold_done) = l62_bounded_resolve(cold_pins, steps)
        let (warm, warm_done) = l62_bounded_resolve(warm_pins, steps)
        let warm_touched = warm.touched_bytes == 1049
        let cold_touched = cold.touched_bytes == 1049
        if (!warm_touched && warm.touched_bytes != 0) || (!cold_touched && cold.touched_bytes != 0) ||
            map.contains(warm.stamps, 1) != warm_touched || map.contains(cold.stamps, 1) != cold_touched {
            fail("L62: a step stop tore a first touch")
        }
        if let Some(_) = warm.stopped {
            fail("L62: a hit within the partition latched a stop")
        }
        let cold_latched = match cold.stopped {
            Some(AttemptMiss(TieredBlob(demanded))) => demanded.stamp == 1,
            None => false,
            _ => fail("L62: a cold touch latched the wrong stop"),
        }
        if cold_latched != cold_touched {
            fail("L62: a miss latch and its touch diverged")
        }
        if cold_touched != warm_touched {
            fail("L62: the hit and the miss committed at different steps")
        }
        if warm_touched {
            saw_after = true
        } else {
            saw_before = true
        }
        if cold_done && warm_done {
            break
        }
        if steps == 100000 {
            fail("L62: a bounded resolve never finished")
        }
        steps += 1
    }
    if !saw_before || !saw_after {
        fail("L62: the sweep must stop both before and after the touch commits")
    }
    Ok(())
}

// §13.3 "Batched point misses": `fetch_many` demands every Cold row its keys
// miss in one fetch round, so the body reruns once, and it returns what
// `fetch` returns key by key. Values are 3 * key, so the rows are known
// without the store.
const FETCH_MANY_ROWS: u64 = 4096

fn fetch_many_fixture(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let Committed(_) = run(mut db, None, copy_env(rows), fn(mut tx: Tx, t: Table[u64, u64]) -> Result[(), Error] {
        for key in 0u64 .. FETCH_MANY_ROWS {
            put(mut tx, t, key, key * 3)?
        }
        Ok(())
    })? else {
        fail("fetch_many: the fixture puts commit")
    }
    cold_table(take db, rows.id)
}

// A BLOB-valued table: BLOB_ROWS rows whose value is BLOB_BYTES copies of
// the byte key % 251, past the 1,024-byte inline limit.
const BLOB_ROWS: u64 = 512
const BLOB_BYTES: u64 = 1500

fn blob_row_value(key: u64) -> Bytes {
    let mut v: Bytes = list.with_capacity(BLOB_BYTES)
    list.fill(mut v, BLOB_BYTES, int.truncate(key % 251))
    take v
}

fn blob_fixture(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let _ = law_table(mut db, "blobs", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "blobs", std.codec.key_u64(), std.codec.of_bytes())?
    for first in 0u64 .. BLOB_ROWS / 64 {
        let Committed(_) = run(mut db, None, (copy_env(rows), first), fn(mut tx: Tx, env: (Table[u64, Bytes], u64)) -> Result[(), Error] {
            for key in env.1 * 64 .. env.1 * 64 + 64 {
                put(mut tx, env.0, key, blob_row_value(key))?
            }
            Ok(())
        })? else {
            fail("blob fixture: the puts commit")
        }
    }
    cold_table(take db, rows.id)
}

// Makes the table Tiered and cuts, so every row is Cold after a reopen.
fn cold_table(take opened: Db, table_id: u32) -> Result[(), Error] waits {
    let mut db = take opened
    let id = prefix(table_id)?
    let mut tree = share_page_tree(db.heads[0u64].roots.collections)
    let (take root, take descriptor) = {
        let Some((here, before)) = std.page.collection_entry(tree.root, id) else {
            fail("cold table: the fixture has its table")
        }
        (arc.share(here), rooted_collection_record(here, before[52u64], 1)?)
    }
    let mut draw = stamp_after(db.next_node)?
    let first = draw
    page_result(std.page.insert(mut tree.root, id, descriptor, Some(arc.share(root)), tree.inline, first, mut draw))?
    page_result(std.page.install_tiered_root(mut tree.root, id, HotPage(take root), mut draw))?
    db.heads[0u64].roots.collections = take tree
    db.next_node = draw - 1
    let _ = checkpoint(mut db)?
    close(take db)
}

// Sixteen keys a leaf apart, an absent key and a repeat of the first.
fn fetch_many_keys() -> List[u64] {
    let mut keys: List[u64] = list.new()
    for i in 0u64 .. 16 {
        list.push(mut keys, i * (FETCH_MANY_ROWS / 16) + 7)
    }
    list.push(mut keys, FETCH_MANY_ROWS + 5)
    list.push(mut keys, 7)
    keys
}

fn fetch_many_expected(keys: List[u64]) -> List[Option[u64]] {
    let mut rows: List[Option[u64]] = list.new()
    for key in keys {
        list.push(mut rows, if key < FETCH_MANY_ROWS { Some(key * 3) } else { None })
    }
    rows
}

fn fetch_many_body(tx: Tx, env: (Table[u64, u64], bool)) -> Result[List[Option[u64]], Error] {
    let keys = fetch_many_keys()
    if env.1 {
        return fetch_many(tx, env.0, keys)
    }
    let mut rows: List[Option[u64]] = list.new()
    for key in keys {
        list.push(mut rows, fetch(tx, env.0, key)?)
    }
    Ok(rows)
}

// look's attempts, one serve between each: the attempts the body takes, the
// frames its deciding attempt touched and what it returned. With `prefetch`
// the attempts and demands are look's own; without it every attempt has
// window 0 and every demand reads no value, which is the oracle's read.
fn cold_look[E: inert, R](r: Reader, s: Snapshot, env: E, body: fn(Tx, E) -> R, prefetch: bool) -> Result[(u64, u64, R), Error] waits {
    let Some(pool) = view r.pool else { fail("cold look: the reader has a pool") }
    let partition = pool.grant.pin_bytes
    let root = TieredPinRoot(domain: s.open, branch: s.branch, generation: match s.roots.collections.paging {
        Some(inventory) => inventory.generation,
        None => 0,
    }, root_stamp: tree_stamp(s.roots.collections))
    let mut pins = empty_tiered_pins(root, partition)
    let mut pending: Option[(TieredTarget, Error)] = None
    let mut attempts = 0u64
    loop {
        attempts += 1
        let attempt = if prefetch {
            call_attempt(s.roots.collections.root, partition, tiered_window(pins))
        } else {
            Some(tiered_attempt(partition, 0))
        }
        let looked = look_attempt(s, Some(100000000), env, body, attempt, pins.frames)
        let Some(state) = call_attempt_finish(take attempt) else {
            fail("cold look: the snapshot is Tiered")
        }
        match state.stopped {
            None => {
                let Seen(take seen) = take looked else { fail("cold look: the look runs") }
                let Seen(value: take value, ..) = take seen
                return Ok((attempts, map.len(state.stamps), take value))
            },
            Some(AttemptMiss(_)) => {
                let SeekKey(sought) = view state.seek else { fail("cold look: a miss seeks its key") }
                let pager: Option[View[Sender[TieredPagerMessage]]] = Some(view pool.requests)
                let source = tx_page_source(pager, s.roots.collections)?
                serve_tiered_miss(source, root, state, sought, TieredPoint, Some(arc.share(pool.grant)), mut pins, mut pending)?
            },
            _ => fail("cold look: only misses stop the body"),
        }
    }
}

fn fetch_many_look(r: Reader, s: Snapshot, rows: Table[u64, u64], batched: bool) -> Result[(u64, List[Option[u64]]), Error] waits {
    let (attempts, _, take found) = cold_look(r, s, (copy_env(rows), batched), fetch_many_body, true)?
    Ok((attempts, found?))
}

@test
fn test_fetch_many_cold_keys_rerun_once(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    fetch_many_fixture(d, c, r, tasks, floor)?
    let expected = fetch_many_expected(fetch_many_keys())
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    let (single, one_by_one) = fetch_many_look(read_handle, s, rows, false)?
    drop(take s)
    let again = snapshot(db)
    let (batched, together) = fetch_many_look(read_handle, again, rows, true)?
    drop(take again)
    drop(take read_handle)
    if one_by_one != expected || together != one_by_one {
        fail("fetch_many: the rows are what fetch returns key by key")
    }
    // The sixteen keys sit in different Cold leaves, so fetch reruns for
    // more than one of them; fetch_many reruns once for all.
    if single < 3 || batched != 2 {
        fail("fetch_many: the Cold rows of one body cost one rerun")
    }
    // Staged edits in the same body: fetch_many still answers as fetch does.
    let Committed(done) = run(mut db, Some(100000000), copy_env(rows), fn(mut tx: Tx, t: Table[u64, u64]) -> Result[bool, Error] {
        put(mut tx, t, 7u64, 1u64)?
        let _ = delete(mut tx, t, FETCH_MANY_ROWS / 16 + 7)?
        put(mut tx, t, FETCH_MANY_ROWS + 5, 5u64)?
        let staged_many = fetch_many_body(tx, (copy_env(t), true))?
        let staged_each = fetch_many_body(tx, (copy_env(t), false))?
        let mut edited = fetch_many_expected(fetch_many_keys())
        edited[0u64] = Some(1)
        edited[1u64] = None
        edited[16u64] = Some(5)
        edited[17u64] = Some(1)
        Ok(staged_many == staged_each && staged_each == edited)
    })? else {
        fail("fetch_many: the staged call commits")
    }
    if !done.value {
        fail("fetch_many: staged rows answer fetch_many as they answer fetch")
    }
    close(take db)
}

// A forward scan of every row of the 4,096-row table: the count, the sum of
// the values and the sum of the keys.
fn scan_rows_body(tx: Tx, t: Table[u64, u64]) -> Result[(u64, u64, u64), Error] {
    let mut seen = (0u64, 0u64, 0u64)
    let mut rows = range(tx, t, Included(0u64), Excluded(FETCH_MANY_ROWS))?
    while let Some((k, v)) = next_in(tx, mut rows)? {
        seen = (seen.0 + 1, seen.1 + v, seen.2 + k)
    }
    Ok(seen)
}

/// bug: a scan in a Tx body (look, run, serve) is given window 0 and pays one rerun per Cold page.
/// oracle: hand-derived sums (values 3k over k < 4,096) and the same scan with window 0 and no value prefetch; the bound ceil(n/8) is the brief's.
@test
fn test_tx_scan_sibling_window(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    fetch_many_fixture(d, c, r, tasks, floor)?
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    let (plain, pages, take oracle) = cold_look(read_handle, s, copy_env(rows), scan_rows_body, false)?
    let (windowed, _, take scanned) = cold_look(read_handle, s, copy_env(rows), scan_rows_body, true)?
    drop(take s)
    drop(take read_handle)
    close(take db)?
    let n = FETCH_MANY_ROWS
    let expected = (n, 3 * (n * (n - 1) / 2), n * (n - 1) / 2)
    if oracle? != expected || scanned? != expected {
        fail("scan window: the scan returns every row")
    }
    // Without the window every Cold page is its own rerun.
    if plain < pages {
        fail("scan window: the oracle scan paid one attempt per page")
    }
    if windowed > (pages + 7) / 8 {
        fail("scan window: a cold forward scan of n pages takes at most ceil(n/8) attempts")
    }
    Ok(())
}

fn blob_keys() -> List[u64] {
    let mut keys: List[u64] = list.new()
    for i in 0u64 .. 16 {
        list.push(mut keys, i * (BLOB_ROWS / 16) + 5)
    }
    list.push(mut keys, BLOB_ROWS + 1)
    keys
}

fn blob_body(tx: Tx, env: (Table[u64, Bytes], bool)) -> Result[List[Option[Bytes]], Error] {
    if env.1 {
        return fetch_many(tx, env.0, blob_keys())
    }
    let mut found: List[Option[Bytes]] = list.new()
    for key in blob_keys() {
        list.push(mut found, fetch(tx, env.0, key)?)
    }
    Ok(found)
}

/// bug: a BLOB-valued row's leaf is demanded without its BLOB, so fetch_many over BLOB rows reruns twice.
/// oracle: hand-derived values (BLOB_BYTES copies of key % 251, None past the table) and per-key fetch without value prefetch.
@test
fn test_fetch_many_blob_values_rerun_once(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    blob_fixture(d, c, r, tasks, floor)?
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let rows = table(mut db, "blobs", std.codec.key_u64(), std.codec.of_bytes())?
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    let (_, _, take oracle) = cold_look(read_handle, s, (copy_env(rows), false), blob_body, false)?
    let (batched, _, take together) = cold_look(read_handle, s, (copy_env(rows), true), blob_body, true)?
    drop(take s)
    drop(take read_handle)
    close(take db)?
    let mut expected: List[Option[Bytes]] = list.new()
    for key in blob_keys() {
        list.push(mut expected, if key < BLOB_ROWS { Some(blob_row_value(key)) } else { None })
    }
    if oracle? != expected || together? != expected {
        fail("fetch_many blobs: the rows are the BLOB values")
    }
    if batched != 2 {
        fail("fetch_many blobs: BLOB-valued rows cost one rerun")
    }
    Ok(())
}

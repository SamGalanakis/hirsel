// Exact native units are named by the pinned archive head and its index.
fn restore_archive_bytes(mut sink: std.object.Client, path: String, reference: pages.HistoryRef, deadline: u64) -> Result[Bytes, Error] waits {
    restore_archive_bytes_read(std.object.opener(sink), path, reference, deadline)
}

fn restore_archive_bytes_read(sink: std.object.Opener, path: String, reference: pages.HistoryRef, deadline: u64) -> Result[Bytes, Error] waits {
    let (_, take raw) = restore_range_read(sink, path, 0, reference.len, deadline)?
    failure_result_from_rep(history.history_object_digest(path, reference, raw))?
    Ok(take raw)
}

fn restore_object_key(parent: StoreId, inc: Inline[u8, 16], lead: String, r: pages.HistoryRef) -> Result[String, Error] {
    let rel = failure_result_from_rep(history.history_read_key(lead, r))?
    Ok(format.archive_key(store_key_to_rep(parent), inc, rel))
}

fn restore_base_ref(row: format.ArchiveBaseRowRep) -> pages.HistoryRef {
    pages.HistoryRef(seq: row.base_ordinal, epoch: row.epoch, len: row.len, digest: row.digest)
}

fn restore_base_token(parent: StoreId, kind: u8, row: format.ArchiveBaseRowRep, binding_id: u64) -> RestoreToken {
    let boundary = format.RestoreBoundary(source_kind: kind, base_ordinal: row.base_ordinal, base_digest: row.digest, unit: row.first_unit, epoch: row.epoch, unit_digest: row.digest, frame_end: 0)
    RestoreToken(parent, binding_id, capture_attempt: [0; 16], boundary)
}

fn restore_archive_manifest(mut sink: std.object.Client, parent: StoreId, inc: Inline[u8, 16], kind: u8, row: format.ArchiveBaseRowRep, deadline: u64) -> Result[(manifest.PageManifest, history.HistoryActivation), Error] waits {
    restore_archive_manifest_read(std.object.opener(sink), parent, inc, kind, row, deadline)
}

fn restore_archive_manifest_read(sink: std.object.Opener, parent: StoreId, inc: Inline[u8, 16], kind: u8, row: format.ArchiveBaseRowRep, deadline: u64) -> Result[(manifest.PageManifest, history.HistoryActivation), Error] waits {
    let id = store_key_to_rep(parent)
    let reference = restore_base_ref(row)
    let (m, activation) = if kind == format.ARCHIVE_SOURCE_LOG {
        if row.len > manifest.PAGE_MANIFEST_FILE_LIMIT || row.epoch != 0 {
            return Error(failure_from_rep(format.disk_fault("archive-index", 72, Malformed)))
        }
        let key = format.archive_key(id, inc, format.archive_log_manifest_rel(row.base_ordinal, row.digest))
        let raw = restore_archive_bytes_read(sink, key, reference, deadline)?
        let (owner, take parsed) = failure_result_from_rep(manifest.disk_read_page_manifest(key, raw))?
        if owner != id || parsed.generation != row.base_ordinal {
            return Error(failure_from_rep(format.disk_fault(key, 0, Header)))
        }
        (take parsed, history.HistoryActivation(number: 0, binding: [0; 32]))
    } else {
        if row.len > 112 + 16 + 8213 + 16 + 1048576 {
            return Error(failure_from_rep(format.disk_fault("archive-index", 72, Malformed)))
        }
        let key = restore_object_key(parent, inc, "e-", reference)?
        let raw = restore_archive_bytes_read(sink, key, reference, deadline)?
        let mark = failure_result_from_rep(history.history_read_mark(key, id, reference, raw))?
        let mkey = restore_object_key(parent, inc, "m-", mark.manifest)?
        let bytes_in = restore_archive_bytes_read(sink, mkey, mark.manifest, deadline)?
        let parsed = failure_result_from_rep(history.history_decode_manifest(mkey, id, mark, reference.seq, take bytes_in))?
        (take parsed, mark.activation)
    }
    if m.first_live != row.first_unit || m.branches[0u64].version != row.main_version || m.branches[0u64].at != row.main_at || row.frontier.next_pack != m.next_pack || row.frontier.next_gen != int.saturating_add(m.generation, 1) {
        return Error(failure_from_rep(format.disk_fault("archive-index", 72, Malformed)))
    }
    Ok((take m, activation))
}

fn restore_range(mut sink: std.object.Client, key: String, lo: u64, hi: u64, deadline: u64) -> Result[(std.object.Meta, Bytes), Error] waits {
    restore_range_read(std.object.opener(sink), key, lo, hi, deadline)
}

fn restore_range_read(sink: std.object.Opener, key: String, lo: u64, hi: u64, deadline: u64) -> Result[(std.object.Meta, Bytes), Error] waits {
    let buf = failure_result_from_rep(manifest.disk_read_buffer(hi - lo))?
    let (take answer, take raw) = std.object.read_range(sink, std.object.GetRange(key: clone(key), lo, hi, buffer: take buf, deadline))
    let meta = (take answer) ?=> Remote
    if list.len(raw) != hi - lo || meta.size < hi {
        return Error(failure_from_rep(format.disk_fault(key, lo, Truncated)))
    }
    Ok((meta, take raw))
}

fn restore_entry_chain(mut sink: std.object.Client, parent: StoreId, inc: Inline[u8, 16], row: format.ArchiveBaseRowRep, end: pages.HistoryRef, deadline: u64) -> Result[List[history.HistoryLink], Error] waits {
    restore_entry_chain_read(std.object.opener(sink), parent, inc, row, end, deadline)
}

fn restore_entry_chain_read(sink: std.object.Opener, parent: StoreId, inc: Inline[u8, 16], row: format.ArchiveBaseRowRep, end: pages.HistoryRef, deadline: u64) -> Result[List[history.HistoryLink], Error] waits {
    let start = restore_base_ref(row)
    if end.seq < start.seq {
        return Error(failure_from_rep(format.disk_fault("archive-index", 72, Order)))
    }
    let mut suffix = failure_result_from_rep(history.history_link_slots(end.seq - start.seq))?
    let mut unit = end
    while unit.seq > start.seq {
        let key = restore_object_key(parent, inc, "e-", unit)?
        let (meta, take prefix) = restore_range_read(sink, key, 0, 112, deadline)?
        if meta.size != unit.len {
            return Error(failure_from_rep(format.disk_fault(key, 0, Truncated)))
        }
        let (_, prev) = failure_result_from_rep(history.history_entry_context(key, store_key_to_rep(parent), unit, prefix))?
        suffix[unit.seq - start.seq - 1] = history.HistoryLink(epoch: unit.epoch, len: unit.len, digest: unit.digest)
        unit = history.history_length(prev, unit.seq - 1)
    }
    if !history.history_ref_matches(unit, start) {
        return Error(failure_from_rep(format.disk_fault("archive-index", 72, Order)))
    }
    Ok(take suffix)
}

fn restore_read_entry[S](mut sink: std.object.Client, parent: StoreId, inc: Inline[u8, 16], unit: pages.HistoryRef, deadline: u64, mut state: S, visit: scoped fn(mut S, u16, u16, u64, Bytes) -> Result[(), Error] waits) -> Result[(), Error] waits {
    restore_read_entry_read(std.object.opener(sink), parent, inc, unit, deadline, mut state, visit)
}

fn restore_read_entry_read[S](sink: std.object.Opener, parent: StoreId, inc: Inline[u8, 16], unit: pages.HistoryRef, deadline: u64, mut state: S, visit: scoped fn(mut S, u16, u16, u64, Bytes) -> Result[(), Error] waits) -> Result[(), Error] waits {
    let key = restore_object_key(parent, inc, "e-", unit)?
    let (meta, take prefix) = restore_range_read(sink, key, 0, 112, deadline)?
    if meta.size != unit.len {
        return Error(failure_from_rep(format.disk_fault(key, 0, Truncated)))
    }
    let (ctx, _) = failure_result_from_rep(history.history_entry_context(key, store_key_to_rep(parent), unit, prefix))?
    let mut digest = std.check.start()
    std.check.add(mut digest, prefix, 0, 112)
    let mut pos = 112u64
    let mut substantive = false
    while pos < unit.len {
        if unit.len - pos < 16 {
            return Error(failure_from_rep(format.disk_fault(key, pos, Truncated)))
        }
        let (part, take hdr) = restore_range_read(sink, key, pos, pos + 16, deadline)?
        if part.etag != meta.etag {
            return Error(Lost)
        }
        let fh = failure_result_from_rep(manifest.disk_read_frame_head(key, hdr, pos))?
        if fh.size > unit.len - pos - 16 {
            return Error(failure_from_rep(format.disk_fault(key, pos, Truncated)))
        }
        let claim = fh.kind == 0x0040 && pos == 112
        if !claim {
            failure_result_from_rep(manifest.disk_check_frame_kind(key, ctx, fh.kind, fh.flags, pos))?
        }
        let frame_end = pos + 16 + fh.size
        let payload: Bytes = if fh.size == 0 {
            list.new()
        } else {
            let (chunk, take bytes_in) = restore_range_read(sink, key, pos + 16, frame_end, deadline)?
            if chunk.etag != meta.etag {
                return Error(Lost)
            }
            take bytes_in
        }
        if fh.checksum != failure_result_from_rep(types.capacity(format.disk_check(ctx, pos, hdr, payload)))? {
            return Error(failure_from_rep(format.disk_fault(key, pos, Checksum)))
        }
        std.check.add(mut digest, hdr, 0, 16)
        std.check.add(mut digest, payload, 0, fh.size)
        if claim {
            if fh.flags != 1 || frame_end != unit.len || fh.size != 24 || format.read_le(payload, 0, 8) != unit.epoch {
                return Error(failure_from_rep(format.disk_fault(key, pos, Malformed)))
            }
            substantive = true
            visit(mut state, fh.kind, fh.flags, frame_end, payload)?
        } else if format.journal_event_kind(fh.kind) {
            visit(mut state, fh.kind, fh.flags, frame_end, payload)?
            substantive = true
        } else if manifest.disk_kind_limit(fh.kind) != None {
            return Error(failure_from_rep(format.disk_fault(key, pos, Malformed)))
        } else {
            visit(mut state, fh.kind, fh.flags, frame_end, payload)?
        }
        pos = frame_end
    }
    if !substantive || std.check.finish(digest) != unit.digest {
        return Error(failure_from_rep(format.disk_fault(key, 112, Checksum)))
    }
    Ok(())
}

fn restore_archive_entries(mut sink: std.object.Client, parent: StoreId, inc: Inline[u8, 16], row: format.ArchiveBaseRowRep, end: pages.HistoryRef, mut walk: RestoreScan, deadline: u64) -> Result[(), Error] waits {
    let suffix = restore_entry_chain(mut sink, parent, inc, row, end, deadline)?
    for i in 0u64 .. list.len(suffix) {
        let unit = history.history_length(suffix[i], row.base_ordinal + i + 1)
        restore_read_entry(mut sink, parent, inc, unit, deadline, mut walk, scoped fn(mut scan_state: RestoreScan, kind: u16, flags: u16, frame_end: u64, payload: Bytes) -> Result[(), Error] {
            let mut token = scan_state.base
            token.boundary.unit = unit.seq
            token.boundary.epoch = unit.epoch
            token.boundary.unit_digest = unit.digest
            token.boundary.frame_end = frame_end
            if format.journal_event_kind(kind) {
                let key = restore_object_key(parent, inc, "e-", unit)?
                let ev = journal_decode(key, kind, payload)?
                restore_scan_event(mut scan_state, token, key, take ev)?
            } else {
                restore_note(mut scan_state, token, 0, false)
            }
            Ok(())
        })?
    }
    Ok(())
}

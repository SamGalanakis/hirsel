fn tiered_snapshot_row[K, V](attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], tree: pages.PageTree, decoder: RowDecoder[K, V], row_key: Bytes, raw: Bytes, remaining: Option[u64]) -> Result[Option[((K, V), u64)], Error] {
    let (take key, take owner) = decode_row_key(decoder, row_key, raw)?
    let keep = fn(observed: Bytes) -> Result[(), Error] {
        Ok(())
    }
    if let Some(primary) = view owner {
        let Some((edge, descriptor)) = std.page.collection_slot(tree.root, list.slice(primary, 0, 4)) else {
            return Error(Stale(decoder.table))
        }
        if pages.collection_descriptor(descriptor).residency == ResidentMemory {
            let Some(value) = pages.get_page_row(tree, primary) else {
                return Error(Stale(decoder.table))
            }
            return finish_row(decoder, take key, primary, value, remaining, keep)
        }
        let value = failure_result_from_rep(pager.tiered_snapshot_primary(attempt, visible, tree, edge, primary, decoder.table))?
        finish_row(decoder, take key, primary, value, remaining, keep)
    } else {
        finish_row(decoder, take key, row_key, raw, remaining, keep)
    }
}

fn read_tiered_scan[K, V](source: pager.TieredPageSource, grant: Arc[pager.TieredReaderGrant], root: pager.TieredPinRoot, tree: pages.PageTree, edge: std.page.Slot, descriptor: Bytes, collection: u32, take low: Bytes, take high: Bytes, reverse: bool, decoder: RowDecoder[K, V]) -> Result[Option[(Bytes, (K, V))], Error] waits {
    let (take start, take stop) = failure_result_from_rep(pager.tiered_scan_bounds(descriptor, collection, take low, take high))?
    if start >= stop {
        return Ok(None)
    }
    let overlay = match tree.replay {
        Some(replay) => std.omap.get(replay.collections, collection),
        None => None,
    }
    let hint = if reverse {
        view stop
    } else {
        view start
    }
    let direction: pager.TieredDirection = if reverse {
        TieredBackward
    } else {
        TieredForward
    }
    retry_tiered_read(source, grant, root, list.slice(hint, 4, list.len(hint)), None, direction, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[Option[(Bytes, (K, V))], Error] {
        pager.tiered_reading(attempt, if reverse {
            ValuesNone
        } else {
            ValuesFrom
        })
        let Some((take key, take raw)) = failure_result_from_rep(pager.tiered_scan_row(attempt, visible, edge, collection, overlay, start, stop, reverse))? else {
            return Ok(None)
        }
        let result = tiered_snapshot_row(attempt, visible, tree, decoder, key, raw, None)?
        let (take selected, _) = option.unwrap(take result)
        Ok(Some((take key, take selected)))
    })
}

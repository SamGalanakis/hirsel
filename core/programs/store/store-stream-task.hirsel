// The host stream's service task (STORE-SPEC §12.11.4, §12.11.6, §12.11.12):
// it drains the slots the doorbell names, packs their frames into one batch,
// runs the writer cycle, answers each Place, handles stalls/settles/rules
// (a)/(b)/(c)/(f) and runs the idle register and orphan-row head polls.
type StreamServiceInput: send {
    requests: std.object.Requests,
    clock: Clock,
    plan: StreamPlan,
    dir: String,
    authority_kind: u8,
    holder: StoreId,
    op_ms: u64,
    control: Receiver[ServiceControl],
    rings: Inbox[u32],
    reports: Inbox[SlotReport],
    ready: Sender[Result[(), Error]],
    tasks: Tasks,
    bell: Client[u32]
}

type StreamServiceEnd: send {
    requests: std.object.Requests,
    result: Result[(), Error]
}

// One attached Place on a slot: its (store, epoch), whether it was fenced,
// the `live.from_seq` established by its own Applied settles (every stalled
// batch strictly below it is already durable in a GROUP entry on `head`),
// and its answer client.
type SlotPlace {
    store: StoreId,
    epoch: u64,
    fenced: bool,
    settled_from: u64,
    answers: Client[SlotAck]
}

type ServiceSlot {
    inbox: Option[Inbox[SlotMsg]],
    place: Option[SlotPlace],
    held: Option[SlotMsg],
    unsent: Option[SlotAck]
}

// A stalled Place's outstanding tickets (§12.11.4): its slot, its (store,
// epoch), the batch seq carrying its frames, and the last ticket sequence
// among those frames (kept per batch seq for cutoff verdicts).
type StallTicket {
    slot: u64,
    store: StoreId,
    epoch: u64,
    batch_seq: u64,
    through: u64
}

// First-observation monotonic timestamp of a Held row (§12.11.6 rule a).
type ObservedRow {
    store: StoreId,
    epoch: u64,
    token: StoreId,
    first_seen_ns: u64
}

// An in-flight unhold settle requested from X's head task, pinned to the
// fixed token set observed before the settle was issued (§12.11.6 M1).
type ActiveSettle {
    id: u64,
    slot: u64,
    store: StoreId,
    epoch: u64,
    tokens: List[StoreId]
}

// Next stall head-poll deadline (`hold_ms / 4`) for a stalled Place.
type StallPoll {
    slot: u64,
    store: StoreId,
    epoch: u64,
    next_poll_ns: u64
}

// The service's alarm: it rings the service's own bell once at `at`.
type StreamTimer: send {
    c: Clock,
    at: u64,
    bell: Client[u32]
}

fn stream_timer(take job: StreamTimer) waits {
    let StreamTimer(c, at, bell: take bell) = take job
    host.sleep_until(c, at)
    let _ = conn.try_send(bell, STREAM_POLL_RING)
}

// One Place's frames in the batch being built: its slot, the last ticket
// sequence among them, and its slice.
type BatchEntry {
    slot: u64,
    through: u64,
    slice: BatchSlice
}

type StreamService {
    lane: StreamLane,
    client: std.object.Client,
    clock: Clock,
    plan: StreamPlan,
    op_ms: u64,
    slots: List[ServiceSlot],
    rings: Inbox[u32],
    reports: Inbox[SlotReport],
    control: Receiver[ServiceControl],
    // The slots of the created batch whose ack is undecided, with each
    // slice's last ticket sequence, in `lane.pending` order.
    waiting: List[(u64, u64)],
    tickets: List[StallTicket],
    prefixes: Map[StoreId, String],
    observed_rows: List[ObservedRow],
    active_settles: List[ActiveSettle],
    stall_polls: List[StallPoll],
    next_settle_id: u64,
    last_reg_ns: u64,
    tasks: Tasks,
    bell: Client[u32],
    timer: Option[Task[()]],
    poll_at: u64,
    gc: StreamGcState,
    janitor_asks: List[JanitorAsk]
}

fn stream_service_task(take input: StreamServiceInput) -> StreamServiceEnd waits {
    let StreamServiceInput(requests: take requests, clock, plan: take plan, dir: take dir, authority_kind, holder, op_ms, control: take control, rings: take rings, reports: take reports, ready: take ready, tasks, bell: take bell) = take input
    let mut client = std.object.attach(take requests, None)
    let slot_count: u64 = int.widen(plan.limits.max_slots)
    let rows = 2 * slot_count
    let built = stream_lane(plan.sid, authority_kind, rows, holder)
    let mut lane = match take built {
        Ok(take made) => take made,
        Error(take e) => {
            let _ = channel.send(ready, Error(clone(e)))
            return fail("stream service: its lane could not be built")
        },
    }
    lane.dir = stream_key(dir, stream_dir(plan.sid))
    let start_due = std.object.deadline_after_ms(client, op_ms)
    let started = stream_elect(mut lane, mut client, false, start_due)
    let fenced_term = match take started {
        Ok(term) => term,
        Error(problem) => {
            let _ = channel.send(ready, Error(clone(problem)))
            let (take returned, _) = std.object.split(take client)
            return StreamServiceEnd(requests: take returned, result: Error(clone(problem)))
        },
    }
    let now = host.mono_ns(clock)
    let mut prefixes: Map[StoreId, String] = map.new()
    let mut gc = stream_gc_new(lane.reg)
    if let Some(term) = fenced_term {
        let old_inc = lane.inc - 1
        if let Error(problem) = stream_gc_rebuild(mut gc, mut prefixes, mut client, lane, old_inc, term, now, std.object.deadline_after_ms(client, op_ms)) {
            let _ = channel.send(ready, Error(clone(problem)))
            let (take returned, _) = std.object.split(take client)
            return StreamServiceEnd(requests: take returned, result: Error(clone(problem)))
        }
    }
    let _ = channel.send(ready, Ok(()))
    let mut service = StreamService(lane: take lane, client: take client, clock, plan: take plan, op_ms, slots: list.new(), rings: take rings, reports: take reports, control: take control, waiting: list.new(), tickets: list.new(), prefixes: take prefixes, observed_rows: list.new(), active_settles: list.new(), stall_polls: list.new(), next_settle_id: 1, last_reg_ns: now, tasks, bell: take bell, timer: None, poll_at: 0, gc: take gc, janitor_asks: list.new())
    stream_service_arm_next(mut service)
    let result = stream_service_loop(mut service)
    if let Some(take running) = replace(mut service.timer, None) {
        let mut t = take running
        task.cancel(mut t)
        let _ = task.join(take t)
    }
    let StreamService(client: take back, ..) = take service
    let (take returned, _) = std.object.split(take back)
    StreamServiceEnd(requests: take returned, result: take result)
}

fn stream_service_loop(mut s: StreamService) -> Result[(), Error] waits {
    loop {
        match conn.receive(s.rings) {
            Ok(_) => (),
            Error(Closed) => return Ok(()),
            Error(Capacity(_)) => (),
        }
        if !stream_service_wake(mut s)? {
            return Ok(())
        }
    }
}

// One wake: control, reports, polls, then batches until no slot has a frame.
// False once the service is stopped.
fn stream_service_wake(mut s: StreamService) -> Result[bool, Error] waits {
    stream_drain_rings(s)
    if !stream_service_control(mut s)? {
        return Ok(false)
    }
    stream_flush_acks(mut s)
    stream_service_reports(mut s)?
    stream_service_poll(mut s)?
    loop {
        let mut batch: List[BatchEntry] = list.new()
        stream_gather(mut s, mut batch)?
        if list.len(batch) == 0 {
            stream_service_arm_next(mut s)
            return Ok(true)
        }
        if s.plan.batching.max_wait_ms != 0 {
            std.clock.sleep_ns(s.clock, int.saturating_mul(s.plan.batching.max_wait_ms, 1000000))
            stream_drain_rings(s)
            stream_gather(mut s, mut batch)?
        }
        stream_service_batch(mut s, take batch)?
        stream_service_reports(mut s)?
    }
}

fn stream_drain_rings(s: StreamService) {
    while let Ok(_) = conn.try_receive(s.rings) {}
}

fn stream_service_control(mut s: StreamService) -> Result[bool, Error] waits {
    loop {
        match channel.try_receive(s.control) {
            Ok(NewSlot(take answers)) => {
                let granted = stream_new_slot(mut s, false)
                let _ = channel.send(answers, take granted)
            },
            Ok(NewReservedSlot(take answers)) => {
                let granted = stream_new_slot(mut s, true)
                let _ = channel.send(answers, take granted)
            },
            Ok(JanitorPoll(take answers)) => {
                let drained = replace(mut s.janitor_asks, list.new())
                let _ = channel.send(answers, take drained)
            },
            Ok(StopService) => return Ok(false),
            Error(_) => return Ok(true),
        }
    }
}

// A free slot, or a new one while fewer than `max_slots` - 1 are given out
// (one is the janitor's, §12.11.8). Ordinary slots refuse `Full(Pins)` once
// active pins reach `max_pins` - 1; the reserved janitor slot uses the last
// slot and is never refused by `max_pins` (A5).
fn stream_new_slot(mut s: StreamService, reserved: bool) -> Result[(Client[SlotMsg], u32), Error] {
    if !reserved {
        let pins_limit: u64 = int.widen(s.plan.limits.max_pins)
        let max_ordinary_pins = pins_limit - 1
        if list.len(s.gc.pins) >= max_ordinary_pins {
            return Error(Full(Pins(Capacity(requested: 1, available: 0))))
        }
    }
    let mut free: Option[u64] = None
    for i in 0u64 .. list.len(s.slots) {
        if stream_slot_unused(s.slots[i]) {
            free = Some(i)
            break
        }
    }
    let slot_count: u64 = int.widen(s.plan.limits.max_slots)
    let limit = if reserved {
        slot_count
    } else {
        slot_count - 1
    }
    if free == None && list.len(s.slots) >= limit {
        for i in 0u64 .. list.len(s.slots) {
            if stream_slot_closed(mut s.slots[i]) {
                stream_reap_slot(mut s, i)
                free = Some(i)
                break
            }
        }
        if free == None {
            return Error(Full(Slots(Capacity(requested: 1, available: 0))))
        }
    }
    let made: Result[(Client[SlotMsg], Inbox[SlotMsg]), Capacity] = conn.new(STREAM_SLOT_CHUNKS, bytes s.plan.limits.slot_bytes)
    let (take data, take inbox) = capacity(take made)?
    let slot = ServiceSlot(inbox: Some(take inbox), place: None, held: None, unsent: None)
    if let Some(i) = free {
        stream_retire_slot_settles(mut s, i)
        let _ = replace(mut s.slots[i], take slot)
        return Ok((take data, int.narrow(i)))
    }
    capacity(list.try_reserve(mut s.slots, 1))?
    list.push(mut s.slots, take slot)
    Ok((take data, int.narrow(list.len(s.slots) - 1)))
}

fn stream_slot_unused(slot: ServiceSlot) -> bool {
    if let Some(_) = slot.inbox {
        return false
    }
    if let Some(_) = slot.held {
        return false
    }
    true
}

fn stream_slot_closed(mut slot: ServiceSlot) -> bool {
    if let Some(_) = slot.held {
        return false
    }
    let polled = match slot.inbox {
        Some(inbox) => conn.try_receive(inbox),
        None => return true,
    }
    match take polled {
        Ok(take queued) => {
            slot.held = Some(take queued)
            false
        },
        Error(Closed) => true,
        Error(_) => false,
    }
}

fn stream_retire_slot_settles(mut s: StreamService, slot: u64) {
    let mut i = 0u64
    while i < list.len(s.active_settles) {
        if s.active_settles[i].slot == slot {
            let _ = list.remove(mut s.active_settles, i)
        } else {
            i += 1
        }
    }
}

fn stream_reap_slot(mut s: StreamService, slot: u64) {
    stream_retire_slot_settles(mut s, slot)
    s.slots[slot].inbox = None
    s.slots[slot].place = None
    s.slots[slot].unsent = None
}

fn stream_discard_answer(mut s: StreamService, answer: SlotAck) {
    if let SlotSettle(id, _, _) = answer {
        let _ = stream_take_active_settle(mut s, id)
    }
}

// Acks never wait on a Place (§12.11.12): a full answer connection keeps
// the newest answer for the next wake. Only a discarded settle loses its id.
fn stream_answer(mut s: StreamService, slot: u64, take answer: SlotAck) {
    if let Some(old) = replace(mut s.slots[slot].unsent, None) {
        stream_discard_answer(mut s, old)
    }
    let sent = if let Some(place) = s.slots[slot].place {
        conn.try_send(place.answers, take answer)
    } else {
        Error(Closed(take answer))
    }
    match take sent {
        Ok(()) => (),
        Error(Full(take kept)) => {
            s.slots[slot].unsent = Some(take kept)
        },
        Error(Closed(discarded)) => stream_discard_answer(mut s, discarded),
    }
}

fn stream_flush_acks(mut s: StreamService) {
    for i in 0u64 .. list.len(s.slots) {
        if let Some(take answer) = replace(mut s.slots[i].unsent, None) {
            stream_answer(mut s, i, take answer)
        }
    }
}

// The bytes a batch of `batch` takes with one more frame of `width` for a
// Place not yet in it (`added`).
fn stream_batch_room(batch: List[BatchEntry], width: u64, added: bool) -> u64 {
    let mut rows = list.len(batch)
    if added {
        rows += 1
    }
    let mut total = stream_batch_overhead(rows) + width
    for e in batch {
        total += list.len(e.slice.octets)
    }
    total
}

fn stream_entry_of(batch: List[BatchEntry], slot: u64) -> Option[u64] {
    for i in 0u64 .. list.len(batch) {
        if batch[i].slot == slot {
            return Some(i)
        }
    }
    None
}

// Drains every slot into `batch` while the batch has room. A frame that
// does not fit stays held on its slot for the next batch, so a full slot
// blocks only its own Place.
fn stream_gather(mut s: StreamService, mut batch: List[BatchEntry]) -> Result[(), Error] waits {
    for i in 0u64 .. list.len(s.slots) {
        if let Some(place) = s.slots[i].place {
            if stream_is_latched(s.lane) || place.fenced || stream_stalled(s.lane, place.store, place.epoch) {
                continue
            }
        }
        loop {
            let message = match replace(mut s.slots[i].held, None) {
                Some(take kept) => take kept,
                None => {
                    let received = match s.slots[i].inbox {
                        Some(inbox) => conn.try_receive(inbox),
                        None => break,
                    }
                    match take received {
                        Ok(take message) => take message,
                        Error(Empty) => break,
                        Error(Capacity(_)) => break,
                        Error(Closed) => {
                            stream_reap_slot(mut s, i)
                            break
                        },
                    }
                },
            }
            match take message {
                SlotAttach(hi, lo, epoch, take place_prefix, take answers) => {
                    let store = StoreId(hi, lo)
                    let _ = map.try_reserve(mut s.prefixes, 1)
                    map.insert(mut s.prefixes, store, take place_prefix)
                    s.slots[i].place = Some(SlotPlace(store, epoch, fenced: false, settled_from: 0, answers: take answers))
                    let answer = match s.lane.latched {
                        Some(cause) => SlotLatched(cause),
                        None => SlotGranted(s.lane.inc, s.lane.seq),
                    }
                    stream_answer(mut s, i, take answer)
                },
                SlotFrame(width, sequence, take first) => {
                    let (owner, fence) = match s.slots[i].place {
                        Some(place) => (place.store, place.epoch),
                        None => fail("stream service: a frame on a slot with no attachment"),
                    }
                    let at = stream_entry_of(batch, i)
                    if at == None && stream_store_in(batch, owner) {
                        s.slots[i].held = Some(SlotFrame(width, sequence, take first))
                        break
                    }
                    let room = stream_batch_room(batch, width, match at {
                        Some(_) => false,
                        None => true,
                    })
                    if room > s.plan.batching.max_batch_bytes {
                        s.slots[i].held = Some(SlotFrame(width, sequence, take first))
                        break
                    }
                    let row = match at {
                        Some(found) => found,
                        None => {
                            capacity(list.try_reserve(mut batch, 1))?
                            list.push(mut batch, BatchEntry(slot: i, through: 0, slice: BatchSlice(store: owner, epoch: fence, frames: 0, octets: list.new())))
                            list.len(batch) - 1
                        },
                    }
                    stream_take_frame(mut s, i, mut batch[row], width, sequence, take first)?
                },
                SlotMore(_) => fail("stream service: a chunk with no frame"),
            }
        }
    }
    Ok(())
}

fn stream_store_in(batch: List[BatchEntry], store: StoreId) -> bool {
    for e in batch {
        if same(e.slice.store, store) {
            return true
        }
    }
    false
}

// Appends one frame, receiving its remaining chunks, and seals it in its
// slice under (X, ROLE_BATCH, batch seq) at its offset in the slice.
fn stream_take_frame(mut s: StreamService, i: u64, mut filling: BatchEntry, width: u64, sequence: u64, take first: Bytes) -> Result[(), Error] waits {
    let at = list.len(filling.slice.octets)
    capacity(list.try_reserve(mut filling.slice.octets, width + BINDING_BYTES))?
    list.append(mut filling.slice.octets, first)
    while list.len(filling.slice.octets) - at < width {
        let received = match s.slots[i].inbox {
            Some(inbox) => conn.receive(inbox),
            None => fail("stream service: a frame's slot closed"),
        }
        match take received {
            Ok(SlotMore(take piece)) => list.append(mut filling.slice.octets, piece),
            Ok(_) => fail("stream service: a frame cut short"),
            Error(_) => {
                list.truncate(mut filling.slice.octets, at)
                stream_reap_slot(mut s, i)
                return Ok(())
            },
        }
    }
    let kind: u16 = int.narrow(read_le(filling.slice.octets, at, 2))
    let ctx = DiskContext(store: filling.slice.store, role: ROLE_BATCH, seq: s.lane.seq)
    capacity(history_seal(mut filling.slice.octets, ctx, at, kind))?
    filling.slice.frames += 1
    filling.through = sequence
    Ok(())
}

// Runs the writer cycle on `batch` and answers each Place by the ack rule.
fn stream_service_batch(mut s: StreamService, take batch: List[BatchEntry]) -> Result[(), Error] waits {
    let mut ordered = take batch
    list.sort(mut ordered, scoped fn(a: BatchEntry, b: BatchEntry) -> Order {
        match order.compare(a.slice.store.hi, b.slice.store.hi) {
            Equal => order.compare(a.slice.store.lo, b.slice.store.lo),
            other => other,
        }
    })
    let mut slices: List[BatchSlice] = list.new()
    capacity(list.try_reserve(mut slices, list.len(ordered)))?
    capacity(list.try_reserve(mut s.waiting, list.len(ordered)))?
    for take e in take ordered {
        let BatchEntry(slot, through, slice: take slice) = take e
        list.push(mut s.waiting, (slot, through))
        list.push(mut slices, take slice)
    }
    let batch_inc = s.lane.inc
    let batch_seq = s.lane.seq
    let deadline = std.object.deadline_after_ms(s.client, s.op_ms)
    let mut outcome = stream_cycle(mut s.lane, mut s.client, slices, deadline)
    loop {
        match take outcome {
            Ok(take decided) => {
                s.last_reg_ns = host.mono_ns(s.clock)
                stream_gc_record_batch(mut s.gc, s.prefixes, batch_inc, batch_seq, slices, s.last_reg_ns)?
                s.gc.batches_since_checkpoint += 1
                stream_service_decided(mut s, decided)
                stream_process_reg(mut s, std.object.deadline_after_ms(s.client, s.op_ms))?
                if !stream_is_latched(s.lane) && s.gc.batches_since_checkpoint >= s.plan.limits.index_every {
                    stream_gc_checkpoint(mut s, std.object.deadline_after_ms(s.client, s.op_ms))?
                }
                return Ok(())
            },
            Error(take problem) => {
                if let Some(cause) = s.lane.latched {
                    stream_service_latched(mut s, cause)
                    return Ok(())
                }
                if list.len(s.lane.pending) == 0 {
                    return Error(take problem)
                }
            },
        }
        std.clock.sleep_ns(s.clock, int.saturating_mul(s.plan.limits.idle_poll_ms, 1000000))
        outcome = stream_decide_pending(mut s.lane, mut s.client, std.object.deadline_after_ms(s.client, s.op_ms))
    }
}

fn stream_service_decided(mut s: StreamService, decided: List[SliceDecision]) {
    let waiting = replace(mut s.waiting, list.new())
    for i in 0u64 .. list.len(decided) {
        if i >= list.len(waiting) {
            break
        }
        let (slot, through) = waiting[i]
        if decided[i].acked {
            stream_answer(mut s, slot, SlotAcked(through, decided[i].seq))
        } else {
            stream_ticket_stall(mut s, slot, decided[i].store, decided[i].epoch, decided[i].seq, through)
        }
    }
}

fn stream_ticket_stall(mut s: StreamService, slot: u64, store: StoreId, epoch: u64, batch_seq: u64, through: u64) {
    for i in 0u64 .. list.len(s.tickets) {
        if s.tickets[i].slot == slot && same(s.tickets[i].store, store) && s.tickets[i].epoch == epoch && s.tickets[i].batch_seq == batch_seq {
            s.tickets[i].through = order.max(s.tickets[i].through, through)
            return
        }
    }
    if let Error(_) = list.try_reserve(mut s.tickets, 1) {
        return
    }
    list.push(mut s.tickets, StallTicket(slot, store, epoch, batch_seq, through))
}

// Finds the active non-fenced slot serving (store, epoch).
fn stream_serving_slot(s: StreamService, store: StoreId, epoch: u64) -> Option[u64] {
    for i in 0u64 .. list.len(s.slots) {
        if let Some(place) = s.slots[i].place {
            if !place.fenced && same(place.store, store) && place.epoch == epoch {
                return Some(i)
            }
        }
    }
    None
}

{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "concurrently -n mock,vite -c yellow,cyan \"node tools/mock-server.mjs\" \"vite\"",
    "mock-server": "node tools/mock-server.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "e2e:threads": "node ../e2e/thread-smoke.mjs",
    "e2e:product-runbook": "node ../e2e/product-runbook.mjs",
    "dev:artifact-preview": "vite --config artifact-preview.config.ts",
    "e2e:artifacts": "node ../e2e/artifact-thread-smoke.mjs",
    "e2e:artifact-runtime": "node ../e2e/artifact-runtime-smoke.mjs",
    "e2e:svg-artifact": "node ../e2e/svg-artifact-preview-smoke.mjs",
    "e2e:artifact-presentation-recovery": "node ../e2e/artifact-presentation-recovery.mjs",
    "e2e:workspace-responsive": "node ../e2e/workspace-responsive.mjs"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@solidjs/babel-plugin": "2.0.0-rc.7",
    "@solidjs/web": "2.0.0-rc.7",
    "@tailwindcss/vite": "^4.3.1",
    "assert": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lowlight": "^3.3.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "remend": "^1.3.0",
    "solid-js": "2.0.0-rc.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.0-rc.7",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.40",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__standalone": "^7.1.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.27.4",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~5.9.3",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  }
}

// The contained run laws' program (docs/spec/foreign.md, "Contained laws").
// Each mode prints one line per observation; the driver's law compares them
// with the values the spec derives.
fn say(out: Stdout, text: String) waits {
    result.unwrap(stdout.write(out, text))
    result.unwrap(stdout.write(out, "\n"))
}

fn number(out: Stdout, label: String, n: u64) waits {
    let mut s = string.from(label)
    string.push_char(mut s, ' ')
    string.push_u64(mut s, n)
    say(out, s)
}

fn word(n: i32) -> u64 {
    let wide: i64 = int.widen(n)
    int.truncate(wide)
}

// The primary cause of an isolated call, as one line: "ok", the Fail text, or "other".
fn primary[R](take outcome: Result[Result[R, Causes], Capacity]) -> String {
    match take outcome {
        Ok(Ok(_)) => string.from("ok"),
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Fail(message) => string.from(message),
                    _ => string.from("other"),
                }
            }
            string.from("none")
        },
        Error(_) => string.from("capacity"),
    }
}

fn all(b: Bytes, value: u8) -> bool {
    for byte in b {
        if byte != value {
            return false
        }
    }
    true
}

fn zeros(n: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(n)
    list.fill(mut b, n, 0)
    b
}

fn make_cell(f: Foreign[laws.Box]) -> foreign.Ptr[laws.Cell] {
    match native.make(f) {
        Some(p) => p,
        None => fail("wasm_laws: pool exhausted"),
    }
}

resource type ObjBox {
    f: Foreign[laws.Box],
    p: foreign.Ptr[laws.Cell]
} drop(o) {
    let _ = native.free(o.f, o.p)
}

resource type FailBox {
    f: Foreign[laws.Box],
    p: foreign.Ptr[laws.Cell]
} drop(o) {
    fail("x")
}

// A handle held where an isolated body can reach it.
resource type Held {
    f: Foreign[laws.Box],
    p: foreign.Ptr[laws.Cell]
} drop(o) {}

fn obj_box(f: Foreign[laws.Box]) -> ObjBox {
    match ObjBox(f: f, p: make_cell(f)) {
        Ok(take o) => take o,
        Error(_) => fail("wasm_laws: no room for a box"),
    }
}

fn held(f: Foreign[laws.Box]) -> Held {
    match Held(f: f, p: make_cell(f)) {
        Ok(take o) => take o,
        Error(_) => fail("wasm_laws: no room for a holder"),
    }
}

// A resource whose finalizer reports whether its loan kept four zeros.
resource type Kept: send {
    d: Bytes,
    tx: Sender[bool]
} drop(o) {
    let _ = channel.try_send(o.tx, list.len(o.d) == 4 && all(o.d, 0))
}

fn fill_then_trap(take parts: (Foreign[laws.Box], Sender[bool])) -> u64 {
    let (f, take tx) = take parts
    let mut kept = match Kept(d: zeros(4), tx: take tx) {
        Ok(take k) => take k,
        Error(_) => fail("wasm_laws: no room for a loan"),
    }
    native.fill_trap(f, mut kept.d)
}

fn loans(f: Foreign[laws.Box], tasks: Tasks, out: Stdout) waits {
    number(out, "FW3 clock", word(native.clock(f)))
    let mut b: Bytes = list.with_capacity(16)
    list.fill(mut b, 4, 0)
    let filled = native.fill(f, mut b)
    number(out, "FW5 fill", filled)
    number(out, "FW5 len", list.len(b))
    number(out, "FW5 marked", if all(b, 0xABu8) {
        1
    } else {
        0
    })
    let mut c: Bytes = list.with_capacity(12)
    for i in 0u64 .. 12u64 {
        let byte: u8 = int.narrow(i)
        list.push(mut c, byte)
    }
    number(out, "FW5 sum", native.sum(f, list.slice(c, 4, 8)))
    let mut empty: Bytes = list.new()
    number(out, "FW5 empty", native.fill(f, mut empty))
    let (tx, rx): (Sender[bool], Receiver[bool]) = channel.new(1)
    let child = task.spawn(tasks, bytes 1048576, (f, take tx), fill_then_trap)
    match task.join(take child) {
        Error(Failed(causes)) => {
            for cause in causes {
                match cause.kind {
                    Fail(message) => say(out, message),
                    _ => say(out, "other"),
                }
                break
            }
        },
        _ => say(out, "not failed"),
    }
    match channel.receive(rx) {
        Ok(true) => say(out, "FW5 kept"),
        _ => say(out, "FW5 copied back"),
    }
    let nan = float.to_bits32(native.nan32(f))
    number(out, "FW11 nan32", int.widen(nan))
    number(out, "FW11 div", native.div_bits(f, 0.0, 0.0))
}

fn area(f: Foreign[laws.Box], out: Stdout) waits {
    let _ = native.set_area(f, 1)
    let b = zeros(16)
    say(out, primary(isolate(fn() -> u64 {
        native.sum(f, b)
    })))
    number(out, "FW6 count", native.count(f))
}

fn traps(f: Foreign[laws.Box], out: Stdout) waits {
    for k in 1u32 .. 11u32 {
        say(out, primary(isolate(fn() -> i32 {
            native.trap(f, k)
        })))
        number(out, "FW12 count", native.count(f))
    }
    say(out, primary(isolate(fn() -> u32 {
        native.recurse(f, 10000000)
    })))
    say(out, "FW16 after")
}

fn handles(f: Foreign[laws.Box], out: Stdout) waits {
    // FW13: a handle of a discarded instance, used twice.
    let h = held(f)
    say(out, primary(isolate(fn() -> i32 {
        native.trap(f, 1)
    })))
    say(out, primary(isolate(fn() -> i32 {
        native.free(h.f, h.p)
    })))
    say(out, primary(isolate(fn() -> i32 {
        native.free(h.f, h.p)
    })))
    // A box made before a trap and dropped after it.
    say(out, primary(isolate(fn() -> u64 {
        let boxed = obj_box(f)
        let _ = isolate(fn() -> i32 {
            native.trap(f, 1)
        })
        let _ = take boxed
        0
    })))
    number(out, "FW13 count", native.count(f))
    // FW26: a handle of the old generation beside a live one at its address.
    let old = held(f)
    let _ = isolate(fn() -> i32 {
        native.trap(f, 1)
    })
    let q = make_cell(f)
    say(out, primary(isolate(fn() -> i32 {
        native.free(old.f, old.p)
    })))
    number(out, "FW26 live", native.live(f))
    let _ = native.free(f, q)
}

fn counter(take f: Foreign[laws.Box]) -> u64 {
    let a = native.count(f)
    let b = native.count(f)
    let c = native.count(f)
    a * 100 + b * 10 + c
}

fn make_free(take f: Foreign[laws.Box]) -> u64 {
    let p = make_cell(f)
    word(native.free(f, p))
}

// FW31: an instance that leaves its slot dirty: its counter at 1 and 0xAB
// in pages 1 to 17 after growing 16 pages.
fn dirty(take f: Foreign[laws.Box]) -> u64 {
    let _ = native.count(f)
    let _ = native.grow(f, 16)
    int.widen(native.fill_mem(f, 1114112))
}

// FW31: the next instance, made in the slot `dirty` left, under its own
// grant: a fresh counter, zero bytes, its initial 2 pages, and room for one
// page more under the bound of its initial 131,104 bytes plus one page.
fn clean(take f: Foreign[laws.Box]) -> u64 {
    match (bound bytes 196640 {
        let entries = native.count(f)
        let byte: u64 = int.widen(native.fill_mem(f, 0))
        let pages = word(native.grow(f, 0))
        let one = word(native.grow(f, 1))
        let two = word(native.grow(f, 1) + 1)
        ((entries * 10 + byte) * 10 + pages) * 100 + one * 10 + two
    }) {
        Ok(n) => n,
        Error(_) => 1,
    }
}

fn per_task(f: Foreign[laws.Box], tasks: Tasks, out: Stdout) waits {
    let one = task.spawn(tasks, bytes 1048576, f, counter)
    let two = task.spawn(tasks, bytes 1048576, f, counter)
    number(out, "FW14 one", result.unwrap(task.join(take one)))
    number(out, "FW14 two", result.unwrap(task.join(take two)))
    let three = task.spawn(tasks, bytes 1048576, f, make_free)
    let four = task.spawn(tasks, bytes 1048576, f, make_free)
    number(out, "FW25 one", result.unwrap(task.join(take three)))
    number(out, "FW25 two", result.unwrap(task.join(take four)))
    let five = task.spawn(tasks, bytes 4194304, f, dirty)
    number(out, "FW31 dirty", result.unwrap(task.join(take five)))
    let six = task.spawn(tasks, bytes 1048576, f, clean)
    number(out, "FW31 clean", result.unwrap(task.join(take six)))
}

fn boxes(f: Foreign[laws.Box], out: Stdout) waits {
    let one = obj_box(f)
    let two = obj_box(f)
    number(out, "FW15 two", native.live(f))
    let _ = take one
    number(out, "FW15 dropped", native.live(f))
    let ObjBox(f: g, p: p) = take two
    let _ = native.free(g, p)
    number(out, "FW15 freed", native.live(f))
    say(out, primary(isolate(fn() -> u64 {
        let failing = match FailBox(f: f, p: make_cell(f)) {
            Ok(take o) => take o,
            Error(_) => fail("wasm_laws: no room for a box"),
        }
        let _ = take failing
        0
    })))
    number(out, "FW15 released", native.live(f))
}

fn faults(take parts: (Foreign[laws.Box], Stdout)) -> u64 waits {
    let (f, out) = take parts
    for _ in 0u64 .. 1000u64 {
        say(out, primary(isolate(fn() -> i32 {
            native.trap(f, 2)
        })))
    }
    0
}

fn deep(n: u64) -> u64 {
    if n == 0 {
        0
    } else {
        deep(n + 1) + 1
    }
}

fn dive(take n: u64) -> u64 {
    deep(n)
}

fn signals(f: Foreign[laws.Box], tasks: Tasks, out: Stdout) waits {
    let a = task.spawn(tasks, bytes 1048576, (f, out), faults)
    let b = task.spawn(tasks, bytes 1048576, 1u64, dive)
    let _ = task.join(take a)
    let _ = task.join(take b)
}

// One bounded call's result: "ok N" or "out N" for OutOfTime(steps: N).
fn stepped(out: Stdout, label: String, take r: Result[u64, OutOfTime]) waits {
    let mut s = string.from(label)
    match take r {
        Ok(n) => {
            string.push(mut s, " ok ")
            string.push_u64(mut s, n)
        },
        Error(o) => {
            string.push(mut s, " out ")
            string.push_u64(mut s, o.steps)
        },
    }
    say(out, s)
}

fn steps(f: Foreign[laws.Box], out: Stdout) waits {
    let _ = native.count(f)
    stepped(out, "FW7 spin 1e9", bound steps 1000 {
        native.spin(f, 1000000000)
    })
    stepped(out, "FW7 spin 10", bound steps 1000000 {
        native.spin(f, 10)
    })
    let _ = native.count(f)
    stepped(out, "FW21 straight", bound steps 2 {
        word(native.straight(f))
    })
    let _ = native.count(f)
    stepped(out, "FW21 straight_trap", bound steps 2 {
        word(native.straight_trap(f))
    })
    let _ = native.count(f)
    stepped(out, "FW21 straight 300", bound steps 300 {
        word(native.straight(f))
    })
    stepped(out, "FW23 fill 100", bound steps 100 {
        int.widen(native.fill_mem(f, 65536))
    })
    let _ = native.count(f)
    stepped(out, "FW23 fill 1e4", bound steps 10000 {
        int.widen(native.fill_mem(f, 65536))
    })
    // FW24: a handle made before the stop, used after it.
    let h = held(f)
    stepped(out, "FW24 spin", bound steps 1000 {
        native.spin(f, 1000000000)
    })
    number(out, "FW24 count", native.count(f))
    say(out, primary(isolate(fn() -> i32 {
        native.free(h.f, h.p)
    })))
}

// The smallest bound in [1, 2^20] at which `fits(n)` holds, which holds at 2^20.
fn least(f: Foreign[laws.Box], fits: fn(Foreign[laws.Box], u64) -> bool) -> u64 {
    let mut lo = 1u64
    let mut hi = 1048576u64
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if fits(f, mid) {
            hi = mid
        } else {
            lo = mid + 1
        }
    }
    lo
}

// Each attempt starts from a live instance, so no attempt pays an instantiation.
fn spin_fits(f: Foreign[laws.Box], n: u64) -> bool {
    let _ = native.count(f)
    match (bound steps n {
        native.spin(f, 10000)
    }) {
        Ok(_) => true,
        Error(_) => false,
    }
}

fn trap_fits(f: Foreign[laws.Box], n: u64) -> bool {
    let _ = native.count(f)
    match isolate(fn() -> Result[i32, OutOfTime] {
        bound steps n {
            native.trap(f, 7)
        }
    }) {
        Ok(Error(_)) => true,
        _ => false,
    }
}

fn div_fits(f: Foreign[laws.Box], n: u64) -> bool {
    let _ = native.count(f)
    match (bound steps n {
        let one = isolate(fn() -> i32 {
            native.loop_div(f, 100000)
        })
        let two = isolate(fn() -> i32 {
            native.loop_div(f, 100000)
        })
        primary(take one) != "ok" && primary(take two) != "ok"
    }) {
        Ok(both) => both,
        Error(_) => false,
    }
}

fn bisect(f: Foreign[laws.Box], out: Stdout) waits {
    number(out, "FW7 least", least(f, spin_fits))
    number(out, "FW8 least", least(f, trap_fits))
    number(out, "FW22 least", least(f, div_fits))
}

fn spinner(take f: Foreign[laws.Box]) -> u64 {
    match (bound steps 1000000000 {
        native.spin(f, 100000000)
    }) {
        Ok(n) => n,
        Error(_) => 0,
    }
}

fn printer(take out: Stdout) -> u64 waits {
    say(out, "FW9 B")
    0
}

fn slices(f: Foreign[laws.Box], tasks: Tasks, out: Stdout) waits {
    let a = task.spawn(tasks, bytes 1048576, f, spinner)
    let b = task.spawn(tasks, bytes 1048576, out, printer)
    let spun = result.unwrap(task.join(take a))
    number(out, "FW9 A", spun)
    let _ = task.join(take b)
}

fn reason(take outcome: Result[Result[u64, Causes], Capacity]) -> String {
    match take outcome {
        Ok(Ok(n)) => {
            let mut s = string.from("ok ")
            string.push_u64(mut s, n)
            s
        },
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(refused) => {
                        let mut s = string.from("capacity ")
                        string.push_u64(mut s, refused.requested)
                        s
                    },
                    Fail(message) => string.from(message),
                    _ => string.from("other"),
                }
            }
            string.from("none")
        },
        Error(_) => string.from("refused"),
    }
}

fn grower(take f: Foreign[laws.Box]) -> u64 {
    let _ = native.count(f)
    word(native.grow(f, 16))
}

fn bytes_law(f: Foreign[laws.Box], tasks: Tasks, out: Stdout) waits {
    // FW10: in a fresh instance, a refused grow then an admitted one.
    let _ = isolate(fn() -> i32 {
        native.trap(f, 1)
    })
    let _ = native.count(f)
    match (bound bytes 1048576 {
        (native.grow(f, 32), native.grow(f, 1))
    }) {
        Ok((big, one)) => {
            number(out, "FW10 big+1", word(big + 1))
            number(out, "FW10 one", word(one))
        },
        Error(_) => say(out, "FW10 bound refused"),
    }
    // A fresh instance's 131,104 bytes against 65,536.
    let _ = isolate(fn() -> i32 {
        native.trap(f, 1)
    })
    say(out, reason(isolate(fn() -> u64 {
        match (bound bytes 65536 {
            native.count(f)
        }) {
            Ok(n) => n,
            Error(_) => 7,
        }
    })))
    number(out, "FW10 count", native.count(f))
    // A child's 16 pages come back when it ends.
    match (bound bytes 4194304 {
        let child = task.spawn(tasks, bytes 2097152, f, grower)
        let old = result.unwrap(task.join(take child))
        match (bound bytes 4128768 {
            0u64
        }) {
            Ok(_) => old,
            Error(_) => 1000,
        }
    }) {
        Ok(n) => number(out, "FW10 child", n),
        Error(_) => say(out, "FW10 outer refused"),
    }
}

fn fuel(f: Foreign[laws.Box], out: Stdout) waits {
    say(out, primary(isolate(fn() -> i32 {
        native.tgrow(f, 8589934592)
    })))
    say(out, "FW29 after")
}

pub fn main(f: Foreign[laws.Box], tasks: Tasks, argv: Args, out: Stdout) -> Result[(), Exit] waits {
    let Some(mode) = args.get(argv, 0) else {
        return Error(Exit(status: 3))
    }
    if mode == "loans" {
        loans(f, tasks, out)
    } else if mode == "area" {
        area(f, out)
    } else if mode == "traps" {
        traps(f, out)
    } else if mode == "handles" {
        handles(f, out)
    } else if mode == "tasks" {
        per_task(f, tasks, out)
    } else if mode == "boxes" {
        boxes(f, out)
    } else if mode == "signals" {
        signals(f, tasks, out)
    } else if mode == "steps" {
        steps(f, out)
    } else if mode == "bisect" {
        bisect(f, out)
    } else if mode == "slices" {
        slices(f, tasks, out)
    } else if mode == "bytes" {
        bytes_law(f, tasks, out)
    } else if mode == "fuel" {
        fuel(f, out)
    } else {
        return Error(Exit(status: 3))
    }
    Ok(())
}

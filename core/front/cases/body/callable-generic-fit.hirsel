// LANG-13: a plain function fits a scoped callable of the same signature.
fn invoke[R](f: scoped[view] fn() -> R) -> R {
    f()
}

fn seven() -> u64 {
    7u64
}

pub fn case_minimal() -> u64 {
    let n = invoke(seven);
    n
}

// expect: run case_minimal() = 7
fn invoke_scoped[R](f: scoped fn() -> R) -> R {
    f()
}

pub fn case_minimal_scoped() -> u64 {
    let n = invoke_scoped(seven);
    n
}

fn invoke_take[R](take f: scoped[view] fn() -> R) -> R {
    f()
}

pub fn case_minimal_take() -> u64 {
    let n = invoke_take(seven);
    n
}

// expect: run case_minimal_scoped() = 7
// expect: run case_minimal_take() = 7
type Tx[T] {
    n: T,
    text: String
}

type Holder[F] {
    callback: F
}

fn fresh() -> Tx[u64] {
    let text = string.from("x");
    Tx(n: 5u64, text: text)
}

type Fnmut = fn(mut Tx[u64]) -> Result[u64, ()]

type Choicemut = Pickmut(Fnmut) | Emptymut

fn named_mut(mut x: Tx[u64]) -> Result[u64, ()] {
    x.n += 1u64;
    Ok(x.n)
}

fn generic_mut[T: plain](mut x: Tx[T]) -> Result[T, ()] {
    Ok(x.n)
}

fn apply_mut_plain[R](mut x: Tx[u64], callback: fn(mut Tx[u64]) -> Result[R, ()]) -> Result[R, ()] {
    callback(mut x)
}

pub fn case_named_mut_plain() -> u64 {
    let mut x = fresh()
    let answer = apply_mut_plain(mut x, named_mut)
    match answer {
        Ok(n) => n,
        Error(_) => 0u64
    }
}

// expect: run case_named_mut_plain() = 6
pub fn case_generic_mut_plain() -> u64 {
    let mut x = fresh()
    let answer = apply_mut_plain(mut x, generic_mut)
    match answer {
        Ok(n) => n,
        Error(_) => 0u64
    }
}

// expect: run case_generic_mut_plain() = 5
pub fn case_static_mut_plain() -> u64 {
    let mut x = fresh()
    let descriptor = code.describe(named_mut)
    let cb = code.callable(descriptor)
    let answer = apply_mut_plain(mut x, cb)
    match answer {
        Ok(n) => n,
        Error(_) => 0u64
    }
}

// expect: run case_static_mut_plain() = 6
pub fn case_record_mut_plain() -> u64 {
    let mut x = fresh()
    let holder = Holder(callback: named_mut)
    let answer = apply_mut_plain(mut x, holder.callback)
    match answer {
        Ok(n) => n,
        Error(_) => 0u64
    }
}

// expect: run case_record_mut_plain() = 6
pub fn case_variant_mut_plain() -> u64 {
    let mut x = fresh()
    let choice = Pickmut(named_mut)
    match choice {
        Pickmut(cb) => {
            let answer = apply_mut_plain(mut x, cb)
            match answer {
                Ok(n) => n,
                Error(_) => 0u64
            }
        },
        Emptymut => 0u64
    }
}

// expect: run case_variant_mut_plain() = 6

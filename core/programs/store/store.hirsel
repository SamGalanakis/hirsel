pub fn law_drop_recreate(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let old = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let saved = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, old, 1, 10) {
        return false
    }
    let held = snapshot(db)
    let sh = shape(saved)
    result.unwrap(drop_table(mut db, take old))
    match get(snapshot(db), sh, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    if db.resident != 0 || typed_value(held, sh, 1) != 10 {
        return false
    }
    result.unwrap(create_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let fresh = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if fresh.id != 2 {
        return false
    }
    // K2 / runner p17 step4a: the old H's Shape reads a recreated, empty
    // table. The result is Stale(1), never the old S1 result Ok(None).
    match get(snapshot(db), sh, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    let stale = run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, saved, 1, 99)
    })
    match take stale {
        Ok(Aborted(Undone(value: Stale(1), ticket: None))) => {},
        _ => return false
    }
    if typed_value(snapshot(db), shape(fresh), 1) != 0 || typed_value(held, sh, 1) != 10 {
        return false
    }
    if !typed_put(mut db, fresh, 1, 20) {
        return false
    }
    let second_saved = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let second_held = snapshot(db)
    let second_shape = shape(second_saved)
    result.unwrap(drop_table(mut db, take fresh))
    result.unwrap(create_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let third = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if third.id != 3 {
        return false
    }
    match get(snapshot(db), second_shape, 1) {
        Error(Stale(2)) => {},
        _ => return false
    }
    let stale_second = run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, second_saved, 1, 99)
    })
    match take stale_second {
        Ok(Aborted(Undone(value: Stale(2), ticket: None))) => {},
        _ => return false
    }
    typed_value(second_held, second_shape, 1) == 20 && typed_value(snapshot(db), shape(third), 1) == 0
}


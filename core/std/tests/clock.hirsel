// Contract tests for `clock` (core/std/clock.hirsel), written to run once an engine runs
// `host.sleep_until`. Each test takes `clock`, the run's granted Clock, and returns a
// scalar; the line `// expect: run f(clock) = R` above it gives the result derived by hand
// from the contract, or `fail Cause` for the failure the contract names.
// The deadline is the entry reading plus ns: the clock has moved by at least ns when it
// returns.
// expect: run waits_the_duration(clock) = true
fn waits_the_duration(c: Clock) -> bool waits {
    let before = host.mono_ns(c)
    clock.sleep_ns(c, 2_000_000)
    host.mono_ns(c) - before >= 2_000_000
}

// A deadline past 2^64 - 1 is refused before waiting, never wrapped into the past.
// expect: run overflowing_deadline(clock) = fail Overflow
fn overflowing_deadline(c: Clock) -> bool waits {
    clock.sleep_ns(c, int.wrapping_sub(0u64, 1))
    true
}

fn read_shared[S: shareable + send](read: fn(S) -> u64, take state: S) -> Result[u64, Capacity] {
    let shared = arc.new(take state)
    Ok(read(shared))
}

fn monotonic_read(c: Clock) -> u64 {
    host.mono_ns(c)
}

// A bare Clock satisfies both bounds and still designates the clock after sharing.
// expect: run bare_clock_shared_state(clock) = true
fn bare_clock_shared_state(c: Clock) -> bool waits {
    let deadline = host.mono_ns(c) + 2_000_000
    host.sleep_until(c, deadline)
    result.unwrap(read_shared(monotonic_read, c)) >= deadline
}

// Dropping a pending alarm leaves the inbox empty. Joining a second pending
// alarm after cancelling it returns its Cancelled cause. The last alarm wakes
// to a closed receiver and finishes before cancel_join consumes its handle.
// expect: run alarm_lifecycle(tasks) = true
fn alarm_lifecycle(tasks: Tasks) -> bool waits {
    let (c, h) = provide.clock(0, 0)
    let mut hand = take h
    let (to, from): (Sender[u64], Receiver[u64]) = channel.new(1)
    let first = clock.alarm(tasks, c, 10, to, 1)
    let pending = clock.idle(mut hand) == Some(10)
    let _ = take first
    clock.advance_to(mut hand, 10)
    let empty = match channel.try_receive(from) {
        Error(Empty) => true,
        _ => false,
    }
    let second = clock.alarm(tasks, c, 20, to, 2)
    let blocked = clock.idle(mut hand) == Some(20)
    let mut causes_seen = 0u64
    if let Error(Cancelled(causes)) = task.cancel_join(take second) {
        for cause in causes {
            if let Cancelled = cause.kind {
                causes_seen += 1
            }
        }
    }
    let third = clock.alarm(tasks, c, 30, to, 3)
    let waiting = clock.idle(mut hand) == Some(30)
    let _ = take from
    clock.advance_to(mut hand, 30)
    let settled = clock.idle(mut hand) == None
    let closed = match task.cancel_join(take third) {
        Ok(()) => true,
        Error(_) => false,
    }
    pending && empty && blocked && causes_seen == 1 && waiting && settled && closed
}

type BootDrive: send {
    clocks: sim.world.Clocks,
    tasks: Tasks
}

fn drive_boot_clocks(take input: BootDrive) waits {
    let BootDrive(clocks: take clocks, tasks) = take input
    sim.world.drive(take clocks, tasks)
}

// The node starts at 1000 ns and gains 1 ns per 4 ns elapsed. At t=150, it
// has been awake for 100 ns. At t=352 and t=353, it has been awake for 151
// and 152 ns. Only the boot clock counts the 201 ns pause and its drift.
// expect: run suspended_node_boot_clock(tasks) = true
fn suspended_node_boot_clock(tasks: Tasks) -> bool waits {
    let (take made, base) = sim.world.new(1, 0, 0)
    let mut world = take made
    let mut clocks = sim.world.clocks(mut world)
    let (index, node) = sim.world.drifting(mut clocks, 1000, 0, 250_000)
    sim.world.pause_at(mut clocks, index, 100, 301)
    let driver = task.spawn(tasks, bytes 65536, BootDrive(clocks: take clocks, tasks), drive_boot_clocks)
    host.sleep_until(base, 150)
    let during = host.mono_ns(node) == 1125 && clock.boot_ns(node) == 1187 && clock.boot_ns(base) == 150
    host.sleep_until(base, 352)
    let after = host.mono_ns(node) == 1188 && clock.boot_ns(node) == 1440
    host.sleep_until(base, 353)
    let next = host.mono_ns(node) == 1190 && clock.boot_ns(node) == 1441
    result.unwrap(task.join(take driver))
    during && after && next
}

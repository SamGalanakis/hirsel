    }
    let w: Simd[i16, 16] = simd.from(want)
    simd.bitmask(simd.eq(v, w)) == 65535
}

// SEM-11: list.set_lanes writes element at + i from lane i and leaves every other element
// and the length; it fails with Bounds exactly when at + 16 > len.
fn set_i16(at: u64) -> bool {
    let s = seq_i16()
    let p = pattern_i16(s)
    let mut xs = seq_i16()
    let v: Simd[i16, 16] = simd.from(p)
    list.set_lanes(mut xs, at, v)
    if at > 3u64 || list.len(xs) != 19u64 {
        return false
    }
    let mut ok = true
    for j in 0u64 .. 19u64 {
        let want = if j >= at && j < at + 16u64 { p[j - at] } else { s[j] }
        ok = ok && xs[j] == want
    }
    ok
}


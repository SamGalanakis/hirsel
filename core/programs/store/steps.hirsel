fn law_first(law: LawDb) -> triggers.Pending {
    option.unwrap(result.unwrap(triggers.next_pending(store.snapshot(law.db), law.triggers, fn(other: triggers.Id) -> bool { false })))
}

fn law_close(take law: LawDb) -> () waits {
    let LawDb(db: take db, ..) = take law
    result.unwrap(store.close(take db))
}

fn law_barrier_cut(d: Dir, c: Clock, r: Random, tasks: Tasks, phase: String, out: Stdout) -> bool waits {
    let mut law = law_open_at(d, c, r, tasks, phase == "init")
    if phase == "init" {
        let _ = law_signup(mut law)
        law_close(take law)
        return true
    }
    let id = triggers.pending_id(law_first(law))
    let a = law_attempt(mut law, id, string.as_bytes("r1"))
    if phase == "write" {
        let prior = store.version(store.snapshot(law.db))
        let request = TxRequest(index: 0u64, arg: result.unwrap(encode(1u64)))
        let ca: std.codec.Codec[TxRequest] = std.codec.of()
        let cr: std.codec.Codec[Reply] = std.codec.of()
        let wire_key = result.unwrap(runner.attempt_key(code.describe(signup.activate), ca, cr))
        let raw = result.unwrap(encode(request))
        let LawDb(db: take db, registered: take registered, triggers: take trigger_tables, ..) = take law
        result.unwrap(stdout.write(out, "ARM"))
        let (take after, at, take response) = runner.journal_attempt_gate(take db, take registered, trigger_tables, a, wire_key, raw)
        let _ = take after
        if let Error(Poisoned(Other(125))) = response {
            result.unwrap(stdout.write(out, "DONE"))
            return at == prior + 1u64
        }
        return false
    }
    // The sign-up activation was visible in the volatile head, but its failed
    // sync kept it outside the durable prefix. The resumed step has to run.
    if triggers.number(a) != 2u64 || result.unwrap(signup.active(law.db, 1u64)) { return false }
    let absent: Result[Option[Result[(), signup.WriteError]], store.Error] = recorded(law.db, StepId(run: id, index: 0u64))
    if let Ok(None) = absent {} else { return false }
    let replay = law_transaction(mut law, a, 0u64, code.describe(signup.activate), 1u64)
    let stored: Result[(), signup.WriteError] = law_replay(replay)
    if let Ok(()) = stored {} else { return false }
    let live = result.unwrap(signup.active(law.db, 1u64))
    law_close(take law)
    live
}

fn law_park_cut(d: Dir, c: Clock, r: Random, tasks: Tasks, phase: String, out: Stdout) -> bool waits {
    let mut law = law_open_at(d, c, r, tasks, phase == "init")
    if phase == "init" {
        let capped_run = law_enroll(mut law, 1u64)
        let first = law_attempt(mut law, capped_run, string.as_bytes("r1"))
        let _ = law_transaction(mut law, first, 0u64, code.describe(law_bump), 1u64)
        if let Capped = law_transaction(mut law, first, 1u64, code.describe(law_bump), 9u64) {} else { return false }
        if let Some(Cap) = result.unwrap(triggers.outcome(store.snapshot(law.db), law.triggers, capped_run)) {} else { return false }
        let park = law_enroll(mut law, 1u64)
        let a = law_attempt(mut law, park, string.as_bytes("r1"))
        let wake = store.next_call_info(law.db).at + 86400000u64
        let reply = law_transaction(mut law, a, 0u64, code.describe(law_park), wake)
        let child: Result[triggers.Id, LawError] = law_replay(reply)
        if result.unwrap(child) == park { return false }
        law_finish(mut law, a, Returned(list.new()))
        law_close(take law)
        return true
    }
    let pending = law_first(law)
    let id = triggers.pending_id(pending)
    let wake = triggers.due_time(pending)
    let snapshot = store.snapshot(law.db)
    let table = result.unwrap(store.with_schema(law.db, code.describe(law_table)))
    if result.unwrap(store.get(snapshot, store.shape(table), 0u64)) != Some(1u64) { return false }
    if result.unwrap(store.get(snapshot, store.shape(table), 1u64)) != Some(wake) { return false }
    if phase == "write" {
        let early = store.next_call_info(law.db).at < wake
        let trigger_tables = view law.triggers
        let tried = store.run(mut law.db, None, scoped fn(mut tx: store.Tx) -> Result[triggers.Started, triggers.Error] {
            triggers.start(mut tx, trigger_tables, pending, string.as_bytes("r1"))
        })
        let refused = match tried { Ok(Aborted(store.Undone(value: NotDue, ticket: None))) => true, _ => false }
        result.unwrap(stdout.write(out, "DONE"))
        return early && refused
    }
    if store.next_call_info(law.db).at != wake { return false }
    let awoken = law_attempt(mut law, id, string.as_bytes("r1"))
    if triggers.number(awoken) != 1u64 { return false }
    law_finish(mut law, awoken, Returned(list.new()))
    let remaining = result.unwrap(triggers.next_pending(store.snapshot(law.db), law.triggers, fn(other: triggers.Id) -> bool { false }))
    let once = match remaining { None => true, _ => false }
    law_close(take law)
    once
}

pub fn journal_steps_main(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, out: Stdout) -> Result[(), Exit] waits {
    let phase = option.unwrap(args.get(argv, 0u64))
    let scenario = option.unwrap(args.get(argv, 1u64))
    let passed = if scenario == "steps-park" { law_park_cut(d, c, r, tasks, phase, out) } else { law_barrier_cut(d, c, r, tasks, phase, out) }
    if passed { Ok(()) } else { Error(Exit(status: 1u8)) }
}

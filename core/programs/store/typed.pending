// S1 typed surface, written against STORE-SPEC v2 §1.2 and the pending S0
// std.codec signatures. This file is intentionally not selected until S0 lands;
// it is a surface contract, never a codec stub.

pub opaque type TypedTable[K, V]: send
pub opaque type TypedShape[K, V]
pub opaque type TypedIndex[J, K, V]

pub fn create_table[K, V](mut db: store.Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[store.Ticket, store.Error] waits
pub fn table[K, V](db: store.Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[TypedTable[K, V], store.Error]
pub fn shape[K, V](t: TypedTable[K, V]) -> TypedShape[K, V]
pub fn create_index[J, K, V](mut db: store.Db, take t: TypedTable[K, V], name: String,
    by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[store.Ticket, store.Error] waits
pub fn index[J, K, V](db: store.Db, take t: TypedTable[K, V], name: String,
    by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[TypedIndex[J, K, V], store.Error]
pub fn migrate[K, V, K2, V2](mut db: store.Db, take from: TypedTable[K, V], take key: std.codec.Key[K2], take value: std.codec.Codec[V2],
    f: fn(K, V) -> Result[Option[(K2, V2)], Capacity]) -> Result[store.Ticket, store.Error] waits

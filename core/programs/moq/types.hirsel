// Default MAX_REQUEST_UPDATES advertised in SETUP.
const DEFAULT_MAX_REQUEST_UPDATES: u64 = 16

// MOQ-5 urgencies.
pub const URGENCY_CONTROL: u8 = 0

pub const URGENCY_REQUEST: u8 = 1

pub const URGENCY_OBJECT: u8 = 2

// MOQ-1: scope from SETUP's AUTHORITY and the path-abempty of its PATH (before any '?').
pub fn default_scope(authority: Bytes, path: Bytes) -> Scope {
    let mut path_end = list.len(path)
    for i in 0u64 .. list.len(path) {
        if path[i] == 0x3f {
            path_end = i
            break
        }
    }
    let mut out: Bytes = list.with_capacity(list.len(authority) + path_end + 9)
    let _ = codec.write_vi64(list.len(authority), mut out)
    list.append(mut out, authority)
    list.append(mut out, list.slice(path, 0, path_end))
    Scope(take out)
}

/// Native QUIC TransportConfig for MoQ: ALPN `moqt-23`, QUIC DATAGRAM extension required
/// (moqt-23 §6.2), RESET_STREAM_AT enabled by quic, and bidirectional credit matching
/// `limits.requests` (MOQ-2).
pub fn transport_config(limits: Limits) -> quic.TransportConfig {
    let mut alpn: List[String] = list.with_capacity(1)
    list.push(mut alpn, ALPN)
    let reqs: u64 = order.max(int.widen(limits.requests), 1)
    let ctrl: u64 = order.max(int.widen(limits.control_bytes), codec.DEFAULT_MAX_CONTROL)
    let tracks: u64 = order.max(int.widen(limits.tracks), 1)
    let early: u64 = int.widen(limits.max_early_streams)
    let uni: u64 = 1 + tracks * 8 + early + 16
    let window: u64 = order.max(ctrl * 4, 262144)
    quic.TransportConfig(max_idle_ms: 30000, initial_max_data: window, initial_max_stream_data: order.max(ctrl * 2, 65536), max_streams_bidi: reqs, max_streams_uni: uni, max_datagram_frame: 65535, send_bytes: window, max_gaps: 32, cc: Cubic, alpn: take alpn, client_pins: None)
}

type SessionPhase: key = Connecting | AwaitingSetup | AwaitingAccept | Established | Ended

type ReqKind: key = ReqSubscribe | ReqPublish | ReqFetch | ReqTrackStatus | ReqPublishNamespace | ReqSubscribeNamespace | ReqSubscribeTracks

type ReqState: key = Pending | Active | Closing

/// One bidirectional request stream (MOQ-2).
type ReqStream {
    stream: LinkStream,
    id: u64,
    kind: ReqKind,
    local: bool,
    state: ReqState,
    track: Option[codec.TrackName],
    prefix: Option[codec.Namespace],
    alias: Option[u64],
    filter: codec.Filter,
    priority: u8,
    group_order: codec.Direction,
    paused: bool,
    sub_obj_timeout_ms: u64,
    sub_sg_timeout_ms: u64,
    pub_obj_timeout_ms: u64,
    pub_sg_timeout_ms: u64,
    default_pub_priority: u8,
    base_group: Option[u64],
    streams_sent: u64,
    pending_updates: u64,
    rx_buf: Bytes,
    rx_fin: bool,
    tx_fin: bool
}

/// Buffered bytes waiting for QUIC/WT stream credit.
type OutData = Raw(Bytes) | SharedChunk(quic.PayloadSlice)

type OutChunk {
    data: OutData,
    charge: u64
}

type Outgoing {
    stream: LinkStream,
    chunks: List[OutChunk],
    offset: u64,
    fin: bool,
    obj_deadline: Option[u64],
    reliable: u64,
    charge: u64
}

/// An incoming unidirectional stream whose StreamHeader has not yet arrived whole.
type UniHead {
    stream: LinkStream,
    buf: Bytes,
    fin: bool
}

/// An incoming data stream parked before its subscription/fetch is known (MOQ-4).
type EarlyStream {
    stream: LinkStream,
    header: codec.StreamHeader,
    buf: Bytes,
    fin: bool
}

/// An active incoming subgroup data stream.
type RxSubgroup {
    stream: LinkStream,
    header: codec.SubgroupHeader,
    track: codec.TrackName,
    default_priority: u8,
    prev_id: Option[u64],
    subgroup_id: Option[u64],
    buf: Bytes,
    fin: bool,
    pending_obj: Option[codec.SubgroupObject]
}

/// An active incoming fetch data stream.
type RxFetch {
    stream: LinkStream,
    request_id: u64,
    track: codec.TrackName,
    state: codec.FetchState,
    buf: Bytes,
    fin: bool,
    pending_obj: Option[codec.FetchObject],
    last_group: u64,
    last_object: u64,
    has_last: bool
}

/// An active outgoing subgroup stream on a publishing subscription.
type TxSubgroup {
    stream: LinkStream,
    req_id: u64,
    track: codec.TrackName,
    group: u64,
    subgroup: u64,
    header: codec.SubgroupHeader,
    header_len: u64,
    prev_id: Option[u64],
    fin_sent: bool,
    acked: bool,
    obj_timeout_ms: u64,
    sg_timeout_ms: u64,
    sg_deadline: Option[u64]
}

/// One seen object cached for MOQ-3 §12.1 malformed-track and duplicate checks.
type SeenObj {
    group: u64,
    id: u64,
    mode: Mode,
    subgroup: u64,
    priority: u8,
    status: codec.ObjectStatus,
    properties: Bytes,
    payload: quic.PayloadSlice,
    charge: u64
}

/// Subgroup metadata observed on a track for §12.1 #1, #2, #3.
type SubgroupMeta {
    group: u64,
    subgroup: u64,
    priority: u8,
    final_obj: Option[u64]
}

/// Per-track malformed-track state (MOQ-3 / moqt-23 §12.1).
type TrackGuard {
    track: codec.TrackName,
    malformed: bool,
    track_end: Option[codec.Location],
    group_ends: List[(u64, u64)],
    subgroups: List[SubgroupMeta],
    seen: List[SeenObj],
    non_existent: List[(codec.Location, codec.Location)],
    rx_past_header_bytes: u64
}

/// Track-level publisher metadata (largest object, datagram tag, delivery timeouts).
type PubTrack {
    track: codec.TrackName,
    tag: u64,
    largest: Option[codec.Location],
    obj_timeout_ms: u64,
    sg_timeout_ms: u64
}

pub opaque type Session {
    side: schedule.Side,
    role: Role,
    link: LinkId,
    address_mode: AddressMode,
    limits: Limits,
    phase: SessionPhase,
    scope: Option[Scope],
    setup_authority: Bytes,
    setup_path: Bytes,
    setup_token: Option[Bytes],
    setup_sent: bool,
    setup_received: bool,
    goaway_received: bool,
    goaway_sent: bool,
    peer_max_control: u64,
    peer_max_filter_ranges: u64,
    peer_max_request_updates: u64,
    local_control: Option[LinkStream],
    peer_control: Option[LinkStream],
    peer_control_buf: Bytes,
    next_req_id: u64,
    next_alias: u64,
    next_tag: u64,
    peer_watermark: u64,
    peer_seen_ids: std.set.Set[u64],
    peer_bidi_heads: List[UniHead],
    requests: List[ReqStream],
    uni_heads: List[UniHead],
    early_streams: List[EarlyStream],
    dropped_early_datagrams: u64,
    padding_streams: List[LinkStream],
    rx_subgroups: List[RxSubgroup],
    finished_rx_subgroups: List[(codec.TrackName, u64, u64)],
    rx_fetches: List[RxFetch],
    tx_subgroups: List[TxSubgroup],
    dead_subgroups: List[(u64, u64, u64)],
    pub_tracks: List[PubTrack],
    guards: List[TrackGuard],
    outgoing: List[Outgoing],
    outgoing_bytes: u64,
    seen_bytes: u64,
    timed_out_objects: u64,
    datagram_payload_copies: u64,
    timed_out_subgroups: u64,
    now: u64
}

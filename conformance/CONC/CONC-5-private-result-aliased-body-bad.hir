fn make() -> Result[Body[fn() -> Result[List[u64], ()]], String] {
  Ok(
    codegen.body(
      "fn() -> Result[List[u64], ()] { let xs: List[u64] = [1]; let alias = copy xs; Ok(take xs) }"
    )
  )
}

fn load() -> Result[List[u64], ()] = comptime make()

pub fn main(rt: Io) -> Result[(), ()] {
  let Ok(tasks) = io.tasks(rt) else {
    return Error(())
  }
  let xs = load()?
  let m = mutex.create(tasks, take xs)
  Ok(())
}

// RFC 4231, sections 4.2 through 4.8.
fn decode_hex(s: String) -> Bytes {
    option.unwrap(hex.decode(string.as_bytes(s)))
}

fn tag_prefix(tag: Inline[u8, 32], n: u64) -> Bytes {
    let mut out: Bytes = list.with_capacity(n)
    for i in 0u64 .. n {
        list.push(mut out, tag[i])
    }
    out
}

fn rfc_case(key: String, data: String, tag_hex: String) -> bool {
    let k = decode_hex(key)
    let d = decode_hex(data)
    let expected = decode_hex(tag_hex)
    let n = list.len(expected)
    let mut h = hmac.start(k)
    hmac.add_byte(mut h, d[0])
    let _ = hmac.finish(h)
    hmac.add(mut h, d, 1, list.len(d))
    let tag = hmac.finish(h)
    let streaming = tag_prefix(tag, n)
    let one_shot = tag_prefix(hmac.sha256(k, d), n)
    let mut wrong = tag
    wrong[n - 1] ^= 1
    hmac.equal(expected, streaming) && hmac.equal(expected, one_shot) && !hmac.equal(expected, list.slice(streaming, 1, n)) && !hmac.equal(expected, tag_prefix(wrong, n))
}

// expect: run rfc_4231_case_1() = true
fn rfc_4231_case_1() -> bool {
    rfc_case("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", "4869205468657265", "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
}

// expect: run rfc_4231_case_2() = true
fn rfc_4231_case_2() -> bool {
    rfc_case("4a656665", "7768617420646f2079612077616e7420666f72206e6f7468696e673f", "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
}


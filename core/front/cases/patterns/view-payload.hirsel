// A declared view payload remains a view, and a view of plain u64 reads as u64.
// View representation is A1's remaining gap; this case tests the typing contract.
// expect: gap values of this type are not built
fn text(v: View[String]) -> View[String] in v {
  let o: Option[View[String]] = Some(v)
  match o { Some(s) => s, None => v }
}
fn number(o: Option[View[u64]]) -> u64 {
  match o { Some(n) => n, None => 99 }
}

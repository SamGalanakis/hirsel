pkg_v1.Package(
    name: "hirsel.ai/fleet",
    version: "1.0.0",
    charge: ChargeV1,
    sources: [
        ("types.hirsel", "move_kernel"),
        ("origin_wire.hirsel", "move_kernel"),
        ("move_kernel.hirsel", "move_kernel"),
        ("advisory.hirsel", "advisory"),
        ("roster.hirsel", "roster"),
        ("roster_store.hirsel", "roster"),
        ("links.hirsel", "roster"),
        ("health.hirsel", "roster"),
        ("peer_rpc.hirsel", "roster"),
        ("directory.hirsel", "directory"),
        ("directory_place.hirsel", "directory"),
        ("live_move.hirsel", "live"),
        ("live_control.hirsel", "live"),
        ("scale_sim.hirsel", "scale_sim"),
        ("placement_sim.hirsel", "placement_sim"),
        ("fleet_sim_main.hirsel", "fleet_sim"),
    ],
    dependencies: [
        ("std", Toolchain(package: "std", major: 1, authority: [])),
        ("quic", Path(package: "quic", major: 1, path: "../quic", authority: [Net, Clock, Random, Secret])),
        ("compute", Path(package: "hirsel.ai/compute", major: 1, path: "../compute", authority: [])),
        ("store", Path(package: "store", major: 1, path: "../store", authority: [Dir, Clock, Random, Tasks])),
        ("runner", Path(
            package: "runner",
            major: 1,
            path: "../runner",
            authority: [Dir, Net, Clock, Random, Stderr, Process, Tasks, Args, Secret, Cred],
        )),
    ],
    tests: Some(Tests(
        sources: [
            ("register_model.hirsel", "register_model"),
            ("laws.hirsel", "laws"),
            ("sim_laws.hirsel", "laws"),
            ("directory_laws.hirsel", "laws"),
            ("roster_laws.hirsel", "laws"),
            ("cluster_laws.hirsel", "laws"),
            ("move_laws.hirsel", "laws"),
            ("scale_sim_laws.hirsel", "laws"),
        ],
        limit: 134217728,
        grants: [Clock, Random, Tasks],
        runs: [
            ("hirsel.ai/fleet@1/laws/sim_fleet_scale_1000_hosts", TestRun(limit: Some(536870912))),
            ("hirsel.ai/fleet@1/laws/sim_sm1_trace_export_ndjson_and_itf", TestRun(grant_change: Some(ReplaceNonDir([Stdout])))),
            ("hirsel.ai/fleet@1/laws/fleet_three_host_quic", TestRun(
                grant_change: Some(ReplaceNonDir([
                    Clock,
                    Random,
                    Stdout,
                    Net(UdpBind(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                    Net(UdpSend(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                ])),
            )),
            ("hirsel.ai/fleet@1/laws/fleet_live_move_keeps_committed_keys", TestRun(
                grant_change: Some(ReplaceNonDir([
                    Clock,
                    Random,
                    Stdout,
                    Net(UdpBind(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                    Net(UdpSend(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                ])),
            )),
            ("hirsel.ai/fleet@1/laws/fleet_stale_move_claims_change_nothing", TestRun(
                grant_change: Some(ReplaceNonDir([
                    Clock,
                    Random,
                    Stdout,
                    Net(UdpBind(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                    Net(UdpSend(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                ])),
            )),
            ("hirsel.ai/fleet@1/laws/fleet_drain_moves_every_place", TestRun(
                grant_change: Some(ReplaceNonDir([
                    Clock,
                    Random,
                    Stdout,
                    Net(UdpBind(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                    Net(UdpSend(cidr: "127.0.0.0/8", first_port: 0, last_port: 65535)),
                ])),
            )),
        ],
    )),
)

# Rust
target/
**/*.rs.bk

# Node / frontend (app/ has its own .gitignore too)
node_modules/
dist/
*.tsbuildinfo

# Runtime state & data
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Secrets & local config
.env
.env.*
*.local
!*.example

# Logs & scratch
*.log
tmp/
scratch/
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.playwright-cli/

# Android / Gradle
.gradle/
**/build/
local.properties
*.apk
*.aab
captures/
.cxx/
**/.externalNativeBuild/

# Firebase secrets — never commit
**/google-services.json
**/*service-account*.json
**/fcm-*service*.json
GoogleService-Info.plist

// rule: PROV-2
// expect: run
// stdout: stamps ordered
// A package defines its own branded ordered token: its constructions take the
// brand their declared result states, and stamps of one owner compare.
pub type Failed = Failed()

pub opaque type Stamp: copyable + plain + inert + ordered of uses {} { n: u64 }

fn stamp(book: String, n: u64) -> Stamp of book {
  Stamp(n: n)
}

fn pair(book: String) -> (Stamp of book, Stamp of book) {
  (Stamp(n: 1), Stamp(n: 2))
}

fn maybe(book: String) -> Option[Stamp of book] {
  Some(Stamp(n: 4))
}

fn checked(book: String, n: u64) -> Result[Stamp of book, Failed] {
  if n == 0 {
    return Error(Failed())
  }
  Ok(Stamp(n: n))
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let book = "ledger"
  let early = stamp(book, 3)
  let late = stamp(book, 9)
  let (first, second) = pair(book)
  let held: Stamp of book = Stamp(n: 9)
  let Some(middle) = maybe(book) else {
    return Error(Failed())
  }
  let Ok(last) = checked(book, 10) else {
    return Error(Failed())
  }
  if !(early < late && late == held && first < second && second < early
    && early < middle && middle < late && late < last) {
    return Error(Failed())
  }
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Failed())
  }
  match out.print(stdout, "stamps ordered\n") {
    Ok(_) => Ok(()),
    Error(_) => Error(Failed()),
  }
}

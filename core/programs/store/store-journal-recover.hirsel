type JournalInput {
    file: HostFile,
    size: u64,
    base: u64,
    chunk: Bytes,
    copy_to: Option[HostFile]
}

fn journal_input(take file: HostFile, flush: bool) -> Result[JournalInput, Error] waits {
    let mut opened = take file
    if flush {
        disk_io(host.sync(mut opened))?
    }
    let file_stat = disk_io(host.stat_file(mut opened))?
    let chunk = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(JOURNAL_CHUNK_BYTES))
    })?
    Ok(JournalInput(file: take opened, size: file_stat.size, base: 0, chunk: take chunk, copy_to: None))
}

fn journal_chunk(mut input: JournalInput, path: String, offset: u64) -> Result[u64, Error] waits {
    if offset >= input.base && offset - input.base < list.len(input.chunk) {
        return Ok(offset - input.base)
    }
    list.clear(mut input.chunk)
    if disk_io(host.read_at(mut input.file, offset, mut input.chunk))? == 0 {
        return Error(disk_fault(path, offset, Truncated))
    }
    // The pack envelope consumes the entire file in order. Copy each
    // refill once, using the same bytes that the checksum pass reads.
    if let Some(mut output) = input.copy_to {
        let width = order.min(list.len(input.chunk), input.size - offset)
        match host.write(mut output, list.slice(input.chunk, 0, width)) {
            Ok(()) => (),
            Error(problem) => return Error(Io(problem.error)),
        }
    }
    input.base = offset
    Ok(0u64)
}

type JournalRecovered {
    replay: JournalReplay,
    seq: u64,
    end: u64,
    uncovered: u64
}

fn journal_wait_shared(mut file: HostFile, c: Clock) -> Result[(), Error] waits {
    while !disk_io(host.try_lock_shared(mut file))? {
        std.clock.sleep_ns(c, 1000000)
    }
    Ok(())
}

// A live reader may stat before the writer extends the file and then read a
// newer END or successor. The boundary names bytes the writer synced, so the
// handle's current size covers it unless the file is damaged.
fn journal_refresh_size(mut input: JournalInput, boundary: Option[u64]) -> Result[(), Error] waits {
    if let Some(d) = boundary {
        if d > input.size {
            input.size = disk_io(host.stat_file(mut input.file))?.size
        }
    }
    Ok(())
}

fn journal_recover(d: Dir, id: StoreId, first: u64, c: Clock, take initial: JournalReplay) -> Result[JournalRecovered, Error] waits {
    let mut replay = take initial
    let mut seq = first
    let mut uncovered = 0u64
    loop {
        let path = journal_path(seq, "")?
        let mut file = match host.open(d, path, Read) {
            Ok(take handle) => take handle,
            Error(NotFound) => return Error(disk_fault(path, 0, Header)),
            Error(e) => return Error(Io(e))
        }
        journal_wait_shared(mut file, c)?
        let mut source = journal_input(take file, true)?
        let following = journal_following(d, id, seq, Some(c))?
        let boundary = match following {
            Some(h) => Some(h.prev_end),
            None => disk_end(d, id, seq)?
        }
        let final_item = match following {
            None => true,
            Some(_) => false
        }
        let scanned = journal_scan(mut source, path, id, seq, 72, boundary, final_item, mut replay, scoped fn(mut recovered_state: JournalReplay, take event: JournalEvent) -> Result[(), Error] {
            journal_apply(path, mut recovered_state, take event)
        })
        let JournalInput(file: take consumed_file, ..) = take source
        let mut consumed = take consumed_file
        disk_io(host.unlock(mut consumed))?
        disk_io(host.close(take consumed))?
        let (end, segment_bytes) = match take scanned {
            Ok(segment) => segment,
            Error(Corrupt(take fault)) => {
                // A bad last HEADER without a good END is an incomplete
                // segment creation. Valid headers with bad frames follow d.
                let no_end = match boundary {
                    None => true,
                    Some(_) => false
                }
                if final_item && no_end && seq == first {
                    if let Error(Corrupt(_)) = journal_header(d, id, seq, None) {
                        return Ok(JournalRecovered(replay: take replay, seq: seq - 1, end: 0, uncovered: uncovered))
                    }
                }
                return Error(Corrupt(take fault))
            },
            Error(take e) => return Error(take e)
        }
        uncovered = int.saturating_add(uncovered, segment_bytes)
        if let None = following {
            return Ok(JournalRecovered(replay: take replay, seq: seq, end: end, uncovered: uncovered))
        }
        seq += 1
    }
}

fn journal_decode_fork(file: String, raw: Bytes) -> Result[JournalFork, Error] {
    let mut at = 0u64
    let id: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let parent: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let forked_at = disk_number(file, raw, mut at, 8)?
    let name = disk_name(file, raw, mut at)?
    let watermark = disk_number(file, raw, mut at, 8)?
    if at != list.len(raw) || watermark == 0 {
        return Error(disk_fault(file, at, Malformed))
    }
    Ok(JournalFork(id: id, parent: parent, forked_at: forked_at, name: take name, watermark: watermark))
}

fn journal_apply_fork(file: String, mut replay: JournalReplay, take encoded: JournalFork) -> Result[(), Error] {
    let JournalFork(id: id, parent: parent, forked_at: forked_at, name: take name, watermark: watermark) = take encoded
    if id < replay.state.next_branch || id == 4294967295 || map.contains(replay.names, name) {
        return Error(disk_fault(file, 0, Malformed))
    }
    let (take roots, at, take key) = disk_allocation(scoped fn() -> Result[(Roots, u64, String), Error] {
        for source in replay.state.tips {
            if source.id != parent {
                continue
            }
            if source.head != forked_at {
                return Error(disk_fault(file, 0, Malformed))
            }
            let mut roots = share_roots(source.roots)
            if let Some(layer) = view source.roots.collections.replay {
                roots.collections.replay = Some(arc.new(ReplayBranch(collections: clone(layer.collections), fork_time: Some(clone(layer.collections)), ids: layer.ids, charged: layer.charged)))
            }
            return Ok((take roots, source.at, string.from(name)))
        }
        Error(disk_fault(file, 0, Malformed))
    })?
    let charge = branch_root_bytes(name, roots)
    if charge > replay.limits.meta - replay.record_bytes {
        return Error(disk_fault(file, 0, Malformed))
    }
    capacity(list.try_reserve(mut replay.state.tips, 1))?
    capacity(list.try_reserve(mut replay.forked, 1))?
    capacity(map.try_reserve(mut replay.names, 1))?
    map.insert(mut replay.names, take key, id)
    list.push(mut replay.state.tips, Tip(id: id, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: forked_at, at: at))
    replay.record_bytes += charge
    list.push(mut replay.forked, LineageFork(child: id, parent: parent, watermark: watermark, adopted: false))
    replay.state.next_branch = id + 1
    replay.next_node = order.max(replay.next_node, watermark - 1)
    replay.tiered.exact = false
    Ok(())
}

type CaptureSegment {
    file: HostFile,
    seq: u64,
    boundary: Option[u64]
}

type CaptureWalk {
    segments: List[CaptureSegment],
    end_image: Option[Bytes],
    torn_tail: bool
}

fn capture_end_image(d: Dir, seq: u64) -> Result[Option[Bytes], Error] waits {
    let path = journal_path(seq, ".end")?
    match disk_read_file(d, path, 96 + 1048576) {
        Ok(take raw) => Ok(Some(take raw)),
        Error(Io(NotFound)) => Ok(None),
        Error(Io(Other(5))) => Ok(None),
        Error(Corrupt(_)) => Ok(None),
        Error(take problem) => Error(take problem),
    }
}

fn capture_end(id: StoreId, seq: u64, raw: Option[Bytes]) -> Result[Option[u64], Error] {
    if let Some(image) = raw {
        let path = journal_path(seq, ".end")?
        match disk_read_end(path, id, seq, image) {
            Ok(at) => Ok(Some(at)),
            Error(Corrupt(_)) => Ok(None),
            Error(take problem) => Error(take problem),
        }
    } else {
        Ok(None)
    }
}

// Hold the descriptions walked so a cut cannot substitute a file between
// its checked HEADER or END and the scan. No fence is taken during the walk.
fn capture_walk(d: Dir, id: StoreId, first: u64, restarted: bool) -> Result[Option[CaptureWalk], Error] waits {
    let mut seen: List[CaptureSegment] = list.new()
    let mut terminal_image: Option[Bytes] = None
    let mut seq = first
    loop {
        let path = journal_path(seq, "")?
        let mut file = match host.open(d, path, Read) {
            Ok(take opened) => take opened,
            Error(NotFound) if seq != first => break,
            Error(NotFound) => return Error(disk_fault(path, 0, Header)),
            Error(problem) => return Error(Io(problem)),
        }
        let image = capture_end_image(d, seq)?
        let boundary_read = capture_end(id, seq, image)?
        let header_read = read_disk_bytes(mut file, path, 0, 72)
        let parsed_header = match take header_read {
            Ok(take head_bytes) => disk_read_header(path, head_bytes, 2, Some(seq), Some(id)),
            Error(take problem) => Error(take problem),
        }
        let header = match take parsed_header {
            Ok(found) => found,
            Error(Corrupt(take problem)) => {
                let successor = journal_path(seq + 1, "")?
                if disk_exists(d, successor)? {
                    if !restarted {
                        return Ok(None)
                    }
                    return Error(Corrupt(take problem))
                }
                if let Some(_) = boundary_read {
                    return Error(Corrupt(take problem))
                }
                break
            },
            Error(take problem) => return Error(take problem),
        }
        let segment_count = list.len(seen)
        if segment_count != 0 {
            seen[segment_count - 1].boundary = Some(header.prev_end)
        }
        list.push(mut seen, CaptureSegment(file: take file, seq: seq, boundary: boundary_read))
        terminal_image = take image
        seq += 1
    }
    Ok(Some(CaptureWalk(segments: take seen, end_image: take terminal_image, torn_tail: true)))
}

fn capture_lock_free(d: Dir) -> Result[bool, Error] waits {
    let mut probe = match host.open(d, "LOCK", Read) {
        Ok(take file) => take file,
        Error(NotFound) => return Ok(true),
        Error(problem) => return Error(Io(problem)),
    }
    let free = disk_io(host.try_lock_shared(mut probe))?
    if free {
        disk_io(host.unlock(mut probe))?
    }
    disk_io(host.close(take probe))?
    Ok(free)
}

fn capture_fence(d: Dir, c: Clock, deadline: u64, mut walk: CaptureWalk) -> Result[(), Error] waits {
    let segment_count = list.len(walk.segments)
    if segment_count == 0 {
        return Ok(())
    }
    loop {
        if disk_io(host.try_lock_shared(mut walk.segments[segment_count - 1].file))? {
            return Ok(())
        }
        if !capture_lock_free(d)? {
            walk.torn_tail = false
            return Ok(())
        }
        let now = host.mono_ns(c)
        if now >= deadline {
            return Error(Remote(Retriable(Deadline)))
        }
        host.sleep_until(c, order.min(deadline, int.saturating_add(now, 1000000)))
    }
}

fn capture_scan(id: StoreId, take walk: CaptureWalk, take initial: JournalReplay) -> Result[JournalReplay, Error] waits {
    let CaptureWalk(segments: take selected, torn_tail: torn_tail, ..) = take walk
    let mut segments = take selected
    let segment_count = list.len(segments)
    // Scan the oldest segment first and transfer each descriptor once.
    for i in 0u64 .. segment_count / 2 {
        list.swap(mut segments, i, segment_count - i - 1)
    }
    let mut replay = take initial
    while let Some(take segment) = list.pop(mut segments) {
        let CaptureSegment(file: take opened, seq: seq, boundary: stored_end) = take segment
        let tail = list.len(segments) == 0
        let torn = tail && torn_tail
        let boundary = if tail && !torn {
            Some(match stored_end {
                Some(end) => end,
                None => 72u64
            })
        } else {
            stored_end
        }
        let path = journal_path(seq, "")?
        let mut source = journal_input(take opened, torn)?
        journal_refresh_size(mut source, boundary)?
        let _ = journal_scan(mut source, path, id, seq, 72, boundary, torn, mut replay, scoped fn(mut recovered_state: JournalReplay, take event: JournalEvent) -> Result[(), Error] {
            journal_apply(path, mut recovered_state, take event)
        })?
        let JournalInput(file: take consumed, ..) = take source
        let mut file = take consumed
        if torn {
            disk_io(host.unlock(mut file))?
        }
        disk_io(host.close(take file))?
    }
    Ok(take replay)
}

fn journal_apply_commit(file: String, mut replay: JournalReplay, commit: JournalCommit) -> Result[(), Error] {
    // Section 3.4 step 6: the branch must exist, and the version is its head + 1.
    let total_count = list.len(replay.state.tips)
    let mut i = total_count
    for k in 0u64 .. total_count {
        if replay.state.tips[k].id == commit.branch {
            i = k
        }
    }
    if i == total_count || int.checked_add(replay.state.tips[i].head, 1) != Some(commit.version) {
        return Error(disk_fault(file, 0, Gap(commit.version)))
    }
    replay_within_limits(file, replay.limits, commit)?
    journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[i].roots.collections, commit.data, mut replay.tiered, replay.immutable)?
    journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[i].roots.streams, commit.streams, mut replay.tiered, replay.immutable)?
    if list.len(commit.keyed) != 0 {
        let before = keyed_root_record_bytes(replay.state.tips[i].roots.keyed)
        let mut draw = stamp_after(replay.next_node)?
        materialize_keyed_edits(mut replay.state.tips[i].roots, commit.keyed, 0, mut draw)?
        if !replay.immutable {
            canonical_roots(mut replay.state.tips[i].roots)?
        }
        replay.next_node = draw - 1
        replay.record_bytes = replay.record_bytes - before + keyed_root_record_bytes(replay.state.tips[i].roots.keyed)
        if replay.record_bytes > replay.limits.meta {
            return Error(disk_fault(file, 0, Malformed))
        }
    }
    replay.state.tips[i].head = commit.version
    replay.state.tips[i].at = commit.at
    Ok(())
}

fn journal_apply(file: String, mut replay: JournalReplay, take event: JournalEvent) -> Result[(), Error] {
    match take event {
        Commit(take commit) => journal_apply_commit(file, mut replay, commit),
        Fork(take encoded) => journal_apply_fork(file, mut replay, take encoded),
    }
}

// Replay settles the Memory union from the final roots. A put can make
// the head and a pin share a row version again, lowering that union.
fn journal_apply_ops(file: String, mut ids: u64, mut tree: PageTree, ops: List[JournalOp], mut account: ReplayTieredAccount, immutable: bool) -> Result[(), Error] {
    if list.len(ops) == 0 {
        return Ok(())
    }
    let mut next_stamp = stamp_after(ids)?
    let domain = tree_domain(tree)
    let mut processed = 0u64
    for slot in 0u64 .. list.len(ops) {
        if slot < processed {
            continue
        }
        let op = view ops[slot]
        if domain == CollectionMap {
            if list.len(op.key) < 4 {
                return Error(disk_fault(file, 0, Malformed))
            }
            let (kind, tiered_descriptor, row_count) = {
                let Some(descriptor) = std.page.lookup(tree.root, list.slice(op.key, 0, 4)) else {
                    return Error(disk_fault(file, 0, Malformed))
                }
                journal_collection_descriptor(descriptor)
            }
            if let Some(before) = tiered_descriptor {
                replay_tiered_op(file, mut tree, mut next_stamp, mut account, before, op)?
                continue
            }
            if let Some(trim) = op.trim {
                match trim_log_page(mut tree, op.key, trim.floor, Some(trim.dropped), 0, mut next_stamp) {
                    Ok(_) => (),
                    Error(Corrupt(_)) => return Error(disk_fault(file, 0, Malformed)),
                    Error(take problem) => return Error(take problem),
                }
                continue
            }
            if kind == LogCollection {
                let Some(value) = view op.value else {
                    return Error(disk_fault(file, 0, Malformed))
                }
                if list.len(op.key) != 12 || op.prior != 0 || list.len(value) < 2 {
                    return Error(disk_fault(file, 0, Malformed))
                }
                let seq: u64 = list.word_be(op.key, 4)
                let id: u32 = list.word_be(op.key, 0)
                let limits = committed_log_bounds(tree, id)?
                if seq != limits.next || seq == 18446744073709551615u64 {
                    return Error(disk_fault(file, 0, Malformed))
                }
                apply_log_append(mut tree, op.key, value, None, 0, mut next_stamp)?
                continue
            }
            if kind == TableCollection || kind == IndexCollection {
                processed = journal_sorted_run(ops, slot)
                if processed > slot + 1 {
                    if immutable && row_count == 0 {
                        journal_collection_bulk(file, mut tree, kind, ops, slot, processed, mut next_stamp)?
                        continue
                    }
                    journal_collection_batch(file, mut tree, ops, slot, processed, mut next_stamp)?
                    continue
                }
            }
            if op.prior != stored_prior(get_page_row(tree, op.key)) {
                return Error(disk_fault(file, 0, Malformed))
            }
            if kind == CellCollection {
                if list.len(op.key) != 4 {
                    return Error(disk_fault(file, 0, Malformed))
                }
                let raw = match op.value {
                    Some(stored) => Some(view stored),
                    None => None
                }
                if let Some(stored) = raw {
                    if list.len(stored) < 2 {
                        return Error(disk_fault(file, 0, Malformed))
                    }
                }
                apply_cell(mut tree, op.key, raw, None, 0, mut next_stamp)?
                continue
            }
        } else if let Some(_) = op.trim {
            return Error(disk_fault(file, 0, Malformed))
        }
        match op.value {
            Some(value) => put_page_row(mut tree, op.key, value, 0, mut next_stamp)?,
            None => {
                let _ = remove_page_row(mut tree, op.key, 0, mut next_stamp)?
            },
        }
    }
    if !immutable {
        canonical_tree(mut tree)?
    }
    ids = next_stamp - 1
    Ok(())
}

fn journal_sorted_run(ops: List[JournalOp], start: u64) -> u64 {
    let collection = list.slice(ops[start].key, 0, 4)
    let mut end = start + 1
    while end < list.len(ops) {
        let op = view ops[end]
        if let Some(_) = op.trim {
            break
        }
        if list.len(op.key) < 4 || list.slice(op.key, 0, 4) != collection || list.compare_bytes(ops[end - 1].key, op.key) != Less {
            break
        }
        end += 1
    }
    end
}

fn journal_collection_batch(file: String, mut tree: PageTree, ops: List[JournalOp], start: u64, end: u64, mut draw: u64) -> Result[(), Error] {
    let Some(empty_root) = view tree.empty_collection else {
        fail("store: missing empty collection page")
    }
    let inline = tree.inline
    let collection = list.slice(ops[start].key, 0, 4)
    let replayed = std.page.edit_collection(mut tree.root, collection, 0, mut draw, scoped fn(mut root: Arc[std.page.Page], mut stamps: u64) -> Result[(), std.page.Error] {
        std.page.apply_sorted_source(mut root, ops, visit_journal_edit, start, end, inline, mut stamps)?
        if std.page.count(std.page.image_of(root)) == 0 {
            root = arc.share(empty_root)
        }
        Ok(())
    })
    match replayed {
        Ok(()) => Ok(()),
        Error(MalformedPage) => Error(disk_fault(file, 0, Malformed)),
        Error(problem) => Error(page_error(problem)),
    }
}

fn visit_journal_edit(ops: List[JournalOp], slot: u64, visit: scoped fn(std.page.SourceEdit) -> Result[(), std.page.Error]) -> Result[(), std.page.Error] {
    let op = view ops[slot]
    let value: Option[(View[Bytes], Option[View[Arc[Bytes]]])] = match view op.value {
        Some(raw) => Some((raw, None)),
        None => None,
    }
    visit(std.page.SourceEdit(key: list.slice(op.key, 4, list.len(op.key)), value: value, prior: Some(op.prior)))
}

fn journal_collection_bulk(file: String, mut tree: PageTree, kind: std.page_descriptor.CollectionKind, ops: List[JournalOp], start: u64, end: u64, mut draw: u64) -> Result[(), Error] {
    let mut has_put = false
    for slot in start .. end {
        let op = view ops[slot]
        if op.prior != 0 {
            return Error(disk_fault(file, 0, Malformed))
        }
        if let Some(_) = view op.value {
            has_put = true
        }
    }
    if !has_put {
        return Ok(())
    }
    let bulk = page_result(std.page.bulk_source(ops, visit_journal_put, start, end, Collection, tree.inline, mut draw))?
    put_collection(mut tree, list.slice(ops[start].key, 0, 4), bulk, descriptor_kind_byte(kind), 0, mut draw)
}

fn visit_journal_put(ops: List[JournalOp], slot: u64, visit: scoped fn(std.page.BulkRow) -> Result[(), std.page.Error]) -> Result[(), std.page.Error] {
    let op = view ops[slot]
    if let Some(raw) = view op.value {
        return visit(std.page.BulkRow(key: list.slice(op.key, 4, list.len(op.key)), value: raw, charge: entry(op.key, raw)))
    }
    Ok(())
}

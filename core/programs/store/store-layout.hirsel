// AP3 in memory: every page a commit or a cut left loose takes its canonical
// image, the one a load of that state builds.
fn canonical_roots(mut roots: Roots) -> Result[(), Error] {
    page_result(std.page.canonicalize(mut roots.collections.root))?
    page_result(std.page.canonicalize(mut roots.streams.root))?
    page_result(std.page.canonicalize(mut roots.catalog.root))
}

fn canonical_tree(mut tree: PageTree) -> Result[(), Error] {
    page_result(std.page.canonicalize(mut tree.root))
}

// Runner laws (admission-laws L33) break the frame handoff with this.
// It disconnects the writer after the runner has admitted a position.
pub fn fixture_broken_handoff(mut db: Db) {
    let (to, abandoned): (Sender[JournalMsg], Receiver[JournalMsg]) = channel.new(1)
    let mut disconnected = Some(take abandoned)
    disconnected = None
    db.journal = Some(take to)
}

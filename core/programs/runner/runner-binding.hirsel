// One bind's job: the binding, a G the bind mint made for this bind alone, and the
// credential. The G is dropped when the binding's task ends (RUNNER-SPEC v2.70 F4).
type BindingJob[G: send]: send {
    grant: G,
    bind: Binder[G],
    credential: Bytes,
    steps: u64
}

// A bind before its mint: the bind mint's inbox and the rest of the job.
type BindAsk[G: send]: send {
    to: Sender[MintRequest[(), G]],
    bind: Binder[G],
    credential: Bytes,
    steps: u64,
    allowance: u64
}

fn bind_ask[G: send](supplied: Option[BindGrant[G]], take credential: Option[Bytes]) -> Option[BindAsk[G]] {
    let Some(b) = view supplied else {
        return None
    }
    let raw = match take credential {
        Some(take bytes_in) => take bytes_in,
        None => list.new()
    }
    Some(BindAsk(to: channel.sender(b.to), bind: b.wire.bind, credential: take raw, steps: b.wire.bind_steps, allowance: b.wire.bind_bytes))
}

// The bind mint's G for this bind, and the job that owns it. A failed mint is
// not a credential failure, and the binding does not run (RUNNER-SPEC v2.70 F5).
fn minted_binding[G: send](take ask: BindAsk[G]) -> Result[(BindingJob[G], u64), Fault] waits {
    let BindAsk(to: take to, bind: bind_app, credential: take credential, steps: steps, allowance: allowance) = take ask
    let made = ask_mint(to, ())?
    Ok((BindingJob(grant: take made, bind: bind_app, credential: take credential, steps: steps), allowance))
}

fn anonymous_caller(random: Random) -> Option[Caller] {
    let mut nonce: Bytes = list.with_capacity(16u64)
    host.random(random, mut nonce)
    Some(store.Caller(issuer: 1u8, subject: take nonce))
}

// §3 "Binding": a binding whose exclusive expiry the wall clock has reached is refused like
// any other, so a credential already expired at bind never yields a session.
fn unexpired(clock: Clock, take given: Result[LiveBinding, BindRefusal]) -> Result[LiveBinding, BindRefusal] waits {
    let b = (take given)?
    if std.stream_watch.revoked(b.guard, clock) {
        return Error(Rejected)
    }
    if let Some(end) = b.binding.expires_at_ms {
        if host.wall_ms(clock) >= end {
            return Error(Rejected)
        }
    }
    Ok(take b)
}

fn run_binding[G: send](take job: BindingJob[G]) -> Result[LiveBinding, BindRefusal] waits {
    let BindingJob(grant: take made, bind: bind_app, credential: take credential, steps: steps) = take job
    invoke_binding(bind_app, made, credential, steps)
}

fn invoke_binding[B](bind_app: Binder[B], seed: B, credential: Bytes, steps: u64) -> Result[LiveBinding, BindRefusal] waits {
    let result = bound steps steps {
        match bind_app {
            DeadlineOnly(f) => match (code.callable(f))(seed, credential) {
                Ok(take identity) => (Ok(LiveBinding(binding: take identity, guard: None)) : Result[LiveBinding, BindRefusal]),
                Error(why) => Error(why),
            },
            Watched(f) => (code.callable(f))(seed, credential),
        }
    }
    match take result {
        Ok(Ok(take given)) if given.binding.caller.issuer != 1u8 => Ok(take given),
        Ok(Error(why)) => Error(why),
        _ => Error(Rejected),
    }
}

// A front outside `operate` makes its own G for each bind and applies the same
// bound and expiry rules before it opens a private session. The G is dropped
// when the bind ends.
pub fn bind_credential[G: send](tasks: Tasks, clock: Clock, take grant: G, bind_app: StaticFn[fn(G, Bytes) -> Result[BoundCaller, BindRefusal] waits], take credential: Bytes, bytes_budget: u64, steps: u64) -> Result[BoundCaller, BindRefusal] waits {
    let LiveBinding(binding: take identity, ..) = unexpired(clock, bound_caller(tasks, BindingJob(grant: take grant, bind: DeadlineOnly(bind_app), credential: take credential, steps: steps), bytes_budget))?
    Ok(take identity)
}

fn bound_caller[G: send](tasks: Tasks, take job: BindingJob[G], allowance: u64) -> Result[LiveBinding, BindRefusal] waits {
    let run: fn(take BindingJob[G]) -> Result[LiveBinding, BindRefusal] waits = run_binding
    let handle = match task.try_spawn(tasks, bytes allowance, take job, run) {
        Ok(take child) => take child,
        Error(_) => return Error(Rejected),
    }
    match task.join(take handle) {
        Ok(take caller) => take caller,
        Error(_) => Error(Rejected)
    }
}

fn read_exact(mut input: ReadHalf, mut out: Bytes, size: u64, until: Until) -> bool waits {
    while list.len(out) < size {
        let left = size - list.len(out)
        match host.recv_bounded(mut input, mut out, left, until) {
            Ok(n) if n > 0u64 => (),
            _ => return false,
        }
    }
    true
}

// One length-prefixed frame of up to the supplied maximum, or None at the stream's end.
pub fn read_frame(mut input: ReadHalf, maximum: u64, until: Until) -> Option[Bytes] waits {
    let mut header: Bytes = list.with_capacity(4u64)
    if !read_exact(mut input, mut header, 4u64, until) {
        return None
    }
    let mut at = 0u64
    let size: u64 = match std.codec.take_u32(header, mut at) {
        Ok(n) => int.widen(n),
        _ => return None
    }
    if size > maximum {
        return None
    }
    let mut body: Bytes = list.with_capacity(size)
    if !read_exact(mut input, mut body, size, until) {
        return None
    }
    Some(body)
}

pub fn send_frame(mut output: WriteHalf, body: Bytes, maximum: u64, until: Until) -> bool waits {
    if list.len(body) > order.min(maximum, 4294967295u64) {
        return false
    }
    let mut header: Bytes = list.new()
    std.codec.put_u32(int.narrow(list.len(body)), mut header)
    let mut offset = 0u64
    while offset < 4u64 + list.len(body) {
        match host.send_pair(mut output, list.slice(header, std.order.min(offset, 4u64), 4u64), list.slice(body, int.saturating_sub(offset, 4u64), list.len(body)), until) {
            Ok(n) if n > 0u64 => {
                offset += n
            },
            _ => return false,
        }
    }
    true
}

type PlacePhase = OpeningPlace | OnlinePlace | DeferredStop(bool) | DrainingPlace(bool) | ExpiredPlace(bool)

type PlaceFinish = WaitingToFinish | SettledPlace | RetiringPlace | FinishSent | FinishingRetired

fn place_online(phase: PlacePhase) -> bool {
    match phase {
        OpeningPlace => false,
        OnlinePlace => true,
        DeferredStop(online) => online,
        DrainingPlace(online) => online,
        ExpiredPlace(online) => online,
    }
}

fn place_stopping(phase: PlacePhase) -> bool {
    match phase {
        DrainingPlace(_) => true,
        ExpiredPlace(_) => true,
        _ => false
    }
}

fn place_expired(phase: PlacePhase) -> bool {
    match phase {
        ExpiredPlace(_) => true,
        _ => false
    }
}

fn place_retiring(finishing: PlaceFinish) -> bool {
    match finishing {
        RetiringPlace => true,
        FinishingRetired => true,
        _ => false
    }
}

type IdleState = IdleWaiting | IdleArmed(u64, Task[()]) | CheckingServe(Option[u64]) | CheckingHead(Option[u64], Sender[()])

fn idle_pending(state: IdleState) -> bool {
    match state {
        IdleArmed(_, _) => true,
        CheckingServe(Some(_)) => true,
        CheckingHead(Some(_), _) => true,
        _ => false
    }
}

fn invalidate_idle(mut state: IdleState) {
    let prior = replace(mut state, IdleWaiting)
    state = match take prior {
        CheckingServe(_) => CheckingServe(None),
        CheckingHead(_, take permit) => CheckingHead(None, take permit),
        _ => IdleWaiting,
    }
}

// The runtime exposes immutable launch words. Variable-length payloads are
// allocated only by the operation that uses them, under that operation's bound.
type LaunchBytes {
    field: u64,
    size: u64
}

type LaunchEnv {
    n_place: u64,
    n_place_explicit: bool,
    revision: LaunchBytes,
    digest: LaunchBytes,
    target: LaunchBytes,
    describe: bool,
    preview: Option[LaunchBytes],
    prepare: Option[(LaunchBytes, LaunchBytes, LaunchBytes)],
    wake: bool,
    idle: Option[u64],
    store_id: Option[(u64, u64)],
    install: Option[u64],
    predecessor: Option[LaunchBytes],
    witness: u64,
    store_op: StoreOp,
    move_envelope: Option[LaunchBytes],
    embedded: bool,
}

// Launch word 20: what an isolated store launch does instead of serving.
// Store repair runs in place. The other operations use a private copy.
type StoreOp = Serving | DryRun | StoreVerify | StoreRepair | TapesCheck

fn store_op(value: u64) -> StoreOp {
    match value {
        1u64 => DryRun,
        2u64 => StoreVerify,
        3u64 => StoreRepair,
        4u64 => TapesCheck,
        _ => Serving,
    }
}

fn launch_env() -> LaunchEnv {
    let preview = if launch_word(6u64, 0u64) != 0u64 {
        Some(LaunchBytes(field: 8u64, size: launch_word(7u64, 0u64)))
    } else {
        None
    }
    let prepare_mode = if launch_word(9u64, 0u64) != 0u64 {
        Some((LaunchBytes(field: 10u64, size: 16u64), LaunchBytes(field: 11u64, size: 32u64), LaunchBytes(field: 24u64, size: launch_word(23u64, 0u64))))
    } else {
        None
    }
    let idle_ms = launch_word(13u64, 0u64)
    let idle: Option[u64] = if idle_ms == 0u64 {
        None
    } else {
        Some(idle_ms)
    }
    let store_id = if launch_word(14u64, 0u64) != 0u64 {
        Some((launch_word(14u64, 1u64), launch_word(14u64, 2u64)))
    } else {
        None
    }
    let install_at = if launch_word(15u64, 0u64) != 0u64 {
        Some(launch_word(15u64, 1u64))
    } else {
        None
    }
    let predecessor = if launch_word(21u64, 0u64) == 32u64 {
        Some(LaunchBytes(field: 22u64, size: 32u64))
    } else {
        None
    }
    let move_envelope = {
        let len = launch_word(25u64, 0u64)
        if len != 0u64 {
            Some(LaunchBytes(field: 26u64, size: len))
        } else {
            None
        }
    }
    LaunchEnv(n_place: launch_word(0u64, 0u64), n_place_explicit: launch_word(16u64, 0u64) != 0u64, revision: LaunchBytes(field: 18u64, size: launch_word(17u64, 0u64)), digest: launch_image(), target: launch_target_bytes(), describe: launch_word(5u64, 0u64) != 0u64, preview: preview, prepare: prepare_mode, wake: launch_word(12u64, 0u64) != 0u64, idle: idle, store_id: store_id, install: install_at, predecessor: predecessor, witness: launch_word(19u64, 0u64), store_op: store_op(launch_word(20u64, 0u64)), move_envelope: move_envelope, embedded: launch_word(28u64, 0u64) != 0u64)
}

// RUNNER-SPEC §14.6: the one source of a Bucket open's ClaimAuth. A managed
// launch (a wake or install child, the only launches the runtime gives a move
// envelope) takes the envelope's auth and nothing else: auth on the Options or
// the backing is dropped, so a managed launch without an envelope opens with
// None and Store refuses it Missing("claim_auth"). Only an embedding that is not
// a managed launch keeps the auth it put on its backing.
fn launch_open_auth(mut opening: store.Options) -> Result[(), store.Error] {
    let env = launch_env()
    if env.wake || env.install != None {
        opening.claim_auth = launch_claim_auth()?
    }
    Ok(())
}

fn launch_claim_auth() -> Result[Option[store.ClaimAuth], store.Error] {
    let Some(raw_ref) = launch_env().move_envelope else {
        return Ok(None)
    }
    let raw = launch_bytes(raw_ref)
    let codec: std.codec.Codec[store.ClaimAuth] = std.codec.of()
    // fleet.md: Adopt (expect None) is a local operator action only, never
    // a remote move command, so a move envelope carrying Adopt is refused.
    match std.codec.decode(codec, raw) {
        Ok(take auth) => match auth.class {
            Adopt => Error(Missing("claim_auth")),
            _ => Ok(Some(take auth)),
        },
        Error(_) => Error(Missing("claim_auth")),
    }
}

fn launch_image() -> LaunchBytes {
    LaunchBytes(field: 2u64, size: launch_word(1u64, 0u64))
}

fn launch_target_bytes() -> LaunchBytes {
    LaunchBytes(field: 4u64, size: launch_word(3u64, 0u64))
}

fn launch_bytes(payload: LaunchBytes) -> Bytes {
    let mut raw: Bytes = list.with_capacity(payload.size)
    for i in 0u64 .. payload.size {
        list.push(mut raw, int.narrow(launch_word(payload.field, i)))
    }
    take raw
}

fn launch_digest() -> Result[Bytes, Capacity] {
    Ok(launch_bytes(launch_image()))
}

fn owned_launch_target(target: LaunchBytes) -> String {
    result.unwrap(string.from_utf8(launch_bytes(target)))
}

fn emit_embed_tag(tag: u8) {
    let mut out: Bytes = list.with_capacity(1u64)
    list.push(mut out, tag)
    let _ = launch_emit(out)
}

fn emit_embed_capacity(cap: Capacity) {
    let mut out: Bytes = list.with_capacity(17u64)
    list.push(mut out, 4u8)
    std.codec.put_u64(cap.requested, mut out)
    std.codec.put_u64(cap.available, mut out)
    let _ = launch_emit(out)
}

fn emit_embed_start_error(problem: StartError) {
    match problem {
        Full(cap) => emit_embed_capacity(cap),
        Open(Place(Full(cap))) => emit_embed_capacity(cap),
        Open(Store(Full(cause))) => emit_embed_capacity(store_capacity(cause)),
        _ => {
            let text = start_text(problem)
            let bytes_text = string.as_bytes(text)
            let mut out: Bytes = list.with_capacity(1u64 + list.len(bytes_text))
            list.push(mut out, 3u8)
            list.append(mut out, bytes_text)
            let _ = launch_emit(out)
        },
    }
}

fn embed_dials() -> Result[Listen, StartError] {
    emit_embed_tag(1u8)
    match std.wsock.dials(16u64) {
        Ok((_, take dials)) => Ok(InProcess(take dials)),
        Error(cap) => {
            emit_embed_capacity(cap)
            Error(Full(cap))
        },
    }
}

fn embed_on_ready(launch: LaunchEnv) {
    if launch.embedded {
        emit_embed_tag(2u8)
    }
}

fn embed_on_result(launch: LaunchEnv, take result: Result[Ended, StartError]) -> Result[Ended, StartError] {
    if launch.embedded {
        if let Error(problem) = result {
            emit_embed_start_error(problem)
        }
    }
    take result
}

fn operate_with_report[G: send, H: shareable + inert + send, S: send](take made: Placing[G, H], take p: PlaceConfig[G, H, S], take stop: StopInput, status: Latest[Status], take watching: Option[Sender[Receiver[Phase]]], take observer: Option[StatusObserver], report: Option[Stderr], registered: bool) -> Result[Ended, StartError] waits {
    let launch = launch_env()
    let mut cfg = take p
    if launch.embedded {
        cfg.listen = embed_dials()?
    }
    let result = operate_with_report_body(launch, take made, take cfg, take stop, status, take watching, take observer, report, registered)
    embed_on_result(launch, take result)
}

pub type HttpBindError: send = RejectedCredential | BindingUnavailable | BindingDeadline | BindingCapacity | BindMintFailed(Fault)

type HttpBindingResult: send = Bound(Result[LiveBinding, BindRefusal]) | BindingExpired

resource type BindingCompletion: send {
    to: Sender[HttpBindingResult],
    sent: bool
} drop(completion) {
    if !completion.sent {
        let _ = channel.try_send(completion.to, Bound(Error(Rejected)))
    }
}

type HttpBindingJob[G: send]: send {
    app: BindingJob[G],
    completion: BindingCompletion
}

fn run_http_binding[G: send](take job: HttpBindingJob[G]) -> () waits {
    let HttpBindingJob(app: take app, completion: take done) = take job
    let mut completion = take done
    let caller = run_binding(take app)
    let _ = channel.try_send(completion.to, Bound(take caller))
    completion.sent = true
}

pub fn bind_http[G: send](supplied: Option[BindGrant[G]], take credential: Option[Bytes], take entries: List[Bytes], random: Random, clock: Clock, tasks: Tasks, deadline: u64, budget: u64, arg_max: u64) -> Result[Admitted, HttpBindError] waits {
    let arrived = host.mono_ns(clock)
    if arrived >= deadline {
        return Error(BindingDeadline)
    }
    let Some(take ask) = bind_ask(supplied, take credential) else {
        let caller = option.unwrap(anonymous_caller(random))
        return Ok(admitted(take caller, None, take entries, arrived, arrived, budget, arg_max))
    }
    let (take app, allowance) = match minted_binding(take ask) {
        Ok(take made) => take made,
        Error(take fault) => return Error(BindMintFailed(take fault)),
    }
    let (to, from): (Sender[HttpBindingResult], Receiver[HttpBindingResult]) = channel.new(1u64)
    let completion = BindingCompletion(to: channel.sender(to), sent: false) ?=> |(_, _)| BindingCapacity
    let alarm = std.clock.alarm(tasks, clock, deadline, to, BindingExpired)
    let job = HttpBindingJob(app: take app, completion: take completion)
    let run: fn(take HttpBindingJob[G]) -> () waits = run_http_binding
    let child = task.try_spawn(tasks, bytes allowance, take job, run) ?=> |(_, _)| BindingCapacity
    let answer = channel.receive(from)
    let now = host.mono_ns(clock)
    let _ = std.task.cancel_join(take child)
    let _ = std.task.cancel_join(take alarm)
    if now >= deadline {
        return Error(BindingDeadline)
    }
    match take answer {
        Ok(Bound(take given)) => match unexpired(clock, take given) {
            Ok(LiveBinding(binding: BoundCaller(caller: take caller, expires_at_ms: expiry), guard: take guard)) => {
                let mut context = admitted(take caller, expiry, take entries, arrived, now, budget, arg_max)
                context.guard = take guard
                Ok(take context)
            },
            Error(Rejected) => Error(RejectedCredential),
            Error(Unavailable) => Error(BindingUnavailable),
        },
        Ok(BindingExpired) => Error(BindingDeadline),
        _ => Error(RejectedCredential),
    }
}

type CheckedArgument: send {
    validate: own[send] fn(Bytes, u64) -> Option[Refusal],
    description: own[send] fn() -> Result[std.codec.Schema, std.codec.EncodeError],
}

fn register_check[G: send, H: shareable + inert + send, A](mut r: Registry[G, H], key: Bytes, ca: std.codec.Codec[A], n: u64, steps: u64) -> Result[(), RegisterError] {
    let check = fn(arg: Bytes, maximum: u64) -> Option[Refusal] {
        let seen = bound bytes order.min(n, maximum) {
            let validate = scoped fn() -> Result[Option[Refusal], OutOfTime] {
                bound steps steps {
                    match std.codec.validate(ca, arg) {
                        Ok(_) => {
                            let no_refusal: Option[Refusal] = None;
                            no_refusal
                        },
                        Error(e) => Some(Malformed(bad(e))),
                    }
                }
            }
            isolate(validate)
        }
        match take seen {
            Ok(Ok(Ok(Ok(take why)))) => take why,
            Ok(Ok(Ok(Error(_)))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Ok(Error(_))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Error(c)) => Some(Budget(capacity_room(c))),
            Error(c) => Some(Budget(capacity_room(c))),
        }
    }
    let description = fn() -> Result[std.codec.Schema, std.codec.EncodeError] {
        std.codec.describe(ca)
    }
    let go = CheckedArgument(validate: take check, description: take description)
    let copied_result: Bytes = clone(key)
    let copied: Bytes = take copied_result
    map.insert(mut r.checks, take copied, take go)
    Ok(())
}

// The composition root supplies previous/current activation keys. A current key
// always wins; retaining a gone key never substitutes a newly registered entry.
pub fn retain_gone[G: send, H: shareable + inert + send](mut r: Registry[G, H], take key: Bytes) -> Result[(), RegisterError] {
    if r.replay {
        return Ok(())
    }
    let mut carried: Option[Bytes] = Some(take key)
    edit_template(mut r, scoped fn(mut t: Template[G]) {
        if let Some(take k) = replace(mut carried, None) {
            map.insert(mut t.gone, take k, ())
        }
    })
    Ok(())
}

// `expires_at_ms` is the binding's exclusive wall-clock expiry (§3 "Binding"). It stays in
// the transport: no store key, transaction or CallInfo carries it.
pub opaque type Admitted: send {
    guard: Option[std.stream_watch.Guard],
    caller: Caller,
    expires_at_ms: Option[u64],
    entries: List[Bytes],
    arrived: u64,
    now: u64,
    budget: u64,
    arg_max: u64
}

fn admitted(take caller: Caller, expires_at_ms: Option[u64], take entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64) -> Admitted {
    Admitted(guard: None, caller: take caller, expires_at_ms: expires_at_ms, entries: take entries, arrived: arrived, now: now, budget: budget, arg_max: arg_max)
}

pub type CallWant: send {
    key: Bytes,
    stream: StreamId,
    p: u64,
    arg: Bytes,
    deadline_ms: u32
}

pub opaque type Send: send {
    stream: store.StreamKey,
    key: Bytes,
    p: u64,
    arg: Bytes,
    digest: store.RequestDigest,
    deadline: u64,
    budget: u64,
    expires_at_ms: Option[u64],
    claim: Option[Bytes]
}

pub fn prepare[G: send, H: shareable + inert + send](r: Registry[G, H], a: Admitted, take want: CallWant) -> Result[Send, Refusal] {
    let CallWant(key: take key, stream: stream_id, p: p, arg: take arg, deadline_ms: relative) = take want
    prepare_call(r, a, take key, stream_id, p, take arg, int.widen(relative))
}

fn prepare_call[G: send, H: shareable + inert + send](r: Registry[G, H], a: Admitted, take key: Bytes, stream_id: StreamId, p: u64, take arg: Bytes, relative: u64) -> Result[Send, Refusal] {
    let known = map.contains(r.slots, key)
    if !known && !map.contains(r.t.gone, key) {
        return Error(NoEntry)
    }
    let mut allowed = false
    for entry in a.entries {
        if entry == key {
            allowed = true
        }
    }
    if !allowed {
        return Error(NotAllowed)
    }
    let size = list.len(arg)
    if size > a.arg_max {
        return Error(Budget(Room(requested: size, available: a.arg_max)))
    }
    if size > a.budget {
        return Error(Budget(Room(requested: size, available: a.budget)))
    }
    let end = std.clock.deadline_after_ms(a.arrived, relative)
    if relative == 0u64 || end <= a.now {
        return Error(Deadline)
    }
    if let Some(check) = map.get(r.checks, key) {
        if let Some(take why) = (check.validate)(arg, a.arg_max) {
            return Error(take why)
        }
    }
    let digest = store.request_digest(key, arg)
    let subject_size = list.len(a.caller.subject)
    if subject_size > SUBJECT_MAX {
        return Error(Budget(Room(requested: subject_size, available: SUBJECT_MAX)))
    }
    let stream = store.StreamKey(caller: clone(a.caller), id: stream_id)
    Ok(Send(stream: take stream, key: take key, p: p, arg: take arg, digest: digest, deadline: end, budget: a.budget, expires_at_ms: a.expires_at_ms, claim: None))
}

fn prepared_request(lease: HeadLease, take seed: Option[Arc[OwnerNumber]], take prepared: Send, take target: ReplyTarget) -> Req {
    let stream = if none(prepared.claim) {
        result.unwrap(store.stream_key_bytes(prepared.stream))
    } else {
        list.new()
    }
    let Send(stream: store.StreamKey(caller: take caller, id: stream_id), key: take key, p: p, arg: take arg, digest: digest, deadline: deadline, claim: take claim, ..) = take prepared
    Req(e: Requested(Request(caller: take caller, stream: take stream, stream_id: stream_id, p: p, key: take key, arg: take arg, digest: digest, deadline: deadline, claim: take claim, reply_to: take target, live: latest.handle(lease.live), identity: latest.handle(lease.identity), seed: take seed)))
}

fn stream_time(head: Sender[HeadInput]) -> Option[StreamTime] waits {
    host_head(head, scoped fn(take to: Sender[StreamTime]) -> Result[HeadInput, Capacity] {
        Ok(ReadStreamTime(take to))
    })
}

type WireHello[G: send]: send {
    binding: Option[BindAsk[G]],
    anonymous: Caller,
    tasks: Tasks,
    to: Sender[WireEvent],
    head: WireHead
}

fn wire_bind_hello[G: send](take job: WireHello[G]) -> () waits {
    let WireHello(binding: take binding, anonymous: take anonymous, tasks: tasks, to: take to, head: take head) = take job
    let identity = match take binding {
        // A failed bind mint closes 1013, never 1008 (RUNNER-SPEC v2.70 F5). The
        // binding's task owns the G, so it is dropped before HelloBound is sent.
        Some(take ask) => match minted_binding(take ask) {
            Ok((take bind_job, allowance)) => bound_caller(tasks, take bind_job, allowance),
            Error(_) => Error(Unavailable),
        },
        None => Ok(LiveBinding(binding: BoundCaller(caller: take anonymous, expires_at_ms: None), guard: None)),
    }
    let sample = match identity {
        Ok(_) => match head {
            LifecycleHead(sender) => stream_time(sender)
        },
        Error(_) => None,
    }
    let _ = channel.send(to, wire_event(HelloBound(take identity, sample)))
}

// §3 "Binding": what a wire binding returns. `expires_at_ms` is the binding's exclusive expiry
// in Unix milliseconds, None for a binding that does not expire; it stays in the transport.
pub type BoundCaller: send {
    caller: Caller,
    expires_at_ms: Option[u64]
}

pub type LiveBinding: send {
    binding: BoundCaller,
    guard: Option[std.stream_watch.Guard]
}

type Binder[G]: send = DeadlineOnly(StaticFn[fn(G, Bytes) -> Result[BoundCaller, BindRefusal] waits]) | Watched(StaticFn[fn(G, Bytes) -> Result[LiveBinding, BindRefusal] waits])

pub type BindRefusal: codec + send = Rejected | Unavailable

// A wire only binds. Its binding takes a view of a G that the place's bind
// mint makes for each bind (RUNNER-SPEC v2.70 F4).
pub opaque type Wire[G: send]: send {
    bind: Binder[G],
    bind_bytes: u64,
    bind_steps: u64,
}

pub fn wire[G: send](bind_app: StaticFn[fn(G, Bytes) -> Result[BoundCaller, BindRefusal] waits], bind_bytes: u64, bind_steps: u64) -> Wire[G] {
    Wire(bind: DeadlineOnly(bind_app), bind_bytes: bind_bytes, bind_steps: bind_steps)
}

/// Carries a live revocation check from the bind mint to the transport.
pub fn watched_wire[G: send](bind_app: StaticFn[fn(G, Bytes) -> Result[LiveBinding, BindRefusal] waits], bind_bytes: u64, bind_steps: u64) -> Wire[G] {
    Wire(bind: Watched(bind_app), bind_bytes: bind_bytes, bind_steps: bind_steps)
}

// A session owner's room for its hello's bind child: the child's 4096 plus the
// wire's bind_bytes, apart from n_granted (granted calls) and the room term.
pub fn bind_owner_bytes[G: send](supplied: Option[BindGrant[G]]) -> u64 {
    match supplied {
        Some(b) => hello_bytes(b.wire.bind_bytes),
        None => 0u64,
    }
}

fn wire_owner_bind_bytes[G: send](supplied: Option[Wire[G]]) -> u64 {
    match supplied {
        Some(w) => hello_bytes(w.bind_bytes),
        None => 0u64,
    }
}

fn hello_bytes(bind_bytes: u64) -> u64 {
    int.saturating_add(4096u64, bind_bytes)
}

fn copy_wire[G: send](w: Wire[G]) -> Wire[G] {
    Wire(bind: w.bind, bind_bytes: w.bind_bytes, bind_steps: w.bind_steps)
}

// What a session or HTTP front holds to bind: the wire and the bind mint's inbox.
pub opaque type BindGrant[G: send]: send {
    wire: Wire[G],
    to: Sender[MintRequest[(), G]],
}

fn copy_bind_grant[G: send](supplied: Option[BindGrant[G]]) -> Option[BindGrant[G]] {
    match supplied {
        Some(b) => Some(BindGrant(wire: copy_wire(b.wire), to: channel.sender(b.to))),
        None => None,
    }
}

// Latches the binding's expiry: at or past it the session closes with 4401
// AuthExpired and no further data frame is admitted or written.
fn wire_auth_lapsed[C: send](mut st: WireLoop[C]) -> bool waits {
    if st.closing {
        return false
    }
    if std.stream_watch.revoked(st.auth_guard, st.clock) {
        wire_owner_refuse(mut st, 4401u16)
        return true
    }
    match st.auth_end {
        Some(end) if host.wall_ms(st.clock) >= end => {
            wire_owner_refuse(mut st, 4401u16)
            true
        },
        _ => false,
    }
}

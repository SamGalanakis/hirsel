// Upstream kostya/LangArena 3c9f84d helper.rs. State is explicit, per benchmark.
pub type Error = Capacity(Capacity) | Io(IoError) | Config | UnknownTask | Checksum(u32, u32)

pub type Lcg {
    state: i32
}

pub fn lcg() -> Lcg {
    Lcg(state: 42)
}

pub fn reset(mut g: Lcg) {
    g.state = 42
}

fn advance(mut g: Lcg) -> f64 {
    g.state = int.wrapping_add(int.wrapping_mul(g.state, 3877), 29573) % 139968
    float.from_int(g.state)
}

pub fn next_int(mut g: Lcg, max: i32) -> i32 {
    let state = advance(mut g)
    let scale: f64 = float.from_int(max)
    let n = state / 139968.0 * scale
    let converted: Result[i32, FloatError] = float.to_int(n)
    result.unwrap(converted)
}

pub fn next_float(mut g: Lcg, max: f64) -> f64 {
    let state = advance(mut g)
    max * state / 139968.0
}

pub fn checksum_bytes(b: Bytes) -> u32 {
    let mut h: u32 = 5381
    for x in b {
        h = int.wrapping_add(int.wrapping_add(h << 5, h), int.widen(x))
    }
    h
}

pub fn checksum_str(s: String) -> u32 {
    checksum_bytes(string.as_bytes(s))
}

pub fn mem[T](take r: Result[T, Capacity]) -> Result[T, Error] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(c) => Error(Capacity(c))
    }
}

fn named[in a](ms: IndexedSpan[std.json.Member] in a, name: String) -> bool {
    match std.json.find(ms, "name") {
        Some(Str(t)) => text.as_string(t) == name,
        _ => false,
    }
}

type Setting = Integer(i64) | StringValue(String) | Invalid

pub opaque type Settings {
    fields: Map[String, Setting]
}

fn own_fields[in a](fields: IndexedSpan[std.json.Member] in a) -> Result[Settings, Error] {
    let mut owned: Map[String, Setting] = map.new()
    for field in fields {
        let key = mem(string.from(text.as_string(field.key)))?
        let value = match field.value {
            Num(t) => {
                match (int.parse(text.as_string(t)) : Result[i64, ParseError]) {
                    Ok(n) => Integer(n),
                    Error(_) => Invalid
                }
            },
            Str(t) => StringValue(mem(string.from(text.as_string(t)))?),
            _ => Invalid,
        }
        mem(result.capacity_only(map.insert(mut owned, take key, take value)))?
    }
    Ok(Settings(fields: take owned))
}

fn task_settings[in a](j: std.json.Json in a, name: String) -> Result[Settings, Error] {
    match j {
        Arr(items) => {
            for item in items {
                if let Obj(fields) = item {
                    if named(fields, name) {
                        return own_fields(fields)
                    }
                }
            }
            Error(Config)
        },
        Obj(ms) => {
            for m in ms {
                if text.as_string(m.key) == name {
                    if let Obj(fields) = m.value {
                        return own_fields(fields)
                    }
                }
            }
            Error(Config)
        },
        _ => Error(Config),
    }
}

/// Parses the upstream array or object config and keeps the selected task's fields.
pub fn read_settings(config: String, name: String) -> Result[Settings, Error] {
    region r {
        let j = match std.json.parse(r, config) {
            Ok(x) => x,
            Error(_) => return Error(Config)
        }
        task_settings(j, name)
    }
}

pub fn config_i64(settings: Settings, key: String) -> Result[i64, Error] {
    match map.get(settings.fields, key) {
        Some(Integer(n)) => Ok(n),
        _ => Error(Config),
    }
}

pub fn config_s(settings: Settings, key: String) -> Result[String, Error] {
    match map.get(settings.fields, key) {
        Some(StringValue(s)) => mem(string.from(s)),
        _ => Error(Config),
    }
}

/// Upstream checksum_str(format!("{:.7}",x)), using the shared exact fixed formatter.
/// Fails: Capacity, propagated from formatting. No private formatting implementation.
pub fn checksum_f64(x: f64) -> Result[u32, Error] {
    let mut s = string.new()
    mem(float.push_fixed64(mut s, x, 7))?
    Ok(checksum_str(s))
}

fn tiered_replayed_row(tree: PageTree, logical: Bytes) -> Option[View[ReplayRow]] in tree {
    let Some(overlays) = view tree.replay else {
        return None
    }
    let id: u32 = list.word_be(logical, 0)
    let Some(overlay) = std.omap.get(overlays.collections, id) else {
        return None
    }
    replay_overlay_at(overlay, logical)
}

type TieredPageBackend = PagerTask(Sender[TieredPagerMessage]) | PagerDirect(Dir, StoreId)

fn read_tiered_point[R](source: TieredPageSource, root_grant: Arc[TieredReaderGrant], root: TieredPinRoot, tree: PageTree, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    read_tiered_point_with(PagerTask(channel.sender(source.pager)), source.packs, source.next_stamp, source.deadline, root_grant, root, tree, logical, decode_row)
}

fn read_tiered_point_direct[R](d: Dir, owner: StoreId, inventory: TieredReadInventory, opened: u64, branch_id: u32, pin_bytes: u64, tree: PageTree, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    let grant = disk_allocation(scoped fn() -> Result[Arc[TieredReaderGrant], Error] {
        Ok(arc.new(TieredReaderGrant(store: owner, opened: opened, pin_bytes: pin_bytes)))
    })?
    let root = TieredPinRoot(domain: opened, branch: branch_id, generation: inventory.generation, root_stamp: tree_stamp(tree))
    read_tiered_point_with(PagerDirect(d, owner), std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, tree, logical, decode_row)
}

fn read_tiered_point_with[R](take backend: TieredPageBackend, packs: std.omap.OMap[u64, TieredPagerPack], next_stamp: u64, deadline: u64, root_grant: Arc[TieredReaderGrant], root: TieredPinRoot, tree: PageTree, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    if list.len(logical) < 4 {
        return decode_row(None)
    }
    let Some((edge, descriptor)) = std.page.collection_slot(tree.root, list.slice(logical, 0, 4)) else {
        return decode_row(None)
    }
    if collection_descriptor(descriptor).kind == LogCollection {
        if list.len(logical) != 12 {
            return decode_row(None)
        }
        let sequence: u64 = list.word_be(logical, 4)
        let window = descriptor_bounds(descriptor)
        if sequence < window.first || sequence >= window.next {
            return decode_row(None)
        }
    }
    if let Some(row) = tiered_replayed_row(tree, logical) {
        let stored: Option[View[Bytes]] = match row.now {
            ReplayPut(value) => Some(view value),
            ReplayAbsent => None,
        }
        return decode_row(stored)
    }
    let key = list.slice(logical, 4, list.len(logical))
    retry_tiered_read_with(take backend, packs, next_stamp, deadline, root_grant, root, key, None, TieredPoint, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[R, Error] {
        tiered_reading(attempt, ValuesAt)
        let backing = TieredBorrowedRoot(edge: view edge, pins: view visible)
        let stored = tiered_point_bytes(attempt, backing, key)?
        decode_row(stored)
    })
}

fn retry_tiered_read[R](source: TieredPageSource, root_grant: Arc[TieredReaderGrant], root: TieredPinRoot, key: Bytes, upper: Option[View[Bytes]], direction: TieredDirection, read: scoped[view] fn(core.Cell[TieredTouchSet], Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[R, Error]) -> Result[R, Error] waits {
    retry_tiered_read_with(PagerTask(channel.sender(source.pager)), source.packs, source.next_stamp, source.deadline, root_grant, root, key, upper, direction, read)
}

fn retry_tiered_read_with[R](take backend: TieredPageBackend, packs: std.omap.OMap[u64, TieredPagerPack], next_stamp: u64, deadline: u64, root_grant: Arc[TieredReaderGrant], root: TieredPinRoot, key: Bytes, upper: Option[View[Bytes]], direction: TieredDirection, read: scoped[view] fn(core.Cell[TieredTouchSet], Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[R, Error]) -> Result[R, Error] waits {
    let mut pins = empty_tiered_pins(root, root_grant.pin_bytes)
    let mut pending: Option[(TieredTarget, Error)] = None
    loop {
        // The attempt lives outside the body's isolation, so a stop that
        // escapes the body still leaves its touches and latch readable.
        let window = if direction == TieredPoint {
            0u64
        } else {
            tiered_window(pins)
        }
        let attempt = tiered_attempt(root_grant.pin_bytes, window)
        let isolated = disk_allocation(scoped fn() -> Result[Result[R, Error], Error] {
            Ok(read(attempt, pins.frames))
        })
        // The latch is read first: a latched attempt reruns however the
        // body ended, an isolated failure included.
        let state = tiered_finish(take attempt)
        match state.stopped {
            Some(AttemptMiss(_)) => {
                let sought = match state.seek {
                    SeekKey(secondary) => view secondary,
                    SeekUpper => option.unwrap(upper),
                    SeekOperation => view key,
                }
                serve_tiered_miss_with(backend, packs, next_stamp, deadline, root, state, sought, direction, Some(arc.share(root_grant)), mut pins, mut pending)?
            },
            Some(AttemptPinLimit(problem)) => return Error(Full(Cache(problem))),
            Some(AttemptAllocation(problem)) => return Error(Full(Allocation(problem))),
            Some(AttemptFold(_)) => fail("store: a read attempt cannot wait for a fold"),
            None => {
                let observed = (take isolated)?
                return take observed
            },
        }
    }
}

// Delivers a latched miss's batch into the pin map, in the order the batch
// names it. A target whose delivery failed once fails the read or call when
// an attempt demands it again.
fn serve_tiered_miss(source: TieredPageSource, root: TieredPinRoot, state: TieredTouchSet, sought: Bytes, direction: TieredDirection, take grant: Option[Arc[TieredReaderGrant]], mut pins: TieredPins, mut pending: Option[(TieredTarget, Error)]) -> Result[(), Error] waits {
    serve_tiered_miss_with(PagerTask(channel.sender(source.pager)), source.packs, source.next_stamp, source.deadline, root, state, sought, direction, take grant, mut pins, mut pending)
}

fn serve_tiered_miss_with(backend: TieredPageBackend, packs: std.omap.OMap[u64, TieredPagerPack], next_stamp: u64, deadline: u64, root: TieredPinRoot, state: TieredTouchSet, sought: Bytes, direction: TieredDirection, take grant: Option[Arc[TieredReaderGrant]], mut pins: TieredPins, mut pending: Option[(TieredTarget, Error)]) -> Result[(), Error] waits {
    let demand = tiered_miss_demand_raw(packs, next_stamp, deadline, state, sought, direction, take grant, mut pending)?
    let delivered = match backend {
        PagerTask(requests) => tiered_point_delivery(requests, take demand)?,
        PagerDirect(d, owner) => {
            let mut input = PagerLocal(d)
            let mut local_cache = new_tiered_cache(0)
            tiered_pager_point(mut input, mut local_cache, owner, demand)?
        },
    }
    let _ = tiered_install_delivery(take delivered, root, state.stamps, mut pins, mut pending)?
    Ok(())
}

// The demand for a latched miss, or the failure an earlier delivery of the
// same target recorded.
fn tiered_miss_demand(source: TieredPageSource, state: TieredTouchSet, sought: Bytes, direction: TieredDirection, take grant: Option[Arc[TieredReaderGrant]], mut pending: Option[(TieredTarget, Error)]) -> Result[TieredPointDemand, Error] {
    tiered_miss_demand_raw(source.packs, source.next_stamp, source.deadline, state, sought, direction, take grant, mut pending)
}

fn tiered_miss_demand_raw(packs: std.omap.OMap[u64, TieredPagerPack], next_stamp: u64, deadline: u64, state: TieredTouchSet, sought: Bytes, direction: TieredDirection, take grant: Option[Arc[TieredReaderGrant]], mut pending: Option[(TieredTarget, Error)]) -> Result[TieredPointDemand, Error] {
    let Some(AttemptMiss(target)) = view state.stopped else {
        fail("store: only a latched miss is delivered")
    }
    let failed_here = match pending {
        Some((failed, _)) => tiered_frame_id(failed) == tiered_frame_id(target),
        None => false,
    }
    if failed_here {
        let (_, take problem) = option.unwrap(replace(mut pending, None))
        return Error(take problem)
    }
    Ok(TieredPointDemand(target: clone(target), key: copied(sought)?, values: clone(state.values), room: int.saturating_sub(state.partition, state.touched_bytes), direction: direction, paths: clone(state.gather.paths), siblings: clone(state.siblings), packs: std.omap.snapshot(packs), next_stamp: next_stamp, deadline: deadline, grant: take grant))
}

// Installs a delivered batch in its order and records its failure. The
// held path frames are protected like touched ones once installed, so a
// later frame of the same batch never evicts one and the next attempt finds
// every path it was demanded for. It is false when a path frame did not fit
// the map's partition (§13.3a "crowded").
fn tiered_install_delivery(take delivered: TieredPointDelivery, root: TieredPinRoot, touched: Map[u64, ()], mut pins: TieredPins, mut pending: Option[(TieredTarget, Error)]) -> Result[bool, Error] {
    let TieredPointDelivery(frames: take frames, held: held, failure: take failure, ..) = take delivered
    let mut kept: Map[u64, ()] = map.new()
    if held != 0 {
        capacity(map.try_reserve(mut kept, map.len(touched) + held))?
        for (stamp, _) in touched {
            map.insert(mut kept, stamp, ())
        }
    }
    let mut fit = true
    let mut at = 0u64
    for frame in frames {
        let installed = if held == 0 {
            tiered_install_pin(mut pins, root, touched, frame)?
        } else {
            tiered_install_pin(mut pins, root, kept, frame)?
        }
        // A sibling or a later value that does not fit is a prefetch left
        // out; only a path frame that does not fit leaves the call crowded.
        if installed {
            if at < held {
                map.insert(mut kept, frame.identity.stamp, ())
            }
        } else if held == 0 || at < held {
            fit = false
        }
        at += 1
    }
    if let Some(take refused) = take failure {
        pending = Some(take refused)
    }
    pins.demands += 1
    Ok(fit)
}

// The source a Tx attempt's misses are served from, at the root it reads.
fn tx_page_source(pager: Option[View[Sender[TieredPagerMessage]]], tree: PageTree) -> Result[TieredPageSource, Error] {
    let Some(requests) = pager else {
        return Error(Io(Closed))
    }
    let Some(inventory) = view tree.paging else {
        fail("store: a Cold edge has no pack inventory")
    }
    Ok(TieredPageSource(pager: channel.sender(requests), packs: std.omap.snapshot(inventory.packs), next_stamp: inventory.next_stamp, deadline: 0))
}

// A resumable counted parent must free each terminal buffer without a frame.
// expect: run counted_string_buffer() = 3
fn counted_string_buffer() -> u64 {
    let r = rc.new(string.from("abc"))
    string.byte_len(r)
}

// expect: run counted_list_buffers() = 1
fn counted_list_buffers() -> u64 {
    let mut xs: List[String] = list.with_capacity(1)
    list.push(mut xs, string.from("abc"))
    let r = rc.new(take xs)
    list.len(r)
}

// expect: run counted_map_buffers() = 1
fn counted_map_buffers() -> u64 {
    let mut m: Map[u64, String] = map.new()
    map.insert(mut m, 7u64, string.from("abc"))
    let a = arc.new(take m)
    map.len(a)
}

fn released_shared_path(held: Arc[List[u64]]) -> bool {
    let mut children: List[Arc[List[u64]]] = list.with_capacity(4)
    list.push(mut children, arc.share(held))
    let mut data: List[u64] = list.with_capacity(1)
    list.push(mut data, 11u64)
    let unique = arc.new(take data)
    list.push(mut children, take unique)
    list.push(mut children, arc.share(held))
    list.push(mut children, arc.share(held))
    let parent = arc.new(take children)
    drop(take parent)
    let words: List[u64] = list.with_capacity(13)
    list.len(words) == 0
}

// The held row costs 8+32=40 bytes. The dropped path costs 32 for four holders,
// 8+32 for its unique child and 32 for its parent, exactly 104 bytes. All 104
// must be reusable before the next admission; its three shared children retain
// only their original 40-byte row. The overall reservation peak is 144 bytes.
// engine-fact: shared_child_release_preserves_exact_refund_order
// expect: run shared_path_release_refunds_exactly() = true
fn shared_path_release_refunds_exactly() -> bool {
    let mut data: List[u64] = list.with_capacity(1)
    list.push(mut data, 7u64)
    let held = arc.new(take data)
    let released = result.unwrap(bound bytes 104 {
        released_shared_path(held)
    })
    released && list.len(held) == 1 && held[0] == 7
}

// Module harness: the projection of a session's next request, which a release's check
// compares under the live and the candidate code (fable-design 4.4, step 5).

// The session's next request as fingerprints of its parts (fable-design 4.4): each
// section's hash in prompt order, the offered tools' hash, and the hash of the messages
// already in the log. It renders under the calling code over the current rows and writes
// nothing, so the live harness and a candidate's, called on the same rows, show exactly
// which parts of the next request a release changes. A section whose render fails keeps
// the hash it last showed, as `plan` would.
pub type Projection: codec + send {
    sections: List[SectionHash],
    tools: Bytes,
    prefix: Bytes
}

pub fn project[G: send](tx: store.Tx, h: Handles, a: Agent[G]) -> Result[Projection, Refused] {
    let s = session_of(tx, h)?
    let mut sections: List[SectionHash] = list.new()
    for sec in a.sections {
        match render(tx, sec, a.limits) {
            Text(take text) => list.push(mut sections, SectionHash(key: clone(sec.key), hash: digest(string.as_bytes(text)))),
            Absent => (),
            Kept => if let Some(take hash) = hash_of(s.active_sections_hashes, sec.key) {
                list.push(mut sections, SectionHash(key: clone(sec.key), hash: take hash))
            },
        }
    }
    let defs = offered(tx, h, a, s)?
    let Some(raw_defs) = encoded(defs) else {
        return Error(Malformed("tool definitions"))
    }
    let mut messages: Bytes = list.new()
    let mut p = s.head_pos
    while p < s.next_pos {
        match kept(store.fetch(tx, store.shape(h.entries), p))? {
            Some(System(_)) => (),
            Some(Note(_, _)) => (),
            Some(entry) => {
                let Some(raw) = encoded(entry) else {
                    return Error(Malformed("entry"))
                }
                std.codec.put_key_bytes(raw, mut messages)
            },
            None => return Error(Malformed("entry")),
        }
        p += 1u64
    }
    Ok(Projection(sections: take sections, tools: digest(raw_defs), prefix: digest(messages)))
}

// What a release changes in a session's next request, from its projection under the live
// code and under the candidate's: the first section in prompt order where the two differ
// (the prompt cache breaks there), every section key whose text changed, appeared or went,
// and whether the tool list or the message prefix differ.
pub type CacheDiff: codec + send {
    first_section: Option[String],
    sections: List[String],
    tools: bool,
    prefix: bool
}

pub fn cache_diff(live: Projection, next: Projection) -> CacheDiff {
    let mut first: Option[String] = None
    let n = if list.len(live.sections) > list.len(next.sections) { list.len(live.sections) } else { list.len(next.sections) }
    for i in 0u64 .. n {
        let same = i < list.len(live.sections) && i < list.len(next.sections) && live.sections[i].key == next.sections[i].key && live.sections[i].hash == next.sections[i].hash
        if !same {
            first = Some(if i < list.len(next.sections) { clone(next.sections[i].key) } else { clone(live.sections[i].key) })
            break
        }
    }
    let mut changed: List[String] = list.new()
    for e in next.sections {
        if hash_of(live.sections, e.key) != Some(clone(e.hash)) {
            list.push(mut changed, clone(e.key))
        }
    }
    for e in live.sections {
        if let None = hash_of(next.sections, e.key) {
            list.push(mut changed, clone(e.key))
        }
    }
    CacheDiff(first_section: take first, sections: take changed, tools: live.tools != next.tools, prefix: live.prefix != next.prefix)
}

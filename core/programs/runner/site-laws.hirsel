fn find_asset(path: Bytes) -> Option[std.wsock.Asset] {
    if path != string.as_bytes("/") {
        return None
    }
    Some(std.wsock.Asset(name: "app.js", content_type: "application/javascript"))
}

type SiteRequest: send {
    socket: Socket,
    peer: Ip,
    site: std.wsock.Site,
    clock: Clock,
    config: std.wsock.Config,
    pending: std.wsock.Pending
}

fn serve_site(take job: SiteRequest) -> Result[(), std.wsock.Error] waits {
    let SiteRequest(socket: take socket, peer: peer, site: site, clock: clock, config: config, pending: take pending) = take job
    let accepted = host.mono_ns(clock)
    let served = std.wsock.server_with_site(take socket, take pending, peer, list.new(), config, clock, accepted, Some(site), scoped fn(path: Bytes) -> Result[Option[(bool, String)], Capacity] {
        if path == string.as_bytes("/raw") {
            Ok(Some((false, string.from("busy"))))
        } else {
            Ok(None)
        }
    }, scoped fn(ip: Ip) -> bool {
        true
    })
    match take served {
        Ok(_) => Ok(()),
        Error(problem) => Error(problem)
    }
}

fn request_site(d: Dir, tasks: Tasks, clock: Clock, network: Net, request: String, response_room: u64) -> Bytes waits {
    let config = std.wsock.defaults()
    let pool = result.unwrap(std.wsock.pending(config))
    let pending = option.unwrap(result.unwrap(std.wsock.acquire(pool)))
    let listened = host.listen(network, Addr(ip: V4(0x7f000001u32), port: 0u16), 1u16)
    let (take server, address) = result.unwrap(take listened)
    let mut accepting = take server
    let deadline = At(clock, std.clock.deadline_after_ms(host.mono_ns(clock), config.upgrade_ms))
    let client = result.unwrap(host.connect(network, address, deadline))
    let accepted = host.accept(mut accepting, deadline)
    let (take socket, peer) = result.unwrap(take accepted)
    let job = SiteRequest(socket: take socket, peer: peer.ip, site: std.wsock.Site(dir: d, find: find_asset), clock: clock, config: config, pending: take pending)
    let child = task.spawn(tasks, bytes (runner.WIRE_OWNER_FLOOR - 320u64), take job, serve_site)
    let (take input, take output) = net.split(take client)
    let mut writer = take output
    let text = string.as_bytes(request)
    let mut sent = 0u64
    while sent < list.len(text) {
        sent += result.unwrap(host.send_pair(mut writer, list.slice(text, sent, list.len(text)), string.as_bytes(""), deadline))
    }
    let mut reader = take input
    let mut response: Bytes = list.with_capacity(response_room)
    loop {
        let room = response_room - list.len(response)
        if room == 0u64 {
            fail("site response exceeded expected size")
        }
        let count = result.unwrap(host.recv_bounded(mut reader, mut response, room, deadline))
        if count == 0u64 {
            break
        }
    }
    result.unwrap(result.unwrap(task.join(take child)))
    take response
}

@test
fn test_site_request_target_and_head(d: Dir, tasks: Tasks, clock: Clock, network: Net) -> Result[(), String] waits {
    let mut temp = string.with_capacity(32u64)
    let dir = result.unwrap(std.dir.create_temp(d, mut temp))
    result.unwrap(std.file.write(dir, "app.js", string.as_bytes("test asset")))
    let get = request_site(dir, tasks, clock, network, "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n", 1024u64)
    let head = request_site(dir, tasks, clock, network, "HEAD / HTTP/1.1\r\nHost: localhost\r\n\r\n", 1024u64)
    let query = request_site(dir, tasks, clock, network, "GET /?q=1#fragment HTTP/1.1\r\nHost: localhost\r\n\r\n", 1024u64)
    let raw = request_site(dir, tasks, clock, network, "HEAD /raw HTTP/1.1\r\nHost: localhost\r\n\r\n", 1024u64)
    let upgraded = request_site(dir, tasks, clock, network, "GET /hirsel?q=1 HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Protocol: hirsel.4\r\n\r\n", 1024u64)
    result.unwrap(std.dir.remove_all(d, temp))
    let expected = string.as_bytes("HTTP/1.1 200 OK\r\nConnection: close\r\nCache-Control: no-store\r\nContent-Type: application/javascript\r\nContent-Length: 10\r\n\r\n")
    if head != expected {
        return Error("HEAD must return the GET headers with no body")
    }
    if list.len(get) != list.len(expected) + 10u64 || list.slice(get, 0u64, list.len(expected)) != head || list.slice(get, list.len(expected), list.len(get)) != string.as_bytes("test asset") || get != query {
        return Error("GET and GET with a query must return the same asset")
    }
    if raw != string.as_bytes("HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\nCache-Control: no-store\r\nContent-Type: application/json\r\nContent-Length: 4\r\n\r\n") {
        return Error("HEAD must also suppress raw handler bodies")
    }
    let switching = string.as_bytes("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: hirsel.4\r\n\r\n")
    if upgraded != switching {
        return Error("Upgrade must match /hirsel with a query")
    }
    Ok(())
}

@test
fn test_site_streams_large_asset(d: Dir, tasks: Tasks, clock: Clock, network: Net) -> Result[(), String] waits {
    let mut temp = string.with_capacity(32u64)
    let dir = result.unwrap(std.dir.create_temp(d, mut temp))
    let size = 1048576u64
    let mut payload: Bytes = list.with_capacity(size)
    for i in 0u64 .. size {
        list.push(mut payload, int.truncate(i + i / 8192u64))
    }
    result.unwrap(std.file.write(dir, "app.js", payload))
    let response = request_site(dir, tasks, clock, network, "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n", size + 1024u64)
    result.unwrap(std.dir.remove_all(d, temp))
    let head = string.as_bytes("HTTP/1.1 200 OK\r\nConnection: close\r\nCache-Control: no-store\r\nContent-Type: application/javascript\r\nContent-Length: 1048576\r\n\r\n")
    let offset = list.len(head)
    if list.len(response) != offset + size || list.slice(response, 0u64, offset) != head || list.slice(response, offset, list.len(response)) != payload {
        return Error("GET must stream the entire asset with its original Content-Length")
    }
    Ok(())
}

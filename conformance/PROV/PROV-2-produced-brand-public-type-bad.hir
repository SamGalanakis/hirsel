// rule: PROV-2
// expect: reject PROV-2 at line 12
// twin: PROV/PROV-2-produced-brand-run.hir
// Only an opaque type's own package produces its brand; a type whose
// representation is public may be constructed anywhere, so its construction
// introduces no brand.
pub type Tok {
  n: u64,
}

fn mint(a: Authority) -> Tok of a {
  Tok(n: 1)
}

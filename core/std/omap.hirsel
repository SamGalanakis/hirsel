// A persistent B+ tree. Nodes contain 1..32 entries/children; non-root nodes
// contain 16..32. Leaf rows and branch separators share immutable payloads.
// Unique node holders retain in-place editing. See api/omap.md.
pub opaque type Node[K: ordered + shareable + send, V: shareable + send]: shareable + send {
    stamp: u64,
    depth: u64,
    size: u64,
    rows: List[Arc[Entry[K, V]]],
    kids: List[Arc[Node[K, V]]],
    lows: Option[Arc[List[Separator[K, V]]]]
}

pub opaque type OMap[K: ordered + shareable + send, V: shareable + send]: shareable + send {
    head: Option[Arc[Node[K, V]]]
}

type Entry[K: ordered + shareable + send, V: shareable + send]: shareable + send {
    key: K,
    value: V
}

// Decoded minima preserve the decoder's supplied keys. Fresh minima retain
// the leaf row, so path copies never allocate or copy a key payload.
type Separator[K: ordered + shareable + send, V: shareable + send]: shareable + send = Row(Arc[Entry[K, V]]) | Decoded(Arc[K])

type Replacement[K: ordered + shareable + send, V: shareable + send]: send = Moved(V) | Held(Arc[Entry[K, V]])

/// The replaced value, moved from a unique row or retained in a shared row.
pub opaque type Replaced[K: ordered + shareable + send, V: shareable + send]: send {
    value: Replacement[K, V]
}

/// The stored value before replacement, without copying its payload.
pub fn replaced_value[K: ordered + shareable + send, V: shareable + send](old: Replaced[K, V]) -> View[V] in old {
    match old.value {
        Moved(v) => view v,
        Held(row) => view row.value
    }
}

pub type Bound[K: ordered + shareable + send]: shareable + send = Unbounded | Included(K) | Excluded(K)

type Frame[K: ordered + shareable + send, V: shareable + send]: shareable + send {
    node: Arc[Node[K, V]],
    position: u64
}

pub opaque type Cursor[K: ordered + shareable + send, V: shareable + send]: send {
    path: List[Frame[K, V]],
    stop: Bound[K],
    reverse: bool
}

fn copied[T: shareable](x: T) -> T {
    clone(x)
}

/// Empty, with no allocation.
pub fn new[K: ordered + shareable + send, V: shareable + send]() -> OMap[K, V] {
    OMap(head: None)
}

/// O(1) version: share the root, allocate nothing.
pub fn snapshot[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> OMap[K, V] {
    OMap(head: root(m))
}

/// Entry count, O(1).
pub fn len[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> u64 {
    match m.head {
        Some(n) => n.size,
        None => 0
    }
}

/// Root holder for a checkpoint or another task, O(1), no allocation.
pub fn root[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> Option[Arc[Node[K, V]]] {
    match m.head {
        Some(n) => Some(arc.share(n)),
        None => None
    }
}

/// Publish decoded nodes without rechecking tree invariants. Loading is eager:
/// every child must have been constructed before its parent. O(1).
pub fn from_root[K: ordered + shareable + send, V: shareable + send](take head: Option[Arc[Node[K, V]]]) -> OMap[K, V] {
    OMap(head: take head)
}

/// Caller-assigned identity, unchanged when a subtree is shared.
pub fn node_id[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]]) -> u64 {
    n.stamp
}

/// Zero for leaves, one plus the children's level for branches.
pub fn node_level[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]]) -> u64 {
    n.depth
}

/// Number of leaf entries or branch children, at most 32.
pub fn node_count[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]]) -> u64 {
    if n.depth == 0 {
        list.len(n.rows)
    } else {
        list.len(n.kids)
    }
}

/// Total leaf entries beneath this node.
pub fn node_len[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]]) -> u64 {
    n.size
}

/// Leaf key i, or minimum key of branch child i. None outside count.
pub fn node_key[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], i: u64) -> Option[View[K]] in n {
    node_key_at(n, i)
}

/// Leaf value i. None for branches or outside count.
pub fn node_value[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], i: u64) -> Option[View[V]] in n {
    if i < list.len(n.rows) {
        Some(view n.rows[i].value)
    } else {
        None
    }
}

/// Child i as an owned Arc holder. None for leaves or outside count.
pub fn node_child[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], i: u64) -> Option[Arc[Node[K, V]]] {
    if i < list.len(n.kids) {
        Some(arc.share(n.kids[i]))
    } else {
        None
    }
}

/// MEM-24 storage of one tree. Entry-owned allocations are counted by its owner.
pub fn storage_charge[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V], key_bytes: u64, value_bytes: u64) -> u64 {
    match m.head {
        Some(node) => node_storage_charge(node, key_bytes, value_bytes),
        None => 0,
    }
}

fn storage_round(total: u64) -> u64 {
    int.saturating_add(total, 7) & 0xfffffffffffffff8u64
}

fn node_storage_charge[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], key_bytes: u64, value_bytes: u64) -> u64 {
    // Three u64s, two List headers, an optional Arc, and the counted header.
    let mut total = 96 + 8 * (list.capacity(n.rows) + list.capacity(n.kids))
    let entry_bytes = storage_round(int.saturating_add(8, int.saturating_add(key_bytes, value_bytes)))
    total = int.saturating_add(total, int.saturating_mul(list.len(n.rows), entry_bytes))
    if let Some(lows) = n.lows {
        // The counted List and its 16-byte tagged separators.
        total = int.saturating_add(total, 32 + 16 * list.capacity(lows))
        for slot in 0u64 .. list.len(lows) {
            if let Decoded(_) = lows[slot] {
                total = int.saturating_add(total, storage_round(int.saturating_add(8, key_bytes)))
            }
        }
    }
    for child in n.kids {
        total = int.saturating_add(total, node_storage_charge(child, key_bytes, value_bytes))
    }
    total
}

/// Construct a decoded leaf with its recorded id. No order or fan-out checks.
/// Payloads are copied into node lists; a refusal raises Capacity.
pub fn leaf[K: ordered + shareable + send, V: shareable + send](id: u64, keys: List[K], values: List[V]) -> Arc[Node[K, V]] {
    load_leaf(id, keys, values)
}

fn load_leaf[K: ordered + shareable + send, V: shareable + send](id: u64, keys: List[K], values: List[V]) -> Arc[Node[K, V]] {
    let mut rows: List[Arc[Entry[K, V]]] = list.with_capacity(list.len(keys))
    for i in 0 .. list.len(keys) {
        list.push(mut rows, new_entry(keys[i], values[i]))
    }
    pack_leaf(id, take rows)
}

/// Construct a decoded branch with recorded minima and child holders. No tree
/// revalidation. Children are eagerly loaded; a refusal raises Capacity.
pub fn branch[K: ordered + shareable + send, V: shareable + send](id: u64, low_keys: List[K], children: List[Arc[Node[K, V]]]) -> Arc[Node[K, V]] {
    load_branch(id, low_keys, children)
}

fn load_branch[K: ordered + shareable + send, V: shareable + send](id: u64, low_keys: List[K], children: List[Arc[Node[K, V]]]) -> Arc[Node[K, V]] {
    let mut ks: List[Separator[K, V]] = list.with_capacity(list.len(low_keys))
    let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(list.len(children))
    let mut size: u64 = 0
    let mut depth: u64 = 1
    for k in low_keys {
        let key = arc.new(copied(k))
        list.push(mut ks, Decoded(take key))
    }
    for n in children {
        size += n.size
        depth = n.depth + 1
        list.push(mut cs, arc.share(n))
    }
    let lows = arc.new(take ks)
    arc.new(Node(stamp: id, depth, size, rows: list.new(), kids: take cs, lows: Some(take lows)))
}

/// Bottom-up build from strictly increasing keys and equally many values.
/// Like leaf/branch, the caller supplies the shape/order invariant. Input lists
/// stay borrowed and unchanged on Capacity. Payloads are cloned into the leaf lists; no
/// search path is copied. O(n) payload work and O(n/32) nodes.
pub fn from_sorted[K: ordered + shareable + send, V: shareable + send](mut ids: u64, keys: List[K], values: List[V]) -> OMap[K, V] {
    let n = list.len(keys)
    if n == 0 {
        return new()
    }
    let groups = (n - 1) / 32 + 1
    let mut level: List[Arc[Node[K, V]]] = list.with_capacity(groups)
    let mut at: u64 = 0
    for group in 0 .. groups {
        let width = n / groups + if group < n % groups {
            1u64
        } else {
            0u64
        }
        let mut rows: List[Arc[Entry[K, V]]] = list.with_capacity(width)
        for i in at .. at + width {
            list.push(mut rows, new_entry(keys[i], values[i]))
        }
        ids += 1
        list.push(mut level, pack_leaf(ids, take rows))
        at += width
    }
    while list.len(level) > 1 {
        let total = list.len(level)
        let branches = (total - 1) / 32 + 1
        let mut parents: List[Arc[Node[K, V]]] = list.with_capacity(branches)
        let mut start: u64 = 0
        for group in 0 .. branches {
            let width = total / branches + if group < total % branches {
                1u64
            } else {
                0u64
            }
            let mut children: List[Arc[Node[K, V]]] = list.with_capacity(width)
            for i in start .. start + width {
                list.push(mut children, arc.share(level[i]))
            }
            list.push(mut parents, fresh_branch(mut ids, take children))
            start += width
        }
        level = take parents
    }
    OMap(head: Some(arc.share(level[0])))
}

/// O(log32 n) search. The returned view freezes this version only.
pub fn get[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V], k: K) -> Option[View[V]] in m {
    match m.head {
        Some(n) => lookup(n, k),
        None => None
    }
}

fn lookup[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], k: K) -> Option[View[V]] in n {
    if n.depth == 0 {
        let i = lower(n.rows, k)
        if i < list.len(n.rows) && key_order(n.rows, i, k) == Equal {
            Some(view n.rows[i].value)
        } else {
            None
        }
    } else {
        lookup(n.kids[child_index(n, k)], k)
    }
}

fn key_order[K: ordered + shareable + send, V: shareable + send](ks: List[Arc[Entry[K, V]]], i: u64, k: K) -> Order {
    order.compare(ks[i].key, k)
}

fn lower[K: ordered + shareable + send, V: shareable + send](ks: List[Arc[Entry[K, V]]], k: K) -> u64 {
    let n = list.len(ks)
    if n > 0 && ks[n - 1].key < k {
        return n
    }
    match list.binary_search_by(ks, scoped fn(entry: Arc[Entry[K, V]]) -> Order {
        if entry.key < k {
            Less
        } else {
            Greater
        }
    }) {
        Ok(i) => i,
        Error(i) => i,
    }
}

// First separator greater than k; its predecessor owns k's interval.
// One comparison per step, without rechecking the final separator.
fn upper_child[K: ordered + shareable + send, V: shareable + send](ks: List[Separator[K, V]], k: K) -> u64 {
    let n = list.len(ks)
    if n > 0 && !(k < separator_key(ks[n - 1])) {
        return n - 1
    }
    let index = match list.binary_search_by(ks, scoped fn(entry: Separator[K, V]) -> Order {
        if k < separator_key(entry) {
            Greater
        } else {
            Less
        }
    }) {
        Ok(i) => i,
        Error(i) => i,
    }
    if index == 0 {
        0u64
    } else {
        index - 1
    }
}

fn child_index[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], k: K) -> u64 {
    child_index_node(n, k)
}

/// Insert/replace by path copying. ids is the last issued id shared by every
/// writer branch. New children are stamped before parents. A refusal raises
/// Capacity; it may consume ids but never publishes a partial version, and m stays valid.
pub fn insert[K: ordered + shareable + send, V: shareable + send](mut ids: u64, m: OMap[K, V], take k: K, take v: V) -> (OMap[K, V], Option[Replaced[K, V]]) {
    let row = arc.new(Entry(key: take k, value: take v))
    inserted(mut ids, m, row)
}

fn inserted[K: ordered + shareable + send, V: shareable + send](mut ids: u64, m: OMap[K, V], incoming: Arc[Entry[K, V]]) -> (OMap[K, V], Option[Replaced[K, V]]) {
    let mut replaced: Option[Replaced[K, V]] = None
    let pieces = match m.head {
        Some(n) => insert_node(mut ids, mut replaced, n, incoming),
        None => {
            let mut rows: List[Arc[Entry[K, V]]] = list.with_capacity(1)
            list.push(mut rows, arc.share(incoming))
            ids += 1
            Pieces(first: pack_leaf(ids, take rows), second: None)
        },
    }
    let Pieces(first: left_node, second: right_node) = take pieces
    let h = match take right_node {
        None => take left_node,
        Some(take r) => {
            let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(2)
            list.push(mut cs, take left_node)
            list.push(mut cs, take r)
            fresh_branch(mut ids, take cs)
        }
    }
    (OMap(head: Some(take h)), take replaced)
}

fn insert_leaf[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut replaced: Option[Replaced[K, V]], n: Arc[Node[K, V]], incoming: Arc[Entry[K, V]]) -> Pieces[K, V] {
    let k = view incoming.key
    let i = lower(n.rows, k)
    let hit = i < list.len(n.rows) && key_order(n.rows, i, k) == Equal
    if hit {
        replaced = Some(Replaced(value: Held(arc.share(n.rows[i]))))
    }
    let total = list.len(n.rows) + if hit {
        0u64
    } else {
        1u64
    }
    let cut = if total <= 32 {
        total
    } else {
        total / 2
    }
    let mut a: List[Arc[Entry[K, V]]] = list.with_capacity(cut)
    let mut b: List[Arc[Entry[K, V]]] = list.with_capacity(total - cut)
    let row = arc.share(incoming)
    for j in 0 .. total {
        let old = if j > i && !hit {
            j - 1
        } else {
            j
        }
        let entry = if j == i {
            arc.share(row)
        } else {
            arc.share(n.rows[old])
        }
        if j < cut {
            list.push(mut a, take entry)
        } else {
            list.push(mut b, take entry)
        }
    }
    ids += 1
    let left_node = pack_leaf(ids, take a)
    let right_node = if cut < total {
        ids += 1
        Some(pack_leaf(ids, take b))
    } else {
        None
    }
    Pieces(first: take left_node, second: take right_node)
}

fn insert_node[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut replaced: Option[Replaced[K, V]], n: Arc[Node[K, V]], incoming: Arc[Entry[K, V]]) -> Pieces[K, V] {
    let k = view incoming.key
    if n.depth == 0 {
        insert_leaf(mut ids, mut replaced, n, incoming)
    } else {
        let at = child_index(n, k)
        let Pieces(first: left_node, second: right_node) = insert_node(mut ids, mut replaced, n.kids[at], incoming)
        let extra = if let Some(_) = right_node {
            1u64
        } else {
            0u64
        }
        let same_boundaries = extra == 0 && (at > 0 || !before_minimum(n, k))
        let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(list.len(n.kids) + extra)
        for j in 0 .. at {
            list.push(mut cs, arc.share(n.kids[j]))
        }
        list.push(mut cs, take left_node)
        if let Some(take r) = take right_node {
            list.push(mut cs, take r)
        }
        for j in at + 1 .. list.len(n.kids) {
            list.push(mut cs, arc.share(n.kids[j]))
        }
        if list.len(cs) <= 32 {
            let lows = if same_boundaries {
                share_lows(n)
            } else {
                Some(fresh_keys(cs))
            }
            let size = n.size + if let Some(_) = replaced {
                0u64
            } else {
                1u64
            }
            ids += 1
            let h: Arc[Node[K, V]] = arc.new(Node(stamp: ids, depth: n.depth, size, rows: list.new(), kids: take cs, lows: take lows))
            return Pieces(first: take h, second: None)
        }
        split_branches(mut ids, take cs)
    }
}

fn pack_leaf[K: ordered + shareable + send, V: shareable + send](id: u64, take rows: List[Arc[Entry[K, V]]]) -> Arc[Node[K, V]] {
    let size = list.len(rows)
    arc.new(Node(stamp: id, depth: 0, size, rows: take rows, kids: list.new(), lows: None))
}

fn fresh_branch[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take cs: List[Arc[Node[K, V]]]) -> Arc[Node[K, V]] {
    let lows = fresh_keys(cs)
    pack_branch(mut ids, take cs, Some(take lows))
}

fn node_key_at[K: ordered + shareable + send, V: shareable + send](n: Node[K, V], i: u64) -> Option[View[K]] in n {
    match n.lows {
        Some(xs) => if i < list.len(xs) {
            Some(separator_key(xs[i]))
        } else {
            None
        },
        None => if i < list.len(n.rows) {
            Some(view n.rows[i].key)
        } else {
            None
        }
    }
}

fn before_minimum[K: ordered + shareable + send, V: shareable + send](n: Node[K, V], k: K) -> bool {
    match n.lows {
        Some(xs) => k < separator_key(xs[0]),
        None => k < n.rows[0].key
    }
}

fn separator_key[K: ordered + shareable + send, V: shareable + send](s: Separator[K, V]) -> View[K] in s {
    match s {
        Row(r) => view r.key,
        Decoded(k) => k
    }
}

fn share_separator[K: ordered + shareable + send, V: shareable + send](s: Separator[K, V]) -> Separator[K, V] {
    match s {
        Row(r) => Row(arc.share(r)),
        Decoded(k) => Decoded(arc.share(k))
    }
}

fn minimum[K: ordered + shareable + send, V: shareable + send](n: Node[K, V]) -> Separator[K, V] {
    match n.lows {
        Some(xs) => share_separator(xs[0]),
        None => Row(arc.share(n.rows[0]))
    }
}

fn new_entry[K: ordered + shareable + send, V: shareable + send](k: K, v: V) -> Arc[Entry[K, V]] {
    let key = copied(k)
    let value = copied(v)
    arc.new(Entry(key: take key, value: take value))
}

// Unchanged separator blocks remain shared across versions.
fn share_lows[K: ordered + shareable + send, V: shareable + send](n: Node[K, V]) -> Option[Arc[List[Separator[K, V]]]] {
    match n.lows {
        Some(xs) => Some(arc.share(xs)),
        None => None
    }
}

fn fresh_keys[K: ordered + shareable + send, V: shareable + send](cs: List[Arc[Node[K, V]]]) -> Arc[List[Separator[K, V]]] {
    let mut ks: List[Separator[K, V]] = list.with_capacity(list.len(cs))
    for c in cs {
        list.push(mut ks, minimum(c))
    }
    arc.new(take ks)
}

fn pack_branch[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take cs: List[Arc[Node[K, V]]], take lows: Option[Arc[List[Separator[K, V]]]]) -> Arc[Node[K, V]] {
    let mut size: u64 = 0
    let depth = cs[0].depth + 1
    for c in cs {
        size += c.size
    }
    ids += 1
    arc.new(Node(stamp: ids, depth, size, rows: list.new(), kids: take cs, lows: take lows))
}

// Transfer a temporary leaf's entries into the final halves. No payload clone.
fn split_leaves[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take rows: List[Arc[Entry[K, V]]]) -> Pieces[K, V] {
    let total = list.len(rows)
    let mut left = take rows
    if total <= 32 {
        ids += 1
        return Pieces(first: pack_leaf(ids, take left), second: None)
    }
    let mid = total / 2
    let mut right: List[Arc[Entry[K, V]]] = list.with_capacity(total - mid)
    for _ in mid .. total {
        list.push(mut right, option.unwrap(list.pop(mut left)))
    }
    for i in 0u64 .. (total - mid) / 2 {
        list.swap(mut right, i, total - mid - 1 - i)
    }
    ids += 1
    let left_node = pack_leaf(ids, take left)
    ids += 1
    let right_node = pack_leaf(ids, take right)
    Pieces(first: take left_node, second: Some(take right_node))
}

fn split_branches[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take cs: List[Arc[Node[K, V]]]) -> Pieces[K, V] {
    let total = list.len(cs)
    let mut left = take cs
    if total <= 32 {
        return Pieces(first: fresh_branch(mut ids, take left), second: None)
    }
    let mid = total / 2
    let mut right: List[Arc[Node[K, V]]] = list.with_capacity(total - mid)
    for _ in mid .. total {
        list.push(mut right, option.unwrap(list.pop(mut left)))
    }
    for i in 0u64 .. (total - mid) / 2 {
        list.swap(mut right, i, total - mid - 1 - i)
    }
    let left_node = fresh_branch(mut ids, take left)
    let right_node = fresh_branch(mut ids, take right)
    Pieces(first: take left_node, second: Some(take right_node))
}

type Pieces[K: ordered + shareable + send, V: shareable + send] {
    first: Arc[Node[K, V]],
    second: Option[Arc[Node[K, V]]]
}

/// Consuming update. Unique nodes are edited in place through with_unique;
/// shared nodes use the ordinary path-copy. Splits retain the left node and add a sibling.
/// A refusal raises Capacity and consumes m; independently held versions remain
/// valid. Keep a snapshot for rollback.
pub fn insert_owned[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take m: OMap[K, V], take k: K, take v: V) -> (OMap[K, V], Option[Replaced[K, V]]) {
    let mut pending = Some((take k, take v))
    let mut map = take m
    match replace(mut map.head, None) {
        None => {},
        Some(take original_head) => {
            let mut h = take original_head
            let old = try_replace_unique(mut ids, mut h, mut pending)
            map.head = Some(take h)
            if let Some(take replaced) = take old {
                return (take map, Some(take replaced))
            }
        }
    }
    let (take pending_key, take pending_value) = option.unwrap(take pending)
    let row = arc.new(Entry(key: take pending_key, value: take pending_value))
    owned_map(mut ids, take map, row)
}

fn owned_map[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take m: OMap[K, V], incoming: Arc[Entry[K, V]]) -> (OMap[K, V], Option[Replaced[K, V]]) {
    let mut replaced: Option[Replaced[K, V]] = None
    let OMap(head: old) = take m
    let changed = match take old {
        None => {
            let empty: Node[K, V] = Node(stamp: 0, depth: 0, size: 0, rows: list.new(), kids: list.new(), lows: None)
            let h = arc.new(take empty)
            owned_arc(mut ids, mut replaced, take h, incoming)
        },
        Some(take h) => owned_arc(mut ids, mut replaced, take h, incoming)
    }
    let Pieces(first: left, second: right) = take changed
    let new_head = match take right {
        None => take left,
        Some(take r) => {
            let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(2)
            list.push(mut cs, take left)
            list.push(mut cs, take r)
            fresh_branch(mut ids, take cs)
        }
    }
    (OMap(head: Some(take new_head)), take replaced)
}

fn owned_arc[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut replaced: Option[Replaced[K, V]], take h: Arc[Node[K, V]], incoming: Arc[Entry[K, V]]) -> Pieces[K, V] {
    let mut holder = take h
    let right = edit_owned_arc(mut ids, mut replaced, mut holder, incoming)
    Pieces(first: take holder, second: take right)
}

fn edit_owned_arc[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut replaced: Option[Replaced[K, V]], mut holder: Arc[Node[K, V]], incoming: Arc[Entry[K, V]]) -> Option[Arc[Node[K, V]]] {
    let k = view incoming.key
    let edited = arc.with_unique(mut holder, scoped fn(mut node: Node[K, V]) -> Option[Arc[Node[K, V]]] {
        if node.depth == 0 {
            let at = lower(node.rows, k)
            let hit = at < list.len(node.rows) && key_order(node.rows, at, k) == Equal
            if hit {
                let old = list.set(mut node.rows, at, arc.share(incoming))
                replaced = Some(Replaced(value: Held(take old)))
            } else {
                let row = arc.share(incoming)
                let capacity = if list.len(node.rows) < 32 {
                    32u64
                } else {
                    33u64
                }
                let extra = capacity - list.len(node.rows)
                list.reserve(mut node.rows, extra)
                push_at(mut node.rows, at, take row)
            }
            node.size = list.len(node.rows)
        } else {
            let at = child_index_node(node, k)
            let mut boundaries_changed = {
                at == 0 && before_minimum(node, k)
            }
            let total = list.len(node.kids)
            let old_size = node.kids[at].size
            list.swap(mut node.kids, at, total - 1)
            let mut selected = option.unwrap(list.pop(mut node.kids))
            let right = edit_owned_arc(mut ids, mut replaced, mut selected, incoming)
            let mut size = selected.size
            list.push(mut node.kids, take selected)
            list.swap(mut node.kids, at, total - 1)
            if let Some(take r) = take right {
                boundaries_changed = true
                size += r.size
                list.reserve(mut node.kids, 1)
                push_at(mut node.kids, at + 1, take r)
            }
            node.size = node.size - old_size + size
            if boundaries_changed && list.len(node.kids) <= 32 {
                node.lows = Some(fresh_keys(node.kids))
            }
        }
        ids += 1
        node.stamp = ids
        let width = if node.depth == 0 {
            list.len(node.rows)
        } else {
            list.len(node.kids)
        }
        if width > 32 {
            Some(split_owned_node(mut ids, mut node))
        } else {
            None
        }
    })
    match take edited {
        Some(take changed) => take changed,
        None => {
            let Pieces(first: left, second: right) = insert_node(mut ids, mut replaced, holder, incoming)
            holder = take left
            take right
        },
    }
}

fn try_replace_unique[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut holder: Arc[Node[K, V]], mut pending: Option[(K, V)]) -> Option[Replaced[K, V]] {
    let edited = arc.with_unique(mut holder, scoped fn(mut node: Node[K, V]) -> Option[Replaced[K, V]] {
        let old = if node.depth == 0 {
            let at = match pending {
                Some((k, _)) => lower(node.rows, k),
                None => return None
            }
            let hit = match pending {
                Some((k, _)) => at < list.len(node.rows) && key_order(node.rows, at, k) == Equal,
                None => false
            }
            if !hit {
                return None
            }
            let total = list.len(node.rows)
            list.swap(mut node.rows, at, total - 1)
            let mut row = option.unwrap(list.pop(mut node.rows))
            let old = arc.with_unique(mut row, scoped fn(mut data: Entry[K, V]) -> Replaced[K, V] {
                let (take key, take value) = option.unwrap(replace(mut pending, None))
                data.key = take key
                let old = replace(mut data.value, take value)
                Replaced(value: Moved(take old))
            })
            list.push(mut node.rows, take row)
            list.swap(mut node.rows, at, total - 1)
            take old
        } else {
            let at = match pending {
                Some((k, _)) => child_index_node(node, k),
                None => return None
            }
            let total = list.len(node.kids)
            list.swap(mut node.kids, at, total - 1)
            let mut child = option.unwrap(list.pop(mut node.kids))
            let old = try_replace_unique(mut ids, mut child, mut pending)
            list.push(mut node.kids, take child)
            list.swap(mut node.kids, at, total - 1)
            take old
        }
        if let Some(_) = old {
            ids += 1
            node.stamp = ids
        }
        take old
    })
    match take edited {
        Some(take old) => take old,
        None => None
    }
}

fn push_at[T](mut xs: List[T], at: u64, take value: T) {
    list.push(mut xs, take value)
    let mut i = list.len(xs) - 1
    while i > at {
        list.swap(mut xs, i, i - 1)
        i -= 1
    }
}

fn split_owned_node[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut node: Node[K, V]) -> Arc[Node[K, V]] {
    let is_leaf = node.depth == 0
    let total = if is_leaf {
        list.len(node.rows)
    } else {
        list.len(node.kids)
    }
    let width = total - total / 2
    let mut rows: List[Arc[Entry[K, V]]] = list.with_capacity(if is_leaf {
        width
    } else {
        0
    })
    let mut kids: List[Arc[Node[K, V]]] = list.with_capacity(if is_leaf {
        0
    } else {
        width
    })
    let mut size = 0u64
    for _ in 0 .. width {
        if is_leaf {
            list.push(mut rows, option.unwrap(list.pop(mut node.rows)))
            size += 1
        } else {
            let child = option.unwrap(list.pop(mut node.kids))
            size += child.size
            list.push(mut kids, take child)
        }
    }
    for i in 0u64 .. width / 2 {
        if is_leaf {
            list.swap(mut rows, i, width - 1 - i)
        } else {
            list.swap(mut kids, i, width - 1 - i)
        }
    }
    node.size -= size
    let lows: Option[Arc[List[Separator[K, V]]]] = if is_leaf {
        None
    } else {
        node.lows = Some(fresh_keys(node.kids))
        Some(fresh_keys(kids))
    }
    ids += 1
    let right = Node(stamp: ids, depth: node.depth, size, rows: take rows, kids: take kids, lows: take lows)
    arc.new(take right)
}

fn child_index_node[K: ordered + shareable + send, V: shareable + send](n: Node[K, V], k: K) -> u64 {
    match n.lows {
        Some(xs) => upper_child(xs, k),
        None => 0
    }
}

/// Remove by path copying and sibling merge/redistribution. Missing keys share
/// the original root and issue no ids. O(log32 n) nodes; Capacity leaves m valid.
pub fn remove[K: ordered + shareable + send, V: shareable + send](mut ids: u64, m: OMap[K, V], k: K) -> OMap[K, V] {
    let head = match m.head {
        None => return new(),
        Some(n) => n,
    }
    if let None = lookup(head, k) {
        return snapshot(m)
    }
    let changed = remove_node(mut ids, head, k)
    match take changed {
        None => new(),
        Some(take n) => {
            if n.depth > 0 && list.len(n.kids) == 1 {
                OMap(head: Some(arc.share(n.kids[0])))
            } else {
                OMap(head: Some(take n))
            }
        },
    }
}

fn remove_node[K: ordered + shareable + send, V: shareable + send](mut ids: u64, n: Arc[Node[K, V]], k: K) -> Option[Arc[Node[K, V]]] {
    if n.depth == 0 {
        let at = lower(n.rows, k)
        let total = list.len(n.rows) - 1
        if total == 0 {
            return None
        }
        let mut rows: List[Arc[Entry[K, V]]] = list.with_capacity(total)
        for i in 0 .. list.len(n.rows) {
            if i != at {
                list.push(mut rows, arc.share(n.rows[i]))
            }
        }
        ids += 1
        Some(pack_leaf(ids, take rows))
    } else {
        let at = child_index(n, k)
        let changed = remove_node(mut ids, n.kids[at], k)
        let same_minimum = {
            match node_key_at(n, at) {
                Some(low) => low < k,
                None => false
            }
        }
        let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(list.len(n.kids))
        for i in 0 .. list.len(n.kids) {
            if i == at {
                if let Some(c) = changed {
                    list.push(mut cs, arc.share(c))
                }
            } else {
                list.push(mut cs, arc.share(n.kids[i]))
            }
        }
        if list.len(cs) == 0 {
            return None
        }
        let short = if at < list.len(cs) {
            at
        } else {
            list.len(cs) - 1
        }
        if node_count(cs[short]) < 16 && list.len(cs) > 1 {
            let a = if short > 0 {
                short - 1
            } else {
                0u64
            }
            let Pieces(first: left_node, second: right_node) = merge_pair(mut ids, cs[a], cs[a + 1])
            let extra = if let Some(_) = right_node {
                1u64
            } else {
                0u64
            }
            let mut fixed: List[Arc[Node[K, V]]] = list.with_capacity(list.len(cs) - 1 + extra)
            for i in 0 .. a {
                list.push(mut fixed, arc.share(cs[i]))
            }
            list.push(mut fixed, take left_node)
            if let Some(take r) = take right_node {
                list.push(mut fixed, take r)
            }
            for i in a + 2 .. list.len(cs) {
                list.push(mut fixed, arc.share(cs[i]))
            }
            return Some(fresh_branch(mut ids, take fixed))
        }
        let lows = if same_minimum && list.len(cs) == list.len(n.kids) {
            share_lows(n)
        } else {
            Some(fresh_keys(cs))
        }
        Some(pack_branch(mut ids, take cs, take lows))
    }
}

fn merge_pair[K: ordered + shareable + send, V: shareable + send](mut ids: u64, a: Arc[Node[K, V]], b: Arc[Node[K, V]]) -> Pieces[K, V] {
    if a.depth == 0 {
        let total = list.len(a.rows) + list.len(b.rows)
        let mut rows: List[Arc[Entry[K, V]]] = list.with_capacity(total)
        for i in 0 .. list.len(a.rows) {
            list.push(mut rows, arc.share(a.rows[i]))
        }
        for i in 0 .. list.len(b.rows) {
            list.push(mut rows, arc.share(b.rows[i]))
        }
        split_leaves(mut ids, take rows)
    } else {
        let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(list.len(a.kids) + list.len(b.kids))
        for c in a.kids {
            list.push(mut cs, arc.share(c))
        }
        for c in b.kids {
            list.push(mut cs, arc.share(c))
        }
        split_branches(mut ids, take cs)
    }
}

/// Least entry, no allocation.
pub fn first[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> Option[(View[K], View[V])] in m {
    match m.head {
        Some(n) => endpoint(n, false),
        None => None
    }
}

/// Greatest entry, no allocation.
pub fn last[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> Option[(View[K], View[V])] in m {
    match m.head {
        Some(n) => endpoint(n, true),
        None => None
    }
}

fn endpoint[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], high: bool) -> Option[(View[K], View[V])] in n {
    let i = if high {
        node_count(n) - 1
    } else {
        0u64
    }
    if n.depth == 0 {
        Some((view n.rows[i].key, view n.rows[i].value))
    } else {
        endpoint(n.kids[i], high)
    }
}

/// An Arc-owned cursor over exactly the requested interval. Reserve one frame
/// per level once. O(height) storage, O(log n) seek, no row materialization.
pub fn range[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V], lo: Bound[K], take hi: Bound[K]) -> Cursor[K, V] {
    let mut path: List[Frame[K, V]] = list.with_capacity(match m.head {
        Some(n) => n.depth + 1,
        None => 0
    })
    if let Some(n) = m.head {
        seek(n, lo, mut path)
    }
    Cursor(path: take path, stop: take hi, reverse: false)
}

fn seek[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], lo: Bound[K], mut path: List[Frame[K, V]]) {
    let i = if n.depth == 0 {
        match lo {
            Unbounded => 0u64,
            Included(k) => lower(n.rows, k),
            Excluded(k) => {
                let j = lower(n.rows, k)
                if j < list.len(n.rows) && key_order(n.rows, j, k) == Equal {
                    j + 1
                } else {
                    j
                }
            },
        }
    } else {
        match lo {
            Unbounded => 0u64,
            Included(k) => child_index(n, k),
            Excluded(k) => child_index(n, k)
        }
    }
    list.push(mut path, Frame(node: arc.share(n), position: i))
    if n.depth > 0 {
        seek(n.kids[i], lo, mut path)
    }
}

fn within_upper[K: ordered + shareable + send](hi: Bound[K], k: K) -> bool {
    match hi {
        Unbounded => true,
        Included(v) => !(v < k),
        Excluded(v) => k < v
    }
}

// Pop exhausted leaves/ancestors and recursively descend the next subtree.
// The original seek reserved the maximum path length, so these pushes fit.
fn ready[K: ordered + shareable + send, V: shareable + send](mut path: List[Frame[K, V]]) -> bool {
    if list.len(path) == 0 {
        return false
    }
    let at = list.len(path) - 1
    if path[at].node.depth == 0 && path[at].position < list.len(path[at].node.rows) {
        return true
    }
    let _ = list.pop(mut path)
    if list.len(path) == 0 {
        return false
    }
    let p = list.len(path) - 1
    path[p].position += 1
    if path[p].position < list.len(path[p].node.kids) {
        let child = arc.share(path[p].node.kids[path[p].position])
        seek(child, Unbounded, mut path)
    }
    ready(mut path)
}

/// Next owned pair; a refused payload copy raises Capacity with this row unconsumed.
/// Complete traversal is O(n) node work plus payload copies. The cursor is send.
pub fn next[K: ordered + shareable + send, V: shareable + send](mut c: Cursor[K, V]) -> Option[(K, V)] {
    if c.reverse {
        return previous(mut c)
    }
    if !ready(mut c.path) {
        return None
    }
    let at = list.len(c.path) - 1
    let pair = {
        let frame = view c.path[at]
        let i = frame.position
        if !within_upper(c.stop, frame.node.rows[i].key) {
            return None
        }
        let key: K = clone(frame.node.rows[i].key)
        let value: V = clone(frame.node.rows[i].value)
        (take key, take value)
    }
    c.path[at].position += 1
    Some(take pair)
}

/// The number of keys in the interval, using subtree sizes without reading rows.
pub fn count[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V], lo: Bound[K], hi: Bound[K]) -> u64 {
    let n = match m.head {
        Some(head) => head,
        None => return 0
    }
    let start = match lo {
        Unbounded => 0u64,
        Included(k) => rank(n, k, false),
        Excluded(k) => rank(n, k, true)
    }
    let end = match hi {
        Unbounded => n.size,
        Included(k) => rank(n, k, true),
        Excluded(k) => rank(n, k, false)
    }
    int.saturating_sub(end, start)
}

fn leaf_rank[K: ordered + shareable + send, V: shareable + send](rows: List[Arc[Entry[K, V]]], k: K, include: bool) -> u64 {
    let at = lower(rows, k)
    if include && at < list.len(rows) && key_order(rows, at, k) == Equal {
        at + 1
    } else {
        at
    }
}

fn rank[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], k: K, include: bool) -> u64 {
    if n.depth == 0 {
        return leaf_rank(n.rows, k, include)
    }
    let child = child_index(n, k)
    let mut before: u64 = 0
    for i in 0u64 .. child {
        before += n.kids[i].size
    }
    before + rank(n.kids[child], k, include)
}

/// Seek to the upper bound and traverse the interval in descending key order.
pub fn range_reverse[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V], take lo: Bound[K], hi: Bound[K]) -> Cursor[K, V] {
    let mut path: List[Frame[K, V]] = list.with_capacity(match m.head {
        Some(n) => n.depth + 1,
        None => 0
    })
    if let Some(n) = m.head {
        seek_reverse(n, hi, mut path)
    }
    Cursor(path: take path, stop: take lo, reverse: true)
}

fn seek_reverse[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], hi: Bound[K], mut path: List[Frame[K, V]]) {
    if n.depth == 0 {
        let position = match hi {
            Unbounded => list.len(n.rows),
            Included(k) => leaf_rank(n.rows, k, true),
            Excluded(k) => leaf_rank(n.rows, k, false)
        }
        list.push(mut path, Frame(node: arc.share(n), position))
    } else {
        let child = match hi {
            Unbounded => list.len(n.kids) - 1,
            Included(k) => child_index(n, k),
            Excluded(k) => child_index(n, k)
        }
        list.push(mut path, Frame(node: arc.share(n), position: child))
        seek_reverse(n.kids[child], hi, mut path)
    }
}

// A leaf's position counts candidates, and a branch's position counts children to its left.
fn ready_reverse[K: ordered + shareable + send, V: shareable + send](mut path: List[Frame[K, V]]) -> bool {
    while list.len(path) > 0 {
        let at = list.len(path) - 1
        if path[at].position == 0 {
            let _ = list.pop(mut path)
        } else if path[at].node.depth == 0 {
            return true
        } else {
            path[at].position -= 1
            let child = arc.share(path[at].node.kids[path[at].position])
            seek_reverse(child, Unbounded, mut path)
        }
    }
    false
}

fn previous[K: ordered + shareable + send, V: shareable + send](mut c: Cursor[K, V]) -> Option[(K, V)] {
    if !ready_reverse(mut c.path) {
        return None
    }
    let at = list.len(c.path) - 1
    let pair = {
        let frame = view c.path[at]
        let row = view frame.node.rows[frame.position - 1]
        let in_range = match c.stop {
            Unbounded => true,
            Included(low) => !(row.key < low),
            Excluded(low) => low < row.key
        }
        if !in_range {
            return None
        }
        let key: K = clone(row.key)
        let value: V = clone(row.value)
        (take key, take value)
    }
    c.path[at].position -= 1
    Some(take pair)
}

/// Replace [lo, hi) with a sorted tree whose keys all lie in that interval.
/// Unchanged subtrees stay shared. Fresh path nodes use ids after every root
/// supplied by the caller.
pub fn graft[K: ordered + shareable + send, V: shareable + send](mut ids: u64, base: OMap[K, V], lo: K, hi: K, replacement: OMap[K, V]) -> OMap[K, V] {
    let (left, rest) = split_tree(mut ids, base, lo)
    let (_, right) = split_tree(mut ids, rest, hi)
    let prefix = concat_trees(mut ids, left, replacement)
    concat_trees(mut ids, prefix, right)
}

fn split_tree[K: ordered + shareable + send, V: shareable + send](mut ids: u64, tree: OMap[K, V], k: K) -> (OMap[K, V], OMap[K, V]) {
    match tree.head {
        Some(n) => split_node(mut ids, n, k),
        None => (new(), new()),
    }
}

fn split_node[K: ordered + shareable + send, V: shareable + send](mut ids: u64, n: Arc[Node[K, V]], k: K) -> (OMap[K, V], OMap[K, V]) {
    if n.depth == 0 {
        let at = lower(n.rows, k)
        if at == 0 {
            return (new(), from_root(Some(arc.share(n))))
        }
        if at == list.len(n.rows) {
            return (from_root(Some(arc.share(n))), new())
        }
        let left = leaf_part(mut ids, n.rows, 0u64, at)
        let right = leaf_part(mut ids, n.rows, at, list.len(n.rows))
        return (from_root(Some(take left)), from_root(Some(take right)))
    }
    let at = child_index(n, k)
    let (child_left, child_right) = split_node(mut ids, n.kids[at], k)
    let left = branch_part(mut ids, n.kids, 0u64, at)
    let right = branch_part(mut ids, n.kids, at + 1u64, list.len(n.kids))
    (concat_trees(mut ids, left, child_left), concat_trees(mut ids, child_right, right))
}

fn leaf_part[K: ordered + shareable + send, V: shareable + send](mut ids: u64, rows: List[Arc[Entry[K, V]]], lo: u64, hi: u64) -> Arc[Node[K, V]] {
    let mut part: List[Arc[Entry[K, V]]] = list.with_capacity(hi - lo)
    for i in lo .. hi {
        list.push(mut part, arc.share(rows[i]))
    }
    ids += 1
    pack_leaf(ids, take part)
}

fn branch_part[K: ordered + shareable + send, V: shareable + send](mut ids: u64, kids: List[Arc[Node[K, V]]], lo: u64, hi: u64) -> OMap[K, V] {
    if hi == lo {
        return new()
    }
    if hi == lo + 1 {
        return from_root(Some(arc.share(kids[lo])))
    }
    let joined_root = build_branch_part(mut ids, kids, lo, hi)
    from_root(Some(take joined_root))
}

fn build_branch_part[K: ordered + shareable + send, V: shareable + send](mut ids: u64, kids: List[Arc[Node[K, V]]], lo: u64, hi: u64) -> Arc[Node[K, V]] {
    let mut part: List[Arc[Node[K, V]]] = list.with_capacity(hi - lo)
    for i in lo .. hi {
        list.push(mut part, arc.share(kids[i]))
    }
    fresh_branch(mut ids, take part)
}

fn concat_trees[K: ordered + shareable + send, V: shareable + send](mut ids: u64, left: OMap[K, V], right: OMap[K, V]) -> OMap[K, V] {
    let Some(a) = root(left) else {
        return snapshot(right)
    }
    let Some(b) = root(right) else {
        return snapshot(left)
    }
    let joined = join_nodes(mut ids, a, b)
    let (take leading, take second) = take joined
    if let Some(take other) = take second {
        let mut children: List[Arc[Node[K, V]]] = list.with_capacity(2)
        list.push(mut children, take leading)
        list.push(mut children, take other)
        let joined_root = fresh_branch(mut ids, take children)
        return from_root(Some(take joined_root))
    }
    from_root(Some(take leading))
}

// Both results have the taller input's depth. At the same depth, combine the
// two roots if either is too small to become a non-joined_root node.
fn join_nodes[K: ordered + shareable + send, V: shareable + send](mut ids: u64, a: Arc[Node[K, V]], b: Arc[Node[K, V]]) -> (Arc[Node[K, V]], Option[Arc[Node[K, V]]]) {
    let ac = node_count(a)
    let bc = node_count(b)
    if a.depth == b.depth && ac >= 16 && bc >= 16 {
        return (arc.share(a), Some(arc.share(b)))
    }
    if a.depth == 0 && b.depth == 0 {
        let mut rows: List[Arc[Entry[K, V]]] = list.with_capacity(ac + bc)
        for row in a.rows {
            list.push(mut rows, arc.share(row))
        }
        for row in b.rows {
            list.push(mut rows, arc.share(row))
        }
        let end = list.len(rows)
        if end <= 32 {
            ids += 1
            return (pack_leaf(ids, take rows), None)
        }
        let left = leaf_part(mut ids, rows, 0u64, end / 2)
        let right = leaf_part(mut ids, rows, end / 2, end)
        return (take left, Some(take right))
    }
    let mut kids: List[Arc[Node[K, V]]] = list.with_capacity(64)
    if a.depth == b.depth {
        for child in a.kids {
            list.push(mut kids, arc.share(child))
        }
        for child in b.kids {
            list.push(mut kids, arc.share(child))
        }
    } else if a.depth > b.depth {
        for i in 0u64 .. ac - 1u64 {
            list.push(mut kids, arc.share(a.kids[i]))
        }
        let (take leading, take second) = join_nodes(mut ids, a.kids[ac - 1], b)
        list.push(mut kids, take leading)
        if let Some(take other) = take second {
            list.push(mut kids, take other)
        }
    } else {
        let (take leading, take second) = join_nodes(mut ids, a, b.kids[0])
        list.push(mut kids, take leading)
        if let Some(take other) = take second {
            list.push(mut kids, take other)
        }
        for i in 1u64 .. bc {
            list.push(mut kids, arc.share(b.kids[i]))
        }
    }
    let end = list.len(kids)
    if end <= 32 {
        return (fresh_branch(mut ids, take kids), None)
    }
    let left = build_branch_part(mut ids, kids, 0u64, end / 2)
    let right = build_branch_part(mut ids, kids, end / 2, end)
    (take left, Some(take right))
}

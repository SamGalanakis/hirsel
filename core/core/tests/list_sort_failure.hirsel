// n=20 keys (3i mod 5 for i < 16, then 3,1,4,0): the first 16 sort by insertion into one
// run, the last four into another. Calls 74-93 merge from scratch into xs,
// starting with the in-order check. The audit checks original keys and single ownership
// when cleanup has to finish moving either or both tails into xs.
fn twenty_key(id: u64) -> u64 {
    if id < 16 {
        (id * 3) % 5
    } else if id == 16 {
        3
    } else if id == 17 {
        1
    } else if id == 18 {
        4
    } else {
        0
    }
}

fn merge_key(count: u64, id: u64) -> u64 {
    if count == 20 {
        return twenty_key(id)
    }
    if id < 32 {
        80 - id / 16 * 16 + id % 16
    } else if id < 48 {
        2 * (id - 32) + 1
    } else {
        2 * (id - 48)
    }
}

resource type MergeAudit {
    out: Stdout,
    values: List[SortItem],
    count: u64
} drop(t) {
    let mut valid = list.len(t.values) == t.count
    let mut mask: u64 = 0
    for x in t.values {
        if x.id >= t.count || x.key != merge_key(t.count, x.id) {
            valid = false
        } else {
            let bit = 1u64 << x.id
            if (mask & bit) != 0 {
                valid = false
            }
            mask |= bit
        }
    }
    let _ = stdout.write(t.out, if valid && mask == (1u64 << t.count) - 1 {
        "ok"
    } else {
        "bad"
    })
}

// Stable sorted: keys never decrease and ids rise within a key.
fn merge_fail_at(out: Stdout, count: u64, failure: u64) -> bool {
    let mut xs: List[SortItem] = list.new()
    for i in 0u64 .. count {
        result.unwrap(list.push(mut xs, result.unwrap(SortItem(out: out, id: i, key: merge_key(count, i)))))
    }
    let mut audit = result.unwrap(MergeAudit(out: out, values: take xs, count: count))
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut audit.values, fn(a: SortItem, b: SortItem) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a.key < b.key {
            Less
        } else if a.key > b.key {
            Greater
        } else {
            Equal
        }
    }))
    let mut sorted = true
    for i in 1u64 .. count {
        let (ak, ai) = (audit.values[i - 1].key, audit.values[i - 1].id)
        let (bk, bi) = (audit.values[i].key, audit.values[i].id)
        if ak > bk || (ak == bk && ai > bi) {
            sorted = false
        }
    }
    sorted
}

// Host-free twin: the evaluator checks scratch and source live slots on failure.
fn merge_plain_fail_at(count: u64, failure: u64) -> bool {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. count {
        result.unwrap(list.push(mut xs, merge_key(count, i)))
    }
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a < b {
            Less
        } else if a > b {
            Greater
        } else {
            Equal
        }
    }))
    let mut sorted = list.len(xs) == count
    for i in 1u64 .. count {
        if xs[i - 1] > xs[i] {
            sorted = false
        }
    }
    sorted
}

fn twenty_fail_at(out: Stdout, failure: u64) -> bool {
    merge_fail_at(out, 20, failure)
}

fn twenty_plain_fail_at(failure: u64) -> bool {
    merge_plain_fail_at(20, failure)
}

// The four runs are ascending, with the second preceding the first and the
// last two interleaved. Powersort detects three runs, merges the first pair
// into scratch, then detects the fourth run. Calls 69-72 begin the second
// merge into scratch, selecting right, left, right. Failure on call 73
// leaves holes in both input runs while the first pair is still in scratch.
// expect: stdout "okXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
// expect: run failure_after_completed_pair(out) = fail Unwrap
fn failure_after_completed_pair(out: Stdout) -> bool {
    merge_fail_at(out, 52, 73)
}

// expect: run plain_failure_after_completed_pair() = fail Unwrap
fn plain_failure_after_completed_pair() -> bool {
    merge_plain_fail_at(52, 73)
}

// The second merge exhausts its right run on call 76. The root check
// on call 77 sees both complete runs in scratch before starting its merge.
// expect: stdout "okXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
// expect: run failure_at_final_merge_check(out) = fail Unwrap
fn failure_at_final_merge_check(out: Stdout) -> bool {
    merge_fail_at(out, 52, 77)
}

// expect: run plain_failure_at_final_merge_check() = fail Unwrap
fn plain_failure_at_final_merge_check() -> bool {
    merge_plain_fail_at(52, 77)
}


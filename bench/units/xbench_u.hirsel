// mc-units-untied crossing microbenchmarks (16-bit unit addresses). Crossing
// modes run under HIRSEL_UNTIED=W HIRSEL_UNITS=K; the launcher appends the
// unit id, K and the unit's role to the arguments.
const TASK_BYTES: u64 = 65536

fn kernel(seed: u64, rounds: u64) -> u64 {
    let mut x = seed
    for _ in 0 .. rounds {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
    }
    x
}

fn arg(argv: Args, i: u64) -> u64 {
    let Some(v) = args.get(argv, i) else { fail("missing argument") }
    result.unwrap(int.parse(v))
}

fn unit_addr(unit: u64, port: u16) -> Addr {
    let lo: u32 = int.truncate(unit)
    Addr(ip: V4(0x7f4d0000 | lo), port: port)
}

fn connect_retry(nw: Net, clock: Clock, a: Addr) -> Socket waits {
    loop {
        match host.connect(nw, a, Never) {
            Ok(take s) => return take s,
            Error(_) => host.sleep_until(clock, host.mono_ns(clock) + 200000),
        }
    }
}

fn payload(size: u64, seed: u64) -> Bytes {
    let mut b: Bytes = result.unwrap(list.with_capacity(size))
    for i in 0 .. size {
        result.unwrap(list.push(mut b, int.truncate(i * 31 + seed)))
    }
    b
}

fn send_all(mut w: WriteHalf, b: Bytes) waits {
    let n = result.unwrap(host.send_pair(mut w, b, string.as_bytes(""), Never))
    if n != list.len(b) { fail("short crossing send") }
}

// Receive exactly `size` bytes into buf (cleared first). Returns false at end.
fn recv_exact(mut r: ReadHalf, mut buf: Bytes, size: u64) -> bool waits {
    list.clear(mut buf)
    while list.len(buf) < size {
        let want = size - list.len(buf)
        let got = result.unwrap(host.recv_bounded(mut r, mut buf, want, Never))
        if got == 0 { return false }
    }
    true
}

fn report(err: Stderr, name: String, n: u64, ns: u64, check: u64) waits {
    let mut line = string.new()
    result.unwrap(string.push(mut line, name))
    result.unwrap(string.push(mut line, " n="))
    result.unwrap(string.push_u64(mut line, n))
    result.unwrap(string.push(mut line, " ns="))
    result.unwrap(string.push_u64(mut line, ns))
    result.unwrap(string.push(mut line, " check="))
    result.unwrap(string.push_u64(mut line, check))
    result.unwrap(string.push(mut line, "\n"))
    result.unwrap(stderr.write(err, line))
}

// ---- crossing request/reply: unit 0 asks, unit 1 echoes (first byte + 1).
fn x_echo(nw: Net, n: u64, size: u64) waits {
    let (take l, _) = result.unwrap(host.listen(nw, unit_addr(1, 1), 16))
    let mut listener = take l
    let (take s, _) = result.unwrap(host.accept(mut listener, Never))
    let (rh, wh) = net.split(take s)
    let mut r = take rh
    let mut w = take wh
    let mut buf: Bytes = result.unwrap(list.with_capacity(size))
    for _ in 0 .. n {
        if !recv_exact(mut r, mut buf, size) { fail("echo: closed") }
        let first: u8 = buf[0]
        let _ = list.set(mut buf, 0, int.wrapping_add(first, 1u8))
        send_all(mut w, buf)
    }
}

fn x_ask(nw: Net, clock: Clock, err: Stderr, n: u64, size: u64) waits {
    let s = connect_retry(nw, clock, unit_addr(1, 1))
    let (rh, wh) = net.split(take s)
    let mut r = take rh
    let mut w = take wh
    let mut req = payload(size, 7)
    let mut buf: Bytes = result.unwrap(list.with_capacity(size))
    let mut check = 0u64
    let started = host.mono_ns(clock)
    for i in 0 .. n {
        let _ = list.set(mut req, 0, int.truncate(i))
        send_all(mut w, req)
        if !recv_exact(mut r, mut buf, size) { fail("ask: closed") }
        let got: u8 = buf[0]
        if got != int.wrapping_add(int.truncate(i), 1u8) { fail("ask: bad reply") }
        check = int.wrapping_add(check, int.widen(got))
    }
    report(err, "x_pingpong", n, host.mono_ns(clock) - started, check)
}

// ---- crossing pipelined request/reply: a writer task keeps the ring full.
type Writer: send {
    w: WriteHalf,
    n: u64,
    size: u64,
}

fn writer(take job: Writer) -> () waits {
    let Writer(w: take wh, n: n, size: size) = take job
    let mut w = take wh
    let mut req = payload(size, 7)
    for i in 0 .. n {
        let _ = list.set(mut req, 0, int.truncate(i))
        send_all(mut w, req)
    }
}

fn x_pipe(tasks: Tasks, nw: Net, clock: Clock, err: Stderr, n: u64, size: u64) waits {
    let s = connect_retry(nw, clock, unit_addr(1, 1))
    let (rh, wh) = net.split(take s)
    let mut r = take rh
    let mut buf: Bytes = result.unwrap(list.with_capacity(size))
    let started = host.mono_ns(clock)
    let h = result.unwrap(task.spawn(tasks, bytes TASK_BYTES, Writer(w: take wh, n: n, size: size), writer))
    let mut check = 0u64
    for i in 0 .. n {
        if !recv_exact(mut r, mut buf, size) { fail("pipe: closed") }
        let got: u8 = buf[0]
        if got != int.wrapping_add(int.truncate(i), 1u8) { fail("pipe: bad reply") }
        check = int.wrapping_add(check, int.widen(got))
    }
    result.unwrap(task.join(take h))
    report(err, "x_pipe", n, host.mono_ns(clock) - started, check)
}

// ---- crossing fan-in: units 1..K-1 each send n messages to unit 0.
type Drain: send {
    r: ReadHalf,
    n: u64,
    size: u64,
    grain: u64,
}

fn drain(take job: Drain) -> u64 waits {
    let Drain(r: take rh, n: n, size: size, grain: grain) = take job
    let mut r = take rh
    let mut buf: Bytes = result.unwrap(list.with_capacity(size))
    let mut sum = 0u64
    for _ in 0 .. n {
        if !recv_exact(mut r, mut buf, size) { fail("drain: closed") }
        let b: u8 = buf[0]
        sum = int.wrapping_add(sum, kernel(int.widen(b), grain) & 0xff)
    }
    sum
}

fn x_sink(tasks: Tasks, nw: Net, clock: Clock, err: Stderr, n: u64, size: u64, producers: u64, grain: u64) waits {
    let (take l, _) = result.unwrap(host.listen(nw, unit_addr(0, 2), 128))
    let mut listener = take l
    let mut jobs: List[Task[u64]] = list.new()
    let mut writers: List[WriteHalf] = list.new()
    let mut started = 0u64
    for p in 0 .. producers {
        let (take s, _) = result.unwrap(host.accept(mut listener, Never))
        if p == 0 { started = host.mono_ns(clock) }
        let (rh, wh) = net.split(take s)
        result.unwrap(list.push(mut writers, take wh))
        result.unwrap(list.push(mut jobs, result.unwrap(task.spawn(tasks, bytes TASK_BYTES, Drain(r: take rh, n: n, size: size, grain: grain), drain))))
    }
    let mut check = 0u64
    while let Some(take h) = list.pop(mut jobs) {
        check = int.wrapping_add(check, result.unwrap(task.join(take h)))
    }
    report(err, "x_fanin", n * producers, host.mono_ns(clock) - started, check)
}

fn x_source(nw: Net, clock: Clock, n: u64, size: u64) waits {
    let s = connect_retry(nw, clock, unit_addr(0, 2))
    let (_, wh) = net.split(take s)
    let mut w = take wh
    let mut req = payload(size, 7)
    for i in 0 .. n {
        let _ = list.set(mut req, 0, int.truncate(i))
        send_all(mut w, req)
    }
}

// ---- local channel shapes inside one run.
type Echo: send {
    input: Receiver[Bytes],
    output: Sender[Bytes],
    n: u64,
}

fn c_echo(take job: Echo) -> () waits {
    for _ in 0 .. job.n {
        let mut b = result.unwrap(channel.receive(job.input))
        let first: u8 = b[0]
        let _ = list.set(mut b, 0, int.wrapping_add(first, 1u8))
        result.unwrap(channel.send(job.output, take b))
    }
}

// cap 1: ping-pong; cap > 1 with a writer task: pipelined.
fn c_pingpong(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64) waits {
    let (tx, rx): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1))
    let (out, back): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1))
    let h = result.unwrap(task.spawn(tasks, bytes TASK_BYTES, Echo(input: take rx, output: take out, n: n), c_echo))
    let req = payload(size, 7)
    let mut check = 0u64
    let started = host.mono_ns(clock)
    for i in 0 .. n {
        // A fresh owned copy per message, as a crossing copies.
        let mut m: Bytes = result.unwrap(list.with_capacity(size))
        result.unwrap(list.append(mut m, req))
        let _ = list.set(mut m, 0, int.truncate(i))
        result.unwrap(channel.send(tx, take m))
        let b = result.unwrap(channel.receive(back))
        let got: u8 = b[0]
        if got != int.wrapping_add(int.truncate(i), 1u8) { fail("c_pingpong: bad reply") }
        check = int.wrapping_add(check, int.widen(got))
    }
    result.unwrap(task.join(take h))
    report(err, "c_pingpong", n, host.mono_ns(clock) - started, check)
}

type Feed: send {
    output: Sender[Bytes],
    n: u64,
    size: u64,
}

fn feed(take job: Feed) -> () waits {
    let req = payload(job.size, 7)
    for i in 0 .. job.n {
        let mut m: Bytes = result.unwrap(list.with_capacity(job.size))
        result.unwrap(list.append(mut m, req))
        let _ = list.set(mut m, 0, int.truncate(i))
        result.unwrap(channel.send(job.output, take m))
    }
}

fn c_pipe(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64, depth: u64) waits {
    let (tx, rx): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(depth))
    let (out, back): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(depth))
    let started = host.mono_ns(clock)
    // In-flight messages are charged to the tasks that allocated them.
    let budget = TASK_BYTES + 4 * depth * (size + 64)
    let e = result.unwrap(task.spawn(tasks, bytes budget, Echo(input: take rx, output: take out, n: n), c_echo))
    let f = result.unwrap(task.spawn(tasks, bytes budget, Feed(output: take tx, n: n, size: size), feed))
    let mut check = 0u64
    for i in 0 .. n {
        let b = result.unwrap(channel.receive(back))
        let got: u8 = b[0]
        if got != int.wrapping_add(int.truncate(i), 1u8) { fail("c_pipe: bad reply") }
        check = int.wrapping_add(check, int.widen(got))
    }
    result.unwrap(task.join(take f))
    result.unwrap(task.join(take e))
    report(err, "c_pipe", n, host.mono_ns(clock) - started, check)
}

fn c_fanin(tasks: Tasks, clock: Clock, err: Stderr, n: u64, size: u64, producers: u64, grain: u64) waits {
    let (tx, rx): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(64))
    let started = host.mono_ns(clock)
    let mut jobs: List[Task[()]] = list.new()
    for _ in 0 .. producers {
        result.unwrap(list.push(mut jobs, result.unwrap(task.spawn(tasks, bytes TASK_BYTES, Feed(output: channel.sender(tx), n: n, size: size), feed))))
    }
    let mut check = 0u64
    for _ in 0 .. n * producers {
        let b = result.unwrap(channel.receive(rx))
        let got: u8 = b[0]
        check = int.wrapping_add(check, kernel(int.widen(got), grain) & 0xff)
    }
    while let Some(take h) = list.pop(mut jobs) {
        result.unwrap(task.join(take h))
    }
    report(err, "c_fanin", n * producers, host.mono_ns(clock) - started, check)
}

// ---- replay demo: unit 0 folds messages from two ports in arrival order.
type Forward: send {
    r: ReadHalf,
    out: Sender[u64],
    n: u64,
}

fn forward(take job: Forward) -> () waits {
    let Forward(r: take rh, out: out, n: n) = take job
    let mut r = take rh
    let mut buf: Bytes = result.unwrap(list.with_capacity(8))
    for _ in 0 .. n {
        if !recv_exact(mut r, mut buf, 8) { fail("svc: closed") }
        result.unwrap(channel.send(out, list.word_le(buf, 0)))
    }
}

fn x_svc(tasks: Tasks, nw: Net, err: Stderr, n: u64) waits {
    let (take l, _) = result.unwrap(host.listen(nw, unit_addr(0, 3), 16))
    let mut listener = take l
    let (tx, rx): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(4096))
    let mut jobs: List[Task[()]] = list.new()
    for _ in 0 .. 2u64 {
        let (take s, _) = result.unwrap(host.accept(mut listener, Never))
        let (rh, _) = net.split(take s)
        result.unwrap(list.push(mut jobs, result.unwrap(task.spawn(tasks, bytes TASK_BYTES, Forward(r: take rh, out: channel.sender(tx), n: n), forward))))
    }
    let mut state = 1u64
    let mut order = 0u64
    for i in 0 .. 2 * n {
        let v = result.unwrap(channel.receive(rx))
        state = kernel(state ^ v, 3)
        // Count how often the source port changes: an arrival-order witness.
        if i > 0 && (v >> 32) != order { state = int.wrapping_add(state, 1) }
        order = v >> 32
    }
    join_units(take jobs)
    report(err, "x_svc", 2 * n, 0, state)
}

fn join_units(take pending: List[Task[()]]) waits {
    let mut jobs = take pending
    while let Some(take h) = list.pop(mut jobs) {
        result.unwrap(task.join(take h))
    }
}

fn x_client(nw: Net, clock: Clock, unit: u64, n: u64) waits {
    let s = connect_retry(nw, clock, unit_addr(0, 3))
    let (_, wh) = net.split(take s)
    let mut w = take wh
    let mut b: Bytes = result.unwrap(list.with_capacity(8))
    for i in 0 .. n {
        list.clear(mut b)
        result.unwrap(list.put_word_le(mut b, (unit << 32) | i))
        send_all(mut w, b)
    }
}

pub fn main(tasks: Tasks, nw: Net, clock: Clock, err: Stderr, argv: Args) -> Result[(), Exit] waits {
    let Some(mode) = args.get(argv, 0) else { return Error(Exit(status: 2)) }
    let n = arg(argv, 1)
    let size = arg(argv, 2)
    if mode == "c_pingpong" {
        c_pingpong(tasks, clock, err, n, size)
        return Ok(())
    }
    if mode == "c_pipe" {
        c_pipe(tasks, clock, err, n, size, arg(argv, 3))
        return Ok(())
    }
    if mode == "c_fanin" {
        c_fanin(tasks, clock, err, n, size, arg(argv, 3), arg(argv, 4))
        return Ok(())
    }
    let count = args.len(argv)
    let unit = arg(argv, count - 3)
    let units = arg(argv, count - 2)
    if mode == "x_pingpong" {
        if unit == 1 { x_echo(nw, n, size) } else { x_ask(nw, clock, err, n, size) }
    } else if mode == "x_pipe" {
        if unit == 1 { x_echo(nw, n, size) } else { x_pipe(tasks, nw, clock, err, n, size) }
    } else if mode == "x_svc" {
        if unit == 0 { x_svc(tasks, nw, err, n) } else { x_client(nw, clock, unit, n) }
    } else if mode == "x_fanin" {
        if unit == 0 { x_sink(tasks, nw, clock, err, n, size, units - 1, arg(argv, 3)) } else { x_source(nw, clock, n, size) }
    } else {
        return Error(Exit(status: 2))
    }
    Ok(())
}

// Shared port entry. The application supplies a direct match/if dispatcher, not a table
// of callable constants. A task prepares once, warms up and runs on the same state.
pub fn main(out:Stdout,d:Dir,argv:Args,
    dispatch:scoped fn(String,String,u64,u64)->Result[u32,helper.Error])->Result[(),Exit] waits {
    main_wait(out,d,argv,dispatch)
}

// Waiting dispatchers may borrow Tasks or other capabilities from their main.
pub fn main_wait(out:Stdout,d:Dir,argv:Args,
    dispatch:scoped fn(String,String,u64,u64)->Result[u32,helper.Error] waits)->Result[(),Exit] waits {
    match execute(out,d,argv,dispatch) {
        Ok(())=>Ok(()),
        Error(_)=>Error(Exit(status:1)),
    }
}
fn execute(out:Stdout,d:Dir,argv:Args,
    dispatch:scoped fn(String,String,u64,u64)->Result[u32,helper.Error] waits)->Result[(),helper.Error] waits {
    let Some(path)=args.get(argv,0) else {return Error(Config)}
    let Some(name)=args.get(argv,1) else {return Error(Config)}
    let config=match std.file.read_string(d,path) {Ok(take s)=>take s,Error(_)=>return Error(Config)}
    let count=helper.config_i64(config,name,"iterations")?
    let expected=helper.config_i64(config,name,"checksum")?
    if count<0 || expected<0 || expected>4294967295 {return Error(Config)}
    let iterations:u64=int.narrow(count)
    let warmup:u64=match helper.config_i64(config,name,"warmup_iterations") {
        Ok(n)=>if n<0 {return Error(Config)} else {int.narrow(n)},
        Error(Config)=>default_warmup(iterations),
        Error(take e)=>return Error(take e),
    }
    let actual=dispatch(config,name,warmup,iterations)?
    let observed:i64=int.widen(actual)
    let actual_word:u64=int.widen(actual)
    let expected_word:u64=int.narrow(expected)
    let expected_code:u32=int.narrow(expected)
    let mut line=helper.mem(string.from(name))?
    helper.mem(string.push(mut line," checksum="))?
    helper.mem(string.push_u64(mut line,actual_word))?
    helper.mem(string.push(mut line," expected="))?
    helper.mem(string.push_u64(mut line,expected_word))?
    helper.mem(string.push(mut line,if observed==expected {" status=OK\n"} else {" status=ERR\n"}))?
    match stdout.write(out,line) {Ok(())=>{},Error(e)=>return Error(Io(e.error))}
    if observed==expected {Ok(())} else {Error(Checksum(actual,expected_code))}
}

fn default_warmup(iterations:u64)->u64 {
    let count:f64=float.from_int(iterations)
    let converted:Result[u64,FloatError]=float.to_int(count*0.2)
    let n=result.unwrap(converted)
    if n>0 {n} else {1}
}

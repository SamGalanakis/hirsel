// jwtbind's laws (RUNNER-SPEC §15.10). Every token below was signed by openssl (ES256, P-256
// keys k1 and k2) and joined by Python, once; the expected answers come from the claims written
// beside them and §15.3's arithmetic, never from std.jwt's output. Claims, all tokens:
//   iss "https://issuer.example", aud "place-a", sub "user-42", exp E = 1767225600, kid k1,
// except: T_LATER exp E + 3600; T_NO_SUB no sub; T_EMPTY_SUB sub ""; T_LONG_SUB sub "a" × 65;
// T_MAX_SUB sub "a" × 64; T_OTHER_ISS iss "https://other.example"; T_OTHER_AUD aud "place-b";
// T_TYP_JWT header typ "JWT"; T_TYP_AT header typ "at+jwt"; T_K2 kid k2, signed by k2;
// T_HUGE_EXP exp 18446744073709551; T_BAD_SIG is T_BASE's header and payload with T_LATER's
// signature.
const T_BASE: String = "eyJhbGciOiJFUzI1NiIsImtpZCI6ImsxIn0.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwiYXVkIjoicGxhY2UtYSIsInN1YiI6InVzZXItNDIiLCJleHAiOjE3NjcyMjU2MDB9.5VNma27IApbMZow7GmJGQ8-mVFVviM9D3pLmWs6gXeMvot1bGbSfMyjsMDV3gezBvbWeWVg0xinafCCWgyMd5A"


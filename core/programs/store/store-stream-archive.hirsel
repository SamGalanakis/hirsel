fn settle_worker_sealed(take lane: ObjectJournalSession, group_bytes: u64, group_commits: u64) -> (ObjectJournalSession, Result[host_stream.SettleOutcome, Error]) waits {
    let (take settled, take result) = with_object_settle(take lane, scoped fn(mut state: host_stream.SettleView) -> Result[host_stream.SettleOutcome, Error] waits {
        failure_result_from_rep(host_stream.stream_settle_sealed(mut state, group_bytes, group_commits))
    })
    if let Ok(SettleApplied) = result {
        if let Some(link) = view settled.stream {
            host_stream.slot_report_head(link, history.register_head(settled.register).store, history.register_attach(settled.register), host_stream.slot_last_batch(link))
        }
    }
    (take settled, take result)
}

pub fn journal_input(take file: HostFile, flush: bool) -> Result[format.JournalInput, types.Failure] waits {
    journal_input_with_deadline(take file, flush, None)
}

pub fn journal_input_with_deadline(take file: HostFile, flush: bool, deadline: Option[(Clock, u64)]) -> Result[format.JournalInput, types.Failure] waits {
    format.open_journal_input(take file, flush, deadline, fn() -> Result[Bytes, types.Failure] {
        manifest.disk_allocation(fn() -> Result[Bytes, types.Failure] {
            Ok(list.with_capacity(JOURNAL_CHUNK_BYTES))
        })
    })
}

pub type JournalRecovered {
    replay: pager.JournalReplay,
    seq: u64,
    end: u64,
    uncovered: u64
}

// A live reader may stat before the writer extends the file and then read a
// newer END or successor. The boundary names bytes the writer synced, so the
// handle's current size covers it unless the file is damaged.
pub fn journal_refresh_size(mut input: format.JournalInput, boundary: Option[u64]) -> Result[(), types.Failure] waits {
    format.refresh_journal_size(mut input, boundary)
}

pub fn journal_apply_fork(file: String, mut replay: pager.JournalReplay, take encoded: format.JournalFork) -> Result[(), types.Failure] {
    let format.JournalFork(id: id, parent: parent, forked_at: forked_at, name: take name, watermark: watermark) = take encoded
    if id < replay.state.next_branch || id == 4294967295 || map.contains(replay.names, name) {
        return Error(format.disk_fault(file, 0, Malformed))
    }
    let (take roots, at, take key) = manifest.disk_allocation(scoped fn() -> Result[(pages.Roots, u64, String), types.Failure] {
        for source in replay.state.tips {
            if source.id != parent {
                continue
            }
            if source.head != forked_at {
                return Error(format.disk_fault(file, 0, Malformed))
            }
            let mut roots = pages.share_roots(source.roots)
            if let Some(layer) = view source.roots.collections.replay {
                roots.collections.replay = Some(arc.new(pages.ReplayBranch(collections: clone(layer.collections), fork_time: Some(clone(layer.collections)), ids: layer.ids, charged: layer.charged)))
            }
            return Ok((take roots, source.at, string.from(name)))
        }
        Error(format.disk_fault(file, 0, Malformed))
    })?
    let charge = manifest.branch_root_bytes(name, roots)
    if charge > replay.limits.meta - replay.record_bytes {
        return Error(format.disk_fault(file, 0, Malformed))
    }
    types.capacity(list.try_reserve(mut replay.state.tips, 1))?
    types.capacity(list.try_reserve(mut replay.forked, 1))?
    types.capacity(map.try_reserve(mut replay.names, 1))?
    map.insert(mut replay.names, take key, id)
    list.push(mut replay.state.tips, pages.Tip(id: id, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: forked_at, at: at))
    replay.record_bytes += charge
    list.push(mut replay.forked, manifest.LineageFork(child: id, parent: parent, watermark: watermark, adopted: false))
    replay.state.next_branch = id + 1
    replay.next_node = order.max(replay.next_node, watermark - 1)
    replay.tiered.exact = false
    Ok(())
}

pub type CaptureSegment {
    file: HostFile,
    seq: u64,
    boundary: Option[u64]
}

pub type CaptureWalk {
    segments: List[CaptureSegment],
    end_image: Option[Bytes],
    torn_tail: bool
}

pub fn capture_end_image(d: Dir, seq: u64) -> Result[Option[Bytes], types.Failure] waits {
    let path = manifest.journal_path(seq, ".end")?
    match manifest.disk_read_file(d, path, 96 + 1048576) {
        Ok(take raw) => Ok(Some(take raw)),
        Error(Io(NotFound)) => Ok(None),
        Error(Io(Other(5))) => Ok(None),
        Error(Corrupt(_)) => Ok(None),
        Error(take problem) => Error(take problem),
    }
}

pub fn capture_end(id: types.StoreKey, seq: u64, raw: Option[Bytes]) -> Result[Option[u64], types.Failure] {
    if let Some(image) = raw {
        let path = manifest.journal_path(seq, ".end")?
        match disk_read_end(path, id, seq, image) {
            Ok(at) => Ok(Some(at)),
            Error(Corrupt(_)) => Ok(None),
            Error(take problem) => Error(take problem),
        }
    } else {
        Ok(None)
    }
}

// Hold the descriptions walked so a cut cannot substitute a file between
// its checked HEADER or END and the scan. No fence is taken during the walk.
pub fn capture_walk(d: Dir, id: types.StoreKey, first: u64, restarted: bool) -> Result[Option[CaptureWalk], types.Failure] waits {
    let mut seen: List[CaptureSegment] = list.new()
    let mut terminal_image: Option[Bytes] = None
    let mut seq = first
    loop {
        let path = manifest.journal_path(seq, "")?
        let mut file = match host.open(d, path, Read) {
            Ok(take opened) => take opened,
            Error(NotFound) if seq != first => break,
            Error(NotFound) => return Error(format.disk_fault(path, 0, Header)),
            Error(problem) => return Error(Io(problem)),
        }
        let image = capture_end_image(d, seq)?
        let boundary_read = capture_end(id, seq, image)?
        let header_read = manifest.read_disk_bytes(mut file, path, 0, 72)
        let parsed_header = match take header_read {
            Ok(take head_bytes) => manifest.disk_read_header(path, head_bytes, 2, Some(seq), Some(id)),
            Error(take problem) => Error(take problem),
        }
        let header = match take parsed_header {
            Ok(found) => found,
            Error(Corrupt(take problem)) => {
                let successor = manifest.journal_path(seq + 1, "")?
                if disk_exists(d, successor)? {
                    if !restarted {
                        return Ok(None)
                    }
                    return Error(Corrupt(take problem))
                }
                if let Some(_) = boundary_read {
                    return Error(Corrupt(take problem))
                }
                break
            },
            Error(take problem) => return Error(take problem),
        }
        let segment_count = list.len(seen)
        if segment_count != 0 {
            seen[segment_count - 1].boundary = Some(header.prev_end)
        }
        list.push(mut seen, CaptureSegment(file: take file, seq: seq, boundary: boundary_read))
        terminal_image = take image
        seq += 1
    }
    Ok(Some(CaptureWalk(segments: take seen, end_image: take terminal_image, torn_tail: true)))
}

pub fn capture_lock_free(d: Dir) -> Result[bool, types.Failure] waits {
    let mut probe = match host.open(d, "LOCK", Read) {
        Ok(take file) => take file,
        Error(NotFound) => return Ok(true),
        Error(problem) => return Error(Io(problem)),
    }
    let free = manifest.disk_io(host.try_lock_shared(mut probe))?
    if free {
        manifest.disk_io(host.unlock(mut probe))?
    }
    manifest.disk_io(host.close(take probe))?
    Ok(free)
}

pub fn capture_fence(d: Dir, c: Clock, deadline: u64, mut walk: CaptureWalk) -> Result[(), types.Failure] waits {
    let segment_count = list.len(walk.segments)
    if segment_count == 0 {
        return Ok(())
    }
    loop {
        if manifest.disk_io(host.try_lock_shared(mut walk.segments[segment_count - 1].file))? {
            return Ok(())
        }
        if !capture_lock_free(d)? {
            walk.torn_tail = false
            return Ok(())
        }
        let now = host.mono_ns(c)
        if now >= deadline {
            return Error(Remote(Retriable(Deadline)))
        }
        host.sleep_until(c, order.min(deadline, int.saturating_add(now, 1000000)))
    }
}

pub fn journal_sorted_run(ops: List[format.JournalOp], start: u64) -> u64 {
    let collection = list.slice(ops[start].key, 0, 4)
    let mut end = start + 1
    while end < list.len(ops) {
        let op = view ops[end]
        if let Some(_) = op.trim {
            break
        }
        if list.len(op.key) < 4 || list.slice(op.key, 0, 4) != collection || list.compare_bytes(ops[end - 1].key, op.key) != Less {
            break
        }
        end += 1
    }
    end
}

pub fn journal_collection_batch(file: String, mut tree: pages.PageTree, ops: List[format.JournalOp], start: u64, end: u64, mut draw: u64) -> Result[(), types.Failure] {
    let collection = list.slice(ops[start].key, 0, 4)
    match pages.apply_collection_batch(mut tree, collection, ops, visit_journal_edit, start, end, 0, mut draw) {
        Ok(()) => Ok(()),
        Error(MalformedPage) => Error(format.disk_fault(file, 0, Malformed)),
        Error(problem) => Error(pages.page_error(problem)),
    }
}

pub fn visit_journal_edit(ops: List[format.JournalOp], slot: u64, visit: scoped fn(std.page.SourceEdit) -> Result[(), std.page.Error]) -> Result[(), std.page.Error] {
    let op = view ops[slot]
    let value: Option[(View[Bytes], Option[View[Arc[Bytes]]])] = match view op.value {
        Some(raw) => Some((raw, None)),
        None => None,
    }
    visit(std.page.SourceEdit(key: list.slice(op.key, 4, list.len(op.key)), value: value, prior: Some(op.prior)))
}

pub fn journal_collection_empty(file: String, mut tree: pages.PageTree, ops: List[format.JournalOp], start: u64, end: u64, mut draw: u64) -> Result[(), types.Failure] {
    let mut has_put = false
    for slot in start .. end {
        let op = view ops[slot]
        if op.prior != 0 {
            return Error(format.disk_fault(file, 0, Malformed))
        }
        if let Some(_) = view op.value {
            has_put = true
        }
    }
    if !has_put {
        return Ok(())
    }
    journal_collection_batch(file, mut tree, ops, start, end, mut draw)
}

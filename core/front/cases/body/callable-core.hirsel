// Adapters expose core operations with the same generic callable convention.
// expect: run sum() = 8
// expect: run count() = 0
// push is expanded in place where called; taken as a value it is still one
// callable: len 1 and the element 5.
// expect: run pushed() = 15
fn sum() -> u8 {
    let cb: fn(u8, u8) -> u8 = int.wrapping_add
    cb(251, 13)
}

fn count() -> u64 {
    let cb: fn(List[u64]) -> u64 = list.len
    let xs: List[u64] = list.new()
    cb(xs)
}

fn pushed() -> u64 {
    let cb: fn(mut List[u64], take u64) = list.push
    let mut xs: List[u64] = list.new()
    let x: u64 = 5
    cb(mut xs, take x)
    list.len(xs) * 10 + xs[0]
}

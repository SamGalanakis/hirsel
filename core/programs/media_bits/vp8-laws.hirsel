fn check_rfc_examples() {
    // RFC 7741 §4.6 leaves the codec bytes symbolic. These prefixes supply P
    // and arbitrary remaining bytes, including a clear low bit in fragments.
    // A keyframe carries the RFC 6386 §9.1 start code and four dimension bytes.
    let mut key = b"\x90\x80\x11\x10\x00\x00\x9d\x01\x2a\x00\x00\x00\x00"
    let descriptor = result.unwrap(vp8.parse(key))
    if let Some(ShortId(17)) = descriptor.picture_id {} else {
        fail("RFC §4.6.1 PictureID 17")
    }
    if !descriptor.extended || !descriptor.first || !descriptor.keyframe || descriptor.payload_start != 3 || descriptor.non_reference {
        fail("RFC §4.6.1 keyframe")
    }
    result.unwrap(vp8.rewrite_picture_id(mut key, 127))
    if let Error(PictureIdTooLarge) = vp8.rewrite_picture_id(mut key, 128) {} else {
        fail("seven-bit PictureID accepted 128")
    }
    if list.compare_bytes(key, b"\x90\x80\x7f\x10\x00\x00\x9d\x01\x2a\x00\x00\x00\x00") != Equal {
        fail("short PictureID rewrite changed another byte")
    }
    let inter = result.unwrap(vp8.parse(b"\x10\x11\x00\x00"))
    if inter.extended || !inter.first || inter.keyframe || inter.non_reference || inter.payload_start != 1 {
        fail("RFC §4.6.2 non-discardable interframe")
    }
    if let Some(_) = inter.picture_id {
        fail("RFC §4.6.2 PictureID must be absent")
    }
    let first = result.unwrap(vp8.parse(b"\x90\x80\x11\x11\x00\x00"))
    let partition = result.unwrap(vp8.parse(b"\x91\x80\x11\x00"))
    let continuation = result.unwrap(vp8.parse(b"\x81\x80\x11\x00"))
    if !first.first || first.keyframe || !partition.partition_start || partition.partition != 1 || partition.first || partition.keyframe || continuation.partition_start || continuation.partition != 1 || continuation.first || continuation.keyframe {
        fail("RFC §§4.6.3–4.6.4 partition boundaries")
    }
    let mut long = b"\x90\x80\x92\x67\x11\x00\x00"
    let wide = result.unwrap(vp8.parse(long))
    if let Some(LongId(4711)) = wide.picture_id {} else {
        fail("RFC §4.6.5 PictureID 4711")
    }
    result.unwrap(vp8.rewrite_picture_id(mut long, 0))
    if let Error(PictureIdTooLarge) = vp8.rewrite_picture_id(mut long, 32768) {} else {
        fail("fifteen-bit PictureID accepted 32768")
    }
    if list.compare_bytes(long, b"\x90\x80\x80\x00\x11\x00\x00") != Equal || wide.payload_start != 4 {
        fail("long PictureID wrap changed the encoded width")
    }
}

fn check_capture() {
    // Decrypted RTP payload prefixes, Chromium 151.0.7922.10, VP8 L1T2.
    // SSRC 2440695892, sequence 32412 and 32435, same timestamp.
    let key = b"\x90\xe0\xf8\x61\xef\x20\xd0\x87\x00\x9d\x01\x2a\x80\x02\x68\x01"
    let last = b"\x80\xe0\xf8\x61\xef\x20\x0a\x58\xd3"
    let first = result.unwrap(vp8.parse(key))
    let continuation = result.unwrap(vp8.parse(last))
    if let Some(LongId(30817)) = first.picture_id {} else {
        fail("Chromium keyframe PictureID")
    }
    if !first.first || !first.keyframe || first.payload_start != 6 || first.tl0picidx != Some(239u8) || first.temporal != Some(0u8) || !first.layer_sync || continuation.first || continuation.keyframe || continuation.partition != 0 {
        fail("Chromium fragmented keyframe")
    }
    // Sequence 32436: N=1, PictureID + 1, same TL0PICIDX, TID=1, Y=1,
    // K=0 despite the shared extension octet, P=1.
    let mut sync = b"\xb0\xe0\xf8\x62\xef\x60\x51\x2e\x00"
    let delta = result.unwrap(vp8.parse(sync))
    if let Some(LongId(30818)) = delta.picture_id {} else {
        fail("Chromium interframe PictureID")
    }
    if !delta.first || delta.keyframe || !delta.non_reference || delta.tl0picidx != Some(239u8) || delta.temporal != Some(1u8) || !delta.layer_sync || delta.payload_start != 6 || delta.key_index != None {
        fail("Chromium layer-sync interframe")
    }
    result.unwrap(vp8.rewrite_picture_id(mut sync, 257))
    result.unwrap(vp8.rewrite_tl0picidx(mut sync, 0))
    if list.compare_bytes(sync, b"\xb0\xe0\x81\x01\x00\x60\x51\x2e\x00") != Equal {
        fail("Chromium rewrite changed another byte")
    }
    for end in 0u64 .. 9u64 {
        if let Error(Truncated) = vp8.parse(list.slice(key, 0, end)) {} else {
            fail("truncated VP8 packet accepted")
        }
    }
}

fn check_extension_flags() {
    // §4.2 ignores reserved bits. K alone ignores TID but keeps Y.
    // T alone ignores KEYIDX.
    let key_only = result.unwrap(vp8.parse(b"\xd8\x1f\xff\x11\x00\x00"))
    if key_only.temporal != None || !key_only.layer_sync || key_only.key_index != Some(31u8) || key_only.partition != 0 || !key_only.first || key_only.payload_start != 3 {
        fail("KEYIDX without TID or reserved bits")
    }
    let mut no_id = b"\x90\x60\xff\x9f\x11\x00\x00"
    let layer_only = result.unwrap(vp8.parse(no_id))
    if layer_only.temporal != Some(2u8) || layer_only.layer_sync || layer_only.key_index != None || layer_only.tl0picidx != Some(255u8) {
        fail("TID without KEYIDX")
    }
    result.unwrap(vp8.rewrite_tl0picidx(mut no_id, 0))
    if list.compare_bytes(no_id, b"\x90\x60\x00\x9f\x11\x00\x00") != Equal {
        fail("TL0PICIDX offset without PictureID")
    }
    let mut all = b"\x90\xf0\x11\x7e\x7d\x11\x00\x00"
    let descriptor = result.unwrap(vp8.parse(all))
    if descriptor.temporal != Some(1u8) || !descriptor.layer_sync || descriptor.key_index != Some(29u8) || descriptor.tl0picidx != Some(126u8) || descriptor.payload_start != 5 {
        fail("TID and KEYIDX share one byte")
    }
    result.unwrap(vp8.rewrite_tl0picidx(mut all, 255))
    if list.compare_bytes(all, b"\x90\xf0\x11\xff\x7d\x11\x00\x00") != Equal {
        fail("TL0PICIDX offset after a short PictureID")
    }
    if let Error(InvalidDescriptor) = vp8.parse(b"\x90\x40\x00\x11\x00\x00") {} else {
        fail("TL0PICIDX without TID")
    }
}

fn check_target_layers() {
    // AV1 RTP §A.8.2. Offset 0, five targets. Template transitions are
    // next temporal, next temporal, next spatial, end. DTIs in wire order:
    // (0,0) R R R R N
    // (0,1) S N N D N
    // (0,2) D N N R N
    // (1,0) R N R N N
    // No frame diffs, chains, or resolutions. Target 0 takes its two maxima
    // from different templates. Target 4 retains the spec's zero defaults.
    let mut structure = dependency.empty()
    if dependency.target_layers(view structure, 0) != None {
        fail("decode target in an empty structure")
    }
    let _ = result.unwrap(dependency.parse(b"\xc0\x00\x01\x80\x04\x5b\xff\x20\x44\x33\x30\x00", mut structure))
    let expected: Inline[(u8, u8), 5] =[(1, 2), (0, 0), (1, 0), (0, 2), (0, 0)]
    for index in 0u64 .. 5u64 {
        if dependency.target_layers(view structure, index) != Some(expected[index]) {
            fail("AV1 decode target maps to the wrong layer")
        }
    }
    if dependency.target_layers(view structure, 5) != None {
        fail("decode target past the structure")
    }
}

/// bug: Misclassify a fragment as a VP8 keyframe, misread optional fields, corrupt a rewrite, or map AV1 decode targets by order.
/// oracle: RFC 7741 §4.6, hand-decoded Chromium VP8 RTP, and a hand-derived AV1 RTP §A.8.2 template table.
@test
fn vp8_descriptor_and_av1_targets() -> Result[(), ()] {
    check_rfc_examples()
    check_capture()
    check_extension_flags()
    check_target_layers()
    Ok(())
}

fn expect_unit(got: unit.Unit, start: bool, end: bool, keyframe: bool, needs: u32, switches: u32, take what: String) {
    if got.start != start || got.end != end || got.keyframe != keyframe || got.needs != needs || got.switches != switches {
        fail(take what)
    }
}

fn check_vp8_units() {
    // Chromium packet 32412: S=1, PID=0, TID 0, Y=1, P=0. A keyframe sets
    // every switch bit; TID 0 is needed by every target.
    let key = result.unwrap(unit.vp8(b"\x90\xe0\xf8\x61\xef\x20\xd0\x87\x00\x9d\x01\x2a\x80\x02\x68\x01", false))
    expect_unit(key, true, false, true, 0xffffffff, 0xffffffff, "VP8 keyframe unit")
    // Chromium packet 32436: TID 1, Y=1, P=1, the frame's last packet.
    // Targets 1 .. 31 need it, and Y allows target 1 only.
    let sync = result.unwrap(unit.vp8(b"\xb0\xe0\xf8\x62\xef\x60\x51\x2e\x00", true))
    expect_unit(sync, true, true, false, 0xfffffffe, 2, "VP8 layer-sync unit")
    // TID 2 without Y: targets 2 .. 31 need it, and nothing may switch.
    let upper = result.unwrap(unit.vp8(b"\x90\x60\xff\x9f\x11\x00\x00", false))
    expect_unit(upper, true, false, false, 0xfffffffc, 0, "VP8 TID 2 unit")
    // S=1, PID=0 and P=0 with 4 of the keyframe header's 10 bytes
    // (RFC 6386 §9.1): refused, so it is never a start.
    if let Ok(_) = unit.vp8(b"\x90\xe0\xf8\x61\xef\x20\xd0\x87\x00\x9d", false) {
        fail("VP8 truncated first partition taken as a start")
    }
}

fn check_vp9_units() {
    // RFC 9628 §4.2 flexible mode, I/L/F/B set, P=0, PID 5. Layer byte:
    // TID 0, U=1, SID 2, D=1. Targets 4*S+T with S >= 2 need it: bits 8 .. 15.
    let dependent = result.unwrap(unit.vp9_frame(b"\xb8\x05\x15\x82", false))
    // Current target 0 (S 0) never forwarded spatial layer 1, which D=1 references.
    expect_unit(result.unwrap(unit.vp9_unit(dependent, Some(0u8), unit.vp9_layers())), true, false, false, 0xff00, 0, "VP9 spatial switch over an unforwarded layer")
    // From target 4 (S 1, T 0), layer 1 was forwarded: target 8 may follow.
    expect_unit(result.unwrap(unit.vp9_unit(dependent, Some(4u8), unit.vp9_layers())), true, false, false, 0xff00, 0x100, "VP9 spatial up-switch")
    // The same frame with D=0 references no lower layer.
    let independent = result.unwrap(unit.vp9_frame(b"\xb8\x05\x14\x82", false))
    expect_unit(result.unwrap(unit.vp9_unit(independent, Some(0u8), unit.vp9_layers())), true, false, false, 0xff00, 0x100, "VP9 independent spatial layer")
    // P=1 with one P_DIFF of 1. Picture A: TID 0, U=1, SID 0. Picture B:
    // TID 1, U=0. From target 0, A keeps target 0 (bit 0); B is the first
    // frame above T 0 after A, so targets 1 .. 3 may follow it.
    let a = result.unwrap(unit.vp9_frame(b"\xfc\x05\x10\x02\x86", true))
    let b = result.unwrap(unit.vp9_frame(b"\xfc\x06\x20\x02\x86", true))
    let mut layers = unit.vp9_layers()
    expect_unit(result.unwrap(unit.vp9_unit(a, Some(0u8), layers)), true, true, false, 0xffff, 1, "VP9 picture start at target 0")
    expect_unit(result.unwrap(unit.vp9_unit(b, Some(0u8), layers)), true, true, false, 0xeeee, 0, "VP9 temporal switch without U")
    unit.vp9_observe(mut layers, a)
    expect_unit(result.unwrap(unit.vp9_unit(b, Some(0u8), layers)), true, true, false, 0xeeee, 0xe, "VP9 temporal switch after U")
    unit.vp9_observe(mut layers, b)
    expect_unit(result.unwrap(unit.vp9_unit(b, Some(0u8), layers)), true, true, false, 0xeeee, 0, "VP9 temporal switch past its first frame")
}

fn check_h264_units() {
    // Captured STAP-A 19249 (h264_rtp_parameter_sets): SPS 0 and PPS 0.
    // An SPS begins an access unit, and with a usable PPS it leads an IDR.
    let sets = b"\x78\x00\x10\x67\x42\xc0\x1e\x8c\x8d\x40\xf8\x63\xd4\x44\x03\xc2\x21\x1a\x80\x00\x04\x68\xce\x3c\x80"
    let mut leg = unit.parameter_sets()
    expect_unit(result.unwrap(unit.h264(sets, false, true, leg)), true, false, true, 0xffffffff, 0xffffffff, "H.264 parameter sets lead the access unit")
    result.unwrap(unit.h264_sent(mut leg, sets))
    // FU-A start of an IDR: indicator 0x7c, header S=1 type 5. Slice header
    // ue first_mb_in_slice 0 '1', slice_type 7 '0001000', PPS 0 '1'.
    let idr = b"\x7c\x85\x88\x80"
    expect_unit(result.unwrap(unit.h264(idr, false, false, leg)), false, false, false, 0xffffffff, 0, "H.264 IDR after its own parameter sets")
    expect_unit(result.unwrap(unit.h264(idr, false, true, leg)), true, false, true, 0xffffffff, 0xffffffff, "H.264 IDR with sent parameter sets")
    expect_unit(result.unwrap(unit.h264(idr, false, true, unit.parameter_sets())), true, false, false, 0xffffffff, 0, "H.264 IDR without parameter sets")
    // The second NAL of that IDR access unit: first_mb_in_slice 10
    // '0001011', slice_type 7, PPS 0. Only a NAL starts, not an access unit.
    expect_unit(result.unwrap(unit.h264(b"\x7c\x85\x16\x23", false, true, leg)), false, false, false, 0xffffffff, 0, "H.264 second IDR slice as a start")
}

fn check_av1_units() {
    // AV1 RTP §A.8. Structure packet, frame 256, start and end, template 0:
    // flags 10000, offset 000000, 32 targets 11111, one template '11',
    // DTIs Required (11) for targets 0 .. 30 and Switch (10) for target 31,
    // no frame diffs '0', chain_cnt ns(33) = 1 '00001', every target on
    // chain 0 (ns(1) is 0 bits), template chain diff '0000', no resolutions '0'.
    let mut structure = dependency.empty()
    let first = result.unwrap(dependency.parse(b"\xc0\x01\x00\x80\x1f\xff\xff\xff\xff\xff\xff\xff\xff\x81\x00", mut structure))
    // Frame 258 with custom chain diff 2 (flags 00001): its chain's previous frame is 256.
    let later = result.unwrap(dependency.parse(b"\xc0\x01\x02\x08\x10", mut structure))
    // Aggregation headers W=1 with N=1 (a new coded video sequence) and N=0.
    let sequence = b"\x18\x30"
    let plain = b"\x10\x30"
    let mut chains = unit.av1_chains()
    expect_unit(result.unwrap(unit.av1(sequence, first, view structure, chains)), true, true, true, 0xffffffff, 0xffffffff, "AV1 keyframe unit")
    expect_unit(result.unwrap(unit.av1(plain, later, view structure, chains)), true, true, false, 0xffffffff, 0, "AV1 switch over a broken chain")
    unit.av1_forwarded(mut chains, first, view structure)
    expect_unit(result.unwrap(unit.av1(plain, later, view structure, chains)), true, true, false, 0xffffffff, 0x80000000, "AV1 switch to target 31")
}

/// bug: Take a truncated VP8 first partition, a VP9 frame over an unforwarded layer, a second H.264 slice, or an AV1 Switch with a broken chain as a switch point, or misplace a mask bit.
/// oracle: RFC 7741 §4.2, RFC 6386 §9.1, RFC 9628 §4.2, RFC 6184 §§5.7-5.8 with H.264 §7.4.1.2.3, AV1 RTP §§A.5-A.8, and the rtp spec RTP-11 and webrtc spec RTC-6 maps, by hand.
@test
fn unit_adapter() -> Result[(), ()] {
    check_vp8_units()
    check_vp9_units()
    check_h264_units()
    check_av1_units()
    Ok(())
}

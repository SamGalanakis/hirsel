fn prior_fixture_value(width: u64) -> Bytes {
    let mut raw: Bytes = list.with_capacity(width)
    list.fill(mut raw, width, 0u8)
    take raw
}

fn prior_fixture_frame(wire: Bytes, at: u64, tag: u8, length: u64, prior: u64) -> bool {
    // 16 (frame) + 21 (COMMIT) + 5 (data section) gives the op tag.
    // The 12-byte logical key follows its u32 length, then the prior.
    read_le(wire, at + 4, 4) == length - 16 && wire[at + 42] == tag && read_le(wire, at + 43, 4) == 12 && read_le(wire, at + 59, 4) == prior
}

@test
fn cached_prior_conflict_safety(c: Clock) -> Result[(), Error] waits {
    let mut db = raw_test_db(c, 1048576)
    let Committed(_) = execute(mut db, 0, 20, None, fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(7), prior_fixture_value(34))
    })? else {
        return Error(Missing("initial row"))
    }
    let ci = call_info(db.store, 0, db.heads[0].head + 1, 21, db.heads[0].at)
    let reads: core.Log[Read] = log.new()
    let issued: core.Cell[u64] = cell.new(0)
    let keep: Option[fn(Error) -> bool] = None
    let Prepared(take draft) = draft_body(db, db.indexes, db.heads[0].roots, ci, keep, reads, issued, None, map.new(), fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(7), prior_fixture_value(16))?
        rollback_writes_on_error(mut tx, fn(mut nested: Tx) -> Result[(), Error] {
            put_bytes(mut nested, 1, key_word(7), prior_fixture_value(10))
        })
    }) else {
        return Error(Missing("repeated write draft"))
    }
    let _ = log.finish(take reads)
    let _ = cell.into_inner(take issued)
    let mut staged = take draft
    if data_row_count(staged.ops) != 1 || data_row(staged.ops, 0).prior != Some(35u32) {
        return Error(Missing("cached base width across repeated writes"))
    }
    let before = capacity(encode_staged(ci, Some(view db.heads[0].roots.collections), Some(staged.base_stamp), None, mut staged.ops, staged.order, NO_FRAME_TAIL, staged.stream_ops, None, None, None, None, 1, 72, FRAME_LIMIT))?
    if !prior_fixture_frame(before, 0, 1, 77, 35) {
        return Error(Missing("frame on the original head"))
    }
    let Committed(_) = execute(mut db, 0, 22, None, fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(7), prior_fixture_value(23))
    })? else {
        return Error(Missing("moved head"))
    }
    let after = capacity(encode_staged(ci, Some(view db.heads[0].roots.collections), Some(staged.base_stamp), None, mut staged.ops, staged.order, NO_FRAME_TAIL, staged.stream_ops, None, None, None, None, 1, 72, FRAME_LIMIT))?
    if !prior_fixture_frame(after, 0, 1, 77, 24) {
        return Error(Missing("frame on the moved head"))
    }
    Ok(())
}

@test
fn journal_test_table_priors(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    if !law_frames(c) {
        return Error(Missing("ordered data wire vectors"))
    }
    if !journal_law_payload() {
        return Error(Missing("data and reply parser vectors"))
    }
    if !journal_law_call_vector() {
        return Error(Missing("recorded call wire vectors"))
    }
    let dir = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut db = open(tasks, dir, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let baseline = db.resident
    let start = db.file_end
    let seq = db.file_seq
    let Committed(initial) = run(mut db, None, (), fn(mut tx: Tx, unused: ()) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(7), prior_fixture_value(34))
    })? else {
        return Error(Missing("insert"))
    }
    // entry(12, 34) = 62 + 16 + 40 = 118.
    if db.resident != baseline + 118 || db.file_end != start + 101 {
        return Error(Missing("insert charge or length"))
    }
    let first = share_page_tree(db.heads[0].roots.collections)
    let Committed(changed) = run(mut db, None, (), fn(mut tx: Tx, unused: ()) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(7), prior_fixture_value(16))?
        put_bytes(mut tx, 1, key_word(7), prior_fixture_value(10))
    })? else {
        return Error(Missing("overwrite"))
    }
    // entry(12, 10) = 62 + 16 + 16 = 94. Only one put survives in the frame.
    if db.resident != baseline + 94 || db.file_end != start + 101 + 77 {
        return Error(Missing("overwrite charge or length"))
    }
    let Committed(removed) = run(mut db, None, (), fn(mut tx: Tx, unused: ()) -> Result[(), Error] {
        let _ = delete_bytes(mut tx, 1, key_word(7))?
        Ok(())
    })? else {
        return Error(Missing("delete"))
    }
    if db.resident != baseline || db.file_end != start + 101 + 77 + 63 {
        return Error(Missing("delete charge or length"))
    }
    durable(mut db, removed.ticket)?
    let path = capacity(disk_path("j-", seq, ""))?
    let wire = read_journal_prefix(dir, path, start + 241)?
    if !prior_fixture_frame(wire, start, 1, 101, 0) || !prior_fixture_frame(wire, start + 101, 1, 77, 35) || !prior_fixture_frame(wire, start + 178, 2, 63, 11) {
        return Error(Missing("table prior bytes"))
    }
    let body_at = start + 101 + 16
    let mut body = copied(list.slice(wire, body_at, start + 178))?
    list.set_word_le(mut body, 43, 34u32)
    let invalid = journal_decode_commit(path, body)?
    let mut tree = take first
    let mut ids = db.next_node
    let mut tiered = ReplayTieredAccount(total: 0, exact: true)
    match journal_apply_ops(path, mut ids, mut tree, invalid.data, mut tiered, false) {
        Error(Corrupt(Fault(why: Malformed, ..))) => (),
        _ => return Error(Missing("contradictory prior refusal")),
    }
    list.set_word_le(mut body, 43, 16711682u32)
    match journal_decode_commit(path, body) {
        Error(Corrupt(Fault(why: Malformed, ..))) => (),
        _ => return Error(Missing("oversized prior refusal")),
    }
    let initial_info = option.unwrap(initial.info)
    let changed_info = option.unwrap(changed.info)
    let removed_info = option.unwrap(removed.info)
    if initial_info.id.version + 1 != changed_info.id.version || changed_info.id.version + 1 != removed_info.id.version {
        return Error(Missing("version sequence"))
    }
    close(take db)?
    let reopened = open(tasks, dir, c, r, options)?
    if reopened.resident != baseline || page_row_count(reopened.heads[0].roots.collections) != 0 || reopened.heads[0].head != removed_info.id.version {
        return Error(Missing("replayed table account"))
    }
    close(take reopened)
}

fn covering_prior_key(k: u64, old_value: u32) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.with_capacity(1)
    list.push(mut keys, k)
    Ok(take keys)
}

fn covering_prior_value(k: u64, v: u32) -> Result[u32, Capacity] {
    Ok(v)
}

fn covering_prior_case(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = journal_crash_options()
    let mut db = open(tasks, directory, c, r, options)?
    let mut declaring = declare(db, Migrate)?
    let mut declared = declare_table(mut declaring, "rows", std.codec.key_u64(), std.codec.of_u32())?
    let projected_index = covering(mut declaring, mut declared, "projected", Many, code.describe(covering_prior_key), std.codec.key_u64(), code.describe(covering_prior_value), std.codec.of_u32())?
    let primary = finish(mut declaring, take declared)?
    let _ = seal(mut db, take declaring)?
    for new_value in 6u32 .. 8 {
        let start = db.file_end
        let seq = db.file_seq
        let commit = run(mut db, None, (copy_env(primary), new_value), fn(mut tx: Tx, args: (Table[u64, u32], u32)) -> Result[(), Error] {
            put(mut tx, args.0, 9u64, args.1)
        })?
        let Committed(done) = commit else {
            return Error(Missing("covering put"))
        }
        durable(mut db, done.ticket)?
        if new_value == 7 {
            let path = capacity(disk_path("j-", seq, ""))?
            let raw = read_journal_prefix(directory, path, db.file_end)?
            // Payload is a two-byte schema number plus a four-byte u32.
            // The 20-byte Many key follows the primary's 31-byte put.
            let op = start + 42 + 31
            let found: u32 = list.word_be(raw, op + 5)
            if raw[op] != 1 || read_le(raw, op + 1, 4) != 20 || found != projected_index.id || read_le(raw, op + 25, 4) != 7 || read_le(raw, op + 29, 4) != 6 || read_le(raw, op + 33, 2) != 0 || read_le(raw, op + 35, 4) != 7 {
                return Error(Missing("covering prior wire charge"))
            }
        }
    }
    let expected = db.resident
    close(take db)?
    let recovered = open(tasks, directory, c, r, options)?
    if recovered.resident != expected {
        return Error(Missing("covering prior replay charge"))
    }
    close(take recovered)
}

fn prior_ceiling_case(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut db = open(tasks, directory, c, r, options)?
    let _ = law_table(mut db, "big", std.codec.key_u64(), std.codec.of_bytes())?
    let baseline = db.resident
    let logical = logical_key(1, key_word(7))?
    let width = 12582912u64
    {
        // Seed a valid checkpoint from a writer whose write limit held 12 MiB.
        // The law also runs with the public write limit compiled to 8 MiB.
        let mut next_stamp = stamp_after(db.next_node)?
        let first = next_stamp
        let raw = prior_fixture_value(width)
        put_page_row(mut db.heads[0].roots.collections, logical, raw, first, mut next_stamp)?
        db.next_node = next_stamp - 1
        db.resident += 12582990
    }
    let receipt = checkpoint(mut db)?
    durable(mut db, receipt)?
    close(take db)?
    let mut reopened = open(tasks, directory, c, r, options)?
    if reopened.resident != baseline + 12582990 {
        return Error(Missing("12 MiB prior seed charge"))
    }
    if let Some(raw) = get_page_row(reopened.heads[0].roots.collections, logical) {
        if list.len(raw) != width {
            return Error(Missing("12 MiB seed size"))
        }
    } else {
        return Error(Missing("12 MiB seed row"))
    }
    let start = reopened.file_end
    let seq = reopened.file_seq
    let removed = run(mut reopened, None, (), fn(mut tx: Tx, unused: ()) -> Result[(), Error] {
        if !delete_bytes(mut tx, 1, key_word(7))? {
            return Error(Missing("delete 12 MiB"))
        }
        Ok(())
    })?
    let Committed(done) = removed else {
        return Error(Missing("delete commit"))
    }
    durable(mut reopened, done.ticket)?
    let path = capacity(disk_path("j-", seq, ""))?
    let wire = read_journal_prefix(directory, path, start + 63)?
    if !prior_fixture_frame(wire, start, 2, 63, 12582913) || reopened.resident != baseline {
        return Error(Missing("12 MiB delete prior or charge"))
    }
    let mut body = copied(list.slice(wire, start + 16, start + 63))?
    list.set_word_le(mut body, 43, 16711681u32)
    let at_ceiling = journal_decode_commit(path, body)?
    if at_ceiling.data[0].prior != 16711681 {
        return Error(Missing("maximum wire prior"))
    }
    list.set_word_le(mut body, 43, 16711682u32)
    match journal_decode_commit(path, body) {
        Error(Corrupt(Fault(why: Malformed, ..))) => (),
        _ => return Error(Missing("prior above wire ceiling")),
    }
    close(take reopened)?
    let replayed = open(tasks, directory, c, r, options)?
    if replayed.resident != baseline || page_row_count(replayed.heads[0].roots.collections) != 0 {
        return Error(Missing("12 MiB delete replay"))
    }
    close(take replayed)
}

fn install_cold_companion(mut roots: Roots, stamp: u64) -> Result[(), Error] {
    let warm_key = prefix(1)?
    let (take resident_root, take resident_descriptor) = {
        let Some((warm_root, warm_descriptor)) = std.page.collection_entry(roots.collections.root, warm_key) else {
            return Error(Missing("warm fixture root"))
        }
        (arc.share(warm_root), copied(warm_descriptor)?)
    }
    let cold = std.page.PagePtr(pack: 8, offset: 72, len: 80, checksum: 0xc3a9635c753cb40c, stamp: 40)
    let mut descriptor = std.page.encode_ptr(cold)
    list.put_word_le(mut descriptor, 2u64)
    list.put_word_le(mut descriptor, 172u64)
    list.put_word_le(mut descriptor, 257u32)
    let mut descriptors: List[std.page.Entry] = list.new()
    list.push(mut descriptors, std.page.Entry(key: take warm_key, cell: InlineValue(take resident_descriptor)))
    list.push(mut descriptors, std.page.Entry(key: prefix(9)?, cell: InlineValue(take descriptor)))
    let mut slots: List[std.page.Slot] = list.new()
    list.push(mut slots, HotPage(take resident_root))
    list.push(mut slots, ColdPage(cold))
    let image = page_result(std.page.encode(descriptors, 0, stamp, CollectionMap))?
    roots.collections.root = page_result(std.page.attach(take image, take slots, list.new()))?
    Ok(())
}

fn retained_fixture_write(mut db: Db, k: u64, v: u64) -> Result[(), Error] waits {
    let outcome = run(mut db, None, (k, v), fn(mut tx: Tx, args: (u64, u64)) -> Result[(), Error] {
        let mut raw: Bytes = list.new()
        list.put_word_le(mut raw, 0u16)
        let word: u32 = int.narrow(args.1)
        list.put_word_le(mut raw, word)
        put_bytes(mut tx, 1, key_word(args.0), raw)
    })?
    let Committed(committed) = outcome else {
        return Error(Missing("retained root write"))
    }
    durable(mut db, committed.ticket)
}

fn retained_replay_case(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let mut options = journal_crash_options()
    let mut db = open(tasks, directory, c, r, options)?
    let _ = law_table(mut db, "warm", std.codec.key_u64(), std.codec.of_u32())?
    let baseline = db.resident
    retained_fixture_write(mut db, 1, 1)?
    retained_fixture_write(mut db, 2, 2)?
    let original = snapshot(db)
    let receipt = pin(mut db, "held", original)?
    durable(mut db, receipt)?
    retained_fixture_write(mut db, 2, 99)?
    let cut = checkpoint(mut db)?
    durable(mut db, cut)?
    close(take db)?
    // Key 1, pinned 2:A and head 2:B are three distinct 86-byte versions.
    options.resident_limit = baseline + 258
    let mut writer = open(tasks, directory, c, r, options)?
    if writer.resident != baseline + 258 {
        return Error(Missing("retained fixture baseline"))
    }
    retained_fixture_write(mut writer, 2, 2)?
    if writer.resident != baseline + 172 {
        return Error(Missing("retained live settle"))
    }
    close(take writer)?
    let mut replayed = open(tasks, directory, c, r, options)?
    if replayed.resident != baseline + 172 {
        return Error(Missing("retained replay settle"))
    }
    {
        // Attach an untouched Tiered sibling with no resolvable page at its
        // pointer. Only its 126-byte Memory descriptor belongs to this walk.
        let mut state = capacity(main_state(share_roots(replayed.heads[0].roots), replayed.heads[0].head, 0))?
        install_cold_companion(mut state.tips[0].roots, 101)?
        let mut restored = journal_replay(take state, 102, default_limits())?
        if journal_account(restored)? != baseline + 172 + 126 {
            return Error(Missing("single mixed root Memory account"))
        }
        let mut held = capacity(share_pin(replayed.pins[0]))?
        install_cold_companion(mut held.roots, 102)?
        list.push(mut restored.state.pins, take held)
        if journal_account(restored)? != baseline + 172 + 126 {
            return Error(Missing("retained mixed root Memory account"))
        }
    }
    retained_fixture_write(mut replayed, 3, 3)?
    if replayed.resident != baseline + 258 {
        return Error(Missing("retained reopen admission"))
    }
    close(take replayed)
}

@test
fn journal_test_v264_recovery(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    covering_prior_case(d, c, r, tasks)?
    retained_replay_case(d, c, r, tasks)?
    prior_ceiling_case(d, c, r, tasks)
}

fn batch_law_edits(round: u64) -> Result[DataRows, Error] {
    let mut ops = new_data_rows()
    for i in 0u64 .. 3072 {
        let k = 3071 - i
        let id: u32 = int.truncate(1 + k % 2)
        let key = logical_key(id, key_word(k))?
        let choice = (k * 41 + round * 107 + k * round * 59) % 211
        if round >= 2 && choice >= 13 {
            continue
        }
        let value: Option[StagedValue] = if round == 1 || (round >= 2 && choice % 3 == 0) {
            None
        } else {
            let width = if choice % 17 == 0 {
                1100 + choice
            } else {
                160 + choice
            }
            let mut raw = prior_fixture_value(width)
            list.set_word_le(mut raw, 0, round * 3072 + k)
            Some(stage_value(take raw, 1024))
        }
        push_data_row(mut ops, DataOp(key: take key, value: take value, trim: None, prior: None))
    }
    Ok(take ops)
}

fn batch_law_bounds(root: Arc[std.page.Page], low: Option[View[Bytes]], high: Option[View[Bytes]]) -> Result[(), Error] {
    let image = std.page.image_of(root)
    let height = std.page.level(image)
    let n = std.page.count(image)
    if height != 0 && n < 2 {
        return Error(Missing("unary batch branch"))
    }
    let mut prev: Option[Bytes] = None
    for i in 0u64 .. n {
        let key = option.unwrap(std.page.key_at(image, i))
        if height != 0 && i == 0 {
            if list.len(key) != 0 {
                return Error(Missing("batch entry zero divider"))
            }
        } else {
            if let Some(edge) = low {
                if key < edge {
                    return Error(Missing("batch lower bound"))
                }
            }
            if let Some(edge) = high {
                if key >= edge {
                    return Error(Missing("batch upper bound"))
                }
            }
            if let Some(previous) = view prev {
                if key <= previous {
                    return Error(Missing("batch key order"))
                }
            }
        }
        if height != 0 {
            let child = option.unwrap(std.page.child(root, i))
            let ceiling = std.page.key_at(image, i + 1)
            let from = if i == 0 {
                low
            } else {
                Some(view key)
            }
            let to = if let Some(edge) = view ceiling {
                Some(view edge)
            } else {
                high
            }
            if std.page.level(std.page.image_of(child)) + 1 != height {
                return Error(Missing("batch page level"))
            }
            batch_law_bounds(child, from, to)?
        }
        prev = Some(take key)
    }
    Ok(())
}

fn batch_law_compare(candidate: PageTree, oracle: PageTree) -> Result[(), Error] {
    for id in 1u32 .. 3 {
        let collection = prefix(id)?
        let want = option.unwrap(std.page.collection_child(oracle.root, collection))
        let got = option.unwrap(std.page.collection_child(candidate.root, collection))
        if std.page.totals(want) != std.page.totals(got) {
            return Error(Missing("batch row totals"))
        }
        batch_law_bounds(got, None, None)?
        let mut a = std.page.cursor_open(want, None, true, false)
        let mut b = std.page.cursor_open(got, None, true, false)
        while let Some(row) = std.page.cursor_read(mut a, scoped fn(key: Bytes, value: Bytes) -> (Bytes, Bytes) {
            (clone(key), clone(value))
        }) {
            let equal = std.page.cursor_read(mut b, scoped fn(key: Bytes, value: Bytes) -> bool {
                key == row.0 && value == row.1
            })
            if equal != Some(true) {
                return Error(Missing("batch row mismatch"))
            }
        }
        if let Some(_) = std.page.cursor_next(mut b) {
            return Error(Missing("extra batch row"))
        }
    }
    Ok(())
}

@test
fn sorted_batch_equivalence() -> Result[(), Error] {
    let mut empty = std.page.empty(0, 0, Collection)
    let mut invalid: List[std.page.BatchEdit] = list.new()
    list.push(mut invalid, std.page.BatchEdit(key: key_word(0), value: Some(BatchBytes(key_word(70))), prior: Some(0u32)))
    list.push(mut invalid, std.page.BatchEdit(key: key_word(1), value: None, prior: Some(3u32)))
    let mut rejected_ids = 1u64
    match std.page.apply_sorted_batch(mut empty, invalid, 1024, mut rejected_ids) {
        Error(MalformedPage) => (),
        _ => return Error(Missing("batch prior was accepted")),
    }
    if std.page.count(std.page.image_of(empty)) != 0 {
        return Error(Missing("batch prior published a prefix"))
    }
    let mut oracle = new_page_tree(CollectionMap, 1024)
    let mut oracle_ids = 0u64
    define_store_collection(mut oracle, 1, 1, mut oracle_ids)?
    define_store_collection(mut oracle, 2, 1, mut oracle_ids)?
    let mut live_tree = share_page_tree(oracle)
    let mut replay = share_page_tree(oracle)
    let mut live_ids = oracle_ids + 1
    let mut replay_ids = oracle_ids
    let mut account = ReplayTieredAccount(total: 0, exact: true)
    for round in 0u64 .. 200 {
        let mut ops = batch_law_edits(round)?
        let order = capacity(data_order(ops))?
        let ci = CallInfo(id: CallId(store: StoreId(hi: 1, lo: 2), branch: 0, version: round + 1), at: round, seed: 0)
        let wire = capacity(encode_staged(ci, Some(view oracle), None, None, mut ops, order, NO_FRAME_TAIL, new_data_rows(), None, None, None, None, 1, 72, FRAME_LIMIT))?
        let frame = journal_decode_commit("batch", list.slice(wire, 16, list.len(wire)))?
        for op in frame.data {
            if let Some(value) = op.value {
                put_page_row(mut oracle, op.key, value, 0, mut oracle_ids)?
            } else {
                let _ = remove_page_row(mut oracle, op.key, 0, mut oracle_ids)?
            }
        }
        let first = live_ids
        materialize_ordered_rows(mut live_tree, ops, order, false, first, mut live_ids)?
        canonical_tree(mut live_tree)?
        journal_apply_ops("batch", mut replay_ids, mut replay, frame.data, mut account, false)?
        if !page_result(std.page.canonical(live_tree.root))? || !page_result(std.page.canonical(replay.root))? {
            return Error(Missing("batch canonical form"))
        }
        batch_law_compare(live_tree, oracle)?
        batch_law_compare(replay, oracle)?
    }
    Ok(())
}

fn replay_budget_write(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(Dir, Db, u64), Error] waits {
    let directory = disk_test_directory(d)
    let mut db = open_directory(tasks, directory, c, r, journal_crash_options(), JournalCadence(group_delay_us: 0, end_groups: 1, end_interval_ms: 10))?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let Committed(written) = run(mut db, None, copy_env(rows), fn(mut tx, target) -> Result[(), Error] {
        for i in 0u64 .. 10000 {
            let key = (i * 733) % 10000
            put(mut tx, target, key, key * 7 + 5)?
        }
        Ok(())
    })? else {
        return Error(Missing("10,000-row journal commit"))
    }
    durable(mut db, written.ticket)?
    // The live capture reads the named END. Its update follows the ack and
    // precedes the worker's handling of the following barrier.
    {
        let journal = disk_state(db)
        result.unwrap(channel.send(journal.journal, Barrier))
        match result.unwrap(channel.receive(journal.written)) {
            Written => (),
            WriteFailed(problem) => return Error(Poisoned(problem)),
        }
    }
    Ok((directory, take db, option.unwrap(written.info).id.version))
}

fn replay_prior_grants() -> Result[(), Error] {
    let mut base = new_page_tree(CollectionMap, 1024)
    let mut ids = 0u64
    define_store_collection(mut base, 1, 1, mut ids)?
    let seed = ids
    let mut wrong: List[JournalOp] = list.new()
    list.push(mut wrong, JournalOp(key: logical_key(1, key_word(0))?, value: Some(prior_fixture_value(65536)), prior: 0, trim: None))
    list.push(mut wrong, JournalOp(key: logical_key(1, key_word(1))?, value: None, prior: 1, trim: None))
    let mut account = ReplayTieredAccount(total: 0, exact: true)
    // 4 KiB covers the fault but cannot admit the first 64 KiB value copy.
    let readonly_refusal = bound bytes 4096 {
        journal_apply_ops("bulk prior", mut ids, mut base, wrong, mut account, true)
    }
    match readonly_refusal {
        Ok(Error(Corrupt(Fault(why: Malformed, ..)))) => (),
        _ => return Error(Missing("immutable prior must precede value admission")),
    }
    // 96 KiB covers the candidate blob and page work, but cannot hold the
    // old BatchEdit's 64 KiB copy alongside a second 64 KiB blob.
    let mutable_refusal = bound bytes 98304 {
        journal_apply_ops("batch prior", mut ids, mut base, wrong, mut account, false)
    }
    match mutable_refusal {
        Ok(Error(Corrupt(Fault(why: Malformed, ..)))) => (),
        _ => return Error(Missing("mutable prior must precede a redundant value copy")),
    }
    if ids != seed || page_row_count(base) != 0 {
        return Error(Missing("failed prior published a prefix"))
    }
    wrong[1].prior = 0
    for immutable in[true, false] {
        let mut candidate = share_page_tree(base)
        let mut candidate_ids = seed
        capacity(bound bytes 98304 {
            journal_apply_ops("valid priors", mut candidate_ids, mut candidate, wrong, mut account, immutable)
        })??
        {
            let Some(stored) = get_page_row(candidate, wrong[0].key) else {
                return Error(Missing("zero-prior put is absent"))
            }
            if page_row_count(candidate) != 1 || list.len(stored) != 65536 || get_page_row(candidate, wrong[1].key) != None {
                return Error(Missing("put with an absent zero-prior delete"))
            }
        }
        let mut mismatch: List[JournalOp] = list.new()
        list.push(mut mismatch, JournalOp(key: logical_key(1, key_word(0))?, value: None, prior: 65536, trim: None))
        list.push(mut mismatch, JournalOp(key: logical_key(1, key_word(1))?, value: None, prior: 0, trim: None))
        match journal_apply_ops("wrong existing prior", mut candidate_ids, mut candidate, mismatch, mut account, immutable) {
            Error(Corrupt(Fault(why: Malformed, ..))) => (),
            _ => return Error(Missing("existing row accepted a mismatched prior")),
        }
        mismatch[0].key = logical_key(1, key_word(1))?
        mismatch[0].prior = 0
        mismatch[1].key = logical_key(1, key_word(2))?
        let mut empty = share_page_tree(base)
        let mut empty_ids = seed
        journal_apply_ops("zero-prior deletes", mut empty_ids, mut empty, mismatch, mut account, immutable)?
        if page_row_count(empty) != 0 {
            return Error(Missing("zero-prior deletes built rows"))
        }
    }
    Ok(())
}

@test
fn read_only_replay_step_budget(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    replay_prior_grants()?
    let (directory, take writer, version_wanted) = replay_budget_write(d, c, r, tasks)?
    let options = journal_crash_options()
    // One fifth of the 12,130,750 steps on 11bafba2 with this journal.
    let tested = bound steps 2426150 {
        open_read_only(directory, c, journal_crash_options())
    }
    let Ok(capture_result) = tested else {
        return Error(Missing("read-only capture exceeded 2,426,150 steps"))
    }
    let captured = capture_result?
    close(take writer)?
    let mut eager = open(tasks, directory, c, r, options)?
    let read_table = read_only_table(captured, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let eager_table = table(mut eager, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let held = read_only_snapshot(captured)
    let eager_snapshot = snapshot(eager)
    if version(held) != version_wanted || version(eager_snapshot) != version_wanted {
        return Error(Missing("journal head"))
    }
    let eager_reader = reader(eager, 0)?
    let held_reader = read_only_reader(captured, 0)?
    if count_at(held_reader, held, read_table, Unbounded, Unbounded)? != 10000 || count_at(eager_reader, eager_snapshot, eager_table, Unbounded, Unbounded)? != 10000 {
        return Error(Missing("journal row count"))
    }
    for key in 0u64 .. 10000 {
        let want = Some(key * 7 + 5)
        if get(held_reader, held, read_table, key)? != want || get(eager_reader, eager_snapshot, eager_table, key)? != want {
            return Error(Missing("journal row value"))
        }
    }
    close(take eager)
}

// Format-3 genesis files. The MANIFEST matches the old law's frozen digest.
fn format3_manifest() -> Bytes {
    let words: Inline[u64, 49] =[
        0x0000003800010001,
        0x6fa42cfe8eb61906,
        0x45524f5453524948,
        0x0000000100000003,
        0x0000000000000001,
        0x0000000000000002,
        0x0000000000000000,
        0x0000000000000001,
        0x0000000000000000,
        0x0000012b00010031,
        0xdaeef507b53cffcf,
        0x0000000000000001,
        0x0000100000001000,
        0x0100004000000400,
        0x0000000000000001,
        0x0000000100000001,
        0x0000000000000001,
        0x0000000000000001,
        0x0000000000000001,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000001,
        0x00006e69616d0004,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
    ]
    let mut raw: Bytes = list.with_capacity(392)
    for word in words {
        list.put_word_le(mut raw, word)
    }
    list.truncate(mut raw, 387)
    take raw
}


pub type DescribeEntry: key + shareable + send {
    id: u32,
    name: String,
    table: String,
    form: EntryForm,
    state: u8,
    revision: Bytes,
    rows: u64,
    charge: u64
}

pub type DescribeTotals: key + shareable + send {
    head: u64,
    segments: u64,
    journal_bytes: u64,
    frames: u64,
    packs: u64
}

pub type DescribeLine: key + shareable + send = DescribeHead(StoreId, u64) | DescribeCollection(DescribeEntry) | DescribeAccount(u64, u64) | DescribeJournal(DescribeTotals) | DescribePin(u64, String, u32, u64) | DescribePack(u64, u8, u32, u64, u64) | DescribeOpenPacks(u64) | DescribeScrubRound(ScrubRound)

fn describe_collection(mut packs: capture.CapturePacks, names: List[capture.DescribeName], root: std.page.PagePtr, deltas: List[capture.DescribeDelta], path: String, at: u64, key: Bytes, value: std.page.Cell) -> Result[DescribeEntry, Error] waits {
    let cat = failure_result_from_rep(capture.capture_catalog_cell(mut packs, path, at, value))?
    let name = failure_result_from_rep(capture.capture_catalog_name(path, at, key))?
    let owner_name = if cat.kind == 2 {
        failure_result_from_rep(capture.describe_owner(names, cat.owner))?
    } else {
        string.from(name)
    }
    let form = match cat.kind {
        2 => match cat.shape {
            0 => IndexForm(Many),
            1 => IndexForm(Unique),
            _ => AggregateForm,
        },
        3 => CellForm,
        4 => LogForm,
        5 => BlobsForm,
        _ => TableForm,
    }
    let desc = failure_result_from_rep(capture.describe_descriptor(mut packs, root, cat.id))?
    let (rows, charge, log_first, log_next) = if let Some(record) = view desc {
        let descriptor = std.page_descriptor.collection_descriptor(record) ?=> |_| failure_from_rep(format.disk_fault(path, at, Malformed))
        if cat.kind == 4 && descriptor.kind != LogCollection {
            return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
        }
        let rows: u64 = descriptor.rows
        let charge: u64 = descriptor.row_bytes
        let limits = if cat.kind == 4 {
            pager.descriptor_bounds(record)
        } else {
            pages.LogBoundsRep(first: 0, next: 0)
        }
        (rows, charge, limits.first, limits.next)
    } else {
        (0u64, 0u64, 0u64, 0u64)
    }
    let slot: u64 = int.widen(cat.id)
    let delta = deltas[slot]
    let final_rows = if cat.kind == 4 {
        let first = order.max(log_first, delta.floor)
        let next_seq = order.max(order.max(log_next, delta.floor), delta.next)
        next_seq - first
    } else {
        failure_result_from_rep(capture.describe_adjust(path, at, rows, delta.rows))?
    }
    let final_charge = failure_result_from_rep(capture.describe_adjust(path, at, charge, delta.charge))?
    let capture.CaptureCatalog(id: id, state: state, revision: take revision, ..) = take cat
    Ok(DescribeEntry(id: id, name: take name, table: take owner_name, form: form, state: state, revision: take revision, rows: final_rows, charge: final_charge))
}

pub fn describe_capture(take p: PreparedCapture, line: scoped[view] fn(DescribeLine) -> Result[(), Error] waits) -> Result[DescribeTotals, Error] waits {
    let mut selected = take p
    if capture.prepared_locked(selected.state) {
        return Error(Unsupported(0))
    }
    let mut packs = capture.capture_packs(capture.prepared_dir(selected.state), capture.prepared_id(selected.state), capture.prepared_manifest(selected.state), true, capture.capture_add(capture.prepared_lists(selected.state).pack_rows, capture.prepared_lists(selected.state).pages))
    // Complete all lazy acquisitions before the first line. A reader whose
    // generation was retired can then retry without partial output.
    let collected = failure_result_from_rep(capture.describe_acquire(mut packs, selected.state))
    let names = match take collected {
        Ok(take found) => take found,
        Error(Io(NotFound)) => {
            if !failure_result_from_rep(capture.capture_same_manifest(capture.prepared_dir(selected.state), capture.prepared_raw(selected.state)))? {
                return Error(Changed("MANIFEST"))
            }
            return Error(failure_from_rep(format.disk_fault("MANIFEST", 72, Absent)))
        },
        Error(Io(Other(24))) => {
            line(DescribeOpenPacks(capture.held_pack_count(packs)))?
            return Error(Io(Other(24)))
        },
        Error(take problem) => return Error(take problem),
    }
    let summary = describe_suffix(mut selected)?
    describe_lines(selected, mut packs, names.names, summary.0, summary.1, line)?;
    Ok(summary.0)
}

fn describe_suffix(mut p: PreparedCapture) -> Result[(DescribeTotals, List[capture.DescribeDelta]), Error] waits {
    let mut folded = capture.DescribeFold(deltas: list.with_capacity(int.widen(capture.prepared_manifest(p.state).next_table)), head: capture.prepared_manifest(p.state).branches[0].version, value_limit: capture.prepared_manifest(p.state).limits.value)
    list.fill(mut folded.deltas, int.widen(capture.prepared_manifest(p.state).next_table), capture.DescribeDelta(rows: 0, charge: 0, next: 0, floor: 0))
    let segs = capture.prepared_segment_count(p.state)
    let mut frame_count = 0u64
    let mut journal_bytes = 0u64
    for i in 0u64 .. segs {
        let (size, frames) = failure_result_from_rep(capture.scan_prepared_segment(mut p.state, i, KeepCommit, mut folded, capture.describe_commit))?
        frame_count = capture.capture_add(frame_count, frames)
        journal_bytes = capture.capture_add(journal_bytes, size)
    }
    let summary = DescribeTotals(head: folded.head, segments: segs, journal_bytes: journal_bytes, frames: frame_count, packs: capture.prepared_lists(p.state).pack_rows)
    let capture.DescribeFold(deltas: take deltas, ..) = take folded
    Ok((summary, take deltas))
}

fn describe_lines(p: PreparedCapture, mut packs: capture.CapturePacks, names: List[capture.DescribeName], summary: DescribeTotals, deltas: List[capture.DescribeDelta], line: scoped[view] fn(DescribeLine) -> Result[(), Error] waits) -> Result[(), Error] waits {
    line(DescribeHead(store_key_from_rep(capture.prepared_id(p.state)), summary.head))?
    let roots = capture.prepared_manifest(p.state).branches[0].roots
    let mut pages = 0u64
    let mut ignored = ()
    failure_result_from_rep(capture.capture_walk_pages(mut packs, roots.catalog, 0, None, mut ignored, mut pages, scoped fn(mut source: capture.CapturePacks, mut _walk: (), path: String, at: u64, key: Bytes, value: std.page.Cell) -> Result[(), types.Failure] waits {
        let row = failure_result_to_rep(describe_collection(mut source, names, roots.collections, deltas, path, at, key, value))?
        failure_result_to_rep(line(DescribeCollection(take row)))
    }))?
    line(DescribeAccount(capture.prepared_manifest(p.state).generation, manifest.manifest_account(capture.prepared_manifest(p.state))))?
    line(DescribeJournal(summary))?
    if let Some(history) = read_scrub_history(capture.prepared_dir(p.state), store_key_from_rep(capture.prepared_id(p.state)))? {
        if let Some(round) = last_complete_scrub_round(history) {
            line(DescribeScrubRound(round))?
        }
    }
    for pin_record in capture.prepared_manifest(p.state).pins {
        line(DescribePin(manifest.pin_owner_tag(pin_record.owner), clone(pin_record.name), pin_record.branch, pin_record.version))?
    }
    failure_result_from_rep(capture.capture_walk_pages(mut packs, capture.prepared_manifest(p.state).pack_root, 2, None, mut ignored, mut pages, scoped fn(mut _source: capture.CapturePacks, mut _walk: (), path: String, at: u64, key: Bytes, value: std.page.Cell) -> Result[(), types.Failure] waits {
        let raw = match value {
            InlineValue(found) => found,
            _ => return Error(format.disk_fault(path, at, Malformed)),
        }
        let pack = manifest.pack_record(path, at, raw)?
        let seq: u64 = list.word_be(key, 0)
        failure_result_to_rep(line(DescribePack(seq, pack.class, pack.frames, pack.live, pack.payload_bytes)))
    }))
}

// Module `char`, extended (LANG-7): library members of the core module `char`, over its
// core members from_u32 and to_u32 (core/core/char.hirsel). `char` is also the builtin type
// name: a type position reads the type, so `fn f(c: char)` and `char.digit(c, 16)` do not
// collide. A char is plain, 4 bytes, key + ordered.
/// Number of UTF-8 bytes, 1 to 4. Cost: O(1). Ex: `char.utf8_len('é')` is 2
pub fn utf8_len(c: char) -> u64 {
    let v = char.to_u32(c)
    if v < 0x80 {
        1
    } else if v < 0x800 {
        2
    } else if v < 0x10000 {
        3
    } else {
        4
    }
}

/// 'a'..='z' mapped to 'A'..='Z'; every other scalar unchanged. Cost: O(1).
/// Ex: `string.push_char(mut out, char.to_ascii_upper(c))`
pub fn to_ascii_upper(c: char) -> char {
    if c >= 'a' && c <= 'z' {
        option.unwrap(char.from_u32(char.to_u32(c) - 32))
    } else {
        c
    }
}

/// 'A'..='Z' mapped to 'a'..='z'; every other scalar unchanged. Cost: O(1).
/// Ex: `string.push_char(mut out, char.to_ascii_lower(c))`
pub fn to_ascii_lower(c: char) -> char {
    if c >= 'A' && c <= 'Z' {
        option.unwrap(char.from_u32(char.to_u32(c) + 32))
    } else {
        c
    }
}

/// Whether c is '0'..='9' (Rust is_ascii_digit). Cost: O(1). Ex: `char.is_ascii_digit('7')` is true
pub fn is_ascii_digit(c: char) -> bool {
    let v = char.to_u32(c)
    v < 128 && int.is_ascii_digit(int.narrow(v))
}

/// Whether c is 'A'..='Z' or 'a'..='z' (Rust is_ascii_alphabetic). Cost: O(1).
/// Ex: `char.is_ascii_alpha('é')` is false
pub fn is_ascii_alpha(c: char) -> bool {
    let v = char.to_u32(c)
    v < 128 && int.is_ascii_alpha(int.narrow(v))
}

/// Whether c is space, tab, line feed, form feed or carriage return; U+000B is not
/// (Rust is_ascii_whitespace, the WhatWG set). Cost: O(1). Ex: `char.is_ascii_whitespace('\t')` is true
pub fn is_ascii_whitespace(c: char) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r' || char.to_u32(c) == 0x0C
}

/// The value of an ASCII digit in `base` (2 to 36), or None: '0'..'9', then 'a'..'z' or
/// 'A'..'Z' for 10 to 35 (Rust char::to_digit). Fails: Fail when base is outside 2..=36.
/// Cost: O(1).
/// Ex: `char.digit('f', 16)` is Some(15)
pub fn digit(c: char, base: u32) -> Option[u32] {
    if base < 2 || base > 36 {
        fail("char.digit: base outside 2..=36")
    }
    let byte: Option[u8] = int.try_narrow(char.to_u32(c))
    let Some(b) = byte else {
        return None
    }
    match int.ascii_digit(b, base) {
        Some(d) => Some(int.widen(d)),
        None => None,
    }
}

/// The Unicode Character Database version used by std.
pub const UNICODE_VERSION: (u8, u8, u8) = (18, 0, 0)

/// The Unicode General_Category short aliases for scalar values.
pub type Category: key = Lu | Ll | Lt | Lm | Lo | Mn | Mc | Me | Nd | Nl | No | Pc | Pd | Ps | Pe | Pi | Pf | Po | Sm | Sc | Sk | So | Zs | Zl | Zp | Cc | Cf | Co | Cn

// Each word stores the start of a run in its high bits and the Category tag in its low five.
fn category_tag(code: u32) -> u32 {
    let mut lo: u64 = 0
    let mut hi = CATEGORY_COUNT
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if CATEGORY_RUNS[mid] >> 5 <= code {
            lo = mid
        } else {
            hi = mid
        }
    }
    CATEGORY_RUNS[lo] & 31
}

fn has_property(code: u32, first: u64, end: u64) -> bool {
    let mut lo = first
    let mut hi = end
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let (start, last) = PROPERTY_RANGES[mid]
        if code < start {
            hi = mid
        } else if code > last {
            lo = mid + 1
        } else {
            return true
        }
    }
    false
}

/// The Unicode General_Category of c. Fails: no operation-specific failure. Alloc: nothing.
/// Cost: O(1). Ex: `char.category('½')` is No.
pub fn category(c: char) -> Category {
    match category_tag(char.to_u32(c)) {
        0 => Lu,
        1 => Ll,
        2 => Lt,
        3 => Lm,
        4 => Lo,
        5 => Mn,
        6 => Mc,
        7 => Me,
        8 => Nd,
        9 => Nl,
        10 => No,
        11 => Pc,
        12 => Pd,
        13 => Ps,
        14 => Pe,
        15 => Pi,
        16 => Pf,
        17 => Po,
        18 => Sm,
        19 => Sc,
        20 => Sk,
        21 => So,
        22 => Zs,
        23 => Zl,
        24 => Zp,
        25 => Cc,
        26 => Cf,
        27 => Co,
        _ => Cn,
    }
}

fn alphabetic(code: u32, tag: u32) -> bool {
    tag <= 4 || tag == 9 || has_property(code, OTHER_ALPHABETIC_LO, OTHER_ALPHABETIC_HI)
}

/// Whether c has the Unicode Alphabetic property. Fails: no operation-specific failure.
/// Alloc: nothing. Cost: O(1). Ex: `char.is_alphabetic('Ⅷ')` is true.
pub fn is_alphabetic(c: char) -> bool {
    let code = char.to_u32(c)
    alphabetic(code, category_tag(code))
}

/// Whether c has a Unicode letter category (Lu through Lo). Fails: no operation-specific failure.
/// Alloc: nothing. Cost: O(1). Ex: `char.is_letter('Ⅷ')` is false.
pub fn is_letter(c: char) -> bool {
    category_tag(char.to_u32(c)) <= 4
}

/// Whether c has a Unicode number category (Nd, Nl or No). Fails: no operation-specific failure.
/// Alloc: nothing. Cost: O(1). Ex: `char.is_numeric('½')` is true.
pub fn is_numeric(c: char) -> bool {
    let tag = category_tag(char.to_u32(c))
    tag >= 8 && tag <= 10
}

/// Whether c is a Unicode decimal digit (Nd). Fails: no operation-specific failure.
/// Alloc: nothing. Cost: O(1). Ex: `char.is_decimal('٠')` is true.
pub fn is_decimal(c: char) -> bool {
    category(c) == Nd
}

/// Whether c has the Unicode Alphabetic property or a number category.
/// Fails: no operation-specific failure. Alloc: nothing. Cost: O(1).
/// Ex: `char.is_alphanumeric('½')` is true.
pub fn is_alphanumeric(c: char) -> bool {
    let code = char.to_u32(c)
    let tag = category_tag(code)
    (tag >= 8 && tag <= 10) || alphabetic(code, tag)
}

/// Whether c has the Unicode White_Space property. Fails: no operation-specific failure.
/// Alloc: nothing. Cost: O(1). Ex: `char.is_whitespace('\u{b}')` is true.
pub fn is_whitespace(c: char) -> bool {
    has_property(char.to_u32(c), WHITE_SPACE_LO, WHITE_SPACE_HI)
}

/// Whether c has the Unicode Uppercase property. Fails: no operation-specific failure.
/// Alloc: nothing. Cost: O(1). Ex: `char.is_uppercase('Ⅷ')` is true.
pub fn is_uppercase(c: char) -> bool {
    let code = char.to_u32(c)
    category_tag(code) == 0 || has_property(code, OTHER_UPPERCASE_LO, OTHER_UPPERCASE_HI)
}

/// Whether c has the Unicode Lowercase property. Fails: no operation-specific failure.
/// Alloc: nothing. Cost: O(1). Ex: `char.is_lowercase('ª')` is true.
pub fn is_lowercase(c: char) -> bool {
    let code = char.to_u32(c)
    category_tag(code) == 1 || has_property(code, OTHER_LOWERCASE_LO, OTHER_LOWERCASE_HI)
}


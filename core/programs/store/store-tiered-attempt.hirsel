type TieredAttemptStop: send = AttemptMiss(TieredTarget) | AttemptFold(u32) | AttemptPinLimit(Capacity) | AttemptAllocation(Capacity)

// The key a miss's demand descends by. Each operation installs its own as
// its first access, so no stale context outlives the operation that set it.
type TieredSeek: send = SeekOperation | SeekKey(Bytes) | SeekUpper

// The BLOB values a read at its seek key goes on to read (§13.3 "Values"):
// none, the value of the row at the key, or the values of the rows from the
// key on in scan order. The pager reads them with the leaf that holds them.
type TieredValues: send = ValuesNone | ValuesAt | ValuesFrom

// One first touch, committed by a single assignment (§13.3 "The intent").
type TieredIntent: send {
    stamp: u64,
    total: u64,
    stop: Option[TieredAttemptStop]
}

type TieredTouch {
    stamp: u64,
    payload: u64,
    miss: Option[TieredTarget]
}

// One more key path a batch demands: the Cold target a key missed at, the
// key the pager descends by from it and the values the read goes on to read.
type TieredPath: send {
    target: TieredTarget,
    key: Bytes,
    values: TieredValues
}

// `fetch_many`'s batch (§13.3 "Batched point misses"). While `on`, a point
// read keeps resolving after the latch: each later miss adds its path to
// `paths`, counted as a first touch, until a touch would pass the partition
// and `full` ends the batch. `seek` is the key of the read in progress.
type TieredGather: send {
    on: bool,
    full: bool,
    seek: Bytes,
    values: TieredValues,
    paths: List[TieredPath]
}

// The attempt record the driver owns in a core.Cell, outside the body's
// isolation and step scope. Every access settles the intent first.
type TieredTouchSet: send {
    stamps: Map[u64, ()],
    touched_bytes: u64,
    partition: u64,
    seek: TieredSeek,
    values: TieredValues,
    sibling_window: u64,
    siblings: List[TieredTarget],
    gather: TieredGather,
    stopped: Option[TieredAttemptStop],
    intent: Option[TieredIntent]
}

fn tiered_touch_set(partition: u64) -> TieredTouchSet {
    TieredTouchSet(stamps: map.new(), touched_bytes: 0, partition: partition, seek: SeekOperation, values: ValuesNone, sibling_window: 0, siblings: list.new(), gather: TieredGather(on: false, full: false, seek: list.new(), values: ValuesNone, paths: list.new()), stopped: None, intent: None)
}

fn tiered_attempt(partition: u64, window: u64) -> core.Cell[TieredTouchSet] {
    let mut state = tiered_touch_set(partition)
    state.sibling_window = window
    cell.new(take state)
}

// Replays an installed intent. Each write is idempotent and the stamp's room
// was reserved before the intent, so a stop here leaves the intent for the
// next entry to replay.
fn tiered_settle(mut a: TieredTouchSet) {
    let (stamp, total, stop): (u64, u64, Option[TieredAttemptStop]) = match a.intent {
        Some(i) => (i.stamp, i.total, clone(i.stop)),
        None => return,
    }
    a.touched_bytes = total
    map.insert(mut a.stamps, stamp, ())
    if let None = a.stopped {
        a.stopped = take stop
    }
    a.intent = None
}

// The driver's exit: settle, then read the latch before anything else.
fn tiered_finish(take attempt: core.Cell[TieredTouchSet]) -> TieredTouchSet {
    let mut state = cell.into_inner(take attempt)
    tiered_settle(mut state)
    take state
}

// A call reads Tiered rows only from a head with Tiered collections, so only
// such a call carries an attempt record and a Hot call allocates none. Its
// scans read ahead by the call's window, as a Reader's do.
fn call_attempt(root: Arc[std.page.Page], partition: u64, window: u64) -> Option[core.Cell[TieredTouchSet]] {
    if tiered_collections(root) {
        Some(tiered_attempt(partition, window))
    } else {
        None
    }
}

fn call_attempt_latched(attempt: Option[core.Cell[TieredTouchSet]]) -> bool {
    match attempt {
        Some(a) => tiered_stopped(a),
        None => false,
    }
}

fn call_attempt_finish(take attempt: Option[core.Cell[TieredTouchSet]]) -> Option[TieredTouchSet] {
    match take attempt {
        Some(take a) => Some(tiered_finish(take a)),
        None => None,
    }
}

fn tiered_touch_entry(mut a: TieredTouchSet, take t: TieredTouch) -> bool {
    let TieredTouch(stamp: stamp, payload: payload, miss: take miss) = take t
    tiered_settle(mut a)
    if let Some(_) = a.stopped {
        return tiered_gather_touch(mut a, stamp, payload, take miss)
    }
    if map.contains(a.stamps, stamp) {
        return true
    }
    if let Error(problem) = map.try_reserve(mut a.stamps, 1) {
        a.stopped = Some(AttemptAllocation(problem))
        return false
    }
    let total = int.saturating_add(a.touched_bytes, 16 + payload)
    let stop = if total > a.partition {
        Some(AttemptPinLimit(Capacity(requested: total, available: a.partition)))
    } else {
        match take miss {
            Some(take target) => Some(AttemptMiss(take target)),
            None => None,
        }
    }
    let admitted = match stop {
        Some(_) => false,
        None => true,
    }
    a.intent = Some(TieredIntent(stamp: stamp, total: total, stop: take stop))
    tiered_settle(mut a)
    admitted
}

// A touch after the latch. Outside a batch it fails, as every touch after a
// latch does. In a batch it is counted like a first touch and a miss adds
// its path, so the rerun's pins fit beside the touched ones. The attempt is
// already latched and will be discarded, so a step stop here tears nothing
// the outcome reads; a touch that would pass the partition or cannot be
// reserved ends the batch instead of latching a second stop.
fn tiered_gather_touch(mut a: TieredTouchSet, stamp: u64, payload: u64, take miss: Option[TieredTarget]) -> bool {
    let batching = match a.stopped {
        Some(AttemptMiss(_)) => a.gather.on && !a.gather.full,
        _ => false,
    }
    if !batching {
        return false
    }
    let first = !map.contains(a.stamps, stamp)
    let total = if first {
        int.saturating_add(a.touched_bytes, 16 + payload)
    } else {
        a.touched_bytes
    }
    if total > a.partition {
        a.gather.full = true
        return false
    }
    if first {
        if let Error(_) = map.try_reserve(mut a.stamps, 1) {
            a.gather.full = true
            return false
        }
    }
    let Some(take target) = take miss else {
        if first {
            a.touched_bytes = total
            map.insert(mut a.stamps, stamp, ())
        }
        return true
    }
    if let Error(_) = list.try_reserve(mut a.gather.paths, 1) {
        a.gather.full = true
        return false
    }
    list.push(mut a.gather.paths, TieredPath(target: take target, key: clone(a.gather.seek), values: clone(a.gather.values)))
    if first {
        a.touched_bytes = total
        map.insert(mut a.stamps, stamp, ())
    }
    false
}

fn tiered_gather_entry(mut a: TieredTouchSet, take on: bool) {
    tiered_settle(mut a)
    a.gather.on = on
}

// Starts or ends `fetch_many`'s batch.
fn tiered_gather(attempt: core.Cell[TieredTouchSet], on: bool) {
    cell.with(attempt, on, tiered_gather_entry)
}

fn tiered_blocked_entry(mut a: TieredTouchSet, take nothing: ()) -> bool {
    tiered_settle(mut a)
    match a.stopped {
        None => false,
        Some(AttemptMiss(_)) => !a.gather.on || a.gather.full,
        Some(_) => true,
    }
}

// Whether a point read stops at once: as `tiered_stopped`, except that a
// batch keeps resolving after a latched miss until it is full.
fn tiered_blocked(attempt: core.Cell[TieredTouchSet]) -> bool {
    cell.with(attempt, (), tiered_blocked_entry)
}

// Hot and Cold payloads use one first-touch counter. A Hot PAGE passes the
// image length, a Hot BLOB passes 8 + value length, and Cold uses the edge.
fn tiered_touch(attempt: core.Cell[TieredTouchSet], stamp: u64, payload: u64, take miss: Option[TieredTarget]) -> bool {
    cell.with(attempt, TieredTouch(stamp: stamp, payload: payload, miss: take miss), tiered_touch_entry)
}

fn tiered_stopped_entry(mut a: TieredTouchSet, take nothing: ()) -> bool {
    tiered_settle(mut a)
    match a.stopped {
        Some(_) => true,
        None => false,
    }
}

fn tiered_stopped(attempt: core.Cell[TieredTouchSet]) -> bool {
    cell.with(attempt, (), tiered_stopped_entry)
}

fn tiered_latch_entry(mut a: TieredTouchSet, take stop: TieredAttemptStop) {
    tiered_settle(mut a)
    if let None = a.stopped {
        a.stopped = Some(take stop)
    }
}

// A non-touch stop (a fold demand). The first stop wins.
fn tiered_latch(attempt: core.Cell[TieredTouchSet], take stop: TieredAttemptStop) {
    cell.with(attempt, take stop, tiered_latch_entry)
}

fn tiered_seek_entry(mut a: TieredTouchSet, take seek: TieredSeek) {
    tiered_settle(mut a)
    // A latched miss keeps the seek it was latched under. A batch tracks
    // the key of each later read for the path it may add.
    // A new seek reads no values until its read says it does.
    if let None = a.stopped {
        a.seek = take seek
        a.values = ValuesNone
    } else if a.gather.on {
        if let SeekKey(take key) = take seek {
            a.gather.seek = take key
        }
        a.gather.values = ValuesNone
    }
}

fn tiered_seek(attempt: core.Cell[TieredTouchSet], take seek: TieredSeek) {
    cell.with(attempt, take seek, tiered_seek_entry)
}

fn tiered_values_entry(mut a: TieredTouchSet, take values: TieredValues) {
    tiered_settle(mut a)
    if let None = a.stopped {
        a.values = take values
    } else if a.gather.on {
        a.gather.values = take values
    }
}

// Names the values the read at the current seek key goes on to read, as
// the seek is named: a latched miss keeps the values it was latched under.
fn tiered_reading(attempt: core.Cell[TieredTouchSet], take values: TieredValues) {
    cell.with(attempt, take values, tiered_values_entry)
}

fn tiered_missed_page_entry(mut a: TieredTouchSet, take nothing: ()) -> Option[(std.page.PagePtr, u64)] {
    tiered_settle(mut a)
    match a.stopped {
        Some(AttemptMiss(TieredPage(ptr))) => Some((clone(ptr), a.sibling_window)),
        _ => None,
    }
}

fn tiered_missed_page(attempt: core.Cell[TieredTouchSet]) -> Option[(std.page.PagePtr, u64)] {
    cell.with(attempt, (), tiered_missed_page_entry)
}

fn tiered_siblings_entry(mut a: TieredTouchSet, take found: List[TieredTarget]) {
    tiered_settle(mut a)
    a.siblings = take found
}

// Siblings are prefetch hints, set after the latch. A hint list that cannot
// be reserved is left out and never replaces the latched miss.
fn tiered_set_siblings(attempt: core.Cell[TieredTouchSet], take found: List[TieredTarget]) {
    cell.with(attempt, take found, tiered_siblings_entry)
}

// The visible pin map is looked up before the touch, so the path to the
// install is the same on a hit and a miss. Nothing miss-specific runs before
// it; the edge check runs after, so a Cache refusal precedes Corrupt.
fn tiered_resolve_cold(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], target: TieredTarget) -> Result[Option[View[Arc[TieredFrame]]], Error] in visible {
    let facts = tiered_frame_id(target)
    let found = map.get(visible, tiered_cache_key(facts))
    let owned: TieredTarget = clone(target)
    let miss: Option[TieredTarget] = match found {
        Some(_) => None,
        None => Some(take owned),
    }
    if !tiered_touch(attempt, facts.stamp, facts.len, take miss) {
        return Ok(None)
    }
    let frame = option.unwrap(found)
    if frame.identity != facts {
        verify_tiered_edge(paged_pack_path(facts.pack)?, target, frame.identity)?
    }
    Ok(Some(frame))
}

fn tiered_touch_hot_page(attempt: core.Cell[TieredTouchSet], page: Arc[std.page.Page]) -> Result[(), Error] {
    let image = std.page.image_of(page)
    let id = std.page.stamp(image)
    if id != 0 && !tiered_touch(attempt, id, list.len(std.page.payload(image)), None) {
        return Error(Missed)
    }
    Ok(())
}

fn tiered_pinned_page(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], ptr: std.page.PagePtr, expected_level: Option[u8]) -> Result[View[Arc[std.page.Page]], Error] in visible {
    let Some(frame) = tiered_resolve_cold(attempt, visible, TieredPage(ptr))? else {
        return Error(Missed)
    }
    let TieredImage(page) = view frame.payload else {
        fail("store: verified PAGE has no image")
    }
    if let Some(wanted) = expected_level {
        if std.page.level(std.page.image_of(page)) != wanted {
            return Error(disk_fault(paged_pack_path(ptr.pack)?, ptr.offset, Malformed))
        }
    }
    Ok(page)
}

fn tiered_point_page(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], edge: std.page.Slot, expected_level: Option[u8]) -> Result[Arc[std.page.Page], Error] {
    if tiered_stopped(attempt) {
        return Error(Missed)
    }
    match edge {
        HotPage(page) => {
            tiered_touch_hot_page(attempt, page)?
            Ok(arc.share(page))
        },
        ColdPage(ptr) => {
            let page = tiered_pinned_page(attempt, visible, ptr, expected_level)?
            Ok(arc.share(page))
        },
    }
}

fn tiered_touch_hot_blob(attempt: core.Cell[TieredTouchSet], reference: std.page.BlobRef, contents: Arc[Bytes]) -> Result[(), Error] {
    if !tiered_touch(attempt, reference.stamp, 8 + list.len(contents), None) {
        return Error(Missed)
    }
    Ok(())
}

fn tiered_pinned_blob(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], ptr: std.page.BlobRef) -> Result[View[Arc[Bytes]], Error] in visible {
    let Some(frame) = tiered_resolve_cold(attempt, visible, TieredBlob(ptr))? else {
        return Error(Missed)
    }
    let TieredValue(contents) = view frame.payload else {
        fail("store: verified BLOB has no value")
    }
    Ok(contents)
}

fn tiered_point_value(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], page: Arc[std.page.Page], slot: u64) -> Result[Arc[Bytes], Error] {
    let Some(BlobEdge(reference)) = std.page.owning_edge(std.page.image_of(page), slot) else {
        let Some(value) = std.page.value_at(page, slot) else {
            fail("store: missing selected inline value")
        }
        return Ok(arc.new(copied(value)?))
    }
    let Some(edge) = std.page.blob_slot(page, reference.body) else {
        fail("store: missing attached BLOB")
    }
    match edge {
        HotBlob(contents) => {
            tiered_touch_hot_blob(attempt, reference, contents)?
            Ok(arc.share(contents))
        },
        ColdBlob(ptr) => {
            let contents = tiered_pinned_blob(attempt, visible, ptr)?
            Ok(arc.share(contents))
        },
    }
}

fn tiered_point_path(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], edge: std.page.Slot, expected_level: Option[u8], key: Bytes) -> Result[Option[Arc[Bytes]], Error] {
    let page = tiered_point_page(attempt, visible, edge, expected_level)?
    let image = std.page.image_of(page)
    if let Some(slot) = std.page.descend(image, key) {
        let Some(child_edge) = std.page.child_slot(page, slot) else {
            fail("store: missing attached PAGE")
        }
        return tiered_point_path(attempt, visible, child_edge, Some(std.page.level(image) - 1), key)
    }
    let (slot, hit) = std.page.search(image, key)
    if !hit {
        return Ok(None)
    }
    Ok(Some(tiered_point_value(attempt, visible, page, slot)?))
}

fn tiered_leaf_prior(leaf: Arc[std.page.Page], key: Bytes) -> u32 {
    let image = std.page.image_of(leaf)
    let (slot, hit) = std.page.search(image, key)
    if !hit {
        return 0
    }
    if let Some(BlobEdge(reference)) = std.page.owning_edge(image, slot) {
        return int.truncate(1 + reference.len)
    }
    let stored = option.unwrap(std.page.value_at(leaf, slot))
    int.truncate(1 + list.len(stored))
}

fn tiered_plan_path(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], page: Arc[std.page.Page], key: Bytes) -> Result[Arc[std.page.Page], Error] {
    let image = std.page.image_of(page)
    let Some(slot) = std.page.descend(image, key) else {
        return Ok(arc.share(page))
    }
    let child_level = Some(std.page.level(image) - 1)
    let edge = option.unwrap(std.page.child_slot(page, slot))
    let child = tiered_point_page(attempt, visible, edge, child_level)?
    if slot != 0 {
        let left = option.unwrap(std.page.child_slot(page, slot - 1))
        let _ = tiered_point_page(attempt, visible, left, child_level)?
    }
    if let Some(right) = std.page.child_slot(page, slot + 1) {
        let _ = tiered_point_page(attempt, visible, right, child_level)?
    }
    tiered_plan_path(attempt, visible, child, key)
}

// The leaf and any siblings that apply can need are resolved before encoding.
// Reading the old width never resolves the old BLOB.
fn tiered_plan_prior(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], tree: PageTree, logical: Bytes) -> Result[u32, Error] {
    if tiered_stopped(attempt) {
        return Error(Missed)
    }
    let collection: u32 = list.word_be(logical, 0)
    if let Some(overlays) = view tree.replay {
        if let Some(_) = std.omap.get(overlays.collections, collection) {
            tiered_latch(attempt, AttemptFold(collection))
            return Error(Missed)
        }
    }
    let Some((edge, descriptor)) = std.page.collection_slot(tree.root, list.slice(logical, 0, 4)) else {
        return Error(Stale(collection))
    }
    let key = list.slice(logical, 4, list.len(logical))
    let origin = tiered_point_page(attempt, visible, edge, None)?
    let leaf = tiered_plan_path(attempt, visible, origin, key)?
    if collection_descriptor(descriptor).kind == LogCollection {
        return Ok(0u32)
    }
    Ok(tiered_leaf_prior(leaf, key))
}

fn tiered_edit_page(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], ptr: std.page.PagePtr, mut failure: Option[Error]) -> Result[Arc[std.page.Page], std.page.Error] {
    match tiered_point_page(attempt, visible, ColdPage(ptr), None) {
        Ok(take loaded) => Ok(take loaded),
        Error(take problem) => {
            failure = Some(take problem)
            Error(MalformedPage)
        },
    }
}

fn stage_tiered_row(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], base: std.page.Slot, empty_root: Arc[std.page.Page], key: Bytes, value: ReplayValue, inline: u64, rightmost: bool, private_from: u64, mut next_stamp: u64) -> Result[Arc[std.page.Page], Error] {
    if tiered_stopped(attempt) {
        return Error(Missed)
    }
    // Pages made by this plan are paid for as dirty images. Only pages
    // inherited from its deciding root spend the attempt's pin partition.
    let mut working = match base {
        HotPage(page) if std.page.stamp(std.page.image_of(page)) >= private_from => arc.share(page),
        _ => tiered_point_page(attempt, visible, base, None)?,
    }
    let mut following_stamp = next_stamp
    let mut failure: Option[Error] = None
    let edited: Result[(), std.page.Error] = {
        let load = scoped fn(ptr: std.page.PagePtr) -> Result[Arc[std.page.Page], std.page.Error] {
            tiered_edit_page(attempt, visible, ptr, mut failure)
        }
        match value {
            ReplayPut(raw) => std.page.insert_shared_resolved(mut working, key, raw, inline, private_from, rightmost, mut following_stamp, load),
            ReplayAbsent => {
                match std.page.remove_resolved(mut working, key, empty_root, private_from, mut following_stamp, load) {
                    Ok(_) => Ok(()),
                    Error(problem) => Error(problem),
                }
            },
        }
    }
    if let Some(take problem) = take failure {
        return Error(take problem)
    }
    page_result(take edited)?
    next_stamp = following_stamp
    Ok(take working)
}

fn stage_tiered_trim(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]], base: std.page.Slot, empty_root: Arc[std.page.Page], limits: LogBounds, before: u64, floor: u64, mut next_stamp: u64) -> Result[(Arc[std.page.Page], u64), Error] {
    if tiered_stopped(attempt) {
        return Error(Missed)
    }
    if floor < limits.first {
        return Error(malformed(0))
    }
    if floor >= limits.next {
        return Ok((arc.share(empty_root), before))
    }
    let working = tiered_point_page(attempt, visible, base, None)?
    let mut following_stamp = next_stamp
    let mut failure: Option[Error] = None
    let clipped = std.page.cut_before_resolved(working, key_word(floor), mut following_stamp, scoped fn(ptr: std.page.PagePtr) -> Result[Arc[std.page.Page], std.page.Error] {
        tiered_edit_page(attempt, visible, ptr, mut failure)
    })
    if let Some(take problem) = take failure {
        return Error(take problem)
    }
    let kept = page_result(take clipped)?
    let (rows, occupied) = std.page.totals(kept)
    let Some(dropped) = int.checked_sub(before, occupied) else {
        return Error(malformed(0))
    }
    if rows != limits.next - floor {
        return Error(malformed(0))
    }
    next_stamp = following_stamp
    Ok((take kept, dropped))
}

scoped type TieredBorrowedRoot {
    edge: View[std.page.Slot],
    pins: View[Map[TieredCacheKey, Arc[TieredFrame]]]
}

// Both possible anchors of a returned row are fields of root. The attempt
// accounts for the visits and retains shares, but it never stores the row's
// locator in its growable bookkeeping.
fn tiered_point_bytes(attempt: core.Cell[TieredTouchSet], root: TieredBorrowedRoot, key: Bytes) -> Result[Option[View[Bytes]], Error] in root {
    tiered_point_bytes_at(attempt, root, root.edge, None, key)
}

fn tiered_point_bytes_at(attempt: core.Cell[TieredTouchSet], root: TieredBorrowedRoot, edge: View[std.page.Slot] in root, expected: Option[u8], key: Bytes) -> Result[Option[View[Bytes]], Error] in root {
    if tiered_blocked(attempt) {
        return Error(Missed)
    }
    let page: View[Arc[std.page.Page]] in root = match edge {
        HotPage(hot) => {
            tiered_touch_hot_page(attempt, hot)?
            view hot
        },
        ColdPage(ptr) => tiered_pinned_page(attempt, root.pins, ptr, expected)?,
    }
    let image = std.page.image_of(page)
    if let Some(selected) = std.page.descend(image, key) {
        let child = option.unwrap(std.page.child_slot(page, selected))
        return tiered_point_bytes_at(attempt, root, child, Some(std.page.level(image) - 1), key)
    }
    let (selected, hit) = std.page.search(image, key)
    if !hit {
        return Ok(None)
    }
    if let Some(BlobEdge(reference)) = std.page.owning_edge(image, selected) {
        let bytes_view: View[Arc[Bytes]] in root = match option.unwrap(std.page.blob_slot(page, reference.body)) {
            HotBlob(contents) => {
                tiered_touch_hot_blob(attempt, reference, contents)?
                view contents
            },
            ColdBlob(ptr) => tiered_pinned_blob(attempt, root.pins, ptr)?,
        }
        return Ok(Some(view bytes_view))
    }
    Ok(std.page.value_at(page, selected))
}

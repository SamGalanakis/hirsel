pub type ReaderInput {
    store: types.StoreKey,
    opened: u64,
    pin_bytes: u64
}

type ReaderPool: send {
    requests: Sender[pager.TieredPagerMessage],
    grant: Arc[pager.TieredReaderGrant]
}

pub opaque type ReaderState: send {
    access: ReadAccess,
    pool: Option[ReaderPool]
}

type ReadAccess {
    store: types.StoreKey,
    opened: u64,
    check: fn(types.StoreKey, u64, types.StoreKey, u64) -> Result[(), types.Failure] waits
}

pub fn open_reader(input: ReaderInput, requests_in: Option[Sender[pager.TieredPagerMessage]]) -> Result[ReaderState, types.Failure] waits {
    let pool: Option[ReaderPool] = match requests_in {
        Some(requests) => {
            let grant = pager.pager_reader_grant(requests, input.pin_bytes)?
            Some(ReaderPool(requests: channel.sender(requests), grant: take grant))
        },
        None => None,
    }
    Ok(make_reader(input.store, input.opened, take pool))
}

fn make_reader(store: types.StoreKey, opened: u64, take pool: Option[ReaderPool]) -> ReaderState {
    ReaderState(access: ReadAccess(store: store, opened: opened, check: hot_read_access), pool: take pool)
}

fn hot_read_access(id: types.StoreKey, opened: u64, captured: types.StoreKey, capture_open: u64) -> Result[(), types.Failure] {
    if id != captured || opened != capture_open {
        return Error(Foreign)
    }
    Ok(())
}

pub fn read_access(r: ReaderState, store: types.StoreKey, opened: u64) -> Result[(), types.Failure] waits {
    (r.access.check)(r.access.store, r.access.opened, store, opened)
}

pub fn snapshot_pager(r: ReaderState, inventory: pages.TieredReadInventory, opened: u64, branch: u32, root_stamp: u64) -> Result[(pager.TieredPageSource, Arc[pager.TieredReaderGrant], pager.TieredPinRoot), types.Failure] {
    let Some(pool) = view r.pool else {
        return Error(Io(Closed))
    }
    let source = pager.TieredPageSource(pager: channel.sender(pool.requests), packs: std.omap.snapshot(inventory.packs), next_stamp: inventory.next_stamp, deadline: 0)
    let root = pager.TieredPinRoot(domain: opened, branch, generation: inventory.generation, root_stamp)
    Ok((take source, arc.share(pool.grant), root))
}

pub scoped type ByteLimit = NoLimit | IncludeKey(View[Bytes]) | ExcludeKey(View[Bytes])

pub fn lower_bytes(id: u32, limit: ByteLimit, high: bool) -> Result[Bytes, types.Failure] {
    match limit {
        NoLimit => catalog.prefix(if high {
            id + 1
        } else {
            id
        }),
        IncludeKey(k) => {
            let mut p = catalog.logical_key(id, k)?
            if high {
                list.push(mut p, 0u8)
            }
            Ok(take p)
        },
        ExcludeKey(k) => {
            let mut p = catalog.logical_key(id, k)?
            if !high {
                list.push(mut p, 0u8)
            }
            Ok(take p)
        }
    }
}

pub fn byte_cursor(data: pages.PageTree, take low: std.omap.Bound[Bytes], high: Bytes) -> Result[pages.PageRange, types.Failure] {
    let empty: Bytes = list.new()
    let (take start, inclusive) = match take low {
        Unbounded => (take empty, true),
        Included(take key) => (take key, true),
        Excluded(take key) => (take key, false),
    }
    pages.open_page_range(data, Some(take start), inclusive, false, Some(types.copied(high)?))
}

pub fn reverse_byte_cursor(data: pages.PageTree, low: Bytes, high: Bytes) -> Result[pages.PageRange, types.Failure] {
    pages.open_page_range(data, Some(types.copied(high)?), false, true, Some(types.copied(low)?))
}

pub fn memory_span_step(mut cursor: Option[pages.PageRange], tree: pages.PageTree, low: Bytes, high: Bytes, previous: Option[Bytes]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], types.Failure] {
    // The allocation scope can only view its captures. The cell transfers the
    // cursor through the scope. A refusal discards it, so the next call resumes
    // after the last key actually returned.
    let exchange = manifest.disk_allocation(scoped fn() -> Result[core.Cell[Option[pages.PageRange]], types.Failure] {
        Ok(cell.new(None))
    })?
    cell.set(exchange, replace(mut cursor, None))
    let selected = manifest.disk_allocation(scoped fn() -> Result[Option[(Bytes, Arc[Bytes], Bytes)], types.Failure] {
        let mut walk = match cell.replace(exchange, None) {
            Some(take active) => take active,
            None => resume_data(tree, low, high, previous, false)?,
        }
        let found = catalog.next_bytes(mut walk)?
        let Some((take key, take value)) = take found else {
            return Ok(None)
        }
        let resume = types.copied(key)?
        cell.set(exchange, Some(take walk))
        Ok(Some((take key, take value, take resume)))
    })
    match take selected {
        Ok(take row) => {
            cursor = cell.into_inner(take exchange)
            Ok(take row)
        },
        Error(take problem) => Error(take problem),
    }
}

pub fn resume_data(data: pages.PageTree, low: Bytes, high: Bytes, final_item: Option[Bytes], reverse: bool) -> Result[pages.PageRange, types.Failure] {
    if reverse {
        return match final_item {
            Some(previous) => reverse_byte_cursor(data, low, previous),
            None => reverse_byte_cursor(data, low, high),
        }
    }
    let start: std.omap.Bound[Bytes] = match final_item {
        Some(previous) => Excluded(types.copied(previous)?),
        None => Included(types.copied(low)?),
    }
    byte_cursor(data, take start, high)
}

pub fn collection_is_tiered(data: pages.PageTree, key: Bytes) -> bool {
    match std.page.lookup(data.root, key) {
        Some(descriptor) => pages.collection_descriptor(descriptor).residency == ResidentTiered,
        None => false,
    }
}

pub fn open_index_cursor(tree: pages.PageTree, id: u32, low: Bytes, high: Bytes) -> Result[(Option[pages.CollectionCursor], bool), types.Failure] {
    if low >= high {
        return Ok((None, false))
    }
    // Below `high`, `low` starts with the index's prefix: `prefix_after` only
    // leaves it at or past the next id, and `high` never passes that id.
    let leading = catalog.prefix(id)?
    let Some((edge, residency)) = std.page.collection_residency(tree.root, leading) else {
        return Ok((None, false))
    }
    if residency != 0 {
        return Ok((None, true))
    }
    let HotPage(root) = edge else {
        fail("store: a Memory index has a Cold root")
    }
    let start = Some(types.copied(list.slice(low, 4, list.len(low)))?)
    let stop = if list.len(high) >= 4 && list.slice(high, 0, 4) == leading {
        Some(types.copied(list.slice(high, 4, list.len(high)))?)
    } else {
        None
    }
    let walk = std.page.cursor_open_bounded(root, start, true, false, take stop)
    Ok((Some(pages.CollectionCursor(walk: take walk, leading: take leading)), false))
}

// RUNNER-SPEC §4 (R2): a Cover names data-tree key ranges (I1) without reading them. `key_span`
// gives the Span a fully consumed range over the same bounds covers.
pub fn prefix_limits[K, Q](id: u32, full: std.codec.Key[K], leading: std.codec.Key[Q], q: Q) -> Result[(Bytes, Bytes), types.Failure] {
    let matches = std.key_prefix.matches(full, leading) ?=> |_| Schema(0)
    if !matches {
        return Error(Schema(0))
    }
    let low = catalog.logical_key(id, catalog.encode_key(leading, q)?)?
    let high = catalog.prefix_after(low)?
    Ok((take low, take high))
}

pub type RowDecoder[K, R: shareable + send]: send {
    table: u32,
    key: std.codec.Key[K],
    readers: Arc[R],
    unique: bool,
    skip: Option[own[send] fn(Bytes, mut u64) -> Result[(), std.codec.DecodeError]]
}

pub fn decode_value[V](codec: std.codec.Codec[V], current: u16, older: List[Option[std.codec.Reader[V]]], id: u32, raw: Bytes) -> Result[V, types.Failure] {
    if list.len(raw) < 2 {
        return Error(Decode(Truncated(0)))
    }
    let number: u16 = int.truncate(format.read_le(raw, 0, 2))
    if number == current {
        return catalog.decoded(std.codec.decode_at(codec, raw, 2))
    }
    let n: u64 = int.widen(number)
    if n >= list.len(older) {
        return Error(Stale(id))
    }
    match older[n] {
        Some(old) => catalog.decoded(std.codec.read_at(old, raw, 2)),
        None => Error(Stale(id))
    }
}

pub fn decode_row_key[K, R: shareable + send](r: RowDecoder[K, R], row_key: Bytes, raw: Bytes) -> Result[(K, Option[Bytes]), types.Failure] {
    let mut at: u64 = 4
    if let Some(skip) = r.skip {
        match (skip)(row_key, mut at) {
            Ok(()) => {},
            Error(e) => return Error(Decode(e))
        }
    }
    let key = if r.unique {
        list.slice(raw, 4, indexes.unique_owner_end(raw)?)
    } else {
        list.slice(row_key, at, list.len(row_key))
    }
    let k = catalog.decoded(std.codec.decode_key(r.key, key))?
    let primary = if let Some(_) = r.skip {
        Some(catalog.logical_key(r.table, key)?)
    } else {
        None
    }
    Ok((take k, take primary))
}

pub fn advance_rows[K, V, R: shareable + send](r: RowDecoder[K, R], data: pages.PageTree, row_key: Bytes, raw: Bytes, remaining: Option[u64], decode: fn(R, u32, Bytes) -> Result[V, types.Failure], seen: scoped[view] fn(Bytes) -> Result[(), types.Failure]) -> Result[Option[((K, V), u64)], types.Failure] {
    let (take k, take owner) = decode_row_key(r, row_key, raw)?
    if let Some(primary) = view owner {
        match pages.get_page_row(data, primary) {
            Some(value) => finish_row(r, take k, primary, value, remaining, decode, seen),
            None => Error(Stale(r.table))
        }
    } else {
        finish_row(r, take k, row_key, raw, remaining, decode, seen)
    }
}

pub fn finish_row[K, V, R: shareable + send](r: RowDecoder[K, R], take key: K, row_key: Bytes, raw: Bytes, remaining: Option[u64], decode: fn(R, u32, Bytes) -> Result[V, types.Failure], seen: scoped[view] fn(Bytes) -> Result[(), types.Failure]) -> Result[Option[((K, V), u64)], types.Failure] {
    let size = list.len(row_key) + list.len(raw)
    if let Some(left) = remaining {
        if size > left {
            return Ok(None)
        }
    }
    let value = decode(r.readers, r.table, raw)?
    seen(row_key)?
    Ok(Some(((take key, take value), size)))
}

pub fn next_memory_snapshot[K, V, R: shareable + send](mut walk: std.page.Cursor, leading: Bytes, decoder: RowDecoder[K, R], data: pages.PageTree, decode: fn(R, u32, Bytes) -> Result[V, types.Failure]) -> Option[Result[(K, V), types.Failure]] {
    std.page.cursor_read(mut walk, scoped fn(suffix: Bytes, raw: Bytes) -> Result[(K, V), types.Failure] {
        if let None = decoder.skip {
            return decode_table_row(decoder, suffix, raw, decode)
        }
        let key = pages.collection_row_key(leading, suffix)
        let (take row_key, take owner) = decode_row_key(decoder, key, raw)?
        let value = if let Some(primary) = view owner {
            let Some(stored) = pages.get_page_row(data, primary) else {
                return Error(Stale(decoder.table))
            }
            decode(decoder.readers, decoder.table, stored)?
        } else {
            decode(decoder.readers, decoder.table, raw)?
        }
        Ok((take row_key, take value))
    })
}

pub fn decode_table_row[K, V, R: shareable + send](decoder: RowDecoder[K, R], suffix: Bytes, raw: Bytes, decode: fn(R, u32, Bytes) -> Result[V, types.Failure]) -> Result[(K, V), types.Failure] {
    let key = catalog.decoded(std.codec.decode_key(decoder.key, suffix))?
    Ok((take key, decode(decoder.readers, decoder.table, raw)?))
}

pub fn snapshot_point[R](r: ReaderState, tree: pages.PageTree, opened: u64, branch: u32, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, types.Failure]) -> Result[R, types.Failure] waits {
    if let Some(inventory) = view tree.paging {
        if let Some((_, descriptor)) = std.page.collection_slot(tree.root, list.slice(logical, 0, 4)) {
            if pages.collection_descriptor(descriptor).residency == ResidentTiered {
                let (take source, take grant, root) = snapshot_pager(r, inventory, opened, branch, pages.tree_stamp(tree))?
                return read_tiered_point(source, grant, root, tree, logical, decode_row)
            }
        }
    }
    decode_row(pages.get_page_row(tree, logical))
}

pub fn open_snapshot_rows(data: pages.PageTree, source: u32, table: u32, low: Bytes, high: Bytes, reverse: bool) -> Result[(Option[pages.CollectionCursor], bool), types.Failure] {
    let tiered = if let Some(_) = data.paging {
        let source_tiered = collection_is_tiered(data, catalog.prefix(source)?)
        source_tiered || (source != table && collection_is_tiered(data, catalog.prefix(table)?))
    } else {
        false
    }
    let cursor: Option[pages.CollectionCursor] = if tiered {
        None
    } else {
        catalog.collection_cursor(data, source, low, high, reverse)?
    }
    let done = if let None = cursor {
        !tiered || list.len(low) < 4
    } else {
        false
    }
    Ok((take cursor, done))
}

pub fn plain_reader(store: types.StoreKey, opened: u64) -> ReaderState {
    make_reader(store, opened, None)
}

pub fn reader_grant(r: ReaderState) -> Option[View[Arc[pager.TieredReaderGrant]]] in r {
    match view r.pool {
        Some(pool) => Some(view pool.grant),
        None => None,
    }
}

pub fn reader_requests(r: ReaderState) -> Option[View[Sender[pager.TieredPagerMessage]]] in r {
    match view r.pool {
        Some(pool) => Some(view pool.requests),
        None => None,
    }
}

pub fn decode_snapshot_next[K, V, R: shareable + send](r: ReaderState, tree: pages.PageTree, opened: u64, branch: u32, decoder: RowDecoder[K, R], key: Bytes, raw: Bytes, decode: fn(R, u32, Bytes) -> Result[V, types.Failure]) -> Result[(K, V), types.Failure] waits {
    let (take row_key, take owner) = decode_row_key(decoder, key, raw)?
    let value = if let Some(primary) = view owner {
        snapshot_point(r, tree, opened, branch, primary, scoped fn(stored: Option[View[Bytes]]) -> Result[V, types.Failure] {
            let Some(row) = stored else {
                return Error(Stale(decoder.table))
            }
            decode(decoder.readers, decoder.table, row)
        })?
    } else {
        decode(decoder.readers, decoder.table, raw)?
    }
    Ok((take row_key, take value))
}

pub opaque type ReadOnlyState: shareable + send {
    store: types.StoreKey,
    head: u64,
    roots: pages.Roots,
    watermark: u64,
    bases: pages.TailBases
}

pub fn read_only_state(store: types.StoreKey, replay: pager.JournalReplay) -> Result[ReadOnlyState, types.Failure] {
    let main = view replay.state.tips[0u64]
    let roots = pages.share_roots(main.roots)
    let watermark = catalog.stamp_after(replay.next_node)?
    let bases = manifest.capture_tail_bases(replay.state.pins)?
    Ok(ReadOnlyState(store: store, head: main.head, roots: take roots, watermark: watermark, bases: take bases))
}

pub fn read_only_identity(source: ReadOnlyState) -> (types.StoreKey, u64, u64) {
    (source.store, source.head, source.watermark)
}

pub fn read_only_roots(source: ReadOnlyState) -> View[pages.Roots] in source {
    view source.roots
}

pub fn read_only_bases(source: ReadOnlyState) -> View[pages.TailBases] in source {
    view source.bases
}

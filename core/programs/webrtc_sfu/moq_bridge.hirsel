// MOQ-8 applies RTC-7 control and socket fences to the MoQ publisher.
pub type BridgeMode: key = StreamsOnly | DatagramsOnly | StreamsAndDatagrams

pub type BridgeConfig: key {
    unit: u16,
    window: u64,
    max_wait_us: u64,
    max_frame_bytes: u64,
    mode: BridgeMode
}

pub type BridgeCounts: key {
    stale: u64,
    unwanted: u64,
    oversized: u64,
    window_overflow: u64,
    published: u64,
    fenced_tracks: u64,
    fenced_streams: u64,
    dropped_datagrams: u64,
    discarded_staged: u64,
    keys: u64
}

type BridgeSeat: key {
    room: peer.RoomId,
    publication: router.PublicationId,
    sub: peer.Gen,
    owner: peer.Gen,
    home: u16
}

type BridgeTrack {
    seat: BridgeSeat,
    depack_codec: rtp_jitter.depack.Codec,
    video: bool,
    target: router.Target,
    mask: u8,
    encoding: Option[u8],
    moq_track: moq.codec.TrackName,
    jitter: rtp_jitter.jitter.Jitter,
    max_frame_bytes: u64,
    needs_key: bool,
    started_group: bool,
    group: u64,
    object_id: u64
}

pub opaque type Bridge {
    r: router.Observer,
    rooms: List[Attached],
    config: BridgeConfig,
    tracks: List[BridgeTrack],
    next_group: u64,
    posts: List[router.Post],
    events: List[rtp_jitter.jitter.Event],
    empty: Shared[Bytes],
    io: moq.LinkIo[moq.MixedDriver],
    publisher: moq.Publisher,
    authority: String,
    path: String,
    send: SendBatch,
    counts: BridgeCounts
}

type Attached: key {
    room: peer.RoomId,
    max_frame_bytes: u64
}

const BRIDGE_ENCODINGS_PER_PUB: u64 = 4

fn decimal_bytes(n: u64) -> Bytes {
    let mut s = string.from("")
    string.push_u64(mut s, n)
    let raw = string.as_bytes(s)
    let mut out: Bytes = list.with_capacity(list.len(raw))
    list.append(mut out, raw)
    take out
}

/// MOQ-8 track name: namespace `(room, participant)` (CAS-2 canonical participant id),
/// name `<kind>/<section>/<rid>`.
pub fn track_name(room: peer.RoomId, owner: peer.Gen, codec: sdp.Codec, section: u8, encoding: u8) -> moq.codec.TrackName {
    let peer.RoomId(rn) = room
    let peer.Gen(id: pid, epoch: _) = owner
    let mut ns_fields: List[Bytes] = list.with_capacity(2)
    list.push(mut ns_fields, decimal_bytes(rn))
    list.push(mut ns_fields, decimal_bytes(pid))
    let ns: moq.codec.Namespace = Namespace(take ns_fields)
    let kind: Bytes = match codec {
        Opus => b"audio",
        Red => b"audio",
        _ => b"video",
    }
    let enc_u64: u64 = int.widen(encoding)
    let rid = decimal_bytes(enc_u64)
    let media_section = decimal_bytes(int.widen(section))
    let mut name: Bytes = list.with_capacity(list.len(kind) + 2 + list.len(media_section) + list.len(rid))
    list.append(mut name, kind)
    list.push(mut name, 0x2f)
    list.append(mut name, media_section)
    list.push(mut name, 0x2f)
    list.append(mut name, rid)
    moq.codec.TrackName(ns: take ns, name: take name)
}

fn seq_price(element: u64, cap: u64) -> u64 {
    match charge.seq(element, cap) {
        Some(v) => v,
        None => 0xffffffffffffffff,
    }
}

/// MOQ-8 budgeted reassembly cost charged in `RoomCost.bridge` (RTC-10).
/// Bounds the per-layer reassembly buffers for every published layer of the room.
pub fn bridge_room_cost(limits: router.RoomLimits, window: u64, max_frame_bytes: u64) -> u64 {
    if window == 0 || window > 32768 {
        return 0xffffffffffffffff
    }
    let participants: u64 = int.widen(limits.participants)
    let pubs: u64 = int.widen(limits.publications)
    let layers = participants * pubs * BRIDGE_ENCODINGS_PER_PUB
    let packets = rtp_jitter.jitter.window_bytes(window, peer.SLOT)
    let frame = seq_price(1, max_frame_bytes)
    let retained = int.saturating_mul(layers, int.saturating_add(packets, frame))
    let table = seq_price(bytes[BridgeTrack], order.max(4, 4 * layers))
    // One depacketization can hold its owned parts and completed frames
    // while draining the bounded window of one track.
    let scratch = 4u64 * packets
    int.saturating_add(int.saturating_add(retained, table), scratch)
}

/// Build a mixed-transport publisher. The configured authority and path identify
/// this broadcast endpoint. Its room attachments determine which tracks it offers.
pub fn bridge(config: BridgeConfig, take q: quic.Endpoint, take w: Option[webtransport.Endpoint], mtu: u16, limits: moq.Limits, most: u64, take authority: String, take path: String) -> Bridge {
    let empty: Bytes = list.new()
    let p = moq.publisher(limits, most, clone(string.as_bytes(authority)), clone(string.as_bytes(path)))
    Bridge(
        r: router.new_observer(config.unit),
        rooms: list.new(),
        config: config,
        tracks: list.new(),
        next_group: 0,
        posts: list.new(),
        events: list.new(),
        empty: shared.new(take empty),
        io: moq.mixed_driver(take q, take w, most),
        publisher: take p,
        authority: take authority,
        path: take path,
        send: SendBatch(wire: list.with_capacity(SEND_BATCH * int.widen(mtu)), tx: list.with_capacity(SEND_BATCH), outputs: list.with_capacity(SEND_BATCH)),
        counts: BridgeCounts(stale: 0, unwanted: 0, oversized: 0, window_overflow: 0, published: 0, fenced_tracks: 0, fenced_streams: 0, dropped_datagrams: 0, discarded_staged: 0, keys: 0),
    )
}

pub fn counts(b: Bridge) -> BridgeCounts {
    b.counts
}

pub fn take_posts(mut b: Bridge) -> List[router.Post] {
    replace(mut b.posts, list.new())
}

pub fn pending_subscriptions(b: Bridge) -> u64 {
    moq.publisher_pending(b.publisher)
}

pub fn track_count(b: Bridge, owner: peer.Gen) -> u64 {
    let mut n = 0u64
    for t in b.tracks {
        if t.seat.owner == owner {
            n += 1
        }
    }
    n
}

fn room_at(b: Bridge, room: peer.RoomId) -> Option[u64] {
    for i in 0u64 .. list.len(b.rooms) {
        if b.rooms[i].room == room {
            return Some(i)
        }
    }
    None
}

/// Install at the latest accepted sequence. The projection is already current
/// because this virtual door participates from pool startup.
fn attach(mut b: Bridge, now: u64, room: peer.RoomId, max_frame_bytes: u64) -> Result[(), router.RouterError] {
    if router.observer_sequence(b.r, room) == None {
        return Error(NoRoom)
    }
    if room_at(b, room) != None {
        return Error(Exists)
    }
    if max_frame_bytes == 0 || max_frame_bytes > b.config.max_frame_bytes {
        return Error(Limit(int.narrow(order.min(b.config.max_frame_bytes, 0xffffffff))))
    }
    list.try_reserve(mut b.rooms, 1) ?=> |cap| Capacity(cap)
    list.push(mut b.rooms, Attached(room: room, max_frame_bytes: max_frame_bytes))
    settle_tracks(mut b, now, room)
    Ok(())
}

fn detach(mut b: Bridge, now: u64, room: peer.RoomId) -> Result[(), router.RouterError] {
    let Some(k) = room_at(b, room) else {
        return Error(NoRoom)
    }
    let _ = list.remove(mut b.rooms, k)
    settle_tracks(mut b, now, room)
    Ok(())
}

/// Apply the accepted RTC-5 order and settle the output before answering.
pub fn control(mut b: Bridge, now: u64, take c: router.Control) -> Option[router.Control] {
    match take c {
        Order(room: room, seq: seq, change: change) => {
            let was_allowed = router.observer_routing_allowed(b.r, room, now / 1000000)
            let answer = router.observer_apply(mut b.r, room, seq, change)
            if let Ok(_) = answer {
                if let Close(..) = change {
                    if let Some(k) = room_at(b, room) {
                        let _ = list.remove(mut b.rooms, k)
                    }
                }
                if was_allowed && !router.observer_routing_allowed(b.r, room, now / 1000000) {
                    if let Suspend(..) = change {
                        pause_room(mut b, now, room)
                    }
                }
                settle_tracks(mut b, now, room)
            }
            let unit = b.config.unit
            Some(Ack(room: room, seq: seq, unit: unit, answer: take answer))
        },
        BridgeOrder(room: room, serial: serial, frame_bytes: cap) => {
            let answer = match cap {
                Some(max) => attach(mut b, now, room, max),
                None => detach(mut b, now, room),
            }
            Some(BridgeAck(room: room, serial: serial, unit: b.config.unit, answer: take answer))
        },
        _ => None,
    }
}

fn pause_room(mut b: Bridge, now: u64, room: peer.RoomId) {
    discard_staged(mut b, now)
    for i in 0u64 .. list.len(b.tracks) {
        if b.tracks[i].seat.room != room {
            continue
        }
        let name: moq.codec.TrackName = clone(b.tracks[i].moq_track)
        moq.publisher_pause(mut b.publisher, mut b.io, name)
        restart_track(mut b, i)
        b.tracks[i].started_group = false
        b.tracks[i].object_id = 0
    }
}

/// Take one media-inbox message from a publisher's home unit (RTC-5, RTC-7 step 4).
pub fn carried(mut b: Bridge, now: u64, take msg: router.Carried) {
    let router.Carried(carry: carry, packet: packet) = take msg
    match carry {
        Media(room: room, publication: p, src: src, m: m, ..) => on_media(mut b, now, room, p, src, m, packet),
        _ => {
            b.counts.unwanted += 1
        },
    }
}

/// Advance jitter buffers so completed frames whose holes timed out are emitted.
pub fn poll_jitter(mut b: Bridge, now: u64) {
    for i in 0u64 .. list.len(b.tracks) {
        if !router.observer_routing_allowed(b.r, b.tracks[i].seat.room, now / 1000000) {
            continue
        }
        rtp_jitter.jitter.poll(mut b.tracks[i].jitter, now / 1000, mut b.events)
        deliver_frames(mut b, i, now)
    }
}

fn settle_tracks(mut b: Bridge, now: u64, room: peer.RoomId) {
    let downs = router.observer_downs(b.r, room)
    let mut i = 0u64
    while i < list.len(b.tracks) {
        let t = b.tracks[i].seat
        if t.room != room {
            i += 1
            continue
        }
        let target = b.tracks[i].target
        let kept = room_at(b, t.room) != None && list.any(downs, scoped fn(d: router.DownInfo) -> bool {
            d.room == t.room && d.publication == t.publication && d.sub == t.sub && d.target == target
        })
        if kept && !router.observer_fenced(b.r, t.room, t.owner) {
            i += 1
        } else {
            close_track(mut b, i, now)
        }
    }
    for d in downs {
        let Some(a) = room_at(b, d.room) else {
            continue
        }
        let found = list.any(b.tracks, scoped fn(t: BridgeTrack) -> bool {
            t.seat.room == d.room && t.seat.publication == d.publication && t.seat.sub == d.sub
        })
        if !found {
            let max_frame_bytes = b.rooms[a].max_frame_bytes
            open_track(mut b, d, max_frame_bytes)
        }
    }
}

fn open_track(mut b: Bridge, d: router.DownInfo, max_frame_bytes: u64) {
    let Layer(encoding: enc, ..) = d.target else {
        return
    }
    let Some(info) = router.observer_publication(b.r, d.room, d.publication) else {
        return
    }
    let depack_codec: rtp_jitter.depack.Codec = match info.shape.codec {
        Opus => Opus,
        Vp8 => Vp8,
        Vp9 => Vp9,
        Av1 => Av1,
        H264 => H264,
        _ => return,
    }
    let video = info.shape.codec != Opus
    let tr = track_name(d.room, info.owner, info.shape.codec, info.section, enc)
    if list.any(b.tracks, scoped fn(t: BridgeTrack) -> bool {
        t.moq_track == tr
    }) {
        return
    }
    let j = new_jitter(b.config, depack_codec)
    list.push(mut b.tracks, BridgeTrack(
        seat: BridgeSeat(room: d.room, publication: d.publication, sub: d.sub, owner: info.owner, home: info.home),
        depack_codec: depack_codec,
        video: video,
        target: d.target,
        mask: 0,
        encoding: None,
        moq_track: take tr,
        jitter: take j,
        max_frame_bytes: max_frame_bytes,
        needs_key: video,
        started_group: false,
        group: 0,
        object_id: 0,
    ))
    send_want(mut b, list.len(b.tracks) - 1)
}

fn close_track(mut b: Bridge, i: u64, now: u64) {
    discard_staged(mut b, now)
    let t = list.remove(mut b.tracks, i)
    let (reset, dropped) = moq.publisher_fence(mut b.publisher, mut b.io, t.moq_track)
    b.counts.fenced_tracks += 1
    b.counts.fenced_streams += reset
    b.counts.dropped_datagrams += dropped
    if t.mask != 0 {
        let unit = b.config.unit
        post_bare(mut b, t.seat.home, Wanted(room: t.seat.room, publication: t.seat.publication, src: t.seat.owner, unit: unit, mask: 0))
    }
}

fn new_jitter(c: BridgeConfig, codec: rtp_jitter.depack.Codec) -> rtp_jitter.jitter.Jitter {
    rtp_jitter.jitter.new(rtp_jitter.jitter.Config(codec: codec, window: c.window, max_wait_us: c.max_wait_us))
}

fn restart_track(mut b: Bridge, i: u64) {
    let dc = b.tracks[i].depack_codec
    b.tracks[i].jitter = new_jitter(b.config, dc)
    b.tracks[i].needs_key = b.tracks[i].video
}

fn send_want(mut b: Bridge, i: u64) {
    let mask: u8 = match b.tracks[i].target {
        Layer(encoding: e, ..) => 1u8 << e,
        Off => 0,
    }
    if mask == b.tracks[i].mask {
        return
    }
    b.tracks[i].mask = mask
    let t = b.tracks[i].seat
    let unit = b.config.unit
    post_bare(mut b, t.home, Wanted(room: t.room, publication: t.publication, src: t.owner, unit: unit, mask: mask))
}

fn post_bare(mut b: Bridge, to: u16, take carry: router.Carry) {
    let packet = shared.share(b.empty)
    list.push(mut b.posts, router.Post(to: to, carried: router.Carried(carry: take carry, packet: packet)))
}

fn ask_key(mut b: Bridge, i: u64) {
    let Some(e) = b.tracks[i].encoding else {
        return
    }
    let t = b.tracks[i].seat
    b.counts.keys += 1
    post_bare(mut b, t.home, Key(room: t.room, publication: t.publication, encoding: e, why: Loss))
}

fn on_media(mut b: Bridge, now: u64, room: peer.RoomId, p: router.PublicationId, src: peer.Gen, m: peer.MediaIn, packet: Bytes) {
    // RTC-7 step 4: drop media of any fenced generation or suspended room on arrival.
    if router.observer_fenced(b.r, room, src) || !router.observer_routing_allowed(b.r, room, now / 1000000) {
        b.counts.stale += 1
        return
    }
    let mut taken = false
    for i in 0u64 .. list.len(b.tracks) {
        if b.tracks[i].seat.room != room || b.tracks[i].seat.publication != p {
            continue
        }
        if b.tracks[i].seat.owner != src {
            b.counts.stale += 1
            continue
        }
        let Layer(encoding: e, ..) = b.tracks[i].target else {
            continue
        }
        if e != m.encoding || m.payload_at > list.len(packet) || m.payload_len > list.len(packet) - m.payload_at || m.payload_len > peer.SLOT {
            continue
        }
        taken = true
        if b.tracks[i].encoding != Some(e) || m.reset {
            restart_track(mut b, i)
            b.tracks[i].encoding = Some(e)
        }
        let seq: u16 = int.truncate(m.index)
        if !rtp_jitter.jitter.window_fits(b.tracks[i].jitter, seq) {
            rtp_jitter.jitter.poll(mut b.tracks[i].jitter, now / 1000, mut b.events)
            deliver_frames(mut b, i, now)
            if !rtp_jitter.jitter.window_fits(b.tracks[i].jitter, seq) {
                b.counts.window_overflow += 1
                restart_track(mut b, i)
                if b.tracks[i].video {
                    ask_key(mut b, i)
                }
            }
        }
        let mut payload: Bytes = list.with_capacity(m.payload_len)
        list.append(mut payload, list.slice(packet, m.payload_at, m.payload_at + m.payload_len))
        rtp_jitter.jitter.push(mut b.tracks[i].jitter, seq, m.ts, m.marker, take payload, now / 1000, mut b.events)
        deliver_frames(mut b, i, now)
    }
    if !taken {
        b.counts.unwanted += 1
    }
}

fn deliver_frames(mut b: Bridge, i: u64, now: u64) {
    let events = replace(mut b.events, list.new())
    for take ev in events {
        match take ev {
            Frame(ts: _, key: key, data: take data) => publish_frame(mut b, i, now, key, take data),
            Gap(..) => (),
            NeedKeyframe => {
                if b.tracks[i].video {
                    b.tracks[i].needs_key = true
                    ask_key(mut b, i)
                }
            },
        }
    }
}

fn publish_frame(mut b: Bridge, i: u64, now: u64, key: bool, take data: Bytes) {
    // MOQ-8: a frame past the layer's max_frame_bytes bound is dropped and counted,
    // and the next keyframe starts a new group.
    if list.len(data) > b.tracks[i].max_frame_bytes {
        b.counts.oversized += 1
        if b.tracks[i].video {
            b.tracks[i].needs_key = true
            ask_key(mut b, i)
        }
        return
    }
    if b.tracks[i].needs_key && !key {
        return
    }
    // Allocate fresh group IDs even when a new epoch reuses a track name.
    // The subscriber may still retain duplicate guards for the old epoch.
    if key || !b.tracks[i].started_group {
        if b.tracks[i].started_group {
            let prev = b.tracks[i].group
            let name: moq.codec.TrackName = clone(b.tracks[i].moq_track)
            moq.publisher_finish(mut b.publisher, mut b.io, now, name, prev)
        }
        b.tracks[i].started_group = true
        b.tracks[i].group = b.next_group
        b.next_group += 1
        b.tracks[i].object_id = 0
        b.tracks[i].needs_key = false
    }
    let shared_payload = shared.new(take data)
    let g = b.tracks[i].group
    let oid = b.tracks[i].object_id
    b.tracks[i].object_id += 1
    let tr: moq.codec.TrackName = clone(b.tracks[i].moq_track)
    let prio: u8 = if key {
        10
    } else {
        40
    }
    let send_stream = b.config.mode == StreamsOnly || b.config.mode == StreamsAndDatagrams
    let send_dg = b.config.mode == DatagramsOnly || (b.config.mode == StreamsAndDatagrams && list.len(shared_payload) <= 900)
    if send_stream {
        let obj = moq.Object(track: clone(tr), group: g, subgroup: 0, id: oid, mode: Subgroup, publisher_priority: prio, status: Normal, properties: b"", payload: quic.payload_whole(shared.share(shared_payload)))
        moq.publisher_send(mut b.publisher, mut b.io, now, obj)
    }
    if send_dg {
        let dg_oid = if send_stream {
            let x = b.tracks[i].object_id
            b.tracks[i].object_id += 1
            x
        } else {
            oid
        }
        let obj = moq.Object(track: clone(tr), group: g, subgroup: 0, id: dg_oid, mode: Datagram, publisher_priority: prio, status: Normal, properties: b"", payload: quic.payload_whole(shared.share(shared_payload)))
        moq.publisher_send(mut b.publisher, mut b.io, now, obj)
    }
    b.counts.published += 1
}

// WIRE-SPEC 2.3: ten reader-funded frames at q=4, assembly plus growth and
// scratch 401408, and 4096 bytes of reader bookkeeping. Decode's safe bound
// is four payload bytes per encoded byte plus 128 per frame, not a run's peak.
fn pressure(take c: WireConfig) -> bool {
    let units = 1u64 + c.q
    let (head, stalled): (Sender[Frame], Receiver[Frame]) = result.unwrap(channel.new(units))
    let (to, inbox): (Sender[Frame], Receiver[Frame]) = result.unwrap(channel.new(units))
    let mut input: Bytes = result.unwrap(list.with_capacity(c.socket.max_frame))
    result.unwrap(std.codec.put_u32(1u32, mut input))
    result.unwrap(std.codec.put_u32(0u32, mut input))
    result.unwrap(std.codec.put_u64(0u64, mut input))
    result.unwrap(std.codec.put_u32(0u32, mut input))
    result.unwrap(std.codec.put_u32(1000u32, mut input))
    result.unwrap(std.codec.put_u32(262116u32, mut input))
    while list.len(input) < c.socket.max_frame { result.unwrap(list.push(mut input, 97u8)) }
    for _ in 0u64 .. units {
        let f = result.unwrap(wire_decode(input))
        if let Error(_) = channel.try_send(head, take f) { return false }
    }
    for _ in 0u64 .. units {
        let f = result.unwrap(wire_decode(input))
        if let Error(_) = channel.try_send(to, take f) { return false }
    }
    // A max frame still being assembled, with geometric-growth transient and
    // receive scratch, while neither consumer drains its held requests.
    let assembly: Bytes = result.unwrap(list.with_capacity(401408u64))
    let full_head = match channel.try_send(head, Unsubscribe(0u32)) { Error(Full(_)) => true, _ => false }
    let full_inbox = match channel.try_send(to, Unsubscribe(0u32)) { Error(Full(_)) => true, _ => false }
    let mut count = 0u64
    for _ in 0u64 .. units {
        if let Ok(Call(_, _, _, _, arg)) = channel.try_receive(stalled) {
            if list.len(arg) == c.socket.max_frame - 28u64 { count += 1u64 }
        }
        if let Ok(Call(_, _, _, _, arg)) = channel.try_receive(inbox) {
            if list.len(arg) == c.socket.max_frame - 28u64 { count += 1u64 }
        }
    }
    full_head && full_inbox && count == 10u64 && list.capacity(assembly) == 401408u64
}

pub fn law_reader_reservation_holds(tasks: Tasks) -> bool waits {
    let c = wire_defaults(0u64, 0u64)
    // Independent arithmetic from the WIRE formula, for m=262144 and q=4.
    let expected = 10u64 * (4u64 * 262144u64 + 128u64) + 401408u64 + 4096u64
    if reader_bytes(c) < expected { return false }
    let h = match task.spawn(tasks, bytes reader_bytes(c), c, pressure) {
        Ok(take h) => take h, Error(_) => return false,
    }
    match task.join(take h) { Ok(ok) => ok, Error(_) => false }
}

@test
fn test_wire_session(tasks: Tasks) -> Result[(), ()] waits {
    if law_session_records(tasks) && law_reader_reservation_holds(tasks) && law_writer_one_frame() && law_children_joined_on_close(tasks) { Ok(()) } else { Error(()) }
}

pub fn law_writer_one_frame() -> bool {
    // Two caller-owned candidate frames and one Bytes handoff record. A third
    // charged byte cannot fit; the writer cannot reserve or retain another frame.
    let checked = bound bytes (2u64 * 262160u64 + 88u64) {
        let (tx, rx): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1u64))
        let first: Bytes = result.unwrap(list.with_capacity(262158u64))
        let second: Bytes = result.unwrap(list.with_capacity(262158u64))
        let mut busy = false
        let handed = if wire_ready(busy) {
            match wire_offer(tx, mut busy, take first) { Ok(()) => true, _ => false }
        } else { false }
        let pending = result.unwrap(channel.try_receive(rx))
        let rejected = if wire_ready(busy) {
            let _ = wire_offer(tx, mut busy, take second)
            false
        } else {
            let extra: Result[Bytes, Capacity] = list.with_capacity(1u64)
            let charged = match extra { Error(_) => true, _ => false }
            charged && list.capacity(second) == 262158u64
        }
        let empty = match channel.try_receive(rx) { Error(Empty) => true, _ => false }
        handed && busy && rejected && empty && list.capacity(pending) == 262158u64
    }
    match checked { Ok(ok) => ok, Error(_) => false }
}

fn wire_park(take rx: Receiver[()]) -> () waits { let _ = channel.receive(rx) }

pub fn law_children_joined_on_close(tasks: Tasks) -> bool waits {
    let (a, ar): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let (b, br): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let reader = result.unwrap(task.spawn(tasks, bytes 4096u64, take ar, wire_park))
    let writer = result.unwrap(task.spawn(tasks, bytes 4096u64, take br, wire_park))
    wire_join(take reader, take writer)
    let read_closed = match channel.try_send(a, ()) { Error(Closed(_)) => true, _ => false }
    let write_closed = match channel.try_send(b, ()) { Error(Closed(_)) => true, _ => false }
    read_closed && write_closed
}

fn wire_owner_park(take rx: Receiver[()]) -> Result[(), std.wsock.Error] waits {
    let _ = channel.receive(rx)
    Ok(())
}

pub fn law_session_records(tasks: Tasks) -> bool waits {
    // charge-v1: five WireEvents of 426 plus 64, one Bytes plus 64,
    // a credit channel of zero-sized units plus 64; three test gates of 64;
    // two unit-returning task records of 288 and the owner record of 320.
    let checked = bound bytes 3434u64 {
        let (events, hear): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(5u64))
        let (writes, read_writes): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1u64))
        let (credit, read_credit): (Sender[()], Receiver[()]) = result.unwrap(channel.new(5u64))
        let (a, ar): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let (b, br): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let (end, er): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let mut owner = result.unwrap(task.spawn(tasks, bytes 0u64, take er, wire_owner_park))
        let reader = result.unwrap(task.spawn(tasks, bytes 0u64, take ar, wire_park))
        let writer = result.unwrap(task.spawn(tasks, bytes 0u64, take br, wire_park))
        let extra: Result[Bytes, Capacity] = list.with_capacity(1u64)
        let exact = match extra { Error(_) => true, _ => false }
        task.cancel(mut owner)
        wire_join(take reader, take writer)
        let _ = task.join(take owner)
        let owner_closed = match channel.try_send(end, ()) { Error(Closed(_)) => true, _ => false }
        let _ = channel.try_send(events, wire_event(Sent))
        let _ = channel.try_send(writes, list.new())
        let _ = channel.try_send(credit, ())
        let live = match (channel.try_receive(hear), channel.try_receive(read_writes), channel.try_receive(read_credit)) {
            (Ok(WireEvent(e: Sent)), Ok(_), Ok(())) => true,
            _ => false,
        }
        let closed = match (channel.try_send(a, ()), channel.try_send(b, ())) {
            (Error(Closed(_)), Error(Closed(_))) => true,
            _ => false,
        }
        exact && live && closed && owner_closed
    }
    match checked { Ok(ok) => ok, Error(_) => false }
}

const ITEMS: u64 = 60
const SPLIT: u64 = 5
const LANES: u64 = 32
const ROUND_NODES: u64 = 2048

// Positive weights in density order. The seeded jitter is applied to the
// prefix sums, so the fractional ceiling can find its last whole item by bisection.
fn prefix_weight(n: u64) -> u64 {
    if n == 0 { return 0 }
    let jitter = int.wrapping_mul(n + 1199, 11400714819323198485u64) >> 61
    100 * n + 17 * n * (n - 1) / 2 + jitter
}

fn capacity() -> u64 {
    prefix_weight(ITEMS) / 3 + 7
}

fn weight(i: u64) -> u64 {
    prefix_weight(i + 1) - prefix_weight(i)
}

fn upper(depth: u64, remaining: u64, value: u64) -> u64 {
    let base = prefix_weight(depth)
    let mut low = depth
    let mut high = ITEMS + 1
    while low + 1 < high {
        let mid = (low + high) / 2
        if prefix_weight(mid) - base <= remaining {
            low = mid
        } else {
            high = mid
        }
    }
    let used = prefix_weight(low) - base
    let mut ceiling = value + used + 300 * (low - depth)
    if low < ITEMS {
        let w = weight(low)
        ceiling += (remaining - used) * (w + 300) / w
    }
    ceiling
}

type Cursor: codec {
    prefix: u64,
    chosen: u64,
    depth: u64,
    remaining: u64,
    value: u64,
    done: bool
}

type Reply: codec {
    nodes: u64,
    best: u64,
    witness: u64,
    done: bool
}

fn root(lane: u64) -> Cursor {
    let mut remaining = capacity()
    let mut value: u64 = 0
    for i in 0 .. SPLIT {
        if (lane & (1u64 << i)) != 0 {
            let w = weight(i)
            remaining -= w
            value += w + 300
        }
    }
    Cursor(prefix: lane, chosen: 0, depth: SPLIT, remaining: remaining, value: value, done: false)
}

fn stage(take cursor: Cursor, key: u64, incumbent: u64) -> (Cursor, Option[Reply]) {
    let mut state = cursor
    let mut best = incumbent
    let mut witness: u64 = 0
    let mut nodes: u64 = 0
    while nodes < ROUND_NODES && !state.done {
        nodes += 1
        if state.value > best {
            best = state.value
            witness = state.prefix | state.chosen
        }
        let depth = state.depth
        if depth < ITEMS && upper(depth, state.remaining, state.value) > best {
            let w = weight(depth)
            state.depth = depth + 1
            if w <= state.remaining {
                state.chosen |= 1u64 << depth
                state.remaining -= w
                state.value += w + 300
            }
        } else if state.chosen == 0 {
            state.done = true
        } else {
            // The most recent include decision still has an unvisited exclude branch.
            let zeros: u64 = int.widen(int.leading_zeros(state.chosen))
            let last = 63 - zeros
            state.chosen ^= 1u64 << last
            let w = weight(last)
            state.depth = last + 1
            state.remaining += w
            state.value -= w + 300
        }
    }
    (state, Some(Reply(nodes: nodes, best: best, witness: witness, done: state.done)))
}

pub fn main(tasks: Tasks, out: Stdout, clock: Clock) -> Result[(), Exit] waits {
    let start = host.mono_ns(clock)
    let mut f = flow.new()
    let mut lanes: List[(Port[u64], Sink[Reply])] = list.with_capacity(LANES)
    for i in 0 .. LANES {
        // Lane 0 visits the all-include prefix, which supplies a good incumbent first.
        let (sink, into): (Sink[Reply], Into[Reply]) = result.unwrap(flow.sink(mut f))
        let input = result.unwrap(flow.stage(mut f, into, 1, bytes 0, steps 2000000, root(LANES - 1 - i), code.describe(stage)))
        let port = result.unwrap(flow.port(mut f, input, 1))
        list.push(mut lanes, (port, sink))
    }
    let mut active: Inline[bool, 32] = [true; 32]
    let mut remaining = LANES
    let mut best: u64 = 0
    let mut witness: u64 = 0
    let mut nodes: u64 = 0
    let mut key: u64 = 0
    let mut winning_start = start
    let mut winning_end = start
    let mut last_start = start
    while remaining > 0 {
        let round_start = host.mono_ns(clock)
        last_start = round_start
        let before = best
        for i in 0 .. LANES {
            if active[i] {
                let (port, _) = lanes[i]
                match flow.push(mut f, port, key, before) {
                    Ok => (),
                    _ => fail("knapsack request")
                }
            }
        }
        for i in 0 .. LANES {
            if active[i] {
                let (_, sink) = lanes[i]
                match flow.next(mut f, sink) {
                    Item(key: _, from: _, x: reply) => {
                        nodes += reply.nodes
                        if reply.best > best {
                            best = reply.best
                            witness = reply.witness
                        }
                        if reply.done {
                            active[i] = false
                            remaining -= 1
                        }
                    },
                    _ => fail("knapsack reply")
                }
            }
        }
        if best > before {
            winning_start = round_start
            winning_end = host.mono_ns(clock)
        }
        key += 1
    }
    let drained = host.mono_ns(clock)
    result.unwrap(flow.finish(take f))
    let elapsed = host.mono_ns(clock) - start
    let mut line = string.new()
    let fields: Inline[u64, 7] = [
        elapsed, nodes, best, witness,
        int.saturating_sub(last_start, winning_end), drained - winning_start, key
    ]
    for field in fields {
        string.push_u64(mut line, field)
        string.push(mut line, " ")
    }
    string.push(mut line, "\n")
    result.unwrap(stdout.write(out, line))
    Ok(())
}

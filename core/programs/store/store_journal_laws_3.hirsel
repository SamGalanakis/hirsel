// L24 (iv)(b), Y1: the journal task's ack send never waits. group_commits = 1
// and group_bytes = 1 make the frame queue 2 places and the ack channel 6.
// Eight commits, each written and acked before the next (recorded's barrier
// waits for the write; the journal syncs and acks before its next receive):
// without the drain at the start of run the 7th ack finds 6/6 full and the
// next barrier is never answered. A commit without a CALL section is None.
// (iv)(a), syncs held across the writer's turns, is the provider scenario
// journal-ack (journal_ack_held), because only the provider can hold a sync.
fn journal_ack_options() -> Options {
    let mut options = journal_crash_options()
    options.group_commits = 1
    options.group_bytes = 1
    options.checkpoint_bytes = 1073741824
    options.journal_limit = 1090519120
    options
}

pub fn journal_law_ack_channel(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = result.unwrap(open(tasks, disk_test_directory(d), c, r, journal_ack_options()))
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let br = main_branch(db)
    for k in 0u64 .. 8 {
        match result.unwrap(run(mut db, None, (copy_env(t), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, call_env.1, call_env.1 + 10)
        })) {
            Committed(_) => {},
            _ => return false
        }
        let head = pages.holder_heads(db.holders)[0].head
        match recorded(db, br, head) {
            Ok(None) => {},
            _ => return false
        }
    }
    result.unwrap(close(take db))
    true
}

// L24 (iv)(a), Y1's counterexample: the provider holds every journal sync for
// one writer turn, so f2 and f3 queue, the 4th commit's send waits, and the
// acks of f1..f3 arrive with no drain between them. At capacity 2g the ack of
// f3 finds 2/2 full, recorded's Barrier waits behind f4, and every task blocks.
fn journal_ack_held(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, journal_ack_options())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    for k in 0u64 .. 4 {
        let committed = run(mut db, None, (copy_env(t), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, call_env.1, call_env.1 + 10)
        })?
        match take committed {
            Committed(_) => {},
            _ => fail("journal-ack commit")
        }
    }
    let br = main_branch(db)
    let head = pages.holder_heads(db.holders)[0].head
    match recorded(db, br, head)? {
        None => {},
        Some(_) => fail("journal-ack record")
    }
    let cut = checkpoint(mut db)?
    durable(mut db, cut)?
    close(take db)
}


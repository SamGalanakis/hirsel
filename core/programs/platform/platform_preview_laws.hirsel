// Laws of the platform host's deploy preview and its decision (launch.md "Deploy preview";
// RUNNER-SPEC §14.7: L48's decision half and L54) over the faked launcher, with their rig
// helpers.
// A grant diff of at most one added and one removed line; "" is none.
fn grants_of(added: String, removed: String) -> launcher.Grants {
    let mut g = launcher.no_grants()
    if added != "" {
        list.push(mut g.added, string.from(added))
    }
    if removed != "" {
        list.push(mut g.dropped, string.from(removed))
    }
    g
}

// Whether `p` awaits a decision on exactly the diff `added` and `removed` name.
fn awaits(p: Option[operator.Phase], added: String, removed: String) -> bool {
    match p {
        Some(AwaitDecision(x)) => same_grants(x.grants, grants_of(added, removed)),
        _ => false,
    }
}

// The operator decides request d's grant diff on a new connection: the decision the host
// shows (an empty Admission-stage one when it shows none) with its grants replaced by `diff`,
// and no fates. Gives the connection.
fn decide_on(mut r: Rig, d: Bytes, take diff: launcher.Grants, approve: bool) -> u64 waits {
    let mut shown = match status_of(mut r, d) {
        Some(AwaitDecision(x)) => x,
        _ => operator.Decision(tree: list.new(), root: list.new(), stage: AdmissionStage, grants: launcher.no_grants(), approvals: None, migration: None, triggers: operator.no_triggers()),
    }
    shown.grants = take diff
    decide_with(mut r, d, take shown, runner.fate.none(), approve)
}

// The operator sends Decide(d, decision, fates, approve) on a new connection; the rig's
// attempt becomes any the host assigned. Gives the connection.
fn decide_with(mut r: Rig, d: Bytes, take decision: operator.Decision, take fates: runner.fate.Fates, approve: bool) -> u64 waits {
    r.conns += 1u64
    let conn = r.conns
    send(mut r, conn, DecideAsk(clone(d), take decision, take fates, approve))
    if let Some(p) = phase_on(r, conn) {
        if let Some(a) = attempt_of(p) {
            r.a = a
        }
    }
    r.conn = conn
    conn
}

// The prepare child's trigger report: one held Transact trigger with fate `chosen`.
fn trigger_report_of(chosen: Option[runner.fate.HeldFate]) -> Bytes {
    let c: std.codec.Codec[runner.TriggerReport] = std.codec.of()
    let mut rows: List[runner.TriggerScanRow] = list.new()
    list.push(mut rows, runner.TriggerScanRow(class: Held, kind: Transact, path: bytes_of(4u64, 7u8), schema: bytes_of(4u64, 8u8), hold: Some(Cut), fate: chosen, count: 2u64, earliest_due: 9u64))
    let mut out: Bytes = list.new()
    let _ = std.codec.encode(c, runner.TriggerReport(rows: take rows, unmatched: list.new()), mut out)
    out
}

// A settled report: its one held group is released.
fn trigger_answer() -> Bytes {
    trigger_report_of(Some(Release))
}

fn imports_of(r: Rig) -> u64 {
    let mut n = 0u64
    for q in r.asked {
        if let Command(_, HostImport(_, _, _, _)) = q {
            n += 1u64
        }
    }
    n
}

// The fates bytes of every prepare child the host started, in order.
fn prepare_fates(r: Rig) -> List[Bytes] {
    let mut out: List[Bytes] = list.new()
    for q in r.asked {
        if let Start(l) = q {
            if let PrepareMode(_, _, f) = l.mode {
                list.push(mut out, clone(f))
            }
        }
    }
    out
}

// L54 (v2.81): a report whose held group has no fate aborts OLD's export once and holds the
// deploy for the operator's decision on that report (RUNNER-SPEC §14.6, launch.md
// "Self-editing" "Holds and decisions"); nothing is imported and OLD serves on. A Decide
// that approves the shown decision with `all` Release repeats the admission, its prepare
// child gets the hand-encoded `Fates(all: Some(Release), entries: [])`, and the same
// request is Installed.
fn unsettled_deploy(c: Clock, rnd: Random) waits {
    let mut u = rig(c, rnd, 4u64)
    add(mut u, "g", "t")
    op_wake(mut u, "g")
    let old = last(u, "g")
    let held_d = request_id(u.conns + 1u64)
    to_export(mut u, old, preview_answer(image_two(), release_two()))
    old_says(mut u, old, PlaceExported(1u64, "export-1"))
    let ua = u.a
    helper_answers(mut u, helper_child(old, PrepareMode(ua, "export-1", list.new())), trigger_report_of(None))
    expect(asked_of(u, 3u64) == 1u64 && imports_of(u) == 0u64 && still_preparing(u), "L54: an unsettled report did not abort OLD's export once before any import")
    old_says(mut u, old, PlaceAborted)
    let held = match status_of(mut u, held_d) {
        Some(AwaitDecision(x)) => Some(x),
        _ => None,
    }
    let Some(shown) = held else {
        expect(false, "L54: an unsettled report did not hold the deploy for the operator's decision")
        unplug(mut u)
        return
    }
    let report_ok = match shown.stage {
        PreparedStage => list.len(shown.triggers.rows) == 1u64 && shown.triggers.rows[0u64].fate == None && operator.shows_held(shown),
        AdmissionStage => false,
    }
    expect(report_ok && asked_of(u, 3u64) == 1u64 && imports_of(u) == 0u64 && old_serves(u), "L54: the held decision does not carry the trigger report, or OLD stopped serving")
    let mut release_all = runner.fate.none()
    release_all.all = Some(Release)
    let _ = decide_with(mut u, held_d, clone(shown), take release_all, true)
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Admitted(u.a, image_two(), summary_of(1u64, 1u64, launcher.no_grants()), ""))
    feed(mut u, take events)
    assembled_new(mut u)
    let a = u.a
    helper_answers(mut u, helper_child(old, DescribeMode(a)), describe_answer())
    helper_answers(mut u, helper_child(old, PreviewMode(a, list.new())), preview_answer(image_two(), release_two()))
    old_says(mut u, old, PlaceExported(1u64, "export-2"))
    helper_answers(mut u, helper_child(old, PrepareMode(a, "export-2", list.new())), trigger_answer())
    let fates = prepare_fates(u)
    expect(list.len(fates) == 2u64 && std.hex.encode(fates[0u64]) == "0000000000000000" && std.hex.encode(fates[1u64]) == "010000000000000000000000", "L54: the repeated prepare did not get the decision's fates")
    let cut = apply(mut u, Got(Placed(clone(old), PlaceImported(image_two(), runner.ImportedMigration(digest: list.new(), changes: list.new())))))
    pump(mut u, take cut)
    answer(mut u, old, PlaceInstalled(2u64, true))
    expect(is_installed(status_of(mut u, held_d)), "L54: the decided deploy was not Installed")
    unplug(mut u)
}

// One exported entry: Transact, `identity` and code revision `revision`.
fn entry_of(identity: u8, revision: u8) -> runner.Exported {
    let described = runner.Described(kind: Transact, identity: bytes_of(32u64, identity), args: list.new(), result: list.new())
    runner.Exported(described: described, args_fp: 0u64, result_fp: 0u64, revision: bytes_of(32u64, revision), slots: list.new(), value: list.new())
}

// A Describe of image `digest` exporting `entries`.
fn describing(digest: Bytes, take entries: List[runner.Exported]) -> runner.Describe {
    runner.Describe(digest: clone(digest), target: "t", n_place: 1u64, revision: clone(digest), exported: take entries, tables: list.new(), bindings: list.new())
}

// L54 `deploy_preview` (launch.md "Deploy preview"): the deploy's report shows what NEW
// changes. OLD exports entries 1 and 2 at revision 1, and NEW, a self-edit that swaps the
// tool entry 2 reaches and adds entry 3, exports 1 at revision 1, 2 at revision 2 and 3:
// the entry diff is exactly 1 unchanged, 2 changed, 3 added, and entry 4, which only OLD
// exports, removed. The prepare child's trigger report is the report's, row for row, and
// a prepare child that exits 0 without one fails the deploy.
@test
fn deploy_preview(c: Clock, rnd: Random) -> Result[(), ()] waits {
    let mut r = rig(c, rnd, 4u64)
    add(mut r, "g", "t")
    op_wake(mut r, "g")
    let old = last(r, "g")
    let submitted = release_source("", 2u8)
    let publication = request_id(51u64)
    let _ = begin_with(mut r, publication, submitted)
    source_admitted(mut r, launcher.no_grants())
    assembled_new(mut r)
    let a = r.a
    let mut was: List[runner.Exported] = list.new()
    list.push(mut was, entry_of(1u8, 1u8))
    list.push(mut was, entry_of(2u8, 1u8))
    list.push(mut was, entry_of(4u8, 1u8))
    let dc: std.codec.Codec[runner.Describe] = std.codec.of()
    let mut described: Bytes = list.new()
    let _ = std.codec.encode(dc, describing(image(), take was), mut described)
    helper_answers(mut r, helper_child(old, DescribeMode(a)), take described)
    let mut now: List[runner.Exported] = list.new()
    list.push(mut now, entry_of(3u8, 1u8))
    list.push(mut now, entry_of(2u8, 2u8))
    list.push(mut now, entry_of(1u8, 1u8))
    let mut answers: List[runner.Entry] = list.new()
    for _ in 0u64 .. 3u64 {
        list.push(mut answers, Gone)
    }
    let pc: std.codec.Codec[runner.Preview] = std.codec.of()
    let mut preview_bytes: Bytes = list.new()
    let _ = std.codec.encode(pc, runner.Preview(describe: describing(image_two(), take now), release: release_two(), answers: take answers), mut preview_bytes)
    helper_answers(mut r, helper_child(old, PreviewMode(a, list.new())), take preview_bytes)
    old_says(mut r, old, PlaceExported(1u64, "export-1"))
    helper_answers(mut r, helper_child(old, PrepareMode(a, "export-1", list.new())), trigger_answer())
    let cut = apply(mut r, Got(Placed(clone(old), PlaceImported(image_two(), runner.ImportedMigration(digest: list.new(), changes: list.new())))))
    pump(mut r, take cut)
    answer(mut r, old, PlaceInstalled(2u64, true))
    expect(committed_once(r), "L54: the proposed source did not install NEW once")
    let mut recovered = restart(take r, 4u64)
    expect(is_installed(status_of(mut recovered, publication)), "L54: restart lost the installed result")
    let _ = begin_with(mut recovered, publication, submitted)
    expect(admits(recovered) == 0u64 && committed_once(recovered), "L54: retry after install started another deploy")
    let shown: operator.Preview = match store.get(result.unwrap(store.reader(recovered.h.db, 0u64)), store.snapshot(recovered.h.db), recovered.h.t.deploys, "g") {
        Ok(Some(row)) => clone(row.preview),
        _ => operator.no_preview(),
    }
    let mut want: List[(u8, u64)] = list.new()
    list.push(mut want, (1u8, 3u64))
    list.push(mut want, (2u8, 2u64))
    list.push(mut want, (3u8, 0u64))
    list.push(mut want, (4u8, 1u64))
    let mut entries_ok = list.len(shown.entries) == 4u64
    if entries_ok {
        for i in 0u64 .. 4u64 {
            let (id, change) = want[i]
            let line = shown.entries[i]
            entries_ok = entries_ok && line.identity == bytes_of(32u64, id) && change_tag(line.change) == change
        }
    }
    expect(entries_ok, "L54: the entry diff is not exactly 1 unchanged, 2 changed, 3 added, 4 removed")
    let rows = view shown.triggers.rows
    let triggers_ok = list.len(rows) == 1u64 && rows[0u64].count == 2u64 && rows[0u64].earliest_due == 9u64 && rows[0u64].path == bytes_of(4u64, 7u8) && rows[0u64].fate == Some(Release)
    expect(triggers_ok, "L54: the report does not carry the prepare child's trigger report")
    // A prepare child that exits 0 without its report fails the deploy before OLD imports.
    let mut q = rig(c, rnd, 4u64)
    add(mut q, "g", "t")
    op_wake(mut q, "g")
    let old2 = last(q, "g")
    to_export(mut q, old2, preview_answer(image_two(), release_two()))
    old_says(mut q, old2, PlaceExported(1u64, "export-1"))
    let qa = q.a
    finish(mut q, helper_child(old2, PrepareMode(qa, "export-1", list.new())), Code(0i32), None)
    expect(asked_of(q, 3u64) == 1u64 && still_preparing(q), "L54: a prepare without its trigger report did not abort OLD's export")
    old_says(mut q, old2, PlaceAborted)
    expect(failed_with(q, "prepare ended without its trigger report"), "L54: a prepare without its trigger report went on to the import")
    source_refusals(c, rnd)
    unsettled_deploy(c, rnd)
    Ok(())
}

// The tag of an entry change: 0 added, 1 removed, 2 changed, 3 unchanged.
fn change_tag(c: operator.EntryChange) -> u64 {
    match c {
        EntryAdded => 0u64,
        EntryRemoved => 1u64,
        EntryChanged => 2u64,
        EntryUnchanged => 3u64,
    }
}

fn release_source(grant: String, required_id: u8) -> launcher.Input {
    let mut key = bytes_of(32u64, required_id)
    std.codec.put_u64(0u64, mut key)
    std.codec.put_u64(0u64, mut key)
    let mut required: List[launcher.RequiredEntry] = list.new()
    list.push(mut required, launcher.RequiredEntry(kind: Transact, key: take key))
    let mut grants: List[String] = list.new()
    if grant != "" {
        list.push(mut grants, string.from(grant))
    }
    let tree = launcher.Tree(package: ".", grants: take grants, dirs: list.new(), files: list.new(), required_entries: take required)
    let codec: std.codec.Codec[launcher.Tree] = std.codec.of()
    let mut out: Bytes = list.new()
    result.unwrap(std.codec.encode(codec, tree, mut out))
    Source(take out)
}

fn source_admitted(mut r: Rig, take diff: launcher.Grants) waits {
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Admitted(r.a, image_two(), summary_of(1u64, 1u64, take diff), ""))
    feed(mut r, take events)
}

fn old_serves(r: Rig) -> bool waits {
    match group_row(r.h, "g") {
        Ok(Some(g)) => g.assembly == image() && g.activation == 1u64 && is_dirty(r, "g", 1u64),
        _ => false,
    }
}

fn source_refusals(c: Clock, rnd: Random) waits {
    let mut r = admission_case(c, rnd, None, Untrusted)
    let granted = request_id(52u64)
    let _ = begin_with(mut r, granted, release_source("Clock", 2u8))
    source_admitted(mut r, grants_of("Clock", ""))
    expect(awaits(status_of(mut r, granted), "Clock", "") && asked_of(r, 4u64) == 0u64 && old_serves(r), "L54: the grant widening neither held before assembly nor left OLD serving")
    let _ = decide_on(mut r, granted, grants_of("Clock", ""), false)
    expect(phase_failed(status_of(mut r, granted), DeniedClass, "the operator refused the decision") && old_serves(r), "L54: refused grant diff did not end against OLD")
    let ill_typed = request_id(53u64)
    let _ = begin_with(mut r, ill_typed, release_source("", 2u8))
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, AdmissionFailed(r.a, Uncompiled("main.hirsel:1:37-41: LANG-11 found `u64`")))
    feed(mut r, take events)
    expect(phase_failed(status_of(mut r, ill_typed), UncompiledClass, "main.hirsel:1:37-41: LANG-11 found `u64`") && old_serves(r), "L54: bad proposed source lost the checker refusal or replaced OLD")
    let missing = request_id(54u64)
    let _ = begin_with(mut r, missing, release_source("", 2u8))
    source_admitted(mut r, launcher.no_grants())
    assembled_new(mut r)
    let incarnation = option.unwrap(result.unwrap(group_row(r.h, "g"))).incarnation
    let old = child_of("g", incarnation, 1u64)
    let a = r.a
    helper_answers(mut r, helper_child(old, DescribeMode(a)), describe_answer())
    helper_answers(mut r, helper_child(old, PreviewMode(a, list.new())), preview_answer(image_two(), release_two()))
    expect(phase_failed(status_of(mut r, missing), UncompiledClass, "candidate removes or changes a required release entry") && old_serves(r) && asked_of(r, 1u64) == 0u64, "L54: a missing release entry reached export")
}

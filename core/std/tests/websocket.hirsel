    first(unhex("82 80 00 00 00 00"), Client, 256)
}

// tungstenite parse_overflow / size_limit_hit, plus canonical length checks.
// Mutants: ignore_length_high_bit, allow_nonminimal_length, skip_size_limit.
// expect: run frame_lengths() = true
fn frame_lengths() -> bool {
    first(unhex("82 7f ff ff ff ff ff ff ff ff"), Client, 262144) == 1002 && first(unhex("82 7e 00 01"), Client, 262144) == 1002 && first(unhex("82 7f 00 00 00 00 00 00 00 7e"), Client, 262144) == 1002 && first(unhex("82 07 01 02 03 04 05 06 07"), Client, 4) == 1009
}

// F17 / RFC 6455 section 7.4: a code is 1000..1014 except 1004..1006,
// or an application/private code 3000..4999. Empty is allowed.
// Mutants: close_one_byte, accept_reserved_close_code, skip_reason_utf8.
// expect: run close_validation() = true
fn close_validation() -> bool {
    let mut d = websocket.decoder(Client, 256)
    let mut at: u64 = 0
    let b = unhex("88 05 03 e8 62 79 65")
    let closed = control(websocket.next(mut d, b, mut at), 8, unhex("03 e8 62 79 65"))
    closed && event(websocket.next(mut d, b, mut at)) == 65535 && first(unhex("88 00"), Client, 256) == 8 && first(unhex("88 01 00"), Client, 256) == 1002 && first(unhex("88 02 03 ed"), Client, 256) == 1002 && first(unhex("88 02 03 e7"), Client, 256) == 1002 && first(unhex("88 03 03 e8 ff"), Client, 256) == 1007 && first(unhex("88 04 03 e8 e2 82"), Client, 256) == 1007 && first(unhex("88 02 0b b8"), Client, 256) == 8
}

// Full legal payload and fragmented assembly at the configured limit. No
// second assembly buffer; max+1 fails from its header. Mutant: skip_assembly_cap.
// expect: run assembly_at_limit() = true
fn assembly_at_limit() -> bool {
    let mut b = unhex("02 7e 00 80")
    list.fill(mut b, 128, b'a')
    list.append(mut b, unhex("80 7e 00 80"))
    list.fill(mut b, 128, b'b')
    let mut d = websocket.decoder(Client, 256)
    let mut at: u64 = 0
    let full = match websocket.next(mut d, b, mut at) {
        Message(v) => list.len(v) == 256 && v[0] == b'a' && v[127] == b'a' && v[128] == b'b' && v[255] == b'b',
        _ => false
    }
    let mut over = websocket.decoder(Client, 128)
    at = 0
    full && event(websocket.next(mut over, b, mut at)) == 1009
}

// Every split point in the masked frame gives exactly one final message.
// Mutants: mask_offset_from_read_chunk, forget_header_prefix.
// expect: run all_splits() = true
fn all_splits() -> bool {
    let b = unhex("82 85 37 fa 21 3d 7f 9f 4d 51 58")
    for k in 0u64 .. list.len(b) {
        let mut d = websocket.decoder(Server, 256)
        let mut at: u64 = 0
        if event(websocket.next(mut d, list.slice(b, 0, k), mut at)) != 0 {
            return false
        }
        at = 0
        if !payload(websocket.next(mut d, list.slice(b, k, list.len(b)), mut at), b"Hello") {
            return false
        }
    }
    true
}

// Hand-derived encoding and tungstenite write_frames Ping/Pong vectors.
// Mutants: encoder_wrong_mask, pong_wrong_opcode, close_allows_data.
// expect: run encode_vectors() = true
fn encode_vectors() -> bool {
    let mut client = websocket.encoder(Client, 256)
    let mut out: Bytes = list.new()
    let mask: Inline[u8, 4] =[0x37, 0xfa, 0x21, 0x3d]
    let masked = websocket.encode(mut client, true, 2, b"Hello", mask, mut out) == Ok(()) && out == unhex("82 85 37 fa 21 3d 7f 9f 4d 51 58")
    let mut server = websocket.encoder(Server, 256)
    list.clear(mut out)
    let no_mask: Inline[u8, 4] =[0; 4]
    let ping = websocket.encode(mut server, true, 9, unhex("04 05"), no_mask, mut out) == Ok(())
    let pong = websocket.encode(mut server, true, 10, unhex("01"), no_mask, mut out) == Ok(()) && out == unhex("89 02 04 05 8a 01 01")
    list.clear(mut out)
    let closed = websocket.encode(mut server, true, 8, unhex("03 e8"), no_mask, mut out) == Ok(()) && out == unhex("88 02 03 e8")
    masked && ping && pong && closed && websocket.encode(mut server, true, 2, b"x", no_mask, mut out) == Error(1002)
}

// The sender has the same fragmentation, text and size contract as the reader.
// Mutants: encoder_skip_total, encoder_utf8_per_frame, encoder_skip_close_check.
// expect: run encode_validation() = true
fn encode_validation() -> bool {
    let mut e = websocket.encoder(Server, 4)
    let mut out: Bytes = list.new()
    let mask: Inline[u8, 4] =[0; 4]
    let start = websocket.encode(mut e, false, 1, unhex("e2"), mask, mut out) == Ok(())
    let ping = websocket.encode(mut e, true, 9, b"p", mask, mut out) == Ok(())
    let finished = websocket.encode(mut e, true, 0, unhex("82 ac"), mask, mut out) == Ok(())
    let invalid = websocket.encode(mut e, true, 8, unhex("00"), mask, mut out) == Error(1002)
    let before = list.len(out)
    let long = websocket.encode(mut e, true, 2, b"fives", mask, mut out) == Error(1009) && list.len(out) == before
    start && ping && finished && invalid && long
}

// Default cap exercised under g(max_frame), with recv-sized slices. The
// input belongs to the caller, scratch is funded before reading. Mutant:
// reserve_declared (caught for a tiny arrival in length_before_reserve).
fn receive_default(raw: Bytes) -> bool {
    result.unwrap(bound bytes 401408 {
        let scratch: Bytes = list.with_capacity(8192)
        let mut d = websocket.decoder(Client, 262144)
        let mut offset: u64 = 0
        let mut done = false
        while offset < list.len(raw) {
            let end = if list.len(raw) - offset > 8192 {
                offset + 8192
            } else {
                list.len(raw)
            }
            let mut at: u64 = 0
            match websocket.next(mut d, list.slice(raw, offset, end), mut at) {
                Message(v) => {
                    if list.len(v) != 262144 || v[0] != b'a' || v[262143] != b'a' {
                        return false
                    };
                    done = true
                },
                Need => {},
                _ => return false
            }
            if at != end - offset {
                return false
            }
            offset = end
        }
        done && list.capacity(scratch) == 8192
    })
}

// expect: run full_default_limit() = true
fn full_default_limit() -> bool {
    let mut one = unhex("82 7f 00 00 00 00 00 04 00 00")
    list.fill(mut one, 262144, b'a')
    let mut fragments = unhex("02 7f 00 00 00 00 00 02 00 00")
    list.fill(mut fragments, 131072, b'a')
    list.append(mut fragments, unhex("80 7f 00 00 00 00 00 02 00 00"))
    list.fill(mut fragments, 131072, b'a')
    receive_default(one) && receive_default(fragments)
}

// Checking UTF-8 on each completed frame rather than across fragments loses
// both invalid continuations and incomplete final scalars.
// Mutant: utf8_checked_per_frame_only.
// expect: run utf8_cross_fragment_invalid() = true
fn utf8_cross_fragment_invalid() -> bool {
    first(unhex("01 01 e2 80 02 28 a1"), Client, 256) == 1007 && first(unhex("01 01 e2 80 00"), Client, 256) == 1007
}

// The assembled bytes survive a Ping even when the caller discards the
// control event. This independently catches assembly loss.
// Mutant: ping_breaks_assembly.
// expect: run ping_preserves_assembly() = true
fn ping_preserves_assembly() -> bool {
    let mut d = websocket.decoder(Client, 256)
    let mut at: u64 = 0
    let first_part = unhex("02 01 61 89 01 70")
    let ignored = websocket.next(mut d, first_part, mut at)
    at = 0
    payload(websocket.next(mut d, unhex("80 02 62 63"), mut at), b"abc")
}

// The read-ahead offset is handed directly to the decoder; no copying or
// discarded tail between the handshake and the first frame. Mutant: drop_tail.
// expect: run upgrade_frame_handoff() = true
fn upgrade_frame_handoff() -> bool {
    let mut input = result.unwrap(websocket.request(b"example.com", b"the sample nonce", false))
    list.append(mut input, unhex("82 83 00 00 00 00 61 62 63"))
    let mut at = match websocket.server(input) {
        Upgraded(end, _) => end,
        _ => return false
    }
    let mut d = websocket.decoder(Server, 262144)
    payload(websocket.next(mut d, input, mut at), b"abc") && at == list.len(input)
}

// Thirteen payload bytes cross an eight-byte word and a five-byte tail.
// The mask bytes below are hand-derived from RFC 6455's 37fa213d mask.
// Every read split also checks the mask phase when the next word is unaligned.
// Mutant: tail_unmasked.
// expect: run mask_word_tail() = true
fn mask_word_tail() -> bool {
    let plain = b"Hello, world!"
    let wire = unhex("82 8d 37 fa 21 3d 7f 9f 4d 51 58 d6 01 4a 58 88 4d 59 16")
    let mask: Inline[u8, 4] =[0x37, 0xfa, 0x21, 0x3d]
    let mut enc = websocket.encoder(Client, 256)
    let mut out: Bytes = list.new()
    if websocket.encode(mut enc, true, 2, plain, mask, mut out) != Ok(()) || out != wire {
        return false
    }
    for cut in 0u64 .. list.len(wire) {
        let mut dec = websocket.decoder(Server, 256)
        let mut at: u64 = 0
        if event(websocket.next(mut dec, list.slice(wire, 0, cut), mut at)) != 0 {
            return false
        }
        at = 0
        if !payload(websocket.next(mut dec, list.slice(wire, cut, list.len(wire)), mut at), plain) {
            return false
        }
    }
    true
}

// WIRE 2.2: one absolute close deadline for both initiators. Repeated events
// do not restart it. Same oracle under the model clock and real native clock.
// Mutant: close_waits_forever.
// expect: run close_deadline(clock) = true
fn close_deadline(c: Clock) -> bool waits {
    let mut config = wsock.defaults()
    config.close_ms = 2
    let now = host.mono_ns(c)
    let mut local = wsock.timers(config, now)
    wsock.welcomed(mut local)
    wsock.closing(mut local, now, false)
    wsock.closing(mut local, now + 1000000, false)
    let unchanged = match wsock.until(local, c, Never) {
        At(_, end) => end == now + 2000000,
        Never => false
    }
    let mut peer = wsock.timers(config, now)
    wsock.closing(mut peer, now, true)
    wsock.closing(mut peer, now + 1000000, true)
    let before = wsock.due(mut local, now + 1999999) == Wait && wsock.due(mut peer, now + 1999999) == Wait
    host.sleep_until(c, now + 2000000)
    unchanged && before && wsock.due(mut local, host.mono_ns(c)) == Expired && wsock.due(mut peer, host.mono_ns(c)) == Expired
}

// WIRE 2.1: a timed-out upgrade's lease returns to the bounded allowance.
// Mutant: leak_pending_on_timeout.
// expect: run pending_released(clock) = true
fn pending_released(c: Clock) -> bool waits {
    let mut config = wsock.defaults()
    config.pending_max = 1
    let pool = result.unwrap(wsock.pending(config))
    let slot = match result.unwrap(wsock.acquire(pool)) {
        Some(take lease) => take lease,
        None => return false
    }
    let full = match result.unwrap(wsock.acquire(pool)) {
        None => true,
        Some(_) => false
    }
    timed_pending(take slot, c)
    let returned = match result.unwrap(wsock.acquire(pool)) {
        Some(_) => true,
        None => false
    }
    let returned_again = match result.unwrap(wsock.acquire(pool)) {
        Some(_) => true,
        None => false
    }
    full && returned && returned_again
}

fn timed_pending(take slot: wsock.Pending, c: Clock) waits {
    host.sleep_until(c, host.mono_ns(c) + 1000000)
}

// Composite deadlines include Hello, idle Ping, idle Close and an outer wait.
// Pong reception renews idle through a fresh activity timestamp.
// expect: run connection_timers(clock) = true
fn connection_timers(c: Clock) -> bool {
    let config = wsock.defaults()
    let mut t = wsock.timers(config, 0)
    let hello = match wsock.until(t, c, Never) {
        At(_, end) => end == 10000000000,
        _ => false
    }
    wsock.welcomed(mut t)
    let outer = match wsock.until(t, c, At(c, 7)) {
        At(_, end) => end == 7,
        _ => false
    }
    let ping_due = wsock.due(mut t, 30000000000) == SendPing
    let next = match wsock.until(t, c, Never) {
        At(_, end) => end == 60000000000,
        _ => false
    }
    let second = wsock.due(mut t, 60000000000) == SendClose
    let closing = match wsock.until(t, c, Never) {
        At(_, end) => end == 65000000000,
        _ => false
    }
    hello && outer && ping_due && next && second && closing && wsock.due(mut t, 65000000000) == Expired
}

// WIRE 2.2. A committed prefix may never be overwritten by a control frame.
// Hand-derived RFC 6455 bytes, also exercised against a full kernel buffer.
// Mutant: drop_pong_when_busy.
// expect: run blocked_pong_drains() = true
fn blocked_pong_drains() -> bool {
    let config = wsock.defaults()
    let mut encoder = result.unwrap(wsock.outbound(Server, config, None))
    let frame = result.unwrap(wsock.encode(mut encoder, true, 2, b"abc"))
    let mut pending = wsock.write_buffer()
    result.unwrap(wsock.offer(mut pending, take frame))
    wsock.wrote(mut pending, 2)
    let mut ping_payload = websocket.Control(data:[0; 125], len: 1)
    ping_payload.data[0] = b'p'
    wsock.owe_pong(mut pending, ping_payload)
    let blocked = !result.unwrap(wsock.prepare(mut pending, mut encoder)) && wsock.remaining(pending) == b"abc"
    wsock.wrote(mut pending, 3)
    let other = result.unwrap(wsock.encode(mut encoder, true, 2, b"later"))
    let priority = match wsock.offer(mut pending, take other) {
        Error(_) => true,
        Ok(_) => false
    }
    let drained = !result.unwrap(wsock.prepare(mut pending, mut encoder)) && wsock.remaining(pending) == b"\x8a\x01p"
    wsock.wrote(mut pending, 3)
    blocked && priority && drained && result.unwrap(wsock.prepare(mut pending, mut encoder)) && wsock.idle(pending)
}

// Match std clock's checked deadline arithmetic, never shorten a requested
// duration by silently saturating its unrepresentable absolute timestamp.
// expect: run connection_time_overflow() = fail Overflow
fn connection_time_overflow() -> bool {
    let _ = wsock.timers(wsock.defaults(), 0xffffffffffffffff)
    true
}

// Non-final data frames are activity even though no message is delivered yet.
// Their observable count lets the socket driver renew idle without treating
// a trickled partial frame as a completed one.
// expect: run fragment_frame_progress() = true
fn fragment_frame_progress() -> bool {
    let mut d = websocket.decoder(Client, 256)
    let mut at: u64 = 0
    let a = unhex("01 01 61")
    let start = websocket.frame_count(d) == 0 && event(websocket.next(mut d, a, mut at)) == 0 && websocket.frame_count(d) == 1
    at = 0
    let b = unhex("00 01 62")
    let middle = event(websocket.next(mut d, b, mut at)) == 0 && websocket.frame_count(d) == 2
    at = 0
    let last = websocket.next(mut d, unhex("80 01 63"), mut at)
    start && middle && websocket.frame_count(d) == 3 && match last {
        Text(text) => text == b"abc",
        _ => false
    }
}

// RFC 6455 sections 7.4.1 and 8.1. E2 82 still owes one continuation when
// the final frame ends, irrespective of where the transport splits the bytes.
// expect: run utf8_missing_final_continuation_splits() = true
fn utf8_missing_final_continuation_splits() -> bool {
    let b = unhex("01 01 e2 80 01 82")
    let end = list.len(b)
    for split in 0u64 .. end {
        let mut d = websocket.decoder(Client, 256)
        let mut at: u64 = 0
        let Need = websocket.next(mut d, list.slice(b, 0, split), mut at) else {
            return false
        }
        if at != split {
            return false
        }
        at = 0
        let tail = list.slice(b, split, end)
        let Reject(code) = websocket.next(mut d, tail, mut at) else {
            return false
        }
        if code != 1007 || at != end - split {
            return false
        }
        let Ended = websocket.next(mut d, tail, mut at) else {
            return false
        }
        if at != end - split {
            return false
        }
    }
    true
}

// Autobahn Testsuite, autobahntestsuite/autobahntestsuite/case/case6_{1_2,1_3,2_*,3_*}.py.
// 5092f41aaf9243052047a4f0cd53dbe30e1ea3ec, Apache-2.0, copyright typedef int GmbH, see vectors/autobahn-LICENSE.
// The peer receives unmasked server frames. Timing and the close handshake are separate.
// expect: run autobahn_text_messages() = true
fn autobahn_text_messages() -> bool {
    let rows: Inline[(String, Option[String]), 8] =[
        // 6.1.2. Three empty fragments still produce one text message.
        ("01 00 00 00 80 00", Some("")),
        // 6.1.3. Only the middle fragment contains data.
        ("01 00 00 14 6d 69 64 64 6c 65 20 66 72 61 6d 65 20 70 61 79 6c 6f 61 64 80 00", Some("6d 69 64 64 6c 65 20 66 72 61 6d 65 20 70 61 79 6c 6f 61 64")),
        // 6.2.1. One complete frame of multibyte UTF-8.
        ("81 1d 48 65 6c 6c 6f 2d c2 b5 40 c3 9f c3 b6 c3 a4 c3 bc c3 a0 c3 a1 2d 55 54 46 2d 38 21 21", Some("48 65 6c 6c 6f 2d c2 b5 40 c3 9f c3 b6 c3 a4 c3 bc c3 a0 c3 a1 2d 55 54 46 2d 38 21 21")),
        // 6.2.2. Split at a code-point boundary.
        ("01 0f 48 65 6c 6c 6f 2d c2 b5 40 c3 9f c3 b6 c3 a4 80 0e c3 bc c3 a0 c3 a1 2d 55 54 46 2d 38 21 21", Some("48 65 6c 6c 6f 2d c2 b5 40 c3 9f c3 b6 c3 a4 c3 bc c3 a0 c3 a1 2d 55 54 46 2d 38 21 21")),
        // 6.2.3. Split inside code points, one byte per frame.
        ("01 01 48 00 01 65 00 01 6c 00 01 6c 00 01 6f 00 01 2d 00 01 c2 00 01 b5 00 01 40 00 01 c3 00 01 9f 00 01 c3 00 01 b6 00 01 c3 00 01 a4 00 01 c3 00 01 bc 00 01 c3 00 01 a0 00 01 c3 00 01 a1 00 01 2d 00 01 55 00 01 54 00 01 46 00 01 2d 00 01 38 00 01 21 80 01 21", Some("48 65 6c 6c 6f 2d c2 b5 40 c3 9f c3 b6 c3 a4 c3 bc c3 a0 c3 a1 2d 55 54 46 2d 38 21 21")),
        // 6.2.4. Accept the Greek text with each UTF-8 byte in its own frame.
        ("01 01 ce 00 01 ba 00 01 e1 00 01 bd 00 01 b9 00 01 cf 00 01 83 00 01 ce 00 01 bc 00 01 ce 80 01 b5", Some("ce ba e1 bd b9 cf 83 ce bc ce b5")),
        // 6.3.1. Reject a surrogate between otherwise valid scalars in one frame.
        ("81 14 ce ba e1 bd b9 cf 83 ce bc ce b5 ed a0 80 65 64 69 74 65 64", None),
        // 6.3.2. Reject the same message with every byte in its own frame.
        ("01 01 ce 00 01 ba 00 01 e1 00 01 bd 00 01 b9 00 01 cf 00 01 83 00 01 ce 00 01 bc 00 01 ce 00 01 b5 00 01 ed 00 01 a0 00 01 80 00 01 65 00 01 64 00 01 69 00 01 74 00 01 65 80 01 64", None),
    ]
    for (raw, expected) in rows {
        let mut decoder = websocket.decoder(Client, 256)
        let mut at: u64 = 0
        let received = websocket.next(mut decoder, unhex(raw), mut at)
        match expected {
            Some(message) => if !payload(received, unhex(message)) || event(received) != 1 {
                return false
            },
            None => if event(received) != 1007 {
                return false
            },
        }
    }
    true
}

// Autobahn Testsuite, autobahntestsuite/autobahntestsuite/case/case6_4_[1-4].py.
// 5092f41aaf9243052047a4f0cd53dbe30e1ea3ec, Apache-2.0, copyright typedef int GmbH, see vectors/autobahn-LICENSE.
// The strict oracle rejects when the invalid byte arrives, before the later payload.
// expect: run autobahn_fails_fast_on_utf8() = true
fn autobahn_fails_fast_on_utf8() -> bool {
    for (prefix, invalid) in[
        // 6.4.1. Next continuation starts an out-of-range scalar.
        ("01 0b ce ba e1 bd b9 cf 83 ce bc ce b5", "00 04 f4 90 80 80"),
        // 6.4.2. The invalid continuation byte is in its own frame.
        ("01 0c ce ba e1 bd b9 cf 83 ce bc ce b5 f4", "00 01 90"),
        // 6.4.3. The same message in two transport reads within one frame.
        ("81 15 ce ba e1 bd b9 cf 83 ce bc ce b5", "f4 90 80 80"),
        // 6.4.4. The invalid continuation byte arrives in its own read.
        ("81 15 ce ba e1 bd b9 cf 83 ce bc ce b5 f4", "90"),
    ] {
        let mut decoder = websocket.decoder(Client, 256)
        let mut at: u64 = 0
        let prefix_bytes = unhex(prefix)
        let Need = websocket.next(mut decoder, prefix_bytes, mut at) else {
            return false
        }
        if at != list.len(prefix_bytes) {
            return false
        }
        at = 0
        let Reject(1007) = websocket.next(mut decoder, unhex(invalid), mut at) else {
            return false
        }
    }
    true
}

// Autobahn Testsuite, autobahntestsuite/autobahntestsuite/case/case7_{5_1,7_X,9_X}.py.
// 5092f41aaf9243052047a4f0cd53dbe30e1ea3ec, Apache-2.0, copyright typedef int GmbH, see vectors/autobahn-LICENSE.
// RFC 6455 section 8.1 and Hirsel's F17 choose 1007 for an invalid reason.
// expect: run autobahn_close_frames() = true
fn autobahn_close_frames() -> bool {
    for (raw, expected) in[
        // 7.5.1. A valid close code followed by an invalid UTF-8 reason.
        ("88 16 03 e8 ce ba e1 bd b9 cf 83 ce bc ce b5 ed a0 80 65 64 69 74 65 64", 1007u16),
        // 7.7.1 through 7.7.13. Code 3000 already has an identical vector.
        ("88 02 03 e8", 8u16),
        ("88 02 03 e9", 8u16),
        ("88 02 03 ea", 8u16),
        ("88 02 03 eb", 8u16),
        ("88 02 03 ef", 8u16),
        ("88 02 03 f0", 8u16),
        ("88 02 03 f1", 8u16),
        ("88 02 03 f2", 8u16),
        ("88 02 03 f3", 8u16),
        ("88 02 0f 9f", 8u16),
        ("88 02 0f a0", 8u16),
        ("88 02 13 87", 8u16),
        // 7.9.1 through 7.9.9. Codes 999 and 1005 already have identical vectors.
        ("88 02 00 00", 1002u16),
        ("88 02 03 ec", 1002u16),
        ("88 02 03 ee", 1002u16),
        ("88 02 03 f8", 1002u16),
        ("88 02 04 4c", 1002u16),
        ("88 02 07 d0", 1002u16),
        ("88 02 0b b7", 1002u16),
    ] {
        if first(unhex(raw), Client, 256) != expected {
            return false
        }
    }
    true
}

// Autobahn Testsuite, autobahntestsuite/autobahntestsuite/case/case{3_*,4_*}.py.
// 5092f41aaf9243052047a4f0cd53dbe30e1ea3ec, Apache-2.0, copyright typedef int GmbH, see vectors/autobahn-LICENSE.
// The decoder refuses each offending frame when no extension was negotiated.
// expect: run autobahn_reserved_frame_headers() = true
fn autobahn_reserved_frame_headers() -> bool {
    for raw in[
        // Cases 3.1 through 3.7. All seven nonzero RSV combinations.
        "91 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
        "a1 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
        "b1 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
        "c1 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
        "d2 08 00 ff fe fd fc fb 00 ff",
        "e2 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
        "f8 00",
        // Cases 4.1.2 through 4.2.5. Case 4.1.1 is already in rejects_reserved_opcode.
        "84 17 72 65 73 65 72 76 65 64 20 6f 70 63 6f 64 65 20 70 61 79 6c 6f 61 64",
        "85 00",
        "86 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
        "87 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
        "8b 00",
        "8c 17 72 65 73 65 72 76 65 64 20 6f 70 63 6f 64 65 20 70 61 79 6c 6f 61 64",
        "8d 00",
        "8e 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
        "8f 0d 48 65 6c 6c 6f 2c 20 77 6f 72 6c 64 21",
    ] {
        if first(unhex(raw), Client, 256) != 1002 {
            return false
        }
    }
    true
}

fn autobahn_received_length_frames(text: bool, opcode: u8, fill: u8) -> bool {
    for (header, n) in[
        // Case 1.x.1 and 1.x.2. Inline payload length.
        ("00", 0u64),
        ("7d", 125u64),
        // Case 1.x.3 through 1.x.6. Two-byte extended length.
        ("7e 00 7e", 126u64),
        ("7e 00 7f", 127u64),
        ("7e 00 80", 128u64),
        ("7e ff ff", 65535u64),
        // Case 1.x.7. Eight-byte extended length.
        ("7f 00 00 00 00 00 01 00 00", 65536u64),
    ] {
        let mut frame: Bytes = list.new()
        list.push(mut frame, opcode)
        list.append(mut frame, unhex(header))
        let mut want: Bytes = list.new()
        list.fill(mut want, n, fill)
        list.append(mut frame, want)
        let mut decoder = websocket.decoder(Client, 65536)
        let mut at: u64 = 0
        let got = websocket.next(mut decoder, frame, mut at)
        let matches = match got {
            Text(data) => text && data == want,
            Message(data) => !text && data == want,
            _ => false,
        }
        if !matches || at != list.len(frame) {
            return false
        }
    }
    true
}

// Autobahn Testsuite, autobahntestsuite/autobahntestsuite/case/case1_1_[1-7].py.
// 5092f41aaf9243052047a4f0cd53dbe30e1ea3ec, Apache-2.0, copyright typedef int GmbH, see vectors/autobahn-LICENSE.
// expect: run autobahn_text_frame_lengths() = true
fn autobahn_text_frame_lengths() -> bool {
    autobahn_received_length_frames(true, 0x81, b'*')
}

// Autobahn Testsuite, autobahntestsuite/autobahntestsuite/case/case1_2_[1-7].py.
// 5092f41aaf9243052047a4f0cd53dbe30e1ea3ec, Apache-2.0, copyright typedef int GmbH, see vectors/autobahn-LICENSE.
// expect: run autobahn_binary_frame_lengths() = true
fn autobahn_binary_frame_lengths() -> bool {
    autobahn_received_length_frames(false, 0x82, 0xfe)
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

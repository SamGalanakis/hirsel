// ---- TURN slice U8: a browser that reaches the SFU only through its sibling relay ----
const RELAY_LISTEN: Addr = Addr(ip: V4(0xc0000264), port: 3478)

const RELAY_POOL_1: Addr = Addr(ip: V4(0xc0000264), port: 50000)

const RELAY_POOL_2: Addr = Addr(ip: V4(0xc0000264), port: 50002)

// The SFU's media address (server_addr) and the same IP on a port that is not media.
const SFU_MEDIA: Addr = Addr(ip: V4(0xc0000201), port: 5000)

const SFU_OTHER: Addr = Addr(ip: V4(0xc0000201), port: 5001)

// A public address the relay-only policy must still refuse.
const OUTSIDE: Addr = Addr(ip: V4(0x5db8d814), port: 9000)

const MINT_UNIX: u64 = 1700000000

fn plan() -> signal.RelayPlan {
    let mut ranges: List[turn.Allow] = list.new()
    list.push(mut ranges, turn.Allow(prefix: turn.Prefix(ip: V4(0xc0000201), bits: 32), ports_lo: 5000, ports_hi: 5000))
    let mut host: List[Ip] = list.new()
    // Co-located: the SFU's own address is one of the relay host's addresses.
    list.push(mut host, V4(0xc0000201))
    signal.RelayPlan(realm: b"sfu.example", lifetime_s: 3600, media: take ranges, host: take host)
}

/// The SFU's local end, with the ICE credentials minted beside the TURN ones.
fn sfu_local(creds: signal.SessionCredentials) -> sdp.LocalEnd {
    let mut local = rig_local()
    local.ice_ufrag = copy_of(creds.ice_ufrag)
    local.ice_pwd = copy_of(creds.ice_pwd)
    local
}

fn master(uses: String) -> Secret {
    let mut b: Bytes = list.with_capacity(32)
    list.fill(mut b, 32, 0x3c)
    result.unwrap(secret.seal(take b, uses))
}

fn tnow(ms: u64) -> turn.Now {
    turn.Now(mono_ns: ms * MS, unix_s: MINT_UNIX + ms / 1000)
}

/// One browser's TURN client and the relay place, over UDP or one stream connection,
/// with each direction's stream bytes run through a Framer.
type Leg {
    cl: turn.Client,
    o: turn.Origin,
    stream: bool,
    up: Bytes,
    down: Bytes,
    fu: turn.Framer,
    fd: turn.Framer
}

fn relay_leg(mut rl: turn.Relay, now: turn.Now, stream: bool, source: Addr, conn: u64, creds: signal.SessionCredentials) -> Leg {
    let o = if stream {
        result.unwrap(turn.connected(mut rl, conn, RELAY_LISTEN, source, now))
        turn.Origin(ingress: Stream(conn), client: source)
    } else {
        turn.Origin(ingress: Udp(RELAY_LISTEN), client: source)
    }
    let cl = relay_client(stream, creds)
    Leg(cl: take cl, o: o, stream: stream, up: list.new(), down: list.new(), fu: turn.framer(), fd: turn.framer())
}

fn relay_client(stream: bool, creds: signal.SessionCredentials) -> turn.Client {
    let mut c = turn.client_defaults()
    if stream {
        c.transport = Stream
    }
    let password = result.unwrap(secret.seal(copy_of(creds.turn_password), "digest"))
    result.unwrap(turn.client(c, RELAY_LISTEN, copy_of(creds.turn_username), take password))
}

/// The messages in bytes, whole: framed when the leg is a stream, else bytes itself.
fn messages(stream: bool, mut f: turn.Framer, mut buffer: Bytes, raw: Bytes) -> List[Bytes] {
    let mut out: List[Bytes] = list.new()
    if !stream {
        list.push(mut out, copy_of(raw))
        return out
    }
    list.append(mut buffer, raw)
    while true {
        match result.unwrap(turn.frame_next(mut f, buffer)) {
            Message(r) => list.push(mut out, copy_of(list.slice(buffer, r.lo, r.hi))),
            Pending => break,
        }
    }
    turn.frame_consumed(mut f, mut buffer)
    out
}

/// Relay to browser: the payloads of the Data the client takes from bytes.
fn to_browser(mut l: Leg, now: turn.Now, rnd: Random, raw: Bytes) -> List[(Addr, Bytes)] {
    let mut taken: List[(Addr, Bytes)] = list.new()
    for m in messages(l.stream, mut l.fd, mut l.down, raw) {
        let mut packet = copy_of(m)
        // A client that closes on a response answers Closed, and client_state keeps it.
        let got = match turn.receive(mut l.cl, now, rnd, mut packet) {
            Ok(x) => x,
            Error(Closed(_)) => return taken,
            Error(_) => fail("the browser's TURN client failed on the relay's message"),
        }
        if let Data(from, d) = got {
            list.push(mut taken, (from, copy_of(list.slice(packet, d.lo, d.hi))))
        }
    }
    taken
}

/// Browser to relay: answers the datagrams the relay sends to peers; replies go back down.
fn to_relay(mut rl: turn.Relay, mut l: Leg, now: turn.Now, rnd: Random, raw: Bytes) -> List[(Addr, Addr, Bytes)] {
    let mut sent: List[(Addr, Addr, Bytes)] = list.new()
    for m in messages(l.stream, mut l.fu, mut l.up, raw) {
        let mut packet = copy_of(m)
        let mut out: Bytes = list.with_capacity(1500)
        list.fill(mut out, 1500, 0)
        match result.unwrap(turn.from_client(mut rl, now, rnd, l.o, mut packet, mut out)) {
            Reply(_, n) => {
                let _ = to_browser(mut l, now, rnd, list.slice(out, 0, n))
            },
            ToPeer(relayed, to, r) => list.push(mut sent, (relayed, to, copy_of(list.slice(packet, r.lo, r.hi)))),
            _ => (),
        }
    }
    sent
}

/// Run the client's queued requests through the relay until it has nothing to send.
fn pump(mut rl: turn.Relay, mut l: Leg, now: turn.Now, rnd: Random) {
    for _ in 0u64 .. 16 {
        let mut out: Bytes = list.with_capacity(1500)
        list.fill(mut out, 1500, 0)
        let Ok(Send(n)) = turn.poll(mut l.cl, now, rnd, mut out) else {
            return
        }
        let _ = to_relay(mut rl, mut l, now, rnd, list.slice(out, 0, n))
    }
}

fn relayed_of(l: Leg) -> Addr {
    let Allocated(a) = turn.client_state(l.cl) else {
        fail("the browser holds no allocation")
    }
    a.relayed
}

/// bug: the standalone relay binds 16 addresses even when the 17th allocation is funded.
/// oracle: 17 live TURN clients receive distinct addresses from the bound pool.
@test
fn relay_plan_binds_the_seventeenth_allocation(network: Net) -> Result[(), turn.TurnError] waits {
    let sockets_plan = option.unwrap(signal.relay_socket_plan(17, 1500, 2500))
    let (take sockets, take addresses) = signal.bind_relay_pool(network, LOOPBACK.ip, sockets_plan) ?=> |_| Config
    let terms = signal.relay_config(plan())?
    let rnd = provide.random(6017)
    let mut rl = turn.relay(take terms, rnd, master("kdf"), master("mac"), clone(addresses))?
    let mut allocated: List[Addr] = list.with_capacity(17)
    let inc: Inline[u8, 16] =[0u8; 16]
    let now = tnow(1000)
    for i in 1u64 .. 18u64 {
        let subject = signal.admission_subject(inc, i)
        let creds = signal.mint_session(master("mac"), rnd, subject, MINT_UNIX, plan())?
        let suffix: u32 = int.narrow(i)
        let origin = Addr(ip: V4(0xc6336400u32 + suffix), port: 50000)
        let mut leg = relay_leg(mut rl, now, false, origin, 0, creds)
        pump(mut rl, mut leg, now, rnd)
        let relayed = relayed_of(leg)
        let mut found = false
        for address in addresses {
            if address == relayed {
                found = true
            }
        }
        if !found {
            fail("the relay granted an address without a bound socket")
        }
        for address in allocated {
            if address == relayed {
                fail("two clients received the same live relay address")
            }
        }
        list.push(mut allocated, relayed)
    }
    if turn.relay_counts(rl).allocations != 17 {
        fail("the relay did not retain all 17 allocations")
    }
    let _ = take sockets
    Ok(())
}

/// The browser sends payload to peer through its allocation; answers what reached a peer.
fn browser_send(mut rl: turn.Relay, mut l: Leg, now: turn.Now, rnd: Random, peer_at: Addr, payload: Bytes) -> List[(Addr, Addr, Bytes)] {
    let n = list.len(payload)
    let mut slot: Bytes = list.with_capacity(turn.HEADROOM + n + 3)
    list.fill(mut slot, turn.HEADROOM, 0)
    list.append(mut slot, payload)
    list.fill(mut slot, turn.HEADROOM + n + 3, 0)
    let range = result.unwrap(turn.send_to(mut l.cl, peer_at, mut slot, turn.HEADROOM, turn.HEADROOM + n))
    to_relay(mut rl, mut l, now, rnd, list.slice(slot, range.lo, range.hi))
}

/// A datagram from peer_at to the relayed address; answers what the browser took.
fn peer_send(mut rl: turn.Relay, mut l: Leg, now: turn.Now, rnd: Random, relayed: Addr, peer_at: Addr, payload: Bytes) -> List[(Addr, Bytes)] {
    let n = list.len(payload)
    let mut slot: Bytes = list.with_capacity(turn.HEADROOM + n + 3)
    list.fill(mut slot, turn.HEADROOM, 0)
    list.append(mut slot, payload)
    list.fill(mut slot, turn.HEADROOM + n + 3, 0)
    match result.unwrap(turn.from_peer(mut rl, now, relayed, peer_at, mut slot, turn.HEADROOM, turn.HEADROOM + n)) {
        ToClient(_, r) => to_browser(mut l, now, rnd, list.slice(slot, r.lo, r.hi)),
        _ => list.new(),
    }
}

/// The SFU's datagrams in out, each sent from SFU_MEDIA to the relayed address.
fn sfu_out(mut rl: turn.Relay, mut l: Leg, now: turn.Now, rnd: Random, relayed: Addr, out: peer.Outbox) -> List[(Addr, Bytes)] {
    let mut got: List[(Addr, Bytes)] = list.new()
    for tx in out.pkts {
        let UdpTx(to, at, len, ecn: _) = tx
        if to != relayed {
            fail("the SFU answered other than the relayed address")
        }
        for (from, payload) in peer_send(mut rl, mut l, now, rnd, relayed, SFU_MEDIA, list.slice(out.data, at, at + len)) {
            list.push(mut got, (from, copy_of(payload)))
        }
    }
    got
}

/// What reached the SFU: one datagram, from the relayed address, to SFU_MEDIA.
fn at_sfu(sent: List[(Addr, Addr, Bytes)], relayed: Addr, take what: String) -> Bytes {
    if list.len(sent) != 1 {
        fail(take what)
    }
    for (from, to, payload) in sent {
        if from == relayed && to == SFU_MEDIA {
            return copy_of(payload)
        }
    }
    fail(take what)
}

/// bug: a relay-only browser cannot reach the SFU (the ICE credentials minted beside the
/// TURN ones fail, or the policy refuses the SFU's media port), the relay reaches more than
/// the SFU's media address and ports, or a revoke signaling forwards leaves the browser's
/// allocation relaying or lets the subject allocate again.
/// oracle: turn.md TURN-7 (deny 0.0.0.0/0 and ::/0, allow only media), TURN-8 (the relayed
/// address is an ordinary UDP source, selected by ICE and pinned by DTLS) and TURN-9
/// (revoke deletes every allocation of the subject and step 4 refuses it), by hand.
@test
fn relay_only_session() -> Result[(), turn.TurnError] {
    relay_only_over(false, 81)
    relay_only_over(true, 85)
    Ok(())
}

fn relay_only_over(stream: bool, seed: u64) {
    let rnd = provide.random(seed)
    let mut inc: Inline[u8, 16] =[0u8; 16]
    inc[0] = 0xa5
    inc[15] = 0x01
    let subject = signal.admission_subject(inc, 3)
    if !same(subject, b"a5000000000000000000000000000001-3") {
        fail("the subject is not hex(incarnation) - peer")
    }
    // Signaling holds the master with mac, the relay place the same master with kdf.
    let creds = result.unwrap(signal.mint_session(master("mac"), provide.random(seed + 10), subject, MINT_UNIX, plan()))
    let c = result.unwrap(signal.relay_config(plan()))
    let mut pool: List[Addr] = list.new()
    list.push(mut pool, RELAY_POOL_1)
    list.push(mut pool, RELAY_POOL_2)
    let mut rl = result.unwrap(turn.relay(take c, rnd, master("kdf"), master("mac"), take pool))
    let browser = Addr(ip: V4(0xc6336401), port: 50000)
    let mut l = relay_leg(mut rl, tnow(1000), stream, browser, 1, creds)
    let now = tnow(1000)
    pump(mut rl, mut l, now, rnd)
    let relayed = relayed_of(l)
    let _ = result.unwrap(turn.bind(mut l.cl, SFU_MEDIA, now))
    pump(mut rl, mut l, now, rnd)
    // The SFU's session uses the ICE credentials minted with the TURN ones.
    let Party(id: take server_id, certificate: server_certificate) = party(seed)
    let Party(id: take client_id, certificate: client_certificate) = party(seed + 1)
    let mut offer = sdp.description()
    result.unwrap(sdp.parse(session_offer(), mut offer))
    let mut reply = sdp.description()
    let mut n = sdp.negotiated(sfu_local(creds))
    result.unwrap(sdp.answer(sdp.default_policy(), None, offer, sfu_local(creds), mut reply, mut n))
    let d = std.sha256.hash(client_certificate)
    for i in 0u64 .. 32 {
        n.remote_fingerprint[i] = d[i]
    }
    let limits = peer.PeerLimits(sections: 8, down_tracks: 4, rtx_bytes: 1048576, pacer_packets: 64, start_bps: 300000, dtls_transport: peer.DTLS_DEFAULT, repair_profile: peer.DEFAULT_REPAIR)
    let who = peer.Participant(gen: Gen(id: 1, epoch: 1), room: RoomId(7))
    let mut p = result.unwrap(peer.open(sfu_local(creds), take server_id, provide.random(seed + 2), SFU_MEDIA, limits, n, who))
    let mut out = result.unwrap(peer.outbox(65536, 64))
    // ICE: the browser's nomination arrives from the relayed address and selects it.
    let mut pkt: Bytes = list.with_capacity(576)
    list.fill(mut pkt, 576, 0)
    let mut scratch: Bytes = list.with_capacity(576)
    list.fill(mut scratch, 576, 0)
    let mut ice_user = copy_of(creds.ice_ufrag)
    list.append(mut ice_user, b":remote")
    let check = stun_ice.Check(role: stun_ice.IceRole(role: Controlling, tie: 7), priority: 0x6e0001ff, nominate: true)
    let k = result.unwrap(stun_ice.binding_request(stun_ice.Transaction(high: 1, low: 2), ice_user, Some(check), Sha1, true, creds.ice_pwd, mut pkt, mut scratch))
    let mut slot = at_sfu(browser_send(mut rl, mut l, now, rnd, SFU_MEDIA, list.slice(pkt, 0, k)), relayed, "the nomination did not reach the SFU from the relayed address")
    if let Ok(Replied) = peer.receive(mut p, 0, relayed, mut slot, mut out) {} else {
        fail("the relayed nomination was not answered")
    }
    if peer.selected(p) != Some(relayed) {
        fail("the relayed nomination did not select the relayed path")
    }
    let answer = sfu_out(mut rl, mut l, now, rnd, relayed, out)
    peer.clear_outbox(mut out)
    let mut answered = 0u64
    for (from, payload) in answer {
        if from == SFU_MEDIA && list.len(payload) >= 20 && payload[0] == 0x01 && payload[1] == 0x01 {
            answered += 1
        }
    }
    if answered != 1 || list.len(answer) != 1 {
        fail("the Binding success did not reach the browser from the SFU")
    }
    // DTLS both ways through the relay, pinned by fingerprint.
    let rc = provide.random(seed + 3)
    let mut dc = result.unwrap(dtls.client(take client_id, dtls.defaults(), SFU_MEDIA))
    result.unwrap(dtls.expect(mut dc, pin_list(server_certificate)))
    for _ in 0u64 .. 8 {
        while true {
            let mut f: Bytes = list.with_capacity(1500)
            match dtls.poll(mut dc, 0, rc, mut f) {
                Ok(Send(_)) => {
                    for (_, _, payload) in browser_send(mut rl, mut l, now, rnd, SFU_MEDIA, f) {
                        let mut s = copy_of(payload)
                        let _ = result.unwrap(peer.receive(mut p, 0, relayed, mut s, mut out))
                    }
                },
                _ => break,
            }
        }
        let _ = peer.poll(mut p, 0, mut out)
        for (_, flight) in sfu_out(mut rl, mut l, now, rnd, relayed, out) {
            let mut data: Bytes = list.new()
            let _ = dtls.receive(mut dc, 0, rc, flight, mut data)
        }
        peer.clear_outbox(mut out)
    }
    if !peer.connected(p) {
        fail("DTLS did not connect over the relay")
    }
    let profile = option.unwrap(dtls.srtp_profile(dc))
    let keys = result.unwrap(dtls.take_srtp(mut dc))
    let mut cs = result.unwrap(srtp.session(take keys, profile, srtp.Limits(send_streams: 8, receive_streams: 8, ended_streams: 8)))
    let mut m = at_sfu(browser_send(mut rl, mut l, now, rnd, SFU_MEDIA, media(mut cs, MEDIA_SSRC, 1, b"a", 96)), relayed, "media did not reach the SFU")
    let Ok(Media(_)) = peer.receive(mut p, MS, relayed, mut m, mut out) else {
        fail("the relayed media was not taken")
    }
    // TURN-7: only the media address and ports are reachable, even on the SFU's own IP.
    let before = turn.relay_discards(rl).policy
    if list.len(browser_send(mut rl, mut l, now, rnd, SFU_OTHER, b"x")) != 0 {
        fail("the relay sent to the SFU's IP on a port that is not media")
    }
    if list.len(peer_send(mut rl, mut l, now, rnd, relayed, SFU_OTHER, b"y")) != 0 {
        fail("the relay took a datagram from the SFU's IP on a port that is not media")
    }
    if turn.relay_discards(rl).policy != before + 2 {
        fail("the policy did not count both refused datagrams")
    }
    let _ = turn.permit(mut l.cl, OUTSIDE, now)
    pump(mut rl, mut l, now, rnd)
    let mut probe: Bytes = list.with_capacity(turn.HEADROOM + 4)
    list.fill(mut probe, turn.HEADROOM + 4, 0)
    let Error(Unpermitted(_)) = turn.send_to(mut l.cl, OUTSIDE, mut probe, turn.HEADROOM, turn.HEADROOM + 1) else {
        fail("a relay-only policy permitted an address outside the SFU")
    }
    // TURN-9: signaling forwards the revoke to the relay place as a codec value.
    let revoked_at = tnow(2000)
    let rv = signal.relay_revoke(subject, revoked_at.unix_s, plan())
    if rv.until_unix_s < creds.expiry_unix_s {
        fail("the revoke ends before the credential it refuses")
    }
    let co: std.codec.Codec[signal.RelayRevoke] = std.codec.of()
    let mut wire: Bytes = list.new()
    result.unwrap(std.codec.encode(co, rv, mut wire))
    let arrived = result.unwrap(std.codec.decode(co, wire))
    if result.unwrap(signal.apply_revoke(mut rl, arrived, revoked_at)) != 1 || turn.relay_counts(rl).allocations != 0 {
        fail("the revoke did not delete the subject's one allocation")
    }
    if list.len(browser_send(mut rl, mut l, revoked_at, rnd, SFU_MEDIA, b"after")) != 0 || list.len(peer_send(mut rl, mut l, revoked_at, rnd, relayed, SFU_MEDIA, b"after")) != 0 {
        fail("a revoked allocation still relays")
    }
    let mut again = relay_leg(mut rl, revoked_at, stream, Addr(ip: V4(0xc6336401), port: 50004), 2, creds)
    pump(mut rl, mut again, revoked_at, rnd)
    let Closed(Credentials) = turn.client_state(again.cl) else {
        fail("a revoked subject allocated again")
    }
}

/// bug: the idle TURN relay woke every millisecond and polled the allocation pool.
/// oracle: the test clock registers only shutdown, and a served Net sees no pool reads.
@test
fn idle_relay_waits_until_shutdown(tasks: Tasks, out: Stdout) -> Result[(), turn.TurnError] waits {
    let until = 20u64 * MS
    let listen = Addr(ip: RELAY_LISTEN.ip, port: RELAY_LISTEN.port)
    let sockets = option.unwrap(signal.relay_socket_plan(64, 1200, 1))
    let (test_clock, hand) = provide.clock(0, MINT_UNIX * 1000)
    let mut time = take hand
    let (net, port) = provide.net(bytes 4194304)
    let mut served = take port
    let (revoke, revokes): (Sender[signal.RelayRevoke], Receiver[signal.RelayRevoke]) = channel.new(1)
    let (ready, started): (Sender[()], Receiver[()]) = channel.new(1)
    let job = turn_runtime.Start(net, clock: test_clock, random: provide.random(1), tasks, out, listen, master: master("mac kdf"), nonce: master("mac"), plan: plan(), sockets, revokes: take revokes, ready: take ready, until)
    let relay = task.spawn(tasks, bytes turn_runtime.reserve_bytes(sockets), take job, turn_runtime.run)
    let mut binds = 0u64
    let mut pending: List[Call[NetOp]] = list.new()
    while let Some(take request) = provide.next(mut served) {
        match provide.net_op(request) {
            UdpBind(..) => {
                let addr = if binds == 0 {
                    listen
                } else {
                    Addr(ip: listen.ip, port: int.narrow(50000u64 + binds))
                }
                result.unwrap(provide.reply(mut served, take request, provide.net_reply(UdpSockets(first: 1 + binds, count: 1, addr))))
                binds += 1
            },
            Listen(addr: address, backlog: _) => result.unwrap(provide.reply(mut served, take request, provide.net_reply(Listener(100, address)))),
            UdpRecv(socket: 1, ..) => list.push(mut pending, take request),
            Accept(listener: 100) => list.push(mut pending, take request),
            _ => fail("idle relay touched an allocation socket"),
        }
    }
    if clock.idle(mut time) != Some(until) {
        fail("idle relay registered a wake before shutdown")
    }
    let Ok(()) = channel.try_receive(started) else {
        fail("the relay did not become ready")
    }
    if binds != 65 || list.len(pending) != 2 {
        fail("expected both listeners pending and 64 inactive sockets")
    }
    clock.advance_to(mut time, until - 1)
    if clock.idle(mut time) != Some(until) {
        fail("idle relay woke during the idle interval")
    }
    clock.advance_to(mut time, until)
    let _ = take revoke
    result.unwrap(task.join(take relay))
}

// Socket IDs in this virtual Net are 1..3 for UDP, 4 for the listener, and 5..6
// for the clients. Pending reads and accepts use their socket ID as the key.
// Pending writes use ID + 8 so a stream can have both directions in flight.
type RelayNet {
    port: Served[NetOp],
    pending: Map[u64, Call[NetOp]],
    binds: u64,
    slow_read_closed: bool,
    slow_write_closed: bool
}

fn relay_net_drain(mut net: RelayNet) waits {
    while let Some(take op) = provide.next(mut net.port) {
        let key = match provide.net_op(op) {
            UdpBind(..) => {
                let addr = match net.binds {
                    0 => RELAY_LISTEN,
                    1 => RELAY_POOL_1,
                    2 => RELAY_POOL_2,
                    _ => fail("the virtual relay bound an extra socket"),
                }
                net.binds += 1
                result.unwrap(provide.reply(mut net.port, take op, provide.net_reply(UdpSockets(first: net.binds, count: 1, addr))))
                continue
            },
            Listen(addr: addr, backlog: _) => {
                result.unwrap(provide.reply(mut net.port, take op, provide.net_reply(Listener(4, addr))))
                continue
            },
            Accept(listener: listener) => listener,
            Recv(socket: socket, ..) => socket,
            UdpRecv(socket: socket, ..) => socket,
            Send(socket: socket, ..) => socket + 8,
            Released(id: 5, part: Read) => {
                net.slow_read_closed = true
                continue
            },
            Released(id: 5, part: Write) => {
                net.slow_write_closed = true
                continue
            },
            _ => fail("unexpected operation on the virtual TURN network"),
        }
        map.insert(mut net.pending, key, take op)
    }
}

fn relay_net_call(mut net: RelayNet, key: u64) -> Call[NetOp] {
    let Some(take op) = map.remove(mut net.pending, key) else {
        fail("the relay did not issue the expected socket operation")
    }
    take op
}

fn relay_net_send(mut net: RelayNet, socket: u64) -> Bytes waits {
    let op = relay_net_call(mut net, socket + 8)
    let Send(prefix: prefix, tail: tail, ..) = provide.net_op(op) else {
        fail("expected a TURN TCP write")
    }
    let mut data: Bytes = list.with_capacity(prefix + tail)
    provide.payload(op, 1, mut data)
    provide.payload(op, 2, mut data)
    result.unwrap(provide.reply(mut net.port, take op, provide.net_reply(Count(prefix + tail))))
    relay_net_drain(mut net)
    take data
}

fn relay_net_request(mut net: RelayNet, socket: u64, mut client: turn.Client, rnd: Random) waits {
    let mut wire: Bytes = list.with_capacity(1500)
    list.fill(mut wire, 1500, 0)
    let Send(n) = result.unwrap(turn.poll(mut client, tnow(0), rnd, mut wire)) else {
        fail("the client had no TURN request")
    }
    let mut read = relay_net_call(mut net, socket)
    if provide.fill(mut net.port, mut read, list.slice(wire, 0, n)) != n {
        fail("the virtual TCP read did not fit the request")
    }
    result.unwrap(provide.reply(mut net.port, take read, provide.net_reply(Count(n))))
    relay_net_drain(mut net)
    let mut response = relay_net_send(mut net, socket)
    let _ = result.unwrap(turn.receive(mut client, tnow(0), rnd, mut response))
}

fn relay_net_open(mut net: RelayNet, socket: u64, rnd: Random) -> turn.Client waits {
    let accept = relay_net_call(mut net, 4)
    let from = Addr(ip: V4(0xc6336401), port: int.narrow(50000u64 + socket))
    result.unwrap(provide.reply(mut net.port, take accept, provide.net_reply(Socket(socket, from))))
    relay_net_drain(mut net)
    let creds = result.unwrap(signal.mint_session(master("mac"), rnd, b"test", MINT_UNIX, plan()))
    let mut client = relay_client(true, creds)
    relay_net_request(mut net, socket, mut client, rnd)
    relay_net_request(mut net, socket, mut client, rnd)
    let _ = result.unwrap(turn.bind(mut client, SFU_MEDIA, tnow(0)))
    relay_net_request(mut net, socket, mut client, rnd)
    take client
}

fn relay_net_datagram(mut net: RelayNet, client: turn.Client, payload: Bytes) {
    let Allocated(allocation) = turn.client_state(client) else {
        fail("the virtual TURN client has no allocation")
    }
    let key = if allocation.relayed == RELAY_POOL_1 {
        2u64
    } else {
        3u64
    }
    let mut read = relay_net_call(mut net, key)
    let n = provide.fill(mut net.port, mut read, payload)
    let mut packets: List[UdpStaged] = list.with_capacity(1)
    list.push(mut packets, UdpStaged(peer: SFU_MEDIA, len: n, appended: n, ecn: 0))
    if n != list.len(payload) || provide.fill_packets(mut net.port, mut read, take packets) != 1 {
        fail("could not stage a datagram on the virtual allocation")
    }
    result.unwrap(provide.reply(mut net.port, take read, provide.net_reply(UdpPackets(count: 1))))
}

/// bug: a TCP client that stops reading parks the relay inside its write, keeping another client's queued media from reaching it.
/// oracle: a virtual Net holds one TCP write pending and delivers media to both bound allocations. The stalled connection releases both socket halves within 100 ms and the healthy client receives its original media bytes.
@test
fn stalled_turn_stream_releases_healthy_media(tasks: Tasks, out: Stdout) -> Result[(), turn.TurnError] waits {
    let until = 1000u64 * MS
    let sockets = option.unwrap(signal.relay_socket_plan(2, 1200, 1))
    let (test_clock, take hand) = provide.clock(0, MINT_UNIX * 1000)
    let mut time = take hand
    let (net, take port) = provide.net(bytes 4194304)
    let mut served = RelayNet(port: take port, pending: map.new(), binds: 0, slow_read_closed: false, slow_write_closed: false)
    let (revoke, revokes): (Sender[signal.RelayRevoke], Receiver[signal.RelayRevoke]) = channel.new(1)
    let (ready, started): (Sender[()], Receiver[()]) = channel.new(1)
    let rnd = provide.random(11)
    let job = turn_runtime.Start(net, clock: test_clock, random: rnd, tasks, out, listen: RELAY_LISTEN, master: master("mac kdf"), nonce: master("mac"), plan: plan(), sockets, revokes: take revokes, ready: take ready, until)
    let relay = task.spawn(tasks, bytes turn_runtime.reserve_bytes(sockets), take job, turn_runtime.run)
    relay_net_drain(mut served)
    result.unwrap(channel.try_receive(started))
    let slow = relay_net_open(mut served, 5, rnd)
    let mut healthy = relay_net_open(mut served, 6, rnd)
    relay_net_datagram(mut served, slow, b"one")
    relay_net_drain(mut served)
    let stalled = relay_net_call(mut served, 13)
    relay_net_datagram(mut served, healthy, b"two")
    relay_net_drain(mut served)
    let Some(due) = clock.idle(mut time) else {
        fail("the outstanding TCP write registered no deadline")
    }
    if due > 100 * MS {
        fail("the outstanding TCP write blocked the relay beyond 100 ms")
    }
    clock.advance_to(mut time, due)
    relay_net_drain(mut served)
    let Error(Withdrawn) = provide.reply(mut served.port, take stalled, provide.net_reply(Count(0))) else {
        fail("the stalled write stayed live after its deadline")
    }
    if !served.slow_read_closed || !served.slow_write_closed {
        fail("the stalled TURN connection did not release both halves")
    }
    let mut data = relay_net_send(mut served, 6)
    let Ok(Data(from, range)) = turn.receive(mut healthy, tnow(due / MS), rnd, mut data) else {
        fail("the healthy TURN client did not receive relayed media")
    }
    if from != SFU_MEDIA || !same(list.slice(data, range.lo, range.hi), b"two") {
        fail("the healthy TURN client received different media")
    }
    clock.advance_to(mut time, until)
    let _ = take revoke
    result.unwrap(task.join(take relay))
}

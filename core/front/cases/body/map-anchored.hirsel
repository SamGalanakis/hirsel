// SEM-5 / FORM #63, #65: equal stable keys in different blobs hit the same entry.
// Anchors in Map arguments name the same rows as the closed layout.
// Text, native stable fields and compact fields compare values, never addresses.
// expect: run checked() = 18
// One Doc map hit contributes seven; one Text map hit contributes eleven.
@compact(u16) stable type Doc:key { text:Text }
fn write[in r](take w:Writer[Doc,in r],s:String)->Result[Child[Doc],BuildError] {
 emit(take w,Doc(text:emit(fn(take t:Writer[Text,in r])->Result[Child[Text],BuildError] {
  writer.push(mut t,s)?
  writer.close(take t)
 })))
}
fn make(r:Region,s:String)->Doc in r {
 let b=result.unwrap(build_stream_in(r,bytes 128,fn(take w:Writer[Doc,in r])->Result[Child[Doc],BuildError] {write(take w,s)}))
 finish(take b)
}
fn get[T:key](m:Map[T,u64],x:T)->u64 {match map.get(m,x) {Some(v)=>v,None=>1000u64}}
fn checked()->u64 {region r {
 let a=make(r,"same")
 let b=make(r,"same")
 let mut docs:Map[Doc in r,u64]=map.new()
 let _=result.unwrap(map.insert(mut docs,a,7u64))
 let hit=get(docs,b)
 let t=result.unwrap(text.copy_in(r,"same"))
 let u=result.unwrap(text.copy_in(r,"same"))
 let mut texts:Map[Text in r,u64]=map.new()
 let _=result.unwrap(map.insert(mut texts,t,11u64))
 hit+get(texts,u)
}}
pub fn main()->Result[(),Exit] {if checked()==18u64 {Ok(())}else{Error(Exit(status:1))}}

; FORM #48: nonnull static data owns nothing at capacity zero, even when length is zero.
; f0 plain carrier, f1 counted carrier, f2 Map value, f3 Map value in a counted node.
; Each case returns no values and retains zero charge. Map storage is 48 bytes;
; counted holders add 32 bytes. Only those blocks may be cleaned/refunded.
core v1
type t0 = own "String" { bytes: seq u8 }
type t1 = own "Table" { values: map u64 seq u8 }
static d0 = align 1 hex 68656c6c6f
sig g0 = (u64) -> ()
sig g1 = (u64) -> (ptr)
inst n0 = test@0/static_carrier/plain [] []
inst n1 = test@0/static_carrier/counted [] []
inst n2 = test@0/static_carrier/map [] []
inst n3 = test@0/static_carrier/counted_map [] []
inst n4 = test@0/static_carrier/entry [] []
fn f0 = n0 g0 {
  slot s0 = t0
  addr a0 = s0 field 0 byte v1 : ptr
  addr a1 = s0 field 0 byte v2 : u64
  addr a2 = s0 field 0 byte v3 : u64
  addr a3 = s0 : t0
b0(v0: u64):
  live s0
  v1: u64 = const 0
  v2: u64 = const 8
  v3: u64 = const 16
  v4: ptr = static d0
  address a0
  address a1
  address a2
  store a0, v4
  store a1, v0
  store a2, v1
  address a3
  drop a3 t0
  dead s0
  return
}
fn f1 = n1 g0 {
  addr a0 = v5 byte v2 : ptr
  addr a1 = v5 byte v3 : u64
  addr a2 = v5 byte v4 : u64
b0(v0: u64):
  v1: u64 = const 0
  v2: u64 = const 8
  v3: u64 = const 16
  v4: u64 = const 24
  v6: u64 = const 32
  v5: ptr, v7: u64 = alloc counted rc v6 align 8 charge v6
  v8: ptr = static d0
  address a0
  address a1
  address a2
  store a0, v8
  store a1, v0
  store a2, v1
  release v5 rc t0
  return
}
fn f2 = n2 g0 {
  slot s0 = t1
  addr a0 = s0 field 0 byte v1 : ptr
  addr a1 = s0 field 0 byte v2 : u64
  addr a2 = s0 field 0 byte v3 : u64
  addr a3 = s0 : t1
b0(v0: u64):
  live s0
  v1: u64 = const 0
  v2: u64 = const 8
  v3: u64 = const 16
  v4: ptr = call f4 g1 (v0)
  v5: u64 = const 1
  address a0
  address a1
  address a2
  store a0, v4
  store a1, v5
  store a2, v5
  address a3
  drop a3 t1
  dead s0
  return
}
fn f3 = n3 g0 {
  addr a0 = v5 byte v2 : ptr
  addr a1 = v5 byte v3 : u64
  addr a2 = v5 byte v4 : u64
b0(v0: u64):
  v1: u64 = const 1
  v2: u64 = const 8
  v3: u64 = const 16
  v4: u64 = const 24
  v6: u64 = const 32
  v5: ptr, v7: u64 = alloc counted rc v6 align 8 charge v6
  v8: ptr = call f4 g1 (v0)
  address a0
  address a1
  address a2
  store a0, v8
  store a1, v1
  store a2, v1
  release v5 rc t1
  return
}
fn f4 = n4 g1 {
  addr a0 = v8 : u64
  addr a1 = v8 byte v2 : u64
  addr a2 = v8 byte v3 : u64
  addr a3 = v8 byte v4 : ptr
  addr a4 = v8 byte v5 : u64
  addr a5 = v8 byte v6 : u64
b0(v0: u64):
  v1: u64 = const 0
  v2: u64 = const 8
  v3: u64 = const 16
  v4: u64 = const 24
  v5: u64 = const 32
  v6: u64 = const 40
  v7: u64 = const 48
  v8: ptr, v9: u64 = alloc own v7 align 8 charge v7
  v10: u64 = const 1
  v11: ptr = static d0
  address a0
  address a1
  address a2
  address a3
  address a4
  address a5
  store a0, v1
  store a1, v10
  store a2, v10
  store a3, v11
  store a4, v0
  store a5, v1
  return v8
}

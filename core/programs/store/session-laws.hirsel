// A Reset encodes from a 16-byte payload and a 30-byte wire capacity. Two
// connections hold one wire block each. A third job needs 48 more bytes
// (16 + 32), so an 80-byte pool refuses until one of the two blocks drops.
pub fn law_pool_holds_writer_bytes(tasks: Tasks, clock: Clock) -> bool waits {
    let config = wire_defaults(0u64, 0u64)
    let allocated: Result[(Sender[WireAllocation[()]], Task[()]), Capacity] = start_wire_pool(tasks, config, clock, 80u64, 2u64)
    let (pool, take pooled_task) = result.unwrap(take allocated)
    let (one_to, one_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) = result.unwrap(channel.new(1u64))
    let (two_to, two_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) = result.unwrap(channel.new(1u64))
    let (write, pending): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1u64))
    let first = result.unwrap(wire_pack(pool, one_to, one_from, Reset(17u64, list.new())))
    let second = result.unwrap(wire_pack(pool, two_to, two_from, Reset(19u64, list.new())))
    result.unwrap(channel.try_send(write, take first))
    let before_write = match wire_pack(pool, one_to, one_from, Reset(23u64, list.new())) { Error(Protocol(1013u16)) => true, _ => false }
    let writing = result.unwrap(channel.try_receive(pending))
    let during_write = match wire_pack(pool, two_to, two_from, Reset(29u64, list.new())) { Error(Protocol(1013u16)) => true, _ => false }
    let bytes_sent = list.len(writing)
    let _ = take writing
    let third = result.unwrap(wire_pack(pool, one_to, one_from, Reset(31u64, list.new())))
    let other_bytes = list.len(second)
    let _ = take pooled_task
    before_write && during_write && bytes_sent == 18u64 && other_bytes == 18u64 && list.len(third) == 18u64
}

pub fn law_serving_budget() -> bool {
    let config = wire_defaults(65536u64, 1048576u64)
    let total = match serving_bytes(config, 10000u64) { Ok(n) => n, Error(_) => return false }
    if total != 1125122048u64 { return false }
    if let Ok(_) = serving_bytes(config, 10001u64) { return false }
    let mut excessive = config
    excessive.n_pool = 0xffffffffffffffffu64
    if let Error(_) = serving_bytes(excessive, 10000u64) { true } else { false }
}

pub fn law_subscription_room_refunded() -> bool {
    let mut quota = result.unwrap(subscription_room(400u64, 2u64))
    let (to, from): (Sender[SubscriptionInput], Receiver[SubscriptionInput]) = result.unwrap(channel.new(1u64))
    let arg: Bytes = result.unwrap(list.with_capacity(128u64))
    let first = result.unwrap(subscription_hold(mut quota, list.new(), take arg))
    result.unwrap(channel.try_send(to, take first))
    let same_size: Bytes = result.unwrap(list.with_capacity(128u64))
    let refused = match subscription_hold(mut quota, list.new(), take same_size) {
        Error(Capacity(requested: 192u64, available: 120u64)) => true,
        _ => false,
    }
    let _ = result.unwrap(channel.try_receive(from))
    let after_drop: Bytes = result.unwrap(list.with_capacity(128u64))
    let readmitted = match subscription_hold(mut quota, list.new(), take after_drop) { Ok(_) => true, _ => false }
    refused && readmitted
}

@test
fn test_wire_session(tasks: Tasks, clock: Clock) -> Result[(), ()] waits {
    if law_serving_budget() && law_subscription_room_refunded() && law_session_records(tasks) && law_pool_holds_writer_bytes(tasks, clock) && law_writer_one_frame() && law_children_joined_on_close(tasks) { Ok(()) } else { Error(()) }
}

pub fn law_writer_one_frame() -> bool {
    // Two caller-owned candidate frames and one Bytes handoff record. A third
    // charged byte cannot fit; the writer cannot reserve or retain another frame.
    let checked = bound bytes (2u64 * 262160u64 + 88u64) {
        let (tx, rx): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1u64))
        let first: Bytes = result.unwrap(list.with_capacity(262158u64))
        let second: Bytes = result.unwrap(list.with_capacity(262158u64))
        let mut busy = false
        let handed = if wire_ready(busy) {
            match wire_offer(tx, mut busy, take first) { Ok(()) => true, _ => false }
        } else { false }
        let pending = result.unwrap(channel.try_receive(rx))
        let rejected = if wire_ready(busy) {
            let _ = wire_offer(tx, mut busy, take second)
            false
        } else {
            let extra: Result[Bytes, Capacity] = list.with_capacity(1u64)
            let charged = match extra { Error(_) => true, _ => false }
            charged && list.capacity(second) == 262158u64
        }
        let empty = match channel.try_receive(rx) { Error(Empty) => true, _ => false }
        handed && busy && rejected && empty && list.capacity(pending) == 262158u64
    }
    match checked { Ok(ok) => ok, Error(_) => false }
}

fn wire_park(take rx: Receiver[()]) -> () waits { let _ = channel.receive(rx) }

pub fn law_children_joined_on_close(tasks: Tasks) -> bool waits {
    let (a, ar): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let (b, br): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let reader = result.unwrap(task.spawn(tasks, bytes 4096u64, take ar, wire_park))
    let writer = result.unwrap(task.spawn(tasks, bytes 4096u64, take br, wire_park))
    wire_join(take reader, take writer)
    let read_closed = match channel.try_send(a, ()) { Error(Closed(_)) => true, _ => false }
    let write_closed = match channel.try_send(b, ()) { Error(Closed(_)) => true, _ => false }
    read_closed && write_closed
}

fn wire_owner_park(take rx: Receiver[()]) -> Result[(), std.wsock.Error] waits {
    let _ = channel.receive(rx)
    Ok(())
}

pub fn law_session_records(tasks: Tasks) -> bool waits {
    // charge-v1: five WireEvents of 450 plus 64, one Bytes plus 64,
    // a credit channel of zero-sized units plus 64; three test gates of 64;
    // two unit-returning task records of 288 and the owner record of 320.
    let checked = bound bytes 3554u64 {
        let (events, hear): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(5u64))
        let (writes, read_writes): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1u64))
        let (credit, read_credit): (Sender[()], Receiver[()]) = result.unwrap(channel.new(5u64))
        let (a, ar): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let (b, br): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let (end, er): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let mut owner = result.unwrap(task.spawn(tasks, bytes 0u64, take er, wire_owner_park))
        let reader = result.unwrap(task.spawn(tasks, bytes 0u64, take ar, wire_park))
        let writer = result.unwrap(task.spawn(tasks, bytes 0u64, take br, wire_park))
        let extra: Result[Bytes, Capacity] = list.with_capacity(1u64)
        let exact = match extra { Error(_) => true, _ => false }
        task.cancel(mut owner)
        wire_join(take reader, take writer)
        let _ = task.join(take owner)
        let owner_closed = match channel.try_send(end, ()) { Error(Closed(_)) => true, _ => false }
        let _ = channel.try_send(events, wire_event(Sent))
        let _ = channel.try_send(writes, list.new())
        let _ = channel.try_send(credit, ())
        let live = match (channel.try_receive(hear), channel.try_receive(read_writes), channel.try_receive(read_credit)) {
            (Ok(WireEvent(e: Sent)), Ok(_), Ok(())) => true,
            _ => false,
        }
        let closed = match (channel.try_send(a, ()), channel.try_send(b, ())) {
            (Error(Closed(_)), Error(Closed(_))) => true,
            _ => false,
        }
        exact && live && closed && owner_closed
    }
    match checked { Ok(ok) => ok, Error(_) => false }
}

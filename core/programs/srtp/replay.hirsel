const RTCP_LIMIT: u64 = 1 << 31

type Floor {
    reference: Option[u64],
    minimum: u64
}

type ReceiveWindow {
    floor: Floor,
    receipts: std.replay.Window
}

fn window(floor: Floor) -> ReceiveWindow {
    ReceiveWindow(floor, receipts: result.unwrap(std.replay.window(128)))
}

fn copy_window(w: ReceiveWindow) -> ReceiveWindow {
    ReceiveWindow(floor: w.floor, receipts: result.unwrap(std.replay.try_copy(w.receipts)))
}

fn start_floor(index: Option[u64]) -> Floor {
    Floor(reference: index, minimum: index_or(index, 0))
}

fn estimate_base(w: ReceiveWindow) -> Option[u64] {
    match std.replay.top(w.receipts) {
        Some(top) => Some(top),
        None => w.floor.reference,
    }
}

fn kept_floor(w: ReceiveWindow) -> Floor {
    match std.replay.top(w.receipts) {
        Some(top) => Floor(reference: Some(top), minimum: top + 1),
        None => w.floor,
    }
}

fn check_window(w: ReceiveWindow, index: u64) -> Result[(), SrtpError] {
    if index < w.floor.minimum {
        return Error(Discarded(TooOld))
    }
    match std.replay.seen(w.receipts, index) {
        Fresh => Ok(()),
        Duplicate => Error(Discarded(Replayed)),
        TooOld => Error(Discarded(TooOld)),
    }
}

fn index_or(index: Option[u64], fallback: u64) -> u64 {
    match index {
        Some(value) => value,
        None => fallback,
    }
}

fn start_index(roc: u32, seq: u16) -> u64 {
    let high: u64 = int.widen(roc)
    let low: u64 = int.widen(seq)
    (high << 16) | low
}

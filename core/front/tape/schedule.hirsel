type Work: send {
    clock: Clock,
    sender: Sender[u64],
    n: u64
}

fn sleeper(take work: Work) -> u64 waits {
    host.sleep_until(work.clock, 9000u64)
    result.unwrap(channel.send(work.sender, work.n))
    work.n
}

pub fn main(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Exit] waits {
    let mode = match host.open(d, "schedule.tape", Read) {
        Ok(take f) => { result.unwrap(host.close(take f)); Replay },
        Error(NotFound) => Record,
        _ => return Error(Exit(status: 2))
    }
    let arg: Bytes = list.new()
    let header = tape.Header(id: (7u64, 9u64), identity: "schedule", arg: arg, limit: 1048576u64)
    let mut t = result.unwrap(tape.open(d, "schedule.tape", mode, header))
    let clock = tape.clock(mut t, c)
    let scheduler = tape.tasks(mut t, tasks)
    let (tx, rx): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(2))
    let one = result.unwrap(task.spawn(scheduler, bytes 4096, Work(clock: clock, sender: channel.sender(tx), n: 1), sleeper))
    let two = result.unwrap(task.spawn(scheduler, bytes 4096, Work(clock: clock, sender: channel.sender(tx), n: 2), sleeper))
    let first = result.unwrap(channel.receive(rx))
    let second = result.unwrap(channel.receive(rx))
    let _ = task.join(take one)
    let _ = task.join(take two)
    let mut outcome: Bytes = list.new()
    result.unwrap(list.push(mut outcome, int.truncate(first)))
    result.unwrap(list.push(mut outcome, int.truncate(second)))
    match tape.end(take t, Ok(outcome)) {
        Sealed => Ok(()),
        Faulted(_) => Error(Exit(status: 4))
    }
}

// Module harness: outside payloads. Blob staging for results too large to inline, and
// the granted worker that makes a sealed effect's one outside call and settles it.
fn blob_key(hash: Bytes) -> String {
    let mut key = string.into_bytes("sha256/")
    std.hex.append_from(mut key, list.len(hash), scoped fn(i: u64) -> u8 {
        hash[i]
    })
    result.unwrap(string.from_utf8(take key))
}

const EXCERPT_BYTES: u64 = 4096u64

pub fn truncate_middle(text: String, max: u64) -> String {
    middle_excerpt(string.as_bytes(text), max)
}

fn elision(dropped: u64) -> String {
    let mut marker = string.from("\n[")
    string.push_u64(mut marker, dropped)
    string.push(mut marker, " bytes omitted]\n")
    take marker
}

// The marker counts bytes excluded after rounding each cut inwards to a
// UTF-8 boundary. A budget too small for the marker yields an empty excerpt.
fn middle_excerpt(source: Bytes, max: u64) -> String {
    let n = list.len(source)
    let mut out: Bytes = list.with_capacity(if max < n { max } else { n })
    if n <= max {
        list.append(mut out, source)
    } else {
        let mut marker = elision(n)
        loop {
            let size = string.byte_len(marker)
            let keep = if max >= size { max - size } else { 0u64 }
            let mut head = (keep + 1u64) / 2u64
            let mut tail = n - keep / 2u64
            while (source[head] & 192u8) == 128u8 { head -= 1u64 }
            while tail < n && (source[tail] & 192u8) == 128u8 { tail += 1u64 }
            marker = elision(tail - head)
            if string.byte_len(marker) == size {
                if size <= max {
                    list.append(mut out, list.slice(source, 0u64, head))
                    list.append(mut out, string.as_bytes(marker))
                    list.append(mut out, list.slice(source, tail, n))
                }
                break
            }
        }
    }
    result.unwrap(string.from_utf8(take out))
}

// Read through the same bucket and prefix used for the write. The caller
// supplies its byte budget before the length in the reference can allocate.
pub fn read_blob(mut client: std.object.Client, reference: BlobRef, max_bytes: u64, deadline_ns: u64) -> Result[Bytes, Fault] waits {
    if reference.len > max_bytes {
        return Error(TooLarge)
    }
    if list.len(reference.digest) != 32u64 {
        return Error(Refused("invalid blob digest"))
    }
    let (fetched, take body) = std.object.fetch(mut client, blob_key(reference.digest), list.with_capacity(reference.len), deadline_ns)
    if let Error(_) = fetched {
        return Error(Unavailable)
    }
    if list.len(body) != reference.len || digest(body) != reference.digest {
        return Error(Refused("blob length or digest mismatch"))
    }
    Ok(take body)
}

// Stage a payload before settling it. A pre-existing key can only be reused
// after verifying its bytes. A crash before settle may leave an orphan.
pub fn store_payload(mut client: std.object.Client, take body: Bytes, take mime: String, deadline_ns: u64) -> Result[Payload, Fault] waits {
    let size = list.len(body)
    if size <= INLINE_LIMIT {
        return Ok(Inline(take body))
    }
    let excerpt = match std.utf8.validate(body) {
        Ok(()) => Some(middle_excerpt(body, EXCERPT_BYTES)),
        Error(_) => None,
    }
    let reference = BlobRef(digest: digest(body), len: size, mime: take mime, excerpt: take excerpt)
    let (written, _) = std.object.store_no_clobber(mut client, blob_key(reference.digest), take body, deadline_ns)
    match written {
        Ok(Created(_)) => (),
        Ok(Exists) => {
            let _ = read_blob(mut client, reference, size, deadline_ns)?
        },
        Error(TooLarge) => return Error(TooLarge),
        Error(_) => return Error(Unavailable),
    }
    Ok(Blob(take reference))
}

// ---- the granted worker ----
pub type Worked: codec + send = Sent | Doubted | Skipped | Lost

fn encoded[A: codec](a: A) -> Option[Bytes] {
    let codec: std.codec.Codec[A] = std.codec.of()
    let mut raw: Bytes = list.new()
    match std.codec.encode(codec, a, mut raw) {
        Ok(_) => Some(take raw),
        Error(_) => None
    }
}

fn call_attempt[F, A: codec, R: codec](ctx: runner.TriggerContext, f: StaticFn[F], a: A) -> Option[R] waits {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let Ok(take key) = runner.attempt_key(f, ca, cr) else {
        return None
    }
    let Some(take arg) = encoded(a) else {
        return None
    }
    let Ok(Returned(raw)) = runner.trigger_call(ctx, take key, take arg) else {
        return None
    }
    match std.codec.decode(cr, raw) {
        Ok(take r) => Some(take r),
        Error(_) => None
    }
}

fn doubt[F](ctx: runner.TriggerContext, settle_entry: StaticFn[F], key: EffectKey) -> Worked waits {
    let done: Option[Filed] = call_attempt(ctx, settle_entry, Settle(key: key, receipt: None))
    match done {
        Some(_) => Doubted,
        None => Lost
    }
}

fn remote_effect[G: send, App: inert + send](read_handle: store.Reader, snap: store.Snapshot, h: Handles, e: Effect, c: Call, a: Agent[G, App], port: G) -> Outcome waits {
    let Some(resolve) = a.mcp_peer else {
        return Gone
    }
    let Some(pos) = e.cutoff.tools_pos else {
        return Gone
    }
    let Ok(pinned) = store.get(read_handle, snap, h.entries, pos) else {
        return InDoubt
    }
    let Ok(found) = store.get(read_handle, snap, h.mcp_catalog, c.name) else {
        return InDoubt
    }
    let Some(row) = found else {
        return Gone
    }
    if !matching_remote(pinned, c.name, row) {
        return Gone
    }
    let get_peer = code.callable(resolve)
    let Some(peer) = get_peer(port, mcp_tools.server_id(row)) else {
        return Gone
    }
    let Inline(raw) = view c.args else {
        return Failed("MCP arguments must be inline")
    }
    let wall = host.wall_ms(peer.clock)
    if wall >= e.deadline {
        return Failed("MCP deadline elapsed before send")
    }
    let deadline = std.clock.deadline_after_ms(host.mono_ns(peer.clock), e.deadline - wall)
    let reply = mcp_tools.call(peer, row, clone(raw), mcp_tools.REPLY_LIMIT, deadline)
    tool_result(port, a, take reply)
}

fn tool_result[G: send, App: inert + send](port: G, a: Agent[G, App], take reply: Result[Bytes, Fault]) -> Outcome waits {
    let body = match take reply {
        Ok(take output) => take output,
        Error(Unavailable) => return InDoubt,
        Error(take fault) => return Failed(fault_text(take fault)),
    }
    if list.len(body) <= INLINE_LIMIT {
        return Returned(Inline(take body))
    }
    let Some(save) = a.store_result else {
        return Failed("result too large")
    }
    let save_result = code.callable(save)
    match save_result(port, take body) {
        Ok(take reference) => Returned(Blob(take reference)),
        Error(take fault) => Failed(fault_text(take fault)),
    }
}

fn reconcile_tool[G: send, App: inert + send](port: G, a: Agent[G, App], key: EffectKey, e: Effect) -> Option[Receipt] waits {
    let Some(c) = view e.call else {
        return None
    }
    let Some(Outside(_, _, Some(reconcile))) = tool_named(a, c.name) else {
        return None
    }
    let check = code.callable(reconcile)
    match check(port, key) {
        Ok(Some(take output)) => Some(Tool(tool_result(port, a, Ok(take output)))),
        Ok(None) => Some(Tool(Failed("not dispatched"))),
        Error(_) => None,
    }
}

// The body of the app's granted effect entry: begin, read the sealed cutoff
// through the fenced snapshot, make the one outside call, settle.
// A target streams the model's draft and each tool's progress to the preview hub.
pub fn effect[G: send, App: inert + send, F](ctx: runner.TriggerContext, h: Handles, port: G, take key: EffectKey, a: Agent[G, App], settle_entry: StaticFn[F], target: Option[preview.Target]) -> Result[Worked, Capacity] waits {
    let permit: Option[Permit] = call_attempt(ctx, code.describe(begin), key)
    let (recover, dispatches) = match permit {
        Some(Go(n)) => (false, n),
        Some(Doubt) if key.kind == TOOL => (true, 0u64),
        Some(Doubt) => return Ok(doubt(ctx, settle_entry, key)),
        Some(Shut) => return Ok(Skipped),
        None => return Ok(Lost),
    }
    let Ok((take read_handle, snap)) = runner.trigger_snapshot(ctx) else {
        return Ok(Lost)
    }
    let Ok(Some(take e)) = store.get(read_handle, snap, h.effects, key) else {
        return Ok(Lost)
    }
    let receipt: Receipt = if recover {
        let Some(take recovered) = reconcile_tool(port, a, key, e) else {
            return Ok(doubt(ctx, settle_entry, key))
        }
        take recovered
    } else if key.kind == MODEL || key.kind == WARM {
        let Ok(take asked) = request(read_handle, snap, h, key, e) else {
            return Ok(Lost)
        }
        let mut sink: Option[preview.Source] = if key.kind == WARM { None } else { effect_preview(read_handle, target, snap, h, ctx, key) }
        let race = match e.repeat {
            Repeatable(max) if key.kind == MODEL && e.stream && dispatches < max => a.hedged_model,
            _ => None,
        }
        let answered = match race {
            Some(f) => {
                let call = code.callable(f)
                call(port, take asked, mut sink, Hedge(context: runner.share_trigger_context(ctx), key: key, dispatches: dispatches))
            },
            None => {
                let call = code.callable(a.model)
                call(port, take asked, mut sink)
            },
        }
        match take answered {
            Ok(take answer) => Model(take answer),
            Error(take fault) => ModelFailed(take fault),
        }
    } else {
        let progress = effect_preview(read_handle, target, snap, h, ctx, key)
        let Some(c) = view e.call else {
            return Ok(Lost)
        }
        let outcome: Receipt = if mcp_tools.reserved(c.name) {
            Tool(remote_effect(read_handle, snap, h, e, c, a, port))
        } else {
            let Some(Outside(f, _, _)) = tool_named(a, c.name) else {
                return Ok(Lost)
            }
            let Inline(raw) = view c.args else {
                return Ok(Lost)
            }
            let go = code.callable(f)
            Tool(tool_result(port, a, go(port, clone(raw))))
        }
        let _ = take progress
        take outcome
    }
    let done: Option[Filed] = call_attempt(ctx, settle_entry, Settle(key: key, receipt: Some(take receipt)))
    match done {
        Some(_) => Ok(Sent),
        None => Ok(Lost)
    }
}

fn effect_preview(read_handle: store.Reader, target: Option[preview.Target], snap: store.Snapshot, h: Handles, ctx: runner.TriggerContext, key: EffectKey) -> Option[preview.Source] waits {
    let Some(t) = view target else {
        return None
    }
    let Ok(Some(s)) = store.get(read_handle, snap, h.session, 0u64) else {
        return None
    }
    let Ok(Some(r)) = store.get(read_handle, snap, h.runs, key.run) else {
        return None
    }
    let a = runner.trigger_attempt(ctx)
    // Parallel tools point to the first future ToolResult. All results become
    // visible in the same commit, even if reactions add entries between them.
    let tool: Option[u64] = if key.kind == MODEL {
        None
    } else {
        Some(key.ordinal)
    }
    let key_with_attempt = preview.Key(dispatch: runner.triggers.run_id(a), run: key.run, entry: s.next_pos, tool: tool, attempt: runner.triggers.number(a))
    match (bound bytes 16384u64 {
        preview.source(t, r.caller, key_with_attempt)
    }) {
        Ok(take result) => take result,
        Error(_) => None,
    }
}

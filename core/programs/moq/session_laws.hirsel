// MS2 Session laws: M11 (cancel_frees_state) and session behavior over Native QUIC and
// WebTransport (SETUP, tokens, narrowed REQUEST_OK/REQUEST_UPDATE, malformed tracks,
// early stream bounds, datagram requirement).
const MOQ_CLIENT_ADDR: Addr = Addr(ip: V4(0x7f000001u32), port: 25101)

const MOQ_SERVER_ADDR: Addr = Addr(ip: V4(0x7f000001u32), port: 25102)

fn moq_cert() -> Bytes {
    option.unwrap(std.hex.decode(b""))
}

fn moq_digest() -> Inline[u8, 32] {
    [22, 152, 95, 217, 108, 32, 99, 25, 28, 177, 201, 36, 198, 124, 23, 187, 129, 43, 78, 68, 81, 35, 158, 172, 159, 56, 49, 60, 242, 53, 214, 166]
}

fn moq_identity() -> quic.handshake.Identity {
    let mut scalar: Bytes = list.with_capacity(32)
    for _ in 0u64 .. 31 {
        list.push(mut scalar, 0)
    }
    list.push(mut scalar, 3)
    let mut point: Bytes = list.with_capacity(65)
    let key = result.unwrap(secret.p256_key(provide.random_tape(take scalar), "sign(p256)", mut point))
    let mut chain: List[Bytes] = list.with_capacity(1)
    list.push(mut chain, moq_cert())
    Identity(chain: take chain, key: take key, alg: P256)
}

fn moq_pins() -> List[quic.handshake.Pin] {
    let mut p: List[quic.handshake.Pin] = list.with_capacity(1)
    list.push(mut p, Cert(moq_digest()))
    take p
}

fn moq_endpoint_config() -> quic.EndpointConfig {
    let reset = result.unwrap(secret.seal(b"MOQ reset key", "mac"))
    let token = result.unwrap(secret.seal(b"MOQ token key", "kdf"))
    quic.EndpointConfig(member: 0, members: 1, cid_len: 8, max_mtu: 1200, retry: Never, reset_key: take reset, token_key: take token, limits: quic.EndpointLimits(connections: 16, unvalidated: 16, datagram_bytes: 131072))
}

fn moq_limits() -> moq.Limits {
    moq.Limits(requests: 16, tracks: 16, control_bytes: 65535, object_bytes: 65536, filter_ranges: 8, max_early_streams: 4, max_timeout_ms: 5000, max_buffered: 8388608)
}

fn wt_limits() -> webtransport.Limits {
    let mut auths: List[String] = list.new()
    list.push(mut auths, "server")
    let mut origins: List[String] = list.new()
    list.push(mut origins, "https://good.example")
    webtransport.Limits(authorities: take auths, origins: take origins, require_origin: false, sessions: 8, sessions_per_connection: 4, pending_connects: 4, streams_bidi: 16, streams_uni: 32, data: 131072, buffered: 8, buffered_datagrams: 8, header_bytes: 4096)
}

type Peer {
    io: moq.LinkIo[moq.MixedDriver],
    sess: Option[moq.Session],
    pooled: Option[moq.Session],
    pooled_events: List[moq.Event],
    events: List[moq.Event],
    raw: List[quic.Event],
    wt_events: List[webtransport.Event]
}

fn native_session(mut io: moq.LinkIo[moq.MixedDriver], c: quic.ConnectionHandle, side: schedule.Side, role: moq.Role, limits: moq.Limits) -> moq.Session {
    let link = option.unwrap(moq.native_link(mut io.driver, c))
    option.unwrap(moq.link_session(io, link, side, role, limits))
}

fn web_session(mut io: moq.LinkIo[moq.MixedDriver], s: webtransport.SessionHandle, side: schedule.Side, role: moq.Role, limits: moq.Limits) -> moq.Session {
    let link = option.unwrap(moq.web_link(mut io.driver, s))
    option.unwrap(moq.link_session(io, link, side, role, limits))
}

fn native_server(seed: u64, limits: moq.Limits) -> Peer {
    let t = moq.transport_config(limits)
    let q = result.unwrap(quic.endpoint(provide.random(seed), moq_endpoint_config(), Some((moq_identity(), take t))))
    Peer(io: moq.mixed_driver(take q, None, 32), sess: None, pooled: None, pooled_events: list.new(), events: list.new(), raw: list.new(), wt_events: list.new())
}

fn native_client(seed: u64) -> Peer {
    let q = result.unwrap(quic.endpoint(provide.random(seed), moq_endpoint_config(), None))
    Peer(io: moq.mixed_driver(take q, None, 32), sess: None, pooled: None, pooled_events: list.new(), events: list.new(), raw: list.new(), wt_events: list.new())
}

fn wt_server(seed: u64) -> Peer {
    let l = wt_limits()
    let t = webtransport.transport(l)
    let q = result.unwrap(quic.endpoint(provide.random(seed), moq_endpoint_config(), Some((moq_identity(), take t))))
    Peer(io: moq.mixed_driver(take q, Some(webtransport.endpoint(take l)), 32), sess: None, pooled: None, pooled_events: list.new(), events: list.new(), raw: list.new(), wt_events: list.new())
}

fn wt_client(seed: u64) -> Peer {
    let l = wt_limits()
    let q = result.unwrap(quic.endpoint(provide.random(seed), moq_endpoint_config(), None))
    Peer(io: moq.mixed_driver(take q, Some(webtransport.endpoint(take l)), 32), sess: None, pooled: None, pooled_events: list.new(), events: list.new(), raw: list.new(), wt_events: list.new())
}

fn deliver_peer(mut from: Peer, mut to: Peer, from_addr: Addr, now: u64, mut wire: Bytes, mut packets: List[quic.Output]) -> u64 {
    list.clear(mut wire)
    list.clear(mut packets)
    let _ = quic.poll(mut from.io.driver.q, now, mut wire, mut packets)
    let mut count = 0u64
    for output in packets {
        if let Transmit(..) = output {
            count += 1
        }
    }
    quic.committed(mut from.io.driver.q, now, count)
    let mut qevents: List[quic.Event] = list.new()
    for output in packets {
        if let Transmit(at: at, len: len, ..) = output {
            quic.receive_datagram(mut to.io.driver.q, now, from_addr, 0, mut wire, at, len, mut qevents)
        }
    }
    let has_wt = match to.io.driver.w {
        Some(_) => true,
        None => false,
    }
    if has_wt {
        let mut wevs: List[webtransport.Event] = list.new()
        if let Some(mut w) = to.io.driver.w {
            webtransport.receive(mut w, mut to.io.driver.q, now, qevents, mut wevs)
        }
        for ev in wevs {
            list.push(mut to.wt_events, clone(ev))
        }
        if let Some(mut s) = to.sess {
            let mut tevs: List[moq.AddressedEvent] = list.new()
            moq.web_events(mut to.io.driver, wevs, mut tevs)
            moq.receive(mut s, mut to.io, now, tevs, mut to.events)
        }
    } else {
        for ev in qevents {
            list.push(mut to.raw, clone(ev))
        }
        if let Some(mut s) = to.sess {
            let mut tevs: List[moq.AddressedEvent] = list.new()
            moq.native_events(mut to.io.driver, qevents, mut tevs)
            moq.receive(mut s, mut to.io, now, tevs, mut to.events)
        }
    }
    count
}

fn settle_pair(mut client: Peer, mut server: Peer, now: u64) {
    let mut wire: Bytes = list.with_capacity(64 * 1200)
    let mut packets: List[quic.Output] = list.with_capacity(65)
    for _ in 0u64 .. 4000 {
        let a = deliver_peer(mut client, mut server, MOQ_CLIENT_ADDR, now, mut wire, mut packets)
        let b = deliver_peer(mut server, mut client, MOQ_SERVER_ADDR, now, mut wire, mut packets)
        if a == 0 && b == 0 {
            return
        }
    }
    fail("moq peers never settled")
}

fn first_quic_conn(events: List[quic.Event]) -> quic.ConnectionHandle {
    for ev in events {
        if let Connected(c: c, ..) = ev {
            return c
        }
    }
    fail("no QUIC connection")
}

fn establish_native(mut client: Peer, mut server: Peer, limits: moq.Limits, auth: Bytes, path: Bytes, tok: Option[Bytes]) {
    let cc = result.unwrap(quic.connect(mut client.io.driver.q, 0, MOQ_SERVER_ADDR, "server", moq_pins(), None, moq.transport_config(limits)))
    let mut cs = native_session(mut client.io, cc, Client, Both, limits)
    moq.configure_setup(mut cs, clone(auth), clone(path), clone(tok))
    client.sess = Some(take cs)
    settle_pair(mut client, mut server, 1)
    let sc = first_quic_conn(server.raw)
    let mut ss = native_session(mut server.io, sc, Server, Both, limits)
    let mut tevs: List[moq.AddressedEvent] = list.new()
    moq.native_events(mut server.io.driver, server.raw, mut tevs)
    moq.receive(mut ss, mut server.io, 2, tevs, mut server.events)
    server.sess = Some(take ss)
    settle_pair(mut client, mut server, 3)
    if let Some(mut s) = server.sess {
        moq.accept_setup(mut s, mut server.io, Ok(moq.default_scope(auth, path)))
    }
    settle_pair(mut client, mut server, 4)
}

fn make_obj(take tr: codec.TrackName, group: u64, sg: u64, id: u64, mode: moq.Mode, prio: u8, take payload: Bytes) -> moq.Object {
    moq.Object(track: take tr, group: group, subgroup: sg, id: id, mode: mode, publisher_priority: prio, status: Normal, properties: b"", payload: quic.payload_whole(shared.new(take payload)))
}

fn received_objects(events: List[moq.Event]) -> List[moq.Object] {
    let mut out: List[moq.Object] = list.new()
    for ev in events {
        if let Received(o) = ev {
            list.push(mut out, clone(o))
        }
    }
    take out
}

fn has_malformed(events: List[moq.Event], tr: codec.TrackName) -> bool {
    for ev in events {
        if let Malformed(track: t) = ev {
            if t == tr {
                return true
            }
        }
    }
    false
}

fn has_closed(events: List[moq.Event], code: u64) -> bool {
    for ev in events {
        if let Closed(code: c) = ev {
            if c == code {
                return true
            }
        }
    }
    false
}

fn first_subscribe_id(events: List[moq.Event]) -> moq.RequestId {
    for ev in events {
        if let Subscribe(id: id, ..) = ev {
            return id
        }
    }
    fail("no Subscribe event received")
}

fn first_fetch_id(events: List[moq.Event]) -> moq.RequestId {
    for ev in events {
        if let Fetch(id: id, ..) = ev {
            return id
        }
    }
    fail("no Fetch event received")
}

/// bug: cancelling a subscription leaves per-subscription state alive on the publisher, or
/// STOP_SENDING on a request stream does not free its subscription entry.
/// oracle: moqt-23 §6.4.2.3 and M11 (cancel_frees_state): after STOP_SENDING / cancel on a
/// request stream, active_requests and active_subscriptions drop to 0 on both peers and
/// Event.Done fires on the publisher.
@test
fn cancel_frees_state() -> Result[(), ()] {
    let lim = moq_limits()
    let mut client = native_client(101)
    let mut server = native_server(102, lim)
    establish_native(mut client, mut server, lim, b"example.com", b"/live", Some(b"tok-1"))
    let tr = track(ns1(b"room"), b"video")
    let req_id = if let Some(mut cs) = client.sess {
        result.unwrap(moq.subscribe(mut cs, mut client.io, 10, clone(tr), NoFilter, 10, Some(b"sub-tok")))
    } else {
        fail("missing client session")
    }
    settle_pair(mut client, mut server, 11)
    let sub_id = first_subscribe_id(server.events)
    if let Some(mut ss) = server.sess {
        moq.accept(mut ss, mut server.io, sub_id, Ok(()))
    }
    settle_pair(mut client, mut server, 12)
    if let Some(ss) = server.sess {
        if moq.active_subscriptions(ss) != 1 || moq.active_requests(ss) != 1 {
            fail("publisher did not record active subscription")
        }
    }
    if let Some(mut ss) = server.sess {
        result.unwrap(moq.publish(mut ss, mut server.io, 13, make_obj(clone(tr), 1, 0, 0, Subgroup, 64, b"frame-0")))
    }
    settle_pair(mut client, mut server, 14)
    let got = received_objects(client.events)
    if list.len(got) != 1 || got[0].group != 1 || got[0].id != 0 {
        fail("subscriber did not receive object before cancel")
    }
    list.clear(mut server.events)
    if let Some(mut cs) = client.sess {
        moq.cancel(mut cs, mut client.io, req_id, moq.RESET_CANCELLED)
        if moq.active_requests(cs) != 0 || moq.active_subscriptions(cs) != 0 {
            fail("subscriber did not free state on cancel")
        }
    }
    settle_pair(mut client, mut server, 15)
    if let Some(ss) = server.sess {
        if moq.active_requests(ss) != 0 || moq.active_subscriptions(ss) != 0 {
            fail("publisher did not free subscription state after STOP_SENDING")
        }
    }
    let mut saw_done = false
    for ev in server.events {
        if let Done(id: id, ..) = ev {
            if id == sub_id {
                saw_done = true
            }
        }
    }
    if !saw_done {
        fail("publisher did not emit Event.Done when subscriber cancelled")
    }
    Ok(())
}

/// bug: MoQ fails to run over WebTransport, accepts SETUP without DATAGRAM extension, fails to
/// narrow REQUEST_OK/REQUEST_UPDATE per request kind (moq.md:337), or accepts malformed tracks.
/// oracle: docs/spec/moq.md MOQ-1..MOQ-4, MOQ-9, and moqt-23 §6.2, §9.1, §9.3, §9.5, §12.1.
@test
fn session_native_webtransport_and_refusals() -> Result[(), ()] {
    // 1. default_scope strips '?query' and separates authority from path.
    let s1 = moq.default_scope(b"a.example", b"/room/1?token=abc")
    let s2 = moq.default_scope(b"a.example", b"/room/1?token=xyz")
    let s3 = moq.default_scope(b"a.example/room", b"/1")
    if s1 != s2 || s1 == s3 {
        fail("default_scope did not strip query or collided authority/path")
    }
    // 2. Native QUIC: Subgroup + Datagram delivery + tokens + Malformed track detection.
    let lim = moq_limits()
    let mut client = native_client(201)
    let mut server = native_server(202, lim)
    establish_native(mut client, mut server, lim, b"moq.test", b"/app?q=1", Some(b"setup-secret"))
    let mut saw_setup = false
    for ev in server.events {
        if let Setup(authority: authority, path: path, token: token) = ev {
            if authority == b"moq.test" && path == b"/app?q=1" && token == Some(b"setup-secret") {
                saw_setup = true
            }
        }
    }
    if !saw_setup {
        fail("server did not surface SETUP authority, path and token")
    }
    let tr = track(ns2(b"ns", b"live"), b"audio")
    let _ = if let Some(mut cs) = client.sess {
        result.unwrap(moq.subscribe(mut cs, mut client.io, 10, clone(tr), NoFilter, 32, Some(b"req-secret")))
    } else {
        fail("missing client")
    }
    settle_pair(mut client, mut server, 11)
    let mut sub_id: moq.RequestId = RequestId(0)
    let mut got_sub_tok = false
    for ev in server.events {
        if let Subscribe(id: id, track: t, token: token, ..) = ev {
            if t == tr && token == Some(b"req-secret") {
                sub_id = id
                got_sub_tok = true
            }
        }
    }
    if !got_sub_tok {
        fail("server did not surface per-request token")
    }
    if let Some(mut ss) = server.sess {
        moq.accept(mut ss, mut server.io, sub_id, Ok(()))
    }
    settle_pair(mut client, mut server, 12)
    if let Some(mut ss) = server.sess {
        result.unwrap(moq.publish(mut ss, mut server.io, 13, make_obj(clone(tr), 2, 0, 0, Datagram, 40, b"dg-0")))
        result.unwrap(moq.publish(mut ss, mut server.io, 14, make_obj(clone(tr), 2, 0, 0, Datagram, 40, b"dg-0")))
    }
    settle_pair(mut client, mut server, 15)
    let got_dg = received_objects(client.events)
    if list.len(got_dg) != 1 || got_dg[0].mode != Datagram {
        fail("datagram object not delivered or duplicate not deduplicated")
    }
    if let Some(mut ss) = server.sess {
        result.unwrap(moq.publish(mut ss, mut server.io, 16, make_obj(clone(tr), 2, 0, 0, Datagram, 40, b"evil")))
    }
    settle_pair(mut client, mut server, 17)
    if !has_malformed(client.events, clone(tr)) {
        fail("conflicting duplicate object did not mark track malformed")
    }
    if let Some(cs) = client.sess {
        if moq.active_subscriptions(cs) != 0 {
            fail("malformed track did not cancel subscriber's requests")
        }
    }
    // 3. WebTransport session with moqt-23 protocol negotiation + object delivery.
    let mut wc = wt_client(301)
    let mut ws = wt_server(302)
    let mut protos: List[String] = list.new()
    list.push(mut protos, moq.ALPN)
    let csh = if let Some(mut w) = wc.io.driver.w {
        result.unwrap(webtransport.connect(mut w, mut wc.io.driver.q, 0, MOQ_SERVER_ADDR, "https://server/moq", moq_pins(), take protos))
    } else {
        fail("missing wt client")
    }
    settle_pair(mut wc, mut ws, 1)
    let mut ssh_opt: Option[webtransport.SessionHandle] = None
    for ev in ws.wt_events {
        if let Requested(sh, req) = ev {
            if list.contains(req.protocols, moq.ALPN) {
                ssh_opt = Some(sh)
            }
        }
    }
    let ssh = option.unwrap(ssh_opt)
    if let Some(mut w) = ws.io.driver.w {
        result.unwrap(webtransport.answer(mut w, mut ws.io.driver.q, ssh, Accept(protocol: Some(moq.ALPN), headers: list.new())))
    }
    ws.sess = Some(web_session(mut ws.io, ssh, Server, Both, lim))
    wc.sess = Some(web_session(mut wc.io, csh, Client, Both, lim))
    settle_pair(mut wc, mut ws, 2)
    if let Some(mut ss) = ws.sess {
        moq.accept_setup(mut ss, mut ws.io, Ok(moq.default_scope(b"server", b"/moq")))
    }
    settle_pair(mut wc, mut ws, 3)
    let wt_tr = track(ns1(b"wt"), b"stream")
    let _ = if let Some(mut cs) = wc.sess {
        result.unwrap(moq.subscribe(mut cs, mut wc.io, 4, clone(wt_tr), NoFilter, 16, None))
    } else {
        fail("missing wt client moq session")
    }
    settle_pair(mut wc, mut ws, 5)
    let wt_sub_id = first_subscribe_id(ws.events)
    if let Some(mut ss) = ws.sess {
        moq.accept(mut ss, mut ws.io, wt_sub_id, Ok(()))
    }
    settle_pair(mut wc, mut ws, 6)
    if let Some(mut ss) = ws.sess {
        result.unwrap(moq.publish(mut ss, mut ws.io, 7, make_obj(clone(wt_tr), 0, 0, 0, Subgroup, 20, b"wt-hello")))
    }
    settle_pair(mut wc, mut ws, 8)
    let wt_got = received_objects(wc.events)
    if list.len(wt_got) != 1 || wt_got[0].track != wt_tr {
        fail("WebTransport MoQ session did not deliver object")
    }
    // 4. Refusals: second SETUP -> PROTOCOL_VIOLATION; narrowed REQUEST_UPDATE -> INVALID_PARAMETER.
    let mut rc = native_client(401)
    let mut rs = native_server(402, lim)
    let rcc = result.unwrap(quic.connect(mut rc.io.driver.q, 0, MOQ_SERVER_ADDR, "server", moq_pins(), None, moq.transport_config(lim)))
    settle_pair(mut rc, mut rs, 1)
    let rsc = first_quic_conn(rs.raw)
    rs.sess = Some(native_session(mut rs.io, rsc, Server, Both, lim))
    let mut rs_ready: List[moq.AddressedEvent] = list.new()
    moq.native_events(mut rs.io.driver, rs.raw, mut rs_ready)
    if let Some(mut session) = rs.sess {
        moq.receive(mut session, mut rs.io, 2, rs_ready, mut rs.events)
    }
    let ctrl = result.unwrap(quic.open(mut rc.io.driver.q, rcc, false))
    let mut two_setups: Bytes = list.new()
    result.unwrap(codec.write_message(Setup(options: list.new()), codec.DEFAULT_MAX_CONTROL, mut two_setups))
    result.unwrap(codec.write_message(Setup(options: list.new()), codec.DEFAULT_MAX_CONTROL, mut two_setups))
    let _ = result.unwrap(quic.write(mut rc.io.driver.q, rcc, ctrl, two_setups, false))
    settle_pair(mut rc, mut rs, 2)
    if !has_closed(rs.events, moq.ERR_PROTOCOL_VIOLATION) {
        fail("second SETUP did not close with PROTOCOL_VIOLATION")
    }
    let mut nc = native_client(501)
    let mut ns_srv = native_server(502, lim)
    let ncc = result.unwrap(quic.connect(mut nc.io.driver.q, 0, MOQ_SERVER_ADDR, "server", moq_pins(), None, moq.transport_config(lim)))
    settle_pair(mut nc, mut ns_srv, 1)
    let nsc = first_quic_conn(ns_srv.raw)
    ns_srv.sess = Some(native_session(mut ns_srv.io, nsc, Server, Both, lim))
    let mut ns_srv_ready: List[moq.AddressedEvent] = list.new()
    moq.native_events(mut ns_srv.io.driver, ns_srv.raw, mut ns_srv_ready)
    if let Some(mut session) = ns_srv.sess {
        moq.receive(mut session, mut ns_srv.io, 2, ns_srv_ready, mut ns_srv.events)
    }
    let nctrl = result.unwrap(quic.open(mut nc.io.driver.q, ncc, false))
    let mut one_setup: Bytes = list.new()
    result.unwrap(codec.write_message(Setup(options: list.new()), codec.DEFAULT_MAX_CONTROL, mut one_setup))
    let _ = result.unwrap(quic.write(mut nc.io.driver.q, ncc, nctrl, one_setup, false))
    settle_pair(mut nc, mut ns_srv, 2)
    if let Some(mut ss) = ns_srv.sess {
        moq.accept_setup(mut ss, mut ns_srv.io, Ok(moq.default_scope(b"", b"")))
    }
    settle_pair(mut nc, mut ns_srv, 3)
    let bidi = result.unwrap(quic.open(mut nc.io.driver.q, ncc, true))
    let mut fetch_and_bad_upd: Bytes = list.new()
    result.unwrap(codec.write_message(Fetch(id: 0, track: track(ns1(b"a"), b"b"), params: list.new()), codec.DEFAULT_MAX_CONTROL, mut fetch_and_bad_upd))
    let mut bad_ps: List[codec.Param] = list.new()
    list.push(mut bad_ps, TrackNamespacePrefix(ns1(b"x")))
    result.unwrap(codec.write_message(RequestUpdate(id: 2, params: take bad_ps), codec.DEFAULT_MAX_CONTROL, mut fetch_and_bad_upd))
    let _ = result.unwrap(quic.write(mut nc.io.driver.q, ncc, bidi, fetch_and_bad_upd, false))
    settle_pair(mut nc, mut ns_srv, 4)
    if !has_closed(ns_srv.events, moq.ERR_INVALID_PARAMETER) {
        fail("REQUEST_UPDATE narrowing did not refuse TRACK_NAMESPACE_PREFIX on FETCH")
    }
    // 5. Connection without QUIC DATAGRAM extension refused at setup (moqt-23 §6.2).
    let mut dc = native_client(601)
    let mut ds = native_server(602, lim)
    let mut no_dg = moq.transport_config(lim)
    no_dg.max_datagram_frame = 0
    let _ = result.unwrap(quic.connect(mut dc.io.driver.q, 0, MOQ_SERVER_ADDR, "server", moq_pins(), None, take no_dg))
    settle_pair(mut dc, mut ds, 1)
    let dsc = first_quic_conn(ds.raw)
    let mut dss = native_session(mut ds.io, dsc, Server, Both, lim)
    let mut ds_ready: List[moq.AddressedEvent] = list.new()
    moq.native_events(mut ds.io.driver, ds.raw, mut ds_ready)
    moq.receive(mut dss, mut ds.io, 2, ds_ready, mut ds.events)
    if !has_closed(ds.events, moq.ERR_PROTOCOL_VIOLATION) {
        fail("missing QUIC DATAGRAM extension was not refused at setup")
    }
    // 6. Narrowing REQUEST_OK (moq.md:337): PUBLISH_NAMESPACE_OK carrying LARGEST_OBJECT is INVALID_PARAMETER.
    let mut oc = native_client(701)
    let mut os = native_server(702, lim)
    let occ = result.unwrap(quic.connect(mut oc.io.driver.q, 0, MOQ_SERVER_ADDR, "server", moq_pins(), None, moq.transport_config(lim)))
    oc.sess = Some(native_session(mut oc.io, occ, Client, Both, lim))
    settle_pair(mut oc, mut os, 1)
    let osc = first_quic_conn(os.raw)
    let sctrl = result.unwrap(quic.open(mut os.io.driver.q, osc, false))
    let mut srv_setup: Bytes = list.new()
    result.unwrap(codec.write_message(Setup(options: list.new()), codec.DEFAULT_MAX_CONTROL, mut srv_setup))
    let _ = result.unwrap(quic.write(mut os.io.driver.q, osc, sctrl, srv_setup, false))
    settle_pair(mut oc, mut os, 2)
    let _ = if let Some(mut cs) = oc.sess {
        result.unwrap(moq.publish_namespace(mut cs, mut oc.io, 3, ns1(b"pub"), None))
    } else {
        fail("missing oc client")
    }
    settle_pair(mut oc, mut os, 4)
    let mut peer_bidi: Option[quic.StreamId] = None
    for ev in os.raw {
        if let Opened(_, sid) = ev {
            let quic.StreamId(n) = sid
            if (n & 2) == 0 {
                peer_bidi = Some(sid)
            }
        }
    }
    let bad_ok_stream = option.unwrap(peer_bidi)
    let mut bad_ok_ps: List[codec.Param] = list.new()
    list.push(mut bad_ok_ps, LargestObject(loc(1, 0)))
    let mut bad_ok_wire: Bytes = list.new()
    result.unwrap(codec.write_message(RequestOk(params: take bad_ok_ps, properties: list.new()), codec.DEFAULT_MAX_CONTROL, mut bad_ok_wire))
    let _ = result.unwrap(quic.write(mut os.io.driver.q, osc, bad_ok_stream, bad_ok_wire, false))
    settle_pair(mut oc, mut os, 5)
    if !has_closed(oc.events, moq.ERR_INVALID_PARAMETER) {
        fail("REQUEST_OK narrowing did not refuse LARGEST_OBJECT on PUBLISH_NAMESPACE")
    }
    Ok(())
}

/// bug: an object length of 2^64 - 1 on a subgroup or fetch stream overflows p.length + 256 and ends the relay task, or a Descending FETCH with EndOfRange at group 2^64 - 1 overflows last_group + 1.
/// oracle: moqt-23 §11 and MOQ-7/MOQ-9: lengths past Limits.object_bytes end only the offending session with FIELD_LENGTH_EXCEEDED (0x401), a second session on the same relay still delivers objects, and extreme group ids do not overflow.
@test
fn session_object_limits_and_fetch_extremes() -> Result[(), ()] {
    let lim = moq_limits()
    // 1. Subgroup stream declaring length 2^64 - 1, then 1 byte: ends offending session, relay survives.
    let rlim = moq.RelayLimits(cache_groups: 8, cache_bytes: 131072, per_track_cache_bytes: 131072, max_objects_per_group: 32, max_object_bytes: 16384)
    let mut rig = new_relay_rig(2101, lim, rlim, 8)
    let sc = moq.default_scope(b"sec.test", b"/p0-1")
    let bad_pub = rig_add_peer(mut rig, 2102, Publisher, clone(sc), lim, 0)
    let good_pub = rig_add_peer(mut rig, 2103, Publisher, clone(sc), lim, 10)
    let sub_i = rig_add_peer(mut rig, 2104, Subscriber, clone(sc), lim, 20)
    let tr = track(ns1(b"p01"), b"sg")
    let _ = peer_subscribe(mut rig.peers[sub_i], 30, clone(tr), NoFilter, 10, None)
    rig_settle(mut rig, 31, true)
    let _ = peer_accept_subscribes(mut rig.peers[bad_pub])
    let _ = peer_accept_subscribes(mut rig.peers[good_pub])
    rig_settle(mut rig, 32, true)
    let bad_cc = first_quic_conn(rig.peers[bad_pub].raw)
    let bad_st = result.unwrap(quic.open(mut rig.peers[bad_pub].io.driver.q, bad_cc, false))
    let sh = codec.SubgroupHeader(alias: 0, group: 1, subgroup: ZeroSubgroup, priority: Some(10), properties: false, end_of_group: false, first_object: true)
    let mut swire: Bytes = list.new()
    result.unwrap(codec.write_subgroup_header(sh, mut swire))
    result.unwrap(codec.write_subgroup_object(codec.SubgroupObject(id: 0, properties: list.new(), length: 0xffffffffffffffff, status: Normal), sh, None, mut swire))
    let _ = result.unwrap(quic.write(mut rig.peers[bad_pub].io.driver.q, bad_cc, bad_st, swire, false))
    rig_settle(mut rig, 33, true)
    let _ = quic.write(mut rig.peers[bad_pub].io.driver.q, bad_cc, bad_st, b"\x00", false)
    rig_settle(mut rig, 34, true)
    let bad_rid = rig.peer_rids[bad_pub]
    let mut bad_ended = false
    for ev in rig.events {
        if let Ended(session: sid, code: c) = ev {
            if sid == bad_rid && c == moq.ERR_FIELD_LENGTH_EXCEEDED {
                bad_ended = true
            }
        }
    }
    if !bad_ended {
        fail("subgroup length 2^64 - 1 did not close offending session with FIELD_LENGTH_EXCEEDED")
    }
    peer_publish(mut rig.peers[good_pub], 35, make_obj(clone(tr), 2, 0, 0, Subgroup, 10, b"still-alive"), true)
    rig_settle(mut rig, 36, true)
    let got_good = received_objects(rig.peers[sub_i].events)
    if list.len(got_good) != 1 || got_good[0].group != 2 {
        fail("second session on relay could not deliver after offending session closed")
    }
    // 2. Fetch stream declaring length 2^64 - 1, then 1 byte: ends session with FIELD_LENGTH_EXCEEDED.
    let mut fc = native_client(2201)
    let mut fs = native_server(2202, lim)
    establish_native(mut fc, mut fs, lim, b"sec.test", b"/fetch-len", None)
    let ftr = track(ns1(b"p01"), b"fetch")
    let freq = if let Some(mut cs) = fc.sess {
        result.unwrap(moq.fetch(mut cs, mut fc.io, 10, clone(ftr), loc(0, 0), loc(10, 0), 10, Ascending, None))
    } else {
        fail("missing fc")
    }
    settle_pair(mut fc, mut fs, 11)
    let fsid = first_fetch_id(fs.events)
    if let Some(mut ss) = fs.sess {
        moq.accept(mut ss, mut fs.io, fsid, Ok(()))
    }
    settle_pair(mut fc, mut fs, 12)
    let moq.RequestId(raw_fid) = freq
    let fsc = first_quic_conn(fs.raw)
    let fst = result.unwrap(quic.open(mut fs.io.driver.q, fsc, false))
    let mut fwire: Bytes = list.new()
    result.unwrap(codec.write_fetch_header(raw_fid, mut fwire))
    let mut fwr = codec.fetch_state(Ascending)
    result.unwrap(codec.write_fetch_entry(FetchedObject(codec.FetchObject(location: loc(1, 0), subgroup: Some(0), priority: 10, properties: list.new(), length: 0xffffffffffffffff)), mut fwr, mut fwire))
    let _ = result.unwrap(quic.write(mut fs.io.driver.q, fsc, fst, fwire, false))
    settle_pair(mut fc, mut fs, 13)
    let _ = quic.write(mut fs.io.driver.q, fsc, fst, b"\x00", false)
    settle_pair(mut fc, mut fs, 14)
    if !has_closed(fc.events, moq.ERR_FIELD_LENGTH_EXCEEDED) {
        fail("fetch length 2^64 - 1 did not close session with FIELD_LENGTH_EXCEEDED")
    }
    // 3. Descending FETCH answered with EndOfRange at 2^64 - 1 then 2^64 - 2: no overflow.
    let mut dc = native_client(2301)
    let mut ds = native_server(2302, lim)
    establish_native(mut dc, mut ds, lim, b"sec.test", b"/fetch-desc", None)
    let dtr = track(ns1(b"p01"), b"desc")
    let dreq = if let Some(mut cs) = dc.sess {
        result.unwrap(moq.fetch(mut cs, mut dc.io, 10, clone(dtr), loc(0, 0), loc(0xffffffffffffffff, 0xffffffffffffffff), 10, Descending, None))
    } else {
        fail("missing dc")
    }
    settle_pair(mut dc, mut ds, 11)
    let dsid = first_fetch_id(ds.events)
    if let Some(mut ss) = ds.sess {
        moq.accept(mut ss, mut ds.io, dsid, Ok(()))
    }
    settle_pair(mut dc, mut ds, 12)
    let moq.RequestId(raw_did) = dreq
    let dsc = first_quic_conn(ds.raw)
    let dst = result.unwrap(quic.open(mut ds.io.driver.q, dsc, false))
    let mut dwire: Bytes = list.new()
    result.unwrap(codec.write_fetch_header(raw_did, mut dwire))
    let mut dwr = codec.fetch_state(Descending)
    result.unwrap(codec.write_fetch_entry(EndOfRange(kind: UnknownRange, end: loc(0xffffffffffffffff, 0)), mut dwr, mut dwire))
    result.unwrap(codec.write_fetch_entry(EndOfRange(kind: UnknownRange, end: loc(0xfffffffffffffffe, 0)), mut dwr, mut dwire))
    let _ = result.unwrap(quic.write(mut ds.io.driver.q, dsc, dst, dwire, true))
    settle_pair(mut dc, mut ds, 13)
    if let Some(cs) = dc.sess {
        if moq.is_closed(cs) {
            fail("descending fetch at group 2^64 - 1 closed session")
        }
    }
    let mut unknown_n = 0u64
    for ev in dc.events {
        if let Unknown(track: ut, ..) = ev {
            if ut == dtr {
                unknown_n += 1
            }
        }
    }
    if unknown_n != 2 {
        fail("descending fetch did not deliver both EndOfRange Unknown events")
    }
    Ok(())
}

fn moq_room_left(most: u64) -> u64 {
    let mut lo = 0u64
    let mut hi = most
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        let mut l: Bytes = list.new()
        if let Ok(_) = list.try_reserve(mut l, mid) {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    lo
}

/// bug: a receiver accepts an object length past Limits.object_bytes or reserves the peer-declared
/// payload length before any payload byte arrives, exhausting the relay task's memory budget, or
/// fails to grow on demand to receive a legitimate object above 64 KiB within object_bytes.
/// oracle: MOQ-7 and MOQ-9: a header declaring object_bytes + 1 closes the session with
/// FIELD_LENGTH_EXCEEDED without rising reserved bytes; a header declaring object_bytes with zero
/// payload bytes does not pre-reserve object_bytes; a 70 KiB object within object_bytes delivers.
@test
fn object_bytes_and_no_preread_reserve() -> Result[(), ()] {
    // 1. Subgroup header declaring object_bytes + 1 is refused and reserved bytes do not rise.
    let lim_a = moq.Limits(requests: 16, tracks: 16, control_bytes: 65535, object_bytes: 262144, filter_ranges: 8, max_early_streams: 4, max_timeout_ms: 5000, max_buffered: 8388608)
    let mut ca = native_client(2501)
    let mut sa = native_server(2502, lim_a)
    establish_native(mut ca, mut sa, lim_a, b"sec.test", b"/p1-1a", None)
    let tr_a = track(ns1(b"p11"), b"over")
    let _ = if let Some(mut cs) = ca.sess {
        result.unwrap(moq.subscribe(mut cs, mut ca.io, 10, clone(tr_a), NoFilter, 10, None))
    } else {
        fail("missing ca")
    }
    settle_pair(mut ca, mut sa, 11)
    let sub_a = first_subscribe_id(sa.events)
    if let Some(mut ss) = sa.sess {
        moq.accept(mut ss, mut sa.io, sub_a, Ok(()))
    }
    settle_pair(mut ca, mut sa, 12)
    let sac = first_quic_conn(sa.raw)
    let sast = result.unwrap(quic.open(mut sa.io.driver.q, sac, false))
    let sh_a = codec.SubgroupHeader(alias: 0, group: 1, subgroup: ZeroSubgroup, priority: Some(10), properties: false, end_of_group: false, first_object: true)
    let mut wire_a: Bytes = list.new()
    result.unwrap(codec.write_subgroup_header(sh_a, mut wire_a))
    result.unwrap(codec.write_subgroup_object(codec.SubgroupObject(id: 0, properties: list.new(), length: lim_a.object_bytes + 1, status: Normal), sh_a, None, mut wire_a))
    let most = 4194304u64
    let Ok(drop_a) = (bound bytes most {
        let before = moq_room_left(most)
        let _ = result.unwrap(quic.write(mut sa.io.driver.q, sac, sast, wire_a, false))
        settle_pair(mut ca, mut sa, 13)
        let after = moq_room_left(most)
        int.saturating_sub(before, after)
    }) else {
        fail("bound scope failed during object_bytes + 1 refusal")
    }
    if !has_closed(ca.events, moq.ERR_FIELD_LENGTH_EXCEEDED) {
        fail("header declaring object_bytes + 1 did not close session with FIELD_LENGTH_EXCEEDED")
    }
    if drop_a >= 65536 {
        fail("refused object_bytes + 1 header raised reserved memory")
    }
    // 2. Subgroup and fetch headers declaring 1 MiB (<= object_bytes) with 0 payload bytes
    //    do NOT pre-reserve 1 MiB before payload bytes arrive.
    let lim_b = moq.Limits(requests: 16, tracks: 16, control_bytes: 65535, object_bytes: 1048576, filter_ranges: 8, max_early_streams: 4, max_timeout_ms: 5000, max_buffered: 8388608)
    let mut cb = native_client(2601)
    let mut sb = native_server(2602, lim_b)
    establish_native(mut cb, mut sb, lim_b, b"sec.test", b"/p1-1b", None)
    let tr_b = track(ns1(b"p11"), b"nores")
    let _ = if let Some(mut cs) = cb.sess {
        result.unwrap(moq.subscribe(mut cs, mut cb.io, 10, clone(tr_b), NoFilter, 10, None))
    } else {
        fail("missing cb")
    }
    let freq_b = if let Some(mut cs) = cb.sess {
        result.unwrap(moq.fetch(mut cs, mut cb.io, 10, clone(tr_b), loc(0, 0), loc(10, 0), 10, Ascending, None))
    } else {
        fail("missing cb fetch")
    }
    settle_pair(mut cb, mut sb, 11)
    let sub_b = first_subscribe_id(sb.events)
    let fid_b = first_fetch_id(sb.events)
    if let Some(mut ss) = sb.sess {
        moq.accept(mut ss, mut sb.io, sub_b, Ok(()))
        moq.accept(mut ss, mut sb.io, fid_b, Ok(()))
    }
    settle_pair(mut cb, mut sb, 12)
    let sbc = first_quic_conn(sb.raw)
    let sg_st = result.unwrap(quic.open(mut sb.io.driver.q, sbc, false))
    let sh_b = codec.SubgroupHeader(alias: 0, group: 1, subgroup: ZeroSubgroup, priority: Some(10), properties: false, end_of_group: false, first_object: true)
    let mut wire_sg: Bytes = list.new()
    result.unwrap(codec.write_subgroup_header(sh_b, mut wire_sg))
    result.unwrap(codec.write_subgroup_object(codec.SubgroupObject(id: 0, properties: list.new(), length: lim_b.object_bytes, status: Normal), sh_b, None, mut wire_sg))
    let moq.RequestId(raw_fb) = freq_b
    let ft_st = result.unwrap(quic.open(mut sb.io.driver.q, sbc, false))
    let mut wire_ft: Bytes = list.new()
    result.unwrap(codec.write_fetch_header(raw_fb, mut wire_ft))
    let mut wr_fb = codec.fetch_state(Ascending)
    result.unwrap(codec.write_fetch_entry(FetchedObject(codec.FetchObject(location: loc(1, 0), subgroup: Some(0), priority: 10, properties: list.new(), length: lim_b.object_bytes)), mut wr_fb, mut wire_ft))
    let Ok(drop_b) = (bound bytes most {
        let before = moq_room_left(most)
        let _ = result.unwrap(quic.write(mut sb.io.driver.q, sbc, sg_st, wire_sg, false))
        let _ = result.unwrap(quic.write(mut sb.io.driver.q, sbc, ft_st, wire_ft, false))
        settle_pair(mut cb, mut sb, 13)
        let after = moq_room_left(most)
        int.saturating_sub(before, after)
    }) else {
        fail("bound scope failed during 1 MiB header-only check")
    }
    if let Some(cs) = cb.sess {
        if moq.is_closed(cs) {
            fail("valid header within object_bytes closed session")
        }
    }
    if drop_b >= 131072 {
        fail("receiver pre-reserved peer-declared object length before payload bytes arrived")
    }
    // 3. A legitimate 70 KiB object within object_bytes grows on demand and delivers intact.
    let lim_c = moq.Limits(requests: 16, tracks: 16, control_bytes: 65535, object_bytes: 131072, filter_ranges: 8, max_early_streams: 4, max_timeout_ms: 5000, max_buffered: 8388608)
    let mut cc = native_client(2701)
    let mut sc = native_server(2702, lim_c)
    establish_native(mut cc, mut sc, lim_c, b"sec.test", b"/p1-1c", None)
    let tr_c = track(ns1(b"p11"), b"big")
    let _ = if let Some(mut cs) = cc.sess {
        result.unwrap(moq.subscribe(mut cs, mut cc.io, 10, clone(tr_c), NoFilter, 10, None))
    } else {
        fail("missing cc")
    }
    settle_pair(mut cc, mut sc, 11)
    let sub_c = first_subscribe_id(sc.events)
    if let Some(mut ss) = sc.sess {
        moq.accept(mut ss, mut sc.io, sub_c, Ok(()))
    }
    settle_pair(mut cc, mut sc, 12)
    let mut big: Bytes = list.with_capacity(70000)
    list.fill(mut big, 70000, 0x5au8)
    if let Some(mut ss) = sc.sess {
        result.unwrap(moq.publish(mut ss, mut sc.io, 13, make_obj(clone(tr_c), 1, 0, 0, Subgroup, 10, take big)))
    }
    for step in 0u64 .. 40 {
        let t = 14 + step * 10 * MS_NS
        let mut qev_c: List[quic.Event] = list.new()
        quic.timeout(mut cc.io.driver.q, t, mut qev_c)
        let mut qev_s: List[quic.Event] = list.new()
        quic.timeout(mut sc.io.driver.q, t, mut qev_s)
        settle_pair(mut cc, mut sc, t)
        if list.len(received_objects(cc.events)) >= 1 {
            break
        }
    }
    let got_c = received_objects(cc.events)
    if list.len(got_c) != 1 || quic.payload_len(got_c[0].payload) != 70000 {
        fail("70 KiB object within object_bytes did not deliver intact")
    }
    Ok(())
}

fn ingress_room() -> u64 {
    match (bound bytes 0xffffffffffffffffu64 {
        ()
    }) {
        Error(c) => c.available,
        Ok(()) => fail("payer admitted an unbounded reservation"),
    }
}

fn cancellable_decode(take started: Sender[()]) {
    let _ = isolate(fn() {
        result.unwrap(channel.try_send(started, ()))
        loop {
            task.check_cancel()
        }
    })
    fail("isolate returned after cancellation")
}

fn cancel_ingress(tasks: Tasks) waits {
    let (tx, rx): (Sender[()], Receiver[()]) = channel.new(1)
    let h = task.spawn(tasks, bytes 4096, take tx, cancellable_decode)
    result.unwrap(channel.receive(rx))
    if let Error(Cancelled(causes)) = std.task.cancel_join(take h) {
        for cause in causes {
            if let Cancelled = cause.kind {
                return
            }
            break
        }
    }
    fail("decoder cancellation did not reach the joiner")
}

fn deliver_ingress_request(mut client: Peer, mut server: Peer, n: u64) {
    let name = if n == 1 {
        b"one"
    } else {
        b"two"
    }
    let tr = track(ns1(b"peer"), clone(name))
    let t = 10 * n
    let _ = peer_subscribe(mut client, t, tr, NoFilter, 10, None)
    settle_pair(mut client, mut server, t + 1)
    if peer_accept_subscribes(mut server) != 1 {
        fail("expected one peer request")
    }
    settle_pair(mut client, mut server, t + 2)
    peer_publish(mut server, t + 3, make_obj(clone(tr), n, 0, 0, Subgroup, 10, clone(name)), true)
    settle_pair(mut client, mut server, t + 4)
    let objects = received_objects(client.events)
    if list.len(client.events) != n || list.len(objects) != n {
        fail("wrong delivered object count")
    }
    let o = objects[n - 1]
    if o.track != tr || o.group != n || o.subgroup != 0 || o.id != 0 || o.mode != Subgroup || o.publisher_priority != 10 || o.status != Normal || o.properties != b"" || quic.payload_bytes(o.payload) != name {
        fail("peer received different subgroup data")
    }
}

type IngressSnapshot: key {
    events: u64,
    requests: u64,
    subscriptions: u64,
    available: u64
}

fn ingress_snapshot(p: Peer) -> IngressSnapshot {
    let Some(s) = view p.sess else {
        fail("missing peer session")
    }
    if !moq.is_established(s) {
        fail("live session closed")
    }
    IngressSnapshot(events: list.len(p.events), requests: moq.active_requests(s), subscriptions: moq.active_subscriptions(s), available: ingress_room())
}

fn peer_schedule(tasks: Tasks, row: moq.IngressRow) -> (IngressSnapshot, IngressSnapshot) waits {
    let expected_site = moq.ingress_overflow_site()
    let mut client = native_client(3376)
    let mut server = native_server(3377, moq_limits())
    establish_native(mut client, mut server, moq_limits(), b"example.com", b"/peer", None)
    list.clear(mut client.events)
    deliver_ingress_request(mut client, mut server, 1)
    let before = ingress_room()
    match row {
        BOnly => {},
        CancelDecode => cancel_ingress(tasks),
        _ => moq.ingress_fixture(mut client.io, moq_limits(), row, expected_site),
    }
    if ingress_room() != before {
        fail("A changed the live peer payer at quiescence")
    }
    let first = ingress_snapshot(client)
    deliver_ingress_request(mut client, mut server, 2)
    (first, ingress_snapshot(client))
}

/// bug: a header decode runs without admission, or its failure interrupts an unrelated subscriber.
/// oracle: FAIL-16 admits before invocation and refunds on cleanup. Compare B's deliveries,
/// committed subscriptions and payer after A settles and after B's next completed request.
@test
fn two_sessions_preserve_peer(tasks: Tasks) -> Result[(), ()] waits {
    let control = result.unwrap(bound bytes 33554432 {
        peer_schedule(tasks, BOnly)
    })
    let rows: Inline[moq.IngressRow, 7] =[BadType, ShortFin, NoCell, CountedNoCell, Checked, NoSteps, CancelDecode]
    for row in rows {
        let actual = result.unwrap(bound bytes 33554432 {
            peer_schedule(tasks, row)
        })
        if actual != control {
            fail("B events, committed requests, subscriptions or available bytes differ from the control")
        }
    }
    Ok(())
}

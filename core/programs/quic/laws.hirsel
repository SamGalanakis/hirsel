fn varint_vector(wire: Bytes, canonical: Bytes, expected: u64) {
    let mut at = 0u64
    if result.unwrap(codec.read_varint(wire, mut at, list.len(wire))) != expected || at != list.len(wire) {
        fail("RFC 9000 varint decode")
    }
    let mut out: Bytes = list.new()
    result.unwrap(codec.write_varint(expected, mut out))
    if out != canonical {
        fail("RFC 9000 varint encode")
    }
}

/// bug: Decode a legal varint or an authenticated packet-number window incorrectly.
/// oracle: RFC 9000 §16 and Appendix A.1/A.3, plus hand-derived width and window edges.
@test
fn varint_and_packet_number_vectors() -> Result[(), ()] {
    varint_vector(b"\xc2\x19\x7c\x5e\xff\x14\xe8\x8c", b"\xc2\x19\x7c\x5e\xff\x14\xe8\x8c", 151288809941952652)
    varint_vector(b"\x9d\x7f\x3e\x7d", b"\x9d\x7f\x3e\x7d", 494878333)
    varint_vector(b"\x7b\xbd", b"\x7b\xbd", 15293)
    varint_vector(b"\x25", b"\x25", 37)
    varint_vector(b"\x40\x25", b"\x25", 37)
    varint_vector(b"\x80\x00\x00\x25", b"\x25", 37)
    varint_vector(b"\xc0\x00\x00\x00\x00\x00\x00\x25", b"\x25", 37)
    varint_vector(b"\x3f", b"\x3f", 63)
    varint_vector(b"\x40\x40", b"\x40\x40", 64)
    varint_vector(b"\x7f\xff", b"\x7f\xff", 16383)
    varint_vector(b"\x80\x00\x40\x00", b"\x80\x00\x40\x00", 16384)
    varint_vector(b"\xbf\xff\xff\xff", b"\xbf\xff\xff\xff", 1073741823)
    varint_vector(b"\xc0\x00\x00\x00\x40\x00\x00\x00", b"\xc0\x00\x00\x00\x40\x00\x00\x00", 1073741824)
    varint_vector(b"\xff\xff\xff\xff\xff\xff\xff\xff", b"\xff\xff\xff\xff\xff\xff\xff\xff", 0x3fffffffffffffff)
    let mut at = 1u64
    if let Error(Truncated) = codec.read_varint(b"\x00\x40\x25", mut at, 2) {} else {
        fail("varint read beyond its bound")
    }
    if at != 1 {
        fail("truncated varint advanced the cursor")
    }
    let mut out = b"a"
    if let Error(VarintOverflow) = codec.write_varint(0x4000000000000000, mut out) {} else {
        fail("varint accepted 2^62")
    }
    if out != b"a" {
        fail("unrepresentable varint changed output")
    }
    pn(Some(0xa82f30ea), 0x9b32, 2, 0xa82f9b32)
    pn(None, 255, 1, 255)
    pn(Some(0xff), 0x80, 1, 0x180)
    pn(Some(0x17f), 0, 1, 0x200)
    pn(Some(0x11f), 0xf0, 1, 0xf0)
    pn(Some(0x01fffffe), 0, 3, 0x02000000)
    pn(Some(0x1fffffff0), 0x10, 4, 0x200000010)
    pn(Some(0x3fffffffffffffff), 0xff, 1, 0x3fffffffffffffff)
    if let Error(PacketNumber) = codec.decode_packet_number(Some(0x3fffffffffffffff), 0, 1) {} else {
        fail("decoded a packet number past 2^62 - 1")
    }
    if let Error(PacketNumber) = codec.decode_packet_number(None, 256, 1) {} else {
        fail("accepted a nine-bit truncated packet number as eight bits")
    }
    check_headers()
    Ok(())
}

fn pn(largest: Option[u64], low: u64, size: u8, expected: u64) {
    if result.unwrap(codec.decode_packet_number(largest, low, size)) != expected {
        fail("RFC 9000 A.3 packet number")
    }
}

fn span(at: u64, len: u64) -> codec.Span {
    codec.Span(at: at, len: len)
}

fn check_headers() {
    // An Initial and Handshake with a 20-byte protected body apiece, and a short
    // packet last. The receive window starts one byte into the backing buffer.
    let initial = b"\xc1\x00\x00\x00\x01\x01\xaa\x02\xbb\xcc\x02\xde\xad\x14\x12\x34"
    let handshake = b"\xe0\x00\x00\x00\x01\x01\xaa\x00\x14\x07"
    let short = b"\x65\xaa\xde\xad"
    let cipher18 = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11"
    let mut packet = b"x"
    list.append(mut packet, initial)
    list.append(mut packet, cipher18)
    list.append(mut packet, handshake)
    list.append(mut packet, cipher18)
    list.push(mut packet, 0x12)
    list.append(mut packet, short)
    list.append(mut packet, cipher18)
    list.push(mut packet, 0xff)
    let mut at = 1u64
    let first = result.unwrap(codec.read_header(packet, mut at, 86, 1))
    if first.kind != Initial || first.version != 1 || first.packet != span(1, 34) || first.destination != span(7, 1) || first.source != span(9, 2) || first.token != span(12, 2) || first.body != span(15, 20) || at != 35 {
        fail("Initial bounds and CIDs")
    }
    if result.unwrap(codec.sample(first)) != span(19, 16) {
        fail("Initial sample bounds")
    }
    let opened = result.unwrap(codec.read_open_header(packet, first))
    if opened.number != codec.Number(truncated: 0x1234, size: 2) || opened.aad != span(1, 16) || opened.payload != span(17, 18) {
        fail("Initial number and associated data")
    }
    let second = result.unwrap(codec.read_coalesced_header(packet, mut at, 86, 1, first.destination))
    if second.kind != Handshake || second.packet != span(35, 29) || second.body != span(44, 20) || at != 64 {
        fail("coalesced Handshake boundary")
    }
    let last = result.unwrap(codec.read_coalesced_header(packet, mut at, 86, 1, first.destination))
    let short_open = result.unwrap(codec.read_open_header(packet, last))
    if last.kind != OneRtt || last.packet != span(64, 22) || last.body != span(66, 20) || at != 86 || !short_open.spin || !short_open.key_phase || short_open.number != codec.Number(truncated: 0xdead, size: 2) {
        fail("short header consumes the datagram tail")
    }
    let mut out: Bytes = list.new()
    result.unwrap(codec.write_long_header(Initial, b"\xaa", b"\xbb\xcc", b"\xde\xad", codec.Number(truncated: 0x1234, size: 2), 18, mut out))
    if out != initial {
        fail("Initial encoding")
    }
    list.truncate(mut out, 0)
    result.unwrap(codec.write_long_header(Handshake, b"\xaa", b"", b"", codec.Number(truncated: 7, size: 1), 19, mut out))
    if out != handshake {
        fail("Handshake encoding")
    }
    list.truncate(mut out, 0)
    result.unwrap(codec.write_long_header(ZeroRtt, b"", b"", b"", codec.Number(truncated: 0x01020304, size: 4), 16, mut out))
    if out != b"\xd3\x00\x00\x00\x01\x00\x00\x14\x01\x02\x03\x04" {
        fail("0-RTT encoding")
    }
    list.truncate(mut out, 0)
    result.unwrap(codec.write_short_header(b"\xaa", true, true, codec.Number(truncated: 0xdead, size: 2), mut out))
    if out != short {
        fail("short header encoding")
    }
    packet[41] = 0xbb
    at = 35
    if let Error(CoalescedDestination) = codec.read_coalesced_header(packet, mut at, 86, 1, first.destination) {} else {
        fail("coalesced packet accepted another destination CID")
    }
    if at != 64 || result.unwrap(codec.read_coalesced_header(packet, mut at, 86, 1, first.destination)).kind != OneRtt {
        fail("mismatched CID hid the following coalesced packet")
    }
    check_unnumbered()
}

fn check_unnumbered() {
    let retry = b"\xf0\x00\x00\x00\x01\x01\xaa\x01\xbbtt0123456789abcdef"
    let mut at = 0u64
    let h = result.unwrap(codec.read_header(retry, mut at, 27, 1))
    if h.kind != Retry || h.destination != span(6, 1) || h.source != span(8, 1) || h.token != span(9, 2) || h.body != span(11, 16) || at != 27 {
        fail("Retry token and integrity tag")
    }
    let mut out: Bytes = list.new()
    result.unwrap(codec.write_retry_prefix(b"\xaa", b"\xbb", b"tt", mut out))
    if out != b"\xf0\x00\x00\x00\x01\x01\xaa\x01\xbbtt" {
        fail("Retry prefix encoding")
    }
    let vn = b"\x80\x00\x00\x00\x00\x01\xbb\x01\xaa\x00\x00\x00\x01\x6b\x33\x43\xcf"
    at = 0
    let v = result.unwrap(codec.read_header(vn, mut at, 17, 1))
    if v.kind != Negotiation || v.version != 0 || v.body != span(9, 8) || at != 17 {
        fail("Version Negotiation ignores the Unused bits")
    }
    list.truncate(mut out, 0)
    let mut versions: List[u32] = list.new()
    list.push(mut versions, 1)
    list.push(mut versions, 0x6b3343cf)
    result.unwrap(codec.write_negotiation(b"\xbb", b"\xaa", versions, mut out))
    if out != b"\xc0\x00\x00\x00\x00\x01\xbb\x01\xaa\x00\x00\x00\x01\x6b\x33\x43\xcf" {
        fail("Version Negotiation encoding")
    }
}

fn expect_frame(wire: Bytes, expected: codec.Frame) {
    let mut r = result.unwrap(codec.frames(wire, span(0, list.len(wire)), OneRtt, 1200))
    let Some(take found) = result.unwrap(codec.next_frame(wire, mut r)) else {
        fail("missing frame")
    }
    if found != expected || result.unwrap(codec.next_frame(wire, mut r)) != None {
        fail("decoded frame fields or length")
    }
    let mut out: Bytes = list.new()
    result.unwrap(codec.write_frame(expected, wire, mut out))
    if out != wire {
        fail("frame encoding differs from hand-derived bytes")
    }
}

fn check_frames() {
    expect_frame(b"\x00\x00\x00", Padding(3))
    expect_frame(b"\x01", Ping)
    let mut ranges: List[codec.AckRange] = list.new()
    list.push(mut ranges, codec.AckRange(smallest: 8, largest: 10))
    list.push(mut ranges, codec.AckRange(smallest: 4, largest: 5))
    expect_frame(b"\x02\x0a\x01\x01\x02\x01\x01", Ack(codec.AckFields(delay: 1, ranges: clone(ranges), ecn: None)))
    expect_frame(b"\x03\x0a\x01\x01\x02\x01\x01\x02\x03\x04", Ack(codec.AckFields(delay: 1, ranges: take ranges, ecn: Some(codec.EcnCounts(ect0: 2, ect1: 3, ce: 4)))))
    expect_frame(b"\x04\x07\x08\x09", ResetStream(stream: 7, code: 8, final_size: 9))
    expect_frame(b"\x05\x07\x08", StopSending(stream: 7, code: 8))
    expect_frame(b"\x06\x08\x02hi", Crypto(offset: 8, data: span(3, 2)))
    expect_frame(b"\x07\x02hi", NewToken(span(2, 2)))
    expect_frame(b"\x08\x05hi", Stream(stream: 5, offset: 0, fin: false, explicit_len: false, data: span(2, 2)))
    expect_frame(b"\x09\x05hi", Stream(stream: 5, offset: 0, fin: true, explicit_len: false, data: span(2, 2)))
    expect_frame(b"\x0a\x05\x02hi", Stream(stream: 5, offset: 0, fin: false, explicit_len: true, data: span(3, 2)))
    expect_frame(b"\x0b\x05\x02hi", Stream(stream: 5, offset: 0, fin: true, explicit_len: true, data: span(3, 2)))
    expect_frame(b"\x0c\x05\x03hi", Stream(stream: 5, offset: 3, fin: false, explicit_len: false, data: span(3, 2)))
    expect_frame(b"\x0d\x05\x03hi", Stream(stream: 5, offset: 3, fin: true, explicit_len: false, data: span(3, 2)))
    expect_frame(b"\x0e\x05\x03\x02hi", Stream(stream: 5, offset: 3, fin: false, explicit_len: true, data: span(4, 2)))
    expect_frame(b"\x0f\x05\x03\x02hi", Stream(stream: 5, offset: 3, fin: true, explicit_len: true, data: span(4, 2)))
    expect_frame(b"\x10\x40\x40", MaxData(64))
    expect_frame(b"\x11\x05\x12", MaxStreamData(stream: 5, limit: 18))
    expect_frame(b"\x12\x12", MaxStreams(bidi: true, limit: 18))
    expect_frame(b"\x13\x13", MaxStreams(bidi: false, limit: 19))
    expect_frame(b"\x14\x13", DataBlocked(19))
    expect_frame(b"\x15\x05\x13", StreamDataBlocked(stream: 5, limit: 19))
    expect_frame(b"\x16\x14", StreamsBlocked(bidi: true, limit: 20))
    expect_frame(b"\x17\x15", StreamsBlocked(bidi: false, limit: 21))
    expect_frame(b"\x18\x03\x01\x02AB0123456789abcdef", NewConnectionId(sequence: 3, retire_prior_to: 1, id: span(4, 2), reset_token: span(6, 16)))
    expect_frame(b"\x19\x02", RetireConnectionId(2))
    expect_frame(b"\x1a01234567", PathChallenge(span(1, 8)))
    expect_frame(b"\x1b76543210", PathResponse(span(1, 8)))
    expect_frame(b"\x1c\x0a\x0f\x02hi", TransportClose(code: 10, frame_type: 15, reason: span(4, 2)))
    expect_frame(b"\x1d\x10\x02hi", ApplicationClose(code: 16, reason: span(3, 2)))
    expect_frame(b"\x1e", HandshakeDone)
    expect_frame(b"\x24\x04\x08\x0a\x09", ResetStreamAt(stream: 4, code: 8, final_size: 10, reliable_size: 9))
    expect_frame(b"\x30hi", Datagram(explicit_len: false, data: span(1, 2)))
    expect_frame(b"\x31\x02hi", Datagram(explicit_len: true, data: span(2, 2)))
    // Non-minimal scalar varints are legal. The declared frame boundary excludes the
    // prefix and trailer of the backing buffer, and explicit LEN leaves a following Ping.
    let group = b"\xff\x10\x40\x25\x31\x00\x01\xff"
    let mut r = result.unwrap(codec.frames(group, span(1, 6), OneRtt, 2))
    if result.unwrap(codec.next_frame(group, mut r)) != Some(MaxData(37)) || result.unwrap(codec.next_frame(group, mut r)) != Some(Datagram(explicit_len: true, data: span(6, 0))) || result.unwrap(codec.next_frame(group, mut r)) != Some(Ping) || result.unwrap(codec.next_frame(group, mut r)) != None {
        fail("legal non-minimal field or coalesced frame boundary")
    }
}

fn wrong_level(wire: Bytes, kind: codec.PacketKind, t: u64, max_datagram_frame: u64) {
    let mut r = result.unwrap(codec.frames(wire, span(0, list.len(wire)), kind, max_datagram_frame))
    if let Error(ProtocolViolation(found)) = codec.next_frame(wire, mut r) {
        if found == t {
            return
        }
    }
    fail("expected PROTOCOL_VIOLATION for frame")
}

fn bad_frame(wire: Bytes, t: u64) {
    let mut r = result.unwrap(codec.frames(wire, span(0, list.len(wire)), OneRtt, 1200))
    if let Error(FrameEncodingError(found)) = codec.next_frame(wire, mut r) {
        if found == t {
            return
        }
    }
    fail("expected FRAME_ENCODING_ERROR for frame")
}

/// bug: Accept forbidden, malformed or out-of-bounds QUIC wire forms.
/// oracle: RFC 9000 §§12.4, 17 and 19, RFC 9001 §5.4.2, RFC 9221 §3,
/// and draft-ietf-quic-reliable-stream-reset-11 §4.
@test
fn frame_refusals() -> Result[(), ()] {
    check_frames()
    for (wire, t) in[(b"\x02\x00\x00\x00\x00", 2u64), (b"\x03\x00\x00\x00\x00\x00\x00\x00", 3u64), (b"\x06\x00\x00", 6u64)] {
        wrong_level(wire, ZeroRtt, t, 1200)
    }
    for (wire, t) in[(b"\x07\x01t", 7u64), (b"\x1b01234567", 27u64), (b"\x1e", 30u64)] {
        wrong_level(wire, Initial, t, 1200)
        wrong_level(wire, Handshake, t, 1200)
        wrong_level(wire, ZeroRtt, t, 1200)
    }
    for (wire, t) in[
        (b"\x04\x00\x00\x00", 4u64),
        (b"\x05\x00\x00", 5u64),
        (b"\x08\x00", 8u64),
        (b"\x09\x00", 9u64),
        (b"\x0a\x00\x00", 10u64),
        (b"\x0b\x00\x00", 11u64),
        (b"\x0c\x00\x00", 12u64),
        (b"\x0d\x00\x00", 13u64),
        (b"\x0e\x00\x00\x00", 14u64),
        (b"\x0f\x00\x00\x00", 15u64),
        (b"\x10\x00", 16u64),
        (b"\x11\x00\x00", 17u64),
        (b"\x12\x00", 18u64),
        (b"\x13\x00", 19u64),
        (b"\x14\x00", 20u64),
        (b"\x15\x00\x00", 21u64),
        (b"\x16\x00", 22u64),
        (b"\x17\x00", 23u64),
        (b"\x18\x00\x00\x01x0123456789abcdef", 24u64),
        (b"\x19\x00", 25u64),
        (b"\x1a01234567", 26u64),
        (b"\x1d\x00\x00", 29u64),
        (b"\x24\x00\x00\x02\x01", 36u64),
        (b"\x30a", 48u64),
        (b"\x31\x01a", 49u64),
    ] {
        wrong_level(wire, Initial, t, 1200)
        wrong_level(wire, Handshake, t, 1200)
    }
    wrong_level(b"\x30a", OneRtt, 0x30, 0)
    wrong_level(b"\x31\x01a", OneRtt, 0x31, 0)
    wrong_level(b"\x31\x01a", OneRtt, 0x31, 2)
    bad_frame(b"\x40\x01", 1)
    bad_frame(b"\x80\x00\x00\x01", 1)
    bad_frame(b"\xc0\x00\x00\x00\x00\x00\x00\x01", 1)
    bad_frame(b"\x40", 0)
    bad_frame(b"\x40\x40", 64)
    bad_frame(b"\x02\x00\x00\x00\x01", 2)
    bad_frame(b"\x02\x02\x00\x01\x00\x01\x00", 2)
    bad_frame(b"\x02\x02\x00\x01\x00\x00\x01", 2)
    bad_frame(b"\x03\x00\x00\x00\x00\x00\x00", 3)
    bad_frame(b"\x06\x00\x02a", 6)
    bad_frame(b"\x07\x00", 7)
    bad_frame(b"\x0e\x00\xff\xff\xff\xff\xff\xff\xff\xff\x01a", 14)
    bad_frame(b"\x12\xd0\x00\x00\x00\x00\x00\x00\x01", 18)
    bad_frame(b"\x18\x00\x01\x01x0123456789abcdef", 24)
    bad_frame(b"\x18\x00\x00\x000123456789abcdef", 24)
    bad_frame(b"\x1aa", 26)
    bad_frame(b"\x24\x00\x00\x01\x02", 36)
    bad_frame(b"\x31\x02a", 49)
    if let Error(ProtocolViolation(0)) = codec.frames(b"", span(0, 0), OneRtt, 1200) {} else {
        fail("empty authenticated packet")
    }
    let mut out = b"x"
    if let Error(VarintOverflow) = codec.write_frame(MaxData(0x4000000000000000), b"", mut out) {} else {
        fail("unrepresentable frame scalar accepted")
    }
    if out != b"x" {
        fail("failed frame write left a partial frame")
    }
    header_refusals()
    Ok(())
}

fn quic_push_boundary_varint(mut src: std.prop.Source, rem: u64, mut out: Bytes) {
    match std.prop.below(mut src, 8) {
        0 => list.push(mut out, 0u8),
        1 => list.append(mut out, b"\xff\xff\xff\xff\xff\xff\xff\xff"),
        2 => {
            let v = order.min(rem + 1, codec.MAX_VARINT)
            let _ = codec.write_varint(v, mut out)
        },
        3 => {
            let v = order.min(rem, codec.MAX_VARINT)
            let _ = codec.write_varint(v, mut out)
        },
        4 => list.append(mut out, b"\x40\x00"),
        5 => list.append(mut out, b"\x80\x00\x00\x01"),
        _ => {
            let _ = codec.write_varint(std.prop.below(mut src, 64), mut out)
        },
    }
}

fn quic_wire_gen() -> std.prop.Gen[Bytes] {
    let mut arms: List[std.prop.Gen[Bytes]] = list.new()
    list.push(mut arms, std.prop.bytes_of(0, 256))
    // Biased QUIC frame payloads: valid frame type + boundary varints / lengths one past buffer.
    list.push(mut arms, std.prop.make(fn(mut src: std.prop.Source) -> Bytes {
        let mut out: Bytes = list.new()
        let ftype: u64 = match std.prop.below(mut src, 12) {
            0 => 0x00u64,
            1 => 0x01u64,
            2 => 0x02u64,
            3 => 0x06u64,
            4 => 0x08u64 + std.prop.below(mut src, 8),
            5 => 0x10u64 + std.prop.below(mut src, 10),
            6 => 0x1au64 + std.prop.below(mut src, 5),
            7 => 0x24u64,
            8 => 0x30u64 + std.prop.below(mut src, 2),
            _ => std.prop.below(mut src, 64),
        }
        let _ = codec.write_varint(ftype, mut out)
        let body_tail = std.prop.draw(mut src, std.prop.bytes_of(0, 48))
        let n_fields = std.prop.below(mut src, 4)
        for _ in 0u64 .. n_fields {
            quic_push_boundary_varint(mut src, list.len(body_tail), mut out)
        }
        list.append(mut out, body_tail)
        take out
    }, fn(b: Bytes, mut out: String) {
        string.push(mut out, "quic_frame_wire(len=")
        string.push_u64(mut out, list.len(b))
        string.push(mut out, ")")
    }))
    // Biased QUIC packet headers (long, short, Retry, Version Negotiation).
    list.push(mut arms, std.prop.make(fn(mut src: std.prop.Source) -> Bytes {
        let mut out: Bytes = list.new()
        let first: u8 = match std.prop.below(mut src, 6) {
            0 => 0xc0u8 | int.narrow(std.prop.below(mut src, 4)),
            1 => 0xd0u8 | int.narrow(std.prop.below(mut src, 4)),
            2 => 0xe0u8 | int.narrow(std.prop.below(mut src, 4)),
            3 => 0xf0u8,
            4 => 0x40u8 | int.narrow(std.prop.below(mut src, 4)),
            _ => int.narrow(std.prop.below(mut src, 256)),
        }
        list.push(mut out, first)
        let body_tail = std.prop.draw(mut src, std.prop.bytes_of(0, 64))
        if (first & 0x80u8) != 0 {
            let ver: u32 = match std.prop.below(mut src, 4) {
                0 => 0u32,
                1 => 1u32,
                2 => 2u32,
                _ => 1u32,
            }
            list.put_word_be(mut out, ver)
            let dlen: u8 = int.narrow(std.prop.below(mut src, 9))
            list.push(mut out, dlen)
            for _ in 0u64 .. int.widen(dlen) {
                list.push(mut out, 0x41u8)
            }
            let slen: u8 = int.narrow(std.prop.below(mut src, 9))
            list.push(mut out, slen)
            for _ in 0u64 .. int.widen(slen) {
                list.push(mut out, 0x42u8)
            }
            if ver == 1 && ((first >> 4) & 3) == 0 {
                quic_push_boundary_varint(mut src, 0, mut out)
            }
            if ver == 1 && ((first >> 4) & 3) != 3 {
                quic_push_boundary_varint(mut src, list.len(body_tail), mut out)
            }
        }
        list.append(mut out, body_tail)
        take out
    }, fn(b: Bytes, mut out: String) {
        string.push(mut out, "quic_header_wire(len=")
        string.push_u64(mut out, list.len(b))
        string.push(mut out, ")")
    }))
    std.prop.one_of(take arms)
}

fn quic_check_frame_reencode(wire: Bytes, start: u64, end: u64, kind: codec.PacketKind, max_dg: u64, f: codec.Frame) -> Result[(), String] {
    let consumed = list.slice(wire, start, end)
    let mut re: Bytes = list.with_capacity(list.len(consumed) + 16)
    if let Error(_) = codec.write_frame(f, wire, mut re) {
        return Error(string.from("write_frame refused decoded frame"))
    }
    if re == consumed {
        return Ok(())
    }
    // QUIC permits non-minimal scalar varints and STREAM with OFF=1, offset=0;
    // canonical re-encoding can only be strictly shorter, and must re-decode identically.
    if list.len(re) >= list.len(consumed) {
        return Error(string.from("re-encoded frame differed without shrinking non-minimal form"))
    }
    let mut r2 = match codec.frames(re, span(0, list.len(re)), kind, max_dg) {
        Ok(fr) => fr,
        Error(_) => return Error(string.from("re-encoded frame refused by frames()")),
    }
    let Ok(Some(f2)) = codec.next_frame(re, mut r2) else {
        return Error(string.from("re-encoded frame did not re-decode"))
    }
    if let Ok(None) = codec.next_frame(re, mut r2) {} else {
        return Error(string.from("re-encoded frame left trailing bytes"))
    }
    let mut re2: Bytes = list.with_capacity(list.len(re))
    if let Error(_) = codec.write_frame(f2, re, mut re2) {
        return Error(string.from("second write_frame failed"))
    }
    if re2 != re {
        return Error(string.from("canonical frame did not stabilize on re-encode"))
    }
    Ok(())
}

fn quic_total_law(pkt: Bytes) -> Result[(), String] {
    let len = list.len(pkt)
    // 1. Varint decode + canonical re-encode.
    let mut vat = 0u64
    if let Ok(v) = codec.read_varint(pkt, mut vat, len) {
        let mut vre: Bytes = list.with_capacity(8)
        let Ok(()) = codec.write_varint(v, mut vre) else {
            return Error(string.from("write_varint failed on decoded varint"))
        }
        if vat == codec.varint_len(v) && vre != list.slice(pkt, 0, vat) {
            return Error(string.from("minimal varint did not re-encode to consumed prefix"))
        }
    }
    // 2. Packet header decode + open header + re-encode.
    for short_len in[0u8, 4u8, 8u8, 20u8] {
        let mut at = 0u64
        let _ = codec.read_first_header(pkt, mut at, len, short_len, true)
        at = 0
        let _ = codec.read_first_header(pkt, mut at, len, short_len, false)
        at = 0
        if let Ok(h) = codec.read_header(pkt, mut at, len, short_len) {
            if h.packet.at != 0 || h.packet.len != at || at > len {
                return Error(string.from("read_header produced out-of-bounds packet span"))
            }
            let _ = codec.sample(h)
            let _ = codec.check_reserved_bits(h.kind, h.first)
            if at < len {
                let mut at2 = at
                let _ = codec.read_coalesced_header(pkt, mut at2, len, short_len, h.destination)
            }
            let dst = list.slice(pkt, h.destination.at, h.destination.at + h.destination.len)
            let src_id = list.slice(pkt, h.source.at, h.source.at + h.source.len)
            let tok = list.slice(pkt, h.token.at, h.token.at + h.token.len)
            let consumed = list.slice(pkt, 0, at)
            if let Ok(oh) = codec.read_open_header(pkt, h) {
                let mut re: Bytes = list.with_capacity(at + 16)
                let payload = list.slice(pkt, oh.payload.at, oh.payload.at + oh.payload.len)
                if h.kind == Initial || h.kind == ZeroRtt || h.kind == Handshake {
                    let Ok(()) = codec.write_long_header(h.kind, dst, src_id, tok, oh.number, oh.payload.len, mut re) else {
                        return Error(string.from("write_long_header failed on decoded header"))
                    }
                    list.append(mut re, payload)
                    if (h.first & 0x0cu8) == 0 && list.len(re) == at && re != consumed {
                        return Error(string.from("long header did not re-encode to consumed prefix"))
                    }
                } else if h.kind == OneRtt {
                    let Ok(()) = codec.write_short_header(dst, oh.spin, oh.key_phase, oh.number, mut re) else {
                        return Error(string.from("write_short_header failed on decoded header"))
                    }
                    list.append(mut re, payload)
                    if (h.first & 0x18u8) == 0 && re != consumed {
                        return Error(string.from("short header did not re-encode to consumed prefix"))
                    }
                }
            } else if h.kind == Retry {
                let mut re: Bytes = list.with_capacity(at)
                let Ok(()) = codec.write_retry_prefix(dst, src_id, tok, mut re) else {
                    return Error(string.from("write_retry_prefix failed on decoded Retry"))
                }
                list.append(mut re, list.slice(pkt, h.body.at, h.body.at + h.body.len))
                if (h.first & 0x0fu8) == 0 && re != consumed {
                    return Error(string.from("Retry header did not re-encode to consumed prefix"))
                }
            }
        }
    }
    // 3. Frame stream decode + re-encode across all numbered packet kinds.
    for kk in 0u64 .. 4 {
        let kind = total_kind(kk)
        let mut opened = codec.frames(pkt, span(0, len), kind, 1200)
        if let Ok(mut r) = opened {
            for _ in 0u64 .. 64 {
                match codec.next_frame(pkt, mut r) {
                    Ok(None) => break,
                    Ok(Some(f)) => {
                        // A decoded frame re-encodes to a canonical frame that decodes back and is stable.
                        let mut re: Bytes = list.with_capacity(len + 16)
                        if let Error(_) = codec.write_frame(f, pkt, mut re) {
                            return Error(string.from("write_frame refused decoded frame"))
                        }
                        let mut r2 = match codec.frames(re, span(0, list.len(re)), kind, 1200) {
                            Ok(fr) => fr,
                            Error(_) => return Error(string.from("re-encoded frame refused by frames()")),
                        }
                        let Ok(Some(f2)) = codec.next_frame(re, mut r2) else {
                            return Error(string.from("re-encoded frame did not re-decode"))
                        }
                        if let Ok(None) = codec.next_frame(re, mut r2) {} else {
                            return Error(string.from("re-encoded frame left trailing bytes"))
                        }
                        let mut re2: Bytes = list.with_capacity(list.len(re))
                        if let Error(_) = codec.write_frame(f2, re, mut re2) {
                            return Error(string.from("second write_frame failed"))
                        }
                        if re2 != re {
                            return Error(string.from("canonical frame did not stabilize on re-encode"))
                        }
                    },
                    Error(_) => break,
                }
            }
        }
    }
    // Single-frame exact prefix check from offset 0: if next_frame succeeds and then finishes at end,
    // verify re-encode against pkt[0..len].
    let mut opened0 = codec.frames(pkt, span(0, len), OneRtt, 1200)
    if let Ok(mut r0) = opened0 {
        if let Ok(Some(f0)) = codec.next_frame(pkt, mut r0) {
            if let Ok(None) = codec.next_frame(pkt, mut r0) {
                quic_check_frame_reencode(pkt, 0, len, OneRtt, 1200, f0)?
            }
        }
    }
    Ok(())
}

/// bug: Trap, overflow, slice past the packet end, or accept a QUIC header or frame that does not re-encode to the consumed wire prefix.
/// oracle: RFC 9000 §§16, 17, 19 and RFC 9221 wire encoders (independent of the decoders).
@test
fn quic_header_and_frame_totality_property() -> Result[(), ()] {
    let mut c = std.prop.config()
    c.cases = 160
    std.prop.check(c, quic_wire_gen(), quic_total_law)
}

fn header_refusals() {
    let mut initial = b"\xc0\x00\x00\x00\x01\x08abcdefgh\x00\x00\x44\x9d"
    for _ in 0u64 .. 1181u64 {
        list.push(mut initial, 0)
    }
    let mut at = 0u64
    if let Error(SmallInitial) = codec.read_first_header(initial, mut at, 1199, 0, true) {} else {
        fail("server accepted a 1199-byte Initial datagram")
    }
    initial[4] = 2
    at = 0
    if let Error(SmallUnsupportedVersion) = codec.read_first_header(initial, mut at, 1199, 0, true) {} else {
        fail("server accepted a 1199-byte datagram for Version Negotiation")
    }
    list.push(mut initial, 0)
    at = 0
    if result.unwrap(codec.read_first_header(initial, mut at, 1200, 0, true)).kind != OtherVersion {
        fail("server refused to negotiate an unsupported version at 1200 bytes")
    }
    at = 0
    let short = b"\x40abcd0123456789abcdef"
    let h = result.unwrap(codec.read_first_header(short, mut at, 21, 4, true))
    if let Error(SampleTooShort) = codec.sample(h) {} else {
        fail("short packet could reach header protection without a sample")
    }
    at = 0
    let coalesced = b"\xe0\x00\x00\x00\x01\x00\x00\x01\x00\x40abcdefghijklmnopqrst"
    let first = result.unwrap(codec.read_header(coalesced, mut at, 30, 0))
    if let Error(SampleTooShort) = codec.sample(first) {} else {
        fail("sample crossed into a following coalesced packet")
    }
    let last = result.unwrap(codec.read_header(coalesced, mut at, 30, 0))
    if last.kind != OneRtt || result.unwrap(codec.sample(last)) != span(14, 16) || at != 30 {
        fail("discarded packet hid the following coalesced packet")
    }
    at = 0
    let fixed = b"\xa0\x00\x00\x00\x01\x00\x00\x00\x40abcdefghijklmnopqrst"
    if let Error(FixedBit) = codec.read_header(fixed, mut at, 29, 0) {} else {
        fail("v1 header accepted a clear fixed bit")
    }
    if at != 8 || result.unwrap(codec.read_header(fixed, mut at, 29, 0)).kind != OneRtt {
        fail("bad fixed bit hid the following coalesced packet")
    }
    at = 0
    if let Error(DatagramTooShort) = codec.read_first_header(b"\x40", mut at, 1, 0, true) {} else {
        fail("datagram shorter than 21 bytes")
    }
    if let Error(Truncated) = codec.read_header(b"\xe0\x00\x00\x00\x01\x00\x00\x02a", mut at, 9, 0) {} else {
        fail("long packet length passed datagram end")
    }
    if let Error(VersionList) = codec.read_header(b"\xc0\x00\x00\x00\x00\x00\x00\x00", mut at, 8, 0) {} else {
        fail("partial Version Negotiation list")
    }
    at = 0
    if let Error(RetryToken) = codec.read_header(b"\xf0\x00\x00\x00\x01\x00\x000123456789abcdef", mut at, 23, 0) {} else {
        fail("Retry without a token")
    }
    if let Error(ReservedBits) = codec.check_reserved_bits(OneRtt, 0x48) {} else {
        fail("authenticated short-header reserved bits")
    }
}

fn wrap_handshake(mut client: quic.Endpoint, mut server: quic.Endpoint, from: Addr, start: u64) -> (Option[quic.ConnectionHandle], Option[quic.CloseReason]) {
    let mut now = start
    let mut at_server: List[quic.Event] = list.new()
    let mut at_client: List[quic.Event] = list.new()
    let mut server_handle: Option[quic.ConnectionHandle] = None
    let mut client_closed: Option[quic.CloseReason] = None
    for _ in 0u64 .. 16 {
        pipe(mut client, mut server, from, now, mut at_server)
        for ev in at_server {
            if let Connected(c: h, ..) = ev {
                server_handle = Some(h)
            }
        }
        list.clear(mut at_server)
        now += 1000000
        pipe(mut server, mut client, SERVER_ADDR, now, mut at_client)
        for ev in at_client {
            if let Closed(_, reason) = ev {
                client_closed = Some(reason)
            }
        }
        list.clear(mut at_client)
        now += 1000000
        let done_closed = match client_closed {
            Some(_) => true,
            None => false,
        }
        if server_handle != None || done_closed {
            break
        }
    }
    (server_handle, client_closed)
}

/// bug: connection handles are monotonically allocated up to 2^32 and never reused, so
/// after 2^32 accepted Initials the endpoint permanently answers every new Initial with
/// CONNECTION_REFUSED (0x02) even while live connections are below EndpointLimits.connections.
/// oracle: EndpointLimits (docs/spec/quic.md): the only connection-admission bound is the
/// number of live connections; handles wrap past 2^32 without colliding with still-live
/// handles, and connections are refused only when live == limits.connections.
@test
fn connection_handles_wrap_past_u32_limit() -> Result[(), ()] {
    let mut server = qs3_server(None)
    // Keep a long-lived connection on ConnectionHandle(0) while advancing next_handle
    // to 0xfffffffe (two below 2^32).
    let mut c0 = qs3_client()
    let _ = result.unwrap(quic.connect(mut c0, 0, SERVER_ADDR, "server", cert_pin(old_digest()), None, transport_config(None)))
    let (h0_opt, _) = wrap_handshake(mut c0, mut server, CLIENT_ADDR, 1000000)
    let Some(h0) = h0_opt else {
        fail("initial live connection did not establish")
    }
    if h0 != ConnectionHandle(0) || quic.live_connections(server) != 1 {
        fail("first server connection did not take handle 0")
    }
    quic.set_next_handle(mut server, 0xfffffffe)
    // Accept three more Initials crossing 2^32: 0xfffffffe, 0xffffffff, then wrapping
    // past 2^32 while skipping still-live ConnectionHandle(0) to assign ConnectionHandle(1).
    let mut c1 = qs3_client()
    let _ = result.unwrap(quic.connect(mut c1, 0, SERVER_ADDR, "server", cert_pin(old_digest()), None, transport_config(None)))
    let (h1_opt, _) = wrap_handshake(mut c1, mut server, CLIENT_ADDR, 50000000)
    let Some(h1) = h1_opt else {
        fail("connection at 0xfffffffe did not establish")
    }
    let mut c2 = qs3_client()
    let _ = result.unwrap(quic.connect(mut c2, 0, SERVER_ADDR, "server", cert_pin(old_digest()), None, transport_config(None)))
    let (h2_opt, _) = wrap_handshake(mut c2, mut server, CLIENT_ADDR, 100000000)
    let Some(h2) = h2_opt else {
        fail("connection at 0xffffffff did not establish")
    }
    let mut c3 = qs3_client()
    let _ = result.unwrap(quic.connect(mut c3, 0, SERVER_ADDR, "server", cert_pin(old_digest()), None, transport_config(None)))
    let (h3_opt, _) = wrap_handshake(mut c3, mut server, CLIENT_ADDR, 150000000)
    let Some(h3) = h3_opt else {
        fail("endpoint refused an Initial after 2^32 handles while live < limits.connections")
    }
    if h1 != ConnectionHandle(0xfffffffe) || h2 != ConnectionHandle(0xffffffff) || h3 != ConnectionHandle(1) {
        fail("wrapped handle collided with still-live handle 0 or chose wrong wrapped id")
    }
    if quic.live_connections(server) != 4 {
        fail("server does not hold all 4 live connections across handle wrap")
    }
    if let None = quic.peer_params(server, h0) {
        fail("live connection handle 0 lost after wraparound")
    }
    if let None = quic.peer_params(server, h3) {
        fail("wrapped connection handle lost after wraparound")
    }
    // At live == limits.connections (4), a 5th Initial must still be refused with
    // CONNECTION_REFUSED (0x02).
    let mut c4 = qs3_client()
    let _ = result.unwrap(quic.connect(mut c4, 0, SERVER_ADDR, "server", cert_pin(old_digest()), None, transport_config(None)))
    let (h4_opt, c4_closed) = wrap_handshake(mut c4, mut server, CLIENT_ADDR, 200000000)
    if h4_opt != None || quic.live_connections(server) != 4 {
        fail("server admitted past EndpointLimits.connections")
    }
    match c4_closed {
        Some(Transport(code: 0x02, ..)) => (),
        _ => fail("server did not answer limit exhaustion with CONNECTION_REFUSED (0x02)"),
    }
    // Once h0 idles out (live drops to 3), another post-wrap Initial is admitted cleanly.
    let mut at_server: List[quic.Event] = list.new()
    quic.timeout(mut server, 5040000000, mut at_server)
    if quic.live_connections(server) != 3 {
        fail("idle connection did not release its slot")
    }
    let mut c5 = qs3_client()
    let _ = result.unwrap(quic.connect(mut c5, 0, SERVER_ADDR, "server", cert_pin(old_digest()), None, transport_config(None)))
    let (h5_opt, _) = wrap_handshake(mut c5, mut server, CLIENT_ADDR, 5040000000)
    if h5_opt == None || quic.live_connections(server) != 4 {
        fail("server did not admit a new Initial after releasing a slot past 2^32 handles")
    }
    // Client-side connect() also wraps past 2^32 without returning Limit.
    let mut wrap_client = qs3_client()
    quic.set_next_handle(mut wrap_client, 0xffffffff)
    let a = result.unwrap(quic.connect(mut wrap_client, 0, SERVER_ADDR, "server", cert_pin(old_digest()), None, transport_config(None)))
    let b = result.unwrap(quic.connect(mut wrap_client, 0, SERVER_ADDR, "server", cert_pin(old_digest()), None, transport_config(None)))
    if a != ConnectionHandle(0xffffffff) || b != ConnectionHandle(0) {
        fail("client connect() did not wrap connection handle across 2^32")
    }
    Ok(())
}

fn total_kind(k: u64) -> codec.PacketKind {
    match k {
        0 => OneRtt,
        1 => Initial,
        2 => Handshake,
        _ => ZeroRtt,
    }
}

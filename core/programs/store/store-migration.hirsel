pub fn top_level_catalog(catalog: pages.PageTree) -> Result[pages.PageRange, types.Failure] {
    let mut upper: Bytes = list.new()
    list.push(mut upper, 2u8)
    pages.open_page_range(catalog, Some(table_key("")?), true, false, Some(types.copied(upper)?))
}

pub fn catalog_collection_name(key: Bytes, kind: u8) -> Result[String, types.Failure] {
    let start = if kind == 2u8 {
        5u64
    } else {
        1u64
    }
    Ok(string.from_utf8(types.copied(list.slice(key, start, list.len(key)))?) ?=> |_| pages.malformed(0u64))
}

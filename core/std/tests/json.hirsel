// test-vectors
// Contract tests for `json` (core/std/json.hirsel), written to run once an engine runs
// library bodies. Sizes come from the layout in the module header, by hand:
// a tag 1, a Text 4 + its bytes, a container 1 + 4 + 4 + its items + 4 per item, a member
// 4 + its key's bytes + its value.
fn size_of(s: String) -> u64 {
    match json.size(s) {
        Ok(n) => n,
        Error(_) => 999,
    }
}

fn syntax_at(s: String) -> u64 {
    match json.size(s) {
        Error(Syntax(i)) => i,
        _ => 999,
    }
}

fn not_finite_at(s: String) -> u64 {
    match json.size(s) {
        Error(NotFinite(i)) => i,
        _ => 999,
    }
}

// expect: run size_of_mixed() = 73
// 12 is 1 + 4 + 2 = 7; "ab" is 7; [true,30] is 9 + 1 + 7 + 8 = 25; [] is 9;
// the root is 9 + (7 + 7 + 25 + 9) + 16 = 73.
fn size_of_mixed() -> u64 {
    size_of("[12,\"ab\",[true,30],[]]")
}

// expect: run size_ignores_space() = 29
// 9 + (6 + 4) x 2: whitespace takes no bytes.
fn size_ignores_space() -> u64 {
    size_of(" [ 1 , 2 ] ")
}

// expect: run size_of_escapes() = 13
// Decoded: a 1, \n 1, U+00E9 2, the pair U+1F600 4: 8 bytes, and 5 + 8 = 13.
fn size_of_escapes() -> u64 {
    size_of("\"a\\n\\u00e9\\ud83d\\ude00\"")
}

// Sweep word and vector boundaries. A four-byte scalar can cross a boundary,
// followed by escaped newline and quote. Decoded bytes n+4+1+1 plus tag/header5.
// A control at n+1 must stop at that byte. Trailing whitespace keeps complete
// blocks available even when the marker is near their end.
// expect: run sizing_words_stop_at_special_bytes() = true
fn sizing_words_stop_at_special_bytes() -> bool {
    for n in 0u64 .. 80 {
        let mut plain = string.from("\"")
        let mut escaped = string.from("\"")
        let mut bad = string.from("\"")
        for _ in 0u64 .. n {
            string.push(mut plain, " ")
            string.push(mut escaped, "x")
            string.push(mut bad, "x")
        }
        string.push(mut plain, "\"                                ")
        string.push(mut escaped, "🙂\\n\\\"\"                                ")
        string.push(mut bad, "\u{1f}\"                                ")
        if size_of(plain) != n + 5 || size_of(escaped) != n + 11 || syntax_at(bad) != n + 1 {
            return false
        }
    }
    true
}

// expect: run size_keeps_duplicates() = 39
// Both members stay in the blob: 9 + 2 x (4 + 1 + 6 + 4).
fn size_keeps_duplicates() -> u64 {
    size_of("{\"a\":1,\"a\":2}")
}

// expect: run size_of_scalars() = 1
fn size_of_scalars() -> u64 {
    size_of("null")
}

// expect: run size_of_negative() = 9
// The spelling "-2.5" is kept: 1 + 4 + 4.
fn size_of_negative() -> u64 {
    size_of("-2.5")
}

// expect: run size_of_empty_object() = 9
fn size_of_empty_object() -> u64 {
    size_of("{ }")
}

// expect: run trailing_comma() = 3
// After "1," the ']' at 3 is where a value must start.
fn trailing_comma() -> u64 {
    syntax_at("[1,]")
}

// expect: run infinite_number() = 1
fn infinite_number() -> u64 {
    not_finite_at("[1e999]")
}

// expect: run leading_zero() = 1
fn leading_zero() -> u64 {
    syntax_at("01")
}

// The boundary scan may skip digit words, but float.parse64 still checks the whole
// token. "0." +n zeros +"125" has n+5 spelling bytes, so its Num takes n+10.
// x is trailing syntax; e999 overflows even after24 fractional zeros. A delimiter
// mistaken for a digit, or a scanner that skips grammar/range validation, is red.
// expect: run number_words_keep_grammar_and_range() = true
fn number_words_keep_grammar_and_range() -> bool {
    for n in 0u64 .. 24 {
        let mut s = string.from("0.")
        for _ in 0u64 .. n {
            string.push(mut s, "0")
        }
        string.push(mut s, "125")
        if size_of(s) != n + 10 {
            return false
        }
        let mut bad = string.from(s)
        string.push(mut bad, "x")
        if syntax_at(bad) != n + 5 {
            return false
        }
        string.push(mut s, "e999")
        if not_finite_at(s) != 0 {
            return false
        }
    }
    // Array: 9 header +10 and13 Num bytes +8 offset bytes =40. Skipping a
    // non-digit word would swallow the comma or close instead of ending a token.
    size_of("[0.125,12345678]") == 40 && not_finite_at("[12345678e999x,0]") == 1 && size_of("-12345678.125e+2") == 21 && syntax_at("12345678+1") == 8 && syntax_at("000000000000000000001") == 1
}

// expect: run lone_low_surrogate() = 1
fn lone_low_surrogate() -> u64 {
    syntax_at("\"\\udc00\"")
}

// expect: run high_surrogate_alone() = 7
// "\ud800 is bytes 0 to 6; byte 7 should start the low half.
fn high_surrogate_alone() -> u64 {
    syntax_at("\"\\ud800x\"")
}

// expect: run unterminated_string() = 3
fn unterminated_string() -> u64 {
    syntax_at("\"ab")
}

// expect: run empty_input() = 0
fn empty_input() -> u64 {
    syntax_at("")
}

// expect: run trailing_bytes() = 2
fn trailing_bytes() -> u64 {
    syntax_at("1 x")
}

// expect: run unknown_escape() = 2
fn unknown_escape() -> u64 {
    syntax_at("\"\\x\"")
}

// expect: run truncated_literal() = 0
fn truncated_literal() -> u64 {
    syntax_at("nul")
}

// First-byte dispatch must still validate the whole keyword. Each literal takes one
// tag byte, so [null,true,false] is 9 +3 tags +3 offsets of4 =24. An unknown UTF-8
// head is Syntax at its first byte, without slicing through a later scalar.
// A mutant accepting any n/t/f head breaks nxll/truX; probing keywords before their
// first-byte branch breaks the unknown non-ASCII head instead of returning Syntax.
// expect: run keyword_dispatch_and_bad_heads() = true
fn keyword_dispatch_and_bad_heads() -> bool {
    size_of("[null,true,false]") == 24 && syntax_at("nxll") == 0 && syntax_at("truX") == 0 && syntax_at("falsX") == 0 && syntax_at("n") == 0 && syntax_at("tru") == 0 && syntax_at("fals") == 0 && syntax_at("truex") == 4 && syntax_at("1x") == 1 && not_finite_at("1e999x") == 0 && syntax_at("€€") == 0 && syntax_at(" [€€]") == 2
}

// JSON keywords are ASCII byte sequences. A malformed UTF-8-containing token is
// Syntax at its start, even when a four/five-byte candidate ends inside a scalar.
// A String-slice prefix probe faults instead; accepting just n/t/f also fails these.
// expect: run literal_keywords_compare_bytes() = true
fn literal_keywords_compare_bytes() -> bool {
    syntax_at("nu€") == 0 && syntax_at("tr€") == 0 && syntax_at("fal€") == 0 && syntax_at("n🙂") == 0 && syntax_at("[tr€]") == 1 && syntax_at("falset") == 5 && size_of("null") == 1 && size_of("true") == 1 && size_of("false") == 1
}

/// Whether v is a number spelled w.
fn spelled(v: json.Json, w: String) -> bool {
    match v {
        Num(t) => text.as_string(t) == w,
        _ => false,
    }
}

// expect: run parse_reads_items() = 42
// 4 items; item 1 is a Str of 2 bytes; item 3 is an empty Arr: 4 x 10 + 2.
fn parse_reads_items() -> u64 {
    region r {
        match result.unwrap(json.parse(r, "[12,\"ab\",[true,30],[]]")) {
            Arr(xs) => {
                let n = seq.len(xs) * 10
                let b = match indexed.get(xs, 1) {
                    Some(Str(t)) => text.len(t),
                    _ => 0,
                }
                let e = match indexed.get(xs, 3) {
                    Some(Arr(ys)) => seq.len(ys),
                    _ => 99,
                }
                n + b + e
            }
            _ => 0,
        }
    }
}

// expect: run lookup_takes_last() = true
// In {"b":1,"a":2,"b":3}, b is 3 (the last value), a is 2, and c is absent.
fn lookup_takes_last() -> bool {
    region r {
        match result.unwrap(json.parse(r, "{\"b\":1,\"a\":2,\"b\":3}")) {
            Obj(ms) => {
                let x = json.index(ms)
                let b = match json.get(x, "b") {
                    Some(v) => spelled(v, "3"),
                    None => false,
                }
                let a = match json.get(x, "a") {
                    Some(v) => spelled(v, "2"),
                    None => false,
                }
                let c = match json.get(x, "c") {
                    Some(_) => false,
                    None => true,
                }
                let single = match (json.find(ms, "b"), json.find(ms, "a"), json.find(ms, "c")) {
                    (Some(last), Some(only), None) => spelled(last, "3") && spelled(only, "2"),
                    _ => false,
                }
                b && a && c && single
            }
            _ => false,
        }
    }
}

// expect: run render_keeps_first_position() = true
// In {"b":1,"a":2,"b":3}: member 0 shows b with 3, member 1 shows a with 2, member 2 is
// hidden (b was shown at 0), and 3 is past the end.
fn render_keeps_first_position() -> bool {
    region r {
        match result.unwrap(json.parse(r, "{\"b\":1,\"a\":2,\"b\":3}")) {
            Obj(ms) => {
                let x = json.index(ms)
                let first = match json.shown(x, 0) {
                    Some((k, v)) => k == "b" && spelled(v, "3"),
                    None => false,
                }
                let second = match json.shown(x, 1) {
                    Some((k, v)) => k == "a" && spelled(v, "2"),
                    None => false,
                }
                let third = match json.shown(x, 2) {
                    Some(_) => false,
                    None => true,
                }
                let past = match json.shown(x, 3) {
                    Some(_) => false,
                    None => true,
                }
                first && second && third && past
            }
            _ => false,
        }
    }
}

// expect: run equal_keys_order_by_ordinal() = true
// Three equal keys: the lookup gives the last (3); render shows the first position only.
fn equal_keys_order_by_ordinal() -> bool {
    region r {
        match result.unwrap(json.parse(r, "{\"k\":1,\"k\":2,\"k\":3}")) {
            Obj(ms) => {
                let x = json.index(ms)
                let last = match json.get(x, "k") {
                    Some(v) => spelled(v, "3"),
                    None => false,
                }
                let shown_once = match (json.shown(x, 0), json.shown(x, 1), json.shown(x, 2)) {
                    (Some((_, v)), None, None) => spelled(v, "3"),
                    _ => false,
                }
                last && shown_once
            }
            _ => false,
        }
    }
}

// RFC 8259: remove insignificant whitespace; keep number spelling and duplicates.
// A comma-before-first or deduplicating printer changes this hand-written text.
// expect: run print_nested_round_trip() = true
fn print_nested_round_trip() -> bool {
    region r {
        let doc = result.unwrap(json.parse(r, " {\"b\": [null, false, true, -0.50e+2], \"b\":{}, \"a\": []} "))
        let mut out = string.from("prefix:")
        let _ = json.push_json(mut out, doc)
        let expected = "{\"b\":[null,false,true,-0.50e+2],\"b\":{},\"a\":[]}"
        let again = result.unwrap(json.parse(r, string.slice(out, 7, string.byte_len(out))))
        let mut second = string.new()
        let _ = json.push_json(mut second, again)
        string.slice(out, 7, string.byte_len(out)) == expected && second == expected
    }
}

// The short escapes, two hex escapes, quote, backslash, slash and UTF-8 runs.
// Omitting the escaping branch produces either different or invalid JSON.
// expect: run print_escapes_round_trip() = true
fn print_escapes_round_trip() -> bool {
    region r {
        let doc = result.unwrap(json.parse(r, "{\"\\u0000\\u001f\":\"é\\b\\t\\n\\f\\r\\\"\\\\/😀\"}"))
        let mut out = string.new()
        let _ = json.push_json(mut out, doc)
        let expected = "{\"\\u0000\\u001f\":\"é\\b\\t\\n\\f\\r\\\"\\\\/😀\"}"
        let again = result.unwrap(json.parse(r, out))
        let mut second = string.new()
        let _ = json.push_json(mut second, again)
        out == expected && second == expected
    }
}

// expect: run parse_admission_order() = true
fn parse_admission_order() -> bool {
    let out = isolate(fn() -> Result[bool, Capacity] {
        bound bytes 0 {
            region r {
                let bad = match json.parse(r, "[1,]") {
                    Error(Syntax(3)) => true,
                    _ => false
                }
                let bad_key = match json.parse_tree("{\"abcdef\\q\":0}", fn() -> Result[(), json.Error] {
                    Ok(())
                }, fn(take node: json.TreeValue[()]) {
                    drop(take node)
                }, fn(take e: json.Error) -> json.Error {
                    take e
                }) {
                    Error(Syntax(9)) => true,
                    _ => false
                }
                if bad && bad_key {
                    let _ = json.parse(r, "null")
                }
                false
            }
        }
    })
    match caught(take out) {
        Some(c) => c.requested == 8 && c.available == 0,
        None => false,
    }
}

// Two exact one-tag blobs remain charged and readable; the third raises Capacity.
// expect: run parse_retains_admitted_prefix() = true
fn parse_retains_admitted_prefix() -> bool {
    let out = isolate(fn() -> Result[bool, Capacity] {
        bound bytes 16 {
            region r {
                let a = result.unwrap(json.parse(r, "null"))
                let b = result.unwrap(json.parse(r, "true"))
                let readable = match (a, b) {
                    (Null, True) => true,
                    _ => false
                }
                if readable {
                    let _ = json.parse(r, "false")
                }
                false
            }
        }
    })
    match caught(take out) {
        Some(c) => c.requested == 8 && c.available == 0,
        None => false,
    }
}

// Output GROWTH starts at capacity4, rounded charge8. At limit8, quote+a+\n
// fills it and the next run is refused. At limit16, quote+abc fills it; reserving the
// whole six-byte hex escape requests16 with8 left. A printer that appends a hex escape
// piecemeal requests 8 first and fails this law.
// expect: run print_capacity_prefixes() = true
fn printed(src: String, limit: u64, requested: u64, available: u64) -> bool {
    let out = isolate(fn() -> Result[u64, Capacity] {
        region r {
            let x = result.unwrap(json.parse(r, src))
            bound bytes limit {
                let mut s = string.new()
                json.push_json(mut s, x)
                string.byte_len(s)
            }
        }
    })
    match caught(take out) {
        Some(c) => c.requested == requested && c.available == available,
        None => false,
    }
}

fn print_capacity_prefixes() -> bool {
    printed("\"a\\nb\"", 0, 8, 0) && printed("\"a\\nb\"", 8, 8, 0) && printed("\"abc\\u0000\"", 16, 16, 8)
}

fn read_named_values(s: String, mut cursor: json.Cursor) -> Result[List[f64], json.Error] {
    json.record_of(s, mut cursor, list.new(), fn(key: String, input: String, mut c: json.Cursor, mut values: List[f64]) -> Result[(), json.Error] {
        if key == "xy" {
            values = json.list_of(input, mut c, json.read_f64)?
        } else {
            json.skip_value(input, mut c)?
        }
        Ok(())
    })
}

fn decode_refuses(s: String) -> bool {
    match json.decode(s, read_named_values) {
        Error(Syntax(_)) => true,
        _ => false,
    }
}

// RFC 8259 member names are decoded first. Skipped fields and trailing bytes
// still obey JSON grammar. A raw-key lookup or unchecked skip fails this case.
// expect: run typed_record_decode() = true
fn typed_record_decode() -> bool {
    let source = " {\"unused\":[false,{\"a\":null}],\"x\u{005c}u0079\":[-2.5,3e1]} "
    let values = result.unwrap(json.decode(source, read_named_values))
    list.len(values) == 2 && float.to_bits64(values[0]) == float.to_bits64(-2.5) && float.to_bits64(values[1]) == float.to_bits64(30.0) && decode_refuses("{\"xy\":[],\"unused\":[true,]}") && decode_refuses("{\"xy\":[false]}") && decode_refuses("{\"xy\":[]}{}")
}

type JsonTestExpectation = AcceptJson | RefuseJson | RefuseJsonSyntax | RefuseJsonNumber

fn json_test_case(s: String, expected: JsonTestExpectation) -> bool {
    region r {
        match (json.parse(r, s), expected) {
            (Ok(_), AcceptJson) => true,
            (Error(Syntax(_)), RefuseJson) => true,
            (Error(Syntax(_)), RefuseJsonSyntax) => true,
            (Error(NotFinite(_)), RefuseJson) => true,
            (Error(NotFinite(_)), RefuseJsonNumber) => true,
            _ => false,
        }
    }
}

fn decode_json_fixture(hex: String) -> Bytes {
    let n = string.byte_len(hex)
    let mut input: Bytes = list.with_capacity(n / 2)
    for i in 0u64 .. n / 2 {
        let byte: u8 = int.narrow(result.unwrap(int.parse_uint(string.slice(hex, 2 * i, 2 * i + 2), 16)))
        list.push(mut input, byte)
    }
    take input
}

// Source and implementation-defined choices are in vectors/json/README.md.
// expect: run json_test_suite() = true
fn json_test_suite() -> bool {
    let data = json_test_suite_data()
    let mut at: u64 = 0
    while at < string.byte_len(data) {
        let end = option.unwrap(string.find(data, at, "\n"))
        let Some((name, hex)) = string.split_once(string.slice(data, at + 1, end), " ") else {
            return false
        }
        let tag = string.as_bytes(data)[at]
        let passed = match string.from_utf8(decode_json_fixture(hex)) {
            Ok(s) => match tag {
                b'A' => json_test_case(s, AcceptJson),
                b'R' => json_test_case(s, RefuseJson),
                b'S' => json_test_case(s, RefuseJsonSyntax),
                b'N' => json_test_case(s, RefuseJsonNumber),
                _ => false,
            },
            Error(_) => tag == b'U',
        }
        if !passed {
            fail(string.from(name))
        }
        at = end + 1
    }
    true
}

// Source: serde_json tests/test.rs, f51fa15a7015c7d02817a46d2db44c899a0016e8, MIT.
// expect: run serde_json_numbers() = true
fn serde_json_numbers() -> bool {
    let valid: Inline[(String, u64), 10] =[("-0", 0x8000000000000000), ("-0.0", 0x8000000000000000), ("-0e2", 0x8000000000000000), ("-0.0e2", 0x8000000000000000), ("-1e-400", 0x8000000000000000), ("-1e-4000000000000000000000000000000000000000000000000", 0x8000000000000000), ("-9223372036854775808", 0xc3e0000000000000), ("9223372036854775807", 0x43e0000000000000), ("18446744073709551615", 0x43f0000000000000), ("2.638344616030823e-256", 0xadfb11e2adb03c3),]
    for row in valid {
        let (input, bits) = row
        match json.decode(input, json.read_f64) {
            Ok(n) => if float.to_bits64(n) != bits {
                fail(string.from(input))
            },
            Error(_) => fail(string.from(input)),
        }
    }
    let invalid: Inline[(String, JsonTestExpectation), 9] =[("00", RefuseJsonSyntax), ("0x80", RefuseJsonSyntax), (".0", RefuseJsonSyntax), ("1.e1", RefuseJsonSyntax), ("1e", RefuseJsonSyntax), ("1e+", RefuseJsonSyntax), ("1a", RefuseJsonSyntax), ("100e777777777777777777777777777", RefuseJsonNumber), ("-100e777777777777777777777777777", RefuseJsonNumber),]
    for row in invalid {
        let (input, expected) = row
        if !json_test_case(input, expected) {
            fail(string.from(input))
        }
    }
    true
}

fn nested_json_input(unit: String, count: u64, tail: String) -> String {
    let mut input = string.repeat(unit, count)
    string.push(mut input, tail)
    take input
}

fn refuses_depth_before_admission(input: String) -> bool {
    region r {
        result.unwrap(bound bytes 0 {
            match json.parse(r, input) {
                Error(Depth) => true,
                _ => false,
            }
        })
    }
}

// expect: run json_test_suite_nesting() = true
fn json_test_suite_nesting() -> bool {
    for row in json_test_suite_deep_data() {
        let (name, unit, count, tail) = row
        if !refuses_depth_before_admission(nested_json_input(unit, count, tail)) {
            fail(string.from(name))
        }
    }
    true
}

// expect: run json_nesting_128() = true
fn json_nesting_128() -> bool {
    let input = nested_json_input("[", 128, string.repeat("]", 128))
    // The innermost empty array takes 9 bytes. Each of the other arrays
    // adds a 9-byte header and one 4-byte offset.
    let Ok(1660u64) = json.size(input) else {
        return false
    }
    region r {
        match json.parse(r, input) {
            Ok(Arr(xs)) => seq.len(xs) == 1,
            _ => false,
        }
    }
}

// expect: run json_nesting_129() = true
fn json_nesting_129() -> bool {
    let closing = string.repeat("]", 129)
    refuses_depth_before_admission(nested_json_input("[", 129, closing))
}

type ProfileSum: codec = Empty | Single(char) | Multiple(u8, bool)

type ProfileRow: codec {
    unit: (),
    flag: bool,
    scalar: char,
    a8: u8,
    a16: u16,
    a32: u32,
    a64: u64,
    b8: i8,
    b16: i16,
    b32: i32,
    b64: i64,
    narrow: f32,
    wide: f64,
    label: String,
    payload: Bytes,
    series: List[u16],
    lookup: Map[u64, String],
    maybe: Option[String],
    outcome: Result[(), bool],
    choice: ProfileSum
}

fn typed_input(s: String) -> Bytes {
    string.into_bytes(string.from(s))
}

fn profile_encode[T](f: json.Format[T], v: T) -> String {
    let mut scratch: Bytes = list.new()
    let mut output: Bytes = list.new()
    let mut declared: u64 = 0
    let measured = result.unwrap(json.encode_typed(f, v, mut scratch, scoped fn(n: u64) {
        declared = n
    }, scoped fn(byte: u8) {
        list.push(mut output, byte)
    }))
    if measured != declared || measured != list.len(output) {
        fail("typed JSON length differs from bytes written")
    }
    result.unwrap(string.from_utf8(take output))
}

fn profile_law[T: codec](f: json.Format[T], v: T, alternative: String, canonical: String) -> bool {
    let c: codec.Codec[T] = codec.of()
    let mut expected: Bytes = list.new()
    result.unwrap(codec.encode(c, v, mut expected))
    let actual = profile_encode(f, v)
    if actual != canonical {
        return false
    }
    let round_trip = result.unwrap(json.decode_typed(f, typed_input(actual), 65536))
    let mut round_trip_bytes: Bytes = list.new()
    result.unwrap(codec.encode(c, round_trip, mut round_trip_bytes))
    let parsed = result.unwrap(json.decode_typed(f, typed_input(alternative), 65536))
    round_trip_bytes == expected && profile_encode(f, parsed) == canonical
}

// B-4's canonical spellings, including declaration order, padded Bytes,
// insertion order, float width, explicit None, and the multi-field sum.
// expect: run typed_json_profile_round_trips() = true
fn typed_json_profile_round_trips() -> bool {
    let mut lookup: Map[u64, String] = map.new()
    map.insert(mut lookup, 10u64, string.from("ten"))
    map.insert(mut lookup, 2u64, string.from("two"))
    let mut payload: Bytes = list.new()
    codec.put_u8(77, mut payload)
    let mut series: List[u16] = list.new()
    list.push(mut series, 2u16)
    list.push(mut series, 0u16)
    let value = ProfileRow(unit: (), flag: true, scalar: '😀', a8: 255, a16: 65535, a32: 4294967295, a64: 18446744073709551615, b8: -128, b16: -32768, b32: -2147483648, b64: -9223372036854775808, narrow: 1.0000001, wide: float.from_bits64(0x8000000000000000), label: string.from("é\n/\"\\\u{001f}"), payload: take payload, series: take series, lookup: take lookup, maybe: None, outcome: Ok(()), choice: Multiple(7, false))
    let alternative = " { \"choice\": {\"Multiple\": [7,false]}, \"outcome\": {\"ok\":null}, \"lookup\":[[\"10\",\"ten\"],[\"2\",\"two\"]], \"series\":[2,0], \"payload\":\"TQ==\", \"label\":\"é\\n\\/\\\"\\\\\\u001f\", \"wide\":-0.0e4, \"narrow\":1.0000000596046448, \"b64\":\"-9223372036854775808\", \"b32\":-2147483648, \"b16\":-32768, \"b8\":-128, \"a64\":\"18446744073709551615\", \"a32\":4294967295, \"a16\":65535, \"a8\":255, \"scalar\":\"\\uD83D\\uDE00\", \"flag\":true, \"unit\":null } "
    let canonical = "{\"unit\":null,\"flag\":true,\"scalar\":\"😀\",\"a8\":255,\"a16\":65535,\"a32\":4294967295,\"a64\":\"18446744073709551615\",\"b8\":-128,\"b16\":-32768,\"b32\":-2147483648,\"b64\":\"-9223372036854775808\",\"narrow\":1.0000001,\"wide\":-0,\"label\":\"é\\u000A/\\\"\\\\\\u001F\",\"payload\":\"TQ==\",\"series\":[2,0],\"lookup\":[[\"10\",\"ten\"],[\"2\",\"two\"]],\"maybe\":null,\"outcome\":{\"ok\":null},\"choice\":{\"Multiple\":[7,false]}}"
    let f: json.Format[ProfileRow] = result.unwrap(json.typed())
    profile_law(f, value, alternative, canonical)
}

type ProfileAlternates: codec {
    empty: ProfileSum,
    single: ProfileSum,
    present: Option[u8],
    failed: Result[bool, ()],
    low: f64,
    fixed: f64,
    high: f64,
    nan: f32,
    inf: f64,
    neg_inf: f32
}

// B-4's other variant/option forms and the Number::toString exponent edges.
// expect: run typed_json_profile_variants_and_floats() = true
fn typed_json_profile_variants_and_floats() -> bool {
    let value = ProfileAlternates(empty: Empty, single: Single('x'), present: Some(9), failed: Error(()), low: 1e-7, fixed: 1e-6, high: 1e21, nan: float.from_bits32(0x7fc00000), inf: float.from_bits64(0x7ff0000000000000), neg_inf: float.from_bits32(0xff800000))
    let alternative = "{\"empty\":\"\\u0045mpty\",\"single\":{\"Single\":\"\\u0078\"},\"present\":9,\"failed\":{\"error\":null},\"low\":0.0000001,\"fixed\":1E-06,\"high\":1000000000000000000000,\"nan\":\"NaN\",\"inf\":\"Infinity\",\"neg_inf\":\"-Infinity\"}"
    let canonical = "{\"empty\":\"Empty\",\"single\":{\"Single\":\"x\"},\"present\":9,\"failed\":{\"error\":null},\"low\":1e-7,\"fixed\":0.000001,\"high\":1e+21,\"nan\":\"NaN\",\"inf\":\"Infinity\",\"neg_inf\":\"-Infinity\"}"
    let f: json.Format[ProfileAlternates] = result.unwrap(json.typed())
    profile_law(f, value, alternative, canonical)
}

type ProfileBad: codec {
    wide: u64,
    payload: Bytes,
    label: String,
    real: f64
}

type ProfileDepth: codec = Stop | Next(List[ProfileDepth])

// B-4. Escaped duplicates, unfamiliar members and bad scalars must be
// refused before a codec can consume their bytes. Offsets are UTF-8 bytes.
// expect: run typed_json_profile_refusals() = true
fn typed_json_profile_refusals() -> bool {
    let f: json.Format[ProfileBad] = result.unwrap(json.typed())
    let duplicate = match json.decode_typed(f, typed_input("{\"wide\":\"1\",\"\\u0077ide\":\"2\"}"), 65536) {
        Error(Input(12, path, DuplicateMember)) => path == "/wide",
        _ => false,
    }
    let unknown = match json.decode_typed(f, typed_input("{\"extra\":null}"), 65536) {
        Error(Input(1, path, UnknownMember)) => path == "/extra",
        _ => false,
    }
    let bare = match json.decode_typed(f, typed_input("{\"wide\":1}"), 65536) {
        Error(Input(8, path, ExpectedValue)) => path == "/wide",
        _ => false,
    }
    let padding = match json.decode_typed(f, typed_input("{\"payload\":\"TR==\"}"), 65536) {
        Error(Input(11, path, InvalidBase64)) => path == "/payload",
        _ => false,
    }
    let surrogate = match json.decode_typed(f, typed_input("{\"label\":\"\\uD800\"}"), 65536) {
        Error(Input(_, path, ExpectedValue)) => path == "/label",
        _ => false,
    }
    let overflow = match json.decode_typed(f, typed_input("{\"real\":1.7976931348623159e308}"), 65536) {
        Error(Input(8, path, InvalidNumber)) => path == "/real",
        _ => false,
    }
    let f_deep: json.Format[ProfileDepth] = result.unwrap(json.typed())
    let mut deep = string.repeat("{\"Next\":[", 33)
    string.push(mut deep, "\"Stop\"")
    string.push(mut deep, string.repeat("]}", 33))
    let depth = match json.decode_typed(f_deep, typed_input(deep), 1048576) {
        Error(Input(288, _, DepthLimit)) => true,
        _ => false,
    }
    let c: codec.Codec[ProfileDepth] = codec.of()
    let mut nested: ProfileDepth = Stop
    for _ in 0u64 .. 32 {
        let mut items: List[ProfileDepth] = list.new()
        list.push(mut items, take nested)
        nested = Next(take items)
    }
    let mut wire_value: Bytes = list.new()
    result.unwrap(codec.encode(c, nested, mut wire_value))
    let good_depth = result.unwrap(json.typed_length(f_deep, wire_value)) == 358
    let mut items: List[ProfileDepth] = list.new()
    list.push(mut items, take nested)
    let mut starts: u64 = 0
    let bad_depth = match json.encode_typed(f_deep, Next(take items), mut wire_value, scoped fn(n: u64) {
        starts = n
    }, scoped fn(byte: u8) {
        if byte != 0 {
            fail("over-depth JSON sent a byte")
        }
    }) {
        Error(DepthLimit) => starts == 0,
        _ => false,
    }
    duplicate && unknown && bare && padding && surrogate && overflow && depth && good_depth && bad_depth
}

// The output starts with an existing byte, and é uses two bytes on the wire.
// An over-depth value may be measured but may never append bytes.
// expect: run typed_json_buffer_helpers() = true
fn typed_json_buffer_helpers() -> bool {
    let format: json.Format[String] = result.unwrap(json.typed())
    let text = "é\n"
    let mut out = typed_input("!")
    let mut scratch: Bytes = list.new()
    let n = result.unwrap(json.push_typed(format, text, mut out, mut scratch))
    let encoded = result.unwrap(json.to_string(format, text))
    let decoded = result.unwrap(json.from_string(format, " \"\\u00e9\\n\" ", 65536))
    let deep: json.Format[ProfileDepth] = result.unwrap(json.typed())
    let mut nested: ProfileDepth = Stop
    for _ in 0u64 .. 33 {
        let mut items: List[ProfileDepth] = list.new()
        list.push(mut items, take nested)
        nested = Next(take items)
    }
    let refused = match json.push_typed(deep, nested, mut out, mut scratch) {
        Error(DepthLimit) => true,
        _ => false,
    }
    let enter = isolate(fn() -> Result[bool, Capacity] {
        bound bytes 0 {
            match json.from_string(format, "\"é\"", 8) {
                Error(Capacity(_)) => true,
                _ => false,
            }
        }
    })
    let in_bound = isolate(fn() -> Result[bool, Capacity] {
        bound bytes 0 {
            let _ = json.from_string(format, "\"é\"", 0)
            false
        }
    })
    n == 10 && encoded == "\"é\\u000A\"" && decoded == text && refused && out == typed_input("!\"é\\u000A\"") && match (take enter, caught(take in_bound)) {
        (Ok(Ok(Ok(true))), Some(c)) => c.available == 0,
        _ => false,
    }
}

type InteropRecord: codec {
    a: Option[bool],
    b: Option[u64],
    c: Option[bool],
    d: Option[bool]
}

fn ignored_arrays(count: u64) -> String {
    let mut s = string.from("{\"x\":")
    string.push(mut s, string.repeat("[", count))
    string.push(mut s, "null")
    string.push(mut s, string.repeat("]", count))
    string.push(mut s, "}")
    take s
}

fn interop_ignored_members(format: json.Format[InteropRecord]) -> bool {
    let good = result.unwrap(json.from_string(format, ignored_arrays(63), 1048576))
    let boundary = match json.from_string(format, ignored_arrays(64), 1048576) {
        Error(Input(68, _, DepthLimit)) => true,
        _ => false,
    }
    let far = match json.from_string(format, ignored_arrays(129), 1048576) {
        Error(Input(68, _, DepthLimit)) => true,
        _ => false,
    }
    let escaped = match json.from_string(format, "{\"x\":1,\"\\u0078\":2}", 65536) {
        Error(Input(7, path, DuplicateMember)) => path == "/x",
        _ => false,
    }
    let literal = match json.from_string(format, "{\"x\":1,\"x\":2}", 65536) {
        Error(Input(7, path, DuplicateMember)) => path == "/x",
        _ => false,
    }
    let nested = match json.from_string(format, "{\"ignored\":{\"a\":1,\"\\u0061\":2}}", 65536) {
        Error(Input(18, path, DuplicateMember)) => path == "/ignored/a",
        _ => false,
    }
    let malformed = match json.from_string(format, "{\"x\":[true,]}", 65536) {
        Error(Input(11, path, ExpectedValue)) => path == "/x/1",
        _ => false,
    }
    result.unwrap(json.to_string(format, good)) == "{}" && boundary && far && escaped && literal && nested && malformed
}

fn interop_record_commas(format: json.Format[InteropRecord]) -> bool {
    let value = result.unwrap(json.from_string(format, "{\"d\":false,\"c\":null,\"b\":7,\"x\":{\"b\":true}}", 65536))
    result.unwrap(json.to_string(format, value)) == "{\"b\":7,\"d\":false}"
}

fn interop_numbers_and_maps() -> bool {
    let map_format: json.Format[Map[String, u64]] = result.unwrap(json.interop())
    let value = result.unwrap(json.from_string(map_format, "{\"z\":18446744073709551615,\"a\":0}", 65536))
    let encoded = result.unwrap(json.to_string(map_format, value))
    let decoded = match (map.get(value, "z"), map.get(value, "a")) {
        (Some(z), Some(a)) => z == 18446744073709551615 && a == 0,
        _ => false,
    }
    let duplicate = match json.from_string(map_format, "{\"a\":1,\"\\u0061\":2}", 65536) {
        Error(Input(7, path, DuplicateMember)) => path == "/a",
        _ => false,
    }
    let i64_format: json.Format[i64] = result.unwrap(json.interop())
    let minimum = result.unwrap(json.from_string(i64_format, "-9223372036854775808", 65536))
    let quoted = match json.from_string(i64_format, "\"1\"", 65536) {
        Error(Input(0, _, ExpectedValue)) => true,
        _ => false,
    }
    let too_big = match json.from_string(i64_format, "9223372036854775808", 65536) {
        Error(Input(0, _, InvalidNumber)) => true,
        _ => false,
    }
    let other_map: json.Format[Map[u8, bool]] = result.unwrap(json.interop())
    let pairs = result.unwrap(json.from_string(other_map, "[[4,true]]", 65536))
    encoded == "{\"z\":18446744073709551615,\"a\":0}" && decoded && duplicate && minimum == -9223372036854775808 && result.unwrap(json.to_string(i64_format, minimum)) == "-9223372036854775808" && quoted && too_big && result.unwrap(json.to_string(other_map, pairs)) == "[[4,true]]"
}

fn interop_closed() -> bool {
    let outcome: json.Format[Result[bool, ()]] = result.unwrap(json.interop())
    let extra = match json.from_string(outcome, "{\"ok\":true,\"x\":null}", 65536) {
        Error(Input(11, path, UnknownMember)) => path == "/x",
        _ => false,
    }
    let choice: json.Format[ProfileSum] = result.unwrap(json.interop())
    let invalid = match json.from_string(choice, "{\"Missing\":null}", 65536) {
        Error(Input(1, path, UnknownMember)) => path == "/Missing",
        _ => false,
    }
    let real: json.Format[f64] = result.unwrap(json.interop())
    let small: json.Format[f32] = result.unwrap(json.interop())
    let named = match json.from_string(real, "\"NaN\"", 65536) {
        Error(Input(0, _, ExpectedValue)) => true,
        _ => false,
    }
    let mut out = typed_input("keep")
    let mut scratch: Bytes = list.new()
    let inf = match json.push_typed(small, float.from_bits32(0xff800000), mut out, mut scratch) {
        Error(NonFinite) => true,
        _ => false,
    }
    let nan = match json.push_typed(real, float.from_bits64(0x7ff8000000000000), mut out, mut scratch) {
        Error(NonFinite) => true,
        _ => false,
    }
    extra && invalid && named && inf && nan && out == typed_input("keep")
}

// expect: run typed_json_interop_contract() = true
fn typed_json_interop_contract() -> bool {
    let format: json.Format[InteropRecord] = result.unwrap(json.interop())
    interop_ignored_members(format) && interop_record_commas(format) && interop_numbers_and_maps() && interop_closed()
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

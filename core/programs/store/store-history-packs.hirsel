fn history_check_list_pack(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, cache: Option[pager.ObjectsCache], id: StoreId, seq: u64, next_stamp: u64, offsets: List[u64]) -> Result[pages.PagePack, Error] waits {
    let item: pages.HistoryRef = clone(option.unwrap(map.get(history.locator_rows(locator), seq)))
    let path = failure_result_from_rep(history.history_read_key("p-", item))?
    let mut stream = failure_result_from_rep(history.history_pack_stream(item))?
    if let Some(local) = cache {
        if let Some(take file) = history.pack_cache_open(local, path, item.len) {
            history.pack_stream_cache(mut stream, take file)
            let verified = failure_result_from_rep(history.history_scan_list_pack(mut client, deadline, path, mut stream, store_key_to_rep(id), next_stamp, offsets))
            if let Ok(found) = verified {
                return Ok(found)
            }
            history.pack_stream_refetch(mut stream)
            history.pack_cache_discard(local, path)
        }
        if let Some((take locked, take file)) = pack_cache_stage(local, path, item.len) {
            history.pack_stream_stage(mut stream, take file)
            let checked = failure_result_from_rep(history.history_scan_list_pack(mut client, deadline, path, mut stream, store_key_to_rep(id), next_stamp, offsets))
            if let Some(take staged) = history.pack_stream_staged(mut stream) {
                if let Ok(_) = checked {
                    history.pack_cache_publish(local.dir, path, take staged)
                }
            }
            let _ = host.remove(local.dir, history.PACK_CACHE_INCOMING)
            drop(take locked)
            return take checked
        }
    }
    failure_result_from_rep(history.history_scan_list_pack(mut client, deadline, path, mut stream, store_key_to_rep(id), next_stamp, offsets))
}

fn history_load_data_pack(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, cache: Option[pager.ObjectsCache], id: StoreId, seq: u64, pack: pages.PagePack, next_stamp: u64) -> Result[(String, manifest.LoadedPack), Error] waits {
    let item: pages.HistoryRef = clone(option.unwrap(map.get(history.locator_rows(locator), seq)))
    let name = failure_result_from_rep(history.history_read_key("p-", item))?
    let frame_room = if pack.class == 0 {
        manifest.PAGE_LIMIT
    } else {
        manifest.BLOB_LIMIT
    }
    let rows: u64 = int.widen(pack.frames)
    if item.len > 72 + rows * (16 + frame_room) + manifest.UNKNOWN_ROOM {
        return Error(Corrupt(Fault(file: take name, offset: 0, why: Malformed)))
    }
    let (take raw, verified) = match cache {
        Some(local) if item.len <= local.capacity_bytes => {
            let mut bytes_in = failure_result_from_rep(manifest.disk_read_buffer(item.len))?
            history_read_pack(mut client, name, item, local, mut bytes_in, deadline)?
            (take bytes_in, true)
        },
        _ => (failure_result_from_rep(history.history_read_object(mut client, name, item, deadline))?, false),
    }
    let payloads = disk_allocation(scoped fn() -> Result[Map[u64, format.DiskFrame], Error] {
        let ctx = failure_result_from_rep(history.history_object_context(name, store_key_to_rep(id), 3, item, raw))?
        if !verified {
            failure_result_from_rep(history.history_object_digest(name, item, raw))?
        }
        failure_result_from_rep(manifest.index_pack_frames(name, ctx, pack, next_stamp, raw))
    })?
    Ok((take name, manifest.LoadedPack(class: pack.class, payloads: take payloads, raw: take raw)))
}

fn history_validate_manifest(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, id: StoreId, file: String, take page_record: manifest.PageManifest, cache: Option[pager.ObjectsCache]) -> Result[manifest.ValidatedPageManifest, Error] waits {
    failure_result_from_rep(manifest.require_object_memory_manifest(page_record))?
    validate_bucket_graph(mut client, locator, deadline, id, file, take page_record, false, cache)
}

fn validate_bucket_graph(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, id: StoreId, file: String, take page_record: manifest.PageManifest, allow_tiered: bool, cache: Option[pager.ObjectsCache]) -> Result[manifest.ValidatedPageManifest, Error] waits {
    let blank = manifest.PageGraph(stamps: map.new(), frames: map.new(), postorder: list.new())
    let mut lists = manifest.empty_listed_pages(allow_tiered, take blank)
    let mut final_item: Option[u64] = None
    failure_result_from_rep(manifest.read_page_list(mut client, store_key_to_rep(id), page_record, page_record.pack_root, None, PackList, mut final_item, mut lists, scoped fn(mut reader_client: std.object.Client, store_id: types.StoreKey, ptr: std.page.PagePtr) -> Result[(String, std.page.Image), types.Failure] waits {
        failure_result_to_rep(failure_result_from_rep(history.history_list_page(mut reader_client, locator, deadline, cache, store_key_to_rep(store_key_from_rep(store_id)), ptr)))
    }))?
    final_item = None
    failure_result_from_rep(manifest.read_page_list(mut client, store_key_to_rep(id), page_record, page_record.lineage, None, LineageList, mut final_item, mut lists, scoped fn(mut reader_client: std.object.Client, store_id: types.StoreKey, ptr: std.page.PagePtr) -> Result[(String, std.page.Image), types.Failure] waits {
        failure_result_to_rep(failure_result_from_rep(history.history_list_page(mut reader_client, locator, deadline, cache, store_key_to_rep(store_key_from_rep(store_id)), ptr)))
    }))?
    failure_result_from_rep(manifest.validate_lineage_forks(file, page_record, lists.lineage.forks))?
    for (seq, _) in lists.class_two {
        if map.contains(lists.packs, seq) || !map.contains(history.locator_rows(locator), seq) {
            return Error(failure_from_rep(format.disk_fault(file, 72, Malformed)))
        }
    }
    if map.len(history.locator_rows(locator)) != map.len(lists.packs) + map.len(lists.class_two) {
        return Error(failure_from_rep(format.disk_fault(file, 72, Malformed)))
    }
    let mut seqs: List[u64] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut seqs, map.len(lists.packs))))?
    for (seq, pack) in lists.packs {
        let Some(located) = map.get(history.locator_rows(locator), seq) else {
            return Error(failure_from_rep(format.disk_fault(file, 72, Malformed)))
        }
        if pack.class < 3 {
            list.push(mut seqs, seq)
        } else if located.len != pack.payload_bytes {
            return Error(failure_from_rep(format.disk_fault(file, 72, Malformed)))
        }
    }
    for (seq, offsets) in lists.class_two {
        let pack = history_check_list_pack(mut client, locator, deadline, cache, id, seq, page_record.next_stamp, offsets)?
        failure_result_from_rep(types.capacity(map.try_reserve(mut lists.packs, 1)))?
        map.insert(mut lists.packs, seq, pack)
    }
    let mut pending: Map[u64, List[history.LocatedNeed]] = map.new()
    for holder in page_record.branches {
        failure_result_from_rep(history.history_want_roots(mut pending, holder.roots))?
    }
    for held in page_record.pins {
        failure_result_from_rep(history.history_want_roots(mut pending, held.roots))?
    }
    list.sort(mut seqs, fn(a: u64, b: u64) -> Order {
        order.compare(b, a)
    })
    for seq in seqs {
        let pack = option.unwrap(map.get(lists.packs, seq))
        let (take name, take loaded) = history_load_data_pack(mut client, locator, deadline, cache, id, seq, pack, page_record.next_stamp)?
        let inventory = manifest.RecoveryInventory(packs: view lists.packs, next_stamp: page_record.next_stamp, allow_tiered: allow_tiered)
        failure_result_from_rep(history.history_resolve_pack(name, loaded, inventory, seq, mut pending, mut lists.live_graph))?
    }
    for (seq, frames) in pending {
        let (offset, stamp) = match frames[0] {
            NeedPage(ptr, _, _) => (ptr.offset, ptr.stamp),
            NeedBlob(reference) => (reference.offset, reference.stamp),
        }
        let name = failure_result_from_rep(manifest.paged_pack_path(seq))?
        return Error(failure_from_rep(format.disk_fault(name, offset, Dangling(stamp))))
    }
    let manifest.ListedPages(packs: take inventory, lineage: take lineage, live_graph: take graph, ..) = take lists
    let mut ordered = take graph
    history.history_graph_order(mut ordered)
    Ok(manifest.ValidatedPageManifest(manifest: take page_record, inventory: take inventory, lineage: take lineage, graph: take ordered, allow_tiered: allow_tiered))
}

fn history_paged_capture(mut source: history.ObjectPackRead, head: history.HistoryHead, ceiling: u64) -> Result[pager.JournalReplay, Error] waits {
    let (take replay, _) = history_paged_load(mut source, head, ceiling)?
    Ok(take replay)
}

fn history_paged_load(mut source: history.ObjectPackRead, head: history.HistoryHead, ceiling: u64) -> Result[(pager.JournalReplay, manifest.LoadedPageStore), Error] waits {
    let chain = failure_result_from_rep(history.history_suffix(mut source.client, head, head.checkpoint, source.deadline))?
    let (take mark, take checkpoint_data) = failure_result_from_rep(history.history_checkpoint(mut source.client, head, source.deadline))?
    let page_record = failure_result_from_rep(history.history_read_manifest(mut source.client, head.store, mark, head.checkpoint.seq, source.deadline))?
    let (take replay, take loaded) = history_open_checkpoint(mut source, head, mark, checkpoint_data, take page_record, ceiling)?
    let mut recovered = take replay
    history_apply_suffix(mut source.client, head, head.checkpoint.seq, chain, mut recovered, ceiling, source.deadline)?
    Ok((take recovered, take loaded))
}

fn history_open_checkpoint(mut source: history.ObjectPackRead, head: history.HistoryHead, mark: history.HistoryMark, checkpoint_data: Bytes, take page_record: manifest.PageManifest, ceiling: u64) -> Result[(pager.JournalReplay, manifest.LoadedPageStore), Error] waits {
    source.locator = failure_result_from_rep(history.history_locator(mut source.client, head, mark, checkpoint_data, source.deadline))?
    let name = failure_result_from_rep(history.history_read_key("m-", mark.manifest))?
    let cache = history.pack_cache_directory(source.cache)
    if let Some(local) = cache {
        pack_cache_trim(local)
    }
    let validated = history_validate_manifest(mut source.client, source.locator, source.deadline, store_key_from_rep(head.store), name, take page_record, cache)?
    let loaded = failure_result_from_rep(history.rebuild_page_store(take validated, Some(view source.locator)))?
    let initial = disk_allocation(scoped fn() -> Result[pages.State, Error] {
        failure_result_from_rep(types.capacity(manifest.manifest_state(loaded.manifest, loaded.holders)))
    })?
    let replay = failure_result_from_rep(pager.journal_replay_manifest(take initial, loaded.manifest))?
    failure_result_from_rep(catalog.over_ceiling(failure_result_from_rep(journal.journal_account(replay))?, ceiling))?
    Ok((take replay, take loaded))
}

// §13.10a class-aware Cold reachable-edge walk for R4, leased cuts and the
// install cut. Holds at most one frame buffer (<= 1,048,576 bytes or one
// frame) at a time and no pin across frames.
fn check_listed_tiered_present(d: Dir, packs: Map[u64, PagePack]) -> Result[(), Error] waits {
    for (seq, pack) in packs {
        if pack.class < 3 {
            continue
        }
        let path = paged_pack_path(seq)?
        match host.open(d, path, Read) {
            Ok(take file) => disk_io(host.close(take file))?,
            Error(NotFound) => return Error(Unsupported(0x0023)),
            Error(problem) => return Error(Io(problem)),
        }
    }
    Ok(())
}

type ColdWalk {
    d: Dir,
    id: StoreId,
    next_stamp: u64,
    settled_below: u64,
    headers_checked: Map[u64, ()],
    page_levels: Map[u64, u8],
    reached_by_pack: Map[u64, List[TieredFrameId]]
}

fn cold_check_pack_header(mut walk: ColdWalk, seq: u64, pack: PagePack, path: String) -> Result[(), Error] waits {
    if map.contains(walk.headers_checked, seq) {
        return Ok(())
    }
    let mut opened = match host.open(walk.d, path, Read) {
        Ok(take fd) => take fd,
        Error(NotFound) => return Error(disk_fault(path, 0, Absent)),
        Error(problem) => return Error(Io(problem)),
    }
    let size = disk_io(host.stat_file(mut opened))?.size
    if size != pack.payload_bytes {
        disk_io(host.close(take opened))?
        let why = if size < pack.payload_bytes {
            Truncated
        } else {
            Malformed
        }
        return Error(disk_fault(path, size, why))
    }
    let header_raw = read_disk_bytes(mut opened, path, 0, 72)?
    disk_io(host.close(take opened))?
    let _ = disk_allocation(scoped fn() -> Result[DiskHeader, Error] {
        disk_read_header(path, header_raw, 3, Some(seq), Some(walk.id))
    })?
    capacity(map.try_reserve(mut walk.headers_checked, 1))?
    map.insert(mut walk.headers_checked, seq, ())
    Ok(())
}

fn cold_record_reached(mut walk: ColdWalk, frame: TieredFrameId) -> Result[(), Error] {
    let appended = map.update(mut walk.reached_by_pack, frame.pack, fn(mut items: List[TieredFrameId]) -> Result[(), Capacity] {
        list.try_reserve(mut items, 1)?
        list.push(mut items, frame)
        Ok(())
    })
    match take appended {
        Some(take result) => capacity(take result),
        None => {
            let mut items: List[TieredFrameId] = list.new()
            capacity(list.try_reserve(mut items, 1))?
            list.push(mut items, frame)
            capacity(map.try_reserve(mut walk.reached_by_pack, 1))?
            map.insert(mut walk.reached_by_pack, frame.pack, take items)
            Ok(())
        },
    }
}

fn walk_cold_blob(mut walk: ColdWalk, packs: Map[u64, PagePack], reference: std.page.BlobRef, mut stamps: Map[u64, std.page.PagePtr]) -> Result[(), Error] waits {
    let path = paged_pack_path(reference.pack)?
    if reference.stamp == 0 || reference.stamp >= walk.next_stamp || reference.len > BLOB_LIMIT - 8 {
        return Error(disk_fault(path, reference.offset, Malformed))
    }
    let width = 8 + reference.len
    let Some(pack) = map.get(packs, reference.pack) else {
        return Error(disk_fault(path, reference.offset, Dangling(reference.stamp)))
    }
    if pack.class != 4 || reference.offset < 72 || reference.offset >= pack.index || 16 + width > pack.index - reference.offset {
        return Error(disk_fault(path, reference.offset, Malformed))
    }
    let loc = std.page.PagePtr(pack: reference.pack, offset: reference.offset, len: int.truncate(width), checksum: reference.checksum, stamp: reference.stamp)
    if !mark_reached(mut stamps, path, loc)? {
        return Ok(())
    }
    if reference.pack < walk.settled_below {
        return Ok(())
    }
    cold_check_pack_header(mut walk, reference.pack, pack, path)?
    {
        let mut opened = match host.open(walk.d, path, Read) {
            Ok(take fd) => take fd,
            Error(NotFound) => return Error(disk_fault(path, reference.offset, Absent)),
            Error(problem) => return Error(Io(problem)),
        }
        let raw = read_disk_bytes(mut opened, path, reference.offset, 16 + width)?
        disk_io(host.close(take opened))?
        let _ = disk_allocation(scoped fn() -> Result[Arc[TieredFrame], Error] {
            read_tiered_frame(path, walk.id, TieredBlob(reference), raw, reference.offset, walk.next_stamp)
        })?
    }
    cold_record_reached(mut walk, tiered_frame_id(TieredBlob(reference)))
}

fn walk_cold_page(mut walk: ColdWalk, packs: Map[u64, PagePack], ptr: std.page.PagePtr, expected_level: Option[u8], mut stamps: Map[u64, std.page.PagePtr]) -> Result[(), Error] waits {
    if ptr.stamp == 0 {
        return Ok(())
    }
    let path = paged_pack_path(ptr.pack)?
    let Some(pack) = map.get(packs, ptr.pack) else {
        return Error(disk_fault(path, ptr.offset, Dangling(ptr.stamp)))
    }
    let width: u64 = int.widen(ptr.len)
    if pack.class != 3 || ptr.stamp >= walk.next_stamp || width < 24 || width > PAGE_LIMIT || ptr.offset < 72 || ptr.offset >= pack.index || 16 + width > pack.index - ptr.offset {
        return Error(disk_fault(path, ptr.offset, Malformed))
    }
    if !mark_reached(mut stamps, path, ptr)? {
        if let Some(wanted) = expected_level {
            if let Some(seen_level) = map.get(walk.page_levels, ptr.stamp) {
                if seen_level != wanted {
                    return Error(disk_fault(path, ptr.offset, Malformed))
                }
            }
        }
        return Ok(())
    }
    if ptr.pack < walk.settled_below {
        return Ok(())
    }
    cold_check_pack_header(mut walk, ptr.pack, pack, path)?
    let (height, take child_pages, take child_blobs) = {
        let mut opened = match host.open(walk.d, path, Read) {
            Ok(take fd) => take fd,
            Error(NotFound) => return Error(disk_fault(path, ptr.offset, Absent)),
            Error(problem) => return Error(Io(problem)),
        }
        let raw = read_disk_bytes(mut opened, path, ptr.offset, 16 + width)?
        disk_io(host.close(take opened))?
        disk_allocation(scoped fn() -> Result[(u8, List[std.page.PagePtr], List[std.page.BlobRef]), Error] {
            let frame = read_tiered_frame(path, walk.id, TieredPage(ptr), raw, ptr.offset, walk.next_stamp)?
            let page = fold_page(frame)
            let image = std.page.image_of(page)
            let h = std.page.level(image)
            if let Some(wanted) = expected_level {
                if h != wanted {
                    return Error(disk_fault(path, ptr.offset, Malformed))
                }
            }
            let mut pages_out: List[std.page.PagePtr] = list.new()
            let mut blobs_out: List[std.page.BlobRef] = list.new()
            for slot in 0u64 .. std.page.count(image) {
                match std.page.owning_edge(image, slot) {
                    Some(PageEdge(child)) => {
                        if child.stamp != 0 {
                            page_edge_order(path, ptr, child)?
                            capacity(list.try_reserve(mut pages_out, 1))?
                            list.push(mut pages_out, child)
                        }
                    },
                    Some(BlobEdge(body)) => {
                        capacity(list.try_reserve(mut blobs_out, 1))?
                        list.push(mut blobs_out, body)
                    },
                    None => (),
                }
            }
            Ok((h, take pages_out, take blobs_out))
        })?
    }
    capacity(map.try_reserve(mut walk.page_levels, 1))?
    map.insert(mut walk.page_levels, ptr.stamp, height)
    cold_record_reached(mut walk, tiered_frame_id(TieredPage(ptr)))?
    for child in child_pages {
        if height == 0 {
            return Error(disk_fault(path, ptr.offset, Malformed))
        }
        walk_cold_page(mut walk, packs, child, Some(height - 1), mut stamps)?
    }
    for body in child_blobs {
        walk_cold_blob(mut walk, packs, body, mut stamps)?
    }
    Ok(())
}

// Verifies a touched unsettled class-3/4 pack's PACK_INDEX chain using one
// frame buffer at a time and matches every reached edge against its row.
fn verify_cold_pack_index(d: Dir, id: StoreId, seq: u64, pack: PagePack, next_stamp: u64, reached_in: List[TieredFrameId]) -> Result[(), Error] waits {
    let path = paged_pack_path(seq)?
    let mut reached: List[TieredFrameId] = disk_allocation(scoped fn() -> Result[List[TieredFrameId], Error] {
        Ok(clone(reached_in))
    })?
    list.sort(mut reached, fn(a: TieredFrameId, b: TieredFrameId) -> Order {
        order.compare(a.offset, b.offset)
    })
    for i in 1u64 .. list.len(reached) {
        if reached[i].offset == reached[i - 1].offset {
            return Error(disk_fault(path, reached[i].offset, Malformed))
        }
    }
    let expected_row_kind = if pack.class == 3 {
        0x21u8
    } else {
        0x22u8
    }
    let mut opened = match host.open(d, path, Read) {
        Ok(take fd) => take fd,
        Error(NotFound) => return Error(disk_fault(path, pack.index, Absent)),
        Error(problem) => return Error(Io(problem)),
    }
    let mut at = pack.index
    let mut prev_index = 0u64
    let mut next_data = 72u64
    let mut rows_seen = 0u64
    let mut matched = 0u64
    let mut problem: Option[Error] = None
    while at < pack.payload_bytes {
        if pack.payload_bytes - at < 16 {
            problem = Some(disk_fault(path, at, Malformed))
            break
        }
        let width = order.min(PACK_INDEX_LIMIT + 16, pack.payload_bytes - at)
        let wire = match read_disk_bytes(mut opened, path, at, width) {
            Ok(take bytes_read) => take bytes_read,
            Error(take err) => {
                problem = Some(take err)
                break
            },
        }
        let start_data = next_data
        let start_rows = rows_seen
        let start_matched = matched
        let step = disk_allocation(scoped fn() -> Result[(u64, u64, u64, u64), Error] {
            let end = checked_tiered_index(path, id, seq, at, width, wire)?
            let payload = list.slice(wire, 16, end)
            let (prev, take initial) = start_pack_index(path, at, payload, 0)?
            if prev != prev_index {
                return Error(disk_fault(path, at, Order))
            }
            let mut cursor = take initial
            let mut cur_data = start_data
            let mut cur_rows = start_rows
            let mut cur_matched = start_matched
            while let Some(take row) = next_pack_index(path, at, payload, mut cursor)? {
                let row_len: u64 = int.widen(row.len)
                if row.kind != expected_row_kind || row.offset != cur_data || row.stamp >= next_stamp || row.offset >= pack.index || 16 + row_len > pack.index - row.offset || cur_rows >= int.widen(pack.frames) {
                    return Error(disk_fault(path, at, Malformed))
                }
                if cur_matched < list.len(reached) && reached[cur_matched].offset < row.offset {
                    return Error(disk_fault(path, reached[cur_matched].offset, Malformed))
                }
                if cur_matched < list.len(reached) && reached[cur_matched].offset == row.offset {
                    let row_frame_kind: u16 = if row.kind == 0x21 {
                        0x0021u16
                    } else {
                        0x0022u16
                    }
                    if row_len != reached[cur_matched].len || row.stamp != reached[cur_matched].stamp || row_frame_kind != reached[cur_matched].kind {
                        return Error(disk_fault(path, row.offset, Checksum))
                    }
                    cur_matched += 1
                }
                cur_data += 16 + row_len
                cur_rows += 1
            }
            Ok((end, cur_data, cur_rows, cur_matched))
        })
        match take step {
            Ok((end, cur_data, cur_rows, cur_matched)) => {
                prev_index = at
                at += end
                next_data = cur_data
                rows_seen = cur_rows
                matched = cur_matched
            },
            Error(take err) => {
                problem = Some(take err)
                break
            },
        }
    }
    disk_io(host.close(take opened))?
    if let Some(take err) = take problem {
        return Error(take err)
    }
    if at != pack.payload_bytes || next_data != pack.index || rows_seen != int.widen(pack.frames) {
        return Error(disk_fault(path, at, Malformed))
    }
    if matched < list.len(reached) {
        return Error(disk_fault(path, reached[matched].offset, Malformed))
    }
    Ok(())
}

fn walk_cold_reachable(d: Dir, id: StoreId, packs: Map[u64, PagePack], next_stamp: u64, settled_below: u64, cold_roots: List[std.page.PagePtr], deferred: List[DeferredFree], mut stamps: Map[u64, std.page.PagePtr]) -> Result[(), Error] waits {
    if list.len(cold_roots) == 0 && list.len(deferred) == 0 {
        return Ok(())
    }
    let mut walk = ColdWalk(d: d, id: id, next_stamp: next_stamp, settled_below: settled_below, headers_checked: map.new(), page_levels: map.new(), reached_by_pack: map.new())
    for ptr in cold_roots {
        walk_cold_page(mut walk, packs, ptr, None, mut stamps)?
    }
    for queued in deferred {
        match queued.target {
            TieredPage(ptr) => walk_cold_page(mut walk, packs, ptr, None, mut stamps)?,
            TieredBlob(body) => walk_cold_blob(mut walk, packs, body, mut stamps)?,
        }
    }
    let ColdWalk(reached_by_pack: take touched, ..) = take walk
    for (seq, reached) in touched {
        let Some(pack) = map.get(packs, seq) else {
            return Error(disk_fault(paged_pack_path(seq)?, 72, Malformed))
        }
        verify_cold_pack_index(d, id, seq, pack, next_stamp, reached)?
    }
    Ok(())
}

// Offline walker helper: verifies that a single Cold frame edge is named by a
// PACK_INDEX row in its pack, using one PACK_INDEX frame buffer at a time.
fn check_cold_pack_index_row(d: Dir, id: StoreId, path: String, seq: u64, class: u8, index_at: u64, size: u64, next_stamp: u64, expected: TieredFrameId) -> Result[(), Error] waits {
    let expected_row_kind = if class == 3 {
        0x21u8
    } else {
        0x22u8
    }
    let mut opened = match host.open(d, path, Read) {
        Ok(take fd) => take fd,
        Error(NotFound) => return Error(disk_fault(path, index_at, Absent)),
        Error(problem) => return Error(Io(problem)),
    }
    let mut at = index_at
    let mut prev_index = 0u64
    let mut next_data = 72u64
    let mut found = false
    let mut problem: Option[Error] = None
    while at < size {
        if size - at < 16 {
            problem = Some(disk_fault(path, at, Malformed))
            break
        }
        let width = order.min(PACK_INDEX_LIMIT + 16, size - at)
        let wire = match read_disk_bytes(mut opened, path, at, width) {
            Ok(take bytes_read) => take bytes_read,
            Error(take err) => {
                problem = Some(take err)
                break
            },
        }
        let start_data = next_data
        let step = disk_allocation(scoped fn() -> Result[(u64, u64, bool), Error] {
            let end = checked_tiered_index(path, id, seq, at, width, wire)?
            let payload = list.slice(wire, 16, end)
            let (prev, take initial) = start_pack_index(path, at, payload, 0)?
            if prev != prev_index {
                return Error(disk_fault(path, at, Order))
            }
            let mut cursor = take initial
            let mut cur_data = start_data
            let mut hit = false
            while let Some(take row) = next_pack_index(path, at, payload, mut cursor)? {
                let row_len: u64 = int.widen(row.len)
                if row.kind != expected_row_kind || row.offset != cur_data || row.stamp >= next_stamp || row.offset >= index_at || 16 + row_len > index_at - row.offset {
                    return Error(disk_fault(path, at, Malformed))
                }
                if row.offset == expected.offset {
                    let row_frame_kind: u16 = if row.kind == 0x21 {
                        0x0021u16
                    } else {
                        0x0022u16
                    }
                    if row_len != expected.len || row.stamp != expected.stamp || row_frame_kind != expected.kind {
                        return Error(disk_fault(path, row.offset, Checksum))
                    }
                    hit = true
                }
                cur_data += 16 + row_len
            }
            Ok((end, cur_data, hit))
        })
        match take step {
            Ok((end, cur_data, hit)) => {
                prev_index = at
                at += end
                next_data = cur_data
                if hit {
                    found = true
                    break
                }
            },
            Error(take err) => {
                problem = Some(take err)
                break
            },
        }
    }
    disk_io(host.close(take opened))?
    if let Some(take err) = take problem {
        return Error(take err)
    }
    if !found {
        return Error(disk_fault(path, expected.offset, Malformed))
    }
    Ok(())
}

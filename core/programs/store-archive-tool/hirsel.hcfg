pkg_v1.Package(
    name: "hirsel.ai/store_archive_tool",
    version: "1.0.0",
    charge: ChargeV1,
    sources: [("main.hirsel", "main")],
    dependencies: [
        ("std", Toolchain(package: "std", major: 1, authority: [])),
        ("platform", Path(
            package: "platform",
            major: 1,
            path: "../platform",
            authority: [Dir, Net, Clock, Random, Stdout, Stderr, Tasks, Args, Secret, Cred],
        )),
    ],
)

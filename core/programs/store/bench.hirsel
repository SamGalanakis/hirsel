// R1–R3. The READY/DONE gate is std.omap's phase-measurement protocol.
pub type Account: send + codec {
    id: u64,
    balance: i64,
    owner: String
}

fn insert(mut db: store.Db, t: store.Table[u64, Account], i: u64) -> u64 waits {
    let done = result.unwrap(store.run(mut db, None, fn(mut tx: store.Tx) -> Result[u64, store.Error] {
        let a = Account(id: i, balance: int.narrow(i), owner: result.unwrap(string.from("owner000")))
        store.put(mut tx, t, i, a)?
        let back = option.unwrap(store.fetch(tx, store.shape(t), i)?)
        if back.id != i || back.balance != int.narrow(i) || back.owner != "owner000" {
            fail("store R1 wrong row")
        }
        Ok(back.id + string.byte_len(back.owner))
    }))
    match take done {
        Committed(x) => x.value,
        _ => fail("store R1 refused")
    }
}

type Reader: send {
    held: store.Snapshot,
    sh: store.Shape[u64, Account]
}

fn reader(take r: Reader) -> u64 {
    let mut state: u64 = 1
    let mut sum: u64 = 0
    for _ in 0u64 .. 100000 {
        let k = store.splitmix64(state) % 100000
        state = int.wrapping_add(state, 0x9E3779B97F4A7C15u64)
        let a = option.unwrap(result.unwrap(store.get(r.held, r.sh, k)))
        if a.id != k || a.balance != int.narrow(k) || a.owner != "owner000" {
            fail("store R3 wrong row")
        }
        sum += a.id + string.byte_len(a.owner)
    }
    sum
}

pub fn main(dir: Dir, clock: Clock, random: Random, tasks: Tasks, out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let mode = option.unwrap(args.get(argv, 0))
    let mut db = store.memory(clock, random, store.defaults())
    let accounts: std.codec.Codec[Account] = std.codec.of()
    result.unwrap(store.create_table(mut db, store.spec("accounts", std.codec.key_u64(), accounts)))
    let t = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), accounts))
    if mode != "R1" {
        for i in 0u64 .. 100000 {
            let _ = insert(mut db, t, i)
        }
    }
    let held = store.snapshot(db)
    let sh = store.shape(t)
    let mut gate = result.unwrap(host.open(dir, "gate", Read))
    let mut byte: Bytes = result.unwrap(list.with_capacity(1))
    result.unwrap(stdout.write(out, "READY\n"))
    if result.unwrap(host.read(mut gate, mut byte)) != 1 {
        return Error(Exit(status: 7))
    }
    let start = host.mono_ns(clock)
    let mut sum: u64 = 0
    if mode == "R1" {
        for i in 0u64 .. 100000 {
            sum += insert(mut db, t, i)
        }
    } else if mode == "R2" {
        let mut rows = result.unwrap(store.scan(held, sh, Unbounded, Unbounded))
        while let Some((k, a)) = result.unwrap(store.next(mut rows)) {
            if a.id != k || a.balance != int.narrow(k) || a.owner != "owner000" {
                fail("store R2 wrong row")
            }
            sum += a.id + string.byte_len(a.owner)
        }
    } else {
        let payload = Reader(held: take held, sh: take sh)
        let h = result.unwrap(task.spawn(tasks, bytes 16777216, take payload, reader))
        sum = result.unwrap(task.join(take h))
    }
    let elapsed = host.mono_ns(clock) - start
    let mut rendered = string.new()
    result.unwrap(string.push(mut rendered, "DONE "))
    result.unwrap(string.push_u64(mut rendered, sum))
    result.unwrap(string.push(mut rendered, " "))
    result.unwrap(string.push_u64(mut rendered, elapsed))
    result.unwrap(string.push(mut rendered, "\n"))
    result.unwrap(stdout.write(out, rendered))
    list.clear(mut byte)
    if result.unwrap(host.read(mut gate, mut byte)) != 1 {
        return Error(Exit(status: 7))
    }
    if store.version(store.snapshot(db)) != 100001 {
        return Error(Exit(status: 6))
    }
    Ok(())
}

// Module gateway_http (package harness): the gateway's HTTP front. It serves /sessions
// and holds each browser's event stream itself, so a session's place runs only while
// the session works: a stream follows the place through a wire client while the session
// is busy and lets go of it when the session is quiet, and the place then stops by
// itself under the open stream.
//
// The front accepts its own connections, and each connection's task holds a gateway
// door. std.http cannot serve this: its handlers and stream producers hold only
// shareable state and a Clock and Dir (HTTP-10, HTTP-11), and a door is a channel. Each
// connection carries one request and closes (`Connection: close`); a request body has a
// Content-Length or none.
//
// Routes: GET /sessions lists ids; POST /sessions creates a session keyed by the body;
// DELETE /sessions/{id}; POST /sessions/{id}/messages takes a JSON `harness.Submit`;
// POST /sessions/{id}/decisions a JSON `harness.Decision`; GET /sessions/{id}/events is
// the status and the transcript's last `tail` rows (`?tail=N`, at most and by default
// the front's `tail_lines`) and every later row as
// server-sent events, one JSON `Shown` per changed row and a comment as a heartbeat;
// GET /sessions/{id}/history?before=B&lines=N is one JSON `Page` of earlier rows;
// GET /sessions/{id}/waits lists pending approvals; POST /sessions/{id}/forks takes a
// JSON `ForkAsk` and answers the new session's id. GET /sessions/{id}/releases lists
// filed proposals and POST settles one on a development front. After each image's rows comes a
// "batch" event carrying the store
// version: a reader applies the rows before it together, and the first batch on a
// stream completes its image. A bearer-authenticated stream on a preview-enabled front
// also gets the draft: a "preview" snapshot on join, gap, dropped text or a new key,
// then "preview-delta" events that append text at the draft's end, and "preview-clear".
// Its transcript row at key.entry + 1 supersedes the draft.
// One transcript row as a stream sends it: its position and its view.
pub type Shown: codec + send {
    at: u64,
    line: harness.View
}

// Draft text that continues the last snapshot or delta: `at` is the draft offset where
// `text` begins, which must be the end of what the reader holds.
pub type PreviewDelta: codec + send {
    seq: u64,
    at: u64,
    text: String
}

// The rows of `harness.Page(before, lines)`: every row at `from` or later and before
// `before`. The next older page is `before = from`; at `from` 1 there is none.
pub type Page: codec + send {
    from: u64,
    rows: List[Shown]
}

// A fork of a session: the cut is the first entry the fork does not share, and `key`
// names the fork as a creation key does, so a repeated ask returns the same id.
pub type ForkAsk: codec + send {
    key: String,
    cut: u64
}

// How long a front call waits before connecting to a place again.
const RECONNECT_MS: u64 = 20u64

// The most a history page may ask for.
const PAGE_LINES_MAX: u64 = 256u64

// What the front needs from a session's place: its submit and decide entries and a query
// over `harness.window`, and how to reach it. A new session starts as `agent` with
// `narrow`. Each connection's task spends `conn_bytes`, which must hold a wire client.
pub type Front: send {
    bind: StaticFn[fn((), Bytes) -> Result[runner.BoundCaller, runner.BindRefusal] waits],
    bind_bytes: u64,
    bind_steps: u64,
    authority: Bytes,
    submit: runner.client.Callee[harness.Submit, Result[harness.Disposition, harness.Refused]],
    decide: runner.client.Callee[harness.Decision, Result[harness.Ruling, harness.Refused]],
    settle: Option[runner.client.Callee[release.DevSettlement, Result[harness.Filed, harness.Refused]]],
    keys: List[Bytes],
    socket: std.wsock.Config,
    agent: String,
    narrow: harness.Narrow,
    preview: Option[preview.Door],
    tasks: Tasks,
    clock: Clock,
    random: Random,
    net: Net,
    tail_lines: u64,
    within_ms: u64,
    beat_ms: u64,
    conn_bytes: u64,
    conns_max: u64,
    head_max: u64,
    body_max: u64,
}

pub opaque type Served {
    to: Sender[FrontEvent],
    serving: Task[()]
}

fn copy_front(f: Front) -> Front {
    Front(bind: f.bind, bind_bytes: f.bind_bytes, bind_steps: f.bind_steps, authority: clone(f.authority), submit: clone(f.submit), decide: clone(f.decide), settle: clone(f.settle), keys: clone(f.keys), socket: clone(f.socket), agent: string.from(f.agent), narrow: clone(f.narrow), preview: copy_preview(f.preview), tasks: f.tasks, clock: f.clock, random: f.random, net: f.net, tail_lines: f.tail_lines, within_ms: f.within_ms, beat_ms: f.beat_ms, conn_bytes: f.conn_bytes, conns_max: f.conns_max, head_max: f.head_max, body_max: f.body_max)
}

fn window_entry() -> runner.client.Callee[harness.Window, ()] {
    let codec: std.codec.Codec[harness.View] = std.codec.of()
    runner.client.query_as_entry(code.describe(harness.window), result.unwrap(harness.window_slots()))
}

fn copy_preview(p: Option[preview.Door]) -> Option[preview.Door] {
    match p {
        Some(d) => Some(preview.copy_door(d)),
        None => None
    }
}

fn deadline_ms(c: Clock, ms: u64) -> u64 {
    std.clock.deadline_after_ms(host.mono_ns(c), ms)
}

// ---- reaching a session ----
fn turned(why: harness.gateway.Refused) -> u16 {
    match why {
        Unknown => 404u16,
        Denied => 403u16,
        Asleep => 503u16,
        Full => 503u16,
        Stopping => 503u16,
        _ => 500u16
    }
}

// Checks a cold ACL before waking a place. If the place is already running,
// authorize on its live query. A disconnect retries the check as well as the
// connection, since the place may have unloaded in between.
fn reach(d: harness.gateway.Door, f: Front, id: u64, identity: Identity, first_p: u64, wake: bool) -> Result[Option[runner.client.Client], u16] waits {
    let until = deadline_ms(f.clock, f.within_ms)
    loop {
        match harness.gateway.access(d, id, identity.caller, wake) {
            Ok(None) => return Ok(None),
            Ok(Some(take lease)) => {
                if let Some(address) = latest.read(platform.local.status(lease)).addr {
                    let opened = runner.client.client_at(f.net, f.clock, f.random, f.keys, f.socket, address, f.authority, Some(clone(identity.credential)), first_p, f.within_ms)
                    if let Ok(take c) = take opened {
                        let mut client = take c
                        let who = runner.client.bound_caller(client)
                        if who.issuer != identity.caller.issuer || who.subject != identity.caller.subject {
                            runner.client.close(take client)
                            return Error(403u16)
                        }
                        match checked_status(mut client, f) {
                            Ok(_) => return Ok(Some(take client)),
                            Error(403u16) => { runner.client.close(take client); return Error(403u16) },
                            Error(_) => runner.client.close(take client),
                        }
                    }
                }
            },
            Error(Asleep) => (),
            Error(why) => return Error(turned(why)),
        }
        if host.mono_ns(f.clock) >= until {
            return Error(503u16)
        }
        host.sleep_until(f.clock, deadline_ms(f.clock, RECONNECT_MS))
    }
}

// The browser is the Caller. It names itself with `Authorization: Bearer <base64 credential>`
// and gives its next request position in `Hirsel-Position`, which it keeps by WIRE's client
// rules (P1, P2), so a repeated request at one position with the same bytes runs once.
type Identity {
    credential: Bytes,
    caller: store.Caller,
}

fn request_position(req: Request) -> Result[u64, u16] {
    let Some(at) = field(req, "hirsel-position") else { return Error(400u16) }
    Ok(std.int.parse_uint(text_of(take at), 10) ?=> |_| 400u16)
}

fn bearer(f: Front, req: Request) -> Result[Identity, runner.BindRefusal] waits {
    let Some(auth) = field(req, "authorization") else {
        return Error(Rejected)
    }
    if list.len(auth) <= 7u64 || !std.http1.equal_ascii(std.http.copy_bytes(list.slice(auth, 0u64, 7u64)), string.as_bytes("Bearer ")) {
        return Error(Rejected)
    }
    let Some(take credential) = std.base64.decode(std.http.copy_bytes(list.slice(auth, 7u64, list.len(auth)))) else {
        return Error(Rejected)
    }
    let runner.BoundCaller(caller: take caller, ..) = runner.bind_credential(f.tasks, f.clock, (), f.bind, clone(credential), f.bind_bytes, f.bind_steps)?
    Ok(Identity(credential: take credential, caller: take caller))
}

fn call_place[A: codec, R: codec](d: harness.gateway.Door, f: Front, id: u64, identity: Identity, p: u64, e: runner.client.Callee[A, Result[R, harness.Refused]], take a: A) -> Result[R, u16] waits {
    let mut client = option.unwrap(reach(d, f, id, identity, p, true)?)
    let replied = runner.client.call(mut client, e, take a, int.truncate(f.within_ms))
    runner.client.close(take client)
    match take replied {
        Ok(runner.client.Replied(answer: Returned(Ok(take r)), ..)) => Ok(take r),
        Ok(runner.client.Replied(answer: Returned(Error(NotAllowed)), ..)) => Error(403u16),
        Ok(runner.client.Replied(answer: Returned(Error(_)), ..)) => Error(422u16),
        Ok(runner.client.Replied(answer: Refused(NotAllowed), ..)) => Error(403u16),
        Ok(runner.client.Replied(answer: Refused(RequestMismatch), ..)) => Error(409u16),
        Ok(runner.client.Replied(answer: Refused(HistoryUnavailable), ..)) => Error(409u16),
        _ => Error(503u16),
    }
}

// ---- the stream ----
fn busy(status: String) -> bool {
    status == "thinking" || status == "calling tools"
}

type Following {
    client: runner.client.Client,
    signal: runner.client.Signal,
    status: u32,
    pending: u32,
    sub: u32,
    version: u64,
    fresh: bool,
    hold_until: u64,
}

// A client following the session's transcript. One opened for a nudge stays at least one
// beat even if the session looks quiet, so a change whose run has not yet written its
// busy status is not missed.
fn follow_from(d: harness.gateway.Door, f: Front, id: u64, wake: bool, nudged: bool, identity: Identity, tail: u64, mut first: Option[u64]) -> Result[Option[Following], u16] waits {
    let Some(take opened) = reach(d, f, id, identity, 0u64, wake)? else {
        return Ok(None)
    }
    let mut client = take opened
    let hold_until = if nudged {
        deadline_ms(f.clock, f.beat_ms)
    } else {
        0u64
    }
    // The stream's first row is fixed on its first follow, from one image of the tail.
    // A cover that moved with appends would skip rows that two coalesced commits add.
    if first == None {
        let Ok(tail_sub) = runner.client.subscribe(mut client, window_entry(), Tail(tail), f.within_ms) else {
            runner.client.close(take client);
            return Error(503u16)
        }
        let Ok(image) = runner.client.seen_at(mut client, tail_sub, 0u64, f.within_ms) else {
            runner.client.close(take client);
            return Error(503u16)
        }
        let mut low: Option[u64] = None
        for r in image.rows {
            if let Some(at) = position(r) {
                if low == None || Some(at) < low {
                    low = Some(at)
                }
            }
        }
        runner.client.unsubscribe(mut client, tail_sub)
        first = match low {
            Some(at) => Some(at),
            None => Some(1u64)
        }
    }
    let from = match first {
        Some(at) => at,
        None => 1u64
    }
    let Ok(status) = runner.client.subscribe(mut client, window_entry(), Status, f.within_ms) else {
        runner.client.close(take client)
        return Error(503u16)
    }
    let Ok(pending) = runner.client.subscribe(mut client, window_entry(), PendingTurn, f.within_ms) else {
        runner.client.close(take client)
        return Error(503u16)
    }
    let Ok(sub) = runner.client.subscribe(mut client, window_entry(), From(from), f.within_ms) else {
        runner.client.close(take client)
        return Error(503u16)
    }
    let Ok(head) = runner.client.seen_at(mut client, status, 0u64, f.within_ms) else {
        runner.client.close(take client)
        return Error(503u16)
    }
    if visible_status(head) == None {
        runner.client.close(take client)
        return Error(403u16)
    }
    let reader_bytes = int.saturating_add(65536u64, int.saturating_mul(4u64, f.socket.max_frame))
    let Ok(take changed) = runner.client.follow(mut client, f.tasks, reader_bytes) else {
        runner.client.close(take client)
        return Error(503u16)
    }
    Ok(Some(Following(client: take client, signal: take changed, status: status, pending: pending, sub: sub, version: 0u64, fresh: true, hold_until: hold_until)))
}

fn send_out(mut w: WriteHalf, f: Front, take out: Bytes) -> bool waits {
    match std.http.write_wire(mut w, out, list.new(), f.clock, deadline_ms(f.clock, f.within_ms)) {
        Ok(()) => true,
        Error(_) => false
    }
}

fn beat(mut w: WriteHalf, f: Front) -> bool waits {
    let mut buffer = std.sse.buffer(16u64)
    if let Error(_) = std.sse.comment(mut buffer, "beat") {
        return false
    }
    send_out(mut w, f, std.sse.into_bytes(take buffer))
}

fn event_of[V: codec](s: V, name: Option[String]) -> Option[Bytes] {
    let Ok(format) = (std.json.interop() : Result[std.json.Format[V], std.json.TypedError]) else {
        return None
    }
    let Ok(take text) = std.json.to_string(format, s) else {
        return None
    }
    let mut buffer = std.sse.buffer(string.byte_len(text) + 40u64)
    if let Error(_) = std.sse.event(mut buffer, name, None, string.as_bytes(text)) {
        return None
    }
    Some(std.sse.into_bytes(take buffer))
}

// The status Cover has exactly one row while the caller may read the session.
fn visible_status(image: runner.client.Seen) -> Option[String] {
    let codec: std.codec.Codec[harness.View] = std.codec.of()
    for r in image.rows {
        if let Some(raw) = view r.value {
            if let Ok(Status(take text)) = std.codec.decode(codec, raw) {
                return Some(take text)
            }
        }
    }
    None
}

fn send_rows(mut w: WriteHalf, f: Front, image: runner.client.Seen, mut sent: Map[u64, Bytes]) -> bool waits {
    let codec: std.codec.Codec[harness.View] = std.codec.of()
    for r in image.rows {
        let Some(raw) = view r.value else {
            continue
        }
        let Some(at) = position(r) else {
            continue
        }
        if let Some(old) = map.get(sent, at) {
            if old == raw { continue }
        }
        let Ok(take v) = std.codec.decode(codec, raw) else { continue }
        let Some(take event) = event_of(Shown(at: at, line: take v), None) else { return false }
        if !send_out(mut w, f, take event) { return false }
        map.insert(mut sent, at, clone(raw))
    }
    true
}

// A query row's key carries the table's prefix before the u64 key.
fn position(r: runner.SubRow) -> Option[u64] {
    let width = list.len(r.key)
    if width < 8u64 {
        return None
    }
    let mut at = 0u64
    for i in width - 8u64 .. width {
        at = at * 256u64 + int.widen(r.key[i])
    }
    Some(at)
}

type PreviewWatch {
    observer: Option[preview.Observer],
    // The draft the browser holds and the byte offset of its end.
    sent: Option[(preview.Key, u64)]
}

fn watching(watch: PreviewWatch) -> bool {
    match watch.observer {
        Some(_) => true,
        None => false
    }
}

fn unwatch(mut watch: PreviewWatch) -> () waits {
    if let Some(take obs) = replace(mut watch.observer, None) {
        preview.unobserve(take obs)
    }
}

fn clear_preview(mut w: WriteHalf, f: Front, mut watch: PreviewWatch) -> bool waits {
    if let Some(_) = replace(mut watch.sent, None) {
        return send_out(mut w, f, string.into_bytes("event: preview-clear\ndata: null\n\n"))
    }
    true
}

fn send_preview(mut w: WriteHalf, f: Front, mut client: runner.client.Client, sent: Map[u64, Bytes], mut watch: PreviewWatch) -> bool waits {
    let next = {
        let Some(obs) = view watch.observer else {
            return true
        }
        preview.read(obs)
    }
    let Some(take draft) = take next else {
        return clear_preview(mut w, f, mut watch)
    }
    if map.contains(sent, draft.key.entry + 1u64) {
        return clear_preview(mut w, f, mut watch)
    }
    let end = draft.offset + string.byte_len(draft.text)
    let following = watch.sent
    let start = match following {
        Some((key, held)) if key == draft.key && draft.offset <= held && held <= end => Some(held),
        _ => None
    }
    if start == Some(end) {
        return true
    }

    // Read the ACL after fetching the draft. A status image already held by the
    // follow loop might precede a revocation that raced the hub read.
    let Ok(take present) = runner.client.fence(mut client, window_entry(), Status, f.tasks, f.within_ms) else { return false }
    let Some(status) = visible_status(present) else { return false }
    if !busy(status) {
        return clear_preview(mut w, f, mut watch)
    }

    let encoded = match start {
        Some(held) => {
            let more = PreviewDelta(seq: draft.seq, at: held, text: string.from(string.slice(draft.text, held - draft.offset, end - draft.offset)))
            event_of(more, Some("preview-delta"))
        },
        None => event_of(draft, Some("preview"))
    }
    let Some(take event) = take encoded else {
        return false
    }
    // A blocked write lets the hub coalesce further bytes within its cap.
    watch.sent = Some((draft.key, end))
    send_out(mut w, f, take event)
}

fn send_batch(mut w: WriteHalf, f: Front, version: u64) -> bool waits {
    let mut out = string.from("event: batch\ndata: ")
    string.push_u64(mut out, version)
    string.push(mut out, "\n\n")
    send_out(mut w, f, string.into_bytes(take out))
}

fn halted(quit: Receiver[()]) -> bool {
    match channel.try_receive(quit) {
        Ok(()) => true,
        Error(Empty) => false,
        Error(_) => true
    }
}

// The gateway wakes quiet streams on place starts and requests. While attached
// to a place, WIRE drives durable rows and the hub signals changed drafts.
fn follow(d: harness.gateway.Door, f: Front, id: u64, mut w: WriteHalf, quit: Receiver[()], identity: Identity, tail: u64) -> () waits {
    let (notify, changed): (Sender[()], Receiver[()]) = channel.new(1u64)
    let Some(token) = harness.gateway.watch_marks(d, id, notify) else {
        return reply(mut w, f, 503u16, list.new())
    }
    let mut watch = PreviewWatch(observer: None, sent: None)
    follow_loop(d, f, id, mut w, quit, identity, tail, notify, changed, mut watch)
    unwatch(mut watch)
    harness.gateway.unwatch_marks(d, id, token)
}

fn follow_loop(d: harness.gateway.Door, f: Front, id: u64, mut w: WriteHalf, quit: Receiver[()], identity: Identity, tail: u64, notify: Sender[()], changed: Receiver[()], mut watch: PreviewWatch) -> () waits {
    let mut last = harness.gateway.marks(d, id)
    let mut first: Option[u64] = None
    let initial = follow_from(d, f, id, true, false, identity, tail, mut first)
    let opened = match take initial {
        Ok(Some(take client)) => take client,
        Ok(None) => return reply(mut w, f, 503u16, list.new()),
        Error(code) => return reply(mut w, f, code, list.new()),
    }
    let head = string.into_bytes("HTTP/1.1 200 \r\nContent-Type: text/event-stream\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
    if !send_out(mut w, f, take head) {
        let Following(client: take client, ..) = take opened
        runner.client.close(take client)
        return
    }
    let mut following = Some(take opened)
    let mut sent: Map[u64, Bytes] = map.new()
    let mut beat_at = deadline_ms(f.clock, f.beat_ms)
    while !halted(quit) {
        if let Some(take open) = replace(mut following, None) {
            let mut place = take open
            let ending = place_stream(d, f, id, mut w, quit, mut place, mut sent, mut watch, mut beat_at, mut last)
            let Following(client: take client, ..) = take place
            runner.client.close(take client)
            unwatch(mut watch)
            if !ending || !clear_preview(mut w, f, mut watch) { return }
        } else {
            let m = harness.gateway.marks(d, id)
            if m.nudges != last.nudges || m.ups != last.ups {
                let nudged = m.nudges != last.nudges
                last = m
                match follow_from(d, f, id, nudged, nudged, identity, tail, mut first) {
                    Ok(take next) => { following = take next },
                    Error(403u16) => return,
                    Error(_) => (),
                }
                continue
            }
            if !heartbeat(mut w, f, mut beat_at) { return }
            let alarm = std.clock.alarm(f.tasks, f.clock, beat_at, notify, ())
            let _ = channel.receive(changed)
            let _ = task.cancel_join(take alarm)
        }
    }
}

fn heartbeat(mut w: WriteHalf, f: Front, mut at: u64) -> bool waits {
    if host.mono_ns(f.clock) < at { return true }
    at = deadline_ms(f.clock, f.beat_ms)
    beat(mut w, f)
}

// Returns true when the browser can wait for this place to start again.
fn place_stream(d: harness.gateway.Door, f: Front, id: u64, mut w: WriteHalf, quit: Receiver[()], mut place: Following, mut sent: Map[u64, Bytes], mut watch: PreviewWatch, mut beat_at: u64, mut marks: platform.local.Marks) -> bool waits {
    let group = platform.local.name_of(id)
    let mut active = false
    let mut draft_changed = false
    while !halted(quit) {
        let at = if place.fresh { 0u64 } else { place.version + 1u64 }
        let Ok(take status_image) = runner.client.current(place.client, place.status, at) else { return false }
        let Ok(take pending_image) = runner.client.current(place.client, place.pending, at) else { return false }
        match runner.client.current(place.client, place.sub, at) {
            Error(_) => return true,
            Ok(None) => (),
            Ok(Some(take image)) => {
                let next = image.version
                let Some(take head) = take status_image else { return false }
                let Some(take queued) = take pending_image else { return false }
                let Some(status) = visible_status(head) else { return false }
                marks = harness.gateway.marks(d, id)
                // Finishing a turn publishes its answer before the queued turn's Kick runs.
                // A tool or approval wait still lets the place go idle.
                active = busy(status) || (status != "waiting" && list.len(queued.rows) != 0u64)
                if active && !watching(watch) {
                    if let Some(p) = view f.preview {
                        watch.observer = preview.observe_with(p, group, runner.client.bound_caller(place.client), Some(runner.client.signal(place.signal)))
                        draft_changed = true
                    }
                }
                if !send_rows(mut w, f, head, mut sent) ||
                    !send_rows(mut w, f, image, mut sent) ||
                    !send_batch(mut w, f, next) {
                    return false
                }
                place.fresh = false
                place.version = next
                if !active {
                    unwatch(mut watch)
                    if !clear_preview(mut w, f, mut watch) { return false }
                } else if let Some((key, _)) = watch.sent {
                    if map.contains(sent, key.entry + 1u64) && !clear_preview(mut w, f, mut watch) { return false }
                }
            },
        }
        if !active && host.mono_ns(f.clock) >= place.hold_until { return true }
        if active && draft_changed {
            draft_changed = false
            if !send_preview(mut w, f, mut place.client, sent, mut watch) { return false }
            // The ordered ACL check can have advanced the live subscription.
            continue
        }
        if !heartbeat(mut w, f, mut beat_at) { return false }
        let until = if !active && place.hold_until < beat_at { place.hold_until } else { beat_at }
        match runner.client.wait_for(mut place.client, f.tasks, until) {
            Ok(woken) => { draft_changed = woken },
            Error(_) => return true,
        }
    }
    false
}

// ---- one request ----
type Request {
    input: Bytes,
    head: std.http1.Head,
    body_at: u64,
    body_len: u64
}

fn read_request(mut r: ReadHalf, f: Front) -> Result[Request, u16] waits {
    let until = At(f.clock, deadline_ms(f.clock, f.within_ms))
    let mut input: Bytes = list.with_capacity(f.head_max + f.body_max)
    let mut head = std.http1.head()
    let mut cursor = std.http1.cursor()
    loop {
        match std.http1.resume(input, mut head, mut cursor) {
            Complete => break,
            Partial => (),
            Bad => return Error(400u16),
            TooLarge => return Error(431u16),
        }
        if list.len(input) >= f.head_max {
            return Error(431u16)
        }
        let room = f.head_max - list.len(input)
        match host.recv_bounded(mut r, mut input, room, until) {
            Ok(0u64) => return Error(400u16),
            Ok(_) => (),
            Error(_) => return Error(408u16)
        }
    }
    let body_at = head.end
    let body_len = match std.http.framing(input, view head, f.body_max) {
        Ok(Empty) => 0u64,
        Ok(ContentLength(n)) => n,
        Ok(_) => return Error(411u16),
        Error(_) => return Error(413u16),
    }
    while list.len(input) < body_at + body_len {
        let want = body_at + body_len - list.len(input)
        match host.recv_bounded(mut r, mut input, want, until) {
            Ok(0u64) => return Error(400u16),
            Ok(_) => (),
            Error(_) => return Error(408u16)
        }
    }
    Ok(Request(input: take input, head: take head, body_at: body_at, body_len: body_len))
}

fn part(req: Request, s: std.http1.Span) -> Bytes {
    std.http.copy_bytes(list.slice(req.input, s.start, s.end))
}

fn field(req: Request, name: String) -> Option[Bytes] {
    for i in 0u64 .. req.head.count {
        let h = req.head.fields[i]
        if std.http1.equal_ascii(part(req, h.name), string.as_bytes(name)) {
            return Some(part(req, h.value))
        }
    }
    None
}

fn body(req: Request) -> Bytes {
    std.http.copy_bytes(list.slice(req.input, req.body_at, req.body_at + req.body_len))
}

fn text_of(take b: Bytes) -> String {
    match string.from_utf8(take b) {
        Ok(take t) => take t,
        Error(_) => string.new()
    }
}

// The path's segments after the leading slash, without the query.
fn segments(target: Bytes) -> List[String] {
    let mut out: List[String] = list.new()
    let mut current: Bytes = list.new()
    let mut started = false
    for b in target {
        if b == 63u8 {
            break
        }
        if b == 47u8 {
            if started {
                list.push(mut out, text_of(replace(mut current, list.new())))
            }
            started = true
        } else {
            list.push(mut current, b)
        }
    }
    if started {
        list.push(mut out, text_of(take current))
    }
    out
}

// The value of `name=` in the target's query, as a decimal.
fn query_uint(target: Bytes, name: String) -> Option[u64] {
    let mut at = 0u64
    while at < list.len(target) && target[at] != 63u8 {
        at += 1u64
    }
    let key = string.as_bytes(name)
    while at < list.len(target) {
        let start = at + 1u64
        let mut end = start
        while end < list.len(target) && target[end] != 38u8 {
            end += 1u64
        }
        let n = list.len(key)
        if end > start + n && target[start + n] == 61u8 && std.http.copy_bytes(list.slice(target, start, start + n)) == key {
            return match std.int.parse_uint(text_of(std.http.copy_bytes(list.slice(target, start + n + 1u64, end))), 10) {
                Ok(v) => Some(v),
                Error(_) => None
            }
        }
        at = end
    }
    None
}

// The fresh status query follows the data queries and applies the same ACL.
fn history(d: harness.gateway.Door, f: Front, id: u64, identity: Identity, before: u64, lines: u64) -> Result[Page, u16] waits {
    let mut client = option.unwrap(reach(d, f, id, identity, 0u64, true)?)
    let page = history_page(mut client, f, before, lines)
    runner.client.close(take client)
    take page
}

fn reply(mut w: WriteHalf, f: Front, status: u16, take payload: Bytes) -> () waits {
    reply_with_retry(mut w, f, status, take payload, false)
}

fn reply_with_retry(mut w: WriteHalf, f: Front, status: u16, take payload: Bytes, retry: bool) -> () waits {
    let mut head = string.from("HTTP/1.1 ")
    string.push_uint(mut head, int.widen(status), 10u32, 3u64, '0')
    string.push(mut head, " \r\nContent-Length: ")
    string.push_u64(mut head, list.len(payload))
    if list.len(payload) > 0u64 {
        string.push(mut head, "\r\nContent-Type: application/json")
    }
    if retry { string.push(mut head, "\r\nRetry-After: 5") }
    string.push(mut head, "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
    let _ = std.http.write_wire(mut w, string.into_bytes(take head), payload, f.clock, deadline_ms(f.clock, f.within_ms))
}

fn json_reply[V: codec](mut w: WriteHalf, f: Front, status: u16, v: V) -> () waits {
    let Ok(format) = (std.json.interop() : Result[std.json.Format[V], std.json.TypedError]) else {
        return reply(mut w, f, 500u16, list.new())
    }
    match std.json.to_string(format, v) {
        Ok(take text) => reply(mut w, f, status, string.into_bytes(take text)),
        Error(_) => reply(mut w, f, 500u16, list.new()),
    }
}

fn json_body[V: codec](req: Request, f: Front) -> Option[V] {
    let Ok(format) = (std.json.interop() : Result[std.json.Format[V], std.json.TypedError]) else {
        return None
    }
    match std.json.decode_typed(format, body(req), f.body_max) {
        Ok(take v) => Some(take v),
        Error(_) => None
    }
}

type Conn: send {
    door: harness.gateway.Door,
    front: Front,
    socket: Socket,
    slot: u64,
    done: Sender[FrontEvent],
    quit: Receiver[()]
}

fn connection(take job: Conn) -> () waits {
    let Conn(door: take d, front: take f, socket: take socket, slot: slot, done: take done, quit: take quit) = take job
    let (r, w) = net.split(take socket)
    let mut read = take r
    let mut write = take w
    serve_one(d, f, mut read, mut write, quit)
    let _ = channel.send(done, Finished(slot))
}

fn serve_one(d: harness.gateway.Door, f: Front, mut read: ReadHalf, mut write: WriteHalf, quit: Receiver[()]) -> () waits {
    let req = match read_request(mut read, f) {
        Ok(take q) => take q,
        Error(code) => return reply(mut write, f, code, list.new())
    }
    let method = part(req, req.head.method)
    let path = segments(part(req, req.head.target))
    if list.len(path) == 0u64 || path[0] != "sessions" {
        return reply(mut write, f, 404u16, list.new())
    }
    let identity = match bearer(f, req) {
        Ok(take b) => take b,
        Error(Rejected) => return reply(mut write, f, 401u16, list.new()),
        Error(Unavailable) => return reply_with_retry(mut write, f, 503u16, list.new(), true),
    }
    if list.len(path) == 1u64 {
        if method == b"GET" {
            return match visible_sessions(d, f, identity) {
                Ok(take ids) => json_reply(mut write, f, 200u16, ids),
                Error(code) => reply(mut write, f, code, list.new()),
            }
        }
        if method == b"POST" {
            return match harness.gateway.create_visible(d, body(req), Fresh(string.from(f.agent), clone(f.narrow)), clone(identity.caller)) {
                Ok(n) => json_reply(mut write, f, 201u16, n),
                Error(why) => reply(mut write, f, turned(why), list.new()),
            }
        }
        return reply(mut write, f, 405u16, list.new())
    }
    let Ok(id) = std.int.parse_uint(path[1], 10) else {
        return reply(mut write, f, 404u16, list.new())
    }
    if list.len(path) == 2u64 && method == b"DELETE" {
        if let Error(code) = allowed(d, f, id, identity) {
            return reply(mut write, f, code, list.new())
        }
        return match harness.gateway.delete(d, id) {
            Ok(()) => reply(mut write, f, 204u16, list.new()),
            Error(why) => reply(mut write, f, turned(why), list.new())
        }
    }
    if list.len(path) != 3u64 {
        return reply(mut write, f, 404u16, list.new())
    }
    if path[2] == "messages" && method == b"POST" {
        let p = match request_position(req) {
            Ok(take w) => take w,
            Error(code) => return reply(mut write, f, code, list.new())
        }
        let Some(take m) = (json_body(req, f) : Option[harness.Submit]) else {
            return reply(mut write, f, 400u16, list.new())
        }
        return match call_place(d, f, id, identity, p, f.submit, take m) {
            Ok(take placed) => {
                harness.gateway.nudge(d, id);
                json_reply(mut write, f, 202u16, placed)
            },
            Error(code) => reply(mut write, f, code, list.new()),
        }
    }
    if path[2] == "decisions" && method == b"POST" {
        let p = match request_position(req) {
            Ok(take w) => take w,
            Error(code) => return reply(mut write, f, code, list.new())
        }
        let Some(take decision) = (json_body(req, f) : Option[harness.Decision]) else {
            return reply(mut write, f, 400u16, list.new())
        }
        return match call_place(d, f, id, identity, p, f.decide, take decision) {
            Ok(take ruling) => {
                harness.gateway.nudge(d, id);
                json_reply(mut write, f, 200u16, ruling)
            },
            Error(code) => reply(mut write, f, code, list.new()),
        }
    }
    if path[2] == "forks" && method == b"POST" {
        let Some(take ask) = (json_body(req, f) : Option[ForkAsk]) else {
            return reply(mut write, f, 400u16, list.new())
        }
        if let Error(code) = allowed(d, f, id, identity) {
            return reply(mut write, f, code, list.new())
        }
        let ForkAsk(key: take key, cut: cut) = take ask
        return match harness.gateway.fork(d, id, cut, string.into_bytes(take key), clone(identity.caller)) {
            Ok(n) => json_reply(mut write, f, 201u16, n),
            Error(Place(Failed(_))) => reply(mut write, f, 422u16, list.new()),
            Error(why) => reply(mut write, f, turned(why), list.new()),
        }
    }
    if path[2] == "releases" {
        return release_route(d, f, id, identity, method, req, mut write)
    }
    if path[2] == "history" && method == b"GET" {
        let target = part(req, req.head.target)
        let Some(before) = query_uint(target, "before") else {
            return reply(mut write, f, 400u16, list.new())
        }
        let Some(lines) = query_uint(target, "lines") else {
            return reply(mut write, f, 400u16, list.new())
        }
        if before < 2u64 || lines == 0u64 || lines > PAGE_LINES_MAX {
            return reply(mut write, f, 400u16, list.new())
        }
        return match history(d, f, id, identity, before, lines) {
            Ok(take page) => json_reply(mut write, f, 200u16, page),
            Error(code) => reply(mut write, f, code, list.new()),
        }
    }
    if path[2] == "waits" && method == b"GET" {
        let mut client = match reach(d, f, id, identity, 0u64, true) {
            Ok(take opened) => option.unwrap(take opened),
            Error(code) => return reply(mut write, f, code, list.new()),
        }
        let waits = waits_page(mut client, f)
        runner.client.close(take client)
        return match take waits {
            Ok(take rows) => json_reply(mut write, f, 200u16, rows),
            Error(code) => reply(mut write, f, code, list.new()),
        }
    }
    if path[2] == "events" && method == b"GET" {
        let tail = match query_uint(part(req, req.head.target), "tail") {
            Some(n) => n,
            None => f.tail_lines
        }
        if tail == 0u64 || tail > f.tail_lines {
            return reply(mut write, f, 400u16, list.new())
        }
        return follow(d, f, id, mut write, quit, identity, tail)
    }
    reply(mut write, f, 404u16, list.new())
}

// ---- serving ----
type FrontEvent: send = Accepted(Socket) | ListenerEnded | Finished(u64) | Halt

type Acceptor: send { listener: Listener, permit: Receiver[()], to: Sender[FrontEvent] }

fn accept_sockets(take job: Acceptor) waits {
    let Acceptor(listener: take listener, permit: take permit, to: take to) = take job
    let mut l = take listener
    while let Ok(()) = channel.receive(permit) {
        match host.accept(mut l, Never) {
            Ok((take socket, _)) => if let Error(_) = channel.send(to, Accepted(take socket)) { return },
            Error(_) => { let _ = channel.send(to, ListenerEnded); return },
        }
    }
}

type FrontJob: send {
    door: harness.gateway.Door,
    front: Front,
    listener: Listener,
    to: Sender[FrontEvent],
    inbox: Receiver[FrontEvent]
}

fn serve_front(take job: FrontJob) -> () waits {
    let FrontJob(door: take d, front: take f, listener: take listener, to: take to, inbox: take inbox) = take job
    let (permit, permits): (Sender[()], Receiver[()]) = channel.new(1u64)
    let acceptor = Acceptor(listener: take listener, permit: take permits, to: channel.sender(to))
    let accepting = task.spawn(f.tasks, bytes 8192u64, take acceptor, accept_sockets)
    let _ = channel.try_send(permit, ())
    let mut conns: Map[u64, (Sender[()], Task[()])] = map.new()
    let mut next = 0u64
    let run: fn(take Conn) -> () waits = connection
    while let Ok(take event) = channel.receive(inbox) {
        match take event {
            Accepted(take socket) => {
                if map.len(conns) >= f.conns_max {
                    let (_, w) = net.split(take socket)
                    let mut write = take w
                    reply(mut write, f, 503u16, list.new())
                } else {
                    let (h, quit): (Sender[()], Receiver[()]) = channel.new(1u64)
                    let conn = Conn(door: harness.gateway.copy_door(d), front: copy_front(f), socket: take socket, slot: next, done: channel.sender(to), quit: take quit)
                    let t = task.spawn(f.tasks, bytes f.conn_bytes, take conn, run)
                    map.insert(mut conns, next, (take h, take t))
                    next += 1u64
                }
                let _ = channel.try_send(permit, ())
            },
            Finished(slot) => if let Some((_, take t)) = map.remove(mut conns, slot) { let _ = task.join(take t) },
            Halt => break,
            ListenerEnded => break,
        }
    }
    let _ = task.cancel_join(take accepting)
    for (_, (h, _)) in conns { let _ = channel.try_send(h, ()) }
    for take (_, (_, take t)) in take conns { let _ = task.join(take t) }
}

// Serves the gateway behind `d` on `listener` until `halt`.
pub fn serve(d: harness.gateway.Door, take front: Front, take listener: Listener) -> Served {
    let (to, inbox): (Sender[FrontEvent], Receiver[FrontEvent]) = channel.new(front.conns_max + 2u64)
    let tasks = front.tasks
    // The supervisor and acceptor's buffers, and the connections' tasks.
    let room = 1048576u64 + front.conns_max * front.conn_bytes
    let job = FrontJob(door: harness.gateway.copy_door(d), front: take front, listener: take listener, to: channel.sender(to), inbox: take inbox)
    let run: fn(take FrontJob) -> () waits = serve_front
    let serving = task.spawn(tasks, bytes room, take job, run)
    Served(to: take to, serving: take serving)
}

// Stops accepting, ends every open stream and waits for every connection's task.
pub fn halt(take s: Served) -> () waits {
    let Served(to: take to, serving: take serving) = take s
    let _ = channel.send(to, Halt)
    let _ = task.join(take serving)
}

/// A deterministic object medium over a Test Dir. All objects are immutable;
/// every completed call adds virtual ticks without delaying a thread. The
/// administrator chooses operation ordinals for failures, lost replies, races
/// or a create whose durability barrier fails after it became visible.
pub type Sim {
  dir: Dir,
  operations: u64,
  ticks: u64,
  latency: u64,
  fail_at: u64,
  lost_reply_at: u64,
  race_at: u64,
  barrier_fail_at: u64,
  // The largest object a create accepts; a larger one is refused unwritten.
  max_object_bytes: u64,
}

pub fn simulated(d: Dir, latency: u64, fail_at: u64, lost_reply_at: u64, race_at: u64) -> Sim {
  Sim(
    dir: d,
    operations: 0,
    ticks: 0,
    latency: latency,
    fail_at: fail_at,
    lost_reply_at: lost_reply_at,
    race_at: race_at,
    barrier_fail_at: 0,
    max_object_bytes: 16777216
  )
}

/// The same medium accepting objects of at most `cap` bytes.
pub fn with_object_cap(take sim: Sim, cap: u64) -> Sim {
  let mut capped = take sim
  capped.max_object_bytes = cap
  capped
}

/// The same medium whose create at operation `at` becomes visible without its
/// durability barrier and reports the failure, as a host whose directory sync
/// fails after the link does.
pub fn with_failed_barrier(take sim: Sim, at: u64) -> Sim {
  let mut failing = take sim
  failing.barrier_fail_at = at
  failing
}

pub fn simulated_backend() -> store.Backend[Sim] uses {} {
  store.Backend(
    read: sim_read,
    put_new: sim_put,
    list: sim_list,
    remove: sim_remove,
    mkdir: sim_mkdir,
    max_object_bytes: sim_max_object_bytes
  )
}

fn sim_max_object_bytes(mut state: Sim) -> u64 uses {} {
  state.max_object_bytes
}

fn advance(mut state: Sim) -> Result[(), FileError] uses {} {
  state.operations += 1
  state.ticks += state.latency
  if state.operations == state.fail_at {
    return Error(FileFault(1))
  }
  Ok(())
}

fn sim_read(mut state: Sim, name: String) -> Result[Bytes, FileError] {
  advance(mut state)?
  file.read_bytes(state.dir, path.of(name))
}

fn sim_put(mut state: Sim, name: String, data: Bytes, mode: Durability) -> Result[
  (),
  store.PutError
] {
  // An injected failure happens before the request has any effect.
  if let Error(e) = advance(mut state) {
    return Error(Refused(e))
  }
  if bytes.len(data) > state.max_object_bytes {
    return Error(Refused(FileFault(1)))
  }
  if state.operations == state.race_at {
    put_object(state.dir, name, b"competing writer", Durable())?
  }
  if state.operations == state.barrier_fail_at {
    put_object(state.dir, name, data, Volatile())?
    return Error(Undecided(FileFault(3)))
  }
  put_object(state.dir, name, data, mode)?
  if state.operations == state.lost_reply_at {
    return Error(Undecided(FileFault(2)))
  }
  Ok(())
}

fn put_object(d: Dir, name: String, data: Bytes, mode: Durability) -> Result[
  (),
  store.PutError
] uses {d} {
  match file.put_new(d, path.of(name), unique data, mode) {
    Ok(()) => Ok(()),
    Error(AlreadyExists()) => Error(Taken()),
    Error(e) => Error(Undecided(e)),
  }
}

fn sim_list(mut state: Sim, name: String) -> Result[List[String], FileError] {
  advance(mut state)?
  let entries = file.read_dir(state.dir, path.of(name))?
  let mut names: List[String] = []
  for item in take entries {
    let entry = item?
    list.push(mut names, path.text(entry.path))
  }
  Ok(take names)
}

fn sim_remove(mut state: Sim, name: String) -> Result[(), FileError] {
  advance(mut state)?
  file.remove(state.dir, path.of(name))
}

fn sim_mkdir(mut state: Sim, name: String) -> Result[(), FileError] {
  advance(mut state)?
  file.mkdir(state.dir, path.of(name))
}

#!/usr/bin/env bash
# Build the compiler's engine libLLVM (`engine_llvm` in llvm-23.lock): PGO + ThinLTO.
#
#   build-libllvm DIR ARTIFACTS [instr|train|opt|guard|plain]
#
# ARTIFACTS is a core/tools/measurement_artifacts.py identity (compiler and runtime
# archive). With no stage, runs instr, train, opt and guard in order, then prints the
# `engine_llvm` and `engine_llvm_guard` lock records.
#
#   instr  IR-instrumented libLLVM.so.23.1 from the locked source archive
#   train  every training program of engine_llvm.py through it, merged into DIR/llvm.profdata
#   opt    the profile-guided ThinLTO libLLVM.so.23.1, debug info stripped, as DIR/libLLVM.so.23.1
#   guard  engine_llvm.py guard: the stock library against DIR/libLLVM.so.23.1 on the training
#          and held-out programs. Fails unless every .text is byte-identical and the warm build
#          cost geomean is below the stock library's and no worse than the lock's previous
#          `engine_llvm_guard` record
#   plain  the same configuration without profile or ThinLTO, as DIR/plain/lib/libLLVM.so.23.1:
#          the fallback when a profile build fails its guard (about 0.88 of the stock library's
#          warm cost against 0.64 for the profile build)
#
# The stage compiler is the pinned tree's clang, lld, llvm-tblgen and llvm-profdata, so the
# profile format and the library version match the pin. Configuration: Release without
# assertions; targets X86 and AArch64, the only ones the compiler initialises (engine.c);
# a dylib; -fno-semantic-interposition; zlib on; zstd, libxml2, libedit, terminfo, ffi, z3
# and libpfm off. The result loads only libz, libstdc++, libm, libgcc_s and libc.
#
# Each compile stage runs under tools/capped (16G) at nice 19 with JOBS jobs (default 12),
# on CPUS if set (a taskset list), after the 1-minute load falls to MAX_LOAD (default 32).
# About 2.7 CPU-hours at 12 jobs: instr 4.5 min, train 3 min, opt 6 min of wall time.
#
# Run once per pin change on an x86_64 Ubuntu 24.04 host, then upload DIR/libLLVM.so.23.1 to
# the release in `deb_pool` under the printed asset name and write both records into
# llvm-23.lock. Nothing rebuilds it per land.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lock="$here/llvm-23.lock"
tree="$here/../buck2/toolchains/llvm-files"
fail() { echo "build-libllvm: $*" >&2; exit 1; }
(( $# == 2 || $# == 3 )) || { echo "usage: build-libllvm DIR ARTIFACTS [instr|train|opt|guard|plain]" >&2; exit 2; }
lock_value() {
  awk -v k="$1" '$1 == k { sub(/^[^ ]+ /, ""); print; found = 1 } END { exit !found }' "$lock" \
    || fail "llvm-23.lock has no '$1' record"
}

mkdir -p "$1"
dir="$(cd "$1" && pwd)"
artifacts="$(realpath "$2")"
jobs=${JOBS:-12}
version="$(lock_value llvm_version)"
[[ -x "$tree/bin/clang" ]] || fail "no pinned LLVM tree at $tree (run tools/buck2/sync.py)"
tree="$(cd "$tree" && pwd)"
# The tree's clang finds libclang-cpp and libLLVM only through the loader path.
export LD_LIBRARY_PATH="$tree/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

wait_load() { while awk -v m="${MAX_LOAD:-32}" '{ exit !($1 > m) }' /proc/loadavg; do sleep 60; done; }
capped() {
  wait_load
  HIRSEL_JOBS=$jobs HIRSEL_MEMORY_LIMIT=16G "$here/../capped" --long nice -n 19 ${CPUS:+taskset -c "$CPUS"} "$@"
}

source_tree() {
  [[ -d "$dir/src/llvm" ]] && return
  local archive="$dir/llvm-project-$version.src.tar.xz"
  [[ -f "$archive" ]] || curl -fsSL "$(lock_value source_url)" -o "$archive" || fail "could not download the source archive"
  [[ "$(sha256sum "$archive" | cut -d ' ' -f 1)" == "$(lock_value source_sha256)" ]] || fail "$archive does not have the locked SHA-256"
  mkdir "$dir/src.partial"
  tar xf "$archive" --strip-components=1 -C "$dir/src.partial"
  mv "$dir/src.partial" "$dir/src"
}

configure() {  # configure BUILD EXTRA...
  local build=$1; shift
  rm -rf "$build"
  cmake -G Ninja -S "$dir/src/llvm" -B "$build" \
    -DCMAKE_BUILD_TYPE=Release -DLLVM_ENABLE_ASSERTIONS=OFF \
    -DCMAKE_C_COMPILER="$tree/bin/clang" -DCMAKE_CXX_COMPILER="$tree/bin/clang++" \
    -DCMAKE_AR="$tree/bin/llvm-ar" -DCMAKE_RANLIB="$tree/bin/llvm-ranlib" -DLLVM_USE_LINKER=lld \
    -DCMAKE_EXE_LINKER_FLAGS="-B$tree/bin" -DCMAKE_SHARED_LINKER_FLAGS="-B$tree/bin" \
    -DCMAKE_C_FLAGS=-fno-semantic-interposition -DCMAKE_CXX_FLAGS=-fno-semantic-interposition \
    -DLLVM_NATIVE_TOOL_DIR="$tree/bin" -DLLVM_TABLEGEN="$tree/bin/llvm-tblgen" \
    -DLLVM_TARGETS_TO_BUILD='X86;AArch64' -DLLVM_ENABLE_PROJECTS= \
    -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON \
    -DLLVM_ENABLE_ZLIB=FORCE_ON -DLLVM_ENABLE_ZSTD=OFF -DLLVM_ENABLE_LIBXML2=OFF -DLLVM_ENABLE_LIBEDIT=OFF \
    -DLLVM_ENABLE_TERMINFO=OFF -DLLVM_ENABLE_FFI=OFF -DLLVM_ENABLE_Z3_SOLVER=OFF -DLLVM_ENABLE_LIBPFM=OFF \
    -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_INCLUDE_DOCS=OFF \
    -DLLVM_PARALLEL_LINK_JOBS=1 "$@" > "$build.cmake.log"
}

library() {  # library BUILD
  capped ninja -C "$1" -j "$jobs" LLVM > "$1.ninja.log" || fail "the LLVM build in $1 failed (see $1.ninja.log)"
}

instr() {
  source_tree
  configure "$dir/instr" -DLLVM_BUILD_INSTRUMENTED=IR -DLLVM_PROFILE_DATA_DIR="$dir/profiles"
  library "$dir/instr"
}

train() {
  [[ -f "$dir/instr/lib/libLLVM.so.23.1" ]] || fail "no instrumented library: run the instr stage"
  rm -rf "$dir/profiles" && mkdir "$dir/profiles"
  LLVM_PROFILE_FILE="$dir/profiles/%m-%p.profraw" capped \
    python3 "$here/engine_llvm.py" train "$dir/instr/lib" "$dir/train" --artifacts "$artifacts"
  "$tree/bin/llvm-profdata" merge -o "$dir/llvm.profdata" "$dir"/profiles/*.profraw
}

opt() {
  [[ -f "$dir/llvm.profdata" ]] || fail "no profile: run the train stage"
  source_tree
  configure "$dir/opt" -DLLVM_ENABLE_LTO=Thin -DLLVM_PROFDATA_FILE="$dir/llvm.profdata" \
    -DCMAKE_SHARED_LINKER_FLAGS="-B$tree/bin -Wl,--thinlto-jobs=$jobs" \
    -DLLVM_THINLTO_CACHE_PATH="$dir/opt/thinlto-cache"
  library "$dir/opt"
  "$tree/bin/llvm-strip" --strip-debug -o "$dir/libLLVM.so.23.1" "$dir/opt/lib/libLLVM.so.23.1"
  [[ "$(readelf -d "$dir/libLLVM.so.23.1" | awk '/\(SONAME\)/ { print $NF }')" == '[libLLVM.so.23.1]' ]] \
    || fail "the library's soname is not libLLVM.so.23.1"
  local needed
  needed="$(readelf -d "$dir/libLLVM.so.23.1" | awk '/\(NEEDED\)/ { print $NF }' | sort | tr '\n' ' ')"
  [[ "$needed" == '[ld-linux-x86-64.so.2] [libc.so.6] [libgcc_s.so.1] [libm.so.6] [libstdc++.so.6] [libz.so.1] ' ]] \
    || fail "the library loads more than libz, libstdc++, libm, libgcc_s and libc: $needed"
}

guard() {
  [[ -f "$dir/libLLVM.so.23.1" ]] || fail "no engine library: run the opt stage"
  local previous=()
  if grep -q '^engine_llvm_guard ' "$lock"; then previous=(--previous-warm "$(lock_value engine_llvm_guard)"); fi
  python3 "$here/engine_llvm.py" guard "$tree/lib" "$dir" "$dir/guard" --artifacts "$artifacts" "${previous[@]}" \
    || fail "the engine library fails its guard (see $dir/guard/guard.json)"
}

plain() {
  source_tree
  configure "$dir/plain"
  library "$dir/plain"
}

case ${3:-all} in
  instr | train | opt | guard | plain) "$3" ;;
  all)
    instr
    train
    opt
    guard
    echo "engine_llvm $(sha256sum "$dir/libLLVM.so.23.1" | cut -d ' ' -f 1) $(stat -c %s "$dir/libLLVM.so.23.1") libLLVM-$version-engine-x86_64.so"
    echo "engine_llvm_guard $(python3 -c 'import json, sys; print(f"{json.load(open(sys.argv[1]))["warm"]:.4f}")' "$dir/guard/guard.json")"
    ;;
  *) fail "unknown stage '$3'" ;;
esac

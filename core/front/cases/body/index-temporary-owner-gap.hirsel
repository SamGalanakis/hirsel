// LANG-6/OWN-8: expected result is 3; the let/block value must retain its List owner.
// Kept explicit until the shared temporary-reach mechanism also serves field/view reads.
// expect: gap a view of an indexed temporary owner is not built
fn mk()->List[String] {
 let mut xs:List[String]=list.new()
 let _=list.push(mut xs,"abc")
 xs
}
fn immediate()->u64 { string.byte_len(mk()[0]) }
fn let_bound()->u64 { let v=mk()[0]; string.byte_len(v) }
fn nested()->u64 { let v={mk()[0]}; string.byte_len(v) }

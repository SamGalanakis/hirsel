// rule: STORE-11
// expect: run
// authorities: {"l1":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":1,"crash_at":1}},"l10":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":10,"crash_at":10}},"l11":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":11,"crash_at":11}},"l12":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":12,"crash_at":12}},"l13":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":13,"crash_at":13}},"l14":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":14,"crash_at":14}},"l15":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":15,"crash_at":15}},"l16":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":16,"crash_at":16}},"l17":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":17,"crash_at":17}},"l18":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":18,"crash_at":18}},"l19":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":19,"crash_at":19}},"l2":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":2,"crash_at":2}},"l20":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":20,"crash_at":20}},"l21":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":21,"crash_at":21}},"l3":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":3,"crash_at":3}},"l4":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":4,"crash_at":4}},"l5":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":5,"crash_at":5}},"l6":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":6,"crash_at":6}},"l7":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":7,"crash_at":7}},"l8":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":8,"crash_at":8}},"l9":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":9,"crash_at":9}}}
// cuts: 1..=21
// steps: 20000000
// Each cut hashes every commit and checkpoint with the interpreted SHA-256.
// Checkpoints over a simulated log whose history is cut at each authority
// request in turn; authority `lN` applies request N, loses its answer, then fails the power. The one level is disk and the
// floor, so an Ok commit is durable.
// The history is fixed: open a store; commit 1 puts six values of 2000
// bytes and twelve small ones; compact;
// commit 3 overwrites one large value, deletes another and a small one and adds
// a small one; commit 4 adds a value of 2250 bytes; compact; commit 6 deletes
// a large value and overwrites a small one; close.
// After each cut the store reopens holding exactly the model's rows after some
// step j, j at least the last step that returned Ok and at most the last that
// may have happened. The history then finishes from the step after j, its
// compactions putting nodes the cut one may already have put, and a reopen
// holds the model's end state.
// Every `lN` up to the history's last request stops the history there, and
// the one past it, the last declared cut, lets the history finish.
// Each run makes one cut, K, of the declared cuts; the last lets the
// history finish.
// stdout: checkpoints: 0

// The cut this case makes at each request.
const KIND: String = "l"

// A value of `len` bytes, each `fill`, built by doubling.
fn value(fill: u8, len: u64) -> Bytes {
  let mut out: List[u8] = [fill]
  while list.len(out) * 2 <= len {
    let half = bytes.from_list(copy out)
    bytes.append(mut out, half)
  }
  let have = list.len(out)
  if have < len {
    let head = bytes.from_list(copy out)
    bytes.append(mut out, bytes.slice(head, 0, len - have))
  }
  bytes.from_list(take out)
}

fn big(i: u8) -> Bytes {
  bytes.from_list([98u8, 47u8, 48u8 + i])
}

fn small(i: u8) -> Bytes {
  bytes.from_list([115u8, 47u8, 48u8 + i / 10, 48u8 + i % 10])
}

// One write of a step: the key, and the fill and length of its value, or a
// deletion when the length is 0.
type Write {
  key: Bytes,
  fill: u8,
  len: u64,
}

// The writes of step j; compactions (2 and 5) write nothing.
fn writes(j: u8) -> List[Write] {
  let mut w: List[Write] = []
  if j == 1 {
    for i in 1u8..7u8 {
      list.push(mut w, Write(key: big(i), fill: i, len: 2000))
    }
    for i in 1u8..13u8 {
      list.push(mut w, Write(key: small(i), fill: 20 + i, len: 50))
    }
  } else if j == 3 {
    list.push(mut w, Write(key: big(2), fill: 7, len: 1875))
    list.push(mut w, Write(key: big(3), fill: 0, len: 0))
    list.push(mut w, Write(key: small(3), fill: 0, len: 0))
    list.push(mut w, Write(key: small(13), fill: 33, len: 50))
  } else if j == 4 {
    list.push(mut w, Write(key: big(7), fill: 8, len: 2250))
  } else if j == 6 {
    list.push(mut w, Write(key: big(1), fill: 0, len: 0))
    list.push(mut w, Write(key: small(1), fill: 9, len: 20))
  }
  w
}

fn compaction(j: u8) -> bool {
  j == 2 || j == 5
}

const STEPS: u8 = 6

fn step(mut tx: store.Tx, info: store.CallInfo, j: u8) -> Result[u8, store.TxError] {
  for w in writes(j) {
    if w.len == 0 {
      store.tx_delete(mut tx, copy w.key)?
    } else {
      store.tx_put(mut tx, copy w.key, value(w.fill, w.len))?
    }
  }
  Ok(j)
}

// The model: the keys after step j, ascending, each with its value's fill and
// length.
fn want(j: u8) -> List[Write] {
  let mut m: List[Write] = []
  for i in 1u8..j + 1 {
    for w in writes(i) {
      let mut next: List[Write] = []
      let mut placed = false
      for old in m {
        if !placed && w.key <= old.key {
          if w.len > 0 {
            list.push(mut next, copy w)
          }
          placed = true
          if w.key != old.key {
            list.push(mut next, copy old)
          }
        } else {
          list.push(mut next, copy old)
        }
      }
      if !placed && w.len > 0 {
        list.push(mut next, copy w)
      }
      m = take next
    }
  }
  m
}

pub type Failed = Check(String) | Store(store.StoreError)

fn check(ok: bool, take what: String) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check(what))
  }
}

// Every user row of the store's state at its floor.
fn rows(a: Authority, mut s: store.Store) -> Result[List[(Bytes, Bytes)], Failed] {
  let snap = store.snapshot(a, mut s, authority.floor(a)) ? Store
  let mut user: List[(Bytes, Bytes)] = []
  for (k, v) in store.range(snap, Unbounded(), Unbounded(), Ascending(), 100) {
    if !store.reserved(k) {
      list.push(mut user, (copy k, copy v))
    }
  }
  Ok(user)
}

// Whether the rows are the model's after step j.
fn holds(r: List[(Bytes, Bytes)], j: u8) -> bool {
  let m = want(j)
  if list.len(r) != list.len(m) {
    return false
  }
  for i in 0u64..list.len(m) {
    let (k, v) = copy r[i]
    if k != m[i].key || v != value(m[i].fill, m[i].len) {
      return false
    }
  }
  true
}

// The step whose model the rows are, the commit when a compaction after it
// shares its model, so finishing from there compacts again over the nodes
// already put; 255 when they are no step's.
fn which(r: List[(Bytes, Bytes)]) -> u8 {
  for j in 0u8..STEPS + 1 {
    if holds(r, j) {
      return j
    }
  }
  255
}

// What the history learned: `low`, the last step an Ok covered (the floor is
// the one level, so an Ok commit is durable), and `high`, the last step that
// may have happened.
type Known {
  low: u8,
  high: u8,
  finished: bool,
}

// Runs steps from `first` on, stopping at the first failure.
fn steps_from(mut s: store.Store, mut k: Known, first: u8) -> bool {
  for j in first..STEPS + 1 {
    if compaction(j) {
      if store.compact(mut s) != Ok(()) {
        return false
      }
      k.low = j
      k.high = j
    } else {
      let r: Result[u8, store.TxFailure[store.TxError]] = store.transact(mut s, step, j)
      match r {
        Ok(_) => {
          k.low = j
          k.high = j
        },
        Error(Unknown(_)) => {
          k.high = j
          return false
        },
        _ => return false,
      }
    }
  }
  true
}

// The fixed history.
fn history(a: Authority, mut k: Known) -> () {
  let Ok(opened) = store.open(a, store.default_config()) else {
    return ()
  }
  let mut s = take opened
  if !steps_from(mut s, mut k, 1) {
    return ()
  }
  if store.close(take s) == Ok(()) {
    k.finished = true
  }
}

fn reopen(a: Authority, name: String, what: String) -> Result[store.Store, Failed] {
  match store.open(a, store.default_config()) {
    Ok(s) => Ok(s),
    Error(_) => Error(Check(f"{name}: {what} refused")),
  }
}

// Recovers the store a cut history left and checks it against `k`, then
// finishes the history from the recovered step and checks the end state.
fn recover(a: Authority, name: String, k: Known) -> Result[(), Failed] {
  let mut s = reopen(a, name, "reopen")?
  let seen = rows(a, mut s)?
  let j = which(seen)
  check(
    j != 255,
    f"{name}: {list.len(seen)} rows, no step's state, history {k.low}..{k.high}"
  )?
  // Rows that are a compaction's state are also its commit's.
  let low = if compaction(k.low) {
    k.low - 1
  } else {
    k.low
  }
  check(
    low <= j && j <= k.high,
    f"{name}: recovered step {j} outside {k.low}..{k.high}"
  )?
  let mut rest = Known(low: j, high: j, finished: false)
  check(steps_from(mut s, mut rest, j + 1), f"{name}: finishing from step {j} failed")?
  store.close(take s) ? Store
  let mut last = reopen(a, name, "last reopen")?
  let end = rows(a, mut last)?
  check(
    holds(end, STEPS),
    f"{name}: finished from step {j}, {list.len(end)} rows, not the end state"
  )?
  Ok(())
}

// Argument i of the run: the corpus driver runs the case once per declared cut
// K, with the arguments K and the last declared cut.
fn cut_arg(args: Args, i: u64) -> Result[u64, Failed] {
  match arg.text(args, i) {
    Ok(text) => match u64.parse(text) {
      Ok(k) => Ok(k),
      Error(_) => Error(Check(f"argument {i} is not a cut")),
    },
    Error(_) => Error(
      Check(f"argument {i} is missing: the corpus driver runs each cut")
    ),
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Check("stdout"))
  }
  let r = run(rt, stdout, args)
  if let Error(Check(what)) = r {
    let _ = out.print(stdout, f"{what}\n")
  }
  r
}

fn run(rt: Io, stdout: Stdout, args: Args) -> Result[(), Failed] {
  let n = cut_arg(args, 0)?
  let end = cut_arg(args, 1)?
  let name = f"{KIND}{n}"
  let Ok(a) = io.authority(rt, name) else {
    return Error(Check(f"{name} not granted"))
  }
  let mut cut = Known(low: 0, high: 0, finished: false)
  history(a, mut cut)
  let mut failures: u64 = 0
  if n == end {
    // Every cut stops the history at its request, so the one past its end
    // lets it finish.
    check(cut.finished, f"{name} stopped the history: it is longer than its cuts")?
  } else {
    check(!cut.finished, f"{name} let the history finish: it is shorter than its cuts")?
    if let Error(e) = recover(a, name, cut) {
      failures += 1
      let line = match e {
        Check(what) => what,
        Store(_) => f"{name}: store error",
      }
      let _ = out.print(stdout, f"{line}\n")
    }
  }
  let _ = out.print(stdout, f"checkpoints: {failures}\n")
  Ok(())
}

type Event: send = Line(String) | Cleanup(String)

resource type Temp {
    parent: Dir,
    name: String
} drop(t) {
    let _ = std.dir.remove_all(t.parent, t.name)
}

resource type Owned grant bytes 1024 {
    handle: Option[HostFile],
    lock: Option[std.file.Lock],
    name: String,
    injected: bool,
    tx: Sender[Event]
} drop(f) {
    let mut failed = false
    if let Some(take lock) = replace(mut f.lock, None) {
        let handle = match std.file.unlock(take lock) {
            Ok(take h) => h,
            Error((_, take h)) => {
                failed = true;
                h
            }
        }
        if let Error(_) = std.file.close(take handle) {
            failed = true
        }
    }
    if let Some(take h) = replace(mut f.handle, None) {
        if let Error(_) = std.file.close(take h) {
            failed = true
        }
    }
    let _ = event(f.tx, "release=", f.name)
    if failed || f.injected {
        let _ = event(f.tx, "cleanup-error=Io@release-", f.name)
        let cause = result.unwrap(string.from("Io@release-"))
        let mut label = cause
        let _ = string.push(mut label, f.name)
        let _ = channel.try_send(f.tx, Cleanup(take label))
    }
}

fn event(tx: Sender[Event], prefix: String, name: String) -> Result[(), m1.support.Error] {
    let mut line = m1.support.mem(string.from(prefix))?
    m1.support.add(mut line, name)?
    match channel.try_send(tx, Line(take line)) {
        Ok(()) => Ok(()),
        Error(_) => fail("trace capacity")
    }
}

fn acquired(take handle: Option[HostFile], take lock: Option[std.file.Lock], name: String, variant: String, tx: Sender[Event]) -> Result[Owned, m1.support.Error] {
    let mut failure = m1.support.mem(string.from("error-release-"))?
    m1.support.add(mut failure, name)?
    event(tx, "acquire=", name)?
    m1.support.mem(Owned(handle: take handle, lock: take lock, name: m1.support.mem(string.from(name))?, injected: variant == failure || variant == "error-cleanup-all", tx: channel.sender(tx)))
}

fn io[T](take r: Result[T, IoError], label: String) -> Result[T, m1.support.Error] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(_) => Error(m1.support.error(m1.support.mem(string.from(label))?))
    }
}

fn copy_files(d: Dir, variant: String, tx: Sender[Event]) -> Result[(), m1.support.Error] waits {
    let source_path = if variant == "error-first" {
        "missing"
    } else {
        "source.txt"
    }
    let source_file = io(std.file.open(d, source_path, Read), "Io@open-source")?
    let mut source = acquired(Some(take source_file), None, "source", variant, tx)?
    let destination_file = io(std.file.open(d, "destination.txt", CreateNew), "Io@create-destination")?
    let mut destination = acquired(Some(take destination_file), None, "destination", variant, tx)?
    let lf = io(std.file.open(d, "lock.txt", Append), "Lock@acquire")?
    let locked = match std.file.try_lock(take lf) {
        Ok(take l) => l,
        Error(Capacity(c)) => return m1.support.mem(Error(c)),
        Error(_) => return Error(m1.support.error("Lock@acquire"))
    }
    let lock_owner = acquired(None, Some(take locked), "lock", variant, tx)?
    m1.support.admission(variant, "copy.buffer", 4096)?
    let mut buf: Bytes = m1.support.mem(list.with_capacity(4096))?
    let mut copied: u64 = 0
    loop {
        list.clear(mut buf)
        // The Option placeholders allow a whole-resource owner to keep fallible handles.
        let mut src = option.unwrap(replace(mut source.handle, None))
        let read = std.file.read_into(mut src, mut buf)
        source.handle = Some(take src)
        let n = io(take read, "Io@read")?
        if n == 0 {
            break
        }
        let inject = variant == "error-work" || variant == "error-cleanup-all"
        let count: u64 = if inject && n > 17 {
            17
        } else {
            n
        }
        let mut dst = option.unwrap(replace(mut destination.handle, None))
        let written = std.file.write_all(mut dst, list.slice(buf, 0, count))
        destination.handle = Some(take dst)
        if let Error(_) = written {
            return Error(m1.support.error("Io@write"))
        }
        copied += count
        if inject {
            return Error(m1.support.error("Io@copy"))
        }
    }
    event(tx, "copied=", m1.support.name("", copied, "")?)?
    Ok(())
}

fn run(out: Stdout, parent: Dir, input: String, variant: String, take tx: Sender[Event], take rx: Receiver[Event]) -> Result[(), m1.support.Error] waits {
    let mut name = m1.support.mem(string.with_capacity(32))?
    let directory = io(std.dir.create_temp(parent, mut name), "Io@temp")?
    let temporary = m1.support.mem(Temp(parent: parent, name: take name))?
    io(std.file.write(directory, "source.txt", string.as_bytes(input)), "Io@setup")?
    if variant == "error-second" {
        io(std.file.write(directory, "destination.txt", b"existing"), "Io@setup")?
    }
    let mut holder: Option[std.file.Lock] = None
    if variant == "error-lock" {
        let f = io(std.file.open(directory, "lock.txt", Append), "Io@setup")?
        holder = Some(match std.file.try_lock(take f) {
            Ok(take l) => l,
            Error(_) => return Error(m1.support.error("Lock@setup"))
        })
    }
    let outcome = copy_files(directory, variant, tx)
    let _ = replace(mut holder, None)
    let probe = io(std.file.open(directory, "lock.txt", Append), "Io@probe")?
    let free = match std.file.try_lock(take probe) {
        Ok(_) => true,
        Error(_) => false
    }
    let data = match std.file.read(directory, "destination.txt") {
        Ok(take b) => b,
        Error(Io(NotFound)) => list.new(),
        Error(_) => return Error(m1.support.error("Io@read-destination"))
    }
    {
        let closed = tx
    }
    let mut cleanups: List[String] = list.new()
    while let Ok(take e) = channel.receive(rx) {
        match take e {
            Line(take line) => {
                m1.support.put(out, line)?;
                m1.support.put(out, "\n")?
            },
            Cleanup(take label) => m1.support.push(mut cleanups, take label)?,
        }
    }
    let mut rendered = m1.support.name("destination-bytes=", list.len(data), " sum=")?
    m1.support.num(mut rendered, list.sum_bytes(data))?
    m1.support.add(mut rendered, if free {
        " lock-free=true\n"
    } else {
        " lock-free=false\n"
    })?
    m1.support.put(out, rendered)?
    let mut primary = outcome
    if let Ok(()) = primary {
        if list.len(cleanups) > 0 {
            primary = Error(m1.support.error(list.remove(mut cleanups, 0)))
        }
    }
    for cause in cleanups {
        m1.support.put(out, "suppressed=")?;
        m1.support.put(out, cause)?;
        m1.support.put(out, "\n")?
    }
    match take primary {
        Ok(()) => Ok(()),
        Error(take e) => {
            m1.support.put(out, "failure=")?;
            m1.support.put(out, e.label)?;
            m1.support.put(out, "\n")?;
            Error(take e)
        },
    }
}

pub fn main(out: Stdout, d: Dir, argv: Args) -> Result[(), m1.support.Error] waits {
    let input = m1.support.input(d, argv)?
    let (tx, rx): (Sender[Event], Receiver[Event]) = m1.support.mem(channel.new(16))?
    run(out, d, input, m1.support.case_variant(argv), take tx, take rx)
}

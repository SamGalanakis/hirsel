// R1b (RUNNER-SPEC v2.10 §8, L1 and calls25's crash scenarios) on a disk store, under the
// store's W2 crash adapter (core/tools/runner_crash.c). The adapter starts separate server and client processes for each phase,
// argv: phase (init, write, read), scenario, expected (new or prefix), floor. In write it
// cuts the filesystem at one mutation, or fails one named sync (poison-segment); its floor
// is the largest version this program reported with `ACK v`.
//
// Expected values come from the spec, not from the runner:
// - each body's reply is std.codec.put_result of its Result[u64, u32], or Failed(Raised(2))
//   for an index fault (RUNNER-SPEC §1.1), and does not depend on the version, so a reply
//   kept before a crash and one made after it are byte-equal (C3);
// - `bump` adds 1 to the counter row 0, so after every position is answered the counter
//   is the number of positions whose body committed: each effect once (C1);
// - a frame reporting a commit (Returned or Failed) comes from a durable Release (V4), so
//   the store recovered after any cut holds at least every version a client saw (L1);
// - a poisoned journal answers nothing (§2.1 Poison), so its floor holds too.
//
// Scenarios (calls25_model.py):
// - runner-cross (cross_session_crash): stream 0 p0 from two sessions, stream 1 p0 a typed
//   error from the second, then stream 0 p1 from the first;
// - runner-order (out_of_order_two_sessions): stream 0 p1 from one session before p0, a
//   fault, from the other;
// - poison-segment (poison): the cross calls, each sent once the previous is answered, with
//   the sync of the first call's effect frame failing.
// The adapter gives one cut per run, so runner-order has one crash where the model has two.
type Hd: shareable + send {
    t: store.Table[u64, u64]
}

type Calls = runner.Registry[(), Hd]

fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    let codec: std.codec.Codec[u64] = std.codec.of()
    match store.migration_create_table(mut phase, store.spec("data", std.codec.key_u64(), codec)) {
        Ok(()) => Ok(()),
        Error(Exists(_)) => Ok(()),
        Error(take problem) => Error(take problem),
    }
}

fn schema(mut d: store.Declare) -> Result[Hd, store.Error] {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let table = store.declare_table(mut d, "data", std.codec.key_u64(), cv)?
    let t = store.finish(mut d, take table)?
    Ok(Hd(t: t))
}

fn open_data(db: store.Db) -> Result[Hd, store.Error] {
    let mut declaration = store.declare(db, Open)?
    schema(mut declaration)
}

fn install_data(mut db: store.Db) -> Result[store.Ticket, store.Error] waits {
    let mut declaration = store.declare(db, Migrate)?
    let _ = schema(mut declaration)?
    store.seal(mut db, take declaration)
}

fn counted(tx: store.Tx, h: Hd) -> Result[u64, u32] {
    match store.fetch(tx, h.t, 0u64) {
        Ok(Some(n)) => Ok(n),
        Ok(None) => Ok(0u64),
        Error(_) => Error(1u32),
    }
}

// Adds 1 to the counter and returns k.
fn bump(mut tx: store.Tx, h: Hd, author: runner.Caller, take k: u64) -> Result[u64, u32] {
    let n = counted(tx, h)?
    match store.put(mut tx, h.t, 0u64, n + 1u64) {
        Ok(()) => Ok(k),
        Error(_) => Error(1u32),
    }
}

// Adds 1 to the counter, then returns a typed error, so the effect is aborted.
fn deny(mut tx: store.Tx, h: Hd, author: runner.Caller, take k: u64) -> Result[u64, u32] {
    let n = counted(tx, h)?
    let _ = store.put(mut tx, h.t, 0u64, n + 1u64)
    Error(7u32)
}

// Adds 1 to the counter, then faults (Bounds, Raised(2)).
fn trip(mut tx: store.Tx, h: Hd, author: runner.Caller, take k: u64) -> Result[u64, u32] {
    let n = counted(tx, h)?
    let _ = store.put(mut tx, h.t, 0u64, n + 1u64)
    let xs: List[u64] = list.new()
    Ok(xs[k])
}

fn place(mut r: Calls) -> Result[(), runner.RegisterError] {
    runner.transact(mut r, code.describe(bump), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(deny), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(trip), 65536u64, runner.DEFAULT_STEPS)
}

const N_PLACE: u64 = 1048576u64

fn key_of(id: View[Bytes]) -> Bytes {
    let mut key: Bytes = list.new()
    list.append(mut key, id)
    std.codec.put_u64(result.unwrap(std.codec.fingerprint(std.codec.of_u64())), mut key)
    let carried: std.codec.Codec[Result[u64, u32]] = std.codec.of()
    std.codec.put_u64(result.unwrap(std.codec.fingerprint(carried)), mut key)
    key
}

fn u64_bytes(x: u64) -> Bytes {
    let mut b: Bytes = list.new()
    std.codec.put_u64(x, mut b)
    b
}

fn want(ok: bool, take what: String) {
    if !ok {
        fail(take what)
    }
}

// Keep the install's staged catalog private until the launcher kills this child.
fn hold_install(mut phase: store.Migration) -> Result[(), store.Error] {
    migrate(mut phase)?
    loop {}
}

// H4 uses the same registry and durable counter as the W2 crash scenarios.
pub fn host_main(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, n: Net, process: Process, errors: Stderr) -> Result[(), Exit] waits {
    let serve = scoped fn(take stopping: Receiver[()]) -> Result[runner.Ended, runner.MainError] waits {
        let mut wire = runner.wire_defaults(131072u64)
        wire.n_pool = 4194304u64
        wire.socket.max_frame = 131072u64
        let mut disk = options()
        disk.lock_wait_ms = 10000u64
        let migration: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits] = match args.get(argv, 0u64) {
            Some(arg) if arg == "hold-install" => code.describe(hold_install),
            _ => code.describe(migrate),
        }
        let config: runner.PlaceConfig[(), Hd, (), ()] = runner.PlaceConfig(backing: Disk(d), sizes: store.Overrides(resident_limit: Some(disk.resident_limit), journal_limit: Some(disk.journal_limit), checkpoint_bytes: Some(disk.checkpoint_bytes), pack_bytes: Some(disk.pack_bytes), group_bytes: Some(int.widen(disk.group_bytes)), group_commits: Some(disk.group_commits), lock_wait_ms: Some(disk.lock_wait_ms), cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: (runner.launch_selection(argv) ?=> Usage), place: code.describe(place), n_place: N_PLACE, on_migrate: Some(migration), schema: code.describe(schema), session: wire, max_sessions: 4u64, proxies: list.new(), n_publisher: 3145728u64, listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: n, tasks: tasks, clock: c, random: r, stop: runner.Stop(lag_ms: 0u64, grace_ms: 1000u64), wire: Some(runner.ingress.binding()), grants: None, triggers: None, idle: None)
        let ended = runner.operate_report(take config, take stopping, result.unwrap(runner.status_root()), None, errors) ?=> Start
        Ok(ended)
    }
    runner.main(argv, process, errors, tasks, c, code.describe(place), code.describe(schema), serve)
}

// T1's executable uses a smaller configured allowance than its hosted recipe.
pub fn identity_main(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, n: Net, process: Process, errors: Stderr) -> Result[(), Exit] waits {
    let serve = scoped fn(take stopping: Receiver[()]) -> Result[runner.Ended, runner.MainError] waits {
        let n_place = 524288u64
        let mut wire = runner.wire_defaults(65536u64)
        wire.n_pool = 4194304u64
        let mut disk = options()
        disk.lock_wait_ms = 10000u64
        let config: runner.PlaceConfig[(), Hd, (), ()] = runner.PlaceConfig(backing: Disk(d), sizes: store.Overrides(resident_limit: Some(disk.resident_limit), journal_limit: Some(disk.journal_limit), checkpoint_bytes: Some(disk.checkpoint_bytes), pack_bytes: Some(disk.pack_bytes), group_bytes: Some(int.widen(disk.group_bytes)), group_commits: Some(disk.group_commits), lock_wait_ms: Some(disk.lock_wait_ms), cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: (runner.launch_selection(argv) ?=> Usage), place: code.describe(place), n_place: n_place, on_migrate: Some(code.describe(migrate)), schema: code.describe(schema), session: wire, max_sessions: 4u64, proxies: list.new(), n_publisher: 3145728u64, listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: n, tasks: tasks, clock: c, random: r, stop: runner.Stop(lag_ms: 0u64, grace_ms: 1000u64), wire: Some(runner.ingress.binding()), grants: None, triggers: None, idle: None)
        let ended = runner.operate_report(take config, take stopping, result.unwrap(runner.status_root()), None, errors) ?=> Start
        Ok(ended)
    }
    runner.main(argv, process, errors, tasks, c, code.describe(place), code.describe(schema), serve)
}

// A client verdict: empty when every call was answered as expected.
fn clean(take verdict: String) {
    if verdict != "" {
        fail(take verdict)
    }
}

fn same(a: runner.Outcome, b: runner.Outcome) -> bool {
    let co: std.codec.Codec[runner.Outcome] = std.codec.of()
    let mut x: Bytes = list.new()
    let mut y: Bytes = list.new()
    result.unwrap(std.codec.encode(co, a, mut x))
    result.unwrap(std.codec.encode(co, b, mut y))
    x == y
}

fn returned(r: Result[u64, u32]) -> runner.Outcome {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_result(r, std.codec.of_u64(), std.codec.of_u32(), mut b))
    Returned(take b)
}

// One position of a scenario: who sends it (session 0 or 1), its stream and p, its body
// (0 bump, 1 deny, 2 trip), its argument, and whether its body commits an effect.
type Pos: send {
    from: u64,
    stream: u64,
    p: u64,
    body: u64,
    k: u64
}

fn body_key(body: u64) -> Bytes {
    if body == 0u64 {
        key_of(code.identity(code.describe(bump)))
    } else if body == 1u64 {
        key_of(code.identity(code.describe(deny)))
    } else {
        key_of(code.identity(code.describe(trip)))
    }
}

fn expected(x: Pos) -> runner.Outcome {
    if x.body == 0u64 {
        returned(Ok(x.k))
    } else if x.body == 1u64 {
        returned(Error(7u32))
    } else {
        Failed(Raised(2u32))
    }
}

// Sends in this order; re-sends after a crash go in (stream, p) order.
fn positions(scenario: View[String]) -> List[Pos] {
    let mut xs: List[Pos] = list.new()
    if scenario == "runner-order" {
        list.push(mut xs, Pos(from: 1u64, stream: 0u64, p: 1u64, body: 0u64, k: 5u64))
        list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 0u64, body: 2u64, k: 0u64))
    } else {
        list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 0u64, body: 0u64, k: 1u64))
        list.push(mut xs, Pos(from: 1u64, stream: 0u64, p: 0u64, body: 0u64, k: 1u64))
        list.push(mut xs, Pos(from: 1u64, stream: 1u64, p: 0u64, body: 1u64, k: 2u64))
        list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 1u64, body: 0u64, k: 3u64))
    }
    xs
}

// The positions once each, in (stream, p) order, and the counter they leave.
fn resends(scenario: View[String]) -> (List[Pos], u64) {
    let mut xs: List[Pos] = list.new()
    if scenario == "runner-order" {
        list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 0u64, body: 2u64, k: 0u64))
        list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 1u64, body: 0u64, k: 5u64))
        (take xs, 1u64)
    } else {
        list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 0u64, body: 0u64, k: 1u64))
        list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 1u64, body: 0u64, k: 3u64))
        list.push(mut xs, Pos(from: 0u64, stream: 1u64, p: 0u64, body: 1u64, k: 2u64))
        (take xs, 2u64)
    }
}

fn options() -> store.Options {
    let mut o = result.unwrap(store.sized(Directory, 2147483648u64))
    o.resident_limit = 1048576u64
    o.pack_bytes = 512u64
    o.group_commits = 2u32
    o.group_bytes = 1048576u32
    o
}

// L31 uses the disk harness without a crash. The host supplies one random token
// and searches the files after the last acknowledged call and checkpoint.
type SecretClient: send {
    tasks: Tasks,
    net: Net,
    clock: Clock,
    random: Random,
    head: Sender[runner.HeadInput],
    post: Sender[runner.PubIn],
    token: Bytes
}

fn secret_client(take d: SecretClient) -> String waits {
    let SecretClient(tasks: tasks, net: n, clock: c, random: r, head: take head, post: take post, token: take token) = take d
    let mut keys: List[Bytes] = list.new()
    list.push(mut keys, body_key(0u64))
    let pair = runner.wire_client.pair(tasks, n, c, r, Some(runner.ingress.binding()), head, post, code.describe(place), keys, Some(take token), 1u64, 2097152u64)
    let (take wire, take server) = match take pair {
        Ok(take connected) => take connected,
        Error(Allocation(_)) => return "L31: client allocation refused",
        Error(Network(Denied)) => return "L31: loopback grant refused",
        Error(Network(_)) => return "L31: loopback connection failed",
        Error(_) => return "L31: handshake failed",
    }
    let _ = take head
    let birth = host.wall_ms(c)
    let mut answered = true
    for p in 0u64 .. 2u64 {
        runner.wire_client.send_frame(wire, Call(store.StreamId(t: birth, n: 7u64), p, 0u32, 5000u32, u64_bytes(p)))
        let ok = match runner.wire_client.next(wire) {
            Ok(Batch(_, _, _, ds)) => list.len(ds) == 1u64 && ds[0u64].stream == store.StreamId(t: birth, n: 7u64) && ds[0u64].p == p && same(ds[0u64].outcome, returned(Ok(p))),
            _ => false,
        }
        answered = answered && ok
    }
    let closed = runner.wire_client.close(take wire)
    let joined = match task.join(take server) {
        Ok(Ok(())) => true,
        _ => false
    }
    if !answered {
        return "L31: calls did not return"
    }
    if !closed || !joined {
        return "L31: connection did not close"
    }
    ""
}

pub fn no_secret_at_rest(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, n: Net) -> Result[(), Exit] waits {
    let encoded = option.unwrap(args.get(argv, 0u64))
    let token = option.unwrap(std.base64.decode(string.as_bytes(encoded)))
    let mut db = result.unwrap(store.open(tasks, d, c, r, options()))
    result.unwrap(install_data(mut db))
    let (head, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let mail = result.unwrap(runner.mailbox(4u64))
    let seed = SecretClient(tasks: tasks, net: n, clock: c, random: r, head: take head, post: runner.post(mail), token: take token)
    let driving = task.spawn(tasks, bytes 33554432u64, take seed, secret_client)
    result.unwrap(runner.place_head(take db, code.describe(place), N_PLACE, None, code.describe(schema), take inbox, take mail, tasks, 1048576u64))
    clean(result.unwrap(task.join(take driving)))
    let mut o = options()
    o.create = false
    let mut again = result.unwrap(store.open(tasks, d, c, r, o))
    let h = result.unwrap(open_data(again))
    let total = result.unwrap(store.get(result.unwrap(store.reader(again, 0u64)), store.snapshot(again), h.t, 0u64))
    want(total == Some(2u64), "L31: two effects must be durable")
    let ticket = result.unwrap(store.checkpoint(mut again))
    result.unwrap(store.durable(mut again, ticket))
    result.unwrap(store.close(take again))
    Ok(())
}

fn ack(out: Stdout, v: u64) waits {
    let mut line = string.with_capacity(32u64)
    string.push(mut line, "ACK ")
    string.push_u64(mut line, v)
    result.unwrap(stdout.write(out, line))
}

// The client consumes one pending send per answer, matched by session, stream and position.
// A frame that reports a commit raises the floor. Refused(HistoryUnavailable)
// is a valid answer only to a position with a later one on its stream: the later one is
// admitted only once this one is replied. The client never fails: a failed task would
// leave its sessions open and the head waiting, so it hangs up every session, drains
// each channel to its close, and returns its verdict (empty when every call was answered
// as expected) for the caller to fail on.
//
// `armed` is the poison run. It arms the named sync failure once both sessions are up, then
// sends each call only after the previous one is answered, so a call's commits are the only
// frames the head has handed the journal when it gates them (see main's poison note).
type Client {
    connections: List[runner.wire_client.Conn],
    calls: List[Pos],
    out: Stdout,
    armed: bool
}

type Tally {
    floor: u64,
    pending: List[Pos],
    bad: String
}

fn later(calls: List[Pos], x: Pos) -> bool {
    for y in calls {
        if y.stream == x.stream && y.p > x.p {
            return true
        }
    }
    false
}

fn send_call(cn: runner.wire_client.Conn, x: Pos, mut t: Tally) waits {
    let stream: u32 = int.narrow(x.stream)
    let slot: u32 = int.narrow(x.body)
    let request: runner.Frame = Call(store.StreamId(t: 0u64, n: int.widen(stream)), x.p, slot, 4294967295u32, u64_bytes(x.k))
    list.push(mut t.pending, clone(x))
    runner.wire_client.send_frame(cn, take request)
}

fn accept_answer(mut pending: List[Pos], calls: List[Pos], session: u64, answer: runner.Done) -> bool {
    for at in 0u64 .. list.len(pending) {
        let x = pending[at]
        if x.from == session && x.stream == answer.stream.n && x.p == answer.p {
            let below = match answer.outcome {
                Refused(HistoryUnavailable) => later(calls, x),
                _ => false,
            }
            if !below && !same(answer.outcome, expected(x)) {
                return false
            }
            let _ = list.swap_remove(mut pending, at)
            return true
        }
    }
    false
}

fn runner_crash_answer_oracle() {
    let calls = positions("runner-cross")
    let mut pending: List[Pos] = list.new()
    list.push(mut pending, clone(calls[0u64]))
    list.push(mut pending, clone(calls[1u64]))
    list.push(mut pending, clone(calls[3u64]))
    let both = runner.Done(stream: store.StreamId(t: 0u64, n: 0u64), p: 0u64, outcome: returned(Ok(1u64)))
    want(accept_answer(mut pending, calls, 0u64, both), "oracle: first session's p0 was rejected")
    want(accept_answer(mut pending, calls, 1u64, both), "oracle: second session's p0 was rejected")
    want(!accept_answer(mut pending, calls, 0u64, both), "oracle: a repeated p0 answered p1")
    let next = runner.Done(stream: store.StreamId(t: 0u64, n: 0u64), p: 1u64, outcome: returned(Ok(3u64)))
    want(accept_answer(mut pending, calls, 0u64, next) && list.len(pending) == 0u64, "oracle: p1 did not clear the remaining send")
}

// One Batch from session i, or false once it ends or sends another frame.
fn heard(cn: runner.wire_client.Conn, i: u64, calls: List[Pos], out: Stdout, mut t: Tally) -> bool waits {
    let (v, done) = match runner.wire_client.next(cn) {
        Ok(Batch(version, _, _, take done)) => (version, take done),
        Ok(_) => {
            t.bad = "runner_crash: a frame other than a Batch"
            return false
        },
        Error(_) => return false,
    }
    for answer in done {
        if !accept_answer(mut t.pending, calls, i, answer) {
            t.bad = "runner_crash: an answer did not match a pending call's expected Outcome"
        }
        let reports = match answer.outcome {
            Returned(_) => true,
            Failed(_) => true,
            _ => false,
        }
        if reports && v > t.floor {
            t.floor = v
            ack(out, t.floor)
        }
    }
    true
}

fn owes(pending: List[Pos], session: u64) -> bool {
    for x in pending {
        if x.from == session {
            return true
        }
    }
    false
}

fn client(take c: Client) -> String waits {
    let Client(connections: take connections, calls: take calls, out: out, armed: armed) = take c
    let mut t = Tally(floor: 0u64, pending: list.with_capacity(list.len(calls)), bad: "")
    if armed {
        result.unwrap(stdout.write(out, "ARM"))
        for x in calls {
            send_call(connections[x.from], x, mut t)
            while owes(t.pending, x.from) && t.bad == "" {
                if !heard(connections[x.from], x.from, calls, out, mut t) {
                    break
                }
            }
            if list.len(t.pending) != 0u64 || t.bad != "" {
                break
            }
        }
    } else {
        for x in calls {
            send_call(connections[x.from], x, mut t)
        }
        for i in 0u64 .. list.len(connections) {
            while owes(t.pending, i) && t.bad == "" {
                if !heard(connections[i], i, calls, out, mut t) {
                    break
                }
            }
        }
    }
    for cn in connections {
        let _ = channel.send(cn.to, Close)
    }
    for cn in connections {
        loop {
            match runner.wire_client.next(cn) {
                Ok(_) => if t.bad == "" {
                    t.bad = "runner_crash: an answer after the last"
                },
                Error(_) => break,
            }
        }
    }
    for take cn in connections {
        let _ = runner.wire_client.close(take cn)
    }
    if t.bad == "" && list.len(t.pending) != 0u64 {
        t.bad = "unanswered"
    }
    let Tally(bad: take bad, ..) = take t
    bad
}

type Accept: send {
    listener: Listener,
    input: Stdin,
    tasks: Tasks,
    clock: Clock,
    random: Random,
    head: Sender[runner.HeadInput],
    post: Sender[runner.PubIn],
    sessions: u64
}

fn accept(take seed: Accept) -> () waits {
    let Accept(listener: take listener, input: input, tasks: tasks, clock: c, random: random, head: take head, post: take post, sessions: sessions) = take seed
    let mut l = take listener
    let mut config = runner.wire_defaults(65536u64)
    // The replay sends up to three calls per owner. Reserve those outcomes
    // within the fixture's 32 KiB frame limit.
    config.q = 2u64
    config.socket.max_frame = 32768u64
    let pool = result.unwrap(std.wsock.pending(config.socket))
    let mut owners: List[Task[Result[(), std.wsock.Error]]] = list.new()
    for _ in 0u64 .. sessions {
        let mut port: Bytes = list.with_capacity(2u64)
        while list.len(port) < 2u64 {
            want(result.unwrap(stdin.read(input, mut port, Never)) != 0, "runner_crash: missing client port")
        }
        let low: u16 = int.widen(port[0])
        let high: u16 = int.widen(port[1])
        let peer = Addr(ip: V4(0x7f000001u32), port: low | (high << 8))
        let socket = result.unwrap(std.net.accept_from(mut l, peer, Never))
        let lease = option.unwrap(result.unwrap(std.wsock.acquire(pool)))
        let up = result.unwrap(std.wsock.server(take socket, take lease, peer.ip, list.new(), config.socket, c, host.mono_ns(c)))
        let no_grants: Option[Sender[runner.GrantRequest[()]]] = None
        let service = runner.wire_target_service(random, Some(runner.ingress.binding()), take no_grants, head, c, tasks, config, "crash fixture")
        let owner = result.unwrap(runner.serve_connection(tasks, take up, take service, result.unwrap(runner.wire_place_allocator(code.describe(place), N_PLACE)), post, config, c))
        list.push(mut owners, take owner)
    }
    for take owner in owners {
        let _ = task.join(take owner)
    }
}

fn served(take db: store.Db, selection: runner.Selection, c: Clock, r: Random, tasks: Tasks, n: Net, input: Stdin, out: Stdout, sessions: u64) -> Result[(), runner.OpenError] waits {
    let (listener, address) = result.unwrap(host.listen(n, Addr(ip: V4(0x7f000001u32), port: 0u16), 16u16))
    let mut port = string.from("PORT ")
    string.push_u64(mut port, int.widen(address.port))
    result.unwrap(stdout.write(out, port))
    let (head, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let mail = result.unwrap(runner.mailbox(4u64))
    let seed = Accept(listener: take listener, input: input, tasks: tasks, clock: c, random: r, head: take head, post: runner.post(mail), sessions: sessions)
    let mut driving = task.spawn(tasks, bytes 33554432u64, take seed, accept)
    let opened = runner.place_head_selected(take db, selection, code.describe(place), N_PLACE, None, code.describe(schema), take inbox, take mail, tasks, 1048576u64)
    if let Error(_) = opened {
        task.cancel(mut driving)
    }
    let _ = task.join(take driving)
    take opened
}

fn decode_fixture_token(text: View[String]) -> Option[Bytes] {
    if text == "-" {
        return None
    }
    let raw = string.as_bytes(text)
    want(list.len(raw) == 32u64, "runner_crash: invalid saved credential")
    for byte in raw {
        want(byte < b'A' || byte > b'F', "runner_crash: invalid saved credential")
    }
    let Some(take decoded) = std.hex.decode(raw) else {
        fail("runner_crash: invalid saved credential")
    }
    Some(take decoded)
}

fn remember(out: Stdout, principal: Bytes) waits {
    let mut line = string.into_bytes("TOKEN ")
    std.hex.append_from(mut line, list.len(principal), scoped fn(i: u64) -> u8 {
        principal[i]
    })
    result.unwrap(stdout.write(out, result.unwrap(string.from_utf8(take line))))
}

fn drive(c: Clock, r: Random, tasks: Tasks, n: Net, out: Stdout, port: u16, sessions: u64, take calls: List[Pos], take principal: Option[Bytes], armed: bool) -> String waits {
    let mut connections: List[runner.wire_client.Conn] = list.new()
    let credential = match take principal {
        Some(take given) => take given,
        None => runner.ingress.credential(r)
    }
    for _ in 0u64 .. sessions {
        let mut keys: List[Bytes] = list.new()
        for body in 0u64 .. 3u64 {
            list.push(mut keys, body_key(body))
        }
        let until: Until = At(c, int.saturating_add(host.mono_ns(c), 5000000000u64))
        let socket = result.unwrap(host.connect(n, Addr(ip: V4(0x7f000001u32), port: port), until))
        let source = result.unwrap(net.local_addr(socket))
        let mut message = string.from("PEER ")
        string.push_u64(mut message, int.widen(source.port))
        result.unwrap(stdout.write(out, message))
        let cn = result.unwrap(runner.wire_client.connect_socket(tasks, take socket, c, r, keys, Some(clone(credential)), std.wsock.defaults(), until, 5000u64))
        remember(out, credential)
        list.push(mut connections, take cn)
    }
    client(Client(connections: take connections, calls: take calls, out: out, armed: armed))
}

fn arg_u64(text: View[String]) -> u64 {
    let mut n = 0u64
    for digit in string.as_bytes(text) {
        n = n * 10u64 + int.widen(digit - b'0')
    }
    n
}

fn count(d: Dir, c: Clock, r: Random, tasks: Tasks) -> (u64, u64) waits {
    let mut o = options()
    o.create = false
    let mut db = result.unwrap(store.open(tasks, d, c, r, o))
    let h = result.unwrap(open_data(db))
    let v = store.version(store.snapshot(db))
    let n = match result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.t, 0u64)) {
        Some(n) => n,
        None => 0u64,
    }
    result.unwrap(store.close(take db))
    (v, n)
}

type DeadlinePlace: send {
    config: runner.PlaceConfig[(), Hd, (), ()],
    stop: Receiver[()],
    status: Latest[runner.Status],
    watch: Sender[Receiver[runner.Phase]],
}

fn deadline_place(take fixture: DeadlinePlace) -> Result[runner.Ended, runner.StartError] waits {
    let DeadlinePlace(config: take config, stop: take stop, status: take status, watch: take watch) = take fixture
    runner.operate(take config, take stop, status, Some(take watch))
}

fn status_address(status: runner.Status) -> Addr {
    option.unwrap(status.addr)
}

fn activation_pairs(d: Dir, c: Clock, r: Random, tasks: Tasks, n: Net, out: Stdout, phase: String, uncut: bool, genesis: bool) -> () waits {
    let codec: std.codec.Codec[Bytes] = std.codec.of_list()
    let mut old_previous: Bytes = list.new()
    let mut old_current: Bytes = list.new()
    list.append(mut old_previous, string.as_bytes("previous release"))
    list.append(mut old_current, string.as_bytes("current release"))
    if phase == "init" {
        let mut db = result.unwrap(store.open(tasks, d, c, r, options()))
        if genesis {
            result.unwrap(store.close(take db));
            return
        }
        let _ = result.unwrap(install_data(mut db))
        let _ = result.unwrap(store.create_table(mut db, store.spec("hirsel.runner.activation", std.codec.key_u8(), codec)))
        let release_codec: std.codec.Codec[runner.ReleaseRecord] = std.codec.of()
        let _ = result.unwrap(store.create_table(mut db, store.spec("hirsel.runner.releases", std.codec.key_u64(), release_codec)))
        let table = result.unwrap(store.table(mut db, "hirsel.runner.activation", std.codec.key_u8(), codec))
        let written = result.unwrap(store.run(mut db, None, (store.copy_env(old_previous), store.copy_env(old_current), store.copy_env(table)), fn(mut tx, call_env) -> Result[(), store.Error] {
            store.put(mut tx, call_env.2, 0u8, call_env.1)?
            store.put(mut tx, call_env.2, 1u8, call_env.0)
        }))
        if let Committed(done) = written {
            result.unwrap(store.durable(mut db, done.ticket))
        } else {
            fail("activation: failed to seed both rows")
        }
        result.unwrap(store.close(take db))
        return
    }
    let mut existing = options()
    existing.create = false
    let base = if genesis {
        0u64
    } else {
        4u64
    }
    let mut chosen: runner.Selection = if genesis {
        Current(0u64)
    } else {
        Install(runner.fate.none())
    }
    let expected_version = base + 1u64
    if phase == "read" {
        let mut db = result.unwrap(store.open(tasks, d, c, r, existing))
        let snap = store.snapshot(db)
        let version = store.version(snap)
        let activated = version == base + 1u64
        want((activated && store.fence_level(db) == 1) || (!activated && !uncut && version == base && store.fence_level(db) == 0), "activation and fence disagree")
        if activated || !genesis {
            let table = result.unwrap(store.system_table(db, "hirsel.runner.activation", std.codec.key_u8(), codec))
            let current = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, table, 0u8)))
            let previous = result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, table, 1u8))
            let releases: store.Table[u64, runner.ReleaseRecord] = result.unwrap(store.system_table(db, "hirsel.runner.releases", std.codec.key_u64(), std.codec.of()))
            let history = result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, releases, base + 1u64))
            if activated {
                if genesis {
                    if let Some(_) = previous {
                        fail("genesis: unexpected previous release")
                    }
                } else {
                    want(option.unwrap(take previous) == old_current, "activation: current changed but previous did not")
                }
                let describe: std.codec.Codec[runner.Describe] = std.codec.of()
                let decoded = result.unwrap(std.codec.decode(describe, current))
                want(list.len(decoded.exported) == 3u64 && decoded.exported[0u64].described.identity == code.identity(code.describe(bump)) && decoded.exported[1u64].described.identity == code.identity(code.describe(deny)) && decoded.exported[2u64].described.identity == code.identity(code.describe(trip)), "activation: incorrect new release")
                let row = option.unwrap(take history)
                want(row.release == result.unwrap(runner.release_digest(decoded.exported)) && row.digest == decoded.digest, "activation: new release history differs from current")
                let _ = result.unwrap(store.checkpoint(mut db))
                chosen = Current(version)
            } else {
                want(current == old_current && option.unwrap(take previous) == old_previous, "activation: legacy rows changed")
                if let Some(_) = history {
                    fail("activation: history committed without current")
                }
                chosen = Current(0u64)
            }
        } else {
            match open_data(db) {
                Error(Missing(_)) => (),
                _ => fail("activation: genesis catalog committed without activation")
            }
        }
        result.unwrap(store.close(take db))
        if !activated && !genesis {
            refused_open(d, c, r, tasks, Current(0u64), N_PLACE, base, true)
            return
        }
        if activated {
            refused_open(d, c, r, tasks, Current(base), N_PLACE, base + 1u64, false)
            refused_open(d, c, r, tasks, Current(base + 1u64), N_PLACE + 1u64, base + 1u64, false)
        }
    }
    let (stop, stopping): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (watch, watcher): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = channel.new(1u64)
    let mut wire = runner.wire_defaults(131072u64)
    wire.n_pool = 4194304u64
    let settings: runner.PlaceConfig[(), Hd, (), ()] = runner.PlaceConfig(backing: Disk(d), sizes: store.Overrides(resident_limit: Some(existing.resident_limit), journal_limit: None, checkpoint_bytes: None, pack_bytes: Some(existing.pack_bytes), group_bytes: Some(int.widen(existing.group_bytes)), group_commits: Some(existing.group_commits), lock_wait_ms: Some(existing.lock_wait_ms), cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: take chosen, place: code.describe(place), n_place: N_PLACE, on_migrate: Some(code.describe(migrate)), schema: code.describe(schema), session: wire, max_sessions: 1u64, proxies: list.new(), n_publisher: 1048576u64, listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: n, tasks: tasks, clock: c, random: r, stop: runner.Stop(lag_ms: 0u64, grace_ms: 1000u64), wire: Some(runner.ingress.binding()), grants: None, triggers: None, idle: None)
    let installing = match settings.selection {
        Install(_) => true,
        _ => false
    }
    let allowance = deadline_disk_bytes(settings)
    let seed = DeadlinePlace(config: take settings, stop: take stopping, status: result.unwrap(runner.status_root()), watch: take watch)
    let running = task.spawn(tasks, bytes allowance, take seed, deadline_place)
    // A standalone install completes durably without publishing a serving phase.
    if installing {
        if let Ok(Ok(Unstarted)) = task.join(take running) {} else {
            fail("activation: install did not finish")
        }
        result.unwrap(stdout.write(out, "DONE"))
        return
    }
    let phases = result.unwrap(channel.receive(watcher))
    loop {
        match channel.receive(phases) {
            Ok(Ready) => break,
            Ok(Starting(_)) => (),
            _ => fail("activation: no Ready")
        }
    }
    if phase == "write" {
        result.unwrap(stdout.write(out, "DONE"))
    }
    result.unwrap(channel.send(stop, ()))
    if let Ok(Ok(Stopped(_))) = task.join(take running) {} else {
        fail("activation: empty place did not stop")
    }
    if phase == "read" {
        let db = result.unwrap(store.open(tasks, d, c, r, existing))
        want(store.version(store.snapshot(db)) == expected_version, "activation: wrong write count on restart")
        want(store.fence_level(db) == 1, "activation: a later cut lost the fence")
        result.unwrap(store.close(take db))
    }
}

fn unreachable_schema(mut _catalog: store.Declare) -> Result[Hd, store.Error] {
    fail("a refused opener called handles")
}

fn refused_open(d: Dir, c: Clock, r: Random, tasks: Tasks, selected: runner.Selection, allowance: u64, v: u64, legacy: bool) -> () waits {
    let db = result.unwrap(store.open(tasks, d, c, r, options()))
    let (_sender, from): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(1u64)
    let mail = result.unwrap(runner.mailbox(1u64))
    let tried = runner.place_head_selected(take db, selected, code.describe(place), allowance, None, code.describe(unreachable_schema), take from, take mail, tasks, 1048576u64)
    match take tried {
        Error(NotCurrent(Legacy)) => want(legacy, "activation: fenced store reported legacy"),
        Error(NotCurrent(Active(found, _, _))) => want(!legacy && found == v, "activation: wrong active version"),
        _ => fail("activation: unexpected selection result")
    }
    let reopened = result.unwrap(store.open(tasks, d, c, r, options()))
    want(store.version(store.snapshot(reopened)) == v, "activation: refusal advanced the head")
    result.unwrap(store.close(take reopened))
}

fn unavailable_identity(d: Dir, c: Clock, r: Random, tasks: Tasks, grow: bool, phase: String, out: Stdout) -> () waits {
    if phase == "init" {
        let db = result.unwrap(store.open(tasks, d, c, r, options()))
        result.unwrap(store.close(take db))
        return
    }
    let db = result.unwrap(store.open(tasks, d, c, r, options()))
    if phase == "write" {
        let chosen: runner.Selection = if grow {
            Install(runner.fate.none())
        } else {
            Current(0u64)
        }
        let (_sender, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(1u64)
        let attempted = runner.place_head_selected(take db, chosen, code.describe(place), N_PLACE, None, code.describe(unreachable_schema), take inbox, result.unwrap(runner.mailbox(1u64)), tasks, 1048576u64)
        match take attempted {
            Error(IdentityUnknown) => result.unwrap(stdout.write(out, "DONE")),
            _ => fail("disk install accepted an unavailable identity"),
        }
    } else {
        want(store.version(store.snapshot(db)) == 0u64 && store.fence_level(db) == 0, "identity refusal committed the install")
        result.unwrap(store.close(take db))
    }
}

fn deadline_disk_bytes(config: runner.PlaceConfig[(), Hd, (), ()]) -> u64 {
    let plan = result.unwrap(store.planned(Directory, 18446744073709551615u64, config.sizes))
    // Runner's 1 MiB keep and 1 MiB for the fixture.
    result.unwrap(runner.operate_bytes(config)) + 2 * 1048576u64 + store.planned_bytes(plan)
}

fn freeze_until_stop(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout, n: Net, take stopping: Receiver[()], twice: bool) -> runner.Ended waits {
    let (watch, watcher): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = channel.new(1u64)
    let status = result.unwrap(runner.status_root())
    let mut wire = runner.wire_defaults(131072u64)
    wire.n_pool = 4194304u64
    wire.socket.max_frame = 65536u64
    let config: runner.PlaceConfig[(), Hd, (), ()] = runner.PlaceConfig(backing: Disk(d), sizes: store.Overrides(resident_limit: Some(1048576u64), journal_limit: None, checkpoint_bytes: Some(4194304u64), pack_bytes: Some(512u64), group_bytes: Some(1048576u64), group_commits: Some(2u32), lock_wait_ms: None, cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: Current(0u64), place: code.describe(place), n_place: N_PLACE, on_migrate: Some(code.describe(migrate)), schema: code.describe(schema), session: wire, max_sessions: 1u64, proxies: list.new(), n_publisher: 1048576u64, listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: n, tasks: tasks, clock: c, random: r, stop: runner.Stop(lag_ms: 10000u64, grace_ms: 100u64), wire: Some(runner.ingress.binding()), grants: None, triggers: None, idle: None)
    let allowance = deadline_disk_bytes(config)
    let seed = DeadlinePlace(config: take config, stop: take stopping, status: latest.handle(status), watch: take watch)
    let running = task.spawn(tasks, bytes allowance, take seed, deadline_place)
    let phases = result.unwrap(channel.receive(watcher))
    loop {
        match channel.receive(phases) {
            Ok(Ready) => break,
            Ok(Starting(_)) => (),
            _ => fail("runner-deadline: no Ready")
        }
    }
    let mut keys: List[Bytes] = list.new()
    list.push(mut keys, body_key(0u64))
    let credential = runner.ingress.credential(r)
    let connection = result.unwrap(runner.wire_client.connect(tasks, n, status_address(latest.read(status)), c, r, keys, Some(clone(credential)), wire.socket))
    remember(out, credential)
    result.unwrap(stdout.write(out, "FREEZE"))
    runner.wire_client.send_frame(connection, Call(store.StreamId(t: 0u64, n: 0u64), 0u64, 0u32, 10000u32, u64_bytes(9u64)))
    let watchdog = host.mono_ns(c) + 5000000000u64
    while let Error(_) = stdout.write(out, "FROZEN?") {
        let now = host.mono_ns(c)
        if now >= watchdog {
            fail("runner-deadline: no journal sync to freeze")
        }
        host.sleep_until(c, now + 1000000u64)
    }
    if let Ok(Draining) = channel.receive(phases) {} else {
        fail("runner-deadline: no Draining after SIGTERM")
    }
    if twice {
        result.unwrap(stdout.write(out, "SECOND"))
    }
    let ended: runner.Ended = match task.join(take running) {
        Ok(Ok(Forced(abandoned_count))) if abandoned_count == 1u64 => Forced(abandoned_count),
        _ => fail("runner-deadline: expected exactly one logically abandoned send"),
    }
    let mut abandoned = 0u64
    while let Ok(take frame) = runner.wire_client.next(connection) {
        match frame {
            Batch(_, _, _, done) => for outcome in done {
                if let Abandoned = outcome.outcome {
                    abandoned += 1u64
                } else {
                    fail("runner-deadline: answered a send past the cut")
                }
            },
            _ => fail("runner-deadline: unexpected wire frame"),
        }
    }
    want(abandoned <= 1u64, "runner-deadline: duplicate Abandoned")
    let _ = runner.wire_client.close(take connection)
    result.unwrap(stdout.write(out, "DONE"))
    ended
}

fn deadline_reopen(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args) -> () waits {
    let mut existing = options()
    existing.create = false
    let mut db = result.unwrap(store.open(tasks, d, c, r, existing))
    let data = result.unwrap(open_data(db))
    let named = option.unwrap(decode_fixture_token(option.unwrap(args.get(argv, 4u64))))
    let given = result.unwrap(runner.ingress.caller((), named))
    let stream = store.StreamKey(caller: clone(given.caller), id: store.StreamId(t: store.keyed_time(db), n: 0u64))
    want(match result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), data.t, 0u64)) {
        None => true,
        _ => false
    }, "runner-deadline: frozen effect reached disk")
    let digest = store.request_digest(body_key(0u64), u64_bytes(9u64))
    match result.unwrap(store.admit(mut db, stream, 0u64, digest)) {
        Admitted(_) => (),
        Abandoned(_) => (),
        _ => fail("runner-deadline: frozen position is not retryable without a prior reply"),
    }
    result.unwrap(store.close(take db))
}

pub fn main(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, out: Stdout, n: Net, input: Stdin) -> Result[(), Exit] waits {
    let phase = option.unwrap(args.get(argv, 0u64))
    let scenario = option.unwrap(args.get(argv, 1u64))
    if scenario == "runner-activation" || scenario == "runner-activation-genesis" {
        activation_pairs(d, c, r, tasks, n, out, string.from(phase), option.unwrap(args.get(argv, 2u64)) == "new", scenario == "runner-activation-genesis")
        return Ok(())
    }
    if scenario == "runner-unavailable-genesis" || scenario == "runner-unavailable-install" {
        unavailable_identity(d, c, r, tasks, scenario == "runner-unavailable-install", phase, out)
        return Ok(())
    }
    if phase == "client" {
        let mode = option.unwrap(args.get(argv, 2u64))
        let port: u16 = int.narrow(arg_u64(option.unwrap(args.get(argv, 3u64))))
        let principal = decode_fixture_token(option.unwrap(args.get(argv, 4u64)))
        if mode == "init" {
            runner_crash_answer_oracle()
            clean(drive(c, r, tasks, n, out, port, 1u64, list.new(), take principal, false))
        } else if mode == "write" {
            let verdict = drive(c, r, tasks, n, out, port, 2u64, positions(scenario), take principal, scenario == "poison-segment")
            if verdict != "unanswered" {
                clean(take verdict)
            } else if scenario != "poison-segment" {
                return Ok(())
            }
        } else {
            let (again, _) = resends(scenario)
            clean(drive(c, r, tasks, n, out, port, 1u64, take again, take principal, false))
        }
        result.unwrap(stdout.write(out, "DONE"))
        return Ok(())
    }
    if phase == "init" {
        let mut db = result.unwrap(store.open(tasks, d, c, r, options()))
        result.unwrap(install_data(mut db))
        let opened = served(take db, Current(0u64), c, r, tasks, n, input, out, 1u64)
        want(match opened {
            Ok(()) => true,
            Error(_) => false
        }, "runner_crash: the first head failed")
        return Ok(())
    }
    if phase == "write" {
        // Poison: one frame per journal group, so the adapter's second armed segment sync
        // carries exactly the call's effect frame. The admit frame's sync succeeds, and
        // the effect frame's failure reaches the head only through the gate's durable:
        // between that frame's hand-off and the gate the head makes no store call, and
        // the client sends nothing more until it is answered. An answer before durable,
        // or one sent despite the poison, then always reaches the client (L1).
        let mut o = options()
        if scenario == "poison-segment" {
            o.group_commits = 1u32
        }
        let db = match store.open(tasks, d, c, r, o) {
            Ok(take x) => take x,
            Error(_) => return Ok(())
        }
        // The data table is version 1 and the initial activation is version 2.
        let opened = served(take db, Current(2u64), c, r, tasks, n, input, out, 2u64)
        match opened {
            Ok(()) => want(scenario != "poison-segment", "runner_crash: a failed journal sync did not stop the head"),
            Error(_) => (),
        }
        return Ok(())
    }
    let done = option.unwrap(args.get(argv, 2u64)) == "new"
    let floor = arg_u64(option.unwrap(args.get(argv, 3u64)))
    let (before, _) = count(d, c, r, tasks)
    want(before >= floor, "runner_crash: a client saw a commit the store lost (L1)")
    let mut o = options()
    o.create = false
    let db = result.unwrap(store.open(tasks, d, c, r, o))
    let opened = served(take db, Current(2u64), c, r, tasks, n, input, out, 1u64)
    want(match opened {
        Ok(()) => true,
        Error(_) => false
    }, "runner_crash: the re-send head failed")
    let (_, total) = resends(scenario)
    let (after, value) = count(d, c, r, tasks)
    want(value == total, "runner_crash: an effect ran other than once (C1)")
    if done && scenario != "poison-segment" {
        want(after == before, "runner_crash: a re-send after a complete run committed")
    }
    Ok(())
}

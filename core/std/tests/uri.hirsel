    host_is("scheme://a", "a") && host_is("scheme://a.b", "a.b") && host_is("scheme://example.com", "example.com") && host_is("scheme://www.example.com", "www.example.com") && host_is("scheme://example.org.", "example.org.") && host_is("scheme://www.example.org.", "www.example.org.") && host_is("scheme://xn--nw2a.xn--j6w193g", "xn--nw2a.xn--j6w193g") && host_is("scheme://fe80--1ff-fe23-4567-890as3.ipv6-literal.net", "fe80--1ff-fe23-4567-890as3.ipv6-literal.net") && host_is("scheme://255.255.255.255", "255.255.255.255") && host_is("scheme://0.0.0.0", "0.0.0.0") && host_is("scheme://8.8.8.8", "8.8.8.8") && host_is("scheme://1.2.3.4", "1.2.3.4") && host_is("scheme://192.168.0.1", "192.168.0.1") && host_is("scheme://10.42.0.0", "10.42.0.0")
}

fn invalid(text: String, at: u64) -> bool {
    match uri.parse(text) {
        Error(Invalid(i)) => i == at,
        _ => false
    }
}


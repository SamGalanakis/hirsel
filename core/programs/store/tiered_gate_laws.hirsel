// Tiered activation gates (STORE-SPEC §13.5, §13.6, L87, L88) through the
// public path, each with its §13.6 crash arm. A crash arm drives the same
// holder change the public call would (`pin_delta`, `plan_fork`) through a
// cut whose MANIFEST seal is refused after its packs are written
// (`refused_cut_bytes`), then lands the sealed bytes as MANIFEST.tmp (the
// process died before the rename) or MANIFEST (it died after the rename,
// before RAM install). The crash table's rows:
// - the refused cut loses nothing: RAM keeps the previous generation;
// - before the rename, open removes MANIFEST.tmp and the cut's packs, and
//   the previous generation recovers without the new holder;
// - after the rename, the new generation recovers with the holder.
// In every generation the walker over every published root finds each stamp
// at exactly one (pack, offset), in a listed pack on disk (L88).
fn gate_walk_roots(d: Dir, db: Db, roots: pages.Roots, collection: u32, mut walk: CompactWalk) -> Result[(), Error] waits {
    match std.page.collection_slot(roots.collections.root, failure_result_from_rep(catalog.prefix(collection))?) {
        Some((ColdPage(root), _)) => compact_walk_frame(d, db, root, mut walk),
        _ => fail("L88: a cut leaves every published holder's Tiered root Cold"),
    }
}

// One walker across every head, every pin and every queued Page or Blob row
// (§13.6: queue rows are their own roots).
fn gate_walk_all(d: Dir, db: Db, collection: u32) -> Result[CompactWalk, Error] waits {
    let mut walk = CompactWalk(live: map.new(), places: map.new())
    for slot in 0u64 .. list.len(pages.holder_heads(db.holders)) {
        gate_walk_roots(d, db, pages.holder_heads(db.holders)[slot].roots, collection, mut walk)?
    }
    for k in 0u64 .. list.len(pages.holder_pins(db.holders)) {
        gate_walk_roots(d, db, pages.holder_pins(db.holders)[k].roots, collection, mut walk)?
    }
    let queued = l87_queue(db)?
    for k in 0u64 .. list.len(queued) {
        let (_, row) = queued[k]
        match row.target {
            TieredPage(ptr) => compact_walk_frame(d, db, ptr, mut walk)?,
            TieredBlob(body) => compact_walk_blob(d, db, body, mut walk)?,
        }
    }
    for (seq, _) in walk.live {
        if !compact_listed(db, seq) || !disk_exists(d, failure_result_from_rep(manifest.paged_pack_path(seq))?)? {
            fail("L88: every published root reaches its frames in listed packs on disk")
        }
    }
    Ok(take walk)
}

fn gate_head(db: Db, name: String) -> Option[Branch] {
    for slot in 0u64 .. list.len(pages.holder_heads(db.holders)) {
        if pages.holder_heads(db.holders)[slot].name == name {
            return Some(Branch(store: db.store, id: pages.holder_heads(db.holders)[slot].id))
        }
    }
    None
}

// The §13.6 crash table's rows, at the cut that publishes a holder:
// - NoCrash: the cut publishes.
// - SealRefused: the seal is refused and the same open carries on; its next
//   cut publishes nothing of the refused holder.
// - BeforeRename: the process dies with MANIFEST.tmp written.
// - AfterRename: it dies with MANIFEST renamed, before RAM install.
// - RetryAfterRename: the cut's first attempt is refused with relocation in
//   its candidate, so AP16 restores the retry base and redoes the plan once;
//   the process dies with the redo's MANIFEST renamed.
type GateCrash = NoCrash | SealRefused | BeforeRename | AfterRename | RetryAfterRename

// Ends the refused cut's open as `crash` says, and returns the store that
// carries on. A crash lands the sealed bytes and reopens, and open removes
// MANIFEST.tmp, and before the rename the packs the cut wrote from
// `first_output` on.
fn gate_crash_reopen(d: Dir, c: Clock, r: Random, tasks: Tasks, options: Options, take db: Db, sealed: Bytes, first_output: u64, crash: GateCrash) -> Result[Db, Error] waits {
    let renamed = match crash {
        BeforeRename => false,
        AfterRename => true,
        RetryAfterRename => true,
        _ => {
            let mut carried = take db
            let _ = checkpoint(mut carried)?
            return Ok(take carried)
        },
    }
    close(take db)?
    failure_result_from_rep(manifest.disk_write_synced(d, if renamed {
        "MANIFEST"
    } else {
        "MANIFEST.tmp"
    }, sealed))?
    let reopened = open(tasks, d, c, r, options)?
    if disk_exists(d, "MANIFEST.tmp")? {
        fail("§13.6 crash: open removes an unpublished MANIFEST.tmp")
    }
    if !renamed && disk_exists(d, failure_result_from_rep(manifest.paged_pack_path(first_output))?)? {
        fail("§13.6 crash: open removes an unpublished cut's packs")
    }
    Ok(take reopened)
}

fn gate_published(crash: GateCrash) -> bool {
    match crash {
        AfterRename => true,
        RetryAfterRename => true,
        _ => false,
    }
}

// L87 (pin materialization adds no queue row): one row, seq 0, main's
// detached first Cold leaf.
fn gate_one_queued_leaf(db: Db, leaf: std.page.PagePtr) -> Result[(), Error] {
    let queued = l87_queue(db)?
    if list.len(queued) != 1 || manifest.pack_lists(disk_state(db).packs).deferred_next != 1 {
        fail("L87: a pin's materialization adds no queue row")
    }
    let (seq, row) = queued[0u64]
    let TieredPage(queued_leaf) = row.target else {
        fail("L87: a detached leaf is queued as a Page row")
    }
    if seq != 0 || row.branch_id != 0 || queued_leaf != leaf {
        fail("L87: the queue names main's detached Cold leaf once")
    }
    Ok(())
}

// The pinned Snapshot reads the rows at or above the trim, as appended.
fn gate_pin_reads(db: Db, events: Log[Bytes], trim: u64, appended: u64) -> Result[(), Error] waits {
    let Some(held) = pinned(db, "history") else {
        fail("L87: the pin is published")
    }
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    for at in 0u64 .. appended {
        let expected: Option[Bytes] = if at < trim {
            None
        } else {
            Some(compact_entry(at))
        }
        if log_get(read_handle, held, events, at)? != expected {
            fail("L87: the pin reads its Snapshot's overlay")
        }
    }
    drop(take read_handle)
    drop(take held)
    Ok(())
}

// Crash arm of test_l87_pin_materialization_adds_no_queue_row: the cut that
// publishes pin(S) is the one that crashes. S was captured before the fold
// cut, so the pin materializes S's overlay into fresh pages (§13.5 step 3)
// and its queue still holds the one row main's fold queued.
fn gate_pin_crash(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let floor = 182375272u64
    let appended = 120u64
    let events = l87_cold_log(d, c, r, tasks, floor, appended, 48)?
    let mut cold = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let (leaf, trim) = l87_first_leaf(d, cold, events.binding.id)?
    let trimmed: Log[Bytes] = clone(events)
    let Committed(_) = run(mut cold, Some(100000), copy_env((trimmed, trim)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L87: the served trim of a Cold Tiered Log commits")
    }
    close(take cold)?
    let mut db = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let s = snapshot(db)
    let _ = checkpoint(mut db)?
    let delta = pin_delta(mut db, ApplicationPin, "history", s)?
    drop(take s)
    let first_output = manifest.pack_next(disk_state(db).packs)
    let sealed = refused_cut_bytes(mut db, take delta)?
    if !disk_exists(d, failure_result_from_rep(manifest.paged_pack_path(first_output))?)? {
        fail("§13.6 crash: the pin's cut wrote its materialization before the rename")
    }
    if let Some(_) = pinned(db, "history") {
        fail("§13.6 crash: a refused cut installs no pin")
    }
    gate_one_queued_leaf(db, leaf)?
    let reopened = gate_crash_reopen(d, c, r, tasks, l87_options(floor, 0)?, take db, sealed, first_output, crash)?
    gate_one_queued_leaf(reopened, leaf)?
    if gate_published(crash) {
        gate_pin_reads(reopened, events, trim, appended)?
    } else if let Some(_) = pinned(reopened, "history") {
        fail("§13.6 crash: the previous generation recovers without the pin")
    }
    let _ = gate_walk_all(d, reopened, events.binding.id)?
    close(take reopened)
}

@test
fn test_l87_pin_materialization_crash_before_rename(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_pin_crash(d, c, r, tasks, BeforeRename)
}

@test
fn test_l87_pin_materialization_crash_after_rename(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_pin_crash(d, c, r, tasks, AfterRename)
}

// Crash arm of test_l87_each_promoted_holder_materializes_once: the cut-path
// fork `beta` of S crashes. Before the rename, `beta` is absent and the pin's
// pack and pack 7 keep their live bytes. After it, `beta` reads its own
// materialization in a pack of its own, and its later kill of those pages
// lowers only that pack's live to 0 (§13.6 "Holders").
fn gate_fork_crash(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let floor = 182375272u64
    let rows = compact_cold_table_of(d, c, r, tasks, floor, 160, 48)?
    let mut cold = open(tasks, d, c, r, l69_options(floor)?)?
    let original = l69_cold_root(cold, rows.id)?.pack
    l87_edit_on(mut cold, rows, 0, 1)?
    close(take cold)?
    let mut db = open(tasks, d, c, r, l69_options(floor)?)?
    let s = snapshot(db)
    let _ = checkpoint(mut db)?
    let old_live = l69_pack_live(db, original)
    let _ = pin(mut db, "history", s)?
    let Some(held) = pinned(db, "history") else {
        fail("L87 (e2): the pin is published")
    }
    let (pin_pack, pin_bytes) = l87_fresh_frames(d, db, l87_snapshot_root(held, rows.id)?, original)?
    drop(take held)
    let CutFork(beta_id, delta) = plan_fork(mut db, "beta", s)? else {
        fail("L87 (e2): a fork of a Snapshot before the cut is published by a cut")
    }
    drop(take s)
    let first_output = manifest.pack_next(disk_state(db).packs)
    let sealed = refused_cut_bytes(mut db, take delta)?
    if !disk_exists(d, failure_result_from_rep(manifest.paged_pack_path(first_output))?)? {
        fail("§13.6 crash: the fork's cut wrote its materialization before the rename")
    }
    if let Some(_) = gate_head(db, "beta") {
        fail("§13.6 crash: a refused cut installs no head")
    }
    let mut reopened = gate_crash_reopen(d, c, r, tasks, l69_options(floor)?, take db, sealed, first_output, crash)?
    if l69_pack_live(reopened, pin_pack) != pin_bytes || l69_pack_live(reopened, original) != old_live {
        fail("§13.6 crash: the fork's crash leaves the pin's pack and pack 7 unchanged")
    }
    let Some(history) = pinned(reopened, "history") else {
        fail("L87 (e2): the pin survives the crash")
    }
    l87_reads_row(reopened, history, rows, 1)?
    drop(take history)
    let _ = gate_walk_all(d, reopened, rows.id)?
    if !gate_published(crash) {
        if let Some(_) = gate_head(reopened, "beta") {
            fail("§13.6 crash: the previous generation recovers without the fork")
        }
        // The refused fork's lineage row never publishes: no head names it.
        if map.contains(manifest.pack_lists(disk_state(reopened).packs).rows.forks, beta_id) {
            fail("§13.6 crash: a refused fork publishes no lineage row")
        }
        return close(take reopened)
    }
    let Some(beta) = gate_head(reopened, "beta") else {
        fail("§13.6 crash: the new generation recovers with the fork")
    }
    let forked = snapshot_of(reopened, beta)?
    let (beta_pack, beta_bytes) = l87_fresh_frames(d, reopened, l87_snapshot_root(forked, rows.id)?, original)?
    l87_reads_row(reopened, forked, rows, 1)?
    drop(take forked)
    if beta_pack == pin_pack || l69_pack_live(reopened, beta_pack) != beta_bytes {
        fail("L87 (e2): the fork's materialization is its own pack's live")
    }
    l87_edit_on(mut reopened, rows, beta.id, 2)?
    let _ = checkpoint(mut reopened)?
    if l69_pack_live(reopened, beta_pack) != 0 || l69_pack_live(reopened, pin_pack) != pin_bytes || l69_pack_live(reopened, original) != old_live {
        fail("L87 (e2): the fork's kill lowers only its own pack's live")
    }
    let _ = gate_walk_all(d, reopened, rows.id)?
    close(take reopened)
}

@test
fn test_l87_each_promoted_holder_refused_cut(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_fork_crash(d, c, r, tasks, SealRefused)
}

@test
fn test_l87_each_promoted_holder_crash_before_rename(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_fork_crash(d, c, r, tasks, BeforeRename)
}

@test
fn test_l87_each_promoted_holder_crash_after_rename(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_fork_crash(d, c, r, tasks, AfterRename)
}

// A Cold page's frame, read from its pack.
fn gate_page(d: Dir, db: Db, ptr: std.page.PagePtr) -> Result[Arc[std.page.Page], Error] waits {
    let path = failure_result_from_rep(manifest.paged_pack_path(ptr.pack))?
    let wire = failure_result_from_rep(manifest.disk_read_file(d, path, 4194304))?
    let frame = failure_result_from_rep(manifest.read_tiered_frame(path, store_key_to_rep(db.store), TieredPage(ptr), wire, 0, failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders)))?))?
    Ok(arc.share(manifest.fold_page(frame)))
}

// A Cold leaf of a two-level table tree: its location, its row count and
// its first key.
type GateLeaf {
    at: std.page.PagePtr,
    rows: u64,
    first: u64
}

fn gate_leaves(d: Dir, db: Db, slot: u64, collection: u32) -> Result[(std.page.PagePtr, List[GateLeaf]), Error] waits {
    let root = compact_branch_root(db, slot, collection)?
    let page = gate_page(d, db, root)?
    if std.page.level(std.page.image_of(page)) != 1 {
        fail("L87 (d): the fixture table is a root over leaves")
    }
    let mut leaves: List[GateLeaf] = list.new()
    for k in 0u64 .. std.page.count(std.page.image_of(page)) {
        let Some(ColdPage(child)) = std.page.child_slot(page, k) else {
            fail("L87 (d): every leaf of the fixture is Cold")
        }
        let leaf = gate_page(d, db, child)?
        let image = std.page.image_of(leaf)
        let Some(key) = std.page.key_at(image, 0) else {
            fail("L87 (d): a leaf holds rows")
        }
        let first: u64 = list.word_be(key, 0)
        list.push(mut leaves, GateLeaf(at: child, rows: std.page.count(image), first: first))
    }
    Ok((root, take leaves))
}

fn gate_delete_rows(mut db: Db, rows: Table[u64, Bytes], from: u64, to: u64) -> Result[(), Error] waits {
    let fixture: Table[u64, Bytes] = clone(rows)
    let Committed(_) = run(mut db, Some(100000000), copy_env((fixture, from, to)), fn(mut tx: Tx, env: (Table[u64, Bytes], u64, u64)) -> Result[(), Error] {
        for key in env.1 .. env.2 {
            let _ = delete(mut tx, env.0, key)?
        }
        Ok(())
    })? else {
        fail("L87 (d): the deletes commit")
    }
    Ok(())
}

// Rows [0, count) minus `gone`, each as written.
fn gate_reads_rows(db: Db, b: Branch, rows: Table[u64, Bytes], row_total: u64, gone: Map[u64, ()]) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot_of(db, b)?
    for key in 0u64 .. row_total {
        let wanted: Option[Bytes] = if map.contains(gone, key) {
            None
        } else {
            Some(compact_value_of(key, 0, 300))
        }
        if get(read_handle, s, rows, key)? != wanted {
            fail("L87 (d): each branch reads its rows after the merge")
        }
    }
    drop(take s)
    drop(take read_handle)
    Ok(())
}

// L87 (d), merge across a fork (§13.7 "Ownership", astra 2207 medium).
// Main's Cold table has leaves L (4 rows) and R (5 rows) of 300-byte values
// under root T, all in pack P. Main deletes L's first row, so L falls under
// a quarter page and AP3 merges L and R; a live-head FORK `beta` follows,
// and the writer crashes. The fold cut replaces T, L and R on main and
// files them into main's holder cell for `beta`'s origin w₀, because `beta`
// inherited them: cell (main, w₀, 1, 0, P) = |T| + |L| + |R|, and `live[P]`
// is unchanged. `beta`'s own fold records nothing. `adopt(beta)` then
// retires main's chain, so `live[P]` falls by exactly that cell. Red when
// main's kill skips the holder watermark (`live[P]` falls at the fold).
// T is in the cell because the merge rewrites the parent, which sits in P.
// `beta` folds to its own root, distinct from main's, yet its fold files no
// kill and queues no row: with `fold_owners` forced to own every head, the
// cells and the queue are unchanged. So `child_records_inherited` is not
// reachable through this fixture.
// Opens the store and runs its next cut, crashed at `crash`'s row of the
// §13.6 table; a crash before the rename is followed by the retried cut.
fn gate_fold_cut(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64, pack: u64, before_live: u64, crash: GateCrash) -> Result[Db, Error] waits {
    let mut db = open(tasks, d, c, r, l69_options(floor)?)?
    if let NoCrash = crash {
        let _ = checkpoint(mut db)?
        return Ok(db)
    }
    let first_output = manifest.pack_next(disk_state(db).packs)
    let sealed = refused_cut_bytes(mut db, NoHolderChange)?
    if l69_pack_live(db, pack) != before_live {
        fail("§13.6 crash: a refused fold cut files nothing")
    }
    let mut reopened = gate_crash_reopen(d, c, r, tasks, l69_options(floor)?, take db, sealed, first_output, crash)?
    if let BeforeRename = crash {
        let _ = checkpoint(mut reopened)?
    }
    Ok(reopened)
}

fn gate_merge_fork(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let floor = 182375272u64
    let row_count = 60u64
    let rows = compact_cold_table_of(d, c, r, tasks, floor, row_count, 300)?
    let mut shaper = open(tasks, d, c, r, l69_options(floor)?)?
    // Shape the first two leaves to 4 and 5 rows; each stays at or above a
    // quarter page, so no merge happens yet.
    let (_, shaped) = gate_leaves(d, shaper, 0, rows.id)?
    if list.len(shaped) < 3 {
        fail("L87 (d): the fixture table spans at least three leaves")
    }
    let mut gone: Map[u64, ()] = map.new()
    for key in shaped[0u64].first + 4 .. shaped[1u64].first {
        map.insert(mut gone, key, ())
    }
    for key in shaped[1u64].first + 5 .. shaped[2u64].first {
        map.insert(mut gone, key, ())
    }
    gate_delete_rows(mut shaper, rows, shaped[0u64].first + 4, shaped[1u64].first)?
    gate_delete_rows(mut shaper, rows, shaped[1u64].first + 5, shaped[2u64].first)?
    let _ = checkpoint(mut shaper)?
    let (top, leaves) = gate_leaves(d, shaper, 0, rows.id)?
    let left = leaves[0u64]
    let right = leaves[1u64]
    if left.rows != 4 || right.rows != 5 || left.at.pack != top.pack || right.at.pack != top.pack {
        fail("L87 (d): the cut writes T over L (4 rows) and R (5 rows) in one pack")
    }
    let pack = top.pack
    let before_live = l69_pack_live(shaper, pack)
    close(take shaper)?
    // The suffix: main deletes L's first row, then FORK `beta`; crash.
    let mut writer = open(tasks, d, c, r, l69_options(floor)?)?
    gate_delete_rows(mut writer, rows, left.first, left.first + 1)?
    map.insert(mut gone, left.first, ())
    let at_fork = snapshot(writer)
    let (beta, _) = fork(mut writer, "beta", at_fork)?
    drop(take at_fork)
    close(take writer)?
    // The fold cut, crashed at the crash table's row, or not at all.
    let mut db = gate_fold_cut(d, c, r, tasks, floor, pack, before_live, crash)?
    let w0 = match map.get(manifest.pack_lists(disk_state(db).packs).rows.forks, beta.id) {
        Some(fork_row) => fork_row.watermark,
        None => fail("L87 (d): the fold cut publishes beta's fork row"),
    }
    let top_len: u64 = int.widen(top.len)
    let left_len: u64 = int.widen(left.at.len)
    let right_len: u64 = int.widen(right.at.len)
    let replaced = top_len + left_len + right_len
    for slot in 0u64 .. list.len(pages.holder_heads(db.holders)) {
        let walk = compact_walk_from(d, db, compact_branch_root(db, slot, rows.id)?)?
        if map.contains(walk.places, top.stamp) || map.contains(walk.places, left.at.stamp) || map.contains(walk.places, right.at.stamp) {
            fail("L87 (d): every branch's fold merges L and R and replaces T")
        }
    }
    let cell = manifest.LineageCell(branch: 0, boundary: w0, side: 1, interval: 0, pack: pack)
    if map.len(manifest.pack_lists(disk_state(db).packs).rows.cells) != 1 || map.get_or(manifest.pack_lists(disk_state(db).packs).rows.cells, cell, 0u64) != replaced || l69_pack_live(db, pack) != before_live {
        fail("L87 (d): main's merge files T, L and R into its holder cell for beta, live[P] keeps them, and beta's own fold records nothing")
    }
    let _ = gate_walk_all(d, db, rows.id)?
    gate_reads_rows(db, main_branch(db), rows, row_count, gone)?
    let forked = match branch(db, "beta") {
        Some(b) => b,
        None => fail("L87 (d): beta survives the fold"),
    }
    gate_reads_rows(db, forked, rows, row_count, gone)?
    let _ = adopt(mut db, forked)?
    for round in 0u64 .. 2 {
        if l69_pack_live(db, pack) != before_live - replaced {
            fail("L87 (d): adopt(beta) retires main's cell from live[P] exactly once")
        }
        gate_reads_rows(db, main_branch(db), rows, row_count, gone)?
        let _ = gate_walk_all(d, db, rows.id)?
        if round == 0 {
            close(take db)?
            db = open(tasks, d, c, r, l69_options(floor)?)?
        }
    }
    close(take db)
}

@test
fn test_l87_merge_across_a_fork(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_merge_fork(d, c, r, tasks, NoCrash)
}


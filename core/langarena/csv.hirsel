// kostya/LangArena 3c9f84d benchmarks/csv_parse.rs:30-115.
// Read raw CSV fields and parse columns 1, 3 and 5 into owned points.
type Point {
    x: f64,
    y: f64,
    z: f64
}

fn generate(rows: u64) -> Result[String, helper.Error] {
    let mut out = string.new()
    let mut g = helper.lcg()
    for i in 0 .. rows {
        let digit: u32 = int.narrow(i % 26)
        let code: u32 = 65 + digit
        let c = option.unwrap(char.from_u32(code))
        let x = helper.next_float(mut g, 1.0)
        let z = helper.next_float(mut g, 1.0)
        let y = helper.next_float(mut g, 1.0)
        string.push(mut out, "\"point ")
        string.push_char(mut out, c)
        string.push(mut out, "\\n, \"\"")
        string.push_u64(mut out, i % 100)
        string.push(mut out, "\"\"\",")
        float.push_fixed64(mut out, x, 10)
        string.push(mut out, ",,")
        float.push_fixed64(mut out, z, 10)
        string.push(mut out, ",\"[")
        string.push(mut out, if i % 2 == 0 {
            "true"
        } else {
            "false"
        })
        string.push(mut out, "\\n, ")
        string.push_u64(mut out, i % 100)
        string.push(mut out, "]\",")
        float.push_fixed64(mut out, y, 10)
        string.push(mut out, "\n")
    }
    Ok(take out)
}

fn number(source: String, f: std.csv.Field) -> Result[f64, helper.Error] {
    if f.quoted {
        return Error(Config)
    }
    match float.parse64(string.slice(source, f.span.start, f.span.end)) {
        Ok(v) => Ok(v),
        Error(_) => Error(Config),
    }
}

fn parse(source: String) -> Result[List[Point], helper.Error] {
    let b = string.as_bytes(source)
    let n = list.len(b)
    let mut points: List[Point] = list.new()
    let mut fields: List[std.csv.Field] = list.new()
    let dialect = std.csv.Dialect(delimiter: b',', crlf: false)
    let mut i: u64 = 0
    while i < n {
        let next = match std.csv.record(b, i, dialect, true, mut fields) {
            Ok(Record(next)) => next,
            _ => return Error(Config),
        }
        if list.len(fields) != 6 {
            return Error(Config)
        }
        // Only columns 1, 3 and 5 are coordinates.
        let x = number(source, fields[1])?
        let z = number(source, fields[3])?
        let y = number(source, fields[5])?
        list.push(mut points, Point(x, y, z))
        i = next
    }
    Ok(take points)
}

pub fn dispatch(config: helper.Settings, name: String, warmup: u64, iterations: u64) -> Result[u32, helper.Error] {
    if name != "CSV::Parse" {
        return Error(UnknownTask)
    }
    let rows = helper.config_i64(config, "rows")?
    if rows < 0 {
        return Error(Config)
    }
    let source = generate(int.narrow(rows))?
    let mut checksum: u32 = 0
    for _ in 0 .. warmup + iterations {
        let points = parse(source)?
        if list.len(points) == 0 {
            continue
        }
        let mut x: f64 = 0.0
        let mut y: f64 = 0.0
        let mut z: f64 = 0.0
        for p in points {
            x += p.x;
            y += p.y;
            z += p.z
        }
        let count: f64 = float.from_int(list.len(points))
        checksum = int.wrapping_add(checksum, helper.checksum_f64(x / count)?)
        checksum = int.wrapping_add(checksum, helper.checksum_f64(y / count)?)
        checksum = int.wrapping_add(checksum, helper.checksum_f64(z / count)?)
    }
    Ok(int.wrapping_add(checksum, helper.checksum_str(source)))
}

pub fn main(out: Stdout, d: Dir, argv: Args) -> Result[(), Exit] waits {
    harness.main(out, d, argv, fn(c: helper.Settings, n: String, w: u64, i: u64) -> Result[u32, helper.Error] {
        dispatch(c, n, w, i)
    })
}

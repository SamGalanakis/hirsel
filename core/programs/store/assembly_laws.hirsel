// Store regression laws appended by the store and runner test drivers.
// Store identity/catalog rules: write, read, drop and recreate twice. Each
// iteration must find exactly its newly written (1, i), so the result is true.
fn assembly_bucket(v: u64) -> Result[u64, Capacity] {
    Ok(v % 4)
}

pub fn law_assembly_indexed_recreate(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    result.unwrap(store.create_table(mut db, store.spec("t", std.codec.key_u64(), std.codec.of_u64())))
    let mut t = result.unwrap(store.table(mut db, "t", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(store.create_index(mut db, t, "i", code.describe(assembly_bucket), std.codec.key_u64()))
    let mut ix = result.unwrap(store.index(db, mut t, "i", code.describe(assembly_bucket), std.codec.key_u64()))
    for i in 0u64 .. 2 {
        let done = store.run(mut db, None, fn(mut tx: store.Tx) -> Result[(), store.Error] {
            store.put(mut tx, t, 1, i)
        })
        match take done {
            Ok(Committed(_)) => {},
            _ => return false
        }
        if result.unwrap(store.get(store.snapshot(db), store.shape(t), 1)) != Some(i) {
            return false
        }
        let mut rows = result.unwrap(store.find(store.snapshot(db), ix, Unbounded, Unbounded))
        if result.unwrap(store.next(mut rows)) != Some((1u64, i)) {
            return false
        }
        result.unwrap(store.drop_table(mut db, take t))
        result.unwrap(store.create_table(mut db, store.spec("t", std.codec.key_u64(), std.codec.of_u64())))
        t = result.unwrap(store.table(mut db, "t", std.codec.key_u64(), std.codec.of_u64()))
        result.unwrap(store.create_index(mut db, t, "i", code.describe(assembly_bucket), std.codec.key_u64()))
        ix = result.unwrap(store.index(db, mut t, "i", code.describe(assembly_bucket), std.codec.key_u64()))
    }
    true
}

@test
fn test_assembly_indexed_recreate(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_assembly_indexed_recreate(c, r) {
        Ok(())
    } else {
        Error(())
    }
}

fn shared_store_bytes(i: u64) -> Bytes {
    let mut out: Bytes = result.unwrap(list.with_capacity(1024))
    for _ in 0u64 .. 1024 {
        result.unwrap(list.push(mut out, int.narrow(i)))
    }
    take out
}

// One overwritten row needs its log copies and a copied path, not 64 KiB of
// unchanged leaf payload. The old snapshot must still contain all 32 rows.
pub fn law_shared_payload_copy(c: Clock) -> bool {
    let mut db = test_db(c, 1073741824)
    for i in 0u64 .. 32 {
        let key = shared_store_bytes(i)
        let value = shared_store_bytes(i)
        let _ = result.unwrap(execute(mut db, 0, i, None, fn(mut tx: Tx) -> Result[(), Error] {
            put_bytes(mut tx, 1, key, value)
        }))
    }
    let held = snapshot(db)
    let key = shared_store_bytes(16)
    let value = shared_store_bytes(99)
    let attempted = result.unwrap(bound bytes 32768 {
        execute(mut db, 0, 32, None, fn(mut tx: Tx) -> Result[(), Error] {
            put_bytes(mut tx, 1, key, value)
        })
    })
    match take attempted {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let now = snapshot(db)
    for i in 0u64 .. 32 {
        let old = option.unwrap(result.unwrap(get_bytes(held, 1, shared_store_bytes(i))))
        let current = option.unwrap(result.unwrap(get_bytes(now, 1, shared_store_bytes(i))))
        let expected = if i == 16 {
            99u64
        } else {
            i
        }
        if list.len(old) != 1024 || old[0] != int.narrow(i) || old[1023] != int.narrow(i) || list.len(current) != 1024 || current[0] != int.narrow(expected) || current[1023] != int.narrow(expected) {
            return false
        }
    }
    version(held) == 32 && version(now) == 33
}

@test
fn test_shared_payload_copy(c: Clock) -> Result[(), ()] {
    if law_shared_payload_copy(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn pages_match(s: Snapshot, sh: Shape[u64, u64], ix: Index[u64, u64, u64], indexed: bool, limits: Limits) -> bool {
    let table_model: Inline[(u64, u64), 5] = [(2, 5), (3, 9), (4, 2), (5, 13), (6, 6)]
    let index_model: Inline[(u64, u64), 5] = [(2, 5), (3, 9), (5, 13), (4, 2), (6, 6)]
    let expected = if indexed { index_model } else { table_model }
    let mut page = if indexed {
        result.unwrap(find_page(s, ix, Included(1), Excluded(3), limits))
    } else {
        result.unwrap(scan_page(s, sh, Excluded(1), Included(6), limits))
    }
    let mut offset = 0u64
    for _ in 0u64 .. 5 {
        let mut count = 0u64
        while offset + count < 5 && count < limits.rows {
            if count > 0 && (count + 1) * 22 > limits.byte_limit {
                break
            }
            count += 1
        }
        if list.len(page.rows) != count || page.byte_count != count * 22 {
            return false
        }
        for position in 0u64 .. count {
            if page.rows[position] != expected[offset + position] {
                return false
            }
        }
        offset += count
        let Page(rows: _, byte_count: _, next: take resume) = take page
        match take resume {
            None => return offset == 5,
            Some(take token) => {
                if offset == 5 {
                    return false
                }
                let resumed = if indexed {
                    find_next(s, ix, take token, limits)
                } else {
                    scan_next(s, sh, take token, limits)
                }
                match take resumed {
                    Ok(Paged(take following)) => { page = take following },
                    _ => return false
                }
            }
        }
    }
    false
}

fn page_token(take page: Page[u64, u64]) -> Resume {
    let Page(rows: _, byte_count: _, next: take resume) = take page
    option.unwrap(take resume)
}

fn page_missing[T](take actual: Result[T, Error], name: String) -> bool {
    match take actual {
        Error(Missing(field)) => field == name,
        _ => false
    }
}

fn page_empty(take page: Page[u64, u64]) -> bool {
    match page.next {
        None => list.len(page.rows) == 0 && page.byte_count == 0,
        Some(_) => false
    }
}

pub fn law_keyset_pages(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("pages", std.codec.key_u64(), std.codec.of_u64())))
    let mut original = result.unwrap(table(mut db, "pages", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(create_index(mut db, original, "bucket", code.describe(bucket), std.codec.key_u64()))
    let ix = result.unwrap(index(db, mut original, "bucket", code.describe(bucket), std.codec.key_u64()))
    let sh = shape(original)
    let written = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        let inserted: Inline[(u64, u64), 7] = [(5, 13), (3, 9), (7, 3), (1, 8), (6, 6), (2, 5), (4, 2)]
        for (key, value) in inserted {
            put(mut tx, original, key, value)?
        }
        Ok(())
    })
    match take written {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let held = snapshot(db)
    let byte_limits: Inline[u64, 3] = [21, 22, 66]
    for row_limit in 1u64 .. 4 {
        for byte_limit in byte_limits {
            let limits = Limits(rows: row_limit, byte_limit: byte_limit)
            if !pages_match(held, sh, ix, false, limits) || !pages_match(held, sh, ix, true, limits) {
                return false
            }
        }
    }
    let one = Limits(rows: 1, byte_limit: 22)
    if !page_empty(result.unwrap(scan_page(held, sh, Excluded(5), Included(5), one))) ||
        !page_empty(result.unwrap(find_page(held, ix, Included(1), Excluded(1), one))) {
        return false
    }
    let zero_rows = Limits(rows: 0, byte_limit: 22)
    let zero_bytes = Limits(rows: 1, byte_limit: 0)
    if !page_missing(scan_page(held, sh, Unbounded, Unbounded, zero_rows), "rows") ||
        !page_missing(find_page(held, ix, Unbounded, Unbounded, zero_bytes), "bytes") ||
        !page_missing(scan_next(held, sh, page_token(result.unwrap(scan_page(held, sh, Unbounded, Unbounded, one))), zero_bytes), "bytes") ||
        !page_missing(find_next(held, ix, page_token(result.unwrap(find_page(held, ix, Unbounded, Unbounded, one))), zero_rows), "rows") {
        return false
    }

    result.unwrap(drop_table(mut db, take original))
    result.unwrap(create_table(mut db, spec("pages", std.codec.key_u64(), std.codec.of_u64())))
    let mut fresh = result.unwrap(table(mut db, "pages", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(create_index(mut db, fresh, "bucket", code.describe(bucket), std.codec.key_u64()))
    let fresh_ix = result.unwrap(index(db, mut fresh, "bucket", code.describe(bucket), std.codec.key_u64()))
    let fresh_shape = shape(fresh)
    let current = snapshot(db)
    match scan_next(current, fresh_shape, page_token(result.unwrap(scan_page(held, sh, Unbounded, Unbounded, one))), one) {
        Ok(Moved(head)) => if head != version(current) { return false },
        _ => return false
    }
    match find_next(current, fresh_ix, page_token(result.unwrap(find_page(held, ix, Unbounded, Unbounded, one))), one) {
        Ok(Moved(head)) => if head != version(current) { return false },
        _ => return false
    }
    match scan_next(held, fresh_shape, page_token(result.unwrap(scan_page(held, sh, Unbounded, Unbounded, one))), one) {
        Error(Stale(1)) => {},
        _ => return false
    }
    match find_next(held, fresh_ix, page_token(result.unwrap(find_page(held, ix, Unbounded, Unbounded, one))), one) {
        Error(Stale(2)) => true,
        _ => false
    }
}

@test
fn test_keyset_pages(c: Clock) -> Result[(), ()] waits {
    if law_keyset_pages(c) { Ok(()) } else { Error(()) }
}

fn settle_fault_at(mut tx: Tx, attempted_at: u64) -> Result[Bytes, Bytes] {
    if info(mut tx).at == attempted_at {
        let no_values: List[u64] = list.new()
        let _ = no_values[0]
    }
    Ok(key_word(19))
}

// L33/AM6. Two intervening commits put the attempted base three versions
// behind the settle frame. Set the previous times to known wall-clock floors.
pub fn law_settled_callinfo(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    settled_callinfo_case(d, c, r, tasks, false) && settled_callinfo_case(d, c, r, tasks, true)
}

fn settled_callinfo_case(d: Dir, c: Clock, r: Random, tasks: Tasks, room_refusal: bool) -> bool waits {
    let dir = disk_test_directory(d)
    let options = journal_crash_options()
    let mut db = result.unwrap(open(tasks, dir, c, r, options))
    result.unwrap(declare_authority(mut db, list.new()))
    let stream = key_word(55)
    let rec = call_for(stream, 32)
    let request = request_digest(rec.key, rec.args)
    let admission = result.unwrap(admit(mut db, stream, 0, request))
    let Admitted(take complete) = take admission else { return false }
    result.unwrap(durable(mut db, ticket(complete)))
    let original_at = 0x8000_0000_0000_0000u64
    db.heads[0].at = original_at
    let plan = Plan(n_p: 8192, s_p: 8192, n_e: 4096, s_e: 8192, reply_max: 4096)
    if room_refusal { db.ceiling = db.resident }
    let fault_at = if room_refusal { original_at + 1u64 } else { original_at }
    let tried = serve(mut db, take complete, plan, Some(take rec), law_caller(), code.describe(reserve_policy),
        scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] { settle_fault_at(mut tx, fault_at) })
    let (take stopped, way) = match take tried {
        Ok(Failed(take pending_run, Raised(2u32))) if !room_refusal => (take pending_run, 1u8),
        // The admitted row costs 118 (62 + 8 + 48). The replied row costs
        // 158 (62 + 8 + 88). Its stream-only frame adds 140 and CALL adds
        // 206 (22 + 32 + 16 + 8 + 32 + 96), so the refusal requests 504.
        Ok(NoRoom(take pending_run, reason)) if room_refusal && reason.requested == 504 &&
            reason.available == 118 => (take pending_run, 2u8),
        _ => return false,
    }
    if version(snapshot(db)) != 1 || stream_now(db, stream) != (0u64, 1u64) {
        return false
    }
    if let Some(_) = result.unwrap(recorded(db, main_branch(db), 2)) { return false }
    db.ceiling = options.resident_limit
    db.heads[0].at = original_at + 1u64
    for _ in 0u64 .. 2 {
        let advanced = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), ()] { Ok(()) }))
        if let Committed(_) = advanced {} else { return false }
    }
    let settled = conclude(mut db, take stopped, key_word(2), Resident)
    let Ok(Committed(receipt)) = take settled else { return false }
    if receipt.reply != key_word(2) { return false }
    let expected_digest = receipt.digest
    result.unwrap(durable(mut db, receipt.ticket))
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, dir, c, r, options))
    let line = main_branch(reopened)
    let Some(found) = result.unwrap(recorded(reopened, line, 4)) else { return false }
    let ctx = call_info(reopened.store, 0, 2, original_at, original_at)
    if found.settle != way || found.base != 1 || found.at != original_at || found.seed != ctx.seed || reopened.heads[0].at != original_at + 1u64 {
        return false
    }
    let duplicate = result.unwrap(admit(mut reopened, stream, 0, request))
    let good = match duplicate {
        Duplicate(stored) => stored.reply == key_word(2) &&
            stored.scope_digest.a == expected_digest.a && stored.scope_digest.b == expected_digest.b &&
            stored.scope_digest.c == expected_digest.c && stored.scope_digest.d == expected_digest.d,
        _ => false,
    }
    result.unwrap(close(take reopened))
    good
}

// Disconnect the writer after the runner has admitted a position.
pub fn fixture_broken_handoff(mut db: Db) {
    let (to, abandoned): (Sender[JournalMsg], Receiver[JournalMsg]) = result.unwrap(channel.new(1))
    let mut disconnected = Some(take abandoned)
    disconnected = None
    db.journal = Some(take to)
}

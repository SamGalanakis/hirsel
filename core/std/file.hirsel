// Module `file`: files below a Dir, as library code over core's host primitives
// (core/core/host.hirsel; core.md, "Host"). Every operation passes the replay point
// at issue and at delivery (CAP-8) and, when marked `waits`, is a cancellation point
// (CONC-7). Field legend: API.md; "Prefix:" says what has happened on the host when the
// operation fails or is cancelled part way.
//
// The open file is core's HostFile: a `send` mechanical resource with a position (MEM-24):
// making one admits nothing, and its finalizer closes it and ignores the outcome, as Rust's
// File does; call `close` to see the error. The seed writes it `HostFile` and adds no
// wrapper.
//
// OpenMode (core.md, "Host"): Read opens an existing file for reading; Write creates or
// empties a file for writing; Append creates or opens one for writing at the end;
// CreateNew creates one for writing and fails with Exists; ReadWrite opens for reading and
// writing and creates the file when absent.
/// A host error or invalid UTF-8 encountered while reading.
pub type Error = Io(IoError) | NotUtf8

/// A host error, invalid UTF-8, or a file that exceeds the requested byte limit.
pub type BoundedReadError = ReadError(Error) | TooLarge(u64)

/// Opens p in mode. `host.open`. Fails: Error(NotFound | Denied | Exists | Other(_)).
/// Prefix: nothing on failure; on success Write and CreateNew may have created p and Write
/// emptied it. A cancellation at delivery closes the handle.
/// Ex: `let src = std.file.open(d, "source.txt", Read)?`
pub fn open(d: Dir, p: String, mode: OpenMode) -> Result[HostFile, IoError] waits {
    host.open(d, p, mode)
}

/// Reads at most capacity(buf) - len(buf) bytes from f's position and appends them to
/// buf. Ok(0) means EOF. No spare capacity gives Error(Other(22)) before issue.
/// Fails: Error(Denied | Closed | Other(_)); buf unchanged. Alloc: nothing; buf never
/// grows. Prefix: on failure nothing was read. Cost: O(n) bytes.
/// Ex: `list.clear(mut buf); let n = std.file.read_into(mut src, mut buf)?`
pub fn read_into(mut f: HostFile, mut buf: Bytes) -> Result[u64, IoError] waits {
    host.read(mut f, mut buf)
}

/// Writes all of data at f's position. `host.write`.
/// Fails: Error(WriteError(written: n, error: e)).
/// Prefix: the first n bytes are written and stay written; the position moved by n.
/// Alloc: nothing. Cost: O(len). Ex: `std.file.write_all(mut dst, list.slice(buf, 0, 17))?`
pub fn write_all(mut f: HostFile, data: Bytes) -> Result[(), WriteError] waits {
    host.write(mut f, data)
}

/// Appends at a byte offset with the same room requirement and EOF result as read_into.
pub fn read_at(mut f: HostFile, at: u64, mut buf: Bytes) -> Result[u64, IoError] waits {
    host.read_at(mut f, at, mut buf)
}

/// Writes data at a byte offset. Errors report the committed prefix.
pub fn write_at(mut f: HostFile, at: u64, data: Bytes) -> Result[(), WriteError] waits {
    host.write_at(mut f, at, data)
}

/// Reports the open file's kind, size and modification time.
pub fn stat(mut f: HostFile) -> Result[Stat, IoError] waits {
    host.stat_file(mut f)
}

/// Closes f and reports the host's close error. `host.close`. Either way f is ended and
/// its finalizer does not run. Ex: `std.file.close(take src)?`
pub fn close(take f: HostFile) -> Result[(), IoError] waits {
    host.close(take f)
}

/// Reads the whole file p: opens it Read, then `list.reserve` and `host.read` until
/// Ok(0), then closes it. Grows by GROWTH from 4096 bytes.
/// Returns Error(Io(_)) on a host error. Refused growth raises Capacity and
/// cleanup closes the file and refunds the buffer (FAIL-5).
/// Alloc: the Bytes, current limit.
/// Prefix: nothing on the host changes. Cost: O(size).
/// Ex: `let raw = std.file.read(d, "input.txt")?`
pub fn read(d: Dir, p: String) -> Result[Bytes, Error] waits {
    let mut f = match host.open(d, p, Read) {
        Ok(take h) => take h,
        Error(e) => return Error(Io(e)),
    }
    let mut buf: Bytes = list.new()
    loop {
        if list.len(buf) == list.capacity(buf) {
            let want: u64 = if list.capacity(buf) == 0 {
                4096
            } else {
                list.capacity(buf)
            }
            list.reserve(mut buf, want)
        }
        match host.read(mut f, mut buf) {
            Ok(0) => break,
            Ok(_) => {}
            Error(e) => return Error(Io(e)),
        }
    }
    match host.close(take f) {
        Ok(()) => Ok(take buf),
        Error(e) => Error(Io(e)),
    }
}

/// As read, then `string.from_utf8`; Error(NotUtf8) when it is not UTF-8 (the bytes
/// are cleaned). Ex: `let s = std.file.read_string(d, input)?`
pub fn read_string(d: Dir, p: String) -> Result[String, Error] waits {
    let b = read(d, p)?
    match string.from_utf8(take b) {
        Ok(take s) => Ok(take s),
        Error(_) => Error(NotUtf8),
    }
}

/// Reads p to EOF or returns Error(TooLarge(max_bytes)) after one excess byte.
/// Grows the buffer as needed, up to max_bytes + 1. A refused allocation raises
/// Capacity. Cleanup closes the file and refunds the buffer on failure.
pub fn read_bounded(d: Dir, p: String, max_bytes: u64) -> Result[Bytes, BoundedReadError] waits {
    let mut f = host.open(d, p, Read) ?=> |e| ReadError(Io(e))
    let ceiling = int.saturating_add(max_bytes, 1)
    let mut buf: Bytes = list.with_capacity(order.min(4096, ceiling))
    loop {
        if list.len(buf) == list.capacity(buf) {
            let capacity = order.min(int.saturating_mul(list.capacity(buf), 2), ceiling)
            let mut next: Bytes = list.with_capacity(capacity)
            list.append(mut next, buf)
            buf = take next
        }
        let n = host.read(mut f, mut buf) ?=> |e| ReadError(Io(e))
        if n == 0 {
            break
        }
        if list.len(buf) > max_bytes {
            return Error(TooLarge(max_bytes))
        }
    }
    host.close(take f) ?=> |e| ReadError(Io(e))
    Ok(take buf)
}

/// Reads at most max_bytes of UTF-8. The byte limit is checked before decoding.
pub fn read_string_bounded(d: Dir, p: String, max_bytes: u64) -> Result[String, BoundedReadError] waits {
    let b = read_bounded(d, p, max_bytes)?
    match string.from_utf8(take b) {
        Ok(take s) => Ok(take s),
        Error(_) => Error(ReadError(NotUtf8)),
    }
}

/// Opens p Write, writes all of data, then closes it.
/// Fails: Error(Io(e)) from any of the three. Prefix: the file may exist holding a
/// prefix of data of unknown length (use open, write_all and close to learn it).
/// Alloc: nothing. Ex: `std.file.write(d, "source.txt", data)?`
pub fn write(d: Dir, p: String, data: Bytes) -> Result[(), IoError] waits {
    let mut f = host.open(d, p, Write)?
    if let Error(e) = host.write(mut f, data) {
        return Error(e.error)
    }
    host.close(take f)
}

/// Removes the file p. `host.remove`. Fails: Error(NotFound | Denied | Other(_)).
/// Prefix: a cancellation at delivery leaves it removed. Ex: `std.file.remove(d, p)?`
pub fn remove(d: Dir, p: String) -> Result[(), IoError] waits {
    host.remove(d, p)
}

// The OS file lock: advisory, exclusive, whole-file (flock semantics, as Rust's
// File::try_lock). Lock is a `send` resource that owns the locked file, so the lock is
// released exactly once: by `unlock`, or by its finalizer, which unlocks (ignoring the
// error) and then cleans the file field, whose finalizer closes the handle. Making a Lock
// admits one 40-byte block: its HostFile field 8 plus its cause cell 32 (MEM-24, "resource
// value"). try_lock makes it before asking the host, so a refused admission leaves the host
// untouched. A refused
// resource literal hands its one field back (`Result[Lock, (Capacity, HostFile)]`), so on
// Capacity the file comes back open and unlocked.
pub opaque resource type Lock: send {
    f: HostFile
} drop(l) {
    let _ = host.unlock(mut l.f)
}

/// Held(f): another handle holds the lock; f comes back unlocked. Io(e, f): the host
/// refused for another reason; f comes back unlocked. Capacity(c, f): the Lock's block was
/// refused before the host was asked; f comes back untouched.
pub type LockError = Held(HostFile) | Io(IoError, HostFile) | Capacity(Capacity, HostFile)

/// Takes the lock on f without blocking. `host.try_lock`.
/// Fails: Error(Held(f)) or Error(Io(e, f)), f unlocked and the Lock's 40 bytes refunded;
/// Error(Capacity(c, f)), f untouched and the host not asked. Alloc: 40, current limit.
/// Prefix: on failure the lock is not held. Cost: one host call.
/// Ex: `let l = match std.file.try_lock(take lf) { Ok(take l) => l, Error(Held(take lf)) => .. }`
pub fn try_lock(take f: HostFile) -> Result[Lock, LockError] waits {
    let mut l = match Lock(f: take f) {
        Ok(take made) => take made,
        Error((c, take back)) => return Error(Capacity(c, take back)),
    }
    match host.try_lock(mut l.f) {
        Ok(true) => Ok(take l),
        Ok(false) => {
            let Lock(f: take back) = take l
            Error(Held(take back))
        }
        Error(e) => {
            let Lock(f: take back) = take l
            Error(Io(e, take back))
        }
    }
}

/// Unlocks and returns the file, still open. `host.unlock`. Fails: Error((e, f)): the
/// unlock failed and the lock state is the host's; closing f releases it. Either way l
/// is ended exactly once. Alloc: nothing; the cause cell is refunded.
/// Ex: `let lf = std.file.unlock(take l)?`
pub fn unlock(take l: Lock) -> Result[HostFile, (IoError, HostFile)] waits {
    let Lock(f: take f) = take l
    let mut g = take f
    match host.unlock(mut g) {
        Ok(()) => Ok(take g),
        Error(e) => Error((e, take g)),
    }
}

/// Creates an exclusive temporary file below d and appends its suffix to name.
/// Requires 32 bytes of spare capacity. The caller owns the file and its removal.
pub fn create_temp(d: Dir, mut name: String) -> Result[HostFile, IoError] waits {
    host.mkstemp(d, mut name)
}

/// NotReplaced leaves the old file in place. Unsynced leaves the new file visible
/// with unknown crash durability.
pub type ReplaceError = NotReplaced(IoError) | Unsynced(IoError)

fn write_synced(take f: HostFile, data: Bytes) -> Result[(), IoError] waits {
    let mut out = take f
    if let Error(e) = host.write(mut out, data) {
        return Error(e.error)
    }
    host.sync(mut out)?
    host.close(take out)
}

/// Atomically replaces one regular file directly in d. Syncs the new contents before
/// renaming, then syncs the directory. On error before rename, attempts to remove
/// the temp file. Cancellation before rename may leave a .hirsel-tmp- file behind.
pub fn replace(d: Dir, name: String, data: Bytes) -> Result[(), ReplaceError] waits {
    if !path.is_name(name) {
        return Error(NotReplaced(Denied))
    }
    let mut tmp = string.with_capacity(45)
    let prefix = if string.starts_with(name, ".hirsel-tmp-0") {
        ".hirsel-tmp-1"
    } else {
        ".hirsel-tmp-0"
    }
    string.push(mut tmp, prefix)
    let f = match create_temp(d, mut tmp) {
        Ok(take f) => take f,
        Error(e) => return Error(NotReplaced(e)),
    }
    let renamed = match write_synced(take f, data) {
        Ok(()) => host.rename(d, tmp, name),
        Error(e) => Error(e),
    }
    if let Error(e) = renamed {
        let _ = host.remove(d, tmp)
        return Error(NotReplaced(e))
    }
    match host.sync_dir(d) {
        Ok(()) => Ok(()),
        Error(e) => Error(Unsynced(e)),
    }
}

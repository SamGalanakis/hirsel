// Module `string`: String, own valid UTF-8 (SEM-3). Field legend, GROWTH, FREEZE and CORE:
// API.md, "Reading a contract". CORE operations are core.md's, restated; the others are
// library code over them.
//
// Representation: String is an opaque own type over a Bytes block: a 24-byte header
// inline, storage capacity x 1 byte rounded up to 8, charged to the limit where it was
// made (MEM-28); GROWTH as for lists. A literal is static: never charged; its first growth
// copies it. Positions are byte offsets. Equality, order and hashing are bytewise (`==`,
// `<`); nothing normalises. Cutting a string is `string.find` plus `string.slice`: a
// library function cannot return a sub-view it got from a core operation (OWN-20; N2 in
// SPEC-GAPS), so split_once and strip_prefix are not in the seed. Scalars are read with
// `next_scalar` in a `while let` loop; `for` iterates only built-in sources (SEM-6).

/// CORE. An empty string with no storage. Alloc: nothing. Ex: `let mut line = string.new()`
pub fn new() -> String

/// An empty string with storage for n bytes: `string.from_utf8` of `list.with_capacity(n)`.
/// Fails: Error(c). Alloc: n rounded to 8, current limit. Cost: O(1).
/// Ex: `let mut reply = string.with_capacity(256)?`
pub fn with_capacity(n: u64) -> Result[String, Capacity]

/// CORE. A new string holding a copy of s (a literal or a view).
/// Fails: Error(c). Alloc: byte_len(s) rounded to 8, current limit. Cost: O(len).
/// Ex: `let k = string.from(key)?`
pub fn from(s: String) -> Result[String, Capacity]

/// CORE. As `from`. Ex: `let w = string.copy(string.slice(line, 0, i))?`
pub fn copy(s: String) -> Result[String, Capacity]

/// CORE. Takes b's block as a String if it is valid UTF-8; no copy.
/// Fails: Error(b), b returned unchanged. Alloc: nothing. Cost: O(len) validation.
/// Ex: `let s = match string.from_utf8(take raw) { Ok(s) => s, Error(raw) => .. }`
pub fn from_utf8(take b: Bytes) -> Result[String, Bytes]

/// CORE. Gives up the String's block as Bytes; no copy. Alloc: nothing. Cost: O(1).
/// Ex: `let b = string.into_bytes(take s)`
pub fn into_bytes(take s: String) -> Bytes

/// CORE. A sub-view of s's bytes (OWN-8). View: anchored to s; FREEZE s. Cost: O(1).
/// Ex: `for b in string.as_bytes(s) { sum += int.widen(b) }`
pub fn as_bytes(s: String) -> View[Bytes] in s

/// CORE. A sub-view of bytes from..to (OWN-8). Fails: Bounds (failure) unless
/// from <= to <= byte_len and both are scalar boundaries; check with `is_boundary` first
/// when the positions come from input. View: anchored to s; FREEZE s. Cost: O(1).
/// Ex: `let key = string.slice(line, 0, colon)`
pub fn slice(s: String, from: u64, to: u64) -> View[String] in s

/// CORE. The scalar at byte position at and the position after it; None at or past the end.
/// Fails: Bounds (failure) when at is not a boundary. Cost: O(1).
/// Ex: `let mut at: u64 = 0; while let Some((c, n)) = string.next_scalar(s, at) { ..; at = n }`
pub fn next_scalar(s: String, at: u64) -> Option[(char, u64)]

/// CORE. Length in bytes. Cost: O(1). Ex: `string.byte_len(s)`
pub fn byte_len(s: String) -> u64

/// Whether i is a scalar boundary: i == byte_len, or i < byte_len and byte i is not a
/// continuation byte. Cost: O(1). Ex: `if !string.is_boundary(text, at) { return Error(BadPosition) }`
pub fn is_boundary(s: String, i: u64) -> bool

/// CORE. Appends t. Fails: Error(c); s unchanged. Alloc: GROWTH. Cost: O(byte_len(t)).
/// Ex: `string.push(mut line, "\n")?`
pub fn push(mut s: String, t: String) -> Result[(), Capacity]

/// CORE. Appends one scalar as 1 to 4 bytes. Fails: Error(c); s unchanged. Alloc: GROWTH.
/// Ex: `string.push_char(mut out, c)?`
pub fn push_char(mut s: String, c: char) -> Result[(), Capacity]

/// CORE. Appends n in decimal. Fails: Error(c); s unchanged. Alloc: GROWTH, at most 20 bytes.
/// Ex: `string.push_u64(mut line, n)?`
pub fn push_u64(mut s: String, n: u64) -> Result[(), Capacity]

/// Appends n in decimal, with '-' when negative. Fails: Error(c); s unchanged.
/// Alloc: one GROWTH, at most 20 bytes. Ex: `string.push_i64(mut s, -3)?`
pub fn push_i64(mut s: String, n: i64) -> Result[(), Capacity]

/// Appends n in `base` (2 to 36, lower-case), left-padded with `pad` to at least `width`
/// scalars (Go strconv.AppendUint plus padding). Fails: Bounds (failure) when base is
/// outside 2..=36; Error(c) when the one admission of the whole text is refused, s
/// unchanged. Cost: O(digits + width). Ex: `string.push_uint(mut out, 31, 16, 4, '0')?` appends "001f"
pub fn push_uint(mut s: String, n: u64, base: u32, width: u64, pad: char) -> Result[(), Capacity]

/// Upper-cases ASCII a-z in place; other bytes are unchanged, so the result is valid UTF-8
/// of the same length (Rust make_ascii_uppercase). Library code over into_bytes and
/// from_utf8, which revalidates. Alloc: nothing. Cost: O(len).
/// Ex: `let mut up = string.copy(row)?; string.make_ascii_upper(mut up)`
pub fn make_ascii_upper(mut s: String)

/// Empties s; keeps storage. Alloc: nothing. Cost: O(1). Ex: `string.clear(mut line)`
pub fn clear(mut s: String)

/// The first byte position at or after `start` where pat occurs, or None. An empty pat is
/// found at `start`. Fails: Bounds (failure) when start > byte_len. Alloc: nothing.
/// Cost: O(len x len(pat)) worst case (naive search, as Go for short patterns).
/// Ex: `let Some(colon) = string.find(line, 0, ":") else { return Error(Malformed) }`
pub fn find(s: String, start: u64, pat: String) -> Option[u64]

/// Whether s begins with p. Cost: O(len(p)). Ex: `string.starts_with(line, "GET ")`
pub fn starts_with(s: String, p: String) -> bool

/// Whether s ends with p. Cost: O(len(p)). Ex: `string.ends_with(name, ".json")`
pub fn ends_with(s: String, p: String) -> bool

/// Bytewise order as Order (the order of `<`). Cost: O(min len). Ex: `string.compare(a, b)`
pub fn compare(a: String, b: String) -> Order

fn chain_caught() -> u64 {
    only_stack(isolate(fn() -> u64 { c01(0u64) }))
}

// Each 4 KiB level holds a probe whose finalizer calls a function with a 4 KiB frame;
// the deepest ones run at the edge of the allowance, inside the released margin.
resource type Probe { depth: u64 } drop(p) { let _ = deep(p.depth % 2u64); }

fn probed(n: u64) -> u64 {
    let probe = Probe(depth: n)
    let mut pad: Inline[u64, 512] = [0u64; 512]
    pad[n % 512u64] = n
    let below = if n == 0u64 { 0u64 } else { probed(n - 1u64) + pad[n % 512u64] - n + 1u64 }
    let _ = take probe
    below
}

fn finalizer_within_margin() -> u64 {
    only_stack(isolate(fn() -> u64 { probed(1000000u64) }))
}

// After a caught `Stack`, the margin is restored and the program goes on: a second
// refusal is caught alike, and ordinary calls run.
fn continues() -> u64 {
    let first = recursion_caught()
    let second = recursion_caught()
    if first == 1u64 && second == 1u64 && deep(100u64) == 100u64 { 1u64 } else { 0u64 }
}

// Recursive key glue walks its value in constant stack: `==`, `<` and hashing of a
// value a million levels deep finish inside the allowance, whatever field the
// recursion goes through. Box last: no continuation per level.
type Tail: key + ordered = End | Link(u64, Box[Tail])
// Box first: every level leaves the scalar after it for later.
type Head: key + ordered = Stop(u64) | Node(Box[Head], u64)
// A list of boxes per level, the deep one first.
type Kids: key + ordered = Leaf(u64) | Kids(List[Box[Kids]])
// A list of lists of boxes per level.
type Grid: key + ordered = Cell(u64) | Rows(List[List[Box[Grid]]])

fn tail(n: u64, bottom: u64) -> Tail {
    let mut c: Tail = Link(bottom, box.new(End))
    let mut i = 0u64
    while i < n {
        let prev = take c
        c = Link(i, box.new(take prev))
        i += 1u64
    }
    c
}

fn head(n: u64, bottom: u64, top: u64) -> Head {
    let mut c: Head = Stop(bottom)
    let mut i = 0u64
    while i < n {
        let prev = take c
        c = Node(box.new(take prev), i)
        i += 1u64
    }
    Node(box.new(take c), top)
}

fn kids(n: u64, bottom: u64) -> Kids {
    let mut c: Kids = Leaf(bottom)
    let mut i = 0u64
    while i < n {
        let prev = take c
        let mut xs: List[Box[Kids]] = list.new()
        list.push(mut xs, box.new(take prev))
        list.push(mut xs, box.new(Leaf(i)))
        c = Kids(take xs)
        i += 1u64
    }
    c
}

fn grid(n: u64, bottom: u64) -> Grid {
    let mut c: Grid = Cell(bottom)
    let mut i = 0u64
    while i < n {
        let prev = take c
        let mut down: List[Box[Grid]] = list.new()
        list.push(mut down, box.new(take prev))
        let mut flat: List[Box[Grid]] = list.new()
        list.push(mut flat, box.new(Cell(i)))
        let mut rows: List[List[Box[Grid]]] = list.new()
        list.push(mut rows, take down)
        list.push(mut rows, take flat)
        c = Rows(take rows)
        i += 1u64
    }
    c
}

fn answer(take r: Result[Result[u64, Causes], Capacity]) -> u64 {
    match take r {
        Ok(Ok(v)) => v,
        Ok(Error(_)) => 3u64,
        Error(_) => 4u64,
    }
}

fn found[K: key](take a: K, b: K) -> bool {
    let mut m: Map[K, u64] = map.new()
    map.insert(mut m, take a, 1u64)
    match map.get(m, b) { Some(_) => true, None => false }
}

// Each law holds at most two values `n` levels deep at once. The evaluator runs them
// shallower than the native engines (test_run_stack_native.rs) to save time.
// Equal values compare equal and find each other in a map.
fn tail_equal(n: u64) -> bool {
    let a = tail(n, 7u64)
    let b = tail(n, 7u64)
    a == b && !(a < b) && !(b < a) && found(take a, b)
}

// A value differing at the bottom compares by that difference.
fn tail_differs(n: u64) -> bool {
    let a = tail(n, 7u64)
    let c = tail(n, 8u64)
    a != c && a < c && !(c < a) && !found(take a, c)
}

fn head_equal(n: u64) -> bool {
    let a = head(n, 1u64, 9u64)
    let b = head(n, 1u64, 9u64)
    a == b && !(a < b) && !(b < a) && found(take a, b)
}

// The bottom decides before the top scalar after it, with a million continuations
// left; a walk straight after that early answer starts clean.
fn head_bottom_first(n: u64) -> bool {
    let a = head(n, 1u64, 9u64)
    let c = head(n, 2u64, 0u64)
    let first = a < c
    first && c == c && !(c < a) && a != c && !found(take a, c)
}

// A top scalar decides after the whole equal depth.
fn head_top_last(n: u64) -> bool {
    let a = head(n, 1u64, 9u64)
    let d = head(n, 1u64, 10u64)
    a < d && !(d < a) && a != d && !found(take a, d)
}

fn kids_equal(n: u64) -> bool {
    let a = kids(n, 7u64)
    let b = kids(n, 7u64)
    a == b && !(a < b) && found(take a, b)
}

fn kids_differs(n: u64) -> bool {
    let a = kids(n, 7u64)
    let c = kids(n, 8u64)
    a != c && a < c && !(c < a) && !found(take a, c)
}

fn grid_equal(n: u64) -> bool {
    let a = grid(n, 7u64)
    let b = grid(n, 7u64)
    a == b && !(a < b) && found(take a, b)
}

fn grid_differs(n: u64) -> bool {
    let a = grid(n, 7u64)
    let c = grid(n, 8u64)
    a != c && a < c && !(c < a) && !found(take a, c)
}

fn holds(ok: bool) -> u64 { if ok { 1u64 } else { 2u64 } }

fn tail_walks(n: u64) -> u64 {
    answer(isolate(fn() -> u64 { holds(tail_equal(n) && tail_differs(n)) }))
}

fn head_walks(n: u64) -> u64 {
    answer(isolate(fn() -> u64 { holds(head_equal(n) && head_bottom_first(n) && head_top_last(n)) }))
}

fn kids_walk(n: u64) -> u64 {
    answer(isolate(fn() -> u64 { holds(kids_equal(n) && kids_differs(n)) }))
}

fn grid_walk(n: u64) -> u64 {
    answer(isolate(fn() -> u64 { holds(grid_equal(n) && grid_differs(n)) }))
}

// An 8 MiB frame is past the single-frame ceiling (the allowance).
fn oversized(n: u64) -> u64 {
    let mut pad: Inline[u64, 1048576] = [0u64; 1048576]
    pad[n % 1048576u64] = n
    pad[0u64]
}

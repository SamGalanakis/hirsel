// rule: SER-2
// expect: run
// Canonical decoding as a law over arbitrary payload bytes: whenever
// `codec.decode_payload` accepts bytes, `codec.encode_payload` of the value is exactly
// those bytes, and otherwise it returns a `DecodeError` rather than fail. The bytes are
// single-byte mutations, truncations and extensions of a hand-written payload that
// reaches every validation of the schema (bool, char, NaN, UTF-8, tag, length, set order
// and duplicates, a checked type, counts no bytes can satisfy), plus short random
// strings decoded as Option[char].
@serializable
type Choice = Empty | Item(String)

@serializable(check = valid)
pub opaque type Month: plain + key + sendable + inert + noalloc_drop uses {} {
  number: u8,
}

@noalloc
fn valid(value: Month) -> bool uses {} {
  value.number >= 1 && value.number <= 12
}

@serializable
type Sample {
  flag: bool,
  letter: char,
  ratio: f32,
  name: String,
  small: Option[u8],
  tags: Set[u8],
  month: Month,
  kind: Choice,
  nums: List[u16],
}

type Tally {
  accepted: u64,
  refused: u64,
}

// The next value of a 64-bit linear congruential generator; callers use its high bits.
fn step(state: u64) -> u64 {
  int.wrapping_add(
    int.wrapping_mul(state, 6364136223846793005u64),
    1442695040888963407u64
  )
}

// `data` decodes as a `T` only to a value that encodes back to `data`.
// `data`, whose count no remaining bytes can satisfy, is Truncated.
fn truncated[T: serializable](t: Test, none: Option[T], data: Bytes) {
  let decoded: Result[T, DecodeError] = codec.decode_payload(none, data)
  match take decoded {
    Error(Truncated()) => test.check(t, true),
    _ => test.check(t, false),
  }
}

fn law[T: serializable](t: Test, none: Option[T], data: Bytes, mut tally: Tally) {
  let decoded: Result[T, DecodeError] = codec.decode_payload(none, data)
  match take decoded {
    Ok(v) => {
      tally.accepted += 1
      test.check(t, codec.encode_payload(v) == data)
    },
    Error(_) => {
      tally.refused += 1
    },
  }
}

pub fn main(t: Test) -> Result[(), DecodeError] {
  // flag true, letter 'A', ratio 1.5, name "hé", small Some(5), tags {3, 7}, month 12,
  // kind Item("s"), nums [1, 258].
  let seed: Bytes = b"\x01\x41\x00\x00\x00\x00\x00\xc0\x3f\x03\x00\x00\x00\x00\x00\x00\x00\x68\xc3\xa9\x01\x00\x00\x00\x05\x02\x00\x00\x00\x00\x00\x00\x00\x03\x07\x0c\x01\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x73\x02\x00\x00\x00\x00\x00\x00\x00\x01\x00\x02\x01"
  let sample_none: Option[Sample] = None()
  let mut tally = Tally(accepted: 0, refused: 0)
  law(t, sample_none, seed, mut tally)
  test.check(t, tally.accepted == 1)
  let n = bytes.len(seed)
  let mut state: u64 = 691
  let mut round: u64 = 0
  let mut oversized: u64 = 0
  while round < 300 {
    state = step(state)
    let r = state >> 32
    let at = r % n
    let mut out: List[u8] = []
    bytes.append(mut out, seed)
    let op = (r >> 8) % 5
    if op == 0 {
      out[at] = int.narrow(r >> 16 & 255)
    } else if op == 1 {
      list.truncate(mut out, at)
    } else if op == 2 {
      list.push(mut out, int.narrow(r >> 16 & 255))
    } else if op == 3 {
      let near: List[u8] = [0, 1, 2, 127, 128, 255]
      out[at] = near[(r >> 16) % 6]
    } else {
      // An oversized count: a nonzero byte in the high six bytes of the tags count
      // (offsets 27-32) or the nums count (offsets 51-56), far past both the bytes
      // left and the run's value budget, is Truncated input, never the end of the run.
      let high = 27u64 + (r >> 16) % 6 + if (r >> 24) % 2 == 0 {
        0u64
      } else {
        24u64
      }
      out[high] = int.narrow(1u64 + (r & 255) % 255)
      oversized += 1
    }
    let data = bytes.from_list(take out)
    if op == 4 {
      truncated(t, sample_none, data)
    }
    law(t, sample_none, data, mut tally)
    round += 1
  }
  let char_none: Option[Option[char]] = None()
  round = 0
  while round < 400 {
    state = step(state)
    let mut out: List[u8] = []
    let mut left = 3u64 + (state >> 32) % 7
    while left > 0 {
      state = step(state)
      let r = state >> 32
      // Mostly 0 and 1, so the u32 tags 0 and 1 and in-range scalars occur.
      list.push(
        mut out,
        int.narrow(
          if r % 4 == 0 {
            r >> 8 & 255
          } else if r % 4 == 1 {
            1u64
          } else {
            0u64
          }
        )
      )
      left -= 1
    }
    law(t, char_none, bytes.from_list(take out), mut tally)
    round += 1
  }
  // Both outcomes occur, so the law is not vacuous.
  test.check(t, tally.accepted > 15 && tally.refused > 100 && oversized > 20)
  Ok(())
}

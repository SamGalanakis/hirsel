// Heap exposes no key or ordered bound, so structural comparison is refused.
// expect: refuse LANG-21 at 5:48
// expect: refuse LANG-21 at 6:48
// expect: refuse LANG-12 at 7:18
fn equal(a: Heap[u64], b: Heap[u64]) -> bool { a == b }
fn order(a: Heap[u64], b: Heap[u64]) -> bool { a < b }
fn as_key(m: Map[Heap[u64], u64]) {}

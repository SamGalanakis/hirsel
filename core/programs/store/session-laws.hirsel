// A Reset encodes its 16-byte payload in place in one 30-byte wire capacity,
// charged as 32. Two connections hold one wire block each, so a third job's
// 32 bytes do not fit a 64-byte pool until one of the two blocks drops.
pub fn law_pool_holds_writer_bytes(tasks: Tasks, clock: Clock) -> bool waits {
    let config = wire_defaults(0u64, 0u64)
    let allocated: Result[(Sender[WireAllocation[()]], Task[()]), Capacity] = start_wire_pool(tasks, config, clock, 64u64, 2u64)
    let (pool, take pooled_task) = result.unwrap(take allocated)
    let (one_to, one_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) = result.unwrap(channel.new(1u64))
    let (two_to, two_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) = result.unwrap(channel.new(1u64))
    let (write, pending): (Sender[Bytes], Receiver[Bytes]) = result.unwrap(channel.new(1u64))
    let first = result.unwrap(wire_pack(pool, one_to, one_from, Reset(17u64, list.new())))
    let second = result.unwrap(wire_pack(pool, two_to, two_from, Reset(19u64, list.new())))
    result.unwrap(channel.try_send(write, take first))
    let before_write = match wire_pack(pool, one_to, one_from, Reset(23u64, list.new())) { Error(Protocol(1013u16)) => true, _ => false }
    let writing = result.unwrap(channel.try_receive(pending))
    let during_write = match wire_pack(pool, two_to, two_from, Reset(29u64, list.new())) { Error(Protocol(1013u16)) => true, _ => false }
    let bytes_sent = list.len(writing)
    let _ = take writing
    let third = result.unwrap(wire_pack(pool, one_to, one_from, Reset(31u64, list.new())))
    let other_bytes = list.len(second)
    let _ = take pooled_task
    before_write && during_write && bytes_sent == 18u64 && other_bytes == 18u64 && list.len(third) == 18u64
}

type PoolCallPeer: send {
    net: Net, address: Addr, clock: Clock, random: Random, socket: std.wsock.Config, payload: Bytes,
}

fn pool_call_peer(take peer: PoolCallPeer) -> () waits {
    let PoolCallPeer(net: net, address: address, clock: clock, random: random, socket: config, payload: take payload) = take peer
    let end: Until = At(clock, int.saturating_add(host.mono_ns(clock), 5000000000u64))
    let socket = result.unwrap(host.connect(net, address, end))
    let mut name: Bytes = list.new()
    result.unwrap(list.append(mut name, string.as_bytes("127.0.0.1")))
    let std.wsock.Connected(reader: take reader, writer: take initial, outgoing: take outgoing, timers: _) =
        result.unwrap(std.wsock.client(take socket, take name, config, clock, random))
    let mut writer = take initial
    let mut out = take outgoing
    let frame = result.unwrap(std.wsock.encode(mut out, true, 2u8, payload))
    result.unwrap(std.wsock.stage(mut writer, take frame))
    while !std.wsock.drained(writer) { let _ = result.unwrap(std.wsock.flush(mut writer, mut out, end)) }
    let _ = take reader
}

fn pool_slot_unavailable(pending: std.wsock.PendingPool) -> bool {
    match std.wsock.acquire(pending) { Ok(None) => true, _ => false }
}

type PoolCallOwner: send {
    tasks: Tasks, clock: Clock, config: std.wsock.Config, pool: Sender[WireAllocation[()]],
    upgraded: std.wsock.Upgraded, ready: Sender[bool], proceed: Receiver[()],
}

fn pool_call_owner(take owner: PoolCallOwner) -> () waits {
    let PoolCallOwner(tasks: tasks, clock: clock, config: config, pool: take pool,
        upgraded: take upgraded, ready: take ready, proceed: take proceed) = take owner
    let std.wsock.Upgraded(reader: take input, writer: take writer, source: _, timers: _, pending: take lease) = take upgraded
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let (credit, credits): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    result.unwrap(channel.try_send(credit, ()))
    let reading = WireRead(reader: take input, to: take to, credits: take credits, clock: clock, config: config, pool: take pool)
    let mut reader = result.unwrap(task.spawn(tasks, bytes reader_bytes(), take reading, wire_read))

    // Park the reader's handoff at the head of the owner's deferred queue.
    let WireEvent(e: take event) = result.unwrap(channel.receive(inbox))
    let Input(take f, at) = take event else { fail("expected a decoded Call") }
    let mut deferred: List[(Frame, u64)] = list.new()
    result.unwrap(list.push(mut deferred, (take f, at)))
    result.unwrap(channel.send(ready, true))
    result.unwrap(channel.receive(proceed))

    task.cancel(mut reader)
    let stopped = match task.join(take reader) { Error(Cancelled(_)) => true, _ => false }
    let queued = match deferred[0u64].0 {
        Call(0u32, 0u64, 0u32, 10000u32, arg) => list.len(arg) == 4u64 && arg[0u64] == 7u8,
        _ => false,
    }
    result.unwrap(channel.send(ready, stopped && queued))
    let _ = channel.receive(proceed)
    let _ = take deferred
    let _ = take writer
    let _ = take lease
}

fn pool_call_queued(tasks: Tasks, clock: Clock, random: Random, net: Net, config: WireConfig,
    pool: Sender[WireAllocation[()]], pending: std.wsock.PendingPool, take payload: Bytes,
    probe: scoped fn() -> bool waits) -> bool waits {
    let slot = option.unwrap(result.unwrap(std.wsock.acquire(pending)))
    let (take listening, address) = result.unwrap(host.listen(net, Addr(ip: V4(0x7f000001u32), port: 0u16), 1u16))
    let mut listener = take listening
    let peer = PoolCallPeer(net: net, address: address, clock: clock, random: random, socket: config.socket, payload: take payload)
    let sending = result.unwrap(task.spawn(tasks, bytes 65536u64, take peer, pool_call_peer))
    let deadline: Until = At(clock, int.saturating_add(host.mono_ns(clock), 5000000000u64))
    let (take socket, addr) = result.unwrap(host.accept(mut listener, deadline))
    let upgraded = result.unwrap(std.wsock.server(take socket, take slot, addr.ip, list.new(), config.socket, clock, host.mono_ns(clock)))
    let (ready, heard): (Sender[bool], Receiver[bool]) = result.unwrap(channel.new(1u64))
    let (go, proceed): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let state = PoolCallOwner(tasks: tasks, clock: clock, config: config.socket, pool: channel.sender(pool),
        upgraded: take upgraded, ready: take ready, proceed: take proceed)
    let mut owner = result.unwrap(task.spawn(tasks, bytes 65536u64, take state, pool_call_owner))

    let _ = result.unwrap(channel.receive(heard))
    let before = probe() && pool_slot_unavailable(pending)
    result.unwrap(channel.send(go, ()))
    let reader_stopped = result.unwrap(channel.receive(heard))
    let after = probe() && pool_slot_unavailable(pending)
    task.cancel(mut owner)
    let owner_stopped = match task.join(take owner) { Error(Cancelled(_)) => true, _ => false }
    let _ = result.unwrap(task.join(take sending))
    before && reader_stopped && after && owner_stopped
}

fn pool_durable_add(mut tx: store.Tx, table: store.Table[u64, u32], author: Caller, take value: u32) -> Result[u32, u32] {
    let old = match store.fetch(tx, store.shape(table), 0u64) {
        Ok(Some(count)) => count,
        Ok(None) => 0u32,
        Error(_) => return Error(1u32),
    }
    let total = old + value
    if let Error(_) = store.put(mut tx, table, 0u64, total) { return Error(1u32) }
    Ok(total)
}

fn pool_retry(mut head: Head[(), store.Table[u64, u32]], inbox: Receiver[PubIn],
    take key: Bytes, take arg: Bytes, version: u64) -> bool waits {
    let (to, heard): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let mut stream: Bytes = list.new()
    result.unwrap(std.codec.put_u32(0u32, mut stream))
    let request = head_request(store.Caller(issuer: 1, subject: list.new()), take stream, 0u64, take key, take arg, take to)
    result.unwrap(head_arrival(mut head, take request, false))
    if list.len(head.group) != 0u64 { result.unwrap(gate(mut head)) }
    let PubIn(e: take event) = result.unwrap(channel.receive(inbox))
    let Released(Release(version: _, snapshot: _, answers: take rows)) = take event else { return false }
    if list.len(rows) != 1u64 || rows[0u64].row.p != 0u64 { return false }
    let codec: std.codec.Codec[Result[u32, u32]] = std.codec.of()
    let reply = match rows[0u64].row.outcome {
        Returned(body) => match std.codec.decode(codec, body) { Ok(Ok(Ok(7u32))) => true, _ => false },
        _ => false,
    }
    reply && store.version(store.snapshot(head.db)) == version
}

fn pool_full_frame() -> Frame {
    let mut body: Bytes = list.new()
    for i in 0u8 .. 14u8 { result.unwrap(list.push(mut body, i)) }
    Ended(0u32, Returned(take body))
}

pub fn law_pool_releases_cancelled_reader(tasks: Tasks, clock: Clock, random: Random, net: Net) -> bool waits {
    let mut config = wire_defaults(0u64, 0u64)
    config.socket.pending_max = 2u64
    let pending = result.unwrap(std.wsock.pending(config.socket))
    // A second live lease leaves room for a duplicate refund to add a token.
    let other_slot = option.unwrap(result.unwrap(std.wsock.acquire(pending)))
    let allocated: Result[(Sender[WireAllocation[()]], Task[()]), Capacity] = start_wire_pool(tasks, config, clock, 80u64, 2u64)
    let (pool, take pooled_task) = result.unwrap(take allocated)
    let (reply, result_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) =
        result.unwrap(channel.new(1u64))
    let writing = result.unwrap(wire_pack(pool, reply, result_from, Reset(41u64, list.new())))
    let mut arg: Bytes = list.new()
    result.unwrap(std.codec.put_u32(7u32, mut arg))
    let call_frame = Call(0u32, 0u64, 0u32, 10000u32, take arg)
    let frames: std.codec.Codec[Frame] = std.codec.of()
    let mut payload: Bytes = result.unwrap(list.with_capacity(wire_output_size(call_frame)))
    result.unwrap(std.codec.encode(frames, call_frame, mut payload))

    let mut db = store.memory(clock, random, store.defaults())
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), std.codec.of_u32())))
    let table = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), std.codec.of_u32()))
    let mut entries: Registry[(), store.Table[u64, u32]] = registry()
    let add = code.describe(pool_durable_add)
    result.unwrap(transact(mut entries, add, 65536u64, DEFAULT_STEPS))
    let (release_to, releases): (Sender[PubIn], Receiver[PubIn]) = result.unwrap(channel.new(1u64))
    let mut head = Head(db: take db, r: take entries, replay_identity: list.new(),
        h: table, out: take release_to, busy: map.new(), waiting: list.new(),
        group: list.new(), last: None, minted: 0u64, cut: false, trigger_drive: None)

    // The retained writer block costs 32 bytes. An Ended frame with a 30-byte
    // payload encodes in place in capacity 44, charged 48: the remaining 48,
    // so even one retained decoder charge refuses it until the refund.
    let held = pool_call_queued(tasks, clock, random, net, config, pool, pending, result.unwrap(clone(payload)),
        scoped fn() -> bool waits {
            match wire_pack(pool, reply, result_from, pool_full_frame()) { Error(Protocol(1013u16)) => true, _ => false }
        })
    let bytes_refunded = match wire_pack(pool, reply, result_from, pool_full_frame()) {
        Ok(body) => list.len(body) == 32u64,
        _ => false,
    }
    let slot_returned_once = match std.wsock.acquire(pending) {
        Ok(Some(take returned)) => {
            let unavailable = pool_slot_unavailable(pending)
            let _ = take returned
            unavailable
        },
        _ => false,
    }
    let _ = take other_slot
    let _ = take writing
    let _ = take pooled_task

    let before = store.snapshot(head.db)
    let untouched = store.version(before) == 1u64 && result.unwrap(store.get(before, store.shape(head.h), 0u64)) == None
    let _ = take before
    let reply_codec: std.codec.Codec[Result[u32, u32]] = std.codec.of()
    let (take key, _) = result.unwrap(described(code.identity(add), code.revision(add), Transact, std.codec.of_u32(), reply_codec))
    let Call(_, _, _, _, take retry_arg) = result.unwrap(wire_decode(payload)) else { return false }
    let committed = pool_retry(mut head, releases, result.unwrap(clone(key)), result.unwrap(clone(retry_arg)), 3u64)
    let replayed = pool_retry(mut head, releases, take key, take retry_arg, 3u64)
    let one_effect = result.unwrap(store.get(store.snapshot(head.db), store.shape(head.h), 0u64)) == Some(7u32)
    held && bytes_refunded && slot_returned_once && untouched && committed && replayed && one_effect
}

@test
fn test_pool_releases_cancelled_reader(tasks: Tasks, clock: Clock, random: Random, net: Net) -> Result[(), ()] waits {
    if law_pool_releases_cancelled_reader(tasks, clock, random, net) { Ok(()) } else { Error(()) }
}

pub fn law_serving_budget() -> bool {
    let config = wire_defaults(65536u64, 1048576u64)
    let total = match serving_bytes(config, 10000u64) { Ok(n) => n, Error(_) => return false }
    if total != 1125122048u64 { return false }
    if let Ok(_) = serving_bytes(config, 10001u64) { return false }
    let mut excessive = config
    excessive.n_pool = 0xffffffffffffffffu64
    if let Error(_) = serving_bytes(excessive, 10000u64) { true } else { false }
}

pub fn law_subscription_room_refunded() -> bool {
    let mut quota = result.unwrap(subscription_room(400u64, 2u64))
    let (to, from): (Sender[SubscriptionInput], Receiver[SubscriptionInput]) = result.unwrap(channel.new(1u64))
    let arg: Bytes = result.unwrap(list.with_capacity(128u64))
    let first = result.unwrap(subscription_hold(mut quota, list.new(), take arg))
    result.unwrap(channel.try_send(to, take first))
    let same_size: Bytes = result.unwrap(list.with_capacity(128u64))
    let refused = match subscription_hold(mut quota, list.new(), take same_size) {
        Error(Capacity(requested: 192u64, available: 120u64)) => true,
        _ => false,
    }
    let _ = result.unwrap(channel.try_receive(from))
    let after_drop: Bytes = result.unwrap(list.with_capacity(128u64))
    let readmitted = match subscription_hold(mut quota, list.new(), take after_drop) { Ok(_) => true, _ => false }
    refused && readmitted
}

@test
fn test_wire_session(tasks: Tasks, clock: Clock) -> Result[(), ()] waits {
    if law_serving_budget() && law_subscription_room_refunded() && law_session_records(tasks) && law_pool_holds_writer_bytes(tasks, clock) && law_writer_one_frame() && law_children_joined_on_close(tasks) { Ok(()) } else { Error(()) }
}

pub fn law_writer_one_frame() -> bool {
    // Two caller-owned candidate frames and one WireUnit handoff record (Bytes 24, an
    // Option of a u64 and two Latest handles 32, plus 64). A third charged byte cannot
    // fit; the writer cannot reserve or retain another frame.
    let checked = bound bytes (2u64 * 262160u64 + 120u64) {
        let (tx, rx): (Sender[WireUnit], Receiver[WireUnit]) = result.unwrap(channel.new(1u64))
        let first: Bytes = result.unwrap(list.with_capacity(262158u64))
        let second: Bytes = result.unwrap(list.with_capacity(262158u64))
        let mut busy = false
        let handed = if wire_ready(busy) {
            match wire_offer(tx, mut busy, WireUnit(frame: take first, check: None, write_ack: false)) { Ok(()) => true, _ => false }
        } else { false }
        let pending = result.unwrap(channel.try_receive(rx))
        let rejected = if wire_ready(busy) {
            let _ = wire_offer(tx, mut busy, WireUnit(frame: take second, check: None, write_ack: false))
            false
        } else {
            let extra: Result[Bytes, Capacity] = list.with_capacity(1u64)
            let charged = match extra { Error(_) => true, _ => false }
            charged && list.capacity(second) == 262158u64
        }
        let empty = match channel.try_receive(rx) { Error(Empty) => true, _ => false }
        handed && busy && rejected && empty && list.capacity(pending.frame) == 262158u64
    }
    match checked { Ok(ok) => ok, Error(_) => false }
}

fn wire_park(take rx: Receiver[()]) -> () waits { let _ = channel.receive(rx) }

pub fn law_children_joined_on_close(tasks: Tasks) -> bool waits {
    let (a, ar): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let (b, br): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let reader = result.unwrap(task.spawn(tasks, bytes 4096u64, take ar, wire_park))
    let writer = result.unwrap(task.spawn(tasks, bytes 4096u64, take br, wire_park))
    wire_join(take reader, take writer)
    let read_closed = match channel.try_send(a, ()) { Error(Closed(_)) => true, _ => false }
    let write_closed = match channel.try_send(b, ()) { Error(Closed(_)) => true, _ => false }
    read_closed && write_closed
}

fn wire_owner_park(take rx: Receiver[()]) -> Result[(), std.wsock.Error] waits {
    let _ = channel.receive(rx)
    Ok(())
}

pub fn law_session_records(tasks: Tasks) -> bool waits {
    // charge-v1: five WireEvents of 450 plus 64, one WireUnit of 56 plus 64,
    // a credit channel of zero-sized units plus 64; three test gates of 64;
    // two unit-returning task records of 288 and the owner record of 328 (it holds a
    // Result[(), std.wsock.Error], widened by NetError's Tls(TlsFailure) arm).
    let checked = bound bytes 3594u64 {
        let (events, hear): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(5u64))
        let (writes, read_writes): (Sender[WireUnit], Receiver[WireUnit]) = result.unwrap(channel.new(1u64))
        let (credit, read_credit): (Sender[()], Receiver[()]) = result.unwrap(channel.new(5u64))
        let (a, ar): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let (b, br): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let (end, er): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
        let mut owner = result.unwrap(task.spawn(tasks, bytes 0u64, take er, wire_owner_park))
        let reader = result.unwrap(task.spawn(tasks, bytes 0u64, take ar, wire_park))
        let writer = result.unwrap(task.spawn(tasks, bytes 0u64, take br, wire_park))
        let extra: Result[Bytes, Capacity] = list.with_capacity(1u64)
        let exact = match extra { Error(_) => true, _ => false }
        task.cancel(mut owner)
        wire_join(take reader, take writer)
        let _ = task.join(take owner)
        let owner_closed = match channel.try_send(end, ()) { Error(Closed(_)) => true, _ => false }
        let _ = channel.try_send(events, wire_event(Sent))
        let _ = channel.try_send(writes, WireUnit(frame: list.new(), check: None, write_ack: false))
        let _ = channel.try_send(credit, ())
        let live = match (channel.try_receive(hear), channel.try_receive(read_writes), channel.try_receive(read_credit)) {
            (Ok(WireEvent(e: Sent)), Ok(_), Ok(())) => true,
            _ => false,
        }
        let closed = match (channel.try_send(a, ()), channel.try_send(b, ())) {
            (Error(Closed(_)), Error(Closed(_))) => true,
            _ => false,
        }
        exact && live && closed && owner_closed
    }
    match checked { Ok(ok) => ok, Error(_) => false }
}

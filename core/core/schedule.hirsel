pub type Suite13 = Aes128GcmSha256 | Aes256GcmSha384 | ChaCha20Poly1305Sha256

pub type Suite12 = Aes128GcmSha256 | Aes256GcmSha384 | ChaCha20Poly1305Sha256

pub type SrtpProfile = Aes128CmHmacSha1_80 | AeadAes128Gcm | AeadAes256Gcm

pub type SframeSuite = Aes128GcmSha256_128()

pub type Profile13 = Quic(Suite13) | Dtls13(Suite13) | Tls13(Suite13) | QuicMultipath(Suite13)

pub opaque resource type Schedule

pub type Side = Client | Server

pub type ScheduleError = Denied | Invalid | Issued | Spent | Capacity(Capacity)

pub type PacketCipher: key = Aes128CmHmacSha1_80 | Aes128Gcm | Aes256Gcm | ChaCha20Poly1305

pub type SpaceInfo {
    cipher: PacketCipher,
    send: bool,
    receive: bool
}

pub fn inspect(s: Schedule, space: packet.Space) -> Result[SpaceInfo, ScheduleError] {
    let (algorithm, directions) = space_info_raw(s, space)?
    let cipher: PacketCipher = match algorithm {
        0 => Aes128CmHmacSha1_80,
        1 => Aes128Gcm,
        2 => Aes256Gcm,
        _ => ChaCha20Poly1305,
    }
    Ok(SpaceInfo(cipher, send: directions & 1 != 0, receive: directions & 2 != 0))
}

fn space_info_raw(s: Schedule, space: packet.Space) -> Result[(u64, u64), ScheduleError]

pub fn quic_initial(side: Side, dcid: Bytes) -> Result[Schedule, ScheduleError]

pub fn tls13(p: Profile13, side: Side, take k: secret.KeyShare, peer: Bytes, hello_hash: Bytes) -> Result[Schedule, (ScheduleError, Option[secret.KeyShare])]

pub fn dtls12(suite: Suite12, side: Side, epoch: u16, take k: secret.KeyShare, peer: Bytes, client_random: Bytes, server_random: Bytes, session_hash: Option[Bytes]) -> Result[Schedule, (ScheduleError, Option[secret.KeyShare])]

pub fn import_traffic(p: Profile13, take s: Secret) -> Result[Schedule, (ScheduleError, Option[Secret])]

pub fn import_srtp(p: SrtpProfile, take s: Secret) -> Result[Schedule, (ScheduleError, Option[Secret])]

pub fn import_sframe(suite: SframeSuite, take s: Secret) -> Result[Schedule, (ScheduleError, Option[Secret])]

pub fn srtp(mut s: Schedule, p: SrtpProfile) -> Result[Schedule, ScheduleError]

pub fn application(mut s: Schedule, finished_hash: Bytes) -> Result[(), ScheduleError]

pub fn key_update(mut s: Schedule, local: bool) -> Result[(), ScheduleError]

pub fn retire(mut s: Schedule, space: packet.Space) -> Result[(), ScheduleError]

pub fn finished(s: Schedule, of: Side, transcript_hash: Bytes, mut out: Bytes) -> Result[u64, ScheduleError]

pub fn verify_finished(s: Schedule, of: Side, transcript_hash: Bytes, received: Bytes) -> Result[bool, ScheduleError]

pub fn sealer(mut s: Schedule, space: packet.Space, domain: u64, floor: u64) -> Result[packet.Sealer, ScheduleError]

pub fn sealer_pair(mut s: Schedule, first: packet.Space, second: packet.Space, domain: u64, first_floor: u64, second_floor: u64) -> Result[(packet.Sealer, packet.Sealer), ScheduleError]

pub fn opener(s: Schedule, space: packet.Space) -> Result[packet.Opener, ScheduleError]

pub fn header_mask(s: Schedule, space: packet.Space, local: bool) -> Result[packet.HeaderMask, ScheduleError]

pub fn sframe_sealer(mut s: Schedule, steps: u64, kid: u64, floor: u64) -> Result[packet.Sealer, ScheduleError]

pub fn sframe_opener(s: Schedule, ahead: u64, kid: u64) -> Result[packet.Opener, ScheduleError]

pub fn sframe_ratchet(mut s: Schedule, steps: u64) -> Result[(), ScheduleError]

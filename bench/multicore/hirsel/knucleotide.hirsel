type Sequence: shareable + send { bases: Bytes }
type Job: send { sequence: Arc[Sequence], k: u64 }
type Counts = Map[u64, u64]
type Frequency { key: u64, count: u64 }

fn base(c: u8) -> Option[u8] {
    match c | 32u8 {
        b'a' => Some(0),
        b'c' => Some(1),
        b'g' => Some(2),
        b't' => Some(3),
        _ => None,
    }
}

fn extract(file: Bytes) -> Bytes {
    let mut dna: Bytes = list.new()
    let mut start: u64 = 0
    let mut three = false
    while start < list.len(file) {
        let mut end = start
        while end < list.len(file) && file[end] != b'\n' { end += 1 }
        if start < end && file[start] == b'>' {
            if three { break }
            three = end - start >= 6 && file[start + 1] == b'T' && file[start + 2] == b'H'
                && file[start + 3] == b'R' && file[start + 4] == b'E' && file[start + 5] == b'E'
        } else if three {
            for i in start .. end {
                if let Some(code) = base(file[i]) { result.unwrap(list.push(mut dna, code)) }
            }
        }
        start = end + 1
    }
    take dna
}

fn tally(take job: Job) -> Counts {
    let n = list.len(job.sequence.bases)
    let mut table: Counts = map.new()
    for frame in 0 .. job.k {
        let mut at = frame
        while at + job.k <= n {
            let mut key: u64 = 0
            for i in at .. at + job.k {
                key = (key << 2) | int.widen(job.sequence.bases[i])
            }
            if map.update(mut table, key, fn(mut count: u64) { count += 1 }) == None {
                result.unwrap(map.insert(mut table, key, 1u64))
            }
            at += job.k
        }
    }
    take table
}

fn push_name(mut line: String, key: u64, k: u64) {
    let letters: Inline[char, 4] = ['A', 'C', 'G', 'T']
    for i in 0 .. k {
        let digit = (key >> (2 * (k - i - 1))) & 3
        result.unwrap(string.push_char(mut line, letters[digit]))
    }
}

fn frequencies(mut line: String, table: Counts, k: u64) {
    let mut sorted: List[Frequency] = result.unwrap(list.with_capacity(map.len(table)))
    let mut total: u64 = 0
    for (key, count) in table {
        total += count
        result.unwrap(list.push(mut sorted, Frequency(key: key, count: count)))
    }
    std.list.sort(mut sorted, fn(a: Frequency, b: Frequency) -> Order {
        if a.count != b.count {
            if a.count > b.count { Less } else { Greater }
        } else if a.key < b.key { Less } else if a.key == b.key { Equal } else { Greater }
    })
    for row in sorted {
        push_name(mut line, row.key, k)
        result.unwrap(string.push(mut line, " "))
        let part: f64 = float.from_int(row.count)
        let whole: f64 = float.from_int(total)
        result.unwrap(std.float.push_fixed64(mut line, part * 100.0 / whole, 3))
        result.unwrap(string.push(mut line, "\n"))
    }
    result.unwrap(string.push(mut line, "\n"))
}

pub fn main(tasks: Tasks, out: Stdout, d: Dir, argv: Args) -> Result[(), Exit] waits {
    let Some(path) = args.get(argv, 0) else { return Error(Exit(status: 2)) }
    let input = result.unwrap(std.file.read(d, path))
    let sequence = result.unwrap(arc.new(Sequence(bases: extract(input))))
    let lengths: Inline[u64, 7] = [1u64, 2, 3, 4, 6, 12, 18]
    let queries: Inline[String, 5] = ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"]
    let mut jobs: List[Task[Counts]] = result.unwrap(list.with_capacity(7))
    for i in 0u64 .. 7 {
        let k = lengths[6 - i]
        let bases = list.len(sequence.bases)
        let keys = 1u64 << (2 * k)
        let upper_bound = if keys < bases { keys } else { bases }
        let allowance = 65536 + upper_bound * 128
        let job = Job(sequence: arc.share(sequence), k: k)
        let h = result.unwrap(task.spawn(tasks, bytes allowance, take job, tally))
        result.unwrap(list.push(mut jobs, take h))
    }
    let mut line = string.new()
    for i in 0u64 .. 7 {
        let k = lengths[i]
        let h = option.unwrap(list.pop(mut jobs))
        let table = result.unwrap(task.join(take h))
        if i < 2 {
            frequencies(mut line, table, k)
        } else {
            let word = queries[i - 2]
            let mut key: u64 = 0
            let chars = string.as_bytes(word)
            for j in 0 .. k { key = (key << 2) | int.widen(option.unwrap(base(chars[j]))) }
            let count: u64 = if let Some(value) = map.get(table, key) { value } else { 0u64 }
            result.unwrap(string.push_u64(mut line, count))
            result.unwrap(string.push(mut line, "\t"))
            result.unwrap(string.push(mut line, word))
            result.unwrap(string.push(mut line, "\n"))
        }
    }
    result.unwrap(stdout.write(out, line))
    Ok(())
}

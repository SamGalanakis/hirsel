type ManagedRun[G: send, S: send]: send {
    settings: runner.PlaceConfig[G, Hd, S],
    stop: Receiver[()],
    status: Latest[runner.Status],
    watch: Sender[Receiver[runner.Phase]],
}

fn run_managed[G: send, S: send](take job: ManagedRun[G, S]) -> Result[runner.Ended, runner.StartError] waits {
    let ManagedRun(settings: take settings, stop: take stop, status: take status, watch: take watch) = take job
    runner.operate(take settings, take stop, status, Some(take watch))
}

fn managed_address(status: runner.Status) -> Addr {
    option.unwrap(status.addr)
}

fn managed_settings(dir: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, listen: Addr, stop: runner.Stop) -> runner.PlaceConfig[(), Hd, ()] {
    let mut wire = runner.wire_defaults(65536u64)
    wire.n_pool = 4194304u64
    runner.PlaceConfig(backing: Disk(dir), sizes: store.Overrides(resident_limit: Some(1048576u64), journal_limit: None, checkpoint_bytes: Some(4194304u64), pack_bytes: Some(512u64), group_bytes: Some(1048576u64), group_commits: Some(2u32), lock_wait_ms: None, cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: Current(0u64), place: code.describe(place), n_place: N_PLACE, on_migrate: None, schema: code.describe(schema), session: wire, max_sessions: 1u64, proxies: list.new(), n_publisher: 1048576u64, listen: Tcp(listen), net: net, tasks: tasks, clock: clock, random: random, stop: stop, wire: Some(ingress.binding()), grants: Some(ingress.bind_grants()), triggers: None, idle: None)
}

fn try_start_managed[G: send, S: send](tasks: Tasks, take settings: runner.PlaceConfig[G, Hd, S], stop_pending: bool, allowance: u64) -> Result[(Task[Result[runner.Ended, runner.StartError]], Sender[()], Receiver[runner.Phase], Latest[runner.Status]), runner.StartError] waits {
    let (stop_to, stop_from): (Sender[()], Receiver[()]) = channel.new(1u64)
    if stop_pending {
        result.unwrap(channel.send(stop_to, ()))
    }
    let (handoff, phase_rx): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = channel.new(1u64)
    let status = result.unwrap(runner.status_root())
    let request = ManagedRun(settings: take settings, stop: take stop_from, status: latest.handle(status), watch: take handoff)
    let run: fn(take ManagedRun[G, S]) -> Result[runner.Ended, runner.StartError] waits = run_managed
    let running = task.try_spawn(tasks, bytes allowance, take request, run) ?=> |(cap, _)| Full(cap)
    match channel.receive(phase_rx) {
        Ok(take phases) => Ok((take running, take stop_to, take phases, take status)),
        Error(_) => match task.join(take running) {
            Ok(Error(take why)) => Error(take why),
            _ => fail("managed fixture exited before handing off its phases"),
        },
    }
}

fn managed_budget[G: send, S: send](settings: runner.PlaceConfig[G, Hd, S]) -> (u64, u64) {
    let plan = result.unwrap(store.planned(Directory, 18446744073709551615u64, settings.sizes))
    // Operate includes the head, serving and supervisor. Its keep is 1 MiB.
    let share = store.planned_bytes(plan)
    (result.unwrap(runner.operate_bytes(settings)) + 1048576u64 + share, share)
}

fn start_managed[G: send, S: send](tasks: Tasks, take settings: runner.PlaceConfig[G, Hd, S], stop_pending: bool) -> (Task[Result[runner.Ended, runner.StartError]], Sender[()], Receiver[runner.Phase], Latest[runner.Status]) waits {
    let (allowance, _) = managed_budget(settings)
    match try_start_managed(tasks, take settings, stop_pending, allowance) {
        Ok(take started) => take started,
        Error(take why) => fail(runner.start_text(why)),
    }
}

@test
fn test_stop_unstarted(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), ()] waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let listen = Addr(ip: V4(0x7f000001u32), port: 0u16)
    let stop = runner.Stop(lag_ms: 0u64, grace_ms: 1000u64)
    let small = managed_settings(dir, clock, random, tasks, net, listen, stop)
    let (allowance, need) = managed_budget(small)
    match try_start_managed(tasks, take small, true, allowance - 1) {
        Error(Full(cap)) if cap.requested == need && cap.available == need - 1 => (),
        _ => fail("stop: sizing refusal lost before the phase handoff"),
    }
    let config = managed_settings(dir, clock, random, tasks, net, listen, stop)
    let (running, stop_to, phases, _) = start_managed(tasks, take config, true)
    if let Ok(Ok(Unstarted)) = task.join(take running) {} else {
        fail("stop: expected Unstarted")
    }
    if let Ok(Starting(Recovering)) = channel.try_receive(phases) {} else {
        fail("stop: expected Recovering")
    }
    if let Ok(Draining) = channel.try_receive(phases) {} else {
        fail("stop: expected Draining")
    }
    if let Error(Closed) = channel.try_receive(phases) {} else {
        fail("stop: place continued after Draining")
    }
    let _ = take stop_to
    result.unwrap(std.dir.remove_all(parent, name))
    Ok(())
}

// The head's refusal, named for stderr.
fn opened_text(e: runner.OpenError) -> String {
    string.from(match e {
        Store(_) => "calls: place_head: store error",
        StoreMismatch(_, _) => "calls: place_head: store mismatch",
        Place(_) => "calls: place_head: place registration failed",
        Migrate(_) => "calls: place_head: migration failed",
        NotCurrent(_) => "calls: place_head: activation is not current",
        IdentityUnknown => "calls: place_head: image identity is unavailable",
        Unsettled(_) => "calls: place_head: a held run has no fate",
        PublisherStopped => "calls: place_head: publisher stopped",
        InstallVersion(_) => "calls: place_head: wrong install activation",
        PredecessorChanged(_) => "calls: place_head: install predecessor changed",
        InstallUncertain(_) => "calls: place_head: install outcome unknown",
        KeyedOpDropped(_) => "calls: place_head: live keyed operation was dropped",
        KeyedOpQuotaChanged(..) => "calls: place_head: keyed quota changed",
        KeyedOpChanged(..) => "calls: place_head: keyed operation changed",
        KeyedNoGrant(_) => "calls: place_head: keyed operation needs a claim mint",
        BindNoGrant => "calls: place_head: a wire needs a bind mint",
        TriggerNoGrant(_) => "calls: place_head: granted trigger entry needs an attempt mint",
        CallNotGranted(_) => "calls: place_head: call mint entry is not granted",
        Operator(_) => "calls: place_head: a store operator refused",
    })
}

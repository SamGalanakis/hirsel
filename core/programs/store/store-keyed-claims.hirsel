const KEYED_OPS: u8 = 0
const CLAIMS: u8 = 1
const CLAIM_EXP: u8 = 2
const CLAIM_PEXP: u8 = 3
const CLAIM_COUNT: u8 = 4
const CLAIM_PCOUNT: u8 = 5
const CLAIM_OPEN: u8 = 6

const CLAIM_NEVER: u64 = 18446744073709551615
pub const CLAIM_DONE_MAX: u64 = 8192
pub const KEYED_OP_RECORD_MAX: u64 = 16384

pub type ClaimKey: shareable + send {
    op: Bytes,
    caller: Caller,
    key: Bytes
}

pub type KeyedPolicy: codec + shareable + send {
    retention_ms: u64,
    keys_max: u64,
    principal_keys_max: u64,
    arg_max: u64,
    call_record_max: u64,
    record: Bytes
}

type ClaimAddress {
    op: Bytes,
    principal: Bytes,
    full: Bytes
}

type ClaimRow {
    digest: RequestDigest,
    expiry: u64,
    replied: bool
}

pub type ClaimAdmission = Accepted(ClaimCompletion) | Ownerless(ClaimCompletion) | Duplicate(Bytes) | Mismatch | MissingClaim

pub opaque type ClaimCompletion {
    ticket: Ticket,
    key: Bytes,
    request: RequestDigest,
    policy: KeyedPolicy,
    admitted_width: u64
}

pub fn claim_ticket(completion: ClaimCompletion) -> Ticket { completion.ticket }

pub fn claim_key_bytes(key: ClaimKey) -> Result[Bytes, Error] {
    let address = claim_address(key)?
    let ClaimAddress(full: take full, ..) = take address
    Ok(take full)
}

fn op_claim_key(op: Bytes) -> Result[Bytes, Error] {
    let len = list.len(op)
    if len == 0 || len > 64 { return Error(Limit(Key)) }
    let mut raw: Bytes = list.with_capacity(1 + len)
    list.push(mut raw, int.narrow(len))
    list.append(mut raw, op)
    Ok(take raw)
}

fn claim_address(key: ClaimKey) -> Result[ClaimAddress, Error] {
    let len = list.len(key.key)
    if len == 0 || len > 255 { return Error(Limit(Key)) }
    for byte in key.key {
        if byte < 0x21 || byte > 0x7e { return Error(Limit(Key)) }
    }
    let op = op_claim_key(key.op)?
    let mut principal = copied(op)?
    capacity(caller_key(key.caller, mut principal))?
    let mut full = copied(principal)?
    list.push(mut full, int.narrow(len))
    list.append(mut full, key.key)
    Ok(ClaimAddress(op: take op, principal: take principal, full: take full))
}

fn claim_op_end(raw: Bytes) -> Result[u64, Error] {
    if list.len(raw) == 0 || raw[0u64] == 0 || raw[0u64] > 64 { return Error(malformed(0)) }
    let op: u64 = int.widen(raw[0u64])
    if op >= list.len(raw) { return Error(malformed(0)) }
    Ok(op + 1)
}

fn claim_principal_end(raw: Bytes, op_end: u64) -> Result[u64, Error] {
    if list.len(raw) < op_end + 2 { return Error(malformed(0)) }
    let subject: u64 = int.widen(raw[op_end + 1])
    if subject > SUBJECT_MAX || list.len(raw) <= op_end + 2 + subject { return Error(malformed(0)) }
    let principal_end = op_end + 2 + subject
    let width: u64 = int.widen(raw[principal_end])
    if width == 0 || list.len(raw) != principal_end + 1 + width { return Error(malformed(0)) }
    Ok(principal_end)
}

fn claim_expired(expires: u64, at: u64) -> bool {
    expires != CLAIM_NEVER && expires <= at
}

fn claim_expiry(at: u64, retention_ms: u64) -> u64 {
    int.saturating_add(at, retention_ms)
}

fn claim_parse(raw: Bytes) -> Result[ClaimRow, Error] {
    let width = list.len(raw)
    if width < 41 { return Error(malformed(0)) }
    let expiry: u64 = list.word_le(raw, 33)
    if (raw[0u64] == 1 && expiry != 0) || (raw[0u64] == 2 && expiry == 0) || (raw[0u64] != 1 && raw[0u64] != 2) {
        return Error(malformed(0))
    }
    let mut digest_bytes: Inline[u8, 32] = [0u8; 32]
    for i in 0u64 .. 32u64 { digest_bytes[i] = raw[1 + i] }
    Ok(ClaimRow(digest: RequestDigest(b: take digest_bytes), expiry: expiry, replied: raw[0u64] == 2))
}

fn claim_value(digest: RequestDigest, expiry: u64, payload: Bytes) -> Bytes {
    let replied = expiry != 0
    let header = 41u64
    let mut raw: Bytes = list.with_capacity(header + list.len(payload))
    list.push(mut raw, if replied { 2u8 } else { 1u8 })
    for byte in digest.b { list.push(mut raw, byte) }
    list.put_word_le(mut raw, expiry)
    list.append(mut raw, payload)
    take raw
}

fn keyed_policy_bytes(policy: KeyedPolicy) -> Result[Bytes, Error] {
    let codec: std.codec.Codec[KeyedPolicy] = std.codec.of()
    let mut raw: Bytes = list.new()
    std.codec.encode(codec, policy, mut raw) ?=> |_| Limit(Value)
    if list.len(raw) > KEYED_OP_RECORD_MAX { return Error(Limit(Value)) }
    Ok(take raw)
}

fn read_keyed_policy(raw: Bytes) -> Result[KeyedPolicy, Error] {
    let codec: std.codec.Codec[KeyedPolicy] = std.codec.of()
    decoded(std.codec.decode(codec, raw))
}

pub fn keyed_policy(db: Db, op: Bytes) -> Result[Option[KeyedPolicy], Error] {
    let name = op_claim_key(op)?
    match keyed_lookup(db.heads[0u64].roots.keyed, KEYED_OPS, name) {
        Some(raw) => Ok(Some(read_keyed_policy(raw)?)),
        None => Ok(None),
    }
}

fn terminal_frame_credit(policy: KeyedPolicy) -> u64 {
    // Frame and commit headers, keyed-section header, four edits, and call.
    37 + 5 + (10 + 387 + 41 + CLAIM_DONE_MAX) + (10 + 460) + (10 + 526) + (6 + 387) + policy.call_record_max
}

fn keyed_page_height(ceiling: u64) -> u64 {
    let mut rows = int.saturating_add(ceiling / 70, 1)
    let mut height = 1u64
    while rows > 1 {
        rows = (rows >> 1) + (rows & 1)
        height += 1
    }
    height
}

fn claim_terminal_credit(ceiling: u64, policy: KeyedPolicy, admitted_width: u64) -> KeyedCredit {
    let frame = terminal_frame_credit(policy)
    let maximum_row = order.max(41 + policy.arg_max, 41 + CLAIM_DONE_MAX)
    let padding = round8(maximum_row) - round8(admitted_width)
    let retained = 4 * (6 * keyed_page_height(ceiling) + 2) * 32768
    KeyedCredit(resident: 526 + 590 + frame + retained, padding: padding, journal: frame)
}

fn add_keyed_credit(total: KeyedCredit, own_credit: KeyedCredit) -> KeyedCredit {
    KeyedCredit(resident: int.saturating_add(total.resident, own_credit.resident),
        padding: int.saturating_add(total.padding, own_credit.padding),
        journal: int.saturating_add(total.journal, own_credit.journal))
}

fn remove_keyed_credit(total: KeyedCredit, own_credit: KeyedCredit) -> KeyedCredit {
    KeyedCredit(resident: total.resident - own_credit.resident,
        padding: total.padding - own_credit.padding,
        journal: total.journal - own_credit.journal)
}

fn append_claim_edit(mut edits: List[KeyedEdit], tree: u8, key: Bytes, take value: Option[Bytes]) -> Result[(), Error] {
    list.push(mut edits, KeyedEdit(tree: tree, key: copied(key)?, value: take value))
    Ok(())
}

fn claim_index_key(prefix_bytes: Bytes, expiry: u64, key: Bytes) -> Result[Bytes, Error] {
    let mut raw = copied(prefix_bytes)?
    list.put_word_be(mut raw, expiry)
    list.append(mut raw, key)
    Ok(take raw)
}

fn claim_count_after(roots: Roots, edits: List[KeyedEdit], tree: u8, key: Bytes) -> u64 {
    let mut edit_index = list.len(edits)
    while edit_index != 0 {
        edit_index -= 1
        let edit = view edits[edit_index]
        if edit.tree == tree && edit.key == key {
            return match edit.value { Some(raw) => list.word_le(raw, 0), None => 0u64 }
        }
    }
    match keyed_lookup(roots.keyed, tree, key) { Some(raw) => list.word_le(raw, 0), None => 0u64 }
}

fn set_claim_count(mut edits: List[KeyedEdit], tree: u8, key: Bytes, cardinality: u64) -> Result[(), Error] {
    let value: Option[Bytes] = if cardinality == 0 {
        None
    } else {
        let mut raw: Bytes = list.with_capacity(8)
        list.put_word_le(mut raw, cardinality)
        Some(take raw)
    }
    append_claim_edit(mut edits, tree, key, take value)
}

fn forget_claim(roots: Roots, mut edits: List[KeyedEdit], key: Bytes, expiry: u64) -> Result[(), Error] {
    let op_end = claim_op_end(key)?
    let principal_end = claim_principal_end(key, op_end)?
    let op = list.slice(key, 0, op_end)
    let principal = list.slice(key, 0, principal_end)
    append_claim_edit(mut edits, CLAIMS, key, None)?
    append_claim_edit(mut edits, CLAIM_EXP, claim_index_key(op, expiry, key)?, None)?
    append_claim_edit(mut edits, CLAIM_PEXP, claim_index_key(principal, expiry, key)?, None)?
    let cardinality = claim_count_after(roots, edits, CLAIM_COUNT, op)
    let pcount = claim_count_after(roots, edits, CLAIM_PCOUNT, principal)
    set_claim_count(mut edits, CLAIM_COUNT, op, cardinality - 1)?
    set_claim_count(mut edits, CLAIM_PCOUNT, principal, pcount - 1)
}

fn claim_deletion_planned(edits: List[KeyedEdit], key: Bytes) -> bool {
    for edit in edits {
        if edit.tree == CLAIMS && edit.key == key { return true }
    }
    false
}

fn reclaim_claim_scope(roots: Roots, mut edits: List[KeyedEdit], tree: u8, prefix_bytes: Bytes, at: u64) -> Result[(), Error] {
    if list.len(roots.keyed) == 0 { return Ok(()) }
    let slot: u64 = int.widen(tree)
    let mut cursor = std.page.cursor_open(roots.keyed[slot].root, Some(copied(prefix_bytes)?), true, false)
    let mut reclaimed = 0u64
    let width = list.len(prefix_bytes)
    let leading: Bytes = list.new()
    while reclaimed < 2 {
        let Some((take indexed, _)) = std.page.cursor_next_key(mut cursor, leading) else { break }
        if !list.starts_with_at(indexed, 0, prefix_bytes) { break }
        if list.len(indexed) <= width + 8 { return Error(malformed(0)) }
        let expiry: u64 = list.word_be(indexed, width)
        if !claim_expired(expiry, at) { break }
        let key = list.slice(indexed, width + 8, list.len(indexed))
        if claim_deletion_planned(edits, key) { continue }
        forget_claim(roots, mut edits, key, expiry)?
        reclaimed += 1
    }
    Ok(())
}

fn stage_claim_admit(mut tx: Tx, address: ClaimAddress, d: RequestDigest, args: Bytes, policy: KeyedPolicy, credit: KeyedCredit) -> Result[(), Error] {
    let mut edits: List[KeyedEdit] = list.new()
    if let Some(raw) = keyed_lookup(tx.roots.keyed, CLAIMS, address.full) {
        let row = claim_parse(raw)?
        forget_claim(tx.roots, mut edits, address.full, row.expiry)?
    }
    if claim_count_after(tx.roots, edits, CLAIM_PCOUNT, address.principal) >= policy.principal_keys_max {
        reclaim_claim_scope(tx.roots, mut edits, CLAIM_PEXP, address.principal, tx.info.at)?
    }
    if claim_count_after(tx.roots, edits, CLAIM_COUNT, address.op) >= policy.keys_max {
        reclaim_claim_scope(tx.roots, mut edits, CLAIM_EXP, address.op, tx.info.at)?
    }
    let op_count = claim_count_after(tx.roots, edits, CLAIM_COUNT, address.op)
    let principal_count = claim_count_after(tx.roots, edits, CLAIM_PCOUNT, address.principal)
    if principal_count >= policy.principal_keys_max {
        return Error(Full(Resident(Capacity(requested: principal_count + 1, available: policy.principal_keys_max))))
    }
    if op_count >= policy.keys_max {
        return Error(Full(Resident(Capacity(requested: op_count + 1, available: policy.keys_max))))
    }
    if let None = keyed_lookup(tx.roots.keyed, KEYED_OPS, address.op) {
        append_claim_edit(mut edits, KEYED_OPS, address.op, Some(keyed_policy_bytes(policy)?))?
    }
    append_claim_edit(mut edits, CLAIMS, address.full, Some(claim_value(d, 0, args)))?
    append_claim_edit(mut edits, CLAIM_OPEN, address.full, Some(list.new()))?
    set_claim_count(mut edits, CLAIM_COUNT, address.op, op_count + 1)?
    set_claim_count(mut edits, CLAIM_PCOUNT, address.principal, principal_count + 1)?
    tx.keyed = Some(KeyedDraft(edits: take edits, after: credit))
    Ok(())
}

pub fn admit_claim(mut db: Db, key: ClaimKey, d: RequestDigest, args: Bytes, take supplied: Option[KeyedPolicy]) -> Result[ClaimAdmission, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let at = match supplied { Some(_) => keyed_time(db), None => db.heads[0u64].at }
    let address = claim_address(key)?
    let stored = keyed_policy(db, key.op)?
    if let Some(raw) = keyed_lookup(db.heads[0u64].roots.keyed, CLAIMS, address.full) {
        let row = claim_parse(raw)?
        if !row.replied || !claim_expired(row.expiry, at) {
            if row.digest != d { return Ok(Mismatch) }
            if row.replied { return Ok(Duplicate(copied(list.slice(raw, 41, list.len(raw)))?)) }
            let committing = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, db.heads[0u64].head))
            let Some(take policy) = take stored else { return Error(malformed(0)) }
            let width = list.len(raw)
            return Ok(Ownerless(ClaimCompletion(ticket: committing, key: copied(address.full)?, request: d, policy: take policy, admitted_width: width)))
        }
    }
    let Some(take offered) = take supplied else { return Ok(MissingClaim) }
    let policy = match take stored { Some(take fixed) => take fixed, None => take offered }
    if policy.retention_ms == 0 || policy.retention_ms > 9007199254740992 || policy.principal_keys_max == 0 ||
        policy.principal_keys_max > policy.keys_max || policy.call_record_max > FRAME_LIMIT ||
        policy.arg_max > FORMAT_VALUE_MAX - 41 || list.len(args) > policy.arg_max {
        return Error(Limit(Value))
    }
    let width = 41 + list.len(args)
    let exclusive_credit = claim_terminal_credit(db.ceiling, policy, width)
    if exclusive_credit.journal > FRAME_LIMIT { return Error(Limit(Transaction)) }
    let after = add_keyed_credit(db.keyed_credit, exclusive_credit)
    let keep: Option[fn(Error) -> bool] = None
    let outcome = store_body_at(mut db, 0, at, None, keep, scoped fn(mut tx: Tx) -> Result[(), Error] {
        stage_claim_admit(mut tx, address, d, args, policy, after)
    })?
    let committed_ticket = match take outcome {
        Committed(done) => done.ticket,
        Refused(problem) => return Error(Full(problem)),
        Aborted(Undone(value: take problem, ..)) => return Error(take problem),
        _ => return Error(Missing("claim admission")),
    }
    durable(mut db, committed_ticket)?
    let ClaimAddress(full: take full, ..) = take address
    Ok(Accepted(ClaimCompletion(ticket: committed_ticket, key: take full, request: d, policy: take policy, admitted_width: width)))
}

fn write_claim_reply(mut tx: Tx, completion: ClaimCompletion, reply_bytes: Bytes, credit: KeyedCredit) -> Result[(), Error] {
    if list.len(reply_bytes) > CLAIM_DONE_MAX { return Error(Limit(Value)) }
    let key = view completion.key
    let op_end = claim_op_end(key)?
    let principal_end = claim_principal_end(key, op_end)?
    let expiry = claim_expiry(tx.info.at, completion.policy.retention_ms)
    let mut edits: List[KeyedEdit] = list.with_capacity(4)
    append_claim_edit(mut edits, CLAIMS, key, Some(claim_value(completion.request, expiry, reply_bytes)))?
    append_claim_edit(mut edits, CLAIM_EXP, claim_index_key(list.slice(key, 0, op_end), expiry, key)?, Some(list.new()))?
    append_claim_edit(mut edits, CLAIM_PEXP, claim_index_key(list.slice(key, 0, principal_end), expiry, key)?, Some(list.new()))?
    append_claim_edit(mut edits, CLAIM_OPEN, key, None)?
    tx.keyed = Some(KeyedDraft(edits: take edits, after: credit))
    Ok(())
}

fn validate_claim_completion(db: Db, completion: ClaimCompletion) -> Result[(), Error] {
    let bound_ticket = completion.ticket
    if !same(db.store, bound_ticket.store) || open_number(db) != bound_ticket.open {
        return Error(Foreign)
    }
    let Some(raw) = keyed_lookup(db.heads[0u64].roots.keyed, CLAIMS, completion.key) else { return Error(Missing("claim")) }
    let row = claim_parse(raw)?
    if row.replied || row.digest != completion.request { return Error(Missing("claim")) }
    Ok(())
}

pub fn conclude_claim(mut db: Db, take completion: ClaimCompletion, reply_bytes: Bytes) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    validate_claim_completion(db, completion)?
    let own_credit = claim_terminal_credit(db.ceiling, completion.policy, completion.admitted_width)
    let after = remove_keyed_credit(db.keyed_credit, own_credit)
    let keep: Option[fn(Error) -> bool] = None
    let outcome = store_body_on(mut db, 0, None, keep, scoped fn(mut tx: Tx) -> Result[(), Error] {
        write_claim_reply(mut tx, completion, reply_bytes, after)
    })?
    match take outcome {
        Committed(done) => {
            durable(mut db, done.ticket)?
            Ok(done.ticket)
        },
        Refused(problem) => Error(Full(problem)),
        Aborted(Undone(value: take problem, ..)) => Error(take problem),
        _ => Error(Missing("claim reply")),
    }
}

fn rebuild_keyed_credit(mut db: Db, uncovered: u64, journal_limit: u64) -> Result[(), Error] {
    let roots = view db.heads[0u64].roots
    if list.len(roots.keyed) == 0 { return Ok(()) }
    let open_slot: u64 = int.widen(CLAIM_OPEN)
    let mut cursor = std.page.cursor_open(roots.keyed[open_slot].root, None, true, false)
    let prefix_bytes: Bytes = list.new()
    let mut credit = no_keyed_credit()
    while let Some((take key, _)) = std.page.cursor_next_key(mut cursor, prefix_bytes) {
        let op_end = claim_op_end(key)?
        let Some(raw_policy) = keyed_lookup(roots.keyed, KEYED_OPS, list.slice(key, 0, op_end)) else { return Error(malformed(0)) }
        let Some(raw_claim) = keyed_lookup(roots.keyed, CLAIMS, key) else { return Error(malformed(0)) }
        let policy = read_keyed_policy(raw_policy)?
        credit = add_keyed_credit(credit, claim_terminal_credit(db.ceiling, policy, list.len(raw_claim)))
    }
    over_ceiling(int.saturating_add(db.resident, int.saturating_add(credit.resident, credit.padding)), db.ceiling)?
    if let Some(room) = journal_refusal(uncovered, credit.journal, journal_limit) { return Error(Full(Journal(room))) }
    db.keyed_credit = credit
    Ok(())
}

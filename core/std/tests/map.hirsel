// Contract tests for `map` (core/std/map.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names.
/// {1: 10}.
fn one_entry() -> Map[u64, u64] {
    let mut m: Map[u64, u64] = map.new()
    result.unwrap(map.insert(mut m, 1, 10))
    m
}

// expect: run contains_present() = true
fn contains_present() -> bool {
    let m = one_entry()
    map.contains(m, 1)
}

// expect: run contains_absent() = false
fn contains_absent() -> bool {
    let m = one_entry()
    map.contains(m, 2)
}

// expect: run get_or_present() = 10
fn get_or_present() -> u64 {
    let m = one_entry()
    map.get_or(m, 1, 7)
}

// expect: run get_or_absent() = 7
fn get_or_absent() -> u64 {
    let m = one_entry()
    map.get_or(m, 2, 7)
}

// Existing entry must stay 10; absent key gets 7, at the end.
// expect: run get_or_insert_cases() = 107
fn get_or_insert_cases() -> u64 {
    let mut m = one_entry()
    let a: u64 = result.unwrap(map.get_or_insert(mut m, 1, 99))
    let b: u64 = result.unwrap(map.get_or_insert(mut m, 2, 7))
    a * 10 + b
}

// expect: run reinsert_order() = 132
fn reinsert_order() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    result.unwrap(map.insert(mut m, 1, 10))
    result.unwrap(map.insert(mut m, 2, 20))
    result.unwrap(map.insert(mut m, 3, 30))
    let _ = map.remove(mut m, 2)
    result.unwrap(map.insert(mut m, 2, 21))
    let mut n: u64 = 0
    for (k, _) in m {
        n = n * 10 + k
    }
    n
}

// Remove a prefix, then iterate exactly the live suffix in original order.
// expect: run remove_churn() = 3
fn remove_churn() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    for i in 0u64 .. 64 {
        result.unwrap(map.insert(mut m, i, i))
    }
    for i in 0u64 .. 61 {
        let _ = map.remove(mut m, i)
    }
    let mut visits: u64 = 0
    let mut expected: u64 = 61
    for (k, v) in m {
        if k != expected || v != expected {
            return 99
        }
        expected += 1
        visits += 1
    }
    visits
}

// expect: run get_or_insert_capacity() = 3
fn get_or_insert_capacity() -> u64 {
    let mut m: Map[String, u64] = map.new()
    let x = result.unwrap(string.from("abc"))
    let r = bound bytes 0 {
        map.get_or_insert(mut m, take x, 7)
    }
    match r {
        Ok(Error((_, (take original, v)))) => if v == 7 && original == "abc" {
            list.len(string.as_bytes(original)) + map.len(m)
        } else {
            99
        },
        _ => 99
    }
}

// A present key is read without admission, without replacing its value.
// expect: run get_or_insert_present_bound() = 10
fn get_or_insert_present_bound() -> u64 {
    let mut m = one_entry()
    let r = bound bytes 0 {
        map.get_or_insert(mut m, 1, 99)
    }
    result.unwrap(result.unwrap(r))
}

// One present entry is changed in place, and f's distinct return value is kept.
// expect: run update_present_result() = 1122
fn update_present_result() -> u64 {
    let mut m = one_entry()
    let r = map.update(mut m, 1, fn(mut v: u64) -> u64 {
        v += 1;
        v * 2
    })
    option.unwrap(r) + map.get_or(m, 1, 0) * 100
}

// A miss must neither invoke the failing callback nor insert a key.
// expect: run update_absent() = true
fn update_absent() -> bool {
    let mut m = one_entry()
    let r = map.update(mut m, 2, fn(mut v: u64) -> u64 {
        fail("absent callback")
    })
    let absent = match r {
        None => true,
        _ => false
    }
    absent && map.len(m) == 1 && map.get_or(m, 1, 0) == 10
}

// No allocation for a hit, including owned values; callback mutates the existing owner.
// expect: run update_owned_no_admission() = 2
fn update_owned_no_admission() -> u64 {
    let mut m: Map[u64, List[u64]] = map.new()
    let mut xs: List[u64] = list.new()
    result.unwrap(list.push(mut xs, 2))
    result.unwrap(map.insert(mut m, 1, take xs))
    let r = bound bytes 0 {
        map.update(mut m, 1, fn(mut v: List[u64]) -> u64 {
            option.unwrap(list.pop(mut v))
        })
    }
    option.unwrap(result.unwrap(r))
}

// Existing key identity and insertion order stay fixed.
// expect: run update_keeps_order() = 123
fn update_keeps_order() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    for i in 1u64 .. 4 {
        result.unwrap(map.insert(mut m, i, i))
    }
    let _ = map.update(mut m, 2, fn(mut v: u64) {
        v += 10
    })
    let mut n: u64 = 0
    for (k, _) in m {
        n = n * 10 + k
    }
    n
}

// An empty map needs no index access and never invokes f.
// expect: run update_empty() = true
fn update_empty() -> bool {
    let mut m: Map[u64, u64] = map.new()
    let r = map.update(mut m, 1, fn(mut v: u64) -> u64 {
        fail("empty callback")
    })
    match r {
        None => map.len(m) == 0,
        _ => false
    }
}

// An owning callback result is transferred to Some, not borrowed from its frame.
// expect: run update_owning_result() = 114
fn update_owning_result() -> u64 {
    let mut m = one_entry()
    let returned = option.unwrap(map.update(mut m, 1, fn(mut v: u64) -> String {
        v += 1
        result.unwrap(string.from("done"))
    }))
    let noise = result.unwrap(string.from("xxxx"))
    if returned != "done" || noise != "xxxx" {
        return 99
    }
    map.get_or(m, 1, 0) * 10 + list.len(string.as_bytes(returned))
}

// reserve's law: the map is made inside a limit of exactly 8 entries of Map[u64, u64]
// storage (8 x (8 + 8 + 16) = 256 bytes, MEM-24), so any later admission returns Capacity.
// reserve(8) admits those 256 once; 8 inserts follow without growth (+1000 +80). With 3
// removed, len + 3 = 8 fits the capacity, so reserve(3) compacts in place and admits
// nothing (+100), and 3 fresh inserts follow without growth (+3). Order: 3 .. 10.
// expect: run reserve_admits_once() = 1183
fn reserve_admits_once() -> u64 {
    let r = bound bytes 256 {
        let mut m: Map[u64, u64] = map.new()
        let mut code: u64 = 0
        match map.reserve(mut m, 8) {
            Ok(()) => {
                code += 1000
            }
            Error(_) => {}
        }
        for i in 0u64 .. 8 {
            match map.insert(mut m, i, i) {
                Ok(()) => {
                    code += 10
                }
                Error(_) => {}
            }
        }
        for i in 0u64 .. 3 {
            let _ = map.remove(mut m, i)
        }
        match map.reserve(mut m, 3) {
            Ok(()) => {
                code += 100
            }
            Error(_) => {}
        }
        for i in 8u64 .. 11 {
            match map.insert(mut m, i, i) {
                Ok(()) => {
                    code += 1
                }
                Error(_) => {}
            }
        }
        let mut expected: u64 = 3
        for (k, v) in m {
            if k != expected || v != expected {
                code += 5000
            }
            expected += 1
        }
        code
    }
    result.unwrap(r)
}

// Growth from empty is max(len + n, 4, 2 x 0) = 4 entries: 4 x 32 = 128 bytes, refused
// under 127 (+1) and admitted under 128 (+10).
// expect: run reserve_charge() = 11
fn reserve_charge() -> u64 {
    let mut a: Map[u64, u64] = map.new()
    let under = result.unwrap(bound bytes 127 {
        map.reserve(mut a, 3)
    })
    let mut b: Map[u64, u64] = map.new()
    let exact = result.unwrap(bound bytes 128 {
        map.reserve(mut b, 3)
    })
    let refused: u64 = match under {
        Error(_) => 1,
        Ok(()) => 0
    }
    let admitted: u64 = match exact {
        Ok(()) => 10,
        Error(_) => 0
    }
    refused + admitted
}

// len + n past 2^64 - 1 is refused, never wrapped into a small request; the map keeps
// its one entry.
// expect: run reserve_overflow_refused() = 1
fn reserve_overflow_refused() -> u64 {
    let mut m = one_entry()
    match map.reserve(mut m, int.wrapping_sub(0u64, 1)) {
        Error(_) => map.len(m),
        Ok(()) => 99
    }
}

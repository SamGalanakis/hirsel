pub fn journal_apply_commit(file: String, mut replay: pager.JournalReplay, commit: format.JournalCommit) -> Result[(), types.Failure] {
    // Section 3.4 step 6: the branch must exist, and the version is its head + 1.
    let total_count = list.len(replay.state.tips)
    let mut i = total_count
    for k in 0u64 .. total_count {
        if replay.state.tips[k].id == commit.branch {
            i = k
        }
    }
    if i == total_count || int.checked_add(replay.state.tips[i].head, 1) != Some(commit.version) {
        return Error(format.disk_fault(file, 0, Gap(commit.version)))
    }
    format.replay_within_limits(file, replay.limits, commit)?
    journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[i].roots.collections, commit.data, mut replay.tiered, replay.immutable)?
    journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[i].roots.streams, commit.streams, mut replay.tiered, replay.immutable)?
    if list.len(commit.keyed) != 0 {
        let before = manifest.keyed_root_record_bytes(replay.state.tips[i].roots.keyed)
        let mut draw = catalog.stamp_after(replay.next_node)?
        pages.materialize_keyed_edits(mut replay.state.tips[i].roots, commit.keyed, 0, mut draw)?
        if !replay.immutable {
            pages.canonical_roots(mut replay.state.tips[i].roots)?
        }
        replay.next_node = draw - 1
        replay.record_bytes = replay.record_bytes - before + manifest.keyed_root_record_bytes(replay.state.tips[i].roots.keyed)
        if replay.record_bytes > replay.limits.meta {
            return Error(format.disk_fault(file, 0, Malformed))
        }
    }
    replay.state.tips[i].head = commit.version
    replay.state.tips[i].at = commit.at
    Ok(())
}

pub fn journal_apply(file: String, mut replay: pager.JournalReplay, take event: format.JournalEvent) -> Result[(), types.Failure] {
    match take event {
        Commit(take commit) => journal_apply_commit(file, mut replay, commit),
        Fork(take encoded) => journal.journal_apply_fork(file, mut replay, take encoded),
    }
}

// Replay settles the Memory union from the final roots. A put can make
// the head and a pin share a row version again, lowering that union.
pub fn journal_apply_ops(file: String, mut ids: u64, mut tree: pages.PageTree, ops: List[format.JournalOp], mut account: pager.ReplayTieredAccount, immutable: bool) -> Result[(), types.Failure] {
    if list.len(ops) == 0 {
        return Ok(())
    }
    let mut next_stamp = catalog.stamp_after(ids)?
    let domain = pages.tree_domain(tree)
    let mut processed = 0u64
    for slot in 0u64 .. list.len(ops) {
        if slot < processed {
            continue
        }
        let op = view ops[slot]
        if domain == CollectionMap {
            if list.len(op.key) < 4 {
                return Error(format.disk_fault(file, 0, Malformed))
            }
            let (kind, tiered_descriptor, row_count) = {
                let Some(descriptor) = std.page.lookup(tree.root, list.slice(op.key, 0, 4)) else {
                    return Error(format.disk_fault(file, 0, Malformed))
                }
                pager.journal_collection_descriptor(descriptor)
            }
            if let Some(_) = op.direct {
                if kind != BlobsCollection {
                    return Error(format.disk_fault(file, 0, Malformed))
                }
            }
            if let Some(before) = tiered_descriptor {
                replay_tiered_op(file, mut tree, mut next_stamp, mut account, before, op)?
                continue
            }
            if let Some(trim) = op.trim {
                match trim_log_page(mut tree, op.key, trim.floor, Some(trim.dropped), 0, mut next_stamp) {
                    Ok(_) => (),
                    Error(Corrupt(_)) => return Error(format.disk_fault(file, 0, Malformed)),
                    Error(take problem) => return Error(take problem),
                }
                continue
            }
            if kind == LogCollection {
                let Some(value) = view op.value else {
                    return Error(format.disk_fault(file, 0, Malformed))
                }
                if list.len(op.key) != 12 || op.prior != 0 || list.len(value) < 2 {
                    return Error(format.disk_fault(file, 0, Malformed))
                }
                let seq: u64 = list.word_be(op.key, 4)
                let id: u32 = list.word_be(op.key, 0)
                let limits = committed_log_bounds(tree, id)?
                if seq != limits.next || seq == 18446744073709551615u64 {
                    return Error(format.disk_fault(file, 0, Malformed))
                }
                journal.apply_log_append(mut tree, op.key, value, None, 0, mut next_stamp)?
                continue
            }
            if kind == TableCollection || kind == IndexCollection {
                processed = journal.journal_sorted_run(ops, slot)
                if processed > slot + 1 {
                    if immutable && row_count == 0 {
                        journal.journal_collection_empty(file, mut tree, ops, slot, processed, mut next_stamp)?
                        continue
                    }
                    journal.journal_collection_batch(file, mut tree, ops, slot, processed, mut next_stamp)?
                    continue
                }
            }
            let prior = if kind == BlobsCollection {
                pages.blob_row_prior(tree, op.key)
            } else {
                format.stored_prior(pages.get_page_row(tree, op.key))
            }
            if op.prior != prior {
                return Error(format.disk_fault(file, 0, Malformed))
            }
            if let Some(place) = op.direct {
                let resident: Option[Arc[Bytes]] = match op.value {
                    Some(bytes_value) => {
                        if list.len(bytes_value) != place.len || std.check.xxh3(bytes_value, 0, list.len(bytes_value)) != place.checksum {
                            return Error(format.disk_fault(file, place.offset, Checksum))
                        }
                        Some(arc.new(types.copied(bytes_value)?))
                    },
                    None => None,
                }
                pages.put_direct_page_row(mut tree, op.key, place, take resident, 0, mut next_stamp)?
                continue
            }
            if kind == CellCollection {
                if list.len(op.key) != 4 {
                    return Error(format.disk_fault(file, 0, Malformed))
                }
                let raw = match op.value {
                    Some(stored) => Some(view stored),
                    None => None
                }
                if let Some(stored) = raw {
                    if list.len(stored) < 2 {
                        return Error(format.disk_fault(file, 0, Malformed))
                    }
                }
                apply_cell(mut tree, op.key, raw, None, 0, mut next_stamp)?
                continue
            }
        } else if let Some(_) = op.trim {
            return Error(format.disk_fault(file, 0, Malformed))
        }
        match op.value {
            Some(value) => pages.put_page_row(mut tree, op.key, value, 0, mut next_stamp)?,
            None => {
                let _ = pages.remove_page_row(mut tree, op.key, 0, mut next_stamp)?
            },
        }
    }
    if !immutable {
        pages.canonical_tree(mut tree)?
    }
    ids = next_stamp - 1
    Ok(())
}

// Account for the suffix appends before dropping their overlay_entries. Only the
// Cold part and its interval go to the fold, where the Cold tree is available.
pub fn replay_overlay_trim(mut overlay: Arc[pages.ReplayOverlay], path: String, at: u64, collection: u32, head: pager.ReplayLogHead, trim: format.JournalTrim) -> Result[pager.ReplayLogHead, types.Failure] {
    if trim.floor < head.first || trim.dropped > head.row_bytes {
        return Error(format.disk_fault(path, at, Malformed))
    }
    let end = order.min(trim.floor, head.next)
    let suffix_start = order.max(head.first, head.cold_next)
    let hi = order.min(end, head.cold_next)
    let ready = manifest.disk_allocation(scoped fn() -> Result[Arc[pages.ReplayOverlay], types.Failure] {
        let mut removed = 0u64
        let mut suffix_charge = 0u64
        let suffix_key = pager.log_key(collection, suffix_start)?
        if suffix_start < end {
            let mut cursor = std.omap.range(overlay.entries, Included(clone(suffix_key)), Excluded(pager.log_key(collection, end)?))
            let mut n = 0u64
            while let Some((key, row)) = std.omap.next(mut cursor) {
                let ReplayPut(value) = view row.now else {
                    return Error(format.disk_fault(path, at, Malformed))
                }
                suffix_charge += entry(key, value)
                removed += 24 + list.len(key) + list.len(value)
                n += 1
            }
            if n != end - suffix_start {
                return Error(format.disk_fault(path, at, Malformed))
            }
        }
        let Some(cold_charge) = int.checked_sub(trim.dropped, suffix_charge) else {
            return Error(format.disk_fault(path, at, Malformed))
        }
        if head.first >= hi && cold_charge != 0 {
            return Error(format.disk_fault(path, at, Malformed))
        }
        let mut ids = overlay.ids
        let overlay_entries = if suffix_start < end {
            std.omap.graft(mut ids, overlay.entries, suffix_key, pager.log_key(collection, trim.floor)?, std.omap.new())
        } else {
            clone(overlay.entries)
        }
        let proof = pages.ReplayTrimEvidence(lo: head.first, hi: hi, cold_charge: cold_charge)
        let (take trims, _) = std.omap.insert(mut ids, overlay.trims, std.omap.len(overlay.trims), proof)
        let charged = overlay.charged - removed + 24
        Ok(arc.new(pages.ReplayOverlay(entries: take overlay_entries, cold_next: overlay.cold_next, floor: Some(trim.floor), trims: take trims, ids: ids, charged: charged)))
    })?
    overlay = take ready
    Ok(pager.ReplayLogHead(first: trim.floor, next: order.max(head.next, trim.floor), cold_next: head.cold_next, row_bytes: head.row_bytes - trim.dropped))
}

pub fn replay_tiered_op(file: String, mut tree: pages.PageTree, mut next_stamp: u64, mut account: pager.ReplayTieredAccount, before: pager.ReplayDescriptor, op: format.JournalOp) -> Result[(), types.Failure] {
    let id: u32 = list.word_be(op.key, 0)
    let (take ready_root, take next_branch_overlay, following_stamp, total) = manifest.disk_allocation(scoped fn() -> Result[(Arc[std.page.Page], Arc[pages.ReplayBranch], u64, u64), types.Failure] {
        let previous = match tree.replay {
            Some(existing) => arc.share(existing),
            None => arc.new(pages.ReplayBranch(collections: std.omap.new(), fork_time: None, ids: 0, charged: 0)),
        }
        let (take current, previous_charge) = match std.omap.get(previous.collections, id) {
            Some(overlay) => (arc.share(overlay), overlay.charged),
            None => (pager.empty_replay_overlay(match before.seq_bounds {
                Some(window) => Some(window.next),
                None => None
            }), 0u64),
        }
        let mut overlay = take current
        let (after, removed, added) = match op.trim {
            Some(trim) => replay_trim_edit(file, mut overlay, id, before, op, trim)?,
            None => replay_row_edit(file, mut overlay, before, op)?,
        }
        let new_total = pager.replay_charge(file, account.total, if account.exact {
            removed
        } else {
            0u64
        }, added)?
        let seq_bounds: Option[(u64, u64)] = match after.seq_bounds {
            Some(window) => Some((window.first, window.next)),
            None => None,
        }
        let mut root = arc.share(tree.root)
        let mut stamp = next_stamp
        pages.page_result(std.page.replay_collection_totals(mut root, list.slice(op.key, 0, 4), after.rows, after.row_bytes, seq_bounds, mut stamp))?
        let charged = previous.charged - previous_charge + overlay.charged
        let mut ids = previous.ids
        let (take collections, _) = std.omap.insert(mut ids, previous.collections, id, take overlay)
        Ok((take root, arc.new(pages.ReplayBranch(collections: take collections, fork_time: clone(previous.fork_time), ids: ids, charged: charged)), stamp, new_total))
    })?
    tree.root = take ready_root
    tree.replay = Some(take next_branch_overlay)
    next_stamp = following_stamp
    account.total = total
    Ok(())
}

fn replay_row_edit(file: String, mut overlay: Arc[pages.ReplayOverlay], before: pager.ReplayDescriptor, op: format.JournalOp) -> Result[(pager.ReplayDescriptor, u64, u64), types.Failure] {
    let mut seq_bounds = before.seq_bounds
    if let Some(window) = before.seq_bounds {
        let Some(value) = view op.value else {
            return Error(format.disk_fault(file, 0, Malformed))
        }
        if op.prior != 0 || list.len(op.key) != 12 || list.len(value) < 2 || list.word_be(op.key, 4) != window.next {
            return Error(format.disk_fault(file, 0, Malformed))
        }
        let Some(following) = int.checked_add(window.next, 1) else {
            return Error(format.disk_fault(file, 0, Malformed))
        }
        seq_bounds = Some(pages.LogBoundsRep(first: window.first, next: following))
    }
    let (now, added, added_rows): (pages.ReplayValue, u64, u64) = match (view op.direct, view op.value) {
        (Some(place), _) => (ReplayDirect(arc.share(place)), capture.stored_row_charge(list.len(op.key), place.len), 1),
        (None, Some(value)) => (ReplayPut(arc.new(types.copied(value)?)), entry(op.key, value), 1),
        (None, None) => (ReplayAbsent, 0, 0),
    }
    let removed = pager.prior_row_charge(op.key, op.prior)
    let removed_rows = if op.prior == 0 {
        0u64
    } else {
        1u64
    }
    let rows = pager.replay_charge(file, before.rows, removed_rows, added_rows)?
    let row_bytes = pager.replay_charge(file, before.row_bytes, removed, added)?
    pager.replay_overlay_edit(mut overlay, file, 0, op.key, op.prior, now)?
    Ok((pager.ReplayDescriptor(rows: rows, row_bytes: row_bytes, seq_bounds: seq_bounds), removed, added))
}

fn replay_trim_edit(file: String, mut overlay: Arc[pages.ReplayOverlay], collection: u32, before: pager.ReplayDescriptor, op: format.JournalOp, trim: format.JournalTrim) -> Result[(pager.ReplayDescriptor, u64, u64), types.Failure] {
    let Some(window) = before.seq_bounds else {
        return Error(format.disk_fault(file, 0, Malformed))
    }
    if list.len(op.key) != 4 {
        return Error(format.disk_fault(file, 0, Malformed))
    }
    let start = pager.ReplayLogHead(first: window.first, next: window.next, cold_next: option.unwrap(overlay.cold_next), row_bytes: before.row_bytes)
    let revised = replay_overlay_trim(mut overlay, file, 0, collection, start, trim)?
    let seq_bounds = pages.LogBoundsRep(first: revised.first, next: revised.next)
    Ok((pager.ReplayDescriptor(rows: revised.next - revised.first, row_bytes: revised.row_bytes, seq_bounds: Some(seq_bounds)), trim.dropped, 0u64))
}

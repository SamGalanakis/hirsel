    (0x19f623d5a8a73297, 0x4cfbc31db4b0295f), // q = 32
    (0x14c4e977ba1f5bac, 0x3d9635b15d59bab2), // q = 33
    (0x109d8792fb4c4956, 0x97ab5e277de16228), // q = 34
    (0x1a95a5b7f87a0ef0, 0xf2abc9d8c9689d0d), // q = 35

fn check_aggregation() {
    // Initial OBU(s) from str0m RTP packet 7485. FFmpeg decoded two packets
    // with this sequence header and frame prefix as a 640x480 keyframe.
    // The frame element is shortened here because its coded bytes are opaque.
    let packet = b"\x68\x0b\x08\x00\x00\x00\x24\xc4\xff\xdf\x00\x68\x02\x30\x10\x6b\x74"
    let aggregation = result.unwrap(av1.parse_rtp(packet))
    if aggregation.count != 2 || !aggregation.starts_sequence || !aggregation.continues_next || aggregation.continues_previous {
        fail("captured AV1 aggregation header")
    }
    let mut at: u64 = 1
    let seq = option.unwrap(result.unwrap(av1.rtp_next(packet, mut at, 0)))
    let seq_header = result.unwrap(av1.parse_obu(list.slice(packet, seq.start, seq.end), 0))
    if seq.start != 2 || seq.end != 13 || seq_header.kind != 1 || seq_header.payload_start != 1 || seq.continues_previous || seq.continues_next {
        fail("sequence header offset in the captured keyframe")
    }
    let sequence = list.slice(packet, seq.start + seq_header.payload_start, seq.end)
    let reduced = result.unwrap(av1.reduced_still_picture(sequence))
    let key = option.unwrap(result.unwrap(av1.rtp_next(packet, mut at, 1)))
    let key_header = result.unwrap(av1.parse_obu(list.slice(packet, key.start, key.end), 0))
    if key.start != 13 || key.end != 17 || !key.continues_next || key.continues_previous || key_header.kind != 6 || reduced || !result.unwrap(av1.is_keyframe(list.slice(packet, key.start + key_header.payload_start, key.end), reduced)) {
        fail("captured keyframe classification")
    }
    let resume = result.unwrap(av1.parse_rtp(b"\x90\xfe\xc6\x2c"))
    let lone_inter = result.unwrap(av1.parse_rtp(b"\x10\x30\x30\xc0"))
    if !resume.continues_previous || resume.continues_next || resume.count != 1 || lone_inter.starts_sequence || result.unwrap(av1.is_keyframe(b"\x30\xc0", reduced)) {
        fail("captured continuation or inter frame")
    }
    // AV1 §5.3. OBU_METADATA with extension T=3/S=2, explicit length 1 in
    // a two-byte leb128, then a temporal delimiter with zero payload.
    let stream = b"\x2e\x70\x81\x00x\x12\x00"
    let metadata = result.unwrap(av1.parse_obu(stream, 0))
    let delimiter = result.unwrap(av1.parse_obu(stream, metadata.end))
    if metadata.kind != 5 || metadata.temporal != 3 || metadata.spatial != 2 || metadata.payload_start != 4 || metadata.end != 5 || delimiter.kind != 2 || delimiter.payload_start != 7 || delimiter.end != 7 {
        fail("AV1 OBU extension or length")
    }
    // W=0 requires lengths for both elements. The reserved bits are ignored.
    let explicit = result.unwrap(av1.parse_rtp(b"\x07\x81\x00\x28\x01\x30"))
    if explicit.count != 2 {
        fail("AV1 W=0 element count")
    }
    if let Ok(_) = av1.parse_rtp(b"\x88\x01\x30") {
        fail("AV1 new sequence and continuation accepted together")
    }
    if let Ok(_) = av1.parse_rtp(b"\x20\x01\x08") {
        fail("AV1 W count exceeds payload")
    }
    if let Ok(_) = av1.parse_obu(b"\x0a\xff\xff\xff\xff\x10", 0) {
        fail("AV1 leb128 greater than 32 bits accepted")
    }
}

fn check_dependency() {
    // str0m's spatial_transitions_chains_resolutions_and_template_wrap.
    let wire = b"\xc3\xff\xff\x87\xc1\x59\xba\x66\x21\x24\x1f\x41\x14\xda\x00\x22\x44\x66\x88\xab\x01\x3f\x00\xb3\x02\x7f\x01\x67\xff\xff\xff\xff"
    let mut structure = dependency.empty()
    if let Ok(_) = dependency.parse(b"\xc3\xff\xff", mut structure) {
        fail("mandatory-only descriptor accepted without structure")
    }
    let frame = result.unwrap(dependency.parse(wire, mut structure))
    let resolution = option.unwrap(frame.resolution)
    let mut refs = frame.references
    if !frame.first || !frame.last || frame.number != 65535 || frame.template_id != 3 || frame.spatial != 2 || frame.temporal != 0 || frame.active_targets != 3 || resolution.width != 65536 || resolution.height != 65536 || option.unwrap(dependency.protecting_chain(view structure, 1)) != 1 || option.unwrap(dependency.chain_difference(frame, 0)) != 5 || option.unwrap(dependency.chain_difference(frame, 1)) != 5 || option.unwrap(result.unwrap(dependency.next_reference(wire, view structure, mut refs))) != 4 {
        fail("dependency template layers, references, chains or resolutions")
    }
    if let Some(_) = result.unwrap(dependency.next_reference(wire, view structure, mut refs)) {
        fail("extra dependency in the template")
    }
    if let Ok(_) = dependency.parse(list.slice(wire, 0, 31), mut structure) {
        fail("truncated structure accepted")
    }
    let cached = result.unwrap(dependency.parse(b"\x40\x00\x01", mut structure))
    if cached.spatial != 0 || cached.temporal != 2 || cached.first || !cached.last || cached.number != 1 {
        fail("cached template lookup after frame-number wrap or refused update")
    }
    // A.8.2 single template, two targets, one chain protecting both
    // targets. Then str0m custom_fields_wire_vector overrides all fields.
    let template = b"\xc0\x00\x01\x80\x01\xe9\x00"
    let _ = result.unwrap(dependency.parse(template, mut structure))
    let mut custom = b"\xc0\x12\x34\x7c\xe8\x3f\x08\x5f\xf8\x80\x7f\xfe\x7f\x80"
    result.unwrap(dependency.rewrite_frame_number(mut custom, 17))
    let changed = result.unwrap(dependency.parse(custom, mut structure))
    if changed.number != 17 || changed.active_targets != 2 || option.unwrap(dependency.chain_difference(changed, 0)) != 255 {
        fail("dependency frame number or custom chain")
    }
    if let Some(Discardable) = dependency.decode_target(changed, 0) {} else {
        fail("custom target zero indication")
    }
    if let Some(Required) = dependency.decode_target(changed, 1) {} else {
        fail("custom target one indication")
    }
    let expected: Inline[u64, 6] =[1, 16, 17, 256, 257, 4096]
    let mut differences = changed.references
    for diff in expected {
        let found = result.unwrap(dependency.next_reference(custom, view structure, mut differences))
        if option.unwrap(found) != diff {
            fail("custom frame differences")
        }
    }
    if let Some(_) = result.unwrap(dependency.next_reference(custom, view structure, mut differences)) {
        fail("extra custom frame difference")
    }
    let implicit = result.unwrap(dependency.parse(b"\xc0\x00\x12", mut structure))
    if implicit.active_targets != 2 || implicit.decode_target_count != 2 || option.unwrap(dependency.chain_difference(implicit, 0)) != 0 {
        fail("active target update or template fallback")
    }
}

fn indication(frame: dependency.Frame, target: u64) -> u8 {
    match dependency.decode_target(frame, target) {
        Some(Absent) => 0,
        Some(Discardable) => 1,
        Some(Switch) => 2,
        Some(Required) => 3,
        None => 4
    }
}

// Every decode target's indication, two bits each, target 0 lowest, as A.8.3 sends them.
fn indications(frame: dependency.Frame) -> u64 {
    let mut packed: u64 = 0
    for target in 0u64 .. frame.decode_target_count {
        let value: u64 = int.widen(indication(frame, target))
        packed |= value << (2 * target)
    }
    packed
}

// Pack "-DSR" letters (ASCII 68, 83, 82), target 0 first, the way the structure is usually printed.
fn letters(text: Bytes) -> u64 {
    let mut packed: u64 = 0
    for i in 0u64 .. list.len(text) {
        let c = text[i]
        let value: u64 = if c == 68 {
            1
        } else if c == 83 {
            2
        } else if c == 82 {
            3
        } else {
            0
        }
        packed |= value << (2 * i)
    }
    packed
}

fn check_l3t3() {
    // LiveKit pkg/sfu/rtpextension/dependencydescriptor/dependencydescriptorextension_test.go
    // (d210b4d4), "hex bytes from traffic capture": a Chromium AV1 L3T3 keyframe
    // descriptor with its structure, then per-frame descriptors.
    let key = b"\xc1\x01\x72\x80\x08\x14\x85\x21\x4e\xaf\xff\xaa\xaa\x86\x3c\xf0\x43\x0c\x10\xc3\x02\xaf\xc0\xaa\xa0\x06\x3c\x00\x43\x00\x10\xc0\x02\xa0\x00\xa8\x00\x06\x00\x00\x40\x00\x1d\x95\x49\x26\xe0\x82\xb0\x4a\x09\x41\xb8\x20\xac\x12\x82\x50\x31\x57\xf9\x74\x00\x0c\xa8\x64\x33\x0e\x22\x22\x22\xec\xa8\x65\x53\x04\x22\x42\x30\xec\xa8\x77\x53\x00\x77\x00\x42\x00\xef\x00\x86\x01\xdf\x01\x0d"
    let mut structure = dependency.empty()
    let frame = result.unwrap(dependency.parse(key, mut structure))
    let resolution = option.unwrap(frame.resolution)
    if !frame.first || !frame.last || frame.number != 370 || frame.template_id != 1 || frame.spatial != 0 || frame.temporal != 0 || frame.decode_target_count != 9 || frame.active_targets != 511 || resolution.width != 120 || resolution.height != 67 || indications(frame) != letters(b"SSSSSSSSS") {
        fail("captured L3T3 keyframe descriptor")
    }
    // A.8.2: nine decode targets, d = 3 * spatial + temporal; three chains, one per
    // spatial layer.
    for target in 0u64 .. 9u64 {
        let spatial: u8 = int.narrow(target / 3)
        let temporal: u8 = int.narrow(target % 3)
        let (s, t) = option.unwrap(dependency.target_layers(view structure, target))
        if s != spatial || t != temporal || option.unwrap(dependency.protecting_chain(view structure, target)) != spatial {
            fail("captured L3T3 decode target layers or chains")
        }
    }
    if let Some(_) = dependency.target_layers(view structure, 9) {
        fail("a tenth decode target in an L3T3 structure")
    }
    // Template 6: S1T0, one reference one frame back.
    let upper = b"\x86\x01\x73\x40\xfc"
    let s1 = result.unwrap(dependency.parse(upper, mut structure))
    let mut refs = s1.references
    if !s1.first || s1.last || s1.number != 371 || s1.spatial != 1 || s1.temporal != 0 || s1.active_targets != 63 || indications(s1) != letters(b"---SSSSSS") || option.unwrap(dependency.chain_difference(s1, 1)) != 1 || option.unwrap(result.unwrap(dependency.next_reference(upper, view structure, mut refs))) != 1 {
        fail("captured S1T0 descriptor")
    }
    if let Some(_) = result.unwrap(dependency.next_reference(upper, view structure, mut refs)) {
        fail("extra S1T0 reference")
    }
    let t2 = result.unwrap(dependency.parse(b"\xc3\x01\x75\x40\xfc", mut structure))
    if t2.number != 373 || t2.spatial != 0 || t2.temporal != 2 || indications(t2) != letters(b"--D--R--R") {
        fail("captured S0T2 descriptor")
    }
    let both = b"\x88\x01\x76\x40\xfc"
    let s1t2 = result.unwrap(dependency.parse(both, mut structure))
    let mut two = s1t2.references
    let first = option.unwrap(result.unwrap(dependency.next_reference(both, view structure, mut two)))
    let second = option.unwrap(result.unwrap(dependency.next_reference(both, view structure, mut two)))
    if s1t2.number != 374 || s1t2.spatial != 1 || s1t2.temporal != 2 || indications(s1t2) != letters(b"-----D--R") || first != 3 || second != 1 {
        fail("captured S1T2 descriptor")
    }
    let t1 = result.unwrap(dependency.parse(b"\xc2\x01\x78\x40\xfc", mut structure))
    if t1.number != 376 || t1.spatial != 0 || t1.temporal != 1 || indications(t1) != letters(b"-DS-RR-RR") {
        fail("captured S0T1 descriptor")
    }
    // The second capture: a new structure restores every target, then mandatory-only
    // descriptors reuse it.
    let _ = result.unwrap(dependency.parse(key, mut structure))
    let s2 = result.unwrap(dependency.parse(b"\x8b\x01\x74", mut structure))
    if !s2.first || s2.last || s2.number != 372 || s2.spatial != 2 || s2.temporal != 0 || s2.active_targets != 511 || indications(s2) != letters(b"------SSS") {
        fail("captured mandatory-only S2T0 descriptor")
    }
}

/// bug: Lose an OBU boundary or layer field, or apply the wrong Dependency Descriptor template after wrap or a failed update.
/// oracle: AV1 bitstream section 5.3, AV1 RTP sections 4.4–4.5 and Appendix A, FFmpeg on str0m av1.pcap, str0m Dependency Descriptor wire vectors, and LiveKit's captured Chromium L3T3 descriptors (d210b4d4), decoded by hand from AV1 RTP section A.8 and by LiveKit's own parser.
@test
fn av1_rtp_dependencies() -> Result[(), ()] {
    check_aggregation()
    check_dependency()
    check_l3t3()
    Ok(())
}

fn disk_try_publish(d: Dir, state: DiskState, cut: DiskCut) -> Result[(), Error] waits {
    let prepared = disk_prepare(d, state, cut, 512)?
    let _ = disk_commit(d, take prepared)?
    Ok(())
}

// L28: removal names are part of preparation, even when the named files are
// already absent. At each bound a refused cut keeps generation1; an accepted
// one publishes generation2. Moving those allocations past rename can instead
// return Full after generation2 is durable (alloc_after_publish).
pub fn disk_law_publish_refusal(d: Dir) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let roots = Roots(data: std.omap.new(), streams: std.omap.new(), catalog: std.omap.new())
    let mut refused_count: u64 = 0
    let mut saved_count: u64 = 0
    for step in 1u64 .. 129 {
        let child = disk_test_directory(d)
        let manifest = disk_genesis_fixture()
        result.unwrap(disk_publish_manifest(child, id, manifest))
        let state = DiskState(store: id, manifest: take manifest, lease: None, graph: disk_graph())
        let cut = DiskCut(generation: 2, fence: 0, lease: None, target: None, state: result.unwrap(main_state(share_roots(roots), 0, 0)), next_node: 1, next_table: 1, first_live: 97)
        let trial: Result[Result[(), Error], Capacity] = bound bytes (step * 512) {
            disk_try_publish(child, state, cut)
        }
        let saved = match take trial {
            Ok(Ok(())) => true,
            Ok(Error(Full(_))) => false,
            Error(_) => false,
            _ => return false
        }
        let raw = result.unwrap(disk_read_file(child, "MANIFEST", 1048576))
        let persisted = result.unwrap(disk_read_manifest("MANIFEST", raw))
        let (_, take current) = take persisted
        if saved {
            saved_count += 1
            if current.generation != 2 || current.first_live != 97 {
                return false
            }
        } else {
            refused_count += 1
            if current.generation != 1 || current.first_live != 1 {
                return false
            }
        }
    }
    refused_count > 0 && saved_count > 0
}


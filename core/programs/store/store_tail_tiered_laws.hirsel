fn tail_pin_page(db: Db, fixture: ProjectorFixture, image: Image) -> Result[std.page.PagePtr, Error] {
    let name = pages.projector_pin_name(fixture.decl.name, image.slot)
    let slot = pin_index(db, ProjectorPin, name)
    let key = failure_result_from_rep(catalog.prefix(fixture.source_table.id))?
    let Some((ColdPage(ptr), _)) = std.page.collection_slot(pages.holder_pins(db.holders)[slot].roots.collections.root, key) else {
        fail("Tiered tail: the published pin must hold a Cold source")
    }
    Ok(ptr)
}

fn checkpoint_tail_pin(mut db: Db, fixture: ProjectorFixture, image: Image) -> Result[(), Error] waits {
    let original = tail_pin_page(db, fixture, image)?
    let _ = checkpoint(mut db)?
    let moved = tail_pin_page(db, fixture, image)?
    if original.pack == moved.pack || original.stamp != moved.stamp || compact_listed(db, original.pack) {
        fail("Tiered tail: the cut must relocate the image root and retire the old pack")
    }
    Ok(())
}

/// bug: read_tail refuses a Tiered source, misses staged changes or keeps a retired pin location after a cut.
/// oracle: the paged model-map differences in L-TAIL, after two publications and a guarded relocation cut.
@test
fn test_tail_tiered(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut options = l70_open_options(300000000)?
    options.compact_permille = 1001
    options.probe_budget = 65536
    let mut db = open(tasks, disk_test_directory(d), c, r, options)?
    let fixture = projector_fixture(mut db, Migrate, Own, cadence())?
    set_residency(mut db, fixture.source_table.id, Tiered)?
    law_tail(mut db, fixture, true)?
    close(take db)
}

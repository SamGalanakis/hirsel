#!/usr/bin/env bash
# Build the compiler's engine libLLVM (`engine_llvm` in llvm-23.lock): PGO + ThinLTO + BOLT.
#
#   build-libllvm DIR ARTIFACTS bootstrap|package|instr|train|opt|bolt-tools|bolt|guard|plain
#
# ARTIFACTS is a core/tools/measurement_artifacts.py identity (compiler and runtime
# archive). For IR train and guard, set HIRSEL_LLVM_PROFILE_SOURCE to the checkout
# named by engine_llvm_guard_source and use ARTIFACTS from that checkout. For BOLT
# training use a release compiler and runtime from this checkout.
#
#   bootstrap  each build tool and its stock shared libraries, as DIR/llvm-bootstrap.tar.xz
#   package    package an already-built bootstrap tree
#   instr  IR-instrumented libLLVM.so.23.1 from the locked source archive
#   train  every training program of engine_llvm.py through it, merged into DIR/llvm.profdata
#   opt    the profile-guided ThinLTO libLLVM.so.23.1 with relocations in DIR/opt/lib
#   bolt-tools  build and package llvm-bolt and merge-fdata from the same source pin
#   bolt   instrument that library, train on release builds, and write DIR/libLLVM.so.23.1
#   guard  the locked apt.llvm.org deb against DIR/libLLVM.so.23.1 on the training
#          and held-out programs. Fails unless every .text is byte-identical and the warm build
#          cost geomean is below the stock library's and no worse than the lock's previous
#          `engine_llvm_guard` record. Runs on the host and prints the engine_llvm record.
#   plain  the same configuration without profile or ThinLTO, as DIR/plain/lib/libLLVM.so.23.1:
#          the fallback when a profile build fails its guard (about 0.88 of the stock library's
#          warm cost against 0.64 for the profile build)
#
# Build in the manylinux_2_28 x86_64 image with the GCC toolset on PATH.
# For the engine stages, set CC and CXX to the matching bootstrap clangs and
# provide their compiler-rt profile runtime. Use the same LLVM snapshot's
# lld, TableGen and llvm-profdata beside clang. Configuration: Release without
# assertions; targets X86 and AArch64, the only ones the compiler initialises (engine.c);
# a dylib without RPATH or RUNPATH; -fno-semantic-interposition; zlib on; zstd, libxml2, libedit, terminfo, ffi, z3
# and libpfm off. The result loads only libz, libstdc++, libm, libgcc_s and libc.
#
# Each compile stage runs under tools/capped (8G) at nice 19 with JOBS jobs (default 4),
# on CPUS if set (a taskset list), after the 1-minute load falls to MAX_LOAD (default 32).
# About 2.7 CPU-hours at 12 jobs: instr 4.5 min, train 3 min, opt 6 min of wall time.
#
# Run once per pin change, then upload DIR/libLLVM.so.23.1 to
# the release in `asset_pool` under the printed asset name and update the engine_llvm
# record in llvm-23.lock. Nothing rebuilds it per land.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lock="$here/llvm-23.lock"
fail() { echo "build-libllvm: $*" >&2; exit 1; }
(( $# == 3 )) || { echo "usage: build-libllvm DIR ARTIFACTS bootstrap|package|instr|train|opt|bolt-tools|bolt|guard|plain" >&2; exit 2; }
lock_value() {
  awk -v k="$1" '$1 == k { sub(/^[^ ]+ /, ""); print; found = 1 } END { exit !found }' "$lock" \
    || fail "llvm-23.lock has no '$1' record"
}

mkdir -p "$1"
dir="$(cd "$1" && pwd)"
artifacts="$(realpath "$2")"
jobs=${JOBS:-4}
version="$(lock_value llvm_version)"
library_path="$(python3 "$here/../toolchain-dist/product.py" llvm-path x86_64-unknown-linux-gnu)"
soname="${library_path##*/}"
cc="$(command -v "${CC:-clang}")"
cxx="$(command -v "${CXX:-clang++}")"
tool_bin="$(dirname "$cc")"
gcc_install="$(dirname "$(gcc -print-libgcc-file-name)")"

wait_load() { while awk -v m="${MAX_LOAD:-32}" '{ exit !($1 > m) }' /proc/loadavg; do sleep 60; done; }
capped() {
  wait_load
  HIRSEL_JOBS=$jobs HIRSEL_MEMORY_LIMIT=${HIRSEL_MEMORY_LIMIT:-8G} "$here/../capped" --long nice -n 19 ${CPUS:+taskset -c "$CPUS"} "$@"
}

source_tree() {
  [[ -d "$dir/src/llvm" ]] && return
  local archive="$dir/llvm-project-$version.src.tar.xz"
  [[ -f "$archive" ]] || curl -fsSL "$(lock_value source_url)" -o "$archive" || fail "could not download the source archive"
  [[ "$(sha256sum "$archive" | cut -d ' ' -f 1)" == "$(lock_value source_sha256)" ]] || fail "$archive does not have the locked SHA-256"
  mkdir "$dir/src.partial"
  tar xf "$archive" --strip-components=1 -C "$dir/src.partial"
  mv "$dir/src.partial" "$dir/src"
}

configure() {  # configure BUILD EXTRA...
  local build=$1; shift
  cmake -G Ninja -S "$dir/src/llvm" -B "$build" \
    -DCMAKE_BUILD_TYPE=Release -DLLVM_ENABLE_ASSERTIONS=OFF \
    -DCMAKE_C_COMPILER="$cc" -DCMAKE_CXX_COMPILER="$cxx" \
    -DCMAKE_AR="$tool_bin/llvm-ar" -DCMAKE_RANLIB="$tool_bin/llvm-ranlib" -DLLVM_USE_LINKER=lld \
    -DCMAKE_C_FLAGS="--gcc-install-dir=$gcc_install -fno-semantic-interposition" \
    -DCMAKE_CXX_FLAGS="--gcc-install-dir=$gcc_install -fno-semantic-interposition" \
    -DLLVM_TARGETS_TO_BUILD='X86;AArch64' -DLLVM_ENABLE_PROJECTS= \
    -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON \
    -DLLVM_ENABLE_ZLIB=FORCE_ON -DLLVM_ENABLE_ZSTD=OFF -DLLVM_ENABLE_LIBXML2=OFF -DLLVM_ENABLE_LIBEDIT=OFF \
    -DLLVM_ENABLE_TERMINFO=OFF -DLLVM_ENABLE_FFI=OFF -DLLVM_ENABLE_Z3_SOLVER=OFF -DLLVM_ENABLE_LIBPFM=OFF \
    -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_INCLUDE_DOCS=OFF \
    -DLLVM_PARALLEL_LINK_JOBS=1 -DCMAKE_SKIP_RPATH=ON "$@" > "$build.cmake.log"
}

configure_engine() {  # configure_engine BUILD SHARED_LINKER_FLAGS EXTRA...
  local build=$1 shared_linker_flags=$2
  shift 2
  configure "$build" \
    -DCMAKE_EXE_LINKER_FLAGS="-B$tool_bin" \
    -DCMAKE_SHARED_LINKER_FLAGS="-B$tool_bin -Wl,--build-id=sha1${shared_linker_flags:+ $shared_linker_flags}" \
    -DLLVM_NATIVE_TOOL_DIR="$tool_bin" -DLLVM_TABLEGEN="$tool_bin/llvm-tblgen" "$@"
}

library() {  # library BUILD
  capped ninja -C "$1" -j "$jobs" LLVM > "$1.ninja.log" || fail "the LLVM build in $1 failed (see $1.ninja.log)"
}

bootstrap_tools=(clang llvm-ar llvm-config llvm-nm llvm-objcopy llvm-objdump llvm-profdata llvm-readobj llvm-strip llvm-symbolizer llvm-tblgen)

bootstrap() {
  source_tree
  local build="$dir/bootstrap"
  configure "$build" -DLLVM_ENABLE_PROJECTS=clang -DLLVM_DEFAULT_TARGET_TRIPLE=x86_64-unknown-linux-gnu \
    -DCMAKE_SKIP_RPATH=OFF "-DCMAKE_INSTALL_RPATH=\$ORIGIN/../lib"
  capped ninja -C "$build" -j "$jobs" LLVM clang-resource-headers "${bootstrap_tools[@]}" > "$build.ninja.log"
  package
}

package() {
  local build="$dir/bootstrap" stage="$dir/bootstrap-install"
  local components=(LLVM clang-cpp clang-resource-headers llvm-headers "${bootstrap_tools[@]}")
  rm -rf "$stage"
  local component
  for component in "${components[@]}"; do
    cmake --install "$build" --prefix "$stage" --strip --component "$component"
  done
  ln -sf llvm-ar "$stage/bin/llvm-ranlib"
  ln -sf llvm-readobj "$stage/bin/llvm-readelf"
  "$stage/bin/clang" --version
  "$stage/bin/llvm-config" --link-shared --libnames
  mkdir -p "$stage/share/licenses/llvm-project"
  for component in llvm clang; do
    cp "$dir/src/$component/LICENSE.TXT" "$stage/share/licenses/llvm-project/$component-LICENSE.TXT"
  done
  cp -r "$here/../toolchain-dist/licenses/"almalinux-* "$stage/share/licenses/"
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -cJf "$dir/llvm-bootstrap.tar.xz" -C "$stage" .
  echo "bootstrap_llvm $(sha256sum "$dir/llvm-bootstrap.tar.xz" | cut -d ' ' -f 1) $(stat -c %s "$dir/llvm-bootstrap.tar.xz") llvm-$version-bootstrap-manylinux_2_28-x86_64.tar.xz"
}

instr() {
  source_tree
  configure_engine "$dir/instr" "" -DLLVM_BUILD_INSTRUMENTED=IR -DLLVM_PROFILE_DATA_DIR="$dir/profiles"
  library "$dir/instr"
}

benchmark_script() {
  local source=${HIRSEL_LLVM_PROFILE_SOURCE:?set HIRSEL_LLVM_PROFILE_SOURCE to the guard checkout}
  [[ "$(git -C "$source" rev-parse HEAD)" == "$(lock_value engine_llvm_guard_source)" ]] \
    || fail "HIRSEL_LLVM_PROFILE_SOURCE must be at $(lock_value engine_llvm_guard_source)"
  realpath "$source/tools/native-toolchain/engine_llvm.py"
}

train() {
  [[ -f "$dir/instr/$library_path" ]] || fail "no instrumented library: run the instr stage"
  local benchmark
  benchmark=$(benchmark_script)
  # The arena opens more than Docker's default soft limit of 1024 descriptors.
  ulimit -Sn "$(ulimit -Hn)"
  rm -rf "$dir/profiles" && mkdir "$dir/profiles"
  LLVM_PROFILE_FILE="$dir/profiles/%m-%p.profraw" capped \
    python3 "$benchmark" train "$dir/instr/lib" "$dir/train" --artifacts "$artifacts"
  "$tool_bin/llvm-profdata" merge -o "$dir/llvm.profdata" "$dir"/profiles/*.profraw
}

configure_opt() {
  [[ -f "$dir/llvm.profdata" ]] || fail "no profile: run the train stage"
  source_tree
  configure_engine "$dir/opt" "-Wl,--thinlto-jobs=$jobs -Wl,--emit-relocs" \
    -DLLVM_ENABLE_PROJECTS=bolt -DBOLT_TARGETS_TO_BUILD=X86 \
    -DLLVM_ENABLE_LTO=Thin -DLLVM_PROFDATA_FILE="$dir/llvm.profdata" \
    -DLLVM_THINLTO_CACHE_PATH="$dir/opt/thinlto-cache"
}

opt() {
  configure_opt
  library "$dir/opt"
}

bolt-tools() {
  configure_opt
  local build="$dir/opt" stage="$dir/bolt-install"
  local archive="$dir/llvm-bolt-$version-manylinux_2_28-x86_64.tar.xz"
  # BOLT configures its runtime in a nested CMake project that inherits
  # compiler flags from the environment.
  CFLAGS="${CFLAGS:+$CFLAGS }--gcc-install-dir=$gcc_install" \
  CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }--gcc-install-dir=$gcc_install" \
  capped ninja -C "$build" -j "$jobs" llvm-bolt merge-fdata > "$dir/bolt-tools.ninja.log"
  rm -rf "$stage"
  mkdir -p "$stage/bin" "$stage/lib" "$stage/share/licenses/bolt"
  "$tool_bin/llvm-strip" --strip-debug -o "$stage/bin/llvm-bolt" "$build/bin/llvm-bolt"
  "$tool_bin/llvm-strip" --strip-debug -o "$stage/bin/merge-fdata" "$build/bin/merge-fdata"
  cp "$build/tools/bolt/bolt_rt-bins/lib/libbolt_rt_instr.a" "$stage/lib/"
  cp "$dir/src/bolt/LICENSE.TXT" "$stage/share/licenses/bolt/"
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -cJf "$archive" -C "$stage" .
  echo "bolt_tools $(sha256sum "$archive" | cut -d ' ' -f 1) $(stat -c %s "$archive") ${archive##*/}"
}

bolt() (
  local input="$dir/opt/$library_path"
  [[ -f "$input" ]] || fail "no profile-guided library: run the opt stage"
  local output
  output=$(mktemp -d "$dir/.bolt.XXXXXXXX")
  trap 'rm -rf "$output"' EXIT
  PATH="$dir/bolt-install/bin:$PATH" capped \
    python3 "$here/bolt.py" engine "$input" "$output/$soname" --artifacts "$artifacts"
  local library="$output/$soname"
  "$tool_bin/llvm-strip" --strip-debug "$library"
  [[ "$(readelf -d "$library" | awk '/\(SONAME\)/ { print $NF }')" == "[$soname]" ]] \
    || fail "the library's soname is not $soname"
  [[ "$(readelf -n "$library" | awk '/Build ID:/ { print $NF }')" =~ ^[0-9a-f]{40}$ ]] \
    || fail "the library has no SHA-1 build ID"
  local needed
  needed="$(readelf -d "$library" | awk '/\(NEEDED\)/ { print $NF }' | sort | tr '\n' ' ')"
  local name
  for name in $needed; do
    case "$name" in
      '[ld-linux-x86-64.so.2]'|'[libc.so.6]'|'[libgcc_s.so.1]'|'[libm.so.6]'|'[libstdc++.so.6]'|'[libz.so.1]'|'[libdl.so.2]'|'[libpthread.so.0]'|'[librt.so.1]') ;;
      *) fail "unexpected library dependency: $name" ;;
    esac
  done
  # No search path of its own: the loading executable's RPATH finds libz, never the
  # build tree's lib/ or, through an empty entry, the working directory.
  ! readelf -d "$library" | grep -qE '\((RPATH|RUNPATH)\)' || fail "the library carries a search path"
  mv "$library" "$dir/$soname"
)

guard() (
  [[ -f "$dir/$soname" ]] || fail "no engine library: run the bolt stage"
  local benchmark reference sha256 size asset package
  benchmark=$(benchmark_script)
  reference=$(mktemp -d "$dir/.guard-deb.XXXXXXXX")
  trap 'rm -rf "$reference"' EXIT
  read -r sha256 size asset <<< "$(lock_value engine_llvm_guard_deb)"
  package="$reference/$asset"
  curl -fsSL "$(lock_value asset_pool)/$asset" -o "$package"
  [[ "$(stat -c %s "$package")" == "$size" ]] || fail "the guard reference deb has the wrong size"
  printf '%s  %s\n' "$sha256" "$package" | sha256sum -c --status \
    || fail "the guard reference deb has the wrong SHA-256"
  dpkg-deb -x "$package" "$reference/root"
  ulimit -Sn "$(ulimit -Hn)"
  systemd-run --quiet --user --scope -p MemoryMax=2G -p MemorySwapMax=0 \
    python3 "$benchmark" guard "$reference/root/usr/lib/x86_64-linux-gnu" "$dir" "$dir/guard" \
    --artifacts "$artifacts" --previous-warm "$(lock_value engine_llvm_guard)" \
    || fail "the engine library fails its guard (see $dir/guard/guard.json)"
  echo "engine_llvm $(sha256sum "$dir/$soname" | cut -d ' ' -f 1) $(stat -c %s "$dir/$soname") libLLVM-$version-engine-bolt-manylinux_2_28-x86_64.so"
)

plain() {
  source_tree
  configure_engine "$dir/plain" ""
  library "$dir/plain"
}

case $3 in
  bootstrap | package | instr | train | opt | bolt-tools | bolt | guard | plain) "$3" ;;
  *) fail "unknown stage '$3'" ;;
esac

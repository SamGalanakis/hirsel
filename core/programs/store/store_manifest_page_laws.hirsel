// The caller holds LOCK. The export opener uses the reader and validator
// directly, so it never selects or removes files in the captured directory.
fn read_selected_page_manifest(d: Dir) -> Result[(StoreId, ValidatedPageManifest), Error] waits {
    let (id, take manifest) = read_page_manifest_file(d)?
    Ok((id, select_page_manifest(d, id, take manifest)?))
}

fn publish_page_manifest(d: Dir, id: StoreId, m: PageManifest, target: Option[TargetLimits], mut scratch: Bytes) -> Result[(), Error] waits {
    fill_page_manifest_file(mut scratch, id, m)?
    if let Some(wanted) = target {
        validate_new_page_manifest(d, id, scratch, wanted)?
    }
    publish_page_manifest_bytes(d, scratch)
}

// Independently encoded from AP3, AP14, AP20 and §13.1 using libxxhash.
// The 29-byte pack row has a zero index offset. Both live PAGEs start at byte 72.
fn page_manifest_vector() -> Bytes {
    let words: Inline[u64, 69] =[
        0x0000003800010001,
        0x45c5d41cbebe7f57,
        0x45524f5453524948,
        0x0000000100000009,
        0x0000000000000001,
        0x0000000000000002,
        0x0000000000000000,
        0x0000000000000001,
        0x0000000000000000,
        0x000001cf00010031,
        0xf14d2727324ffe74,
        0x0000000000000001,
        0x0000100000001000,
        0x0100004000000400,
        0x0000000000000003,
        0x0000000100000001,
        0x0000000000000003,
        0x0000000000000001,
        0x0000000000000001,
        0x000000000000004e,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000200000000,
        0x0000004800000000,
        0x0000004400000000,
        0xc222e9723fa736a5,
        0x0000000000000002,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000100000000,
        0x616d000400000000,
        0x0000000000006e69,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000010000,
        0x0000000000480000,
        0x33c6000000210000,
        0x0001222e8df641cc,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
    ]
    let mut raw: Bytes = list.with_capacity(552)
    for word in words {
        list.put_word_le(mut raw, word)
    }
    list.truncate(mut raw, 551)
    take raw
}


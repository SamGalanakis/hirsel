// rule: CT-5
// expect: reject LANG-7 at line 26
// twin: CT/CT-5-generic-instance-run.hir
// CT-5: a generator over the shape of a local generic type applied to the
// generated declaration's own parameters.
type Types[K, V] {
  key: Option[K],
  value: Option[V],
}

fn body[K: serializable, V: serializable](s: TypeShape[Types[K, V]]) -> Result[
  Body[fn(Types[K, V]) -> u64 uses {}],
  String
] uses {} {
  let name = type_shape.info(s).name
  Ok(codegen.body(f"fn(_t: {name}) -> u64 uses {{}} {{ 7 }}"))
}

fn compiled[K: serializable, V: serializable](types: Types[K, V]) -> u64 uses {} = comptime body(
  shape(Types[K, V])
)

pub fn main(rt: Io) -> Result[(), GrantError] {
  let out = io.stdout(rt)?
  let t: Types[u64, String] = Types(key: None(), value: None())
  let _ = out.print(out, f"{compiled(t)}\n")
  Ok(())
}

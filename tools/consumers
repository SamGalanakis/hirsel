#!/usr/bin/env python3
"""Select affected Buck2 targets, or classify a completed consumer event log.

Default stdout remains a target list for `buck2 test $(tools/consumers ...)`.
Selection reasons go to stderr; --reasons puts target/reason columns on stdout.
--classify LOG reads Buck's .pb.zst or decoded JSONL without running tests.
Exact known matches cite their selector, diagnostic, caps and existing evidence
on stderr; stdout retains only new/uncertain results. Classification is read-only.
"""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[1]
LIMIT = 100
BIG = {
    'hirsel-driver-test-it-stdlib': 'crates/hirsel-driver/tests/it-stdlib',
    'hirsel-driver-test-it': 'crates/hirsel-driver/tests/it',
    'hirsel-cli-test-cli': 'crates/hirsel-cli/tests/cli',
    'hirsel-cli-test-free': 'crates/hirsel-cli/tests/free.rs',
    'hirsel-cli-test-examples': 'crates/hirsel-cli/tests/examples.rs',
}
# These bodies launch native programs and verify replay, rather than merely
# checking their compilation. The inventory resolves their current shards.
MUST = {
    'hirsel-cli-test-cli': {'https::https_serves_a_verifying_client_and_replays_in_either_engine',
                           'replay::native_and_interpreted_recordings_replay_in_either_engine_and_executables'},
    'hirsel-cli-test-examples': {'grpc_greeter_serves_and_calls_itself_over_tcp',
                                'unix_http_serves_itself_over_a_real_socket_and_replays_across_cli_backends'},
}
PROOF_HOMES = {
    ('hirsel-driver-test-it', 'native_compilation_tasks_19::admitted_root_plans_bind_the_kit_before_codegen'):
        'root//tools/buck2/native-toolchain:root-frozen-kit-proof',
    ('hirsel-driver-test-it', 'native_compilation_tasks_19::frozen_root_plans_run_both_backends_without_live_linker_inputs'):
        'root//tools/buck2/native-toolchain:root-plan-proof',
}
RUNTIME = re.compile(r'(?:^|/)(?:startup[^/]*|scheduler[^/]*|pool[^/]*|cpu[^/]*|managed_cores|ordered|launch)(?:[./]|$)')
# Startup also lives in native entry emission and link-kit construction.
STARTUP_PREFIXES = (
    'crates/hirsel-rt/src/',
    'crates/hirsel-driver/src/native',
    'crates/hirsel-requests/src/',
    'crates/hirsel-native/src/',
    'crates/hirsel-native-queries/src/',
    'crates/hirsel-native-cache/src/',
    'crates/hirsel-native-batch/src/',
    'crates/hirsel-native-testing/src/',
    'crates/hirsel-host-io/src/',
    'crates/hirsel-llvm/src/',
    'crates/hirsel-cranelift/src/',
    'crates/hirsel-engine/src/queries/native_records',
    'tools/buck2/native-toolchain/link_kit',
)


def runtime_change(paths):
    return any(RUNTIME.search(path) or path.startswith(STARTUP_PREFIXES) for path in paths)


def buck(root, *args):
    result = subprocess.run([str(root / '.buck2/bin/buck2'), *args], cwd=root,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode:
        raise ValueError(result.stderr.strip() or result.stdout.strip())
    return result.stdout


def test_graph(root, seeds):
    selection = f'rdeps(//:, {" + ".join(seeds)})' if seeds else '//:'
    graph = json.loads(buck(root, 'uquery', selection,
                           '--output-attribute', '^test_binary$', '--output-attribute', '^shard',
                           '--output-attribute', '^costs$', '--output-attribute', '^extra_env$',
                           '--output-attribute', '^args$', '--output-attribute', '^exact_cpus$',
                           '--output-attribute', '^script$', '--output-attribute', '^harness$',
                           '--output-attribute', r'^buck\.deps$'))
    # A test's data edge can be affected while its executable is independent.
    # Resolve that executable explicitly; rdeps need not contain its node.
    missing = sorted({attrs['harness'] for attrs in graph.values()
                      if attrs.get('harness') and attrs['harness'] not in graph})
    if missing:
        graph.update(json.loads(buck(root, 'uquery', 'set(' + ' '.join(missing) + ')',
                                     '--output-attribute', '^script$')))
    return graph


def listings(root, graph):
    binaries = {attrs['test_binary']: attrs.get('args', []) for target, attrs in graph.items()
                if attrs.get('test_binary') in BIG and attrs.get('shard_index', 0) == 0
                and (attrs.get('shards', 0) > 0 or target == 'root//:' + attrs['test_binary'])}
    if not binaries:
        return {}
    print('consumers: discovering harness cases from shared-cache builds', file=sys.stderr)
    targets = ['root//:' + binary + '-harness' for binary in sorted(binaries)]
    outputs = json.loads(buck(root, 'build', *targets, '--show-json-output'))
    result = {}
    # --list needs neither SDK materialization nor the multi-GiB reservation
    # of a real test action. Build with Buck, then discover under the normal
    # local wrapper with one CPU. This executes no test bodies.
    env = dict(os.environ, HIRSEL_JOBS='1')
    env.setdefault('HIRSEL_MEMORY_LIMIT', '2G')
    for binary in sorted(binaries):
        harness = root / outputs['root//:' + binary + '-harness']
        listed = subprocess.run([str(root / 'tools/capped'), str(harness),
                                 *binaries[binary], '--list', '--format', 'terse'], cwd=root, env=env,
                                capture_output=True, text=True)
        if listed.returncode:
            raise ValueError(f'{binary}: case discovery failed: {listed.stderr.strip()}')
        result[binary] = {line.removesuffix(': test') for line in listed.stdout.splitlines()
                          if line.endswith(': test')}
        if not result[binary]:
            raise ValueError('no case listing for ' + binary)
    return result


def case_widths(root=ROOT):
    """EXACT_CASE_CPUS (tools/buck2/test_requirements.bzl): binary -> case -> CPUs."""
    def fail(message):
        raise ValueError(f'test_requirements.bzl: {message}')
    scope = {'fail': fail}
    exec((root / 'tools/buck2/test_requirements.bzl').read_text(), scope)
    return scope['EXACT_CASE_CPUS']


def assignments(root, graph, inventories, widths=None):
    """Match test_launcher.sh's longest-first greedy assignment, including mean
    costs. A binary with per-case widths deals each width group's cases over that
    group's shards (`exact_cpus`), and its undeclared cases over the measured ones."""
    result = {}
    widths = case_widths(root) if widths is None else widths
    for binary, cases in inventories.items():
        groups = {}
        for target, attrs in graph.items():
            if attrs.get('test_binary') == binary and attrs.get('shards', 0) > 0:
                groups.setdefault(attrs.get('exact_cpus', 0), {})[attrs.get('shard_index', 0)] = (target, attrs)
        if not groups:
            target = 'root//:' + binary
            if target in graph:
                result.update({(binary, case): target for case in cases})
            continue
        declared = widths.get(binary, {})
        for case in cases:
            if declared.get(case, 0) not in groups:
                raise ValueError(f'{binary}: {case} declares {declared[case]} CPUs but the graph has no '
                                 f'{binary}-cpus-{declared[case]} shards; run tools/buck2/sync.py')
        for width, targets in groups.items():
            deal(root, binary, [case for case in cases if declared.get(case, 0) == width], targets, result)
    for target, attrs in graph.items():
        case = attrs.get('extra_env', {}).get('HIRSEL_TEST_DEDICATED_CASE')
        if case and attrs.get('test_binary') in inventories:
            if case not in inventories[attrs['test_binary']]:
                raise ValueError(f'{target}: dedicated selector {case} is absent from the case listing')
            result[attrs['test_binary'], case] = target
    for key, target in PROOF_HOMES.items():
        if key[1] in inventories.get(key[0], set()):
            result[key] = target
    return result


def deal(root, binary, cases, targets, result):
    """One shard set's longest-first greedy assignment, as test_launcher.sh deals it."""
    _, attrs = targets[0]
    costs = {}
    if attrs.get('costs'):
        table = root / attrs['costs'].removeprefix('root//').replace(':', '/').lstrip('/')
        costs = {name: float(cost) for name, cost in
                 (line.split('\t') for line in table.read_text().splitlines())}
    total = 0.0
    for cost in costs.values():
        total += cost
    mean = total / len(costs) if costs else 1
    weights = {name: float(f'{costs.get(name, mean):.3f}') for name in cases}
    loads = [0.0] * attrs['shards']
    for name in sorted(cases, key=lambda name: (-weights[name], name)):
        shard = min(range(len(loads)), key=loads.__getitem__)
        loads[shard] += weights[name]
        result[binary, name] = targets[shard][0]


# Rust strings and comments may contain braces and fake function declarations.
# Keep offsets while masking them before extracting function extents.
RUST_LITERAL = re.compile(r'//[^\n]*|/\*.*?\*/|(?:b?r)(?P<hashes>\#*)".*?"(?P=hashes)|b?"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])\'', re.S)


class Sources:
    def __init__(self, root, path):
        self.root = root
        path = root / path
        files = sorted(path.rglob('*.rs')) if path.is_dir() else [path]
        support = (path if path.is_dir() else path.parent).parent / 'support'
        files = sorted(set(files) | set(support.rglob('*.rs')))
        self.files = {file: file.read_text() for file in files}
        self.functions = {}
        self.by_name = {}
        for file in files:
            source = file.read_text()
            masked = RUST_LITERAL.sub(lambda match: ' ' * len(match[0]), source)
            imports = '\n'.join(re.findall(r'(?m)^use [^;]+;', source))
            for match in re.finditer(r'\bfn\s+(\w+)\s*(?:<[^;{]*>)?\s*\(', masked):
                start = masked.find('{', match.end())
                if start < 0:
                    continue
                depth, end = 1, start + 1
                while depth and end < len(masked):
                    depth += (masked[end] == '{') - (masked[end] == '}')
                    end += 1
                key = file, match[1]
                body = imports + '\n' + source[match.start():end]
                if key in self.functions:
                    self.functions[key] += '\n' + body
                else:
                    self.functions[key] = body
                    self.by_name.setdefault(match[1], []).append(key)

    def matching(self, names, pattern):
        """Walk each helper graph using cached match facts, rather than copying
        the same fixture and helper source into every case's expanded text."""
        direct, calls, files = {}, {}, {}

        def references(origin, text):
            for literal in re.findall(r'"([^"\n]+\.(?:hir|json))"', text):
                for file in (origin.parent / literal, self.root / literal):
                    file = file.resolve()
                    if file.is_file() and file.is_relative_to(self.root):
                        yield file
                        break

        def file_matches(first):
            if first in files:
                return files[first]
            pending, seen = [first], set()
            while pending:
                file = pending.pop()
                if file in seen:
                    continue
                seen.add(file)
                if files.get(file):
                    files[first] = True
                    return True
                text = file.read_text()
                if pattern.search(file.relative_to(self.root).as_posix()) or pattern.search(text):
                    files[first] = True
                    return True
                pending.extend(references(file, text))
            files[first] = False
            return False

        def text_matches(file, text):
            return bool(pattern.search(file.relative_to(self.root).as_posix()) or pattern.search(text)
                        or any(file_matches(loaded) for loaded in references(file, text)))

        matched = set()
        for name in names:
            parts = name.split('::')
            candidates = self.by_name.get(parts[-1], [])
            matching = [key for key in candidates if len(parts) == 1 or parts[-2] in key[0].parts
                        or key[0].stem == parts[-2]]
            pending = list(matching or candidates)
            if not pending and len(parts) > 1:
                # Macro-generated cases share their declaring module's inputs.
                if any(text_matches(file, text) for file, text in self.files.items()
                       if file.stem == parts[-2]):
                    matched.add(name)
            seen = set()
            while pending:
                key = pending.pop()
                if key in seen:
                    continue
                seen.add(key)
                if key not in direct:
                    text = self.functions[key]
                    direct[key] = text_matches(key[0], text)
                    calls[key] = [] if direct[key] else [called_key
                                  for qualifier, called in re.findall(
                                      r'(?:(\w+)::)?\b(\w+)\s*\(', RUST_LITERAL.sub('', text))
                                  for called_key in self.by_name.get(called, [])
                                  if called_key[0] == key[0] or qualifier and called_key[0].stem == qualifier]
                if direct[key]:
                    matched.add(name)
                    break
                pending.extend(calls[key])
        return matched


def module_users(root, paths):
    modules = {file.stem: file for file in (root / 'stdlib/std@1').glob('*.hir')}
    affected = {Path(path).stem for path in paths if path.startswith('stdlib/std@1/')}
    if not affected:
        return affected
    dependencies = {name: set(re.findall(r'\b([a-z_]\w*)\.', file.read_text()))
                    for name, file in modules.items()}
    while True:
        users = {name for name, imports in dependencies.items() if imports & affected}
        if users <= affected:
            return affected
        affected |= users


def corpus_shard(path, count):
    # hirsel-cli-args/src/lib.rs Shard::holds: FNV-1a of the repository path.
    value = 0xcbf29ce484222325
    for byte in path.encode():
        value = ((value ^ byte) * 0x100000001b3) & ((1 << 64) - 1)
    return value % count + 1


def direct_owners(root, paths):
    expression = ' + '.join('owner(' + json.dumps(path) + ')' for path in paths)
    owners = json.loads(buck(root, 'uquery', expression, '--output-attribute', '^srcs$',
                             '--output-attribute', '^script$'))
    # owner() also includes runtime data. Only compilation/script inputs prove
    # direct ownership; shipping std or compiler sources as test data does not.
    direct = {}
    for target, attrs in owners.items():
        sources = {source.removeprefix('root//').lstrip('/') for source in attrs.get('srcs', [])}
        sources.add(attrs.get('script', '').removeprefix('root//').lstrip('/'))
        owned = set(paths) & sources
        if owned:
            direct[target] = ('direct source owner' if any('/tests/' not in path for path in owned)
                              else 'direct test owner')
    return direct


def distances(graph, owners):
    """Each target's dependency distance from the nearest changed-source owner
    (Buck's declared edges within the reverse graph); absent when unreached."""
    users = {}
    for target, attrs in graph.items():
        for dependency in attrs.get('buck.deps', []):
            users.setdefault(dependency, []).append(target)
    distance = {owner: 0 for owner in owners}
    frontier = list(owners)
    while frontier:
        following = []
        for node in frontier:
            for user in users.get(node, []):
                if user not in distance:
                    distance[user] = distance[node] + 1
                    following.append(user)
        frontier = following
    return distance


def select(root, paths, graph, inventories, owners=None, reasons=None, limit=LIMIT, cut=None):
    """Affected targets, nearest owner first; the first `limit` (0: all) are kept.
    `cut` receives the targets past the limit."""
    sys.path.insert(0, str(root / 'tools/buck2'))
    from sync import CONFORMANCE_SHARDS, CONSUMER_CASES
    mapped = assignments(root, graph, inventories)
    replay_cells = {target for target, attrs in graph.items()
                    if 'HIRSEL_REPLAY_CELL' in attrs.get('extra_env', {})}

    def homes(binary, case):
        if binary == 'hirsel-cli-test-cli' and case in {
                'ordered_deadline_liveness_55::cell', 'ordered_deadline_liveness_55::fixture'}:
            if not replay_cells:
                raise ValueError('deadline replay consumers require their configured matrix targets')
            return replay_cells
        return {mapped[binary, case]}

    mandatory, ordinary, shards = set(), set(), set()
    runtime = runtime_change(paths)
    tooling = all(path.startswith('tools/') for path in paths)
    scripts = {target: attrs['harness'] for target, attrs in graph.items()
               if graph.get(attrs.get('harness'), {}).get('script')}
    crates = {Path(path).parts[1].replace('-', '_') for path in paths if path.startswith('crates/')}
    modules = module_users(root, paths)
    loaded_crates = crates | {target.split(':')[-1].replace('-', '_') for target in graph
                             if crates and (root / 'crates' / target.split(':')[-1] / 'Cargo.toml').is_file()}
    if runtime:
        required = MUST | {'hirsel-cli-test-free': {'native_returned_rest_completion_replays_across_engines'}}
        for binary, cases in required.items():
            if missing := cases - inventories.get(binary, set()):
                raise ValueError(f'{binary}: required launch selectors missing from listing: {sorted(missing)}')
    for binary, cases in CONSUMER_CASES.items():
        if runtime:
            mandatory |= {f'root//:{binary}-consumer-{suffix}' for suffix in cases}
    for target, attrs in graph.items():
        binary = attrs.get('test_binary', '')
        if tooling and target in scripts:
            ordinary.add(target)
        elif runtime and binary.startswith('hirsel-cli-test-cpu_pool_'):
            mandatory.add(target)
        elif crates and binary and binary not in BIG:
            ordinary.add(target)
    expressions = ([re.escape(crate) for crate in loaded_crates]
                   + [re.escape(path) for path in paths]
                   + [r'\b' + re.escape(module) + r'\.' for module in modules])
    pattern = re.compile('|'.join(expressions))
    direct_cases = set()
    test_paths = [path for path in paths if '/tests/' in path]
    test_pattern = re.compile('|'.join(map(re.escape, test_paths))) if test_paths else None
    for binary, names in inventories.items():
        sources = Sources(root, BIG[binary])
        affected = sources.matching(names, pattern)
        if test_pattern:
            direct_cases |= {mapped[binary, name] for name in sources.matching(names, test_pattern)}
        for name in names:
            if runtime and (name in MUST.get(binary, set()) or
                            binary == 'hirsel-cli-test-free' and name == 'native_returned_rest_completion_replays_across_engines'):
                mandatory |= homes(binary, name)
            if name in affected or runtime and re.search(r'pool|ordered|scheduler|cpu|tasks', name):
                shards |= homes(binary, name)
    # Resolve std uses in corpus source, including uses through another std module.
    conformance = sorted((root / 'conformance').rglob('*.hir')) if modules else []
    chosen = {path for path in paths if path.startswith('conformance/') and path.endswith('.hir')}
    for file in conformance:
        if any(re.search(r'\b' + re.escape(module) + r'\.', file.read_text()) for module in modules):
            chosen.add(file.relative_to(root).as_posix())
    ordinary |= {f'root//:gate-conformance-shard-{corpus_shard(path, CONFORMANCE_SHARDS)}' for path in chosen}
    # Ownership is established by Buck's source graph, never by test status.
    direct = {}
    for target, attrs in graph.items():
        binary = attrs.get('test_binary', '')
        if binary in BIG:
            if target in direct_cases:
                direct[target] = 'direct test owner'
        elif owners and (binary or target in scripts):
            harness = scripts.get(target, 'root//:' + binary + '-harness')
            if target not in owners and harness not in owners:
                continue
            owner = target if target in owners else harness
            direct[target] = (owners[owner] if isinstance(owners, dict) else
                              'direct test owner' if test_paths else 'direct source owner')
    limit = limit or len(graph) + len(ordinary | shards | mandatory | direct.keys())
    if len(mandatory) > limit:
        raise ValueError(f'{len(mandatory)} mandatory targets exceed the {limit}-target ceiling')
    distance = distances(graph, owners or {})

    # Harnesses declare their crate dependencies flat, so most tests sit two
    # edges from a changed library: the changed crate's own tests come first.
    own = tuple(owner + '-' for owner in owners or {})

    def near(target):
        steps = distance.get(target, distance.get(graph.get(target, {}).get('harness'), len(graph)))
        return steps - 1 if target.startswith(own) and steps < len(graph) else steps
    # Reserve the mandatory set before spending the remaining bound. Direct
    # owners precede broad shards; each transitive binary still gets a turn.
    # Give each affected binary a turn before spending the bound on a large
    # unit-test family. Full conformance shards precede optional harness shards.
    groups = {}
    for target in ordinary | shards:
        if target not in mandatory and target not in direct:
            family = graph.get(target, {}).get('test_binary', 'conformance')
            groups.setdefault(family, []).append(target)
    for targets in groups.values():
        targets.sort(key=lambda target: re.sub(r'\d+', lambda m: m[0].zfill(8), target))
    # Nearest owner first: direct owners by distance, then each round of the
    # families, the family nearest the change first.
    owned = sorted(direct, key=lambda target: (near(target), target))
    selected = owned + sorted(mandatory - direct.keys())
    order = sorted(groups, key=lambda family: (min(map(near, groups[family])), family))
    while any(groups.values()):
        for family in order:
            if groups[family]:
                selected.append(groups[family].pop(0))
    # Keep the mandatory reservation even when direct ownership itself is broad.
    retained = set([target for target in owned if target not in mandatory][:limit - len(mandatory)]) | mandatory
    for target in selected:
        if len(retained) < limit:
            retained.add(target)
    if reasons is not None:
        reasons.update({target: direct.get(target, 'mandatory set' if target in mandatory else 'transitive shard')
                        + (f' (distance {near(target)})' if near(target) < len(graph) else '')
                        for target in selected})
    if cut is not None:
        cut.extend(target for target in selected if target not in retained)
    return [target for target in selected if target in retained]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('paths', nargs='*')
    parser.add_argument('--reasons', action='store_true', help='print target/reason columns on stdout')
    parser.add_argument('--classify', metavar='LOG', nargs='+', help='classify completed Buck event logs')
    parser.add_argument('--known-failures', type=Path, default=ROOT / 'tools/known-failures.tsv')
    parser.add_argument('--limit', type=int, default=LIMIT,
                        help=f'keep the nearest N affected targets (default {LIMIT}; 0 keeps all)')
    args = parser.parse_args()
    try:
        if args.classify:
            if args.paths or args.reasons:
                raise ValueError('--classify cannot be combined with paths or --reasons')
            sys.path.insert(0, str(ROOT / 'tools/buck2'))
            from consumer_results import report
            return report(args.classify, args.known_failures)
        if not args.paths:
            raise ValueError('supply changed paths or --classify LOG')
        paths = []
        seeds = set()
        for argument in args.paths:
            path = (Path.cwd() / argument).resolve()
            if not path.is_file() or not path.is_relative_to(ROOT):
                raise ValueError(f'expected a repository file: {argument}')
            paths.append(path.relative_to(ROOT).as_posix())
            if paths[-1].startswith('tools/'):
                seeds.add('owner(' + json.dumps(paths[-1]) + ')')
            if paths[-1].startswith('crates/'):
                package = tomllib.loads((ROOT / 'crates' / path.relative_to(ROOT).parts[1] / 'Cargo.toml').read_text())
                seeds.add('owner(' + json.dumps(paths[-1]) + ')')
                if (ROOT / 'crates' / path.relative_to(ROOT).parts[1] / 'src/lib.rs').is_file():
                    seeds.add('set(//:' + package['package']['name'] + ')')
        if runtime_change(paths):
            seeds.add('set(//:hirsel-rt)')
        sys.path.insert(0, str(ROOT / 'tools/buck2'))
        import generated
        if not (ROOT / '.buck2/bin/buck2').is_file():
            prepared = subprocess.run([sys.executable, str(ROOT / 'tools/buck2/prepare.py')],
                                      cwd=ROOT, stdout=sys.stderr)
            if prepared.returncode:
                raise ValueError('Buck2 preparation failed')
        generated.require(ROOT)
        graph = test_graph(ROOT, sorted(seeds))
        inventories = listings(ROOT, graph)
        reasons, cut = {}, []
        selected = select(ROOT, paths, graph, inventories, direct_owners(ROOT, paths), reasons, args.limit, cut)
        if not selected:
            raise ValueError('no consumers found for ' + ', '.join(paths))
        for target in selected:
            label = target.removeprefix('root')
            if args.reasons:
                print(f'{label}\t{reasons[target]}')
            else:
                print(label)
                print(f'{label}\t{reasons[target]}', file=sys.stderr)
        if cut:
            # Name what the cap dropped: every cut owner, and each cut family.
            print(f'consumers: CAPPED: kept the nearest {len(selected)} of {len(selected) + len(cut)} affected '
                  f'targets (--limit {args.limit}; --limit 0 keeps all); cut:', file=sys.stderr)
            families = {}
            for target in cut:
                if 'owner' in reasons[target]:
                    print(f'consumers:   cut {target.removeprefix("root")}\t{reasons[target]}', file=sys.stderr)
                else:
                    family = re.sub(r'(?:-cpus-\d+)?-shard-\d+$', '', target.removeprefix('root'))
                    families.setdefault(family, []).append(reasons[target])
            for family, why in families.items():
                print(f'consumers:   cut {len(why)} of {family}\t{why[0]}', file=sys.stderr)
        return 0
    except (ValueError, OSError, KeyError) as error:
        print(f'consumers: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())

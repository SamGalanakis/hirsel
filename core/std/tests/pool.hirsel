// Contract tests for `pool` (core/std/pool.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names.
fn handle(r: Result[pool.Id[u64], (Capacity, u64)]) -> pool.Id[u64] {
    match r {
        Ok(h) => h,
        Error(_) => fail("pool test: insert refused"),
    }
}

/// 0 for Ok, 1 for WrongPool, 2 for Removed.
fn stale(r: Result[View[u64], pool.Stale]) -> u64 {
    match r {
        Ok(_) => 0,
        Error(WrongPool) => 1,
        Error(Removed) => 2,
    }
}

// expect: run insert_and_get() = 1020
fn insert_and_get() -> u64 {
    let mut p: pool.Pool[u64] = pool.new()
    let a = handle(pool.insert(mut p, 10))
    let b = handle(pool.insert(mut p, 20))
    pool.get_or(p, a, 0) * 100 + pool.get_or(p, b, 0)
}

// expect: run len_counts_live() = 1
fn len_counts_live() -> u64 {
    let mut p: pool.Pool[u64] = pool.new()
    let a = handle(pool.insert(mut p, 10))
    let _ = handle(pool.insert(mut p, 20))
    let _ = pool.remove(mut p, a)
    pool.len(p)
}

// expect: run remove_returns_value() = 10
fn remove_returns_value() -> u64 {
    let mut p: pool.Pool[u64] = pool.new()
    let a = handle(pool.insert(mut p, 10))
    result.unwrap(pool.remove(mut p, a))
}

// A removed Id is Removed, for get, contains and a second remove.
// expect: run removed_is_stale() = true
fn removed_is_stale() -> bool {
    let mut p: pool.Pool[u64] = pool.new()
    let a = handle(pool.insert(mut p, 10))
    let _ = pool.remove(mut p, a)
    let again = match pool.remove(mut p, a) {
        Ok(_) => false,
        Error(Removed) => true,
        Error(WrongPool) => false,
    }
    stale(pool.get(p, a)) == 2 && !pool.contains(p, a) && again
}

// A reused slot has a new generation: the old Id stays stale and differs from the new one.
// expect: run reuse_keeps_old_stale() = true
fn reuse_keeps_old_stale() -> bool {
    let mut p: pool.Pool[u64] = pool.new()
    let a = handle(pool.insert(mut p, 10))
    let _ = pool.remove(mut p, a)
    let c = handle(pool.insert(mut p, 30))
    pool.get_or(p, a, 0) == 0 && pool.get_or(p, c, 0) == 30 && a != c
}

// expect: run other_pool_is_wrong() = 1
fn other_pool_is_wrong() -> u64 {
    let mut p: pool.Pool[u64] = pool.new()
    let mut q: pool.Pool[u64] = pool.new()
    let _ = handle(pool.insert(mut p, 1))
    let h = handle(pool.insert(mut q, 1))
    stale(pool.get(p, h))
}

// expect: run update_in_place() = 2121
fn update_in_place() -> u64 {
    let mut p: pool.Pool[u64] = pool.new()
    let b = handle(pool.insert(mut p, 20))
    let r = result.unwrap(pool.update(mut p, b, fn(mut x: u64) -> u64 {
        x += 1
        x
    }))
    r * 100 + pool.get_or(p, b, 0)
}

// expect: run update_stale() = true
fn update_stale() -> bool {
    let mut p: pool.Pool[u64] = pool.new()
    let b = handle(pool.insert(mut p, 20))
    let _ = pool.remove(mut p, b)
    match pool.update(mut p, b, fn(mut x: u64) -> u64 {
        x
    }) {
        Ok(_) => false,
        Error(Removed) => true,
        Error(WrongPool) => false,
    }
}

// A failure inside f propagates out of update (the slot is left vacant at a new generation).
// expect: run update_failure_retires() = fail Overflow
fn update_failure_retires() -> u64 {
    let mut p: pool.Pool[u64] = pool.new()
    let b = handle(pool.insert(mut p, 18446744073709551615))
    let r = pool.update(mut p, b, fn(mut x: u64) -> u64 {
        x += 1
        x
    })
    let _ = r
    0
}

// expect: run with_capacity_is_empty() = 0
fn with_capacity_is_empty() -> u64 {
    let p: pool.Pool[u64] = result.unwrap(pool.with_capacity(4))
    pool.len(p)
}

// Clear must advance generations, including a slot reused before the clear. A mutant
// that truncates the slots and restarts at generation zero resurrects a and b.
// expect: run clear_invalidates_every_handle() = true
fn clear_invalidates_every_handle() -> bool {
    let mut p: pool.Pool[u64] = pool.new()
    let a = handle(pool.insert(mut p, 10))
    let b = handle(pool.insert(mut p, 20))
    let _ = pool.remove(mut p, a)
    let c = handle(pool.insert(mut p, 30))
    pool.clear(mut p)
    let empty = pool.len(p) == 0
    pool.clear(mut p)
    let d = handle(pool.insert(mut p, 40))
    empty && pool.len(p) == 1 && !pool.contains(p, a) && !pool.contains(p, b) && !pool.contains(p, c) && pool.get_or(p, d, 0) == 40
}

// Insertion order 10,20,30 then replace slot 0 by 40: slot order is 40,30.
// A dense swap-remove iterator or insertion-order iterator returns another number.
// expect: run iteration_is_slot_order() = 4030
fn iteration_is_slot_order() -> u64 {
    let mut p: pool.Pool[u64] = pool.new()
    let a = handle(pool.insert(mut p, 10))
    let b = handle(pool.insert(mut p, 20))
    let _ = handle(pool.insert(mut p, 30))
    let _ = pool.remove(mut p, a)
    let _ = handle(pool.insert(mut p, 40))
    let _ = pool.remove(mut p, b)
    let mut at: u64 = 0
    let mut answer: u64 = 0
    loop {
        match pool.next(p, at) {
            Some((h, v, cursor)) => {
                if pool.get_or(p, h, 0) != v {
                    return 999
                }
                answer = answer * 100 + v
                at = cursor
            }
            None => break,
        }
    }
    answer
}

// expect: run iteration_empty_and_past_end() = true
fn iteration_empty_and_past_end() -> bool {
    let mut p: pool.Pool[u64] = pool.new()
    let empty = match pool.next(p, 0) {
        None => true,
        _ => false
    }
    let _ = handle(pool.insert(mut p, 7))
    let past = match pool.next(p, 18446744073709551615) {
        None => true,
        _ => false
    }
    pool.clear(mut p)
    empty && past && match pool.next(p, 0) {
        None => true,
        _ => false
    }
}

// Admission refusal returns the taken owner and leaves the pool empty.
// expect: run capacity_returns_value() = true
fn capacity_returns_value() -> bool {
    let mut p: pool.Pool[String] = pool.new()
    let x = result.unwrap(string.from("kept"))
    let attempt = result.unwrap(bound bytes 0 {
        pool.insert(mut p, take x)
    })
    match attempt {
        Error((c, take back)) => c.requested > 0 && c.available == 0 && back == "kept" && pool.len(p) == 0,
        Ok(_) => false,
    }
}

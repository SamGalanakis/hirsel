// UTF-8 scalars and CRLF may split at any byte. RFC 3629 excludes overlongs,
// surrogates and scalars above U+10FFFF. Mutants: rescan_from_zero,
// restart_cursor_loses_field.
// expect: run resume_utf8() = true
fn resume_utf8() -> bool {
    resume_parity(result.unwrap(b"GET /\xc2\xa2\xe2\x82\xac\xf0\x90\x80\x80 HTTP/1.1\r\nA: x\r\nB: y\r\n\r\nTAIL"), Some(39)) && resume_parity(result.unwrap(b"GET /\xe0\x80 HTTP/1.1\r\n\r\n"), None) && resume_parity(result.unwrap(b"GET /\xed\xa0 HTTP/1.1\r\n\r\n"), None) && resume_parity(result.unwrap(b"GET /\xf4\x90 HTTP/1.1\r\n\r\n"), None) && resume_parity(result.unwrap(b"GET /\xe2\x82"), None)
}

// HTTP-3 fixed bounds: exactly 8192 bytes succeeds; needing byte 8193 fails.
// Terminal results preserve the head and do no more work.
// expect: run resume_limits() = true
fn resume_limits() -> bool {
    let mut raw = result.unwrap(b"GET / HTTP/1.1\r\nX:")
    while list.len(raw) < 8188 {
        result.unwrap(list.push(mut raw, b'a'))
    }
    result.unwrap(list.append(mut raw, result.unwrap(b"\r\n\r\n")))
    let mut h = http1.head()
    let mut cur = http1.cursor()
    if http1.resume(list.slice(raw, 0, 8191), mut h, mut cur) != Partial || http1.resume(raw, mut h, mut cur) != Complete || h.end != 8192 || cur.examined != 8192 || cur.line_end != 16 {
        return false
    }
    let before = h
    if http1.resume(raw, mut h, mut cur) != Complete || !same_head(h, before) || cur.examined != 8192 {
        return false
    }
    raw[8190] = b'a'
    raw[8191] = b'a'
    h = http1.head()
    cur = http1.cursor()
    http1.resume(raw, mut h, mut cur) == TooLarge && cur.examined == 8192 && http1.request(raw, mut h) == TooLarge
}

// HTTP-3 counts initialized fields, including empty values and duplicates.
// expect: run resume_field_limit() = true
fn resume_field_limit() -> bool {
    let mut raw = result.unwrap(b"GET / HTTP/1.1\r\n")
    for i in 0u64 .. 64u64 {
        result.unwrap(list.append(mut raw, result.unwrap(b"X:\r\n")))
    }
    result.unwrap(list.append(mut raw, result.unwrap(b"\r\n")))
    if !resume_parity(raw, Some(list.len(raw))) {
        return false
    }
    let mut h = http1.head()
    if http1.request(raw, mut h) != Complete || h.count != 64 {
        return false
    }
    raw[list.len(raw) - 2] = b'X'
    http1.request(raw, mut h) == TooLarge && resume_parity(raw, None)
}

// A request-line overflow maps to 414 rather than the field limit's 431.
// expect: run resume_request_line_limit() = true
fn resume_request_line_limit() -> bool {
    let mut raw = result.unwrap(b"GET /")
    while list.len(raw) < 8192 {
        result.unwrap(list.push(mut raw, b'a'))
    }
    let mut h = http1.head()
    let mut cur = http1.cursor()
    http1.resume(raw, mut h, mut cur) == TooLarge && cur.line_end == 0 && cur.examined == 8192 && http1.request(raw, mut h) == TooLarge
}

// HTTP-3's 414 applies only when the request line alone overflows. A prefix
// of empty lines consumes head space, never request-line space.
// expect: run resume_prefixed_limit() = true
fn resume_prefixed_limit() -> bool {
    let mut raw = result.unwrap(b"\r\n")
    while list.len(raw) < 8192 {
        result.unwrap(list.push(mut raw, b'a'))
    }
    let mut h = http1.head()
    let mut cur = http1.cursor()
    if http1.resume(raw, mut h, mut cur) != TooLarge || cur.line_start != 2 || cur.line_end != 0 || cur.examined != 8192 {
        return false
    }
    for i in 0u64 .. 8192u64 {
        raw[i] = 10
    }
    h = http1.head()
    cur = http1.cursor()
    http1.resume(raw, mut h, mut cur) == TooLarge && cur.line_start == 8192 && cur.line_end == 0 && cur.examined == 8192
}

// The request head ends at byte 27. The body is already in the buffer on
// some splits and does not change when the head first becomes complete.
// expect: run resume_exact_prefix_progress() = true
fn resume_exact_prefix_progress() -> bool {
    let raw = result.unwrap(b"GET / HTTP/1.1\r\nHost: x\r\n\r\nbody")
    let mut names: List[Bytes] = list.new()
    result.unwrap(list.push(mut names, result.unwrap(b"Host")))
    let mut values: List[Bytes] = list.new()
    result.unwrap(list.push(mut values, result.unwrap(b"x")))
    request_case(raw, Complete, 27, Some(result.unwrap(b"GET")), Some(result.unwrap(b"/")), Some(1), names, values)
}

// Syntax follows regex-syntax at fde4946. Scratch belongs to the caller's
// byte limit. The AST and HIR use one 64-byte node per source token.
pub type SyntaxKind: key = CaptureLimitExceeded | ClassEscapeInvalid | ClassRangeInvalid | ClassRangeLiteral | ClassUnclosed | DecimalEmpty | DecimalInvalid | EscapeHexEmpty | EscapeHexInvalid | EscapeHexInvalidDigit | EscapeUnexpectedEof | EscapeUnrecognized | FlagDanglingNegation | FlagDuplicate | FlagRepeatedNegation | FlagUnexpectedEof | FlagUnrecognized | GroupNameDuplicate | GroupNameEmpty | GroupNameInvalid | GroupNameUnexpectedEof | GroupUnclosed | GroupUnopened | NestLimitExceeded | RepetitionCountInvalid | RepetitionCountDecimalEmpty | RepetitionCountUnclosed | RepetitionMissing | SpecialWordBoundaryUnclosed | SpecialWordBoundaryUnrecognized | SpecialWordOrRepetitionUnexpectedEof | UnicodeClassInvalid | UnsupportedBackreference | UnsupportedLookAround | UnicodeNotAllowed | InvalidUtf8 | UnicodePropertyNotFound | UnicodePropertyValueNotFound

pub type SyntaxError: key {
    at: u64,
    kind: SyntaxKind
}

pub type Error = Syntax(SyntaxError) | TooBig(u64) | Capacity(Capacity)

const ROOT: u64 = 0

const ARM: u64 = 1

const CAPTURE: u64 = 2

const SCOPED: u64 = 3

const FLAGS: u64 = 4

const REPEAT: u64 = 5

const LITERAL: u64 = 6

const FIXED_BYTE: u64 = 7

const DOT: u64 = 8

const ASSERT: u64 = 9

const PERL: u64 = 10

const PROPERTY: u64 = 11

const CLASS: u64 = 12

const SEGMENT: u64 = 13

const RANGE: u64 = 14

const ASCII: u64 = 15

const INSENSITIVE: u64 = 1

const MULTILINE: u64 = 2

const DOT_ALL: u64 = 4

const SWAP_GREED: u64 = 8

const UNICODE: u64 = 16

const CRLF: u64 = 32

const FREE_SPACE: u64 = 64

const FLAG_BITS: u64 = 127

const UNBOUNDED: u64 = 4294967296

// first/successor link the contents of one arm; more links arms of a group or
// the operands of a bracket class. While parsing, b links back to the open
// enclosing arm. An open capture keeps its name offset in successor. Closing
// the capture moves that offset to b and frees successor for the next atom.
// For a repetition, first links to the preceding atom.
type Node: key {
    kind: u64,
    at: u64,
    end: u64,
    first: u64,
    successor: u64,
    a: u64,
    b: u64,
    more: u64
}

type Parser {
    ast: List[Node],
    names: List[u32],
    at: u64,
    width: u64,
    captures: u64,
    free_space: bool,
    scope: u64,
    arm: u64,
    tail: u64
}

fn node(kind: u64, at: u64, end: u64, a: u64, b: u64) -> Node {
    Node(kind: kind, at: at, end: end, first: 0, successor: 0, a: a, b: b, more: 0)
}

fn syntax(at: u64, kind: SyntaxKind) -> Error {
    Syntax(SyntaxError(at: at, kind: kind))
}

fn read(xs: List[Node], i: u64) -> Node {
    xs[i]
}

fn write(mut xs: List[Node], i: u64, n: Node) {
    xs[i] = n
}

fn insert(mut xs: List[Node], n: Node) -> Result[u64, Error] {
    let i = list.len(xs)
    match list.push(mut xs, n) {
        Ok(()) => Ok(i),
        Error((e, _)) => Error(Capacity(e)),
    }
}

fn append(mut p: Parser, n: Node) -> Result[u64, Error] {
    let i = insert(mut p.ast, n)?
    if p.tail == 0 {
        p.ast[p.arm].first = i
    } else {
        p.ast[p.tail].successor = i
    }
    p.tail = i
    Ok(i)
}

fn byte(s: String, at: u64) -> u8 {
    string.as_bytes(s)[at]
}

fn starts(s: String, at: u64, text: String) -> bool {
    let n = string.byte_len(text)
    if n > string.byte_len(s) - at {
        return false
    }
    let mut i: u64 = 0
    while i < n {
        if byte(s, at + i) != byte(text, i) {
            return false
        }
        i += 1
    }
    true
}

fn scalar(s: String, at: u64) -> (u64, u64) {
    match string.next_scalar(s, at) {
        Some((c, successor)) => (int.widen(char.to_u32(c)), successor),
        None => (0, at),
    }
}

fn is_space(c: u64) -> bool {
    (c >= 9 && c <= 13) || c == 32 || c == 0x85 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000
}

fn advance_space(s: String, at: u64, enabled: bool) -> u64 {
    let mut successor = at
    if enabled {
        while successor < string.byte_len(s) {
            let (c, end) = scalar(s, successor)
            if is_space(c) {
                successor = end
            } else if c == 35 {
                successor = end
                while successor < string.byte_len(s) && byte(s, successor) != b'\n' {
                    successor += 1
                }
            } else {
                break
            }
        }
    }
    successor
}

fn skip(s: String, mut p: Parser) {
    p.at = advance_space(s, p.at, p.free_space)
}

fn ast(s: String) -> Result[Parser, Error] {
    let width = string.byte_len(s)
    let alloc: Result[List[Node], Capacity] = list.with_capacity(width + 1)
    let arena = match take alloc {
        Ok(take xs) => take xs,
        Error(e) => return Error(Capacity(e)),
    }
    let mut p = Parser(ast: take arena, names: list.new(), at: 0, width: width, captures: 0, free_space: false, scope: 0, arm: 0, tail: 0)
    let _ = insert(mut p.ast, node(ROOT, 0, 0, 0, 0))?
    loop {
        skip(s, mut p)
        if p.at == width {
            if p.scope != 0 {
                return Error(syntax(read(p.ast, p.scope).at, GroupUnclosed))
            }
            break
        }
        match byte(s, p.at) {
            b'(' => {
                open_group(s, mut p)?
            },
            b')' => {
                close_group(mut p)?
            },
            b'|' => {
                p.at += 1
                let arm = insert(mut p.ast, node(ARM, p.at, p.at, p.scope, 0))?
                p.ast[p.arm].more = arm
                p.arm = arm
                p.tail = 0
            },
            b'?' => {
                repetition(s, mut p)?
            },
            b'*' => {
                repetition(s, mut p)?
            },
            b'+' => {
                repetition(s, mut p)?
            },
            b'{' => {
                repetition(s, mut p)?
            },
            b'[' => {
                bracket(s, mut p)?
            },
            _ => {
                let atom = primitive(s, mut p, false)?
                let _ = append(mut p, atom)?
            },
        }
    }
    Ok(take p)
}

fn open_group(s: String, mut p: Parser) -> Result[(), Error] {
    let start = p.at
    p.at += 1
    skip(s, mut p)
    let inner = p.at
    if starts(s, inner, "?=") || starts(s, inner, "?!") || starts(s, inner, "?<=") || starts(s, inner, "?<!") {
        return Error(syntax(start, UnsupportedLookAround))
    }
    let mut kind = CAPTURE
    let mut data: u64 = 0
    let mut name_start: u64 = 0
    if starts(s, inner, "?P<") || starts(s, inner, "?<") {
        p.at += if starts(s, inner, "?P<") {
            3
        } else {
            2
        }
        data = capture_index(mut p, start)?
        name_start = p.at
        capture_name(s, mut p)?
    } else if starts(s, inner, "?") {
        p.at += 1
        if p.at == p.width {
            return Error(syntax(start, GroupUnclosed))
        }
        data = flags(s, mut p)?
        let close = byte(s, p.at) == b')'
        p.at += 1
        if close {
            if data == 0 {
                return Error(syntax(inner, RepetitionMissing))
            }
            let flags_node = node(FLAGS, start, p.at, data, 0)
            let _ = append(mut p, flags_node)?
            p.free_space = spacing(p.free_space, data)
            return Ok(())
        }
        kind = SCOPED
    } else {
        data = capture_index(mut p, start)?
    }
    let saved = 2 * p.arm + if p.free_space {
        1
    } else {
        0
    }
    let mut opener = node(kind, start, p.at, data, saved)
    opener.successor = name_start
    let opened = append(mut p, opener)?
    if kind == SCOPED {
        p.free_space = spacing(p.free_space, data)
    }
    p.scope = opened
    p.arm = opened
    p.tail = 0
    Ok(())
}

fn close_group(mut p: Parser) -> Result[(), Error] {
    if p.scope == 0 {
        return Error(syntax(p.at, GroupUnopened))
    }
    let opened = p.scope
    let mut opener = read(p.ast, opened)
    let saved = opener.b
    if opener.kind == CAPTURE {
        opener.b = opener.successor
        opener.successor = 0
        write(mut p.ast, opened, opener)
    }
    p.free_space = (saved & 1) != 0
    p.arm = saved / 2
    let parent = read(p.ast, p.arm)
    p.scope = if parent.kind == ARM {
        parent.a
    } else {
        p.arm
    }
    p.tail = opened
    p.at += 1
    Ok(())
}

fn capture_index(mut p: Parser, at: u64) -> Result[u64, Error] {
    if p.captures == 4294967295 {
        return Error(syntax(at, CaptureLimitExceeded))
    }
    p.captures += 1
    Ok(p.captures)
}

fn capture_name(s: String, mut p: Parser) -> Result[(), Error] {
    let start = p.at
    while p.at < p.width && byte(s, p.at) != b'>' {
        let (c, successor) = scalar(s, p.at)
        if !capture_char(c, p.at == start) {
            return Error(syntax(p.at, GroupNameInvalid))
        }
        p.at = successor
    }
    if p.at == p.width {
        return Error(syntax(p.at, GroupNameUnexpectedEof))
    }
    if p.at == start {
        return Error(syntax(start, GroupNameEmpty))
    }
    let end = p.at
    let width = end - start
    let mut i: u64 = 0
    while i < list.len(p.names) {
        let low: u64 = int.widen(p.names[i])
        let high: u64 = int.widen(p.names[i + 1])
        let prior = (high << 32) | low
        if width < p.width - prior && byte(s, prior + width) == b'>' && string.slice(s, prior, prior + width) == string.slice(s, start, end) {
            return Error(syntax(start, GroupNameDuplicate))
        }
        i += 2
    }
    // A parsed name ends at the first '>'. Store its start in two words
    // so positions stay exact for any String length.
    push_u32(mut p.names, int.narrow(start & 0xFFFFFFFF))?
    push_u32(mut p.names, int.narrow(start >> 32))?
    p.at += 1
    Ok(())
}

fn flag(c: u8) -> u64 {
    match c {
        b'i' => INSENSITIVE,
        b'm' => MULTILINE,
        b's' => DOT_ALL,
        b'U' => SWAP_GREED,
        b'u' => UNICODE,
        b'R' => CRLF,
        b'x' => FREE_SPACE,
        _ => 0,
    }
}

// Low seven bits set flags, next seven clear flags.
fn flags(s: String, mut p: Parser) -> Result[u64, Error] {
    let mut plus: u64 = 0
    let mut minus: u64 = 0
    let mut negative = false
    let mut dangling = false
    let mut marker: u64 = 0
    loop {
        if p.at == p.width {
            return Error(syntax(p.at, FlagUnexpectedEof))
        }
        let c = byte(s, p.at)
        if c == b')' || c == b':' {
            break
        }
        if c == b'-' {
            if negative {
                return Error(syntax(p.at, FlagRepeatedNegation))
            }
            marker = p.at
            negative = true
            dangling = true
        } else {
            let bit = flag(c)
            if bit == 0 {
                return Error(syntax(p.at, FlagUnrecognized))
            }
            if ((plus | minus) & bit) != 0 {
                return Error(syntax(p.at, FlagDuplicate))
            }
            if negative {
                minus |= bit
            } else {
                plus |= bit
            }
            dangling = false
        }
        p.at += 1
    }
    if dangling {
        return Error(syntax(marker, FlagDanglingNegation))
    }
    Ok(plus | (minus << 7))
}

fn spacing(previous: bool, change: u64) -> bool {
    let current = if previous {
        FREE_SPACE
    } else {
        0
    }
    (apply_flags(current, change) & FREE_SPACE) != 0
}

fn apply_flags(current: u64, change: u64) -> u64 {
    (current | (change & FLAG_BITS)) & (FLAG_BITS ^ (change >> 7))
}

fn decimal(s: String, mut p: Parser) -> Result[u64, Error] {
    while p.at < p.width {
        let (c, successor) = scalar(s, p.at)
        if !is_space(c) {
            break
        }
        p.at = successor
    }
    let start = p.at
    let mut n: Option[u64] = Some(0)
    while p.at < p.width {
        let c = byte(s, p.at)
        if c < b'0' || c > b'9' {
            break
        }
        if let Some(prefix) = n {
            n = int.accumulate_digit(prefix, 10, c - b'0', 4294967295)
        }
        p.at += 1
        skip(s, mut p)
    }
    if p.at == start {
        return Error(syntax(start, RepetitionCountDecimalEmpty))
    }
    while p.at < p.width {
        let (c, successor) = scalar(s, p.at)
        if !is_space(c) {
            break
        }
        p.at = advance_space(s, successor, p.free_space)
    }
    match n {
        Some(value) => Ok(value),
        None => Error(syntax(start, DecimalInvalid)),
    }
}

fn counted(s: String, mut p: Parser, start: u64) -> Result[(u64, u64), Error] {
    skip(s, mut p)
    if p.at == p.width {
        return Error(syntax(start, RepetitionCountUnclosed))
    }
    let low = decimal(s, mut p)
    if p.at == p.width {
        return Error(syntax(start, RepetitionCountUnclosed))
    }
    if byte(s, p.at) == b',' {
        p.at += 1
        skip(s, mut p)
        if p.at == p.width {
            return Error(syntax(start, RepetitionCountUnclosed))
        }
        let lo = low?
        if byte(s, p.at) == b'}' {
            return Ok((lo, UNBOUNDED))
        }
        let hi = decimal(s, mut p)?
        Ok((lo, hi))
    } else {
        let lo = low?
        Ok((lo, lo))
    }
}

fn repetition(s: String, mut p: Parser) -> Result[(), Error] {
    let start = p.at
    if p.tail == 0 || read(p.ast, p.tail).kind == FLAGS {
        return Error(syntax(start, RepetitionMissing))
    }
    let op = byte(s, p.at)
    p.at += 1
    let (lo, hi) = match op {
        b'?' => (0u64, 1u64),
        b'*' => (0u64, UNBOUNDED),
        b'+' => (1u64, UNBOUNDED),
        _ => {
            let bounds = counted(s, mut p, start)?
            if p.at == p.width || byte(s, p.at) != b'}' {
                return Error(syntax(start, RepetitionCountUnclosed))
            }
            p.at += 1
            skip(s, mut p)
            bounds
        },
    }
    let lazy = p.at < p.width && byte(s, p.at) == b'?'
    if lazy {
        p.at += 1
    }
    if hi < lo {
        return Error(syntax(start, RepetitionCountInvalid))
    }
    let child = read(p.ast, p.tail)
    let i = insert(mut p.ast, child)?
    let mut repeat = node(REPEAT, child.at, p.at, lo, hi)
    repeat.first = i
    repeat.more = if lazy {
        1
    } else {
        0
    }
    write(mut p.ast, p.tail, repeat)
    Ok(())
}

const START_LINE: u64 = 1

const END_LINE: u64 = 2

const START_TEXT: u64 = 3

const END_TEXT: u64 = 4

const WORD: u64 = 5

const NOT_WORD: u64 = 6

const WORD_START: u64 = 7

const WORD_END: u64 = 8

const WORD_START_HALF: u64 = 9

const WORD_END_HALF: u64 = 10

fn primitive(s: String, mut p: Parser, in_class: bool) -> Result[Node, Error] {
    let start = p.at
    let (c, successor) = scalar(s, start)
    p.at = successor
    if c == 92 {
        return escape(s, mut p, start)
    }
    if !in_class {
        match c {
            46 => return Ok(node(DOT, start, successor, 0, 0)),
            94 => return Ok(node(ASSERT, start, successor, START_LINE, 0)),
            36 => return Ok(node(ASSERT, start, successor, END_LINE, 0)),
            _ => {},
        }
    }
    Ok(node(LITERAL, start, successor, c, 0))
}

fn escape(s: String, mut p: Parser, start: u64) -> Result[Node, Error] {
    if p.at == p.width {
        return Error(syntax(start, EscapeUnexpectedEof))
    }
    let (c, successor) = scalar(s, p.at)
    p.at = successor
    if c < 128 {
        let b: u8 = int.narrow(c)
        if int.is_ascii_digit(b) {
            return Error(syntax(start, UnsupportedBackreference))
        }
        if !int.is_ascii_alpha(b) && b != b'<' && b != b'>' {
            return Ok(node(LITERAL, start, successor, c, 0))
        }
    }
    match c {
        120 => hexadecimal(s, mut p, start, c),
        117 => hexadecimal(s, mut p, start, c),
        85 => hexadecimal(s, mut p, start, c),
        112 => property(s, mut p, start, c == 80),
        80 => property(s, mut p, start, c == 80),
        100 => Ok(node(PERL, start, successor, c, 0)),
        115 => Ok(node(PERL, start, successor, c, 0)),
        119 => Ok(node(PERL, start, successor, c, 0)),
        68 => Ok(node(PERL, start, successor, c + 32, 1)),
        83 => Ok(node(PERL, start, successor, c + 32, 1)),
        87 => Ok(node(PERL, start, successor, c + 32, 1)),
        97 => Ok(node(LITERAL, start, successor, 7, 0)),
        102 => Ok(node(LITERAL, start, successor, 12, 0)),
        116 => Ok(node(LITERAL, start, successor, 9, 0)),
        110 => Ok(node(LITERAL, start, successor, 10, 0)),
        114 => Ok(node(LITERAL, start, successor, 13, 0)),
        118 => Ok(node(LITERAL, start, successor, 11, 0)),
        65 => Ok(node(ASSERT, start, successor, START_TEXT, 0)),
        122 => Ok(node(ASSERT, start, successor, END_TEXT, 0)),
        98 => {
            let kind = word_boundary(s, mut p, start)?
            Ok(node(ASSERT, start, p.at, kind, 0))
        },
        66 => Ok(node(ASSERT, start, successor, NOT_WORD, 0)),
        60 => Ok(node(ASSERT, start, successor, WORD_START, 0)),
        62 => Ok(node(ASSERT, start, successor, WORD_END, 0)),
        _ => Error(syntax(start, EscapeUnrecognized)),
    }
}

fn hexadecimal(s: String, mut p: Parser, escape_at: u64, prefix: u64) -> Result[Node, Error] {
    skip(s, mut p)
    if p.at == p.width {
        return Error(syntax(p.at, EscapeUnexpectedEof))
    }
    let brace = p.at
    let braced = byte(s, p.at) == b'{'
    let digits: u64 = if prefix == 120 {
        2
    } else if prefix == 117 {
        4
    } else {
        8
    }
    if braced {
        p.at += 1
        skip(s, mut p)
    }
    let start = if braced {
        brace + 1
    } else {
        p.at
    }
    let mut seen: u64 = 0
    let mut value: u64 = 0
    while braced || seen < digits {
        if p.at == p.width {
            return Error(syntax(if braced {
                brace
            } else {
                p.at
            }, EscapeUnexpectedEof))
        }
        let c = byte(s, p.at)
        if braced && c == b'}' {
            break
        }
        let Some(digit) = int.ascii_digit(c, 16) else {
            return Error(syntax(p.at, EscapeHexInvalidDigit))
        }
        if value <= 0x10FFFF {
            value = value * 16 + int.widen(digit)
        }
        seen += 1
        p.at += 1
        skip(s, mut p)
    }
    if braced {
        p.at += 1
        skip(s, mut p)
        if seen == 0 {
            return Error(syntax(brace, EscapeHexEmpty))
        }
    }
    if value > 0x10FFFF || (0xD800 <= value && value <= 0xDFFF) {
        return Error(syntax(start, EscapeHexInvalid))
    }
    Ok(node(if !braced && prefix == 120 {
        FIXED_BYTE
    } else {
        LITERAL
    }, escape_at, p.at, value, 0))
}

fn property(s: String, mut p: Parser, start: u64, negated: bool) -> Result[Node, Error] {
    skip(s, mut p)
    if p.at == p.width {
        return Error(syntax(p.at, EscapeUnexpectedEof))
    }
    let mut lo = p.at
    let mut hi = p.at
    if byte(s, p.at) == b'{' {
        p.at += 1
        lo = p.at
        skip(s, mut p)
        while p.at < p.width && byte(s, p.at) != b'}' {
            let (_, successor) = scalar(s, p.at)
            p.at = successor
            skip(s, mut p)
        }
        if p.at == p.width {
            return Error(syntax(p.at, EscapeUnexpectedEof))
        }
        hi = p.at
        p.at += 1
    } else {
        if byte(s, p.at) == b'\\' {
            return Error(syntax(p.at, UnicodeClassInvalid))
        }
        let (_, successor) = scalar(s, p.at)
        hi = successor
        p.at = successor
        skip(s, mut p)
    }
    let mut n = node(PROPERTY, start, p.at, lo, hi)
    n.more = (if negated {
        1u64
    } else {
        0u64
    }) + (if p.free_space {
        2u64
    } else {
        0u64
    })
    Ok(n)
}

fn word_boundary(s: String, mut p: Parser, start: u64) -> Result[u64, Error] {
    if p.at == p.width || byte(s, p.at) != b'{' {
        return Ok(WORD)
    }
    let brace = p.at
    p.at += 1
    skip(s, mut p)
    if p.at == p.width {
        return Error(syntax(start, SpecialWordOrRepetitionUnexpectedEof))
    }
    let body = p.at
    let mut token: Inline[u8, 10] =[0; 10]
    let mut total_count: u64 = 0
    while p.at < p.width {
        let c = byte(s, p.at)
        if !int.is_ascii_alpha(c) && c != b'-' {
            break
        }
        if total_count < 10 {
            token[total_count] = c
        }
        total_count += 1
        p.at += 1
        skip(s, mut p)
    }
    if total_count == 0 {
        p.at = brace
        return Ok(WORD)
    }
    if p.at == p.width || byte(s, p.at) != b'}' {
        return Error(syntax(brace, SpecialWordBoundaryUnclosed))
    }
    p.at += 1
    if total_count == 5 && word_is(token, "start") {
        return Ok(WORD_START)
    }
    if total_count == 3 && word_is(token, "end") {
        return Ok(WORD_END)
    }
    if total_count == 10 && word_is(token, "start-half") {
        return Ok(WORD_START_HALF)
    }
    if total_count == 8 && word_is(token, "end-half") {
        return Ok(WORD_END_HALF)
    }
    Error(syntax(body, SpecialWordBoundaryUnrecognized))
}

fn word_is(token: Inline[u8, 10], text: String) -> bool {
    let mut i: u64 = 0
    while i < string.byte_len(text) {
        if token[i] != byte(text, i) {
            return false
        }
        i += 1
    }
    true
}

const INTERSECTION: u64 = 1

const DIFFERENCE: u64 = 2

const SYMMETRIC_DIFFERENCE: u64 = 3

// Each operator owns the following implicit union. The first union is
// embedded in its bracket node. This mirrors the upstream class stack's
// left-associative reduction without allocating separate union nodes.
fn bracket(s: String, mut p: Parser) -> Result[(), Error] {
    let opening = open_class(s, mut p, 0)?
    let root = append(mut p, opening)?
    let mut class = root
    let mut segment = root
    let mut tail = class_leading(s, mut p, root)?
    loop {
        skip(s, mut p)
        if p.at == p.width {
            return Error(syntax(read(p.ast, class).at, ClassUnclosed))
        }
        let c = byte(s, p.at)
        if c == b']' {
            p.at += 1
            if class == root {
                return Ok(())
            }
            let parent = read(p.ast, class).b
            tail = class
            segment = parent
            let n = read(p.ast, segment)
            class = if n.kind == CLASS {
                segment
            } else {
                n.b
            }
        } else if c == b'[' {
            match ascii_class(s, p.at) {
                Some(n) => {
                    p.at = n.end
                    tail = append_set(mut p, segment, tail, n)?
                },
                None => {
                    let nested = open_class(s, mut p, segment)?
                    class = append_set(mut p, segment, tail, nested)?
                    segment = class
                    tail = class_leading(s, mut p, class)?
                },
            }
        } else {
            let op = class_operator(s, p.at, c)
            if op != 0 {
                p.at += 2
                let successor = insert(mut p.ast, node(SEGMENT, p.at, p.at, op, class))?
                p.ast[segment].more = successor
                segment = successor
                tail = 0
            } else {
                let opened_at = read(p.ast, class).at
                let item = set_item(s, mut p, opened_at)?
                tail = append_set(mut p, segment, tail, item)?
            }
        }
    }
}

fn open_class(s: String, mut p: Parser, parent: u64) -> Result[Node, Error] {
    let start = p.at
    p.at += 1
    skip(s, mut p)
    if p.at == p.width {
        return Error(syntax(start, ClassUnclosed))
    }
    let negated: u64 = if byte(s, p.at) == b'^' {
        1
    } else {
        0
    }
    if negated == 1 {
        p.at += 1
        skip(s, mut p)
    }
    if p.at == p.width {
        return Error(syntax(start, ClassUnclosed))
    }
    Ok(node(CLASS, start, p.at, negated, parent))
}

fn class_leading(s: String, mut p: Parser, class: u64) -> Result[u64, Error] {
    let mut tail: u64 = 0
    while p.at < p.width && byte(s, p.at) == b'-' {
        let start = p.at
        p.at += 1
        tail = append_set(mut p, class, tail, node(LITERAL, start, start + 1, 45, 0))?
        skip(s, mut p)
    }
    if tail == 0 && p.at < p.width && byte(s, p.at) == b']' {
        let start = p.at
        p.at += 1
        tail = append_set(mut p, class, tail, node(LITERAL, start, start + 1, 93, 0))?
    }
    Ok(tail)
}

fn append_set(mut p: Parser, segment: u64, tail: u64, item: Node) -> Result[u64, Error] {
    let i = insert(mut p.ast, item)?
    if tail == 0 {
        p.ast[segment].first = i
    } else {
        p.ast[tail].successor = i
    }
    Ok(i)
}

fn class_operator(s: String, at: u64, c: u8) -> u64 {
    if at + 1 == string.byte_len(s) || byte(s, at + 1) != c {
        return 0
    }
    match c {
        b'&' => INTERSECTION,
        b'-' => DIFFERENCE,
        b'~' => SYMMETRIC_DIFFERENCE,
        _ => 0,
    }
}

// The crate's class-range lookahead skips whitespace and the first '#'
// marker. It does not consume a whole comment the way advance_space does.
fn range_peek(s: String, start: u64, free: bool) -> u8 {
    let len = string.byte_len(s)
    let mut i = start
    let mut comment = false
    while i < len {
        if !free {
            return byte(s, i)
        }
        let (c, successor) = scalar(s, i)
        if c == 35 && !comment {
            comment = true
        } else if !is_space(c) {
            return byte(s, i)
        }
        i = successor
    }
    0
}

fn set_item(s: String, mut p: Parser, opening: u64) -> Result[Node, Error] {
    let first = primitive(s, mut p, true)?
    skip(s, mut p)
    if p.at == p.width {
        return Error(syntax(opening, ClassUnclosed))
    }
    if byte(s, p.at) == b'-' {
        let c = range_peek(s, p.at + 1, p.free_space)
        if c != b']' && c != b'-' {
            p.at += 1
            skip(s, mut p)
            if p.at == p.width {
                return Error(syntax(opening, ClassUnclosed))
            }
            let last = primitive(s, mut p, true)?
            if first.kind != LITERAL && first.kind != FIXED_BYTE {
                return Error(syntax(first.at, ClassRangeLiteral))
            }
            if last.kind != LITERAL && last.kind != FIXED_BYTE {
                return Error(syntax(last.at, ClassRangeLiteral))
            }
            if first.a > last.a {
                return Error(syntax(first.at, ClassRangeInvalid))
            }
            let mut range = node(RANGE, first.at, last.end, first.a, last.a)
            range.more = last.at
            range.first = if first.kind == FIXED_BYTE {
                1
            } else {
                0
            }
            range.first += if last.kind == FIXED_BYTE {
                2
            } else {
                0
            }
            return Ok(range)
        }
    }
    if first.kind == ASSERT {
        return Error(syntax(first.at, ClassEscapeInvalid))
    }
    Ok(first)
}

fn ascii_class(s: String, at: u64) -> Option[Node] {
    if !starts(s, at, "[:") {
        return None
    }
    let negated = starts(s, at, "[:^")
    let lo = at + if negated {
        3
    } else {
        2
    }
    let mut hi = lo
    while hi < string.byte_len(s) && hi - lo < 7 {
        if byte(s, hi) == b':' {
            break
        }
        if !int.is_ascii_alpha(byte(s, hi)) {
            return None
        }
        hi += 1
    }
    if !starts(s, hi, ":]") {
        return None
    }
    let name = string.slice(s, lo, hi)
    let kind: u64 = if name == "alnum" {
        1
    } else if name == "alpha" {
        2
    } else if name == "ascii" {
        3
    } else if name == "blank" {
        4
    } else if name == "cntrl" {
        5
    } else if name == "digit" {
        6
    } else if name == "graph" {
        7
    } else if name == "lower" {
        8
    } else if name == "print" {
        9
    } else if name == "punct" {
        10
    } else if name == "space" {
        11
    } else if name == "upper" {
        12
    } else if name == "word" {
        13
    } else if name == "xdigit" {
        14
    } else {
        return None
    }
    Some(node(ASCII, at, hi + 2, kind, if negated {
        1
    } else {
        0
    }))
}

const WALK_EXPR: u64 = 1

const WALK_ARMS: u64 = 0

const WALK_CLASS: u64 = 2

const WALK_CLASS_ITEMS: u64 = 3

type Walk: key {
    kind: u64,
    i: u64,
    depth: u64
}

fn descent(depth: u64, at: u64) -> Result[u64, Error] {
    if depth == 250 {
        return Error(syntax(at, NestLimitExceeded))
    }
    Ok(depth + 1)
}

fn check_depth(xs: List[Node]) -> Result[(), Error] {
    let mut pending: Inline[Walk, 503] =[Walk(kind: WALK_ARMS, i: 0, depth: 0); 503]
    let mut used: u64 = 1
    while used != 0 {
        used -= 1
        let task = pending[used]
        let n = read(xs, task.i)
        let mut d = task.depth
        if task.kind == WALK_EXPR || task.kind == WALK_CLASS_ITEMS {
            if n.successor != 0 {
                pending[used] = Walk(kind: task.kind, i: n.successor, depth: d)
                used += 1
            }
            if n.kind == REPEAT {
                d = descent(d, n.at)?
                pending[used] = Walk(kind: WALK_EXPR, i: n.first, depth: d)
                used += 1
            } else if n.kind == CAPTURE || n.kind == SCOPED {
                d = descent(d, n.at)?
                pending[used] = Walk(kind: WALK_ARMS, i: task.i, depth: d)
                used += 1
            } else if n.kind == CLASS {
                d = descent(d, n.at)?
                pending[used] = Walk(kind: WALK_CLASS, i: task.i, depth: d)
                used += 1
            }
        } else if task.kind == WALK_ARMS {
            let start = if n.kind == ARM {
                n.at
            } else {
                n.end
            }
            if n.more != 0 {
                if n.kind != ARM {
                    d = descent(d, start)?
                }
                pending[used] = Walk(kind: WALK_ARMS, i: n.more, depth: d)
                used += 1
            }
            if n.first != 0 {
                if read(xs, n.first).successor != 0 {
                    d = descent(d, start)?
                }
                pending[used] = Walk(kind: WALK_EXPR, i: n.first, depth: d)
                used += 1
            }
        } else {
            if n.kind == CLASS {
                let mut successor = n.more
                let start = if n.first != 0 && read(xs, n.first).successor == 0 {
                    read(xs, n.first).at
                } else {
                    n.end
                }
                while successor != 0 {
                    d = descent(d, start)?
                    successor = read(xs, successor).more
                }
            }
            if n.more != 0 {
                let remaining = if n.kind == CLASS {
                    d
                } else {
                    d - 1
                }
                pending[used] = Walk(kind: WALK_CLASS, i: n.more, depth: remaining)
                used += 1
            }
            if n.first != 0 {
                if read(xs, n.first).successor != 0 {
                    d = descent(d, n.end)?
                }
                pending[used] = Walk(kind: WALK_CLASS_ITEMS, i: n.first, depth: d)
                used += 1
            }
        }
    }
    Ok(())
}

fn table_contains(first: u64, last: u64, value: u64) -> bool {
    let mut lo = first
    let mut hi = last
    while lo < hi {
        let i = lo + (hi - lo) / 2
        let start: u64 = int.widen(UNICODE_RANGES[2 * i])
        let end: u64 = int.widen(UNICODE_RANGES[2 * i + 1])
        if value < start {
            hi = i
        } else if value > end {
            lo = i + 1
        } else {
            return true
        }
    }
    false
}

fn capture_char(c: u64, first: bool) -> bool {
    c == 95 || table_contains(NAME_START_LO, NAME_START_HI, c) || (!first && (c == 46 || c == 91 || c == 93 || table_contains(NAME_CONTINUE_LO, NAME_CONTINUE_HI, c)))
}

type Alias: key {
    letters: Inline[u8, 64],
    len: u64
}

fn normalize_alias(s: String, lo: u64, hi: u64, free: bool) -> Alias {
    let mut a = Alias(letters:[0; 64], len: 0)
    let mut i = advance_space(s, lo, free)
    let j = if i < hi {
        advance_space(s, i + 1, free && byte(s, i) < 128)
    } else {
        i
    }
    let has_is = j < hi && (byte(s, i) | 32) == b'i' && (byte(s, j) | 32) == b's'
    if has_is {
        i = advance_space(s, j + 1, free)
    }
    while i < hi {
        let (c, successor) = scalar(s, i)
        i = advance_space(s, successor, free)
        if c <= 127 && c != 32 && c != 95 && c != 45 {
            if a.len == 64 {
                a.len = 65
                return a
            }
            let ch: u8 = int.narrow(c)
            a.letters[a.len] = if ch >= b'A' && ch <= b'Z' {
                ch | 32
            } else {
                ch
            }
            a.len += 1
        }
    }
    if has_is && a.len == 1 && a.letters[0] == b'c' {
        a.letters[0] = b'i'
        a.letters[1] = b's'
        a.letters[2] = b'c'
        a.len = 3
    }
    a
}

fn alias_order(a: Alias, lo: u64, n: u64) -> Order {
    let mut i: u64 = 0
    while i < a.len && i < n {
        let ch = ALIAS_TEXT[lo + i]
        if a.letters[i] < ch {
            return Less
        }
        if a.letters[i] > ch {
            return Greater
        }
        i += 1
    }
    if a.len < n {
        Less
    } else if a.len > n {
        Greater
    } else {
        Equal
    }
}

fn alias_lookup(a: Alias, code: u32) -> u32 {
    if a.len > 64 {
        return 0
    }
    let mut lower: u64 = 0
    let mut upper = ALIAS_COUNT
    while lower < upper {
        let mid = lower + (upper - lower) / 2
        let i = 4 * mid
        let alias_group = ALIASES[i]
        let order = if code < alias_group {
            Less
        } else if code > alias_group {
            Greater
        } else {
            alias_order(a, int.widen(ALIASES[i + 1]), int.widen(ALIASES[i + 2]))
        }
        match order {
            Less => {
                upper = mid
            },
            Greater => {
                lower = mid + 1
            },
            Equal => return ALIASES[i + 3],
        }
    }
    0
}

type Property: key {
    kind: u64,
    negate: bool
}

fn property_kind(s: String, n: Node) -> Result[Property, Error] {
    let free = (n.more & 2) != 0
    let negated = (n.more & 1) != 0
    let mut i = advance_space(s, n.a, free)
    let mut prev = i
    let mut equ = n.b
    let mut colon = n.b
    let mut ne = n.b
    let mut ne_end = n.b
    while i < n.b {
        let (c, successor) = scalar(s, i)
        if c == 58 && colon == n.b {
            colon = i
        } else if c == 61 {
            if equ == n.b {
                equ = i
            }
            if prev != i && byte(s, prev) == b'!' && ne == n.b {
                ne = prev
                ne_end = successor
            }
        }
        prev = i
        i = advance_space(s, successor, free)
    }
    let op = if ne < n.b {
        ne
    } else if colon < n.b {
        colon
    } else {
        equ
    }
    let a = normalize_alias(s, n.a, op, free)
    let code = alias_lookup(a, 0)
    if op == n.b {
        if code == 2 {
            return Ok(Property(kind: 115, negate: negated))
        }
        if code == 0 && alias_lookup(a, 1) == 1 {
            return Ok(Property(kind: 100, negate: negated))
        }
    } else {
        if code == 0 {
            return Error(syntax(n.at, UnicodePropertyNotFound))
        }
        let start = if ne < n.b {
            ne_end
        } else {
            op + 1
        }
        let b = normalize_alias(s, start, n.b, free)
        let value = alias_lookup(b, code)
        if value == 0 {
            return Error(syntax(n.at, UnicodePropertyValueNotFound))
        }
        if code == 1 && value == 1 {
            return Ok(Property(kind: 100, negate: negated != (ne < n.b)))
        }
    }
    Error(syntax(n.at, UnicodePropertyNotFound))
}

type Hir {
    nodes: List[Node],
    ranges: List[u32],
    names: List[u32]
}

const EMPTY: u64 = 16

const CHAR_SET: u64 = 17

type Translate: key {
    i: u64,
    kind: u64,
    saved: u64
}

const ENTER: u64 = 3

const EXIT_GROUP: u64 = 1

const EXIT_REPEAT: u64 = 2

const ENTER_ARM: u64 = 0

fn compile_hir(s: String) -> Result[Hir, Error] {
    let parsed = ast(s)?
    check_depth(parsed.ast)?
    let alloc: Result[List[Node], Capacity] = list.with_capacity(parsed.width + 1)
    let mut nodes = match take alloc {
        Ok(take xs) => take xs,
        Error(e) => return Error(Capacity(e)),
    }
    match list.append(mut nodes, parsed.ast) {
        Ok(()) => {},
        Error(e) => return Error(Capacity(e)),
    }
    let mut ranges: List[u32] = list.new()
    translate(s, parsed.ast, mut nodes, mut ranges)?
    let Parser(names: take names, ..) = take parsed
    Ok(Hir(nodes: take nodes, ranges: take ranges, names: take names))
}

fn translate(s: String, tree: List[Node], mut nodes: List[Node], mut ranges: List[u32]) -> Result[(), Error] {
    let mut active = UNICODE
    let mut pending: Inline[Translate, 753] =[Translate(i: 0, kind: ENTER_ARM, saved: 0); 753]
    let mut used: u64 = 1
    while used != 0 {
        used -= 1
        let task = pending[used]
        let mut n = read(tree, task.i)
        if task.kind == EXIT_GROUP {
            active = task.saved
        } else if task.kind == EXIT_REPEAT {
            let expr = read(nodes, n.first)
            if expr.kind == EMPTY || n.b == 0 {
                n.kind = EMPTY
            } else {
                if expr.kind == ASSERT {
                    if n.a > 1 {
                        n.a = 1
                    }
                    n.b = 1
                }
                n.more = task.saved
            }
            write(mut nodes, task.i, n)
        } else if task.kind == ENTER_ARM {
            if n.more != 0 {
                pending[used] = Translate(i: n.more, kind: ENTER_ARM, saved: 0)
                used += 1
            }
            if n.first != 0 {
                pending[used] = Translate(i: n.first, kind: ENTER, saved: 0)
                used += 1
            }
        } else {
            if n.successor != 0 {
                pending[used] = Translate(i: n.successor, kind: ENTER, saved: 0)
                used += 1
            }
            if n.kind == CAPTURE || n.kind == SCOPED {
                pending[used] = Translate(i: task.i, kind: EXIT_GROUP, saved: active)
                used += 1
                if n.kind == SCOPED {
                    active = apply_flags(active, n.a)
                }
                pending[used] = Translate(i: task.i, kind: ENTER_ARM, saved: 0)
                used += 1
            } else if n.kind == REPEAT {
                // HIR greed is the combination of the suffix and the scope's U flag.
                let lazy = (n.more != 0) != ((active & SWAP_GREED) != 0)
                pending[used] = Translate(i: task.i, kind: EXIT_REPEAT, saved: if lazy {
                    1
                } else {
                    0
                })
                used += 1
                pending[used] = Translate(i: n.first, kind: ENTER, saved: 0)
                used += 1
            } else if n.kind == FLAGS {
                active = apply_flags(active, n.a)
                n.kind = EMPTY
                write(mut nodes, task.i, n)
            } else {
                let mapped = translate_atom(s, tree, task.i, n, active, mut nodes, mut ranges)?
                write(mut nodes, task.i, mapped)
            }
        }
    }
    Ok(())
}

fn translate_atom(s: String, tree: List[Node], i: u64, n: Node, active: u64, mut nodes: List[Node], mut ranges: List[u32]) -> Result[Node, Error] {
    let mut result = n
    let unicode = (active & UNICODE) != 0
    let lo = list.len(ranges) / 2
    if n.kind == ASSERT {
        result.b = active & (MULTILINE | CRLF | UNICODE)
        return Ok(result)
    }
    if n.kind == DOT {
        if !unicode {
            return Error(syntax(n.at, InvalidUtf8))
        }
        if (active & DOT_ALL) != 0 {
            add_range(mut ranges, 0, 0x10FFFF)?
        } else {
            add_range(mut ranges, 0, 9)?
            if (active & CRLF) != 0 {
                add_range(mut ranges, 11, 12)?
                add_range(mut ranges, 14, 0x10FFFF)?
            } else {
                add_range(mut ranges, 11, 0x10FFFF)?
            }
        }
    } else if n.kind == CLASS {
        translate_class(s, tree, i, active, mut nodes, mut ranges)?
    } else if n.kind == PERL || n.kind == PROPERTY {
        item_ranges(s, n, active, mut ranges)?
    } else {
        if n.kind == FIXED_BYTE && !unicode && n.a >= 128 {
            return Error(syntax(n.at, InvalidUtf8))
        }
        result.kind = LITERAL
        if (active & INSENSITIVE) == 0 {
            return Ok(result)
        }
        let ch: u32 = int.narrow(n.a)
        add_range(mut ranges, ch, ch)?
        fold(mut ranges, lo, unicode)?
    }
    let hi = list.len(ranges) / 2
    if hi == lo + 1 && ranges[2 * lo] == ranges[2 * lo + 1] {
        result.kind = LITERAL
        result.a = int.widen(ranges[2 * lo])
        range_cut(mut ranges, lo)
    } else {
        result.kind = CHAR_SET
        result.a = lo
        result.b = hi
    }
    result.first = 0
    Ok(result)
}

fn push_u32(mut pool: List[u32], x: u32) -> Result[(), Error] {
    match list.push(mut pool, x) {
        Ok(()) => Ok(()),
        Error((e, _)) => Error(Capacity(e)),
    }
}

fn add_range(mut pool: List[u32], lo: u32, hi: u32) -> Result[(), Error] {
    if lo < 0xD800 {
        let end: u32 = if hi < 0xD800 {
            hi
        } else {
            0xD7FF
        }
        push_u32(mut pool, lo)?
        push_u32(mut pool, end)?
    }
    if hi >= 0xE000 {
        let start: u32 = if lo >= 0xE000 {
            lo
        } else {
            0xE000
        }
        push_u32(mut pool, start)?
        push_u32(mut pool, hi)?
    }
    Ok(())
}

fn range_cut(mut pool: List[u32], end: u64) {
    while list.len(pool) > 2 * end {
        let _ = list.pop(mut pool)
    }
}

fn range_move(mut pool: List[u32], to: u64, from: u64) {
    pool[2 * to] = pool[2 * from]
    pool[2 * to + 1] = pool[2 * from + 1]
}

fn range_swap(mut pool: List[u32], a: u64, b: u64) {
    list.swap(mut pool, 2 * a, 2 * b)
    list.swap(mut pool, 2 * a + 1, 2 * b + 1)
}

fn range_compare(pool: List[u32], a: u64, b: u64) -> Order {
    let by_start = order.compare(pool[2 * a], pool[2 * b])
    if by_start == Equal {
        order.compare(pool[2 * a + 1], pool[2 * b + 1])
    } else {
        by_start
    }
}

fn canonical(mut pool: List[u32], lo: u64) {
    let hi = list.len(pool) / 2
    if hi <= lo + 1 {
        return
    }
    let mut sorted = true
    let mut scan = lo + 1
    while scan < hi {
        if range_compare(pool, scan, scan - 1) == Less {
            sorted = false
            break
        }
        scan += 1
    }
    if !sorted {
        list.heap_sort_by_index(mut pool, lo, hi, range_compare, range_swap)
    }
    let mut i = lo + 1
    let mut write_at = lo
    while i < hi {
        let end = pool[2 * write_at + 1]
        if pool[2 * i] <= end + 1 {
            let current_end = pool[2 * i + 1]
            if current_end > end {
                pool[2 * write_at + 1] = current_end
            }
        } else {
            write_at += 1
            range_move(mut pool, write_at, i)
        }
        i += 1
    }
    range_cut(mut pool, write_at + 1)
}

fn fold(mut pool: List[u32], lo: u64, unicode: bool) -> Result[(), Error] {
    let hi = list.len(pool) / 2
    if hi == lo {
        return Ok(())
    }
    if unicode {
        let first = pool[2 * lo]
        let mut a: u64 = 0
        let mut b = FOLD_COUNT
        while a < b {
            let middle = a + (b - a) / 2
            if CASE_FOLD[2 * middle] < first {
                a = middle + 1
            } else {
                b = middle
            }
        }
        let mut i = lo
        while a < FOLD_COUNT && i < hi {
            let from = CASE_FOLD[2 * a]
            if from > pool[2 * i + 1] {
                i += 1
            } else {
                if from >= pool[2 * i] {
                    let to = CASE_FOLD[2 * a + 1]
                    add_range(mut pool, to, to)?
                }
                a += 1
            }
        }
    } else {
        let mut i = lo
        while i < hi {
            let start = pool[2 * i]
            let end = pool[2 * i + 1]
            if start <= 90 && end >= 65 {
                let a: u32 = if start < 65 {
                    65
                } else {
                    start
                }
                let b: u32 = if end > 90 {
                    90
                } else {
                    end
                }
                add_range(mut pool, a + 32, b + 32)?
            }
            if start <= 122 && end >= 97 {
                let a: u32 = if start < 97 {
                    97
                } else {
                    start
                }
                let b: u32 = if end > 122 {
                    122
                } else {
                    end
                }
                add_range(mut pool, a - 32, b - 32)?
            }
            i += 1
        }
    }
    canonical(mut pool, lo)
    Ok(())
}

fn replace_tail(mut pool: List[u32], lo: u64, from: u64) {
    let end = list.len(pool) / 2
    let mut i = from
    let mut dest = lo
    while i < end {
        range_move(mut pool, dest, i)
        dest += 1
        i += 1
    }
    range_cut(mut pool, dest)
}

fn negate(mut pool: List[u32], lo: u64, unicode: bool) -> Result[(), Error] {
    let n = list.len(pool) / 2
    let mut i = lo
    let mut from: u32 = 0
    while i < n {
        let start = pool[2 * i]
        let end = pool[2 * i + 1]
        if start > from {
            add_range(mut pool, from, start - 1)?
        }
        from = end + 1
        i += 1
    }
    let max: u32 = if unicode {
        0x10FFFF
    } else {
        255
    }
    if from <= max {
        add_range(mut pool, from, max)?
    }
    replace_tail(mut pool, lo, n)
    Ok(())
}

fn ascii_ranges(mut pool: List[u32], kind: u64) -> Result[(), Error] {
    if kind == 1 || kind == 6 || kind >= 13 {
        add_range(mut pool, 48, 57)?
    }
    if kind == 1 || kind == 2 || kind == 12 || kind == 13 {
        add_range(mut pool, 65, 90)?
    }
    if kind == 1 || kind == 2 || kind == 8 || kind == 13 {
        add_range(mut pool, 97, 122)?
    }
    match kind {
        3 => {
            add_range(mut pool, 0, 127)?
        },
        4 => {
            add_range(mut pool, 9, 9)?;
            add_range(mut pool, 32, 32)?
        },
        5 => {
            add_range(mut pool, 0, 31)?;
            add_range(mut pool, 127, 127)?
        },
        7 => {
            add_range(mut pool, 33, 126)?
        },
        9 => {
            add_range(mut pool, 32, 126)?
        },
        10 => {
            add_range(mut pool, 33, 47)?
            add_range(mut pool, 58, 64)?
            add_range(mut pool, 91, 96)?
            add_range(mut pool, 123, 126)?
        },
        11 => {
            add_range(mut pool, 9, 13)?;
            add_range(mut pool, 32, 32)?
        },
        13 => {
            add_range(mut pool, 95, 95)?
        },
        14 => {
            add_range(mut pool, 65, 70)?;
            add_range(mut pool, 97, 102)?
        },
        _ => {},
    }
    Ok(())
}

fn perl_ranges(mut pool: List[u32], kind: u64, unicode: bool) -> Result[(), Error] {
    if unicode {
        let (lo, hi) = if kind == 100 {
            (DECIMAL_LO, DECIMAL_HI)
        } else if kind == 115 {
            (SPACE_LO, SPACE_HI)
        } else {
            (WORD_LO, WORD_HI)
        }
        let mut i = lo
        while i < hi {
            add_range(mut pool, UNICODE_RANGES[2 * i], UNICODE_RANGES[2 * i + 1])?
            i += 1
        }
    } else if kind == 115 {
        add_range(mut pool, 9, 10)?
        add_range(mut pool, 12, 13)?
        add_range(mut pool, 32, 32)?
    } else {
        ascii_ranges(mut pool, if kind == 100 {
            6
        } else {
            13
        })?
    }
    Ok(())
}

fn byte_class_member(at: u64, value: u64, fixed: bool) -> Result[(), Error] {
    if value < 128 {
        return Ok(())
    }
    Error(syntax(at, if fixed {
        InvalidUtf8
    } else {
        UnicodeNotAllowed
    }))
}

fn check_ascii(pool: List[u32], lo: u64, at: u64) -> Result[(), Error] {
    let end = list.len(pool)
    if end > 2 * lo && pool[end - 1] >= 128 {
        return Error(syntax(at, InvalidUtf8))
    }
    Ok(())
}

fn item_ranges(s: String, n: Node, active: u64, mut pool: List[u32]) -> Result[(), Error] {
    let unicode = (active & UNICODE) != 0
    let lo = list.len(pool) / 2
    if n.kind == LITERAL || n.kind == FIXED_BYTE {
        if !unicode {
            byte_class_member(n.at, n.a, n.kind == FIXED_BYTE)?
        }
        add_range(mut pool, int.narrow(n.a), int.narrow(n.a))?
    } else if n.kind == RANGE {
        if !unicode {
            byte_class_member(n.at, n.a, (n.first & 1) != 0)?
            byte_class_member(n.more, n.b, (n.first & 2) != 0)?
        }
        add_range(mut pool, int.narrow(n.a), int.narrow(n.b))?
    } else {
        let mut negated = n.b != 0
        if n.kind == PROPERTY {
            if !unicode {
                return Error(syntax(n.at, UnicodeNotAllowed))
            }
            let p = property_kind(s, n)?
            perl_ranges(mut pool, p.kind, true)?
            negated = p.negate
        } else if n.kind == PERL {
            perl_ranges(mut pool, n.a, unicode)?
        } else {
            ascii_ranges(mut pool, n.a)?
        }
        canonical(mut pool, lo)
        if n.kind == ASCII && (active & INSENSITIVE) != 0 {
            fold(mut pool, lo, unicode)?
        }
        if negated {
            negate(mut pool, lo, unicode)?
        }
        if !unicode {
            check_ascii(pool, lo, n.at)?
        }
    }
    Ok(())
}

fn includes(op: u64, a: bool, b: bool) -> bool {
    if op == INTERSECTION {
        a && b
    } else if op == DIFFERENCE {
        a && !b
    } else {
        a != b
    }
}

fn combine(mut pool: List[u32], lo: u64, mid: u64, op: u64) -> Result[(), Error] {
    let end = list.len(pool) / 2
    let mut a = 2 * lo
    let mut b = 2 * mid
    let mut from: u32 = 0
    while a < 2 * mid || b < 2 * end {
        let tie_a: u32 = int.narrow(a & 1)
        let bound_a = if a < 2 * mid {
            pool[a] + tie_a
        } else {
            0x110001
        }
        let tie_b: u32 = int.narrow(b & 1)
        let bound_b = if b < 2 * end {
            pool[b] + tie_b
        } else {
            0x110001
        }
        let edge = if bound_a < bound_b {
            bound_a
        } else {
            bound_b
        }
        let before = includes(op, a % 2 == 1, b % 2 == 1)
        if bound_a == edge {
            a += 1
        }
        if bound_b == edge {
            b += 1
        }
        let after = includes(op, a % 2 == 1, b % 2 == 1)
        if before && !after {
            add_range(mut pool, from, edge - 1)?
        } else if !before && after {
            from = edge
        }
    }
    replace_tail(mut pool, lo, end)
    Ok(())
}

type ClassFrame: key {
    parent: u64,
    segment: u64,
    successor: u64,
    lo: u64,
    mid: u64
}

fn class_frame(nodes: List[Node], i: u64) -> ClassFrame {
    let n = read(nodes, i)
    ClassFrame(parent: n.a, segment: n.at, successor: n.end, lo: n.first, mid: n.successor)
}

fn put_class_frame(mut nodes: List[Node], i: u64, frame: ClassFrame) {
    let mut n = read(nodes, i)
    n.at = frame.segment
    n.end = frame.successor
    n.first = frame.lo
    n.successor = frame.mid
    n.a = frame.parent
    write(mut nodes, i, n)
}

// A bracket class consumes only its root HIR slot. While translating it,
// borrow each bracket's unused HIR fields for the open class's frame.
// Record the parent on descent because repetition can move a class root.
fn translate_class(s: String, tree: List[Node], root: u64, active: u64, mut nodes: List[Node], mut pool: List[u32]) -> Result[(), Error] {
    let start = list.len(pool) / 2
    put_class_frame(mut nodes, root, ClassFrame(parent: 0, segment: root, successor: read(tree, root).first, lo: start, mid: start))
    let mut open_class_id = root
    let unicode = (active & UNICODE) != 0
    let insensitive = (active & INSENSITIVE) != 0
    loop {
        let mut frame = class_frame(nodes, open_class_id)
        if frame.successor == 0 {
            canonical(mut pool, frame.mid)
            if insensitive {
                fold(mut pool, frame.mid, unicode)?
            }
            let segment = read(tree, frame.segment)
            if segment.kind == SEGMENT {
                combine(mut pool, frame.lo, frame.mid, segment.a)?
            }
            if segment.more != 0 {
                frame.segment = segment.more
                frame.successor = read(tree, segment.more).first
                frame.mid = list.len(pool) / 2
                put_class_frame(mut nodes, open_class_id, frame)
            } else {
                let class = read(tree, open_class_id)
                if class.a != 0 {
                    negate(mut pool, frame.lo, unicode)?
                }
                if !unicode {
                    check_ascii(pool, frame.lo, class.at)?
                }
                if open_class_id == root {
                    return Ok(())
                }
                open_class_id = frame.parent
            }
        } else {
            let item_id = frame.successor
            let item = read(tree, item_id)
            frame.successor = item.successor
            put_class_frame(mut nodes, open_class_id, frame)
            if item.kind == CLASS {
                let lo = list.len(pool) / 2
                put_class_frame(mut nodes, item_id, ClassFrame(parent: open_class_id, segment: item_id, successor: item.first, lo: lo, mid: lo))
                open_class_id = item_id
            } else {
                item_ranges(s, item, active, mut pool)?
            }
        }
    }
}

type NfaState: key {
    op: u32,
    a: u32,
    b: u32,
    c: u32
}

type NfaEdge: key {
    lo: u32,
    hi: u32,
    target: u32
}

type CaptureOffsets: key {
    prefix: u64,
    suffix: u64,
}

pub opaque type Regex: shareable + send {
    owner: Unique,
    forward: List[NfaState],
    reverse: List[NfaState],
    edges: List[NfaEdge],
    class_map: Bytes,
    names: List[u32],
    name_text: Bytes,
    prefilter: Bytes,
    pref_plan: Prefilter,
    pref_reverse_start: u64,
    charge: u64,
    group_count: u64,
    capture_offsets: Option[CaptureOffsets],
    class_count: u64,
    start: u64,
    reverse_start: u64,
    can_empty: bool,
    has_look: bool,
    quit_non_ascii: bool
}

pub opaque type Cache: send {
    owner: Unique,
    work: List[u32],
    slices: Layout
}

pub opaque type Groups: send {
    owner: Unique,
    spans: List[u64]
}

pub opaque type Cursor: key {
    at: u64,
    after_match: bool,
    finished: bool
}

pub type Match: key {
    start: u64,
    end: u64
}

const SIZE_LIMIT: u64 = 10485760

const OFFSET_LIMIT: u64 = 4294967295

fn round8(n: u64) -> u64 {
    (n + 7) & 0xFFFFFFFFFFFFFFF8
}

pub fn size(re: Regex) -> u64 {
    re.charge
}

type Layout: key {
    words: u64,
    states: u64,
    pike: u64,
    front: u64,
    back: u64,
    row: u64,
    saved: u64,
    stack: u64
}

fn layout(re: Regex, budget: u64) -> Layout {
    let classes = re.class_count + 1
    let nf = list.len(re.forward)
    let nr = list.len(re.reverse)
    let n = re.group_count
    let headers: u64 = 24
    let dfa_scratch = 3 * (nf + nr)
    let frontiers = 2 * nf + 4 * n * nf
    let pike_scratch = 2 * frontiers + 8 * n + 8 * nf
    let fixed = headers + dfa_scratch + pike_scratch
    let per_pair = 2 * (classes + 20)
    let target: u64 = budget / 4
    let fit: u64 = if target > fixed {
        (target - fixed) / per_pair
    } else {
        0
    }
    // A state id is its transition row's offset (id * classes), so it must
    // stay below the DFA_MATCH tag bit.
    let max_states: u64 = DFA_TARGET_LIMIT / classes
    let states: u64 = if fit < 8 {
        8
    } else if fit > max_states {
        max_states
    } else {
        fit
    }
    let pike = headers + per_pair * states + dfa_scratch
    let back = pike + frontiers
    let row = back + frontiers
    let saved = row + 4 * n
    Layout(words: pike + pike_scratch, states: states, pike: pike, front: pike, back: back, row: row, saved: saved, stack: saved + 4 * n)
}

pub fn cache_bytes(re: Regex, budget: u64) -> u64 {
    round8(4 * layout(re, budget).words)
}

pub fn cache(re: Regex, budget: u64) -> Result[Cache, Capacity] {
    let slices = layout(re, budget)
    let n = slices.words
    let admitted: Result[List[u32], Capacity] = list.with_capacity(n)
    let mut work = admitted?
    list.fill(mut work, n, 0)?
    Ok(Cache(owner: re.owner, work: take work, slices: slices))
}

pub fn groups(re: Regex) -> Result[Groups, Capacity] {
    let n = 2 * re.group_count
    let admitted: Result[List[u64], Capacity] = list.with_capacity(n)
    let mut spans = admitted?
    list.fill(mut spans, n, 0)?
    init_group_spans(mut spans)
    Ok(Groups(owner: re.owner, spans: take spans))
}

fn init_group_spans(mut spans: List[u64]) {
    let mut i: u64 = 0
    while i < list.len(spans) {
        spans[i] = 1
        spans[i + 1] = 0
        i += 2
    }
}

pub fn group_len(re: Regex) -> u64 {
    re.group_count
}

pub fn group(g: Groups, i: u64) -> Option[Match] {
    if i >= list.len(g.spans) / 2 {
        return None
    }
    let lo = g.spans[2 * i]
    let hi = g.spans[2 * i + 1]
    if lo <= hi {
        Some(Match(start: lo, end: hi))
    } else {
        None
    }
}

pub fn group_index(re: Regex, name: String) -> Option[u64] {
    let mut pos: u64 = 0
    let mut i: u64 = 0
    let n = string.byte_len(name)
    while i < list.len(re.names) {
        let end: u64 = int.widen(re.names[i + 1])
        if end - pos == n {
            let mut k: u64 = 0
            while k < n && re.name_text[pos + k] == byte(name, k) {
                k += 1
            }
            if k == n {
                return Some(int.widen(re.names[i]))
            }
        }
        pos = end
        i += 2
    }
    None
}

pub fn cursor(at: u64) -> Cursor {
    Cursor(at: at, after_match: false, finished: false)
}

fn check_cache(re: Regex, c: Cache) {
    if re.owner != c.owner {
        fail("regex: cache belongs to another regex")
    }
}

fn check_groups(re: Regex, g: Groups) {
    if re.owner != g.owner {
        fail("regex: groups belong to another regex")
    }
}

fn check_start(s: String, at: u64) {
    let _ = string.slice(s, at, at)
}

const OP_MATCH: u32 = 0

const OP_BYTE: u32 = 1

const OP_SPLIT: u32 = 2

const OP_SAVE: u32 = 3

const OP_ASSERT: u32 = 4

const OP_SPARSE: u32 = 5

const OP_DEAD: u32 = 6

const OP_UTF8_CHOICE: u32 = 7

const FORWARD_BASE: u64 = 5

const REVERSE_BASE: u64 = 3

type Shape: key {
    states: u64,
    edges: u64,
    pgroup: u64,
    can_empty: bool,
    can_consume: bool
}

fn shape(states: u64, edges: u64, nullable: bool, consuming: bool) -> Shape {
    Shape(states: states, edges: edges, pgroup: 0, can_empty: nullable, can_consume: consuming)
}

fn check_size(f: u64, r: u64, edges: u64, names: u64, text: u64, prefix: u64) -> Result[u64, Error] {
    let n = 16 * (f + r) + round8(12 * edges) + 256 + 8 * names + round8(text) + round8(prefix)
    if n > SIZE_LIMIT {
        Error(TooBig(SIZE_LIMIT))
    } else {
        Ok(n)
    }
}

fn size_add(a: Shape, b: Shape, is_alt: bool) -> Result[Shape, Error] {
    let states = a.states + b.states
    let edges = a.edges + b.edges
    let _ = check_size(states, 0, edges, 0, 0, 0)?
    let pgroup = if a.pgroup > b.pgroup {
        a.pgroup
    } else {
        b.pgroup
    }
    let nullable = if is_alt {
        a.can_empty || b.can_empty
    } else {
        a.can_empty && b.can_empty
    }
    Ok(Shape(states: states, edges: edges, pgroup: pgroup, can_empty: nullable, can_consume: a.can_consume || b.can_consume))
}

fn sized_repeat(m: Shape, minimum: u64, maximum: u64) -> Result[Shape, Error] {
    let zero_width = m.can_empty && !m.can_consume
    let lo: u64 = if zero_width && minimum > 1 {
        1
    } else {
        minimum
    }
    let hi: u64 = if zero_width && maximum > 1 {
        1
    } else {
        maximum
    }
    if lo == 0 && hi == 0 {
        return Ok(shape(0, 0, true, false))
    }
    let mut optional: u64 = 0
    let mut copies = hi
    if hi == UNBOUNDED {
        copies = if lo == 0 {
            1
        } else {
            lo
        }
        optional = if lo == 0 && m.can_empty {
            2
        } else {
            1
        }
    } else {
        optional = hi - lo
    }
    // The child already passed check_size, and copies is at most u32::MAX.
    // This product fits u64 even when the regular expression would not.
    let states = m.states * copies + optional
    let edges = m.edges * copies
    let _ = check_size(states, 0, edges, 0, 0, 0)?
    Ok(Shape(states: states, edges: edges, pgroup: m.pgroup, can_empty: lo == 0 || m.can_empty, can_consume: m.can_consume))
}

fn sized_atom(h: Hir, i: u64, rev: bool) -> Result[Shape, Error] {
    let n = read(h.nodes, i)
    if n.kind == EMPTY {
        return Ok(shape(0, 0, true, false))
    }
    if n.kind == LITERAL {
        return Ok(shape(utf8_width(n.a), 0, false, true))
    }
    if n.kind == ASSERT {
        return Ok(shape(1, 0, true, false))
    }
    if n.kind == CHAR_SET {
        return sized_set(h.ranges, n.a, n.b)
    }
    if n.kind == REPEAT {
        return sized_repeat(sized_atom(h, n.first, rev)?, n.a, n.b)
    }
    let mut m = sized_alts(h, i, rev)?
    if n.kind == CAPTURE && !rev {
        m.states += 2
        if n.a > m.pgroup {
            m.pgroup = n.a
        }
    }
    Ok(m)
}

fn sized_seq(h: Hir, i: u64, rev: bool) -> Result[Shape, Error] {
    let mut m = shape(0, 0, true, false)
    let mut successor = i
    while successor != 0 {
        m = size_add(m, sized_atom(h, successor, rev)?, false)?
        successor = read(h.nodes, successor).successor
    }
    Ok(m)
}

fn sized_alts(h: Hir, i: u64, rev: bool) -> Result[Shape, Error] {
    let n = read(h.nodes, i)
    let mut total = sized_seq(h, n.first, rev)?
    if n.more == 0 {
        return Ok(total)
    }
    let sparse = disjoint_literals(h.nodes, i, rev)
    let mut arms: u64 = 1
    let mut other = n.more
    while other != 0 {
        let branch = read(h.nodes, other)
        total = size_add(total, sized_seq(h, branch.first, rev)?, true)?
        other = branch.more
        arms += 1
    }
    if sparse {
        total.states = total.states + 1 - arms
        total.edges += arms
    } else {
        total.states += arms - 1
    }
    let _ = check_size(total.states, 0, total.edges, 0, 0, 0)?
    Ok(total)
}

fn chain_end(xs: List[Node], first: u64, arms: bool) -> u64 {
    let mut at = first
    loop {
        let n = read(xs, at)
        let successor = if arms {
            n.more
        } else {
            n.successor
        }
        if successor == 0 {
            return at
        }
        at = successor
    }
}

fn disjoint_literals(xs: List[Node], i: u64, rev: bool) -> bool {
    let mut seen: Inline[bool, 128] =[false; 128]
    let mut here = i
    loop {
        let arm = read(xs, here)
        if arm.first == 0 {
            return false
        }
        let mut start: u64 = 0
        let mut successor = arm.first
        while successor != 0 {
            let n = read(xs, successor)
            if n.kind != LITERAL || n.a >= 128 {
                return false
            }
            if rev || successor == arm.first {
                start = n.a
            }
            successor = n.successor
        }
        if seen[start] {
            return false
        }
        seen[start] = true
        if arm.more == 0 {
            return true
        }
        here = arm.more
    }
}

fn utf8_width(c: u64) -> u64 {
    if c < 0x80 {
        1
    } else if c < 0x800 {
        2
    } else if c < 0x10000 {
        3
    } else {
        4
    }
}

fn byte_scalar(c: u64, n: u64, i: u64) -> u32 {
    if n == 1 {
        return int.narrow(c)
    }
    let shift = 6 * (n - i - 1)
    if i == 0 {
        let prefix: u64 = if n == 2 {
            0xC0
        } else if n == 3 {
            0xE0
        } else {
            0xF0
        }
        return int.narrow(prefix | (c >> shift))
    }
    int.narrow(0x80 | ((c >> shift) & 63))
}

// A UTF-8 scalar interval is a sorted sequence of byte rectangles. Split where
// the width changes or a partial low-bit range crosses a higher-bit boundary.
// The source range pool already separates the surrogate interval.
fn rectangle_end(lo: u64, hi: u64, n: u64) -> u64 {
    let limit = if n == 1 {
        0x7Fu64
    } else if n == 2 {
        0x7FFu64
    } else if n == 3 {
        0xFFFFu64
    } else {
        0x10FFFFu64
    }
    let mut end = if hi < limit {
        hi
    } else {
        limit
    }
    let mut i: u64 = 1
    while i < n {
        let mask = (1u64 << (6 * i)) - 1
        let lower = lo & (0xFFFFFFFF ^ mask)
        let upper = end & (0xFFFFFFFF ^ mask)
        if lower != upper {
            if (lo & mask) != 0 {
                end = lo | mask
            } else if (end & mask) != mask {
                end = upper - 1
            }
        }
        i += 1
    }
    end
}

fn sized_set(ranges: List[u32], start: u64, end: u64) -> Result[Shape, Error] {
    if start == end {
        return Ok(shape(1, 0, false, false))
    }
    if ranges[2 * end - 1] < 128 {
        return Ok(shape(1, if end - start > 1 {
            end - start
        } else {
            0
        }, false, true))
    }
    let mut states: u64 = 0
    let mut i = start
    while i < end {
        let mut lo: u64 = int.widen(ranges[2 * i])
        let hi: u64 = int.widen(ranges[2 * i + 1])
        while lo <= hi {
            let n = utf8_width(lo)
            let last = rectangle_end(lo, hi, n)
            if states != 0 {
                states += 1
            }
            states += n
            if states > SIZE_LIMIT / 16 {
                return Error(TooBig(SIZE_LIMIT))
            }
            lo = last + 1
        }
        i += 1
    }
    Ok(shape(states, 0, false, true))
}

type Assembler {
    fw: List[NfaState],
    rv: List[NfaState],
    sparse_edges: List[NfaEdge],
    boundaries: Inline[bool, 257],
    rev: bool,
    ops_used: u64,
    edges_used: u64,
    has_look: bool,
    quit_non_ascii: bool,
    pref_node: u64,
    pref_start: u64
}

fn admit_states(n: u64) -> Result[List[NfaState], Error] {
    let admitted: Result[List[NfaState], Capacity] = list.with_capacity(n)
    let mut xs = match take admitted {
        Ok(take x) => take x,
        Error(e) => return Error(Capacity(e)),
    }
    match list.fill(mut xs, n, NfaState(op: 0, a: 0, b: 0, c: 0)) {
        Ok(()) => Ok(take xs),
        Error(e) => Error(Capacity(e)),
    }
}

fn admit_edges(n: u64) -> Result[List[NfaEdge], Error] {
    let admitted: Result[List[NfaEdge], Capacity] = list.with_capacity(n)
    let mut xs = match take admitted {
        Ok(take x) => take x,
        Error(e) => return Error(Capacity(e)),
    }
    match list.fill(mut xs, n, NfaEdge(lo: 0, hi: 0, target: 0)) {
        Ok(()) => Ok(take xs),
        Error(e) => Error(Capacity(e)),
    }
}

fn admit_u32(n: u64) -> Result[List[u32], Error] {
    let result: Result[List[u32], Capacity] = list.with_capacity(n)
    let mut xs = match take result {
        Ok(take x) => take x,
        Error(e) => return Error(Capacity(e)),
    }
    match list.fill(mut xs, n, 0) {
        Ok(()) => Ok(take xs),
        Error(e) => Error(Capacity(e)),
    }
}

fn admit_u8(n: u64) -> Result[Bytes, Error] {
    let result: Result[Bytes, Capacity] = list.with_capacity(n)
    let mut xs = match take result {
        Ok(take x) => take x,
        Error(e) => return Error(Capacity(e)),
    }
    match list.fill(mut xs, n, 0) {
        Ok(()) => Ok(take xs),
        Error(e) => Error(Capacity(e)),
    }
}

fn put_op(mut a: Assembler, i: u64, tag: u32, x: u32, y: u32, z: u32) {
    let state = NfaState(op: tag, a: x, b: y, c: z)
    if a.rev {
        a.rv[i] = state
    } else {
        a.fw[i] = state
    }
}

fn emit(mut a: Assembler, tag: u32, x: u64, y: u64, z: u64) -> u64 {
    let i = a.ops_used
    a.ops_used += 1
    put_op(mut a, i, tag, int.narrow(x), int.narrow(y), int.narrow(z))
    i
}

fn edge_bounds(mut a: Assembler, lower: u32, upper: u32) {
    a.boundaries[int.widen(lower)] = true
    a.boundaries[int.widen(upper + 1)] = true
}

fn emit_byte(mut a: Assembler, lo: u32, hi: u32, following: u64) -> u64 {
    edge_bounds(mut a, lo, hi)
    emit(mut a, OP_BYTE, int.widen(lo | (hi << 8)), following, 0)
}

fn emit_edge(mut a: Assembler, lo: u32, hi: u32, following: u64) {
    let i = a.edges_used
    a.edges_used += 1
    edge_bounds(mut a, lo, hi)
    a.sparse_edges[i] = NfaEdge(lo: lo, hi: hi, target: int.narrow(following))
}

fn emit_set(mut a: Assembler, ranges: List[u32], start: u64, end: u64, following: u64) -> u64 {
    if start == end {
        return emit(mut a, OP_DEAD, 0, 0, 0)
    }
    if ranges[2 * end - 1] < 128 {
        if end == start + 1 {
            return emit_byte(mut a, ranges[2 * start], ranges[2 * start + 1], following)
        }
        let offset = a.edges_used
        let mut i = start
        while i < end {
            emit_edge(mut a, ranges[2 * i], ranges[2 * i + 1], following)
            i += 1
        }
        return emit(mut a, OP_SPARSE, offset, end - start, 0)
    }
    let mut ascii: u64 = OFFSET_LIMIT
    let mut unicode: u64 = OFFSET_LIMIT
    let mut i = start
    while i < end {
        let mut lo: u64 = int.widen(ranges[2 * i])
        let hi: u64 = int.widen(ranges[2 * i + 1])
        while lo <= hi {
            let n = utf8_width(lo)
            let last = rectangle_end(lo, hi, n)
            let successor = emit_scalar(mut a, lo, last, n, following)
            if n == 1 {
                ascii = merge_disjoint(mut a, ascii, successor)
            } else {
                unicode = merge_disjoint(mut a, unicode, successor)
            }
            lo = last + 1
        }
        i += 1
    }
    if ascii == OFFSET_LIMIT {
        return unicode
    }
    // ASCII and multibyte sequences start with disjoint byte sets in both
    // directions. This choice replaces their epsilon split using one state.
    emit(mut a, OP_UTF8_CHOICE, ascii, unicode, 0)
}

fn merge_disjoint(mut a: Assembler, root: u64, successor: u64) -> u64 {
    if root == OFFSET_LIMIT {
        successor
    } else {
        emit(mut a, OP_SPLIT, root, successor, 0)
    }
}

fn emit_scalar(mut a: Assembler, lo: u64, hi: u64, n: u64, following: u64) -> u64 {
    let mut head = following
    let mut i: u64 = 0
    let rev = a.rev
    while i < n {
        let p = if rev {
            i
        } else {
            n - i - 1
        }
        head = emit_byte(mut a, byte_scalar(lo, n, p), byte_scalar(hi, n, p), head)
        i += 1
    }
    head
}

fn emit_assert(mut a: Assembler, n: Node, following: u64) -> u64 {
    a.has_look = true
    let modes = n.b
    if n.a == START_LINE || n.a == END_LINE {
        if (modes & MULTILINE) != 0 {
            edge_bounds(mut a, 10, 10)
            if (modes & CRLF) != 0 {
                edge_bounds(mut a, 13, 13)
            }
        }
    } else if n.a >= WORD {
        edge_bounds(mut a, 48, 57)
        edge_bounds(mut a, 65, 90)
        edge_bounds(mut a, 95, 95)
        edge_bounds(mut a, 97, 122)
        if (modes & UNICODE) != 0 {
            edge_bounds(mut a, 128, 255)
            a.quit_non_ascii = true
        }
    }
    emit(mut a, OP_ASSERT, n.a, modes, following)
}

fn ordered_split(mut a: Assembler, lazy: bool, first: u64, second: u64) -> u64 {
    if lazy {
        emit(mut a, OP_SPLIT, second, first, 0)
    } else {
        emit(mut a, OP_SPLIT, first, second, 0)
    }
}

fn emit_repeat(h: Hir, mut a: Assembler, n: Node, following: u64) -> u64 {
    let lazy = n.more != 0
    let mut begin = following
    let child = sized_atom(h, n.first, a.rev)
    let zero_width = match child {
        Ok(m) => m.can_empty && !m.can_consume,
        Error(_) => false,
    }
    let mut mandatory: u64 = if zero_width && n.a > 1 {
        1
    } else {
        n.a
    }
    let maximum: u64 = if zero_width && n.b > 1 {
        1
    } else {
        n.b
    }
    if maximum == UNBOUNDED {
        let loop_at = emit(mut a, OP_SPLIT, 0, 0, 0)
        let first = emit_atom(h, mut a, n.first, loop_at)
        let short = if lazy {
            following
        } else {
            first
        }
        let long = if lazy {
            first
        } else {
            following
        }
        put_op(mut a, loop_at, OP_SPLIT, int.narrow(short), int.narrow(long), 0)
        if mandatory == 0 {
            if nullable_atom(h, n.first) {
                return ordered_split(mut a, lazy, first, following)
            }
            return loop_at
        }
        mandatory -= 1
        begin = first
    } else {
        let mut remaining = maximum - mandatory
        while remaining != 0 {
            let first = emit_atom(h, mut a, n.first, begin)
            begin = ordered_split(mut a, lazy, first, following)
            remaining -= 1
        }
    }
    while mandatory != 0 {
        begin = emit_atom(h, mut a, n.first, begin)
        mandatory -= 1
    }
    begin
}

fn nullable_atom(h: Hir, i: u64) -> bool {
    let n = read(h.nodes, i)
    if n.kind == EMPTY || n.kind == ASSERT {
        return true
    }
    if n.kind == REPEAT {
        return n.a == 0 || nullable_atom(h, n.first)
    }
    if n.kind == CAPTURE || n.kind == SCOPED {
        let mut arm = i
        loop {
            let branch = read(h.nodes, arm)
            let mut at = branch.first
            while at != 0 && nullable_atom(h, at) {
                at = read(h.nodes, at).successor
            }
            if at == 0 {
                return true
            }
            if branch.more == 0 {
                return false
            }
            arm = branch.more
        }
    }
    false
}

fn emit_atom(h: Hir, mut a: Assembler, i: u64, following: u64) -> u64 {
    let n = read(h.nodes, i)
    if n.kind == EMPTY {
        return following
    }
    if n.kind == LITERAL {
        return emit_scalar(mut a, n.a, n.a, utf8_width(n.a), following)
    }
    if n.kind == CHAR_SET {
        return emit_set(mut a, h.ranges, n.a, n.b, following)
    }
    if n.kind == ASSERT {
        return emit_assert(mut a, n, following)
    }
    if n.kind == REPEAT {
        return emit_repeat(h, mut a, n, following)
    }
    if n.kind == CAPTURE && !a.rev {
        let end = emit(mut a, OP_SAVE, n.a, following, 1)
        let inner = emit_alts(h, mut a, i, end)
        return emit(mut a, OP_SAVE, n.a, inner, 0)
    }
    emit_alts(h, mut a, i, following)
}

fn sequence_entry(h: Hir, first: u64, rev: bool) -> u64 {
    if rev || first == 0 {
        first
    } else {
        chain_end(h.nodes, first, false)
    }
}

fn emit_seq(h: Hir, mut a: Assembler, first: u64, following: u64) -> u64 {
    let rev = a.rev
    let mut result = following
    let mut at = sequence_entry(h, first, rev)
    while at != 0 {
        if rev && at == a.pref_node {
            a.pref_start = result
        }
        result = emit_atom(h, mut a, at, result)
        let n = read(h.nodes, at)
        at = if rev {
            n.successor
        } else {
            n.end
        }
    }
    result
}

fn emit_alts(h: Hir, mut a: Assembler, first: u64, following: u64) -> u64 {
    let root = read(h.nodes, first)
    if root.more == 0 {
        return emit_seq(h, mut a, root.first, following)
    }
    let rev = a.rev
    if disjoint_literals(h.nodes, first, rev) {
        let offset = a.edges_used
        let mut at = first
        loop {
            let branch = read(h.nodes, at)
            let mut i = sequence_entry(h, branch.first, rev)
            let mut target = following
            let mut n = read(h.nodes, i)
            let mut successor = if rev {
                n.successor
            } else {
                n.end
            }
            while successor != 0 {
                target = emit_atom(h, mut a, i, target)
                i = successor
                n = read(h.nodes, i)
                successor = if rev {
                    n.successor
                } else {
                    n.end
                }
            }
            let ch: u32 = int.narrow(n.a)
            emit_edge(mut a, ch, ch, target)
            if branch.more == 0 {
                break
            }
            at = branch.more
        }
        let total_count = a.edges_used - offset
        return emit(mut a, OP_SPARSE, offset, total_count, 0)
    }
    let mut at = chain_end(h.nodes, first, true)
    let mut start = emit_seq(h, mut a, read(h.nodes, at).first, following)
    while at != first {
        at = read(h.nodes, at).end
        let branch = emit_seq(h, mut a, read(h.nodes, at).first, following)
        start = emit(mut a, OP_SPLIT, branch, start, 0)
    }
    start
}

fn link_backwards(mut xs: List[Node]) {
    let mut i: u64 = 0
    while i < list.len(xs) {
        let n = read(xs, i)
        if n.kind == ROOT || n.kind == ARM || n.kind == CAPTURE || n.kind == SCOPED {
            let mut previous: u64 = 0
            let mut child = n.first
            while child != 0 {
                xs[child].end = previous
                previous = child
                child = read(xs, child).successor
            }
            if n.more != 0 {
                xs[n.more].end = i
            }
        }
        i += 1
    }
}

type NameLayout: key {
    total_count: u64,
    length: u64
}

fn names_atom(h: Hir, i: u64, mut ns: NameLayout) {
    let n = read(h.nodes, i)
    if n.kind == REPEAT {
        names_atom(h, n.first, mut ns)
    } else if n.kind == CAPTURE || n.kind == SCOPED {
        if n.kind == CAPTURE && n.b != 0 {
            ns.total_count += 1
            ns.length += n.end - 1 - n.b
        }
        names_size(h, i, mut ns)
    }
}

fn names_size(h: Hir, i: u64, mut ns: NameLayout) {
    let mut al = i
    loop {
        let arm = read(h.nodes, al)
        let mut at = arm.first
        while at != 0 {
            names_atom(h, at, mut ns)
            at = read(h.nodes, at).successor
        }
        if arm.more == 0 {
            break
        }
        al = arm.more
    }
}

type NameTable {
    index: List[u32],
    text: Bytes,
    pos: u64,
    slot: u64
}

fn write_name_atom(p: String, h: Hir, i: u64, mut ns: NameTable) {
    let n = read(h.nodes, i)
    if n.kind == REPEAT {
        write_name_atom(p, h, n.first, mut ns)
    } else if n.kind == CAPTURE || n.kind == SCOPED {
        if n.kind == CAPTURE && n.b != 0 {
            for j in n.b .. (n.end - 1) {
                ns.text[ns.pos] = byte(p, j)
                ns.pos += 1
            }
            ns.index[2 * ns.slot] = int.narrow(n.a)
            ns.index[2 * ns.slot + 1] = int.narrow(ns.pos)
            ns.slot += 1
        }
        write_names(p, h, i, mut ns)
    }
}

fn write_names(p: String, h: Hir, i: u64, mut ns: NameTable) {
    let mut al = i
    loop {
        let arm = read(h.nodes, al)
        let mut at = arm.first
        while at != 0 {
            write_name_atom(p, h, at, mut ns)
            at = read(h.nodes, at).successor
        }
        if arm.more == 0 {
            break
        }
        al = arm.more
    }
}

const NO_PREFILTER: u32 = 0

const MEMCHR: u32 = 1

const MEMMEM: u32 = 2

const TEDDY: u32 = 3

const REVERSE_SUFFIX: u32 = 4

const REVERSE_INNER: u32 = 5

const MAX_LITERALS: u64 = 250

const SHARED_LITERAL_WIDTH: u64 = 8

const MAX_LITERAL_WIDTH: u64 = 100

type Needle: key {
    items: Inline[u8, 8],
    width: u8,
    exact: bool
}

type Needles: key {
    values: Inline[Needle, 250],
    linear: Inline[u8, 100],
    end: u64,
    full: bool
}

type Prefilter: key {
    kind: u32,
    width: u64,
    literals: u64,
    rare_a: u64,
    rare_b: u64,
    bytes_count: u64,
    reverse_prev: Option[u8],
    node_id: u64
}

fn no_prefilter() -> Prefilter {
    Prefilter(kind: NO_PREFILTER, width: 0, literals: 0, rare_a: 0, rare_b: 0, bytes_count: 0, reverse_prev: None, node_id: 0)
}

fn blank_needle() -> Needle {
    Needle(items:[0; 8], width: 0, exact: true)
}

fn needle_width(needle: Needle) -> u64 {
    int.widen(needle.width)
}

fn truncate_needle(mut needle: Needle, width: u64) {
    if needle_width(needle) > width {
        needle.width = int.narrow(width)
        needle.exact = false
    }
}

fn append_scalar(mut needle: Needle, ch: u64) {
    if !needle.exact {
        return
    }
    let width = utf8_width(ch)
    for i in 0u64 .. width {
        if needle_width(needle) == SHARED_LITERAL_WIDTH {
            needle.exact = false
            break
        }
        needle.items[needle_width(needle)] = int.narrow(byte_scalar(ch, width, i))
        needle.width += 1
    }
}

fn close_needles(mut needles: Needles, first: u64) {
    for i in first .. needles.end {
        needles.values[i].exact = false
    }
}

fn any_exact(needles: Needles, first: u64) -> bool {
    for i in first .. needles.end {
        if needles.values[i].exact {
            return true
        }
    }
    false
}

fn extract_class(h: Hir, n: Node, mut needles: Needles, first: u64, max_end: u64) {
    let old_width = needles.end - first
    let mut items: Inline[u64, 10] =[0; 10]
    let mut used: u64 = 0
    for i in n.a .. n.b {
        let lo: u64 = int.widen(h.ranges[2 * i])
        let hi: u64 = int.widen(h.ranges[2 * i + 1])
        if hi - lo + 1 > 10 - used {
            close_needles(mut needles, first)
            return
        }
        for ch in lo .. (hi + 1) {
            items[used] = ch
            used += 1
        }
    }
    if used == 0 || old_width * used > max_end - first {
        close_needles(mut needles, first)
        return
    }
    let mut i = old_width
    while i != 0 {
        i -= 1
        let seed = needles.values[first + i]
        let dst = first + i * used
        for j in 0u64 .. used {
            needles.values[dst + j] = seed
            append_scalar(mut needles.values[dst + j], items[j])
        }
    }
    needles.end = first + old_width * used
}

fn extract_atom(h: Hir, id: u64, mut needles: Needles, first: u64, max_end: u64) {
    let n = read(h.nodes, id)
    if n.kind == LITERAL {
        for i in first .. needles.end {
            append_scalar(mut needles.values[i], n.a)
        }
    } else if n.kind == CHAR_SET {
        extract_class(h, n, mut needles, first, max_end)
    } else if n.kind == REPEAT {
        // A zero-minimum repetition preserves the prefix accumulated so far.
        // Its skip path can continue, but that prefix alone remains mandatory.
        let mut i: u64 = 0
        while i < n.a && i < 10 && any_exact(needles, first) {
            extract_atom(h, n.first, mut needles, first, max_end)
            i += 1
        }
        if n.a != n.b || n.a > 10 {
            close_needles(mut needles, first)
        }
    } else if n.kind == CAPTURE || n.kind == SCOPED {
        if n.more == 0 {
            extract_sequence(h, n.first, mut needles, first, max_end)
        } else {
            // The caller's prefix survives every nested alternative.
            close_needles(mut needles, first)
        }
    }
}

fn extract_sequence(h: Hir, first_atom: u64, mut needles: Needles, first: u64, max_end: u64) {
    let mut node_id = first_atom
    while node_id != 0 && any_exact(needles, first) {
        extract_atom(h, node_id, mut needles, first, max_end)
        node_id = read(h.nodes, node_id).successor
    }
}

fn extract_prefixes(h: Hir, mut needles: Needles) {
    let mut tail = read(h.nodes, 0).more
    let mut branches: u64 = 1
    while tail != 0 && branches <= MAX_LITERALS {
        branches += 1
        tail = read(h.nodes, tail).more
    }
    if branches > MAX_LITERALS {
        needles.full = true
        return
    }
    // Split the fixed arena among arms so each contributes at least one prefix.
    let per_arm = MAX_LITERALS / branches
    let mut arm: u64 = 0
    loop {
        let start = needles.end
        needles.values[start] = blank_needle()
        needles.end += 1
        let n = read(h.nodes, arm)
        extract_sequence(h, n.first, mut needles, start, start + per_arm)
        if n.more == 0 {
            break
        }
        arm = n.more
    }
}

fn same_head(a: Needle, b: Needle, width: u64) -> bool {
    for i in 0u64 .. width {
        if a.items[i] != b.items[i] {
            return false
        }
    }
    true
}

fn dedup_needles(mut needles: Needles) {
    let mut keep: u64 = 0
    for i in 0u64 .. needles.end {
        let x = needles.values[i]
        let mut j: u64 = 0
        while j < keep {
            let y = needles.values[j]
            if x.width == y.width && same_head(x, y, needle_width(x)) {
                break
            }
            j += 1
        }
        if j == keep {
            needles.values[keep] = x
            keep += 1
        }
    }
    needles.end = keep
}

fn trim_needles(mut needles: Needles, width: u64) {
    for i in 0u64 .. needles.end {
        truncate_needle(mut needles.values[i], width)
    }
    dedup_needles(mut needles)
}

fn common_literal_prefix(needles: Needles) -> u64 {
    let first = needles.values[0]
    let mut width = needle_width(first)
    for i in 1u64 .. needles.end {
        let current = needles.values[i]
        let other = needle_width(current)
        let max = if other < width {
            other
        } else {
            width
        }
        let mut same: u64 = 0
        while same < max && first.items[same] == current.items[same] {
            same += 1
        }
        width = same
    }
    width
}

fn byte_rank(ch: u8) -> u8 {
    PREFILTER_RANK[int.widen(ch)]
}

fn rare_pair(needle: Needle) -> (u64, u64) {
    let mut a: u64 = 0
    let mut b: u64 = 1
    if byte_rank(needle.items[b]) < byte_rank(needle.items[a]) {
        a = 1
        b = 0
    }
    for i in 2u64 .. needle_width(needle) {
        let rank = byte_rank(needle.items[i])
        if rank < byte_rank(needle.items[a]) {
            b = a
            a = i
        } else if rank < byte_rank(needle.items[b]) {
            b = i
        }
    }
    (a, b)
}

fn choose_prefix(mut needles: Needles) -> Prefilter {
    if needles.full || needles.end == 0 {
        return no_prefilter()
    }
    let mut min_width = needle_width(needles.values[0])
    for i in 1u64 .. needles.end {
        let width = needle_width(needles.values[i])
        if width < min_width {
            min_width = width
        }
    }
    if min_width == 0 {
        return no_prefilter()
    }
    dedup_needles(mut needles)
    let common = common_literal_prefix(needles)
    if needles.end > 1 && common > 0 && common <= 3 && byte_rank(needles.values[0].items[0]) < 200 {
        trim_needles(mut needles, 1)
    } else if common > 4 || (common > 1 && needles.end > 16) {
        trim_needles(mut needles, common)
    } else {
        let attempts: Inline[(u64, u64), 5] =[(5, 10), (4, 10), (3, 64), (2, 64), (1, 10)]
        for (keep, limit) in attempts {
            if needles.end <= limit {
                break
            }
            trim_needles(mut needles, keep)
        }
    }
    if needles.end == 1 {
        let needle = needles.values[0]
        if needle.width == 1 {
            return Prefilter(kind: MEMCHR, width: 1, literals: 1, rare_a: 0, rare_b: 0, bytes_count: 1, reverse_prev: None, node_id: 0)
        }
        let (rare_a, rare_b) = rare_pair(needle)
        return Prefilter(kind: MEMMEM, width: needle_width(needle), literals: 1, rare_a: rare_a, rare_b: rare_b, bytes_count: needle_width(needle), reverse_prev: None, node_id: 0)
    }
    if min_width == 1 || needles.values[0].width == 1 {
        trim_needles(mut needles, 1)
        if needles.end <= 3 {
            return Prefilter(kind: MEMCHR, width: 1, literals: needles.end, rare_a: 0, rare_b: 0, bytes_count: needles.end, reverse_prev: None, node_id: 0)
        }
        return no_prefilter()
    }
    if needles.end > 64 {
        return no_prefilter()
    }
    let mut width: u64 = 4
    for i in 0u64 .. needles.end {
        let other = needle_width(needles.values[i])
        if other < width {
            width = other
        }
    }
    trim_needles(mut needles, width)
    Prefilter(kind: TEDDY, width: width, literals: needles.end, rare_a: 0, rare_b: 0, bytes_count: width * (32 + needles.end), reverse_prev: None, node_id: 0)
}

fn mark_ascii(mut seen: Inline[bool, 128], lo: u64, hi: u64) {
    if lo >= 128 {
        return
    }
    let end: u64 = if hi >= 127 {
        128
    } else {
        hi + 1
    }
    for c in lo .. end {
        seen[c] = true
    }
}

fn possible_ascii(h: Hir, id: u64, mut seen: Inline[bool, 128]) {
    let n = read(h.nodes, id)
    if n.kind == LITERAL {
        if n.a < 128 {
            seen[n.a] = true
        }
    } else if n.kind == CHAR_SET {
        for i in n.a .. n.b {
            mark_ascii(mut seen, int.widen(h.ranges[2 * i]), int.widen(h.ranges[2 * i + 1]))
        }
    } else if n.kind == REPEAT {
        possible_ascii(h, n.first, mut seen)
    } else if n.kind == CAPTURE || n.kind == SCOPED {
        let mut arm = id
        loop {
            let branch = read(h.nodes, arm)
            let mut node_id = branch.first
            while node_id != 0 {
                possible_ascii(h, node_id, mut seen)
                node_id = read(h.nodes, node_id).successor
            }
            if branch.more == 0 {
                break
            }
            arm = branch.more
        }
    }
}

fn choose_reverse(h: Hir, mut needles: Needles) -> Prefilter {
    let root = read(h.nodes, 0)
    if root.more != 0 {
        return no_prefilter()
    }
    let first = read(h.nodes, root.first)
    if first.kind == ASSERT && (first.a == START_TEXT || (first.a == START_LINE && (first.b & MULTILINE) == 0)) {
        return no_prefilter()
    }
    let mut seen: Inline[bool, 128] =[false; 128]
    let mut last: u64 = 0
    let mut previous: Option[u8] = None
    let mut needle_previous: Option[u8] = None
    let mut freq: u8 = 255
    let mut node_id = root.first
    while node_id != 0 {
        let n = read(h.nodes, node_id)
        if node_id != root.first && n.kind == LITERAL && n.a < 128 && !seen[n.a] {
            let value = PREFILTER_RANK[n.a]
            if last == 0 || value < freq || n.successor == 0 {
                last = node_id
                needle_previous = previous
                freq = value
            }
        }
        possible_ascii(h, node_id, mut seen)
        previous = if n.kind == LITERAL && n.a < 128 {
            Some(int.narrow(n.a))
        } else {
            None
        }
        node_id = n.successor
    }
    if last == 0 {
        return no_prefilter()
    }
    let n = read(h.nodes, last)
    needles.values[0] = blank_needle()
    append_scalar(mut needles.values[0], n.a)
    needles.end = 1
    Prefilter(kind: if n.successor == 0 {
        REVERSE_SUFFIX
    } else {
        REVERSE_INNER
    }, width: 1, literals: 1, rare_a: 0, rare_b: 0, bytes_count: 1, reverse_prev: needle_previous, node_id: last)
}

// A single mandatory prefix can keep the extractor's full width. Multiple
// prefixes share a smaller buffer because only their first lanes select Teddy.
fn linear_atom(h: Hir, id: u64, mut output: Inline[u8, 100], mut width: u64) -> bool {
    let n = read(h.nodes, id)
    if n.kind == LITERAL {
        let scalar_width = utf8_width(n.a)
        for offset in 0u64 .. scalar_width {
            if width == MAX_LITERAL_WIDTH {
                return false
            }
            output[width] = int.narrow(byte_scalar(n.a, scalar_width, offset))
            width += 1
        }
        return true
    }
    if n.kind == CAPTURE || n.kind == SCOPED {
        return n.more == 0 && linear_sequence(h, n.first, mut output, mut width)
    }
    if n.kind == REPEAT {
        let mut repeated: u64 = 0
        while repeated < n.a && repeated < 10 {
            if !linear_atom(h, n.first, mut output, mut width) {
                return false
            }
            repeated += 1
        }
        return repeated == n.a && n.a == n.b
    }
    n.kind == EMPTY || n.kind == ASSERT
}

fn linear_sequence(h: Hir, id: u64, mut output: Inline[u8, 100], mut width: u64) -> bool {
    let mut at = id
    while at != 0 {
        if !linear_atom(h, at, mut output, mut width) {
            return false
        }
        at = read(h.nodes, at).successor
    }
    true
}

fn linear_pair(output: Inline[u8, 100], width: u64) -> (u64, u64) {
    let mut a: u64 = 0
    let mut b: u64 = 1
    if byte_rank(output[b]) < byte_rank(output[a]) {
        a = 1
        b = 0
    }
    for i in 2u64 .. width {
        let rank = byte_rank(output[i])
        if rank < byte_rank(output[a]) {
            b = a
            a = i
        } else if rank < byte_rank(output[b]) {
            b = i
        }
    }
    (a, b)
}

fn choose_prefilter(h: Hir, mut needles: Needles) -> Prefilter {
    let root = read(h.nodes, 0)
    if root.more == 0 {
        let mut width: u64 = 0
        let _ = linear_sequence(h, root.first, mut needles.linear, mut width)
        if width > SHARED_LITERAL_WIDTH {
            let (a, b) = linear_pair(needles.linear, width)
            return Prefilter(kind: MEMMEM, width: width, literals: 1, rare_a: a, rare_b: b, bytes_count: width, reverse_prev: None, node_id: 0)
        }
    }
    extract_prefixes(h, mut needles)
    let p = choose_prefix(mut needles)
    if p.kind == NO_PREFILTER {
        choose_reverse(h, mut needles)
    } else {
        p
    }
}

fn write_prefilter(mut table: Bytes, p: Prefilter, needles: Needles) {
    if p.kind == TEDDY {
        for i in 0u64 .. p.literals {
            let shift: u8 = int.narrow(i % 8)
            let bit: u8 = 1 << shift
            for j in 0u64 .. p.width {
                let ch = needles.values[i].items[j]
                let low: u64 = int.widen(ch & 15)
                let high: u64 = int.widen(ch >> 4)
                table[32 * j + low] |= bit
                table[32 * j + 16 + high] |= bit
                table[32 * p.width + i * p.width + j] = ch
            }
        }
    } else if p.kind == MEMCHR {
        for i in 0u64 .. p.literals {
            table[i] = needles.values[i].items[0]
        }
    } else if p.width > SHARED_LITERAL_WIDTH {
        for i in 0u64 .. p.width {
            table[i] = needles.linear[i]
        }
    } else {
        for i in 0u64 .. p.width {
            table[i] = needles.values[0].items[i]
        }
    }
}

pub fn new(pattern: String) -> Result[Regex, Error] {
    let hir = compile_hir(pattern)?
    compile_new(pattern, take hir)
}

// One mandatory capture with fixed-width neighbors is determined by the
// whole match. Its body can still contain choices and repetitions.
fn fixed_capture_offsets(h: Hir, highest_group: u64) -> Option[CaptureOffsets] {
    let root = read(h.nodes, 0)
    if highest_group != 1 || root.more != 0 {
        return None
    }
    let mut prefix: u64 = 0
    let mut suffix: u64 = 0
    let mut found = false
    let mut id = root.first
    while id != 0 {
        let n = read(h.nodes, id)
        if n.kind == LITERAL {
            let width = utf8_width(n.a)
            if found {
                suffix += width
            } else {
                prefix += width
            }
        } else if n.kind == CAPTURE && n.a == 1 && !found {
            found = true
        } else {
            return None
        }
        id = n.successor
    }
    if found {
        Some(CaptureOffsets(prefix: prefix, suffix: suffix))
    } else {
        None
    }
}

fn compile_new(pattern: String, take input_hir: Hir) -> Result[Regex, Error] {
    let mut hir = take input_hir
    let f = sized_alts(hir, 0, false)?
    let r = sized_alts(hir, 0, true)?
    let nf = FORWARD_BASE + f.states
    let nr = REVERSE_BASE + r.states
    let offsets = fixed_capture_offsets(hir, f.pgroup)
    let mut candidates = Needles(values:[Needle(items:[0; 8], width: 0, exact: false); 250], linear:[0; 100], end: 0, full: false)
    let plan = choose_prefilter(hir, mut candidates)
    let mut ns = NameLayout(total_count: 0, length: 0)
    names_size(hir, 0, mut ns)
    let charge = check_size(nf, nr, f.edges + r.edges, ns.total_count, ns.length, plan.bytes_count)?
    let forward = admit_states(nf)?
    let reverse = admit_states(nr)?
    let edges = admit_edges(f.edges + r.edges)?
    let mut map = admit_u8(256)?
    let index = admit_u32(2 * ns.total_count)?
    let text = admit_u8(ns.length)?
    let mut pref = admit_u8(plan.bytes_count)?
    write_prefilter(mut pref, plan, candidates)
    let mut metadata = NameTable(index: take index, text: take text, pos: 0, slot: 0)
    write_names(pattern, hir, 0, mut metadata)
    link_backwards(mut hir.nodes)
    let mut a = Assembler(fw: take forward, rv: take reverse, sparse_edges: take edges, boundaries:[false; 257], rev: false, ops_used: 0, edges_used: 0, has_look: false, quit_non_ascii: false, pref_node: plan.node_id, pref_start: 0)
    let end = emit(mut a, OP_MATCH, 0, 0, 0)
    let save_end = emit(mut a, OP_SAVE, 0, end, 1)
    let body = emit_alts(hir, mut a, 0, save_end)
    let anchored = emit(mut a, OP_SAVE, 0, body, 0)
    let skip_at = a.ops_used + 1
    let unanchored = emit(mut a, OP_SPLIT, anchored, skip_at, 0)
    let _ = emit_byte(mut a, 0, 255, unanchored)
    a.rev = true
    a.ops_used = 0
    let rev_end = emit(mut a, OP_MATCH, 0, 0, 0)
    let anchored_r = emit_alts(hir, mut a, 0, rev_end)
    let skip_r = a.ops_used + 1
    let unanchored_r = emit(mut a, OP_SPLIT, anchored_r, skip_r, 0)
    let _ = emit_byte(mut a, 0, 255, unanchored_r)
    let mut classes: u64 = 0
    let mut b: u64 = 0
    while b < 256 {
        if a.boundaries[b] {
            classes += 1
        }
        map[b] = int.narrow(classes - 1)
        b += 1
    }
    let Assembler(fw: take f_program, rv: take r_program, sparse_edges: take transitions, has_look: has_look, quit_non_ascii: quit, pref_start: pre_reverse, ..) = take a
    let NameTable(index: take name_index, text: take name_text, ..) = take metadata
    Ok(Regex(owner: unique.new(), forward: take f_program, reverse: take r_program, edges: take transitions, class_map: take map, names: take name_index, name_text: take name_text, prefilter: take pref, pref_plan: plan, pref_reverse_start: pre_reverse, charge: charge, group_count: f.pgroup + 1, capture_offsets: offsets, class_count: classes, start: unanchored, reverse_start: anchored_r, can_empty: f.can_empty, has_look: has_look, quit_non_ascii: quit))
}

const ABSENT: u64 = 0xFFFFFFFFFFFFFFFF

fn read_slot(work: List[u32], i: u64) -> u64 {
    let lo: u64 = int.widen(work[i])
    let hi: u64 = int.widen(work[i + 1])
    (hi << 32) | lo
}

fn store_slot(mut work: List[u32], i: u64, value: u64) {
    work[i] = int.narrow(value & OFFSET_LIMIT)
    work[i + 1] = int.narrow(value >> 32)
}

fn copy_slots(mut work: List[u32], dest: u64, src: u64, slots: u64) {
    let mut i: u64 = 0
    while i < 2 * slots {
        work[dest + i] = work[src + i]
        i += 1
    }
}

fn clear_slots(mut work: List[u32], first: u64, slots: u64) {
    let mut i: u64 = 0
    while i < 2 * slots {
        work[first + i] = 0xFFFFFFFF
        i += 1
    }
}

fn boundary(s: String, at: u64) -> bool {
    at == string.byte_len(s) || (byte(s, at) & 0xC0) != 0x80
}

fn ascii_word(c: u8) -> bool {
    int.is_ascii_alpha(c) || int.is_ascii_digit(c) || c == b'_'
}

fn unicode_word(s: String, at: u64) -> bool {
    let (ch, _) = scalar(s, at)
    table_contains(WORD_LO, WORD_HI, ch)
}

fn assertion(kind: u64, mode: u64, s: String, at: u64) -> bool {
    let width = string.byte_len(s)
    if kind == START_TEXT {
        return at == 0
    }
    if kind == END_TEXT {
        return at == width
    }
    let prev: u8 = if at != 0 {
        byte(s, at - 1)
    } else {
        0
    }
    let successor: u8 = if at != width {
        byte(s, at)
    } else {
        0
    }
    if kind == START_LINE || kind == END_LINE {
        let crlf = (mode & CRLF) != 0
        let lines = (mode & MULTILINE) != 0
        if kind == START_LINE {
            return at == 0 || (lines && (prev == 10 || (crlf && prev == 13 && successor != 10)))
        }
        return at == width || (lines && ((successor == 10 && (!crlf || prev != 13)) || (crlf && successor == 13)))
    }
    let mut left = ascii_word(prev)
    let mut right = ascii_word(successor)
    if (mode & UNICODE) != 0 {
        if !boundary(s, at) {
            return false
        }
        if at != 0 {
            let mut before = at - 1
            while !boundary(s, before) {
                before -= 1
            }
            left = unicode_word(s, before)
        }
        if at != width {
            right = unicode_word(s, at)
        }
    }
    match kind {
        5 => left != right,
        6 => left == right,
        7 => !left && right,
        8 => left && !right,
        9 => !left,
        _ => !right,
    }
}

type Frontier: key {
    offset: u64,
    extent: u64,
    ready: u64
}

fn slot_row(f: Frontier, capacity: u64, slots: u64, rank: u64) -> u64 {
    f.offset + 2 * capacity + 2 * slots * rank
}

type Pike: key {
    width: u64,
    slots: u64,
    row: u64,
    saved: u64,
    stack: u64
}

fn pike_config(re: Regex, c: Cache, groups_wanted: u64) -> Pike {
    Pike(width: list.len(re.forward), slots: 2 * groups_wanted, row: c.slices.row, saved: c.slices.saved, stack: c.slices.stack)
}

fn closure(re: Regex, flow: Pike, mut work: List[u32], mut into: Frontier, s: String, at: u64, entry: u64) {
    let mut filled: u64 = 1
    work[flow.stack] = 0
    work[flow.stack + 1] = int.narrow(entry)
    while filled != 0 {
        filled -= 1
        let head = flow.stack + 4 * filled
        let mode = work[head]
        if mode != 0 {
            let hi: u64 = int.widen(mode - 1)
            let lo: u64 = int.widen(work[head + 1])
            let value = read_slot(work, head + 2)
            store_slot(mut work, flow.row + 2 * ((hi << 32) | lo), value)
        } else {
            let mut state: u64 = int.widen(work[head + 1])
            loop {
                let rank: u64 = int.widen(work[into.offset + flow.width + state])
                let id: u32 = int.narrow(state)
                if rank < into.extent && work[into.offset + rank] == id {
                    break
                }
                let inst = re.forward[state]
                let op = inst.op
                let left: u64 = int.widen(inst.a)
                let right: u64 = int.widen(inst.b)
                let third: u64 = int.widen(inst.c)
                if op == OP_BYTE || op == OP_SPARSE || op == OP_MATCH {
                    // Keep consuming and match states first in priority order.
                    // The remaining dense entries deduplicate epsilon paths.
                    let position = into.ready
                    if position < into.extent {
                        let displaced = work[into.offset + position]
                        let displaced_id: u64 = int.widen(displaced)
                        work[into.offset + into.extent] = displaced
                        work[into.offset + flow.width + displaced_id] = int.narrow(into.extent)
                    }
                    work[into.offset + position] = id
                    work[into.offset + flow.width + state] = int.narrow(position)
                    into.ready += 1
                    into.extent += 1
                    copy_slots(mut work, slot_row(into, flow.width, flow.slots, position), flow.row, flow.slots)
                    break
                }
                work[into.offset + into.extent] = id
                work[into.offset + flow.width + state] = int.narrow(into.extent)
                into.extent += 1
                if op == OP_SPLIT {
                    let pending = flow.stack + 4 * filled
                    work[pending] = 0
                    work[pending + 1] = int.narrow(right)
                    filled += 1
                    state = left
                } else if op == OP_UTF8_CHOICE {
                    if at == string.byte_len(s) {
                        break
                    }
                    state = if byte(s, at) < 128 {
                        left
                    } else {
                        right
                    }
                } else if op == OP_SAVE {
                    let slot = 2 * left + third
                    if slot < flow.slots {
                        let pending = flow.stack + 4 * filled
                        work[pending] = int.narrow((slot >> 32) + 1)
                        work[pending + 1] = int.narrow(slot & OFFSET_LIMIT)
                        let old = read_slot(work, flow.row + 2 * slot)
                        store_slot(mut work, pending + 2, old)
                        store_slot(mut work, flow.row + 2 * slot, at)
                        filled += 1
                    }
                    state = right
                } else if op == OP_ASSERT && assertion(left, right, s, at) {
                    state = third
                } else {
                    break
                }
            }
        }
    }
}

fn nfa_advance(inst: NfaState, edges: List[NfaEdge], ch: u32) -> Option[u64] {
    if inst.op == OP_BYTE {
        let interval = inst.a
        if (interval & 255) <= ch && ch <= (interval >> 8) {
            return Some(int.widen(inst.b))
        }
    } else if inst.op == OP_SPARSE {
        let start: u64 = int.widen(inst.a)
        let len: u64 = int.widen(inst.b)
        for j in start .. (start + len) {
            let edge = edges[j]
            if edge.lo <= ch && ch <= edge.hi {
                return Some(int.widen(edge.target))
            }
        }
    }
    None
}

fn pike_search(re: Regex, mut c: Cache, s: String, at: u64, width: u64, entry: u64, groups_wanted: u64) -> Option[Match] {
    let flow = pike_config(re, c, groups_wanted)
    let mut now = Frontier(offset: c.slices.front, extent: 0, ready: 0)
    let mut later = Frontier(offset: c.slices.back, extent: 0, ready: 0)
    let mut pos = at
    let mut found: Option[Match] = None
    clear_slots(mut c.work, flow.row, flow.slots)
    closure(re, flow, mut c.work, mut now, s, pos, entry)
    while now.ready != 0 {
        let mut rank: u64 = 0
        let ch: u32 = if pos < width {
            int.widen(byte(s, pos))
        } else {
            0
        }
        while rank < now.ready {
            let state: u64 = int.widen(c.work[now.offset + rank])
            let row = slot_row(now, flow.width, flow.slots, rank)
            let inst = re.forward[state]
            if inst.op == OP_MATCH {
                if boundary(s, pos) {
                    let lo = read_slot(c.work, row)
                    let hi = read_slot(c.work, row + 2)
                    found = Some(Match(start: lo, end: hi))
                    copy_slots(mut c.work, flow.saved, row, flow.slots)
                    break
                }
            } else if pos < width {
                match nfa_advance(inst, re.edges, ch) {
                    Some(successor) => {
                        copy_slots(mut c.work, flow.row, row, flow.slots)
                        closure(re, flow, mut c.work, mut later, s, pos + 1, successor)
                    },
                    None => {},
                }
            }
            rank += 1
        }
        if pos == width {
            break
        }
        let previous_offset = now.offset
        now = later
        later = Frontier(offset: previous_offset, extent: 0, ready: 0)
        pos += 1
    }
    found
}

const DFA_UNKNOWN: u32 = 0xFFFFFFFF

const DFA_MATCH: u32 = 0x80000000

// Targets fit below bit 30 when the state ids' exclusive limit
// (states * columns) is at most 2^30. Larger caches keep the full target
// field and inspect the start key.
const DFA_START: u32 = 0x40000000

const DFA_TARGET: u32 = 0x7FFFFFFF

const DFA_TARGET_LIMIT: u64 = 0x7FFFFFFF

const DFA_DEAD: u32 = 0

const DFA_INPUT_END: u64 = 256

const DFA_EDGE: u32 = 0

const DFA_OTHER: u32 = 1

const DFA_WORD: u32 = 2

const DFA_LF: u32 = 3

const DFA_CR: u32 = 4

type DfaLayout: key {
    header: u64,
    starts: u64,
    states: u64,
    columns: u64,
    transitions: u64,
    spans: u64,
    hash: u64,
    keys: u64,
    scratch: u64,
    width: u64,
    has_look: bool,
    start_bit: u32,
    start_entry: u32,
    reverse: bool,
}

fn dfa_layout(re: Regex, c: Cache, reverse: bool) -> DfaLayout {
    let nf = list.len(re.forward)
    let nr = list.len(re.reverse)
    let s = c.slices.states
    let columns = re.class_count + 1
    let table = s * (columns + 20)
    let base = if reverse {
        24 + table
    } else {
        24
    }
    let scratch = 24 + 2 * table
    DfaLayout(header: if reverse {
        7
    } else {
        2
    }, starts: if reverse {
        18
    } else {
        12
    }, states: s, columns: columns, transitions: base, spans: base + s * columns, hash: base + s * (columns + 2), keys: base + s * (columns + 4), scratch: if reverse {
        scratch + 3 * nf
    } else {
        scratch
    }, width: if reverse {
        nr
    } else {
        nf
    }, has_look: re.has_look, start_bit: if !reverse && re.pref_plan.kind != NO_PREFILTER && re.pref_plan.kind < REVERSE_SUFFIX && s * columns <= 0x40000000 {
        DFA_START
    } else {
        0
    }, start_entry: int.narrow(re.start), reverse: reverse,)
}

fn dfa_context(ch: u64) -> u32 {
    if ch == DFA_INPUT_END {
        return DFA_EDGE
    }
    if ch == 10 {
        return DFA_LF
    }
    if ch == 13 {
        return DFA_CR
    }
    if ascii_word(int.narrow(ch)) {
        return DFA_WORD
    }
    DFA_OTHER
}

fn dfa_look(kind: u64, mode: u64, left: u32, right: u32) -> bool {
    if kind == START_TEXT {
        return left == DFA_EDGE
    }
    if kind == END_TEXT {
        return right == DFA_EDGE
    }
    if kind == START_LINE || kind == END_LINE {
        let crlf = (mode & CRLF) != 0
        let lines = (mode & MULTILINE) != 0
        if kind == START_LINE {
            return left == DFA_EDGE || (lines && (left == DFA_LF || (crlf && left == DFA_CR && right != DFA_LF)))
        }
        return right == DFA_EDGE || (lines && ((right == DFA_LF && (!crlf || left != DFA_CR)) || (crlf && right == DFA_CR)))
    }
    let before = left == DFA_WORD
    let after = right == DFA_WORD
    match kind {
        5 => before != after,
        6 => before == after,
        7 => !before && after,
        8 => before && !after,
        9 => !before,
        _ => !after,
    }
}

fn dfa_hash_step(hash: u64, word: u32) -> u64 {
    let x: u64 = int.widen(word)
    int.wrapping_mul(hash ^ x, 0x100000001B3)
}

fn dfa_key_hash(work: List[u32], base: u64, len: u64, context: u32) -> u64 {
    let mut hash = dfa_hash_step(0xCBF29CE484222325, context)
    for i in 0u64 .. len {
        hash = dfa_hash_step(hash, work[base + i])
    }
    hash
}

// A state is named two ways. Its index is one-based and orders spans, hash
// cells and keys. Its id, the value held in transitions, starts and tagged
// edges, is index * columns: the offset of its transition row plus one row,
// so the search loop steps with `transitions - columns + id + class` and no
// multiply (regex-automata premultiplies its lazy DFA ids the same way).
// DFA_DEAD stays 0.
fn dfa_id(d: DfaLayout, index: u64) -> u32 {
    int.narrow(index * d.columns)
}

fn dfa_index(d: DfaLayout, id: u32) -> u64 {
    let wide: u64 = int.widen(id)
    wide / d.columns
}

fn dfa_row(d: DfaLayout, id: u32) -> u64 {
    let wide: u64 = int.widen(id)
    d.transitions + (wide - d.columns)
}

// A hash cell is current only when the corresponding state's backlink
// points here. Resetting the used length invalidates all old cells.
fn dfa_slot(work: List[u32], d: DfaLayout, used: u64, base: u64, len: u64, context: u32) -> (u64, u32) {
    let slots = 2 * d.states
    let mut slot = dfa_key_hash(work, base, len, context) % slots
    // A full probe window clears the hash section. Bounded probes keep
    // the cost of building a state linear in its NFA key size.
    for _ in 0u64 .. 16 {
        let candidate = work[d.hash + slot]
        let id: u64 = int.widen(candidate)
        if id == 0 || id > used || work[d.spans + 2 * (id - 1) + 1] != int.narrow(slot) {
            return (slot, DFA_DEAD)
        }
        let offset: u64 = int.widen(work[d.spans + 2 * (id - 1)])
        let key = d.keys + 8 * offset
        if work[key] == int.narrow(len) && work[key + 1] == context {
            let mut i: u64 = 0
            while i < len && work[key + 2 + i] == work[base + i] {
                i += 1
            }
            if i == len {
                return (slot, dfa_id(d, id))
            }
        }
        slot += 1
        if slot == slots {
            slot = 0
        }
    }
    (slots, DFA_DEAD)
}

fn dfa_key_units(len: u64) -> u64 {
    (len + 9) / 8
}

fn dfa_add(mut work: List[u32], d: DfaLayout, start: u64, len: u64, context: u32, slot: u64) -> u32 {
    let used: u64 = int.widen(work[d.header])
    let arena_at: u64 = int.widen(work[d.header + 1])
    let key = d.keys + 8 * arena_at
    work[key] = int.narrow(len)
    work[key + 1] = context
    // Clear may move a retained key toward the start of the same arena.
    for i in 0u64 .. len {
        work[key + 2 + i] = work[start + i]
    }
    let id: u32 = int.narrow(used + 1)
    work[d.spans + 2 * used] = int.narrow(arena_at)
    work[d.spans + 2 * used + 1] = int.narrow(slot)
    work[d.hash + slot] = id
    work[d.header] = id
    work[d.header + 1] = int.narrow(arena_at + dfa_key_units(len))
    let built: u64 = int.widen(work[d.header + 4])
    work[d.header + 4] = int.narrow(built + 1)
    for c in 0u64 .. d.columns {
        work[d.transitions + used * d.columns + c] = DFA_UNKNOWN
    }
    dfa_id(d, used + 1)
}

fn dfa_seen_bytes(work: List[u32], d: DfaLayout) -> u64 {
    let hi: u64 = int.widen(work[d.header + 2] >> 2)
    let lo: u64 = int.widen(work[d.header + 3])
    (hi << 32) | lo
}

fn dfa_clear_count(work: List[u32], d: DfaLayout) -> u32 {
    work[d.header + 2] & 3
}

fn dfa_clear(mut work: List[u32], d: DfaLayout, keep: u32, next_units: u64) -> bool {
    let clears = dfa_clear_count(work, d)
    let built: u64 = int.widen(work[d.header + 4])
    if clears == 3 && dfa_seen_bytes(work, d) < 10 * built {
        return false
    }
    let mut old: u64 = 0
    let mut len: u64 = 0
    let has_key = keep != DFA_DEAD
    if has_key {
        let id = dfa_index(d, keep)
        let offset: u64 = int.widen(work[d.spans + 2 * (id - 1)])
        old = d.keys + 8 * offset
        len = int.widen(work[old])
        if dfa_key_units(len) + next_units > 2 * d.states {
            return false
        }
    }
    work[d.header] = 0
    work[d.header + 1] = 0
    work[d.header + 2] = if clears < 3 {
        clears + 1
    } else {
        clears
    }
    work[d.header + 3] = 0
    work[d.header + 4] = 0
    for i in 0u64 .. 6 {
        work[d.starts + i] = 0
    }
    if has_key {
        let context = work[old + 1]
        let (slot, _) = dfa_slot(work, d, 0, old + 2, len, context)
        let _ = dfa_add(mut work, d, old + 2, len, context, slot)
    }
    true
}

fn dfa_bytes(mut work: List[u32], d: DfaLayout, n: u64) {
    let prior = dfa_seen_bytes(work, d)
    // After 10*S bytes, the give-up comparison cannot see any larger count.
    let max = 10 * d.states
    let total = if n > max - prior {
        max
    } else {
        prior + n
    }
    let hi: u32 = int.narrow(total >> 32)
    work[d.header + 2] = (work[d.header + 2] & 3) | (hi << 2)
    work[d.header + 3] = int.truncate(total)
}

fn dfa_intern(mut work: List[u32], d: DfaLayout, from: u32, base: u64, len: u64, context: u32) -> (u32, u32) {
    let units = dfa_key_units(len)
    if units > 2 * d.states {
        return (from, DFA_UNKNOWN)
    }
    let used: u64 = int.widen(work[d.header])
    let (slot, known) = dfa_slot(work, d, used, base, len, context)
    if known != DFA_DEAD {
        return (from, known)
    }
    let key_end: u64 = int.widen(work[d.header + 1])
    if used + 1 >= d.states || slot == 2 * d.states || key_end + units > 2 * d.states {
        if !dfa_clear(mut work, d, from, units) {
            return (from, DFA_UNKNOWN)
        }
        let remaining: u64 = if from == DFA_DEAD {
            0
        } else {
            1
        }
        let retained = dfa_id(d, remaining)
        let (cleared_slot, _) = dfa_slot(work, d, remaining, base, len, context)
        return (retained, dfa_add(mut work, d, base, len, context, cleared_slot))
    }
    (from, dfa_add(mut work, d, base, len, context, slot))
}

fn dfa_start(mut work: List[u32], d: DfaLayout, entry: u64, ch: u64, ordinary: bool) -> u32 {
    let context = if d.has_look {
        dfa_context(ch)
    } else {
        DFA_EDGE
    }
    // Without look assertions, the anchored prefilter entry can use an
    // otherwise unused context slot. There is one such entry per direction.
    let kind: u64 = if !d.has_look && !ordinary {
        1
    } else {
        int.widen(context)
    }
    let remember = ordinary || !d.has_look
    if remember {
        let stored = work[d.starts + kind]
        if stored != 0 {
            return stored
        }
    }
    work[d.scratch] = int.narrow(entry)
    let (_, start) = dfa_intern(mut work, d, DFA_DEAD, d.scratch, 1, context)
    if remember && start != DFA_UNKNOWN {
        work[d.starts + kind] = start
    }
    start
}

type DfaVisit: key {
    len_out: u64,
    matched: bool,
}

fn dfa_walk(program: List[NfaState], edges: List[NfaEdge], mut work: List[u32], d: DfaLayout, key: u64, len: u64, ch: u64, left: u32, right: u32, valid: bool,) -> DfaVisit {
    let seen = d.scratch + d.width
    let stack = seen + d.width
    for i in 0u64 .. d.width {
        work[seen + i] = 0
    }
    let mut len_out: u64 = 0
    let mut matched = false
    for seed in 0u64 .. len {
        let mut filled: u64 = 1
        work[stack] = work[key + seed]
        while filled != 0 {
            filled -= 1
            let mut state: u64 = int.widen(work[stack + filled])
            loop {
                let marks = work[seen + state]
                if (marks & 1) != 0 {
                    break
                }
                work[seen + state] = marks | 1
                let inst = program[state]
                let op = inst.op
                let a: u64 = int.widen(inst.a)
                let b: u64 = int.widen(inst.b)
                let c: u64 = int.widen(inst.c)
                if op == OP_SPLIT {
                    work[stack + filled] = int.narrow(b)
                    filled += 1
                    state = a
                } else if op == OP_UTF8_CHOICE {
                    if ch == DFA_INPUT_END {
                        break
                    }
                    state = if ch < 128 {
                        a
                    } else {
                        b
                    }
                } else if op == OP_SAVE {
                    state = b
                } else if op == OP_ASSERT && dfa_look(a, b, left, right) {
                    state = c
                } else {
                    if op == OP_MATCH && valid {
                        matched = true
                        if !d.reverse {
                            return DfaVisit(len_out: len_out, matched: true)
                        }
                    } else if ch != DFA_INPUT_END {
                        match nfa_advance(inst, edges, int.narrow(ch)) {
                            Some(target) => {
                                let visit = work[seen + target]
                                if (visit & 2) == 0 {
                                    work[seen + target] = visit | 2
                                    work[d.scratch + len_out] = int.narrow(target)
                                    len_out += 1
                                }
                            },
                            None => {},
                        }
                    }
                    break
                }
            }
        }
    }
    DfaVisit(len_out: len_out, matched: matched)
}

fn dfa_transition(program: List[NfaState], edges: List[NfaEdge], mut work: List[u32], d: DfaLayout, state: u32, col: u64, ch: u64, at_boundary: bool,) -> u32 {
    let cached = work[dfa_row(d, state) + col]
    if at_boundary && cached != DFA_UNKNOWN {
        return cached
    }
    let id = dfa_index(d, state)
    let offset: u64 = int.widen(work[d.spans + 2 * (id - 1)])
    let key = d.keys + 8 * offset
    let len: u64 = int.widen(work[key])
    let behind = work[key + 1]
    let ahead = if d.has_look {
        dfa_context(ch)
    } else {
        DFA_EDGE
    }
    let (left, right) = if d.reverse {
        (ahead, behind)
    } else {
        (behind, ahead)
    }
    let found = dfa_walk(program, edges, mut work, d, key + 2, len, ch, left, right, at_boundary)
    let start_tag = if d.start_bit != 0 && found.len_out == 1 && work[d.scratch] == d.start_entry {
        d.start_bit
    } else {
        0
    }
    let (from, target) = if found.len_out == 0 {
        (state, DFA_DEAD)
    } else {
        dfa_intern(mut work, d, state, d.scratch, found.len_out, ahead)
    }
    if target == DFA_UNKNOWN {
        return DFA_UNKNOWN
    }
    let edge = if found.matched {
        target | DFA_MATCH | start_tag
    } else {
        target | start_tag
    }
    if at_boundary {
        work[dfa_row(d, from) + col] = edge
    }
    edge
}

type Half: key = Found(u64) | Missing | Retry

fn literal_at(data: Bytes, table: Bytes, pos: u64, first: u64, width: u64) -> bool {
    let needle = list.slice(table, first, first + width)
    list.starts_with_at(data, pos, needle)
}

fn memchr_at(data: Bytes, table: Bytes, literals: u64, at: u64) -> Option[u64] {
    let end = list.len(data)
    let mut pos = at
    let x = table[0]
    let y = if literals >= 2 {
        table[1]
    } else {
        x
    }
    let z = if literals == 3 {
        table[2]
    } else {
        x
    }
    let xs: Simd[u8, 32] = simd.splat(x)
    let ys: Simd[u8, 32] = simd.splat(y)
    let zs: Simd[u8, 32] = simd.splat(z)
    while end - pos >= 32 {
        let input: Simd[u8, 32] = list.lanes(data, pos)
        let candidates = simd.bitmask(simd.eq(input, xs) | simd.eq(input, ys) | simd.eq(input, zs))
        if candidates != 0 {
            let low: u64 = int.widen(int.trailing_zeros(candidates))
            return Some(pos + low)
        }
        pos += 32
    }
    while pos < end {
        let ch = data[pos]
        if ch == x || ch == y || ch == z {
            return Some(pos)
        }
        pos += 1
    }
    None
}

fn pair_at(data: Bytes, left: u8, right: u8, at: u64) -> Option[u64] {
    let end = list.len(data)
    let mut pos = at
    let lhs: Simd[u8, 32] = simd.splat(left)
    let rhs: Simd[u8, 32] = simd.splat(right)
    while end - pos > 32 {
        let a: Simd[u8, 32] = list.lanes(data, pos)
        let b: Simd[u8, 32] = list.lanes(data, pos + 1)
        let hits = simd.bitmask(simd.eq(a, lhs) & simd.eq(b, rhs))
        if hits != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(hits))
            return Some(pos + offset)
        }
        pos += 32
    }
    while end - pos > 1 {
        if data[pos] == left && data[pos + 1] == right {
            return Some(pos)
        }
        pos += 1
    }
    None
}

fn memmem_at(data: Bytes, table: Bytes, p: Prefilter, at: u64) -> Option[u64] {
    if p.width == 2 {
        return pair_at(data, table[0], table[1], at)
    }
    let width = list.len(data)
    if width - at < p.width {
        return None
    }
    let end = width - p.width + 1
    let mut pos = at
    let a = p.rare_a
    let b = p.rare_b
    let left: Simd[u8, 32] = simd.splat(table[a])
    let right: Simd[u8, 32] = simd.splat(table[b])
    while end - pos >= 32 {
        let lhs: Simd[u8, 32] = list.lanes(data, pos + a)
        let rhs: Simd[u8, 32] = list.lanes(data, pos + b)
        let mut hits = simd.bitmask(simd.eq(lhs, left) & simd.eq(rhs, right))
        while hits != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(hits))
            let candidate = pos + offset
            if literal_at(data, table, candidate, 0, p.width) {
                return Some(candidate)
            }
            hits &= int.wrapping_sub(hits, 1)
        }
        pos += 32
    }
    while pos < end {
        if data[pos + a] == table[a] && data[pos + b] == table[b] && literal_at(data, table, pos, 0, p.width) {
            return Some(pos)
        }
        pos += 1
    }
    None
}

fn teddy_confirm(data: Bytes, table: Bytes, p: Prefilter, pos: u64) -> bool {
    // A surviving bit identifies a bucket, whose literals are eight apart.
    let mut buckets: u8 = 255
    for i in 0u64 .. p.width {
        let ch = data[pos + i]
        let lo: u64 = int.widen(ch & 15)
        let hi: u64 = int.widen(ch >> 4)
        buckets &= table[32 * i + lo] & table[32 * i + 16 + hi]
        if buckets == 0 {
            return false
        }
    }
    let first = 32 * p.width
    while buckets != 0 {
        let mut i: u64 = int.widen(int.trailing_zeros(buckets))
        while i < p.literals {
            if literal_at(data, table, pos, first + i * p.width, p.width) {
                return true
            }
            i += 8
        }
        buckets &= int.wrapping_sub(buckets, 1)
    }
    false
}

fn teddy_votes(data: Bytes, at: u64, lo: Simd[u8, 16], hi: Simd[u8, 16]) -> Simd[u8, 32] {
    let input: Simd[u8, 32] = list.lanes(data, at)
    let mask: Simd[u8, 32] = simd.splat(15)
    simd.swizzle(lo, input & mask) & simd.swizzle(hi, input >> 4)
}

fn teddy_at(data: Bytes, table: Bytes, p: Prefilter, at: u64) -> Option[u64] {
    let width = list.len(data)
    if width - at < p.width {
        return None
    }
    let end = width - p.width + 1
    let neutral: Simd[u8, 16] = simd.splat(255)
    let low0: Simd[u8, 16] = list.lanes(table, 0)
    let high0: Simd[u8, 16] = list.lanes(table, 16)
    let low1: Simd[u8, 16] = if p.width >= 2 {
        list.lanes(table, 32)
    } else {
        neutral
    }
    let high1: Simd[u8, 16] = if p.width >= 2 {
        list.lanes(table, 48)
    } else {
        neutral
    }
    let low2: Simd[u8, 16] = if p.width >= 3 {
        list.lanes(table, 64)
    } else {
        neutral
    }
    let high2: Simd[u8, 16] = if p.width >= 3 {
        list.lanes(table, 80)
    } else {
        neutral
    }
    let low3: Simd[u8, 16] = if p.width == 4 {
        list.lanes(table, 96)
    } else {
        neutral
    }
    let high3: Simd[u8, 16] = if p.width == 4 {
        list.lanes(table, 112)
    } else {
        neutral
    }
    let mut pos = at
    while end - pos >= 32 {
        let mut votes = teddy_votes(data, pos, low0, high0)
        if p.width >= 2 {
            votes &= teddy_votes(data, pos + 1, low1, high1)
        }
        if p.width >= 3 {
            votes &= teddy_votes(data, pos + 2, low2, high2)
        }
        if p.width == 4 {
            votes &= teddy_votes(data, pos + 3, low3, high3)
        }
        let mut hits = simd.bitmask(~simd.eq(votes, simd.splat(0)))
        while hits != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(hits))
            let candidate = pos + offset
            if teddy_confirm(data, table, p, candidate) {
                return Some(candidate)
            }
            hits &= int.wrapping_sub(hits, 1)
        }
        pos += 32
    }
    while pos < end {
        if teddy_confirm(data, table, p, pos) {
            return Some(pos)
        }
        pos += 1
    }
    None
}

fn prefilter_at(data: Bytes, table: Bytes, p: Prefilter, at: u64) -> Option[u64] {
    if p.kind == MEMMEM {
        return memmem_at(data, table, p, at)
    }
    if p.kind == TEDDY {
        return teddy_at(data, table, p, at)
    }
    memchr_at(data, table, p.literals, at)
}

type DfaQuery: key {
    begin: u64,
    limit: u64,
    entry: u64,
    ordinary_entry: bool,
    skip_enabled: bool,
}

type DfaRun: key {
    half: Half,
    stopped_at: u64,
}

fn dfa_initial_byte(data: Bytes, width: u64, pos: u64, reverse: bool) -> u64 {
    if reverse {
        if pos == width {
            DFA_INPUT_END
        } else {
            int.widen(data[pos])
        }
    } else if pos == 0 {
        DFA_INPUT_END
    } else {
        int.widen(data[pos - 1])
    }
}

fn dfa_is_start(work: List[u32], d: DfaLayout, state: u32, entry: u64) -> bool {
    let id = dfa_index(d, state)
    let offset: u64 = int.widen(work[d.spans + 2 * (id - 1)])
    let key = d.keys + 8 * offset
    work[key] == 1 && work[key + 2] == int.narrow(entry)
}

fn dfa_search(re: Regex, program: List[NfaState], mut work: List[u32], d: DfaLayout, query: DfaQuery, s: String) -> DfaRun {
    let data = string.as_bytes(s)
    let width = list.len(data)
    let reverse = d.reverse
    let skip_enabled = query.skip_enabled && re.pref_plan.kind != NO_PREFILTER && re.pref_plan.kind < REVERSE_SUFFIX
    let mut pos = query.begin
    let mut behind = dfa_initial_byte(data, width, pos, reverse)
    if re.quit_non_ascii && behind >= 128 && behind != DFA_INPUT_END {
        return DfaRun(half: Retry, stopped_at: pos)
    }
    let mut state = dfa_start(mut work, d, query.entry, behind, query.ordinary_entry)
    let mut matched: Option[u64] = None
    let mut at_start = query.entry == re.start
    let target_mask = DFA_TARGET ^ d.start_bit
    let tags = DFA_MATCH | d.start_bit
    let mut scanned: u64 = 0
    while state != DFA_DEAD {
        if state == DFA_UNKNOWN {
            return DfaRun(half: Retry, stopped_at: pos)
        }
        if skip_enabled && (at_start || (d.start_bit == 0 && dfa_is_start(work, d, state, query.entry))) {
            match prefilter_at(data, re.prefilter, re.pref_plan, pos) {
                None => {
                    scanned += width - pos
                    pos = width
                    break
                },
                Some(hit) => {
                    if hit != pos {
                        scanned += hit - pos
                        pos = hit
                        if d.has_look {
                            behind = dfa_initial_byte(data, width, pos, false)
                            dfa_bytes(mut work, d, scanned)
                            scanned = 0
                            if re.quit_non_ascii && behind >= 128 && behind != DFA_INPUT_END {
                                return DfaRun(half: Retry, stopped_at: pos)
                            }
                            state = dfa_start(mut work, d, query.entry, behind, true)
                            if state == DFA_UNKNOWN {
                                return DfaRun(half: Retry, stopped_at: pos)
                            }
                        }
                    }
                },
            }
        }
        if !reverse && (!skip_enabled || d.start_bit != 0) {
            let columns: u32 = int.narrow(d.columns)
            let begin = pos
            // Follow cached ASCII transitions, recording matches as the outer
            // loop would. The outer loop handles dead, start and uncached
            // transitions and the end of input.
            while pos < query.limit {
                let ch = data[pos]
                if ch >= 128 {
                    break
                }
                let col: u32 = int.widen(re.class_map[int.widen(ch)])
                // Live ids are at least `columns` and below DFA_TARGET_LIMIT.
                let offset: u64 = int.widen(int.wrapping_add(int.wrapping_sub(state, columns), col))
                let transition = work[d.transitions + offset]
                if transition == DFA_DEAD || (transition & tags) != 0 {
                    // Only a match into a live, non-start state stays here.
                    let untagged = transition ^ DFA_MATCH
                    if untagged == DFA_DEAD || (transition & DFA_MATCH) == 0 || (untagged & d.start_bit) != 0 || transition == DFA_UNKNOWN {
                        break
                    }
                    matched = Some(pos)
                    state = untagged
                } else {
                    state = transition
                }
                pos += 1
            }
            scanned += pos - begin
        }
        let ch: u64 = if reverse {
            if pos == 0 {
                DFA_INPUT_END
            } else {
                int.widen(data[pos - 1])
            }
        } else if pos == width {
            DFA_INPUT_END
        } else {
            int.widen(data[pos])
        }
        if re.quit_non_ascii && ch >= 128 && ch != DFA_INPUT_END {
            dfa_bytes(mut work, d, scanned)
            return DfaRun(half: Retry, stopped_at: pos)
        }
        let col: u64 = if ch == DFA_INPUT_END {
            d.columns - 1
        } else {
            int.widen(re.class_map[ch])
        }
        let valid = pos == width || (data[pos] & 0xC0) != 0x80
        let cached = work[dfa_row(d, state) + col]
        let edge = if !valid || cached == DFA_UNKNOWN {
            dfa_bytes(mut work, d, scanned)
            scanned = 0
            dfa_transition(program, re.edges, mut work, d, state, col, ch, valid)
        } else {
            cached
        }
        if edge == DFA_UNKNOWN {
            return DfaRun(half: Retry, stopped_at: pos)
        }
        if (edge & DFA_MATCH) != 0 {
            matched = Some(pos)
        }
        if pos == query.limit {
            break
        }
        state = edge & target_mask
        at_start = (edge & d.start_bit) != 0
        pos = if reverse {
            pos - 1
        } else {
            pos + 1
        }
        scanned += 1
    }
    dfa_bytes(mut work, d, scanned)
    let half = match matched {
        Some(at) => Found(at),
        None => Missing,
    }
    DfaRun(half: half, stopped_at: pos)
}

fn forward_end(re: Regex, mut c: Cache, s: String, at: u64) -> Half {
    let d = dfa_layout(re, c, false)
    let q = DfaQuery(begin: at, limit: string.byte_len(s), entry: re.start, ordinary_entry: true, skip_enabled: true)
    dfa_search(re, re.forward, mut c.work, d, q, s).half
}

fn reverse_start(re: Regex, mut c: Cache, s: String, end: u64, limit: u64) -> Half {
    let d = dfa_layout(re, c, true)
    let q = DfaQuery(begin: end, limit: limit, entry: re.reverse_start, ordinary_entry: true, skip_enabled: false)
    dfa_search(re, re.reverse, mut c.work, d, q, s).half
}

fn reverse_needle_at(data: Bytes, table: Bytes, p: Prefilter, at: u64) -> Option[u64] {
    match p.reverse_prev {
        Some(left) => match pair_at(data, left, table[0], at) {
            Some(start) => Some(start + 1),
            None => None,
        },
        None => memchr_at(data, table, 1, at),
    }
}

fn reverse_prefilter(re: Regex, mut c: Cache, s: String, at: u64) -> Result[Option[Match], ()] {
    let f = dfa_layout(re, c, false)
    let r = dfa_layout(re, c, true)
    let data = string.as_bytes(s)
    let end = list.len(data)
    let mut lo = at
    let mut from = at
    let mut min_pre_start = at
    while let Some(needle) = reverse_needle_at(data, re.prefilter, re.pref_plan, from) {
        if needle < min_pre_start {
            // A failed forward confirmation read into this candidate's region.
            return Error(())
        }
        let q = DfaQuery(begin: needle, limit: lo, entry: re.pref_reverse_start, ordinary_entry: false, skip_enabled: false)
        match dfa_search(re, re.reverse, mut c.work, r, q, s).half {
            Found(start) => {
                if re.pref_plan.kind == REVERSE_SUFFIX {
                    return Ok(Some(Match(start: start, end: needle + re.pref_plan.width)))
                }
                let confirm = DfaQuery(begin: start, limit: end, entry: re.start - 1, ordinary_entry: false, skip_enabled: false)
                let observed = dfa_search(re, re.forward, mut c.work, f, confirm, s)
                match observed.half {
                    Found(end_at) => return Ok(Some(Match(start: start, end: end_at))),
                    Retry => return Error(()),
                    Missing => {
                        min_pre_start = observed.stopped_at
                    },
                }
            },
            Missing => {},
            Retry => return Error(()),
        }
        from = needle + 1
        // The eligibility proof excludes the needle's first byte from the
        // prefix, so a later prefix cannot cross this rejected literal.
        lo = from
    }
    Ok(None)
}

fn match_span(re: Regex, mut c: Cache, s: String, at: u64) -> Result[Option[Match], ()] {
    if re.pref_plan.kind >= REVERSE_SUFFIX {
        match reverse_prefilter(re, mut c, s, at) {
            Ok(span) => return Ok(span),
            Error(()) => {},
        }
    }
    match forward_end(re, mut c, s, at) {
        Found(end) => match reverse_start(re, mut c, s, end, at) {
            Found(start) => Ok(Some(Match(start: start, end: end))),
            Missing => Ok(None),
            Retry => Error(()),
        },
        Missing => Ok(None),
        Retry => Error(()),
    }
}

fn search(re: Regex, mut c: Cache, s: String, at: u64, groups_wanted: u64) -> Option[Match] {
    let width = string.byte_len(s)
    let vm_groups: u64 = if re.capture_offsets != None {
        1
    } else {
        groups_wanted
    }
    match match_span(re, mut c, s, at) {
        Ok(None) => None,
        Ok(Some(span)) => {
            if vm_groups > 1 {
                return pike_search(re, mut c, s, span.start, span.end, re.start - 1, vm_groups)
            }
            Some(span)
        },
        Error(()) => pike_search(re, mut c, s, at, width, re.start, vm_groups),
    }
}

fn publish_groups(re: Regex, c: Cache, mut g: Groups, span: Match) {
    g.spans[0] = span.start
    g.spans[1] = span.end
    if let Some(offsets) = re.capture_offsets {
        g.spans[2] = span.start + offsets.prefix
        g.spans[3] = span.end - offsets.suffix
        return
    }
    let mut i: u64 = 1
    while i < re.group_count {
        let lo = read_slot(c.work, c.slices.saved + 4 * i)
        let hi = read_slot(c.work, c.slices.saved + 4 * i + 2)
        if lo == ABSENT || hi == ABSENT {
            g.spans[2 * i] = 1
            g.spans[2 * i + 1] = 0
        } else {
            g.spans[2 * i] = lo
            g.spans[2 * i + 1] = hi
        }
        i += 1
    }
}

pub fn is_match(re: Regex, mut c: Cache, s: String, at: u64) -> bool {
    check_cache(re, c)
    check_start(s, at)
    search_end(re, mut c, s, at) != None
}

pub fn find(re: Regex, mut c: Cache, s: String, at: u64) -> Option[Match] {
    check_cache(re, c)
    check_start(s, at)
    search(re, mut c, s, at, 1)
}

pub fn captures(re: Regex, mut c: Cache, s: String, at: u64, mut g: Groups) -> bool {
    check_cache(re, c)
    check_groups(re, g)
    check_start(s, at)
    match search(re, mut c, s, at, re.group_count) {
        Some(span) => {
            publish_groups(re, c, mut g, span)
            true
        },
        None => {
            init_group_spans(mut g.spans)
            false
        },
    }
}

fn next_search(re: Regex, mut c: Cache, s: String, mut k: Cursor, groups_wanted: u64) -> Option[Match] {
    if k.finished {
        return None
    }
    check_start(s, k.at)
    let width = string.byte_len(s)
    let mut found = search(re, mut c, s, k.at, groups_wanted)
    if k.after_match && found == Some(Match(start: k.at, end: k.at)) {
        if k.at == width {
            found = None
        } else {
            let (_, boundary_at) = scalar(s, k.at)
            found = search(re, mut c, s, boundary_at, groups_wanted)
        }
    }
    match found {
        Some(m) => {
            k.at = m.end
            k.after_match = true
        },
        None => {
            k.finished = true
        },
    }
    found
}

pub fn next(re: Regex, mut c: Cache, s: String, mut k: Cursor) -> Option[Match] {
    check_cache(re, c)
    next_search(re, mut c, s, mut k, 1)
}

pub fn next_captures(re: Regex, mut c: Cache, s: String, mut k: Cursor, mut g: Groups) -> bool {
    check_cache(re, c)
    check_groups(re, g)
    match next_search(re, mut c, s, mut k, re.group_count) {
        Some(span) => {
            publish_groups(re, c, mut g, span)
            true
        },
        None => {
            init_group_spans(mut g.spans)
            false
        },
    }
}

fn search_end(re: Regex, mut c: Cache, s: String, at: u64) -> Option[u64] {
    let width = string.byte_len(s)
    if re.pref_plan.kind >= REVERSE_SUFFIX {
        match reverse_prefilter(re, mut c, s, at) {
            Ok(Some(span)) => return Some(span.end),
            Ok(None) => return None,
            Error(()) => {},
        }
    }
    match forward_end(re, mut c, s, at) {
        Found(end) => Some(end),
        Missing => None,
        Retry => match pike_search(re, mut c, s, at, width, re.start, 1) {
            Some(span) => Some(span.end),
            None => None,
        },
    }
}

pub fn count(re: Regex, mut c: Cache, s: String) -> u64 {
    check_cache(re, c)
    let mut at: u64 = 0
    let mut matches_found: u64 = 0
    while let Some(end) = search_end(re, mut c, s, at) {
        if re.can_empty && matches_found != 0 && end == at {
            if at == string.byte_len(s) {
                break
            }
            let (_, boundary_at) = scalar(s, at)
            match search_end(re, mut c, s, boundary_at) {
                Some(new_end) => {
                    at = new_end
                },
                None => {
                    break
                },
            }
        } else {
            at = end
        }
        matches_found += 1
    }
    matches_found
}


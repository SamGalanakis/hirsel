pub opaque type Level: send {
    store: StoreId,
    name: String
}

fn store_level_name(db: Db) -> String {
    if let Some(connection) = db.disk {
        if let Some(object_writer) = connection.object { return string.from(object_writer.level_name) }
    }
    if is_disk(db) {
        "host"
    } else {
        "memory"
    }
}

pub fn levels(db: Db) -> List[String] {
    let mut declared: List[String] = list.with_capacity(1)
    list.push(mut declared, store_level_name(db))
    take declared
}

pub fn level(db: Db, name: String) -> Result[Level, Error] {
    if name != store_level_name(db) {
        return Error(NoLevel(string.from(name)))
    }
    Ok(Level(store: db.store, name: string.from(name)))
}

pub fn durable_at(mut db: Db, receipt: Ticket, requested: Level) -> Result[(), Error] waits {
    if !same(requested.store, db.store) {
        return Error(Foreign)
    }
    if requested.name != store_level_name(db) {
        return Error(NoLevel(string.from(requested.name)))
    }
    durable(mut db, receipt)
}

pub type Position {
    store: StoreId,
    branch: u32,
    version: u64
}

pub fn position(mut db: Db, receipt: Ticket) -> Result[Position, Error] waits {
    if !same(receipt.store, db.store) || receipt.open != open_number(db) {
        return Error(Foreign)
    }
    let Journal(_, branch_id, committed_version) = receipt.mark else {
        return Error(Missing("position"))
    }
    durable(mut db, receipt)?
    Ok(Position(store: receipt.store, branch: branch_id, version: committed_version))
}

// The platform host's catalog tables, declared once per store.
pub opaque type Tables {
    groups: store.Table[String, GroupRow],
    activations: store.Table[(u64, u64), Bytes],
    wake: store.Table[String, WakeRow],
    dirty: store.Table[String, u64],
    due: store.Table[DueKey, u8],
    deploys: store.Table[String, DeployRow],
    requests: store.Table[Bytes, RequestRow],
    active: store.Table[String, Bytes],
    pins: store.Table[Bytes, Pin],
    quotas: store.Table[String, Quota],
    usage: store.Table[String, Usage],
    config: store.Table[u64, Config],
    meta: store.Table[u64, Meta],
    retired: store.Table[String, Retired],
    // Source blobs by group incarnation and SHA-256 (launch.md "Source by content").
    blobs: store.Table[Bytes, Bytes],
    node: store.Table[u64, NodeRow],
}

fn declared[K, V](mut d: store.Declare, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[store.Table[K, V], store.Error] {
    let table = store.declare_table(mut d, name, take key, take value)?
    store.finish(mut d, take table)
}

pub fn declare_tables(mut d: store.Declare) -> Result[Tables, store.Error] {
    Ok(Tables(
        groups: declared(mut d, "platform.groups", std.codec.key_string(), std.codec.of())?,
        activations: declared(mut d, "platform.activations", activation_key(), std.codec.of_bytes())?,
        wake: declared(mut d, "platform.wake", std.codec.key_string(), std.codec.of())?,
        dirty: declared(mut d, "platform.dirty", std.codec.key_string(), std.codec.of_u64())?,
        due: declared(mut d, "platform.due", due_key(), std.codec.of_u8())?,
        deploys: declared(mut d, "platform.deploys", std.codec.key_string(), std.codec.of())?,
        requests: declared(mut d, "platform.requests", std.codec.key_bytes(), std.codec.of())?,
        active: declared(mut d, "platform.active", std.codec.key_string(), std.codec.of_bytes())?,
        pins: declared(mut d, "platform.pins", std.codec.key_bytes(), std.codec.of())?,
        quotas: declared(mut d, "platform.quotas", std.codec.key_string(), std.codec.of())?,
        usage: declared(mut d, "platform.usage", std.codec.key_string(), std.codec.of())?,
        config: declared(mut d, "platform.config", std.codec.key_u64(), std.codec.of())?,
        meta: declared(mut d, "platform.meta", std.codec.key_u64(), std.codec.of())?,
        retired: declared(mut d, "platform.retired", std.codec.key_string(), std.codec.of())?,
        blobs: declared(mut d, "platform.blobs", std.codec.key_bytes(), std.codec.of_bytes())?,
        node: declared(mut d, "platform.node", std.codec.key_u64(), std.codec.of())?,
    ))
}

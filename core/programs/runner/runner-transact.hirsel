// A transact run, for the head: an effect to commit with its reply, a typed error whose
// reply is kept alone, a fault after entry, or a refusal that records nothing.
type Ran: send = Commit(Bytes) | Abort(Bytes) | Exhausted(Capacity) | Refuse(Refusal)

// The session's check (rule 5): the argument decodes under n, and the value is dropped.
// Running out of n is not a refusal; the head's run answers it with Failed(OutOfBytes).
fn check_arg[A](ca: std.codec.Codec[A], arg: Bytes, n: u64) -> Option[Refusal] {
    let seen = bound bytes n {
        match std.codec.decode(ca, arg) {
            Error(e) => {
                let why: Refusal = Malformed(bad(e))
                Some(take why)
            },
            _ => None,
        }
    }
    match take seen {
        Ok(take o) => take o,
        Error(c) => Some(Budget(capacity_room(c))),
    }
}

// The store's entry bound covers decoding, execution and reply encoding.
fn adapt_transact[H: shareable + inert + send, A, R, E](f: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], ce: std.codec.Codec[E], mut tx: store.Tx, h: H, author: Caller, arg: Bytes) -> Ran {
    let body = code.callable(f)
    match std.codec.decode(ca, arg) {
        Ok(take a) => {
            let res = body(mut tx, h, author, take a)
            let kept = match res { Ok(_) => true, Error(_) => false }
            let mut out: Bytes = list.new()
            match std.codec.put_result(res, cr, ce, mut out) {
                Ok(()) => {
                    let length = list.len(out)
                    if length > MAX_RETURNED_BYTES {
                        Exhausted(Capacity(requested: length, available: MAX_RETURNED_BYTES))
                    } else if kept { Commit(take out) } else { Abort(take out) }
                },
                Error(_) => fail("runner: unrepresentable reply count"),
            }
        },
        Error(e) => Refuse(Malformed(bad(e))),
    }
}

type TransactAdapters[H: shareable + inert + send]: send {
    serve: own[send] fn(mut store.Db, take store.Completion, store.Plan, take Option[store.CallRecord], H, Caller, Bytes) -> Result[store.Served, store.ServeError] waits,
    // A parked served call's next attempt, with the request's bytes decoded afresh (STORE-SPEC §13.3a).
    resume: own[send] fn(mut store.Db, take store.Parked, H, Caller, Bytes) -> Result[store.Served, store.ServeError] waits,
    trigger: own[send] fn(mut store.Db, H, Caller, triggers.Tables, triggers.Pending) -> Result[store.Outcome[(), TriggerBodyError], store.Error] waits,
    attempt: own[send] fn(mut store.Db, H, Caller, triggers.Tables, triggers.Attempt, Bytes) -> Result[store.Outcome[Outcome, FencedRefusal], store.Error] waits,
    replay: own[send] fn(store.Db, store.ReplaySource, take store.Declare, store.Plan, H, Caller, Bytes) -> Result[store.Verdict, store.Error] waits
}

type TransactEntry[H, A, R, E] {
    run: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]],
    args: std.codec.Codec[A],
    reply: std.codec.Codec[R],
    error: std.codec.Codec[E]
}

type TransactBody[H, A, R, E] {
    entry: TransactEntry[H, A, R, E],
    handles: H,
    caller: Caller,
    raw: Bytes
}

fn transact_body[H: shareable + inert + send, A, R, E](mut tx: store.Tx, env: TransactBody[H, A, R, E]) -> Ran {
    adapt_transact(env.entry.run, env.entry.args, env.entry.reply, env.entry.error, mut tx, env.handles, env.caller, env.raw)
}

fn transact_reply[H: shareable + inert + send, A, R, E](mut tx: store.Tx, env: TransactBody[H, A, R, E]) -> Result[Bytes, Bytes] {
    let value = transact_body(mut tx, env)
    encode_entry_reply(mut tx, take value)
}

fn transact_replay[H: shareable + inert + send, A, R, E](record: store.Recorded, mut tx: store.Tx, env: TransactBody[H, A, R, E]) -> Result[Bytes, Bytes] {
    transact_reply(mut tx, env)
}

fn run_trigger_body[H: shareable + inert + send, A, R, E](mut tx: store.Tx, env: (TransactBody[H, A, R, E], triggers.Tables, triggers.Pending, u64)) -> Result[(), TriggerBodyError] {
    // The wall can move backwards between the scheduler's sample and this transaction.
    if store.info(mut tx).at < triggers.due_time(env.2) { return Error(NotDue) }
    let ran = bound bytes env.3 { transact_body(mut tx, env.0) }
    let terminal: triggers.Terminal = match take ran {
        Ok(Commit(take payload)) => Returned(take payload),
        Ok(Abort(take payload)) => return Error(Terminal(Returned(take payload))),
        Ok(Exhausted(cap)) => return Error(Terminal(OutOfBytes(cap.requested, cap.available))),
        Ok(Refuse(_)) => return Error(Terminal(Gone)),
        Error(cap) => return Error(Terminal(OutOfBytes(cap.requested, cap.available))),
    }
    triggers.finish_transact(mut tx, env.1, env.2, terminal) ?=> Store
    Ok(())
}

fn check_attempt(tx: store.Tx, tables: triggers.Tables, attempt: triggers.Attempt) -> Result[(), FencedRefusal] {
    match triggers.fence(tx, tables, attempt) {
        Ok(false) => Ok(()),
        Ok(true) => Error(Refusal(Cancelled)),
        Error(Store(take problem)) => Error(Refusal(Store(take problem))),
        Error(_) => Error(Refusal(StaleAttempt)),
    }
}

fn run_transact_attempt[H: shareable + inert + send, A, R, E](mut tx: store.Tx, env: (TransactBody[H, A, R, E], triggers.Tables, triggers.Attempt, u64)) -> Result[Outcome, FencedRefusal] {
    check_attempt(tx, env.1, env.2)?
    let ran = bound bytes env.3 { transact_body(mut tx, env.0) }
    match take ran {
        Ok(Commit(take payload)) => Ok(Returned(take payload)),
        Ok(Abort(take payload)) => Error(BodyOutcome(Returned(take payload))),
        Ok(Refuse(take refusal)) => Error(BodyOutcome(Refused(take refusal))),
        Ok(Exhausted(cap)) => Error(BodyOutcome(Failed(OutOfBytes(capacity_room(cap))))),
        Error(cap) => Error(BodyOutcome(Failed(OutOfBytes(capacity_room(cap))))),
    }
}

pub fn transact[G: send, H: shareable + inert + send, A: codec, R: codec, E: codec](mut r: Registry[G, H], f: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]], n: u64, s: u64) -> Result[(), RegisterError] {
    check_call_reserve(n, s)?
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let ce: std.codec.Codec[E] = std.codec.of()
    let carried: std.codec.Codec[Result[R, E]] = std.codec.of()
    let (take key, take d) = entry_described(r, scoped fn() -> Result[(Bytes, Exported), RegisterError] {
        Ok(described(code.identity(f), code.revision(f), Transact, ca, carried) ?=> |_| Bounds)
    })?
    let revision: Option[Bytes] = match code.revision(f) {
        Some(digest) => {
            let mut copied: Bytes = list.new()
            list.append(mut copied, digest)
            if list.len(copied) == 0u64 {
                None
            } else {
                Some(take copied)
            }
        },
        None => None,
    }
    register_check(mut r, key, ca, n, s)?
    let check = fn(arg: Bytes) -> Option[Refusal] { check_arg(ca, arg, n) }
    let entry = TransactEntry(run: f, args: ca, reply: cr, error: ce)
    let serve_entry = fn(mut db: store.Db, take complete: store.Completion, plan: store.Plan, take rec: Option[store.CallRecord], h: H, author: Caller, arg: Bytes) -> Result[store.Served, store.ServeError] waits {
        let env = TransactBody(entry: store.copy_env(entry), handles: store.copy_env(h), caller: clone(author), raw: clone(arg))
        store.serve(mut db, take complete, plan, take rec, env, transact_reply)
    }
    let resume_entry = fn(mut db: store.Db, take parked: store.Parked, h: H, author: Caller, arg: Bytes) -> Result[store.Served, store.ServeError] waits {
        let env = TransactBody(entry: store.copy_env(entry), handles: store.copy_env(h), caller: clone(author), raw: clone(arg))
        store.resume_parked(mut db, take parked, env, transact_reply)
    }
    let trigger = fn(mut db: store.Db, h: H, author: Caller, tables: triggers.Tables, pending: triggers.Pending) -> Result[store.Outcome[(), TriggerBodyError], store.Error] waits {
        let body = TransactBody(entry: store.copy_env(entry), handles: store.copy_env(h), caller: clone(author), raw: clone(triggers.argument(pending)))
        store.run(mut db, Some(s), (take body, store.copy_env(tables), store.copy_env(pending), n), run_trigger_body)
    }
    let attempt = fn(mut db: store.Db, h: H, author: Caller, tables: triggers.Tables, active: triggers.Attempt, arg: Bytes) -> Result[store.Outcome[Outcome, FencedRefusal], store.Error] waits {
        let body = TransactBody(entry: store.copy_env(entry), handles: store.copy_env(h), caller: clone(author), raw: clone(arg))
        store.run(mut db, Some(s), (take body, store.copy_env(tables), store.copy_env(active), n), run_transact_attempt)
    }
    let replay = fn(db: store.Db, source: store.ReplaySource, take declaration: store.Declare, plan: store.Plan, h: H, author: Caller, arg: Bytes) -> Result[store.Verdict, store.Error] waits {
        let env = TransactBody(entry: store.copy_env(entry), handles: store.copy_env(h), caller: clone(author), raw: clone(arg))
        store.reexecute_with(db, source, take declaration, plan, replay_fault, env, transact_replay)
    }
    let adapters = TransactAdapters(serve: take serve_entry, resume: take resume_entry, trigger: take trigger, attempt: take attempt, replay: take replay)
    insert_exported(mut r, take key, take d, Transact(n, s, take revision, check, take adapters))
}

pub fn attempt_key[F, A, R](definition: StaticFn[F], arg: std.codec.Codec[A], reply: std.codec.Codec[R]) -> Result[Bytes, std.codec.EncodeError] {
    let identity = code.identity(definition)
    Ok(entry_key(identity, std.codec.fingerprint(arg)?, std.codec.fingerprint(reply)?))
}

// An attempt entry has no wire slot or call record. Only the head can attach
// the checked attempt, and the application must register the entry at open.
type FencedEntry[H, Env: inert + send, A, R]: send {
    body: fn(mut store.Tx, H, triggers.Attempt, take A, Env) -> Result[R, store.Error],
    env: Env,
    args: std.codec.Codec[A],
    reply: std.codec.Codec[R]
}

fn run_fenced_entry[H: shareable + inert + send, Env: inert + send, A, R](mut tx: store.Tx, env: (FencedEntry[H, Env, A, R], triggers.Tables, triggers.Attempt, Bytes, u64, H)) -> Result[Outcome, FencedRefusal] {
    check_attempt(tx, env.1, env.2)?
    let ran: Result[Result[Outcome, FencedRefusal], Capacity] = bound bytes env.4 {
        let entry = view env.0
        let decoded = match std.codec.decode(entry.args, env.3) {
            Ok(take value) => take value,
            Error(_) => return Error(Refusal(Store(Missing("attempt argument")))),
        }
        let answer = (entry.body)(mut tx, env.5, env.2, take decoded, entry.env) ?=> |problem| Refusal(Store(take problem))
        let mut raw: Bytes = list.new()
        std.codec.encode(entry.reply, answer, mut raw) ?=> |_| Refusal(Store(Limit(Value)))
        Ok(Returned(take raw))
    }
    match take ran {
        Ok(take outcome) => take outcome,
        Error(cap) => Error(Refusal(Capacity(cap))),
    }
}

pub fn register_attempt[G: send, H: shareable + inert + send, F, Env: inert + send, A: codec, R: codec](mut registered: Registry[G, H], definition: StaticFn[F],
    env: Env, run: fn(mut store.Tx, H, triggers.Attempt, take A, Env) -> Result[R, store.Error], n: u64, steps: u64) -> Result[(), RegisterError] {
    check_call_reserve(n, steps)?
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let key = if registered.replay {
        let replayed: Bytes = clone(registered.t.slot_keys[registered.at])
        take replayed
    } else {
        attempt_key(definition, ca, cr) ?=> |_| Bounds
    }
    let entry = FencedEntry(body: run, env: store.copy_env(env), args: ca, reply: cr)
    let adapter = fn(mut db: store.Db, h: H, tables: triggers.Tables, active: triggers.Attempt, arg: Bytes) -> Result[store.Outcome[Outcome, FencedRefusal], store.Error] waits {
        let raw: Bytes = clone(arg)
        let body_env: (FencedEntry[H, Env, A, R], triggers.Tables, triggers.Attempt, Bytes, u64, H) = (store.copy_env(entry), store.copy_env(tables), store.copy_env(active), take raw, n, store.copy_env(h))
        store.run(mut db, Some(steps), body_env, run_fenced_entry)
    }
    let ready: own[send] fn(mut store.Db, H, triggers.Tables, triggers.Attempt, Bytes) -> Result[store.Outcome[Outcome, FencedRefusal], store.Error] waits = take adapter
    insert(mut registered, take key, None, Fenced(n, steps, take ready))
}

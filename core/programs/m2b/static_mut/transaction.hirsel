// RUNNER-SPEC section 1 probe: a transact entry `fn(mut Tx, take A) -> Result[R, E]`
// registered by its StaticFn and erased into an owning closure that takes `mut Tx`.
// `Tx` here is a local stand-in with the store's kind (scoped: it holds a view).
scoped type Tx {
    base: View[Bytes],
    writes: u64
}

pub type Outcome = Returned(Bytes) | Aborted(Bytes) | Malformed

type Slot {
    run: own fn(mut Tx, Bytes) -> Outcome
}

fn slot[A, R, E](f: StaticFn[fn(mut Tx, take A) -> Result[R, E]], take ca: std.codec.Codec[A], take cr: std.codec.Codec[R], take ce: std.codec.Codec[E]) -> Slot {
    let made = fn(mut tx: Tx, arg: Bytes) -> Outcome {
        let body = code.callable(f)
        match std.codec.decode(ca, arg) {
            Ok(take a) => {
                let mut out: Bytes = list.new()
                match body(mut tx, take a) {
                    Ok(take r) => match std.codec.encode(cr, r, mut out) {
                        Ok(()) => Returned(take out),
                        Error(_) => fail("transaction: unrepresentable reply count")
                    },
                    Error(take e) => match std.codec.encode(ce, e, mut out) {
                        Ok(()) => Aborted(take out),
                        Error(_) => fail("transaction: unrepresentable reply count")
                    },
                }
            },
            Error(_) => Malformed,
        }
    }
    Slot(run: take made)
}

fn flip(mut tx: Tx, take i: u32) -> Result[bool, u32] {
    if i > 999u32 {
        return Error(i)
    }
    tx.writes += 1u64
    Ok(true)
}

pub fn main() -> Result[(), Exit] {
    let s = slot(code.describe(flip), std.codec.of_u32(), std.codec.of_bool(), std.codec.of_u32())
    let base: Bytes = list.new()
    let mut tx = Tx(base: view base, writes: 0u64)
    let mut arg: Bytes = list.new()
    std.codec.put_u32(5u32, mut arg)
    let Slot(run) = take s
    let o = run(mut tx, arg)
    match o {
        Returned(_) => {
            if tx.writes == 1u64 {
                Ok(())
            } else {
                Error(Exit(status: 1))
            }
        },
        _ => Error(Exit(status: 1)),
    }
}

fn wire_call_ready[G: send, H: shareable + inert + send, B: send](mut s: WireSession[G, B], r: Registry[G, H], mut work: WireWork, take pending: WirePending) -> Result[(), u16] {
    let plan = wire_plan_call(mut s, r, take pending)?
    wire_apply_plan(mut s, mut work, take plan)
}

// WIRE W3c: hand-sized replies and the exact 41,140-byte outcome reserve.
fn w3c_bytes(take count: u32) -> Result[Bytes, Capacity] {
    let mut b: Bytes = list.new()
    let n: u64 = int.widen(count)
    for _ in 0u64 .. n { list.push(mut b, 3u8) }
    Ok(take b)
}

fn w3c_tx(mut tx: store.Tx, h: (), author: Caller, take count: u32) -> Result[Bytes, u32] {
    match w3c_bytes(count) { Ok(take b) => Ok(take b), Error(_) => Error(1u32) }
}

fn w3c_key[A, R](f: View[Bytes], ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Bytes {
    let mut key: Bytes = clone(f)
    std.codec.put_u64(result.unwrap(std.codec.fingerprint(ca)), mut key)
    std.codec.put_u64(result.unwrap(std.codec.fingerprint(cr)), mut key)
    key
}

fn transport_receive[G: send, B: send](mut s: WireSession[G, B], mut w: WireWork) -> Option[Frame] {
    let frame = result.unwrap(wire_take_output(s, mut w))
    wire_sent(mut s, mut w)
    take frame
}

pub fn law_unread_client(tasks: Tasks, clock: Clock, random: Random) -> bool {
    let mut reg: Registry[(), ()] = registry()
    result.unwrap(compute(mut reg, code.describe(w3c_bytes), 65536u64, DEFAULT_STEPS))
    result.unwrap(transact(mut reg, code.describe(w3c_tx), 65536u64, DEFAULT_STEPS))
    let carried: std.codec.Codec[Result[Bytes, u32]] = std.codec.of()
    let transact_key = w3c_key(code.identity(code.describe(w3c_tx)), std.codec.of_u32(), carried)
    let codec: std.codec.Codec[Bytes] = std.codec.of()
    let key = w3c_key(code.identity(code.describe(w3c_bytes)), std.codec.of_u32(), codec)
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(5u64)
    let service: Service[WireSession[(), ()]] = wire_service_seed(random, no_wire(), head, clock, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut s = take initial
    let mut work = wire_work()
    let (owner, events): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(5u64)
    s.me = Some(take owner)
    let caller = option.unwrap(anonymous_caller(random))
    s.caller = Some(take caller)
    s.phase = 3u8
    wire_know(mut s, reg, take key)
    wire_know(mut s, reg, take transact_key)
    for stream in 0u32 .. 5u32 {
        let mut arg: Bytes = list.new()
        std.codec.put_u32(8168u32, mut arg)
        let at = host.mono_ns(clock)
        result.unwrap(wire_call_ready(mut s, reg, mut work, WirePending(stream: stream, p: 0u64, wire_slot: 0u32, deadline: 10000u32, arg: take arg, at: at, grows: true)))
    }
    if wire_units(s) != 5u64 { return false }
    for completed in 0u64 .. 5u64 {
        let selected = result.unwrap(wire_step(mut s, mut work, WPoll(true)))
        if let None = selected { return false }
        if wire_units(s) != 5u64 - completed { return false }
        let _ = result.unwrap(wire_step(mut s, mut work, WPoll(false)))
        if wire_units(s) != 5u64 - completed { return false }
        let _ = result.unwrap(wire_step(mut s, mut work, WSent))
        if wire_units(s) != 4u64 - completed { return false }
    }
    // One durable group retains its units and V1 rows until Sent.
    let mut answers: List[KeyedDone] = list.new()
    for stream in 0u32 .. 5u32 {
        let mut arg: Bytes = list.new()
        std.codec.put_u32(8164u32, mut arg)
        let at = host.mono_ns(clock)
        result.unwrap(wire_call_ready(mut s, reg, mut work, WirePending(stream: stream, p: 0u64, wire_slot: 1u32, deadline: 10000u32, arg: take arg, at: at, grows: true)))
        let RunRequest(Req(e: take input)) = result.unwrap(channel.try_receive(requests)) else { return false }
        let Requested(Request(stream: take named, p: p, ..)) = take input else {
            return false
        }
        let mut reply_bytes: Bytes = list.new()
        let body = result.unwrap(w3c_bytes(8164u32))
        let value: Result[Bytes, u32] = Ok(take body)
        result.unwrap(std.codec.encode(carried, value, mut reply_bytes))
        list.push(mut answers, KeyedDone(stream: take named, p: p, outcome: Returned(take reply_bytes)))
    }
    result.unwrap(wire_update(mut s, mut work, Update(version: 7u64, content: None, outcomes: take answers)))
    if wire_units(s) != 5u64 || list.len(work.output) != 1u64 { return false }
    for stream in 5u32 .. 10u32 { result.unwrap(wire_refused(mut s, mut work, stream, 0u64, Budget(Room(requested: 9u64, available: 8u64)))) }
    if let Error(1008u16) = wire_refused(mut s, mut work, 10u32, 0u64, Overloaded) {} else { return false }
    let mut retained = 0u64
    for o in work.output { if let Batch(_, _, _, ds) = o.frame { for d in ds { retained += wire_done_size(d.outcome) } } }
    if retained != 41140u64 { return false }
    result.unwrap(wire_reset(mut s, mut work.output, 7u64))
    let reset = result.unwrap(wire_step(mut s, mut work, WPoll(true)))
    if wire_units(s) != 5u64 || s.refusals != 5u64 { return false }
    if let Error(1008u16) = wire_refused(mut s, mut work, 10u32, 0u64, Overloaded) {} else { return false }
    let _ = result.unwrap(wire_step(mut s, mut work, WSent))
    let preserved = match take reset {
        Some(Reset(7u64, take ds)) => {
            if list.len(ds) != 10u64 { false } else {
                let mut ok = true
                let mut count = 0u32
                for take d in take ds {
                    if d.stream != count || d.p != 0u64 { ok = false }
                    if count < 5u32 {
                        if let Returned(b) = d.outcome { if list.len(b) != 8172u64 || b[0u64] != 0u8 || b[4u64] != 228u8 || b[5u64] != 31u8 || b[8u64] != 3u8 || b[8171u64] != 3u8 { ok = false } } else { ok = false }
                    } else {
                        if let Refused(Budget(Room(requested: 9u64, available: 8u64))) = d.outcome {} else { ok = false }
                    }
                    count += 1u32
                }
                ok
            }
        },
        _ => false,
    }
    let no_head = match channel.try_receive(requests) { Error(Empty) => true, _ => false }
    let freed = wire_units(s) == 0u64 && s.refusals == 0u64 && list.len(work.output) == 0u64
    let legacy = result.unwrap(w3c_bytes(8173u32))
    let mut unfit: List[KeyedDone] = list.new()
    list.push(mut unfit, KeyedDone(stream: list.new(), p: 0u64, outcome: Returned(take legacy)))
    let refused_legacy = match wire_update(mut s, mut work, Update(version: 9u64, content: None, outcomes: take unfit)) { Error(1009u16) => true, _ => false }
    let unchanged = s.last == 7u64 && list.len(work.output) == 0u64
    let readmitted = match wire_refused(mut s, mut work, 10u32, 0u64, Overloaded) {
        Ok(()) => s.refusals == 1u64,
        Error(_) => false,
    }
    preserved && freed && no_head && refused_legacy && unchanged && readmitted
}

pub fn law_hello_and_slots(tasks: Tasks, clock: Clock, random: Random) -> bool {
    let mut reg: Registry[(), ()] = registry()
    result.unwrap(compute(mut reg, code.describe(w3c_bytes), 65536u64, DEFAULT_STEPS))
    result.unwrap(transact(mut reg, code.describe(w3c_tx), 65536u64, DEFAULT_STEPS))
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let service: Service[WireSession[(), ()]] = wire_service_seed(random, no_wire(), head, clock, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut s = take initial
    let mut work = wire_work()
    s.phase = 2u8
    let caller = option.unwrap(anonymous_caller(random))
    s.caller = Some(take caller)
    let entry_codec: std.codec.Codec[Result[Bytes, u32]] = std.codec.of()
    let entry = w3c_key(code.identity(code.describe(w3c_tx)), std.codec.of_u32(), entry_codec)
    wire_know(mut s, reg, clone(entry))
    let mut unknown: Bytes = list.new()
    list.append(mut unknown, string.as_bytes("missing"))
    let missing = wire_key(Want(identity: take unknown, args_fp: 0u64, result_fp: 0u64))
    wire_know(mut s, reg, take missing)
    wire_know(mut s, reg, clone(entry))
    if wire_can_read(s) { return false }
    if let Ok(Some(Welcome(_, 4u32, 1048576u64, _, _, _))) = wire_step(mut s, mut work, WPoll(true)) {} else { return false }
    if wire_can_read(s) { return false }
    if let Ok(Some(Placed(Ready(0u32)))) = wire_step(mut s, mut work, WPoll(true)) {} else { return false }
    if let Ok(Some(Placed(Gone))) = wire_step(mut s, mut work, WPoll(true)) {} else { return false }
    if let Ok(Some(Placed(Ready(2u32)))) = wire_step(mut s, mut work, WPoll(true)) {} else { return false }
    if wire_can_read(s) { return false }
    let _ = wire_step(mut s, mut work, WPoll(true))
    if !wire_can_read(s) { return false }
    if let Error(1008u16) = wire_step(mut s, mut work, WClient(Hello(None, list.new()), 0u64)) {} else { return false }
    let at = host.mono_ns(clock)
    result.unwrap(wire_call_ready(mut s, reg, mut work, WirePending(stream: 1u32, p: 2u64, wire_slot: 0xffffffffu32, deadline: 10u32, arg: list.new(), at: at, grows: true)))
    let refused = match transport_receive(mut s, mut work) { Some(Batch(0u64, _, _, ds)) => list.len(ds) == 1u64 && match ds[0u64].outcome { Refused(NoEntry) => true, _ => false }, _ => false }
    let empty = match channel.try_receive(requests) { Error(Empty) => true, _ => false }
    let mut old: Bytes = list.new()
    std.codec.put_u32(0u32, mut old)
    let mut changed: Bytes = list.new()
    std.codec.put_u32(1u32, mut changed)
    let named: Bytes = match s.caller { Some(who) => wire_stream(who, 1u32), _ => return false }
    let digest = store.request_digest(entry, old)
    map.insert(mut s.held, slot_key(named, 2u64), WireHeld(stream: 1u32, p: 2u64, digest: digest, forwarded: true, queued: 0u64, owed: list.new()))
    let mismatched = wire_check_live(s, Call(1u32, 2u64, 0u32, 10u32, take changed)) == Some(1008u16)
    let joined = wire_check_live(s, Call(1u32, 2u64, 2u32, 20u32, take old)) == None
    refused && empty && mismatched && joined
}

@test
fn test_wire_admission(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_join_cleanup() && law_unread_client(tasks, clock, random) && law_hello_and_slots(tasks, clock, random) && law_full_head_waits(tasks, clock, random) { Ok(()) } else { Error(()) }
}


pub fn law_join_cleanup() -> bool {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let (pub_to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(1u64)
    result.unwrap(channel.try_send(pub_to, PubIn(e: Drained)))
    let (closing, closed): (Sender[()], Receiver[()]) = channel.new(1u64)
    let lease = result.unwrap(WireJoinLease(closing: take closing, publisher: channel.sender(pub_to)))
    let mut joined: List[Joiner] = list.new()
    list.push(mut joined, Joiner(who: 7u64, to: take to, closed: Some(take closed), ended: list.new(), reset: false, read_failed: false, mark: None, identity: None, fence: None, due: false, progress: None, progressed: false, taken: None, handed: 0u64, http_credit: None))
    let _ = take lease
    let mut subs = subscriptions()
    let mut waiting: List[Replies] = list.new()
    settle(mut subs, mut joined, mut waiting, list.new(), 0u64)
    list.len(joined) == 0u64 && match channel.try_receive(from) { Ok(PubIn(e: Drained)) => true, _ => false }
}

type W3cHandles: shareable + send { data: store.Table[u64, u32] }

fn w3c_put(mut tx: store.Tx, h: W3cHandles, author: Caller, take value: u32) -> Result[u64, u32] {
    if let Error(_) = store.put(mut tx, h.data, 0u64, value) { return Error(1u32) }
    Ok(store.info(mut tx).id.version)
}

fn w3c_large(mut tx: store.Tx, h: W3cHandles, author: Caller, take count: u32) -> Result[Bytes, u32] {
    if let Error(_) = store.put(mut tx, h.data, 0u64, 99u32) { return Error(1u32) }
    match w3c_bytes(count) { Ok(take b) => Ok(take b), Error(_) => Error(2u32) }
}

fn w3c_registry() -> Registry[(), W3cHandles] {
    let mut r: Registry[(), W3cHandles] = registry()
    result.unwrap(transact(mut r, code.describe(w3c_put), 65536u64, DEFAULT_STEPS))
    result.unwrap(transact(mut r, code.describe(w3c_large), 65536u64, DEFAULT_STEPS))
    result.unwrap(compute(mut r, code.describe(w3c_bytes), 65536u64, DEFAULT_STEPS))
    result.unwrap(retain_gone(mut r, w3c_retired()))
    r
}

fn w3c_retired() -> Bytes {
    let mut key: Bytes = list.new()
    list.append(mut key, string.as_bytes("retired"))
    std.codec.put_u64(0u64, mut key)
    std.codec.put_u64(0u64, mut key)
    key
}

type W3cRig {
    head: Head[(), W3cHandles], owner: WireSession[(), ()], work: WireWork,
    requests: Receiver[HeadInput], releases: Receiver[PubIn], inbox: Receiver[WireEvent]
}

// The real wire owner, head and publisher delivery path, stepped without sockets.
// One pre-admitted unreplied gone call gives the same version oracle as the socket fixture.
fn w3c_rig(tasks: Tasks, clock: Clock, random: Random) -> W3cRig waits {
    w3c_rig_on(store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64))), tasks, clock, random)
}

fn w3c_rig_on(take backing: store.Db, tasks: Tasks, clock: Clock, random: Random) -> W3cRig waits {
    let mut db = take backing
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), std.codec.of_u32())))
    let data = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), std.codec.of_u32()))
    let caller = option.unwrap(anonymous_caller(random))
    let stream = wire_stream(caller, 77u32)
    let _ = result.unwrap(store.admit(mut db, stream, 0u64, store.request_digest(w3c_retired(), list.new())))
    let (to_head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(5u64)
    let (to_pub, releases): (Sender[PubIn], Receiver[PubIn]) = channel.new(5u64)
    let (to_owner, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(5u64)
    let service: Service[WireSession[(), ()]] = wire_service_seed(random, no_wire(), to_head, clock, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut owner = take initial
    owner.phase = 3u8
    owner.caller = Some(take caller)
    owner.me = Some(take to_owner)
    let put_codec: std.codec.Codec[Result[u64, u32]] = std.codec.of()
    let large_codec: std.codec.Codec[Result[Bytes, u32]] = std.codec.of()
    let big_codec: std.codec.Codec[Bytes] = std.codec.of()
    let entries = w3c_registry()
    wire_know(mut owner, entries, w3c_key(code.identity(code.describe(w3c_put)), std.codec.of_u32(), put_codec))
    wire_know(mut owner, entries, w3c_key(code.identity(code.describe(w3c_large)), std.codec.of_u32(), large_codec))
    wire_know(mut owner, entries, w3c_key(code.identity(code.describe(w3c_bytes)), std.codec.of_u32(), big_codec))
    wire_know(mut owner, entries, w3c_retired())
    let head = Head(db: take db, r: take entries, replay_identity: list.new(),
        h: arc.new(W3cHandles(data: data)), out: take to_pub, busy: map.new(), waiting: list.new(), group: list.new(), last: None, held: list.new(), wakes: false, minted: 0u64, cut: false, trigger_drive: None)
    W3cRig(head: take head, owner: take owner, work: wire_work(), requests: take requests, releases: take releases, inbox: take inbox)
}

fn w3c_arg(n: u32) -> Bytes {
    let mut b: Bytes = list.new()
    std.codec.put_u32(n, mut b)
    b
}

fn w3c_send(mut rig: W3cRig, stream: u32, p: u64, wire_slot: u32, take arg: Bytes) -> Frame waits {
    let at = host.mono_ns(rig.owner.clock)
    result.unwrap(wire_call_ready(mut rig.owner, rig.head.r, mut rig.work, WirePending(stream: stream, p: p, wire_slot: wire_slot, deadline: 10000u32, arg: take arg, at: at, grows: true)))
    if let Some(take out) = transport_receive(mut rig.owner, mut rig.work) { return take out }
    let RunRequest(take q) = result.unwrap(channel.try_receive(rig.requests)) else { fail("W3c: expected request") }
    result.unwrap(head_arrival(mut rig.head, take q, false, false))
    if list.len(rig.head.group) != 0u64 { result.unwrap(gate(mut rig.head)) }
    let release = result.unwrap(channel.try_receive(rig.releases))
    let PubIn(e: take released) = take release
    let answers = match take released { Released(Release(version: _, snapshot: _, answers: take a)) => take a, _ => fail("W3c: expected release") }
    let mut waiting: List[Replies] = list.new()
    let mut subs = subscriptions()
    let mut joined: List[Joiner] = list.new()
    let version = store.version(store.snapshot(rig.head.db))
    keep_answers(mut waiting, take answers)
    settle(mut subs, mut joined, mut waiting, list.new(), version)
    let WireEvent(e: take event) = result.unwrap(channel.try_receive(rig.inbox))
    let delivered = match take event { FromRunner(take message) => take message, _ => fail("W3c: expected runner event") }
    result.unwrap(wire_step(mut rig.owner, mut rig.work, WRunner(take delivered)))
    option.unwrap(transport_receive(mut rig.owner, mut rig.work))
}

fn w3c_answer(frame: Frame, version: u64, stream: u32, p: u64, expected: Outcome) -> bool {
    match frame {
        Batch(v, complete, rows, done) => {
            if v != version || list.len(complete) != 0u64 || list.len(rows) != 0u64 || list.len(done) != 1u64 { return false }
            let got = done[0u64]
            let codec: std.codec.Codec[Outcome] = std.codec.of()
            let mut a: Bytes = list.new()
            let mut b: Bytes = list.new()
            result.unwrap(std.codec.encode(codec, got.outcome, mut a))
            result.unwrap(std.codec.encode(codec, expected, mut b))
            got.stream == stream && got.p == p && a == b
        },
        _ => false,
    }
}

fn w3c_ok(version: u64) -> Outcome {
    let mut b: Bytes = list.new()
    std.codec.put_u32(0u32, mut b)
    std.codec.put_u64(version, mut b)
    Returned(take b)
}

fn w3c_close(take rig: W3cRig) -> () waits {
    let W3cRig(head: take hd, owner: _, work: _, requests: _, releases: _, inbox: _) = take rig
    let Head(db: take db, ..) = take hd
    result.unwrap(store.close(take db))
}

// RUNNER-SPEC v2.23 (§3 queue table): a full head inbox does not refuse. Other sessions fill
// the shared head; this owner's sends are still admitted, each keeping its deadline task, and
// reach the head in send order once it has room.
pub fn law_full_head_waits(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let filling = result.unwrap(head_lease(copy_wire_head(rig.owner.head)))
    let deadline = int.saturating_add(host.mono_ns(clock), 10000000000u64)
    for p in 0u64 .. 5u64 {
        let key = w3c_retired()
        let arg: Bytes = list.new()
        let digest = store.request_digest(key, arg)
        let request = Request(caller: store.Caller(issuer: 1, subject: list.new()), stream: list.new(), p: p, key: take key, arg: take arg, digest: digest,
            deadline: deadline, reply_to: WireReply(wire_me(rig.owner)), live: latest.handle(filling.live),
            identity: latest.handle(filling.identity), seed: result.unwrap(owner_seed(filling)))
        if let Posted = try_head(rig.owner.head, Req(e: Requested(take request))) {} else { return false }
    }
    for stream in 0u32 .. 5u32 {
        let at = host.mono_ns(clock)
        let pending = WirePending(stream: stream, p: 0u64, wire_slot: 0u32, deadline: 10000u32, arg: w3c_arg(7u32), at: at, grows: true)
        result.unwrap(wire_call_ready(mut rig.owner, rig.head.r, mut rig.work, take pending))
        if let Some(_) = transport_receive(mut rig.owner, mut rig.work) { return false }
    }
    if map.len(rig.work.timers) != 5u64 { return false }
    for _ in 0u64 .. 5u64 { let _ = result.unwrap(channel.try_receive(rig.requests)) }
    if !wire_post(mut rig.work) { return false }
    for stream in 0u32 .. 5u32 {
        let RunRequest(Req(e: take got)) = result.unwrap(channel.try_receive(rig.requests)) else { return false }
        let named = match rig.owner.caller { Some(c) => wire_stream(c, stream), None => return false }
        match take got {
            Requested(take q) => if q.stream != named { return false },
            _ => return false,
        }
    }
    w3c_close(take rig)
    true
}

pub fn law_gone_slot_v5(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let mut ok = true
    for (p, v) in [(0u64, 3u64), (0u64, 3u64), (1u64, 5u64), (1u64, 5u64)] {
        let out = w3c_send(mut rig, 77u32, p, 3u32, list.new())
        ok = w3c_answer(out, v, 77u32, p, Failed(Gone)) && ok
    }
    ok = store.version(store.snapshot(rig.head.db)) == 5u64 && ok
    w3c_close(take rig)
    ok
}

pub fn law_request_mismatch_wire(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let first = w3c_send(mut rig, 0u32, 0u64, 0u32, w3c_arg(7u32))
    let mut ok = w3c_answer(first, 4u64, 0u32, 0u64, w3c_ok(4u64))
    let changed = w3c_send(mut rig, 0u32, 0u64, 0u32, w3c_arg(8u32))
    ok = w3c_answer(changed, 4u64, 0u32, 0u64, Refused(RequestMismatch)) && ok
    ok = store.version(store.snapshot(rig.head.db)) == 4u64 && result.unwrap(store.get(result.unwrap(store.reader(rig.head.db, 0u64)), store.snapshot(rig.head.db), rig.head.h.data, 0u64)) == Some(7u32) && ok
    w3c_close(take rig)
    ok
}

pub fn law_history_below_latest(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let mut ok = true
    for (p, v) in [(0u64, 4u64), (1u64, 6u64)] {
        let out = w3c_send(mut rig, 0u32, p, 0u32, w3c_arg(7u32))
        ok = w3c_answer(out, v, 0u32, p, w3c_ok(v)) && ok
    }
    let old = w3c_send(mut rig, 0u32, 0u64, 0u32, w3c_arg(9u32))
    ok = w3c_answer(old, 6u64, 0u32, 0u64, Refused(HistoryUnavailable)) && ok
    ok = store.version(store.snapshot(rig.head.db)) == 6u64 && result.unwrap(store.get(result.unwrap(store.reader(rig.head.db, 0u64)), store.snapshot(rig.head.db), rig.head.h.data, 0u64)) == Some(7u32) && ok
    w3c_close(take rig)
    ok
}

pub fn law_reply_over_done_max(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let large = w3c_send(mut rig, 1u32, 0u64, 1u32, w3c_arg(8165u32))
    let mut ok = w3c_answer(large, 4u64, 1u32, 0u64, Failed(OutOfBytes(Room(requested: 8173u64, available: 8172u64))))
    let big = w3c_send(mut rig, 2u32, 0u64, 2u32, w3c_arg(8169u32))
    ok = w3c_answer(big, 4u64, 2u32, 0u64, Failed(OutOfBytes(Room(requested: 8173u64, available: 8172u64)))) && ok
    ok = store.version(store.snapshot(rig.head.db)) == 4u64 && result.unwrap(store.get(result.unwrap(store.reader(rig.head.db, 0u64)), store.snapshot(rig.head.db), rig.head.h.data, 0u64)) == None && ok
    w3c_close(take rig)
    ok
}

@test
fn test_durable_wire_admission(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_gone_slot_v5(tasks, clock, random) && law_request_mismatch_wire(tasks, clock, random) && law_history_below_latest(tasks, clock, random) && law_reply_over_done_max(tasks, clock, random) { Ok(()) } else { Error(()) }
}

fn wire_deliver_content(mut owner: WireSession[(), ()], mut work: WireWork, inbox: Receiver[WireEvent]) -> () waits {
    let WireEvent(e: take event) = result.unwrap(channel.receive(inbox))
    match take event {
        FromRunner(take incoming) => { result.unwrap(wire_step(mut owner, mut work, WRunner(take incoming))); },
        _ => fail("expected publisher content"),
    }
}

fn wire_initial_count(frame: Option[Frame], sub: u32, count: u64) -> bool {
    match frame {
        Some(Batch(_, complete, groups, done)) => list.len(complete) == 1u64 && complete[0] == sub &&
            list.len(groups) == 1u64 && list.len(groups[0u64].rows) == count && list.len(done) == 0u64,
        _ => false,
    }
}

// G3 permits replacing a live id. Both the publisher's deliveries and the
// frames waiting for the writer can outlive the query that produced them.
pub fn law_wire_replacement_generation(tasks: Tasks, c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, result.unwrap(store.sized(Memory, 1074790400u64)))
    let h = result.unwrap(install_subs_data(mut db))
    let t: store.Table[u64, u64] = clone(h.t)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = channel.new(1u64)
    let pub_job = Publish(place: code.describe(subs_place), n_place: 1048576u64, staging: 1048576u64,
        h: arc.new(take h), read_handle: result.unwrap(store.reader(db, 0u64)), base: take base, from: take from, rounds: take rounds, ready: take ready_to)
    let publishing = task.spawn(tasks, bytes 8388608u64, take pub_job, publish)
    if let Ok(None) = channel.receive(ready_from) {} else { return false }
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let config = wire_defaults(1048576u64)
    let service: Service[WireSession[(), ()]] = wire_service_seed(r, no_wire(), head, c, tasks, config, string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let (events, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(5u64)
    let (told, who): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    let (closing, closed): (Sender[()], Receiver[()]) = channel.new(1u64)
    result.unwrap(channel.send(to, PubIn(e: Joined(Join(to: take events, told: take told, mark: None, closed: Some(take closed), identity: None, fence: None, progress: None, taken: None, first: None, http_credit: None)))))
    owner.joined = Some(result.unwrap(channel.receive(who)).who)
    owner.publisher = Some(channel.sender(to))
    if let Ok(WireEvent(e: JoinReady)) = channel.receive(inbox) {} else { return false }

    wire_subscribed(mut owner, mut work, 10u32, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    wire_deliver_content(mut owner, mut work, inbox)
    let _ = transport_receive(mut owner, mut work)

    let sub = 8u32
    wire_subscribed(mut owner, mut work, sub, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    wire_deliver_content(mut owner, mut work, inbox)
    wire_subscribed(mut owner, mut work, sub, SubscriptionInput(room: None, key: query_key(code.describe(qf)), arg: no_arg(), caller: law_caller(1u64)))
    let old_initial_discarded = match transport_receive(mut owner, mut work) { None => true, _ => false }
    wire_deliver_content(mut owner, mut work, inbox)
    let new_initial = transport_receive(mut owner, mut work)
    let replacement_published = wire_initial_count(new_initial, sub, 1u64)

    set(mut db, t, 2u64, 2u64)
    let snapshot = store.snapshot(db)
    let version = store.version(snapshot)
    result.unwrap(channel.send(to, PubIn(e: Released(Release(version: version, snapshot: Some(take snapshot), answers: list.new())))))
    let stale = result.unwrap(channel.receive(inbox))
    wire_subscribed(mut owner, mut work, sub, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    if let WireEvent(e: FromRunner(take old_end)) = take stale {
        result.unwrap(wire_step(mut owner, mut work, WRunner(take old_end)))
    } else { return false }
    wire_deliver_content(mut owner, mut work, inbox)
    let after_end = transport_receive(mut owner, mut work)
    let other_sub_kept = match take after_end {
        Some(Batch(_, complete, groups, _)) => list.len(complete) == 0u64 &&
            list.len(groups) == 1u64 && groups[0u64].sub == 10u32 && list.len(groups[0u64].rows) == 1u64,
        _ => false,
    }
    let renewed = transport_receive(mut owner, mut work)
    let stale_end_discarded = other_sub_kept && wire_initial_count(renewed, sub, 2u64)

    // The old complete can still be in the owner inbox when a replacement arrives.
    wire_subscribed(mut owner, mut work, 3u32, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    wire_subscribed(mut owner, mut work, 3u32, SubscriptionInput(room: None, key: list.new(), arg: no_arg(), caller: law_caller(1u64)))
    wire_deliver_content(mut owner, mut work, inbox)
    wire_deliver_content(mut owner, mut work, inbox)
    let stale_complete_discarded = match transport_receive(mut owner, mut work) {
        Some(Ended(3u32, Refused(NoEntry))) => true,
        _ => false,
    }
    result.unwrap(channel.send(to, PubIn(e: Halt)))
    let _ = task.join(take publishing)
    let _ = take closing
    let _ = take requests
    result.unwrap(store.close(take db))
    old_initial_discarded && replacement_published && stale_end_discarded && stale_complete_discarded
}

@test
fn test_wire_replacement_generation(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_wire_replacement_generation(tasks, clock, random) { Ok(()) } else { Error(()) }
}

// L33. The store has published new roots, then the frame handoff fails.
// The head leaves without any Release for the outstanding caller.
pub fn law_after_publication(d: Dir, tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut label = string.with_capacity(32)
    let dir = result.unwrap(host.mkdtemp(d, mut label))
    let disk = result.unwrap(store.open(tasks, dir, clock, random, result.unwrap(store.sized(Directory, 2147483648u64))))
    let mut rig = w3c_rig_on(take disk, tasks, clock, random)
    let caller = store.Caller(issuer: 1u8, subject: list.new())
    let stream = result.unwrap(stream_key(caller, 51u32))
    let codec: std.codec.Codec[Result[u64, u32]] = std.codec.of()
    let chosen = w3c_key(code.identity(code.describe(w3c_put)), std.codec.of_u32(), codec)
    let (to, from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1)
    let req = head_request(take caller, take stream, 0u64, take chosen, w3c_arg(7u32), take to)
    let Req(e: Requested(take request)) = take req else { return false }
    let admission = result.unwrap(store.admit(mut rig.head.db, request.stream, request.p, request.digest))
    let Admitted(take complete) = take admission else { return false }
    let before = store.version(store.snapshot(rig.head.db))
    store.fixture_broken_handoff(mut rig.head.db)
    let observed = execute(mut rig.head, take request, take complete)
    let poisoned = match observed { Error(Poisoned(Closed)) => true, _ => false }
    let no_release = match channel.try_receive(rig.releases) { Error(Empty) => true, _ => false }
    let no_outcome = match channel.try_receive(from) { Error(Closed) => true, _ => false }
    let after = store.snapshot(rig.head.db)
    let published = store.version(after) == before + 1u64 &&
        result.unwrap(store.get(result.unwrap(store.reader(rig.head.db, 0u64)), after, rig.head.h.data, 0u64)) == Some(7u32)
    let W3cRig(head: take owned, ..) = take rig
    let Head(db: take db, ..) = take owned
    let _ = store.close(take db)
    poisoned && no_release && no_outcome && published
}

@test
fn test_after_publication(d: Dir, tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_after_publication(d, tasks, clock, random) { Ok(()) } else { Error(()) }
}

// L28 (v2.19, outcome_dropped): a unit the writer drops loses its content and keeps its
// Outcome rows, which ride in the owner's next Reset; a Dropped never counts toward the
// protocol-error close, so a second one sends a second Reset rather than closing 1008.
pub fn law_dropped_keeps_outcomes(tasks: Tasks, c: Clock, r: Random) -> bool {
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[(), ()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let mut ok = true
    for p in 5u64 .. 7u64 {
        let mut complete: List[u32] = list.new()
        list.push(mut complete, 1u32)
        let mut done: List[Done] = list.new()
        list.push(mut done, Done(stream: 3u32, p: p, outcome: Refused(NoEntry)))
        wire_queue_checked(mut work.output, Batch(4u64, take complete, list.new(), take done), list.new(), list.new(), Some(4u64))
        let taken = match result.unwrap(wire_take_output(owner, mut work)) {
            Some(Batch(_, _, _, _)) => true,
            _ => false,
        }
        let dropped = match wire_step(mut owner, mut work, WDropped) {
            Ok(_) => true,
            Error(_) => false,
        }
        let reset = match result.unwrap(wire_take_output(owner, mut work)) {
            Some(Reset(_, ds)) => list.len(ds) == 1u64 && ds[0].stream == 3u32 && ds[0].p == p,
            _ => false,
        }
        wire_sent(mut owner, mut work)
        ok = ok && taken && dropped && reset && !owner.reset_seen && list.len(work.output) == 0u64
    }
    let _ = take requests
    ok
}

@test
fn test_dropped_keeps_outcomes(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] {
    if law_dropped_keeps_outcomes(tasks, clock, random) { Ok(()) } else { Error(()) }
}

// A whole board of sub 1 as a repair's rows: REPAIR_KEYS keys, each holding `mark` bytes of
// REPAIR_VALUE, so one repair is about a fifth of `budget` and fits a frame.
const REPAIR_KEYS: u64 = 10u64
const REPAIR_VALUE: u64 = 20000u64

fn repair_board(mark: u8) -> List[SubRow] {
    let mut rows: List[SubRow] = list.new()
    for k in 0u64 .. REPAIR_KEYS {
        let mut key: Bytes = list.new()
        std.codec.put_u64(k, mut key)
        let mut value: Bytes = list.new()
        for _ in 0u64 .. REPAIR_VALUE { list.push(mut value, mark) }
        list.push(mut rows, SubRow(sub: 1u32, key: take key, value: Some(take value)))
    }
    take rows
}

// L24 (v2.20, repair_delivered), the owner's half: a reader that is slow but responsive gets
// one repair after another while its writer is still busy. Each `complete` replaces sub 1's
// image from empty (v2.20 item 5), so the client reaches the newest board with no `Reset`
// (item 6 counts only coalesced rows against `budget`). Red when the owner keeps every
// superseded repair queued: the sixth whole board puts it over `budget`, and it resets.
pub fn law_repair_coalesced(tasks: Tasks, c: Clock, r: Random) -> bool {
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[(), ()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut owner = take initial
    let mut work = wire_work()
    owner.joined = Some(7u64)
    list.push(mut owner.subs, (1u32, 1u64))
    let repairs = 8u8
    let mut delivered = true
    for mark in 1u8 .. repairs + 1u8 {
        let version: u64 = 10u64 + int.widen(mark)
        let mut generations: List[(u32, u64)] = list.new()
        list.push(mut generations, (1u32, 1u64))
        let mut complete: List[u32] = list.new()
        list.push(mut complete, 1u32)
        let rows = repair_board(mark)
        let mut groups: List[OwedGroup] = list.new()
        list.push(mut groups, fixture_owed_group(1u32, rows))
        let owed = Owe(session: 7u64, version: version, generations: take generations, complete: take complete, rows: take rows, groups: take groups, ended: list.new(), group_bytes: 0u64, frame_limit: 18446744073709551615u64, reset: false, read_failed: false)
        if let Error(_) = wire_update(mut owner, mut work, Update(version: version, content: Some(take owed), outcomes: list.new())) { delivered = false }
    }
    // The client's image: every `complete` naming sub 1 replaces it from empty.
    let mut image: Map[Bytes, Bytes] = map.new()
    let mut reset = false
    while let Some(take frame) = transport_receive(mut owner, mut work) {
        match take frame {
            Batch(_, take complete, take groups, _) => {
                let rows = publication_rows(take groups)
                if list.len(complete) == 1u64 && complete[0] == 1u32 { image = map.new() }
                for take row in rows {
                    let SubRow(sub: _, key: take key, value: take value) = take row
                    if let Some(take v) = take value { map.insert(mut image, take key, take v) }
                }
            },
            _ => { reset = true },
        }
    }
    let mut exact = map.len(image) == REPAIR_KEYS
    for k in 0u64 .. REPAIR_KEYS {
        let mut key: Bytes = list.new()
        std.codec.put_u64(k, mut key)
        exact = exact && match map.get(image, key) {
            Some(v) => list.len(v) == REPAIR_VALUE && v[0] == repairs && v[REPAIR_VALUE - 1u64] == repairs,
            None => false,
        }
    }
    let _ = take requests
    delivered && !reset && !owner.reset_seen && exact
}

@test
fn test_repair_coalesced(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] {
    if law_repair_coalesced(tasks, clock, random) { Ok(()) } else { Error(()) }
}

fn held_quiet(from: Receiver[PubIn]) -> bool {
    match channel.try_receive(from) { Error(_) => true, _ => false }
}

// L28 (v2.19.2, remove_while_held): an owner removal (an Unsubscribed, a Subscribed that
// replaces a live sub, or the leave a Reset makes) reaches the publisher only while the
// writer holds no content unit. Otherwise the publisher forgets the read set the held unit
// was computed from, a later hit no longer fences it, and the writer releases it stale.
// Red on v2.19.1, which sent each removal at once.
pub fn law_removal_waits_for_writer(tasks: Tasks, c: Clock, r: Random) -> bool {
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[(), ()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let (to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(8u64)
    let (closing, closed): (Sender[()], Receiver[()]) = channel.new(1u64)
    owner.publisher = Some(channel.sender(to))
    owner.joined = Some(1u64)
    owner.phase = 3u8
    list.reserve(mut owner.leaving, 1u64)
    owner.join_lease = Some(result.unwrap(WireJoinLease(closing: take closing, publisher: channel.sender(to))))
    wire_subscribed(mut owner, mut work, 8u32, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    wire_subscribed(mut owner, mut work, 9u32, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    let idle_sent = match (channel.try_receive(from), channel.try_receive(from)) {
        (Ok(PubIn(e: WireSubscribed(1u64, 8u32, _, _))), Ok(PubIn(e: WireSubscribed(1u64, 9u32, _, _)))) => true,
        _ => false,
    }

    // The writer holds a content unit: a replacement of 9 and an Unsubscribe of 8 wait.
    work.check = Some(4u64)
    let replace_9: ServicePlan = PlannedSubscribe(9u32, SubscriptionInput(room: None, key: query_key(code.describe(qf)), arg: no_arg(), caller: law_caller(1u64)))
    let replaced = match wire_step(mut owner, mut work, WPrepared(box.new(take replace_9))) { Ok(_) => true, Error(_) => false }
    let unsubscribed = match wire_step(mut owner, mut work, WClient(Unsubscribe(8u32), 0u64)) { Ok(_) => true, Error(_) => false }
    let held = replaced && unsubscribed && held_quiet(from)
    let sent = match wire_step(mut owner, mut work, WSent) { Ok(_) => true, Error(_) => false }
    let flushed = sent && match (channel.try_receive(from), channel.try_receive(from)) {
        (Ok(PubIn(e: WireSubscribed(1u64, 9u32, _, _))), Ok(PubIn(e: Unsubscribed(1u64, 8u32)))) => true,
        _ => false,
    } && held_quiet(from)

    // A Reset made while the writer holds a unit keeps the session joined until it is sent.
    work.check = Some(5u64)
    let reset: ServicePlan = ResumeReset
    let reset_made = match wire_step(mut owner, mut work, WPrepared(box.new(take reset))) { Ok(_) => true, Error(_) => false }
    let lease_kept = reset_made && match channel.try_receive(closed) { Error(Empty) => true, _ => false } && held_quiet(from)
    let _ = wire_step(mut owner, mut work, WSent)
    let left = match channel.try_receive(closed) { Ok(()) => true, _ => false }

    let _ = take requests
    idle_sent && held && flushed && lease_kept && left
}

@test
fn test_removal_waits_for_writer(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] {
    if law_removal_waits_for_writer(tasks, clock, random) { Ok(()) } else { Error(()) }
}

fn repair_offer(mut b: Board[(), Qh], mut joined: List[Joiner]) -> u64 waits {
    let mut owes: List[Owe] = list.new()
    repair(mut b, mut joined, mut owes)
    let mut offered = 0u64
    for o in owes { offered += list.len(o.complete) }
    let mut waiting: List[Replies] = list.new()
    let at = store.version(b.base)
    settle(mut b.subs, mut joined, mut waiting, take owes, at)
    offered
}

fn owner_takes(mut owner: WireSession[(), ()], mut work: WireWork, inbox: Receiver[WireEvent]) -> bool {
    match channel.try_receive(inbox) {
        Ok(WireEvent(e: FromRunner(take notice))) => match wire_step(mut owner, mut work, WRunner(take notice)) { Ok(_) => true, Error(_) => false },
        _ => false,
    }
}

// L24 (v2.22, repair_one_unsent): a repair is sent only when the session holds no other repair
// `complete` the owner has not sent; until then the sub stays due. Session 7's sub 1 is due and
// its owner has drained, so the publisher hands it one repair. The owner takes it, but its
// writer has not sent it when the sub bounces again and the owner drains again: the publisher
// owes nothing, and the sub stays due. Once the writer sends the first repair, the owner wakes
// the publisher, and the next pass owes exactly one `complete` of sub 1. Red when the publisher
// repairs on the drain token alone (v2.20), which queues a second whole repair behind the first.
pub fn law_repair_one_unsent(tasks: Tasks, c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, result.unwrap(store.sized(Memory, 1074790400u64)))
    let h = result.unwrap(install_subs_data(mut db))
    let t: store.Table[u64, u64] = clone(h.t)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    let board_reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let mut bound_registry = take board_reg
    result.unwrap(bind_query_slots(mut bound_registry, h))
    let mut b = Board(r: take bound_registry, h: arc.new(take h), read_handle: result.unwrap(store.reader(db, 0u64)), reads: publisher_reads(), base: store.snapshot(db), newest: None, subs: subscriptions())
    let _ = at_base_generation(mut b, 7u64, 1u32, 1u64, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))

    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[(), ()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let (to_owner, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(8u64)
    let (to_pub, from_pub): (Sender[PubIn], Receiver[PubIn]) = channel.new(8u64)
    owner.me = Some(channel.sender(to_owner))
    owner.publisher = Some(take to_pub)
    owner.phase = 3u8
    owner.joined = Some(7u64)
    list.push(mut owner.subs, (1u32, 1u64))
    list.push(mut owner.pub_subs, 1u32)
    let zero = arc.new(Taken(n: 0u64))
    let root = latest.new(take zero)
    let register = latest.handle(root)
    owner.taken = Some(take root)
    let (token, progress): (Sender[()], Receiver[()]) = channel.new(1u64)
    let mut joined: List[Joiner] = list.new()
    list.push(mut joined, Joiner(who: 7u64, to: take to_owner, closed: None, ended: list.new(), reset: false, read_failed: false, mark: None, identity: None, fence: None, due: false, progress: Some(take progress), progressed: false, taken: Some(take register), handed: 0u64, http_credit: None))

    // The first repair: due, and the owner drained.
    let _ = mark_due(mut b.subs, 7u64, 1u32)
    joined[0].due = true
    let _ = channel.try_send(token, ())
    let first = repair_offer(mut b, mut joined)
    let took = owner_takes(mut owner, mut work, inbox)

    // The sub bounces again and the owner drains again, while the first repair is unsent.
    let _ = mark_due(mut b.subs, 7u64, 1u32)
    joined[0].due = true
    let _ = channel.try_send(token, ())
    let held = repair_offer(mut b, mut joined) == 0u64 && joined[0].due

    // The writer sends the first repair; the owner wakes the publisher.
    let sent_complete = match wire_step(mut owner, mut work, WPoll(true)) {
        Ok(Some(Batch(_, complete, _, _))) => list.len(complete) == 1u64 && complete[0] == 1u32,
        _ => false,
    }
    let sent = sent_complete && match wire_step(mut owner, mut work, WSent) { Ok(_) => true, Error(_) => false }
    let woke = match channel.try_receive(from_pub) { Ok(PubIn(e: Drained)) => true, _ => false }
    let second = repair_offer(mut b, mut joined)

    let _ = take requests
    first == 1u64 && took && held && sent && woke && second == 1u64 && !joined[0].due
}

@test
fn test_repair_one_unsent(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_repair_one_unsent(tasks, clock, random) { Ok(()) } else { Error(()) }
}

type BurstDrain: send { from: Receiver[PubIn], back: Sender[Receiver[PubIn]] }

// The publisher's side of a full PubIn: it takes the message that filled the inbox, then hands
// the inbox back to the law.
fn burst_drain(take d: BurstDrain) -> Result[(), ()] waits {
    let BurstDrain(from: take from, back: take back) = take d
    let _ = channel.receive(from)
    let _ = channel.send(back, take from)
    Ok(())
}

// L23 (v2.22, join_waits): a Subscribe that makes its owner join is not refused because PubIn
// is full while the place is not overloaded. Its Join waits in PubIn like `connect`'s, and it
// carries that first Subscribe, so a PubIn that fills again before the Admit arrives refuses
// nothing either. The owner answers `Refused(Overloaded)` to neither, and sub 1 is live at the
// generation its Join named. Red when the owner `try_send`s its Join (v2.12 item 3), and when
// it sends the first Subscribe as its own `WireSubscribed` after the Admit.
pub fn law_join_waits(tasks: Tasks, c: Clock, r: Random) -> bool waits {
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[(), ()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, finish: _, check: _) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let (to_owner, _inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(8u64)
    let (to_pub, from_pub): (Sender[PubIn], Receiver[PubIn]) = channel.new(1u64)
    let (back_to, back): (Sender[Receiver[PubIn]], Receiver[Receiver[PubIn]]) = channel.new(1u64)
    owner.me = Some(take to_owner)
    owner.publisher = Some(channel.sender(to_pub))
    owner.phase = 3u8
    // Another session's message fills PubIn.
    result.unwrap(channel.try_send(to_pub, PubIn(e: Drained)))
    let subscribe: ServicePlan = PlannedSubscribe(1u32, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    let applied = match wire_step(mut owner, mut work, WPrepared(box.new(take subscribe))) { Ok(_) => true, Error(_) => false }
    let not_refused_full = wire_no_end(work.output)
    let draining = task.spawn(tasks, bytes 1048576u64, BurstDrain(from: take from_pub, back: take back_to), burst_drain)
    wire_join_send(mut work, to_pub)
    let inbox = match channel.receive(back) { Ok(take i) => take i, Error(_) => return false }
    let _ = task.join(take draining)
    let first: Option[JoinSubscribe] = None
    let mut carried = take first
    let mut told: Option[Sender[Admit]] = None
    if let Ok(PubIn(e: Joined(take j))) = channel.try_receive(inbox) {
        let Join(to: _, told: take answer, mark: _, closed: _, identity: _, fence: _, progress: _, taken: _, first: take sub, http_credit: _) = take j
        told = Some(take answer)
        carried = take sub
    }

    // PubIn fills again before the owner sees its Admit.
    result.unwrap(channel.try_send(to_pub, PubIn(e: Drained)))
    let round_at = arc.new(std.http.ReleaseRound(at: 0u64))
    let rounds = latest.new(take round_at)
    let mut admit_sent = false
    if let Some(take to) = take told {
        let admit = Admit(who: 7u64, round: latest.handle(rounds))
        admit_sent = match channel.try_send(to, take admit) { Ok(_) => true, _ => false }
    }
    let polled = match wire_step(mut owner, mut work, WPoll(false)) { Ok(_) => true, Error(_) => false }
    let not_refused = wire_no_end(work.output)
    let generation = match take carried { Some(take f) => if f.sub == 1u32 { f.generation } else { 0u64 }, None => 0u64 }
    let live = generation != 0u64 && match sub_generation(owner.subs, 1u32) { Some(g) => g == generation, None => false }
    let joined_seven = match owner.joined { Some(who) => who == 7u64, None => false }

    let _ = take requests
    applied && not_refused_full && admit_sent && polled && not_refused && live && joined_seven
}

fn wire_no_end(output: List[WireOutput]) -> bool {
    for o in output { if let Ended(_, _) = o.frame { return false } }
    true
}

@test
fn test_join_waits(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_join_waits(tasks, clock, random) { Ok(()) } else { Error(()) }
}

fn keep_answers(mut waiting: List[Replies], take answers: List[CallAnswer]) {
    for take answer in answers {
        if let CallAnswer(take recipient, take row) = take answer {
            keep_wire_answer(mut waiting, take recipient, take row)
        }
    }
}

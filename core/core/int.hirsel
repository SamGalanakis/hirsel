// Module `int` (SEM-1).

pub fn wrapping_add[T: integer](a: T, b: T) -> T
pub fn wrapping_sub[T: integer](a: T, b: T) -> T
pub fn wrapping_mul[T: integer](a: T, b: T) -> T
pub fn wrapping_neg[T: integer](a: T) -> T
pub fn wrapping_shl[T: integer](a: T, n: u32) -> T
pub fn checked_add[T: integer](a: T, b: T) -> Option[T]
pub fn checked_sub[T: integer](a: T, b: T) -> Option[T]
pub fn checked_mul[T: integer](a: T, b: T) -> Option[T]
pub fn checked_div[T: integer](a: T, b: T) -> Option[T]
pub fn saturating_add[T: integer](a: T, b: T) -> T
pub fn saturating_sub[T: integer](a: T, b: T) -> T
pub fn saturating_mul[T: integer](a: T, b: T) -> T
pub fn mul_wide(a: u64, b: u64) -> (u64, u64)
pub fn leading_zeros[T: integer](x: T) -> u32
pub fn widen[T: integer, U: integer](x: T) -> U
pub fn narrow[T: integer, U: integer](x: T) -> U
pub fn try_narrow[T: integer, U: integer](x: T) -> Option[U]
pub fn truncate[T: integer, U: integer](x: T) -> U
pub fn parse[T: integer](s: String) -> Result[T, ParseError] {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if n == 0 {
        return Error(Empty)
    }
    // T is signed exactly when it holds -1.
    let minus_one: Option[T] = int.try_narrow(-1i8)
    let negative = b[0] == b'-' && match minus_one {
        Some(_) => true,
        None => false,
    }
    let start: u64 = if negative {
        1
    } else {
        0
    }
    if start == n {
        return Error(Invalid(0))
    }
    // The magnitude in u64, which holds every T's magnitude (|i64 MIN| = 2^63). Up to
    // 1844674407370955160 (floor((2^64 - 1) / 10) - 1), ten times it plus a digit is at most
    // 2^64 - 7, so that step cannot wrap; past it the step is checked and a magnitude past
    // 2^64 - 1 only sets big. The grammar is still read to the end before the range.
    let mut mag: u64 = 0
    let mut big = false
    for i in start .. n {
        let x = b[i]
        if x < b'0' || x > b'9' {
            return Error(Invalid(i))
        }
        let d: u64 = int.widen(x - b'0')
        if mag <= 1844674407370955160 {
            mag = int.wrapping_add(int.wrapping_mul(mag, 10), d)
        } else if !big {
            match int.checked_mul(mag, 10) {
                Some(m) => match int.checked_add(m, d) {
                    Some(v) => {
                        mag = v
                    },
                    None => {
                        big = true
                    },
                },
                None => {
                    big = true
                },
            }
        }
    }
    if big {
        return Error(OutOfRange)
    }
    if !negative || mag == 0 {
        let fit: Option[T] = int.try_narrow(mag)
        return match fit {
            Some(v) => Ok(v),
            None => Error(OutOfRange),
        }
    }
    // -mag fits exactly when mag - 1 fits, and is then (0 - (mag - 1)) - 1: both steps
    // stay in [MIN, 0], so neither check can fail.
    let below: Option[T] = int.try_narrow(mag - 1)
    let zero: T = int.narrow(0u8)
    let one: T = int.narrow(1u8)
    let value: Option[T] = match below {
        Some(v) => match int.checked_sub(zero, v) {
            Some(w) => int.checked_sub(w, one),
            None => None,
        },
        None => None,
    }
    match value {
        Some(v) => Ok(v),
        None => Error(OutOfRange),
    }
}

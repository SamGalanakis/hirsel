// AWFY runs one verified inner loop per outer iteration.
pub fn main(out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let Some(name) = args.get(argv, 0) else {
        return Error(Exit(status: 2))
    }
    let (outer, inner) = iterations(argv)?
    let input = match args.get(argv, 3) {
        Some(value) => value,
        None => name,
    }
    for _ in 0 .. outer {
        match run(name, inner, input) {
            Ok(true) => {},
            Ok(false) => return Error(Exit(status: 1)),
            Error(_) => return Error(Exit(status: 3)),
        }
        match stdout.write(out, "verified\n") {
            Ok(()) => {},
            Error(_) => return Error(Exit(status: 4)),
        }
    }
    Ok(())
}

pub fn iterations(argv: Args) -> Result[(u64, u64), Exit] {
    let Some(outer_arg) = args.get(argv, 1) else {
        return Error(Exit(status: 2))
    }
    let Some(inner_arg) = args.get(argv, 2) else {
        return Error(Exit(status: 2))
    }
    let outer = match (int.parse(outer_arg) : Result[u64, ParseError]) {
        Ok(n) => n,
        Error(_) => return Error(Exit(status: 2)),
    }
    let inner = match (int.parse(inner_arg) : Result[u64, ParseError]) {
        Ok(n) => n,
        Error(_) => return Error(Exit(status: 2)),
    }
    if outer == 0 || inner == 0 {
        return Error(Exit(status: 2))
    }
    Ok((outer, inner))
}

pub fn next_number(input: String, mut at: u64, limit: u64) -> Option[u64] {
    let digits = string.as_bytes(input)
    let size = list.len(digits)
    let start = at
    while at < size && digits[at] != 44 {
        at += 1
    }
    let parsed: Result[u64, ParseError] = int.parse(string.slice(input, start, at))
    at = if at == size { 0 } else { at + 1 }
    let Ok(n) = parsed else { return None }
    if n > 0 && n <= limit { Some(n) } else { None }
}

fn repeat_number(inner: u64, input: String, limit: u64, check: scoped fn(u64) -> Result[bool, Capacity]) -> Result[bool, Capacity] {
    let mut at = 0u64
    for _ in 0 .. inner {
        let Some(n) = next_number(input, mut at, limit) else {
            return Ok(false)
        }
        if !check(n)? {
            return Ok(false)
        }
    }
    Ok(true)
}

// Each workload is its own entry, reached through a function value as Rust's
// harness reaches its per-benchmark entries, so no workload is compiled into the
// dispatcher and one workload's code never shares a register allocation with another's.
type Entry = fn(u64, String) -> Result[bool, Capacity]

fn run(name: String, inner: u64, input: String) -> Result[bool, Capacity] {
    let Some(workload) = entry(name) else {
        return Ok(false)
    }
    workload(inner, input)
}

fn entry(name: String) -> Option[Entry] {
    if name == "CD" { return Some(run_cd) }
    if name == "Bounce" { return Some(run_bounce) }
    if name == "DeltaBlue" { return Some(run_deltablue) }
    if name == "Havlak" { return Some(run_havlak) }
    if name == "Json" { return Some(run_json) }
    if name == "List" { return Some(run_list) }
    if name == "Mandelbrot" { return Some(run_mandelbrot) }
    if name == "NBody" { return Some(run_nbody) }
    if name == "Permute" { return Some(run_permute) }
    if name == "Queens" { return Some(run_queens) }
    if name == "Richards" { return Some(run_richards) }
    if name == "Sieve" { return Some(run_sieve) }
    if name == "Storage" { return Some(run_storage) }
    if name == "Towers" { return Some(run_towers) }
    None
}

fn run_cd(inner: u64, _input: String) -> Result[bool, Capacity] {
    cd.benchmark(inner)
}

fn run_bounce(inner: u64, input: String) -> Result[bool, Capacity] {
    repeat_number(inner, input, 50, fn(steps: u64) -> Result[bool, Capacity] {
        Ok(small.bounce(steps) == 1331)
    })
}

fn run_deltablue(inner: u64, _input: String) -> Result[bool, Capacity] {
    deltablue.benchmark(inner)
}

fn run_havlak(inner: u64, _input: String) -> Result[bool, Capacity] {
    havlak.benchmark(inner)
}

fn run_json(inner: u64, input: String) -> Result[bool, Capacity] {
    for _ in 0 .. inner {
        if !json_parse.benchmark(input)? { return Ok(false) }
    }
    Ok(true)
}

fn run_list(inner: u64, input: String) -> Result[bool, Capacity] {
    repeat_number(inner, input, 15, fn(first: u64) -> Result[bool, Capacity] {
        Ok(lists.list_benchmark(first)? == 10)
    })
}

fn run_mandelbrot(inner: u64, _input: String) -> Result[bool, Capacity] {
    Ok(numeric.mandelbrot(inner))
}

fn run_nbody(inner: u64, _input: String) -> Result[bool, Capacity] {
    Ok(numeric.nbody(inner))
}

fn run_permute(inner: u64, input: String) -> Result[bool, Capacity] {
    repeat_number(inner, input, 6, fn(size: u64) -> Result[bool, Capacity] {
        Ok(small.permute(size) == 8660)
    })
}

fn run_queens(inner: u64, input: String) -> Result[bool, Capacity] {
    Ok(small.queens(inner, string.as_bytes(input)))
}

fn run_richards(inner: u64, input: String) -> Result[bool, Capacity] {
    repeat_number(inner, input, 10000, fn(count: u64) -> Result[bool, Capacity] {
        richards.benchmark(count)
    })
}

fn run_sieve(inner: u64, input: String) -> Result[bool, Capacity] {
    repeat_number(inner, input, 5000, fn(size: u64) -> Result[bool, Capacity] {
        Ok(small.sieve(size) == 669)
    })
}

fn run_storage(inner: u64, input: String) -> Result[bool, Capacity] {
    repeat_number(inner, input, 7, fn(depth: u64) -> Result[bool, Capacity] {
        Ok(trees.storage(depth)? == 5461)
    })
}

fn run_towers(inner: u64, input: String) -> Result[bool, Capacity] {
    repeat_number(inner, input, 13, fn(disks: u64) -> Result[bool, Capacity] {
        Ok(trees.towers_benchmark(disks)? == 8191)
    })
}

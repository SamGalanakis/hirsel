const DEFAULT_RETRY_SECONDS: u64 = 2u64

fn retry_after(head: std.http_client.ResponseHead, now_ms: u64) -> u64 {
    for i in 0u64 .. std.http_client.field_count(head) {
        let Some((name, value)) = std.http_client.field_at(head, i) else { continue }
        if std.http1.equal_ascii(name, b"retry-after") {
            if let Ok(text) = string.from_utf8(std.http.copy_bytes(value)) {
                let trimmed = string.trim_ascii(text)
                if let Some(seconds) = retry_seconds(trimmed, now_ms) { return seconds }
            }
        }
    }
    DEFAULT_RETRY_SECONDS
}

fn retry_seconds(value: String, now_ms: u64) -> Option[u64] {
    let raw = string.as_bytes(value)
    if list.len(raw) == 0u64 { return None }
    if raw[0u64] >= b'0' && raw[0u64] <= b'9' {
        let mut seconds = 0u64
        for b in raw {
            if b < b'0' || b > b'9' { return None }
            if seconds < harness.MAX_MODEL_BACKOFF_SECONDS {
                seconds = seconds * 10u64 + int.widen(b - b'0')
            }
        }
        return Some(if seconds > harness.MAX_MODEL_BACKOFF_SECONDS { harness.MAX_MODEL_BACKOFF_SECONDS } else { seconds })
    }
    let at = http_date(value, now_ms)?
    if at <= 0 { return Some(0u64) }
    let deadline: u64 = int.narrow(at)
    if now_ms >= deadline { return Some(0u64) }
    let remaining = deadline - now_ms
    let seconds = (remaining + 999u64) / 1000u64
    Some(if seconds > harness.MAX_MODEL_BACKOFF_SECONDS { harness.MAX_MODEL_BACKOFF_SECONDS } else { seconds })
}

fn month_number(month: String) -> Option[u8] {
    let names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    for i in 0u64 .. 12u64 { if month == names[i] { return Some(int.narrow(i + 1u64)) } }
    None
}

// HTTP-date accepts IMF-fixdate and the two obsolete HTTP date forms.
fn http_date(value: String, now_ms: u64) -> Option[i64] {
    let n = string.byte_len(value)
    let b = string.as_bytes(value)
    let (day_at, month_at, year_at, year_len, time_at) = if n == 29u64 && b[3u64] == b',' && b[4u64] == b' ' && string.ends_with(value, " GMT") {
        if b[7u64] != b' ' || b[11u64] != b' ' || b[16u64] != b' ' { return None }
        (5u64, 8u64, 12u64, 4u64, 17u64)
    } else if let Some(comma) = string.find(value, 0u64, ", ") {
        let start = comma + 2u64
        if n != start + 22u64 || !string.ends_with(value, " GMT") { return None }
        if b[start + 2u64] != b'-' || b[start + 6u64] != b'-' || b[start + 9u64] != b' ' { return None }
        (start, start + 3u64, start + 7u64, 2u64, start + 10u64)
    } else if n == 24u64 {
        if b[3u64] != b' ' || b[7u64] != b' ' || b[10u64] != b' ' || b[19u64] != b' ' { return None }
        (8u64, 4u64, 20u64, 4u64, 11u64)
    } else {
        return None
    }
    // Check month bytes before taking a UTF-8 string slice at fixed offsets.
    for i in month_at .. month_at + 3u64 { if b[i] < b'A' || b[i] > b'z' { return None } }
    let month = month_number(string.slice(value, month_at, month_at + 3u64))?
    let from = if b[day_at] == b' ' { day_at + 1u64 } else { day_at }
    let Ok(day) = int.parse_decimal_span(b, from, day_at + 2u64, 31u64) else { return None }
    let Ok(parsed) = int.parse_decimal_span(b, year_at, year_at + year_len, 9999u64) else { return None }
    let mut year = parsed
    if year_len == 2u64 {
        let today = std.time.from_unix_ms(now_ms)?
        let civil = std.time.civil(today, 0i32)?
        let current: u64 = int.widen(std.time.year(std.time.date_of(civil)))
        year += current / 100u64 * 100u64
        if year > current + 50u64 { year -= 100u64 }
    }
    let date = std.time.date(int.narrow(year), month, int.narrow(day))?
    if b[time_at + 2u64] != b':' || b[time_at + 5u64] != b':' { return None }
    let Ok(h) = int.parse_decimal_span(b, time_at, time_at + 2u64, 23u64) else { return None }
    let Ok(m) = int.parse_decimal_span(b, time_at + 3u64, time_at + 5u64, 59u64) else { return None }
    let Ok(s) = int.parse_decimal_span(b, time_at + 6u64, time_at + 8u64, 59u64) else { return None }
    let civil = std.time.at(date, int.narrow(h), int.narrow(m), int.narrow(s), 0u32)?
    let at = std.time.timestamp(civil, 0i32)?
    Some(std.time.unix_ms(at))
}

// Error details may be reflected in the UI. Omit likely provider keys and
// keep the text on one line.
fn clean_detail(message: String) -> Option[String] {
    if let Some(_) = string.find(message, 0u64, "sk-") { return None }
    let mut line: Bytes = list.new()
    for byte in string.as_bytes(message) {
        list.push(mut line, if byte < 32u8 || byte == 127u8 { b' ' } else { byte })
    }
    let Ok(clean) = string.from_utf8(take line) else { return None }
    let trimmed = string.trim_ascii(clean)
    if trimmed == "" { None } else { Some(string.from(trimmed)) }
}

fn error_text(status: u16, detail: Option[String]) -> String {
    let mut why = string.new()
    if status != 0u16 {
        string.push(mut why, "HTTP ")
        string.push_u64(mut why, int.widen(status))
    } else {
        string.push(mut why, "provider error")
    }
    if let Some(message) = detail {
        string.push(mut why, ": ")
        string.push(mut why, message)
    }
    take why
}

fn classify(status: u16, delay: u64, x: std.json.Json) -> harness.ModelFault {
    let code = str_at(x, "/error/code")
    let kind = str_at(x, "/error/type")
    let message = str_at(x, "/error/message")
    let detail = match message { Some(m) => clean_detail(m), None => None }
    let why = error_text(status, detail)
    let numeric = u64_at(x, "/error/code")
    if status == 429u16 || numeric == Some(429u64)
        || code == Some("rate_limit_exceeded") || kind == Some("rate_limit_error") {
        return Throttled(take why, delay)
    }
    let context = match message {
        Some(m) => {
            let mut lower = string.from(m)
            string.make_ascii_lower(mut lower)
            string.find(lower, 0u64, "context length") != None
                || string.find(lower, 0u64, "context window") != None
                || string.find(lower, 0u64, "prompt is too long") != None
                || string.find(lower, 0u64, "prompt too long") != None
        },
        None => false,
    }
    if code == Some("context_length_exceeded") || kind == Some("context_length_exceeded")
        || (context && (status == 0u16 || status == 400u16 || status == 413u16 || status == 422u16)) {
        return ContextExceeded(take why)
    }
    status_fault(status, delay, take why, kind, numeric)
}

fn status_fault(status: u16, delay: u64, take why: String, kind: Option[String], numeric: Option[u64]) -> harness.ModelFault {
    if status == 429u16 { return Throttled(take why, delay) }
    let server_error = match numeric { Some(n) => n >= 500u64 && n < 600u64, None => false }
    if (status >= 500u16 && status < 600u16) || status == 408u16 || status == 425u16
        || server_error || kind == Some("overloaded_error") || kind == Some("api_error") {
        Transient(take why, delay)
    } else {
        Rejected(take why)
    }
}

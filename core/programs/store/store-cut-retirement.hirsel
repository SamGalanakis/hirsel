// The cut's retirements: which removed packs leave now, which a lease
// carries to a later cut, and the generation's new pack state.
fn cut_retirement(layout: manifest.PagedCutLayout, holders: List[manifest.HeldPage], lease: Option[Arc[manifest.ExportLease]], scrubs: List[Arc[manifest.ScrubLease]], compaction: pager.TieredCompaction, range_lease: Option[(u64, u64)], first: u64, end: u64) -> Result[(manifest.PackDiskState, pager.TieredCompaction, DiskRemovals), Error] {
    let mut locations = manifest.share_page_locations(layout.locations)
    let mut packs: List[u64] = list.new()
    let mut carried: List[u64] = list.new()
    for seq in layout.lists.removals {
        let is_tiered = match manifest.disk_index_get(locations.packs, seq) {
            Some(pack) => pack.class >= 3,
            None => false,
        }
        if manifest.tiered_leased(compaction.held, seq) || (is_tiered && (manifest.pack_leased(lease, seq) || manifest.scrub_leased(scrubs, seq))) {
            // A retired Tiered pack leaves the inventory at once; its file
            // waits for the last read inventory, export lease or scrub lease.
            let _ = failure_result_from_rep(types.capacity(manifest.disk_index_remove(mut locations.packs, seq, manifest.pack_edge_charge)))?
            list.push(mut carried, seq)
        } else if manifest.pack_leased(lease, seq) || manifest.scrub_leased(scrubs, seq) {
            list.push(mut carried, seq)
        } else {
            let _ = failure_result_from_rep(types.capacity(manifest.disk_index_remove(mut locations.packs, seq, manifest.pack_edge_charge)))?
            list.push(mut packs, seq)
        }
    }
    let (before, after) = removal_spans(first, end, range_lease)
    let deferred: Option[u64] = if before.end < after.first {
        Some(before.end)
    } else {
        None
    }
    let plan = DiskRemovals(packs: take packs, before: before, after: after, name: string.with_capacity(26))
    let installed = manifest.retired_pack_disk(layout, holders, take locations, take carried, deferred)
    let kept_compaction: pager.TieredCompaction = clone(compaction)
    Ok((take installed, take kept_compaction, take plan))
}

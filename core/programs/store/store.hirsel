// The writer owns the persistent page trees; readers hold Arc roots.
pub type StoreId: codec + key {
    hi: u64,
    lo: u64
}

pub type StorageKind: send = Directory() | Bucket(std.object.Bucket)

pub type Caller: codec + key + shareable + cross {
    issuer: u8,
    subject: Bytes
}

pub type Limit: shareable + cross = Key | Value | Transaction | Name | Ids | Manifest | Triggers

pub type Why: shareable + cross = Checksum | Truncated | Flags | Kind(u64) | Header | Gap(u64) | Order | Dangling(u64) | Absent | Malformed | Regressed

pub type Fault: shareable + cross {
    file: String,
    offset: u64,
    why: Why
}

pub type StoreCapacity: shareable + cross = Journal(Capacity) | Resident(Capacity) | Allocation(Capacity) | Cache(Capacity) | Slots(Capacity) | Pins(Capacity) | Register(Capacity)

pub type Error: shareable + cross = Held | NotFound | Corrupt(Fault) | Unsupported(u64) | Io(IoError) | Poisoned(IoError) | Full(StoreCapacity) | Limit(Limit) | Schema(u64) | Stale(u32) | Decode(std.codec.DecodeError) | Exists(String) | Missing(String) | Changed(String) | Conflict(String) | Undeclared(String) | NoLevel(String) | Behind(Position) | Gone(u32) | Unseen(u32) | Diverged(u32) | Foreign | MigrationFault | ExportDirectory | Fenced(u64) | Lost | Superseded(Claim) | Undecided | Declared(String) | NotCurrent(u64) | Endpoint(EndpointRefusal) | HistoryMissing(String, Option[u64]) | Reclaimed(u64) | Retired | Remote(std.object.Error) | Missed | Tiered(TieredRefusal) | NotReady(String) | Drift(String) | LimitsDiffer(StoreLimits) | Attached(Option[HostStreamId]) | Stream(StreamRefusal) | Latched(StreamLatch)

pub opaque type Db {
    store: StoreId,
    pager: pager.PagerState,
    indexes: indexes.IndexOwner,
    schema: catalog.SchemaState,
    skip_test_teardown: bool,
    disk: Option[DiskState],
    clock: Clock,
    holders: pages.HolderTable,
    followers: List[BranchFollower],
    limits: StoreLimits,
    frame_seq: u64,
    accounting: txn.AccountingState,
    call_streams: txn.CallStreamState[Ticket],
    // Index drift seen since this open (§I.3 step one), one entry per index.
    // `attention_mark`'s own part (store-attention.hirsel).
    attention_seq: u64,
    // The projector pins' roots, rebuilt on each pin change; every Snapshot and
    // Tx shares them as `read_tail`'s bases. Then the registered projectors (§1.14).
    projectors: List[DeclaredProjector],
}

pub type Branch {
    store: StoreId,
    id: u32
}

// I4: while a pin or another branch exists, an old row may stay reachable, so
// commits charge conservatively until the next cut settles the account.
// An owner-3 pin's pages are its own (§3.5a, §13.10a), so it retains nothing.
fn retaining(db: Db) -> bool {
    list.len(pages.holder_heads(db.holders)) > 1 || std.list.any(pages.holder_pins(db.holders), fn(held: pages.Pin) -> bool {
        held.owner != ImportPin
    })
}

// Project the proposed holders into the checkpoint's input. The live holder
// slots and the table-id counter still describe the installed generation.
fn state_with_delta(db: Db, delta: HolderDelta) -> Result[pages.State, Capacity] {
    let mut tips: List[pages.Tip] = list.with_capacity(list.len(pages.holder_heads(db.holders)))
    let mut kept: List[pages.Pin] = list.with_capacity(list.len(pages.holder_pins(db.holders)))
    let mut tables = catalog.next_table_id(db.schema)
    for slot in 0u64 .. list.len(pages.holder_heads(db.holders)) {
        if let RemoveHead(gone) = delta {
            if slot == gone {
                continue
            }
        }
        if let ReplaceMain(proposed, gone) = delta {
            if let Some(away) = gone {
                if slot == away {
                    continue
                }
            }
            if slot == 0 {
                let h = pages.holder_heads(db.holders)[0u64]
                list.push(mut tips, pages.Tip(id: 0, name: string.from(h.name), parent: h.parent, forked_at: h.forked_at, roots: pages.share_roots(proposed.roots), head: proposed.head, at: proposed.at))
                tables = proposed.tables
                continue
            }
        }
        list.push(mut tips, pages.tip_of(pages.holder_heads(db.holders)[slot]))
    }
    if let AddHead(added, _) = delta {
        list.push(mut tips, pages.tip_of(added))
    }
    let dropped = removed_pins(delta)
    for slot in 0u64 .. list.len(pages.holder_pins(db.holders)) {
        if list.contains(dropped, slot) {
            continue
        }
        let held = if let ReplacePin(at, replacement) = delta {
            if at == slot {
                replacement
            } else {
                pages.holder_pins(db.holders)[slot]
            }
        } else {
            pages.holder_pins(db.holders)[slot]
        }
        list.push(mut kept, pages.share_pin(held)?)
    }
    if let AddPin(added) = delta {
        list.push(mut kept, pages.share_pin(added)?)
        list.sort(mut kept, fn(a: pages.Pin, b: pages.Pin) -> Order {
            manifest.pin_order(a.name, a.owner, b.name, b.owner)
        })
    }
    Ok(pages.State(tips: take tips, pins: take kept, next_branch: pages.holder_next_branch(db.holders), next_table: tables))
}

fn current_state(db: Db) -> Result[pages.State, Capacity] {
    state_with_delta(db, NoHolderChange)
}

fn prepare_holder_slot(mut db: Db, delta: HolderDelta) -> Result[(), Error] {
    match delta {
        AddHead(_, _) => failure_result_from_rep(types.capacity(pages.reserve_head(mut db.holders))),
        AddPin(_) => failure_result_from_rep(types.capacity(pages.reserve_pin(mut db.holders))),
        _ => Ok(()),
    }
}

fn install_head(mut db: Db, take added: pages.Head, take indexed_name: String) {
    let count_bytes = manifest.branch_root_bytes(added.name, added.roots)
    pages.add_head(mut db.holders, take added, take indexed_name, count_bytes)
}

fn remove_head(mut db: Db, slot: u64) {
    let head = pages.holder_heads(db.holders)[slot].id
    let count_bytes = manifest.branch_root_bytes(pages.holder_heads(db.holders)[slot].name, pages.holder_heads(db.holders)[slot].roots)
    pages.drop_head(mut db.holders, slot, count_bytes)
    if let Some(follow_slot) = branch_follower_slot(db.followers, head) {
        let _ = list.remove(mut db.followers, follow_slot)
    }
}

fn install_holder_delta(mut db: Db, take delta: HolderDelta) {
    match take delta {
        NoHolderChange => return (),
        AddHead(take added, take name) => install_head(mut db, take added, take name),
        RemoveHead(slot) => remove_head(mut db, slot),
        AddPin(take added) => {
            let count_bytes = manifest.pin_root_bytes(added.name, added.roots)
            let mut slot = 0u64
            while slot < list.len(pages.holder_pins(db.holders)) && manifest.pin_order(pages.holder_pins(db.holders)[slot].name, pages.holder_pins(db.holders)[slot].owner, added.name, added.owner) == Less {
                slot += 1
            }
            pages.add_pin(mut db.holders, slot, take added, count_bytes)
        },
        RemovePins(take slots) => drop_pin_slots(mut db, slots),
        ReplacePin(slot, take replacement) => {
            let old_bytes = manifest.pin_root_bytes(pages.holder_pins(db.holders)[slot].name, pages.holder_pins(db.holders)[slot].roots)
            let count_bytes = manifest.pin_root_bytes(replacement.name, replacement.roots)
            pages.replace_pin(mut db.holders, slot, take replacement, old_bytes, count_bytes)
        },
        ReplaceMain(take proposed, gone) => {
            let ProposedMain(roots: take roots, head: head, at: at, tables: tables, drop_pin: drop_pin, ..) = take proposed
            if let Some(pin_slot) = drop_pin {
                let count_bytes = manifest.pin_root_bytes(pages.holder_pins(db.holders)[pin_slot].name, pages.holder_pins(db.holders)[pin_slot].roots)
                pages.drop_import_pin(mut db.holders, pin_slot, count_bytes)
            }
            let old_bytes = manifest.keyed_root_record_bytes(pages.holder_heads(db.holders)[0u64].roots.keyed)
            let count_bytes = manifest.keyed_root_record_bytes(roots.keyed)
            pages.replace_head(mut db.holders, 0, take roots, head, at, old_bytes, count_bytes)
            catalog.set_next_table(mut db.schema, tables)
            if let Some(slot) = gone {
                remove_head(mut db, slot)
            }
        },
    }
    db.accounting.changes += 1
    db.accounting.settled = db.accounting.changes
}

// A Memory cut counts row versions only. The page-image figure walks every
// page, so `accounts` computes it when asked (§13.8).
fn memory_cut_account(state: pages.State) -> Result[u64, Error] {
    disk_allocation(scoped fn() -> Result[u64, Error] {
        Ok(pages.page_row_account(failure_result_from_rep(types.capacity(pages.state_roots(state)))?))
    })
}

fn record_memory_cut(mut db: Db, live_bytes: u64) -> Ticket {
    db.accounting.checkpointed += 1
    db.accounting.resident = live_bytes
    db.accounting.settled = db.accounting.changes
    Ticket(store: db.store, open: 0, mark: Cut(db.accounting.checkpointed))
}

fn branch_slot(db: Db, id: u32) -> Result[u64, u64] {
    if id == 0 {
        return Ok(0)
    }
    list.binary_search_by(pages.holder_heads(db.holders), scoped fn(h: pages.Head) -> Order {
        order.compare(h.id, id)
    })
}

fn branch_index(db: Db, b: Branch) -> Result[u64, Error] {
    if !types.same(b.store.hi, b.store.lo, db.store.hi, db.store.lo) {
        return Error(Foreign)
    }
    Ok(branch_slot(db, b.id) ?=> |_| Missing("branch"))
}

fn head_snapshot(db: Db, i: u64) -> Snapshot {
    snapshot_from(db, i, pages.holder_heads(db.holders)[i].head, pages.holder_heads(db.holders)[i].roots, int.saturating_add(pages.holder_next_node(db.holders), 1))
}

fn snapshot_from(db: Db, i: u64, head: u64, roots: pages.Roots, watermark: u64) -> Snapshot {
    Snapshot(store: db.store, open: open_number(db), branch: pages.holder_heads(db.holders)[i].id, head: head, roots: pages.share_roots(roots), watermark: watermark, bases: pages.share_tail_bases(pages.holder_bases(db.holders)))
}

pub type CallId {
    store: StoreId,
    branch: u32,
    version: u64
}

pub type CallInfo {
    id: CallId,
    at: u64,
    seed: u64
}

pub type Mark = Journal(u64, u32, u64) | Cut(u64)

pub type Ticket {
    store: StoreId,
    open: u64,
    mark: Mark
}

pub type Read: shareable + send = Point(Bytes) | Span(Bytes, Bytes)

pub type StoreFailure = Raised(Causes) | Conflict(String) | Drift(String)

pub type Outcome[R, A] = Committed(Done[R]) | Aborted(Undone[A]) | Failed(StoreFailure) | Refused(StoreCapacity) | Stopped(OutOfTime)

pub type Undone[A] {
    value: A,
    ticket: Option[Ticket]
}

pub type Done[R] {
    value: R,
    ticket: Ticket,
    info: Option[CallInfo],
    reads: List[Read]
}

pub type Bound[K] = Unbounded | Included(K) | Excluded(K)

pub type Limits: shareable + send {
    rows: u64,
    byte_limit: u64
}

pub opaque type Resume: send {
    store: StoreId,
    open: u64,
    branch: u32,
    version: u64,
    source: u32,
    high: Bytes,
    last: Bytes
}

pub type Page[K, V]: send {
    rows: List[(K, V)],
    byte_count: u64,
    next: Option[Resume]
}

pub type Resumed[K, V]: send = Paged(Page[K, V]) | Moved(u64)

pub opaque scoped type Tx {
    store: StoreId,
    indexes: View[indexes.IndexRegistry],
    roots: pages.Roots,
    base_collection: Option[TxCollection],
    bases: pages.TailBases,
    ids: u64,
    private_from: u64,
    resident: u64,
    retain_old: bool,
    frame_tail: u64,
    reads: View[core.Log[Read]],
    issued: View[core.Cell[u64]],
    observed_info: View[core.Cell[bool]],
    // The attempt record and the pin map it reads (§13.3, v2.81). The call's
    // driver owns both, outside the body's isolation and step bound.
    attempt: View[Option[core.Cell[pager.TieredTouchSet]]],
    pins: View[Map[pager.TieredCacheKey, Arc[format.TieredFrame]]],
    refusal: Option[Capacity],
    // The index error that makes this transaction abort-only.
    index_conflict: Option[IndexStop],
    // (table, index) of each remove whose absent target proved an index
    // wrong (§I.3). The transaction fails, and the index is demoted.
    drift: Option[List[(u32, u32)]],
    frame_bytes: Option[u64],
    // The recorded limits (§11.1 AP4a) every check in the body reads.
    limits: StoreLimits,
    wrote: bool,
    ops: pages.DataOps,
    view_tree: core.Cell[Option[TxView]],
    info: CallInfo,
    // The streams section's ops (§1.8). `extra_bytes` is that section with
    // its 5-byte head, when it has ops, plus the CALL section's bytes.
    stream_ops: pages.DataOps,
    keyed: Option[format.KeyedDraft],
    extra_bytes: u64,
    call: Option[format.CallSection],
    // Layers beneath `ops`, oldest first. The last `own` are this Tx's own
    // staged writes, frozen when it entered a callback; the rest are shared
    // with the transactions it runs inside. `rows` and `streams` count the
    // distinct keys staged across `ops` and every layer: a key's slot is the
    // one it took when first staged, and a new key takes the next.
    below: List[Arc[pages.Staged]],
    own: u64,
    rows: u64,
    cell_rows: u64,
    trim_rows: u64,
    streams: u64
}

pub opaque type Snapshot: shareable + send {
    store: StoreId,
    open: u64,
    branch: u32,
    head: u64,
    roots: pages.Roots,
    watermark: u64,
    bases: pages.TailBases
}

/// Mix a SplitMix64 seed after adding the generator stride with wrapping arithmetic.
pub fn splitmix64(x: u64) -> u64 {
    let mut z = int.wrapping_add(x, 0x9E3779B97F4A7C15u64)
    z = int.wrapping_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9u64)
    z = int.wrapping_mul(z ^ (z >> 27), 0x94D049BB133111EBu64)
    z ^ (z >> 31)
}

fn call_info(id: StoreId, b: u32, v: u64, wall: u64, previous: u64) -> CallInfo {
    CallInfo(id: CallId(store: id, branch: b, version: v), at: if wall < previous {
        previous
    } else {
        wall
    }, seed: splitmix64(splitmix64(splitmix64(splitmix64(id.hi) ^ id.lo) ^ int.widen(b)) ^ v))
}

pub fn memory(c: Clock, r: Random, o: Options) -> Db {
    memory_at(c, store_key_from_rep(types.make_id(r)), o)
}

fn memory_at(c: Clock, id: StoreId, o: Options) -> Db {
    let mut db = empty_db(c, id, o)
    pages.init_main(mut db.holders)
    take db
}

fn empty_db(c: Clock, id: StoreId, o: Options) -> Db {
    Db(store: id, pager: pager.pager_state(o.writer_pin_bytes), indexes: indexes.empty_index_owner(), schema: catalog.schema_state(0, 1), skip_test_teardown: false, disk: None, clock: c, holders: pages.empty_holders(), followers: list.new(), limits: limits_from_rep(types.named_limits(optional_limits_to_rep(o.limits))), frame_seq: 0, accounting: txn.new_accounting(o.resident_limit), call_streams: txn.new_call_streams(o.stream_retention_ms, o.streams_per_caller_max, history.size_or(o.streams_max, o.resident_limit / DEFAULT_STREAM_RESIDENT_BYTES)), attention_seq: 0, projectors: list.new())
}

pub fn fence_level(db: Db) -> u32 {
    catalog.current_fence(db.schema)
}

pub fn is_disk(db: Db) -> bool {
    match db.disk {
        Some(_) => true,
        None => false
    }
}

fn disk_state(db: Db) -> View[DiskState] in db {
    match db.disk {
        Some(state) => view state,
        None => fail("store: a disk store is required"),
    }
}

fn edit_disk[R](mut connection: Option[DiskState], edit: scoped fn(mut DiskState) -> R) -> R {
    match connection {
        Some(mut state) => edit(mut state),
        None => fail("store: a disk store is required"),
    }
}

fn write_disk[R, T](mut connection: Option[DiskState], take value: T, edit: scoped fn(mut DiskState, take T) -> R) -> R {
    match connection {
        Some(mut state) => edit(mut state, take value),
        None => fail("store: a disk store is required"),
    }
}

pub fn identity(db: Db) -> StoreId {
    db.store
}

pub fn main_branch(db: Db) -> Branch {
    Branch(store: db.store, id: 0)
}

pub fn snapshot(db: Db) -> Snapshot {
    head_snapshot(db, 0)
}

pub fn snapshot_of(db: Db, b: Branch) -> Result[Snapshot, Error] {
    let i = branch_index(db, b)?
    Ok(head_snapshot(db, i))
}

fn checked_name(name: String) -> Result[String, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    failure_result_from_rep(catalog.named(name))
}

pub fn branch(db: Db, name: String) -> Option[Branch] {
    if pages.same_name(pages.holder_heads(db.holders)[0u64].name, name) {
        return Some(main_branch(db))
    }
    match map.get(pages.holder_branch_names(db.holders), name) {
        Some(id) => Some(Branch(store: db.store, id: id)),
        None => None,
    }
}

// Section 1.9 and 1.12: fork and pin take only a Snapshot of this open, whose
// node ids this open issued.
fn this_open(db: Db, s: Snapshot) -> Result[(), Error] {
    if !types.same(s.store.hi, s.store.lo, db.store.hi, db.store.lo) || s.open != open_number(db) {
        return Error(Foreign)
    }
    Ok(())
}

// A cut-made operation reserves its holder storage before the cut and
// changes the installed holder records only after publication.
fn cut_install(mut db: Db, take delta: HolderDelta) -> Result[Ticket, Error] waits {
    let mut emitted: Option[Map[u64, std.page.PagePtr]] = None
    cut_install_emitted(mut db, take delta, mut emitted)
}

fn cut_install_emitted(mut db: Db, take delta: HolderDelta, mut emitted: Option[Map[u64, std.page.PagePtr]]) -> Result[Ticket, Error] waits {
    if is_disk(db) {
        let mut timing: Option[CutTiming] = None
        let target = db_target(db)
        let pack_bytes = match target {
            Some(wanted) => wanted.pack,
            None => disk_state(db).options.pack_bytes,
        }
        let limit = cut_output_bytes(pack_bytes, db.limits)
        return disk_cut_with_limit_emitted(mut db, take delta, seal_page_manifest_file, target, pack_bytes, limit, mut timing, mut emitted)
    }
    prepare_holder_slot(mut db, delta)?
    let proposed = disk_allocation(scoped fn() -> Result[pages.State, Error] {
        failure_result_from_rep(types.capacity(state_with_delta(db, delta)))
    })?
    let admission = match delta {
        AddHead(_, _) => true,
        AddPin(_) => true,
        ReplacePin(_, _) => true,
        _ => false
    }
    let live_bytes = memory_cut_account(proposed)?
    if admission {
        failure_result_from_rep(catalog.over_ceiling(live_bytes, txn.available_resident(db.accounting, db.call_streams.keyed_credit)))?
    }
    let commit_ticket = record_memory_cut(mut db, live_bytes)
    install_holder_delta(mut db, take delta)
    Ok(commit_ticket)
}

fn check_manifest_addition(db: Db, extra: u64) -> Result[(), Error] {
    if extra > db.limits.meta - pages.holder_record_bytes(db.holders) {
        Error(Limit(Manifest))
    } else {
        Ok(())
    }
}

// AA1: a fast-forward of main to b, exactly when b forked from main at main's
// current version; b is then deleted. Any other case is Diverged(b).
pub fn adopt(mut db: Db, b: Branch) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    // AA1: a branch that is not live (deleted, or adopted and so deleted) is
    // no fork of main at main's version, so it is Diverged like any other.
    let i = match branch_index(db, b) {
        Ok(found) => found,
        Error(Missing(_)) => return Error(Diverged(b.id)),
        Error(take e) => return Error(take e)
    }
    if i == 0 || pages.holder_heads(db.holders)[i].parent != 0 || pages.holder_heads(db.holders)[0].head != pages.holder_heads(db.holders)[i].forked_at {
        return Error(Diverged(b.id))
    }
    let merged = ProposedMain(roots: pages.share_roots(pages.holder_heads(db.holders)[i].roots), head: pages.holder_heads(db.holders)[i].head, at: pages.holder_heads(db.holders)[i].at, tables: catalog.next_table_id(db.schema), activation: None, drop_pin: None, superseded: list.new(), chunk_freed: None, step_rows: list.new(), step_drift: true)
    let publication = failure_result_from_rep(types.capacity(prepare_publication(db, 0, merged.head, merged.roots, pages.holder_next_node(db.holders))))?
    let commit_ticket = cut_install(mut db, ReplaceMain(take merged, Some(i)))?
    publish(take publication)
    Ok(commit_ticket)
}

// Main is not deletable: it is Missing("branch") like an id that is not live.
pub fn delete_branch(mut db: Db, b: Branch) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, b)?
    if i == 0 {
        return Error(Missing("branch"))
    }
    cut_install(mut db, RemoveHead(i))
}

pub fn version(s: Snapshot) -> u64 {
    s.head
}

type BranchFollower {
    head: u32,
    latest: Latest[Snapshot]
}

fn branch_follower_slot(registered: List[BranchFollower], head: u32) -> Option[u64] {
    std.list.position(registered, scoped fn(registered_head: BranchFollower) -> bool {
        registered_head.head == head
    })
}

pub fn follow(mut db: Db, b: Branch) -> Result[Latest[Snapshot], Error] {
    healthy(db)?
    let i = branch_index(db, b)?
    let head = pages.holder_heads(db.holders)[i].id
    if let Some(slot) = branch_follower_slot(db.followers, head) {
        return Ok(latest.handle(db.followers[slot].latest))
    }
    let root = arc.new(head_snapshot(db, i))
    let h = latest.new(take root)
    list.push(mut db.followers, BranchFollower(head: head, latest: latest.handle(h)))
    Ok(take h)
}

type Publication {
    followed: Option[(Latest[Snapshot], Arc[Snapshot])]
}

// The followed snapshot is allocated before the commit, so publishing it
// after the commit cannot fail.
fn prepare_publication(db: Db, i: u64, head: u64, roots: pages.Roots, last_stamp: u64) -> Result[Publication, Capacity] {
    let followed = match branch_follower_slot(db.followers, pages.holder_heads(db.holders)[i].id) {
        Some(slot) => Some((latest.handle(db.followers[slot].latest), arc.new(snapshot_from(db, i, head, roots, int.saturating_add(last_stamp, 1))))),
        None => None
    }
    Ok(Publication(followed: take followed))
}

fn publish(take publication: Publication) {
    let Publication(followed: take followed) = take publication
    if let Some((take handle, take root)) = take followed {
        latest.publish(handle, take root)
    }
}

pub type Receipt {
    ticket: Ticket,
    reply: Bytes
}

pub type Stop = Raised(u32) | OutOfSteps(u64) | OutOfBytes(Capacity) | Conflict(String)

pub type Plan {
    n_e: u64,
    s_e: u64,
    reply_max: u64
}

pub type CallReserve {
    retained: u64,
    steps: u64
}

// Outside s_e, each metered draft pays for its admission scope (1),
// draft_call (1), isolate and its callback (2), issued-cell into_inner (1),
// log.finish (1), and finish_stage (1). Calls inside core's log.finish take
// no steps; a prepared reply makes finish_stage skip its data-row scan.
const CALL_FIXED_STEPS: u64 = 7

pub fn call_reserves(plan: Plan) -> Option[CallReserve] {
    // The isolate needs only the cause cell that a block charge includes.
    let cause = charge.block(bytes[()], 0)?
    let Some(retained) = int.checked_add(plan.n_e, cause) else {
        return None
    }
    let Some(steps) = int.checked_add(plan.s_e, CALL_FIXED_STEPS) else {
        return None
    }
    Some(CallReserve(retained: retained, steps: steps))
}

pub type ServeError = Before(Error, Option[Pending]) | After(Error)

pub type Reserve = Resident | Claim

pub opaque type Pending {
    completion: Completion,
    record: Option[CallRecord],
    attempted: CallInfo,
    stop: Option[StopKind],
}

pub type Served = Committed(Receipt) | Kept(Receipt) | Failed(Pending, Stop) | NoRoom(Pending, StoreCapacity) | Parked(Parked)

type ServeReply = KeptReply(Bytes) | StoreFailure(Error) | BodyStop(Stop)

pub fn next_call_info(db: Db) -> CallInfo {
    call_info(db.store, 0, pages.holder_heads(db.holders)[0].head + 1, host.wall_ms(db.clock), pages.holder_heads(db.holders)[0].at)
}

pub fn stream_retention_ms(db: Db) -> u64 {
    db.call_streams.stream_retention_ms
}

pub fn untried(take complete: Completion, take rec: Option[CallRecord], attempted: CallInfo) -> Pending {
    Pending(completion: take complete, record: take rec, attempted: attempted, stop: None)
}

fn registered_completion(db: Db, complete: Completion) -> Result[(), ServeError] {
    if !types.same(db.store.hi, db.store.lo, complete.admitted.store.hi, complete.admitted.store.lo) || open_number(db) != complete.admitted.open {
        return Error(Before(Foreign, None))
    }
    if let Some(keyed) = complete.keyed {
        return serve_before(check_keyed_completion(db, complete, keyed))
    }
    if let Some(raw) = pages.get_page_row(pages.holder_heads(db.holders)[0].roots.streams, complete.stream) {
        let state = serve_before(stream_state(raw))?
        if state.p == complete.p && state.state == 1 && state.digest == complete.request {
            return Ok(())
        }
    }
    Error(Before(Missing("reply"), None))
}

fn serve_before[R](take result: Result[R, Error]) -> Result[R, ServeError] {
    match take result {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(Before(take problem, None)),
    }
}

fn serve_after(take result: Result[(), Error]) -> Result[(), ServeError] {
    match take result {
        Ok(()) => Ok(()),
        Error(take problem) => Error(After(take problem)),
    }
}

fn cause_number(causes: Causes) -> u32 {
    for cause in causes {
        return match cause.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity(_) => 7u32,
            OutOfTime => 8u32,
            Stack => 10u32
        }
    }
    0u32
}

fn save_reply(mut tx: Tx, complete: Completion, output: Bytes, rec: Option[CallRecord], settlement: Option[format.Settlement], credit: Option[format.KeyedCredit]) -> Result[(), Error] {
    if let Some(keyed) = complete.keyed {
        let Some(remaining) = credit else {
            fail("store: keyed completion must apply its terminal credit")
        }
        let call = format.KeyedCallSection(record: keyed_call_record_to_rep(clone(keyed.record)), settlement: settlement)
        return stage_claim_reply(mut tx, complete.stream, complete.request, keyed.policy.retention_ms, output, remaining, Some(take call))
    }
    let size = if let Some(_) = tx.frame_bytes {
        match rec {
            Some(value) => format.call_section_bytes(value.key, value.args, value.revision, value.code, settlement),
            None => 0u64,
        }
    } else {
        0u64
    }
    let (take key, take value) = reply_row(tx, complete.stream, complete.p, output)?
    stream_write(mut tx, take key, take value, size)
}

fn stage_reply(mut tx: Tx, complete: Completion, rec: Option[CallRecord], reply_max: u64, credit: Option[format.KeyedCredit], body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[Bytes, ServeReply] {
    let returned = body(mut tx)
    if let Some(problem) = tx.refusal {
        tx.refusal = None
        return Error(BodyStop(OutOfBytes(problem)))
    }
    let (success, take output) = match take returned {
        Ok(take payload) => {
            match tx.index_conflict {
                Some(Duplicate(name)) => return Error(BodyStop(Conflict(clone(name)))),
                Some(Drifted(name)) => return Error(StoreFailure(Drift(clone(name)))),
                None => (),
            }
            (true, take payload)
        },
        Error(take payload) => (false, take payload),
    }
    if list.len(output) > reply_max {
        return Error(BodyStop(OutOfBytes(Capacity(requested: list.len(output), available: reply_max))))
    }
    match save_reply(mut tx, complete, output, rec, None, credit) {
        Ok(()) => (),
        Error(Full(Allocation(problem))) => return Error(BodyStop(OutOfBytes(problem))),
        Error(take problem) => return Error(StoreFailure(take problem)),
    }
    if success {
        Ok(take output)
    } else {
        Error(KeptReply(take output))
    }
}

pub fn serve[E: inert](mut db: Db, take complete: Completion, plan: Plan, take rec: Option[CallRecord], env: E, body: fn(mut Tx, E) -> Result[Bytes, Bytes]) -> Result[Served, ServeError] waits {
    serve_before(journal_poll(mut db))?
    serve_before(healthy(db))?
    registered_completion(db, complete)?
    serve_before(check_completion_record(complete, rec))?
    let wall = host.wall_ms(db.clock)
    let Some(grant) = call_reserves(plan) else {
        return Error(Before(Limit(Transaction), None))
    }
    let first = CallRun(id: None, attempts: 0, pins: pager.empty_tiered_pins(call_pin_root(db, 0), pager.pin_partition(db.pager)), pending: None, crowded: false)
    drive_served(mut db, take complete, plan, grant, take rec, wall, take first, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
        body(mut tx, env)
    })
}

fn finish_served(mut db: Db, take pending_run: Pending, take staged: Ran[Bytes, ServeReply], retry: bool) -> Result[Served, ServeError] waits {
    let ready = serve_before(settle_draft(mut db, 0, take staged))?
    match take ready {
        OverLimit(_, Journal(problem)) => {
            if let Some(_) = pending_run.completion.keyed {
                return Ok(NoRoom(take pending_run, Journal(problem)))
            }
            let pending = if retry {
                Some(take pending_run)
            } else {
                None
            }
            Error(Before(Full(Journal(problem)), take pending))
        },
        OverLimit(_, problem) => Ok(NoRoom(take pending_run, problem)),
        Ready(take accepted, take publication) => {
            if let Some(problem) = reserve_tiered_freed(mut db, accepted) {
                return Ok(NoRoom(take pending_run, problem))
            }
            let committed = commit_prepared(mut db, 0, take accepted, take publication)
            serve_after(handoff(mut db))?
            serve_after(maybe_checkpoint(mut db))?
            match take committed {
                Committed(Done(value: take output, ticket: committed_at, ..)) => Ok(Committed(Receipt(ticket: committed_at, reply: take output))),
                Aborted(Undone(value: KeptReply(take output), ticket: Some(committed_at))) => Ok(Kept(Receipt(ticket: committed_at, reply: take output))),
                _ => fail("store: staged reply was lost"),
            }
        },
    }
}

pub fn conclude(mut db: Db, take pending_run: Pending, take output: Bytes, reserve: Reserve) -> Result[Served, ServeError] waits {
    let has_credit = match pending_run.completion.keyed {
        Some(_) => true,
        None => false
    }
    match reserve {
        Claim if !has_credit => return Error(Before(Missing("claim"), None)),
        Resident if has_credit => return Error(Before(Missing("terminal credit"), None)),
        _ => (),
    }
    serve_before(journal_poll(mut db))?
    serve_before(healthy(db))?
    registered_completion(db, pending_run.completion)?
    serve_before(check_completion_record(pending_run.completion, pending_run.record))?
    let now = host.wall_ms(db.clock)
    let attempted = pending_run.attempted
    let way = match pending_run.stop {
        Some(_) => 1u8,
        None => 2u8
    }
    let settlement: Option[format.Settlement] = if attempted.id.version == 0 {
        None
    } else {
        Some(format.Settlement(way: way, base: attempted.id.version - 1, at: attempted.at, seed: attempted.seed, stop: optional_stop_kind_to_rep(pending_run.stop)))
    }
    let keep: Option[fn(ServeReply) -> bool] = None
    // Saving a reply reads no Tiered row, so it carries no attempt record.
    let attempt: Option[core.Cell[pager.TieredTouchSet]] = None
    let no_pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]] = map.new()
    let credit = keyed_completion_credit(db, pending_run.completion)
    let draft = stage_call(mut db, 0, now, None, keep, pending_run.record, settlement, false, attempt, no_pins, scoped fn(mut tx: Tx) -> Result[Bytes, ServeReply] {
        let held: Bytes = clone(output)
        let moved = take held
        match save_reply(mut tx, pending_run.completion, output, pending_run.record, settlement, credit) {
            Ok(()) => Ok(take moved),
            Error(Full(Allocation(problem))) => Error(BodyStop(OutOfBytes(problem))),
            Error(take problem) => Error(StoreFailure(take problem)),
        }
    })
    match take draft {
        Ran(take staged) => finish_served(mut db, take pending_run, take staged, true),
        Over(Refused(problem)) => Ok(NoRoom(take pending_run, problem)),
        Over(Aborted(Undone(value: BodyStop(OutOfBytes(problem)), ..))) => Ok(NoRoom(take pending_run, Allocation(problem))),
        Over(Aborted(Undone(value: StoreFailure(take problem), ..))) => Error(Before(take problem, None)),
        _ => fail("store: invalid conclude draft"),
    }
}

pub fn info(mut tx: Tx) -> CallInfo {
    cell.set(tx.observed_info, true)
    tx.info
}

pub fn run[E: inert, R, A](mut db: Db, steps: Option[u64], env: E, body: fn(mut Tx, E) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let b = main_branch(db)
    run_on(mut db, b, steps, env, body)
}

pub fn run_on[E: inert, R, A](mut db: Db, b: Branch, steps: Option[u64], env: E, body: fn(mut Tx, E) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    run_on_with_reply(mut db, b, steps, None, scoped fn(mut tx: Tx) -> Result[R, A] {
        body(mut tx, env)
    })
}

// A runner abort may keep its reply. A runner refusal rolls back the whole Tx.
pub fn run_with_reply[E: inert, R, A](mut db: Db, steps: Option[u64], keep_reply: fn(A) -> bool, env: E, body: fn(mut Tx, E) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let b = main_branch(db)
    run_on_with_reply(mut db, b, steps, Some(keep_reply), scoped fn(mut tx: Tx) -> Result[R, A] {
        body(mut tx, env)
    })
}

fn run_on_with_reply[R, A](mut db: Db, b: Branch, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, b)?
    // A retry-capable call is bounded, so a body that loops on a caught
    // Missed ends at its bound and the driver reruns it (§13.3).
    if let None = steps {
        if call_captures_tiered(db, i) {
            return Error(Missing("steps"))
        }
    }
    store_body_on(mut db, i, steps, keep_reply, body)
}

// The store's own bodies, which read no Tiered row, run here unbounded.
fn store_body_on[R, A](mut db: Db, i: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let wall = host.wall_ms(db.clock)
    store_body_at(mut db, i, wall, steps, keep_reply, body)
}

fn handoff(mut db: Db) -> Result[(), Error] waits {
    if let Some(mut state) = db.disk {
        let pending = edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) -> Option[Bytes] {
            replace(mut queue.pending, None)
        })
        if let Some(take raw) = take pending {
            let sent = list.len(raw)
            let closed = match state.backend {
                DirBackend(directory) => match channel.send(journal.dir_sender(directory), Frame(take raw, db.frame_seq)) {
                    Ok(()) => false,
                    Error(_) => true,
                },
                ObjectBackend(writer) => match channel.send(object_writer.sender(writer), Frame(take raw, db.frame_seq)) {
                    Ok(()) => false,
                    Error(_) => true,
                },
            }
            return edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) -> Result[(), Error] {
                if closed {
                    queue.poison = Some(Closed)
                    return Error(Poisoned(Closed))
                }
                queue.inflight += sent
                queue.uncovered += sent
                queue.since_cut += sent
                Ok(())
            })
        }
    }
    Ok(())
}

fn maybe_checkpoint(mut db: Db) -> Result[(), Error] waits {
    if is_disk(db) && (queue_accounting(disk_state(db)).since_cut > disk_state(db).options.checkpoint_bytes || object_cut_due(db)) {
        match cut_install(mut db, NoHolderChange) {
            Error(Full(_)) => (),
            Error(take problem) => return Error(take problem),
            Ok(_) => (),
        }
    }
    Ok(())
}

// A body whose commit the admission bound decides (section 1.11): one that
// returned Ok, or one that returned Error after a reply, whose commit keeps
// only its streams writes and its CALL section (F2).
type Ran[R, A] {
    value: Result[R, A],
    roots: Option[pages.Roots],
    edits: pages.DataRows,
    order: format.DataOrder,
    replies: pages.DataRows,
    keyed: Option[format.KeyedDraft],
    first_stamp: u64,
    prepared_roots: bool,
    tiered: Option[u64],
    freed: Option[pager.TieredFreed],
    live: u64,
    exact: bool,
    admits_rows: bool,
    skipped: bool,
    frame: Option[Bytes],
    info: CallInfo,
    reads: List[Read]
}

// Latched: the attempt's latch was set, so its result, writes, reads and
// issued ids are discarded and the driver serves or refuses the stop.
type Stage[R, A] = Over(Outcome[R, A]) | Ran(Ran[R, A]) | DraftError(Error) | Latched | DriftStop(String, List[(u32, u32)])

// Drifted: a remove proved an index wrong; the call fails with `Drift`
// and its driver counts and demotes the indexes (§I.3).
type Finished[R, A] = RolledBack(Outcome[R, A]) | Prepared(Prepared[R, A]) | DraftFault(Error) | Drifted(String, List[(u32, u32)])

// A successful body or an application error with a reply to commit.
type Prepared[R, A] {
    outcome: Result[R, A],
    roots: pages.Roots,
    tiered: Option[u64],
    plan: Option[pager.TieredWritePlan],
    live: u64,
    frame: Option[Bytes],
    ops: pages.DataRows,
    order: format.DataOrder,
    base_stamp: u64,
    frame_tail: u64,
    stream_ops: pages.DataRows,
    keyed: Option[format.KeyedDraft],
    first_stamp: u64,
    prepared_roots: bool,
    observed_info: bool,
    skipped: bool,
    call: Option[format.CallSection]
}

// Runs the body on branch `i` inside isolate. Everything but a body that
// returned Ok, or Error after a reply, is final here.
fn stage[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    stage_with(mut db, i, wall, steps, keep_reply, false, attempt, pins, body)
}

fn stage_with[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], force_frame: bool, attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    let no_record: Option[CallRecord] = None
    stage_call(mut db, i, wall, steps, keep_reply, no_record, None, force_frame, attempt, pins, body)
}

// The caller keeps owning the record so a refused publication can return it.
fn stage_call[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], rec: Option[CallRecord], settlement: Option[format.Settlement], force_frame: bool, attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    let reads: core.Log[Read] = log.new()
    let issued: core.Cell[u64] = cell.new(0)
    let ci = call_info(db.store, pages.holder_heads(db.holders)[i].id, pages.holder_heads(db.holders)[i].head + 1, wall, pages.holder_heads(db.holders)[i].at)
    let caught = isolate(fn() -> Result[Finished[R, A], OutOfTime] {
        let perform = scoped fn() -> Finished[R, A] {
            let staged = draft_body(db, indexes.index_registry(db.indexes), pages.holder_heads(db.holders)[i].roots, ci, keep_reply, reads, issued, attempt, pins, body)
            let prepared = if let Some(_) = steps {
                match prepare_metered_pages(issued, attempt, pins, take staged) {
                    Ok(take ready) => take ready,
                    Error(Full(problem)) => RolledBack(Refused(problem)),
                    Error(take problem) => DraftFault(take problem),
                }
            } else {
                take staged
            }
            match frame_draft(db, pages.holder_heads(db.holders)[i].roots.collections, ci, rec, settlement, force_frame, take prepared) {
                Ok(take framed) => take framed,
                Error(problem) => RolledBack(Refused(Allocation(problem))),
            }
        }
        match steps {
            Some(s) => bound steps s {
                perform()
            },
            None => Ok(perform()),
        }
    })
    // The latch is read before anything else: a latched attempt's ids and
    // reads are discarded with it, so the watermark never depends on reruns.
    if pager.call_attempt_latched(attempt) {
        let _ = cell.into_inner(take issued)
        let _ = log.finish(take reads)
        return Latched
    }
    let high = cell.into_inner(take issued)
    if high > pages.holder_next_node(db.holders) {
        pages.set_next_node(mut db.holders, high)
    }
    let seen = log.finish(take reads)
    match take caught {
        Error(c) => Over(Refused(Allocation(c))),
        Ok(Error(take cs)) => match manifest.raised_capacity(cs) {
            Some(c) => Over(Refused(Allocation(c))),
            None => Over(Failed(Raised(take cs))),
        },
        Ok(Ok(Error(e))) => Over(Stopped(e)),
        Ok(Ok(Ok(take f))) => finish_stage(ci, take f, take seen),
    }
}

fn draft_body[R, A](db: Db, registry: indexes.IndexRegistry, base: pages.Roots, ci: CallInfo, keep_reply: Option[fn(A) -> bool], reads: core.Log[Read], issued: core.Cell[u64], attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Finished[R, A] {
    let (frame_bytes, initial_tail) = match db.disk {
        Some(_) => (Some(42u64), pages.OPEN_FRAME_TAIL),
        None => (None, pages.NO_FRAME_TAIL),
    }
    let observed_info: core.Cell[bool] = cell.new(false)
    let mut tx = Tx(store: db.store, indexes: view registry, roots: pages.share_roots(base), base_collection: None, bases: pages.share_tail_bases(pages.holder_bases(db.holders)), ids: pages.holder_next_node(db.holders), private_from: int.saturating_add(pages.holder_next_node(db.holders), 1), resident: db.accounting.resident, retain_old: retaining(db), frame_tail: initial_tail, reads: view reads, issued: view issued, observed_info: view observed_info, attempt: view attempt, pins: view pins, refusal: None, index_conflict: None, drift: None, frame_bytes: frame_bytes, limits: db.limits, wrote: false, ops: pages.empty_ops(), view_tree: cell.new(None), info: ci, stream_ops: pages.empty_ops(), keyed: None, extra_bytes: 0, call: None, below: list.new(), own: 0, rows: 0, cell_rows: 0, trim_rows: 0, streams: 0)
    let outcome = body(mut tx)
    if tx.own != 0 {
        fold_own(mut tx)
    }
    if let Some(c) = tx.refusal {
        return RolledBack(Refused(Allocation(c)))
    }
    // A proven-wrong index fails the call however the body ended (§I.3).
    if let Some((take name, take evidence)) = take_drift(mut tx) {
        return Drifted(take name, take evidence)
    }
    let value: Result[R, A] = match take outcome {
        Ok(take v) => {
            if let Some(Duplicate(take name)) = replace(mut tx.index_conflict, None) {
                return RolledBack(Failed(Conflict(take name)))
            }
            Ok(take v)
        },
        Error(take a) => {
            let keep = match keep_reply {
                Some(decide) => decide(a),
                None => true
            }
            let keyed_reply = match tx.keyed {
                Some(_) => true,
                None => false
            }
            if !keep || (pages.data_row_count(tx.stream_ops.rows) == 0 && !keyed_reply) {
                return RolledBack(Aborted(Undone(value: take a, ticket: None)))
            }
            // F2 keeps the streams and CALL writes with the old data roots.
            let live_bytes = match stream_live(db, base.streams, tx.stream_ops) {
                Ok(n) => n,
                Error(c) => return RolledBack(Refused(Allocation(c)))
            }
            tx.resident = live_bytes
            tx.roots.collections = pages.share_page_tree(base.collections)
            tx.roots.catalog = pages.share_page_tree(base.catalog)
            tx.ops = pages.empty_ops()
            tx.rows = 0
            tx.frame_tail = pages.NO_FRAME_TAIL
            Error(take a)
        }
    }
    let mut first_stamp = tx.private_from
    let mut rows = match seal_log_trims(mut tx, mut first_stamp) {
        Ok(take operations) => take operations,
        Error(Full(problem)) => return RolledBack(Refused(problem)),
        Error(_) => fail("store: invalid staged Log trim"),
    }
    if let Some(keyed) = tx.keyed {
        tx.resident = keyed_draft_live(base, keyed.edits, tx.retain_old, tx.resident)
    }
    let Tx(roots: take roots, resident: live_bytes, frame_tail: frame_tail, ops: take ops, stream_ops: take stream_ops, keyed: take keyed, call: take call, ..) = take tx
    let saw_info = cell.replace(observed_info, false)
    let pages.DataOps(cells: take cells, ..) = take ops
    seal_cell_edits(mut rows, cells)
    let order = match pages.data_order(rows) {
        Ok(take sorted) => take sorted,
        Error(problem) => return RolledBack(Refused(Allocation(problem))),
    }
    let pages.DataOps(rows: take stream_rows, ..) = take stream_ops
    let tiered = match attempt {
        Some(_) => Some(db.accounting.tiered),
        None => None,
    }
    Prepared(Prepared(outcome: take value, roots: take roots, tiered: tiered, plan: None, live: live_bytes, frame: None, ops: take rows, order: take order, base_stamp: pages.tree_stamp(base.collections), frame_tail: frame_tail, stream_ops: take stream_rows, keyed: take keyed, first_stamp: first_stamp, prepared_roots: false, observed_info: saw_info, skipped: false, call: take call))
}

fn finish_stage[R, A](ci: CallInfo, take finished: Finished[R, A], take seen: List[Read]) -> Stage[R, A] {
    let prepared = match take finished {
        RolledBack(take o) => return Over(take o),
        DraftFault(take problem) => return DraftError(take problem),
        Drifted(take name, take evidence) => return DriftStop(take name, take evidence),
        Prepared(take tx) => take tx,
    }
    let Prepared(outcome: take outcome, roots: take roots, tiered: tiered, plan: take plan, live: live_bytes, frame: take frame, ops: take operations, order: take order, stream_ops: take stream_edits, keyed: take keyed, first_stamp: first_stamp, prepared_roots: prepared_roots, skipped: skipped, ..) = take prepared
    // A draft without a Tiered plan makes no call here: the draft's step
    // overhead is fixed (§13.3 call reserves).
    let freed = match take plan {
        Some(take written) => {
            let pager.TieredWritePlan(freed: take plan_freed, ..) = take written
            Some(take plan_freed)
        },
        None => None,
    }
    let keyed_writes = match keyed {
        Some(_) => true,
        None => false
    }
    let mut admits_rows = stream_edits.count_word != 0 || keyed_writes
    if !admits_rows {
        for slot in 0u64 .. pages.data_row_count(operations) {
            let edit = pages.data_row(operations, slot)
            if let Some(_) = edit.value {
                if tiered != None && pager.tiered_data_key(roots.collections, edit.key) {
                    continue
                }
                admits_rows = true;
                break
            }
        }
    }
    Ran(Ran(value: take outcome, roots: Some(take roots), edits: take operations, order: take order, replies: take stream_edits, keyed: take keyed, first_stamp: first_stamp, prepared_roots: prepared_roots, tiered: tiered, freed: take freed, live: live_bytes, exact: false, admits_rows: admits_rows, skipped: skipped, frame: take frame, info: ci, reads: take seen))
}

pub fn durable(mut db: Db, t: Ticket) -> Result[(), Error] waits {
    let _ = durable_groups(mut db, t)?
    Ok(())
}

/// The journal's sync notices, taken once: one coalesced () after each group sync or
/// failure, and the channel closes when the journal worker ends. A store without a
/// journal returns None; its tickets are durable when committed.
pub fn sync_notices(mut db: Db) -> Option[Receiver[()]] {
    match db.disk {
        Some(mut state) => match state.backend {
            DirBackend(mut directory) => journal.dir_sync_notices(mut directory),
            ObjectBackend(mut writer) => object_writer.sync_notices(mut writer),
        },
        None => None
    }
}

/// `durable` without waiting: whether t's commit is synced now. A journal that ended
/// without an ack is terminal, as in journal_receive.
pub fn durable_now(mut db: Db, t: Ticket) -> Result[bool, Error] {
    if !types.same(db.store.hi, db.store.lo, t.store.hi, t.store.lo) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(true)
    }
    if let Some(e) = journal_poison(db) {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if is_disk(db) {
            disk_wait_cut(db, generation)?
            return Ok(true)
        }
    }
    let drained = journal_poll_groups(mut db)
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(true)
    }
    let _ = drained ?=> durable_latch_error
    if covered(db, t.mark) {
        return Ok(true)
    }
    let pending = match db.disk {
        Some(state) => try_journal_receive(state),
        None => return Ok(true)
    }
    match take pending {
        Ok(take ack) => journal_ack(mut db, take ack) ?=> durable_latch_error,
        Error(Empty) => {},
        Error(Closed) => journal_ack(mut db, Broken(Closed))?,
    }
    Ok(covered(db, t.mark))
}

fn covered(db: Db, mark: Mark) -> bool {
    match mark {
        Journal(n, _, _) => match db.disk {
            Some(state) => queue_accounting(state).journaled >= n,
            None => n == 0
        },
        Cut(n) => db.accounting.checkpointed >= n
    }
}

pub fn body_capacity(mut tx: Tx, problem: Capacity) {
    tx.refusal = Some(problem)
}

// Reserve the stamp interval before a page edit can allocate. The cell keeps
// the high watermark even if the body exits under a capacity failure; after an
// overrun's rollback a later reservation may end lower and puts the higher back.
fn reserve_ids(mut tx: Tx, height: u64) -> Result[u64, Error] {
    let Some(end) = int.checked_add(tx.ids, 6 * height + 2) else {
        return Error(Limit(Ids))
    }
    let high = cell.replace(tx.issued, end)
    if high > end {
        let _ = cell.replace(tx.issued, high)
    }
    let first = tx.ids + 1
    tx.ids = end
    Ok(first)
}

fn note_read(tx: Tx, take read: Read) -> Result[(), Error] {
    log.append(tx.reads, take read)
    Ok(())
}

// A Tiered row is resolved before its Point is logged, so the first touch's
// count precedes the logical append on every path (§13.3).
fn fetch_logical(tx: Tx, take key: Bytes) -> Result[Option[View[Bytes]], Error] in tx {
    let found = match staged_row(tx, key) {
        Some(staged) => staged,
        None => tx_page_row(tx, key)?,
    }
    log.append(tx.reads, Point(take key))
    Ok(found)
}

// Stream value (section 1.8): position u64 LE, state u8 (1 Admitted,
// 2 Replied), then the reply when Replied.
// A request's identity at a stream position (STORE-SPEC v2.24 §1.8, AH1).
// Made only by request_digest or read from a streams value.
pub opaque type RequestDigest: key + shareable + send {
    b: Inline[u8, 32]
}

/// SHA-256 of u8 17 ‖ "hirsel.request.v1" ‖ u32 LE len(key) ‖ key ‖ u32 LE
/// len(args) ‖ args (§1.8): versioned, domain-separated, length-delimited.
/// Alloc: none. Cost: O(key + args).
pub fn request_digest(key: Bytes, args: Bytes) -> RequestDigest {
    let mut h = std.sha256.start()
    let tag = string.as_bytes("hirsel.request.v1")
    std.sha256.add_byte(mut h, int.truncate(list.len(tag)))
    std.sha256.add(mut h, tag, 0, list.len(tag))
    digest_part(mut h, key)
    digest_part(mut h, args)
    RequestDigest(b: std.sha256.finish(h))
}

fn digest_part(mut h: std.sha256.Sha256, part: Bytes) {
    let n = list.len(part)
    for i in 0u64 .. 4 {
        std.sha256.add_byte(mut h, int.truncate(n >> int.truncate(i * 8)))
    }
    std.sha256.add(mut h, part, 0, n)
}

// STORE AL2/AN2. An admit is 41 B, and a reply is followed by the exact
// reply bytes.
pub type Stored {
    reply: Bytes
}

fn test_db(c: Clock, cap: u64) -> Db {
    let mut opts = result.unwrap(sized(Memory, 1074790400u64))
    opts.resident_limit = cap
    memory_at(c, StoreId(hi: 1, lo: 2), opts)
}

fn transaction_stream(tx: Tx, key: Bytes) -> Option[View[Bytes]] in tx {
    if let Some(slot) = pages.op_slot(tx.stream_ops, key) {
        return match pages.data_row(tx.stream_ops.rows, slot).value {
            Some(raw) => Some(format.staged_bytes(raw)),
            None => None,
        }
    }
    if let Some(at) = newest_layer(tx.below, true, key) {
        let layer = view tx.below[at]
        if let Some(slot) = pages.op_slot(layer.stream_ops, key) {
            return match pages.data_row(layer.stream_ops.rows, slot).value {
                Some(raw) => Some(format.staged_bytes(raw)),
                None => None,
            }
        }
    }
    pages.get_page_row(tx.roots.streams, key)
}

// The newest layer that staged `key`, a deletion included.
fn newest_layer(below: List[Arc[pages.Staged]], streams: bool, key: Bytes) -> Option[u64] {
    let mut newest: Option[u64] = None
    let mut at = 0u64
    for layer in below {
        let found = if streams {
            pages.op_slot(layer.stream_ops, key)
        } else {
            pages.op_slot(layer.ops, key)
        }
        if let Some(_) = found {
            newest = Some(at)
        }
        at += 1
    }
    newest
}

pub type RowSchemas: codec + shareable + send {
    key: Bytes,
    value: Bytes
}

pub opaque type Readers[V]: shareable + send {
    codec: std.codec.Codec[V],
    current: u16,
    older: List[Option[std.codec.Reader[V]]],
    schemas: Arc[RowSchemas]
}

pub opaque type Table[K, V]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    key: std.codec.Key[K],
    readers: Arc[Readers[V]]
}

pub type IndexKind: key + shareable + send = Many | Unique

pub opaque type Index[J, K, V, P]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    table: u32,
    key: std.codec.Key[J],
    primary: std.codec.Key[K],
    readers: Arc[Readers[V]],
    kind: IndexKind,
    payload: Option[Arc[Readers[P]]],
    payload_codec: std.codec.Codec[P],
    // The record was Public in the catalog root page `catalog_page` names.
    public: bool,
    // Current payload rows decode with the built-in List[i8] decoder, so next_i8_entry may lend them.
    lendable: bool
}

type PageRows[K, V]: send {
    cursor: Option[pages.CollectionCursor],
    data: pages.PageTree,
    decoder: RowDecoder[K, V]
}

pub fn row_schemas[K, V](t: Table[K, V]) -> Arc[RowSchemas] {
    arc.share(t.readers.schemas)
}

fn typed_bound[K](k: std.codec.Key[K], limit: Bound[K]) -> Result[Bound[Bytes], Error] {
    match limit {
        Unbounded => Ok(Unbounded),
        Included(x) => Ok(Included(failure_result_from_rep(catalog.encode_key(k, x))?)),
        Excluded(x) => Ok(Excluded(failure_result_from_rep(catalog.encode_key(k, x))?))
    }
}

fn writable[K, V](tx: Tx, t: Table[K, V]) -> Result[List[(u64, indexes.Catalog)], Error] {
    if !types.same(tx.store.hi, tx.store.lo, t.store.hi, t.store.lo) {
        return Error(Foreign)
    }
    failure_result_from_rep(catalog.readable(tx.roots, t.catalog_key, t.catalog_page, t.id))?
    bound_indexes(tx, t.id, t.readers.current)
}

/// Borrow the stored schema tag and codec bytes, including any staged write.
pub fn fetch_bytes[K, V](tx: Tx, t: Table[K, V], k: K) -> Result[Option[View[Bytes]], Error] in tx {
    if !types.same(tx.store.hi, tx.store.lo, t.store.hi, t.store.lo) {
        return Error(Foreign)
    }
    failure_result_from_rep(catalog.readable(tx.roots, t.catalog_key, t.catalog_page, t.id))?
    let mut p: Bytes = list.with_capacity(12)
    list.put_word_be(mut p, t.id)
    std.codec.encode_key(t.key, k, mut p)
    fetch_logical(tx, take p)
}

pub fn fetch[K, V](tx: Tx, t: Table[K, V], k: K) -> Result[Option[V], Error] {
    match fetch_bytes(tx, t, k)? {
        Some(raw) => Ok(Some(row_value(t.readers, t.id, raw)?)),
        None => Ok(None)
    }
}

pub fn key_span[K, V](t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Read, Error] {
    Ok(Span(lower_bytes(t.id, typed_bound(t.key, lo)?, false)?, lower_bytes(t.id, typed_bound(t.key, hi)?, true)?))
}

// AG3: the value a publisher sends for a Change of t, in t's current codec without the u16
// schema prefix. An older number is read with its Reader and encoded again, because the old
// encoding may differ in length and layout. A key of another table (an index row's key
// included) is Missing("table").
pub fn published_value[K, V](t: Table[K, V], c: Change) -> Result[Option[Bytes], Error] {
    let mine = failure_result_from_rep(catalog.prefix(t.id))?
    if list.len(c.tree_key) < 4 || list.slice(c.tree_key, 0, 4) != list.slice(mine, 0, 4) {
        return Error(Missing("table"))
    }
    publish_row(t.id, t.readers, c)
}

fn publish_row[V](id: u32, registered: Readers[V], c: Change) -> Result[Option[Bytes], Error] {
    let raw = match c.value {
        Some(v) => v,
        None => return Ok(None)
    }
    if list.len(raw) < 2 {
        return Error(Decode(Truncated(0)))
    }
    let number: u16 = int.truncate(format.read_le(raw, 0, 2))
    let mut out: Bytes = list.with_capacity(list.len(raw) - 2)
    if number == registered.current {
        list.append(mut out, list.slice(raw, 2, list.len(raw)))
        return Ok(Some(take out))
    }
    let v = row_value(registered, id, raw)?
    std.codec.encode(registered.codec, v, mut out) ?=> |_| Limit(Value)
    Ok(Some(take out))
}

// Whether a changed data-tree key falls in a read: equal to a Point, or in a Span's [low, high).
pub fn reads_key(r: Read, key: Bytes) -> bool {
    match r {
        Point(p) => p == key,
        Span(low, high) => low <= key && key < high
    }
}

fn index_decoder[J, K, V, P](ix: Index[J, K, V, P]) -> RowDecoder[K, V] {
    let k = ix.key
    let start = 4u64
    let skip: own[send] fn(Bytes, mut u64) -> Result[(), std.codec.DecodeError] = fn(raw: Bytes, mut at: u64) -> Result[(), std.codec.DecodeError] {
        at = start
        let _ = std.codec.take_key_with(raw, mut at, k)?
        Ok(())
    }
    read.RowDecoder(table: ix.table, key: ix.primary, readers: arc.share(ix.readers), unique: (ix.kind == Unique), skip: Some(take skip))
}

fn index_bound[J](ix: u32, key: std.codec.Key[J], limit: Bound[J], high: bool) -> Result[Bytes, Error] {
    match limit {
        Unbounded => failure_result_from_rep(catalog.prefix(if high {
            ix + 1
        } else {
            ix
        })),
        Included(x) => {
            let p = failure_result_from_rep(catalog.logical_key(ix, failure_result_from_rep(catalog.encode_key(key, x))?))?;
            if high {
                failure_result_from_rep(catalog.prefix_after(p))
            } else {
                Ok(take p)
            }
        },
        Excluded(x) => {
            let p = failure_result_from_rep(catalog.logical_key(ix, failure_result_from_rep(catalog.encode_key(key, x))?))?;
            if high {
                Ok(take p)
            } else {
                failure_result_from_rep(catalog.prefix_after(p))
            }
        }
    }
}

pub fn system_table[K, V](db: Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    healthy(db)?
    catalog_handle(db.store, pages.holder_heads(db.holders)[0].roots.catalog, failure_result_from_rep(catalog.named(name))?, take key, take value)
}

fn stage_create_table[K, V](mut plan: SchemaPlan, name: String, key: std.codec.Key[K], value: std.codec.Codec[V]) -> Result[(), Error] {
    let k = failure_result_from_rep(catalog.table_key(name))?
    if let Some(_) = pages.get_page_row(plan.schema.roots.catalog, k) {
        return Error(Exists(failure_result_from_rep(catalog.named(name))?))
    }
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let mut schemas: List[catalog.ValueSchema] = list.new()
    let fp = std.codec.fingerprint_of(schema)
    list.push(mut schemas, catalog.ValueSchema(number: 0, fingerprint: fp, schema: take schema))
    let id = plan.schema.next_table
    let c = indexes.Catalog(record: CatalogTable, id: id, owner: 0, epoch: 1, key: (std.codec.key_schema(key) ?=> |_| Schema(0)), schemas: take schemas, next: 1, by: list.new(), revision: list.new())
    let raw = encode_catalog(c)?
    let live_bytes = catalog_recharge(plan.schema.live, plan.schema.roots, k, raw, plan.schema.retained)
    let base = pages.share_roots(plan.schema.roots)
    let mut roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, base, k, raw))?
    failure_result_from_rep(catalog.define_store_collection(mut roots.collections, id, 1, mut plan.schema.next_node))?
    plan.step_drift = true
    keep_schema(mut plan, take roots, int.saturating_add(live_bytes, 126), id + 1)
}

fn readers[V](value: std.codec.Codec[V], c: indexes.Catalog, current: u16, schema: Bytes) -> Result[Arc[Readers[V]], Error] {
    let mut older: List[Option[std.codec.Reader[V]]] = list.with_capacity(int.widen(c.next))
    for _ in 0u64 .. int.widen(c.next) {
        list.push(mut older, None)
    }
    for old in c.schemas {
        if old.number != current {
            let resolution = std.codec.resolve(value, old.schema)
            let resolved = match take resolution {
                Error(Schema(i)) => return Error(Schema(i)),
                Error(e) => return Error(Decode(e)),
                Ok(take read_source) => take read_source
            }
            let _ = list.set(mut older, int.widen(old.number), Some(take resolved))
        }
    }
    let schemas = arc.new(RowSchemas(key: failure_result_from_rep(types.copied(c.key))?, value: failure_result_from_rep(types.copied(schema))?))
    Ok(arc.new(Readers(codec: value, current: current, older: take older, schemas: take schemas)))
}

pub fn table[K, V](mut db: Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] waits {
    healthy(db)?
    let mut plan = schema_plan(db)
    let target = stage_table(mut plan, name, take key, take value)?
    if plan.schema.changed {
        let _ = publish_schema_plan(mut db, take plan)?
    }
    Ok(take target)
}

fn stage_table[K, V](mut plan: SchemaPlan, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let k = failure_result_from_rep(catalog.table_key(name))?
    let mut c = match pages.get_page_row(plan.schema.roots.catalog, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(failure_result_from_rep(catalog.named(name))?))
    }
    if indexes.catalog_kind(c.record) != TableCollection {
        return Error(Missing(failure_result_from_rep(catalog.named(name))?))
    }
    let key_schema = std.codec.key_schema(key) ?=> |_| Schema(0)
    if key_schema != c.key {
        return Error(Schema(0))
    }
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    let mut number = c.next
    let mut found = false
    for old in c.schemas {
        if old.fingerprint == fp && old.schema == schema {
            number = old.number;
            found = true
        }
    }
    // Resolve before publishing a schema addition: Schema is always without effect.
    let resolved = readers(value, c, number, schema)?
    let key_handle = failure_result_from_rep(catalog.catalog_key_handle(take k))?
    let seen = failure_result_from_rep(catalog.catalog_page(plan.schema.roots.catalog))?
    if !found {
        list.push(mut c.schemas, catalog.ValueSchema(number: number, fingerprint: fp, schema: take schema))
        c.next += 1
        let raw = encode_catalog(c)?
        let live_bytes = catalog_recharge(plan.schema.live, plan.schema.roots, key_handle, raw, plan.schema.retained)
        let base = pages.share_roots(plan.schema.roots)
        let roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, base, key_handle, raw))?
        let next_id = plan.schema.next_table
        keep_schema(mut plan, take roots, live_bytes, next_id)?
    }
    Ok(Table(store: plan.store, id: c.id, catalog_key: take key_handle, catalog_page: take seen, key: key, readers: take resolved))
}

fn catalog_handle[K, V](store_id: StoreId, catalog_tree: pages.PageTree, take name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let k = failure_result_from_rep(catalog.table_key(name))?
    let c = match pages.get_page_row(catalog_tree, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(take name))
    }
    if indexes.catalog_kind(c.record) != TableCollection {
        return Error(Missing(take name))
    }
    let key_schema = std.codec.key_schema(key) ?=> |_| Schema(0)
    if key_schema != c.key {
        return Error(Schema(0))
    }
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    for prior in c.schemas {
        if prior.fingerprint == fp && prior.schema == schema {
            let number = prior.number
            let resolved = readers(value, c, number, schema)?
            return Ok(Table(store: store_id, id: c.id, catalog_key: failure_result_from_rep(catalog.catalog_key_handle(take k))?, catalog_page: failure_result_from_rep(catalog.catalog_page(catalog_tree))?, key: key, readers: take resolved))
        }
    }
    Error(Schema(int.widen(c.next)))
}

fn catalog_index_handle[J, K, V, P](catalog_tree: pages.PageTree, t: Table[K, V], c: indexes.Catalog, take k: Bytes, take key: std.codec.Key[J], take payload: Option[Arc[Readers[P]]], payload_codec: std.codec.Codec[P]) -> Result[Index[J, K, V, P], Error] {
    let public = match pages.get_page_row(catalog_tree, k) {
        Some(raw) => catalog.record_public(raw),
        None => false,
    }
    let lendable = lends_i8_rows(payload)
    Ok(Index(store: t.store, id: c.id, catalog_key: failure_result_from_rep(catalog.catalog_key_handle(take k))?, catalog_page: failure_result_from_rep(catalog.catalog_page(catalog_tree))?, table: t.id, key: key, primary: t.key, readers: arc.share(t.readers), kind: entry_kind(catalog_index(c)?.shape)?, payload: take payload, payload_codec: payload_codec, public: public, lendable: lendable))
}

fn stage_drop_table_key(mut plan: SchemaPlan, catalog_key: Bytes, table_id: u32) -> Result[(), Error] {
    let indexes = index_catalog_in(plan.schema.roots.catalog, table_id)?
    let mut ids: List[u32] = list.new()
    list.push(mut ids, table_id)
    for ix in indexes {
        list.push(mut ids, ix.id)
    }
    let mut roots = pages.share_roots(plan.schema.roots)
    let mut live_bytes = plan.schema.live
    failure_result_from_rep(types.capacity(list.try_reserve(mut plan.schema.superseded, list.len(ids))))?
    for id in ids {
        let charge = failure_result_from_rep(catalog.remove_store_collection(mut roots.collections, id, mut plan.schema.next_node))?
        // 3150 F2: a dropped table and its indexes supersede their ids.
        discard_replayed_collection(mut roots.collections, id)?
        list.push(mut plan.schema.superseded, id)
        if !plan.schema.retained {
            live_bytes = int.saturating_sub(live_bytes, charge)
        }
    }
    let low = failure_result_from_rep(catalog.index_prefix(table_id))?
    let high = failure_result_from_rep(catalog.index_prefix(table_id + 1))?
    let mut cursor = byte_cursor(roots.catalog, Included(take low), high)?
    while let Some((k, v)) = failure_result_from_rep(catalog.next_bytes(mut cursor))? {
        if !plan.schema.retained {
            live_bytes = int.saturating_sub(live_bytes, entry(k, v))
        }
        failure_result_from_rep(catalog.remove_store_row(mut roots.catalog, k, mut plan.schema.next_node))?
    }
    if let Some(raw) = pages.get_page_row(plan.schema.roots.catalog, catalog_key) {
        if !plan.schema.retained {
            live_bytes = int.saturating_sub(live_bytes, entry(catalog_key, raw))
        }
    }
    failure_result_from_rep(catalog.remove_store_row(mut roots.catalog, catalog_key, mut plan.schema.next_node))?
    drop_migrate_source(mut plan, table_id)
    plan.step_drift = true
    let next_id = plan.schema.next_table
    keep_schema(mut plan, take roots, live_bytes, next_id)
}

// AP13. Collect and admit the encoded workspace, sort the destination
// records, then build the table and each index bottom up.
fn migrate_build[K, V, K2, V2](source: pages.PageTree, take base: pages.Roots, mut ids: u64, start: u64, ceiling: u64, retained: bool, from: Table[K, V], olds: List[indexes.Catalog], to_name: String, to_key: std.codec.Key[K2], to_value: std.codec.Codec[V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity], id: u32, number: u16, target: Bytes, value_limit: u64) -> Result[catalog.Built, Error] {
    let mut roots = take base
    let schema = std.codec.schema(to_value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    let mut schemas: List[catalog.ValueSchema] = list.new()
    list.push(mut schemas, catalog.ValueSchema(number: number, fingerprint: fp, schema: take schema))
    let table_raw = encode_catalog(indexes.Catalog(record: CatalogTable, id: id, owner: 0, epoch: 1, key: (std.codec.key_schema(to_key) ?=> |_| Schema(0)), schemas: take schemas, next: number + 1, by: list.new(), revision: list.new()))?
    let mut live_bytes = int.saturating_add(start, 126 + entry(target, table_raw))
    let mut workspace = live_bytes
    failure_result_from_rep(catalog.over_ceiling(workspace, ceiling))?
    let Some(source_root) = std.page.collection_child(source.root, failure_result_from_rep(catalog.prefix(from.id))?) else {
        return Error(Stale(from.id))
    }
    let (source_rows, _) = std.page.totals(source_root)
    let mut original = std.page.cursor_open(source_root, None, true, false)
    let mut new_rows: List[std.page.Row] = list.new()
    loop {
        // Decode each source row from the page in place, with no owned copy.
        let read = std.page.cursor_read(mut original, scoped fn(key: Bytes, raw: Bytes) -> Result[(K, V, u64), Error] {
            let decoded_key = failure_result_from_rep(catalog.decoded(std.codec.decode_key(from.key, key)))?
            Ok((take decoded_key, row_value(from.readers, from.id, raw)?, list.len(raw)))
        })
        let Some(take found) = take read else {
            break
        }
        let (take k, take v, source_width) = found?
        if let Some((k2, v2)) = failure_result_from_rep(types.capacity(f(k, v)))? {
            let encoded = failure_result_from_rep(catalog.encode_key(to_key, k2))?
            if list.len(encoded) > 4092 {
                return Error(Limit(Key))
            }
            // The source row's width sizes the buffer, so an upgrade that keeps
            // the row's size encodes it with no regrowth.
            let width = order.max(source_width, 2 + std.codec.least(to_value))
            let mut raw: Bytes = list.with_capacity(order.min(width, value_limit))
            failure_result_from_rep(types.capacity(format.le(mut raw, int.widen(number), 2)))?
            std.codec.encode(to_value, v2, mut raw) ?=> |_| Limit(Value)
            if list.len(raw) > value_limit {
                return Error(Limit(Value))
            }
            let charge = 62 + format.round8(4 + list.len(encoded)) + format.round8(list.len(raw))
            workspace = int.saturating_add(workspace, charge + 8)
            failure_result_from_rep(catalog.over_ceiling(workspace, ceiling))?
            live_bytes = int.saturating_add(live_bytes, charge)
            list.push(mut new_rows, std.page.Row(key: take encoded, value: take raw, charge: charge))
        }
    }
    sort_bulk_rows(mut new_rows)?
    for slot in 1u64 .. list.len(new_rows) {
        if new_rows[slot - 1].key == new_rows[slot].key {
            return Error(Exists(failure_result_from_rep(catalog.named(to_name))?))
        }
    }
    let written = list.len(new_rows)
    failure_result_from_rep(catalog.bulk_store_collection(mut roots.collections, id, 1, new_rows, mut ids))?
    let former = failure_result_from_rep(catalog.remove_store_collection(mut roots.collections, from.id, mut ids))?
    if !retained {
        live_bytes = int.saturating_sub(live_bytes, former)
    }
    for old in olds {
        let charge = failure_result_from_rep(catalog.remove_store_collection(mut roots.collections, old.id, mut ids))?
        if !retained {
            live_bytes = int.saturating_sub(live_bytes, charge)
        }
    }
    let low = failure_result_from_rep(catalog.index_prefix(from.id))?
    let high = failure_result_from_rep(catalog.index_prefix(from.id + 1))?
    let mut catalog_rows = byte_cursor(roots.catalog, Included(take low), high)?
    while let Some((k, v)) = failure_result_from_rep(catalog.next_bytes(mut catalog_rows))? {
        if !retained {
            live_bytes = int.saturating_sub(live_bytes, entry(k, v))
        }
        failure_result_from_rep(catalog.remove_store_row(mut roots.catalog, k, mut ids))?
    }
    if let Some(raw) = pages.get_page_row(roots.catalog, from.catalog_key) {
        if !retained {
            live_bytes = int.saturating_sub(live_bytes, entry(from.catalog_key, raw))
        }
    }
    failure_result_from_rep(catalog.remove_store_row(mut roots.catalog, from.catalog_key, mut ids))?
    roots = failure_result_from_rep(catalog.catalog_insert(mut ids, roots, target, table_raw))?
    if !retained {
        live_bytes = pages.one_page_account(roots)
    }
    failure_result_from_rep(catalog.over_ceiling(live_bytes, ceiling))?
    Ok(catalog.Built(roots: take roots, live: live_bytes, read: source_rows, written: written))
}

fn bucket(_k: u64, v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, v % 4)
    Ok(take keys)
}

fn typed_put(mut db: Db, t: Table[u64, u64], k: u64, v: u64) -> bool waits {
    let out = run(mut db, None, (copy_env(k), copy_env(t), copy_env(v)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.1, call_env.0, call_env.2)
    })
    match take out {
        Ok(Committed(_)) => true,
        _ => false
    }
}

fn check_table_write[K, V](tx: Tx, t: Table[K, V]) -> Result[List[(u64, indexes.Catalog)], Error] {
    check_write_attempt(tx)?
    if let Some(stop) = tx.index_conflict {
        return Error(index_stop_error(stop)?)
    }
    writable(tx, t)
}

pub fn put[K, V](mut tx: Tx, t: Table[K, V], k: K, v: V) -> Result[(), Error] {
    let indexes = check_table_write(tx, t)?
    let tail = tx.frame_tail == pages.OPEN_FRAME_TAIL
    let mut p = failure_result_from_rep(catalog.prefixed(t.id, 8, tail))?
    std.codec.encode_key(t.key, k, mut p)
    put_impl(mut tx, t, indexes, take p, v, tail)
}

pub fn delete[K, V](mut tx: Tx, t: Table[K, V], k: K) -> Result[bool, Error] {
    let indexes = check_table_write(tx, t)?
    let key = failure_result_from_rep(catalog.encode_key(t.key, k))?
    delete_impl(mut tx, t.id, t.readers.current, indexes, key)
}

type OldAccount {
    balance: u64
}

type NewAccount {
    balance: u64,
    bonus: u64
}

fn upgrade(k: u64, v: OldAccount) -> Result[Option[(u64, NewAccount)], Capacity] {
    Ok(Some((k, NewAccount(balance: v.balance, bonus: v.balance * 10))))
}

pub type Looked[R] = Seen(Seen[R]) | Failed(Causes, List[Read]) | Refused(StoreCapacity, List[Read]) | Stopped(OutOfTime, List[Read])

pub type Seen[R] {
    value: R,
    version: u64,
    reads: List[Read]
}

pub type Change {
    tree_key: Bytes,
    value: Option[Arc[Bytes]]
}

pub fn changes(r: Reader, a: Snapshot, b: Snapshot) -> Result[Changes, Error] waits {
    read_access(r, a)?
    read_access(r, b)?
    if !types.same(a.store.hi, a.store.lo, b.store.hi, b.store.lo) || a.open != b.open {
        return Error(Foreign)
    }
    snapshot_changes(r, a, b)
}

fn catalog_recharge(live_bytes: u64, roots: pages.Roots, key: Bytes, value: Bytes, retained: bool) -> u64 {
    let old_charge = if retained {
        0u64
    } else {
        match pages.get_page_row(roots.catalog, key) {
            Some(old) => entry(key, old),
            None => 0
        }
    }
    int.saturating_add(int.saturating_sub(live_bytes, old_charge), entry(key, value))
}

pub fn stage_export_migration(source: Preparation, tasks: Tasks, configure: StaticFn[fn(mut Migration) -> Result[(), Error] waits]) -> Result[StagedMigration, Error] waits {
    stage_migration(source.db, tasks, configure)
}

pub fn export_system_get[K, V](source: Preparation, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V], at: K) -> Result[Option[V], Error] waits {
    let selected = system_table(source.db, name, take key, take value)?
    get(staged_reader(source, 0)?, snapshot(source.db), selected, at)
}

pub fn staged_snapshot(source: Preparation, staged: StagedMigration) -> Snapshot {
    snapshot_from(source.db, 0u64, source.stamp.head, staged.plan.schema.roots, int.saturating_add(staged.plan.schema.next_node, 1))
}

pub type PreparedTarget: codec + send {
    describe: Bytes,
    release: Bytes,
    digest: Bytes,
    resident_limit: u64,
    pack_bytes: u64,
    checkpoint_bytes: u64,
    journal_limit: u64,
    // NEW's limits (§11.1 AP4a); None keeps the store's, others must match.
    limits: Option[StoreLimits]
}

type PreparedMeta: codec + send {
    base: ExportStamp,
    target: PreparedTarget,
    next_table: u32,
    changes: u64,
    ranges: u64
}

type CatalogChange: codec + send {
    key: Bytes,
    before: Option[Bytes],
    after: Option[Bytes]
}

type Inventory: codec + send {
    id: u32,
    count: u64,
    digest: u64
}

type PreparedRow: codec + send {
    key: Bytes,
    value: Bytes
}

fn catalog_changes(base: pages.Roots, target: pages.Roots) -> Result[List[CatalogChange], Error] {
    let mut edits: List[CatalogChange] = list.new()
    let mut before = failure_result_from_rep(pages.open_page_range(base.catalog, None, true, false, None))?
    while let Some((take key, old_arc)) = failure_result_from_rep(catalog.next_page_range(mut before))? {
        match pages.get_page_row(target.catalog, key) {
            Some(new) => if list.compare_bytes(new, old_arc) != Equal {
                list.push(mut edits, CatalogChange(key: take key, before: Some(failure_result_from_rep(types.copied(old_arc))?), after: Some(failure_result_from_rep(types.copied(new))?)))
            },
            None => list.push(mut edits, CatalogChange(key: take key, before: Some(failure_result_from_rep(types.copied(old_arc))?), after: None)),
        }
    }
    let mut after = failure_result_from_rep(pages.open_page_range(target.catalog, None, true, false, None))?
    while let Some((take key, new)) = failure_result_from_rep(catalog.next_page_range(mut after))? {
        let exists = match pages.get_page_row(base.catalog, key) {
            Some(_) => true,
            None => false
        }
        if !exists {
            list.push(mut edits, CatalogChange(key: take key, before: None, after: Some(failure_result_from_rep(types.copied(new))?)))
        }
    }
    list.sort(mut edits, fn(a: CatalogChange, b: CatalogChange) -> Order {
        std.order.compare(a.key, b.key)
    })
    Ok(take edits)
}

type RangeChange: send {
    id: u32,
    catalog: Option[Bytes]
}

fn changed_ranges(edits: List[CatalogChange], initial: u32, advanced: u32) -> Result[List[RangeChange], Error] {
    let mut changes_by_id: List[RangeChange] = list.new()
    for change in edits {
        let old = match change.before {
            Some(raw) => decode_catalog(raw)?.id,
            None => 0u32
        }
        let new = match change.after {
            Some(raw) => decode_catalog(raw)?.id,
            None => 0u32
        }
        if old == new {
            // An index OLD left Backfilling or Failed that the preparation
            // finished under the same id: its entries ship as a replaced range.
            if let (Some(before), Some(after)) = (change.before, change.after) {
                if indexes.catalog_kind(decode_catalog(after)?.record) == IndexCollection && !catalog.record_public(before) {
                    list.push(mut changes_by_id, RangeChange(id: new, catalog: Some(failure_result_from_rep(types.copied(after))?)))
                }
            }
            continue
        }
        if old != 0u32 {
            list.push(mut changes_by_id, RangeChange(id: old, catalog: None))
        }
        if let Some(raw) = change.after {
            list.push(mut changes_by_id, RangeChange(id: new, catalog: Some(failure_result_from_rep(types.copied(raw))?)))
        }
    }
    list.sort(mut changes_by_id, fn(a: RangeChange, b: RangeChange) -> Order {
        std.order.compare(a.id, b.id)
    })
    let mut previous = 0u32
    let mut expected = initial
    for change in changes_by_id {
        if previous >= change.id {
            return Error(failure_from_rep(pages.malformed(0u64)))
        }
        previous = change.id
        if change.id >= initial {
            if change.id != expected || expected == 4294967295u32 {
                return Error(failure_from_rep(pages.malformed(0u64)))
            }
            expected += 1
        }
    }
    if expected != advanced {
        return Error(failure_from_rep(pages.malformed(0u64)))
    }
    Ok(take changes_by_id)
}

fn entries_of(data: pages.PageTree, id: u32) -> Result[pages.PageRange, Error] {
    if id == 4294967295u32 {
        return Error(failure_from_rep(pages.malformed(0u64)))
    }
    byte_cursor(data, Included(failure_result_from_rep(catalog.prefix(id))?), failure_result_from_rep(catalog.prefix(id + 1u32))?)
}

fn checksum_row(mut checksum: std.check.Xxh3, key: Bytes, encoded: Bytes) -> Result[(), Error] {
    let mut lengths: Bytes = list.with_capacity(8u64)
    failure_result_from_rep(types.capacity(format.le(mut lengths, list.len(key), 4u64)))?
    failure_result_from_rep(types.capacity(format.le(mut lengths, list.len(encoded), 4u64)))?
    std.check.add(mut checksum, lengths, 0u64, 8u64)
    std.check.add(mut checksum, key, 0u64, list.len(key))
    std.check.add(mut checksum, encoded, 0u64, list.len(encoded))
    Ok(())
}

fn range_inventory(data: pages.PageTree, ranges: List[RangeChange]) -> Result[List[Inventory], Error] {
    let mut inventory: List[Inventory] = list.with_capacity(list.len(ranges))
    for desc in ranges {
        let mut cursor = entries_of(data, desc.id)?
        let mut row_total = 0u64
        let mut checksum = std.check.start()
        while let Some((key, value)) = failure_result_from_rep(catalog.next_bytes(mut cursor))? {
            checksum_row(mut checksum, key, value)?
            row_total += 1
        }
        list.push(mut inventory, Inventory(id: desc.id, count: row_total, digest: std.check.finish(checksum)))
    }
    Ok(take inventory)
}

pub fn validate_preparation(source: Preparation, staged: StagedMigration) -> Result[(), Error] {
    let mut state = failure_result_from_rep(types.capacity(current_state(source.db)))?
    state.tips[0].roots = pages.share_roots(staged.plan.schema.roots)
    failure_result_from_rep(catalog.over_ceiling(failure_result_from_rep(types.capacity(pages.state_account(state)))?, txn.available_resident(source.db.accounting, source.db.call_streams.keyed_credit)))
}

fn db_target(db: Db) -> Option[manifest.TargetLimits] {
    if is_disk(db) {
        disk_state(db).target
    } else {
        None
    }
}

fn disk_start(d: Dir, c: Clock, r: Random, options: Options) -> Result[journal.DiskStartup, Error] waits {
    let selected = read_page_manifest_file(d)
    let mut loaded = match take selected {
        Ok((id, take page_record)) => {
            failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(options.expect), store_key_to_rep(id)))?
            failure_result_from_rep(types.check_limits(optional_limits_to_rep(options.limits), page_record.limits))?
            let validated = select_page_manifest(d, id, take page_record)?
            let loaded = failure_result_from_rep(history.disk_loaded(store_key_to_rep(id), take validated))?
            // §13.8: a catalog with a Tiered collection opens only on a funded
            // plan, refused before the journal is read or a task is started.
            if !tiered_open_funded(options) && pages.holders_tiered(loaded.all) {
                return Error(Missing("cache_bytes"))
            }
            take loaded
        },
        Error(Io(NotFound)) => {
            if let Some(_) = options.expect {
                return Error(NotFound)
            }
            if !options.create {
                return Error(NotFound)
            }
            let id = failure_result_from_rep(types.capacity(types.disk_identity(r)))?
            let page_record = manifest.page_manifest_empty(types.named_limits(optional_limits_to_rep(options.limits)))
            let mut creation = failure_result_from_rep(journal.disk_creation_block())?
            let (take segment, take end_file, take header) = failure_result_from_rep(journal.disk_new_segment(d, c, id, 1, 0, mut creation))?
            failure_result_from_rep(manifest.disk_publish_manifest(d, id, page_record))?
            let genesis = failure_result_from_rep(types.capacity(pages.main_state(pages.empty_roots(), 0, 0)))?
            let page_disk = manifest.genesis_pack_disk()
            return Ok(journal.DiskStartup(store: id, fence: 0, state: take genesis, live: 0, tiered: 0, resident_pages: 0, uncovered: 0, next_node: 0, next_table: 1, generation: 1, cut_first: 1, recorded_after: 0, seq: 1, segment: take segment, end_file: take end_file, header: take header, creation: take creation, pages: take page_disk, limits: types.named_limits(optional_limits_to_rep(options.limits))))
        },
        Error(take problem) => return Error(take problem),
    }
    let manifested = disk_allocation(scoped fn() -> Result[pages.State, Error] {
        failure_result_from_rep(types.capacity(manifest.manifest_state(loaded.manifest, loaded.all)))
    })?
    list.clear(mut loaded.all)
    let owners = disk_allocation(scoped fn() -> Result[Map[manifest.IncomingEdge, u64], Error] {
        Ok(manifest.located_owners(loaded.manifest))
    })?
    let recorded_after = manifested.tips[0u64].head
    let initial = failure_result_from_rep(pager.journal_replay_manifest(take manifested, loaded.manifest))?
    let recovered = journal_recover(d, store_key_from_rep(loaded.store), loaded.manifest.first_live, c, take initial)?
    let journal.JournalRecovered(replay: take replay, seq: last_seq, end: last_end, uncovered: uncovered) = take recovered
    let live_bytes = failure_result_from_rep(journal.journal_account(replay))?
    let pager.JournalReplay(state: take state, next_node: next_node, tiered: tiered, forked: take forked, ..) = take replay
    failure_result_from_rep(txn.check_stream_quota(state.tips[0u64].roots.streams, options.streams_max))?
    failure_result_from_rep(catalog.over_ceiling(live_bytes, options.resident_limit))?
    let resident_pages = disk_allocation(scoped fn() -> Result[u64, Error] {
        let roots = failure_result_from_rep(types.capacity(pages.state_roots(state)))?
        Ok(int.saturating_add(manifest.resident_images(roots, Some(view loaded.lists)), manifest.location_storage_charge(loaded.locations)))
    })?
    let Some(seq) = int.checked_add(last_seq, 1) else {
        return Error(Limit(Ids))
    }
    // Fence the removal of an orphan END before making its successor HEADER.
    let orphan_end = failure_result_from_rep(types.capacity(manifest.disk_path("j-", seq, ".end")))?
    let _ = failure_result_from_rep(manifest.disk_remove_optional(d, orphan_end))?
    failure_result_from_rep(manifest.disk_io(host.sync_dir(d)))?
    let mut creation = failure_result_from_rep(journal.disk_creation_block())?
    let (take segment, take end_file, take header) = failure_result_from_rep(journal.disk_new_segment(d, c, loaded.store, seq, last_end, mut creation))?
    let manifest.DiskLoaded(store: id, manifest: take page_record, lists: take lists, locations: take locations, ..) = take loaded
    let page_disk = manifest.recovered_pack_disk(page_record, take locations, take lists, take owners, take forked)
    Ok(journal.DiskStartup(store: id, fence: page_record.fence, state: take state, live: live_bytes, tiered: tiered.total, resident_pages: resident_pages, uncovered: uncovered, next_node: next_node, next_table: page_record.next_table, generation: page_record.generation, cut_first: page_record.first_live, recorded_after: recorded_after, seq: seq, segment: take segment, end_file: take end_file, header: take header, creation: take creation, pages: take page_disk, limits: page_record.limits))
}

fn disk_session(d: Dir, clock: Clock, r: Random, options: Options) -> Result[journal.DiskSession, Error] waits {
    if failure_result_from_rep(journal.disk_exists(d, "MANIFEST"))? {
        let mut manifest_file = failure_result_from_rep(manifest.disk_io(host.open(d, "MANIFEST", Read)))?
        failure_result_from_rep(manifest.check_page_manifest_header(mut manifest_file))?
        failure_result_from_rep(manifest.disk_io(host.close(take manifest_file)))?
    }
    let lock = failure_result_from_rep(journal.disk_lock(d, clock, options.lock_wait_ms))?
    if failure_result_from_rep(journal.disk_exists(d, "EXPORT"))? {
        return Error(ExportDirectory)
    }
    let startup = disk_start(d, clock, r, options)?
    Ok(journal.DiskSession(lock: take lock, startup: take startup))
}

type DiskState {
    open: u64,
    options: Options,
    lease: Option[Arc[manifest.ExportLease]],
    // The schema commits main published since the lease last moved
    // (§3.5a "Catch-up"): they reach the child as the round's STEPS.
    steps: List[LeaseStep],
    imported: Option[KeptImport],
    reserving: Option[Inline[u8, 32]],
    target: Option[manifest.TargetLimits],
    retention: journal.RecordRetention,
    packs: manifest.PackDiskState,
    backend: Backend,
    tasks: Tasks,
    tiered: pager.DiskPagerState
}

fn open_number(db: Db) -> u64 {
    if is_disk(db) {
        disk_state(db).open
    } else {
        0u64
    }
}

// A main-branch record at or before this version is below the live journal.
pub fn retained_main_after(db: Db) -> u64 {
    if is_disk(db) {
        journal.retained_after(disk_state(db).retention)
    } else {
        0u64
    }
}

fn healthy(db: Db) -> Result[(), Error] {
    match journal_poison(db) {
        Some(e) => Error(Poisoned(e)),
        None => object_writer_healthy(db),
    }
}

fn open_heads(mut db: Db, take state: pages.State) -> Result[(), Error] {
    let pages.State(tips: take tips, pins: take pins, next_branch: next_branch, next_table: _) = take state
    let mut heads: List[pages.Head] = list.new()
    let mut names: Map[String, u32] = map.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut heads, list.len(tips))))?
    failure_result_from_rep(types.capacity(map.try_reserve(mut names, list.len(tips) - 1)))?
    let mut total = 0u64
    for take t in take tips {
        let pages.Tip(id: br, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: head, at: at) = take t
        total += manifest.branch_root_bytes(name, roots)
        if br != 0 {
            let key = disk_allocation(scoped fn() -> Result[String, Error] {
                failure_result_from_rep(catalog.named(name))
            })?
            map.insert(mut names, take key, br)
        }
        list.push(mut heads, pages.Head(id: br, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: head, at: at))
    }
    for stored in pins {
        total += manifest.pin_root_bytes(stored.name, stored.roots)
    }
    pages.restore_holders(mut db.holders, take heads, take names, take pins, total, next_branch)
    list.clear(mut db.followers)
    Ok(())
}

// S3 makes the disk opener public with its journal and final durability path.
/// Opens a Directory store. An object store opens with `open_authority`.
pub fn open(tasks: Tasks, d: Dir, c: Clock, r: Random, options: Options) -> Result[Db, Error] waits {
    open_directory(tasks, d, c, r, options, journal.DIRECTORY_JOURNAL_CADENCE)
}

/// Captures an existing Directory store. The clock drives the terminal
/// segment fence wait if a dead writer still has a write in flight.
pub fn open_read_only(d: Dir, c: Clock, options: Options) -> Result[ReadOnly, Error] waits {
    if let Bucket(_) = options.authority {
        return Error(Unsupported(1))
    }
    failure_result_from_rep(object_writer.open_checks(options.group_commits, options.group_bytes, optional_limits_to_rep(options.limits), options.checkpoint_bytes, options.journal_limit))?
    let mut restarted = false
    loop {
        let (take raw, store, take page_record) = failure_result_from_rep(capture.read_only_manifest(d))?
        let id = store_key_from_rep(store)
        failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(options.expect), store_key_to_rep(id)))?
        failure_result_from_rep(types.check_limits(optional_limits_to_rep(options.limits), page_record.limits))?
        let candidate = failure_result_from_rep(journal.capture_walk(d, store_key_to_rep(id), page_record.first_live, restarted))?
        let Some(take selected) = take candidate else {
            restarted = true
            continue
        }
        let mut walk = take selected
        failure_result_from_rep(journal.capture_fence(d, c, 18446744073709551615u64, mut walk))?
        failure_result_from_rep(manifest.disk_io(host.sync_dir(d)))?
        if failure_result_from_rep(manifest.read_page_manifest_bytes(d))? != raw {
            restarted = false
            continue
        }
        let mut initial = read_only_checkpoint(d, id, take page_record)?
        initial.immutable = true
        let replay = capture_scan(id, take walk, take initial)?
        failure_result_from_rep(catalog.over_ceiling(failure_result_from_rep(journal.journal_account(replay))?, options.resident_limit))?
        let inner = failure_result_from_rep(read.read_only_state(store, replay))?
        return Ok(ReadOnly(inner: take inner))
    }
}

fn open_started(tasks: Tasks, d: Dir, c: Clock, options: Options, cadence_spec: journal.JournalCadence, take session: journal.DiskSession) -> Result[Db, Error] waits {
    let journal.DiskSession(lock: take lock, startup: take startup) = take session
    let zero_extension = failure_result_from_rep(manifest.disk_io(host.zero_extension(d)))?
    let journal.DiskStartup(store: store, fence: fence, state: take state, live: live_bytes, tiered: tiered, resident_pages: resident_pages, uncovered: uncovered, next_node: next_node, next_table: next_table, generation: generation, cut_first: cut_first, recorded_after: recorded_after, seq: seq, segment: take segment, end_file: take end_file, header: take header, creation: take creation, pages: take page_disk, limits: limits) = take startup
    let id = store_key_from_rep(store)
    let mut db = disk_allocation(scoped fn() -> Result[Db, Error] {
        Ok(empty_db(c, id, options))
    })?
    open_heads(mut db, take state)?
    db.accounting.resident = live_bytes
    rebuild_keyed_credit(mut db, uncovered, options.journal_limit)?
    // The pager starts before the journal tasks, so a refusal leaves none. It
    // reserves C + K + P (§1.1); a queued Cold frame needs it to drain (§13.6).
    let pager_task: Option[Task[()]] = if store_has_tiered(db) || std.page.count(std.page.image_of(manifest.pack_lists(page_disk).deferred)) != 0 {
        let funding = pager.TieredPagerFunding(cache_bytes: options.cache_bytes, writer_pin_bytes: options.writer_pin_bytes, pager_task_bytes: options.pager_task_bytes, cut_pins: true)
        let link = failure_result_from_rep(object_writer.start_tiered_pager_link(tasks, store_key_to_rep(id), seq, PagerDirectory(d), funding, pager.TIERED_PAGER_QUEUE))?
        Some(attach_tiered_pager(mut db, take link))
    } else {
        None
    }
    catalog.restore_fence(mut db.schema, fence)
    db.limits = limits_from_rep(limits)
    pages.set_next_node(mut db.holders, next_node)
    catalog.set_next_table(mut db.schema, next_table)
    db.accounting.tiered = tiered
    db.accounting.page_resident = resident_pages
    db.accounting.checkpointed = generation
    let start = journal.DirJournalStart(lock: take lock, seq: seq, uncovered: uncovered, creation: take creation, segment: take segment, end_file: take end_file, header: take header)
    let directory = failure_result_from_rep(journal.start_directory(tasks, d, c, store, options.group_commits, options.group_bytes, cadence_spec, zero_extension, take start))?
    db.disk = Some(DiskState(open: seq, options: clone(options), lease: None, steps: list.new(), imported: None, reserving: None, target: None, retention: journal.record_retention(cut_first, recorded_after), packs: take page_disk, backend: DirBackend(take directory), tasks, tiered: pager.disk_pager_state(take pager_task)))
    Ok(take db)
}

fn disk_wait_cut(db: Db, generation: u64) -> Result[(), Error] {
    healthy(db)?
    if db.accounting.checkpointed < generation {
        return Error(Foreign)
    }
    Ok(())
}

fn disk_rotate(mut db: Db, id: StoreId, seq: u64, previous: u64) -> Result[(), Error] waits {
    let c = db.clock
    let closed = match db.disk {
        Some(mut storage) => match storage.backend {
            DirBackend(mut directory) => failure_result_from_rep(journal.rotate(mut directory, c, store_key_to_rep(id), seq, previous))?,
            ObjectBackend(_) => return Error(Unsupported(1)),
        },
        None => return Error(Foreign),
    }
    if closed {
        // The task sends Broken before ending. Preserve that first error.
        loop {
            let ack = journal_receive(db);
            journal_ack(mut db, take ack)?
        }
    }
    journal_poll(mut db)
}

fn cut_io_error(mut db: Db, take problem: Error) -> Error {
    match take problem {
        Io(e) => {
            edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Error {
                edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) -> Error {
                    if let None = queue.poison {
                        queue.poison = Some(e)
                    }
                    Poisoned(option.unwrap(queue.poison))
                })
            })
        },
        other => take other,
    }
}

type CutTiming {
    pause_ns: u64,
    removal_ns: u64,
    removal_attempts: u64,
    drain_groups: u64
}

fn disk_cut_timed(mut db: Db, take delta: HolderDelta, write_seal: scoped fn(mut Bytes, format.DiskContext, u32) -> Result[(), Error] waits, mut timing: Option[CutTiming]) -> Result[Ticket, Error] waits {
    let target = db_target(db)
    let pack_bytes = match target {
        Some(wanted) => wanted.pack,
        None => disk_state(db).options.pack_bytes,
    }
    let limit = cut_output_bytes(pack_bytes, db.limits)
    disk_cut_with_limit(mut db, take delta, write_seal, target, pack_bytes, limit, mut timing)
}

fn disk_cut_with_limit(mut db: Db, take requested: HolderDelta, write_seal: scoped fn(mut Bytes, format.DiskContext, u32) -> Result[(), Error] waits, target: Option[manifest.TargetLimits], pack_bytes: u64, limit: u64, mut timing: Option[CutTiming]) -> Result[Ticket, Error] waits {
    let mut emitted: Option[Map[u64, std.page.PagePtr]] = None
    disk_cut_with_limit_emitted(mut db, take requested, write_seal, target, pack_bytes, limit, mut timing, mut emitted)
}

fn disk_cut_with_limit_emitted(mut db: Db, take requested: HolderDelta, write_seal: scoped fn(mut Bytes, format.DiskContext, u32) -> Result[(), Error] waits, target: Option[manifest.TargetLimits], pack_bytes: u64, limit: u64, mut timing: Option[CutTiming], mut emitted_out: Option[Map[u64, std.page.PagePtr]]) -> Result[Ticket, Error] waits {
    let mut delta = take requested
    if let NoHolderChange = delta {
        delta = orphan_owner3_delta(db)
    }
    healthy(db)?
    if object_writer_open(db) {
        return object_cut_state(mut db, take delta, write_seal, target, pack_bytes, limit)
    }
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) {
            queue.since_cut = 0
        })
    })
    let final_item = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    let observe = match timing {
        Some(_) => true,
        None => false,
    }
    let started = if observe {
        host.mono_ns(db.clock)
    } else {
        0
    }
    let drain_groups = durable_groups(mut db, final_item)?
    let Some(generation) = int.checked_add(db.accounting.checkpointed, 1) else {
        return Error(Limit(Ids))
    }
    let Some(seq) = int.checked_add(file_seq(db), 1) else {
        return Error(Limit(Ids))
    }
    let id = db.store
    prepare_holder_slot(mut db, delta)?
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        manifest.prune_pack_scrubs(mut state.packs)
        pager.prune_leases(mut state.tiered)
    })
    let participants = disk_allocation(scoped fn() -> Result[manifest.CutParticipants, Error] {
        cut_participants(db, delta)
    })?
    let manifest.CutParticipants(holders: take participants_held, roots: take roots, branches: take branches, heads: heads, promote: promote) = take participants
    let mut staged = stage_tiered_cut(db, delta, take roots, branches, heads, promote, pack_bytes)?
    pages.set_next_node(mut db.holders, staged.stamp_end - 1)
    raise_materialized_pin(mut delta, staged)
    let holders = failure_result_from_rep(pager.sealed_cut_holders(take participants_held, staged))?
    let mut base = failure_result_from_rep(manifest.page_retry_base(manifest.pack_locations(disk_state(db).packs), manifest.pack_owners(disk_state(db).packs), holders, staged.roots))?
    failure_result_from_rep(pager.list_tiered_cut(mut base.locations, staged))?
    let lineage_rows = settle_lineage_kills(cut_lineage_rows(db, delta, branches, staged.queue.added)?, db, delta, staged.queue, mut base.locations.packs)?
    failure_result_from_rep(catalog.over_ceiling(base.account, txn.available_resident(db.accounting, db.call_streams.keyed_credit)))?
    let manifest_bytes = cut_manifest_size(db, delta)
    let d = log_directory(db)?
    let mut next_stamp = failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders)))?
    let prev_first = match manifest.pack_deferred(disk_state(db).packs) {
        Some(low) => low,
        None => journal.first_live(disk_state(db).retention),
    }
    let attempt = prepare_page_cut(base.locations, mut next_stamp, scoped fn(marks: Map[u64, ()], relocated: Option[View[core.Log[bool]]], mut stamp: u64) -> Result[PreparedDiskCut, Error] waits {
        let cut_plan = {
            let installed = disk_state(db).packs
            plan_page_cut(base, holders, manifest.pack_lists(installed), staged.queue, lineage_rows, Some(manifest.pack_carried(installed)), staged.next_pack, pack_bytes, marks, relocated, mut stamp)?
        }
        let mut buffers = failure_result_from_rep(manifest.cut_output_buffers(cut_plan, manifest_bytes, limit))?
        // A retry after emission reuses the segment created by the first attempt.
        if file_seq(db) != seq {
            let previous = file_end(db)
            disk_rotate(mut db, id, seq, previous)?
            edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
                if let DirBackend(mut directory) = state.backend {
                    journal.set_segment(mut directory, seq)
                }
            })
        }
        failure_result_from_rep(pager.write_tiered_cut(d, staged, mut buffers))?
        let layout = failure_result_from_rep(manifest.write_page_cut(d, store_key_to_rep(id), take cut_plan, mut buffers))?
        let manifest.PackBuffers(out: take out, ..) = take buffers
        let mut page_record = take out
        let (take pages, take compaction, take removals) = disk_allocation(scoped fn() -> Result[(manifest.PackDiskState, pager.TieredCompaction, journal.DiskRemovals), Error] {
            failure_result_from_rep(journal.cut_retirement(layout, holders, disk_state(db).lease, manifest.pack_scrubs(disk_state(db).packs), staged.compaction, cut_input(db, delta).lease_span, prev_first, seq))
        })?
        fill_cut_manifest(mut page_record, db, delta, staged.roots, generation, seq, prev_first, layout, stamp, base.account, write_seal)?
        Ok(PreparedDiskCut(pages: take pages, compaction: take compaction, removals: take removals, manifest: take page_record))
    })
    pages.set_next_node(mut db.holders, next_stamp - 1)
    let prepared = match take attempt {
        Ok(take cut) => take cut,
        Error(take problem) => return Error(cut_io_error(mut db, take problem)),
    }
    let PreparedDiskCut(pages: take prepared_pages, compaction: take compaction, removals: take removals, manifest: take page_record) = take prepared
    let settled_tiered = failure_result_from_rep(history.prepare_tiered_install(mut staged, manifest.pack_locations(prepared_pages), generation, next_stamp))?
    let tail_bases = prepare_sealed_tail_bases(db, delta, staged, heads)?
    // The records name exactly the frames reachable from the participants
    // and the two list roots, so their running charge is the AP15 report.
    let resident_pages = manifest.resident_location_charge(manifest.pack_locations(prepared_pages))
    validate_cut_pages(d, id, page_record, target, disk_state(db).lease, disk_state(db).packs)?
    if let Error(take problem) = failure_result_from_rep(manifest.publish_page_manifest_bytes(d, page_record)) {
        return Error(cut_io_error(mut db, take problem))
    }
    let recorded_after = match delta {
        ReplaceMain(main, _) => main.head,
        _ => pages.holder_heads(db.holders)[0u64].head
    }
    write_disk(mut db.disk, (take prepared_pages, take compaction), scoped fn(mut state: DiskState, take installation: (manifest.PackDiskState, pager.TieredCompaction)) {
        let (take installed, take candidate) = take installation
        manifest.install_pack_cut(mut state.packs, take installed)
        state.retention = journal.record_retention(seq, recorded_after)
        edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) {
            queue.uncovered = 0
        })
        // Step 5: the lists' rows are now queue rows of the published generation.
        pager.install_disk_cut(mut state.tiered, take candidate)
    })
    db.accounting.checkpointed = generation
    db.accounting.resident = base.account
    db.accounting.tiered = settled_tiered
    db.accounting.page_resident = resident_pages
    db.accounting.settled = db.accounting.changes
    let wants_emitted = match view emitted_out {
        Some(_) => true,
        None => false,
    }
    if wants_emitted {
        emitted_out = Some(replace(mut staged.emitted, map.new()))
    }
    let leased_step = build_leased_step(db, delta)
    let held_delta = install_tiered_holders(mut db, take delta, take staged)
    install_holder_delta(mut db, take held_delta)
    if let Some(take bases) = take tail_bases {
        pages.set_holder_bases(mut db.holders, Some(take bases))
    }
    record_leased_step(mut db, take leased_step)
    let installed = if observe {
        host.mono_ns(db.clock)
    } else {
        0
    }
    let removals_count = if observe {
        list.len(removals.packs) + 2 * (removals.before.end - removals.before.first + removals.after.end - removals.after.first)
    } else {
        0
    }
    if let Error(take problem) = failure_result_from_rep(journal.remove_cut_files(d, take removals)) {
        return Error(cut_io_error(mut db, take problem))
    }
    if observe {
        timing = Some(CutTiming(pause_ns: installed - started, removal_ns: host.mono_ns(db.clock) - installed, removal_attempts: removals_count, drain_groups: drain_groups))
    }
    Ok(Ticket(store: id, open: open_number(db), mark: Cut(generation)))
}

pub fn checkpoint(mut db: Db) -> Result[Ticket, Error] waits {
    healthy(db)?
    cut_install(mut db, NoHolderChange)
}

// S3 journal payloads are decoded exactly before their effects are applied.
pub type CallRecord: codec + shareable + send {
    key: Bytes,
    args: Bytes,
    stream: StreamKey,
    // AD1: code.revision of the entry that ran, exactly 32 bytes; None only
    // when the program was assembled without revisions. Never 32 zero bytes.
    revision: Option[Bytes],
    // The code that ran: u64 n ‖ u64 s, big-endian, then the replay identity
    // (32 bytes, or none when the launch has no identity), RUNNER-SPEC §7.
    code: Bytes
}

pub type StopKind: key = Raised | OutOfSteps(u64) | OutOfBytes | Conflict

pub type Recorded {
    record: CallRecord,
    settle: u8,
    branch: Branch,
    base: u64,
    at: u64,
    seed: u64,
    stop: Option[StopKind]
}

// AD1: the CALL revision check. A Some that is not code.revision's 32 bytes is refused
// before anything is committed.
fn call_checked(c: CallRecord) -> Result[(), Error] {
    if let Some(r) = c.revision {
        if list.len(r) != 32 {
            return Error(Missing("revision"))
        }
    }
    if !format.call_code_size(list.len(c.code)) {
        return Error(Missing("code"))
    }
    Ok(())
}

fn check_completion_record(complete: Completion, rec: Option[CallRecord]) -> Result[(), Error] {
    if let Some(c) = rec {
        if let Some(_) = complete.keyed {
            return Error(Foreign)
        }
        if !stream_record_matches(complete.stream, c.stream) {
            return Error(Foreign)
        }
        call_checked(c)?
    }
    Ok(())
}

fn journal_decode_commit(file: String, raw: Bytes) -> Result[format.JournalCommit, Error] {
    let mut at = 0u64
    let br: u32 = int.truncate(failure_result_from_rep(format.disk_number(file, raw, mut at, 4))?)
    let head = failure_result_from_rep(format.disk_number(file, raw, mut at, 8))?
    let wall = failure_result_from_rep(format.disk_number(file, raw, mut at, 8))?
    let sections = failure_result_from_rep(format.disk_number(file, raw, mut at, 1))?
    if sections == 0 || sections > 4 {
        return Error(failure_from_rep(format.disk_fault(file, at - 1, Malformed)))
    }
    let mut data: List[format.JournalOp] = list.new()
    let mut streams: List[format.JournalOp] = list.new()
    let mut keyed: List[format.KeyedEdit] = list.new()
    let mut call: Option[format.CallSection] = None
    let mut previous_tag: Option[u64] = None
    for _ in 0u64 .. sections {
        let tag = failure_result_from_rep(format.disk_number(file, raw, mut at, 1))?
        if tag > 3u64 || (if let Some(prior_tag) = previous_tag {
            tag <= prior_tag
        } else {
            false
        }) {
            return Error(failure_from_rep(format.disk_fault(file, at - 1, Malformed)))
        }
        previous_tag = Some(tag)
        match tag {
            0 => {
                data = failure_result_from_rep(format.journal_ops(file, raw, false, mut at, mut call))?
            },
            1 => {
                streams = failure_result_from_rep(format.journal_ops(file, raw, true, mut at, mut call))?
                for operation in streams {
                    if list.len(operation.key) == 0u64 {
                        return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
                    }
                }
            },
            2 => {
                let mut no_call: Option[format.CallSection] = None
                let mut control_rows = failure_result_from_rep(format.journal_ops(file, raw, true, mut at, mut no_call))?
                if list.len(control_rows) != 1u64 || list.len(control_rows[0u64].key) != 0u64 {
                    return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
                }
                if let Some(_) = no_call {
                    return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
                }
                let row = option.unwrap(list.pop(mut control_rows))
                {
                    let Some(control) = view row.value else {
                        return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
                    }
                    let _ = txn.decode_stream_control(control) ?=> |_| failure_from_rep(format.disk_fault(file, at, Malformed))
                }
                list.insert(mut streams, 0u64, take row)
            },
            _ => {
                if br != 0 {
                    return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
                }
                keyed = decode_keyed_edits(file, raw, mut at)?
            },
        }
    }
    if at != list.len(raw) {
        return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
    }
    if let Some(c) = call {
        let mut matching = 0u64
        for op in streams {
            if format.stream_record_matches(op.key, c.record.stream.caller.issuer, c.record.stream.caller.subject, c.record.stream.id.t, c.record.stream.id.n) {
                matching += 1
            }
        }
        if matching != 1 {
            return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
        }
    }
    Ok(format.JournalCommit(branch: br, version: head, at: wall, data: take data, streams: take streams, keyed: take keyed, call: take call, payload: list.len(raw)))
}

fn journal_decode(file: String, kind: u16, raw: Bytes) -> Result[format.JournalEvent, Error] {
    if kind == 0x0011 {
        return Ok(Commit(journal_decode_commit(file, raw)?))
    }
    Ok(Fork(failure_result_from_rep(format.journal_decode_fork(file, raw))?))
}

// Middle segments stop at the next HEADER's prev_end. Only the last segment
// reads beyond its durable boundary, stopping at the first physically bad frame.
fn journal_scan[S](mut input: format.JournalInput, path: String, id: StoreId, seq: u64, start: u64, boundary: Option[u64], final_item: bool, mut destination: S, consume: scoped fn(mut S, take format.JournalEvent) -> Result[(), Error]) -> Result[(u64, u64), Error] waits {
    let header = failure_result_from_rep(manifest.disk_read_header(path, failure_result_from_rep(manifest.journal_prefix(mut input, path, 0, 72))?, 2, Some(seq), optional_store_key_to_rep(Some(id))))?
    let durable_end = match boundary {
        Some(d) => d,
        None => 72u64
    }
    if durable_end < 72 || durable_end > format.journal_input_size(input) {
        return Error(failure_from_rep(format.disk_fault(path, format.journal_input_size(input), Truncated)))
    }
    let stop = if final_item {
        format.journal_input_size(input)
    } else {
        durable_end
    }
    // A catch-up resumes a segment at the end the previous round replayed.
    if start < 72 || start > durable_end {
        return Error(failure_from_rep(format.disk_fault(path, start, Truncated)))
    }
    let mut at = start
    let mut accepted = 0u64
    while at < stop {
        let received = failure_result_from_rep(manifest.journal_read_frame(mut input, path, header.context, at))
        let frame = match take received {
            Ok(take valid) => take valid,
            Error(Corrupt(take fault)) => {
                if !final_item || at < durable_end || !format.journal_torn(why_to_rep(fault.why)) {
                    return Error(Corrupt(take fault))
                }
                break
            },
            Error(take problem) => return Error(take problem),
        }
        if at < durable_end && frame.end > durable_end {
            return Error(failure_from_rep(format.disk_fault(path, at, Truncated)))
        }
        if let Some(payload) = frame.payload {
            let event = disk_allocation(scoped fn() -> Result[format.JournalEvent, Error] {
                journal_decode(path, frame.kind, payload)
            })?
            consume(mut destination, take event)?
            accepted += frame.end - at
        }
        at = frame.end
    }
    Ok((at, accepted))
}

pub fn recorded(db: Db, b: Branch, wanted: u64) -> Result[Option[Recorded], Error] waits {
    match recorded_commit(db, b, wanted)? {
        Some(commit) => Ok(recorded_call(db.store, b, commit)),
        None => Ok(None),
    }
}

fn reserve_tx(mut tx: Tx, fault: bool) -> Result[Bytes, Bytes] {
    if fault {
        let no_values: List[u64] = list.new()
        let _ = no_values[0]
    }
    Ok(types.key_word(7))
}

// L33: AM5 and MEM-24 give 4096 + 32 bytes. MEM-30 gives 8192 + 7 steps.
pub fn law_call_reserve(c: Clock) -> bool waits {
    let byte_total = 4128u64
    let step_total = 8199u64
    let plan = Plan(n_e: 4096, s_e: 8192, reply_max: 4096)
    let Some(grant) = call_reserves(plan) else {
        return false
    }
    if grant.retained != byte_total || grant.steps != step_total {
        return false
    }
    let mut db = test_db(c, 1073741824)
    let key = types.key_word(23)
    let request = request_digest(key, key)
    let stream_name = StreamKey(caller: Caller(issuer: 2u8, subject: take key), id: StreamId(t: keyed_time(db), n: 0u64))
    let no_record: Option[CallRecord] = None
    let no_pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]] = map.new()
    for fault in[false, true] {
        let p = if fault {
            1u64
        } else {
            0u64
        }
        let admission = result.unwrap(admit(mut db, stream_name, p, request))
        let Admitted(take complete) = take admission else {
            return false
        }
        let ci = next_call_info(db)
        // One step is the call of metered_draft outside its own reserve.
        let rejected = bound steps step_total {
            metered_draft(db, complete, ci, plan, grant, no_record, None, no_pins, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, fault)
            })
        }
        match take rejected {
            Ok(Error(DraftStopped(OutOfSteps(used)))) => if used != step_total {
                return false
            },
            _ => return false,
        }
        let admitted = bound steps step_total + 1u64 {
            metered_draft(db, complete, ci, plan, grant, no_record, None, no_pins, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, fault)
            })
        }
        match take admitted {
            Ok(Ok(draft)) => match draft.stage {
                Ran(_) if !fault => (),
                Over(Failed(_)) if fault => (),
                _ => return false,
            },
            _ => return false,
        }
        let short = bound bytes byte_total - 1u64 {
            serve(mut db, take complete, plan, None, fault, fn(mut tx, should_fail) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, should_fail)
            })
        }
        match take short {
            Ok(Error(Before(Full(Allocation(problem)), None))) => if problem.requested != byte_total || problem.available != byte_total - 1u64 {
                return false
            },
            _ => return false,
        }
        let retry = result.unwrap(admit(mut db, stream_name, p, request))
        let Abandoned(take completion) = take retry else {
            return false
        }
        let exact = bound bytes byte_total {
            serve(mut db, take completion, plan, None, fault, fn(mut tx, should_fail) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, should_fail)
            })
        }
        match take exact {
            Ok(Ok(Committed(receipt))) if !fault => if receipt.reply != types.key_word(7) {
                return false
            },
            Ok(Ok(Failed(take pending_run, Raised(2u32)))) if fault => match conclude(mut db, take pending_run, types.key_word(2), Resident) {
                Ok(Committed(receipt)) => if receipt.reply != types.key_word(2) {
                    return false
                },
                _ => return false,
            },
            _ => return false,
        }
    }
    let admission = result.unwrap(admit(mut db, stream_name, 2, request))
    let Admitted(take complete) = take admission else {
        return false
    }
    let small = Plan(n_e: 1024, s_e: plan.s_e, reply_max: plan.reply_max)
    // MEM-24: log 24, issued cell 8, info flag 8 and view cell 136.
    // Option[TxView] is 8 + PageTree 64 + four u64s 32 + two options 32.
    // An 800-byte reply leaves 48 of 1024. Its stored row needs round8(41 + 800) = 848.
    let kept_inside = match serve(mut db, take complete, small, None, (), fn(mut tx, unused_env) -> Result[Bytes, Bytes] {
        let mut output: Bytes = list.with_capacity(800)
        list.fill(mut output, 800, 7u8)
        Ok(take output)
    }) {
        Ok(Failed(_, OutOfBytes(problem))) => problem.requested == 848 && problem.available == 48,
        _ => false,
    }
    kept_inside && reserve_settles_pin(c, 10, plan) && reserve_settles_pin(c, 100000, plan)
}

// Build the pinned tree directly so its size does not make the setup a call.
fn reserve_pinned_data(mut db: Db, t: Table[u64, u64], rows: u64) -> () {
    let mut input: List[std.page.Row] = list.with_capacity(rows)
    let mut raw: Bytes = list.with_capacity(10)
    result.unwrap(format.le(mut raw, 0, 2))
    result.unwrap(format.le(mut raw, 1, 8))
    for i in 0u64 .. rows {
        list.push(mut input, std.page.Row(key: types.key_word(i), value: result.unwrap(failure_result_from_rep(types.copied(raw))), charge: 94))
    }
    result.unwrap(pages.edit_head_collection_with_stamp(mut db.holders, 0, scoped fn(mut tree: pages.PageTree, mut stamp: u64) -> Result[(), Error] {
        failure_result_from_rep(catalog.bulk_store_collection(mut tree, t.id, 1, input, mut stamp))
    }))
    db.accounting.resident = pages.one_page_account(pages.holder_heads(db.holders)[0].roots)
}

fn reserve_settles_pin(c: Clock, rows: u64, plan: Plan) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let mut d = result.unwrap(declare(db, Migrate))
    let declared = result.unwrap(declare_table(mut d, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let source = result.unwrap(finish(mut d, take declared))
    let _ = result.unwrap(seal(mut db, take d))
    reserve_pinned_data(mut db, source, rows)
    let base = snapshot(db)
    result.unwrap(pin(mut db, "reserve", base))
    // One replaced leaf has at most 32 rows. Sixty-four overwrites of its
    // first key leave more obsolete charges than the extra leaf and reply.
    for i in 0u64 .. 64 {
        if !typed_put(mut db, source, 0, 2u64 + i) {
            return false
        }
    }
    let label = types.key_word(47)
    let request = request_digest(label, label)
    let stream = StreamKey(caller: Caller(issuer: 2u8, subject: take label), id: StreamId(t: keyed_time(db), n: 0u64))
    let admission = result.unwrap(admit(mut db, stream, 0, request))
    let Admitted(take complete) = take admission else {
        return false
    }
    db.accounting.ceiling = db.accounting.resident
    let unsettled = db.accounting.changes
    if db.accounting.settled == unsettled {
        return false
    }
    let cut = db.accounting.checkpointed
    let Some(grant) = call_reserves(plan) else {
        return false
    }
    let ci = next_call_info(db)
    let no_record: Option[CallRecord] = None
    let no_pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]] = map.new()
    let short = bound steps grant.steps {
        metered_draft(db, complete, ci, plan, grant, no_record, None, no_pins, fn(mut tx: Tx) -> Result[Bytes, Bytes] {
            Ok(types.key_word(7))
        })
    }
    match take short {
        Ok(Error(DraftStopped(OutOfSteps(used)))) => if used != grant.steps {
            return false
        },
        _ => return false,
    }
    match serve(mut db, take complete, plan, None, (), fn(mut tx, unused_env) -> Result[Bytes, Bytes] {
        Ok(types.key_word(7))
    }) {
        Ok(Committed(receipt)) => receipt.reply == types.key_word(7) && accounts(db).exact && db.accounting.checkpointed == cut + 1,
        _ => false,
    }
}

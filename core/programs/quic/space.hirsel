/// QUIC-9: CRYPTO reassembly per encryption level, a denial-of-service bound and not a
/// capacity setting. It caps what an unauthenticated peer can make the endpoint hold
/// before the handshake completes: bytes ahead of the read position and one reassembled
/// message. Past it the handshake is CRYPTO_BUFFER_EXCEEDED.
const CRYPTO_LIMIT: u64 = 16384

fn new_space() -> Space {
    Space(receive: None, send: None, next: 0, sent: list.with_capacity(8), received: list.with_capacity(65), discard_before: 0, largest: None, ack_pending: false, ack_staged: false, crypto_in: Reassembly(at: 0, data: b"", present: list.new()), crypto_out: b"", crypto_committed: 0, flights: list.with_capacity(4), resend: list.with_capacity(4), acked: list.with_capacity(4), probes: 0, largest_at: 0, ecn_in: codec.EcnCounts(ect0: 0, ect1: 0, ce: 0), token: b"", key_phase: false, path_out: b"", hold_data: false)
}

fn install_keys(mut s: Space, mut keys: schedule.Schedule, level: packet.Space) -> bool {
    let Ok(take opener) = schedule.opener(keys, level) else {
        return false
    }
    let Ok(take receive_mask) = schedule.header_mask(keys, level, false) else {
        return false
    }
    let Ok(take send_mask) = schedule.header_mask(keys, level, true) else {
        return false
    }
    let Ok(take sealer) = schedule.sealer(mut keys, level, 0, s.next) else {
        return false
    }
    s.receive = Some(ReceiveKeys(opener: take opener, mask: take receive_mask))
    s.send = Some(SendKeys(sealer: take sealer, mask: take send_mask))
    true
}

fn install_handshake(mut s: Space, mut h: handshake.Handshake) -> bool {
    let Ok(take opener) = handshake.handshake_opener(h) else {
        return false
    }
    let Ok(take receive_mask) = handshake.handshake_mask(h, false) else {
        return false
    }
    let Ok(take send_mask) = handshake.handshake_mask(h, true) else {
        return false
    }
    let Ok(take sealer) = handshake.handshake_sealer(mut h, 0, s.next) else {
        return false
    }
    s.receive = Some(ReceiveKeys(opener: take opener, mask: take receive_mask))
    s.send = Some(SendKeys(sealer: take sealer, mask: take send_mask))
    true
}

fn discard(mut s: Space) {
    s.receive = None
    s.send = None
    s.next = 0
    list.clear(mut s.sent)
    list.clear(mut s.received)
    s.discard_before = 0
    s.largest = None
    s.ack_pending = false
    s.ack_staged = false
    s.crypto_in = Reassembly(at: 0, data: b"", present: list.new())
    s.crypto_out = b""
    s.crypto_committed = 0
    list.clear(mut s.flights)
    list.clear(mut s.resend)
    list.clear(mut s.acked)
    s.probes = 0
    s.largest_at = 0
    s.ecn_in = codec.EcnCounts(ect0: 0, ect1: 0, ce: 0)
    s.token = b""
    s.key_phase = false
    s.path_out = b""
    s.hold_data = false
}

fn covers(ranges: List[codec.AckRange], low: u64, high: u64) -> bool {
    for r in ranges {
        if low >= r.smallest && high <= r.largest {
            return true
        }
    }
    false
}

/// Sent ranges are in ascending order. Abandoned packet numbers stay absent.
fn record_sent(mut s: Space, number: u64) {
    let n = list.len(s.sent)
    if n != 0 && s.sent[n - 1].largest + 1 == number {
        s.sent[n - 1].largest = number
    } else {
        list.push(mut s.sent, codec.AckRange(smallest: number, largest: number))
    }
}

fn valid_ack(s: Space, ranges: List[codec.AckRange]) -> bool {
    for range in ranges {
        if !covers(s.sent, range.smallest, range.largest) {
            return false
        }
    }
    true
}

/// RFC 9000 §13.2.4 permits forgetting old ranges. Never process a packet again
/// after its range has been forgotten. The codec writes ranges in descending order.
fn record_received(mut s: Space, number: u64) {
    let n = list.len(s.received)
    let mut first = 0u64
    while first < n && s.received[first].smallest > number + 1 {
        first += 1
    }
    let mut low = number
    let mut high = number
    let mut end = first
    while end < n && s.received[end].largest + 1 >= low {
        low = order.min(low, s.received[end].smallest)
        high = order.max(high, s.received[end].largest)
        end += 1
    }
    let merged = codec.AckRange(smallest: low, largest: high)
    let removed = end - first
    if removed == 1 {
        s.received[first] = merged
    } else if removed == 0 {
        list.push(mut s.received, merged)
        let mut k = n
        while k > first {
            s.received[k] = s.received[k - 1]
            k -= 1
        }
        s.received[first] = merged
    } else {
        s.received[first] = merged
        let tail = n - end
        for k in 0u64 .. tail {
            s.received[first + 1 + k] = s.received[end + k]
        }
        list.truncate(mut s.received, first + 1 + tail)
    }
    if list.len(s.received) > 64 {
        s.discard_before = s.received[64].largest + 1
        list.truncate(mut s.received, 64)
    }
}

fn receive_crypto(mut r: Reassembly, offset: u64, data: Bytes) -> bool {
    let len = list.len(data)
    let end = offset + len
    if end <= r.at {
        return true
    }
    if end - r.at > CRYPTO_LIMIT {
        return false
    }
    if list.capacity(r.data) == 0 {
        r.data = list.with_capacity(CRYPTO_LIMIT)
        r.present = list.with_capacity(CRYPTO_LIMIT)
        list.fill(mut r.data, CRYPTO_LIMIT, 0)
        list.fill(mut r.present, CRYPTO_LIMIT, false)
    }
    for p in order.max(r.at, offset) .. end {
        let i = p % CRYPTO_LIMIT
        if !r.present[i] {
            r.data[i] = data[p - offset]
            r.present[i] = true
        }
    }
    true
}

fn tls_message(mut r: Reassembly) -> Result[Option[Bytes], u64] {
    if list.len(r.present) == 0 {
        return Ok(None)
    }
    let mut len = 0u64
    for i in 1u64 .. 4 {
        let p = (r.at + i) % CRYPTO_LIMIT
        if !r.present[p] {
            return Ok(None)
        }
        len = len * 256 + int.widen(r.data[p])
    }
    len += 4
    if len > CRYPTO_LIMIT {
        return Error(0x0d)
    }
    for i in 0u64 .. len {
        if !r.present[(r.at + i) % CRYPTO_LIMIT] {
            return Ok(None)
        }
    }
    let mut wire: Bytes = list.with_capacity(len)
    for _ in 0u64 .. len {
        let p = r.at % CRYPTO_LIMIT
        list.push(mut wire, r.data[p])
        r.present[p] = false
        r.at += 1
    }
    Ok(Some(take wire))
}

/// Add [at, end) to ascending, disjoint ranges, merging what it touches, in place.
fn add_range(mut l: List[Range], at: u64, end: u64) {
    if at >= end {
        return
    }
    let n = list.len(l)
    let mut first = 0u64
    while first < n && l[first].end < at {
        first += 1
    }
    let mut low = at
    let mut high = end
    let mut last = first
    while last < n && l[last].at <= high {
        low = order.min(low, l[last].at)
        high = order.max(high, l[last].end)
        last += 1
    }
    let merged = Range(at: low, end: high)
    let removed = last - first
    if removed == 1 {
        l[first] = merged
    } else if removed == 0 {
        list.push(mut l, merged)
        let mut k = n
        while k > first {
            l[k] = l[k - 1]
            k -= 1
        }
        l[first] = merged
    } else {
        l[first] = merged
        let tail = n - last
        for k in 0u64 .. tail {
            l[first + 1 + k] = l[last + k]
        }
        list.truncate(mut l, first + 1 + tail)
    }
}

/// Remove [at, end) from ascending, disjoint ranges, in place.
fn remove_range(mut l: List[Range], at: u64, end: u64) {
    if at >= end || list.len(l) == 0 {
        return
    }
    let n = list.len(l)
    for i in 0u64 .. n {
        let r = l[i]
        if r.at < at && r.end > end {
            // [at, end) sits strictly inside one disjoint range: split it in place.
            list.push(mut l, Range(at: end, end: r.end))
            let mut k = n
            while k > i + 1 {
                l[k] = l[k - 1]
                k -= 1
            }
            l[i] = Range(at: r.at, end: at)
            l[i + 1] = Range(at: end, end: r.end)
            return
        }
    }
    let mut dst = 0u64
    for i in 0u64 .. n {
        let r = l[i]
        if r.end <= at || r.at >= end {
            l[dst] = r
            dst += 1
        } else if r.at < at {
            l[dst] = Range(at: r.at, end: at)
            dst += 1
        } else if r.end > end {
            l[dst] = Range(at: end, end: r.end)
            dst += 1
        }
    }
    list.truncate(mut l, dst)
}

fn contains(numbers: List[u64], n: u64) -> bool {
    for m in numbers {
        if m == n {
            return true
        }
    }
    false
}

/// Owe [at, end) again, less whatever an acknowledged packet already carried.
fn owe(mut s: Space, at: u64, end: u64) {
    add_range(mut s.resend, at, end)
    for r in s.acked {
        remove_range(mut s.resend, r.at, r.end)
    }
}

/// What settling a space's flights found about HANDSHAKE_DONE.
type DoneSettled {
    lost: bool,
    acked: bool
}

/// Settle the flights an ACK or a loss names: acknowledged data is owed no more, lost
/// data is owed again unless a later copy was already acknowledged.
fn settle_space(mut s: Space, acked: List[u64], lost: List[u64]) -> DoneSettled {
    let mut done = DoneSettled(lost: false, acked: false)
    let n = list.len(s.flights)
    if n == 0 {
        return done
    }
    for i in 0u64 .. n {
        let f = s.flights[i]
        if contains(acked, f.number) {
            remove_range(mut s.resend, f.crypto_at, f.crypto_end)
            add_range(mut s.acked, f.crypto_at, f.crypto_end)
            done.acked = done.acked || f.done
        }
    }
    let mut dst = 0u64
    for i in 0u64 .. n {
        let f = s.flights[i]
        if contains(acked, f.number) {
            continue
        }
        if contains(lost, f.number) {
            owe(mut s, f.crypto_at, f.crypto_end)
            done.lost = done.lost || f.done
        } else {
            s.flights[dst] = f
            dst += 1
        }
    }
    list.truncate(mut s.flights, dst)
    done
}

/// A probe timeout (RFC 9002 §6.2.4): owe a probe and the data still in flight, which
/// stays in flight until it is acknowledged or declared lost. True when a packet in
/// flight carried HANDSHAKE_DONE.
fn probe_space(mut s: Space) -> bool {
    let mut done = false
    for i in 0u64 .. list.len(s.flights) {
        let f = s.flights[i]
        owe(mut s, f.crypto_at, f.crypto_end)
        done = done || f.done
    }
    s.probes = order.min(s.probes + 1, 2)
    done
}

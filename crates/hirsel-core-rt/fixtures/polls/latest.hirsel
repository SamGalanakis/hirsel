type Input:send { h:Latest[u64],go:Receiver[u64],done:Sender[u64] }
fn number(x:u64)->u64 { x }
// Each read sees a root the parent published, never an older one than before.
fn reader(take s:Input)->u64 waits {
 let Input(h:h,go:go,done:done)=take s
 let mut last:u64=0
 let mut ok:u64=1
 while let Ok(_)=channel.receive(go) {
  let seen=number(latest.read(h))
  if seen<last || seen>4 { ok=0 }
  last=seen
 }
 result.unwrap(channel.send(done,last))
 ok
}
fn start(tasks:Tasks,h:Latest[u64],done:Sender[u64])->(Task[u64],Sender[u64]) {
 let (go,go_rx):(Sender[u64],Receiver[u64])=channel.new(1)
 let input=Input(h:latest.handle(h),go:take go_rx,done:channel.sender(done))
 (task.spawn(tasks,bytes 4096,take input,reader),take go)
}
// Two readers race the publisher; the schedule decides which root each read sees.
pub fn main(tasks:Tasks)->Result[(),Exit] waits {
 let h=latest.new(arc.new(1u64))
 let (done,done_rx):(Sender[u64],Receiver[u64])=channel.new(2)
 let (a,b)={
  let (a,go_a)=start(tasks,h,done)
  let (b,go_b)=start(tasks,h,done)
  for v in 2u64 .. 5 {
   latest.publish(h,arc.new(v))
   result.unwrap(channel.send(go_a,v))
   result.unwrap(channel.send(go_b,v))
  }
  (a,b)
 }
 let last=result.unwrap(channel.receive(done_rx)) + result.unwrap(channel.receive(done_rx))
 let ok=result.unwrap(task.join(take a)) + result.unwrap(task.join(take b))
 if ok==2u64 && last==8u64 && number(latest.read(h))==4u64 { Ok(()) } else { Error(Exit(status:1u8)) }
}

    if law_index_refusal(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn is_foreign[T](take r: Result[T, Error]) -> bool {
    match take r {
        Error(Foreign) => true,
        _ => false
    }
}

fn typed_foreign_at(c: Clock, other_id: StoreId) -> bool waits {
    let mut a = test_db(c, 1073741824)
    let mut b = memory_at(c, other_id, defaults())
    result.unwrap(create_table(mut a, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut a, "rows", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(create_index(mut a, t, "i", code.describe(bucket), std.codec.key_u64()))
    let ix = result.unwrap(index(a, mut t, "i", code.describe(bucket), std.codec.key_u64()))
    let sh = shape(t)
    let other = snapshot(b)
    if !is_foreign(get(other, sh, 1)) || !is_foreign(scan(other, sh, Unbounded, Unbounded)) || !is_foreign(find(other, ix, Unbounded, Unbounded)) {
        return false
    }
    if !is_foreign(create_index(mut b, t, "i", code.describe(bucket), std.codec.key_u64())) {
        return false
    }
    if !is_foreign(index(b, mut t, "i", code.describe(bucket), std.codec.key_u64())) {
        return false
    }
    let ticket = Ticket(store: a.store, open: 0, mark: Journal(0))
    if !is_foreign(durable(mut b, ticket)) {
        return false
    }
    let stale_open = Ticket(store: b.store, open: 9, mark: Journal(0))
    if !is_foreign(durable(mut b, stale_open)) {
        return false
    }
    let out = run(mut b, fn(mut tx: Tx) -> Result[(), bool] {
        let ok = is_foreign(fetch(tx, shape(t), 1)) && is_foreign(put(mut tx, t, 1, 2)) && is_foreign(delete(mut tx, t, 1)) && is_foreign(range(tx, shape(t), Unbounded, Unbounded))
        let lookup_foreign = match lookup(tx, ix, Unbounded, Unbounded) {
            Error(Foreign) => true,
            _ => false
        }
        Error(ok && lookup_foreign)
    })
    match take out {
        Ok(Aborted(Undone(value: true, ticket: None))) => b.head == 0 && b.resident == 0,
        _ => false
    }
}

pub fn law_typed_foreign(c: Clock) -> bool waits {
    typed_foreign_at(c, StoreId(hi: 9, lo: 2)) && typed_foreign_at(c, StoreId(hi: 1, lo: 9)) && typed_foreign_at(c, StoreId(hi: 9, lo: 9))
}


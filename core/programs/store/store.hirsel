pub opaque type Readers[V]: shareable + send {
    codec: std.codec.Codec[V],
    current: u16,
    older: List[Option[std.codec.Reader[V]]]
}

type IndexOf[V]: send {
    id: u32,
    extract: own[send] fn(V) -> Result[Bytes, Capacity]
}

pub opaque type Table[K, V]: send {
    store: StoreId,
    id: u32,
    epoch: u64,
    complete: bool,
    catalog_key: Arc[Bytes],
    key: std.codec.Key[K],
    readers: Arc[Readers[V]],
    indexes: List[IndexOf[V]]
}

pub opaque type Shape[K, V]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    key: std.codec.Key[K],
    readers: Arc[Readers[V]]
}

pub opaque type Index[J, K, V]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    table: u32,
    key: std.codec.Key[J],
    primary: std.codec.Key[K],
    readers: Arc[Readers[V]]
}

pub opaque type Rows[K, V]: send {
    cursor: ByteRows,
    table: u32,
    key: std.codec.Key[K],
    readers: Arc[Readers[V]],
    data: std.omap.OMap[Bytes, Arc[Bytes]],
    skip: Option[own[send] fn(Bytes, mut u64) -> Result[(), std.codec.Stop]]
}

pub fn shape[K, V](t: Table[K, V]) -> Shape[K, V] {
    Shape(store: t.store, id: t.id, catalog_key: arc.share(t.catalog_key), key: t.key, readers: arc.share(t.readers))
}

fn decoded[T](take r: Result[Result[T, std.codec.DecodeError], Capacity]) -> Result[T, Error] {
    match take r {
        Error(c) => Error(Full(c)),
        Ok(Error(e)) => Error(Decode(e)),
        Ok(Ok(take x)) => Ok(take x)
    }
}

fn read_le(raw: Bytes, at: u64, width: u64) -> u64 {
    let mut n: u64 = 0
    for i in 0u64 .. width {
        let x: u64 = int.widen(raw[at + i]);
        n = n | (x << (i * 8))
    }
    n
}

fn row_value[V](r: Readers[V], id: u32, raw: Bytes) -> Result[V, Error] {
    if list.len(raw) < 2 {
        return Error(Decode(Truncated(0)))
    }
    let number: u16 = int.truncate(read_le(raw, 0, 2))
    if number == r.current {
        return decoded(std.codec.decode_at(r.codec, raw, 2))
    }
    let n: u64 = int.widen(number)
    if n >= list.len(r.older) {
        return Error(Stale(id))
    }
    match r.older[n] {
        Some(old) => decoded(std.codec.read_at(old, raw, 2)),
        None => Error(Stale(id))
    }
}

fn encode_key[K](k: std.codec.Key[K], value: K) -> Result[Bytes, Error] {
    let mut raw: Bytes = list.new()
    capacity(std.codec.encode_key(k, value, mut raw))?
    Ok(take raw)
}

fn typed_bound[K](k: std.codec.Key[K], limit: Bound[K]) -> Result[Bound[Bytes], Error] {
    match limit {
        Unbounded => Ok(Unbounded),
        Included(x) => Ok(Included(encode_key(k, x)?)),
        Excluded(x) => Ok(Excluded(encode_key(k, x)?))
    }
}

fn writable[K, V](tx: Tx, t: Table[K, V]) -> Result[(), Error] {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    if !t.complete {
        return Error(Stale(t.id))
    }
    match std.omap.get(tx.roots.catalog, t.catalog_key) {
        Some(raw) => if read_le(raw, 1, 4) == int.widen(t.id) && read_le(raw, 9, 8) == t.epoch {
            Ok(())
        } else {
            Error(Stale(t.id))
        },
        None => Error(Stale(t.id))
    }
}

pub fn fetch[K, V](tx: Tx, t: Shape[K, V], k: K) -> Result[Option[V], Error] {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    readable(tx.roots, t.catalog_key, t.id)?
    let p = physical(t.id, encode_key(t.key, k)?)?
    record(tx, Point(copied(p)?))?
    match std.omap.get(tx.roots.data, p) {
        Some(raw) => Ok(Some(row_value(t.readers, t.id, raw)?)),
        None => Ok(None)
    }
}

fn index_key[V](ix: IndexOf[V], value: V, primary: Bytes) -> Result[Bytes, Error] {
    let mut raw = capacity((ix.extract)(value))?
    capacity(list.append(mut raw, primary))?
    Ok(take raw)
}

fn put_impl[K, V](mut tx: Tx, t: Table[K, V], k: K, v: V) -> Result[(), Error] {
    writable(tx, t)?
    let key = encode_key(t.key, k)?
    let p = physical(t.id, key)?
    let previous: Option[V] = if list.len(t.indexes) == 0 {
        None
    } else {
        match std.omap.get(tx.roots.data, p) {
            Some(old) => Some(row_value(t.readers, t.id, old)?),
            None => None
        }
    }
    for ix in t.indexes {
        let new_key = index_key(ix, v, key)?
        let old_key = match previous {
            Some(value) => Some(index_key(ix, value, key)?),
            None => None
        }
        let unchanged = match old_key {
            Some(old) => old == new_key,
            None => false
        }
        if !unchanged {
            if let Some(take old) = take old_key {
                let _ = delete_bytes(mut tx, ix.id, old)?
            }
            let empty: Bytes = list.new()
            put_bytes(mut tx, ix.id, new_key, empty)?
        }
    }
    let mut raw: Bytes = list.new()
    capacity(le(mut raw, int.widen(t.readers.current), 2))?
    capacity(std.codec.encode(t.readers.codec, v, mut raw))?
    put_physical(mut tx, take p, take raw)
}

fn delete_impl[K, V](mut tx: Tx, t: Table[K, V], k: K) -> Result[bool, Error] {
    writable(tx, t)?
    let key = encode_key(t.key, k)?
    let p = physical(t.id, key)?
    let old = match std.omap.get(tx.roots.data, p) {
        Some(raw) => row_value(t.readers, t.id, raw)?,
        None => return Ok(false)
    }
    for ix in t.indexes {
        let _ = delete_bytes(mut tx, ix.id, index_key(ix, old, key)?)?
    }
    delete_bytes(mut tx, t.id, key)
}

pub fn range[K, V](tx: Tx, t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Rows[K, V], Error] {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    readable(tx.roots, t.catalog_key, t.id)?
    let cursor = range_bytes(tx, t.id, typed_bound(t.key, lo)?, typed_bound(t.key, hi)?)?
    Ok(Rows(cursor: take cursor, table: t.id, key: t.key, readers: arc.share(t.readers), data: std.omap.snapshot(tx.roots.data), skip: None))
}

pub fn get[K, V](s: Snapshot, t: Shape[K, V], k: K) -> Result[Option[V], Error] {
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.id)?
    let p = physical(t.id, encode_key(t.key, k)?)?
    match std.omap.get(s.roots.data, p) {
        Some(raw) => Ok(Some(row_value(t.readers, t.id, raw)?)),
        None => Ok(None)
    }
}

pub fn scan[K, V](s: Snapshot, t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Rows[K, V], Error] {
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.id)?
    let cursor = scan_bytes(s, t.id, typed_bound(t.key, lo)?, typed_bound(t.key, hi)?)?
    Ok(Rows(cursor: take cursor, table: t.id, key: t.key, readers: arc.share(t.readers), data: std.omap.snapshot(s.roots.data), skip: None))
}

fn indexed_rows[J, K, V](data: std.omap.OMap[Bytes, Arc[Bytes]], ix: Index[J, K, V], take cursor: ByteRows) -> Result[Rows[K, V], Error] {
    let k = ix.key
    let start = 4u64
    let made: Result[own[send] fn(Bytes, mut u64) -> Result[(), std.codec.Stop], (Capacity, (u64, std.codec.Key[J]))] = fn(raw: Bytes, mut at: u64) -> Result[(), std.codec.Stop] {
        at = start
        let _ = std.codec.take_key_with(raw, mut at, k)?
        Ok(())
    }
    let skip = match take made {
        Ok(take f) => take f,
        Error((c, _)) => return Error(Full(c))
    }
    Ok(Rows(cursor: take cursor, table: ix.table, key: ix.primary, readers: arc.share(ix.readers), data: std.omap.snapshot(data), skip: Some(take skip)))
}

fn prefix_after(raw: Bytes) -> Result[Bytes, Error] {
    let mut out = copied(raw)?
    let mut i = list.len(out)
    while i > 0 {
        i -= 1
        if out[i] != 255 {
            let byte = out[i] + 1
            let _ = list.set(mut out, i, byte)
            while list.len(out) > i + 1 {
                let _ = list.pop(mut out)
            }
            return Ok(take out)
        }
    }
    Ok(take out)
}

fn index_bound[J](ix: u32, key: std.codec.Key[J], limit: Bound[J], high: bool) -> Result[Bytes, Error] {
    match limit {
        Unbounded => prefix(if high {
            ix + 1
        } else {
            ix
        }),
        Included(x) => {
            let p = physical(ix, encode_key(key, x)?)?;
            if high {
                prefix_after(p)
            } else {
                Ok(take p)
            }
        },
        Excluded(x) => {
            let p = physical(ix, encode_key(key, x)?)?;
            if high {
                Ok(take p)
            } else {
                prefix_after(p)
            }
        }
    }
}

pub fn lookup[J, K, V](tx: Tx, ix: Index[J, K, V], lo: Bound[J], hi: Bound[J]) -> Result[IndexRows[K, V], Error] in tx {
    if !same(tx.store, ix.store) {
        return Error(Foreign)
    }
    readable(tx.roots, ix.catalog_key, ix.id)?
    let low = index_bound(ix.id, ix.key, lo, false)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    record(tx, Span(copied(low)?, copied(high)?))?
    let cursor = byte_cursor(tx.roots.data, low, high)?
    let rows = indexed_rows(tx.roots.data, ix, take cursor)?
    Ok(IndexRows(rows: take rows, reads: tx.reads))
}

pub fn find[J, K, V](s: Snapshot, ix: Index[J, K, V], lo: Bound[J], hi: Bound[J]) -> Result[Rows[K, V], Error] {
    if !same(s.store, ix.store) {
        return Error(Foreign)
    }
    readable(s.roots, ix.catalog_key, ix.id)?
    let cursor = byte_cursor(s.roots.data, index_bound(ix.id, ix.key, lo, false)?, index_bound(ix.id, ix.key, hi, true)?)?
    indexed_rows(s.roots.data, ix, take cursor)
}

fn advance_rows[K, V](mut r: Rows[K, V], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[(K, V)], Error] {
    let found = next_bytes(mut r.cursor)?
    let pair = match take found {
        Some(take pair) => take pair,
        None => return Ok(None)
    }
    let mut at: u64 = 4
    if let Some(skip) = r.skip {
        match (skip)(pair.0, mut at) {
            Ok(()) => {},
            Error(Bad(e)) => return Error(Decode(e)),
            Error(Full(c)) => return Error(Full(c))
        }
    }
    let key = list.slice(pair.0, at, list.len(pair.0))
    let k = decoded(std.codec.decode_key(r.key, key))?
    if let Some(_) = r.skip {
        let physical_key = physical(r.table, key)?
        match std.omap.get(r.data, physical_key) {
            Some(raw) => {
                let value = row_value(r.readers, r.table, raw)?
                seen(physical_key)?
                Ok(Some((take k, take value)))
            },
            None => Error(Stale(r.table))
        }
    } else {
        let value = row_value(r.readers, r.table, pair.1)?
        seen(pair.0)?
        Ok(Some((take k, take value)))
    }
}

type ValueSchema: shareable + send {
    number: u16,
    fingerprint: u64,
    schema: Bytes
}

type Catalog {
    kind: u8,
    id: u32,
    owner: u32,
    epoch: u64,
    key: Bytes,
    schemas: List[ValueSchema],
    next: u16,
    by: Bytes,
    revision: Bytes
}

fn malformed(at: u64) -> Error {
    Corrupt(Fault(file: "catalog", offset: at, why: Malformed))
}

fn take_le(raw: Bytes, mut at: u64, width: u64) -> Result[u64, Error] {
    if at > list.len(raw) || width > list.len(raw) - at {
        return Error(malformed(at))
    }
    let n = read_le(raw, at, width)
    at += width
    Ok(n)
}

fn take_blob(raw: Bytes, mut at: u64) -> Result[Bytes, Error] {
    let n = take_le(raw, mut at, 4)?
    if n > list.len(raw) - at {
        return Error(malformed(at))
    }
    let data = list.slice(raw, at, at + n)
    let out = copied(data)?
    at += n
    Ok(take out)
}

fn decode_catalog(raw: Bytes) -> Result[Catalog, Error] {
    let mut at: u64 = 0
    let kind: u8 = int.truncate(take_le(raw, mut at, 1)?)
    let id: u32 = int.truncate(take_le(raw, mut at, 4)?)
    let owner: u32 = int.truncate(take_le(raw, mut at, 4)?)
    let epoch = take_le(raw, mut at, 8)?
    if (kind != 1 && kind != 2) || id == 0 || epoch == 0 || (kind == 2 && owner == 0) {
        return Error(malformed(0))
    }
    let key = take_blob(raw, mut at)?
    let count = take_le(raw, mut at, 2)?
    let mut schemas: List[ValueSchema] = list.new()
    for _ in 0u64 .. count {
        let number: u16 = int.truncate(take_le(raw, mut at, 2)?)
        let fingerprint = take_le(raw, mut at, 8)?
        let schema = take_blob(raw, mut at)?
        capacity(result.capacity_only(list.push(mut schemas, ValueSchema(number: number, fingerprint: fingerprint, schema: take schema))))?
    }
    let next_number: u16 = int.truncate(take_le(raw, mut at, 2)?)
    let by = take_blob(raw, mut at)?
    let revision = take_blob(raw, mut at)?
    if at != list.len(raw) {
        return Error(malformed(at))
    }
    Ok(Catalog(kind: kind, id: id, owner: owner, epoch: epoch, key: take key, schemas: take schemas, next: next_number, by: take by, revision: take revision))
}

fn encode_catalog(c: Catalog) -> Result[Bytes, Error] {
    let mut raw: Bytes = list.new()
    capacity(le(mut raw, int.widen(c.kind), 1))?
    capacity(le(mut raw, int.widen(c.id), 4))?
    capacity(le(mut raw, int.widen(c.owner), 4))?
    capacity(le(mut raw, c.epoch, 8))?
    capacity(blob(mut raw, c.key))?
    capacity(le(mut raw, list.len(c.schemas), 2))?
    for schema in c.schemas {
        capacity(le(mut raw, int.widen(schema.number), 2))?
        capacity(le(mut raw, schema.fingerprint, 8))?
        capacity(blob(mut raw, schema.schema))?
    }
    capacity(le(mut raw, int.widen(c.next), 2))?
    capacity(blob(mut raw, c.by))?
    capacity(blob(mut raw, c.revision))?
    if list.len(raw) > 1048576 {
        return Error(Limit(Value))
    }
    Ok(take raw)
}

fn named(s: String) -> Result[String, Error] {
    capacity(string.from(s))
}

fn table_key(name: String) -> Result[Bytes, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    let mut k: Bytes = list.new()
    capacity(result.capacity_only(list.push(mut k, 1u8)))?
    capacity(list.append(mut k, string.as_bytes(name)))?
    Ok(take k)
}

fn index_prefix(id: u32) -> Result[Bytes, Error] {
    let mut k: Bytes = list.new()
    capacity(result.capacity_only(list.push(mut k, 2u8)))?
    capacity(list.append(mut k, prefix(id)?))?
    Ok(take k)
}

fn catalog_index_key(id: u32, name: String) -> Result[Bytes, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    let mut k = index_prefix(id)?
    capacity(list.append(mut k, string.as_bytes(name)))?
    Ok(take k)
}

fn catalog_entry(db: Db, k: Bytes) -> Result[Catalog, Error] {
    healthy(db)?
    match std.omap.get(db.roots.catalog, k) {
        Some(raw) => decode_catalog(raw),
        None => Error(Stale(0))
    }
}

fn catalog_put(mut db: Db, roots: Roots, k: Bytes, v: Bytes) -> Result[Roots, Error] {
    let shared_value = capacity(result.capacity_only(arc.new(copied(v)?)))?
    let inserted = std.omap.insert(mut db.next_node, roots.catalog, copied(k)?, take shared_value)
    let catalog = match take inserted {
        Ok((take tree, _)) => take tree,
        Error((c, _)) => return Error(Full(c))
    }
    Ok(Roots(data: std.omap.snapshot(roots.data), streams: std.omap.snapshot(roots.streams), catalog: take catalog))
}

fn schema_publish(mut db: Db, take roots: Roots, live: u64) -> Result[Ticket, Error] waits {
    if live > db.ceiling {
        return Error(Full(Capacity(requested: live, available: db.ceiling)))
    }
    let next_head = db.head + 1
    let ticket = if list.len(db.disk) != 0 {
        Some(disk_request_cut(mut db, roots, next_head, live)?)
    } else {
        None
    }
    db.roots = take roots
    db.resident = live
    db.head += 1
    publish(db)
    match ticket {
        Some(t) => Ok(t),
        None => Ok(Ticket(store: db.store, open: open_number(db), mark: Cut(db.head)))
    }
}

pub fn create_table[K, V](mut db: Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Ticket, Error] waits {
    healthy(db)?
    let k = table_key(name)?
    if let Some(_) = std.omap.get(db.roots.catalog, k) {
        return Error(Exists(named(name)?))
    }
    let schema = capacity(std.codec.schema(value))?
    let mut schemas: List[ValueSchema] = list.new()
    let fp = std.codec.fingerprint_of(schema)
    capacity(result.capacity_only(list.push(mut schemas, ValueSchema(number: 0, fingerprint: fp, schema: take schema))))?
    let c = Catalog(kind: 1, id: db.next_table, owner: 0, epoch: 1, key: capacity(std.codec.key_schema(key))?, schemas: take schemas, next: 1, by: list.new(), revision: list.new())
    let raw = encode_catalog(c)?
    let live = catalog_recharge(db.resident, db.roots, k, raw, db.retained)
    let base = share_roots(db.roots)
    let roots = catalog_put(mut db, base, k, raw)?
    db.next_table += 1
    schema_publish(mut db, take roots, live)
}

fn readers[V](value: std.codec.Codec[V], c: Catalog, current: u16) -> Result[Arc[Readers[V]], Error] {
    let mut older: List[Option[std.codec.Reader[V]]] = capacity(list.with_capacity(int.widen(c.next)))?
    for _ in 0u64 .. int.widen(c.next) {
        capacity(result.capacity_only(list.push(mut older, None)))?
    }
    for old in c.schemas {
        if old.number != current {
            let resolution = std.codec.resolve(value, old.schema)
            let resolved = match take resolution {
                Error(f) => return Error(Full(f)),
                Ok(Error(Schema(i))) => return Error(Schema(i)),
                Ok(Error(e)) => return Error(Decode(e)),
                Ok(Ok(take reader)) => take reader
            }
            let _ = list.set(mut older, int.widen(old.number), Some(take resolved))
        }
    }
    capacity(result.capacity_only(arc.new(Readers(codec: value, current: current, older: take older))))
}

fn index_catalog(db: Db, id: u32) -> Result[List[Catalog], Error] {
    let low = index_prefix(id)?
    let high = index_prefix(id + 1)?
    let mut cursor = capacity(result.capacity_only(std.omap.range(db.roots.catalog, Included(copied(low)?), Excluded(copied(high)?))))?
    let mut out: List[Catalog] = list.new()
    while let Some((_, raw)) = capacity(std.omap.next(mut cursor))? {
        capacity(result.capacity_only(list.push(mut out, decode_catalog(raw)?)))?
    }
    Ok(take out)
}

pub fn table[K, V](mut db: Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] waits {
    healthy(db)?
    let k = table_key(name)?
    let mut c = match std.omap.get(db.roots.catalog, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(named(name)?))
    }
    let key_schema = capacity(std.codec.key_schema(key))?
    if key_schema != c.key {
        return Error(Schema(0))
    }
    let schema = capacity(std.codec.schema(value))?
    let fp = std.codec.fingerprint_of(schema)
    let mut number = c.next
    let mut found = false
    for old in c.schemas {
        if old.fingerprint == fp && old.schema == schema {
            number = old.number;
            found = true
        }
    }
    // Resolve before publishing a schema addition: Schema is always without effect.
    let resolved = readers(value, c, number)?
    if !found {
        capacity(result.capacity_only(list.push(mut c.schemas, ValueSchema(number: number, fingerprint: fp, schema: take schema))))?
        c.next += 1
        let raw = encode_catalog(c)?
        let live = catalog_recharge(db.resident, db.roots, k, raw, db.retained)
        let base = share_roots(db.roots)
        let roots = catalog_put(mut db, base, k, raw)?
        let _ = schema_publish(mut db, take roots, live)?
    }
    let catalog = index_catalog(db, c.id)?
    Ok(Table(store: db.store, id: c.id, epoch: c.epoch, complete: list.len(catalog) == 0, catalog_key: catalog_key_handle(take k)?, key: key, readers: take resolved, indexes: list.new()))
}

pub fn create_index[J, K, V](mut db: Db, t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[Ticket, Error] waits {
    healthy(db)?
    if !same(db.store, t.store) {
        return Error(Foreign)
    }
    let k = catalog_index_key(t.id, name)?
    if let Some(_) = std.omap.get(db.roots.catalog, k) {
        return Error(Exists(named(name)?))
    }
    let mut meta = catalog_entry(db, t.catalog_key)?
    if meta.id != t.id {
        return Error(Stale(t.id))
    }
    let id = db.next_table
    let c = Catalog(kind: 2, id: id, owner: t.id, epoch: 1, key: capacity(std.codec.key_schema(key))?, schemas: list.new(), next: 0, by: copied(code.identity(by))?, revision: list.new())
    let raw = encode_catalog(c)?
    let mut roots = share_roots(db.roots)
    let mut live = catalog_recharge(db.resident, db.roots, k, raw, db.retained)
    let mut rows = scan_bytes(snapshot(db), t.id, Unbounded, Unbounded)?
    while let Some((primary, encoded)) = next_bytes(mut rows)? {
        let value = row_value(t.readers, t.id, encoded)?
        let j = capacity((code.callable(by))(value))?
        let mut encoded_index = encode_key(key, j)?
        let user_key = list.slice(primary, 4, list.len(primary))
        capacity(list.append(mut encoded_index, user_key))?
        let physical_key = physical(id, encoded_index)?
        if list.len(physical_key) > 4096 {
            return Error(Limit(Key))
        }
        let empty: Bytes = list.new()
        live = int.saturating_add(live, entry(physical_key, empty))
        let shared_empty = capacity(result.capacity_only(arc.new(take empty)))?
        let (take data, _) = capacity(result.capacity_only(std.omap.insert(mut db.next_node, roots.data, take physical_key, take shared_empty)))?
        roots.data = take data
    }
    roots = catalog_put(mut db, roots, k, raw)?
    meta.epoch += 1
    let changed = encode_catalog(meta)?
    live = catalog_recharge(live, db.roots, t.catalog_key, changed, db.retained)
    roots = catalog_put(mut db, roots, t.catalog_key, changed)?
    db.next_table += 1
    schema_publish(mut db, take roots, live)
}

pub fn index[J, K, V](db: Db, mut t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[Index[J, K, V], Error] {
    healthy(db)?
    if !same(db.store, t.store) {
        return Error(Foreign)
    }
    let k = catalog_index_key(t.id, name)?
    let c = match std.omap.get(db.roots.catalog, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(named(name)?))
    }
    if c.key != capacity(std.codec.key_schema(key))? || c.by != code.identity(by) || c.owner != t.id {
        return Error(Schema(0))
    }
    let mut present = false
    for old in t.indexes {
        if old.id == c.id {
            present = true
        }
    }
    if !present {
        let made: Result[own[send] fn(V) -> Result[Bytes, Capacity], (Capacity, (StaticFn[fn(V) -> Result[J, Capacity]], std.codec.Key[J]))] = fn(v: V) -> Result[Bytes, Capacity] {
            let j = (code.callable(by))(v)?
            let mut raw: Bytes = list.new()
            std.codec.encode_key(key, j, mut raw)?
            Ok(take raw)
        }
        let extract = match take made {
            Ok(take f) => take f,
            Error((f, _)) => return Error(Full(f))
        }
        capacity(result.capacity_only(list.push(mut t.indexes, IndexOf(id: c.id, extract: take extract))))?
    }
    let all = index_catalog(db, t.id)?
    let mut complete = true
    for needed in all {
        let mut registered = false
        for old in t.indexes {
            if old.id == needed.id {
                registered = true
            }
        }
        if !registered {
            complete = false
        }
    }
    t.complete = complete
    t.epoch = catalog_entry(db, t.catalog_key)?.epoch
    Ok(Index(store: t.store, id: c.id, catalog_key: catalog_key_handle(take k)?, table: t.id, key: key, primary: t.key, readers: arc.share(t.readers)))
}

pub fn drop_table[K, V](mut db: Db, take t: Table[K, V]) -> Result[Ticket, Error] waits {
    healthy(db)?
    if !same(db.store, t.store) {
        return Error(Foreign)
    }
    let meta = catalog_entry(db, t.catalog_key)?
    if meta.id != t.id {
        return Error(Stale(t.id))
    }
    let indexes = index_catalog(db, t.id)?
    let mut ids: List[u32] = list.new()
    capacity(result.capacity_only(list.push(mut ids, t.id)))?
    for ix in indexes {
        capacity(result.capacity_only(list.push(mut ids, ix.id)))?
    }
    let mut roots = share_roots(db.roots)
    let mut live = db.resident
    for id in ids {
        let mut rows = byte_cursor(roots.data, prefix(id)?, prefix(id + 1)?)?
        while let Some((k, v)) = next_bytes(mut rows)? {
            live = int.saturating_sub(live, entry(k, v))
            roots.data = capacity(std.omap.remove(mut db.next_node, roots.data, k))?
        }
    }
    let low = index_prefix(t.id)?
    let high = index_prefix(t.id + 1)?
    let mut cursor = capacity(result.capacity_only(std.omap.range(roots.catalog, Included(copied(low)?), Excluded(copied(high)?))))?
    while let Some((k, v)) = capacity(std.omap.next(mut cursor))? {
        live = int.saturating_sub(live, entry(k, v))
        roots.catalog = capacity(std.omap.remove(mut db.next_node, roots.catalog, k))?
    }
    if let Some(raw) = std.omap.get(db.roots.catalog, t.catalog_key) {
        live = int.saturating_sub(live, entry(t.catalog_key, raw))
    }
    roots.catalog = capacity(std.omap.remove(mut db.next_node, roots.catalog, t.catalog_key))?
    schema_publish(mut db, take roots, live)
}

fn bucket(v: u64) -> Result[u64, Capacity] {
    Ok(v % 4)
}

fn quotient(v: u64) -> Result[u64, Capacity] {
    Ok(v / 4)
}

fn typed_put(mut db: Db, t: Table[u64, u64], k: u64, v: u64) -> bool waits {
    let out = run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, k, v)
    })
    match take out {
        Ok(Committed(_)) => true,
        _ => false
    }
}

fn typed_value(s: Snapshot, t: Shape[u64, u64], k: u64) -> u64 {
    match result.unwrap(get(s, t, k)) {
        None => 0,
        Some(v) => v
    }
}

pub fn law_typed_indexes(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    for k in 0u64 .. 24 {
        if !typed_put(mut db, t, k, k + 1) {
            return false
        }
    }
    let frozen = snapshot(db)
    let sh = shape(t)
    result.unwrap(create_index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
    let stale = run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 1, 99)
    })
    match take stale {
        Ok(Aborted(Undone(value: Stale(_), ticket: None))) => {},
        _ => return false
    }
    let ix = result.unwrap(index(db, mut t, "bucket", code.describe(bucket), std.codec.key_u64()))
    result.unwrap(create_index(mut db, t, "quotient", code.describe(quotient), std.codec.key_u64()))
    let _ = result.unwrap(index(db, mut t, "bucket", code.describe(bucket), std.codec.key_u64()))
    let incomplete = run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 1, 99)
    })
    match take incomplete {
        Ok(Aborted(Undone(value: Stale(_), ticket: None))) => {},
        _ => return false
    }
    let _ = result.unwrap(index(db, mut t, "quotient", code.describe(quotient), std.codec.key_u64()))
    if !typed_put(mut db, t, 1, 99) {
        return false
    }
    let removed = run(mut db, fn(mut tx: Tx) -> Result[bool, Error] {
        delete(mut tx, t, 5)
    })
    match take removed {
        Ok(Committed(done)) => if !done.value {
            return false
        },
        _ => return false
    }
    let mut rows = result.unwrap(find(snapshot(db), ix, Included(2), Included(2)))
    let mut sum: u64 = 0
    while let Some((_, v)) = result.unwrap(next(mut rows)) {
        sum += v
    }
    if sum != 64 || typed_value(frozen, sh, 1) != 2 || typed_value(snapshot(db), sh, 1) != 99 {
        return false
    }
    let reads = run(mut db, fn(mut tx: Tx) -> Result[u64, Error] {
        let own = option.unwrap(fetch(tx, shape(t), 1)?)
        let mut cursor = lookup(tx, ix, Included(2), Included(2))?
        let mut total = own
        while let Some((_, v)) = next_indexed(mut cursor)? {
            total += v
        }
        Ok(total)
    })
    match take reads {
        Ok(Committed(done)) => if done.value != 163 || list.len(done.reads) != 6 {
            return false
        },
        _ => return false
    }
    for bucket_id in 0u64 .. 4 {
        let mut bucket_rows = result.unwrap(find(snapshot(db), ix, Included(bucket_id), Included(bucket_id)))
        for k in 0u64 .. 24 {
            let v = if k == 1 {
                99u64
            } else {
                k + 1
            }
            if k != 5 && v % 4 == bucket_id {
                if result.unwrap(next(mut bucket_rows)) != Some((k, v)) {
                    return false
                }
            }
        }
        if result.unwrap(next(mut bucket_rows)) != None {
            return false
        }
    }
    true
}

@test
fn test_typed_indexes(c: Clock) -> Result[(), ()] waits {
    if law_typed_indexes(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn record_op(mut tx: Tx, take key: Bytes, take value: Option[Bytes]) -> Result[(), Error] {
    let updated = std.omap.insert(mut tx.op_ids, tx.ops, take key, take value)
    match take updated {
        Ok((take ops, _)) => {
            tx.ops = take ops;
            Ok(())
        },
        Error((c, _)) => Error(refused(mut tx, c))
    }
}

// A multi-index operation either installs every new path or none. The op tree
// is persistent too, so rolling back an operation admits no memory.
type Staged[R] {
    result: Result[R, Error],
    roots: Roots,
    ids: u64,
    resident: u64,
    refusal: Option[Capacity],
    frame_bytes: u64,
    wrote: bool,
    ops: std.omap.OMap[Bytes, Option[Bytes]],
    op_ids: u64
}

fn stage_result[R](take draft: Tx, take change: Result[R, Error]) -> Staged[R] {
    let Tx(store: _, roots: take roots, ids: ids, resident: live, retain_old: _, reads: _, issued: _, refusal: no_room, frame_bytes: size, wrote: wrote, ops: take ops, op_ids: op_ids, info: _) = take draft
    Staged(result: take change, roots: take roots, ids: ids, resident: live, refusal: no_room, frame_bytes: size, wrote: wrote, ops: take ops, op_ids: op_ids)
}

fn stage_put[K, V](tx: Tx, t: Table[K, V], k: K, v: V) -> Staged[()] {
    let mut draft = Tx(store: tx.store, roots: share_roots(tx.roots), ids: tx.ids, resident: tx.resident, retain_old: tx.retain_old, reads: tx.reads, issued: tx.issued, refusal: tx.refusal, frame_bytes: tx.frame_bytes, wrote: tx.wrote, ops: std.omap.snapshot(tx.ops), op_ids: tx.op_ids, info: tx.info)
    let changed = put_impl(mut draft, t, k, v)
    stage_result(take draft, take changed)
}

fn stage_delete[K, V](tx: Tx, t: Table[K, V], k: K) -> Staged[bool] {
    let mut draft = Tx(store: tx.store, roots: share_roots(tx.roots), ids: tx.ids, resident: tx.resident, retain_old: tx.retain_old, reads: tx.reads, issued: tx.issued, refusal: tx.refusal, frame_bytes: tx.frame_bytes, wrote: tx.wrote, ops: std.omap.snapshot(tx.ops), op_ids: tx.op_ids, info: tx.info)
    let changed = delete_impl(mut draft, t, k)
    stage_result(take draft, take changed)
}

fn install[R](mut tx: Tx, take staged: Staged[R]) -> Result[R, Error] {
    let Staged(result: take change, roots: take roots, ids: ids, resident: live, refusal: no_room, frame_bytes: size, wrote: wrote, ops: take ops, op_ids: op_ids) = take staged
    let ok = match change {
        Ok(_) => true,
        Error(_) => false
    }
    tx.ids = ids
    tx.op_ids = op_ids
    if ok {
        tx.roots = take roots
        tx.resident = live
        tx.refusal = no_room
        tx.frame_bytes = size
        tx.wrote = wrote
        tx.ops = take ops
    }
    take change
}

pub fn put[K, V](mut tx: Tx, t: Table[K, V], k: K, v: V) -> Result[(), Error] {
    if list.len(t.indexes) == 0 {
        return put_impl(mut tx, t, k, v)
    }
    let changed = stage_put(tx, t, k, v)
    install(mut tx, take changed)
}

pub fn delete[K, V](mut tx: Tx, t: Table[K, V], k: K) -> Result[bool, Error] {
    if list.len(t.indexes) == 0 {
        return delete_impl(mut tx, t, k)
    }
    let changed = stage_delete(tx, t, k)
    install(mut tx, take changed)
}

type OldAccount {
    balance: u64
}

type NewAccount {
    balance: u64,
    bonus: u64
}

fn old_put(v: OldAccount, mut b: Bytes) -> Result[(), Capacity] {
    std.codec.put_u64(v.balance, mut b)
}

fn old_take(b: Bytes, mut at: u64) -> Result[OldAccount, std.codec.Stop] {
    Ok(OldAccount(balance: std.codec.take_u64(b, mut at)?))
}

fn old_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[OldAccount]) -> Result[(), Capacity] {
    std.codec.define(mut s, "store.tests.Account", 0)?
    if std.codec.record(mut s, 1)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)?
    std.codec.close(mut s)
    Ok(())
}

fn new_put(v: NewAccount, mut b: Bytes) -> Result[(), Capacity] {
    std.codec.put_u64(v.balance, mut b)?
    std.codec.put_u64(v.bonus, mut b)
}

fn new_take(b: Bytes, mut at: u64) -> Result[NewAccount, std.codec.Stop] {
    let balance = std.codec.take_u64(b, mut at)?
    let bonus = std.codec.take_u64(b, mut at)?
    Ok(NewAccount(balance: balance, bonus: bonus))
}

fn new_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[NewAccount]) -> Result[(), Capacity] {
    std.codec.define(mut s, "store.tests.Account", 0)?
    if std.codec.record(mut s, 2)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)?
    std.codec.field_default(mut s, "bonus", std.codec.of_u64(), 7)?
    std.codec.close(mut s)
    Ok(())
}

fn old_codec() -> std.codec.Codec[OldAccount] {
    std.codec.make(old_put, old_take, old_schema, 8)
}

fn new_codec() -> std.codec.Codec[NewAccount] {
    std.codec.make(new_put, new_take, new_schema, 16)
}

// L17 in memory: old rows use a resolved reader and defaults; new rows use the new tag.
// Wrong implementation: overwrite the old schema, or treat a fingerprint match as identity.
pub fn law_schema_numbers(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "accounts", std.codec.key_u64(), old_codec()))
    let old = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), old_codec()))
    let first = run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, old, 1, OldAccount(balance: 10))
    })
    match take first {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let held = snapshot(db)
    // An injected equal fingerprint with unequal bytes must not reuse number 0.
    let mut meta = result.unwrap(catalog_entry(db, old.catalog_key))
    let writer = result.unwrap(std.codec.schema(old_codec()))
    let mut schemas: List[ValueSchema] = list.new()
    result.unwrap(list.push(mut schemas, ValueSchema(number: 0, fingerprint: result.unwrap(std.codec.fingerprint(new_codec())), schema: take writer)))
    meta.schemas = take schemas
    let raw = result.unwrap(encode_catalog(meta))
    let base = share_roots(db.roots)
    let patched = result.unwrap(catalog_put(mut db, base, old.catalog_key, raw))
    db.roots = take patched
    let before_append = version(snapshot(db))
    let current = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), new_codec()))
    // K1: adding a schema is one commit, opening it again commits nothing.
    if current.readers.current != 1 || version(snapshot(db)) != before_append + 1 {
        return false
    }
    let sh = shape(current)
    let before = option.unwrap(result.unwrap(get(held, sh, 1)))
    if before.balance != 10 || before.bonus != 7 {
        return false
    }
    let second = run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, current, 2, NewAccount(balance: 20, bonus: 9))
    })
    match take second {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let rows = snapshot(db)
    let one = option.unwrap(result.unwrap(get(rows, sh, 1)))
    let two = option.unwrap(result.unwrap(get(rows, sh, 2)))
    if one.balance != 10 || one.bonus != 7 || two.balance != 20 || two.bonus != 9 {
        return false
    }
    let epoch = db.head
    let again = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), new_codec()))
    if version(snapshot(db)) != epoch || again.readers.current != 1 {
        return false
    }
    let refused_reader = table(mut db, "accounts", std.codec.key_u64(), old_codec())
    match take refused_reader {
        Error(Schema(_)) => {},
        _ => return false
    }
    db.head == epoch
}

@test
fn test_schema_numbers(c: Clock) -> Result[(), ()] waits {
    if law_schema_numbers(c) {
        Ok(())
    } else {
        Error(())
    }
}

// Initial ids and epochs are input validity rules, not B-tree invariants.
pub fn law_catalog_invalid(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let mut meta = result.unwrap(catalog_entry(db, t.catalog_key))
    if meta.id != 1 || meta.epoch != 1 || meta.next != 1 || meta.schemas[0].number != 0 {
        return false
    }
    meta.id = 0
    let raw = result.unwrap(encode_catalog(meta))
    match decode_catalog(raw) {
        Error(Corrupt(_)) => {},
        _ => return false
    }
    meta.id = 1
    meta.epoch = 0
    let zero_epoch = result.unwrap(encode_catalog(meta))
    match decode_catalog(zero_epoch) {
        Error(Corrupt(_)) => {},
        _ => return false
    }
    meta.epoch = 9
    meta.id = 17
    let another = result.unwrap(encode_catalog(meta))
    match decode_catalog(another) {
        Ok(catalog) => catalog.id == 17 && catalog.epoch == 9,
        _ => false
    }
}


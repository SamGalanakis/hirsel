// Contract tests for `float` (core/std/float.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names.
//
// A float result is read as its bits (float.to_bits64, to_bits32). Each expected pattern
// was derived from the IEEE layout by hand and checked against Python's correctly
// rounded float parser.
fn bits64(r: Result[f64, ParseError]) -> u64 {
    float.to_bits64(result.unwrap(r))
}

fn bits32(r: Result[f32, ParseError]) -> u32 {
    float.to_bits32(result.unwrap(r))
}

/// 0 for Ok, 1 for Empty, 100 + i for Invalid(i), 3 for OutOfRange.
fn error64(r: Result[f64, ParseError]) -> u64 {
    match r {
        Ok(_) => 0,
        Error(Empty) => 1,
        Error(Invalid(i)) => 100 + i,
        Error(OutOfRange) => 3,
    }
}

fn error32(r: Result[f32, ParseError]) -> u64 {
    match r {
        Ok(_) => 0,
        Error(Empty) => 1,
        Error(Invalid(i)) => 100 + i,
        Error(OutOfRange) => 3,
    }
}

// expect: run zero() = 0
fn zero() -> u64 {
    bits64(float.parse64("0"))
}

// Only the sign bit, 2^63.
// expect: run negative_zero() = 9223372036854775808
fn negative_zero() -> u64 {
    bits64(float.parse64("-0"))
}

// Biased exponent 1023, 0x3FF0000000000000.
// expect: run one() = 4607182418800017408
fn one() -> u64 {
    bits64(float.parse64("1"))
}

// 0x3FB999999999999A: the mantissa rounds up at the last place.
// expect: run one_tenth() = 4591870180066957722
fn one_tenth() -> u64 {
    bits64(float.parse64("0.1"))
}

// 1.23456, with an exponent folded into the fraction.
// expect: run fraction_and_exponent() = 4608238783128613432
fn fraction_and_exponent() -> u64 {
    bits64(float.parse64("123.456e-2"))
}

// Past the exact fast path (10^23 is not exact in f64): Eisel-Lemire decides it.
// expect: run ten_to_23() = 4950912855330343670
fn ten_to_23() -> u64 {
    bits64(float.parse64("1e23"))
}

// 2^53 + 1 lies halfway between 2^53 and 2^53 + 2: ties to even gives 2^53, biased
// exponent 1076 and a zero mantissa.
// expect: run halfway_to_even() = 4845873199050653696
fn halfway_to_even() -> u64 {
    bits64(float.parse64("9007199254740993"))
}

// The same digits a hair above halfway, past 19 significant digits: 2^53 + 2.
// expect: run above_halfway_long() = 4845873199050653697
fn above_halfway_long() -> u64 {
    bits64(float.parse64("9007199254740993.0000000000000000001"))
}

// The largest subnormal, 0x000FFFFFFFFFFFFF.
// expect: run largest_subnormal() = 4503599627370495
fn largest_subnormal() -> u64 {
    bits64(float.parse64("2.2250738585072011e-308"))
}

// The smallest subnormal, 2^-1074.
// expect: run smallest_subnormal() = 1
fn smallest_subnormal() -> u64 {
    bits64(float.parse64("4.9406564584124654e-324"))
}

// Just below half of 2^-1074 rounds to zero ...
// expect: run below_half_subnormal() = 0
fn below_half_subnormal() -> u64 {
    bits64(float.parse64("2.4703282292062327e-324"))
}

// ... and just above it to 2^-1074.
// expect: run above_half_subnormal() = 1
fn above_half_subnormal() -> u64 {
    bits64(float.parse64("2.4703282292062328e-324"))
}

// expect: run underflow_is_zero() = 0
fn underflow_is_zero() -> u64 {
    bits64(float.parse64("1e-400"))
}

// The largest finite f64, 0x7FEFFFFFFFFFFFFF.
// expect: run largest_finite() = 9218868437227405311
fn largest_finite() -> u64 {
    bits64(float.parse64("1.7976931348623157e308"))
}

// Past the halfway point to 2^1024 the value rounds to an infinity.
// expect: run rounds_to_infinity() = 3
fn rounds_to_infinity() -> u64 {
    error64(float.parse64("1.7976931348623159e308"))
}

// expect: run far_out_of_range() = 3
fn far_out_of_range() -> u64 {
    error64(float.parse64("-1e400"))
}

// expect: run empty() = 1
fn empty() -> u64 {
    error64(float.parse64(""))
}

// expect: run sign_alone() = 101
fn sign_alone() -> u64 {
    error64(float.parse64("-"))
}

// expect: run leading_zero() = 101
fn leading_zero() -> u64 {
    error64(float.parse64("01"))
}

// expect: run dot_without_digits() = 102
fn dot_without_digits() -> u64 {
    error64(float.parse64("1."))
}

// expect: run dot_first() = 100
fn dot_first() -> u64 {
    error64(float.parse64(".5"))
}

// expect: run exponent_without_digits() = 102
fn exponent_without_digits() -> u64 {
    error64(float.parse64("1e"))
}

// expect: run exponent_sign_without_digits() = 103
fn exponent_sign_without_digits() -> u64 {
    error64(float.parse64("1e+"))
}

// expect: run plus_sign() = 100
fn plus_sign() -> u64 {
    error64(float.parse64("+1"))
}

// expect: run infinity_word() = 100
fn infinity_word() -> u64 {
    error64(float.parse64("inf"))
}

// expect: run trailing_byte() = 101
fn trailing_byte() -> u64 {
    error64(float.parse64("1x"))
}

// The scan reads eight digits at a word, the rest one at a time, and scans again only
// past 19 significant digits. Each pattern is Python's correctly rounded float(s).
fn parsed(s: String) -> u64 {
    bits64(float.parse64(s))
}

// Runs of 7, 8, 9, 16 and 17 digits on both sides of the point, and a word that ends in
// '.', 'e', ':' (one above '9') or '/' (one below '0').
// expect: run digit_words() = true
fn digit_words() -> bool {
    parsed("12345678") == 0x41678C29C0000000 && parsed("123456789") == 0x419D6F3454000000 && parsed("0.1234567") == 0x3FBF9ADBB8F8DA72 && parsed("0.12345678") == 0x3FBF9ADD1091C895 && parsed("0.123456789") == 0x3FBF9ADD3739635F && parsed("0.1234567890123456") == 0x3FBF9ADD3746F659 && parsed("0.12345678901234567") == 0x3FBF9ADD3746F65E && parsed("1.1234567e5") == 0x40FB6D9AB851EB85 && parsed("1234567.5") == 0x4132D68780000000 && parsed("12345678.12345678") == 0x41678C29C3F35BA2 && parsed("98765432109876543.5e-3") == 0x42D674E79FCECD23 && error64(float.parse64("1.1234567:")) == 109 && error64(float.parse64("1.1234567/")) == 109
}

// 19 significant digits fit the mantissa exactly; a 20th, zero or not, is past it (2^64
// and 10^20 - 1 wrap a u64); zeros before the first significant digit do not count,
// however many there are.
// expect: run significant_digits() = true
fn significant_digits() -> bool {
    parsed("1234567890123456789") == 0x43B12210F47DE981 && parsed("12345678901234567890") == 0x43E56A95319D63E1 && parsed("12345678901234567891") == 0x43E56A95319D63E1 && parsed("18446744073709551616") == 0x43F0000000000000 && parsed("99999999999999999999") == 0x4415AF1D78B58C40 && parsed("123456789012345678901234") == 0x44BA249B1F10A06D && parsed("0.0000000000000000000001234567890123456789") == 0x3B62A800D163332F && parsed("0.00000000000000000000012345678901234567891") == 0x3B62A800D163332F && parsed("1000000000000000000000000.0000000000001") == 0x44EA784379D99DB4 && parsed("0.30000000000000000000000000000001") == 0x3FD3333333333333
}

// Exact halfway points, written out in full: 1 + 2^-53 ties down to 1 and 1 + 3 x 2^-53
// up to the even 1 + 2^-51, one digit more goes up; 2^-1075 (halfway to the smallest
// subnormal) cut just below and just above; the smallest normal; halfway between the
// largest finite and 2^1024 ties to the infinity, one less is the largest finite.
// expect: run exact_halfways() = true
fn exact_halfways() -> bool {
    parsed("1.00000000000000011102230246251565404236316680908203125") == 0x3FF0000000000000 && parsed("1.00000000000000011102230246251565404236316680908203126") == 0x3FF0000000000001 && parsed("1.00000000000000033306690738754696212708950042724609375") == 0x3FF0000000000002 && parsed("2.4703282292062327208828439643411068618252990130716238221279284125033775363e-324") == 0 && parsed("2.4703282292062327208828439643411068618252990130716238221279284125033775364e-324") == 1 && parsed("2.2250738585072014e-308") == 0x0010000000000000 && parsed("123456789e-330") == 0x19 && error64(float.parse64("")) == 3 && parsed("") == 0x7FEFFFFFFFFFFFFF
}

// 0x3F800000.
// expect: run one_32() = 1065353216
fn one_32() -> u32 {
    bits32(float.parse32("1"))
}

// 0x3DCCCCCD, rounded once from the decimal, not from the f64.
// expect: run one_tenth_32() = 1036831949
fn one_tenth_32() -> u32 {
    bits32(float.parse32("0.1"))
}

// 2^24 + 1 is halfway: ties to even gives 2^24, 0x4B800000.
// expect: run halfway_to_even_32() = 1266679808
fn halfway_to_even_32() -> u32 {
    bits32(float.parse32("16777217"))
}

// The largest finite f32, 0x7F7FFFFF.
// expect: run largest_finite_32() = 2139095039
fn largest_finite_32() -> u32 {
    bits32(float.parse32("3.4028235e38"))
}

// Past the halfway point to 2^128.
// expect: run rounds_to_infinity_32() = 3
fn rounds_to_infinity_32() -> u64 {
    error32(float.parse32("3.4028236e38"))
}

// The smallest f32 subnormal, 2^-149, about 1.401e-45.
// expect: run smallest_subnormal_32() = 1
fn smallest_subnormal_32() -> u32 {
    bits32(float.parse32("1.4e-45"))
}

// Below 2^-150, half the smallest subnormal: zero.
// expect: run below_half_subnormal_32() = 0
fn below_half_subnormal_32() -> u32 {
    bits32(float.parse32("7.0e-46"))
}

// expect: run finite_number() = true
fn finite_number() -> bool {
    float.is_finite(1.5)
}

// expect: run largest_is_finite() = true
fn largest_is_finite() -> bool {
    float.is_finite(float.from_bits64(0x7fefffffffffffff))
}

// expect: run infinity_not_finite() = false
fn infinity_not_finite() -> bool {
    float.is_finite(float.from_bits64(0x7ff0000000000000))
}

// expect: run nan_not_finite() = false
fn nan_not_finite() -> bool {
    float.is_finite(float.from_bits64(0x7ff8000000000000))
}

// Formatting. Expected texts: exact binary values (0.125, 0.375, 2.5, 9.5, 1e22) rounded by
// hand; the others from Python's exact Decimal(x) and repr(x) (David Gay's shortest), which
// agree with Rust's `{:.N}` and `{}` digits.
fn fixed(x: f64, n: u64) -> String {
    let mut s = string.new()
    result.unwrap(float.push_fixed64(mut s, x, n))
    s
}

fn shown(x: f64) -> String {
    let mut s = string.new()
    result.unwrap(float.push_f64(mut s, x))
    s
}

// Exact ties go to the even digit: 0.125 -> 0.12, 0.375 -> 0.38, 2.5 -> 2, 3.5 -> 4,
// 0.5 -> 0.
// expect: run fixed_ties_to_even() = true
fn fixed_ties_to_even() -> bool {
    fixed(0.125, 2) == "0.12" && fixed(0.375, 2) == "0.38" && fixed(2.5, 0) == "2" && fixed(3.5, 0) == "4" && fixed(0.5, 0) == "0"
}

// A carry through every digit adds one in front: 9.5 -> 10, 99.5 -> 100, 9.875 -> 9.88,
// 9.996 (above 9.995) -> 10.00.
// expect: run fixed_carry() = true
fn fixed_carry() -> bool {
    fixed(9.5, 0) == "10" && fixed(99.5, 0) == "100" && fixed(9.875, 2) == "9.88" && fixed(9.996, 2) == "10.00"
}

// 0.1 is 0.1000000000000000055511151231257827...: places 18 to 20 are 555, then 1.
// expect: run fixed_exact_digits() = true
fn fixed_exact_digits() -> bool {
    fixed(0.1, 1) == "0.1" && fixed(0.1, 20) == "0.10000000000000000555" && fixed(0.3, 7) == "0.3000000" && fixed(123456.789, 7) == "123456.7890000"
}

// 2^-30 = 0.000000000931322574615478515625 exactly, padded to 40 places; 1e22 is exact.
// expect: run fixed_wide() = true
fn fixed_wide() -> bool {
    fixed(float.from_bits64(0x3E10000000000000), 40) == "0.0000000009313225746154785156250000000000" && fixed(1e22, 1) == "10000000000000000000000.0"
}

// The sign bit always prints, also when the value rounds to zero; zero has one whole
// digit; NaN has no sign.
// expect: run fixed_signs_and_specials() = true
fn fixed_signs_and_specials() -> bool {
    fixed(-0.0, 1) == "-0.0" && fixed(-0.00000001, 7) == "-0.0000000" && fixed(0.0, 0) == "0" && fixed(-2.25, 1) == "-2.2" && fixed(float.from_bits64(0x7FF0000000000000), 3) == "inf" && fixed(float.from_bits64(0xFFF0000000000000), 3) == "-inf" && fixed(float.from_bits64(0xFFF8000000000000), 3) == "NaN"
}

// 1e300's exact value has 301 whole digits, beginning 1000000000000000052504760255204420.
// expect: run fixed_huge() = true
fn fixed_huge() -> bool {
    let s = fixed(1e300, 7)
    string.byte_len(s) == 309 && string.starts_with(s, "1000000000000000052504760255204420") && string.ends_with(s, "6865459400540160.0000000")
}

// Shortest digits in Rust's `{}` layout: no exponent, no ".0".
// expect: run shown_plain() = true
fn shown_plain() -> bool {
    shown(0.1) == "0.1" && shown(1.0) == "1" && shown(-0.0) == "-0" && shown(0.0) == "0" && shown(123.456) == "123.456" && shown(1e21) == "1000000000000000000000" && shown(1e-7) == "0.0000001" && shown(0.1 + 0.2) == "0.30000000000000004"
}

// Powers of two: below 2^64 the gap is half the gap above, which makes the shortest
// 18446744073709552 x 10^3 (a symmetric interval would give 1844674407370955 x 10^4);
// likewise 2^-44 is 5.684341886080802e-14, and 2^60 is 1.152921504606847e18.
// expect: run shown_powers_of_two() = true
fn shown_powers_of_two() -> bool {
    shown(float.from_bits64(0x43F0000000000000)) == "18446744073709552000" && shown(float.from_bits64(0x3D30000000000000)) == "0.00000000000005684341886080802" && shown(float.from_bits64(0x43B0000000000000)) == "1152921504606847000"
}

// The extremes: 5e-324 is "0." then 323 zeros then 5; the largest finite is
// 17976931348623157 then 292 zeros; the smallest normal is 2.2250738585072014e-308.
// expect: run shown_extremes() = true
fn shown_extremes() -> bool {
    let tiny = shown(float.from_bits64(1))
    let big = shown(float.from_bits64(0x7FEFFFFFFFFFFFFF))
    let normal = shown(float.from_bits64(0x0010000000000000))
    string.byte_len(tiny) == 326 && string.ends_with(tiny, "05") && string.starts_with(tiny, "0.000") && string.byte_len(big) == 309 && string.starts_with(big, "179769313486231570") && string.ends_with(big, "000") && string.byte_len(normal) == 326 && string.ends_with(normal, "22250738585072014")
}

// expect: run shortest_pairs() = true
fn shortest_pairs() -> bool {
    let (c, p) = float.shortest64(0.3)
    let (d, q) = float.shortest64(100.0)
    let (z, w) = float.shortest64(0.0)
    c == 3 && p == -1 && d == 1 && q == 2 && z == 0 && w == 0
}

// exp, within 1 ulp of the correctly rounded value (fdlibm's bound). Each expected bit
// pattern is e^x computed by Python's decimal module to 80 digits and rounded once.
fn ulps(x: f64, want: u64) -> u64 {
    let got = float.to_bits64(float.exp(x))
    if got > want {
        got - want
    } else {
        want - got
    }
}

// expect: run exp_ordinary() = true
fn exp_ordinary() -> bool {
    ulps(1.0, 0x4005bf0a8b145769) <= 1 && ulps(-1.0, 0x3fd78b56362cef38) <= 1 && ulps(0.5, 0x3ffa61298e1e069c) <= 1 && ulps(0.3, 0x3ff599058c8c1a96) <= 1 && ulps(10.0, 0x40d5829dcf950560) <= 1 && ulps(-20.0, 0x3e21b48655f37267) <= 1 && ulps(100.0, 0x48f3494a9b171bf5) <= 1
}

// Both reduction branches meet near 0.5 ln2 and 1.5 ln2: e^(0.5 ln2) = sqrt 2,
// e^(1.5 ln2) = 2 sqrt 2.
// expect: run exp_reduction_edges() = true
fn exp_reduction_edges() -> bool {
    ulps(0.34657359027997264, 0x3ff6a09e667f3bcc) <= 1 && ulps(1.0397207708399179, 0x4006a09e667f3bcc) <= 1
}

// Near overflow, deep in the subnormals (the k < -1021 path), and the tiny-x path.
// expect: run exp_range_ends() = true
fn exp_range_ends() -> bool {
    ulps(709.7, 0x7fed75ae7a50ee14) <= 1 && ulps(-708.5, 0x000e6cf6d08897ac) <= 1 && ulps(-740.0, 0x55) <= 1 && ulps(-745.1, 0x1) <= 1 && ulps(float.from_bits64(0x3E10000000000000), 0x3ff0000000400000) <= 1
}

fn e(x: u64) -> u64 {
    float.to_bits64(float.exp(float.from_bits64(x)))
}

// exp(0) is exactly 1; past the thresholds inf and 0; exp(-inf) = 0, exp(inf) = inf,
// exp(NaN) is NaN.
// expect: run exp_specials() = true
fn exp_specials() -> bool {
    e(0) == 0x3ff0000000000000 && e(0x8000000000000000) == 0x3ff0000000000000 && float.to_bits64(float.exp(709.8)) == 0x7ff0000000000000 && float.to_bits64(float.exp(-745.2)) == 0 && e(0xfff0000000000000) == 0 && e(0x7ff0000000000000) == 0x7ff0000000000000 && !float.is_finite(float.exp(float.from_bits64(0x7ff8000000000000)))
}

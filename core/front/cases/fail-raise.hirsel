// expect: run go(1) = 1
// expect: run go(3) = fail Fail
// core.fail raises a Fail cause with the String it takes; the call is not a link to
// an external function, and nothing after it runs.
fn check(n: u64) -> u64 {
    let msg: String = "too big"
    if n > 2 {
        fail(take msg)
    }
    n
}

fn go(n: u64) -> u64 {
    check(n)
}

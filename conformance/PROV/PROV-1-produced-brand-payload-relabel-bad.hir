// rule: PROV-1
// expect: reject PROV-1 at line 11
// twin: PROV/PROV-2-produced-brand-run.hir
// Owning a wrapper brands only the wrapper's root: its payload keeps its own
// brand, so an instant of `a` cannot become an instant of `b` by wrapping.
pub opaque type W[T: inert]: () uses {} {
  value: T,
}

fn bad(a: MonotonicClock, b: MonotonicClock, x: Instant of a) -> W[Instant of b] of b {
  W(value: x)
}

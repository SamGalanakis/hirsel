resource type MergeAudit {
    out: Stdout,
    values: List[SortItem],
    count: u64
} drop(t) {
    let mut valid = list.len(t.values) == t.count
    let mut mask: u64 = 0
    for x in t.values {
        if x.id >= t.count || x.key != merge_key(t.count, x.id) {
            valid = false
        } else {
            let bit = 1u64 << x.id
            if (mask & bit) != 0 {
                valid = false
            }
            mask |= bit
        }
    }
    let _ = stdout.write(t.out, if valid && mask == (1u64 << t.count) - 1 {
        "ok"
    } else {
        "bad"
    })
}

// Stable sorted: keys never decrease and ids rise within a key.
fn merge_fail_at(out: Stdout, count: u64, failure: u64) -> bool {
    let mut xs: List[SortItem] = list.new()
    for i in 0u64 .. count {
        result.unwrap(list.push(mut xs, result.unwrap(SortItem(out: out, id: i, key: merge_key(count, i)))))
    }
    let mut audit = result.unwrap(MergeAudit(out: out, values: take xs, count: count))
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut audit.values, fn(a: SortItem, b: SortItem) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a.key < b.key {
            Less
        } else if a.key > b.key {
            Greater
        } else {
            Equal
        }
    }))
    let mut sorted = true
    for i in 1u64 .. count {
        let (ak, ai) = (audit.values[i - 1].key, audit.values[i - 1].id)
        let (bk, bi) = (audit.values[i].key, audit.values[i].id)
        if ak > bk || (ak == bk && ai > bi) {
            sorted = false
        }
    }
    sorted
}

// Host-free twin: the evaluator checks scratch and source live slots on failure.
fn merge_plain_fail_at(count: u64, failure: u64) -> bool {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. count {
        result.unwrap(list.push(mut xs, merge_key(count, i)))
    }
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a < b {
            Less
        } else if a > b {
            Greater
        } else {
            Equal
        }
    }))
    let mut sorted = list.len(xs) == count
    for i in 1u64 .. count {
        if xs[i - 1] > xs[i] {
            sorted = false
        }
    }
    sorted
}

// Keys by count. The merge_up laws below fail at chosen calls of the 36 list; the
// sweeps at the end fail at every call of the 37, 44, 88 and 104 lists. Call
// counts come from an independent replay model of the sort.
// 36: two ascending runs of 18, evens then odds. Run detection takes calls 1-35
//     and the merge's gallops 36-49 (key 0 stays put); the merge copies the other
//     17 left keys to scratch and merges up on calls 50-82.
// 37: an ascending run of 21, then 16 keys the small sort orders (sort4 and
//     insertion, then a bidirectional merge of the halves on calls 66-80); the
//     merge with the run gallops and merges down. 128 calls.
// 44: (7i mod 44) mod 3. Short runs, small sorts with bidirectional merges, then
//     merges down. 251 calls.
// 88: (7i mod 88) mod 3. Too long for one small sort: partitions, an equal
//     partition and small sorts. 282 calls.
// 104: ids 0-63 two ascending blocks, the second preceding the first; ids 64-95
//     odd keys; ids 96-103 even keys. Three partitions and small sorts. 583 calls.
fn merge_key(count: u64, id: u64) -> u64 {
    if count == 36 {
        if id < 18 {
            2 * id
        } else {
            2 * (id - 18) + 1
        }
    } else if count == 37 {
        if id < 21 {
            2 * id
        } else {
            (7 * (id - 21)) % 16 * 3 + 1
        }
    } else if count == 44 || count == 88 {
        (id * 7) % count % 3
    } else if id < 64 {
        160 - id / 32 * 32 + id % 32
    } else if id < 96 {
        2 * (id - 64) + 1
    } else {
        2 * (id - 96)
    }
}

// expect: stdout "okXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

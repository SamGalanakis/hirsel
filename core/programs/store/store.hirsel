// M4 store. The writer owns three persistent byte trees; readers hold Arc roots.
pub type StoreId {
    hi: u64,
    lo: u64
}

pub type StorageKind: send = Directory() | Bucket(std.object.Bucket)

pub type Caller: codec + send {
    issuer: u8,
    subject: Bytes
}

pub const FRAME_LIMIT: u64 = 16777296

pub const VALUE_LIMIT: u64 = 16711680

pub type Options: send {
    create: bool,
    lock_wait_ms: u64,
    group_commits: u32,
    group_bytes: u32,
    checkpoint_bytes: u64,
    journal_limit: u64,
    pack_bytes: u64,
    resident_limit: u64,
    authority: StorageKind,
    expect: Option[StoreId]
}

pub fn defaults() -> Options {
    Options(create: true, lock_wait_ms: 0, group_commits: 64, group_bytes: 4194304, checkpoint_bytes: 67108864, journal_limit: 268435456, pack_bytes: 67108864, resident_limit: 1073741824, authority: Directory(), expect: None)
}

pub type Limit = Key | Value | Transaction | Name | Ids | Manifest | Triggers

pub type Why = Checksum | Truncated | Flags | Kind(u64) | Header | Gap(u64) | Order | Dangling(u64) | Absent | Malformed

pub type Fault: send {
    file: String,
    offset: u64,
    why: Why
}

pub type StoreCapacity: send = Journal(Capacity) | Resident(Capacity) | Allocation(Capacity)

pub type Error: send = Held | NotFound | Corrupt(Fault) | Unsupported(u64) | Io(IoError) | Poisoned(IoError) | Full(StoreCapacity) | Limit(Limit) | Schema(u64) | Stale(u32) | Decode(std.codec.DecodeError) | Exists(String) | Missing(String) | NoLevel(String) | Behind(Position) | Gone(u32) | Unseen(u32) | Diverged(u32) | Foreign | MigrationFault | ExportDirectory | Fenced(u64) | Unqualified(String) | Remote(std.object.Error)

type Roots = PageRoots

fn empty_roots() -> Roots {
    PageRoots(collections: new_page_tree(CollectionMap, 1024), streams: new_page_tree(Unprefixed, 1024), catalog: new_page_tree(Unprefixed, 1024))
}

fn share_roots(r: Roots) -> Roots {
    PageRoots(collections: share_page_tree(r.collections), streams: share_page_tree(r.streams), catalog: share_page_tree(r.catalog))
}

type Ack: send = Journaled(u64, u64) | Broken(IoError)

pub opaque type Db {
    store: StoreId,
    fence: u32,
    disk: Option[DiskState],
    clock: Clock,
    // Every live branch, main first, the rest ascending by id. A version is
    // compared only with the head of the branch it belongs to (AA1, Z1).
    heads: List[Head],
    branch_names: Map[String, u32],
    pins: List[Pin],
    record_bytes: u64,
    next_pin: u64,
    next_branch: u32,
    next_node: u64,
    next_table: u32,
    file_seq: u64,
    file_end: u64,
    frame_seq: u64,
    resident: u64,
    page_resident: u64,
    // Commits and cut-made operations on any branch.
    changes: u64,
    // The `changes` count at which `resident` was last exact (I4).
    settled: u64,
    ceiling: u64,
    checkpointed: u64,
    // Stream name to the unreplied Admitted(p) this open committed (§1.8).
    admits: Map[Bytes, OpenAdmit]
}

pub type Branch {
    store: StoreId,
    id: u32
}

type Head {
    id: u32,
    name: String,
    parent: u32,
    forked_at: u64,
    roots: Roots,
    head: u64,
    at: u64,
    following: Option[Latest[Snapshot]]
}

type Pin: shareable + send {
    name: String,
    branch: u32,
    version: u64,
    serial: u64,
    roots: Roots
}

fn main_head(take roots: Roots, head: u64, at: u64) -> Head {
    Head(id: 0, name: "main", parent: 0, forked_at: 0, roots: take roots, head: head, at: at, following: None)
}

// I4: while a pin or another branch exists, an old row may stay reachable, so
// commits charge conservatively until the next cut settles the account.
fn retaining(db: Db) -> bool {
    list.len(db.heads) > 1 || list.len(db.pins) != 0
}

// A branch as a cut, open and replay carry it: a Head without the readers'
// handle (section 3.5 step 3).
type Tip: send {
    id: u32,
    name: String,
    parent: u32,
    forked_at: u64,
    roots: Roots,
    head: u64,
    at: u64
}

// Every branch's head and every pin: what one cut makes durable.
type State: send {
    tips: List[Tip],
    pins: List[Pin],
    next_branch: u32,
    next_table: u32
}

type ProposedMain {
    roots: Roots,
    head: u64,
    at: u64,
    tables: u32
}

type HolderDelta = NoHolderChange | AddHead(Head, String) | RemoveHead(u64) | AddPin(Pin) | RemovePin(u64) | ReplaceMain(ProposedMain, Option[u64])

fn main_state(take roots: Roots, head: u64, at: u64) -> Result[State, Capacity] {
    let mut tips: List[Tip] = list.new()
    list.push(mut tips, Tip(id: 0, name: "main", parent: 0, forked_at: 0, roots: take roots, head: head, at: at))
    Ok(State(tips: take tips, pins: list.new(), next_branch: 1, next_table: 1))
}

fn share_pin(p: Pin) -> Result[Pin, Capacity] {
    Ok(Pin(name: string.from(p.name), branch: p.branch, version: p.version, serial: p.serial, roots: share_roots(p.roots)))
}

fn tip_of(h: Head) -> Tip {
    Tip(id: h.id, name: string.from(h.name), parent: h.parent, forked_at: h.forked_at, roots: share_roots(h.roots), head: h.head, at: h.at)
}

// Project the proposed holders into the checkpoint's input. The live holder
// slots and the table-id counter still describe the installed generation.
fn state_with_delta(db: Db, delta: HolderDelta) -> Result[State, Capacity] {
    let mut tips: List[Tip] = list.with_capacity(list.len(db.heads))
    let mut kept: List[Pin] = list.with_capacity(list.len(db.pins))
    let mut tables = db.next_table
    for slot in 0u64 .. list.len(db.heads) {
        if let RemoveHead(gone) = delta {
            if slot == gone {
                continue
            }
        }
        if let ReplaceMain(proposed, gone) = delta {
            if let Some(away) = gone {
                if slot == away {
                    continue
                }
            }
            if slot == 0 {
                let h = db.heads[0u64]
                list.push(mut tips, Tip(id: 0, name: string.from(h.name), parent: h.parent, forked_at: h.forked_at, roots: share_roots(proposed.roots), head: proposed.head, at: proposed.at))
                tables = proposed.tables
                continue
            }
        }
        list.push(mut tips, tip_of(db.heads[slot]))
    }
    if let AddHead(added, _) = delta {
        list.push(mut tips, tip_of(added))
    }
    for slot in 0u64 .. list.len(db.pins) {
        if let RemovePin(gone) = delta {
            if slot == gone {
                continue
            }
        }
        list.push(mut kept, share_pin(db.pins[slot])?)
    }
    if let AddPin(added) = delta {
        list.push(mut kept, share_pin(added)?)
        list.sort(mut kept, fn(a: Pin, b: Pin) -> Order {
            order.compare(a.name, b.name)
        })
    }
    Ok(State(tips: take tips, pins: take kept, next_branch: db.next_branch, next_table: tables))
}

fn current_state(db: Db) -> Result[State, Capacity] {
    state_with_delta(db, NoHolderChange)
}

fn prepare_holder_slot(mut db: Db, delta: HolderDelta) -> Result[(), Error] {
    match delta {
        AddHead(_, _) => {
            capacity(map.try_reserve(mut db.branch_names, 1))?
            capacity(list.try_reserve(mut db.heads, 1))
        },
        AddPin(_) => capacity(list.try_reserve(mut db.pins, 1)),
        _ => Ok(()),
    }
}

fn install_head(mut db: Db, take added: Head, take indexed_name: String) {
    db.record_bytes += branch_record_bytes(added.name)
    map.insert(mut db.branch_names, take indexed_name, added.id)
    list.push(mut db.heads, take added)
}

fn remove_head(mut db: Db, slot: u64) {
    let removed = list.remove(mut db.heads, slot)
    db.record_bytes -= branch_record_bytes(removed.name)
    let _ = map.remove(mut db.branch_names, removed.name)
}

fn install_holder_delta(mut db: Db, take delta: HolderDelta) {
    match take delta {
        NoHolderChange => return (),
        AddHead(take added, take name) => install_head(mut db, take added, take name),
        RemoveHead(slot) => remove_head(mut db, slot),
        AddPin(take added) => {
            db.record_bytes += pin_record_bytes(added.name)
            let mut slot = 0u64
            while slot < list.len(db.pins) && db.pins[slot].name < added.name {
                slot += 1
            }
            list.insert(mut db.pins, slot, take added)
        },
        RemovePin(slot) => {
            let removed = list.remove(mut db.pins, slot)
            db.record_bytes -= pin_record_bytes(removed.name)
        },
        ReplaceMain(take proposed, gone) => {
            let ProposedMain(roots: take roots, head: head, at: at, tables: tables) = take proposed
            db.heads[0u64].roots = take roots
            db.heads[0u64].head = head
            db.heads[0u64].at = at
            db.next_table = tables
            if let Some(slot) = gone {
                remove_head(mut db, slot)
            }
        },
    }
    db.changes += 1
    db.settled = db.changes
}

fn state_roots(s: State) -> Result[List[Roots], Capacity] {
    let mut all: List[Roots] = list.with_capacity(list.len(s.tips) + list.len(s.pins))
    for t in s.tips {
        list.push(mut all, share_roots(t.roots))
    }
    for held in s.pins {
        list.push(mut all, share_roots(held.roots))
    }
    Ok(take all)
}

fn state_account(s: State) -> Result[u64, Capacity] {
    Ok(page_row_account(state_roots(s)?))
}

fn memory_cut_accounts(state: State) -> Result[(u64, u64), Error] {
    disk_allocation(scoped fn() -> Result[(u64, u64), Error] {
        let roots = capacity(state_roots(state))?
        Ok((page_row_account(roots), resident_images(roots, None)))
    })
}

fn record_memory_cut(mut db: Db, live: u64, pages: u64) -> Ticket {
    db.checkpointed += 1
    db.resident = live
    db.page_resident = pages
    db.settled = db.changes
    Ticket(store: db.store, open: 0, mark: Cut(db.checkpointed))
}

fn branch_index(db: Db, b: Branch) -> Result[u64, Error] {
    if !same(b.store, db.store) {
        return Error(Foreign)
    }
    for i in 0u64 .. list.len(db.heads) {
        if db.heads[i].id == b.id {
            return Ok(i)
        }
    }
    Error(Missing("branch"))
}

fn head_snapshot(db: Db, i: u64) -> Snapshot {
    snapshot_from(db, i, db.heads[i].head, db.heads[i].roots)
}

fn snapshot_from(db: Db, i: u64, head: u64, roots: Roots) -> Snapshot {
    Snapshot(store: db.store, open: open_number(db), branch: db.heads[i].id, head: head, roots: share_roots(roots))
}

pub type CallId {
    store: StoreId,
    branch: u32,
    version: u64
}

pub type CallInfo {
    id: CallId,
    at: u64,
    seed: u64
}

pub type Mark = Journal(u64, u32, u64) | Cut(u64)

pub type Ticket {
    store: StoreId,
    open: u64,
    mark: Mark
}

pub type Read = Point(Bytes) | Span(Bytes, Bytes)

pub type Outcome[R, A] = Committed(Done[R]) | Aborted(Undone[A]) | Failed(Causes) | Refused(StoreCapacity) | Stopped(OutOfTime)

pub type Undone[A] {
    value: A,
    ticket: Option[Ticket]
}

pub type Done[R] {
    value: R,
    ticket: Ticket,
    info: CallInfo,
    reads: List[Read]
}

pub type Bound[K] = Unbounded | Included(K) | Excluded(K)

pub type Limits: shareable + send {
    rows: u64,
    byte_limit: u64
}

pub opaque type Resume: send {
    store: StoreId,
    open: u64,
    branch: u32,
    version: u64,
    source: u32,
    high: Bytes,
    last: Bytes
}

pub type Page[K, V]: send {
    rows: List[(K, V)],
    byte_count: u64,
    next: Option[Resume]
}

pub type Resumed[K, V]: send = Paged(Page[K, V]) | Moved(u64)

type DataOp: shareable + send {
    key: Bytes,
    value: Option[StagedValue]
}

// Inline pages copy the bytes into the page image. Overflow pages share the
// body with the staged operation.
type StagedValue: shareable + send = PageValue(Bytes) | BlobBody(Arc[Bytes])

fn stage_value(take raw: Bytes, inline: u64) -> StagedValue {
    if list.len(raw) <= inline {
        PageValue(take raw)
    } else {
        BlobBody(arc.new(take raw))
    }
}

fn staged_bytes(value: StagedValue) -> View[Bytes] in value {
    match value {
        PageValue(raw) => view raw,
        BlobBody(raw) => view raw,
    }
}

// Keep up to two operations in the draft. Larger drafts spill subsequent
// operations in insertion order.
type DataRows: shareable + send {
    count: u64,
    first: Inline[DataOp, 2],
    rest: List[DataOp]
}

fn new_data_rows() -> DataRows {
    let first: Inline[DataOp, 2] =[
        DataOp(key: list.new(), value: None),
        DataOp(key: list.new(), value: None),
    ]
    DataRows(count: 0, first: take first, rest: list.new())
}

fn data_row(rows: DataRows, slot: u64) -> View[DataOp] in rows {
    if slot < 2 {
        view rows.first[slot]
    } else {
        view rows.rest[slot - 2]
    }
}

fn push_data_row(mut rows: DataRows, take row: DataOp) {
    if rows.count < 2 {
        rows.first[rows.count] = take row
    } else {
        list.push(mut rows.rest, take row)
    }
    rows.count += 1
}

// A commit's rows by key. Up to SCANNED_OPS rows are found by scanning; the
// slot map is built only when a commit stages more.
type DataOps: shareable + send {
    rows: DataRows,
    slots: Map[Bytes, u64]
}

const SCANNED_OPS: u64 = 8

// A journaled draft starts open. The first inserted typed key supplies its row slot.
// The two sentinels are outside the range of slots in a bounded COMMIT frame.
const NO_FRAME_TAIL: u64 = 18446744073709551615

const OPEN_FRAME_TAIL: u64 = NO_FRAME_TAIL - 1

fn empty_ops() -> DataOps {
    DataOps(rows: new_data_rows(), slots: map.new())
}

// What enclosing transactions staged before a callback began, frozen so the
// callback shares it instead of copying it (MEM-30's copy idiom without the
// copy). Lookups check a transaction's own ops, then its layers newest first.
type Staged: shareable + send {
    ops: DataOps,
    stream_ops: DataOps,
    call: Option[CallSection]
}

fn op_slot(ops: DataOps, key: Bytes) -> Option[u64] {
    let n = ops.rows.count
    if n > SCANNED_OPS {
        return option.copied(map.get(ops.slots, key))
    }
    for slot in 0u64 .. n {
        if data_row(ops.rows, slot).key == key {
            return Some(slot)
        }
    }
    None
}

pub opaque scoped type Tx {
    store: StoreId,
    roots: Roots,
    ids: u64,
    private_from: u64,
    resident: u64,
    retain_old: bool,
    frame_tail: u64,
    reads: View[Log[Read]],
    issued: View[Log[u64]],
    refusal: Option[Capacity],
    frame_bytes: Option[u64],
    wrote: bool,
    ops: DataOps,
    info: CallInfo,
    // The streams section's ops (§1.8). `extra_bytes` is that section with
    // its 5-byte head, when it has ops, plus the CALL section's bytes.
    stream_ops: DataOps,
    extra_bytes: u64,
    call: Option[CallSection],
    // Layers beneath `ops`, oldest first. The last `own` are this Tx's own
    // staged writes, frozen when it entered a callback; the rest are shared
    // with the transactions it runs inside. `rows` and `streams` count the
    // distinct keys staged across `ops` and every layer: a key's slot is the
    // one it took when first staged, and a new key takes the next.
    below: List[Arc[Staged]],
    own: u64,
    rows: u64,
    streams: u64
}

pub opaque type Snapshot: shareable + send {
    store: StoreId,
    open: u64,
    branch: u32,
    head: u64,
    roots: Roots
}

/// The main-branch snapshot recovered by a read-only open.
pub opaque type ReadOnly: shareable + send {
    snapshot: Snapshot
}

pub fn read_only_table[K, V](reader: ReadOnly, take name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Shape[K, V], Error] {
    let s = view reader.snapshot
    let handle = catalog_handle(s.store, s.roots.catalog, false, take name, take key, take value)?
    Ok(shape(handle))
}

pub fn read_only_get[K, V](reader: ReadOnly, t: Shape[K, V], key: K) -> Result[Option[V], Error] {
    get(reader.snapshot, t, key)
}

pub fn read_only_snapshot(reader: ReadOnly) -> Snapshot {
    Snapshot(store: reader.snapshot.store, open: reader.snapshot.open, branch: reader.snapshot.branch, head: reader.snapshot.head, roots: share_roots(reader.snapshot.roots))
}

pub opaque type ByteRows: send {
    cursor: PageRange
}

pub opaque scoped type ViewRows {
    cursor: List[std.page.Cursor],
    prefix: Bytes,
    high: Bytes,
    slot: Option[u64]
}

/// Mix a SplitMix64 seed after adding the generator stride with wrapping arithmetic.
pub fn splitmix64(x: u64) -> u64 {
    let mut z = int.wrapping_add(x, 0x9E3779B97F4A7C15u64)
    z = int.wrapping_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9u64)
    z = int.wrapping_mul(z ^ (z >> 27), 0x94D049BB133111EBu64)
    z ^ (z >> 31)
}

fn call_info(id: StoreId, b: u32, v: u64, wall: u64, previous: u64) -> CallInfo {
    CallInfo(id: CallId(store: id, branch: b, version: v), at: if wall < previous {
        previous
    } else {
        wall
    }, seed: splitmix64(splitmix64(splitmix64(splitmix64(id.hi) ^ id.lo) ^ int.widen(b)) ^ v))
}

fn same(a: StoreId, b: StoreId) -> bool {
    a.hi == b.hi && a.lo == b.lo
}

fn make_id(r: Random) -> StoreId {
    let mut raw: Bytes = list.with_capacity(16)
    host.random(r, mut raw)
    StoreId(hi: list.word_le(raw, 0), lo: list.word_le(raw, 8))
}

pub fn memory(c: Clock, r: Random, o: Options) -> Db {
    memory_at(c, make_id(r), o)
}

fn memory_at(c: Clock, id: StoreId, o: Options) -> Db {
    let mut db = empty_db(c, id, o)
    list.push(mut db.heads, main_head(empty_roots(), 0, 0))
    take db
}

fn empty_db(c: Clock, id: StoreId, o: Options) -> Db {
    Db(store: id, fence: 0, disk: None, clock: c, heads: list.new(), branch_names: map.new(), pins: list.new(), record_bytes: branch_record_bytes("main"), next_pin: 0, next_branch: 1, next_node: 0, next_table: 1, file_seq: 1, file_end: 72, frame_seq: 0, resident: 0, page_resident: 0, changes: 0, settled: 0, ceiling: o.resident_limit, checkpointed: 0, admits: map.new())
}

pub type Accounts {
    logical: u64,
    exact: bool,
    frames: u64,
    journal: u64,
    resident: u64
}

pub fn accounts(db: Db) -> Accounts {
    let (frames, journal) = match db.disk { Some(state) => (state.inflight, state.uncovered), None => (0u64, 0u64) }
    Accounts(logical: db.resident, exact: !retaining(db) || db.changes == db.settled, frames: frames, journal: journal, resident: db.page_resident)
}

pub fn fence_level(db: Db) -> u32 {
    db.fence
}

pub fn is_disk(db: Db) -> bool {
    match db.disk { Some(_) => true, None => false }
}

fn disk_state(db: Db) -> View[DiskState] in db {
    match db.disk {
        Some(state) => view state,
        None => fail("store: a disk store is required"),
    }
}

fn edit_disk[R](mut connection: Option[DiskState], edit: scoped fn(mut DiskState) -> R) -> R {
    match connection {
        Some(mut state) => edit(mut state),
        None => fail("store: a disk store is required"),
    }
}

fn write_disk[R, T](mut connection: Option[DiskState], take value: T, edit: scoped fn(mut DiskState, take T) -> R) -> R {
    match connection {
        Some(mut state) => edit(mut state, take value),
        None => fail("store: a disk store is required"),
    }
}

fn journal_poison(db: Db) -> Option[IoError] {
    match db.disk { Some(state) => state.poison, None => None }
}

pub fn identity(db: Db) -> StoreId {
    db.store
}

pub fn main_branch(db: Db) -> Branch {
    Branch(store: db.store, id: 0)
}

pub fn snapshot(db: Db) -> Snapshot {
    head_snapshot(db, 0)
}

pub fn snapshot_of(db: Db, b: Branch) -> Result[Snapshot, Error] {
    let i = branch_index(db, b)?
    Ok(head_snapshot(db, i))
}

fn same_name(a: String, b: String) -> bool {
    string.as_bytes(a) == string.as_bytes(b)
}

fn checked_name(name: String) -> Result[String, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    named(name)
}

pub fn branch(db: Db, name: String) -> Option[Branch] {
    if same_name(db.heads[0u64].name, name) {
        return Some(main_branch(db))
    }
    match map.get(db.branch_names, name) {
        Some(id) => Some(Branch(store: db.store, id: id)),
        None => None,
    }
}

fn pin_index(db: Db, name: String) -> u64 {
    for k in 0u64 .. list.len(db.pins) {
        if same_name(db.pins[k].name, name) {
            return k
        }
    }
    list.len(db.pins)
}

pub fn pinned(db: Db, name: String) -> Option[Snapshot] {
    let k = pin_index(db, name)
    if k == list.len(db.pins) {
        return None
    }
    let p = db.pins[k]
    Some(Snapshot(store: db.store, open: open_number(db), branch: p.branch, head: p.version, roots: share_roots(p.roots)))
}

// Section 1.9 and 1.12: fork and pin take only a Snapshot of this open, whose
// node ids this open issued.
fn this_open(db: Db, s: Snapshot) -> Result[(), Error] {
    if !same(s.store, db.store) || s.open != open_number(db) {
        return Error(Foreign)
    }
    Ok(())
}

// A cut-made operation reserves its holder storage before the cut and
// changes the installed holder records only after publication.
fn cut_install(mut db: Db, take planned: HolderDelta) -> Result[Ticket, Error] waits {
    if is_disk(db) {
        return disk_cut_state(mut db, take planned, seal_page_manifest_file)
    }
    prepare_holder_slot(mut db, planned)?
    let proposed = disk_allocation(scoped fn() -> Result[State, Error] {
        capacity(state_with_delta(db, planned))
    })?
    let admission = match planned {
        AddHead(_, _) => true,
        AddPin(_) => true,
        _ => false
    }
    let (live, pages) = memory_cut_accounts(proposed)?
    if admission {
        over_ceiling(live, db.ceiling)?
    }
    let commit_ticket = record_memory_cut(mut db, live, pages)
    install_holder_delta(mut db, take planned)
    Ok(commit_ticket)
}

fn branch_record_bytes(name: String) -> u64 {
    143 + string.byte_len(name)
}

fn pin_record_bytes(name: String) -> u64 {
    122 + string.byte_len(name)
}

fn check_manifest_addition(db: Db, extra: u64) -> Result[(), Error] {
    if extra > META_LIMIT - db.record_bytes {
        Error(Limit(Manifest))
    } else {
        Ok(())
    }
}

pub fn fork(mut db: Db, name: String, from: Snapshot) -> Result[(Branch, Ticket), Error] waits {
    this_open(db, from)?
    journal_poll(mut db)?
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    if let Some(_) = branch(db, name) {
        return Error(Exists(named(name)?))
    }
    let id = db.next_branch
    if id == 4294967295 {
        return Error(Limit(Ids))
    }
    check_manifest_addition(db, branch_record_bytes(name))?
    // A Snapshot carries no wall time; the branch it was taken on, if it is
    // still live, gives the at its CallInfo continues from (section 1.7).
    let mut at = db.heads[0].at
    let mut live: Option[u64] = None
    for slot in 0u64 .. list.len(db.heads) {
        let h = db.heads[slot]
        if h.id != from.branch {
            continue
        }
        at = h.at
        if h.head == from.head && tree_stamp(h.roots.collections) == tree_stamp(from.roots.collections) && tree_stamp(h.roots.streams) == tree_stamp(from.roots.streams) && tree_stamp(h.roots.catalog) == tree_stamp(from.roots.catalog) {
            live = Some(slot)
        }
        break
    }
    if let Some(parent) = live {
        return fork_live(mut db, name, parent)
    }
    db.next_branch += 1
    let (take head, take indexed_name) = disk_allocation(scoped fn() -> Result[(Head, String), Error] {
        Ok((Head(id: id, name: string.from(name), parent: from.branch, forked_at: from.head, roots: share_roots(from.roots), head: from.head, at: at, following: None), string.from(name)))
    })?
    let commit_ticket = cut_install(mut db, AddHead(take head, take indexed_name))?
    Ok((Branch(store: db.store, id: id), commit_ticket))
}

fn fork_live(mut db: Db, name: String, parent: u64) -> Result[(Branch, Ticket), Error] waits {
    let size = 34 + string.byte_len(name)
    let disk = is_disk(db)
    if disk {
        if let Some(over) = journal_refusal(disk_state(db).uncovered, size, disk_state(db).options.journal_limit) {
            return Error(Full(Journal(over)))
        }
    }
    let id = db.next_branch
    let (take head, take indexed_name, take frame) = disk_allocation(scoped fn() -> Result[(Head, String, Option[Bytes]), Error] {
        let source = db.heads[parent]
        let head = Head(id: id, name: string.from(name), parent: source.id, forked_at: source.head, roots: share_roots(source.roots), head: source.head, at: source.at, following: None)
        let frame: Option[Bytes] = if disk {
            let context = DiskContext(store: db.store, role: 2, seq: db.file_seq)
            Some(capacity(encode_fork(context, db.file_end, head))?)
        } else {
            None
        }
        Ok((take head, string.from(name), take frame))
    })?
    capacity(map.try_reserve(mut db.branch_names, 1))?
    capacity(list.try_reserve(mut db.heads, 1))?
    let store = db.store
    let opened = open_number(db)
    if disk {
        let preceding = Ticket(store: store, open: opened, mark: Journal(db.frame_seq, 0, 0))
        durable(mut db, preceding)?
    }
    db.next_branch += 1
    let exact = !retaining(db) || db.changes == db.settled
    let sequence = if let Some(take raw) = take frame {
        db.file_end += size
        db.frame_seq += 1
        write_disk(mut db.disk, take raw, scoped fn(mut state: DiskState, take frame_bytes: Bytes) { state.pending = Some(take frame_bytes) })
        handoff(mut db)?
        db.frame_seq
    } else {
        db.changes + 1
    }
    let fork_ticket = Ticket(store: store, open: opened, mark: Journal(sequence, id, head.head))
    if disk {
        durable(mut db, fork_ticket)?
    }
    install_head(mut db, take head, take indexed_name)
    db.changes += 1
    if exact {
        db.settled = db.changes
    }
    match maybe_checkpoint(mut db) {
        Ok(()) => (),
        Error(Limit(Ids)) => (),
        Error(take problem) => return Error(take problem),
    }
    Ok((Branch(store: store, id: id), fork_ticket))
}

// AA1: a fast-forward of main to b, exactly when b forked from main at main's
// current version; b is then deleted. Any other case is Diverged(b).
pub fn adopt(mut db: Db, b: Branch) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    // AA1: a branch that is not live (deleted, or adopted and so deleted) is
    // no fork of main at main's version, so it is Diverged like any other.
    let i = match branch_index(db, b) {
        Ok(found) => found,
        Error(Missing(_)) => return Error(Diverged(b.id)),
        Error(take e) => return Error(take e)
    }
    if i == 0 || db.heads[i].parent != 0 || db.heads[0].head != db.heads[i].forked_at {
        return Error(Diverged(b.id))
    }
    let merged = ProposedMain(roots: share_roots(db.heads[i].roots), head: db.heads[i].head, at: db.heads[i].at, tables: db.next_table)
    let publication = capacity(prepare_publication(db, 0, merged.head, merged.roots))?
    let commit_ticket = cut_install(mut db, ReplaceMain(take merged, Some(i)))?
    publish(take publication)
    Ok(commit_ticket)
}

// Main is not deletable: it is Missing("branch") like an id that is not live.
pub fn delete_branch(mut db: Db, b: Branch) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, b)?
    if i == 0 {
        return Error(Missing("branch"))
    }
    cut_install(mut db, RemoveHead(i))
}

pub fn pin(mut db: Db, name: String, s: Snapshot) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    this_open(db, s)?
    let owned = checked_name(name)?
    if pin_index(db, name) != list.len(db.pins) {
        return Error(Exists(take owned))
    }
    check_manifest_addition(db, pin_record_bytes(name))?
    let serial = db.next_pin
    let Some(following) = int.checked_add(serial, 1) else {
        return Error(Limit(Ids))
    }
    db.next_pin = following
    let kept = Pin(name: take owned, branch: s.branch, version: s.head, serial: serial, roots: share_roots(s.roots))
    cut_install(mut db, AddPin(take kept))
}

pub fn unpin(mut db: Db, name: String) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let k = pin_index(db, name)
    if k == list.len(db.pins) {
        return Error(Missing(named(name)?))
    }
    cut_install(mut db, RemovePin(k))
}

pub fn version(s: Snapshot) -> u64 {
    s.head
}

pub fn follow(mut db: Db, b: Branch) -> Result[Latest[Snapshot], Error] {
    healthy(db)?
    let i = branch_index(db, b)?
    if let Some(h) = db.heads[i].following {
        return Ok(latest.handle(h))
    }
    let root = arc.new(head_snapshot(db, i))
    let h = latest.new(take root)
    db.heads[i].following = Some(latest.handle(h))
    Ok(take h)
}

type Publication {
    followed: Option[(Latest[Snapshot], Arc[Snapshot])]
}

// The followed snapshot is allocated before the commit, so publishing it
// after the commit cannot fail.
fn prepare_publication(db: Db, i: u64, head: u64, roots: Roots) -> Result[Publication, Capacity] {
    let followed = match db.heads[i].following {
        Some(handle) => Some((latest.handle(handle), arc.new(snapshot_from(db, i, head, roots)))),
        None => None
    }
    Ok(Publication(followed: take followed))
}

fn publish(take publication: Publication) {
    let Publication(followed: take followed) = take publication
    if let Some((take handle, take root)) = take followed {
        latest.publish(handle, take root)
    }
}

pub type Receipt {
    ticket: Ticket,
    reply: Bytes
}

pub type Stop = Raised(u32) | OutOfSteps(u64) | OutOfBytes(Capacity)

fn append_be(mut raw: Bytes, value: u64, width: u64) -> Result[(), Capacity] {
    for i in 0u64 .. width {
        list.push(mut raw, int.truncate(value >> int.truncate(8 * (width - 1 - i))))
    }
    Ok(())
}

pub type Plan {
    n_e: u64,
    s_e: u64,
    reply_max: u64
}

pub type CallReserve {
    retained: u64,
    steps: u64
}

// AM5. The body isolate's cause cell is the only allocation outside E.
// A finalized issued ID takes one loop latch, and its log cell is eight bytes.
const CALL_CAUSE_BYTES: u64 = 32

// MEM-30 calls on the longest path outside the body's scope: draft_call (1),
// the isolate (2), and log finish twice plus finish_stage (3).
const CALL_FIXED_STEPS: u64 = 6

const ISSUED_ID_BYTES: u64 = 8

pub fn call_reserves(plan: Plan) -> Option[CallReserve] {
    let Some(retained) = int.checked_add(plan.n_e, CALL_CAUSE_BYTES) else {
        return None
    }
    let Some(fixed) = int.checked_add(plan.s_e, CALL_FIXED_STEPS) else {
        return None
    }
    let Some(steps) = int.checked_add(fixed, plan.n_e / ISSUED_ID_BYTES) else {
        return None
    }
    Some(CallReserve(retained: retained, steps: steps))
}

pub type ServeError = Before(Error, Option[Pending]) | After(Error)

pub type Reserve = Resident | Claim

pub opaque type Pending {
    completion: Completion,
    record: Option[CallRecord],
    attempted: CallInfo,
    would_reply: Option[Bytes],
}

pub type Served = Committed(Receipt) | Kept(Receipt) | Failed(Pending, Stop) | NoRoom(Pending, StoreCapacity)

type ServeReply = KeptReply(Bytes) | StoreFailure(Error) | BodyStop(Stop)

pub fn next_call_info(db: Db) -> CallInfo {
    call_info(db.store, 0, db.heads[0].head + 1, host.wall_ms(db.clock), db.heads[0].at)
}

pub fn untried(take complete: Completion, take rec: Option[CallRecord], attempted: CallInfo) -> Pending {
    Pending(completion: take complete, record: take rec, attempted: attempted, would_reply: None)
}

fn registered_completion(db: Db, complete: Completion) -> Result[(), ServeError] {
    if !same(db.store, complete.admitted.store) || open_number(db) != complete.admitted.open {
        return Error(Before(Foreign, None))
    }
    if let Some(raw) = get_page_row(db.heads[0].roots.streams, complete.stream) {
        let state = serve_before(stream_state(raw))?
        if state.p == complete.p && state.state == 1 && state.digest == complete.request {
            return Ok(())
        }
    }
    Error(Before(Missing("reply"), None))
}

fn serve_before[R](take result: Result[R, Error]) -> Result[R, ServeError] {
    match take result {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(Before(take problem, None)),
    }
}

fn serve_after(take result: Result[(), Error]) -> Result[(), ServeError] {
    match take result {
        Ok(()) => Ok(()),
        Error(take problem) => Error(After(take problem)),
    }
}

fn cause_number(causes: Causes) -> u32 {
    for cause in causes {
        return match cause.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity(_) => 7u32,
            OutOfTime => 8u32
        }
    }
    0u32
}

fn save_reply(mut tx: Tx, complete: Completion, output: Bytes, rec: Option[CallRecord], settlement: Option[Settlement]) -> Result[(), Error] {
    let size = if let Some(_) = tx.frame_bytes {
        match rec {
            Some(value) => call_section_bytes(value, match settlement { Some(_) => true, None => false }),
            None => 0u64,
        }
    } else {
        0u64
    }
    let (take key, take value) = reply_row(tx, complete.stream, complete.p, output)?
    stream_write(mut tx, take key, take value, size)
}

fn stage_reply(mut tx: Tx, complete: Completion, rec: Option[CallRecord], reply_max: u64, body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[Bytes, ServeReply] {
    let returned = body(mut tx)
    if let Some(problem) = tx.refusal {
        tx.refusal = None
        return Error(BodyStop(OutOfBytes(problem)))
    }
    let (success, take output) = match take returned {
        Ok(take payload) => (true, take payload),
        Error(take payload) => (false, take payload),
    }
    if list.len(output) > reply_max {
        return Error(BodyStop(OutOfBytes(Capacity(requested: list.len(output), available: reply_max))))
    }
    match save_reply(mut tx, complete, output, rec, None) {
        Ok(()) => (),
        Error(Full(Allocation(problem))) => return Error(BodyStop(OutOfBytes(problem))),
        Error(take problem) => return Error(StoreFailure(take problem)),
    }
    if success {
        Ok(take output)
    } else {
        Error(KeptReply(take output))
    }
}

pub fn serve(mut db: Db, take complete: Completion, plan: Plan, take rec: Option[CallRecord], body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[Served, ServeError] waits {
    serve_before(journal_poll(mut db))?
    serve_before(healthy(db))?
    registered_completion(db, complete)?
    serve_before(check_completion_record(complete, rec))?
    let attempted = next_call_info(db)
    let Some(grant) = call_reserves(plan) else {
        return Error(Before(Limit(Transaction), None))
    }
    let metered = metered_draft(db, complete, attempted, plan, grant, rec, body)
    let DraftedCall(stage: take draft, next_id: next_id) = match take metered {
        Error(AdmissionBytes(problem)) => return Error(Before(Full(Allocation(problem)), None)),
        Error(DraftStopped(stop)) => return Ok(Failed(untried(take complete, take rec, attempted), stop)),
        Ok(take draft) => take draft,
    }
    db.next_node = next_id
    let pending_run = Pending(completion: take complete, record: take rec, attempted: attempted, would_reply: None)
    match take draft {
        Ran(take staged) => finish_served(mut db, take pending_run, take staged, false),
        Over(Stopped(limit)) => Ok(Failed(take pending_run, OutOfSteps(limit.steps))),
        Over(Failed(causes)) => Ok(Failed(take pending_run, Raised(cause_number(causes)))),
        Over(Refused(Allocation(problem))) => Ok(Failed(take pending_run, OutOfBytes(problem))),
        Over(Aborted(Undone(value: BodyStop(stop), ..))) => Ok(Failed(take pending_run, stop)),
        Over(Aborted(Undone(value: StoreFailure(take problem), ..))) => Error(Before(take problem, None)),
        _ => fail("store: missing staged reply"),
    }
}

fn served_value(take result: Result[Bytes, ServeReply]) -> Bytes {
    match take result {
        Ok(take output) => take output,
        Error(KeptReply(take output)) => take output,
        _ => fail("store: invalid staged reply"),
    }
}

fn finish_served(mut db: Db, take pending_run: Pending, take staged: Ran[Bytes, ServeReply], retry: bool) -> Result[Served, ServeError] waits {
    let ready = serve_before(settle_draft(mut db, 0, take staged))?
    match take ready {
        OverLimit(_, Journal(problem)) => {
            let pending = if retry {
                Some(take pending_run)
            } else {
                None
            }
            Error(Before(Full(Journal(problem)), take pending))
        },
        OverLimit(take rejected, problem) => {
            let Ran(value: take would_be, ..) = take rejected
            let mut held = take pending_run
            held.would_reply = Some(served_value(take would_be))
            Ok(NoRoom(take held, problem))
        },
        Ready(take accepted, take publication) => {
            let committed = commit_prepared(mut db, 0, take accepted, take publication)
            serve_after(handoff(mut db))?
            serve_after(maybe_checkpoint(mut db))?
            match take committed {
                Committed(Done(value: take output, ticket: committed_at, ..)) => Ok(Committed(Receipt(ticket: committed_at, reply: take output))),
                Aborted(Undone(value: KeptReply(take output), ticket: Some(committed_at))) => Ok(Kept(Receipt(ticket: committed_at, reply: take output))),
                _ => fail("store: staged reply was lost"),
            }
        },
    }
}

pub fn conclude(mut db: Db, take pending_run: Pending, take output: Bytes, reserve: Reserve) -> Result[Served, ServeError] waits {
    if let Claim = reserve {
        return Error(Before(Missing("claim"), None))
    }
    serve_before(journal_poll(mut db))?
    serve_before(healthy(db))?
    registered_completion(db, pending_run.completion)?
    serve_before(check_completion_record(pending_run.completion, pending_run.record))?
    let now = host.wall_ms(db.clock)
    let attempted = pending_run.attempted
    let way = match pending_run.would_reply {
        Some(_) => 2u8,
        None => 1u8
    }
    let settlement: Option[Settlement] = if attempted.id.version == 0 {
        None
    } else {
        Some(Settlement(way: way, base: attempted.id.version - 1, at: attempted.at, seed: attempted.seed))
    }
    let keep: Option[fn(ServeReply) -> bool] = None
    let draft = stage_call(mut db, 0, now, None, keep, pending_run.record, settlement, scoped fn(mut tx: Tx) -> Result[Bytes, ServeReply] {
        let held: Bytes = clone(output)
        let moved = take held
        match save_reply(mut tx, pending_run.completion, output, pending_run.record, settlement) {
            Ok(()) => Ok(take moved),
            Error(Full(Allocation(problem))) => Error(BodyStop(OutOfBytes(problem))),
            Error(take problem) => Error(StoreFailure(take problem)),
        }
    })
    match take draft {
        Ran(take staged) => finish_served(mut db, take pending_run, take staged, true),
        Over(Refused(problem)) => Ok(NoRoom(take pending_run, problem)),
        Over(Aborted(Undone(value: BodyStop(OutOfBytes(problem)), ..))) => Ok(NoRoom(take pending_run, Allocation(problem))),
        Over(Aborted(Undone(value: StoreFailure(take problem), ..))) => Error(Before(take problem, None)),
        _ => fail("store: invalid conclude draft"),
    }
}

pub fn info(mut tx: Tx) -> CallInfo {
    tx.info
}

pub fn run[R, A](mut db: Db, steps: Option[u64], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let b = main_branch(db)
    run_on(mut db, b, steps, body)
}

pub fn run_on[R, A](mut db: Db, b: Branch, steps: Option[u64], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    run_on_with_reply(mut db, b, steps, None, body)
}

// A runner abort may keep its reply. A runner refusal rolls back the whole Tx.
pub fn run_with_reply[R, A](mut db: Db, steps: Option[u64], keep_reply: fn(A) -> bool, body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let b = main_branch(db)
    run_on_with_reply(mut db, b, steps, Some(keep_reply), body)
}

fn run_on_with_reply[R, A](mut db: Db, b: Branch, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, b)?
    let outcome = append_transaction(mut db, i, steps, keep_reply, body)
    if let Ok(Refused(Journal(_))) = outcome {
        return take outcome
    }
    maybe_checkpoint(mut db)?
    take outcome
}

fn append_transaction[R, A](mut db: Db, i: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let wall = host.wall_ms(db.clock)
    let outcome: Result[Outcome[R, A], Error] = match stage(mut db, i, wall, steps, keep_reply, body) {
        Over(take o) => Ok(take o),
        Ran(take ran) => settle_admit(mut db, i, take ran)
    }
    handoff(mut db)?
    take outcome
}

fn handoff(mut db: Db) -> Result[(), Error] waits {
    match db.disk {
        Some(mut state) => if let Some(take raw) = replace(mut state.pending, None) {
            let sent = list.len(raw)
            if let Error(_) = channel.send(state.journal, Frame(take raw, db.frame_seq)) {
                state.poison = Some(Closed)
                return Error(Poisoned(Closed))
            }
            state.inflight += sent
            state.uncovered += sent
            state.since_cut += sent
        },
        None => (),
    }
    Ok(())
}

fn maybe_checkpoint(mut db: Db) -> Result[(), Error] waits {
    if is_disk(db) && disk_state(db).since_cut > disk_state(db).options.checkpoint_bytes {
        match cut_install(mut db, NoHolderChange) {
            Error(Full(_)) => (),
            Error(take problem) => return Error(take problem),
            Ok(_) => (),
        }
    }
    Ok(())
}

// A body whose commit the admission bound decides (section 1.11): one that
// returned Ok, or one that returned Error after a reply, whose commit keeps
// only its streams writes and its CALL section (F2).
type Ran[R, A] {
    value: Result[R, A],
    roots: Option[Roots],
    edits: DataRows,
    replies: DataRows,
    first_stamp: u64,
    prepared_roots: bool,
    live: u64,
    exact: bool,
    admits_rows: bool,
    frame: Option[Bytes],
    info: CallInfo,
    reads: List[Read]
}

type Stage[R, A] = Over(Outcome[R, A]) | Ran(Ran[R, A])

type Finished[R, A] = RolledBack(Outcome[R, A]) | Prepared(Prepared[R, A])

// A successful body or an application error with a reply to commit.
type Prepared[R, A] {
    outcome: Result[R, A],
    roots: Roots,
    live: u64,
    frame: Option[Bytes],
    ops: DataRows,
    frame_tail: u64,
    stream_ops: DataRows,
    first_stamp: u64,
    prepared_roots: bool,
    call: Option[CallSection]
}

// Runs the body on branch `i` inside isolate. Everything but a body that
// returned Ok, or Error after a reply, is final here.
fn stage[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    let no_record: Option[CallRecord] = None
    stage_call(mut db, i, wall, steps, keep_reply, no_record, None, body)
}

// The caller keeps owning the record so a refused publication can return it.
fn stage_call[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], rec: Option[CallRecord], settlement: Option[Settlement], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    let reads: Log[Read] = log.new()
    let issued: Log[u64] = log.new()
    let ci = call_info(db.store, db.heads[i].id, db.heads[i].head + 1, wall, db.heads[i].at)
    let caught = isolate(fn() -> Result[Finished[R, A], OutOfTime] {
        let perform = scoped fn() -> Finished[R, A] {
            let staged = draft_body(db, db.heads[i].roots, ci, keep_reply, reads, issued, body)
            let prepared = if let Some(_) = steps {
                match prepare_metered_pages(take staged) {
                    Ok(take ready) => take ready,
                    Error(Full(problem)) => RolledBack(Refused(problem)),
                    Error(_) => fail("store: invalid staged pages"),
                }
            } else {
                take staged
            }
            match frame_draft(db, ci, rec, settlement, take prepared) {
                Ok(take framed) => take framed,
                Error(problem) => RolledBack(Refused(Allocation(problem))),
            }
        }
        match steps {
            Some(s) => bound steps s {
                perform()
            },
            None => Ok(perform()),
        }
    })
    let consumed = log.finish(take issued)
    // An overrun under rollback_writes_on_overrun drops its stamps, so a later
    // reservation may log a lower end: the watermark is the highest. The
    // comparison takes no step, so each entry costs its loop step alone.
    for n in consumed {
        if n > db.next_node {
            db.next_node = n
        }
    }
    let seen = log.finish(take reads)
    match take caught {
        Error(c) => Over(Refused(Allocation(c))),
        Ok(Error(take cs)) => match raised_capacity(cs) {
            Some(c) => Over(Refused(Allocation(c))),
            None => Over(Failed(take cs)),
        },
        Ok(Ok(Error(e))) => Over(Stopped(e)),
        Ok(Ok(Ok(take f))) => finish_stage(ci, take f, take seen),
    }
}

// R1: a refused admission inside a body raises Capacity. The store reports it
// as the refusal it is (`Refused`), not as a fault, so it is never recorded.
fn raised_capacity(causes: Causes) -> Option[Capacity] {
    for cause in causes {
        return match cause.kind {
            Capacity(c) => Some(c),
            _ => None,
        }
    }
    None
}

fn draft_body[R, A](db: Db, base: Roots, ci: CallInfo, keep_reply: Option[fn(A) -> bool], reads: Log[Read], issued: Log[u64], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Finished[R, A] {
    let (frame_bytes, initial_tail) = match db.disk {
        Some(_) => (Some(42u64), OPEN_FRAME_TAIL),
        None => (None, NO_FRAME_TAIL),
    }
    let mut tx = Tx(store: db.store, roots: share_roots(base), ids: db.next_node, private_from: int.saturating_add(db.next_node, 1), resident: db.resident, retain_old: retaining(db), frame_tail: initial_tail, reads: view reads, issued: view issued, refusal: None, frame_bytes: frame_bytes, wrote: false, ops: empty_ops(), info: ci, stream_ops: empty_ops(), extra_bytes: 0, call: None, below: list.new(), own: 0, rows: 0, streams: 0)
    let outcome = body(mut tx)
    if tx.own != 0 {
        fold_own(mut tx)
    }
    if let Some(c) = tx.refusal {
        return RolledBack(Refused(Allocation(c)))
    }
    let value: Result[R, A] = match take outcome {
        Ok(take v) => Ok(take v),
        Error(take a) => {
            let keep = match keep_reply {
                Some(decide) => decide(a),
                None => true
            }
            if !keep || tx.stream_ops.rows.count == 0 {
                return RolledBack(Aborted(Undone(value: take a, ticket: None)))
            }
            // F2 keeps the streams and CALL writes with the old data roots.
            let live = match stream_live(db, base.streams, tx.stream_ops) {
                Ok(n) => n,
                Error(c) => return RolledBack(Refused(Allocation(c)))
            }
            tx.resident = live
            tx.roots.collections = share_page_tree(base.collections)
            tx.roots.catalog = share_page_tree(base.catalog)
            tx.ops = empty_ops()
            tx.rows = 0
            tx.frame_tail = NO_FRAME_TAIL
            Error(take a)
        }
    }
    let Tx(store: _, roots: take roots, ids: _, private_from: first_stamp, resident: live, retain_old: _, frame_tail: frame_tail, reads: _, issued: _, refusal: _, frame_bytes: _, wrote: _, ops: take ops, info: _, stream_ops: take stream_ops, extra_bytes: _, call: take call, ..) = take tx
    let DataOps(rows: take rows, slots: _) = take ops
    let DataOps(rows: take stream_rows, slots: _) = take stream_ops
    Prepared(Prepared(outcome: take value, roots: take roots, live: live, frame: None, ops: take rows, frame_tail: frame_tail, stream_ops: take stream_rows, first_stamp: first_stamp, prepared_roots: false, call: take call))
}

fn frame_draft[R, A](db: Db, ci: CallInfo, rec: Option[CallRecord], settlement: Option[Settlement], take finished: Finished[R, A]) -> Result[Finished[R, A], Capacity] {
    match take finished {
        RolledBack(take outcome) => Ok(RolledBack(take outcome)),
        Prepared(take ready) => {
            let mut prepared = take ready
            if is_disk(db) {
                prepared.frame = Some(encode_staged(ci, mut prepared.ops, prepared.frame_tail, prepared.stream_ops, prepared.call, rec, settlement, db.file_seq, db.file_end)?)
            }
            Ok(Prepared(take prepared))
        },
    }
}

// Charge page preparation to the existing call scope when the caller
// supplied a byte or step grant. Only application is outside that scope.
fn prepare_metered_pages[R, A](take finished: Finished[R, A]) -> Result[Finished[R, A], Error] {
    match take finished {
        RolledBack(take outcome) => Ok(RolledBack(take outcome)),
        Prepared(take staged) => {
            let mut prepared = take staged
            let first = prepared.first_stamp
            let mut draw = first
            materialize_rows(mut prepared.roots.collections, prepared.ops, first, mut draw)?
            materialize_rows(mut prepared.roots.streams, prepared.stream_ops, first, mut draw)?
            canonical_roots(mut prepared.roots)?
            prepared.prepared_roots = true
            Ok(Prepared(take prepared))
        },
    }
}

fn finish_stage[R, A](ci: CallInfo, take finished: Finished[R, A], take seen: List[Read]) -> Stage[R, A] {
    let prepared = match take finished {
        RolledBack(take o) => return Over(take o),
        Prepared(take tx) => take tx,
    }
    let Prepared(outcome: take outcome, roots: take roots, live: live, frame: take frame, ops: take operations, frame_tail: _, stream_ops: take stream_edits, first_stamp: first_stamp, prepared_roots: prepared_roots, call: _) = take prepared
    let mut admits_rows = stream_edits.count != 0
    if !admits_rows {
        for slot in 0u64 .. operations.count {
            let edit = data_row(operations, slot)
            if let Some(_) = edit.value {
                admits_rows = true;
                break
            }
        }
    }
    Ran(Ran(value: take outcome, roots: Some(take roots), edits: take operations, replies: take stream_edits, first_stamp: first_stamp, prepared_roots: prepared_roots, live: live, exact: false, admits_rows: admits_rows, frame: take frame, info: ci, reads: take seen))
}

type CallDraft {
    finished: Finished[Bytes, ServeReply],
    reads: Log[Read],
    issued: Log[u64]
}

type DraftedCall {
    stage: Stage[Bytes, ServeReply],
    next_id: u64
}

type DraftRefusal = AdmissionBytes(Capacity) | DraftStopped(Stop)

fn metered_draft(db: Db, complete: Completion, ci: CallInfo, plan: Plan, grant: CallReserve, rec: Option[CallRecord], body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[DraftedCall, DraftRefusal] {
    // These synchronous scopes cannot lose task room between admission and use.
    // Refund the admission before encoding, so frame bytes come from the head.
    let admitted = bound bytes grant.retained {
        ()
    }
    if let Error(problem) = admitted {
        return Error(AdmissionBytes(problem))
    }
    let metered = bound steps grant.steps {
        draft_call(db, complete, ci, plan, rec, body)
    }
    match take metered {
        Error(limit) => Error(DraftStopped(OutOfSteps(limit.steps))),
        Ok(take drafted) => Ok(take drafted),
    }
}

fn draft_call(db: Db, complete: Completion, ci: CallInfo, plan: Plan, rec: Option[CallRecord], body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> DraftedCall {
    let caught = isolate(fn() -> Result[Result[CallDraft, Capacity], OutOfTime] {
        let perform = scoped fn() -> Result[CallDraft, Capacity] {
            let keep: Option[fn(ServeReply) -> bool] = None
            let draft = bound bytes plan.n_e {
                let reads: Log[Read] = log.new()
                let issued: Log[u64] = log.new()
                let staged = draft_body(db, db.heads[0].roots, ci, keep, reads, issued, scoped fn(mut tx: Tx) -> Result[Bytes, ServeReply] {
                    stage_reply(mut tx, complete, rec, plan.reply_max, body)
                })
                let finished = match prepare_metered_pages(take staged) {
                    Ok(take ready) => take ready,
                    Error(Full(problem)) => RolledBack(Refused(problem)),
                    Error(take problem) => RolledBack(Aborted(Undone(value: StoreFailure(take problem), ticket: None))),
                }
                CallDraft(finished: take finished, reads: take reads, issued: take issued)
            }
            let CallDraft(finished: take result, reads: take reads, issued: take issued) = (take draft)?
            // Encoding spends the call's steps and the head's frame bytes.
            let framed = match frame_draft(db, ci, rec, None, take result) {
                Ok(take finished) => take finished,
                Error(problem) => RolledBack(Aborted(Undone(value: StoreFailure(Full(Allocation(problem))), ticket: None))),
            }
            Ok(CallDraft(finished: take framed, reads: take reads, issued: take issued))
        }
        bound steps plan.s_e {
            perform()
        }
    })
    let mut next_id = db.next_node
    let staged: Stage[Bytes, ServeReply] = match take caught {
        Error(problem) => Over(Refused(Allocation(problem))),
        Ok(Error(take causes)) => match raised_capacity(causes) {
            Some(problem) => Over(Refused(Allocation(problem))),
            None => Over(Failed(take causes)),
        },
        Ok(Ok(Error(limit))) => Over(Stopped(limit)),
        Ok(Ok(Ok(Error(problem)))) => Over(Refused(Allocation(problem))),
        Ok(Ok(Ok(Ok(take draft)))) => {
            let CallDraft(finished: take result, reads: take reads, issued: take issued) = take draft
            let consumed = log.finish(take issued)
            for n in consumed {
                if n > next_id {
                    next_id = n
                }
            }
            finish_stage(ci, take result, log.finish(take reads))
        },
    }
    // A fault or step stop drops the private roots, so none of their IDs escape.
    DraftedCall(stage: take staged, next_id: next_id)
}

// F2: the account after only the reply writes `ops`, against the base `streams` tree.
fn stream_live(db: Db, streams: PageTree, ops: DataOps) -> Result[u64, Capacity] {
    let retained = retaining(db)
    let mut live = db.resident
    for slot in 0u64 .. ops.rows.count {
        let operation = data_row(ops.rows, slot)
        let k = operation.key
        if let Some(raw) = operation.value {
            if !retained {
                if let Some(old) = get_page_row(streams, k) {
                    live = int.saturating_sub(live, entry(k, old))
                }
            }
            live = int.saturating_add(live, entry(k, staged_bytes(raw)))
        }
    }
    Ok(live)
}

fn journal_refusal(uncovered: u64, frame: u64, limit: u64) -> Option[Capacity] {
    if uncovered > limit || frame > limit - uncovered {
        Some(Capacity(requested: int.saturating_add(uncovered, frame), available: limit))
    } else {
        None
    }
}

fn over_bound[R, A](db: Db, ran: Ran[R, A]) -> bool {
    ran.admits_rows && ran.live > db.ceiling
}

fn wait_for_frame_room(mut db: Db, frame: Option[Bytes]) -> Result[(), Error] waits {
    if let Some(raw) = frame {
        let size = list.len(raw)
        while disk_state(db).inflight > FRAME_LIMIT - size {
            let acknowledged = journal_receive(db)
            journal_ack(mut db, take acknowledged)?
        }
    }
    Ok(())
}

// The admission bound, then the commit on branch `i` (section 1.11, run step 4).
type AdmittedDraft[R, A] = Ready(Ran[R, A], Publication) | OverLimit(Ran[R, A], StoreCapacity)

fn prepare_edited_roots[R, A](mut db: Db, i: u64, mut ran: Ran[R, A]) -> Result[(), Error] {
    if ran.prepared_roots || (ran.edits.count == 0 && ran.replies.count == 0) {
        return Ok(())
    }
    let (take candidate, after) = disk_allocation(scoped fn() -> Result[(Roots, u64), Error] {
        let Some(base) = view ran.roots else {
            fail("store: draft has no base roots")
        }
        let mut first = ran.first_stamp
        if tree_stamp(base.collections) != tree_stamp(db.heads[i].roots.collections) {
            let Some(fresh_start) = int.checked_add(db.next_node, 1) else {
                return Error(Limit(Ids))
            }
            first = fresh_start
        }
        let mut roots = share_roots(base)
        let mut stamp_out = first
        materialize_rows(mut roots.collections, ran.edits, first, mut stamp_out)?
        materialize_rows(mut roots.streams, ran.replies, first, mut stamp_out)?
        canonical_roots(mut roots)?
        Ok((take roots, stamp_out))
    })?
    db.next_node = order.max(db.next_node, after - 1)
    ran.roots = Some(take candidate)
    ran.prepared_roots = true
    Ok(())
}

fn prepare_direct_edit[R, A](mut db: Db, i: u64, mut ran: Ran[R, A]) -> Result[bool, Capacity] {
    if ran.prepared_roots {
        return Ok(false)
    }
    if let Some(_) = db.heads[i].following {
        return Ok(false)
    }
    let data_count = ran.edits.count
    let reply_count = ran.replies.count
    if data_count + reply_count == 0 || (reply_count != 0 && data_count + reply_count != 1) {
        return Ok(false)
    }
    let Some(take base) = replace(mut ran.roots, None) else {
        fail("store: draft has no base roots")
    }
    if tree_stamp(base.collections) != tree_stamp(db.heads[i].roots.collections) {
        ran.roots = Some(take base)
        return Ok(false)
    }
    let _ = take base
    let changed_roots = if data_count != 0 {
        direct_data_edits(mut db, i, ran)?
    } else {
        let op = data_row(ran.replies, 0u64)
        match view op.value {
            None => false,
            Some(raw) => {
                let inline = db.heads[i].roots.streams.inline
                let empty_key: Bytes = list.new()
                let mut stamps = ran.first_stamp
                std.page.put_inline_unique(mut db.heads[i].roots.streams.root, empty_key, op.key, staged_bytes(raw), inline, mut stamps)?
            },
        }
    }
    if !changed_roots {
        ran.roots = Some(share_roots(db.heads[i].roots))
    }
    Ok(changed_roots)
}

// Writes each row in place when every row is an inline put into a collection
// no other row of the commit touches. All rows are checked, with their leaf
// room reserved, before any is written, so a false or a refusal leaves the
// head's rows as they were. The paths take stamps in turn from first_stamp,
// inside the interval the body reserved for them.
fn direct_data_edits[R, A](mut db: Db, i: u64, ran: Ran[R, A]) -> Result[bool, Capacity] {
    let inline = db.heads[i].roots.collections.inline
    // put_inline_unique takes no stamp above this bound; each path is far shorter than 512.
    let rows = ran.edits.count
    if ran.first_stamp == 0 || rows > 1024 || ran.first_stamp > 18446744073709551103u64 - 512 * rows {
        return Ok(false)
    }
    for e in 0u64 .. rows {
        let op = data_row(ran.edits, e)
        let Some(raw) = view op.value else {
            return Ok(false)
        }
        let collection = list.slice(op.key, 0, 4)
        for prior in 0u64 .. e {
            if list.compare_bytes(list.slice(data_row(ran.edits, prior).key, 0, 4), collection) == Equal {
                return Ok(false)
            }
        }
        if !std.page.inline_unique_ready(mut db.heads[i].roots.collections.root, collection, list.slice(op.key, 4, list.len(op.key)), staged_bytes(raw), inline)? {
            return Ok(false)
        }
    }
    let mut stamps = ran.first_stamp
    for slot in 0u64 .. ran.edits.count {
        let op = data_row(ran.edits, slot)
        let Some(raw) = view op.value else {
            fail("store: a checked direct edit lost its value")
        }
        match std.page.put_inline_unique(mut db.heads[i].roots.collections.root, list.slice(op.key, 0, 4), list.slice(op.key, 4, list.len(op.key)), staged_bytes(raw), inline, mut stamps) {
            Ok(true) => (),
            _ => fail("store: a checked direct edit did not apply"),
        }
    }
    Ok(true)
}

fn prepare_run_commit[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[AdmittedDraft[R, A], Error] {
    if over_bound(db, ran) {
        let needed = ran.live
        return Ok(OverLimit(take ran, Resident(Capacity(requested: needed, available: db.ceiling))))
    }
    let mut draft = take ran
    match prepare_direct_edit(mut db, i, mut draft) {
        Ok(true) => return Ok(Ready(take draft, Publication(followed: None))),
        Ok(false) => (),
        Error(c) => return Ok(OverLimit(take draft, Allocation(c))),
    }
    match prepare_edited_roots(mut db, i, mut draft) {
        Ok(()) => (),
        Error(Full(problem)) => return Ok(OverLimit(take draft, problem)),
        Error(take problem) => return Error(take problem),
    }
    if let None = db.heads[i].following {
        return Ok(Ready(take draft, Publication(followed: None)))
    }
    let drafted_publication = disk_allocation(scoped fn() -> Result[Publication, Error] {
        let Some(roots) = view draft.roots else {
            fail("store: prepared draft has no roots")
        }
        capacity(prepare_publication(db, i, db.heads[i].head + 1, roots))
    })
    let publication = match take drafted_publication {
        Ok(take plan) => take plan,
        Error(Full(problem)) => return Ok(OverLimit(take draft, problem)),
        Error(take problem) => return Error(take problem),
    }
    Ok(Ready(take draft, take publication))
}

fn commit_prepared[R, A](mut db: Db, i: u64, take ran: Ran[R, A], take publication: Publication) -> Outcome[R, A] {
    let Ran(value: take value, roots: take roots, live: live, exact: exact, frame: take frame, info: ci, reads: take seen, ..) = take ran
    match db.disk {
        Some(mut state) => {
            db.file_end += match frame { Some(raw) => list.len(raw), None => 0u64 }
            state.pending = take frame
            db.frame_seq += 1
        },
        None => { let _ = take frame },
    }
    if let Some(take candidate) = take roots {
        let PageRoots(collections: take collections, streams: take streams, catalog: take catalog) = take candidate
        install_page_tree(mut db.heads[i].roots.collections, take collections)
        install_page_tree(mut db.heads[i].roots.streams, take streams)
        install_page_tree(mut db.heads[i].roots.catalog, take catalog)
    }
    db.resident = live
    db.heads[i].head += 1
    db.heads[i].at = ci.at
    db.changes += 1
    if exact {
        db.settled = db.changes
    }
    publish(take publication)
    let sent_sequence = if !is_disk(db) {
        db.changes
    } else {
        db.frame_seq
    }
    let commit_ticket = Ticket(store: db.store, open: open_number(db), mark: Journal(sent_sequence, db.heads[i].id, db.heads[i].head))
    match take value {
        Ok(take v) => Committed(Done(value: take v, ticket: commit_ticket, info: ci, reads: take seen)),
        Error(take a) => Aborted(Undone(value: take a, ticket: Some(commit_ticket)))
    }
}

fn draft_row_account(db: Db, i: u64, proposed: Roots) -> Result[u64, Error] {
    disk_allocation(scoped fn() -> Result[u64, Error] {
        let mut roots: List[Roots] = list.with_capacity(list.len(db.heads) + list.len(db.pins))
        for slot in 0u64 .. list.len(db.heads) {
            let root = if slot == i {
                share_roots(proposed)
            } else {
                share_roots(db.heads[slot].roots)
            }
            list.push(mut roots, take root)
        }
        for held in db.pins {
            list.push(mut roots, share_roots(held.roots))
        }
        Ok(page_row_account(roots))
    })
}

// AP15: an over-bound retained-root draft is admitted on its proposed union.
// If settling old charges rotates the journal, rebind the staged frame.
fn settle_draft[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[AdmittedDraft[R, A], Error] waits {
    if is_disk(db) {
        let refusal = match ran.frame {
            Some(raw) => journal_refusal(disk_state(db).uncovered, list.len(raw), disk_state(db).options.journal_limit),
            None => None,
        }
        if let Some(overflow) = refusal {
            return Ok(OverLimit(take ran, Journal(overflow)))
        }
    }
    if !over_bound(db, ran) || !retaining(db) {
        wait_for_frame_room(mut db, ran.frame)?
        return prepare_run_commit(mut db, i, take ran)
    }
    let mut settled = take ran
    match prepare_edited_roots(mut db, i, mut settled) {
        Ok(()) => (),
        Error(Full(problem)) => return Ok(OverLimit(take settled, problem)),
        Error(take problem) => return Error(take problem),
    }
    let counted = {
        let Some(roots) = view settled.roots else {
            fail("store: settled draft has no roots")
        }
        draft_row_account(db, i, roots)
    }
    let live = match take counted {
        Ok(live) => live,
        Error(Full(problem)) => return Ok(OverLimit(take settled, problem)),
        Error(take problem) => return Error(take problem),
    }
    settled.live = live
    settled.exact = true
    let checked = prepare_run_commit(mut db, i, take settled)?
    let (take admitted, take publication) = match take checked {
        Ready(take ready, take plan) => (take ready, take plan),
        OverLimit(take rejected, problem) => return Ok(OverLimit(take rejected, problem)),
    }
    let mut draft = take admitted
    if db.settled != db.changes {
        match cut_install(mut db, NoHolderChange) {
            Ok(_) => {},
            Error(Full(c)) => return Ok(OverLimit(take draft, c)),
            Error(take e) => return Error(take e)
        }
        if let Some(take frame) = replace(mut draft.frame, None) {
            let mut raw = take frame
            if let Error(c) = seal_frame(mut raw, DiskContext(store: db.store, role: 2, seq: db.file_seq), db.file_end) {
                return Ok(OverLimit(take draft, Allocation(c)))
            }
            draft.frame = Some(take raw)
        }
    }
    wait_for_frame_room(mut db, draft.frame)?
    Ok(Ready(take draft, take publication))
}

fn settle_admit[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[Outcome[R, A], Error] waits {
    let checked = settle_draft(mut db, i, take ran)?
    match take checked {
        Ready(take draft, take publication) => {
            Ok(commit_prepared(mut db, i, take draft, take publication))
        },
        OverLimit(_, c) => Ok(Refused(c)),
    }
}

pub fn durable(mut db: Db, t: Ticket) -> Result[(), Error] waits {
    let _ = durable_groups(mut db, t)?
    Ok(())
}

/// The journal's sync notices, taken once: one coalesced () after each group sync or
/// failure, and the channel closes when the journal worker ends. A store without a
/// journal returns None; its tickets are durable when committed.
pub fn sync_notices(mut db: Db) -> Option[Receiver[()]] {
    match db.disk { Some(mut state) => replace(mut state.synced, None), None => None }
}

/// `durable` without waiting: whether t's commit is synced now. A journal that ended
/// without an ack is terminal, as in journal_receive.
pub fn durable_now(mut db: Db, t: Ticket) -> Result[bool, Error] {
    if !same(db.store, t.store) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if let Some(e) = journal_poison(db) {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if is_disk(db) {
            disk_wait_cut(db, generation)?
            return Ok(true)
        }
    }
    let _ = journal_poll_groups(mut db)?
    if covered(db, t.mark) {
        return Ok(true)
    }
    let pending = match db.disk { Some(state) => channel.try_receive(state.acks), None => return Ok(true) }
    match take pending {
        Ok(take ack) => journal_ack(mut db, take ack)?,
        Error(Empty) => {},
        Error(Closed) => journal_ack(mut db, Broken(Closed))?,
    }
    Ok(covered(db, t.mark))
}

// The worker sends one Journaled ack after each successful group sync.
fn durable_groups(mut db: Db, t: Ticket) -> Result[u64, Error] waits {
    if !same(db.store, t.store) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if let Some(e) = journal_poison(db) {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if is_disk(db) {
            disk_wait_cut(db, generation)?
            return Ok(0)
        }
    }
    let mut groups = journal_poll_groups(mut db)?
    if is_disk(db) {
        while !covered(db, t.mark) {
            let ack = journal_receive(db)
            journal_ack(mut db, take ack)?
            groups += 1
        }
    }
    Ok(groups)
}

fn covered(db: Db, mark: Mark) -> bool {
    match mark {
        Journal(n, _, _) => match db.disk { Some(state) => state.journaled >= n, None => n == 0 },
        Cut(n) => db.checkpointed >= n
    }
}

pub fn close(take db: Db) -> Result[(), Error] waits {
    let mut owned = take db
    if !is_disk(owned) { return Ok(()) }
    let mut failure: Option[Error] = None
    if let None = journal_poison(owned) {
        let last_frame = Ticket(store: owned.store, open: open_number(owned), mark: Journal(owned.frame_seq, 0, 0))
        if let Error(take e) = durable(mut owned, last_frame) { failure = Some(take e) }
    }
    let connection = replace(mut owned.disk, None)
    let DiskState(journal: take frames, acks: take acknowledgements, journal_task: take writer, journal_idle_task: take timer, lock: take lock, poison: fault, written: take notices, written_send: take notice_to, ..) = option.unwrap(take connection)
    let _ = take timer
    let _ = take frames
    let mut poison = fault
    let remaining: Option[Receiver[Ack]] = if let Some(_) = poison {
        let _ = take acknowledgements
        None
    } else {
        Some(take acknowledgements)
    }
    match task.join(take writer) {
        Ok(Error(Io(e))) => if let None = poison { poison = Some(e) },
        Ok(Error(take e)) => if let None = failure { failure = Some(take e) },
        Ok(Ok(())) => (),
        Error(_) => if let None = poison { poison = Some(Closed) },
    }
    if let Some(receiver) = remaining {
        while let Ok(ack) = channel.try_receive(receiver) {
            if let Broken(e) = ack {
                if let None = poison { poison = Some(e) }
            }
        }
    }
    let _ = take notices
    let _ = take notice_to
    if let Error(e) = host.close(take lock) {
        if let None = poison { poison = Some(e) }
    }
    match poison {
        Some(e) => Error(Poisoned(e)),
        None => match take failure {
            Some(take e) => Error(take e),
            None => Ok(()),
        },
    }
}

fn close_ack(db: Db) -> Option[Ack] {
    let Some(state) = view db.disk else { return None }
    match channel.try_receive(state.acks) {
        Ok(ack) => Some(ack),
        Error(_) => None,
    }
}

fn capacity[T](take r: Result[T, Capacity]) -> Result[T, Error] {
    match take r {
        Ok(take value) => Ok(take value),
        Error(c) => Error(Full(Allocation(c)))
    }
}

fn copied(raw: Bytes) -> Result[Bytes, Error] {
    Ok(clone(raw))
}

fn prefix(id: u32) -> Result[Bytes, Error] {
    prefixed(id, 0, false)
}

// The 4-byte big-endian id, in a buffer with room for `rest` more bytes.
fn prefixed(id: u32, rest: u64, tail: bool) -> Result[Bytes, Error] {
    let mut p: Bytes = if tail {
        bytebuf.with_tail(4 + rest)
    } else {
        list.with_capacity(4 + rest)
    }
    list.put_word_be(mut p, id)
    Ok(take p)
}

// One allocation: the key is appended into the prefix's spare capacity.
fn logical_key(id: u32, key: Bytes) -> Result[Bytes, Error] {
    let mut p = prefixed(id, list.len(key), false)?
    list.append(mut p, key)
    Ok(take p)
}

fn round8(n: u64) -> u64 {
    ((n + 7) / 8) * 8
}

fn entry(key: Bytes, val: Bytes) -> u64 {
    62 + round8(list.len(key)) + round8(list.len(val))
}

pub fn body_capacity(mut tx: Tx, problem: Capacity) {
    tx.refusal = Some(problem)
}

// Reserve the stamp interval before a page edit can allocate. The log
// keeps the high watermark even if the body exits under a capacity failure.
fn reserve_ids(mut tx: Tx, height: u64) -> Result[u64, Error] {
    let Some(end) = int.checked_add(tx.ids, 6 * height + 2) else {
        return Error(Limit(Ids))
    }
    log.append(tx.issued, end)
    let first = tx.ids + 1
    tx.ids = end
    Ok(first)
}

fn note_read(tx: Tx, take read: Read) -> Result[(), Error] {
    log.append(tx.reads, take read)
    Ok(())
}

fn fetch_logical(tx: Tx, take key: Bytes) -> Option[View[Bytes]] in tx {
    let found = transaction_row(tx, key)
    log.append(tx.reads, Point(take key))
    found
}

fn apply_put(mut tx: Tx, take p: Bytes, take val: Bytes, tail: bool) -> Result[(), Error] {
    let charge = entry(p, val)
    let (old_charge, height) = {
        let Some(child) = std.page.collection_child(tx.roots.collections.root, list.slice(p, 0, 4)) else {
            return Error(Stale(list.word_be(p, 0)))
        }
        // Both retention modes find the previous charge, so a body takes the
        // same steps on a live store and on a replay fork that retains rows;
        // the selection takes none.
        let previous = match op_slot(tx.ops, p) {
            Some(slot) => match data_row(tx.ops.rows, slot).value {
                Some(value) => entry(p, staged_bytes(value)),
                None => 0,
            },
            None => {
                // The newest layer that staged the key wins.
                let mut beneath: Option[u64] = None
                for layer in tx.below {
                    if let Some(slot) = op_slot(layer.ops, p) {
                        beneath = Some(match data_row(layer.ops.rows, slot).value {
                            Some(value) => entry(p, staged_bytes(value)),
                            None => 0,
                        })
                    }
                }
                match beneath {
                    Some(found) => found,
                    None => match std.page.lookup(child, list.slice(p, 4, list.len(p))) {
                        Some(value) => entry(p, value),
                        None => 0,
                    },
                }
            },
        }
        let old = if tx.retain_old {
            0u64
        } else {
            previous
        }
        let child_depth: u64 = int.widen(std.page.level(std.page.image_of(child)))
        (old, tree_height(tx.roots.collections) + child_depth + 1)
    }
    let _ = reserve_ids(mut tx, height)?
    let value = stage_value(take val, tx.roots.collections.inline)
    let slot_order = save_data_op(mut tx.ops, tx.below, false, mut tx.rows, take p, Some(take value))
    if tail {
        tx.frame_tail = slot_order
    }
    tx.resident = int.saturating_add(int.saturating_sub(tx.resident, old_charge), charge)
    tx.wrote = true
    Ok(())
}

fn delete_refund(tx: Tx, key: Bytes) -> Option[u64] {
    match transaction_row(tx, key) {
        Some(v) => {
            // As in apply_put: both retention modes take the same steps.
            let previous = entry(key, v)
            Some(if tx.retain_old {
                0u64
            } else {
                previous
            })
        },
        None => None
    }
}

fn apply_delete(mut tx: Tx, take p: Bytes, refund: u64) -> Result[(), Error] {
    let height = collection_write_height(tx.roots.collections, p)
    let _ = reserve_ids(mut tx, height)?
    let _ = save_data_op(mut tx.ops, tx.below, false, mut tx.rows, take p, None)
    tx.resident = int.saturating_sub(tx.resident, refund)
    Ok(())
}

fn tree_height(tree: PageTree) -> u64 {
    let height: u64 = int.widen(std.page.level(std.page.image_of(tree.root)))
    height + 1
}

fn collection_write_height(tree: PageTree, key: Bytes) -> u64 {
    let map_height = tree_height(tree)
    let Some(root) = std.page.collection_child(tree.root, list.slice(key, 0, 4)) else {
        return map_height
    }
    let height: u64 = int.widen(std.page.level(std.page.image_of(root)))
    map_height + height + 1
}

// Stream value (section 1.8): position u64 LE, state u8 (1 Admitted,
// 2 Replied), then the reply when Replied.
// A request's identity at a stream position (STORE-SPEC v2.24 §1.8, AH1).
// Made only by request_digest or read from a streams value.
pub opaque type RequestDigest: key + shareable + send {
    b: Inline[u8, 32]
}

/// SHA-256 of u8 17 ‖ "hirsel.request.v1" ‖ u32 LE len(key) ‖ key ‖ u32 LE
/// len(args) ‖ args (§1.8): versioned, domain-separated, length-delimited.
/// Alloc: none. Cost: O(key + args).
pub fn request_digest(key: Bytes, args: Bytes) -> RequestDigest {
    let mut h = std.sha256.start()
    let tag = string.as_bytes("hirsel.request.v1")
    std.sha256.add_byte(mut h, int.truncate(list.len(tag)))
    std.sha256.add(mut h, tag, 0, list.len(tag))
    digest_part(mut h, key)
    digest_part(mut h, args)
    RequestDigest(b: std.sha256.finish(h))
}

fn digest_part(mut h: std.sha256.Sha256, part: Bytes) {
    let n = list.len(part)
    for i in 0u64 .. 4 {
        std.sha256.add_byte(mut h, int.truncate(n >> int.truncate(i * 8)))
    }
    std.sha256.add(mut h, part, 0, n)
}

// STORE AL2/AN2. An admit is 41 B, and a reply is followed by the exact
// reply bytes.
pub type Stored {
    reply: Bytes
}

fn stream_bytes(p: u64, request: RequestDigest, replied: bool, answer: Bytes) -> Result[Bytes, Error] {
    let size = if replied {
        list.len(answer)
    } else {
        0u64
    }
    let mut value: Bytes = list.with_capacity(41 + size)
    capacity(le(mut value, p, 8))?
    for byte in request.b {
        list.push(mut value, byte)
    }
    if replied {
        capacity(le(mut value, 2, 1))?
        list.append(mut value, answer)
    } else {
        capacity(le(mut value, 1, 1))?
    }
    Ok(take value)
}

fn word_be(raw: Bytes, offset: u64) -> u64 {
    let mut value = 0u64
    for i in 0u64 .. 8 {
        value = (value << 8) | int.widen(raw[offset + i])
    }
    value
}

fn stored_reply(raw: Bytes) -> Result[Stored, Error] {
    Ok(Stored(reply: copied(list.slice(raw, 41, list.len(raw)))?))
}

type StreamState {
    p: u64,
    digest: RequestDigest,
    state: u8
}

fn stream_state(raw: Bytes) -> Result[StreamState, Error] {
    if list.len(raw) < 41 || (raw[40] != 1 && raw[40] != 2) || (raw[40] == 1 && list.len(raw) != 41) {
        return Error(malformed(0))
    }
    let mut b: Inline[u8, 32] =[0u8; 32]
    for i in 0u64 .. 32 {
        b[i] = raw[8 + i]
    }
    Ok(StreamState(p: read_le(raw, 0, 8), digest: RequestDigest(b: b), state: raw[40]))
}

// One write to the streams tree, charged and sized like a data write.
fn stream_write(mut tx: Tx, take key: Bytes, take value: Bytes, call_size: u64) -> Result[(), Error] {
    if list.len(key) > 4096 {
        return Error(Limit(Key))
    }
    if list.len(value) > 1048576 {
        return Error(Limit(Value))
    }
    let mut extra = 0u64
    if let Some(frame_bytes) = tx.frame_bytes {
        let head = if tx.streams == 0 { 5u64 } else { 0u64 }
        let data_head = if tx.rows == 0 { 5u64 } else { 0u64 }
        extra = int.saturating_add(tx.extra_bytes - old_data_op_size(tx.stream_ops, tx.below, true, key), head + 9 + list.len(key) + list.len(value) + call_size)
        if int.saturating_add(frame_bytes, extra) - data_head - 16 > 16777280 {
            return Error(Limit(Transaction))
        }
    }
    let charge = entry(key, value)
    // As in apply_put: both retention modes take the same steps.
    let previous = match transaction_stream(tx, key) {
        Some(old) => entry(key, old),
        None => 0
    }
    let old_charge = if tx.retain_old {
        0u64
    } else {
        previous
    }
    let height = tree_height(tx.roots.streams)
    let _ = reserve_ids(mut tx, height)?
    let raw = stage_value(take value, tx.roots.streams.inline)
    let _ = save_data_op(mut tx.stream_ops, tx.below, true, mut tx.streams, take key, Some(take raw))
    tx.resident = int.saturating_add(int.saturating_sub(tx.resident, old_charge), charge)
    tx.extra_bytes = extra
    tx.wrote = true
    Ok(())
}

fn reply_row(tx: Tx, stream: Bytes, p: u64, output: Bytes) -> Result[(Bytes, Bytes), Error] {
    // The reply keeps the digest bound at p (AH1).
    let held = match transaction_stream(tx, stream) {
        Some(raw) => {
            let at = stream_state(raw)?
            if at.p == p && at.state == 1 {
                Some(at.digest)
            } else {
                None
            }
        },
        None => None
    }
    let d = match held {
        Some(d) => d,
        None => return Error(Missing("reply"))
    }
    let value = stream_bytes(p, d, true, output)?
    Ok((copied(stream)?, take value))
}

fn reply(mut tx: Tx, stream: Bytes, p: u64, take r: Bytes) -> Result[(), Error] {
    let (take key, take value) = reply_row(tx, stream, p, r)?
    stream_write(mut tx, take key, take value, 0)
}

pub opaque type Completion {
    admitted: Ticket,
    stream: Bytes,
    p: u64,
    request: RequestDigest
}

pub fn ticket(c: Completion) -> Ticket {
    c.admitted
}

pub type Admission = Admitted(Completion) | Duplicate(Stored) | Rejected(u64) | Abandoned(Completion) | RequestMismatch | HistoryUnavailable

// An Admitted(p) this open committed on main: a later admit of p while it is
// still unreplied answers Abandoned with this commit_ticket and commits nothing.
// `ticket` is None while the entry is only reserved (admit_commit), and a None
// entry answers nothing.
type OpenAdmit: shareable + send {
    p: u64,
    ticket: Option[Ticket]
}

pub fn admit(mut db: Db, stream: Bytes, p: u64, d: RequestDigest) -> Result[Admission, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let state = match get_page_row(db.heads[0].roots.streams, stream) {
        Some(raw) => Some(stream_state(raw)?),
        None => None
    }
    let at = match take state {
        Some(x) => x,
        // AE1: a new stream admits position 0 only.
        None => return if p == 0 {
            admit_commit(mut db, stream, 0, d, false)
        } else {
            Ok(Rejected(0))
        }
    }
    let latest = at.p
    if p < latest {
        // AH2: one state per stream keeps no digest below latest.
        return Ok(HistoryUnavailable)
    }
    if p > latest {
        // S7: latest + 1 only after latest has its reply.
        return if p == latest + 1 && at.state == 2 {
            admit_commit(mut db, stream, p, d, false)
        } else {
            Ok(Rejected(latest))
        }
    }
    // AH1: at latest the digest is compared before any other answer.
    if at.digest != d {
        return Ok(RequestMismatch)
    }
    if at.state == 2 {
        let r = match get_page_row(db.heads[0].roots.streams, stream) {
            Some(raw) => stored_reply(raw)?,
            None => return Error(malformed(0))
        }
        return Ok(Duplicate(take r))
    }
    let mine = match map.get(db.admits, stream) {
        Some(a) => if a.p == p {
            a.ticket
        } else {
            None
        },
        None => None
    }
    if let Some(t) = mine {
        return Ok(Abandoned(Completion(admitted: t, stream: copied(stream)?, p: p, request: d)))
    }
    // An earlier open's admit: re-commit, keeping the digest bound at p.
    admit_commit(mut db, stream, p, at.digest, true)
}

fn admit_commit(mut db: Db, stream: Bytes, p: u64, d: RequestDigest, abandoned: bool) -> Result[Admission, Error] waits {
    let held_stream = copied(stream)?
    let key = copied(stream)?
    // §1.8: a later admit of p in this open commits nothing, so the entry that
    // remembers this one is reserved before the commit. Without room the admit
    // is Full and commits nothing; the map is kept as it was.
    if !map.contains(db.admits, key) {
        capacity(map.try_reserve(mut db.admits, 1))?
    }
    let b = main_branch(db)
    let outcome = run_on(mut db, b, None, fn(mut tx: Tx) -> Result[(), Error] {
        let value = stream_bytes(p, d, false, list.new())?
        stream_write(mut tx, copied(stream)?, take value, 0)
    })?
    let admitted = match take outcome {
        Committed(done) => done.ticket,
        // Ruling 3: an admit over resident_limit is Full.
        Refused(c) => return Error(Full(c)),
        Aborted(Undone(value: take e, ticket: _)) => return Error(take e),
        // The body is the store's own, runs unbounded and does not fault.
        Failed(_) => return Error(Missing("admit")),
        Stopped(_) => return Error(Missing("admit"))
    }
    map.insert(mut db.admits, take key, OpenAdmit(p: p, ticket: Some(admitted)))
    let completion = Completion(admitted: admitted, stream: take held_stream, p: p, request: d)
    Ok(if abandoned {
        Abandoned(take completion)
    } else {
        Admitted(take completion)
    })
}

fn lower_bytes(id: u32, limit: Bound[Bytes], high: bool) -> Result[Bytes, Error] {
    match limit {
        Unbounded => prefix(if high {
            id + 1
        } else {
            id
        }),
        Included(k) => {
            let mut p = logical_key(id, k)?
            if high {
                list.push(mut p, 0u8)
            }
            Ok(take p)
        },
        Excluded(k) => {
            let mut p = logical_key(id, k)?
            if !high {
                list.push(mut p, 0u8)
            }
            Ok(take p)
        }
    }
}

fn byte_cursor(data: PageTree, take low: Bound[Bytes], high: Bytes) -> Result[ByteRows, Error] {
    let empty: Bytes = list.new()
    let (take start, inclusive) = match take low {
        Unbounded => (take empty, true),
        Included(take key) => (take key, true),
        Excluded(take key) => (take key, false),
    }
    let cursor = open_page_range(data, Some(take start), inclusive, false, Some(copied(high)?))?
    Ok(ByteRows(cursor: take cursor))
}

fn reverse_byte_cursor(data: PageTree, low: Bytes, high: Bytes) -> Result[ByteRows, Error] {
    let cursor = open_page_range(data, Some(copied(high)?), false, true, Some(copied(low)?))?
    Ok(ByteRows(cursor: take cursor))
}

fn next_bytes(mut rows: ByteRows) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
    next_page_range(mut rows.cursor)
}

fn scan_raw(s: Snapshot, id: u32, lo: Bound[Bytes], hi: Bound[Bytes]) -> Result[ByteRows, Error] {
    byte_cursor(s.roots.collections, Included(lower_bytes(id, lo, false)?), lower_bytes(id, hi, true)?)
}

// Codec-independent S1 law fixtures. Byte keys are fixed-width big endian.
fn key_word(n: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(8)
    for i in 0u64 .. 8 {
        list.push(mut b, int.truncate(n >> int.truncate((7 - i) * 8)))
    }
    b
}

fn test_db(c: Clock, cap: u64) -> Db {
    let mut opts = defaults()
    opts.resident_limit = cap
    memory_at(c, StoreId(hi: 1, lo: 2), opts)
}

// Stages one row in `ops` and returns its slot: `next_slot`, the next one, for a
// key new to the transaction, else OPEN_FRAME_TAIL. A key a layer beneath
// staged keeps its slot there, so `ops` holds the replacement uncounted.
fn save_data_op(mut ops: DataOps, below: List[Arc[Staged]], streams: bool, mut next_slot: u64, take key: Bytes, take value: Option[StagedValue]) -> u64 {
    if let Some(slot) = op_slot(ops, key) {
        if slot < 2 {
            ops.rows.first[slot].value = take value
        } else {
            ops.rows.rest[slot - 2].value = take value
        }
        return OPEN_FRAME_TAIL
    }
    let mut beneath = false
    for layer in below {
        let found = if streams {
            op_slot(layer.stream_ops, key)
        } else {
            op_slot(layer.ops, key)
        }
        if let Some(_) = found {
            beneath = true
        }
    }
    let at = next_slot
    if !beneath {
        next_slot += 1
    }
    let slot_order = ops.rows.count
    if slot_order == SCANNED_OPS {
        for earlier in 0u64 .. slot_order {
            map.insert(mut ops.slots, clone(data_row(ops.rows, earlier).key), earlier)
        }
    }
    if slot_order >= SCANNED_OPS {
        map.insert(mut ops.slots, clone(key), slot_order)
    }
    push_data_row(mut ops.rows, DataOp(key: take key, value: take value))
    if beneath {
        OPEN_FRAME_TAIL
    } else {
        at
    }
}

fn transaction_row(tx: Tx, key: Bytes) -> Option[View[Bytes]] in tx {
    if let Some(slot) = op_slot(tx.ops, key) {
        return match data_row(tx.ops.rows, slot).value {
            Some(raw) => Some(staged_bytes(raw)),
            None => None,
        }
    }
    if let Some(at) = newest_layer(tx.below, false, key) {
        let layer = view tx.below[at]
        if let Some(slot) = op_slot(layer.ops, key) {
            return match data_row(layer.ops.rows, slot).value {
                Some(raw) => Some(staged_bytes(raw)),
                None => None,
            }
        }
    }
    get_page_row(tx.roots.collections, key)
}

fn transaction_stream(tx: Tx, key: Bytes) -> Option[View[Bytes]] in tx {
    if let Some(slot) = op_slot(tx.stream_ops, key) {
        return match data_row(tx.stream_ops.rows, slot).value {
            Some(raw) => Some(staged_bytes(raw)),
            None => None,
        }
    }
    if let Some(at) = newest_layer(tx.below, true, key) {
        let layer = view tx.below[at]
        if let Some(slot) = op_slot(layer.stream_ops, key) {
            return match data_row(layer.stream_ops.rows, slot).value {
                Some(raw) => Some(staged_bytes(raw)),
                None => None,
            }
        }
    }
    get_page_row(tx.roots.streams, key)
}

// The newest layer that staged `key`, a deletion included.
fn newest_layer(below: List[Arc[Staged]], streams: bool, key: Bytes) -> Option[u64] {
    let mut newest: Option[u64] = None
    let mut at = 0u64
    for layer in below {
        let found = if streams {
            op_slot(layer.stream_ops, key)
        } else {
            op_slot(layer.ops, key)
        }
        if let Some(_) = found {
            newest = Some(at)
        }
        at += 1
    }
    newest
}

// Applies the rows in key order, the order their journal frame records and
// replay applies them, so a commit splits and merges pages as recovery does.
fn materialize_rows(mut tree: PageTree, operations: DataRows, first: u64, mut draw: u64) -> Result[(), Error] {
    let order = capacity(data_order(operations))?
    for slot_order in 0u64 .. operations.count {
        let op = ordered_row(operations, order, slot_order)
        match op.value {
            Some(PageValue(raw)) => put_page_row(mut tree, op.key, raw, first, mut draw)?,
            Some(BlobBody(raw)) => put_shared_page_row(mut tree, op.key, raw, first, mut draw)?,
            None => {
                let _ = remove_page_row(mut tree, op.key, first, mut draw)?
            },
        }
    }
    Ok(())
}

fn transaction_collection_pages(tx: Tx) -> Result[PageTree, Error] {
    let mut tree = share_page_tree(tx.roots.collections)
    let Some(first) = int.checked_add(tx.ids, 1) else {
        return Error(Limit(Ids))
    }
    let mut draw = first
    for layer in tx.below {
        materialize_rows(mut tree, layer.ops.rows, first, mut draw)?
    }
    materialize_rows(mut tree, tx.ops.rows, first, mut draw)?
    Ok(take tree)
}

// The frame bytes of the op staged for `key`, in `ops` or the newest layer.
fn old_data_op_size(ops: DataOps, below: List[Arc[Staged]], streams: bool, key: Bytes) -> u64 {
    if let Some(slot) = op_slot(ops, key) {
        return data_op_size(data_row(ops.rows, slot))
    }
    let mut size = 0u64
    for layer in below {
        let staged = if streams {
            view layer.stream_ops
        } else {
            view layer.ops
        }
        if let Some(slot) = op_slot(staged, key) {
            size = data_op_size(data_row(staged.rows, slot))
        }
    }
    size
}

fn data_op_size(operation: DataOp) -> u64 {
    let size = 5 + list.len(operation.key)
    match operation.value {
        None => size,
        Some(raw) => size + 4 + list.len(staged_bytes(raw)),
    }
}

fn le(mut out: Bytes, x: u64, width: u64) -> Result[(), Capacity] {
    match width {
        1 => {
            list.reserve(mut out, 1)
            Ok(list.push(mut out, int.truncate(x)))
        },
        2 => {
            let word: u16 = int.truncate(x)
            Ok(list.put_word_le(mut out, word))
        },
        4 => {
            let word: u32 = int.truncate(x)
            Ok(list.put_word_le(mut out, word))
        },
        8 => Ok(list.put_word_le(mut out, x)),
        _ => fail("store: invalid frame word width"),
    }
}

fn blob(mut out: Bytes, b: Bytes) -> Result[(), Capacity] {
    le(mut out, list.len(b), 4)?
    Ok(list.append(mut out, b))
}

type DataOrder = InOrder | ReversePair | SortedSlots(List[u64])

fn data_order(ops: DataRows) -> Result[DataOrder, Capacity] {
    let n = ops.count
    if n < 2 {
        return Ok(InOrder)
    }
    if n == 2 {
        return Ok(if list.compare_bytes(data_row(ops, 0).key, data_row(ops, 1).key) == Greater {
            ReversePair
        } else {
            InOrder
        })
    }
    let mut slots: List[u64] = list.new()
    list.try_reserve(mut slots, n)?
    for slot_order in 0u64 .. n {
        list.push(mut slots, slot_order)
    }
    list.sort(mut slots, scoped fn(a: u64, b: u64) -> Order {
        list.compare_bytes(data_row(ops, a).key, data_row(ops, b).key)
    })
    Ok(SortedSlots(take slots))
}

fn ordered_row(ops: DataRows, order: DataOrder, slot_order: u64) -> View[DataOp] in ops {
    let slot = match order {
        InOrder => slot_order,
        ReversePair => 1 - slot_order,
        SortedSlots(slots) => slots[slot_order],
    }
    data_row(ops, slot)
}

fn encode_data_ops(mut payload: Bytes, ops: DataRows, order: DataOrder) -> Result[(), Capacity] {
    le(mut payload, 0, 1)?
    le(mut payload, ops.count, 4)?
    for slot_order in 0u64 .. ops.count {
        let op = ordered_row(ops, order, slot_order)
        encode_data_op(mut payload, op.key, op.value)?
    }
    Ok(())
}

fn encode_data_op(mut payload: Bytes, key: Bytes, value: Option[StagedValue]) -> Result[(), Capacity] {
    match value {
        None => {
            le(mut payload, 2, 1)?;
            blob(mut payload, key)
        },
        Some(raw) => {
            le(mut payload, 1, 1)?;
            blob(mut payload, key)?;
            blob(mut payload, staged_bytes(raw))
        }
    }
}

fn encode_stream_op(mut payload: Bytes, operation: DataOp, call: Option[View[CallRecord]], settlement: Option[Settlement]) -> Result[(), Capacity] {
    if let (Some(raw), Some(record)) = (view operation.value, view call) {
        if operation.key == record.stream {
            le(mut payload, 3, 1)?
            blob(mut payload, operation.key)?
            blob(mut payload, staged_bytes(raw))?
            return encode_call(mut payload, record, settlement)
        }
    }
    encode_data_op(mut payload, operation.key, operation.value)
}

fn encode_stream_ops(mut payload: Bytes, ops: DataRows, call: Option[View[CallRecord]], settlement: Option[Settlement]) -> Result[(), Capacity] {
    le(mut payload, 1, 1)?
    le(mut payload, ops.count, 4)?
    let order = data_order(ops)?
    for slot_order in 0u64 .. ops.count {
        encode_stream_op(mut payload, ordered_row(ops, order, slot_order), call, settlement)?
    }
    Ok(())
}

fn encode_call(mut payload: Bytes, record: CallRecord, settlement: Option[Settlement]) -> Result[(), Capacity] {
    blob(mut payload, record.key)?
    blob(mut payload, record.args)?
    if let Some(revision) = record.revision {
        blob(mut payload, revision)?
    } else {
        le(mut payload, 0, 4)?
    }
    blob(mut payload, record.code)?
    match settlement {
        None => le(mut payload, 0, 1),
        Some(context) => {
            le(mut payload, int.widen(context.way), 1)?
            append_be(mut payload, context.base, 8)?
            append_be(mut payload, context.at, 8)?
            append_be(mut payload, context.seed, 8)
        }
    }
}

fn encode_staged(ci: CallInfo, mut ops: DataRows, tail: u64, streams: DataRows, call: Option[CallSection], rec: Option[CallRecord], settlement: Option[Settlement], seq: u64, offset: u64) -> Result[Bytes, Capacity] {
    if let Some(record) = rec {
        return encode_frame(ci, mut ops, tail, streams, Some(view record), settlement, seq, offset)
    }
    match call {
        Some(section) => encode_frame(ci, mut ops, tail, streams, Some(view section.record), section.settlement, seq, offset),
        None => encode_frame(ci, mut ops, tail, streams, None, None, seq, offset),
    }
}

fn encode_frame(ci: CallInfo, mut ops: DataRows, tail: u64, streams: DataRows, call: Option[View[CallRecord]], settlement: Option[Settlement], seq: u64, offset: u64) -> Result[Bytes, Capacity] {
    let data = ops.count != 0 || streams.count == 0
    let stream = streams.count != 0
    let sections = (if data {
        1u64
    } else {
        0u64
    }) + (if stream {
        1u64
    } else {
        0u64
    })
    let mut size = 21 + 5 * sections
    for slot in 0u64 .. ops.count {
        let operation = data_row(ops, slot)
        size += data_op_size(operation)
    }
    for slot in 0u64 .. streams.count {
        let operation = data_row(streams, slot)
        size += data_op_size(operation)
        if let (Some(_), Some(record)) = (view operation.value, view call) {
            if operation.key == record.stream {
                let shifted = match settlement {
                    Some(_) => true,
                    None => false
                }
                size += call_section_bytes(record, shifted)
            }
        }
    }
    let order = data_order(ops)?
    let room = 16 + size + BINDING_BYTES
    let mut out: Bytes = if tail == 0 {
        bytebuf.from_tail(mut ops.first[0].key, room)
    } else if tail == 1 {
        bytebuf.from_tail(mut ops.first[1].key, room)
    } else if tail < OPEN_FRAME_TAIL {
        bytebuf.from_tail(mut ops.rest[tail - 2].key, room)
    } else {
        list.with_capacity(room)
    }
    le(mut out, 0x0011, 2)?
    le(mut out, 1, 2)?
    le(mut out, size, 4)?
    le(mut out, 0, 8)?
    le(mut out, int.widen(ci.id.branch), 4)?
    le(mut out, ci.id.version, 8)?
    le(mut out, ci.at, 8)?
    le(mut out, sections, 1)?
    if data {
        encode_data_ops(mut out, ops, order)?
    }
    if stream {
        encode_stream_ops(mut out, streams, call, settlement)?
    }
    seal_frame(mut out, DiskContext(store: ci.id.store, role: 2, seq: seq), offset)?
    Ok(take out)
}

pub type RowSchemas: codec + shareable + send {
    key: Bytes,
    value: Bytes
}

pub opaque type Readers[V]: shareable + send {
    codec: std.codec.Codec[V],
    current: u16,
    older: List[Option[std.codec.Reader[V]]],
    schemas: Arc[RowSchemas]
}

type IndexOf[V]: send {
    id: u32,
    extract: own[send] fn(V, Option[u32], Bytes) -> Result[Bytes, Capacity]
}

pub opaque type Table[K, V]: send {
    store: StoreId,
    id: u32,
    epoch: u64,
    complete: bool,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    key: std.codec.Key[K],
    readers: Arc[Readers[V]],
    indexes: List[IndexOf[V]]
}

pub opaque type Shape[K, V]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    key: std.codec.Key[K],
    readers: Arc[Readers[V]]
}

pub opaque type Index[J, K, V]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    table: u32,
    key: std.codec.Key[J],
    primary: std.codec.Key[K],
    readers: Arc[Readers[V]]
}

// AB1: a table declared whole, for create_table and migrate. Each index keeps
// what the catalog stores (name, `code.identity` of `by`, key schema) and the
// erased extractor that builds its entries from V rows.
type IndexSpec[V]: send {
    name: String,
    by: Bytes,
    key: Bytes,
    extract: own[send] fn(V, Option[u32], Bytes) -> Result[Bytes, Capacity]
}

pub opaque type TableSpec[K, V]: send {
    name: String,
    key: std.codec.Key[K],
    value: std.codec.Codec[V],
    indexes: List[IndexSpec[V]]
}

pub fn spec[K, V](take name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> TableSpec[K, V] {
    TableSpec(name: take name, key: key, value: value, indexes: list.new())
}

// Encode the index key straight into the row key, between the optional
// collection prefix and the encoded primary key.
fn erase[J, V](by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[own[send] fn(V, Option[u32], Bytes) -> Result[Bytes, Capacity], Error] {
    let made: own[send] fn(V, Option[u32], Bytes) -> Result[Bytes, Capacity] = fn(v: V, collection: Option[u32], primary: Bytes) -> Result[Bytes, Capacity] {
        let j = (code.callable(by))(v)?
        let mut raw: Bytes = match collection {
            Some(id) => {
                let mut row: Bytes = list.with_capacity(12 + list.len(primary))
                list.put_word_be(mut row, id)
                take row
            },
            None => list.new(),
        }
        std.codec.encode_key(key, j, mut raw)
        list.append(mut raw, primary)
        Ok(take raw)
    }
    Ok(take made)
}

pub fn with_index[J, K, V](mut s: TableSpec[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[(), Error] {
    let owned = checked_name(name)?
    for ix in s.indexes {
        if same_name(ix.name, owned) {
            return Error(Exists(take owned))
        }
    }
    let schema = std.codec.key_schema(key) ?=> |_| Schema(0)
    let extract = erase(by, key)?
    let declared = IndexSpec(name: take owned, by: copied(code.identity(by))?, key: take schema, extract: take extract)
    Ok(list.push(mut s.indexes, take declared))
}

pub opaque type Rows[K, V]: send {
    cursor: ByteRows,
    table: u32,
    key: std.codec.Key[K],
    readers: Arc[Readers[V]],
    data: PageTree,
    skip: Option[own[send] fn(Bytes, mut u64) -> Result[(), std.codec.DecodeError]]
}

// A query only needs the selected incarnation and readers. The copy cannot
// write, since it does not carry the table's registered index extractors.
pub fn query_table[K, V](t: Table[K, V]) -> Table[K, V] {
    Table(store: t.store, id: t.id, epoch: t.epoch, complete: false, catalog_key: arc.share(t.catalog_key), catalog_page: arc.share(t.catalog_page), key: t.key, readers: arc.share(t.readers), indexes: list.new())
}

pub fn shape[K, V](t: Table[K, V]) -> Shape[K, V] {
    Shape(store: t.store, id: t.id, catalog_key: arc.share(t.catalog_key), catalog_page: arc.share(t.catalog_page), key: t.key, readers: arc.share(t.readers))
}

pub fn row_schemas[K, V](t: Shape[K, V]) -> Arc[RowSchemas] {
    arc.share(t.readers.schemas)
}

fn decoded[T](take r: Result[T, std.codec.DecodeError]) -> Result[T, Error] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(e) => Error(Decode(e))
    }
}

fn read_le(raw: Bytes, at: u64, width: u64) -> u64 {
    match width {
        1 => int.widen(raw[at]),
        2 => {
            let word: u16 = list.word_le(raw, at)
            int.widen(word)
        },
        4 => {
            let word: u32 = list.word_le(raw, at)
            int.widen(word)
        },
        8 => list.word_le(raw, at),
        _ => fail("store: invalid frame word width"),
    }
}

fn row_value[V](r: Readers[V], id: u32, raw: Bytes) -> Result[V, Error] {
    if list.len(raw) < 2 {
        return Error(Decode(Truncated(0)))
    }
    let number: u16 = int.truncate(read_le(raw, 0, 2))
    if number == r.current {
        return decoded(std.codec.decode_at(r.codec, raw, 2))
    }
    let n: u64 = int.widen(number)
    if n >= list.len(r.older) {
        return Error(Stale(id))
    }
    match r.older[n] {
        Some(old) => decoded(std.codec.read_at(old, raw, 2)),
        None => Error(Stale(id))
    }
}

fn encode_key[K](k: std.codec.Key[K], value: K) -> Result[Bytes, Error] {
    let mut raw: Bytes = list.new()
    std.codec.encode_key(k, value, mut raw)
    Ok(take raw)
}

fn typed_bound[K](k: std.codec.Key[K], limit: Bound[K]) -> Result[Bound[Bytes], Error] {
    match limit {
        Unbounded => Ok(Unbounded),
        Included(x) => Ok(Included(encode_key(k, x)?)),
        Excluded(x) => Ok(Excluded(encode_key(k, x)?))
    }
}

fn writable[K, V](tx: Tx, t: Table[K, V]) -> Result[(), Error] {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    if !t.complete {
        return Error(Stale(t.id))
    }
    match get_page_row(tx.roots.catalog, t.catalog_key) {
        Some(raw) => if read_le(raw, 1, 4) == int.widen(t.id) && read_le(raw, 9, 8) == t.epoch {
            Ok(())
        } else {
            Error(Stale(t.id))
        },
        None => Error(Stale(t.id))
    }
}

/// Borrow the stored schema tag and codec bytes, including any staged write.
pub fn fetch_bytes[K, V](tx: Tx, t: Shape[K, V], k: K) -> Result[Option[View[Bytes]], Error] in tx {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    readable(tx.roots, t.catalog_key, t.catalog_page, t.id)?
    let mut p: Bytes = list.with_capacity(12)
    list.put_word_be(mut p, t.id)
    std.codec.encode_key(t.key, k, mut p)
    Ok(fetch_logical(tx, take p))
}

pub fn fetch[K, V](tx: Tx, t: Shape[K, V], k: K) -> Result[Option[V], Error] {
    match fetch_bytes(tx, t, k)? {
        Some(raw) => Ok(Some(row_value(t.readers, t.id, raw)?)),
        None => Ok(None)
    }
}

type DataEdit = StoreRow(Bytes, Bytes) | RemoveRow(Bytes, u64)

type IndexEdits {
    first: Option[DataEdit],
    rest: List[DataEdit]
}

fn push_index_edit(mut edits: IndexEdits, take edit: DataEdit) {
    if let None = edits.first {
        edits.first = Some(take edit)
    } else {
        list.push(mut edits.rest, take edit)
    }
}

fn append_index_remove(tx: Tx, mut edits: IndexEdits, take key: Bytes, mut frame: Option[u64]) -> Result[(), Error] {
    if let Some(refund) = delete_refund(tx, key) {
        frame = edit_frame(tx.ops, tx.below, tx.extra_bytes, key, None, frame)?
        push_index_edit(mut edits, RemoveRow(take key, refund))
    }
    Ok(())
}

fn apply_edit(mut tx: Tx, take edit: DataEdit) -> Result[(), Error] {
    match take edit {
        StoreRow(take key, take raw) => apply_put(mut tx, take key, take raw, false),
        RemoveRow(take key, refund) => apply_delete(mut tx, take key, refund),
    }
}

fn apply_edits(mut tx: Tx, take edits: IndexEdits) -> Result[(), Error] {
    let IndexEdits(first: take first, rest: take rest) = take edits
    if let Some(take edit) = take first {
        apply_edit(mut tx, take edit)?
    }
    for take edit in take rest {
        apply_edit(mut tx, take edit)?
    }
    Ok(())
}

// Index IDs are distinct from the table ID and each other. Within one index,
// a delete and put are emitted only for distinct keys. Each planned edit can
// therefore check the original op table while carrying the cumulative frame size.
// A returned Error leaves all roots, accounting and issued IDs untouched.
fn put_impl[K, V](mut tx: Tx, t: Table[K, V], take p: Bytes, v: V, tail: bool) -> Result[(), Error] {
    // The schema tag and the codec's least length, so a fixed-width value encodes without growing.
    let mut raw: Bytes = list.new()
    let least = 2 + std.codec.least(t.readers.codec)
    let hint = if least <= 32 {
        least * 2
    } else {
        least
    }
    capacity(bytebuf.try_reserve_hint(mut raw, least, hint))?
    capacity(le(mut raw, int.widen(t.readers.current), 2))?
    std.codec.encode(t.readers.codec, v, mut raw) ?=> |_| Limit(Value)
    let mut frame = put_frame(tx, p, raw, tx.frame_bytes)?
    if list.len(t.indexes) == 0 {
        apply_put(mut tx, take p, take raw, tail)?
    } else {
        let previous = match transaction_row(tx, p) {
            Some(old) => Some(row_value(t.readers, t.id, old)?),
            None => None
        }
        let mut edits = IndexEdits(first: None, rest: list.new())
        for ix in t.indexes {
            let key = list.slice(p, 4, list.len(p))
            let index_row = capacity((ix.extract)(v, Some(ix.id), key))?
            if let Some(value) = previous {
                let old_row = capacity((ix.extract)(value, Some(ix.id), key))?
                if old_row == index_row {
                    continue
                }
                append_index_remove(tx, mut edits, take old_row, mut frame)?
            }
            let empty: Bytes = list.new()
            frame = put_frame(tx, index_row, empty, frame)?
            push_index_edit(mut edits, StoreRow(take index_row, take empty))
        }
        apply_put(mut tx, take p, take raw, tail)?
        apply_edits(mut tx, take edits)?
    }
    tx.frame_bytes = frame
    Ok(())
}

fn delete_impl[K, V](mut tx: Tx, t: Table[K, V], key: Bytes) -> Result[bool, Error] {
    let p = logical_key(t.id, key)?
    let (take old, refund) = {
        let raw = match transaction_row(tx, p) {
            Some(v) => v,
            None => return Ok(false)
        }
        let value = row_value(t.readers, t.id, raw)?
        // As in apply_put: both retention modes take the same steps.
        let previous = entry(p, raw)
        (take value, if tx.retain_old {
            0u64
        } else {
            previous
        })
    }
    let mut frame = tx.frame_bytes
    let mut edits = IndexEdits(first: None, rest: list.new())
    for ix in t.indexes {
        let row = capacity((ix.extract)(old, Some(ix.id), key))?
        append_index_remove(tx, mut edits, take row, mut frame)?
    }
    frame = edit_frame(tx.ops, tx.below, tx.extra_bytes, p, None, frame)?
    apply_edits(mut tx, take edits)?
    apply_delete(mut tx, take p, refund)?
    tx.frame_bytes = frame
    Ok(true)
}

pub fn range[K, V](tx: Tx, t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[RangeRows[K, V], Error] in tx {
    open_range(tx, t, lo, hi, false)
}

pub fn range_reverse[K, V](tx: Tx, t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[RangeRows[K, V], Error] in tx {
    open_range(tx, t, lo, hi, true)
}

fn open_range[K, V](tx: Tx, t: Shape[K, V], lo: Bound[K], hi: Bound[K], reverse: bool) -> Result[RangeRows[K, V], Error] in tx {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    readable(tx.roots, t.catalog_key, t.catalog_page, t.id)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    let tree = transaction_collection_pages(tx)?
    let cursor = if reverse {
        reverse_byte_cursor(tree, low, high)?
    } else {
        byte_cursor(tree, Included(copied(low)?), high)?
    }
    let rows = Rows(cursor: take cursor, table: t.id, key: t.key, readers: arc.share(t.readers), data: take tree, skip: None)
    Ok(RangeRows(rows: take rows, reads: tx.reads, low: take low, high: take high, reverse))
}

/// Borrow the stored schema tag and codec bytes from a snapshot.
pub fn get_bytes[K, V](s: Snapshot, t: Shape[K, V], k: K) -> Result[Option[View[Bytes]], Error] in s {
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let mut p = prefixed(t.id, 8, false)?
    std.codec.encode_key(t.key, k, mut p)
    Ok(get_page_row(s.roots.collections, p))
}

pub fn get[K, V](s: Snapshot, t: Shape[K, V], k: K) -> Result[Option[V], Error] {
    match get_bytes(s, t, k)? {
        Some(raw) => Ok(Some(row_value(t.readers, t.id, raw)?)),
        None => Ok(None)
    }
}

/// Open a forward cursor over the stored values in a snapshot.
pub fn scan_bytes[K, V](s: Snapshot, t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[ViewRows, Error] in s {
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    let id = prefix(t.id)?
    let mut cursor: List[std.page.Cursor] = list.new()
    if let Some(root) = std.page.collection_child(s.roots.collections.root, id) {
        let boundary: Bytes = clone(list.slice(low, 4, list.len(low)))
        list.push(mut cursor, std.page.cursor_open(root, Some(take boundary), true, false))
    }
    Ok(ViewRows(cursor: take cursor, prefix: take id, high: take high, slot: None))
}

/// Advance the cursor and return the next owned logical key.
pub fn next_view(mut c: ViewRows) -> Result[Option[Bytes], Error] {
    if list.len(c.cursor) != 0 {
        if let Some((take key, slot)) = std.page.cursor_next_key(mut c.cursor[0u64], c.prefix) {
            if key < c.high {
                c.slot = Some(slot)
                return Ok(Some(take key))
            }
        }
        let _ = list.pop(mut c.cursor)
    }
    c.slot = None
    Ok(None)
}

/// Borrow the current row's value. Traps if the cursor has no current row.
pub fn value_view(c: ViewRows) -> View[Bytes] in c {
    let Some(slot) = c.slot else {
        fail("store: no current view row")
    }
    let Some(raw) = std.page.cursor_value(c.cursor[0u64], slot) else {
        fail("store: invalid view row")
    }
    raw
}

pub fn scan[K, V](s: Snapshot, t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Rows[K, V], Error] {
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let cursor = scan_raw(s, t.id, typed_bound(t.key, lo)?, typed_bound(t.key, hi)?)?
    Ok(table_rows(s, t, take cursor))
}

pub fn scan_reverse[K, V](s: Snapshot, t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Rows[K, V], Error] {
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    let cursor = reverse_byte_cursor(s.roots.collections, low, high)?
    Ok(table_rows(s, t, take cursor))
}

pub fn count[K, V](s: Snapshot, t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[u64, Error] {
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    count_page_rows(s.roots.collections, t.id, low, high)
}

fn table_rows[K, V](s: Snapshot, t: Shape[K, V], take cursor: ByteRows) -> Rows[K, V] {
    Rows(cursor: take cursor, table: t.id, key: t.key, readers: arc.share(t.readers), data: share_page_tree(s.roots.collections), skip: None)
}

// RUNNER-SPEC §4 (R2): a Cover names data-tree key ranges (I1) without reading them. `key_span`
// gives the Span a fully consumed range over the same bounds covers.
pub fn key_span[K, V](t: Shape[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Read, Error] {
    Ok(Span(lower_bytes(t.id, typed_bound(t.key, lo)?, false)?, lower_bytes(t.id, typed_bound(t.key, hi)?, true)?))
}

// AG3: iterate the data-tree rows in [lo, hi) without keeping a second copy of the span.
pub fn open_span_changes(s: Snapshot, lo: Bytes, hi: Bytes) -> Result[ByteRows, Error] {
    byte_cursor(s.roots.collections, Included(copied(lo)?), hi)
}

pub fn next_span_change(mut rows: ByteRows) -> Result[Option[Change], Error] {
    match next_bytes(mut rows)? {
        Some((take k, take v)) => Ok(Some(Change(tree_key: take k, value: Some(take v)))),
        None => Ok(None),
    }
}

pub fn span_changes(s: Snapshot, lo: Bytes, hi: Bytes) -> Result[List[Change], Error] {
    let mut out: List[Change] = list.new()
    if hi <= lo {
        return Ok(take out)
    }
    let mut rows = open_span_changes(s, lo, hi)?
    while let Some(take row) = next_span_change(mut rows)? {
        list.push(mut out, take row)
    }
    Ok(take out)
}

// AG3: the value a publisher sends for a Change of t, in t's current codec without the u16
// schema prefix. An older number is read with its Reader and encoded again, because the old
// encoding may differ in length and layout. A key of another table (an index row's key
// included) is Missing("table").
pub fn published_value[K, V](t: Shape[K, V], c: Change) -> Result[Option[Bytes], Error] {
    let mine = prefix(t.id)?
    if list.len(c.tree_key) < 4 || list.slice(c.tree_key, 0, 4) != list.slice(mine, 0, 4) {
        return Error(Missing("table"))
    }
    let raw = match c.value {
        Some(v) => v,
        None => return Ok(None)
    }
    if list.len(raw) < 2 {
        return Error(Decode(Truncated(0)))
    }
    let number: u16 = int.truncate(read_le(raw, 0, 2))
    let mut out: Bytes = list.with_capacity(list.len(raw) - 2)
    if number == t.readers.current {
        list.append(mut out, list.slice(raw, 2, list.len(raw)))
        return Ok(Some(take out))
    }
    let v = row_value(t.readers, t.id, raw)?
    std.codec.encode(t.readers.codec, v, mut out) ?=> |_| Limit(Value)
    Ok(Some(take out))
}

// Whether a changed data-tree key falls in a read: equal to a Point, or in a Span's [low, high).
pub fn reads_key(r: Read, key: Bytes) -> bool {
    match r {
        Point(p) => p == key,
        Span(low, high) => low <= key && key < high
    }
}

fn indexed_rows[J, K, V](data: PageTree, ix: Index[J, K, V], take cursor: ByteRows) -> Result[Rows[K, V], Error] {
    let k = ix.key
    let start = 4u64
    let skip: own[send] fn(Bytes, mut u64) -> Result[(), std.codec.DecodeError] = fn(raw: Bytes, mut at: u64) -> Result[(), std.codec.DecodeError] {
        at = start
        let _ = std.codec.take_key_with(raw, mut at, k)?
        Ok(())
    }
    Ok(Rows(cursor: take cursor, table: ix.table, key: ix.primary, readers: arc.share(ix.readers), data: share_page_tree(data), skip: Some(take skip)))
}

fn prefix_after(raw: Bytes) -> Result[Bytes, Error] {
    let mut out = copied(raw)?
    let mut i = list.len(out)
    while i > 0 {
        i -= 1
        if out[i] != 255 {
            let byte = out[i] + 1
            let _ = list.set(mut out, i, byte)
            while list.len(out) > i + 1 {
                let _ = list.pop(mut out)
            }
            return Ok(take out)
        }
    }
    Ok(take out)
}

fn index_bound[J](ix: u32, key: std.codec.Key[J], limit: Bound[J], high: bool) -> Result[Bytes, Error] {
    match limit {
        Unbounded => prefix(if high {
            ix + 1
        } else {
            ix
        }),
        Included(x) => {
            let p = logical_key(ix, encode_key(key, x)?)?;
            if high {
                prefix_after(p)
            } else {
                Ok(take p)
            }
        },
        Excluded(x) => {
            let p = logical_key(ix, encode_key(key, x)?)?;
            if high {
                Ok(take p)
            } else {
                prefix_after(p)
            }
        }
    }
}

pub fn lookup[J, K, V](tx: Tx, ix: Index[J, K, V], lo: Bound[J], hi: Bound[J]) -> Result[IndexRows[K, V], Error] in tx {
    if !same(tx.store, ix.store) {
        return Error(Foreign)
    }
    readable(tx.roots, ix.catalog_key, ix.catalog_page, ix.id)?
    let low = index_bound(ix.id, ix.key, lo, false)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    note_read(tx, Span(copied(low)?, copied(high)?))?
    let tree = transaction_collection_pages(tx)?
    let cursor = byte_cursor(tree, Included(take low), high)?
    let rows = indexed_rows(tree, ix, take cursor)?
    Ok(IndexRows(rows: take rows, reads: tx.reads))
}

pub fn find[J, K, V](s: Snapshot, ix: Index[J, K, V], lo: Bound[J], hi: Bound[J]) -> Result[Rows[K, V], Error] {
    if !same(s.store, ix.store) {
        return Error(Foreign)
    }
    readable(s.roots, ix.catalog_key, ix.catalog_page, ix.id)?
    let cursor = byte_cursor(s.roots.collections, Included(index_bound(ix.id, ix.key, lo, false)?), index_bound(ix.id, ix.key, hi, true)?)?
    indexed_rows(s.roots.collections, ix, take cursor)
}

fn page_limits(limits: Limits) -> Result[(), Error] {
    if limits.rows == 0 {
        return Error(Missing("rows"))
    }
    if limits.byte_limit == 0 {
        return Error(Missing("bytes"))
    }
    Ok(())
}

pub fn scan_page[K, V](s: Snapshot, t: Shape[K, V], lo: Bound[K], hi: Bound[K], l: Limits) -> Result[Page[K, V], Error] {
    page_limits(l)?
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    let cursor = byte_cursor(s.roots.collections, Included(lower_bytes(t.id, typed_bound(t.key, lo)?, false)?), high)?
    read_page(s, t.id, take high, table_rows(s, t, take cursor), l)
}

pub fn find_page[J, K, V](s: Snapshot, ix: Index[J, K, V], lo: Bound[J], hi: Bound[J], l: Limits) -> Result[Page[K, V], Error] {
    page_limits(l)?
    if !same(s.store, ix.store) {
        return Error(Foreign)
    }
    readable(s.roots, ix.catalog_key, ix.catalog_page, ix.id)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    let cursor = byte_cursor(s.roots.collections, Included(index_bound(ix.id, ix.key, lo, false)?), high)?
    read_page(s, ix.id, take high, indexed_rows(s.roots.collections, ix, take cursor)?, l)
}

fn resume_here(s: Snapshot, store: StoreId, id: u32, catalog_key: Bytes, seen: Bytes, r: Resume, limits: Limits) -> Result[bool, Error] {
    if !same(s.store, store) {
        return Error(Foreign)
    }
    if !same(s.store, r.store) || s.open != r.open || s.branch != r.branch || s.head != r.version {
        return Ok(false)
    }
    if id != r.source {
        return Error(Stale(r.source))
    }
    page_limits(limits)?
    readable(s.roots, catalog_key, seen, id)?
    Ok(true)
}

pub fn scan_next[K, V](s: Snapshot, t: Shape[K, V], take r: Resume, l: Limits) -> Result[Resumed[K, V], Error] {
    if !resume_here(s, t.store, t.id, t.catalog_key, t.catalog_page, r, l)? {
        return Ok(Moved(s.head))
    }
    let Resume(store: _, open: _, branch: _, version: _, source: _, high: take high, last: take last) = take r
    let cursor = byte_cursor(s.roots.collections, Excluded(take last), high)?
    Ok(Paged(read_page(s, t.id, take high, table_rows(s, t, take cursor), l)?))
}

pub fn find_next[J, K, V](s: Snapshot, ix: Index[J, K, V], take r: Resume, l: Limits) -> Result[Resumed[K, V], Error] {
    if !resume_here(s, ix.store, ix.id, ix.catalog_key, ix.catalog_page, r, l)? {
        return Ok(Moved(s.head))
    }
    let Resume(store: _, open: _, branch: _, version: _, source: _, high: take high, last: take last) = take r
    let cursor = byte_cursor(s.roots.collections, Excluded(take last), high)?
    Ok(Paged(read_page(s, ix.id, take high, indexed_rows(s.roots.collections, ix, take cursor)?, l)?))
}

fn read_page[K, V](s: Snapshot, source: u32, take high: Bytes, take rows: Rows[K, V], limits: Limits) -> Result[Page[K, V], Error] {
    let mut cursor = take rows
    let mut page: List[(K, V)] = list.new()
    let mut byte_count = 0u64
    let mut last: Option[Bytes] = None
    while true {
        let found = next_bytes(mut cursor.cursor)?
        let (take key, take raw) = match take found {
            Some(take pair) => take pair,
            None => return Ok(Page(rows: take page, byte_count: byte_count, next: None))
        }
        if list.len(page) == limits.rows {
            break
        }
        let remaining: Option[u64] = if list.len(page) == 0 {
            None
        } else {
            Some(int.saturating_sub(limits.byte_limit, byte_count))
        }
        let row = advance_rows(cursor, key, raw, remaining, fn(observed: Bytes) -> Result[(), Error] {
            Ok(())
        })?
        match take row {
            Some((take value, size)) => {
                list.push(mut page, take value)
                byte_count += size
                last = Some(take key)
            },
            None => break
        }
    }
    let resume = match take last {
        Some(take key) => Some(Resume(store: s.store, open: s.open, branch: s.branch, version: s.head, source: source, high: take high, last: take key)),
        None => None
    }
    Ok(Page(rows: take page, byte_count: byte_count, next: take resume))
}

fn advance_rows[K, V](r: Rows[K, V], row_key: Bytes, raw: Bytes, remaining: Option[u64], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[((K, V), u64)], Error] {
    let mut at: u64 = 4
    if let Some(skip) = r.skip {
        match (skip)(row_key, mut at) {
            Ok(()) => {},
            Error(e) => return Error(Decode(e))
        }
    }
    let key = list.slice(row_key, at, list.len(row_key))
    let k = decoded(std.codec.decode_key(r.key, key))?
    if let Some(_) = r.skip {
        let primary = logical_key(r.table, key)?
        match get_page_row(r.data, primary) {
            Some(value) => finish_row(r, take k, primary, value, remaining, seen),
            None => Error(Stale(r.table))
        }
    } else {
        finish_row(r, take k, row_key, raw, remaining, seen)
    }
}

fn finish_row[K, V](r: Rows[K, V], take key: K, row_key: Bytes, raw: Bytes, remaining: Option[u64], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[((K, V), u64)], Error] {
    let size = list.len(row_key) + list.len(raw)
    if let Some(left) = remaining {
        if size > left {
            return Ok(None)
        }
    }
    let value = row_value(r.readers, r.table, raw)?
    seen(row_key)?
    Ok(Some(((take key, take value), size)))
}

type ValueSchema: shareable + send {
    number: u16,
    fingerprint: u64,
    schema: Bytes
}

type Catalog {
    kind: u8,
    id: u32,
    owner: u32,
    epoch: u64,
    key: Bytes,
    schemas: List[ValueSchema],
    next: u16,
    by: Bytes,
    revision: Bytes
}

fn malformed(at: u64) -> Error {
    Corrupt(Fault(file: "catalog", offset: at, why: Malformed))
}

fn take_le(raw: Bytes, mut at: u64, width: u64) -> Result[u64, Error] {
    if at > list.len(raw) || width > list.len(raw) - at {
        return Error(malformed(at))
    }
    let n = read_le(raw, at, width)
    at += width
    Ok(n)
}

fn take_blob(raw: Bytes, mut at: u64) -> Result[Bytes, Error] {
    let n = take_le(raw, mut at, 4)?
    if n > list.len(raw) - at {
        return Error(malformed(at))
    }
    let data = list.slice(raw, at, at + n)
    let out = copied(data)?
    at += n
    Ok(take out)
}

fn decode_catalog(raw: Bytes) -> Result[Catalog, Error] {
    let mut at: u64 = 0
    let kind: u8 = int.truncate(take_le(raw, mut at, 1)?)
    let id: u32 = int.truncate(take_le(raw, mut at, 4)?)
    let owner: u32 = int.truncate(take_le(raw, mut at, 4)?)
    let epoch = take_le(raw, mut at, 8)?
    if (kind != 1 && kind != 2) || id == 0 || epoch == 0 || (kind == 2 && owner == 0) {
        return Error(malformed(0))
    }
    let key = take_blob(raw, mut at)?
    let schema_count = take_le(raw, mut at, 2)?
    let mut schemas: List[ValueSchema] = list.new()
    for _ in 0u64 .. schema_count {
        let number: u16 = int.truncate(take_le(raw, mut at, 2)?)
        let fingerprint = take_le(raw, mut at, 8)?
        let schema = take_blob(raw, mut at)?
        list.push(mut schemas, ValueSchema(number: number, fingerprint: fingerprint, schema: take schema))
    }
    let next_number: u16 = int.truncate(take_le(raw, mut at, 2)?)
    let by = take_blob(raw, mut at)?
    let revision = take_blob(raw, mut at)?
    if at != list.len(raw) {
        return Error(malformed(at))
    }
    Ok(Catalog(kind: kind, id: id, owner: owner, epoch: epoch, key: take key, schemas: take schemas, next: next_number, by: take by, revision: take revision))
}

fn encode_catalog(c: Catalog) -> Result[Bytes, Error] {
    let mut raw: Bytes = list.new()
    capacity(le(mut raw, int.widen(c.kind), 1))?
    capacity(le(mut raw, int.widen(c.id), 4))?
    capacity(le(mut raw, int.widen(c.owner), 4))?
    capacity(le(mut raw, c.epoch, 8))?
    capacity(blob(mut raw, c.key))?
    capacity(le(mut raw, list.len(c.schemas), 2))?
    for schema in c.schemas {
        capacity(le(mut raw, int.widen(schema.number), 2))?
        capacity(le(mut raw, schema.fingerprint, 8))?
        capacity(blob(mut raw, schema.schema))?
    }
    capacity(le(mut raw, int.widen(c.next), 2))?
    capacity(blob(mut raw, c.by))?
    capacity(blob(mut raw, c.revision))?
    if list.len(raw) > 1048576 {
        return Error(Limit(Value))
    }
    Ok(take raw)
}

fn named(s: String) -> Result[String, Error] {
    Ok(string.from(s))
}

fn table_key(name: String) -> Result[Bytes, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    let mut k: Bytes = list.new()
    list.push(mut k, 1u8)
    list.append(mut k, string.as_bytes(name))
    Ok(take k)
}

fn index_prefix(id: u32) -> Result[Bytes, Error] {
    let mut k: Bytes = list.new()
    list.push(mut k, 2u8)
    list.append(mut k, prefix(id)?)
    Ok(take k)
}

fn catalog_index_key(id: u32, name: String) -> Result[Bytes, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    let mut k = index_prefix(id)?
    list.append(mut k, string.as_bytes(name))
    Ok(take k)
}

fn catalog_entry_in(catalog: PageTree, k: Bytes) -> Result[Catalog, Error] {
    match get_page_row(catalog, k) {
        Some(raw) => decode_catalog(raw),
        None => Error(Stale(0))
    }
}

fn stamp_after(last: u64) -> Result[u64, Error] {
    let Some(next_stamp) = int.checked_add(last, 1) else {
        return Error(Limit(Ids))
    }
    Ok(next_stamp)
}

fn define_store_collection(mut tree: PageTree, id: u32, kind: u8, mut last: u64) -> Result[(), Error] {
    let first = stamp_after(last)?
    let mut next_stamp = first
    define_collection(mut tree, id, kind, first, mut next_stamp)?
    canonical_tree(mut tree)?
    last = next_stamp - 1
    Ok(())
}

fn bulk_store_collection(mut tree: PageTree, id: u32, kind: u8, rows: List[std.page.Row], mut last: u64) -> Result[(), Error] {
    let first = stamp_after(last)?
    let mut next_stamp = first
    bulk_collection(mut tree, id, kind, rows, first, mut next_stamp)?
    canonical_tree(mut tree)?
    last = next_stamp - 1
    Ok(())
}

fn remove_store_row(mut tree: PageTree, key: Bytes, mut last: u64) -> Result[(), Error] {
    let first = stamp_after(last)?
    let mut next_stamp = first
    let _ = remove_page_row(mut tree, key, first, mut next_stamp)?
    canonical_tree(mut tree)?
    last = next_stamp - 1
    Ok(())
}

fn remove_store_collection(mut tree: PageTree, id: u32, mut last: u64) -> Result[u64, Error] {
    let key = prefix(id)?
    let charge = match std.page.lookup(tree.root, key) {
        Some(descriptor) => int.saturating_add(126, list.word_le(descriptor, 44)),
        None => 0u64,
    }
    let first = stamp_after(last)?
    let mut next_stamp = first
    let _ = drop_collection(mut tree, id, first, mut next_stamp)?
    canonical_tree(mut tree)?
    last = next_stamp - 1
    Ok(charge)
}

pub opaque type Schema {
    store: StoreId,
    catalog: PageTree
}

pub opaque type Migration {
    plan: SchemaPlan
}

pub opaque type StagedMigration {
    plan: SchemaPlan
}

type SchemaPlan: send {
    store: StoreId,
    roots: Roots,
    next_node: u64,
    next_table: u32,
    live: u64,
    ceiling: u64,
    retained: bool,
    changed: bool
}

fn schema_plan(db: Db) -> SchemaPlan {
    SchemaPlan(store: db.store, roots: share_roots(db.heads[0].roots), next_node: db.next_node, next_table: db.next_table, live: db.resident, ceiling: db.ceiling, retained: retaining(db), changed: false)
}

fn keep_schema(mut plan: SchemaPlan, take roots: Roots, live: u64, next_table: u32) -> Result[(), Error] {
    over_ceiling(live, plan.ceiling)?
    plan.roots = take roots
    plan.live = live
    plan.next_table = next_table
    plan.changed = true
    Ok(())
}

fn application_name(name: String) -> Result[(), Error] {
    if std.string.starts_with(name, "hirsel.") {
        return Error(Exists("reserved"))
    }
    Ok(())
}

pub fn with_schema[H](db: Db, make: StaticFn[fn(Schema) -> Result[H, Error]]) -> Result[H, Error] {
    healthy(db)?
    (code.callable(make))(Schema(store: db.store, catalog: share_page_tree(db.heads[0].roots.catalog)))
}

pub fn snapshot_schema(s: Snapshot) -> Schema {
    Schema(store: s.store, catalog: share_page_tree(s.roots.catalog))
}

pub fn tx_schema(tx: Tx) -> Schema {
    Schema(store: tx.store, catalog: share_page_tree(tx.roots.catalog))
}

type MigrationJob: send {
    plan: SchemaPlan,
    configure: StaticFn[fn(mut Migration) -> Result[(), Error] waits],
    answer: Sender[Result[SchemaPlan, Error]]
}

fn prepare_migration(take job: MigrationJob) -> () waits {
    let MigrationJob(plan: take plan, configure: configure, answer: take answer) = take job
    let mut working = Migration(plan: take plan)
    let result = (code.callable(configure))(mut working)
    let completed: Result[SchemaPlan, Error] = match take result {
        Ok(()) => {
            let Migration(plan: take committed) = take working
            Ok(take committed)
        },
        Error(take problem) => Error(take problem)
    }
    let _ = channel.send(answer, take completed)
}

pub fn stage_migration(db: Db, tasks: Tasks, configure: StaticFn[fn(mut Migration) -> Result[(), Error] waits]) -> Result[StagedMigration, Error] waits {
    healthy(db)?
    let (answer, from): (Sender[Result[SchemaPlan, Error]], Receiver[Result[SchemaPlan, Error]]) = channel.new(1)
    let job = MigrationJob(plan: schema_plan(db), configure: configure, answer: take answer)
    // The callback can wait, so its fault boundary is a task (FAIL-14).
    // An empty task result costs 288 B (MEM-24). Use the parent's remaining
    // grant for this phase and release the unused portion before the cut.
    let first = task.try_spawn(tasks, bytes 18446744073709551327u64, take job, prepare_migration)
    let running = match take first {
        Ok(take handle) => take handle,
        Error((c, take returned)) => {
            if c.available < 288 {
                return Error(Full(Allocation(c)))
            }
            task.spawn(tasks, bytes (c.available - 288), take returned, prepare_migration)
        },
    }
    match task.join(take running) {
        Ok(()) => (),
        Error(Failed(causes)) => return Error(match raised_capacity(causes) {
            Some(c) => Full(Allocation(c)),
            None => MigrationFault,
        }),
        Error(Cancelled(_)) => return Error(MigrationFault),
    }
    Ok(StagedMigration(plan: result.unwrap(channel.receive(from))?))
}

pub fn run_migration(mut db: Db, tasks: Tasks, configure: StaticFn[fn(mut Migration) -> Result[(), Error] waits]) -> Result[(), Error] waits {
    let StagedMigration(plan: take plan) = stage_migration(db, tasks, configure)?
    if plan.changed {
        let _ = publish_schema_plan(mut db, take plan)?
    }
    Ok(())
}

pub fn system_table[K, V](db: Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    healthy(db)?
    catalog_handle(db.store, db.heads[0].roots.catalog, false, named(name)?, take key, take value)
}

pub fn with_staged_schema[H](staged: StagedMigration, make: StaticFn[fn(Schema) -> Result[H, Error]]) -> Result[H, Error] {
    (code.callable(make))(Schema(store: staged.plan.store, catalog: share_page_tree(staged.plan.roots.catalog)))
}

fn stage_system_table[K, V](mut plan: SchemaPlan, name: String, key: std.codec.Key[K], value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let exists = match get_page_row(plan.roots.catalog, table_key(name)?) {
        Some(_) => true,
        None => false
    }
    if !exists {
        stage_create_table(mut plan, spec(named(name)?, key, value))?
    }
    stage_table(mut plan, name, key, value)
}

fn stage_system_put[K, V](mut plan: SchemaPlan, t: Table[K, V], k: K, v: V) -> Result[(), Error] {
    let p = logical_key(t.id, encode_key(t.key, k)?)?
    let mut raw: Bytes = list.new()
    capacity(le(mut raw, int.widen(t.readers.current), 2))?
    std.codec.encode(t.readers.codec, v, mut raw) ?=> |_| Limit(Value)
    if list.len(raw) > VALUE_LIMIT {
        return Error(Limit(Value))
    }
    let mut live = plan.live
    if !plan.retained {
        if let Some(old) = get_page_row(plan.roots.collections, p) {
            live -= entry(p, old)
        }
    }
    live = int.saturating_add(live, entry(p, raw))
    over_ceiling(live, plan.ceiling)?
    let _ = insert_row(mut plan.next_node, mut plan.roots, take p, take raw)?
    plan.live = live
    plan.changed = true
    Ok(())
}

pub fn stage_activation[V](mut staged: StagedMigration, release_at: u64, previous: Option[Bytes], current: Bytes, codec: std.codec.Codec[V], release: V) -> Result[(), Error] {
    let activation = stage_system_table(mut staged.plan, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes())?
    let releases = stage_system_table(mut staged.plan, "hirsel.runner.releases", std.codec.key_u64(), codec)?
    if let Some(old) = previous {
        stage_system_put(mut staged.plan, activation, 1u8, old)?
    }
    stage_system_put(mut staged.plan, activation, 0u8, current)?
    stage_system_put(mut staged.plan, releases, release_at, release)
}

pub fn install_activation(mut db: Db, take staged: StagedMigration) -> Result[(), Error] waits {
    let StagedMigration(plan: take plan) = take staged
    let old_fence = db.fence
    if is_disk(db) {
        db.fence = 1
    }
    match publish_schema_plan(mut db, take plan) {
        Ok(_) => Ok(()),
        Error(take problem) => {
            db.fence = old_fence;
            Error(take problem)
        }
    }
}

fn publish_schema_plan(mut db: Db, take prepared: SchemaPlan) -> Result[Ticket, Error] waits {
    let SchemaPlan(roots: take roots, next_node: ids, next_table: tables, live: live, ..) = take prepared
    over_ceiling(live, db.ceiling)?
    // Schema commits are main's (section 1.2). Installed only after the cut.
    let replacement = ProposedMain(roots: take roots, head: db.heads[0u64].head + 1, at: db.heads[0u64].at, tables: tables)
    let publication = capacity(prepare_publication(db, 0, replacement.head, replacement.roots))?
    // Stamps stay consumed on refusal. Table ids publish with the roots.
    db.next_node = ids
    let commit_ticket = cut_install(mut db, ReplaceMain(take replacement, None))?
    publish(take publication)
    Ok(commit_ticket)
}

// AB1: the table and every index `s` declares, in one schema commit. The
// table takes the next id and its indexes the ids after it, in `s`'s order.
pub fn create_table[K, V](mut db: Db, take s: TableSpec[K, V]) -> Result[Ticket, Error] waits {
    healthy(db)?
    let mut plan = schema_plan(db)
    stage_create_table(mut plan, take s)?
    publish_schema_plan(mut db, take plan)
}

pub fn migration_create_table[K, V](mut phase: Migration, take s: TableSpec[K, V]) -> Result[(), Error] {
    application_name(s.name)?
    for ix in s.indexes {
        application_name(ix.name)?
    }
    stage_create_table(mut phase.plan, take s)
}

fn stage_create_table[K, V](mut plan: SchemaPlan, take s: TableSpec[K, V]) -> Result[(), Error] {
    let k = table_key(s.name)?
    if let Some(_) = get_page_row(plan.roots.catalog, k) {
        return Error(Exists(named(s.name)?))
    }
    let schema = std.codec.schema(s.value) ?=> |_| Schema(0)
    let mut schemas: List[ValueSchema] = list.new()
    let fp = std.codec.fingerprint_of(schema)
    list.push(mut schemas, ValueSchema(number: 0, fingerprint: fp, schema: take schema))
    let id = plan.next_table
    let c = Catalog(kind: 1, id: id, owner: 0, epoch: 1, key: (std.codec.key_schema(s.key) ?=> |_| Schema(0)), schemas: take schemas, next: 1, by: list.new(), revision: list.new())
    let raw = encode_catalog(c)?
    let mut live = catalog_recharge(plan.live, plan.roots, k, raw, plan.retained)
    let base = share_roots(plan.roots)
    let mut roots = catalog_insert(mut plan.next_node, base, k, raw)?
    define_store_collection(mut roots.collections, id, 1, mut plan.next_node)?
    live = int.saturating_add(live, 126)
    let mut index_id = id + 1
    for ix in s.indexes {
        let ik = catalog_index_key(id, ix.name)?
        let entry_raw = encode_catalog(Catalog(kind: 2, id: index_id, owner: id, epoch: 1, key: copied(ix.key)?, schemas: list.new(), next: 0, by: copied(ix.by)?, revision: list.new()))?
        live = catalog_recharge(live, plan.roots, ik, entry_raw, plan.retained)
        roots = catalog_insert(mut plan.next_node, roots, ik, entry_raw)?
        define_store_collection(mut roots.collections, index_id, 2, mut plan.next_node)?
        live = int.saturating_add(live, 126)
        index_id += 1
    }
    keep_schema(mut plan, take roots, live, index_id)
}

fn readers[V](value: std.codec.Codec[V], c: Catalog, current: u16, schema: Bytes) -> Result[Arc[Readers[V]], Error] {
    let mut older: List[Option[std.codec.Reader[V]]] = list.with_capacity(int.widen(c.next))
    for _ in 0u64 .. int.widen(c.next) {
        list.push(mut older, None)
    }
    for old in c.schemas {
        if old.number != current {
            let resolution = std.codec.resolve(value, old.schema)
            let resolved = match take resolution {
                Error(Schema(i)) => return Error(Schema(i)),
                Error(e) => return Error(Decode(e)),
                Ok(take reader) => take reader
            }
            let _ = list.set(mut older, int.widen(old.number), Some(take resolved))
        }
    }
    let schemas = arc.new(RowSchemas(key: copied(c.key)?, value: copied(schema)?))
    Ok(arc.new(Readers(codec: value, current: current, older: take older, schemas: take schemas)))
}

fn index_catalog_in(catalog: PageTree, id: u32) -> Result[List[Catalog], Error] {
    let low = index_prefix(id)?
    let high = index_prefix(id + 1)?
    let mut cursor = byte_cursor(catalog, Included(take low), high)?
    let mut out: List[Catalog] = list.new()
    while let Some((_, raw)) = next_bytes(mut cursor)? {
        list.push(mut out, decode_catalog(raw)?)
    }
    Ok(take out)
}

pub fn table[K, V](mut db: Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] waits {
    healthy(db)?
    let mut plan = schema_plan(db)
    let target = stage_table(mut plan, name, take key, take value)?
    if plan.changed {
        let _ = publish_schema_plan(mut db, take plan)?
    }
    Ok(take target)
}

pub fn migration_table[K, V](mut phase: Migration, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    application_name(name)?
    stage_table(mut phase.plan, name, take key, take value)
}

fn stage_table[K, V](mut plan: SchemaPlan, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let k = table_key(name)?
    let mut c = match get_page_row(plan.roots.catalog, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(named(name)?))
    }
    let key_schema = std.codec.key_schema(key) ?=> |_| Schema(0)
    if key_schema != c.key {
        return Error(Schema(0))
    }
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    let mut number = c.next
    let mut found = false
    for old in c.schemas {
        if old.fingerprint == fp && old.schema == schema {
            number = old.number;
            found = true
        }
    }
    // Resolve before publishing a schema addition: Schema is always without effect.
    let resolved = readers(value, c, number, schema)?
    let catalog = index_catalog_in(plan.roots.catalog, c.id)?
    let key_handle = catalog_key_handle(take k)?
    let seen = catalog_page(plan.roots.catalog)?
    if !found {
        list.push(mut c.schemas, ValueSchema(number: number, fingerprint: fp, schema: take schema))
        c.next += 1
        let raw = encode_catalog(c)?
        let live = catalog_recharge(plan.live, plan.roots, key_handle, raw, plan.retained)
        let base = share_roots(plan.roots)
        let roots = catalog_insert(mut plan.next_node, base, key_handle, raw)?
        let next_id = plan.next_table
        keep_schema(mut plan, take roots, live, next_id)?
    }
    Ok(Table(store: plan.store, id: c.id, epoch: c.epoch, complete: list.len(catalog) == 0, catalog_key: take key_handle, catalog_page: take seen, key: key, readers: take resolved, indexes: list.new()))
}

pub fn schema_table[K, V](source: Schema, take name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    application_name(name)?
    catalog_handle(source.store, source.catalog, true, take name, take key, take value)
}

fn catalog_handle[K, V](store_id: StoreId, catalog: PageTree, writable_handle: bool, take name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let k = table_key(name)?
    let c = match get_page_row(catalog, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(take name))
    }
    let key_schema = std.codec.key_schema(key) ?=> |_| Schema(0)
    if key_schema != c.key {
        return Error(Schema(0))
    }
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    for prior in c.schemas {
        if prior.fingerprint == fp && prior.schema == schema {
            let number = prior.number
            let resolved = readers(value, c, number, schema)?
            let complete = writable_handle && list.len(index_catalog_in(catalog, c.id)?) == 0
            return Ok(Table(store: store_id, id: c.id, epoch: c.epoch, complete: complete, catalog_key: catalog_key_handle(take k)?, catalog_page: catalog_page(catalog)?, key: key, readers: take resolved, indexes: list.new()))
        }
    }
    Error(Schema(int.widen(c.next)))
}

pub fn create_index[J, K, V](mut db: Db, t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[Ticket, Error] waits {
    healthy(db)?
    let mut plan = schema_plan(db)
    stage_create_index(mut plan, t, name, by, take key)?
    publish_schema_plan(mut db, take plan)
}

pub fn migration_create_index[J, K, V](mut phase: Migration, t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[(), Error] {
    application_name(name)?
    stage_create_index(mut phase.plan, t, name, by, take key)
}

fn stage_create_index[J, K, V](mut plan: SchemaPlan, t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[(), Error] {
    if !same(plan.store, t.store) {
        return Error(Foreign)
    }
    let k = catalog_index_key(t.id, name)?
    if let Some(_) = get_page_row(plan.roots.catalog, k) {
        return Error(Exists(named(name)?))
    }
    let mut meta = catalog_entry_in(plan.roots.catalog, t.catalog_key)?
    if meta.id != t.id {
        return Error(Stale(t.id))
    }
    let id = plan.next_table
    let c = Catalog(kind: 2, id: id, owner: t.id, epoch: 1, key: (std.codec.key_schema(key) ?=> |_| Schema(0)), schemas: list.new(), next: 0, by: copied(code.identity(by))?, revision: list.new())
    let raw = encode_catalog(c)?
    let mut roots = share_roots(plan.roots)
    let mut live = int.saturating_add(126, catalog_recharge(plan.live, plan.roots, k, raw, plan.retained))
    let mut backfill: List[std.page.Row] = list.new()
    let source = match std.page.collection_child(plan.roots.collections.root, prefix(t.id)?) {
        Some(root) => arc.share(root),
        None => return Error(Stale(t.id)),
    }
    let mut rows = std.page.cursor_open(source, None, true, false)
    while let Some(item) = std.page.cursor_next(mut rows) {
        let value = row_value(t.readers, t.id, item.value)?
        let j = capacity((code.callable(by))(value))?
        let mut encoded_index = encode_key(key, j)?
        list.append(mut encoded_index, item.key)
        if list.len(encoded_index) > 4092 {
            return Error(Limit(Key))
        }
        let charge = 62 + round8(4 + list.len(encoded_index))
        live = int.saturating_add(live, charge)
        list.push(mut backfill, std.page.Row(key: take encoded_index, value: list.new(), charge: charge))
    }
    sort_bulk_rows(mut backfill)?
    bulk_store_collection(mut roots.collections, id, 2, backfill, mut plan.next_node)?
    roots = catalog_insert(mut plan.next_node, roots, k, raw)?
    meta.epoch += 1
    let changed = encode_catalog(meta)?
    live = catalog_recharge(live, plan.roots, t.catalog_key, changed, plan.retained)
    roots = catalog_insert(mut plan.next_node, roots, t.catalog_key, changed)?
    keep_schema(mut plan, take roots, live, id + 1)
}

pub fn index[J, K, V](db: Db, mut t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[Index[J, K, V], Error] {
    healthy(db)?
    catalog_index(db.store, db.heads[0].roots.catalog, mut t, name, by, take key)
}

pub fn schema_index[J, K, V](source: Schema, mut t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[Index[J, K, V], Error] {
    application_name(name)?
    catalog_index(source.store, source.catalog, mut t, name, by, take key)
}

pub fn migration_index[J, K, V](phase: Migration, mut t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[Index[J, K, V], Error] {
    application_name(name)?
    catalog_index(phase.plan.store, phase.plan.roots.catalog, mut t, name, by, take key)
}

fn read_catalog_index[J, K, V](store_id: StoreId, catalog: PageTree, t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], key: std.codec.Key[J]) -> Result[(Bytes, Catalog), Error] {
    if !same(store_id, t.store) {
        return Error(Foreign)
    }
    let k = catalog_index_key(t.id, name)?
    let c = match get_page_row(catalog, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(named(name)?))
    }
    if c.key != (std.codec.key_schema(key) ?=> |_| Schema(0)) || c.by != code.identity(by) || c.owner != t.id {
        return Error(Schema(0))
    }
    Ok((take k, take c))
}

fn catalog_index_handle[J, K, V](catalog: PageTree, t: Table[K, V], c: Catalog, take k: Bytes, take key: std.codec.Key[J]) -> Result[Index[J, K, V], Error] {
    Ok(Index(store: t.store, id: c.id, catalog_key: catalog_key_handle(take k)?, catalog_page: catalog_page(catalog)?, table: t.id, key: key, primary: t.key, readers: arc.share(t.readers)))
}

fn catalog_index[J, K, V](store_id: StoreId, catalog: PageTree, mut t: Table[K, V], name: String, by: StaticFn[fn(V) -> Result[J, Capacity]], take key: std.codec.Key[J]) -> Result[Index[J, K, V], Error] {
    let (take k, take c) = read_catalog_index(store_id, catalog, t, name, by, key)?
    let mut present = false
    for old in t.indexes {
        if old.id == c.id {
            present = true
        }
    }
    if !present {
        let extract = erase(by, key)?
        list.push(mut t.indexes, IndexOf(id: c.id, extract: take extract))
    }
    let all = index_catalog_in(catalog, t.id)?
    let mut complete = true
    for needed in all {
        let mut registered = false
        for old in t.indexes {
            if old.id == needed.id {
                registered = true
            }
        }
        if !registered {
            complete = false
        }
    }
    t.complete = complete
    t.epoch = catalog_entry_in(catalog, t.catalog_key)?.epoch
    catalog_index_handle(catalog, t, c, take k, take key)
}

pub fn drop_table[K, V](mut db: Db, take t: Table[K, V]) -> Result[Ticket, Error] waits {
    healthy(db)?
    let mut plan = schema_plan(db)
    stage_drop_table(mut plan, take t)?
    publish_schema_plan(mut db, take plan)
}

pub fn migration_drop_table[K, V](mut phase: Migration, take t: Table[K, V]) -> Result[(), Error] {
    stage_drop_table(mut phase.plan, take t)
}

fn stage_drop_table[K, V](mut plan: SchemaPlan, take t: Table[K, V]) -> Result[(), Error] {
    if !same(plan.store, t.store) {
        return Error(Foreign)
    }
    let meta = catalog_entry_in(plan.roots.catalog, t.catalog_key)?
    if meta.id != t.id {
        return Error(Stale(t.id))
    }
    let indexes = index_catalog_in(plan.roots.catalog, t.id)?
    let mut ids: List[u32] = list.new()
    list.push(mut ids, t.id)
    for ix in indexes {
        list.push(mut ids, ix.id)
    }
    let mut roots = share_roots(plan.roots)
    let mut live = plan.live
    for id in ids {
        let charge = remove_store_collection(mut roots.collections, id, mut plan.next_node)?
        if !plan.retained {
            live = int.saturating_sub(live, charge)
        }
    }
    let low = index_prefix(t.id)?
    let high = index_prefix(t.id + 1)?
    let mut cursor = byte_cursor(roots.catalog, Included(take low), high)?
    while let Some((k, v)) = next_bytes(mut cursor)? {
        if !plan.retained {
            live = int.saturating_sub(live, entry(k, v))
        }
        remove_store_row(mut roots.catalog, k, mut plan.next_node)?
    }
    if let Some(raw) = get_page_row(plan.roots.catalog, t.catalog_key) {
        if !plan.retained {
            live = int.saturating_sub(live, entry(t.catalog_key, raw))
        }
    }
    remove_store_row(mut roots.catalog, t.catalog_key, mut plan.next_node)?
    let next_id = plan.next_table
    keep_schema(mut plan, take roots, live, next_id)
}

// What a migrate builds before its cut: the new roots and the account.
type Built {
    roots: Roots,
    live: u64
}

fn over_ceiling(live: u64, ceiling: u64) -> Result[(), Error] {
    if live > ceiling {
        return Error(Full(Resident(Capacity(requested: live, available: ceiling))))
    }
    Ok(())
}

fn insert_row(mut ids: u64, mut roots: Roots, take p: Bytes, take raw: Bytes) -> Result[bool, Error] {
    let replaced = match get_page_row(roots.collections, p) {
        Some(_) => true,
        None => false
    }
    let first = stamp_after(ids)?
    let mut next_stamp = first
    let collection_key = list.slice(p, 0, 4)
    let exists = match std.page.collection_child(roots.collections.root, collection_key) {
        Some(_) => true,
        None => false,
    }
    if !exists {
        define_collection(mut roots.collections, list.word_be(p, 0), 1, first, mut next_stamp)?
    }
    put_page_row(mut roots.collections, p, raw, first, mut next_stamp)?
    canonical_tree(mut roots.collections)?
    ids = next_stamp - 1
    Ok(replaced)
}

fn sort_bulk_rows(mut rows: List[std.page.Row]) -> Result[(), Error] {
    let mut positions: List[u64] = list.new()
    let n = list.len(rows)
    capacity(list.try_reserve(mut positions, n))?
    for slot in 0u64 .. n {
        list.push(mut positions, slot)
    }
    list.sort(mut positions, scoped fn(a: u64, b: u64) -> Order {
        list.compare_bytes(rows[a].key, rows[b].key)
    })
    for first in 0u64 .. n {
        let mut at = first
        let mut source = positions[at]
        while source != first {
            list.swap(mut rows, at, source)
            positions[at] = at
            at = source
            source = positions[at]
        }
        positions[at] = at
    }
    Ok(())
}

type CatalogWrite {
    key: Bytes,
    value: Bytes
}

// AP13. Collect and admit the encoded workspace, sort the destination
// records, then build the table and each index bottom up.
fn migrate_build[K, V, K2, V2](source: PageTree, take base: Roots, mut ids: u64, start: u64, ceiling: u64, retained: bool, from: Table[K, V], olds: List[Catalog], to: TableSpec[K2, V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity], id: u32, number: u16, target: Bytes) -> Result[Built, Error] {
    let mut roots = take base
    let schema = std.codec.schema(to.value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    let mut schemas: List[ValueSchema] = list.new()
    list.push(mut schemas, ValueSchema(number: number, fingerprint: fp, schema: take schema))
    let table_raw = encode_catalog(Catalog(kind: 1, id: id, owner: 0, epoch: 1, key: (std.codec.key_schema(to.key) ?=> |_| Schema(0)), schemas: take schemas, next: number + 1, by: list.new(), revision: list.new()))?
    let mut edits: List[CatalogWrite] = list.new()
    list.push(mut edits, CatalogWrite(key: copied(target)?, value: take table_raw))
    let mut slot_order = 1u32
    for ix in to.indexes {
        let ik = catalog_index_key(id, ix.name)?
        let raw = encode_catalog(Catalog(kind: 2, id: id + slot_order, owner: id, epoch: 1, key: copied(ix.key)?, schemas: list.new(), next: 0, by: copied(ix.by)?, revision: list.new()))?
        list.push(mut edits, CatalogWrite(key: take ik, value: take raw))
        slot_order += 1
    }
    let mut live = int.saturating_add(start, 126 * list.len(edits))
    for edit in edits {
        live = int.saturating_add(live, entry(edit.key, edit.value))
    }
    let mut workspace = live
    over_ceiling(workspace, ceiling)?
    let Some(source_root) = std.page.collection_child(source.root, prefix(from.id)?) else {
        return Error(Stale(from.id))
    }
    let mut original = std.page.cursor_open(source_root, None, true, false)
    let mut new_rows: List[std.page.Row] = list.new()
    loop {
        // Decode each source row from the page in place, with no owned copy.
        let read = std.page.cursor_read(mut original, scoped fn(key: Bytes, raw: Bytes) -> Result[(K, V, u64), Error] {
            let decoded_key = decoded(std.codec.decode_key(from.key, key))?
            Ok((take decoded_key, row_value(from.readers, from.id, raw)?, list.len(raw)))
        })
        let Some(take found) = take read else {
            break
        }
        let (take k, take v, source_width) = found?
        if let Some((k2, v2)) = capacity(f(k, v))? {
            let encoded = encode_key(to.key, k2)?
            if list.len(encoded) > 4092 {
                return Error(Limit(Key))
            }
            // The source row's width sizes the buffer, so an upgrade that keeps
            // the row's size encodes it with no regrowth.
            let width = order.max(source_width, 2 + std.codec.least(to.value))
            let mut raw: Bytes = list.with_capacity(order.min(width, VALUE_LIMIT))
            capacity(le(mut raw, int.widen(number), 2))?
            std.codec.encode(to.value, v2, mut raw) ?=> |_| Limit(Value)
            if list.len(raw) > VALUE_LIMIT {
                return Error(Limit(Value))
            }
            let charge = 62 + round8(4 + list.len(encoded)) + round8(list.len(raw))
            workspace = int.saturating_add(workspace, charge + 8)
            over_ceiling(workspace, ceiling)?
            live = int.saturating_add(live, charge)
            list.push(mut new_rows, std.page.Row(key: take encoded, value: take raw, charge: charge))
        }
    }
    sort_bulk_rows(mut new_rows)?
    for slot in 1u64 .. list.len(new_rows) {
        if new_rows[slot - 1].key == new_rows[slot].key {
            return Error(Exists(named(to.name)?))
        }
    }
    let mut indexes: List[List[std.page.Row]] = list.with_capacity(list.len(to.indexes))
    for ix in to.indexes {
        let mut index_rows: List[std.page.Row] = list.with_capacity(list.len(new_rows))
        for row in new_rows {
            let value = decoded(std.codec.decode(to.value, list.slice(row.value, 2, list.len(row.value))))?
            let indexed = capacity((ix.extract)(value, None, row.key))?
            if list.len(indexed) > 4092 {
                return Error(Limit(Key))
            }
            let charge = 62 + round8(4 + list.len(indexed))
            workspace = int.saturating_add(workspace, charge + 8)
            over_ceiling(workspace, ceiling)?
            live = int.saturating_add(live, charge)
            list.push(mut index_rows, std.page.Row(key: take indexed, value: list.new(), charge: charge))
        }
        sort_bulk_rows(mut index_rows)?
        list.push(mut indexes, take index_rows)
    }
    bulk_store_collection(mut roots.collections, id, 1, new_rows, mut ids)?
    let mut index_id = id + 1
    for rows in indexes {
        bulk_store_collection(mut roots.collections, index_id, 2, rows, mut ids)?
        index_id += 1
    }
    let former = remove_store_collection(mut roots.collections, from.id, mut ids)?
    if !retained {
        live = int.saturating_sub(live, former)
    }
    for old in olds {
        let charge = remove_store_collection(mut roots.collections, old.id, mut ids)?
        if !retained {
            live = int.saturating_sub(live, charge)
        }
    }
    let low = index_prefix(from.id)?
    let high = index_prefix(from.id + 1)?
    let mut entries = byte_cursor(roots.catalog, Included(take low), high)?
    while let Some((k, v)) = next_bytes(mut entries)? {
        if !retained {
            live = int.saturating_sub(live, entry(k, v))
        }
        remove_store_row(mut roots.catalog, k, mut ids)?
    }
    if let Some(raw) = get_page_row(roots.catalog, from.catalog_key) {
        if !retained {
            live = int.saturating_sub(live, entry(from.catalog_key, raw))
        }
    }
    remove_store_row(mut roots.catalog, from.catalog_key, mut ids)?
    for edit in edits {
        roots = catalog_insert(mut ids, roots, edit.key, edit.value)?
    }
    if !retained {
        live = one_page_account(roots)
    }
    over_ceiling(live, ceiling)?
    Ok(Built(roots: take roots, live: live))
}

fn same_bytes(a: Bytes, b: Bytes) -> bool {
    a == b
}

fn catalog_insert(mut ids: u64, roots: Roots, k: Bytes, v: Bytes) -> Result[Roots, Error] {
    let mut edited = share_roots(roots)
    let first = stamp_after(ids)?
    let mut next_stamp = first
    put_page_row(mut edited.catalog, k, v, first, mut next_stamp)?
    canonical_tree(mut edited.catalog)?
    ids = next_stamp - 1
    Ok(take edited)
}

// AB1: rewrite `from` as the table `to` declares, in one schema commit at
// version + 1. The table and each index get new ids (I3), so every handle
// made before is Stale against later state and still reads older Snapshots
// and pins. The rows take one new schema number, the source entry's next, so
// no number is ever reused (L17); all older numbers retire. A rename is a
// migrate whose `f` keeps every row.
pub fn migrate[K, V, K2, V2](mut db: Db, take from: Table[K, V], take to: TableSpec[K2, V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity]) -> Result[Ticket, Error] waits {
    healthy(db)?
    let mut plan = schema_plan(db)
    stage_migrate(mut plan, take from, take to, f)?
    publish_schema_plan(mut db, take plan)
}

pub fn migration_migrate[K, V, K2, V2](mut phase: Migration, take from: Table[K, V], take to: TableSpec[K2, V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity]) -> Result[(), Error] {
    application_name(to.name)?
    for ix in to.indexes {
        application_name(ix.name)?
    }
    stage_migrate(mut phase.plan, take from, take to, f)
}

fn stage_migrate[K, V, K2, V2](mut plan: SchemaPlan, take from: Table[K, V], take to: TableSpec[K2, V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity]) -> Result[(), Error] {
    if !same(plan.store, from.store) {
        return Error(Foreign)
    }
    let meta = catalog_entry_in(plan.roots.catalog, from.catalog_key)?
    if meta.id != from.id {
        return Error(Stale(from.id))
    }
    let target = table_key(to.name)?
    if !same_bytes(target, from.catalog_key) {
        if let Some(_) = get_page_row(plan.roots.catalog, target) {
            return Error(Exists(named(to.name)?))
        }
    }
    if meta.next == 65535 {
        return Error(Limit(Value))
    }
    let olds = index_catalog_in(plan.roots.catalog, from.id)?
    let id = plan.next_table
    let total_count: u32 = int.truncate(list.len(to.indexes))
    let base = share_roots(plan.roots)
    let mut ids = plan.next_node
    let built = migrate_build(plan.roots.collections, take base, mut ids, plan.live, plan.ceiling, plan.retained, from, olds, to, f, id, meta.next, target)
    plan.next_node = ids
    let Built(roots: take roots, live: live) = built?
    keep_schema(mut plan, take roots, live, id + 1 + total_count)
}

fn bucket(v: u64) -> Result[u64, Capacity] {
    Ok(v % 4)
}

fn typed_put(mut db: Db, t: Table[u64, u64], k: u64, v: u64) -> bool waits {
    let out = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, k, v)
    })
    match take out {
        Ok(Committed(_)) => true,
        _ => false
    }
}

pub fn put[K, V](mut tx: Tx, t: Table[K, V], k: K, v: V) -> Result[(), Error] {
    writable(tx, t)?
    let tail = tx.frame_tail == OPEN_FRAME_TAIL
    let mut p = prefixed(t.id, 8, tail)?
    std.codec.encode_key(t.key, k, mut p)
    put_impl(mut tx, t, take p, v, tail)
}

pub fn delete[K, V](mut tx: Tx, t: Table[K, V], k: K) -> Result[bool, Error] {
    writable(tx, t)?
    let key = encode_key(t.key, k)?
    delete_impl(mut tx, t, key)
}

type OldAccount {
    balance: u64
}

type NewAccount {
    balance: u64,
    bonus: u64
}

fn upgrade(k: u64, v: OldAccount) -> Result[Option[(u64, NewAccount)], Capacity] {
    Ok(Some((k, NewAccount(balance: v.balance, bonus: v.balance * 10))))
}

pub type Looked[R] = Seen(Seen[R]) | Failed(Causes) | Refused(StoreCapacity) | Stopped(OutOfTime)

pub type Seen[R] {
    value: R,
    version: u64,
    reads: List[Read]
}

pub fn look[R](s: Snapshot, steps: Option[u64], body: scoped[view] fn(Tx) -> R) -> Result[Looked[R], Error] {
    let reads: Log[Read] = log.new()
    let issued: Log[u64] = log.new()
    let caught = isolate(fn() -> Result[R, OutOfTime] {
        let perform = scoped fn() -> R {
            let tx = Tx(store: s.store, roots: share_roots(s.roots), ids: 0, private_from: 1, resident: 0, retain_old: false, frame_tail: NO_FRAME_TAIL, reads: view reads, issued: view issued, refusal: None, frame_bytes: None, wrote: false, ops: empty_ops(), info: CallInfo(id: CallId(store: s.store, branch: s.branch, version: s.head), at: 0, seed: 0), stream_ops: empty_ops(), extra_bytes: 0, call: None, below: list.new(), own: 0, rows: 0, streams: 0)
            body(tx)
        }
        match steps {
            Some(n) => bound steps n {
                perform()
            },
            None => Ok(perform()),
        }
    })
    let seen = log.finish(take reads)
    match take caught {
        Error(c) => Ok(Refused(Allocation(c))),
        Ok(Error(take cs)) => match raised_capacity(cs) {
            Some(c) => Ok(Refused(Allocation(c))),
            None => Ok(Failed(take cs)),
        },
        Ok(Ok(Error(e))) => Ok(Stopped(e)),
        Ok(Ok(Ok(take value))) => Ok(Seen(Seen(value: take value, version: s.head, reads: take seen)))
    }
}

pub type Change {
    tree_key: Bytes,
    value: Option[Arc[Bytes]]
}

pub fn changes(a: Snapshot, b: Snapshot) -> Result[List[Change], Error] {
    if !same(a.store, b.store) || a.open != b.open {
        return Error(Foreign)
    }
    compare_page_collections(a.roots.collections, b.roots.collections)
}

fn catalog_key_handle(take key: Bytes) -> Result[Arc[Bytes], Error] {
    Ok(arc.new(take key))
}

// The catalog root page bytes a handle resolved against, for `readable`: empty
// when the root is a branch or holds a BLOB cell, whose lookup reads more than
// the root's bytes.
fn catalog_page(catalog: PageTree) -> Result[Arc[Bytes], Error] {
    let image = std.page.image_of(catalog.root)
    if std.page.level(image) != 0 {
        return Ok(arc.new(list.new()))
    }
    if let Some(_) = std.page.body(catalog.root, 0) {
        return Ok(arc.new(list.new()))
    }
    Ok(arc.new(copied(std.page.payload(image))?))
}

// I3's catalog check. `page` is the catalog root page the handle was resolved
// against when that root was one leaf without BLOB cells, and empty otherwise.
// A lookup in such a leaf reads only its bytes, so a root with the same bytes
// lists the handle's id under its key and the lookup is skipped.
fn readable(roots: Roots, key: Bytes, page: Bytes, id: u32) -> Result[(), Error] {
    if std.page.payload(std.page.image_of(roots.catalog.root)) == page {
        return Ok(())
    }
    match get_page_row(roots.catalog, key) {
        Some(raw) => {
            if list.len(raw) < 5 {
                return Error(malformed(0))
            }
            if read_le(raw, 1, 4) == int.widen(id) {
                Ok(())
            } else {
                Error(Stale(id))
            }
        },
        None => Error(Stale(id))
    }
}

pub opaque scoped type RangeRows[K, V] {
    rows: Rows[K, V],
    reads: View[Log[Read]],
    low: Bytes,
    high: Bytes,
    reverse: bool
}

// Before decoding an attempted row, record it and the gap traversed to find it.
// Exhaustion records the remainder once. An unused cursor observes no keys.
pub fn next_range[K, V](mut r: RangeRows[K, V]) -> Result[Option[(K, V)], Error] {
    let found = next_bytes(mut r.rows.cursor)?
    match take found {
        Some((take key, take raw)) => {
            if r.reverse {
                let new_high = copied(key)?
                let high = replace(mut r.high, take new_high)
                log.append(r.reads, Span(copied(key)?, take high))
            } else {
                let mut end = copied(key)?
                list.push(mut end, 0u8)
                let low = replace(mut r.low, copied(end)?)
                log.append(r.reads, Span(take low, take end))
            }
            let row = advance_rows(r.rows, key, raw, None, fn(observed: Bytes) -> Result[(), Error] {
                Ok(())
            })?
            match take row {
                Some((take value, _)) => Ok(Some(take value)),
                None => Ok(None)
            }
        },
        None => {
            if r.low < r.high {
                let low = replace(mut r.low, list.new())
                let high = replace(mut r.high, list.new())
                log.append(r.reads, Span(take low, take high))
            }
            Ok(None)
        },
    }
}

pub scoped type IndexRows[K, V] {
    rows: Rows[K, V],
    reads: View[Log[Read]]
}

fn next_primary[K, V](mut rows: ByteRows, table_id: u32, key_format: std.codec.Key[K], decoders: Readers[V]) -> Result[Option[(K, V)], Error] {
    if list.len(rows.cursor.active) == 0 {
        if !next_page_collection(mut rows.cursor)? {
            return Ok(None)
        }
        if rows.cursor.collection != table_id {
            list.clear(mut rows.cursor.active)
            return Ok(None)
        }
    }
    let observed = std.page.cursor_read(mut rows.cursor.active[0u64], scoped fn(key: Bytes, raw: Bytes) -> Result[Option[(K, V)], Error] {
        let decoded_key = decoded(std.codec.decode_key(key_format, key))?
        Ok(Some((take decoded_key, row_value(decoders, table_id, raw)?)))
    })
    match take observed {
        Some(take output) => take output,
        None => Ok(None),
    }
}

pub fn next[K, V](mut r: Rows[K, V]) -> Result[Option[(K, V)], Error] {
    if let None = r.skip {
        return next_primary(mut r.cursor, r.table, r.key, r.readers)
    }
    next_row(mut r, fn(key: Bytes) -> Result[(), Error] {
        Ok(())
    })
}

fn next_row[K, V](mut r: Rows[K, V], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[(K, V)], Error] {
    let found = next_bytes(mut r.cursor)?
    match take found {
        Some((take key, take raw)) => {
            let row = advance_rows(r, key, raw, None, seen)?
            match take row {
                Some((take value, _)) => Ok(Some(take value)),
                None => Ok(None)
            }
        },
        None => Ok(None)
    }
}

pub fn next_indexed[K, V](mut r: IndexRows[K, V]) -> Result[Option[(K, V)], Error] {
    indexed_advance(mut r.rows, r.reads)
}

fn indexed_advance[K, V](mut rows: Rows[K, V], reads: View[Log[Read]]) -> Result[Option[(K, V)], Error] {
    next_row(mut rows, fn(key: Bytes) -> Result[(), Error] {
        log.append(reads, Point(copied(key)?))
        Ok(())
    })
}

fn catalog_recharge(live: u64, roots: Roots, key: Bytes, value: Bytes, retained: bool) -> u64 {
    let old_charge = if retained {
        0u64
    } else {
        match get_page_row(roots.catalog, key) {
            Some(old) => entry(key, old),
            None => 0
        }
    }
    int.saturating_add(int.saturating_sub(live, old_charge), entry(key, value))
}

// Format-3 disk framing. STORE-SPEC §11.
const DISK_FORMAT: u64 = 3

type DiskContext {
    store: StoreId,
    role: u8,
    seq: u64
}

type DiskFrame {
    kind: u16,
    flags: u16,
    payload: u64,
    end: u64
}

type DiskHeader {
    context: DiskContext,
    prev_end: u64
}

fn disk_fault(file: String, at: u64, why: Why) -> Error {
    let name: String = clone(file)
    Corrupt(Fault(file: take name, offset: at, why: why))
}

// Every check starts with the store, file role, file sequence and offset.
const BINDING_BYTES: u64 = 33

fn put_binding(mut out: Bytes, ctx: DiskContext, offset: u64) -> Result[(), Capacity] {
    le(mut out, ctx.store.hi, 8)?
    le(mut out, ctx.store.lo, 8)?
    le(mut out, int.widen(ctx.role), 1)?
    le(mut out, ctx.seq, 8)?
    le(mut out, offset, 8)
}

fn disk_check_start(ctx: DiskContext, offset: u64, head: Bytes) -> Result[std.check.Xxh3, Capacity] {
    let mut binding: Bytes = list.with_capacity(BINDING_BYTES)
    put_binding(mut binding, ctx, offset)?
    let mut state = std.check.start()
    std.check.add(mut state, binding, 0, BINDING_BYTES)
    std.check.add(mut state, head, 0, 8)
    Ok(take state)
}

// Writes the check of a frame laid out as head[0..8], check[8..16] and
// payload[16..]. The binding goes past the payload, into capacity the caller
// reserved, and is hashed from there, so sealing allocates nothing and needs no
// allocation isolation when a commit seals its frame at the file end.
fn seal_frame(mut out: Bytes, ctx: DiskContext, offset: u64) -> Result[(), Capacity] {
    let end = list.len(out)
    if list.capacity(out) - end < BINDING_BYTES {
        fail("store: frame has no room for its check binding")
    }
    put_binding(mut out, ctx, offset)?
    let mut state = std.check.start()
    std.check.add(mut state, out, end, end + BINDING_BYTES)
    std.check.add(mut state, out, 0, 8)
    std.check.add(mut state, out, 16, end)
    list.truncate(mut out, end)
    list.set_word_le(mut out, 8, std.check.finish(state))
    Ok(())
}

fn disk_check(ctx: DiskContext, offset: u64, head: Bytes, payload: Bytes) -> Result[u64, Capacity] {
    let mut state = disk_check_start(ctx, offset, head)?
    std.check.add(mut state, payload, 0, list.len(payload))
    Ok(std.check.finish(state))
}

fn disk_seal(ctx: DiskContext, offset: u64, kind: u16, flags: u16, payload: Bytes) -> Result[Bytes, Capacity] {
    let mut out: Bytes = list.with_capacity(16 + list.len(payload) + BINDING_BYTES)
    le(mut out, int.widen(kind), 2)?
    le(mut out, int.widen(flags), 2)?
    le(mut out, list.len(payload), 4)?
    le(mut out, 0, 8)?
    list.append(mut out, payload)
    seal_frame(mut out, ctx, offset)?
    Ok(take out)
}

fn disk_kind_limit(kind: u16) -> Option[u64] {
    match kind {
        0x0001 => Some(56),
        0x0011 => Some(16777280),
        0x0012 => Some(8),
        0x0013 => Some(273),
        0x0021 => Some(8384),
        0x0022 => Some(16711688),
        0x0031 => Some(MANIFEST_LIMIT),
        0x0040 => Some(CLAIM_BYTES),
        0x0050 => Some(AUTHORITY_LIMIT),
        0x0070 => Some(4),
        0x0080 => Some(128),
        0x0081 => Some(1048832),
        0x0082 => Some(2097480),
        0x0083 => Some(20),
        0x0084 => Some(16715784),
        _ => None
    }
}

type DiskFrameHead {
    kind: u16,
    flags: u16,
    size: u64,
    checksum: u64
}

fn disk_read_frame_head(file: String, raw: Bytes, at: u64) -> Result[DiskFrameHead, Error] {
    let kind: u16 = list.word_le(raw, 0)
    let flags: u16 = list.word_le(raw, 2)
    let size = read_le(raw, 4, 4)
    if kind == 0 {
        return Error(disk_fault(file, at, Kind(0)))
    }
    if kind == 0x0020 || kind == 0x0030 {
        return Error(Unsupported(int.widen(kind)))
    }
    if flags & 65534 != 0 {
        return Error(disk_fault(file, at, Flags))
    }
    match disk_kind_limit(kind) {
        Some(limit) => if size > limit {
            return Error(disk_fault(file, at, Malformed))
        },
        None => if flags & 1 == 0 && size > 65536 {
            return Error(disk_fault(file, at, Malformed))
        }
    }
    Ok(DiskFrameHead(kind: kind, flags: flags, size: size, checksum: list.word_le(raw, 8)))
}

fn disk_check_frame_kind(file: String, ctx: DiskContext, kind: u16, flags: u16, at: u64) -> Result[(), Error] {
    if kind == 0x0020 || kind == 0x0030 {
        return Error(Unsupported(int.widen(kind)))
    }
    if ((kind == 0x0040 || kind == 0x0050 || kind == 0x0070) && ctx.role != 1) || (kind == 0x0080 && ctx.role != 5) || (kind >= 0x0081 && kind <= 0x0084 && ctx.role != 6) {
        return Error(disk_fault(file, at, Malformed))
    }
    if let None = disk_kind_limit(kind) {
        if flags & 1 != 0 {
            return Error(Unsupported(int.widen(kind)))
        }
    }
    if kind == 0x0001 && at != 0 {
        return Error(disk_fault(file, at, Header))
    }
    if ((kind == 0x0011 || kind == 0x0013) && ctx.role != 2) || (kind == 0x0012 && ctx.role != 4) || ((kind == 0x0021 || kind == 0x0022) && ctx.role != 3) || (kind == 0x0031 && ctx.role != 1) {
        return Error(disk_fault(file, at, Kind(int.widen(kind))))
    }
    if kind == 0x0013 && flags != 1 {
        return Error(disk_fault(file, at, Flags))
    }
    Ok(())
}

fn disk_read_frame(file: String, ctx: DiskContext, raw: Bytes, at: u64) -> Result[DiskFrame, Error] {
    let frame = disk_frame_bytes(file, ctx, raw, at)?
    disk_check_frame_kind(file, ctx, frame.kind, frame.flags, at)?
    Ok(frame)
}

fn disk_frame_bytes(file: String, ctx: DiskContext, raw: Bytes, at: u64) -> Result[DiskFrame, Error] {
    if at > list.len(raw) || list.len(raw) - at < 16 {
        return Error(disk_fault(file, at, Truncated))
    }
    let head = list.slice(raw, at, at + 16)
    let frame = disk_read_frame_head(file, head, at)?
    if frame.size > list.len(raw) - at - 16 {
        return Error(disk_fault(file, at, Truncated))
    }
    let end = at + 16 + frame.size
    let payload = list.slice(raw, at + 16, end)
    let check = capacity(disk_check(ctx, at, head, payload))?
    if check != frame.checksum {
        return Error(disk_fault(file, at, Checksum))
    }
    Ok(DiskFrame(kind: frame.kind, flags: frame.flags, payload: at + 16, end: end))
}

fn disk_header_bytes(ctx: DiskContext, prev_end: u64, authority: u8) -> Result[Bytes, Capacity] {
    let mut payload: Bytes = list.with_capacity(56)
    list.append(mut payload, string.as_bytes("HIRSTORE"))
    le(mut payload, DISK_FORMAT, 4)?
    list.push(mut payload, ctx.role)
    list.push(mut payload, authority)
    list.put_word_le(mut payload, 0u16)
    le(mut payload, ctx.store.hi, 8)?
    le(mut payload, ctx.store.lo, 8)?
    le(mut payload, 0, 8)?
    le(mut payload, ctx.seq, 8)?
    le(mut payload, prev_end, 8)?
    disk_seal(ctx, 0, 0x0001, 1, payload)
}

fn disk_read_header(file: String, raw: Bytes, role: u8, seq: Option[u64], expected_id: Option[StoreId]) -> Result[DiskHeader, Error] {
    if list.len(raw) < 72 {
        return Error(disk_fault(file, 0, Truncated))
    }
    let ctx = DiskContext(store: StoreId(hi: read_le(raw, 32, 8), lo: read_le(raw, 40, 8)), role: role, seq: read_le(raw, 56, 8))
    let frame = disk_read_frame(file, ctx, raw, 0)?
    if frame.kind != 1 || frame.end != 72 {
        return Error(disk_fault(file, 0, Header))
    }
    let magic = list.slice(raw, 16, 24)
    if magic != string.as_bytes("HIRSTORE") || raw[28] != role || read_le(raw, 30, 2) != 0 {
        return Error(disk_fault(file, 0, Header))
    }
    let format = read_le(raw, 24, 4)
    if format != DISK_FORMAT {
        return Error(Unsupported(format))
    }
    if raw[29] > 1 || (raw[29] == 1 && role != 1) {
        return Error(Unsupported(int.widen(raw[29])))
    }
    let epoch = read_le(raw, 48, 8)
    if epoch != 0 {
        return Error(Unsupported(epoch))
    }
    if let Some(expected) = seq {
        if expected != ctx.seq {
            return Error(disk_fault(file, 0, Header))
        }
    }
    if let Some(expected) = expected_id {
        if !same(expected, ctx.store) {
            return Error(disk_fault(file, 0, Header))
        }
    }
    let previous = read_le(raw, 64, 8)
    if role != 2 && previous != 0 {
        return Error(disk_fault(file, 0, Header))
    }
    Ok(DiskHeader(context: ctx, prev_end: previous))
}

fn disk_number(file: String, raw: Bytes, mut at: u64, width: u64) -> Result[u64, Error] {
    if at > list.len(raw) || width > list.len(raw) - at {
        return Error(disk_fault(file, at, Truncated))
    }
    let value = read_le(raw, at, width)
    at += width
    Ok(value)
}

fn disk_count(file: String, raw: Bytes, mut at: u64, least: u64) -> Result[u64, Error] {
    let n = disk_number(file, raw, mut at, 4)?
    if n > (list.len(raw) - at) / least {
        return Error(disk_fault(file, at, Malformed))
    }
    Ok(n)
}

fn disk_name(file: String, raw: Bytes, mut at: u64) -> Result[String, Error] {
    let size = disk_number(file, raw, mut at, 2)?
    if size > 255 || size > list.len(raw) - at {
        return Error(disk_fault(file, at, Malformed))
    }
    let chars = list.slice(raw, at, at + size)
    let owned = copied(chars)?
    at += size
    match string.from_utf8(take owned) {
        Ok(take text) => Ok(take text),
        Error(_) => Error(disk_fault(file, at - size, Malformed))
    }
}

fn disk_put_name(mut out: Bytes, name: String) -> Result[(), Capacity] {
    le(mut out, string.byte_len(name), 2)?
    Ok(list.append(mut out, string.as_bytes(name)))
}

fn encode_fork(context: DiskContext, offset: u64, head: Head) -> Result[Bytes, Capacity] {
    let size = 18 + string.byte_len(head.name)
    let mut out: Bytes = list.with_capacity(16 + size + BINDING_BYTES)
    le(mut out, 0x0013, 2)?
    le(mut out, 1, 2)?
    le(mut out, size, 4)?
    le(mut out, 0, 8)?
    le(mut out, int.widen(head.id), 4)?
    le(mut out, int.widen(head.parent), 4)?
    le(mut out, head.forked_at, 8)?
    disk_put_name(mut out, head.name)?
    seal_frame(mut out, context, offset)?
    Ok(take out)
}

fn disk_blob(file: String, raw: Bytes, mut at: u64, limit: u64) -> Result[Bytes, Error] {
    let size = disk_number(file, raw, mut at, 4)?
    if size > limit || size > list.len(raw) - at {
        return Error(disk_fault(file, at, Malformed))
    }
    let value = list.slice(raw, at, at + size)
    let out = copied(value)?
    at += size
    Ok(take out)
}

fn disk_io[T](take r: Result[T, IoError]) -> Result[T, Error] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(e) => Error(Io(e))
    }
}

fn disk_path(lead: String, seq: u64, suffix: String) -> Result[String, Capacity] {
    let mut path = string.from(lead)
    string.push_u64(mut path, seq)
    string.push(mut path, suffix)
    Ok(take path)
}

fn disk_read_file(d: Dir, path: String, limit: u64) -> Result[Bytes, Error] waits {
    let mut file = disk_io(host.open(d, path, Read))?
    let mut out: Bytes = list.new()
    loop {
        let size = list.len(out)
        if size == limit {
            let mut probe: Bytes = list.with_capacity(1)
            if disk_io(host.read(mut file, mut probe))? != 0 {
                return Error(disk_fault(path, size, Malformed))
            }
            break
        }
        let room = if limit - size < 16384 {
            limit - size
        } else {
            16384u64
        }
        let mut chunk: Bytes = list.with_capacity(room)
        if disk_io(host.read(mut file, mut chunk))? == 0 {
            break
        }
        list.append(mut out, chunk)
    }
    disk_io(host.close(take file))?
    Ok(take out)
}

fn disk_write_synced(d: Dir, path: String, raw: Bytes) -> Result[(), Error] waits {
    let mut file = disk_io(host.open(d, path, Write))?
    match host.write(mut file, raw) {
        Ok(()) => {},
        Error(e) => return Error(Io(e.error))
    }
    disk_io(host.sync(mut file))?
    disk_io(host.close(take file))
}

fn disk_remove_optional(d: Dir, path: String) -> Result[bool, Error] waits {
    match host.remove(d, path) {
        Ok(()) => Ok(true),
        Error(NotFound) => Ok(false),
        Error(e) => Error(Io(e))
    }
}

fn disk_new_segment(d: Dir, id: StoreId, seq: u64, prev_end: u64) -> Result[(HostFile, HostFile), Error] waits {
    let (take path, take end_path, take journal, take end_bytes) = disk_allocation(scoped fn() -> Result[(String, String, Bytes, Bytes), Error] {
        let path = capacity(disk_path("j-", seq, ""))?
        let end_path = capacity(disk_path("j-", seq, ".end"))?
        let header = capacity(disk_header_bytes(DiskContext(store: id, role: 2, seq: seq), prev_end, 0))?
        let ctx = DiskContext(store: id, role: 4, seq: seq)
        let mut end_bytes = capacity(disk_header_bytes(ctx, 0, 0))?
        let mut payload: Bytes = list.with_capacity(8)
        capacity(le(mut payload, 72, 8))?
        let frame = capacity(disk_seal(ctx, 72, 0x0012, 1, payload))?
        list.append(mut end_bytes, frame)
        Ok((take path, take end_path, take header, take end_bytes))
    })?
    let mut file = disk_io(host.open(d, path, Write))?
    match host.write(mut file, journal) {
        Ok(()) => (),
        Error(e) => return Error(Io(e.error)),
    }
    disk_io(host.sync(mut file))?
    let mut end_file = disk_io(host.open(d, end_path, Write))?
    match host.write(mut end_file, end_bytes) {
        Ok(()) => (),
        Error(e) => return Error(Io(e.error)),
    }
    disk_io(host.sync(mut end_file))?
    disk_io(host.sync_dir(d))?
    Ok((take file, take end_file))
}

// Checkpoint graph: new nodes contribute their child edges once; root edges
// change at the cut. Removing a last edge cascades without walking live subtrees.
type DiskLoaded: send {
    store: StoreId,
    manifest: PageManifest,
    all: List[Roots],
    lists: PagedLists,
    locations: PageLocations
}

fn disk_loaded(id: StoreId, take validated: ValidatedPageManifest) -> Result[DiskLoaded, Error] {
    let LoadedPageStore(manifest: take manifest, holders: take all, lists: take lists, locations: take locations) = rebuild_page_store(take validated)?
    Ok(DiskLoaded(store: id, manifest: take manifest, all: take all, lists: take lists, locations: take locations))
}

fn disk_publish_manifest(d: Dir, id: StoreId, m: PageManifest) -> Result[(), Error] waits {
    let raw = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        disk_page_manifest_bytes(id, m)
    })?
    disk_write_synced(d, "MANIFEST.tmp", raw)?
    disk_io(host.rename(d, "MANIFEST.tmp", "MANIFEST"))?
    disk_io(host.sync_dir(d))
}

pub type ExportStamp: codec + send {
    attempt: Bytes,
    store_hi: u64,
    store_lo: u64,
    opened: u64,
    branch: u32,
    head: u64,
    next_table: u32,
    activation: u64,
    terminal: u64,
    end: u64
}

type ExportLease: shareable + send {
    attempt: Bytes,
    packs: List[u64],
    first: u64,
    terminal: u64,
    end: u64,
    head: u64,
    next_table: u32,
    activation: u64
}

pub type Exported: send {
    dir: Dir,
    name: String,
    stamp: ExportStamp
}

pub opaque type ExportCopy: send {
    from: Dir,
    scratch: Dir,
    raw: Bytes,
    stamp: ExportStamp,
    lease: Arc[ExportLease]
}

pub type DeployError: send = Store(Error) | Scratch(Error) | ExportMismatch | AttemptBusy | ImportMalformed | IdBound | Drift | Expired | FullNew(StoreCapacity)

fn scratch_result[T](take answer: Result[T, Error]) -> Result[T, DeployError] {
    match take answer {
        Ok(take result_value) => Ok(take result_value),
        Error(take problem) => Error(Scratch(take problem))
    }
}

fn deploy_result[T](take answer: Result[T, Error]) -> Result[T, DeployError] {
    match take answer {
        Ok(take result_value) => Ok(take result_value),
        Error(take problem) => Error(Store(take problem))
    }
}

fn copy_export_file(from: Dir, to: Dir, name: String, end: Option[u64]) -> Result[(), Error] waits {
    let mut input = disk_io(host.open(from, name, Read))?
    let mut output = disk_io(host.open(to, name, Write))?
    let mut offset = 0u64
    let mut chunk: Bytes = list.with_capacity(16384)
    loop {
        list.clear(mut chunk)
        if let Some(total) = end {
            if offset == total {
                break
            }
            if total - offset < list.capacity(chunk) {
                chunk = list.with_capacity(total - offset)
            }
        }
        let read_size = disk_io(host.read(mut input, mut chunk))?
        if read_size == 0 {
            if let Some(_) = end {
                return Error(disk_fault(name, offset, Truncated))
            }
            break
        }
        // A provider may round a buffer's capacity up. Keep only the captured
        // prefix of the terminal segment.
        let written = if let Some(total) = end {
            if read_size > total - offset {
                total - offset
            } else {
                read_size
            }
        } else {
            read_size
        }
        match host.write(mut output, list.slice(chunk, 0u64, written)) {
            Ok(()) => (),
            Error(e) => return Error(Io(e.error)),
        }
        offset += written
    }
    disk_io(host.close(take input))?
    disk_io(host.sync(mut output))?
    disk_io(host.close(take output))
}

fn export_bytes(stamp: ExportStamp) -> Result[Bytes, Error] {
    let codec: std.codec.Codec[ExportStamp] = std.codec.of()
    let ctx = DiskContext(store: StoreId(hi: stamp.store_hi, lo: stamp.store_lo), role: 5, seq: stamp.opened)
    let mut raw = capacity(disk_header_bytes(ctx, 0, 0))?
    let mut body: Bytes = list.new()
    std.codec.encode(codec, stamp, mut body) ?=> |_| Limit(Value)
    list.append(mut raw, capacity(disk_seal(ctx, 72, 0x0080, 1, body))?)
    Ok(take raw)
}

pub fn export_copy(take job: ExportCopy) -> Result[Exported, DeployError] waits {
    let mut name = string.with_capacity(32)
    let to = scratch_result(disk_io(host.mkdtemp(job.scratch, mut name)))?
    let raw_stamp = scratch_result(export_bytes(job.stamp))?
    for pack in job.lease.packs {
        let path = scratch_result(capacity(disk_path("p-", pack, "")))?
        scratch_result(copy_export_file(job.from, to, path, None))?
    }
    scratch_result(disk_write_synced(to, "MANIFEST", job.raw))?
    for seq in job.lease.first .. job.stamp.terminal {
        let path = scratch_result(capacity(disk_path("j-", seq, "")))?
        scratch_result(copy_export_file(job.from, to, path, None))?
    }
    let terminal = scratch_result(capacity(disk_path("j-", job.stamp.terminal, "")))?
    scratch_result(copy_export_file(job.from, to, terminal, Some(job.stamp.end)))?
    scratch_result(disk_write_synced(to, "EXPORT", raw_stamp))?
    scratch_result(disk_io(host.sync_dir(to)))?
    let ExportCopy(stamp: take stamp, ..) = take job
    Ok(Exported(dir: to, name: take name, stamp: take stamp))
}

// E1 takes the manifest and the acknowledged extent under the writer's LOCK.
// An export task copies those immutable names while the head continues.
pub fn begin_export(mut db: Db, tasks: Tasks, scratch: Dir, take attempt: Bytes, activation: u64, allowance: u64) -> Result[Task[Result[Exported, DeployError]], DeployError] waits {
    let job = begin_export_copy(mut db, scratch, take attempt, activation)?
    match task.try_spawn(tasks, bytes allowance, take job, export_copy) {
        Ok(take copying) => Ok(take copying),
        Error((cap, take returned)) => {
            release_export(mut db, returned.stamp.attempt)
            Error(Store(Full(Allocation(cap))))
        },
    }
}

pub fn begin_export_copy(mut db: Db, scratch: Dir, take attempt: Bytes, activation: u64) -> Result[ExportCopy, DeployError] waits {
    deploy_result(healthy(db))?
    if !is_disk(db) || list.len(attempt) != 16 {
        return Error(ExportMismatch)
    }
    if let Some(_) = disk_state(db).lease {
        return Error(AttemptBusy)
    }
    let last = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    deploy_result(durable(mut db, last))?
    let from = disk_state(db).d
    let raw = deploy_result(disk_read_paged_file(from, "MANIFEST", 72 + 16 + MANIFEST_LIMIT + 20 + UNKNOWN_ROOM))?
    let lease_attempt = deploy_result(copied(attempt))?
    let stamp = ExportStamp(attempt: take attempt, store_hi: db.store.hi, store_lo: db.store.lo, opened: open_number(db), branch: 0, head: db.heads[0].head, next_table: db.next_table, activation: activation, terminal: db.file_seq, end: db.file_end)
    let first_live = disk_state(db).record_cut
    let packs = deploy_result(disk_allocation(scoped fn() -> Result[List[u64], Error] {
        Ok(live_pack_sequences(disk_state(db).pages.locations))
    }))?
    let kept = ExportLease(attempt: take lease_attempt, packs: take packs, first: first_live, terminal: stamp.terminal, end: stamp.end, head: stamp.head, next_table: stamp.next_table, activation: stamp.activation)
    let lease = arc.new(take kept)
    let job = ExportCopy(from: from, scratch: scratch, raw: take raw, stamp: take stamp, lease: arc.share(lease))
    write_disk(mut db.disk, take lease, scoped fn(mut state: DiskState, take held: Arc[ExportLease]) { state.lease = Some(take held) })
    Ok(take job)
}

pub fn export_leased(db: Db) -> bool {
    is_disk(db) && (match disk_state(db).lease {
        Some(_) => true,
        None => false
    })
}

// The owner joins or cancels the copy before it releases the attempt.
pub fn release_export(mut db: Db, attempt: Bytes) {
    if is_disk(db) {
        let releasing = match disk_state(db).lease {
            Some(lease) => lease.attempt == attempt,
            None => false
        }
        if releasing {
            forget_import(mut db)
        }
    }
}

// R1 has no LOCK, cleanup, rotation or worker. Only this module has a Db
// for the recovered export; callers can stage schema operations on it.
pub opaque type Preparation {
    db: Db,
    stamp: ExportStamp
}

fn read_export_stamp(d: Dir) -> Result[ExportStamp, DeployError] waits {
    let raw = scratch_result(disk_read_file(d, "EXPORT", 216))?
    let head = deploy_result(disk_read_header("EXPORT", raw, 5, None, None))?
    let frame = deploy_result(disk_read_frame("EXPORT", head.context, raw, 72))?
    if frame.kind != 0x0080 || frame.flags != 1 || frame.end != list.len(raw) {
        return Error(ExportMismatch)
    }
    let codec: std.codec.Codec[ExportStamp] = std.codec.of()
    let stamp = deploy_result(decoded(std.codec.decode(codec, list.slice(raw, frame.payload, frame.end))))?
    if list.len(stamp.attempt) != 16 || stamp.store_hi != head.context.store.hi || stamp.store_lo != head.context.store.lo || stamp.opened != head.context.seq || stamp.branch != 0 || stamp.terminal < stamp.opened || stamp.end < 72 || stamp.activation > stamp.head {
        return Error(ExportMismatch)
    }
    Ok(take stamp)
}

fn replay_export(d: Dir, id: StoreId, first: u64, terminal: u64, limit: u64, take initial: JournalReplay) -> Result[JournalReplay, Error] waits {
    let mut replay = take initial
    let mut seq = first
    loop {
        let path = capacity(disk_path("j-", seq, ""))?
        let boundary = if seq == terminal {
            limit
        } else {
            let following = journal_header(d, id, seq + 1u64, false)?
            match following {
                Some(head) => head.prev_end,
                None => return Error(disk_fault(path, 0u64, Header))
            }
        }
        let mut source = journal_input(disk_io(host.open(d, path, Read))?, false)?
        if seq == terminal && source.size > boundary {
            return Error(disk_fault(path, boundary, Malformed))
        }
        let _ = journal_scan(mut source, path, id, seq, Some(boundary), false, mut replay, scoped fn(mut recovered_state: JournalReplay, take event: JournalEvent) -> Result[(), Error] {
            journal_apply(path, mut recovered_state, take event)
        })?
        let JournalInput(file: take file, ..) = take source
        disk_io(host.close(take file))?
        if seq == terminal {
            return Ok(take replay)
        }
        seq += 1
    }
}

pub fn open_export(d: Dir, c: Clock, attempt: Bytes, options: Options) -> Result[Preparation, DeployError] waits {
    if let Bucket(_) = options.authority {
        return Error(Store(Unsupported(1)))
    }
    let stamp = read_export_stamp(d)?
    if stamp.attempt != attempt {
        return Error(ExportMismatch)
    }
    let (id, take manifest) = deploy_result(read_page_manifest_file(d))?
    if id.hi != stamp.store_hi || id.lo != stamp.store_lo || manifest.fence != 1 || manifest.first_live > stamp.terminal || manifest.next_table > stamp.next_table {
        return Error(ExportMismatch)
    }
    let validated = deploy_result(validate_page_manifest(d, id, take manifest))?
    let mut decoded_packs = deploy_result(disk_loaded(id, take validated))?
    let initial = deploy_result(capacity(manifest_state(decoded_packs.manifest, decoded_packs.all)))?
    list.clear(mut decoded_packs.all)
    let replay = deploy_result(journal_replay(take initial, decoded_packs.manifest.next_stamp - 1))?
    let replayed = deploy_result(replay_export(d, id, decoded_packs.manifest.first_live, stamp.terminal, stamp.end, take replay))?
    if replayed.state.tips[0].head != stamp.head {
        return Error(ExportMismatch)
    }
    let live = deploy_result(journal_account(replayed))?
    let JournalReplay(state: take state, next_node: ids, ..) = take replayed
    deploy_result(over_ceiling(live, options.resident_limit))?
    let mut db = empty_db(c, id, options)
    deploy_result(open_heads(mut db, take state))?
    db.resident = live
    db.next_node = ids
    db.next_table = stamp.next_table
    Ok(Preparation(db: take db, stamp: take stamp))
}

pub fn stage_export_migration(source: Preparation, tasks: Tasks, configure: StaticFn[fn(mut Migration) -> Result[(), Error] waits]) -> Result[StagedMigration, Error] waits {
    stage_migration(source.db, tasks, configure)
}

pub fn export_system_get[K, V](source: Preparation, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V], at: K) -> Result[Option[V], Error] {
    let selected = system_table(source.db, name, take key, take value)?
    get(snapshot(source.db), shape(selected), at)
}

pub fn staged_snapshot(source: Preparation, staged: StagedMigration) -> Snapshot {
    snapshot_from(source.db, 0u64, source.stamp.head, staged.plan.roots)
}

pub type PreparedTarget: codec + send {
    describe: Bytes,
    release: Bytes,
    digest: Bytes,
    resident_limit: u64,
    pack_bytes: u64,
    checkpoint_bytes: u64,
    journal_limit: u64
}

type PreparedMeta: codec + send {
    base: ExportStamp,
    target: PreparedTarget,
    next_table: u32,
    changes: u64,
    ranges: u64
}

type CatalogChange: codec + send {
    key: Bytes,
    before: Option[Bytes],
    after: Option[Bytes]
}

type Inventory: codec + send {
    id: u32,
    count: u64,
    digest: u64
}

type PreparedRow: codec + send {
    key: Bytes,
    value: Bytes
}

fn catalog_changes(base: Roots, planned: Roots) -> Result[List[CatalogChange], Error] {
    let mut edits: List[CatalogChange] = list.new()
    let mut before = open_page_range(base.catalog, None, true, false, None)?
    while let Some((take key, old_arc)) = next_page_range(mut before)? {
        match get_page_row(planned.catalog, key) {
            Some(new) => if list.compare_bytes(new, old_arc) != Equal {
                list.push(mut edits, CatalogChange(key: take key, before: Some(copied(old_arc)?), after: Some(copied(new)?)))
            },
            None => list.push(mut edits, CatalogChange(key: take key, before: Some(copied(old_arc)?), after: None)),
        }
    }
    let mut after = open_page_range(planned.catalog, None, true, false, None)?
    while let Some((take key, new)) = next_page_range(mut after)? {
        let exists = match get_page_row(base.catalog, key) {
            Some(_) => true,
            None => false
        }
        if !exists {
            list.push(mut edits, CatalogChange(key: take key, before: None, after: Some(copied(new)?)))
        }
    }
    list.sort(mut edits, fn(a: CatalogChange, b: CatalogChange) -> Order {
        std.order.compare(a.key, b.key)
    })
    Ok(take edits)
}

type RangeChange: send {
    id: u32,
    catalog: Option[Bytes]
}

fn changed_ranges(edits: List[CatalogChange], initial: u32, advanced: u32) -> Result[List[RangeChange], Error] {
    let mut changes_by_id: List[RangeChange] = list.new()
    for change in edits {
        let old = match change.before {
            Some(raw) => decode_catalog(raw)?.id,
            None => 0u32
        }
        let new = match change.after {
            Some(raw) => decode_catalog(raw)?.id,
            None => 0u32
        }
        if old == new {
            continue
        }
        if old != 0u32 {
            list.push(mut changes_by_id, RangeChange(id: old, catalog: None))
        }
        if let Some(raw) = change.after {
            list.push(mut changes_by_id, RangeChange(id: new, catalog: Some(copied(raw)?)))
        }
    }
    list.sort(mut changes_by_id, fn(a: RangeChange, b: RangeChange) -> Order {
        std.order.compare(a.id, b.id)
    })
    let mut previous = 0u32
    let mut expected = initial
    for change in changes_by_id {
        if previous >= change.id {
            return Error(malformed(0u64))
        }
        previous = change.id
        if change.id >= initial {
            if change.id != expected || expected == 4294967295u32 {
                return Error(malformed(0u64))
            }
            expected += 1
        }
    }
    if expected != advanced {
        return Error(malformed(0u64))
    }
    Ok(take changes_by_id)
}

fn entries_of(data: PageTree, id: u32) -> Result[ByteRows, Error] {
    if id == 4294967295u32 {
        return Error(malformed(0u64))
    }
    byte_cursor(data, Included(prefix(id)?), prefix(id + 1u32)?)
}

fn checksum_row(mut checksum: std.check.Xxh3, key: Bytes, encoded: Bytes) -> Result[(), Error] {
    let mut lengths: Bytes = list.with_capacity(8u64)
    capacity(le(mut lengths, list.len(key), 4u64))?
    capacity(le(mut lengths, list.len(encoded), 4u64))?
    std.check.add(mut checksum, lengths, 0u64, 8u64)
    std.check.add(mut checksum, key, 0u64, list.len(key))
    std.check.add(mut checksum, encoded, 0u64, list.len(encoded))
    Ok(())
}

fn range_inventory(data: PageTree, ranges: List[RangeChange]) -> Result[List[Inventory], Error] {
    let mut inventory: List[Inventory] = list.with_capacity(list.len(ranges))
    for desc in ranges {
        let mut cursor = entries_of(data, desc.id)?
        let mut row_total = 0u64
        let mut checksum = std.check.start()
        while let Some((key, value)) = next_bytes(mut cursor)? {
            checksum_row(mut checksum, key, value)?
            row_total += 1
        }
        list.push(mut inventory, Inventory(id: desc.id, count: row_total, digest: std.check.finish(checksum)))
    }
    Ok(take inventory)
}

fn write_prepared_frame[T](mut file: HostFile, ctx: DiskContext, mut offset: u64, kind: u16, codec: std.codec.Codec[T], value: T) -> Result[(), Error] waits {
    let mut encoded: Bytes = list.new()
    std.codec.encode(codec, value, mut encoded) ?=> |_| Limit(Value)
    write_prepared_payload(mut file, ctx, mut offset, kind, encoded)
}

fn write_prepared_payload(mut file: HostFile, ctx: DiskContext, mut offset: u64, kind: u16, encoded: Bytes) -> Result[(), Error] waits {
    let raw = capacity(disk_seal(ctx, offset, kind, 1, encoded))?
    match host.write(mut file, raw) {
        Ok(()) => (),
        Error(e) => return Error(Io(e.error)),
    }
    offset += list.len(raw)
    Ok(())
}

pub fn validate_preparation(source: Preparation, staged: StagedMigration) -> Result[(), Error] {
    let mut state = capacity(current_state(source.db))?
    state.tips[0].roots = share_roots(staged.plan.roots)
    over_ceiling(capacity(state_account(state))?, source.db.ceiling)
}

pub fn write_prepared(source: Preparation, staged: StagedMigration, d: Dir, take target: PreparedTarget) -> Result[(), DeployError] waits {
    let delta = deploy_result(catalog_changes(source.db.heads[0].roots, staged.plan.roots))?
    let ranges = deploy_result(changed_ranges(delta, source.stamp.next_table, staged.plan.next_table))?
    let inventory = deploy_result(range_inventory(staged.plan.roots.collections, ranges))?
    let base: ExportStamp = clone(source.stamp)
    let ctx = DiskContext(store: source.db.store, role: 6, seq: source.stamp.opened)
    let meta = PreparedMeta(base: take base, target: take target, next_table: staged.plan.next_table, changes: list.len(delta), ranges: list.len(inventory))
    let metadata_codec: std.codec.Codec[PreparedMeta] = std.codec.of()
    let mut encoded_meta: Bytes = list.new()
    std.codec.encode(metadata_codec, meta, mut encoded_meta) ?=> |_| Scratch(Limit(Value))
    if list.len(encoded_meta) > 1048832 {
        return Error(Scratch(Limit(Value)))
    }
    let mut file = scratch_result(disk_io(host.open(d, "PREPARED", Write)))?
    let header = scratch_result(capacity(disk_header_bytes(ctx, 0u64, 0)))?
    if let Error(e) = host.write(mut file, header) {
        return Error(Scratch(Io(e.error)))
    }
    let mut offset = 72u64
    let delta_codec: std.codec.Codec[CatalogChange] = std.codec.of()
    let inventory_codec: std.codec.Codec[Inventory] = std.codec.of()
    let row_codec: std.codec.Codec[PreparedRow] = std.codec.of()
    scratch_result(write_prepared_payload(mut file, ctx, mut offset, 0x0081, encoded_meta))?
    for change in delta {
        scratch_result(write_prepared_frame(mut file, ctx, mut offset, 0x0082, delta_codec, change))?
    }
    for desc in inventory {
        scratch_result(write_prepared_frame(mut file, ctx, mut offset, 0x0083, inventory_codec, desc))?
    }
    for desc in inventory {
        let mut rows = deploy_result(entries_of(staged.plan.roots.collections, desc.id))?
        while let Some((take key, value)) = deploy_result(next_bytes(mut rows))? {
            let row = PreparedRow(key: take key, value: deploy_result(copied(value))?)
            scratch_result(write_prepared_frame(mut file, ctx, mut offset, 0x0084, row_codec, row))?
        }
    }
    scratch_result(disk_io(host.sync(mut file)))?
    scratch_result(disk_io(host.close(take file)))
}

type PreparedInput {
    file: HostFile,
    ctx: DiskContext,
    offset: u64,
    digest: std.sha256.Sha256
}

fn prepared_read(mut file: HostFile, n: u64) -> Result[Bytes, Error] waits {
    let mut out: Bytes = list.with_capacity(n)
    while list.len(out) < n {
        let room = n - list.len(out)
        // Keep the old temporary's admission before issuing the read.
        let charge = ((room + 7u64) / 8u64) * 8u64
        capacity(bound bytes charge {})?
        if disk_io(host.read(mut file, mut out))? == 0 {
            // The old temporary was still charged when the eight-byte name
            // was cloned. Check both charges before cloning in the caller.
            if let Error(c) = bound bytes (charge + 8u64) {} {
                return Error(Full(Allocation(Capacity(requested: 8, available: c.available - charge))))
            }
            return Error(disk_fault("PREPARED", list.len(out), Truncated))
        }
    }
    Ok(take out)
}

fn prepared_frame[T](mut input: PreparedInput, kind: u16, codec: std.codec.Codec[T]) -> Result[T, DeployError] waits {
    let raw = scratch_result(prepared_read(mut input.file, 16u64))?
    let n = read_le(raw, 4u64, 4u64)
    if read_le(raw, 0u64, 2u64) != int.widen(kind) || read_le(raw, 2u64, 2u64) != 1u64 || n > option.unwrap(disk_kind_limit(kind)) {
        return Error(ImportMalformed)
    }
    let encoded = scratch_result(prepared_read(mut input.file, n))?
    let check = deploy_result(capacity(disk_check(input.ctx, input.offset, list.slice(raw, 0u64, 8u64), encoded)))?
    if check != read_le(raw, 8u64, 8u64) {
        return Error(ImportMalformed)
    }
    std.sha256.add(mut input.digest, raw, 0u64, 16u64)
    std.sha256.add(mut input.digest, encoded, 0u64, n)
    input.offset += 16u64 + n
    match std.codec.decode(codec, encoded) {
        Error(_) => Error(ImportMalformed),
        Ok(take value) => Ok(take value),
    }
}

fn validate_catalog_key(key: Bytes, c: Catalog) -> bool {
    if list.len(key) == 0 || key[0u64] != c.kind {
        return false
    }
    let prefix_size = if c.kind == 1 {
        1u64
    } else {
        5u64
    }
    if list.len(key) < prefix_size || list.len(key) - prefix_size > 255u64 {
        return false
    }
    if c.kind == 2 {
        let owner: u32 = list.word_be(key, 1u64)
        if owner != c.owner {
            return false
        }
    }
    if c.kind == 1 {
        let total_count = list.len(c.schemas)
        if c.owner != 0 || c.next == 0 || total_count == 0 || c.schemas[total_count - 1u64].number != c.next - 1u16 {
            return false
        }
        for i in 0u64 .. total_count {
            let schema = c.schemas[i]
            if (i > 0 && schema.number <= c.schemas[i - 1u64].number) || std.codec.fingerprint_of(schema.schema) != schema.fingerprint {
                return false
            }
        }
    } else if c.next != 0 || list.len(c.schemas) != 0 {
        return false
    }
    let text = match copied(list.slice(key, prefix_size, list.len(key))) {
        Ok(take b) => take b,
        Error(_) => return false
    }
    match string.from_utf8(take text) {
        Ok(name) => !std.string.starts_with(name, "hirsel."),
        Error(_) => false,
    }
}

fn validate_delta(change: CatalogChange, initial: u32) -> Result[(), DeployError] {
    let old = match change.before {
        Some(raw) => {
            let c = deploy_result(decode_catalog(raw))?
            if !validate_catalog_key(change.key, c) || c.id >= initial {
                return Error(ImportMalformed)
            }
            Some(take c)
        },
        None => None,
    }
    if let Some(raw) = change.after {
        let c = deploy_result(decode_catalog(raw))?
        if !validate_catalog_key(change.key, c) {
            return Error(ImportMalformed)
        }
        if let Some(before) = old {
            if c.id == before.id {
                if c.kind != before.kind || c.owner != before.owner || c.epoch < before.epoch || c.key != before.key || c.next < before.next || c.by != before.by || c.revision != before.revision || list.len(c.schemas) < list.len(before.schemas) {
                    return Error(ImportMalformed)
                }
                for i in 0u64 .. list.len(before.schemas) {
                    let left = before.schemas[i]
                    let right = c.schemas[i]
                    if left.number != right.number || left.fingerprint != right.fingerprint || left.schema != right.schema {
                        return Error(ImportMalformed)
                    }
                }
                return Ok(())
            }
        }
        if c.id < initial {
            return Error(ImportMalformed)
        }
    } else if let None = old {
        return Error(ImportMalformed)
    }
    Ok(())
}

type ValidatedRange: send {
    id: u32,
    kind: u8,
    rows: List[std.page.Row]
}

pub opaque type ValidatedImport: send {
    meta: PreparedMeta,
    delta: List[CatalogChange],
    ranges: List[ValidatedRange],
    digest: Inline[u8, 32],
    charge: u64
}

fn read_valid_range(mut input: PreparedInput, expected: RangeChange, desc: Inventory, codec: std.codec.Codec[PreparedRow], mut charge: u64) -> Result[ValidatedRange, DeployError] waits {
    if desc.id != expected.id {
        return Error(ImportMalformed)
    }
    let (kind, schema_number) = match expected.catalog {
        Some(raw) => {
            let meta = deploy_result(decode_catalog(raw))?
            (meta.kind, meta.next)
        },
        None => {
            if desc.count != 0u64 {
                return Error(ImportMalformed)
            }
            (0u8, 0u16)
        },
    }
    let mut rows: List[std.page.Row] = list.new()
    let mut digest = std.check.start()
    for i in 0u64 .. desc.count {
        let PreparedRow(key: take key, value: take encoded) = prepared_frame(mut input, 0x0084, codec)?
        if list.len(key) < 4 || list.len(key) > 4096 || list.len(encoded) > VALUE_LIMIT {
            return Error(ImportMalformed)
        }
        let seen: u32 = list.word_be(key, 0)
        let suffix = list.slice(key, 4, list.len(key))
        if seen != desc.id || (i > 0 && !(rows[i - 1].key < suffix)) {
            return Error(ImportMalformed)
        }
        if kind == 1 {
            if list.len(encoded) < 2 || read_le(encoded, 0, 2) + 1 != int.widen(schema_number) {
                return Error(ImportMalformed)
            }
        } else if list.len(encoded) != 0 {
            return Error(ImportMalformed)
        }
        deploy_result(checksum_row(mut digest, key, encoded))?
        let row_charge = entry(key, encoded)
        charge = int.saturating_add(charge, row_charge)
        list.push(mut rows, std.page.Row(key: deploy_result(copied(suffix))?, value: take encoded, charge: row_charge))
    }
    if std.check.finish(digest) != desc.digest {
        return Error(ImportMalformed)
    }
    if kind != 0 {
        charge = int.saturating_add(charge, 126)
    }
    Ok(ValidatedRange(id: desc.id, kind: kind, rows: take rows))
}

// M1 may run in a task while OLD serves. It checks all scratch input before
// the head can reserve ids or attach the result to an attempt.
pub fn validate_prepared(d: Dir) -> Result[ValidatedImport, DeployError] waits {
    let mut file = scratch_result(disk_io(host.open(d, "PREPARED", Read)))?
    let header = scratch_result(prepared_read(mut file, 72u64))?
    let head = deploy_result(disk_read_header("PREPARED", header, 6, None, None))?
    let mut digest = std.sha256.start()
    std.sha256.add(mut digest, header, 0u64, 72u64)
    let mut input = PreparedInput(file: take file, ctx: head.context, offset: 72u64, digest: take digest)
    let metadata_codec: std.codec.Codec[PreparedMeta] = std.codec.of()
    let delta_codec: std.codec.Codec[CatalogChange] = std.codec.of()
    let inventory_codec: std.codec.Codec[Inventory] = std.codec.of()
    let row_codec: std.codec.Codec[PreparedRow] = std.codec.of()
    let meta = prepared_frame(mut input, 0x0081, metadata_codec)?
    if list.len(meta.base.attempt) != 16 || meta.base.store_hi != head.context.store.hi || meta.base.store_lo != head.context.store.lo || meta.base.opened != head.context.seq || meta.base.branch != 0 || meta.base.next_table == 0 || meta.next_table < meta.base.next_table || list.len(meta.target.digest) != 32 || list.len(meta.target.release) != 32 || list.len(meta.target.describe) == 0 {
        return Error(ImportMalformed)
    }
    let mut delta: List[CatalogChange] = list.new()
    for i in 0u64 .. meta.changes {
        let changed = prepared_frame(mut input, 0x0082, delta_codec)?
        if i != 0 && !(delta[i - 1u64].key < changed.key) {
            return Error(ImportMalformed)
        }
        validate_delta(changed, meta.base.next_table)?
        list.push(mut delta, take changed)
    }
    let needed = deploy_result(changed_ranges(delta, meta.base.next_table, meta.next_table))?
    if list.len(needed) != meta.ranges {
        return Error(ImportMalformed)
    }
    let mut inventory: List[Inventory] = list.new()
    for _ in 0u64 .. meta.ranges {
        list.push(mut inventory, prepared_frame(mut input, 0x0083, inventory_codec)?)
    }
    let mut ranges: List[ValidatedRange] = list.new()
    let mut charge = 0u64
    for i in 0u64 .. meta.ranges {
        let desc = inventory[i]
        let checked_range = read_valid_range(mut input, needed[i], desc, row_codec, mut charge)?
        list.push(mut ranges, take checked_range)
    }
    let mut extra: Bytes = list.with_capacity(1)
    if scratch_result(disk_io(host.read(mut input.file, mut extra)))? != 0 {
        return Error(ImportMalformed)
    }
    let PreparedInput(file: take done, digest: take hashed, ..) = take input
    scratch_result(disk_io(host.close(take done)))?
    Ok(ValidatedImport(meta: take meta, delta: take delta, ranges: take ranges, digest: std.sha256.finish(hashed), charge: charge))
}

type ImportedRange: send {
    id: u32,
    kind: u8,
    tree: Option[Arc[std.page.Page]]
}

pub opaque type Imported: send {
    meta: PreparedMeta,
    delta: List[CatalogChange],
    ranges: List[ImportedRange],
    digest: Inline[u8, 32],
    charge: u64
}

pub opaque type ImportWork: send {
    payload: ValidatedImport,
    low: u64,
    high: u64,
    inline: u64
}

pub fn reserve_import(mut db: Db, take validated: ValidatedImport) -> Result[ImportWork, DeployError] {
    deploy_result(healthy(db))?
    if !is_disk(db) || validated.meta.base.opened != open_number(db) || validated.meta.base.store_hi != db.store.hi || validated.meta.base.store_lo != db.store.lo || !matches_export(db, validated.meta.base) {
        return Error(ExportMismatch)
    }
    let current = disk_state(db).options.resident_limit
    let s = deploy_result(capacity(current_state(db)))?
    let exact = deploy_result(capacity(state_account(s)))?
    let requested = int.saturating_add(exact, validated.charge)
    if requested > current {
        return Error(Store(Full(Resident(Capacity(requested: requested, available: current)))))
    }
    let low = db.next_node
    let inline = db.heads[0u64].roots.collections.inline
    let mut high = low
    for checked_range in validated.ranges {
        if checked_range.kind == 0 {
            continue
        }
        let n = list.len(checked_range.rows)
        let mut bodies = 0u64
        for row in checked_range.rows {
            if list.len(row.value) > inline {
                bodies += 1
            }
        }
        let Some(pages) = int.checked_mul(n, 2) else {
            return Error(IdBound)
        }
        let Some(with_pages) = int.checked_add(high, pages) else {
            return Error(IdBound)
        }
        let Some(end) = int.checked_add(with_pages, bodies + 1) else {
            return Error(IdBound)
        }
        high = end
    }
    if high == 18446744073709551615u64 {
        return Error(IdBound)
    }
    db.next_node = high
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        state.imported = None
        state.reserving = Some(validated.digest)
    })
    db.ceiling = current - validated.charge
    Ok(ImportWork(payload: take validated, low: low, high: high, inline: inline))
}

fn matches_export(db: Db, base: ExportStamp) -> bool {
    match disk_state(db).lease {
        Some(kept) => kept.attempt == base.attempt && kept.terminal == base.terminal && kept.end == base.end && kept.head == base.head && kept.next_table == base.next_table && kept.activation == base.activation,
        None => false,
    }
}

pub fn import_trees(take work: ImportWork) -> Result[Imported, DeployError] {
    let ImportWork(payload: take payload, low: low, high: high, inline: inline) = take work
    let ValidatedImport(meta: take meta, delta: take delta, ranges: take ranges, digest: digest, charge: charge, ..) = take payload
    let mut ids = low + 1
    let mut imported: List[ImportedRange] = list.with_capacity(list.len(ranges))
    for checked_range in ranges {
        let built: Option[Arc[std.page.Page]] = if checked_range.kind == 0 {
            None
        } else {
            deploy_result(page_result(std.page.bulk(checked_range.rows, Collection, inline, mut ids)))?
        }
        if ids - 1 > high {
            return Error(IdBound)
        }
        list.push(mut imported, ImportedRange(id: checked_range.id, kind: checked_range.kind, tree: take built))
    }
    Ok(Imported(meta: take meta, delta: take delta, ranges: take imported, digest: digest, charge: charge))
}

pub fn imported_digest(value: Imported) -> Inline[u8, 32] {
    value.digest
}

pub fn prepared_matches(value: ValidatedImport, describe: Bytes, release: Bytes, digest: Bytes) -> bool {
    let target = view value.meta.target
    target.describe == describe && target.release == release && target.digest == digest
}

pub fn identity_words(db: Db) -> (u64, u64) {
    (db.store.hi, db.store.lo)
}

pub type Cutover: send {
    attempt: Bytes,
    digest: Inline[u8, 32],
    deadline: u64
}

type TargetLimits {
    resident: u64,
    pack: u64,
    checkpoint: u64,
    journal: u64
}

fn catalog_bytes_equal(a: Bytes, b: Bytes) -> bool {
    a == b
}

fn planned_catalog(mut plan: SchemaPlan, delta: List[CatalogChange]) -> Result[(), DeployError] {
    for changed in delta {
        let agrees = {
            let current = get_page_row(plan.roots.catalog, changed.key)
            match changed.before {
                Some(expected) => match current {
                    Some(raw) => catalog_bytes_equal(raw, expected),
                    None => false
                },
                None => match current {
                    None => true,
                    Some(_) => false
                },
            }
        }
        if !agrees {
            return Error(ImportMalformed)
        }
        if let Some(raw) = changed.after {
            let roots = deploy_result(catalog_insert(mut plan.next_node, plan.roots, changed.key, raw))?
            plan.roots = take roots
        } else {
            deploy_result(remove_store_row(mut plan.roots.catalog, changed.key, mut plan.next_node))?
        }
    }
    Ok(())
}

fn planned_ranges(mut plan: SchemaPlan, imported: List[ImportedRange]) -> Result[(), DeployError] {
    let private_from = deploy_result(stamp_after(plan.next_node))?
    let mut next_stamp = private_from
    for replaced in imported {
        if replaced.kind == 0 {
            let _ = deploy_result(drop_collection(mut plan.roots.collections, replaced.id, private_from, mut next_stamp))?
        } else {
            let key = deploy_result(prefix(replaced.id))?
            deploy_result(put_collection(mut plan.roots.collections, key, replaced.tree, replaced.kind, private_from, mut next_stamp))?
        }
    }
    deploy_result(canonical_tree(mut plan.roots.collections))?
    plan.next_node = next_stamp - 1
    Ok(())
}

fn install_account(db: Db, roots: Roots) -> Result[u64, DeployError] {
    let mut s = deploy_result(capacity(current_state(db)))?
    s.tips[0].roots = share_roots(roots)
    deploy_result(capacity(state_account(s)))
}

// M3 associates the trees with the most recent reservation on this attempt.
pub fn keep_import(mut db: Db, take completed: Imported) -> Result[(), DeployError] {
    if !is_disk(db) || !matches_export(db, completed.meta.base) || disk_state(db).reserving != Some(completed.digest) {
        return Error(ExportMismatch)
    }
    write_disk(mut db.disk, take completed, scoped fn(mut state: DiskState, take ready: Imported) { state.imported = Some(take ready) })
    Ok(())
}

fn accept_cutover(mut db: Db, request: Cutover) -> Result[Imported, DeployError] waits {
    deploy_result(healthy(db))?
    if !is_disk(db) {
        return Error(ExportMismatch)
    }
    let last = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    deploy_result(durable(mut db, last))?
    let finished = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Option[Imported] { replace(mut state.imported, None) })
    let Some(take staged) = take finished else {
        return Error(ExportMismatch)
    }
    let agrees = {
        let base = view staged.meta.base
        staged.digest == request.digest && base.attempt == request.attempt && base.opened == open_number(db) && base.store_hi == db.store.hi && base.store_lo == db.store.lo && base.branch == 0
    }
    if !agrees {
        return Error(ExportMismatch)
    }
    Ok(take staged)
}

// V2 can be observed while the admission timer and control inbox are live.
// The head remains the sole reader of both writers' acknowledgement channels.
pub fn cutover_settled(mut db: Db) -> Result[bool, Error] {
    healthy(db)?
    if !is_disk(db) {
        return Ok(true)
    }
    journal_poll(mut db)?
    Ok(covered(db, Journal(db.frame_seq, 0, 0)))
}

fn install_prepared[V](mut db: Db, request: Cutover, current_activation: u64, old_describe: Bytes, release_codec: std.codec.Codec[V], release_from: fn(PreparedTarget, Inline[u8, 32]) -> Result[V, DeployError], before_cut: scoped fn() -> bool) -> Result[u64, DeployError] waits {
    let staged = accept_cutover(mut db, request)?
    let base = view staged.meta.base
    if db.heads[0].head != base.head || db.next_table != base.next_table || current_activation != base.activation {
        return Error(Drift)
    }
    let target = view staged.meta.target
    if let Some(problem) = journal_floor(target.checkpoint_bytes, target.journal_limit) {
        return Error(FullNew(Journal(problem)))
    }
    let disk_limit = disk_state(db).options.resident_limit
    let mut planned = schema_plan(db)
    planned.ceiling = disk_limit
    planned_catalog(mut planned, staged.delta)?
    planned_ranges(mut planned, staged.ranges)?
    planned.next_table = staged.meta.next_table
    planned.live = install_account(db, planned.roots)?
    deploy_result(over_ceiling(planned.live, disk_limit))?
    let mut installation = StagedMigration(plan: take planned)
    let release_at = base.head + 1u64
    let prior = deploy_result(copied(old_describe))?
    let release = release_from(target, request.digest)?
    deploy_result(stage_activation(mut installation, release_at, Some(take prior), target.describe, release_codec, release))?
    installation.plan.live = install_account(db, installation.plan.roots)?
    deploy_result(over_ceiling(installation.plan.live, disk_limit))?
    if host.mono_ns(db.clock) >= request.deadline || !before_cut() {
        return Error(Expired)
    }
    db.ceiling = disk_limit
    let limits = TargetLimits(resident: target.resident_limit, pack: target.pack_bytes, checkpoint: target.checkpoint_bytes, journal: target.journal_limit)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) { state.target = Some(limits) })
    let StagedMigration(plan: take ready) = take installation
    let installed = publish_schema_plan(mut db, take ready)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) { state.target = None })
    match take installed {
        Ok(_) => Ok(release_at),
        Error(Full(cause)) => Error(FullNew(cause)),
        Error(take fault) => Error(Store(take fault)),
    }
}

// The runner has paused admission and settled its workers before this call.
pub fn perform_cutover[V](mut db: Db, request: Cutover, current_activation: u64, old_describe: Bytes, release_codec: std.codec.Codec[V], release_from: fn(PreparedTarget, Inline[u8, 32]) -> Result[V, DeployError], before_cut: scoped fn() -> bool) -> Result[u64, DeployError] waits {
    let outcome = install_prepared(mut db, request, current_activation, old_describe, release_codec, release_from, before_cut)
    if is_disk(db) {
        forget_import(mut db)
    }
    take outcome
}

fn forget_import(mut db: Db) {
    db.ceiling = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> u64 {
        state.imported = None
        state.reserving = None
        state.lease = None
        state.options.resident_limit
    })
}

fn db_target(db: Db) -> Option[TargetLimits] {
    if is_disk(db) {
        disk_state(db).target
    } else {
        None
    }
}

fn pack_leased(lease: Option[Arc[ExportLease]], seq: u64) -> bool {
    if let Some(kept) = lease {
        for pack in kept.packs {
            if pack == seq {
                return true
            }
        }
    }
    false
}

type SegmentSpan: send {
    first: u64,
    end: u64
}

type DiskRemovals: send {
    packs: List[u64],
    before: SegmentSpan,
    after: SegmentSpan,
    name: String
}

fn removal_spans(first: u64, end: u64, lease: Option[(u64, u64)]) -> (SegmentSpan, SegmentSpan) {
    if let Some((from, through)) = lease {
        if from < end && through >= first {
            return (SegmentSpan(first: first, end: order.max(first, from)), SegmentSpan(first: order.min(end, int.saturating_add(through, 1)), end: end))
        }
    }
    (SegmentSpan(first: first, end: end), SegmentSpan(first: end, end: end))
}

fn remove_numbered(d: Dir, prefix_name: String, seq: u64, both: bool, mut name: String) -> Result[(), Error] waits {
    string.truncate(mut name, 0)
    string.push(mut name, prefix_name)
    string.push_u64(mut name, seq)
    let _ = disk_remove_optional(d, name)?
    if both {
        string.push(mut name, ".end")
        let _ = disk_remove_optional(d, name)?
    }
    Ok(())
}

fn remove_cut_files(d: Dir, take plan: DiskRemovals) -> Result[(), Error] waits {
    let DiskRemovals(packs: take packs, before: before, after: after, name: take scratch) = take plan
    let mut name = take scratch
    for seq in packs {
        remove_numbered(d, "p-", seq, false, mut name)?
    }
    for seq in before.first .. before.end {
        remove_numbered(d, "j-", seq, true, mut name)?
    }
    for seq in after.first .. after.end {
        remove_numbered(d, "j-", seq, true, mut name)?
    }
    Ok(())
}

fn disk_identity(r: Random) -> Result[StoreId, Capacity] {
    let mut raw: Bytes = list.with_capacity(16)
    host.random(r, mut raw)
    Ok(StoreId(hi: list.word_le(raw, 0), lo: list.word_le(raw, 8)))
}

// END damage loses the detection boundary, never the journal's valid prefix.
// A valid unknown MUST kind is a newer format and still refuses the open.
fn disk_read_end(file: String, id: StoreId, seq: u64, raw: Bytes) -> Result[u64, Error] {
    let header = disk_read_header(file, raw, 4, Some(seq), Some(id))?
    let mut at = 72u64
    let mut room = 0u64
    let mut found: Option[u64] = None
    while at < list.len(raw) {
        let frame = disk_read_frame(file, header.context, raw, at)?
        if frame.kind == 0x0012 {
            if let Some(_) = found {
                return Error(disk_fault(file, at, Malformed))
            }
            if frame.end - frame.payload != 8 {
                return Error(disk_fault(file, at, Malformed))
            }
            found = Some(read_le(raw, frame.payload, 8))
        } else {
            room += frame.end - at
            if room > 1048576 {
                return Error(disk_fault(file, at, Malformed))
            }
        }
        at = frame.end
    }
    match found {
        Some(value) => Ok(value),
        None => Error(disk_fault(file, 72, Malformed))
    }
}

fn disk_end(d: Dir, id: StoreId, seq: u64) -> Result[Option[u64], Error] waits {
    let path = capacity(disk_path("j-", seq, ".end"))?
    let raw = match disk_read_file(d, path, 96 + 1048576) {
        Ok(take raw) => take raw,
        Error(Io(NotFound)) => return Ok(None),
        Error(Corrupt(_)) => return Ok(None),
        Error(take e) => return Error(take e)
    }
    match disk_read_end(path, id, seq, raw) {
        Ok(value) => Ok(Some(value)),
        Error(Corrupt(_)) => Ok(None),
        Error(take e) => Error(take e)
    }
}

fn disk_exists(d: Dir, path: String) -> Result[bool, Error] waits {
    match host.open(d, path, Read) {
        Ok(take file) => {
            disk_io(host.close(take file))?;
            Ok(true)
        },
        Error(NotFound) => Ok(false),
        Error(e) => Error(Io(e))
    }
}

type PageDisk: send {
    next_pack: u64,
    locations: PageLocations,
    lists: PagedLists,
    owners: Map[IncomingEdge, u64],
    carried: List[u64],
    deferred: Option[u64]
}

type DiskStartup: send {
    store: StoreId,
    fence: u32,
    state: State,
    live: u64,
    resident_pages: u64,
    uncovered: u64,
    next_node: u64,
    next_table: u32,
    generation: u64,
    cut_first: u64,
    recorded_after: u64,
    seq: u64,
    segment: HostFile,
    end_file: HostFile,
    pages: PageDisk
}

fn empty_paged_lists() -> PagedLists {
    PagedLists(packs: std.page.empty(0, 0, Unprefixed), retired: std.page.empty(0, 0, Unprefixed))
}

fn remember_roots(mut owners: Map[IncomingEdge, u64], kind: u8, owner: u64, roots: LocatedRoots) {
    if roots.collections.stamp != 0 {
        map.insert(mut owners, HolderSource(kind, owner, 0), roots.collections.stamp)
    }
    if roots.streams.stamp != 0 {
        map.insert(mut owners, HolderSource(kind, owner, 1), roots.streams.stamp)
    }
    if roots.catalog.stamp != 0 {
        map.insert(mut owners, HolderSource(kind, owner, 2), roots.catalog.stamp)
    }
}

fn located_owners(manifest: PageManifest) -> Map[IncomingEdge, u64] {
    let mut owners: Map[IncomingEdge, u64] = map.new()
    for tip in manifest.branches {
        remember_roots(mut owners, 0, int.widen(tip.id), tip.roots)
    }
    for serial in 0u64 .. list.len(manifest.pins) {
        remember_roots(mut owners, 1, serial, manifest.pins[serial].roots)
    }
    take owners
}

// The branches and then the pins, in the manifest's order, which is `all`'s.
fn manifest_state(m: PageManifest, all: List[Roots]) -> Result[State, Capacity] {
    let mut tips: List[Tip] = list.with_capacity(list.len(m.branches))
    let mut k = 0u64
    for b in m.branches {
        list.push(mut tips, Tip(id: b.id, name: string.from(b.name), parent: b.parent, forked_at: b.forked_at, roots: share_roots(all[k]), head: b.version, at: b.at))
        k += 1
    }
    let mut pins: List[Pin] = list.with_capacity(list.len(m.pins))
    for held in m.pins {
        let serial = list.len(pins)
        list.push(mut pins, Pin(name: string.from(held.name), branch: held.branch, version: held.version, serial: serial, roots: share_roots(all[k])))
        k += 1
    }
    Ok(State(tips: take tips, pins: take pins, next_branch: m.next_branch, next_table: m.next_table))
}

fn check_expected_store(expected: Option[StoreId], found: StoreId) -> Result[(), Error] {
    if let Some(wanted) = expected {
        if !same(wanted, found) {
            return Error(Foreign)
        }
    }
    Ok(())
}

fn disk_start(d: Dir, r: Random, options: Options) -> Result[DiskStartup, Error] waits {
    let selected = read_page_manifest_file(d)
    let mut loaded = match take selected {
        Ok((id, take manifest)) => {
            check_expected_store(options.expect, id)?
            // Each authority refuses the other's MANIFEST.
            match options.authority {
                Directory() => if let Some(_) = manifest.claim {
                    return Error(Unsupported(1))
                },
                Bucket(_) => if let None = manifest.claim {
                    return Error(Unsupported(0))
                },
            }
            let validated = select_page_manifest(d, id, take manifest)?
            disk_loaded(id, take validated)?
        },
        Error(Io(NotFound)) => {
            if let Some(_) = options.expect {
                return Error(NotFound)
            }
            if !options.create {
                return Error(NotFound)
            }
            if let Bucket(_) = options.authority {
                return Error(NotFound)
            }
            let id = capacity(disk_identity(r))?
            let manifest = page_manifest_empty()
            let (take segment, take end_file) = disk_new_segment(d, id, 1, 0)?
            disk_publish_manifest(d, id, manifest)?
            let genesis = capacity(main_state(empty_roots(), 0, 0))?
            let pages = PageDisk(next_pack: 1, locations: new_page_locations(), lists: empty_paged_lists(), owners: map.new(), carried: list.new(), deferred: None)
            return Ok(DiskStartup(store: id, fence: 0, state: take genesis, live: 0, resident_pages: 0, uncovered: 0, next_node: 0, next_table: 1, generation: 1, cut_first: 1, recorded_after: 0, seq: 1, segment: take segment, end_file: take end_file, pages: take pages))
        },
        Error(take problem) => return Error(take problem),
    }
    let manifested = disk_allocation(scoped fn() -> Result[State, Error] {
        capacity(manifest_state(loaded.manifest, loaded.all))
    })?
    list.clear(mut loaded.all)
    let owners = disk_allocation(scoped fn() -> Result[Map[IncomingEdge, u64], Error] {
        Ok(located_owners(loaded.manifest))
    })?
    let recorded_after = manifested.tips[0u64].head
    let initial = journal_replay(take manifested, loaded.manifest.next_stamp - 1)?
    let recovered = journal_recover(d, loaded.store, loaded.manifest.first_live, true, take initial)?
    let JournalRecovered(replay: take replay, seq: last_seq, end: last_end, uncovered: uncovered) = take recovered
    let live = journal_account(replay)?
    let JournalReplay(state: take state, next_node: next_node, ..) = take replay
    over_ceiling(live, options.resident_limit)?
    let resident_pages = disk_allocation(scoped fn() -> Result[u64, Error] {
        let roots = capacity(state_roots(state))?
        Ok(int.saturating_add(resident_images(roots, Some(view loaded.lists)), location_storage_charge(loaded.locations)))
    })?
    let Some(seq) = int.checked_add(last_seq, 1) else {
        return Error(Limit(Ids))
    }
    // Fence the removal of an orphan END before making its successor HEADER.
    let orphan_end = capacity(disk_path("j-", seq, ".end"))?
    let _ = disk_remove_optional(d, orphan_end)?
    disk_io(host.sync_dir(d))?
    let (take segment, take end_file) = disk_new_segment(d, loaded.store, seq, last_end)?
    let DiskLoaded(store: id, manifest: take manifest, lists: take lists, locations: take locations, ..) = take loaded
    let pages = PageDisk(next_pack: manifest.next_pack, locations: take locations, lists: take lists, owners: take owners, carried: list.new(), deferred: None)
    Ok(DiskStartup(store: id, fence: manifest.fence, state: take state, live: live, resident_pages: resident_pages, uncovered: uncovered, next_node: next_node, next_table: manifest.next_table, generation: manifest.generation, cut_first: manifest.first_live, recorded_after: recorded_after, seq: seq, segment: take segment, end_file: take end_file, pages: take pages))
}

type DiskSession {
    lock: HostFile,
    startup: DiskStartup
}

fn disk_lock(d: Dir, c: Clock, wait_ms: u64) -> Result[HostFile, Error] waits {
    let mut lock = disk_io(host.open(d, "LOCK", Write))?
    if disk_io(host.try_lock(mut lock))? {
        return Ok(take lock)
    }
    if wait_ms == 0 {
        return Error(Held)
    }
    let deadline = std.clock.deadline_after_ms(host.mono_ns(c), wait_ms)
    loop {
        let now = host.mono_ns(c)
        if now >= deadline {
            return Error(Held)
        }
        let poll = int.saturating_add(now, 1000000)
        host.sleep_until(c, if poll < deadline {
            poll
        } else {
            deadline
        })
        if disk_io(host.try_lock(mut lock))? {
            return Ok(take lock)
        }
    }
}

fn disk_session(d: Dir, clock: Clock, r: Random, options: Options) -> Result[DiskSession, Error] waits {
    let lock = disk_lock(d, clock, options.lock_wait_ms)?
    if disk_exists(d, "EXPORT")? {
        return Error(ExportDirectory)
    }
    let startup = disk_start(d, r, options)?
    Ok(DiskSession(lock: take lock, startup: take startup))
}

type DiskState {
    lock: HostFile,
    d: Dir,
    open: u64,
    options: Options,
    lease: Option[Arc[ExportLease]],
    scrubs: List[Arc[ScrubLease]],
    imported: Option[Imported],
    reserving: Option[Inline[u8, 32]],
    target: Option[TargetLimits],
    record_cut: u64,
    recorded_after: u64,
    pages: PageDisk,
    bucket: Option[BucketWriter],
    acks: Receiver[Ack],
    journaled: u64,
    inflight: u64,
    uncovered: u64,
    since_cut: u64,
    acked_bytes: u64,
    written: Receiver[WriteNotice],
    written_send: Sender[WriteNotice],
    // One coalesced notice after each journal group sync or failure, for a
    // writer that releases replies while later commits run (sync_notices).
    synced: Option[Receiver[()]],
    poison: Option[IoError],
    journal: Sender[JournalMsg],
    pending: Option[Bytes],
    journal_task: Task[Result[(), Error]],
    journal_idle_task: Task[()]
}

fn open_number(db: Db) -> u64 {
    if is_disk(db) {
        disk_state(db).open
    } else {
        0u64
    }
}

// A main-branch record at or before this version is below the live journal.
pub fn retained_main_after(db: Db) -> u64 {
    if is_disk(db) {
        disk_state(db).recorded_after
    } else {
        0u64
    }
}

fn healthy(db: Db) -> Result[(), Error] {
    match journal_poison(db) {
        Some(e) => Error(Poisoned(e)),
        None => bucket_failed(db)
    }
}

fn open_heads(mut db: Db, take state: State) -> Result[(), Error] {
    let State(tips: take tips, pins: take pins, next_branch: next_branch, next_table: _) = take state
    let mut heads: List[Head] = list.new()
    let mut names: Map[String, u32] = map.new()
    capacity(list.try_reserve(mut heads, list.len(tips)))?
    capacity(map.try_reserve(mut names, list.len(tips) - 1))?
    let mut total = 0u64
    for take t in take tips {
        let Tip(id: br, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: head, at: at) = take t
        total += branch_record_bytes(name)
        if br != 0 {
            let key = disk_allocation(scoped fn() -> Result[String, Error] {
                named(name)
            })?
            map.insert(mut names, take key, br)
        }
        list.push(mut heads, Head(id: br, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: head, at: at, following: None))
    }
    db.heads = take heads
    db.branch_names = take names
    for stored in pins {
        total += pin_record_bytes(stored.name)
    }
    db.record_bytes = total
    db.next_pin = list.len(pins)
    db.pins = take pins
    db.next_branch = next_branch
    Ok(())
}

fn journal_floor(checkpoint_bytes: u64, journal_limit: u64) -> Option[Capacity] {
    let Some(floor) = int.checked_add(checkpoint_bytes, FRAME_LIMIT) else {
        return Some(Capacity(requested: 18446744073709551615u64, available: journal_limit))
    }
    if floor > journal_limit {
        Some(Capacity(requested: floor, available: journal_limit))
    } else {
        None
    }
}

type JournalChannels {
    frames: Sender[JournalMsg],
    queued: Receiver[JournalMsg],
    acks: Sender[Ack],
    received: Receiver[Ack],
    ready: Sender[Result[(), Capacity]],
    waiting: Receiver[Result[(), Capacity]],
    written_send: Sender[WriteNotice],
    written_receive: Receiver[WriteNotice],
    synced_send: Sender[()],
    synced_receive: Receiver[()],
    idle_send: Sender[()],
    idle_receive: Receiver[()]
}

fn journal_channels(group_count: u64) -> JournalChannels {
    let (frames, queued): (Sender[JournalMsg], Receiver[JournalMsg]) = channel.new(group_count * 2)
    // One ack per frame, for the queued and grouped frames, the handoff
    // and byte-split frames, and a final failure (Y1).
    let (acks, received): (Sender[Ack], Receiver[Ack]) = channel.new(group_count * 3 + 3)
    let (ready, waiting): (Sender[Result[(), Capacity]], Receiver[Result[(), Capacity]]) = channel.new(1)
    let (written_send, written_receive): (Sender[WriteNotice], Receiver[WriteNotice]) = channel.new(2)
    let (synced_send, synced_receive): (Sender[()], Receiver[()]) = channel.new(1)
    let (idle_send, idle_receive): (Sender[()], Receiver[()]) = channel.new(1)
    JournalChannels(frames: take frames, queued: take queued, acks: take acks, received: take received, ready: take ready, waiting: take waiting, written_send: take written_send, written_receive: take written_receive, synced_send: take synced_send, synced_receive: take synced_receive, idle_send: take idle_send, idle_receive: take idle_receive)
}

// S3 makes the disk opener public with its journal and final durability path.
/// Opens a Directory store. A Bucket store opens with `open_bucket`.
pub fn open(tasks: Tasks, d: Dir, c: Clock, r: Random, options: Options) -> Result[Db, Error] waits {
    if let Bucket(_) = options.authority {
        return Error(Unsupported(1))
    }
    open_checks(options)?
    let session = disk_session(d, c, r, options)?
    open_started(tasks, d, c, options, take session, None)
}

/// Recovers an existing Directory store in memory. The caller must exclude writers
/// during recovery to observe the offline durable state. Reads after open use only
/// the captured roots.
pub fn open_read_only(d: Dir, options: Options) -> Result[ReadOnly, Error] waits {
    if let Bucket(_) = options.authority {
        return Error(Unsupported(1))
    }
    open_checks(options)?
    let (take raw, id, take manifest) = read_only_manifest(d)?
    check_expected_store(options.expect, id)?
    if let Some(_) = manifest.claim {
        return Error(Unsupported(1))
    }
    let reader = read_only_recover(d, id, take manifest, options.resident_limit)?
    check_read_only_manifest(d, raw)?
    Ok(take reader)
}

fn read_only_manifest(d: Dir) -> Result[(Bytes, StoreId, PageManifest), Error] waits {
    if disk_exists(d, "EXPORT")? {
        return Error(ExportDirectory)
    }
    let raw = match read_page_manifest_bytes(d) {
        Ok(take found) => take found,
        Error(Io(NotFound)) => return Error(NotFound),
        Error(take problem) => return Error(take problem),
    }
    let (id, take manifest) = disk_allocation(scoped fn() -> Result[(StoreId, PageManifest), Error] {
        disk_read_page_manifest("MANIFEST", raw)
    })?
    Ok((take raw, id, take manifest))
}

fn check_read_only_manifest(d: Dir, raw: Bytes) -> Result[(), Error] waits {
    if read_page_manifest_bytes(d)? != raw {
        return Error(Held)
    }
    Ok(())
}

fn read_only_state(d: Dir, id: StoreId, take manifest: PageManifest, barriers: bool) -> Result[JournalReplay, Error] waits {
    let validated = validate_page_manifest(d, id, take manifest)?
    let ValidatedPageManifest(manifest: take selected, graph: take resolved, ..) = take validated
    let mut graph = take resolved
    let empty_collection = disk_allocation(fn() -> Result[Arc[std.page.Page], Error] {
        Ok(std.page.empty(0, 0, Collection))
    })?
    let pages = attach_page_graph(mut graph, empty_collection)?
    let state = disk_allocation(scoped fn() -> Result[State, Error] {
        let holders = attach_manifest_holders(selected, pages, empty_collection)
        capacity(manifest_state(selected, holders))
    })?
    let replay = journal_replay(take state, selected.next_stamp - 1)?
    let JournalRecovered(replay: take recovered, ..) = journal_recover(d, id, selected.first_live, barriers, take replay)?
    Ok(take recovered)
}

fn read_only_recover(d: Dir, id: StoreId, take manifest: PageManifest, ceiling: u64) -> Result[ReadOnly, Error] waits {
    let replay = read_only_state(d, id, take manifest, false)?
    over_ceiling(journal_account(replay)?, ceiling)?
    let main = view replay.state.tips[0u64]
    Ok(ReadOnly(snapshot: Snapshot(store: id, open: 0, branch: 0, head: main.head, roots: share_roots(main.roots))))
}

fn open_checks(options: Options) -> Result[(), Error] {
    if options.group_commits == 0 {
        return Error(Missing("group_commits"))
    }
    if options.group_bytes == 0 {
        return Error(Missing("group_bytes"))
    }
    if let Some(problem) = journal_floor(options.checkpoint_bytes, options.journal_limit) {
        return Error(Full(Journal(problem)))
    }
    Ok(())
}

fn open_started(tasks: Tasks, d: Dir, c: Clock, options: Options, take session: DiskSession, take remote_writer: Option[BucketWriter]) -> Result[Db, Error] waits {
    let DiskSession(lock: take lock, startup: take startup) = take session
    let DiskStartup(store: id, fence: fence, state: take state, live: live, resident_pages: resident_pages, uncovered: uncovered, next_node: next_node, next_table: next_table, generation: generation, cut_first: cut_first, recorded_after: recorded_after, seq: seq, segment: take segment, end_file: take end_file, pages: take pages) = take startup
    let mut db = disk_allocation(scoped fn() -> Result[Db, Error] {
        Ok(empty_db(c, id, options))
    })?
    open_heads(mut db, take state)?
    db.fence = fence
    db.next_node = next_node
    db.next_table = next_table
    db.file_seq = seq
    db.resident = live
    db.page_resident = resident_pages
    db.checkpointed = generation
    let channels = disk_allocation(scoped fn() -> Result[JournalChannels, Error] {
        Ok(journal_channels(int.widen(options.group_commits)))
    })?
    let JournalChannels(frames: take frames, queued: take queued, acks: take journal_acks, received: take journal_received, ready: take ready, waiting: take waiting, written_send: take written_send, written_receive: take written_receive, synced_send: take synced_send, synced_receive: take synced_receive, idle_send: take idle_send, idle_receive: take idle_receive) = take channels
    let written_worker = channel.sender(written_send)
    let reserve: u64 = int.widen(options.group_bytes)
    let timer_input = JournalIdleTimer(clock: c, requests: take idle_receive, journal: channel.sender(frames))
    let timer = match task.try_spawn(tasks, bytes 4096, take timer_input, journal_idle_timer) {
        Ok(take running) => take running,
        Error((problem, _)) => return Error(Full(Allocation(problem))),
    }
    let input = JournalWorker(store: id, seq: seq, segment: take segment, end_file: take end_file, group_commits: options.group_commits, group_bytes: options.group_bytes, receive: take queued, send: take journal_acks, ready: take ready, written: take written_worker, synced: take synced_send, idle: Some(take idle_send))
    let writer = match task.try_spawn(tasks, bytes reserve + 65536, take input, journal_worker) {
        Ok(take running) => take running,
        Error((problem, _)) => return Error(Full(Allocation(problem))),
    }
    capacity(result.unwrap(channel.receive(waiting)))?
    db.disk = Some(DiskState(lock: take lock, d: d, open: seq, options: clone(options), lease: None,
        scrubs: list.new(), imported: None, reserving: None, target: None, record_cut: cut_first,
        recorded_after: recorded_after, pages: take pages, bucket: take remote_writer,
        acks: take journal_received, journaled: 0, inflight: 0, uncovered: uncovered, since_cut: 0, acked_bytes: 0,
        written: take written_receive, written_send: take written_send, synced: Some(take synced_receive),
        poison: None, journal: take frames, pending: None, journal_task: take writer, journal_idle_task: take timer))
    Ok(take db)
}

fn disk_wait_cut(db: Db, generation: u64) -> Result[(), Error] {
    healthy(db)?
    if db.checkpointed < generation {
        return Error(Foreign)
    }
    Ok(())
}

fn disk_rotate(mut db: Db, id: StoreId, seq: u64, previous: u64) -> Result[(), Error] waits {
    let d = disk_state(db).d
    let (take segment, take end_file) = disk_new_segment(d, id, seq, previous)?
    let closed = match channel.send(disk_state(db).journal, Rotate(take segment, take end_file)) {
        Ok(()) => false,
        Error(_) => true,
    }
    if closed {
        // The task sends Broken before ending. Preserve that first error.
        loop {
            let ack = journal_receive(db);
            journal_ack(mut db, take ack)?
        }
    }
    journal_poll(mut db)
}

fn note_held_roots(mut holders: List[HeldPage], kind: u8, owner: u64, roots: Roots) {
    list.push(mut holders, HeldPage(source: HolderSource(kind, owner, 0), root: arc.share(roots.collections.root)))
    list.push(mut holders, HeldPage(source: HolderSource(kind, owner, 1), root: arc.share(roots.streams.root)))
    list.push(mut holders, HeldPage(source: HolderSource(kind, owner, 2), root: arc.share(roots.catalog.root)))
}

fn visit_cut_heads[T](db: Db, delta: HolderDelta, mut output: T, visit: scoped fn(mut T, Head, Roots, u64, u64) -> Result[(), Error]) -> Result[(), Error] {
    let removed: Option[u64] = match delta {
        RemoveHead(slot) => Some(slot),
        ReplaceMain(_, slot) => slot,
        _ => None,
    }
    for slot in 0u64 .. list.len(db.heads) {
        if removed == Some(slot) {
            continue
        }
        let head = view db.heads[slot]
        if slot == 0 {
            if let ReplaceMain(replacement, _) = delta {
                visit(mut output, head, replacement.roots, replacement.head, replacement.at)?
                continue
            }
        }
        visit(mut output, head, head.roots, head.head, head.at)?
    }
    if let AddHead(added, _) = delta {
        visit(mut output, added, added.roots, added.head, added.at)?
    }
    Ok(())
}

fn visit_cut_pins[T](db: Db, delta: HolderDelta, mut output: T, visit: scoped fn(mut T, Pin) -> Result[(), Error]) -> Result[(), Error] {
    let removed: Option[u64] = match delta {
        RemovePin(slot) => Some(slot),
        _ => None
    }
    let mut inserted = false
    for slot in 0u64 .. list.len(db.pins) {
        if removed == Some(slot) {
            continue
        }
        let held = view db.pins[slot]
        if !inserted {
            if let AddPin(added) = delta {
                if added.name < held.name {
                    visit(mut output, added)?
                    inserted = true
                }
            }
        }
        visit(mut output, held)?
    }
    if !inserted {
        if let AddPin(added) = delta {
            visit(mut output, added)?
        }
    }
    Ok(())
}

type CutParticipants {
    holders: List[HeldPage],
    roots: List[Roots]
}

fn cut_participants(db: Db, delta: HolderDelta) -> Result[CutParticipants, Error] {
    let n = list.len(db.heads) + list.len(db.pins) + 1
    let mut participants = CutParticipants(holders: list.with_capacity(3 * n), roots: list.with_capacity(n))
    visit_cut_heads(db, delta, mut participants, scoped fn(mut current: CutParticipants, head: Head, roots: Roots, head_version: u64, at: u64) -> Result[(), Error] {
        note_held_roots(mut current.holders, 0, int.widen(head.id), roots)
        list.push(mut current.roots, share_roots(roots))
        Ok(())
    })?
    visit_cut_pins(db, delta, mut participants, scoped fn(mut current: CutParticipants, held: Pin) -> Result[(), Error] {
        note_held_roots(mut current.holders, 1, held.serial, held.roots)
        list.push(mut current.roots, share_roots(held.roots))
        Ok(())
    })?
    Ok(take participants)
}

fn cut_manifest_size(db: Db, delta: HolderDelta) -> u64 {
    let records = match delta {
        AddHead(head, _) => db.record_bytes + branch_record_bytes(head.name),
        RemoveHead(slot) => db.record_bytes - branch_record_bytes(db.heads[slot].name),
        ReplaceMain(_, Some(slot)) => db.record_bytes - branch_record_bytes(db.heads[slot].name),
        AddPin(held) => db.record_bytes + pin_record_bytes(held.name),
        RemovePin(slot) => db.record_bytes - pin_record_bytes(db.pins[slot].name),
        _ => db.record_bytes,
    }
    page_manifest_file_size(MANIFEST_FIXED_BYTES + records, db.fence)
}

fn fill_cut_manifest(mut raw: Bytes, db: Db, delta: HolderDelta, generation: u64, seq: u64, prev_first: u64, layout: PagedCutLayout, next_stamp: u64, account: u64, seal: scoped fn(mut Bytes, DiskContext, u32) -> Result[(), Error] waits) -> Result[(), Error] waits {
    let tables = match delta {
        ReplaceMain(main, _) => main.tables,
        _ => db.next_table
    }
    let manifest = PageManifest(generation: generation, fence: db.fence, inline: db.heads[0u64].roots.collections.inline, next_stamp: next_stamp, next_branch: db.next_branch, next_table: tables, next_pack: layout.lists.run_packs.next_pack, first_live: seq, prev_first: prev_first, account: account, pack_root: published_tree_pointer(layout.locations, layout.lists.roots.packs), retirement_root: published_tree_pointer(layout.locations, layout.lists.roots.retired), branches: list.new(), pins: list.new(), claim: None)
    let context = DiskContext(store: db.store, role: 1, seq: generation)
    let claim = bucket_claim_of(db)
    begin_page_manifest_file(mut raw, context, match claim { Some(_) => 1, None => 0 })?
    append_page_manifest_fields(mut raw, manifest)?
    let heads = list.len(db.heads)
    let branch_count = match delta {
        AddHead(_, _) => heads + 1,
        RemoveHead(_) => heads - 1,
        ReplaceMain(_, Some(_)) => heads - 1,
        _ => heads,
    }
    capacity(le(mut raw, branch_count, 4))?
    visit_cut_heads(db, delta, mut raw, scoped fn(mut buffer: Bytes, head: Head, roots: Roots, head_version: u64, at: u64) -> Result[(), Error] {
        append_page_manifest_branch(mut buffer, head.id, head.name, head.parent, head.forked_at, head_version, at, published_page_roots(layout.locations, roots))
    })?
    let pins = list.len(db.pins)
    let pin_count = match delta {
        AddPin(_) => pins + 1,
        RemovePin(_) => pins - 1,
        _ => pins
    }
    capacity(le(mut raw, pin_count, 4))?
    visit_cut_pins(db, delta, mut raw, scoped fn(mut buffer: Bytes, held: Pin) -> Result[(), Error] {
        append_page_manifest_pin(mut buffer, held.name, held.branch, held.version, published_page_roots(layout.locations, held.roots))
    })?
    seal(mut raw, context, db.fence)?
    if let Some(held_claim) = claim { append_bucket_frames(mut raw, context, held_claim)? }
    Ok(())
}

fn cut_retirement(layout: PagedCutLayout, holders: List[HeldPage], lease: Option[Arc[ExportLease]], scrubs: List[Arc[ScrubLease]], first: u64, end: u64) -> Result[(PageDisk, DiskRemovals), Error] {
    let mut locations = share_page_locations(layout.locations)
    let mut packs: List[u64] = list.new()
    let mut carried: List[u64] = list.new()
    for seq in layout.lists.removals {
        if pack_leased(lease, seq) || scrub_leased(scrubs, seq) {
            list.push(mut carried, seq)
        } else {
            let _ = capacity(disk_index_remove(mut locations.packs, seq, pack_edge_charge))?
            list.push(mut packs, seq)
        }
    }
    let range_lease = match lease {
        Some(held) => Some((held.first, held.terminal)),
        None => None
    }
    let (before, after) = removal_spans(first, end, range_lease)
    let deferred: Option[u64] = if before.end < after.first {
        Some(before.end)
    } else {
        None
    }
    let plan = DiskRemovals(packs: take packs, before: before, after: after, name: string.with_capacity(26))
    let mut owners: Map[IncomingEdge, u64] = map.new()
    for held in holders {
        let stamp = std.page.stamp(std.page.image_of(held.root))
        if stamp != 0 {
            map.insert(mut owners, held.source, stamp)
        }
    }
    let installed_lists: PagedLists = clone(layout.lists.roots)
    Ok((PageDisk(next_pack: layout.lists.run_packs.next_pack, locations: take locations, lists: take installed_lists, owners: take owners, carried: take carried, deferred: deferred), take plan))
}

fn cut_io_error(mut db: Db, take problem: Error) -> Error {
    match take problem {
        Io(e) => {
            edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Error {
                if let None = state.poison { state.poison = Some(e) }
                Poisoned(option.unwrap(state.poison))
            })
        },
        other => take other,
    }
}

type PreparedDiskCut {
    pages: PageDisk,
    removals: DiskRemovals,
    manifest: Bytes
}

type CutTiming {
    pause_ns: u64,
    removal_ns: u64,
    removal_attempts: u64,
    drain_groups: u64
}

fn disk_cut_state(mut db: Db, take delta: HolderDelta, seal: scoped fn(mut Bytes, DiskContext, u32) -> Result[(), Error] waits) -> Result[Ticket, Error] waits {
    let mut timing: Option[CutTiming] = None
    disk_cut_timed(mut db, take delta, seal, mut timing)
}

fn disk_cut_timed(mut db: Db, take delta: HolderDelta, seal: scoped fn(mut Bytes, DiskContext, u32) -> Result[(), Error] waits, mut timing: Option[CutTiming]) -> Result[Ticket, Error] waits {
    let target = db_target(db)
    let pack_bytes = match target {
        Some(wanted) => wanted.pack,
        None => disk_state(db).options.pack_bytes,
    }
    let limit = order.max(pack_bytes, page_manifest_file_size(MANIFEST_LIMIT, 1))
    disk_cut_with_limit(mut db, take delta, seal, target, pack_bytes, limit, mut timing)
}

fn disk_cut_with_limit(mut db: Db, take delta: HolderDelta, seal: scoped fn(mut Bytes, DiskContext, u32) -> Result[(), Error] waits, target: Option[TargetLimits], pack_bytes: u64, limit: u64, mut timing: Option[CutTiming]) -> Result[Ticket, Error] waits {
    healthy(db)?
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) { state.since_cut = 0 })
    let last = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    let observe = match timing {
        Some(_) => true,
        None => false,
    }
    let started = if observe {
        host.mono_ns(db.clock)
    } else {
        0
    }
    let drain_groups = durable_groups(mut db, last)?
    let Some(generation) = int.checked_add(db.checkpointed, 1) else {
        return Error(Limit(Ids))
    }
    let Some(seq) = int.checked_add(db.file_seq, 1) else {
        return Error(Limit(Ids))
    }
    let id = db.store
    prepare_holder_slot(mut db, delta)?
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) { prune_scrubs(mut state.scrubs) })
    let participants = disk_allocation(scoped fn() -> Result[CutParticipants, Error] {
        cut_participants(db, delta)
    })?
    let CutParticipants(holders: take holders, roots: take roots) = take participants
    let base = page_retry_base(disk_state(db).pages.locations, disk_state(db).pages.owners, holders, roots)?
    over_ceiling(base.account, db.ceiling)?
    let manifest_bytes = cut_manifest_size(db, delta)
    let d = disk_state(db).d
    let mut next_stamp = stamp_after(db.next_node)?
    let prev_first = match disk_state(db).pages.deferred {
        Some(low) => low,
        None => disk_state(db).record_cut,
    }
    let attempt = prepare_page_cut(base.locations, mut next_stamp, scoped fn(marks: Map[u64, ()], relocated: Option[View[Log[bool]]], mut stamp: u64) -> Result[PreparedDiskCut, Error] waits {
        let planned = {
            let installed = disk_state(db).pages
            plan_page_cut(base, holders, installed.lists, installed.carried, installed.next_pack, pack_bytes, marks, relocated, mut stamp)?
        }
        let mut buffers = cut_output_buffers(planned, manifest_bytes, limit)?
        // A retry after emission reuses the segment created by the first attempt.
        if db.file_seq != seq {
            let previous = db.file_end
            disk_rotate(mut db, id, seq, previous)?
            db.file_seq = seq
            db.file_end = 72
        }
        let layout = write_page_cut(d, id, take planned, mut buffers)?
        let PackBuffers(out: take out, ..) = take buffers
        let mut manifest = take out
        let (take pages, take removals) = disk_allocation(scoped fn() -> Result[(PageDisk, DiskRemovals), Error] {
            cut_retirement(layout, holders, disk_state(db).lease, disk_state(db).scrubs, prev_first, seq)
        })?
        fill_cut_manifest(mut manifest, db, delta, generation, seq, prev_first, layout, stamp, base.account, seal)?
        Ok(PreparedDiskCut(pages: take pages, removals: take removals, manifest: take manifest))
    })
    db.next_node = next_stamp - 1
    let prepared = match take attempt {
        Ok(take cut) => take cut,
        Error(take problem) => return Error(cut_io_error(mut db, take problem)),
    }
    let PreparedDiskCut(pages: take pages, removals: take removals, manifest: take manifest) = take prepared
    // The records name exactly the frames reachable from the participants
    // and the two list roots, so their running charge is the AP15 report.
    let resident_pages = resident_location_charge(pages.locations)
    if let Some(wanted) = target {
        validate_new_page_manifest(d, id, manifest, wanted)?
    }
    // A Bucket store publishes the generation remotely first; the local
    // MANIFEST and the segment removals follow only a created one.
    let first_pack = disk_state(db).pages.next_pack
    bucket_publish(mut db, first_pack, pages.next_pack, generation, manifest)?
    if let Error(take problem) = publish_page_manifest_bytes(d, manifest) {
        return Error(cut_io_error(mut db, take problem))
    }
    let recorded_after = match delta { ReplaceMain(main, _) => main.head, _ => db.heads[0u64].head }
    write_disk(mut db.disk, take pages, scoped fn(mut state: DiskState, take installed: PageDisk) {
        state.pages = take installed
        state.record_cut = seq
        state.recorded_after = recorded_after
        state.uncovered = 0
    })
    db.checkpointed = generation
    db.resident = base.account
    db.page_resident = resident_pages
    db.settled = db.changes
    install_holder_delta(mut db, take delta)
    let installed = if observe {
        host.mono_ns(db.clock)
    } else {
        0
    }
    let removals_count = if observe {
        list.len(removals.packs) + 2 * (removals.before.end - removals.before.first + removals.after.end - removals.after.first)
    } else {
        0
    }
    if let Error(take problem) = remove_cut_files(d, take removals) {
        return Error(cut_io_error(mut db, take problem))
    }
    if observe {
        timing = Some(CutTiming(pause_ns: installed - started, removal_ns: host.mono_ns(db.clock) - installed, removal_attempts: removals_count, drain_groups: drain_groups))
    }
    Ok(Ticket(store: id, open: open_number(db), mark: Cut(generation)))
}

pub fn checkpoint(mut db: Db) -> Result[Ticket, Error] waits {
    healthy(db)?
    cut_install(mut db, NoHolderChange)
}



// S3 journal payloads are decoded exactly before their effects are applied.
pub type CallRecord: codec + shareable + send {
    key: Bytes,
    args: Bytes,
    stream: Bytes,
    // AD1: code.revision of the entry that ran, exactly 32 bytes; None only
    // when the program was assembled without revisions. Never 32 zero bytes.
    revision: Option[Bytes],
    // The code that ran: u64 n ‖ u64 s, big-endian, then the replay identity
    // (32 bytes, or none when the launch has no identity), RUNNER-SPEC §7.
    code: Bytes
}

// The CALL carries the original execution context only when a later frame
// settles the call. An inline reply uses the context of its own frame.
type Settlement: shareable + send {
    way: u8,
    base: u64,
    at: u64,
    seed: u64
}

type CallSection: shareable + send {
    record: CallRecord,
    settlement: Option[Settlement]
}

pub type Recorded {
    record: CallRecord,
    settle: u8,
    branch: Branch,
    base: u64,
    at: u64,
    seed: u64
}

fn call_section_bytes(rec: CallRecord, shifted: bool) -> u64 {
    let revision = match rec.revision {
        Some(raw) => list.len(raw),
        None => 0u64
    }
    17 + list.len(rec.key) + list.len(rec.args) + revision + list.len(rec.code) + (if shifted {
        24u64
    } else {
        0u64
    })
}

// AD1: the CALL revision check. A Some that is not code.revision's 32 bytes is refused
// before anything is committed.
fn call_checked(c: CallRecord) -> Result[(), Error] {
    if let Some(r) = c.revision {
        if list.len(r) != 32 {
            return Error(Missing("revision"))
        }
    }
    if !call_code_size(list.len(c.code)) {
        return Error(Missing("code"))
    }
    Ok(())
}

fn check_completion_record(complete: Completion, rec: Option[CallRecord]) -> Result[(), Error] {
    if let Some(c) = rec {
        if c.stream != complete.stream {
            return Error(Foreign)
        }
        call_checked(c)?
    }
    Ok(())
}

fn call_code_size(size: u64) -> bool {
    size == 16 || size == 48
}

type JournalOp: shareable + send {
    key: Bytes,
    value: Option[Bytes]
}

type JournalCommit {
    branch: u32,
    version: u64,
    at: u64,
    data: List[JournalOp],
    streams: List[JournalOp],
    call: Option[CallSection]
}

type JournalFork {
    id: u32,
    parent: u32,
    forked_at: u64,
    name: String
}

type JournalEvent = Commit(JournalCommit) | Fork(JournalFork)

fn journal_event_kind(kind: u16) -> bool {
    kind == 0x0011 || kind == 0x0013
}

fn journal_ops(file: String, raw: Bytes, stream: bool, mut at: u64, mut call: Option[CallSection]) -> Result[List[JournalOp], Error] {
    let operation_count = disk_count(file, raw, mut at, 5)?
    let mut ops: List[JournalOp] = list.new()
    let value_limit = if stream {
        1048576u64
    } else {
        16711680u64
    }
    for i in 0u64 .. operation_count {
        let op_at = at
        let kind = disk_number(file, raw, mut at, 1)?
        if kind != 1 && kind != 2 && !(stream && kind == 3) {
            return Error(disk_fault(file, op_at, Malformed))
        }
        let key = disk_blob(file, raw, mut at, 4096)?
        let value: Option[Bytes] = if kind == 2 {
            None
        } else {
            let stored = disk_blob(file, raw, mut at, value_limit)?
            if kind == 3 {
                if let Some(_) = call {
                    return Error(disk_fault(file, op_at, Malformed))
                }
                if list.len(stored) < 41 || stored[40] != 2 {
                    return Error(disk_fault(file, op_at, Malformed))
                }
                call = Some(decode_call(file, raw, mut at, copied(key)?)?)
            }
            Some(take stored)
        }
        list.push(mut ops, JournalOp(key: take key, value: take value))
    }
    Ok(take ops)
}

fn decode_settlement(file: String, raw: Bytes, mut at: u64, way: u8) -> Result[Settlement, Error] {
    if list.len(raw) - at < 24 {
        return Error(disk_fault(file, at, Malformed))
    }
    let context = Settlement(way: way, base: word_be(raw, at), at: word_be(raw, at + 8), seed: word_be(raw, at + 16))
    at += 24
    Ok(context)
}

fn decode_call(file: String, raw: Bytes, mut at: u64, take stream: Bytes) -> Result[CallSection, Error] {
    let key = disk_blob(file, raw, mut at, 16777280)?
    let args = disk_blob(file, raw, mut at, 16777280)?
    let revision_at = at
    let revision_bytes = disk_blob(file, raw, mut at, 32)?
    let revision: Option[Bytes] = match list.len(revision_bytes) {
        0 => None,
        32 => Some(take revision_bytes),
        _ => return Error(disk_fault(file, revision_at, Malformed))
    }
    let code_at = at
    let code = disk_blob(file, raw, mut at, 48)?
    if !call_code_size(list.len(code)) {
        return Error(disk_fault(file, code_at, Malformed))
    }
    let way: u8 = int.truncate(disk_number(file, raw, mut at, 1)?)
    let settlement: Option[Settlement] = match way {
        0 => None,
        1 => Some(decode_settlement(file, raw, mut at, way)?),
        2 => Some(decode_settlement(file, raw, mut at, way)?),
        _ => return Error(disk_fault(file, at - 1, Malformed)),
    }
    let record = CallRecord(key: take key, args: take args, stream: take stream, revision: take revision, code: take code)
    Ok(CallSection(record: take record, settlement: settlement))
}

fn journal_decode_commit(file: String, raw: Bytes) -> Result[JournalCommit, Error] {
    let mut at = 0u64
    let br: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let head = disk_number(file, raw, mut at, 8)?
    let wall = disk_number(file, raw, mut at, 8)?
    let sections = disk_number(file, raw, mut at, 1)?
    if sections == 0 || sections > 2 {
        return Error(disk_fault(file, at - 1, Malformed))
    }
    let mut data: List[JournalOp] = list.new()
    let mut streams: List[JournalOp] = list.new()
    let mut call: Option[CallSection] = None
    for section in 0u64 .. sections {
        let tag = disk_number(file, raw, mut at, 1)?
        if tag > 1 || (sections == 2 && tag != section) {
            return Error(disk_fault(file, at - 1, Malformed))
        }
        if tag == 0 {
            data = journal_ops(file, raw, false, mut at, mut call)?
        } else {
            streams = journal_ops(file, raw, true, mut at, mut call)?
        }
    }
    if at != list.len(raw) {
        return Error(disk_fault(file, at, Malformed))
    }
    if let Some(c) = call {
        let mut matching = 0u64
        for op in streams {
            if op.key == c.record.stream {
                matching += 1
            }
        }
        if matching != 1 {
            return Error(disk_fault(file, at, Malformed))
        }
    }
    Ok(JournalCommit(branch: br, version: head, at: wall, data: take data, streams: take streams, call: take call))
}

fn journal_decode(file: String, kind: u16, raw: Bytes) -> Result[JournalEvent, Error] {
    if kind == 0x0011 {
        return Ok(Commit(journal_decode_commit(file, raw)?))
    }
    let mut at = 0u64
    let id: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let parent: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let forked_at = disk_number(file, raw, mut at, 8)?
    let name = disk_name(file, raw, mut at)?
    if at != list.len(raw) {
        return Error(disk_fault(file, at, Malformed))
    }
    Ok(Fork(JournalFork(id: id, parent: parent, forked_at: forked_at, name: take name)))
}

fn journal_torn(why: Why) -> bool {
    match why {
        Truncated => true,
        Flags => true,
        Checksum => true,
        Malformed => true,
        Kind(0) => true,
        _ => false,
    }
}

type JournalInput {
    file: HostFile,
    size: u64,
    base: u64,
    chunk: Bytes
}

fn journal_input(take file: HostFile, flush: bool) -> Result[JournalInput, Error] waits {
    let mut opened = take file
    if flush {
        disk_io(host.sync(mut opened))?
    }
    let file_stat = disk_io(host.stat_file(mut opened))?
    let chunk = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(65536))
    })?
    Ok(JournalInput(file: take opened, size: file_stat.size, base: 0, chunk: take chunk))
}

fn journal_chunk(mut input: JournalInput, path: String, offset: u64) -> Result[u64, Error] waits {
    if offset >= input.base && offset - input.base < list.len(input.chunk) {
        return Ok(offset - input.base)
    }
    list.clear(mut input.chunk)
    if disk_io(host.read_at(mut input.file, offset, mut input.chunk))? == 0 {
        return Error(disk_fault(path, offset, Truncated))
    }
    input.base = offset
    Ok(0u64)
}

fn journal_prefix(mut input: JournalInput, path: String, offset: u64, width: u64) -> Result[Bytes, Error] waits {
    if offset > input.size || width > input.size - offset {
        return Error(disk_fault(path, offset, Truncated))
    }
    let mut raw = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(width))
    })?
    while list.len(raw) < width {
        let start = journal_chunk(mut input, path, offset + list.len(raw))?
        let part = order.min(width - list.len(raw), list.len(input.chunk) - start)
        list.append(mut raw, list.slice(input.chunk, start, start + part))
    }
    Ok(take raw)
}

type JournalFrame {
    end: u64,
    kind: u16,
    payload: Option[Bytes]
}

fn journal_read_frame(mut input: JournalInput, path: String, context: DiskContext, offset: u64) -> Result[JournalFrame, Error] waits {
    let head = journal_prefix(mut input, path, offset, 16)?
    let frame = disk_read_frame_head(path, head, offset)?
    let keep = journal_event_kind(frame.kind)
    let payload = disk_stream_payload(mut input, path, context, offset, head, frame, if keep {
        frame.size
    } else {
        0
    })?
    disk_check_frame_kind(path, context, frame.kind, frame.flags, offset)?
    let event_payload: Option[Bytes] = if keep {
        Some(take payload)
    } else {
        None
    }
    Ok(JournalFrame(end: offset + 16 + frame.size, kind: frame.kind, payload: take event_payload))
}

fn disk_stream_payload(mut input: JournalInput, path: String, context: DiskContext, offset: u64, head: Bytes, frame: DiskFrameHead, keep: u64) -> Result[Bytes, Error] waits {
    if frame.size > input.size - offset - 16 {
        return Error(disk_fault(path, offset, Truncated))
    }
    let mut check = disk_allocation(scoped fn() -> Result[std.check.Xxh3, Error] {
        capacity(disk_check_start(context, offset, head))
    })?
    let mut payload = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(keep))
    })?
    let end = offset + 16 + frame.size
    let mut at = offset + 16
    while at < end {
        let start = journal_chunk(mut input, path, at)?
        let part = order.min(end - at, list.len(input.chunk) - start)
        std.check.add(mut check, input.chunk, start, start + part)
        if list.len(payload) < keep {
            let capture = order.min(part, keep - list.len(payload))
            list.append(mut payload, list.slice(input.chunk, start, start + capture))
        }
        at += part
    }
    if std.check.finish(check) != frame.checksum {
        return Error(disk_fault(path, offset, Checksum))
    }
    Ok(take payload)
}

// Middle segments stop at the next HEADER's prev_end. Only the last segment
// reads beyond its durable boundary, stopping at the first physically bad frame.
fn journal_scan[S](mut input: JournalInput, path: String, id: StoreId, seq: u64, boundary: Option[u64], last: bool, mut destination: S, consume: scoped fn(mut S, take JournalEvent) -> Result[(), Error]) -> Result[(u64, u64), Error] waits {
    let header = disk_read_header(path, journal_prefix(mut input, path, 0, 72)?, 2, Some(seq), Some(id))?
    let durable_end = match boundary {
        Some(d) => d,
        None => 72u64
    }
    if durable_end < 72 || durable_end > input.size {
        return Error(disk_fault(path, input.size, Truncated))
    }
    let stop = if last {
        input.size
    } else {
        durable_end
    }
    let mut at = 72u64
    let mut accepted = 0u64
    while at < stop {
        let received = journal_read_frame(mut input, path, header.context, at)
        let frame = match take received {
            Ok(take valid) => take valid,
            Error(Corrupt(take fault)) => {
                if !last || at < durable_end || !journal_torn(fault.why) {
                    return Error(Corrupt(take fault))
                }
                break
            },
            Error(take problem) => return Error(take problem),
        }
        if at < durable_end && frame.end > durable_end {
            return Error(disk_fault(path, at, Truncated))
        }
        if let Some(payload) = frame.payload {
            consume(mut destination, journal_decode(path, frame.kind, payload)?)?
            accepted += frame.end - at
        }
        at = frame.end
    }
    Ok((at, accepted))
}

type JournalReplay {
    state: State,
    names: Map[String, u32],
    record_bytes: u64,
    next_node: u64
}

fn journal_replay(take state: State, next_node: u64) -> Result[JournalReplay, Error] {
    let (take names, total) = disk_allocation(scoped fn() -> Result[(Map[String, u32], u64), Error] {
        let mut names: Map[String, u32] = map.new()
        capacity(map.try_reserve(mut names, list.len(state.tips)))?
        let mut total = 0u64
        for held in state.pins {
            total += pin_record_bytes(held.name)
        }
        for head in state.tips {
            total += branch_record_bytes(head.name)
            map.insert(mut names, string.from(head.name), head.id)
        }
        Ok((take names, total))
    })?
    Ok(JournalReplay(state: take state, names: take names, record_bytes: total, next_node: next_node))
}

fn journal_apply_ops(file: String, mut ids: u64, mut tree: PageTree, ops: List[JournalOp]) -> Result[(), Error] {
    if list.len(ops) == 0 {
        return Ok(())
    }
    let mut next_stamp = stamp_after(ids)?
    for op in ops {
        if tree_domain(tree) == CollectionMap {
            let valid = list.len(op.key) >= 4 && match std.page.collection_child(tree.root, list.slice(op.key, 0, 4)) {
                Some(_) => true,
                None => false
            }
            if !valid {
                return Error(disk_fault(file, 0, Malformed))
            }
        }
        match op.value {
            Some(value) => put_page_row(mut tree, op.key, value, 0, mut next_stamp)?,
            None => {
                let _ = remove_page_row(mut tree, op.key, 0, mut next_stamp)?
            },
        }
    }
    canonical_tree(mut tree)?
    ids = next_stamp - 1
    Ok(())
}

fn journal_apply_commit(file: String, mut replay: JournalReplay, commit: JournalCommit) -> Result[(), Error] {
    // Section 3.4 step 6: the branch must exist, and the version is its head + 1.
    let total_count = list.len(replay.state.tips)
    let mut i = total_count
    for k in 0u64 .. total_count {
        if replay.state.tips[k].id == commit.branch {
            i = k
        }
    }
    if i == total_count || int.checked_add(replay.state.tips[i].head, 1) != Some(commit.version) {
        return Error(disk_fault(file, 0, Gap(commit.version)))
    }
    journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[i].roots.collections, commit.data)?
    journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[i].roots.streams, commit.streams)?
    replay.state.tips[i].head = commit.version
    replay.state.tips[i].at = commit.at
    Ok(())
}

fn journal_apply(file: String, mut replay: JournalReplay, take event: JournalEvent) -> Result[(), Error] {
    match take event {
        Commit(take commit) => journal_apply_commit(file, mut replay, commit),
        Fork(take encoded) => journal_apply_fork(file, mut replay, take encoded),
    }
}

fn journal_apply_fork(file: String, mut replay: JournalReplay, take encoded: JournalFork) -> Result[(), Error] {
    let JournalFork(id: id, parent: parent, forked_at: forked_at, name: take name) = take encoded
    let charge = branch_record_bytes(name)
    if id < replay.state.next_branch || id == 4294967295 || charge > META_LIMIT - replay.record_bytes || map.contains(replay.names, name) {
        return Error(disk_fault(file, 0, Malformed))
    }
    let (take roots, at, take key) = disk_allocation(scoped fn() -> Result[(Roots, u64, String), Error] {
        for source in replay.state.tips {
            if source.id != parent {
                continue
            }
            if source.head != forked_at {
                return Error(disk_fault(file, 0, Malformed))
            }
            return Ok((share_roots(source.roots), source.at, string.from(name)))
        }
        Error(disk_fault(file, 0, Malformed))
    })?
    capacity(list.try_reserve(mut replay.state.tips, 1))?
    capacity(map.try_reserve(mut replay.names, 1))?
    map.insert(mut replay.names, take key, id)
    list.push(mut replay.state.tips, Tip(id: id, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: forked_at, at: at))
    replay.record_bytes += charge
    replay.state.next_branch = id + 1
    Ok(())
}

// The lookahead needs only the next HEADER's prev_end. Read that prefix, not
// a second whole segment, while the current segment's buffer is retained.
fn journal_header(d: Dir, id: StoreId, seq: u64, flush: bool) -> Result[Option[DiskHeader], Error] waits {
    let path = capacity(disk_path("j-", seq, ""))?
    let mut file = match host.open(d, path, Read) {
        Ok(take file) => take file,
        Error(NotFound) => return Ok(None),
        Error(e) => return Error(Io(e))
    }
    if flush {
        disk_io(host.sync(mut file))?
    }
    let mut raw: Bytes = list.with_capacity(72)
    while list.len(raw) < 72 {
        let mut chunk: Bytes = list.with_capacity(72 - list.len(raw))
        if disk_io(host.read(mut file, mut chunk))? == 0 {
            break
        }
        list.append(mut raw, chunk)
    }
    disk_io(host.close(take file))?
    Ok(Some(disk_read_header(path, raw, 2, Some(seq), Some(id))?))
}

type JournalRecovered {
    replay: JournalReplay,
    seq: u64,
    end: u64,
    uncovered: u64
}

fn journal_recover(d: Dir, id: StoreId, first: u64, flush: bool, take initial: JournalReplay) -> Result[JournalRecovered, Error] waits {
    let mut replay = take initial
    let mut seq = first
    let mut uncovered = 0u64
    loop {
        let path = capacity(disk_path("j-", seq, ""))?
        let file = match host.open(d, path, Read) {
            Ok(take handle) => take handle,
            Error(NotFound) => return Error(disk_fault(path, 0, Header)),
            Error(e) => return Error(Io(e))
        }
        let mut source = journal_input(take file, flush)?
        let following = journal_following(d, id, seq, flush)?
        let boundary = match following {
            Some(h) => Some(h.prev_end),
            None => disk_end(d, id, seq)?
        }
        let last = match following {
            None => true,
            Some(_) => false
        }
        let scanned = journal_scan(mut source, path, id, seq, boundary, last, mut replay, scoped fn(mut recovered_state: JournalReplay, take event: JournalEvent) -> Result[(), Error] {
            journal_apply(path, mut recovered_state, take event)
        })
        let JournalInput(file: take consumed_file, ..) = take source
        disk_io(host.close(take consumed_file))?
        let (end, segment_bytes) = match take scanned {
            Ok(segment) => segment,
            Error(Corrupt(take fault)) => {
                // A bad last HEADER without a good END is an incomplete
                // segment creation. Valid headers with bad frames follow d.
                let no_end = match boundary {
                    None => true,
                    Some(_) => false
                }
                if last && no_end && seq == first {
                    if let Error(Corrupt(_)) = journal_header(d, id, seq, false) {
                        return Ok(JournalRecovered(replay: take replay, seq: seq - 1, end: 0, uncovered: uncovered))
                    }
                }
                return Error(Corrupt(take fault))
            },
            Error(take e) => return Error(take e)
        }
        uncovered = int.saturating_add(uncovered, segment_bytes)
        if let None = following {
            return Ok(JournalRecovered(replay: take replay, seq: seq, end: end, uncovered: uncovered))
        }
        seq += 1
    }
}

// AP15 counts distinct row versions after replay. A FORK only shares the
// parent's roots, so its presence alone cannot change the logical account.
fn journal_account(replay: JournalReplay) -> Result[u64, Error] {
    disk_allocation(scoped fn() -> Result[u64, Error] {
        capacity(state_account(replay.state))
    })
}

// A writer that ended without its ack (cancelled before it could send
// Broken) is a terminal failure: the place stops, unacked sequences unanswered.
fn journal_receive(db: Db) -> Ack waits {
    match channel.receive(disk_state(db).acks) {
        Ok(ack) => ack,
        Error(_) => Broken(Closed),
    }
}

fn journal_ack(mut db: Db, take ack: Ack) -> Result[(), Error] {
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Result[(), Error] {
        match ack {
            Journaled(n, bytes_out) => {
                state.journaled = n
                state.inflight -= bytes_out - state.acked_bytes
                state.acked_bytes = bytes_out
                Ok(())
            },
            Broken(e) => {
                if let None = state.poison { state.poison = Some(e) }
                Error(Poisoned(option.unwrap(state.poison)))
            },
        }
    })
}

fn journal_poll(mut db: Db) -> Result[(), Error] {
    let _ = journal_poll_groups(mut db)?
    Ok(())
}

fn journal_poll_groups(mut db: Db) -> Result[u64, Error] {
    let mut groups = 0u64
    while let Some(take ack) = close_ack(db) {
        journal_ack(mut db, take ack)?
        groups += 1
    }
    healthy(db)?
    Ok(groups)
}

fn journal_following(d: Dir, id: StoreId, seq: u64, flush: bool) -> Result[Option[DiskHeader], Error] waits {
    let Some(next_seq) = int.checked_add(seq, 1) else {
        return Ok(None)
    }
    let next_header = journal_header(d, id, next_seq, flush)
    match take next_header {
        Ok(h) => Ok(h),
        Error(Corrupt(_)) => {
            let beyond = if let Some(following_seq) = int.checked_add(next_seq, 1) {
                disk_exists(d, capacity(disk_path("j-", following_seq, ""))?)?
            } else {
                false
            }
            if beyond || disk_end(d, id, next_seq)? != None {
                let next_path = capacity(disk_path("j-", next_seq, ""))?
                return Error(disk_fault(next_path, 0, Header))
            }
            Ok(None)
        },
        Error(take e) => return Error(take e)
    }
}

pub fn recorded(db: Db, b: Branch, wanted: u64) -> Result[Option[Recorded], Error] waits {
    match recorded_commit(db, b, wanted)? {
        Some(commit) => Ok(recorded_call(db.store, b, commit)),
        None => Ok(None),
    }
}

fn reserve_tx(mut tx: Tx, fault: bool) -> Result[Bytes, Bytes] {
    if fault {
        let no_values: List[u64] = list.new()
        let _ = no_values[0]
    }
    Ok(key_word(7))
}

// L33. AM5 and MEM-24 give 4096 + 32 bytes. MEM-30 gives 8192 body
// steps + 6 fixed calls + at most 4096/8 issued-ID latches.
pub fn law_call_reserve(c: Clock) -> bool waits {
    let byte_total = 4128u64
    let step_total = 8710u64
    let plan = Plan(n_e: 4096, s_e: 8192, reply_max: 4096)
    let Some(grant) = call_reserves(plan) else {
        return false
    }
    if grant.retained != byte_total || grant.steps != step_total {
        return false
    }
    let mut db = test_db(c, 1073741824)
    let key = key_word(23)
    let request = request_digest(key, key)
    let no_record: Option[CallRecord] = None
    for fault in[false, true] {
        let p = if fault {
            1u64
        } else {
            0u64
        }
        let admission = result.unwrap(admit(mut db, key, p, request))
        let Admitted(take complete) = take admission else {
            return false
        }
        let ci = next_call_info(db)
        // One step is the call of metered_draft outside its own reserve.
        let rejected = bound steps step_total {
            metered_draft(db, complete, ci, plan, grant, no_record, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, fault)
            })
        }
        match take rejected {
            Ok(Error(DraftStopped(OutOfSteps(used)))) => if used != step_total {
                return false
            },
            _ => return false,
        }
        let admitted = bound steps step_total + 1u64 {
            metered_draft(db, complete, ci, plan, grant, no_record, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, fault)
            })
        }
        match take admitted {
            Ok(Ok(draft)) => match draft.stage {
                Ran(_) if !fault => (),
                Over(Failed(_)) if fault => (),
                _ => return false,
            },
            _ => return false,
        }
        let short = bound bytes byte_total - 1u64 {
            serve(mut db, take complete, plan, None, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, fault)
            })
        }
        match take short {
            Ok(Error(Before(Full(Allocation(problem)), None))) => if problem.requested != byte_total || problem.available != byte_total - 1u64 {
                return false
            },
            _ => return false,
        }
        let retry = result.unwrap(admit(mut db, key, p, request))
        let Abandoned(take completion) = take retry else {
            return false
        }
        let exact = bound bytes byte_total {
            serve(mut db, take completion, plan, None, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, fault)
            })
        }
        match take exact {
            Ok(Ok(Committed(receipt))) if !fault => if receipt.reply != key_word(7) {
                return false
            },
            Ok(Ok(Failed(take pending_run, Raised(2u32)))) if fault => match conclude(mut db, take pending_run, key_word(2), Resident) {
                Ok(Committed(receipt)) => if receipt.reply != key_word(2) {
                    return false
                },
                _ => return false,
            },
            _ => return false,
        }
    }
    let admission = result.unwrap(admit(mut db, key, 2, request))
    let Admitted(take complete) = take admission else {
        return false
    }
    let small = Plan(n_e: 1024, s_e: plan.s_e, reply_max: plan.reply_max)
    // The two log nodes (48 bytes) and a 944-byte reply fit in 1024. The
    // reply row's stored copy, 41 + 944 = 985 bytes rounded up to 992, does
    // not fit in the 32 left.
    let kept_inside = match serve(mut db, take complete, small, None, fn(mut tx: Tx) -> Result[Bytes, Bytes] {
        let mut output: Bytes = list.with_capacity(944)
        list.fill(mut output, 944, 7u8)
        Ok(take output)
    }) {
        Ok(Failed(_, OutOfBytes(problem))) => problem.requested == 992 && problem.available == 32,
        _ => false,
    }
    kept_inside && reserve_settles_pin(c, 10, plan) && reserve_settles_pin(c, 100000, plan)
}

// Build the pinned tree directly so its size does not make the setup a call.
fn reserve_pinned_data(mut db: Db, t: Table[u64, u64], rows: u64) -> () {
    let mut input: List[std.page.Row] = list.with_capacity(rows)
    let mut raw: Bytes = list.with_capacity(10)
    result.unwrap(le(mut raw, 0, 2))
    result.unwrap(le(mut raw, 1, 8))
    for i in 0u64 .. rows {
        list.push(mut input, std.page.Row(key: key_word(i), value: result.unwrap(copied(raw)), charge: 94))
    }
    result.unwrap(bulk_store_collection(mut db.heads[0].roots.collections, t.id, 1, input, mut db.next_node))
    db.resident = one_page_account(db.heads[0].roots)
}

fn reserve_settles_pin(c: Clock, rows: u64, plan: Plan) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let source = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    reserve_pinned_data(mut db, source, rows)
    let base = snapshot(db)
    result.unwrap(pin(mut db, "reserve", base))
    // One replaced leaf has at most 32 rows. Sixty-four overwrites of its
    // first key leave more obsolete charges than the extra leaf and reply.
    for i in 0u64 .. 64 {
        if !typed_put(mut db, source, 0, 2u64 + i) {
            return false
        }
    }
    let stream = key_word(47)
    let request = request_digest(stream, stream)
    let admission = result.unwrap(admit(mut db, stream, 0, request))
    let Admitted(take complete) = take admission else {
        return false
    }
    db.ceiling = db.resident
    let unsettled = db.changes
    if db.settled == unsettled {
        return false
    }
    let cut = db.checkpointed
    let Some(grant) = call_reserves(plan) else {
        return false
    }
    let ci = next_call_info(db)
    let no_record: Option[CallRecord] = None
    let short = bound steps grant.steps {
        metered_draft(db, complete, ci, plan, grant, no_record, fn(mut tx: Tx) -> Result[Bytes, Bytes] {
            Ok(key_word(7))
        })
    }
    match take short {
        Ok(Error(DraftStopped(OutOfSteps(used)))) => if used != grant.steps {
            return false
        },
        _ => return false,
    }
    match serve(mut db, take complete, plan, None, fn(mut tx: Tx) -> Result[Bytes, Bytes] {
        Ok(key_word(7))
    }) {
        Ok(Committed(receipt)) => receipt.reply == key_word(7) && accounts(db).exact && db.checkpointed == cut + 1,
        _ => false,
    }
}

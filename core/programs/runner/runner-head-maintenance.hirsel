// The head's maintenance driver (RUNNER-SPEC §12.5, Store 1.3). The head
// owns the Db, so it runs the store's upkeep itself, one bounded slice at a
// time. Idle turns run the first job with work in this order:
//
// 1. one index build chunk while an index is Backfilling (§1.2);
// 2. one expiry sweep commit while a row is due (STORE-SPEC §1.2 "Expiry");
// 3. one retention sweep commit while a Log is over its declared `Keep(n)`
//    (STORE-SPEC §14.4a);
// 4. one step of a projector the declaration registered (STORE-SPEC §1.14
//    "Driving"), round-robin over those with work;
// 5. one slice of the current scrub tour (§11.17);
// 6. one slice of the index walker (STORE-SPEC §1.2).
//
// Projection also runs between calls after 32 commits. A build chunk after
// every 16th group raised user-commit p99 from 31 us to 19.5 ms (Store 1.3's kill rule,
// RUNNER-SPEC §12.5). Build chunks and a walker's demotion run while an
// export lease is held: each is a schema commit that catch-up (STORE-SPEC
// §3.5a) ships to the preparation as a step. A projector step moves its
// pins, so it waits for the lease. A job whose
// slice is refused stops for this open of the place, a projector alone of its
// kind; only Poisoned ends the head.
// Rows per build chunk, per walker slice and per retention sweep. Each build
// chunk is one schema commit, one checkpoint.
const UPKEEP_ROWS: u64 = 1024u64

// Row bytes one expiry sweep commit deletes, beside UPKEEP_ROWS rows.
const UPKEEP_SWEEP_BYTES: u64 = 1048576u64

// Bytes one scrub slice reads, and one projector step's page.
const UPKEEP_SCRUB_BYTES: u64 = 1048576u64

// A finished scrub tour or walk starts again this long after it ends, at
// the first idle turn after that.
const UPKEEP_REST_MS: u64 = 3600000u64

const UPKEEP_PROJECT_COMMITS: u64 = 32u64

type Upkeep {
    building: bool,
    // A build chunk has committed since the last release of the head.
    built: bool,
    sweeping: bool,
    swept: u64,
    retaining: bool,
    scrubbing: bool,
    tour: Option[store.Scrub],
    tour_from: u64,
    tour_start_version: u64,
    tour_started_ms: u64,
    tour_faults: u64,
    tours: u64,
    scrub_faults: u64,
    walking: bool,
    walk: store.IndexWalk,
    walk_from: u64,
    walks: u64,
    walk_findings: u64,
    // The projectors whose step was refused, by name, and where the next
    // round-robin turn starts.
    halted: List[String],
    project_from: u64,
    project_checked: u64,
    projected: u64
}

fn upkeep() -> Upkeep {
    Upkeep(building: true, built: false, sweeping: true, swept: 0u64, retaining: true, scrubbing: true, tour: None, tour_from: 0u64, tour_start_version: 0u64, tour_started_ms: 0u64, tour_faults: 0u64, tours: 0u64, scrub_faults: 0u64, walking: true, walk: store.begin_verify(Repair), walk_from: 0u64, walks: 0u64, walk_findings: 0u64, halted: list.new(), project_from: 0u64, project_checked: 0u64, projected: 0u64)
}

// One slice of the first job that has work. False when none has, so the
// head waits for its inbox.
fn advance_maintenance[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    if upkeep_build(mut hd)? {
        return Ok(true)
    }
    if upkeep_sweep(mut hd)? {
        return Ok(true)
    }
    if upkeep_retain(mut hd)? {
        return Ok(true)
    }
    if upkeep_project(mut hd, false)? {
        return Ok(true)
    }
    if upkeep_scrub(mut hd)? {
        return Ok(true)
    }
    upkeep_walk(mut hd)
}

fn upkeep_build[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    if !hd.upkeep.building {
        return Ok(false)
    }
    match store.index_build_step(mut hd.db, UPKEEP_ROWS) {
        Ok(Some(_)) => {
            hd.upkeep.built = true
            Ok(true)
        },
        Ok(None) => {
            upkeep_built(mut hd)
            Ok(false)
        },
        Error(Poisoned(e)) => Error(Poisoned(e)),
        Error(_) => {
            hd.upkeep.building = false
            upkeep_built(mut hd)
            Ok(false)
        },
    }
}

// Readers serve from the last released snapshot, so a finished build is
// released for them to serve its index. Chunks before it change no row.
fn upkeep_built[G: send, H: shareable + inert + send](mut hd: Head[G, H]) waits {
    if hd.upkeep.built {
        hd.upkeep.built = false
        upkeep_release(mut hd)
    }
}

fn upkeep_release[G: send, H: shareable + inert + send](mut hd: Head[G, H]) waits {
    let release = durable_release(publisher_base(hd.db, hd.publish_images), list.new())
    if list.len(hd.held) != 0u64 {
        list.push(mut hd.held, Loose(take release))
    } else {
        publish_release(mut hd, take release)
    }
}

// A sweep's commit is a data commit like a group's: it is released to
// readers once its sync covers it, behind any held group. A drift the sweep
// proved demoted an index, so readers must stop serving it.
fn upkeep_sweep[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    if !hd.upkeep.sweeping {
        return Ok(false)
    }
    let before = store.main_commit_version(hd.db)
    match store.sweep_expired(mut hd.db, store.Limits(rows: UPKEEP_ROWS, byte_limit: UPKEEP_SWEEP_BYTES)) {
        Ok(store.Swept(rows: rows, ticket: Some(ticket))) => {
            hd.upkeep.swept = int.saturating_add(hd.upkeep.swept, rows)
            hd.last = Some(ticket)
            close_group(mut hd)
            Ok(true)
        },
        Ok(_) => {
            if store.main_commit_version(hd.db) == before {
                return Ok(false)
            }
            upkeep_release(mut hd)
            Ok(true)
        },
        Error(Poisoned(e)) => Error(Poisoned(e)),
        Error(_) => {
            hd.upkeep.sweeping = false
            Ok(false)
        },
    }
}

// A retention sweep is a data commit like an expiry sweep's: it closes as a
// group with no answers and is released once its sync covers it (V4).
fn upkeep_retain[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    if !hd.upkeep.retaining {
        return Ok(false)
    }
    match store.retain_step(mut hd.db, UPKEEP_ROWS) {
        Ok(Some(ticket)) => {
            hd.last = Some(ticket)
            close_group(mut hd)
            Ok(true)
        },
        Ok(None) => Ok(false),
        Error(Poisoned(e)) => Error(Poisoned(e)),
        Error(_) => {
            hd.upkeep.retaining = false
            Ok(false)
        },
    }
}

fn interleave_projector[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    if int.saturating_sub(store.main_commit_version(hd.db), hd.upkeep.project_checked) < UPKEEP_PROJECT_COMMITS {
        return Ok(false)
    }
    upkeep_project(mut hd, true)
}

fn upkeep_project[G: send, H: shareable + inert + send](mut hd: Head[G, H], interleaved: bool) -> Result[bool, store.Error] waits {
    if store.export_leased(hd.db) {
        return Ok(false)
    }
    let did_work = projector_turn(mut hd, interleaved)?
    hd.upkeep.project_checked = store.main_commit_version(hd.db)
    Ok(did_work)
}

// An idle turn searches for work. Under load, give one registered projector
// a turn, even if its step turns out to be idle.
fn projector_turn[G: send, H: shareable + inert + send](mut hd: Head[G, H], interleaved: bool) -> Result[bool, store.Error] waits {
    let names = store.projector_names(hd.db)
    let n = list.len(names)
    for k in 0u64 .. n {
        let at = (hd.upkeep.project_from + k) % n
        let name = names[at]
        if list.any(hd.upkeep.halted, fn(held: String) -> bool {
            held == name
        }) {
            continue
        }
        if interleaved {
            // Release earlier writes before publishing the projector's snapshot.
            if unreleased(hd) {
                gate(mut hd)?
                if hd.cut {
                    return Ok(true)
                }
            }
            hd.upkeep.project_from = (at + 1u64) % n
        }
        let before = store.main_commit_version(hd.db)
        match store.project_step(mut hd.db, name, store.Limits(rows: UPKEEP_ROWS, byte_limit: UPKEEP_SCRUB_BYTES)) {
            Ok(Idle) => if interleaved {
                return Ok(false)
            },
            Ok(_) => {
                hd.upkeep.project_from = (at + 1u64) % n
                hd.upkeep.projected += 1u64
                if store.main_commit_version(hd.db) != before {
                    upkeep_release(mut hd)
                }
                return Ok(true)
            },
            Error(Store(Poisoned(e))) => return Error(Poisoned(e)),
            Error(_) => {
                list.push(mut hd.upkeep.halted, clone(name))
                if interleaved {
                    return Ok(false)
                }
            },
        }
    }
    Ok(false)
}

// A tour ends when its last pack is read, and is dropped then, so it holds
// no pack past its end. A store without a directory has nothing to scrub.
fn upkeep_scrub[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    if !hd.upkeep.scrubbing {
        return Ok(false)
    }
    let running = match replace(mut hd.upkeep.tour, None) {
        Some(take tour) => take tour,
        None => {
            if store.keyed_time(hd.db) < hd.upkeep.tour_from {
                return Ok(false)
            }
            match store.begin_scrub(mut hd.db) {
                Ok(take tour) => {
                    hd.upkeep.tour_start_version = store.main_commit_version(hd.db)
                    hd.upkeep.tour_started_ms = store.keyed_time(hd.db)
                    hd.upkeep.tour_faults = 0u64
                    take tour
                },
                Error(Poisoned(e)) => return Error(Poisoned(e)),
                Error(_) => {
                    hd.upkeep.scrubbing = false
                    return Ok(false)
                },
            }
        },
    }
    let mut tour = take running
    match store.scrub_step(mut tour, UPKEEP_SCRUB_BYTES) {
        Ok(report) => {
            let found = list.len(report.faults)
            hd.upkeep.tour_faults = int.saturating_add(hd.upkeep.tour_faults, found)
            hd.upkeep.scrub_faults = int.saturating_add(hd.upkeep.scrub_faults, found)
            if let Some(_) = report.next {
                hd.upkeep.tour = Some(take tour)
            } else {
                let _ = take tour
                hd.upkeep.tours += 1u64
                let now_ms = store.keyed_time(hd.db)
                let _ = store.record_scrub_round(hd.db, report.generation, hd.upkeep.tour_start_version, store.main_commit_version(hd.db), hd.upkeep.tour_started_ms, now_ms, report.checked, hd.upkeep.tour_faults, true)
                if let Some(next) = int.checked_add(now_ms, UPKEEP_REST_MS) {
                    hd.upkeep.tour_from = next
                } else {
                    hd.upkeep.scrubbing = false
                }
            }
            Ok(true)
        },
        Error(Poisoned(e)) => Error(Poisoned(e)),
        Error(_) => {
            hd.upkeep.scrubbing = false
            Ok(false)
        },
    }
}

fn upkeep_walk[G: send, H: shareable + inert + send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    if !hd.upkeep.walking || store.keyed_time(hd.db) < hd.upkeep.walk_from {
        return Ok(false)
    }
    let before = store.main_commit_version(hd.db)
    match store.verify_step(mut hd.db, mut hd.upkeep.walk, UPKEEP_ROWS) {
        Ok(report) => {
            if report.done {
                hd.upkeep.walks += 1u64
                if let Some(next) = int.checked_add(store.keyed_time(hd.db), UPKEEP_REST_MS) {
                    hd.upkeep.walk_from = next
                } else {
                    hd.upkeep.walking = false
                }
                return Ok(false)
            }
            hd.upkeep.walk_findings = int.saturating_add(hd.upkeep.walk_findings, list.len(report.findings))
            // A demotion: readers must stop serving the index it proved wrong.
            if store.main_commit_version(hd.db) != before {
                upkeep_release(mut hd)
            }
            Ok(true)
        },
        Error(Poisoned(e)) => Error(Poisoned(e)),
        Error(_) => {
            hd.upkeep.walking = false
            Ok(false)
        },
    }
}

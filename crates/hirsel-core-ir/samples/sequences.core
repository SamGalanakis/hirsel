  branch v5, b2, b3
b2:
  raise bounds
b3:
  v6: u64 = const 4
  v7: bool = lt v1, v6                 ; then the size: one Link at W = u32
  branch v7, b4, b5
b4:
  v8: u64 = const 1
  return v8
b5:
  v9: u64 = const 0
  return v9
}

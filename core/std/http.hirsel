// HTTP-4: pure request framing over http1's parsed offsets. I/O belongs to
// the connection. ADAPTED Go net/http/transfer.go and internal/chunked.go;
// strict duplicate refusal and extension grammar follow docs/spec/http.md.
pub type Framing: key = Empty | ContentLength(u64) | Chunked | CloseDelimited

pub type BodyError: key {
    status: u16,
    close: bool
}

fn failure(status: u16) -> BodyError {
    BodyError(status, close: true)
}

type ResponseField: send {
    name: FrozenBytes,
    value: FrozenBytes
}

type ResponseBody: send = OwnedBody(FrozenBytes) | SharedBody(Arc[Bytes])

pub opaque type Response: send {
    status: u16,
    fields: List[ResponseField],
    body: ResponseBody,
    close: bool,
    invalid: bool
}

pub type ResponseError: send = StatusInvalid | HeaderReserved | HeaderInvalid | HeadTooLarge | InvalidUpgrade | InvalidStream | Allocation(Capacity) | DateInvalid

pub type HandlerError = ResponseError

/// Builds a final response. Only the connection may send informational statuses.
pub fn response(status: u16, take body: Bytes, close: bool) -> Result[Response, ResponseError] {
    response_frozen(status, bytebuf.freeze(take body), close)
}

/// Builds a response with an immutable payload.
pub fn response_frozen(status: u16, take body: FrozenBytes, close: bool) -> Result[Response, ResponseError] {
    response_with(status, OwnedBody(take body), close)
}

pub fn response_shared(status: u16, take body: Arc[Bytes], close: bool) -> Result[Response, ResponseError] {
    response_with(status, SharedBody(take body), close)
}

fn response_with(status: u16, take body: ResponseBody, close: bool) -> Result[Response, ResponseError] {
    if status < 200 || status > 599 {
        return Error(StatusInvalid)
    }
    Ok(Response(status, fields: list.new(), body: take body, close, invalid: false))
}

fn response_body(r: Response) -> View[Bytes] in r {
    match r.body {
        OwnedBody(data) => bytebuf.as_bytes(data),
        SharedBody(data) => list.slice(data, 0, list.len(data)),
    }
}

fn reserved_field(name: Bytes) -> bool {
    http1.equal_ascii(name, string.as_bytes("content-length")) || http1.equal_ascii(name, string.as_bytes("transfer-encoding")) || http1.equal_ascii(name, string.as_bytes("connection"))
}

fn valid_field(name: Bytes, value: Bytes) -> bool {
    if !http1.valid_field(name, value) {
        return false
    }
    let n = list.len(value)
    n == 0 || value[0] > 32 && value[n - 1] > 32
}

pub fn check_response_field(name: Bytes, value: Bytes) -> Result[(), HandlerError] {
    if reserved_field(name) {
        return Error(HeaderReserved)
    }
    if !valid_field(name, value) {
        return Error(HeaderInvalid)
    }
    Ok(())
}

/// Appends a handler-owned field. Framing fields belong to the connection.
pub fn header(mut r: Response, take name: Bytes, take value: Bytes) -> Result[(), ResponseError] {
    if let Error(e) = check_response_field(name, value) {
        r.invalid = true
        return Error(e)
    }
    push_field(mut r, bytebuf.freeze(take name), bytebuf.freeze(take value))
}

/// Media types whose wire spelling is fixed by the library.
pub type ContentType: key = TextPlain | ApplicationJson

/// Appends a Content-Type whose name and value are valid by construction.
pub fn content_type(mut r: Response, media: ContentType) -> Result[(), ResponseError] {
    let name: FrozenBytes = b"Content-Type"
    let value: FrozenBytes = match media {
        TextPlain => b"text/plain",
        ApplicationJson => b"application/json",
    }
    push_field(mut r, take name, take value)
}

fn push_field(mut r: Response, take name: FrozenBytes, take value: FrozenBytes) -> Result[(), ResponseError] {
    list.push(mut r.fields, ResponseField(name: take name, value: take value))
    Ok(())
}

fn append_head(mut out: Bytes, b: Bytes) -> Result[(), ResponseError] {
    if list.len(b) > list.capacity(out) - list.len(out) {
        return Error(HeadTooLarge)
    }
    list.append(mut out, b)
    Ok(())
}

fn head_text(mut out: Bytes, s: String) -> Result[(), ResponseError] {
    append_head(mut out, string.as_bytes(s))
}

fn decimal(mut out: Bytes, n: u64, width: u64) -> Result[(), ResponseError] {
    let mut digits: Inline[u8, 64] =[0; 64]
    let mut start = int.radix_digits(n, 10, mut digits)
    while 64 - start < width {
        start -= 1
        digits[start] = b'0'
    }
    if bytebuf.append_inline(mut out, digits, start, 64) {
        Ok(())
    } else {
        Error(HeadTooLarge)
    }
}

// IMF-fixdate uses UTC and a four-digit year. Refuse at the Date field before
// appending it when the wall time is outside std.time's timestamp range.
fn date_field(mut out: Bytes, wall_ms: u64) -> Result[(), ResponseError] {
    let Some(stamp) = time.from_unix_ms(wall_ms) else {
        return Error(DateInvalid)
    }
    // A valid UTC timestamp has a civil reading at offset zero.
    let utc = option.unwrap(time.civil(stamp, 0))
    let date = time.date_of(utc)
    let weekday = match time.weekday(date) {
        Monday => "Mon",
        Tuesday => "Tue",
        Wednesday => "Wed",
        Thursday => "Thu",
        Friday => "Fri",
        Saturday => "Sat",
        Sunday => "Sun",
    }
    let months =["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    let month: u64 = int.widen(time.month(date))
    head_text(mut out, "Date: ")?
    head_text(mut out, weekday)?
    head_text(mut out, ", ")?
    decimal(mut out, int.widen(time.day(date)), 2)?
    head_text(mut out, " ")?
    head_text(mut out, months[month - 1])?
    head_text(mut out, " ")?
    decimal(mut out, int.widen(time.year(date)), 4)?
    head_text(mut out, " ")?
    decimal(mut out, int.widen(time.hour(utc)), 2)?
    head_text(mut out, ":")?
    decimal(mut out, int.widen(time.minute(utc)), 2)?
    head_text(mut out, ":")?
    decimal(mut out, int.widen(time.second(utc)), 2)?
    head_text(mut out, " GMT\r\n")
}

type DateCache {
    second: Option[u64],
    length: u64,
    data: Inline[u8, 48]
}

fn date_cache() -> DateCache {
    DateCache(second: None, length: 0, data:[0; 48])
}

fn append_date(mut out: Bytes, wall_ms: u64, mut cache: DateCache) -> Result[(), ResponseError] {
    let second = wall_ms / 1000
    if cache.second == Some(second) {
        if bytebuf.append_inline(mut out, cache.data, 0, cache.length) {
            return Ok(())
        }
        return Error(HeadTooLarge)
    }
    let start = list.len(out)
    date_field(mut out, wall_ms)?
    let n = list.len(out) - start
    for i in 0u64 .. n {
        cache.data[i] = out[start + i]
    }
    cache.length = n
    cache.second = Some(second)
    Ok(())
}

fn status_line(mut out: Bytes, version: u8, status: u16) -> Result[(), ResponseError] {
    let line = match status {
        200 => if version == 0 {
            "HTTP/1.0 200 OK\r\n"
        } else {
            "HTTP/1.1 200 OK\r\n"
        },
        204 => if version == 0 {
            "HTTP/1.0 204 No Content\r\n"
        } else {
            "HTTP/1.1 204 No Content\r\n"
        },
        304 => if version == 0 {
            "HTTP/1.0 304 Not Modified\r\n"
        } else {
            "HTTP/1.1 304 Not Modified\r\n"
        },
        404 => if version == 0 {
            "HTTP/1.0 404 Not Found\r\n"
        } else {
            "HTTP/1.1 404 Not Found\r\n"
        },
        405 => if version == 0 {
            "HTTP/1.0 405 Method Not Allowed\r\n"
        } else {
            "HTTP/1.1 405 Method Not Allowed\r\n"
        },
        406 => if version == 0 {
            "HTTP/1.0 406 Not Acceptable\r\n"
        } else {
            "HTTP/1.1 406 Not Acceptable\r\n"
        },
        _ => {
            head_text(mut out, if version == 0 {
                "HTTP/1.0 "
            } else {
                "HTTP/1.1 "
            })?
            decimal(mut out, int.widen(status), 3)?
            return head_text(mut out, " \r\n")
        },
    }
    head_text(mut out, line)
}

fn has_body(status: u16) -> bool {
    status != 204 && status != 304
}

// Construct the whole head before the first send. A full head leaves the
// connection free to send a bounded error, with no partial header to undo.
fn response_head(mut out: Bytes, r: Response, version: u8, close: bool, wall_ms: u64, mut cache: DateCache) -> Result[(), ResponseError] {
    if r.invalid {
        return Error(HeaderInvalid)
    }
    list.clear(mut out)
    status_line(mut out, version, r.status)?
    for f in r.fields {
        let name = bytebuf.as_bytes(f.name)
        if !http1.equal_ascii(name, string.as_bytes("date")) {
            append_head(mut out, name)?
            head_text(mut out, ": ")?
            append_head(mut out, bytebuf.as_bytes(f.value))?
            head_text(mut out, "\r\n")?
        }
    }
    if has_body(r.status) {
        head_text(mut out, "Content-Length: ")?
        decimal(mut out, list.len(response_body(r)), 1)?
        head_text(mut out, "\r\n")?
    }
    if close {
        head_text(mut out, "Connection: close\r\n")?
    } else if version == 0 {
        head_text(mut out, "Connection: keep-alive\r\n")?
    }
    append_date(mut out, wall_ms, mut cache)?
    head_text(mut out, "\r\n")
}

fn part(b: Bytes, span: http1.Span) -> View[Bytes] in b {
    list.slice(b, span.start, span.end)
}

fn unreserved(x: u8) -> bool {
    int.is_ascii_alpha(x) || int.is_ascii_digit(x) || x == b'-' || x == b'.' || x == b'_' || x == b'~'
}

fn sub_delim(x: u8) -> bool {
    x == b'!' || x == b'$' || x == b'&' || x == 39 || x == b'(' || x == b')' || x == b'*' || x == b'+' || x == b',' || x == b';' || x == b'='
}

// RFC 3986 IP-literal accepts every IPv6 spelling (including an embedded
// IPv4 tail) and the IPvFuture grammar. It has no scope ID or DNS step.
fn ip_literal(b: Bytes) -> bool {
    let n = list.len(b)
    if n == 0 {
        return false
    }
    if int.to_ascii_lower(b[0]) == b'v' {
        let mut at: u64 = 1
        while at < n && int.ascii_digit(b[at], 16) != None {
            at += 1
        }
        if at == 1 || at + 1 >= n || b[at] != b'.' {
            return false
        }
        for i in at + 1 .. n {
            if !(unreserved(b[i]) || sub_delim(b[i]) || b[i] == b':') {
                return false
            }
        }
        return true
    }
    match net.parse_ip(b) {
        Ok(V6(_, _)) => true,
        _ => false,
    }
}

/// Validates the HTTP Host field authority, including an optional numeric port.
pub fn valid_authority(b: Bytes) -> bool {
    let n = list.len(b)
    if n == 0 {
        return false
    }
    let mut at: u64 = 0
    if b[0] == b'[' {
        let Some(close) = list.find_byte(b, 1, n, b']') else {
            return false
        }
        if !ip_literal(list.slice(b, 1, close)) {
            return false
        }
        at = close + 1
    } else {
        let high_bits: u64 = 0x8080808080808080
        while at + 8 <= n {
            let folded = list.word_le(b, at) | 0x2020202020202020
            let ascii = folded & ~high_bits
            // With bit seven clear, the additions cannot carry between bytes.
            // That bit marks a byte at or above 'a', or past 'z', respectively.
            let at_least_a = int.wrapping_add(ascii, 0x1f1f1f1f1f1f1f1f)
            let past_z = int.wrapping_add(ascii, 0x0505050505050505)
            if (at_least_a & ~(past_z | folded) & high_bits) != high_bits {
                break
            }
            at += 8
        }
        while at < n && b[at] != b':' {
            let c = b[at]
            if c == b'%' {
                if n - at < 3 || int.ascii_digit(b[at + 1], 16) == None || int.ascii_digit(b[at + 2], 16) == None {
                    return false
                }
                at += 3
            } else {
                if !(unreserved(c) || sub_delim(c)) {
                    return false
                }
                at += 1
            }
        }
        if at == 0 {
            return false
        }
    }
    if at == n {
        return true
    }
    if b[at] != b':' || n - at < 2 || n - at > 6 {
        return false
    }
    match int.parse_decimal_span(b, at + 1, n, 65535) {
        Ok(_) => true,
        Error(_) => false,
    }
}

type RequestHead {
    authority: Option[http1.Span],
    path: http1.Span,
    query: http1.Span,
    expect_continue: bool,
    upgrade_requested: bool,
    close: bool
}

type RequestField: key = HostField | ExpectField | ConnectionField | UpgradeField | LengthField | EncodingField | OtherField

fn request_field(name: Bytes) -> RequestField {
    match list.len(name) {
        4 => if http1.equal_ascii(name, string.as_bytes("host")) {
            HostField
        } else {
            OtherField
        },
        6 => if http1.equal_ascii(name, string.as_bytes("expect")) {
            ExpectField
        } else {
            OtherField
        },
        7 => if http1.equal_ascii(name, string.as_bytes("upgrade")) {
            UpgradeField
        } else {
            OtherField
        },
        10 => if http1.equal_ascii(name, string.as_bytes("connection")) {
            ConnectionField
        } else {
            OtherField
        },
        14 => if http1.equal_ascii(name, string.as_bytes("content-length")) {
            LengthField
        } else {
            OtherField
        },
        17 => if http1.equal_ascii(name, string.as_bytes("transfer-encoding")) {
            EncodingField
        } else {
            OtherField
        },
        _ => OtherField
    }
}

type FramingFields {
    lengths: u64,
    encoding_fields: u64,
    length: http1.Span
}

fn framing_fields() -> FramingFields {
    let empty = http1.Span(start: 0, end: 0)
    FramingFields(lengths: 0, encoding_fields: 0, length: empty)
}

fn count_framing(mut fields: FramingFields, kind: RequestField, value: http1.Span, index: u64) {
    match kind {
        LengthField => {
            fields.lengths += 1
            fields.length = value
        },
        EncodingField => {
            fields.encoding_fields |= int.wrapping_shl(1u64, int.narrow(index))
        },
        _ => {}
    }
}

fn connection_upgrade(b: Bytes, h: View[http1.Head], connections: u64) -> bool {
    let mut remaining_fields = connections
    while remaining_fields != 0 {
        let i: u64 = int.widen(int.trailing_zeros(remaining_fields))
        if http1.contains(part(b, h.fields[i].value), string.as_bytes("upgrade")) {
            return true
        }
        remaining_fields &= remaining_fields - 1
    }
    false
}

fn request_policy(b: Bytes, h: View[http1.Head]) -> Result[(RequestHead, FramingFields), u16] {
    let verb = part(b, h.method)
    let mut host: Option[http1.Span] = None
    let mut expect = false
    let mut close = false
    let mut keep_alive = false
    let mut upgrade_field = false
    let mut connections: u64 = 0
    let mut wire_fields = framing_fields()
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        let kind = request_field(part(b, f.name))
        match kind {
            HostField => {
                if host != None || !valid_authority(part(b, f.value)) {
                    return Error(400)
                }
                host = Some(f.value)
            },
            ExpectField => {
                if expect || h.version == 0 || !http1.equal_ascii(part(b, f.value), string.as_bytes("100-continue")) {
                    return Error(417)
                }
                expect = true
            },
            ConnectionField => {
                connections |= int.wrapping_shl(1u64, int.narrow(i))
                let value = part(b, f.value)
                close = close || http1.contains(value, string.as_bytes("close"))
                if h.version == 0 && !close {
                    keep_alive = keep_alive || http1.contains(value, string.as_bytes("keep-alive"))
                }
            },
            UpgradeField => {
                upgrade_field = true
            },
            _ => count_framing(mut wire_fields, kind, f.value, i)
        }
    }
    if h.version == 1 && host == None {
        return Error(400)
    }
    if verb == string.as_bytes("CONNECT") {
        return Error(501)
    }
    let mut start = h.target.start
    let end = h.target.end
    if part(b, h.target) == string.as_bytes("*") {
        if verb != string.as_bytes("OPTIONS") {
            return Error(400)
        }
    } else if b[start] != b'/' {
        let Some(colon) = list.find_byte3(b, start, end, b':', b'/', b'?') else {
            return Error(501)
        }
        if end - colon < 3 || b[colon + 1] != b'/' || b[colon + 2] != b'/' {
            return Error(501)
        }
        if !int.is_ascii_alpha(b[start]) {
            return Error(400)
        }
        for i in start + 1 .. colon {
            let x = b[i]
            if !(int.is_ascii_alpha(x) || int.is_ascii_digit(x) || x == b'+' || x == b'-' || x == b'.') {
                return Error(400)
            }
        }
        let host_start = colon + 3
        start = match list.find_byte2(b, host_start, end, b'/', b'?') {
            Some(at) => at,
            None => end,
        }
        let absolute = http1.Span(start: host_start, end: start)
        if host == None || !valid_authority(part(b, absolute)) {
            return Error(400)
        }
        host = Some(absolute)
    }
    let path_end = match list.find_byte2(b, start, end, b'?', b'#') {
        Some(at) => {
            if b[at] == b'#' {
                return Error(400)
            }
            at
        },
        None => end,
    }
    let query_at = if path_end == end {
        end
    } else {
        path_end + 1
    }
    let head = RequestHead(authority: host, path: http1.Span(start, end: path_end), query: http1.Span(start: query_at, end), expect_continue: expect, upgrade_requested: h.version == 1 && upgrade_field && connection_upgrade(b, h, connections), close: close || h.version == 0 && !keep_alive)
    Ok((head, wire_fields))
}

type TargetError: key = BadTarget | TargetCapacity

fn segment(b: Bytes) -> Result[String, TargetError] {
    let end = list.len(b)
    // A refused target answers 503, so this admission is recovered inline.
    let mut decoded: Bytes = list.new()
    if let Error(_) = list.try_reserve(mut decoded, end) {
        return Error(TargetCapacity)
    }
    let mut at: u64 = 0
    while at < end {
        let (byte, next) = match uri.decode_next(b, at, end) {
            Ok(value) => value,
            Error(_) => return Error(BadTarget),
        }
        list.push(mut decoded, byte)
        at = next
    }
    if decoded == string.as_bytes(".") || decoded == string.as_bytes("..") {
        return Error(BadTarget)
    }
    match string.from_utf8(take decoded) {
        Ok(take s) => Ok(take s),
        Error(_) => Error(BadTarget),
    }
}

// Split before decoding; a decoded slash is data in a single segment.
// Root and an empty absolute-form path both have zero segments.
fn segments_of(raw_path: Bytes) -> Result[List[String], TargetError] {
    let mut decoded_segments: List[String] = list.new()
    let n = list.len(raw_path)
    if n <= 1 {
        return Ok(take decoded_segments)
    }
    let mut start: u64 = 1
    while start <= n {
        let end = match list.find_byte(raw_path, start, n, b'/') {
            Some(at) => at,
            None => n,
        }
        if end == start && end < n {
            return Error(BadTarget)
        }
        let s = segment(list.slice(raw_path, start, end))?
        if let Error(_) = list.try_reserve(mut decoded_segments, 1) {
            return Error(TargetCapacity)
        }
        list.push(mut decoded_segments, take s)
        if end == n {
            return Ok(take decoded_segments)
        }
        start = end + 1
    }
    Ok(take decoded_segments)
}

pub type Config: shareable + send {
    ingress: List[wsock.Prefix],
    sockets_max: u64,
    http_max: u64,
    upgrades_max: u64,
    conns_max: u64,
    ip_sockets_max: u64,
    refuse_max: u64,
    refuse_ms: u64,
    inbox_cap: u64,
    head_max: u64,
    fields_max: u64,
    pipeline_max: u64,
    body_inline: u64,
    body_max: u64,
    out_cap: u64,
    handler_bytes: u64,
    first_head_ms: u64,
    idle_ms: u64,
    head_ms: u64,
    body_ms: u64,
    handler_ms: u64,
    write_ms: u64,
    drain_ms: u64,
    linger_ms: u64,
    drain_max: u64,
    streams_max: u64,
    state_max: u64,
    reads_max: u64,
    heartbeat_ms: u64,
    lease_ms: u64
}

pub opaque scoped type Request {
    input: View[Bytes],
    head: View[http1.Head],
    meta: RequestHead,
    segments: List[String],
    route: View[router.Pattern],
    inline_body: Option[View[Bytes]],
    deadline: u64,
    stop: Option[DrainSignal],
    state_max: u64,
    out_cap: u64
}

pub fn method(r: Request) -> View[Bytes] in r {
    part(r.input, r.head.method)
}

pub fn target(r: Request) -> View[Bytes] in r {
    part(r.input, r.head.target)
}

pub fn path(r: Request) -> View[Bytes] in r {
    part(r.input, r.meta.path)
}

pub fn segments(r: Request) -> View[List[String]] in r {
    view r.segments
}

pub fn capture(r: Request, name: String) -> Option[View[String]] in r {
    match router.capture_index(r.route, name) {
        Some(i) => list.get(r.segments, i),
        None => None,
    }
}

pub fn capture_tail(r: Request, name: String) -> Option[View[List[String]]] in r {
    match router.tail_index(r.route, name) {
        Some(i) => Some(list.slice(r.segments, i, list.len(r.segments))),
        None => None,
    }
}

pub fn query(r: Request) -> View[Bytes] in r {
    part(r.input, r.meta.query)
}

pub fn field(r: Request, name: Bytes) -> Option[View[Bytes]] in r {
    field_at(r, name, 0)
}

pub fn field_at(r: Request, name: Bytes, index: u64) -> Option[View[Bytes]] in r {
    if http1.equal_ascii(name, string.as_bytes("host")) {
        if index != 0 {
            return None
        }
        return match r.meta.authority {
            Some(s) => Some(part(r.input, s)),
            None => None,
        }
    }
    let mut remaining = index
    for i in 0u64 .. r.head.count {
        let f = r.head.fields[i]
        if http1.equal_ascii(part(r.input, f.name), name) {
            if remaining == 0 {
                return Some(part(r.input, f.value))
            }
            remaining -= 1
        }
    }
    None
}

pub fn handler_deadline(r: Request) -> u64 {
    clamp_deadline(r.stop, r.deadline)
}

pub fn inline_body(r: Request) -> Option[View[Bytes]] in r {
    r.inline_body
}

fn upgrade_protocol(protocol: Bytes) -> bool {
    let n = list.len(protocol)
    if n == 0 {
        return false
    }
    let mut version = false
    for i in 0u64 .. n {
        let c = protocol[i]
        if c == b'/' && !version && i != 0 && i + 1 != n {
            version = true
        } else if !http1.token(c) {
            return false
        }
    }
    true
}

pub fn upgrade_offer(r: Request, protocol: String) -> Result[u64, HandlerError] {
    let offered = string.as_bytes(protocol)
    if !r.meta.upgrade_requested || !upgrade_protocol(offered) {
        return Error(InvalidUpgrade)
    }
    for i in 0u64 .. r.head.count {
        let f = r.head.fields[i]
        if http1.equal_ascii(part(r.input, f.name), string.as_bytes("upgrade")) && http1.contains(part(r.input, f.value), offered) {
            return Ok(r.state_max)
        }
    }
    Error(InvalidUpgrade)
}

pub fn handover_limits(r: Request) -> (u64, u64) {
    (r.out_cap, r.state_max)
}

/// Copies a borrowed field or body into the current handler's allowance.
pub fn copy_bytes(b: Bytes) -> Bytes {
    let mut copied: Bytes = list.with_capacity(list.len(b))
    let _ = list.append(mut copied, b)
    take copied
}

type HeadResult: key = Ready | PeerClosed | Rejected(u16)

pub opaque type DrainSignal: send {
    deadline: Latest[Option[u64]]
}

fn share_signal(signal: Option[DrainSignal]) -> Option[DrainSignal] {
    if let Some(s) = signal {
        Some(DrainSignal(deadline: latest.handle(s.deadline)))
    } else {
        None
    }
}

fn copied_deadline(d: Option[u64]) -> Option[u64] {
    d
}

pub fn stop_deadline(signal: Option[DrainSignal]) -> Option[u64] {
    if let Some(s) = signal {
        copied_deadline(latest.read(s.deadline))
    } else {
        None
    }
}

pub fn clamp_deadline(signal: Option[DrainSignal], own: u64) -> u64 {
    if let Some(d) = stop_deadline(signal) {
        order.min(own, d)
    } else {
        own
    }
}

fn receive_head(mut r: ReadHalf, mut b: Bytes, c: Clock, deadline: u64, cfg: Config) -> Result[u64, NetError] waits {
    let allowance = order.min(8192, cfg.pipeline_max + 1)
    host.recv_bounded(mut r, mut b, allowance, At(c, deadline))
}

fn read_head(mut r: ReadHalf, mut b: Bytes, mut h: http1.Head, c: Clock, first: bool, start: u64, cfg: Config, inbox: Sender[ConnectionSignal], slot: u64, signal: Option[DrainSignal]) -> HeadResult waits {
    let mut deadline = clock.deadline_after_ms(start, cfg.first_head_ms)
    if !first {
        if list.len(b) == 0 {
            let idle = clock.deadline_after_ms(start, cfg.idle_ms)
            if host.mono_ns(c) >= idle {
                return Rejected(408)
            }
            match receive_head(mut r, mut b, c, idle, cfg) {
                Ok(0) => return PeerClosed,
                Ok(_) => {},
                Error(TimedOut) => return Rejected(408),
                Error(_) => return PeerClosed,
            }
        }
        deadline = clock.deadline_after_ms(host.mono_ns(c), cfg.head_ms)
    }
    let mut active = false
    let mut cur = http1.cursor()
    loop {
        if !active && list.len(b) != 0 {
            if let Some(_) = signal {
                if !commit_phase(inbox, slot, true) {
                    return PeerClosed
                }
            }
            active = true
        }
        let until = clamp_deadline(signal, deadline)
        if host.mono_ns(c) >= until {
            return Rejected(408)
        }
        let view_end = order.min(cfg.head_max, list.len(b))
        let outcome = http1.resume(list.slice(b, 0, view_end), mut h, mut cur)
        if h.count > cfg.fields_max {
            return Rejected(431)
        }
        match outcome {
            Complete => return Ready,
            Bad => return Rejected(400),
            _ => {},
        }
        if outcome == TooLarge || view_end == cfg.head_max {
            return Rejected(if cur.line_end == 0 && cur.offset - cur.line_start == cfg.head_max {
                414
            } else {
                431
            })
        }
        match receive_head(mut r, mut b, c, until, cfg) {
            Ok(0) => return if list.len(b) == 0 {
                PeerClosed
            } else {
                Rejected(400)
            },
            Ok(_) => {},
            Error(TimedOut) => return Rejected(408),
            Error(_) => return PeerClosed,
        }
    }
}

// A single deadline and committed byte count cover both carriers.
pub fn write_wire(mut w: WriteHalf, prefix: Bytes, body: Bytes, c: Clock, deadline: u64) -> Result[(), NetError] waits {
    write_wire_until(mut w, prefix, body, c, deadline, None)
}

pub fn write_wire_until(mut w: WriteHalf, prefix: Bytes, body: Bytes, c: Clock, deadline: u64, signal: Option[DrainSignal]) -> Result[(), NetError] waits {
    let boundary = list.len(prefix)
    let end = boundary + list.len(body)
    let mut committed: u64 = 0
    while committed < end {
        let until = clamp_deadline(signal, deadline)
        if host.mono_ns(c) >= until {
            return Error(TimedOut)
        }
        let sent = if committed < boundary {
            host.send_pair(mut w, list.slice(prefix, committed, boundary), body, At(c, until))
        } else {
            host.send_pair(mut w, list.slice(body, committed - boundary, list.len(body)), string.as_bytes(""), At(c, until))
        }
        match sent {
            Ok(0) => return Error(Reset),
            Ok(n) => {
                committed += n
            },
            Error(e) => return Error(e),
        }
    }
    Ok(())
}

fn refusal_head(status: u16) -> String {
    match status {
        400 => "HTTP/1.1 400 Bad Request\r\n",
        408 => "HTTP/1.1 408 Request Timeout\r\n",
        413 => "HTTP/1.1 413 Content Too Large\r\n",
        414 => "HTTP/1.1 414 URI Too Long\r\n",
        417 => "HTTP/1.1 417 Expectation Failed\r\n",
        431 => "HTTP/1.1 431 Request Header Fields Too Large\r\n",
        501 => "HTTP/1.1 501 Not Implemented\r\n",
        503 => "HTTP/1.1 503 Service Unavailable\r\nRetry-After: 1\r\n",
        _ => "HTTP/1.1 500 Internal Server Error\r\n",
    }
}

fn reply_error(mut w: WriteHalf, status: u16, c: Clock, deadline: u64) -> Result[(), NetError] waits {
    reply_error_until(mut w, status, c, deadline, None)
}

fn reply_error_until(mut w: WriteHalf, status: u16, c: Clock, deadline: u64, signal: Option[DrainSignal]) -> Result[(), NetError] waits {
    write_wire_until(mut w, string.as_bytes(refusal_head(status)), string.as_bytes("Connection: close\r\nContent-Length: 0\r\n\r\n"), c, deadline, signal)
}

pub fn write_promotion_unit(mut w: WriteHalf, head: Bytes, c: Clock, at: u64, ms: u64, signal: Option[DrainSignal]) -> Result[(), NetError] waits {
    write_wire_until(mut w, head, string.as_bytes(""), c, clock.deadline_after_ms(at, ms), signal)
}

pub fn write_promotion_refusal(mut w: WriteHalf, c: Clock, at: u64, ms: u64, signal: Option[DrainSignal]) -> Result[(), NetError] waits {
    reply_error_until(mut w, 503, c, clock.deadline_after_ms(at, ms), signal)
}

pub opaque scoped type Body {
    input: View[Bytes],
    input_at: u64,
    reader: ReadHalf,
    writer: WriteHalf,
    scratch: Bytes,
    scratch_at: u64,
    decoder: Decoder,
    head_max: u64,
    fields_max: u64,
    clock: Clock,
    stop: Option[DrainSignal],
    body_deadline: u64,
    handler_deadline: u64,
    write_ms: u64,
    pipeline_max: u64,
    expect_continue: bool,
    fault: Option[BodyError],
    output_failed: bool
}

pub type Responder = Body

fn body_fault(mut b: Body, status: u16) -> BodyError {
    let error = failure(status)
    b.fault = Some(error)
    error
}

type BodyPiece = Buffered(http1.Span) | Received(http1.Span) | NeedBytes | BodyDone | BodyFailed(BodyError)

fn body_piece(mut b: Body, max: u64) -> BodyPiece {
    if let Some(e) = b.fault {
        return BodyFailed(e)
    }
    let in_input = b.input_at < list.len(b.input)
    let start = if in_input {
        b.input_at
    } else {
        b.scratch_at
    }
    let result = if in_input {
        let limit = start + order.min(max, list.len(b.input) - start)
        decode(mut b.decoder, list.slice(b.input, start, limit))
    } else {
        let limit = start + order.min(max, list.len(b.scratch) - start)
        decode(mut b.decoder, list.slice(b.scratch, start, limit))
    }
    if in_input {
        b.input_at += b.decoder.used
    } else {
        b.scratch_at += b.decoder.used
    }
    if b.decoder.trailer_bytes > b.head_max || b.decoder.trailer_fields > b.fields_max {
        return BodyFailed(body_fault(mut b, 431))
    }
    match result {
        Data(s) => {
            let span = http1.Span(start: start + s.start, end: start + s.end)
            if in_input {
                Buffered(span)
            } else {
                Received(span)
            }
        },
        Done => BodyDone,
        Failed(e) => {
            b.fault = Some(e)
            BodyFailed(e)
        },
        More => NeedBytes,
    }
}

fn refill_body(mut b: Body, max: u64, deadline: u64, timeout_status: u16) -> Result[(), BodyError] waits {
    let until = clamp_deadline(b.stop, deadline)
    if host.mono_ns(b.clock) >= until {
        return Error(body_fault(mut b, timeout_status))
    }
    list.clear(mut b.scratch)
    b.scratch_at = 0
    match host.recv_bounded(mut b.reader, mut b.scratch, max, At(b.clock, until)) {
        Ok(0) => match body_eof(mut b.decoder) {
            Ok(()) => Ok(()),
            Error(e) => {
                b.fault = Some(e)
                Error(e)
            },
        },
        Ok(_) => Ok(()),
        Error(TimedOut) => Error(body_fault(mut b, timeout_status)),
        Error(_) => Error(body_fault(mut b, 400)),
    }
}

/// Appends decoded bytes within the caller-provided spare capacity. Returns
/// zero at body EOF. Use a nonempty spare buffer for a read.
pub fn read(mut b: Body, mut into: Bytes) -> Result[u64, BodyError] waits {
    if let Some(e) = b.fault {
        return Error(e)
    }
    let room = list.capacity(into) - list.len(into)
    if room == 0 {
        return Error(BodyError(status: 503, close: false))
    }
    let handler = clamp_deadline(b.stop, b.handler_deadline)
    let until = order.min(b.body_deadline, handler)
    let timeout_status: u16 = if handler < b.body_deadline {
        503
    } else {
        408
    }
    if host.mono_ns(b.clock) >= until {
        return Error(body_fault(mut b, timeout_status))
    }
    if b.expect_continue {
        let write_end = order.min(until, clock.deadline_after_ms(host.mono_ns(b.clock), b.write_ms))
        let result = write_wire_until(mut b.writer, string.as_bytes("HTTP/1.1 100 Continue\r\n\r\n"), string.as_bytes(""), b.clock, write_end, b.stop)
        b.expect_continue = false
        if let Error(_) = result {
            b.output_failed = true
            return Error(body_fault(mut b, 408))
        }
    }
    loop {
        match body_piece(mut b, room) {
            Buffered(s) => {
                let _ = list.append(mut into, part(b.input, s))
                return Ok(s.end - s.start)
            },
            Received(s) => {
                let _ = list.append(mut into, part(b.scratch, s))
                return Ok(s.end - s.start)
            },
            BodyDone => return Ok(0),
            BodyFailed(e) => return Error(e),
            NeedBytes => {
                if b.input_at == list.len(b.input) && b.scratch_at == list.len(b.scratch) {
                    let max = order.min(8192, b.pipeline_max + 1)
                    refill_body(mut b, max, until, timeout_status)?
                }
            },
        }
    }
}

fn drain(mut b: Body, remaining: u64, deadline: u64) -> bool waits {
    if b.fault != None {
        return false
    }
    if b.decoder.state == Finished {
        return true
    }
    if b.expect_continue || b.decoder.state == Fixed && b.decoder.remaining > remaining || host.mono_ns(b.clock) >= deadline {
        return false
    }
    let mut budget = remaining
    let mut reads = remaining / 8192 + if remaining % 8192 == 0 {
        1
    } else {
        2
    }
    loop {
        let input_at = b.input_at
        let scratch_at = b.scratch_at
        let result = body_piece(mut b, budget)
        budget -= (b.input_at - input_at) + (b.scratch_at - scratch_at)
        match result {
            BodyDone => return true,
            BodyFailed(_) => return false,
            NeedBytes => {
                if budget == 0 || reads == 0 {
                    return false
                }
                if b.input_at == list.len(b.input) && b.scratch_at == list.len(b.scratch) {
                    let max = order.min(budget, order.min(8192, b.pipeline_max + 1))
                    if let Error(_) = refill_body(mut b, max, deadline, 408) {
                        return false
                    }
                    reads -= 1
                }
            },
            _ => {},
        }
    }
}

pub type Outcome: send = Reply(Response) | Upgrade(upgrade.Spec) | Stream(stream.Spec)

type UpgradeOffer: send {
    head: Bytes,
    argument: Bytes,
    bytes_reserved: u64,
    run: fn(take upgrade.Taken) waits,
    pre_head: u64
}

type Handover: send = ToUpgrade(UpgradeOffer) | ToStream(stream.Offer)

type Step = Keep(u64, u64) | RepliedAndClose | CloseConnection | MoveSocket(Handover)

fn discard(take bytes_to_drop: Bytes) {}

fn write_succeeded(r: Result[(), NetError]) -> bool {
    match r {
        Ok(()) => true,
        Error(_) => false
    }
}

type OutputResult = FinalReply(bool) | ClosingReply(bool)

fn error_step(mut w: WriteHalf, status: u16, clock: Clock, end: u64, signal: Option[DrainSignal]) -> Step waits {
    if write_succeeded(reply_error_until(mut w, status, clock, end, signal)) {
        RepliedAndClose
    } else {
        CloseConnection
    }
}

fn send_response(mut b: Body, mut out: Bytes, r: Response, version: u8, suppress: bool, close: bool, cfg: Config, mut cache: DateCache) -> OutputResult waits {
    if let Error(_) = response_head(mut out, r, version, close, host.wall_ms(b.clock), mut cache) {
        return ClosingReply(write_succeeded(reply_error_until(mut b.writer, 500, b.clock, clock.deadline_after_ms(host.mono_ns(b.clock), cfg.write_ms), b.stop)))
    }
    let write_end = clock.deadline_after_ms(host.mono_ns(b.clock), cfg.write_ms)
    if suppress || !has_body(r.status) {
        return FinalReply(write_succeeded(write_wire_until(mut b.writer, out, string.as_bytes(""), b.clock, write_end, b.stop)))
    }
    let payload = response_body(r)
    FinalReply(write_succeeded(write_wire_until(mut b.writer, out, payload, b.clock, write_end, b.stop)))
}

fn route_response[S: shareable + send](routes: router.Router[S], decoded: List[String], options_star: bool) -> Result[Response, HandlerError] {
    let methods = router.allow(routes, decoded, options_star)
    let status: u16 = if options_star {
        204
    } else if string.byte_len(methods) == 0 {
        404
    } else {
        405
    }
    let mut reply = response(status, list.new(), false)?
    if status != 404 {
        let name = b"Allow"
        let allow = copy_bytes(string.as_bytes(methods))
        header(mut reply, take name, take allow)?
    }
    Ok(take reply)
}

fn encode_upgrade(mut out: Bytes, req: Request, take spec: upgrade.Spec, max_bytes: Option[u64], c: Clock, mut cache: DateCache) -> Result[UpgradeOffer, HandlerError] {
    let limit = upgrade_offer(req, spec.protocol)?
    let Some(authorized) = max_bytes else {
        return Error(InvalidUpgrade)
    }
    if list.capacity(spec.argument) > limit || spec.reservation > authorized {
        return Error(InvalidUpgrade)
    }
    list.clear(mut out)
    head_text(mut out, "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: ")?
    head_text(mut out, spec.protocol)?
    head_text(mut out, "\r\n")?
    for (name, value) in spec.fields {
        if reserved_field(name) || http1.equal_ascii(name, string.as_bytes("upgrade")) {
            return Error(HeaderReserved)
        }
        if !valid_field(name, value) {
            return Error(HeaderInvalid)
        }
        append_head(mut out, name)?
        head_text(mut out, ": ")?
        append_head(mut out, value)?
        head_text(mut out, "\r\n")?
    }
    append_date(mut out, host.wall_ms(c), mut cache)?
    head_text(mut out, "\r\n")?
    let head = copy_bytes(out)
    let upgrade.Spec(protocol: _, fields: _, argument: take argument, reservation: reserve, run) = take spec
    Ok(UpgradeOffer(head: take head, argument: take argument, bytes_reserved: reserve, run, pre_head: req.deadline))
}

fn event_stream(value: Bytes) -> bool {
    let media = string.as_bytes("text/event-stream")
    let n = list.len(media)
    if list.len(value) < n || !http1.equal_ascii(list.slice(value, 0, n), media) {
        return false
    }
    let mut at = n
    while at < list.len(value) && (value[at] == b' ' || value[at] == b'\t') {
        at += 1
    }
    at == list.len(value) || value[at] == b';'
}

fn encode_stream(mut out: Bytes, take spec: stream.Spec, c: Clock, version: u8, suppress: bool, at: u64, pre_head: u64, mut cache: DateCache) -> Result[stream.Offer, HandlerError] {
    list.clear(mut out)
    let chunked = version == 1
    status_line(mut out, if chunked {
        1
    } else {
        0
    }, stream.status(spec))?
    let mut heartbeat = false
    for (name, value) in stream.fields(spec) {
        if http1.equal_ascii(name, string.as_bytes("content-type")) && event_stream(value) {
            heartbeat = true
        }
        append_head(mut out, name)?
        head_text(mut out, ": ")?
        append_head(mut out, value)?
        head_text(mut out, "\r\n")?
    }
    if chunked {
        head_text(mut out, "Transfer-Encoding: chunked\r\n")?
    }
    head_text(mut out, "Connection: close\r\n")?
    append_date(mut out, host.wall_ms(c), mut cache)?
    head_text(mut out, "\r\n")?
    Ok(stream.prepare(take spec, out, chunked, heartbeat, suppress, at, pre_head))
}

fn handle[S: shareable + send](input: Bytes, h: View[http1.Head], meta: RequestHead, frame: Framing, take request_body: Body in input, mut out: Bytes, cfg: Config, routes: router.Router[S], state: S, mut cache: DateCache) -> (Step, Option[Body]) in input waits {
    let mut b = take request_body
    let step = 'exchange: {
        let outcome = bound bytes cfg.handler_bytes {
            let normalized = match segments_of(part(input, meta.path)) {
                Ok(take x) => take x,
                Error(BadTarget) => {
                    break 'exchange error_step(mut b.writer, 400, b.clock, clock.deadline_after_ms(host.mono_ns(b.clock), cfg.write_ms), b.stop)
                },
                Error(TargetCapacity) => {
                    break 'exchange error_step(mut b.writer, 503, b.clock, clock.deadline_after_ms(host.mono_ns(b.clock), cfg.write_ms), b.stop)
                },
            }
            let verb = part(input, h.method)
            let options_star = part(input, meta.path) == string.as_bytes("*")
            let selected: Option[View[router.Entry[S]]] = if options_star {
                None
            } else {
                router.select(routes, verb, normalized)
            }
            let result = if let Some(entry) = selected {
                let body_max = match entry.route.body_max {
                    Some(n) => order.min(n, cfg.body_max),
                    None => cfg.body_max,
                }
                if let ContentLength(n) = frame {
                    if n > body_max {
                        break 'exchange error_step(mut b.writer, 413, b.clock, clock.deadline_after_ms(host.mono_ns(b.clock), cfg.write_ms), b.stop)
                    }
                }
                b.decoder.body_max = body_max
                let inline = match frame {
                    ContentLength(n) => if n <= cfg.body_inline && n <= list.len(input) - h.end && !meta.expect_continue {
                        Some(list.slice(input, h.end, h.end + n))
                    } else {
                        None
                    },
                    _ => None,
                }
                if let Some(v) = inline {
                    b.input_at += list.len(v)
                    b.decoder.state = Finished
                    b.decoder.remaining = 0
                }
                let req = Request(input: view input, head: h, meta, segments: take normalized, route: view entry.pattern, inline_body: inline, deadline: b.handler_deadline, stop: share_signal(b.stop), state_max: cfg.state_max, out_cap: cfg.out_cap)
                let handler = entry.route.handler
                let handled = if let Some(limit) = entry.route.steps {
                    let limited = bound steps limit {
                        let mut bounded = take b
                        let reply = region scratch {
                            handler(req, scratch, mut bounded, state)
                        }
                        (take bounded, take reply)
                    }
                    match take limited {
                        Ok((take resumed, take reply)) => {
                            b = take resumed
                            take reply
                        },
                        Error(_) => return (CloseConnection, None),
                    }
                } else {
                    region scratch {
                        handler(req, scratch, mut b, state)
                    }
                }
                match take handled {
                    Ok(Upgrade(take spec)) => {
                        let returned = host.mono_ns(b.clock)
                        if b.output_failed {
                            break 'exchange CloseConnection
                        }
                        if returned >= clamp_deadline(b.stop, b.handler_deadline) {
                            break 'exchange error_step(mut b.writer, 503, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop)
                        }
                        match encode_upgrade(mut out, req, take spec, entry.route.upgrade_bytes, b.clock, mut cache) {
                            Ok(take offer) => MoveSocket(ToUpgrade(take offer)),
                            Error(Allocation(_)) => error_step(mut b.writer, 503, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop),
                            Error(_) => error_step(mut b.writer, 500, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop),
                        }
                    },
                    Ok(Stream(take spec)) => {
                        let returned = host.mono_ns(b.clock)
                        if b.output_failed {
                            break 'exchange CloseConnection
                        }
                        if let Some(e) = b.fault {
                            break 'exchange error_step(mut b.writer, e.status, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop)
                        }
                        if returned >= clamp_deadline(b.stop, b.handler_deadline) {
                            break 'exchange error_step(mut b.writer, 503, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop)
                        }
                        let Some(max_bytes) = entry.route.stream_bytes else {
                            break 'exchange error_step(mut b.writer, 500, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop)
                        }
                        match encode_stream(mut out, take spec, b.clock, h.version, verb == string.as_bytes("HEAD"), returned, b.handler_deadline, mut cache) {
                            Ok(take offer) => {
                                if stream.reservation(offer, cfg.out_cap) > max_bytes {
                                    break 'exchange error_step(mut b.writer, 500, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop)
                                }
                                MoveSocket(ToStream(take offer))
                            },
                            Error(Allocation(_)) => error_step(mut b.writer, 503, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop),
                            Error(_) => error_step(mut b.writer, 500, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop),
                        }
                    },
                    Ok(Reply(take reply)) => break 'exchange handle_reply(mut b, mut out, Ok(take reply), h.version, verb == string.as_bytes("HEAD"), meta.close, cfg, mut cache),
                    Error(e) => break 'exchange handle_reply(mut b, mut out, Error(e), h.version, verb == string.as_bytes("HEAD"), meta.close, cfg, mut cache),
                }
            } else {
                break 'exchange handle_reply(mut b, mut out, route_response(routes, normalized, options_star), h.version, verb == string.as_bytes("HEAD"), meta.close, cfg, mut cache)
            }
            result
        }
        match take outcome {
            Ok(take step) => take step,
            Error(_) => error_step(mut b.writer, 503, b.clock, clock.deadline_after_ms(host.mono_ns(b.clock), cfg.write_ms), b.stop),
        }
    }
    (take step, Some(take b))
}

fn handle_reply(mut b: Body, mut out: Bytes, take result: Result[Response, HandlerError], version: u8, suppress: bool, request_close: bool, cfg: Config, mut cache: DateCache) -> Step waits {
    let returned = host.mono_ns(b.clock)
    if b.output_failed {
        return CloseConnection
    }
    if let Some(e) = b.fault {
        if e.status == 408 || e.status == 503 {
            return error_step(mut b.writer, e.status, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop)
        }
    }
    if returned >= clamp_deadline(b.stop, b.handler_deadline) {
        return error_step(mut b.writer, 503, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop)
    }
    // Stream and upgrade outcomes take the halves here, before any
    // response is committed. The caller owns ordinary close and drain.
    let reply = match take result {
        Ok(take r) => take r,
        Error(e) => {
            let status: u16 = match e {
                Allocation(_) => 503,
                _ => 500
            }
            return error_step(mut b.writer, status, b.clock, clock.deadline_after_ms(returned, cfg.write_ms), b.stop)
        },
    }
    let abandon_expect = b.expect_continue && b.decoder.state != Finished
    let close = request_close || stop_deadline(b.stop) != None || reply.close || b.fault != None || abandon_expect
    match send_response(mut b, mut out, reply, version, suppress, close, cfg, mut cache) {
        FinalReply(true) => if close {
            RepliedAndClose
        } else {
            Keep(host.mono_ns(b.clock), order.min(b.body_deadline, clock.deadline_after_ms(returned, cfg.drain_ms)))
        },
        ClosingReply(true) => RepliedAndClose,
        _ => CloseConnection,
    }
}

type ConnectionSignal: send = FirstResponse(u64) | Source(u64, Ip, Sender[bool]) | EndNotice | Refused(u64) | Accepted(Socket, Ip, u64) | ListenerFailed(NetError) | PromoteUpgrade(UpgradeRequest) | PromoteStream(StreamRequest) | Established(u64, u64) | Phase(u64, bool, Sender[bool]) | StreamReady(u64, u64, stream.StopHandle) | Stop(Arc[Option[u64]]) | StopExpired

type ChildSlot: send = HttpChild(u64) | PromotedChild(u64)

pub opaque type EstablishedNotice: send {
    inbox: Sender[ConnectionSignal],
    slot: u64,
    generation: u64,
    marked: bool,
    stop: Option[DrainSignal]
}

pub fn protocol_stop(notice: EstablishedNotice) -> Option[u64] {
    stop_deadline(notice.stop)
}

pub fn protocol_signal(notice: EstablishedNotice) -> Option[DrainSignal] {
    share_signal(notice.stop)
}

pub fn control_until(notice: EstablishedNotice, c: Clock, until: Until) -> Result[Until, NetError] {
    if let Some(d) = protocol_stop(notice) {
        if host.mono_ns(c) >= d {
            return Error(TimedOut)
        }
        Ok(match until {
            At(clock, at) => At(clock, order.min(at, d)),
            Never => At(c, d),
        })
    } else {
        Ok(until)
    }
}

pub opaque type StreamControl: send {
    inbox: Sender[ConnectionSignal],
    slot: u64,
    generation: u64,
    stop: Option[DrainSignal]
}

pub fn stream_signal(control: Option[StreamControl]) -> Option[DrainSignal] {
    if let Some(s) = control {
        share_signal(s.stop)
    } else {
        None
    }
}

pub fn register_stream(control: StreamControl, take stop: stream.StopHandle) -> bool waits {
    match channel.send(control.inbox, StreamReady(control.slot, control.generation, take stop)) {
        Ok(()) => true,
        Error(_) => false,
    }
}

pub fn upgrade_established(mut notice: EstablishedNotice) -> bool waits {
    if !notice.marked {
        if let Error(_) = channel.send(notice.inbox, Established(notice.slot, notice.generation)) {
            return false
        }
        notice.marked = true
    }
    true
}

type UpgradeRequest: send {
    source_slot: u64,
    transfer: upgrade.Transfer,
    reserve: u64,
    run: fn(take upgrade.Taken) waits,
    reply: Sender[Option[upgrade.Transfer]]
}

type UpgradeJob: send {
    transfer: upgrade.Transfer,
    run: fn(take upgrade.Taken) waits,
    notice: EstablishedNotice,
    completion: Completion
}

type StreamRequest: send {
    source_slot: u64,
    transfer: stream.Transfer,
    reply: Sender[Option[stream.Transfer]]
}

type StreamJob: send {
    work: stream.Work,
    completion: Completion
}

resource type Completion: send {
    done: Sender[ChildSlot],
    wake: Sender[ConnectionSignal],
    slot: ChildSlot,
    armed: bool
} drop(completion) {
    if completion.armed {
        let _ = channel.try_send(completion.done, completion.slot)
        // If the inbox is full, its queued event will wake the supervisor.
        let _ = channel.try_send(completion.wake, EndNotice)
    }
}

fn upgraded(take job: UpgradeJob) waits {
    let UpgradeJob(transfer: take transfer, run, notice: take notice, completion: take done) = take job
    let mut completion = take done
    completion.armed = true
    run(upgrade.hand_over(take transfer, take notice))
}

fn streaming(take job: StreamJob) waits {
    let StreamJob(work: take work, completion: take done) = take job
    let mut completion = take done
    completion.armed = true
    stream.drive(take work)
}

fn decline_handover(take reader: ReadHalf, take write_half: WriteHalf, c: Clock, ms: u64, linger: u64, signal: Option[DrainSignal]) waits {
    let mut writer = take write_half
    let _ = write_promotion_refusal(mut writer, c, host.mono_ns(c), ms, signal)
    let _ = net.finish(take writer, take reader, c, clamp_deadline(signal, clock.deadline_after_ms(host.mono_ns(c), linger)))
}

fn decline_upgrade(take transfer: upgrade.Transfer, cfg: Config, signal: Option[DrainSignal]) waits {
    let upgrade.Transfer(reader: take reader, writer: take writer, input: _, tail_at: _, head: _, argument: _, clock, pre_head: _, write_ms: ms) = take transfer
    decline_handover(take reader, take writer, clock, ms, cfg.linger_ms, signal)
}

fn decline_stream(take transfer: stream.Transfer, signal: Option[DrainSignal]) waits {
    let stream.Transfer(reader: take reader, writer: take writer, offer: _, buffered: _, clock, out_cap: _, pipeline_max: _, write_ms: ms, linger_ms: linger, heartbeat_ms: _, lease_ms: _) = take transfer
    decline_handover(take reader, take writer, clock, ms, linger, signal)
}

fn send_upgrade_promotion(inbox: Sender[ConnectionSignal], slot: u64, take transfer: upgrade.Transfer, reserve: u64, run: fn(take upgrade.Taken) waits, cfg: Config, signal: Option[DrainSignal]) waits {
    let (tx, rx): (Sender[Option[upgrade.Transfer]], Receiver[Option[upgrade.Transfer]]) = channel.new(1)
    let request = UpgradeRequest(source_slot: slot, transfer: take transfer, reserve, run, reply: take tx)
    if let Ok(()) = channel.send(inbox, PromoteUpgrade(take request)) {
        if let Ok(Some(take denied)) = channel.receive(rx) {
            decline_upgrade(take denied, cfg, signal)
        }
    }
}

fn send_stream_promotion(inbox: Sender[ConnectionSignal], slot: u64, take transfer: stream.Transfer, signal: Option[DrainSignal]) waits {
    let (tx, rx): (Sender[Option[stream.Transfer]], Receiver[Option[stream.Transfer]]) = channel.new(1)
    let request = StreamRequest(source_slot: slot, transfer: take transfer, reply: take tx)
    if let Ok(()) = channel.send(inbox, PromoteStream(take request)) {
        if let Ok(Some(take denied)) = channel.receive(rx) {
            decline_stream(take denied, signal)
        }
    }
}

type ConnectionJob[S: shareable + send]: send {
    socket: Socket,
    c: Clock,
    cfg: Arc[Config],
    peer: Ip,
    at: u64,
    routes: Arc[router.Router[S]],
    state: Arc[S],
    inbox: Sender[ConnectionSignal],
    slot: u64,
    stop: Option[DrainSignal],
    completion: Completion
}

fn commit_phase(inbox: Sender[ConnectionSignal], slot: u64, active: bool) -> bool waits {
    let (tx, rx): (Sender[bool], Receiver[bool]) = channel.new(1)
    if let Error(_) = channel.send(inbox, Phase(slot, active, take tx)) {
        return false
    }
    match channel.receive(rx) {
        Ok(allowed) => allowed,
        Error(_) => false,
    }
}

fn change_source(inbox: Sender[ConnectionSignal], slot: u64, ip: Ip) -> bool waits {
    let (tx, rx): (Sender[bool], Receiver[bool]) = channel.new(1)
    if let Error(_) = channel.send(inbox, Source(slot, ip, take tx)) {
        return false
    }
    match channel.receive(rx) {
        Ok(allowed) => allowed,
        Error(_) => false,
    }
}

fn connection[S: shareable + send](take job: ConnectionJob[S]) waits {
    let ConnectionJob(socket: take socket, c, cfg: take cfg, peer, at: accepted, routes: take routes, state: take state, inbox: take inbox, slot, stop: take signal, completion: take notice) = take job
    let mut completion = take notice
    completion.armed = true
    let _ = run_connection(take socket, c, cfg, peer, accepted, routes, state, inbox, slot, signal)
}

fn run_connection[S: shareable + send](take socket: Socket, c: Clock, cfg: Config, peer: Ip, accepted: u64, routes: router.Router[S], state: S, inbox: Sender[ConnectionSignal], slot: u64, signal: Option[DrainSignal]) -> u64 waits {
    let (r, w) = net.split(take socket)
    let mut reader = take r
    let mut writer = take w
    let mut input: Bytes = list.with_capacity(cfg.head_max + cfg.pipeline_max + cfg.body_inline)
    let mut out: Bytes = list.with_capacity(cfg.out_cap)
    let mut scratch: Bytes = list.new()
    let mut first = true
    let mut start = accepted
    let mut batch: u64 = 0
    let mut completed_replies: u64 = 0
    let mut date = date_cache()
    let mut head = http1.head()
    loop {
        // Only the parsed field prefix is visible to request consumers.
        // A fresh cursor supplies the other request offsets before Ready.
        head.count = 0
        match read_head(mut reader, mut input, mut head, c, first, start, cfg, inbox, slot, signal) {
            PeerClosed => break,
            Rejected(status) => {
                if write_succeeded(reply_error_until(mut writer, status, c, clock.deadline_after_ms(host.mono_ns(c), cfg.write_ms), signal)) && first {
                    let _ = channel.send(inbox, FirstResponse(slot))
                }
                break
            },
            Ready => {},
        }
        let completed = host.mono_ns(c)
        if first && list.len(cfg.ingress) != 0 {
            let source = match wsock.source_for_head(input, head, peer, cfg.ingress) {
                Ok(ip) => ip,
                Error(status) => {
                    if write_succeeded(reply_error_until(mut writer, status, c, clock.deadline_after_ms(host.mono_ns(c), cfg.write_ms), signal)) && first {
                        let _ = channel.send(inbox, FirstResponse(slot))
                    }
                    break
                },
            }
            if source_key(source) != source_key(peer) && !change_source(inbox, slot, source) {
                if write_succeeded(reply_error_until(mut writer, 503, c, clock.deadline_after_ms(host.mono_ns(c), cfg.write_ms), signal)) && first {
                    let _ = channel.send(inbox, FirstResponse(slot))
                }
                break
            }
        }
        let parsed = view head
        let (policy, fields) = match request_policy(input, parsed) {
            Ok(p) => p,
            Error(status) => {
                if write_succeeded(reply_error_until(mut writer, status, c, clock.deadline_after_ms(host.mono_ns(c), cfg.write_ms), signal)) && first {
                    let _ = channel.send(inbox, FirstResponse(slot))
                }
                break
            },
        }
        let framed = frame_fields(input, parsed, fields, cfg.body_max)
        let wire: Result[Framing, BodyError] = if policy.upgrade_requested {
            match framed {
                Ok(Empty) => Ok(Empty),
                Ok(ContentLength(0)) => Ok(Empty),
                _ => Error(failure(400)),
            }
        } else {
            framed
        }
        let frame = match wire {
            Ok(f) => f,
            Error(e) => {
                if write_succeeded(reply_error_until(mut writer, e.status, c, clock.deadline_after_ms(host.mono_ns(c), cfg.write_ms), signal)) && first {
                    let _ = channel.send(inbox, FirstResponse(slot))
                }
                break
            },
        }
        let need_scratch = match frame {
            Empty => false,
            ContentLength(n) => n != 0 && n > list.len(input) - head.end,
            Chunked => true,
            CloseDelimited => true,
        }
        if need_scratch && list.capacity(scratch) == 0 {
            scratch = list.with_capacity(8192)
        }
        list.clear(mut scratch)
        let (reuse, input_at, scratch_at, offer) = {
            let initial = Body(input: view input, input_at: head.end, reader: take reader, writer: take writer, scratch: take scratch, scratch_at: 0, decoder: decoder(frame, head, cfg.body_max), head_max: cfg.head_max, fields_max: cfg.fields_max, clock: c, stop: share_signal(signal), body_deadline: clock.deadline_after_ms(completed, cfg.body_ms), handler_deadline: clock.deadline_after_ms(completed, cfg.handler_ms), write_ms: cfg.write_ms, pipeline_max: cfg.pipeline_max, expect_continue: policy.expect_continue, fault: None, output_failed: false)
            let (step, remaining) = handle(input, parsed, policy, frame, take initial, mut out, cfg, routes, state, mut date)
            let mut body = match take remaining {
                Some(take resumed) => take resumed,
                None => return completed_replies,
            }
            let (reuse, offer): (bool, Option[Handover]) = match take step {
                Keep(at, end) => {
                    completed_replies += 1
                    start = at
                    if first {
                        let _ = channel.send(inbox, FirstResponse(slot))
                    }
                    (stop_deadline(signal) == None && drain(mut body, cfg.drain_max, end), None)
                },
                RepliedAndClose => {
                    completed_replies += 1
                    if first {
                        let _ = channel.send(inbox, FirstResponse(slot))
                    }
                    (false, None)
                },
                CloseConnection => (false, None),
                MoveSocket(take offer) => (false, Some(take offer)),
            }
            let Body(reader: take next_reader, writer: take next_writer, scratch: take s, input_at, scratch_at, input: _, decoder: _, head_max: _, fields_max: _, clock: _, stop: _, body_deadline: _, handler_deadline: _, write_ms: _, pipeline_max: _, expect_continue: _, fault: _, output_failed: _) = take body
            reader = take next_reader
            writer = take next_writer
            scratch = take s
            (reuse, input_at, scratch_at, take offer)
        }
        if let Some(take accepted_offer) = take offer {
            match take accepted_offer {
                ToUpgrade(take offered) => {
                    let UpgradeOffer(head: take reply, argument: take argument, bytes_reserved: reserve, run, pre_head: deadline) = take offered
                    discard(take scratch)
                    let transfer = upgrade.Transfer(reader: take reader, writer: take writer, input: take input, tail_at: head.end, head: take reply, argument: take argument, clock: c, pre_head: deadline, write_ms: cfg.write_ms)
                    send_upgrade_promotion(inbox, slot, take transfer, reserve, run, cfg, signal)
                },
                ToStream(take offered) => {
                    let buffered = (list.len(input) - input_at) + (list.len(scratch) - scratch_at)
                    discard(take input)
                    discard(take scratch)
                    let transfer = stream.Transfer(reader: take reader, writer: take writer, offer: take offered, buffered, clock: c, out_cap: cfg.out_cap, pipeline_max: cfg.pipeline_max, write_ms: cfg.write_ms, linger_ms: cfg.linger_ms, heartbeat_ms: cfg.heartbeat_ms, lease_ms: cfg.lease_ms)
                    send_stream_promotion(inbox, slot, take transfer, signal)
                },
            }
            return completed_replies
        }
        if !reuse {
            break
        }
        if let Some(_) = signal {
            if !commit_phase(inbox, slot, false) {
                break
            }
        }
        list.drop_prefix(mut input, input_at)
        let _ = list.append(mut input, list.slice(scratch, scratch_at, list.len(scratch)))
        first = false
        batch += 1
        if batch == 16 {
            task.check_cancel()
            batch = 0
        }
    }
    discard(take scratch)
    let _ = net.finish(take writer, take reader, c, clamp_deadline(signal, clock.deadline_after_ms(host.mono_ns(c), cfg.linger_ms)))
    completed_replies
}

pub type ServeError: send = Configuration | Capacity(Capacity) | Network(NetError)

type AcceptorJob: send {
    listener: Listener,
    c: Clock,
    inbox: Sender[ConnectionSignal]
}

fn acceptor(take job: AcceptorJob) waits {
    let AcceptorJob(listener: take listener, c, inbox: take inbox) = take job
    let mut l = take listener
    loop {
        match host.accept(mut l, Never) {
            Ok((take socket, peer)) => {
                let at = host.mono_ns(c)
                if let Error(_) = channel.send(inbox, Accepted(take socket, peer.ip, at)) {
                    return
                }
            },
            Error(e) => {
                let _ = channel.send(inbox, ListenerFailed(e))
                return
            },
        }
    }
}

type RefusalJob: send {
    socket: Socket,
    at: u64
}

type RefusalWorker: send {
    inbox: Sender[ConnectionSignal],
    jobs: Receiver[RefusalJob],
    slot: u64,
    c: Clock,
    ms: u64
}

fn refusal_worker(take worker: RefusalWorker) waits {
    let RefusalWorker(inbox: take inbox, jobs: take jobs, slot, c, ms) = take worker
    while let Ok(take job) = channel.receive(jobs) {
        let RefusalJob(socket: take socket, at) = take job
        let until = clock.deadline_after_ms(at, ms)
        let (input, output) = net.split(take socket)
        let mut w = take output
        let _ = reply_error(mut w, 503, c, until)
        let _ = net.finish(take w, take input, c, until)
        if let Error(_) = channel.send(inbox, Refused(slot)) {
            return
        }
    }
}

type RefusalSlot {
    child: Task[()],
    tx: Sender[RefusalJob],
    busy: bool
}

type HttpSlot {
    child: Task[()],
    first: bool,
    promoted: bool,
    active: bool,
    ip: (u64, u64, u64)
}

type PromotedSlot {
    child: Task[()],
    first: bool,
    ip: (u64, u64, u64),
    generation: u64,
    stop: Option[stream.StopHandle]
}

resource type ServerTasks {
    connections: List[Option[HttpSlot]],
    promoted: List[Option[PromotedSlot]],
    refusals: List[RefusalSlot],
    acceptors: List[Task[()]]
} drop(group) {
    for i in 0u64 .. list.len(group.acceptors) {
        task.cancel(mut group.acceptors[i])
    }
    for i in 0u64 .. list.len(group.refusals) {
        task.cancel(mut group.refusals[i].child)
    }
    for i in 0u64 .. list.len(group.connections) {
        let slot = replace(mut group.connections[i], None)
        if let Some(take held) = take slot {
            let mut active = take held
            task.cancel(mut active.child)
            group.connections[i] = Some(take active)
        }
    }
    for i in 0u64 .. list.len(group.promoted) {
        let slot = replace(mut group.promoted[i], None)
        if let Some(take held) = take slot {
            let mut active = take held
            task.cancel(mut active.child)
            group.promoted[i] = Some(take active)
        }
    }
}

fn refuse(mut slots: List[RefusalSlot], take socket: Socket, at: u64) {
    for i in 0u64 .. list.len(slots) {
        if !slots[i].busy {
            let job = RefusalJob(socket: take socket, at)
            if let Ok(()) = channel.try_send(slots[i].tx, take job) {
                slots[i].busy = true
            }
            return
        }
    }
}

fn bytes_for_connection(cfg: Config) -> u64 {
    let input = cfg.head_max + cfg.pipeline_max + cfg.body_inline
    // List carriers are inline. MEM-24 rounds their allocations to 8.
    let read_bytes = (input + 7) / 8 * 8
    let write_bytes = (cfg.out_cap + 7) / 8 * 8
    // Head, decoder and cursors are inline. Reserve J and the one-slot
    // hand-over reply alongside the handler's allowance.
    read_bytes + write_bytes + 8192 + 1024 + 248 + cfg.handler_bytes
}

fn valid_config(cfg: Config) -> bool {
    if cfg.head_max == 0 || cfg.head_max > 8192 || cfg.fields_max > 64 || cfg.inbox_cap == 0 {
        return false
    }
    if cfg.streams_max != 0 && cfg.heartbeat_ms == 0 {
        return false
    }
    // Reserve only arithmetic room here. Actual population storage and
    // task allocations still use checked Capacity.
    let input_size = int.saturating_add(cfg.pipeline_max, cfg.body_inline)
    let with_output = int.saturating_add(input_size, cfg.out_cap)
    let total = int.saturating_add(with_output, cfg.handler_bytes)
    total <= 18446744073709551615 - 32768 && cfg.state_max <= 18446744073709551608
}

fn source_key(ip: Ip) -> (u64, u64, u64) {
    match ip {
        V4(lo) => (4u64, 0u64, int.widen(lo)),
        V6(hi, lo) => if hi == 0 && lo >> 32 == 65535 {
            let v4: u32 = int.truncate(lo)
            (4u64, 0u64, int.widen(v4))
        } else {
            (6u64, hi, lo)
        },
    }
}

fn promotion_slot(slots: List[Option[PromotedSlot]], start: u64, end: u64) -> u64 {
    for i in start .. end {
        if let None = slots[i] {
            return i
        }
    }
    end
}

fn promote_upgrade(mut group: ServerTasks, tasks: Tasks, tx: Sender[ConnectionSignal], done: Sender[ChildSlot], end: u64, mut generation: u64, signal: Option[DrainSignal], take request: UpgradeRequest) {
    let UpgradeRequest(source_slot: slot, transfer: take transfer, reserve, run, reply: take reply) = take request
    let vacant = promotion_slot(group.promoted, 0, end)
    if vacant == end {
        let _ = channel.try_send(reply, Some(take transfer))
        return
    }
    let completion = match Completion(done: channel.sender(done), wake: channel.sender(tx), slot: PromotedChild(vacant), armed: false) {
        Ok(take x) => take x,
        Error(_) => {
            let _ = channel.try_send(reply, Some(take transfer))
            return
        },
    }
    let mark = EstablishedNotice(inbox: channel.sender(tx), slot: vacant, generation, marked: false, stop: share_signal(signal))
    let origin = replace(mut group.connections[slot], None)
    let mut source = match take origin {
        Some(take present) => take present,
        None => {
            let _ = channel.try_send(reply, Some(take transfer))
            return
        },
    }
    let job = UpgradeJob(transfer: take transfer, run, notice: take mark, completion: take completion)
    match task.try_spawn(tasks, bytes reserve, take job, upgraded) {
        Ok(take child) => {
            group.promoted[vacant] = Some(PromotedSlot(child: take child, first: source.first, ip: source.ip, generation, stop: None))
            source.first = false
            source.promoted = true
            generation = int.wrapping_add(generation, 1)
            let _ = channel.try_send(reply, None)
        },
        Error((_, take refused)) => {
            let UpgradeJob(transfer: take returned, run: _, notice: _, completion: _) = take refused
            let _ = channel.try_send(reply, Some(take returned))
        },
    }
    group.connections[slot] = Some(take source)
}

fn promote_stream(mut group: ServerTasks, tasks: Tasks, tx: Sender[ConnectionSignal], done: Sender[ChildSlot], from: u64, mut in_first_phase: u64, mut generation: u64, signal: Option[DrainSignal], take request: StreamRequest) {
    let StreamRequest(source_slot: slot, transfer: take transfer, reply: take reply) = take request
    let end = list.len(group.promoted)
    let vacant = promotion_slot(group.promoted, from, end)
    if vacant == end {
        let _ = channel.try_send(reply, Some(take transfer))
        return
    }
    let completion = match Completion(done: channel.sender(done), wake: channel.sender(tx), slot: PromotedChild(vacant), armed: false) {
        Ok(take x) => take x,
        Error(_) => {
            let _ = channel.try_send(reply, Some(take transfer))
            return
        },
    }
    let origin = replace(mut group.connections[slot], None)
    let mut source = match take origin {
        Some(take present) => take present,
        None => {
            let _ = channel.try_send(reply, Some(take transfer))
            return
        },
    }
    let reserve = stream.reservation(transfer.offer, transfer.out_cap)
    let control: Option[StreamControl] = if let Some(_) = signal {
        Some(StreamControl(inbox: channel.sender(tx), slot: vacant, generation, stop: share_signal(signal)))
    } else {
        None
    }
    let job = StreamJob(work: stream.Work(transport: take transfer, tasks, control: take control), completion: take completion)
    match task.try_spawn(tasks, bytes reserve, take job, streaming) {
        Ok(take child) => {
            group.promoted[vacant] = Some(PromotedSlot(child: take child, first: false, ip: source.ip, generation, stop: None))
            generation = int.wrapping_add(generation, 1)
            if source.first {
                in_first_phase -= 1
                source.first = false
            }
            source.promoted = true
            let _ = channel.try_send(reply, None)
        },
        Error((_, take refused)) => {
            let StreamJob(work: take work, completion: _) = take refused
            let stream.Work(transport: take returned, tasks: _, control: _) = take work
            let _ = channel.try_send(reply, Some(take returned))
        },
    }
    group.connections[slot] = Some(take source)
}

type StopJob: send {
    incoming: Receiver[u64],
    inbox: Sender[ConnectionSignal],
    c: Clock
}

fn watch_stop(take job: StopJob) waits {
    let StopJob(incoming: take incoming, inbox: take inbox, c) = take job
    if let Ok(deadline) = channel.receive(incoming) {
        let requested: Option[u64] = Some(deadline)
        let at = arc.new(requested)
        if let Ok(()) = channel.send(inbox, Stop(take at)) {
            host.sleep_until(c, deadline)
            let _ = channel.send(inbox, StopExpired)
        }
    }
}

fn close_admission(mut group: ServerTasks) waits {
    for i in 0u64 .. list.len(group.acceptors) {
        task.cancel(mut group.acceptors[i])
    }
    while let Some(take child) = list.pop(mut group.acceptors) {
        let _ = task.join(take child)
    }
    for current in group.promoted {
        if let Some(s) = current {
            if let Some(stop) = s.stop {
                stream.signal_stop(stop)
            }
        }
    }
    for i in 0u64 .. list.len(group.connections) {
        let current = replace(mut group.connections[i], None)
        if let Some(take held) = take current {
            let mut current_job = take held
            if !current_job.active && !current_job.promoted {
                task.cancel(mut current_job.child)
            }
            group.connections[i] = Some(take current_job)
        }
    }
    for i in 0u64 .. list.len(group.refusals) {
        task.cancel(mut group.refusals[i].child)
    }
    while let Some(take ended) = list.pop(mut group.refusals) {
        let RefusalSlot(child: take child, tx: _, busy: _) = take ended
        let _ = task.join(take child)
    }
}

fn has_sockets(group: ServerTasks) -> bool {
    for current in group.connections {
        if let Some(_) = current {
            return true
        }
    }
    for current in group.promoted {
        if let Some(_) = current {
            return true
        }
    }
    false
}

fn discard_socket(take socket: Socket) {}

/// Serves a group of listeners with an immutable router and shared handler state.
pub fn serve[S: shareable + send](take listeners: List[Listener], c: Clock, tasks: Tasks, take cfg: Config, take routes: router.Router[S], take state: S) -> Result[(), ServeError] waits {
    serve_internal(take listeners, c, tasks, take cfg, take routes, take state, None)
}

/// The first deadline on stop closes admission and bounds the active exchanges.
pub fn serve_with_stop[S: shareable + send](take listeners: List[Listener], c: Clock, tasks: Tasks, take cfg: Config, take routes: router.Router[S], take state: S, take stop: Receiver[u64]) -> Result[(), ServeError] waits {
    serve_internal(take listeners, c, tasks, take cfg, take routes, take state, Some(take stop))
}

fn serve_internal[S: shareable + send](take listeners: List[Listener], c: Clock, tasks: Tasks, take cfg: Config, take routes: router.Router[S], take state: S, take incoming: Option[Receiver[u64]]) -> Result[(), ServeError] waits {
    if !valid_config(cfg) {
        return Error(Configuration)
    }
    if list.len(listeners) == 0 {
        return Ok(())
    }
    let shared = arc.new(take state)
    let routing = arc.new(take routes)
    let settings = arc.new(take cfg)
    let (tx, rx): (Sender[ConnectionSignal], Receiver[ConnectionSignal]) = channel.new(settings.inbox_cap)
    let (signal, _watcher): (Option[DrainSignal], Option[Task[()]]) = match take incoming {
        Some(take stop) => {
            let initial: Option[u64] = None
            let stored = arc.new(initial)
            let root = latest.new(take stored)
            let watch = StopJob(incoming: take stop, inbox: channel.sender(tx), c)
            let observer = task.spawn(tasks, bytes 64, take watch, watch_stop)
            (Some(DrainSignal(deadline: take root)), Some(take observer))
        },
        None => (None, None),
    }
    let http_slots = order.min(settings.http_max, settings.sockets_max)
    let upgrade_slots = order.min(settings.upgrades_max, settings.sockets_max)
    let stream_slots = order.min(settings.streams_max, settings.sockets_max)
    let promoted_slots = int.saturating_add(upgrade_slots, stream_slots)
    let mut slots: List[Option[HttpSlot]] = list.with_capacity(http_slots)
    let mut promoted: List[Option[PromotedSlot]] = list.with_capacity(promoted_slots)
    let (done_tx, done_rx): (Sender[ChildSlot], Receiver[ChildSlot]) = channel.new(order.max(int.saturating_add(http_slots, promoted_slots), 1))
    for _ in 0u64 .. http_slots {
        let _ = list.push(mut slots, None)
    }
    for _ in 0u64 .. promoted_slots {
        let _ = list.push(mut promoted, None)
    }
    let refusals: List[RefusalSlot] = list.with_capacity(settings.refuse_max)
    let acceptors: List[Task[()]] = list.with_capacity(list.len(listeners))
    let allocated_group = ServerTasks(connections: take slots, promoted: take promoted, refusals: take refusals, acceptors: take acceptors)
    let mut group = match take allocated_group {
        Ok(take g) => take g,
        Error((e, _)) => return Error(Capacity(e)),
    }
    for i in 0u64 .. settings.refuse_max {
        let (job_tx, jobs): (Sender[RefusalJob], Receiver[RefusalJob]) = channel.new(1)
        let job = RefusalWorker(inbox: channel.sender(tx), jobs: take jobs, slot: i, c, ms: settings.refuse_ms)
        let child = task.spawn(tasks, bytes 8256, take job, refusal_worker)
        list.push(mut group.refusals, RefusalSlot(child: take child, tx: take job_tx, busy: false))
    }
    let mut pending = take listeners
    while let Some(take listener) = list.pop(mut pending) {
        let job = AcceptorJob(listener: take listener, c, inbox: channel.sender(tx))
        let child = task.spawn(tasks, bytes 64, take job, acceptor)
        list.push(mut group.acceptors, take child)
    }
    let child_bytes = bytes_for_connection(settings)
    let mut in_first_phase: u64 = 0
    let mut generation: u64 = 0
    let mut stopping = false
    while let Ok(take event) = channel.receive(rx) {
        match take event {
            Accepted(take socket, peer, at) => {
                let ip = source_key(peer)
                let mut from_ip: u64 = 0
                let mut admitted: u64 = 0
                let mut vacant = http_slots
                for i in 0u64 .. http_slots {
                    match group.connections[i] {
                        Some(s) => {
                            if !s.promoted {
                                admitted += 1
                                if s.ip == ip {
                                    from_ip += 1
                                }
                            }
                        },
                        None => {
                            if vacant == http_slots {
                                vacant = i
                            }
                        },
                    }
                }
                for active in group.promoted {
                    if let Some(s) = active {
                        admitted += 1
                        if s.ip == ip {
                            from_ip += 1
                        }
                    }
                }
                if stopping {
                    discard_socket(take socket)
                } else if vacant == http_slots || admitted >= settings.sockets_max || from_ip >= settings.ip_sockets_max || in_first_phase >= settings.conns_max {
                    refuse(mut group.refusals, take socket, at)
                } else {
                    let completion = match Completion(done: channel.sender(done_tx), wake: channel.sender(tx), slot: HttpChild(vacant), armed: false) {
                        Ok(take x) => take x,
                        Error(_) => {
                            refuse(mut group.refusals, take socket, at)
                            continue
                        },
                    }
                    let job = ConnectionJob(socket: take socket, c, cfg: arc.share(settings), peer, at, routes: arc.share(routing), state: arc.share(shared), inbox: channel.sender(tx), slot: vacant, stop: share_signal(signal), completion: take completion)
                    match task.try_spawn(tasks, bytes child_bytes, take job, connection) {
                        Ok(take child) => {
                            group.connections[vacant] = Some(HttpSlot(child: take child, first: true, promoted: false, active: false, ip))
                            in_first_phase += 1
                        },
                        Error((_, take refused)) => {
                            let ConnectionJob(socket: take declined, c: _, cfg: _, peer: _, at: _, routes: _, state: _, inbox: _, slot: _, stop: _, completion: _) = take refused
                            refuse(mut group.refusals, take declined, at)
                        },
                    }
                }
            },
            Phase(slot, active, take reply) => {
                let mut accepted = false
                if !stopping {
                    let current = replace(mut group.connections[slot], None)
                    if let Some(take held) = take current {
                        let mut current_job = take held
                        current_job.active = active
                        group.connections[slot] = Some(take current_job)
                        accepted = true
                    }
                }
                let _ = channel.try_send(reply, accepted)
            },
            Stop(take deadline) => {
                if let Some(s) = signal {
                    latest.publish(s.deadline, take deadline)
                    stopping = true
                    close_admission(mut group)
                }
            },
            StopExpired => return Ok(()),
            StreamReady(slot, ticket, take recipient) => {
                let current = replace(mut group.promoted[slot], None)
                if let Some(take held) = take current {
                    let mut session = take held
                    if session.generation == ticket {
                        if stopping {
                            stream.signal_stop(recipient)
                        }
                        session.stop = Some(take recipient)
                    }
                    group.promoted[slot] = Some(take session)
                }
            },
            Source(slot, next_ip, take reply) => {
                let ip = source_key(next_ip)
                let mut from_ip: u64 = 0
                for i in 0u64 .. http_slots {
                    if let Some(s) = group.connections[i] {
                        if !s.promoted && s.ip == ip {
                            from_ip += 1
                        }
                    }
                }
                for active in group.promoted {
                    if let Some(s) = active {
                        if s.ip == ip {
                            from_ip += 1
                        }
                    }
                }
                let allowed = from_ip < settings.ip_sockets_max
                if allowed {
                    let current = replace(mut group.connections[slot], None)
                    if let Some(take session) = take current {
                        let mut s = take session
                        s.ip = ip
                        group.connections[slot] = Some(take s)
                    }
                }
                let _ = channel.try_send(reply, allowed)
            },
            FirstResponse(slot) => {
                let current = replace(mut group.connections[slot], None)
                match take current {
                    Some(take session) => {
                        let mut s = take session
                        if s.first {
                            s.first = false
                            in_first_phase -= 1
                        }
                        group.connections[slot] = Some(take s)
                    },
                    None => {},
                }
            },
            PromoteUpgrade(take request) => {
                if stopping {
                    let UpgradeRequest(source_slot: _, transfer: take transfer, reserve: _, run: _, reply: take reply) = take request
                    let _ = channel.try_send(reply, Some(take transfer))
                } else {
                    promote_upgrade(mut group, tasks, tx, done_tx, upgrade_slots, mut generation, signal, take request)
                }
            },
            PromoteStream(take request) => {
                if stopping {
                    let StreamRequest(source_slot: _, transfer: take transfer, reply: take reply) = take request
                    let _ = channel.try_send(reply, Some(take transfer))
                } else {
                    promote_stream(mut group, tasks, tx, done_tx, upgrade_slots, mut in_first_phase, mut generation, signal, take request)
                }
            },
            Established(slot, ticket) => {
                let current = replace(mut group.promoted[slot], None)
                if let Some(take session) = take current {
                    let mut s = take session
                    if s.generation == ticket && s.first {
                        s.first = false
                        in_first_phase -= 1
                    }
                    group.promoted[slot] = Some(take s)
                }
            },
            EndNotice => {},
            Refused(slot) => {
                if !stopping {
                    group.refusals[slot].busy = false
                }
            },
            ListenerFailed(e) => return Error(Network(e)),
        }
        while let Ok(slot) = channel.try_receive(done_rx) {
            match slot {
                HttpChild(i) => {
                    let ended = replace(mut group.connections[i], None)
                    if let Some(take s) = take ended {
                        let HttpSlot(child: take child, first, promoted: _, active: _, ip: _) = take s
                        let _ = task.join(take child)
                        if first {
                            in_first_phase -= 1
                        }
                    }
                },
                PromotedChild(i) => {
                    let ended = replace(mut group.promoted[i], None)
                    if let Some(take s) = take ended {
                        let PromotedSlot(child: take child, first, ip: _, generation: _, stop: _) = take s
                        let _ = task.join(take child)
                        if first {
                            in_first_phase -= 1
                        }
                    }
                },
            }
        }
        if stopping && !has_sockets(group) {
            return Ok(())
        }
    }
    Ok(())
}

/// Selects a request body boundary from the already parsed Head. No allocation.
/// HTTP-4 refuses ambiguous framing before interpreting any body bytes.
/// Ex: `http.framing(bytes, view h, 1048576)`.
pub fn framing(b: Bytes, h: View[http1.Head], body_max: u64) -> Result[Framing, BodyError] {
    frame_fields(b, h, collect_framing(b, h), body_max)
}

fn collect_framing(b: Bytes, h: View[http1.Head]) -> FramingFields {
    let mut fields = framing_fields()
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        count_framing(mut fields, request_field(part(b, f.name)), f.value, i)
    }
    fields
}

/// RFC 9112 §6.3 response framing. Bodiless responses pass hypothetical
/// length metadata through untouched. Only chunked transfer coding is decoded.
pub fn response_framing(b: Bytes, h: View[http1.Head], head_request: bool, body_max: u64) -> Result[Framing, BodyError] {
    if head_request || h.status == 204 || h.status == 304 || h.status < 200 {
        return Ok(Empty)
    }
    message_framing(b, h, collect_framing(b, h), body_max, CloseDelimited)
}

fn transfer_ows_end(b: Bytes, start: u64, end: u64) -> u64 {
    let mut at = start
    while at < end && whitespace(b[at]) {
        at += 1
    }
    at
}

fn transfer_token_end(b: Bytes, start: u64, end: u64) -> u64 {
    let mut at = start
    while at < end && http1.token(b[at]) {
        at += 1
    }
    at
}

fn transfer_value_end(b: Bytes, start: u64, end: u64) -> Result[u64, BodyError] {
    if start == end {
        return Error(failure(400))
    }
    if b[start] != b'"' {
        let next = transfer_token_end(b, start, end)
        if next == start {
            return Error(failure(400))
        }
        return Ok(next)
    }
    let mut at = start + 1
    while at < end {
        let c = b[at]
        at += 1
        if c == b'"' {
            return Ok(at)
        }
        if c == b'\\' {
            if at == end || !field_value(b[at]) {
                break
            }
            at += 1
        } else if !field_value(c) {
            break
        }
    }
    Error(failure(400))
}

fn transfer_parameters_end(b: Bytes, start: u64, end: u64) -> Result[u64, BodyError] {
    let mut at = start
    while at < end && b[at] == b';' {
        let name_start = transfer_ows_end(b, at + 1, end)
        let name_end = transfer_token_end(b, name_start, end)
        let equals = transfer_ows_end(b, name_end, end)
        if name_end == name_start || equals == end || b[equals] != b'=' {
            return Error(failure(400))
        }
        let value_end = transfer_value_end(b, transfer_ows_end(b, equals + 1, end), end)?
        at = transfer_ows_end(b, value_end, end)
    }
    Ok(at)
}

// The field mask preserves order without scanning unrelated fields again.
// A comma inside a quoted parameter does not separate transfer codings.
fn transfer_framing(b: Bytes, h: View[http1.Head], fields: u64) -> Result[Framing, BodyError] {
    let mut remaining = fields
    let mut chunked = false
    let mut unknown = false
    while remaining != 0 {
        let index: u64 = int.widen(int.trailing_zeros(remaining))
        let value = h.fields[index].value
        let mut at = value.start
        loop {
            let start = transfer_ows_end(b, at, value.end)
            let end = transfer_token_end(b, start, value.end)
            if chunked || start == end {
                return Error(failure(400))
            }
            chunked = http1.equal_ascii(list.slice(b, start, end), string.as_bytes("chunked"))
            unknown = unknown || !chunked
            at = transfer_ows_end(b, end, value.end)
            if at < value.end && b[at] == b';' {
                if chunked {
                    return Error(failure(400))
                }
                at = transfer_parameters_end(b, at, value.end)?
            }
            if at == value.end {
                break
            }
            if b[at] != b',' {
                return Error(failure(400))
            }
            at += 1
        }
        remaining &= remaining - 1
    }
    if unknown {
        return Error(failure(501))
    }
    Ok(Chunked)
}

// The connection checks policy first, then interprets the recorded framing spans.
fn frame_fields(b: Bytes, h: View[http1.Head], fields: FramingFields, body_max: u64) -> Result[Framing, BodyError] {
    if fields.length.end - fields.length.start > 19 && fields.lengths == 1 && fields.encoding_fields == 0 {
        return Error(failure(400))
    }
    message_framing(b, h, fields, body_max, Empty)
}

fn message_framing(b: Bytes, h: View[http1.Head], fields: FramingFields, body_max: u64, absent: Framing) -> Result[Framing, BodyError] {
    let FramingFields(lengths, encoding_fields, length) = fields
    if lengths > 0 && encoding_fields != 0 || lengths > 1 {
        return Error(failure(400))
    }
    if encoding_fields != 0 {
        if h.version == 0 {
            return Error(failure(400))
        }
        return transfer_framing(b, h, encoding_fields)
    }
    if lengths == 0 {
        return Ok(absent)
    }
    if length.start == length.end {
        return Error(failure(400))
    }
    let Ok(size) = int.parse_decimal_span(b, length.start, length.end, 18446744073709551615) else {
        return Error(failure(400))
    }
    if size > body_max {
        return Error(failure(413))
    }
    Ok(ContentLength(size))
}

type BodyState: key = Fixed | UntilEof | Size | SizeWs | ExtStart | ExtName | ExtNameWs | ExtValueStart | ExtToken | ExtQuote | ExtEscape | ExtAfter | ExtWs | ChunkLf | ChunkData | DataCr | DataLf | TrailerStart | TrailerName | TrailerValue | TrailerLf | TrailerEndLf | Finished | Broken

pub type Decoder {
    state: BodyState,
    used: u64,
    decoded: u64,
    remaining: u64,
    body_max: u64,
    size: u64,
    digits: u8,
    line_bytes: u64,
    trailer_bytes: u64,
    trailer_fields: u64,
    error: BodyError
}

pub type BodyProgress: key = More | Data(http1.Span) | Done | Failed(BodyError)

/// Starts a fixed-storage body decoder after framing succeeds. Head is read
/// only here; trailers can never change it. All errors permanently latch close.
/// Ex: `let mut d = http.decoder(frame, h, body_max)`.
pub fn decoder(frame: Framing, h: http1.Head, body_max: u64) -> Decoder {
    let mut d = Decoder(state: Finished, used: 0, decoded: 0, remaining: 0, body_max, size: 0, digits: 0, line_bytes: 0, trailer_bytes: h.end, trailer_fields: h.count, error: failure(400))
    match frame {
        Empty => {},
        ContentLength(n) => {
            d.remaining = n
            if n > 0 {
                d.state = Fixed
            }
        },
        Chunked => {
            d.state = Size
        },
        CloseDelimited => {
            d.state = UntilEof
        },
    }
    d
}

fn fail(mut d: Decoder, status: u16) {
    d.error = failure(status)
    d.state = Broken
}

fn token(c: u8) -> bool {
    int.is_ascii_alpha(c) || int.is_ascii_digit(c) || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
}

fn whitespace(c: u8) -> bool {
    c == b' ' || c == 9
}

fn field_value(c: u8) -> bool {
    c == 9 || c >= 32 && c != 127
}

fn extension_end(c: u8, mut d: Decoder) {
    if c == b';' {
        d.state = ExtStart
    } else if c == 13 {
        d.state = ChunkLf
    } else if whitespace(c) {
        d.state = ExtWs
    } else {
        fail(mut d, 400)
    }
}

fn extension_name_end(c: u8, mut d: Decoder) {
    if c == b'=' {
        d.state = ExtValueStart
    } else if whitespace(c) {
        d.state = ExtNameWs
    } else {
        extension_end(c, mut d)
    }
}

fn chunk_line(c: u8, mut d: Decoder) {
    match d.state {
        Size => {
            match int.ascii_digit(c, 16) {
                Some(nibble) => {
                    let digit: u64 = int.widen(nibble)
                    if d.digits == 16 || d.size > (18446744073709551615u64 - digit) / 16 {
                        fail(mut d, 400)
                    } else {
                        d.size = d.size * 16 + digit
                        d.digits += 1
                    }
                },
                None => {
                    if d.digits == 0 {
                        fail(mut d, 400)
                    } else if whitespace(c) {
                        d.state = SizeWs
                    } else {
                        extension_end(c, mut d)
                    }
                }
            }
        },
        SizeWs => {
            if c == b';' {
                d.state = ExtStart
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ExtStart => {
            if token(c) {
                d.state = ExtName
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ExtName => {
            if !token(c) {
                extension_name_end(c, mut d)
            }
        },
        ExtNameWs => {
            if c == b'=' {
                d.state = ExtValueStart
            } else if c == b';' {
                d.state = ExtStart
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ExtValueStart => {
            if c == b'"' {
                d.state = ExtQuote
            } else if token(c) {
                d.state = ExtToken
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ExtToken => {
            if !token(c) {
                extension_end(c, mut d)
            }
        },
        ExtQuote => {
            if c == b'"' {
                d.state = ExtAfter
            } else if c == b'\\' {
                d.state = ExtEscape
            } else if !field_value(c) {
                fail(mut d, 400)
            }
        },
        ExtEscape => {
            if field_value(c) {
                d.state = ExtQuote
            } else {
                fail(mut d, 400)
            }
        },
        ExtAfter => extension_end(c, mut d),
        ExtWs => {
            if c == b';' {
                d.state = ExtStart
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ChunkLf => {
            if c != 10 {
                fail(mut d, 400)
            } else if d.size > d.body_max - d.decoded {
                fail(mut d, 413)
            } else {
                d.remaining = d.size
                if d.size == 0 {
                    d.state = TrailerStart
                } else {
                    d.state = ChunkData
                }
                d.size = 0
                d.digits = 0
                d.line_bytes = 0
            }
        },
        _ => {}
    }
}

fn in_trailers(state: BodyState) -> bool {
    state == TrailerStart || state == TrailerName || state == TrailerValue || state == TrailerLf || state == TrailerEndLf
}

fn trailer(c: u8, mut d: Decoder) {
    match d.state {
        TrailerStart => {
            if c == 13 {
                d.state = TrailerEndLf
            } else if !token(c) {
                fail(mut d, 400)
            } else if d.trailer_fields == 64 {
                fail(mut d, 431)
            } else {
                d.trailer_fields += 1
                d.state = TrailerName
            }
        },
        TrailerName => {
            if c == b':' {
                d.state = TrailerValue
            } else if !token(c) {
                fail(mut d, 400)
            }
        },
        TrailerValue => {
            if c == 13 {
                d.state = TrailerLf
            } else if !field_value(c) {
                fail(mut d, 400)
            }
        },
        TrailerLf => {
            if c == 10 {
                d.state = TrailerStart
            } else {
                fail(mut d, 400)
            }
        },
        TrailerEndLf => {
            if c == 10 {
                d.state = Finished
            } else {
                fail(mut d, 400)
            }
        },
        _ => {}
    }
}

/// Returns the number of consecutive payload bytes allowed by the decoder.
/// None indicates framing or completion. A zero window requires EOF.
pub fn body_payload(d: Decoder) -> Option[u64] {
    match d.state {
        Fixed => Some(d.remaining),
        ChunkData => Some(d.remaining),
        UntilEof => Some(d.body_max - d.decoded),
        _ => None,
    }
}

/// Accounts for payload read directly into output, within the current window.
pub fn advance_body_payload(mut d: Decoder, n: u64) {
    d.decoded += n
    if d.state != UntilEof {
        d.remaining -= n
        if d.remaining == 0 {
            d.state = if d.state == Fixed {
                Finished
            } else {
                DataCr
            }
        }
    }
}

/// Consumes a fresh input fragment, returning one body span at a time. used
/// counts bytes consumed from THIS call's input, including framing bytes.
/// Pass its unconsumed suffix to the next call. More needs more network bytes;
/// Done leaves the pipelined tail untouched. Data is a view into this input.
/// Ex: `http.decode(mut d, input)`.
pub fn decode(mut d: Decoder, b: Bytes) -> BodyProgress {
    d.used = 0
    loop {
        if d.state == Finished {
            return Done
        }
        if d.state == Broken {
            return Failed(d.error)
        }
        if d.used == list.len(b) {
            if in_trailers(d.state) && d.trailer_bytes == 8192 {
                fail(mut d, 431)
                continue
            }
            if d.line_bytes == 1024 {
                fail(mut d, 400)
                continue
            }
            return More
        }
        if let Some(window) = body_payload(d) {
            let start = d.used
            let n = order.min(window, list.len(b) - start)
            if n == 0 {
                fail(mut d, 413)
                continue
            }
            d.used += n
            advance_body_payload(mut d, n)
            return Data(http1.Span(start, end: d.used))
        }
        let c = b[d.used]
        d.used += 1
        if in_trailers(d.state) {
            if d.trailer_bytes == 8192 {
                fail(mut d, 431)
            } else {
                d.trailer_bytes += 1
                trailer(c, mut d)
            }
        } else if d.state == DataCr {
            if c == 13 {
                d.state = DataLf
            } else {
                fail(mut d, 400)
            }
        } else if d.state == DataLf {
            if c == 10 {
                d.state = Size
            } else {
                fail(mut d, 400)
            }
        } else {
            if d.line_bytes == 1024 {
                fail(mut d, 400)
            } else {
                d.line_bytes += 1
                chunk_line(c, mut d)
            }
        }
    }
}

/// End of input finishes a close-delimited body. A short Content-Length
/// body or unfinished chunk framing permanently closes the connection.
/// Ex: `http.body_eof(mut d)`.
pub fn body_eof(mut d: Decoder) -> Result[(), BodyError] {
    if d.state == Finished || d.state == UntilEof {
        d.state = Finished
        return Ok(())
    }
    if d.state != Broken {
        fail(mut d, 400)
    }
    Error(d.error)
}

// Lanes that differ from every element they replace: s backwards.
fn pattern_i16(s: List[i16]) -> Inline[i16, 16] {
    let mut p: Inline[i16, 16] = [0; 16]
    for i in 0u64 .. 16u64 {
        p[i] = s[18u64 - i]
    }
    p
}

// SEM-11: inline.lanes on an Inline[i16, 19] under the list.lanes law, at an element offset.
fn ilanes_i16(at: u64) -> bool {
    let a = inline_i16(seq_i16())
    let v: Simd[i16, 16] = inline.lanes(a, at)
    if at > 3u64 {
        return false
    }
    let mut want: Inline[i16, 16] = [0; 16]

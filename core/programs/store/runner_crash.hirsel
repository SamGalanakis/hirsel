// R1b (RUNNER-SPEC v2.10 §8, L1 and calls25's crash scenarios) on a disk store, under the
// store's W2 crash adapter (core/tools/runner_crash.c). The adapter starts separate server and client processes for each phase,
// argv: phase (init, write, read), scenario, expected (new or prefix), floor. In write it
// cuts the filesystem at one mutation, or fails one named sync (poison-segment); its floor
// is the largest version this program reported with `ACK v`.
//
// Expected values come from the spec, not from the runner:
// - each body's reply is std.codec.put_result of its Result[u64, u32], or Failed(Raised(2))
//   for an index fault (RUNNER-SPEC §1.1), and does not depend on the version, so a reply
//   kept before a crash and one made after it are byte-equal (C3);
// - `bump` adds 1 to the counter row 0, so after every position is answered the counter
//   is the number of positions whose body committed: each effect once (C1);
// - a frame reporting a commit (Returned or Failed) comes from a durable Release (V4), so
//   the store recovered after any cut holds at least every version a client saw (L1);
// - a poisoned journal answers nothing (§2.1 Poison), so its floor holds too.
//
// Scenarios (calls25_model.py):
// - runner-cross (cross_session_crash): stream 0 p0 from two sessions, stream 1 p0 a typed
//   error from the second, then stream 0 p1 from the first;
// - runner-order (out_of_order_two_sessions): stream 0 p1 from one session before p0, a
//   fault, from the other;
// - poison-segment (poison): the cross calls, each sent once the previous is answered, with
//   the sync of the first call's effect frame failing.
// The adapter gives one cut per run, so runner-order has one crash where the model has two.
type Hd: send { t: store.Table[u64, u64] }

type Calls = runner.Registry[(), Hd]

fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    let codec: std.codec.Codec[u64] = std.codec.of()
    match store.migration_create_table(mut phase, store.spec("data", std.codec.key_u64(), codec)) {
        Ok(()) => Ok(()),
        Error(Exists(_)) => Ok(()),
        Error(take problem) => Error(take problem),
    }
}

fn handles(catalog: store.Schema) -> Result[Hd, store.Error] {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let t = store.schema_table(catalog, "data", std.codec.key_u64(), cv)?
    Ok(Hd(t: t))
}

fn counted(tx: store.Tx, h: Hd) -> Result[u64, u32] {
    match store.fetch(tx, store.shape(h.t), 0u64) {
        Ok(Some(n)) => Ok(n),
        Ok(None) => Ok(0u64),
        Error(_) => Error(1u32),
    }
}

// Adds 1 to the counter and returns k.
fn bump(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    let n = counted(tx, h)?
    match store.put(mut tx, h.t, 0u64, n + 1u64) {
        Ok(()) => Ok(k),
        Error(_) => Error(1u32),
    }
}

// Adds 1 to the counter, then returns a typed error, so the effect is aborted.
fn deny(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    let n = counted(tx, h)?
    let _ = store.put(mut tx, h.t, 0u64, n + 1u64)
    Error(7u32)
}

// Adds 1 to the counter, then faults (Bounds, Raised(2)).
fn trip(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    let n = counted(tx, h)?
    let _ = store.put(mut tx, h.t, 0u64, n + 1u64)
    let xs: List[u64] = list.new()
    Ok(xs[k])
}

fn place(mut r: Calls) -> Result[(), runner.RegisterError] {
    runner.transact(mut r, code.describe(bump), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(deny), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(trip), 65536u64, runner.DEFAULT_STEPS)
}

const N_PLACE: u64 = 1048576u64

fn key_of(id: View[Bytes]) -> Bytes {
    let mut key: Bytes = list.new()
    result.unwrap(list.append(mut key, id))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(std.codec.of_u64())), mut key))
    let carried: std.codec.Codec[Result[u64, u32]] = std.codec.of()
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(carried)), mut key))
    key
}

fn u64_bytes(x: u64) -> Bytes {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_u64(x, mut b))
    b
}

fn want(ok: bool, take what: String) {
    if !ok {
        fail(take what)
    }
}

// A client verdict: empty when every call was answered as expected.
fn clean(take verdict: String) {
    if verdict != "" {
        fail(take verdict)
    }
}

fn same(a: runner.Outcome, b: runner.Outcome) -> bool {
    let co: std.codec.Codec[runner.Outcome] = std.codec.of()
    let mut x: Bytes = list.new()
    let mut y: Bytes = list.new()
    result.unwrap(std.codec.encode(co, a, mut x))
    result.unwrap(std.codec.encode(co, b, mut y))
    x == y
}

fn returned(r: Result[u64, u32]) -> runner.Outcome {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_result(r, std.codec.of_u64(), std.codec.of_u32(), mut b))
    Returned(take b)
}

// One position of a scenario: who sends it (session 0 or 1), its stream and p, its body
// (0 bump, 1 deny, 2 trip), its argument, and whether its body commits an effect.
type Pos: send { from: u64, stream: u64, p: u64, body: u64, k: u64 }

fn body_key(body: u64) -> Bytes {
    if body == 0u64 {
        key_of(code.identity(code.describe(bump)))
    } else if body == 1u64 {
        key_of(code.identity(code.describe(deny)))
    } else {
        key_of(code.identity(code.describe(trip)))
    }
}

fn expected(x: Pos) -> runner.Outcome {
    if x.body == 0u64 {
        returned(Ok(x.k))
    } else if x.body == 1u64 {
        returned(Error(7u32))
    } else {
        Failed(Raised(2u32))
    }
}

// Sends in this order; re-sends after a crash go in (stream, p) order.
fn positions(scenario: View[String]) -> List[Pos] {
    let mut xs: List[Pos] = list.new()
    if scenario == "runner-order" {
        result.unwrap(list.push(mut xs, Pos(from: 1u64, stream: 0u64, p: 1u64, body: 0u64, k: 5u64)))
        result.unwrap(list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 0u64, body: 2u64, k: 0u64)))
    } else {
        result.unwrap(list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 0u64, body: 0u64, k: 1u64)))
        result.unwrap(list.push(mut xs, Pos(from: 1u64, stream: 0u64, p: 0u64, body: 0u64, k: 1u64)))
        result.unwrap(list.push(mut xs, Pos(from: 1u64, stream: 1u64, p: 0u64, body: 1u64, k: 2u64)))
        result.unwrap(list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 1u64, body: 0u64, k: 3u64)))
    }
    xs
}

// The positions once each, in (stream, p) order, and the counter they leave.
fn resends(scenario: View[String]) -> (List[Pos], u64) {
    let mut xs: List[Pos] = list.new()
    if scenario == "runner-order" {
        result.unwrap(list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 0u64, body: 2u64, k: 0u64)))
        result.unwrap(list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 1u64, body: 0u64, k: 5u64)))
        (take xs, 1u64)
    } else {
        result.unwrap(list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 0u64, body: 0u64, k: 1u64)))
        result.unwrap(list.push(mut xs, Pos(from: 0u64, stream: 0u64, p: 1u64, body: 0u64, k: 3u64)))
        result.unwrap(list.push(mut xs, Pos(from: 0u64, stream: 1u64, p: 0u64, body: 1u64, k: 2u64)))
        (take xs, 2u64)
    }
}

fn options() -> store.Options {
    let mut o = store.defaults()
    o.checkpoint_task_bytes = 1048576u64
    o.resident_limit = 1048576u64
    o.pack_bytes = 512u64
    o.group_commits = 2u32
    o.group_bytes = 1048576u32
    o
}

// L31 uses the disk harness without a crash. The host supplies one random token
// and searches the files after the last acknowledged call and checkpoint.
type SecretClient: send {
    tasks: Tasks, net: Net, clock: Clock, random: Random, policy: ingress.Ingress,
    head: Sender[runner.Req], post: Sender[runner.PubIn], authority: store.AuthorityReader, token: Bytes
}

fn secret_client(take d: SecretClient) -> String waits {
    let SecretClient(tasks: tasks, net: n, clock: c, random: r, policy: take policy, head: take head, post: take post, authority: take authority, token: take token) = take d
    let mut keys: List[Bytes] = list.new()
    result.unwrap(list.push(mut keys, body_key(0u64)))
    let pair = wire_client.pair(tasks, n, c, r, policy, head, post, authority, code.describe(place), keys, Some(take token), 1u64, 2097152u64)
    let (take wire, take server) = match take pair {
        Ok(take connected) => take connected,
        Error(Allocation(_)) => return "L31: client allocation refused",
        Error(Network(Denied)) => return "L31: loopback grant refused",
        Error(Network(_)) => return "L31: loopback connection failed",
        Error(_) => return "L31: handshake failed",
    }
    let _ = take head
    let mut answered = true
    for p in 0u64 .. 2u64 {
        wire_client.send_frame(wire, Call(7u32, p, 0u32, 5000u32, u64_bytes(p)))
        let ok = match wire_client.next(wire) {
            Ok(Batch(_, _, _, ds)) => list.len(ds) == 1u64 && ds[0u64].stream == 7u32 &&
                ds[0u64].p == p && same(ds[0u64].outcome, returned(Ok(p))),
            _ => false,
        }
        answered = answered && ok
    }
    let closed = wire_client.close(take wire)
    let joined = match task.join(take server) { Ok(Ok(())) => true, _ => false }
    if !answered { return "L31: calls did not return" }
    if !closed || !joined { return "L31: connection did not close" }
    ""
}

pub fn no_secret_at_rest(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, n: Net) -> Result[(), Exit] waits {
    let encoded = option.unwrap(args.get(argv, 0u64))
    let token = option.unwrap(result.unwrap(std.base64.decode(string.as_bytes(encoded))))
    let mut db = result.unwrap(store.open(tasks, d, c, r, options()))
    let cv: std.codec.Codec[u64] = std.codec.of()
    result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let (head, inbox): (Sender[runner.Req], Receiver[runner.Req]) = result.unwrap(channel.new(64u64))
    let mail = result.unwrap(runner.mailbox(4u64))
    let (policy, take policy_task) = result.unwrap(ingress.start(tasks, c, r, ingress.defaults(), 1048576u64))
    let mut policy_handle = take policy_task
    let seed = SecretClient(tasks: tasks, net: n, clock: c, random: r, policy: take policy, head: take head, post: runner.post(mail), authority: store.authority_reader(db), token: take token)
    let driving = result.unwrap(task.spawn(tasks, bytes 33554432u64, take seed, secret_client))
    result.unwrap(runner.place_head(take db, code.describe(place), N_PLACE, code.describe(migrate), code.describe(handles), take inbox, take mail, tasks, 1048576u64))
    clean(result.unwrap(task.join(take driving)))
    task.cancel(mut policy_handle)
    let _ = task.join(take policy_handle)
    let mut o = options()
    o.create = false
    let mut again = result.unwrap(store.open(tasks, d, c, r, o))
    let h = result.unwrap(store.with_schema(again, code.describe(handles)))
    let total = result.unwrap(store.get(store.snapshot(again), store.shape(h.t), 0u64))
    want(total == Some(2u64), "L31: two effects must be durable")
    let ticket = result.unwrap(store.checkpoint(mut again))
    result.unwrap(store.durable(mut again, ticket))
    result.unwrap(store.close(take again))
    Ok(())
}

fn ack(out: Stdout, v: u64) waits {
    let mut line = result.unwrap(string.with_capacity(32u64))
    result.unwrap(string.push(mut line, "ACK "))
    result.unwrap(string.push_u64(mut line, v))
    result.unwrap(stdout.write(out, line))
}

// The client: each session's answers, each checked against its expected Outcome by
// (stream, p). A frame that reports a commit raises the floor it reports. Refused(HistoryUnavailable)
// is a valid answer only to a position with a later one on its stream: the later one is
// admitted only once this one is replied. The client never fails: a failed task would
// leave its sessions open and the head waiting, so it hangs up every session, drains
// each channel to its close, and returns its verdict (empty when every call was answered
// as expected) for the caller to fail on.
//
// `armed` is the poison run. It arms the named sync failure once both sessions are up, then
// sends each call only after the previous one is answered, so a call's commits are the only
// frames the head has handed the journal when it gates them (see main's poison note).
type Client { connections: List[wire_client.Conn], calls: List[Pos], out: Stdout, armed: bool }

type Tally { floor: u64, answered: u64, bad: String }

fn later(calls: List[Pos], x: Pos) -> bool {
    for y in calls {
        if y.stream == x.stream && y.p > x.p {
            return true
        }
    }
    false
}

fn send_call(cn: wire_client.Conn, x: Pos) waits {
    let stream: u32 = int.narrow(x.stream)
    let slot: u32 = int.narrow(x.body)
    let request: runner.Frame = Call(stream, x.p, slot, 4294967295u32, u64_bytes(x.k))
    wire_client.send_frame(cn, take request)
}

// One Batch from session i, each of its answers checked and counted; the number of
// answers, or None once the session ends or sends another frame.
fn heard(cn: wire_client.Conn, i: u64, calls: List[Pos], out: Stdout, mut t: Tally) -> Option[u64] waits {
    let b = match wire_client.next(cn) {
        Ok(Batch(version, take complete, take rows, take done)) => runner.KeyedBatch(version: version, complete: take complete, rows: take rows, outcomes: keyed(take done)),
        Ok(_) => {
            t.bad = "runner_crash: a frame other than a Batch"
            return None
        },
        Error(_) => return None,
    }
    let v = b.version
    let mut n = 0u64
    for f in b.outcomes {
        n += 1u64
        t.answered += 1u64
        let mut matched = false
        for x in calls {
            if x.from == i && u64_bytes(x.stream) == f.stream && x.p == f.p {
                let below = match f.outcome {
                    Refused(r) => match r { HistoryUnavailable => later(calls, x), _ => false },
                    _ => false,
                }
                if below || same(f.outcome, expected(x)) {
                    matched = true
                }
            }
        }
        if !matched {
            t.bad = "runner_crash: an answer is not its call's expected Outcome"
        }
        let reports = match f.outcome {
            Returned(_) => true,
            Failed(_) => true,
            _ => false,
        }
        if reports && v > t.floor {
            t.floor = v
            ack(out, t.floor)
        }
    }
    Some(n)
}

fn client(take c: Client) -> String waits {
    let Client(connections: take connections, calls: take calls, out: out, armed: armed) = take c
    let mut t = Tally(floor: 0u64, answered: 0u64, bad: "")
    if armed {
        result.unwrap(stdout.write(out, "ARM"))
        for x in calls {
            send_call(connections[x.from], x)
            let mut owed = 1u64
            let mut ended = false
            while owed > 0u64 && t.bad == "" {
                match heard(connections[x.from], x.from, calls, out, mut t) {
                    Some(n) => { owed -= n },
                    None => {
                        ended = true
                        break
                    },
                }
            }
            if ended || t.bad != "" { break }
        }
    } else {
        for x in calls { send_call(connections[x.from], x) }
        for i in 0u64 .. list.len(connections) {
            let mut owed = 0u64
            for x in calls {
                if x.from == i {
                    owed += 1u64
                }
            }
            while owed > 0u64 && t.bad == "" {
                match heard(connections[i], i, calls, out, mut t) {
                    Some(n) => { owed -= n },
                    None => break,
                }
            }
        }
    }
    for cn in connections { let _ = channel.send(cn.to, Close) }
    for cn in connections {
        loop {
            match wire_client.next(cn) {
                Ok(_) => if t.bad == "" { t.bad = "runner_crash: an answer after the last" },
                Error(_) => break,
            }
        }
    }
    for take cn in connections { let _ = wire_client.close(take cn) }
    if t.bad == "" && t.answered != list.len(calls) {
        t.bad = "unanswered"
    }
    let Tally(floor: _, answered: _, bad: take bad) = take t
    bad
}

fn keyed(take done: List[runner.Done]) -> List[runner.KeyedDone] {
    let mut out: List[runner.KeyedDone] = list.new()
    for take d in done {
        let runner.Done(stream: stream, p: p, outcome: take outcome) = take d
        result.unwrap(list.push(mut out, runner.KeyedDone(stream: u64_bytes(int.widen(stream)), p: p, outcome: take outcome)))
    }
    out
}

type Accept: send { listener: Listener, tasks: Tasks, clock: Clock, policy: ingress.Ingress, head: Sender[runner.Req], post: Sender[runner.PubIn], authority: store.AuthorityReader, sessions: u64 }

fn accept(take seed: Accept) -> () waits {
    let Accept(listener: take listener, tasks: tasks, clock: c, policy: take policy, head: take head, post: take post, authority: take authority, sessions: sessions) = take seed
    let mut l = take listener
    let mut config = runner.wire_defaults(65536u64, N_PLACE)
    // The replay sends up to three calls per owner. Reserve those outcomes
    // within the fixture's 32 KiB frame limit.
    config.q = 2u64
    config.socket.max_frame = 32768u64
    let pool = result.unwrap(std.wsock.pending(config.socket))
    let mut owners: List[Task[Result[(), std.wsock.Error]]] = list.new()
    for _ in 0u64 .. sessions {
        let (socket, peer) = result.unwrap(host.accept(mut l, Never))
        let lease = option.unwrap(result.unwrap(std.wsock.acquire(pool)))
        let up = result.unwrap(std.wsock.server(take socket, take lease, peer.ip, list.new(), config.socket, c, host.mono_ns(c)))
        let service = runner.wire_place_target(code.describe(place), policy, head, authority, c, tasks, config, "crash fixture")
        let owner = result.unwrap(runner.serve_connection(tasks, take up, take service, post, config, c))
        result.unwrap(list.push(mut owners, take owner))
    }
    for take owner in owners { let _ = task.join(take owner) }
}

fn served(take db: store.Db, c: Clock, r: Random, tasks: Tasks, n: Net, out: Stdout, sessions: u64) -> Result[(), runner.OpenError] waits {
    let (listener, address) = result.unwrap(host.listen(n, Addr(ip: V4(0x7f000001u32), port: 0u16), 16u16))
    let mut port = result.unwrap(string.from("PORT "))
    result.unwrap(string.push_u64(mut port, int.widen(address.port)))
    result.unwrap(stdout.write(out, port))
    let (head, inbox): (Sender[runner.Req], Receiver[runner.Req]) = result.unwrap(channel.new(64u64))
    let mail = result.unwrap(runner.mailbox(4u64))
    let (policy, take policy_handle) = result.unwrap(ingress.start(tasks, c, r, ingress.defaults(), 1048576u64))
    let mut policy_task = take policy_handle
    let seed = Accept(listener: take listener, tasks: tasks, clock: c, policy: ingress.share(policy), head: take head, post: runner.post(mail), authority: store.authority_reader(db), sessions: sessions)
    let mut driving = result.unwrap(task.spawn(tasks, bytes 33554432u64, take seed, accept))
    let opened = runner.place_head(take db, code.describe(place), N_PLACE, code.describe(migrate), code.describe(handles), take inbox, take mail, tasks, 1048576u64)
    if let Error(_) = opened { task.cancel(mut driving) }
    let _ = task.join(take driving)
    task.cancel(mut policy_task)
    let _ = task.join(take policy_task)
    take opened
}

fn nibble(x: u8) -> u8 { if x <= b'9' { x - b'0' } else { x - b'a' + 10u8 } }
fn decode_fixture_token(text: View[String]) -> Option[Bytes] {
    if text == "-" { return None }
    let raw = string.as_bytes(text)
    want(list.len(raw) == 42u64, "runner_crash: invalid saved principal")
    let mut out: Bytes = list.new()
    for i in 0u64 .. 21u64 { result.unwrap(list.push(mut out, nibble(raw[i * 2u64]) * 16u8 + nibble(raw[i * 2u64 + 1u64]))) }
    Some(take out)
}

fn remember(out: Stdout, principal: Bytes) waits {
    let mut digits: Inline[u8, 64] = [0; 64]
    let mut b: Bytes = list.new()
    result.unwrap(list.append(mut b, string.as_bytes("TOKEN ")))
    for byte in principal {
        digits[62] = b'0'
        let value: u64 = int.widen(byte)
        let _ = int.radix_digits(value, 16, mut digits)
        result.unwrap(list.push(mut b, digits[62]))
        result.unwrap(list.push(mut b, digits[63]))
    }
    result.unwrap(stdout.write(out, result.unwrap(string.from_utf8(take b))))
}

fn drive(c: Clock, r: Random, tasks: Tasks, n: Net, out: Stdout, port: u16, sessions: u64, take calls: List[Pos], take principal: Option[Bytes], armed: bool) -> String waits {
    let mut connections: List[wire_client.Conn] = list.new()
    let mut resume = take principal
    for _ in 0u64 .. sessions {
        let mut keys: List[Bytes] = list.new()
        for body in 0u64 .. 3u64 { result.unwrap(list.push(mut keys, body_key(body))) }
        let cn = result.unwrap(wire_client.connect(tasks, n, Addr(ip: V4(0x7f000001u32), port: port), c, r, keys, take resume, std.wsock.defaults()))
        remember(out, cn.token)
        resume = Some(result.unwrap(clone(cn.token)))
        result.unwrap(list.push(mut connections, take cn))
    }
    client(Client(connections: take connections, calls: take calls, out: out, armed: armed))
}

fn arg_u64(text: View[String]) -> u64 {
    let mut n = 0u64
    for digit in string.as_bytes(text) {
        n = n * 10u64 + int.widen(digit - b'0')
    }
    n
}

fn count(d: Dir, c: Clock, r: Random, tasks: Tasks) -> (u64, u64) waits {
    let mut o = options()
    o.create = false
    let mut db = result.unwrap(store.open(tasks, d, c, r, o))
    let h = result.unwrap(store.with_schema(db, code.describe(handles)))
    let v = store.version(store.snapshot(db))
    let n = match result.unwrap(store.get(store.snapshot(db), store.shape(h.t), 0u64)) {
        Some(n) => n,
        None => 0u64,
    }
    result.unwrap(store.close(take db))
    (v, n)
}

type DeadlinePlace: send {
    config: runner.PlaceConfig[(), Hd], stop: Receiver[()], status: Latest[runner.Status], watch: Sender[Receiver[runner.Phase]],
}

fn deadline_place(take fixture: DeadlinePlace) -> Result[runner.Ended, runner.StartError] waits {
    let DeadlinePlace(config: take config, stop: take stop, status: take status, watch: take watch) = take fixture
    runner.operate(take config, take stop, status, Some(take watch))
}

fn status_address(status: runner.Status) -> Addr { option.unwrap(status.addr) }

fn activation_pairs(d: Dir, c: Clock, r: Random, tasks: Tasks, n: Net, out: Stdout, phase: String, uncut: bool, genesis: bool) -> () waits {
    let codec: std.codec.Codec[Bytes] = std.codec.of_list()
    let mut old_previous: Bytes = list.new()
    let mut old_current: Bytes = list.new()
    result.unwrap(list.append(mut old_previous, string.as_bytes("previous release")))
    result.unwrap(list.append(mut old_current, string.as_bytes("current release")))
    if phase == "init" {
        let mut db = result.unwrap(store.open(tasks, d, c, r, options()))
        if genesis { result.unwrap(store.close(take db)); return }
        let value: std.codec.Codec[u64] = std.codec.of()
        let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), value)))
        let _ = result.unwrap(store.create_table(mut db, store.spec("hirsel.runner.activation", std.codec.key_u8(), codec)))
        let release_codec: std.codec.Codec[runner.ReleaseRecord] = std.codec.of()
        let _ = result.unwrap(store.create_table(mut db, store.spec("hirsel.runner.releases", std.codec.key_u64(), release_codec)))
        let table = result.unwrap(store.table(mut db, "hirsel.runner.activation", std.codec.key_u8(), codec))
        let written = result.unwrap(store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
            store.put(mut tx, table, 0u8, old_current)?
            store.put(mut tx, table, 1u8, old_previous)
        }))
        if let Committed(done) = written { result.unwrap(store.durable(mut db, done.ticket)) } else { fail("activation: failed to seed both rows") }
        result.unwrap(store.close(take db))
        return
    }
    let mut existing = options()
    existing.create = false
    let base = if genesis { 0u64 } else { 4u64 }
    let mut chosen: runner.Selection = if genesis { Current(0u64) } else { Install }
    let expected_version = base + 1u64
    if phase == "read" {
        let mut db = result.unwrap(store.open(tasks, d, c, r, existing))
        let snap = store.snapshot(db)
        let version = store.version(snap)
        let activated = version == base + 1u64
        want((activated && store.fence_level(db) == 1) ||
            (!activated && !uncut && version == base && store.fence_level(db) == 0), "activation and fence disagree")
        if activated || !genesis {
            let table = result.unwrap(store.system_table(db, "hirsel.runner.activation", std.codec.key_u8(), codec))
            let current = option.unwrap(result.unwrap(store.get(snap, store.shape(table), 0u8)))
            let previous = result.unwrap(store.get(snap, store.shape(table), 1u8))
            let releases: store.Table[u64, runner.ReleaseRecord] = result.unwrap(store.system_table(db, "hirsel.runner.releases", std.codec.key_u64(), std.codec.of()))
            let history = result.unwrap(store.get(snap, store.shape(releases), base + 1u64))
            if activated {
                if genesis {
                    if let Some(_) = previous { fail("genesis: unexpected previous release") }
                } else {
                    want(option.unwrap(take previous) == old_current, "activation: current changed but previous did not")
                }
                let describe: std.codec.Codec[runner.Describe] = std.codec.of()
                let decoded = result.unwrap(result.unwrap(std.codec.decode(describe, current)))
                want(list.len(decoded.exported) == 3u64 && decoded.exported[0u64].described.identity == code.identity(code.describe(bump)) &&
                     decoded.exported[1u64].described.identity == code.identity(code.describe(deny)) &&
                     decoded.exported[2u64].described.identity == code.identity(code.describe(trip)), "activation: incorrect new release")
                let row = option.unwrap(take history)
                want(row.release == result.unwrap(runner.release_digest(decoded.exported)) &&
                    row.digest == decoded.digest, "activation: new release history differs from current")
                let _ = result.unwrap(store.checkpoint(mut db))
                chosen = Current(version)
            } else {
                want(current == old_current && option.unwrap(take previous) == old_previous, "activation: legacy rows changed")
                if let Some(_) = history { fail("activation: history committed without current") }
                chosen = Current(0u64)
            }
        } else {
            match store.with_schema(db, code.describe(handles)) {
                Error(Missing(_)) => (),
                _ => fail("activation: genesis catalog committed without activation")
            }
        }
        result.unwrap(store.close(take db))
        if !activated && !genesis {
            refused_open(d, c, r, tasks, Current(0u64), N_PLACE, base, true)
            return
        }
        if activated {
            refused_open(d, c, r, tasks, Current(base), N_PLACE, base + 1u64, false)
            refused_open(d, c, r, tasks, Current(base + 1u64), N_PLACE + 1u64, base + 1u64, false)
        }
    }
    let (policy, policy_handle) = result.unwrap(ingress.start(tasks, c, r, ingress.defaults(), 1048576u64))
    let (stop, stopping): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let (watch, watcher): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = result.unwrap(channel.new(1u64))
    let mut wire = runner.wire_defaults(131072u64, N_PLACE)
    wire.n_pool = 4194304u64
    let settings = runner.PlaceConfig(backing: Disk(d, existing), selection: chosen, place: code.describe(place), n_place: N_PLACE, migrate: code.describe(migrate), handles: code.describe(handles),
        session: wire, max_sessions: 1u64, proxies: list.new(), policy: take policy, n_publisher: 1048576u64,
        listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: n, tasks: tasks, clock: c, random: r,
        stop: runner.Stop(lag_ms: 0u64, grace_ms: 1000u64))
    let seed = DeadlinePlace(config: take settings, stop: take stopping, status: result.unwrap(runner.status_root()), watch: take watch)
    let running = result.unwrap(task.spawn(tasks, bytes 50331648u64, take seed, deadline_place))
    let phases = result.unwrap(channel.receive(watcher))
    loop {
        match channel.receive(phases) { Ok(Ready) => break, Ok(Starting(_)) => (), _ => fail("activation: no Ready") }
    }
    if phase == "write" { result.unwrap(stdout.write(out, "DONE")) }
    result.unwrap(channel.send(stop, ()))
    if let Ok(Ok(Stopped)) = task.join(take running) {} else { fail("activation: empty place did not stop") }
    let mut stopping_policy = take policy_handle
    task.cancel(mut stopping_policy)
    let _ = task.join(take stopping_policy)
    if phase == "read" {
        let db = result.unwrap(store.open(tasks, d, c, r, existing))
        want(store.version(store.snapshot(db)) == expected_version, "activation: wrong write count on restart")
        want(store.fence_level(db) == 1, "activation: a later cut lost the fence")
        result.unwrap(store.close(take db))
    }
}

fn unreachable_handles(_catalog: store.Schema) -> Result[Hd, store.Error] {
    fail("a refused opener called handles")
}

fn refused_open(d: Dir, c: Clock, r: Random, tasks: Tasks, selected: runner.Selection, allowance: u64, v: u64, legacy: bool) -> () waits {
    let db = result.unwrap(store.open(tasks, d, c, r, options()))
    let (_sender, from): (Sender[runner.Req], Receiver[runner.Req]) = result.unwrap(channel.new(1u64))
    let mail = result.unwrap(runner.mailbox(1u64))
    let tried = runner.place_head_selected(take db, selected, code.describe(place), allowance, code.describe(migrate),
        code.describe(unreachable_handles), DirectRequests(take from), take mail, tasks, 1048576u64)
    match take tried {
        Error(NotCurrent(Legacy)) => want(legacy, "activation: fenced store reported legacy"),
        Error(NotCurrent(Active(found, _))) => want(!legacy && found == v, "activation: wrong active version"),
        _ => fail("activation: unexpected selection result")
    }
    let reopened = result.unwrap(store.open(tasks, d, c, r, options()))
    want(store.version(store.snapshot(reopened)) == v, "activation: refusal advanced the head")
    result.unwrap(store.close(take reopened))
}

fn unavailable_identity(d: Dir, c: Clock, r: Random, tasks: Tasks, grow: bool, phase: String, out: Stdout) -> () waits {
    if phase == "init" {
        let db = result.unwrap(store.open(tasks, d, c, r, options()))
        result.unwrap(store.close(take db))
        return
    }
    let db = result.unwrap(store.open(tasks, d, c, r, options()))
    if phase == "write" {
        let chosen: runner.Selection = if grow { Install } else { Current(0u64) }
        let (_sender, inbox): (Sender[runner.Req], Receiver[runner.Req]) = result.unwrap(channel.new(1u64))
        let attempted = runner.place_head_selected(take db, chosen, code.describe(place), N_PLACE, code.describe(migrate),
            code.describe(unreachable_handles), DirectRequests(take inbox), result.unwrap(runner.mailbox(1u64)), tasks, 1048576u64)
        match take attempted {
            Error(IdentityUnknown) => result.unwrap(stdout.write(out, "DONE")),
            _ => fail("disk install accepted an unavailable identity"),
        }
    } else {
        want(store.version(store.snapshot(db)) == 0u64 && store.fence_level(db) == 0, "identity refusal committed the install")
        result.unwrap(store.close(take db))
    }
}

fn freeze_until_stop(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout, n: Net) -> () waits {
    let (policy, policy_handle) = result.unwrap(ingress.start(tasks, c, r, ingress.defaults(), 1048576u64))
    let (stop, stopping): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let (watch, watcher): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = result.unwrap(channel.new(1u64))
    let status = result.unwrap(runner.status_root())
    let mut wire = runner.wire_defaults(131072u64, N_PLACE)
    wire.n_pool = 4194304u64
    wire.socket.max_frame = 65536u64
    let config = runner.PlaceConfig(backing: Disk(d, options()), selection: Current(0u64), place: code.describe(place), n_place: N_PLACE, migrate: code.describe(migrate), handles: code.describe(handles),
        session: wire, max_sessions: 1u64, proxies: list.new(), policy: take policy, n_publisher: 1048576u64,
        listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: n, tasks: tasks, clock: c, random: r,
        stop: runner.Stop(lag_ms: 10000u64, grace_ms: 100u64))
    let seed = DeadlinePlace(config: take config, stop: take stopping, status: latest.handle(status), watch: take watch)
    let running = result.unwrap(task.spawn(tasks, bytes 50331648u64, take seed, deadline_place))
    let phases = result.unwrap(channel.receive(watcher))
    loop {
        match channel.receive(phases) { Ok(Ready) => break, Ok(Starting(_)) => (), _ => fail("runner-deadline: no Ready") }
    }
    let mut keys: List[Bytes] = list.new()
    result.unwrap(list.push(mut keys, body_key(0u64)))
    let connection = result.unwrap(wire_client.connect(tasks, n, status_address(latest.read(status)), c, r, keys, None, wire.socket))
    remember(out, connection.token)
    result.unwrap(stdout.write(out, "FREEZE"))
    wire_client.send_frame(connection, Call(0u32, 0u64, 0u32, 10000u32, u64_bytes(9u64)))
    let watchdog = host.mono_ns(c) + 5000000000u64
    while let Error(_) = stdout.write(out, "FROZEN?") {
        let now = host.mono_ns(c)
        if now >= watchdog { fail("runner-deadline: no journal sync to freeze") }
        host.sleep_until(c, now + 1000000u64)
    }
    result.unwrap(channel.send(stop, ()))
    match task.join(take running) {
        Ok(Ok(Forced(1u64))) => (),
        _ => fail("runner-deadline: expected exactly one logically abandoned send"),
    }
    let mut abandoned = 0u64
    while let Ok(take frame) = wire_client.next(connection) {
        match frame {
            Batch(_, _, _, done) => for outcome in done {
                if let Abandoned = outcome.outcome { abandoned += 1u64 } else { fail("runner-deadline: answered a send past the cut") }
            },
            _ => fail("runner-deadline: unexpected wire frame"),
        }
    }
    want(abandoned <= 1u64, "runner-deadline: duplicate Abandoned")
    let _ = wire_client.close(take connection)
    let mut policy_task = take policy_handle
    task.cancel(mut policy_task)
    let _ = task.join(take policy_task)
    result.unwrap(stdout.write(out, "DONE"))
}

fn deadline_reopen(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args) -> () waits {
    let mut existing = options()
    existing.create = false
    let mut db = result.unwrap(store.open(tasks, d, c, r, existing))
    let data = result.unwrap(store.with_schema(db, code.describe(handles)))
    let named = option.unwrap(decode_fixture_token(option.unwrap(args.get(argv, 4u64))))
    let stream = wire_client.stream(named, 0u32)
    want(match result.unwrap(store.get(store.snapshot(db), store.shape(data.t), 0u64)) { None => true, _ => false }, "runner-deadline: frozen effect reached disk")
    let digest = store.request_digest(body_key(0u64), u64_bytes(9u64))
    match result.unwrap(store.admit(mut db, stream, 0u64, digest)) {
        Admitted(_) => (),
        Abandoned(_) => (),
        _ => fail("runner-deadline: frozen position is not retryable without a prior reply"),
    }
    result.unwrap(store.close(take db))
}

pub fn main(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, out: Stdout, n: Net) -> Result[(), Exit] waits {
    let phase = option.unwrap(args.get(argv, 0u64))
    let scenario = option.unwrap(args.get(argv, 1u64))
    if scenario == "runner-activation" || scenario == "runner-activation-genesis" {
        activation_pairs(d, c, r, tasks, n, out, result.unwrap(string.from(phase)), option.unwrap(args.get(argv, 2u64)) == "new", scenario == "runner-activation-genesis")
        return Ok(())
    }
    if scenario == "runner-unavailable-genesis" || scenario == "runner-unavailable-install" {
        unavailable_identity(d, c, r, tasks, scenario == "runner-unavailable-install", phase, out)
        return Ok(())
    }
    if scenario == "runner-deadline" {
        if phase == "init" {
            let mut db = result.unwrap(store.open(tasks, d, c, r, options()))
            let value: std.codec.Codec[u64] = std.codec.of()
            let created = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), value)))
            result.unwrap(store.durable(mut db, created))
            result.unwrap(store.close(take db))
        } else if phase == "write" { freeze_until_stop(d, c, r, tasks, out, n) } else { deadline_reopen(d, c, r, tasks, argv) }
        return Ok(())
    }
    if phase == "client" {
        let mode = option.unwrap(args.get(argv, 2u64))
        let port: u16 = int.narrow(arg_u64(option.unwrap(args.get(argv, 3u64))))
        let principal = decode_fixture_token(option.unwrap(args.get(argv, 4u64)))
        if mode == "init" {
            clean(drive(c, r, tasks, n, out, port, 1u64, list.new(), take principal, false))
        } else if mode == "write" {
            let verdict = drive(c, r, tasks, n, out, port, 2u64, positions(scenario), take principal, scenario == "poison-segment")
            if verdict != "unanswered" { clean(take verdict) }
            else if scenario != "poison-segment" { return Ok(()) }
        } else {
            let (again, _) = resends(scenario)
            clean(drive(c, r, tasks, n, out, port, 1u64, take again, take principal, false))
        }
        result.unwrap(stdout.write(out, "DONE"))
        return Ok(())
    }
    if phase == "init" {
        let mut db = result.unwrap(store.open(tasks, d, c, r, options()))
        let cv: std.codec.Codec[u64] = std.codec.of()
        result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
        let opened = served(take db, c, r, tasks, n, out, 1u64)
        want(match opened { Ok(()) => true, Error(_) => false }, "runner_crash: the first head failed")
        return Ok(())
    }
    if phase == "write" {
        // Poison: one frame per journal group, so the adapter's second armed segment sync
        // carries exactly the call's effect frame. The admit frame's sync succeeds, and
        // the effect frame's failure reaches the head only through the gate's durable:
        // between that frame's hand-off and the gate the head makes no store call, and
        // the client sends nothing more until it is answered. An answer before durable,
        // or one sent despite the poison, then always reaches the client (L1).
        let mut o = options()
        if scenario == "poison-segment" { o.group_commits = 1u32 }
        let db = match store.open(tasks, d, c, r, o) { Ok(take x) => take x, Error(_) => return Ok(()) }
        let opened = served(take db, c, r, tasks, n, out, 2u64)
        match opened {
            Ok(()) => want(scenario != "poison-segment", "runner_crash: a failed journal sync did not stop the head"),
            Error(_) => (),
        }
        return Ok(())
    }
    let done = option.unwrap(args.get(argv, 2u64)) == "new"
    let floor = arg_u64(option.unwrap(args.get(argv, 3u64)))
    let (before, _) = count(d, c, r, tasks)
    want(before >= floor, "runner_crash: a client saw a commit the store lost (L1)")
    let mut o = options()
    o.create = false
    let db = result.unwrap(store.open(tasks, d, c, r, o))
    let opened = served(take db, c, r, tasks, n, out, 1u64)
    want(match opened { Ok(()) => true, Error(_) => false }, "runner_crash: the re-send head failed")
    let (_, total) = resends(scenario)
    let (after, value) = count(d, c, r, tasks)
    want(value == total, "runner_crash: an effect ran other than once (C1)")
    if done && scenario != "poison-segment" {
        want(after == before, "runner_crash: a re-send after a complete run committed")
    }
    Ok(())
}

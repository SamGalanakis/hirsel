type TypedReader: send {
    read_handle: Reader,
    held: Snapshot,
    sh: Table[u64, u64]
}

@test
fn test_typed_snapshot_task(c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    for k in 0u64 .. 24 {
        if !typed_put(mut db, t, k, k + 1) {
            return Error(())
        }
    }
    let payload = TypedReader(read_handle: result.unwrap(reader(db, 0)), held: snapshot(db), sh: clone(t))
    let read_source = task.spawn(tasks, bytes 1048576, take payload, fn(take p: TypedReader) -> bool waits {
        let mut rows = result.unwrap(scan(p.read_handle, p.held, p.sh, Unbounded, Unbounded))
        for k in 0u64 .. 24 {
            if typed_value(p.held, p.sh, k) != k + 1 {
                return false
            }
            let viewed = result.unwrap(look(p.read_handle, p.held, None, (copy_env(p.sh), k), fn(tx, call_env) -> Result[bool, Error] {
                match fetch_bytes(tx, call_env.0, call_env.1)? {
                    Some(raw) => Ok(raw == schema_zero_bytes(call_env.1 + 1)),
                    None => Ok(false),
                }
            }))
            if let Seen(Seen(value: Ok(true), ..)) = viewed {} else {
                return false
            }
            match result.unwrap(next(p.read_handle, mut rows)) {
                Some((key, value)) => if key != k || value != k + 1 {
                    return false
                },
                None => return false
            }
        }
        result.unwrap(next(p.read_handle, mut rows)) == None
    })
    for k in 0u64 .. 1000 {
        if !typed_put(mut db, t, k % 24, k + 10000) {
            return Error(())
        }
    }
    if result.unwrap(task.join(take read_source)) {
        Ok(())
    } else {
        Error(())
    }
}

// A follower owns the last snapshot after the writer is consumed.
pub fn law_close_follow(c: Clock) -> bool waits {
    let mut db = raw_test_db(c, 1073741824)
    let h = result.unwrap(follow(mut db, Branch(store: StoreId(hi: 1, lo: 2), id: 0)))
    if !put_one(mut db, 1, 10) {
        return false
    }
    if !put_one(mut db, 2, 20) {
        return false
    }
    result.unwrap(close(take db))
    let root = latest.read(h)
    version(root) == 2 && value_at(root, 1) == 10 && value_at(root, 2) == 20
}


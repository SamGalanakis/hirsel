pub type KeyedEdit: shareable + send {
    tree: u8,
    key: Bytes,
    value: Option[Bytes],
    call: Option[KeyedCallSection]
}

pub type KeyedCallSection: shareable + send {
    record: KeyedCallRecordRep,
    settlement: Option[Settlement]
}

pub type KeyedCredit {
    resident: u64,
    padding: u64,
    journal: u64
}

pub type KeyedDraft {
    edits: List[KeyedEdit],
    after: KeyedCredit
}

pub fn no_keyed_credit() -> KeyedCredit {
    KeyedCredit(resident: 0, padding: 0, journal: 0)
}

pub fn keyed_frame_bytes(edits: List[KeyedEdit]) -> u64 {
    if list.len(edits) == 0 {
        return 0
    }
    let mut size = 5u64
    for edit in edits {
        size += 6 + list.len(edit.key)
        if let Some(raw) = edit.value {
            size += 4 + list.len(raw)
        }
        if let Some(call) = edit.call {
            size += keyed_record_size(call.record.entry, call.record.args, call.record.revision, call.record.code, call.settlement)
        }
    }
    size
}

pub fn encode_keyed_edits(mut raw: Bytes, edits: List[KeyedEdit]) -> Result[(), Capacity] {
    list.push(mut raw, 3u8)
    le(mut raw, list.len(edits), 4)?
    for edit in edits {
        list.push(mut raw, edit.tree)
        match edit.value {
            Some(value) => {
                if let Some(call) = edit.call {
                    list.push(mut raw, 3u8)
                    blob(mut raw, value)?
                    // In Format 15 the claim key opens the keyed CALL. It
                    // also identifies the claims row receiving this reply.
                    blob(mut raw, edit.key)?
                    encode_call_fields(mut raw, call.record.entry, call.record.args, call.record.revision, call.record.code, call.settlement)?
                } else {
                    list.push(mut raw, 1u8)
                    blob(mut raw, edit.key)?
                    blob(mut raw, value)?
                }
            },
            None => {
                list.push(mut raw, 2u8)
                blob(mut raw, edit.key)?
            },
        }
    }
    Ok(())
}

// rule: STORE-8
// A store holds at most 1024 named pins: pinning a 1025th name is
// InvalidInput() and records nothing, while moving a held name still pins.
pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

fn put_x(mut tx: store.Tx, info: store.CallInfo, n: u8) -> Result[(), store.TxError] {
  store.tx_put(mut tx, b"x", bytes.from_list([n]))
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  let done: Result[(), store.TxFailure[store.TxError]] = store.transact(mut s, put_x, 1)
  check(done == Ok(()))?
  let Some(level) = authority.level(a, "memory") else {
    return Error(Check())
  }
  let snap = store.snapshot(a, mut s, level) ? Store
  let v = store.version(a, snap)
  for i in 0u64..1024 {
    store.pin(a, mut s, u64.to_string(i), v) ? Store
  }
  check(store.pin(a, mut s, "1024", v) == Error(InvalidInput()))?
  store.pin(a, mut s, "0", v) ? Store
  check(store.unpin(mut s, "1024") == Ok(false))?
  check(store.unpin(mut s, "1023") == Ok(true))?
  store.pin(a, mut s, "1024", v) ? Store
  store.close(take s) ? Store
  Ok(())
}

// The reference evaluator charges the logical 16 bytes for a nine-byte
// literal, including FrozenBytes. Native engines may omit the static charge.
// A caught refusal keeps its 32-byte cause cell admitted.
// expect: run literal_refusal(false) = 1615 used 32
// expect: reference run literal_refusal(true) = 1615 used 32
// expect: run refusal_after_handover(false) = 800 used 32
// expect: reference run refusal_after_handover(true) = 800 used 32
// expect: run refund_after_handover(false) = 90
// expect: reference run refund_after_handover(true) = 90
// expect: run empty_is_free() = 0
// expect: reference run cloned_and_counted() = 18
// expect: run inline_capacity() = 311
// expect: size FrozenPair 48
// expect: size HeapPair 48
// expect: size FrozenOrShared 32
// expect: size HeapOrShared 32
type FrozenPair {
    first: FrozenBytes,
    second: FrozenBytes
}

type HeapPair {
    first: Bytes,
    second: Bytes
}

type FrozenOrShared = Frozen(FrozenBytes) | SharedFrozen(Arc[Bytes])

type HeapOrShared = Heap(Bytes) | SharedHeap(Arc[Bytes])

fn make(frozen: bool) -> FrozenBytes {
    if frozen {
        return b"abcdefghi"
    }
    let heap: Bytes = b"abcdefghi"
    bytebuf.freeze(take heap)
}

fn literal_refusal(frozen: bool) -> u64 {
    let outer = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 15 {
            let b = make(frozen)
            let one = b"x"
            list.len(bytebuf.as_bytes(b)) + list.len(one)
        }
    })
    match caught(take outer) {
        Some(c) => c.requested * 100 + c.available,
        None => 0,
    }
}

fn escape(frozen: bool) -> FrozenBytes {
    result.unwrap(bound bytes 16 {
        make(frozen)
    })
}

fn refusal_after_handover(frozen: bool) -> u64 {
    let outer = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 16 {
            let escaped = escape(frozen)
            let b = bytebuf.as_bytes(escaped)
            if list.capacity(b) == 9 && b[8] == b'i' {
                let x = b"x"
                5000 + list.len(x)
            } else {
                6000
            }
        }
    })
    match caught(take outer) {
        Some(c) => c.requested * 100 + c.available,
        None => 7000,
    }
}

fn refund_after_handover(frozen: bool) -> u64 {
    let got = bound bytes 16 {
        let before = {
            let escaped = escape(frozen)
            10 * list.len(bytebuf.as_bytes(escaped))
        }
        let again = b"123456789"
        before + list.len(again) - 9
    }
    match got {
        Ok(n) => n,
        Error(_) => 7000,
    }
}

fn empty_is_free() -> u64 {
    let got = bound bytes 0 {
        let b: FrozenBytes = b""
        list.len(bytebuf.as_bytes(b))
    }
    match got {
        Ok(n) => n,
        Error(_) => 8000
    }
}

// A nine-byte clone costs 16. The original and clone plus an Arc holding the
// original cost 16 + 16 + (8 + 24) = 64. The Arc's last release refunds the
// literal, and the clone drops independently. Another 64-byte buffer then fits.
fn cloned_and_counted() -> u64 {
    let got = bound bytes 64 {
        let length = {
            let original = make(true)
            let copied: FrozenBytes = clone(original)
            let held = arc.new(take original)
            list.len(bytebuf.as_bytes(held)) + list.len(bytebuf.as_bytes(copied))
        }
        let proof: Bytes = list.with_capacity(64)
        if list.capacity(proof) == 64 {
            length
        } else {
            9000
        }
    }
    match got {
        Ok(n) => n,
        Error(_) => 9001
    }
}

// At the logical bound every build returns the same bytes. The native
// codegen tests also exercise zero room to verify the elided allocation.
fn static_and_clone(room: u64) -> bool {
    let copied = bound bytes room {
        let original: FrozenBytes = b"abcdefghi"
        let snapshot: FrozenBytes = clone(original)
        snapshot
    }
    match take copied {
        Ok(take frozen) => {
            let b = bytebuf.as_bytes(frozen)
            list.len(b) == 9 && b[0] == b'a' && b[8] == b'i'
        },
        Error(_) => false,
    }
}

// expect: reference run static_and_clone(32) = true
// An exact capacity of three costs eight bytes. After 'a' there are two
// bytes left, so a three-byte append refuses at this operation and leaves
// the old prefix untouched. Slice [1,3) then fits and appends 'y', 'z'.
// The final 311 encodes length 3 and one point for each retained byte check.
fn inline_capacity() -> u64 {
    let r = bound bytes 8 {
        let mut out: Bytes = list.with_capacity(3)
        list.push(mut out, b'a')
        let src: Inline[u8, 3] =[b'x', b'y', b'z']
        if bytebuf.append_inline(mut out, src, 0, 3) || out != string.as_bytes("a") {
            8001u64
        } else if bytebuf.append_inline(mut out, src, 2, 4) || bytebuf.append_inline(mut out, src, 2, 1) || out != string.as_bytes("a") {
            8002u64
        } else if bytebuf.append_inline(mut out, src, 1, 3) {
            list.len(out) * 100 + if out[0] == b'a' {
                10
            } else {
                0
            } + if out[1] == b'y' && out[2] == b'z' {
                1
            } else {
                0
            }
        } else {
            8003u64
        }
    }
    match r {
        Ok(n) => n,
        Error(_) => 9000
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

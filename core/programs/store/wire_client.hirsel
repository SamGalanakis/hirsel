// Fixture client over the same wsock machines as the server. The HTTP challenge,
// response checks, read-ahead tail and fresh client masks belong to std.wsock.
pub type Command: send = Send(runner.Frame) | Control(u8, std.websocket.Control) | Close
pub type Conn {
    to: Sender[Command], from: Receiver[runner.Frame], credit: Sender[()], token: Bytes,
    reading: Task[()], writing: Task[()]
}

type Read: send { reader: std.wsock.Reader, to: Sender[runner.Frame], control: Sender[Command], credits: Receiver[()], clock: Clock }
type Write: send { writer: std.wsock.Writer, outgoing: std.wsock.Outbound, from: Receiver[Command], clock: Clock }

fn deadline(c: Clock) -> Until { At(c, int.saturating_add(host.mono_ns(c), 5000000000u64)) }

fn send(mut w: std.wsock.Writer, mut out: std.wsock.Outbound, opcode: u8, payload: Bytes, c: Clock) -> Result[(), std.wsock.Error] waits {
    let encoded = std.wsock.encode(mut out, true, opcode, payload)?
    if let Error(_) = std.wsock.stage(mut w, take encoded) { return Error(Protocol(1008u16)) }
    let until = deadline(c)
    while !std.wsock.drained(w) { let _ = std.wsock.flush(mut w, mut out, until)? }
    Ok(())
}

fn receive(mut r: std.wsock.Reader, mut w: std.wsock.Writer, mut out: std.wsock.Outbound, c: Clock) -> Result[runner.Frame, std.wsock.Error] waits {
    loop {
        match std.wsock.read(mut r, deadline(c))? {
            Message(take b) => {
                let codec: std.codec.Codec[runner.Frame] = std.codec.of()
                return match std.codec.decode(codec, b) { Ok(Ok(take f)) => Ok(take f), _ => Error(Protocol(1007u16)) }
            },
            Ping(control) => { let mut b: Bytes = list.new(); result.unwrap(std.websocket.control(control, mut b)); send(mut w, mut out, 10u8, b, c)? },
            Pong(_) => (),
            Need => (),
            _ => return Error(Protocol(1008u16)),
        }
    }
}

fn read(take seed: Read) -> () waits {
    let Read(reader: take input, to: take to, control: take control, credits: take credits, clock: c) = take seed
    let mut r = take input
    loop {
        if let Error(_) = channel.receive(credits) { return }
        let mut pending = true
        while pending {
        match std.wsock.read(mut r, deadline(c)) {
            Ok(Message(take b)) => {
                let codec: std.codec.Codec[runner.Frame] = std.codec.of()
                let f = match std.codec.decode(codec, b) { Ok(Ok(take f)) => take f, _ => return }
                if let Error(_) = channel.send(to, take f) { return }
                pending = false
            },
            Ok(Ping(p)) => { if let Error(_) = channel.send(control, Control(10u8, p)) { break } },
            Ok(Pong(_)) => (),
            Ok(Need) => (),
            Ok(Closed(p)) => { let _ = channel.send(control, Control(8u8, p)); return },
            _ => { let _ = channel.send(control, Close); return },
        }
        }
    }
}

fn write(take seed: Write) -> () waits {
    let Write(writer: take output, outgoing: take outgoing, from: take from, clock: c) = take seed
    let mut w = take output
    let mut out = take outgoing
    loop {
        let (opcode, take b) = match channel.receive(from) {
            Ok(Send(take f)) => {
                let codec: std.codec.Codec[runner.Frame] = std.codec.of()
                let mut b: Bytes = list.new()
                result.unwrap(std.codec.encode(codec, f, mut b))
                (2u8, take b)
            },
            Ok(Control(op, p)) => { let mut b: Bytes = list.new(); result.unwrap(std.websocket.control(p, mut b)); (op, take b) },
            _ => (8u8, list.new()),
        }
        if let Error(_) = send(mut w, mut out, opcode, b, c) { return }
        if opcode == 8u8 { return }
    }
}

pub fn wants(keys: List[Bytes]) -> List[runner.Want] {
    let mut ws: List[runner.Want] = list.new()
    for key in keys {
        let n = list.len(key)
        let mut id: Bytes = list.new()
        for i in 0u64 .. n - 16u64 { result.unwrap(list.push(mut id, key[i])) }
        let mut at = n - 16u64
        let af = result.unwrap(std.codec.take_u64(key, mut at))
        let rf = result.unwrap(std.codec.take_u64(key, mut at))
        result.unwrap(list.push(mut ws, runner.Want(identity: take id, args_fp: af, result_fp: rf)))
    }
    ws
}

pub fn connect(tasks: Tasks, n: Net, address: Addr, c: Clock, random: Random, keys: List[Bytes], take token: Option[Bytes], config: std.wsock.Config) -> Result[Conn, std.wsock.Error] waits {
    let socket = match host.connect(n, address, deadline(c)) { Ok(take s) => take s, Error(e) => return Error(Network(e)) }
    let mut host_name: Bytes = list.new()
    result.unwrap(list.append(mut host_name, string.as_bytes("127.0.0.1")))
    let std.wsock.Connected(reader: take input, writer: take output, outgoing: take outgoing, timers: _) = std.wsock.client(take socket, host_name, config, c, random)?
    let mut r = take input
    let mut w = take output
    let mut out = take outgoing
    let codec: std.codec.Codec[runner.Frame] = std.codec.of()
    let hello: runner.Frame = Hello(take token, wants(keys))
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.encode(codec, hello, mut b))
    send(mut w, mut out, 2u8, b, c)?
    let principal = match receive(mut r, mut w, mut out, c)? { Welcome(take p, _, _, _, _, _) => take p, _ => return Error(Protocol(1008u16)) }
    for _ in keys { match receive(mut r, mut w, mut out, c)? { Placed(_) => (), _ => return Error(Protocol(1008u16)) } }
    let (to, commands): (Sender[Command], Receiver[Command]) = result.unwrap(channel.new(64u64))
    let (frames, from): (Sender[runner.Frame], Receiver[runner.Frame]) = result.unwrap(channel.new(64u64))
    let (credit, credits): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let read_seed = Read(reader: take r, to: take frames, control: channel.sender(to), credits: take credits, clock: c)
    let reading = match task.spawn(tasks, bytes 1048576u64, take read_seed, read) {
        Ok(take h) => take h, Error((cap, _)) => return Error(Allocation(cap)),
    }
    let write_seed = Write(writer: take w, outgoing: take out, from: take commands, clock: c)
    let writing = match task.spawn(tasks, bytes 1048576u64, take write_seed, write) {
        Ok(take h) => take h, Error((cap, _)) => return Error(Allocation(cap)),
    }
    Ok(Conn(to: take to, from: take from, credit: take credit, token: take principal, reading: take reading, writing: take writing))
}

pub fn send_frame(c: Conn, take f: runner.Frame) -> () waits {
    if let Error(_) = channel.send(c.to, Send(take f)) { fail("wire client: writer closed") }
}

pub fn close(take cn: Conn) -> bool waits {
    let _ = channel.send(cn.to, Close)
    let Conn(to: _, from: _, credit: _, token: _, reading: take reader_task, writing: take writing) = take cn
    let mut reading = take reader_task
    let wrote = task.join(take writing)
    task.cancel(mut reading)
    let heard = task.join(take reading)
    match (wrote, heard) { (Ok(()), Ok(())) => true, (Ok(()), Error(_)) => true, _ => false }
}

// A one-connection fixture listener. Each connection has an ephemeral loopback
// port; all listeners in one fixture share the head, publisher and admission book.
type Server[G: send, H: send]: send {
    listener: Listener, tasks: Tasks, clock: Clock, policy: ingress.Ingress,
    head: Sender[runner.Req], post: Sender[runner.PubIn], authority: store.AuthorityReader, config: runner.WireConfig,
    place: StaticFn[fn(mut runner.Registry[G, H]) -> Result[(), runner.RegisterError]]
}

fn server[G: send, H: send](take seed: Server[G, H]) -> Result[(), std.wsock.Error] waits {
    let Server(listener: take listener, tasks: tasks, clock: c, policy: take policy, head: take head, post: take post, authority: take authority, config: config, place: place) = take seed
    let mut l = take listener
    let (socket, peer) = match host.accept(mut l, deadline(c)) { Ok(take sockets) => take sockets, Error(e) => return Error(Network(e)) }
    let pending = std.wsock.pending(config.socket)?
    let lease = option.unwrap(std.wsock.acquire(pending)?)
    let up = std.wsock.server(take socket, take lease, peer.ip, list.new(), config.socket, c, host.mono_ns(c))?
    let service = runner.wire_place_target(place, policy, head, authority, c, tasks, config, "fixture")
    let h = match runner.serve_connection(tasks, take up, take service, post, config, c) { Ok(take h) => take h, Error(cap) => return Error(Allocation(cap)) }
    match task.join(take h) { Ok(take r) => take r, Error(_) => Error(Protocol(1008u16)) }
}

pub fn pair[G: send, H: send](tasks: Tasks, n: Net, c: Clock, random: Random,
    policy: ingress.Ingress, head: Sender[runner.Req], post: Sender[runner.PubIn], authority: store.AuthorityReader,
    place: StaticFn[fn(mut runner.Registry[G, H]) -> Result[(), runner.RegisterError]],
    keys: List[Bytes], take token: Option[Bytes], q: u64, n_session: u64)
    -> Result[(Conn, Task[Result[(), std.wsock.Error]]), std.wsock.Error] waits {
    let mut config = runner.wire_defaults(524288u64, 65536u64)
    config.q = q
    config.budget = 65536u64
    config.socket.max_frame = 32768u64
    pair_config(tasks, n, c, random, policy, head, post, authority, place, keys, take token, config, n_session)
}

// Cover retention needs one whole initial Batch of 1,954 rows. Its fixture
// selects the frame bound explicitly, using the same listener and owner.
pub fn pair_config[G: send, H: send](tasks: Tasks, n: Net, c: Clock, random: Random,
    policy: ingress.Ingress, head: Sender[runner.Req], post: Sender[runner.PubIn], authority: store.AuthorityReader,
    place: StaticFn[fn(mut runner.Registry[G, H]) -> Result[(), runner.RegisterError]],
    keys: List[Bytes], take token: Option[Bytes], config: runner.WireConfig, n_session: u64)
    -> Result[(Conn, Task[Result[(), std.wsock.Error]]), std.wsock.Error] waits {
    let (l, address) = match host.listen(n, Addr(ip: V4(0x7f000001u32), port: 0u16), 16u16) { Ok(take sockets) => take sockets, Error(e) => return Error(Network(e)) }
    let seed = Server(listener: take l, tasks: tasks, clock: c, policy: ingress.share(policy), head: channel.sender(head), post: channel.sender(post), authority: store.dup(authority), config: config, place: place)
    let run: fn(take Server[G, H]) -> Result[(), std.wsock.Error] waits = server
    let mut h = match task.spawn(tasks, bytes n_session, take seed, run) { Ok(take h) => take h, Error((cap, _)) => return Error(Allocation(cap)) }
    match connect(tasks, n, address, c, random, keys, take token, config.socket) {
        Ok(take cn) => Ok((take cn, take h)),
        Error(e) => { task.cancel(mut h); let _ = task.join(take h); Error(e) },
    }
}

pub fn slot(keys: List[Bytes], key: Bytes) -> u32 {
    for i in 0u64 .. list.len(keys) { if keys[i] == key { return int.narrow(i) } }
    4294967295u32
}

pub fn stream(token: Bytes, s: u32) -> Bytes {
    let caller = option.unwrap(result.unwrap(ingress.caller(token)))
    let mut b: Bytes = list.new()
    result.unwrap(runner.caller_key(caller, mut b))
    result.unwrap(std.codec.encode_key(std.codec.key_u32(), s, mut b))
    b
}

// Reads are demand-driven, so an intentionally unread client holds its bytes
// in the bounded transport rather than in a second fixture prefetch queue.
pub fn next(c: Conn) -> Result[runner.Frame, ReceiveError] waits {
    if let Error(_) = channel.send(c.credit, ()) { return Error(Closed) }
    match channel.receive(c.from) { Ok(take f) => Ok(take f), Error(_) => Error(Closed) }
}

pub fn try_next(c: Conn) -> Result[runner.Frame, ReceiveError] {
    let _ = channel.try_send(c.credit, ())
    channel.try_receive(c.from)
}

// Contract tests for `file` (core/std/file.hirsel), written to run once an engine runs
// library bodies with a host. Each test takes `dir`, a fresh empty directory the runner
// provides, and returns a scalar; the line `// expect: run f(dir) = R` above it gives the
// result derived by hand from the contract.
/// 0 for Ok, then NotFound 1, Denied 2, Exists 3, Closed 4, Other 5.
fn io(r: Result[(), IoError]) -> u64 {
    match r {
        Ok(()) => 0,
        Error(e) => io_code(e),
    }
}

fn io_code(e: IoError) -> u64 {
    match e {
        NotFound => 1,
        Denied => 2,
        Exists => 3,
        Closed => 4,
        Other(_) => 5,
    }
}

/// 0 for Ok, an IoError's code, 6 for Capacity, 7 for NotUtf8.
fn read_code(e: file.Error) -> u64 {
    match e {
        Io(x) => io_code(x),
        Capacity(_) => 6,
        NotUtf8 => 7,
    }
}

// 'h' + 'e' + 'l' + 'l' + 'o' = 104 + 101 + 108 + 108 + 111.
// expect: run write_then_read(dir) = 532
fn write_then_read(d: Dir) -> u64 waits {
    result.unwrap(file.write(d, "a.txt", string.as_bytes("hello")))
    let b = result.unwrap(file.read(d, "a.txt"))
    list.sum_bytes(b)
}

// Write replaces what was there.
// expect: run write_empties_first(dir) = 2
fn write_empties_first(d: Dir) -> u64 waits {
    result.unwrap(file.write(d, "a.txt", string.as_bytes("hello")))
    result.unwrap(file.write(d, "a.txt", string.as_bytes("hi")))
    let b = result.unwrap(file.read(d, "a.txt"))
    list.len(b)
}

// More than the first 4096-byte reservation: the read grows the buffer.
// expect: run read_grows(dir) = 10000
fn read_grows(d: Dir) -> u64 waits {
    let mut data: Bytes = list.new()
    result.unwrap(list.fill(mut data, 10000, 7))
    result.unwrap(file.write(d, "big", data))
    let b = result.unwrap(file.read(d, "big"))
    list.len(b)
}

// expect: run read_missing(dir) = 1
fn read_missing(d: Dir) -> u64 waits {
    match file.read(d, "absent") {
        Ok(_) => 0,
        Error(e) => read_code(e),
    }
}

// expect: run read_string_text(dir) = true
fn read_string_text(d: Dir) -> bool waits {
    result.unwrap(file.write(d, "t", string.as_bytes("héllo")))
    let s = result.unwrap(file.read_string(d, "t"))
    s == "héllo"
}

// A lone 0xFF byte is not UTF-8.
// expect: run read_string_not_utf8(dir) = 7
fn read_string_not_utf8(d: Dir) -> u64 waits {
    let mut data: Bytes = list.new()
    result.unwrap(list.fill(mut data, 1, 255))
    result.unwrap(file.write(d, "bad", data))
    match file.read_string(d, "bad") {
        Ok(_) => 0,
        Error(e) => read_code(e),
    }
}

// "abc" read through a 2-byte buffer: 2 bytes, then 1, then 0 at the end: 210.
// expect: run read_into_in_steps(dir) = 210
fn read_into_in_steps(d: Dir) -> u64 waits {
    let mut out = result.unwrap(file.open(d, "s", Write))
    result.unwrap(file.write_all(mut out, string.as_bytes("abc")))
    result.unwrap(file.close(take out))
    let mut src = result.unwrap(file.open(d, "s", Read))
    let mut buf: Bytes = result.unwrap(list.with_capacity(2))
    let a = result.unwrap(file.read_into(mut src, mut buf))
    list.clear(mut buf)
    let b = result.unwrap(file.read_into(mut src, mut buf))
    list.clear(mut buf)
    let c = result.unwrap(file.read_into(mut src, mut buf))
    result.unwrap(file.close(take src))
    a * 100 + b * 10 + c
}

// A buffer with no spare capacity reads nothing.
// expect: run read_into_full_buffer(dir) = 0
fn read_into_full_buffer(d: Dir) -> u64 waits {
    result.unwrap(file.write(d, "s", string.as_bytes("abc")))
    let mut src = result.unwrap(file.open(d, "s", Read))
    let mut buf: Bytes = list.new()
    let n = result.unwrap(file.read_into(mut src, mut buf))
    result.unwrap(file.close(take src))
    n
}

// Append writes after what is there.
// expect: run append_adds(dir) = 5
fn append_adds(d: Dir) -> u64 waits {
    result.unwrap(file.write(d, "log", string.as_bytes("abc")))
    let mut f = result.unwrap(file.open(d, "log", Append))
    result.unwrap(file.write_all(mut f, string.as_bytes("de")))
    result.unwrap(file.close(take f))
    list.len(result.unwrap(file.read(d, "log")))
}

// expect: run create_new_existing(dir) = 3
fn create_new_existing(d: Dir) -> u64 waits {
    result.unwrap(file.write(d, "x", string.as_bytes("1")))
    match file.open(d, "x", CreateNew) {
        Ok(f) => {
            let _ = file.close(take f)
            0
        }
        Error(e) => io_code(e),
    }
}

// expect: run open_missing(dir) = 1
fn open_missing(d: Dir) -> u64 waits {
    match file.open(d, "absent", Read) {
        Ok(f) => {
            let _ = file.close(take f)
            0
        }
        Error(e) => io_code(e),
    }
}

// expect: run remove_then_missing(dir) = 1
fn remove_then_missing(d: Dir) -> u64 waits {
    result.unwrap(file.write(d, "x", string.as_bytes("1")))
    result.unwrap(file.remove(d, "x"))
    io(file.remove(d, "x"))
}

// A second handle to a locked file is refused with Held; after unlock it locks.
// expect: run lock_held_then_free(dir) = true
fn lock_held_then_free(d: Dir) -> bool waits {
    result.unwrap(file.write(d, "lock", string.as_bytes("")))
    let first = result.unwrap(file.open(d, "lock", Read))
    let second = result.unwrap(file.open(d, "lock", Read))
    let held = match file.try_lock(take first) {
        Ok(l) => l,
        Error(_) => fail("file test: the first lock was refused"),
    }
    let refused = match file.try_lock(take second) {
        Ok(_) => return false,
        Error(Held(f)) => f,
        Error(Io(_, _)) => return false,
        Error(Capacity(_, _)) => return false,
    }
    let back = match file.unlock(take held) {
        Ok(f) => f,
        Error(_) => return false,
    }
    let ok = match file.try_lock(take refused) {
        Ok(_) => true,
        Error(_) => false,
    }
    let _ = file.close(take back)
    ok
}

// The scripted host commits ab, then EIO. write_all reports the committed byte count.
// host: first_write 2 file
// expect: run write_all_keeps_committed_prefix(dir) = true
fn write_all_keeps_committed_prefix(d: Dir) -> bool waits {
    let mut f = result.unwrap(file.open(d, "partial", Write))
    match file.write_all(mut f, string.as_bytes("abcdef")) {
        Error(e) => {
            if e.written != 2 {
                return false
            }
            match e.error {
                Other(5) => {},
                _ => return false
            }
        },
        _ => return false,
    }
    result.unwrap(file.close(take f))
    let b = result.unwrap(file.read(d, "partial"))
    list.len(b) == 2 && b[0] == b'a' && b[1] == b'b'
}

// The high-level helper returns IoError but still leaves exactly the committed prefix.
// host: first_write 2 file
// expect: run write_keeps_committed_prefix(dir) = true
fn write_keeps_committed_prefix(d: Dir) -> bool waits {
    match file.write(d, "partial", string.as_bytes("abcdef")) {
        Error(Other(5)) => {},
        _ => return false
    }
    let b = result.unwrap(file.read(d, "partial"))
    list.len(b) == 2 && b[0] == b'a' && b[1] == b'b'
}

// Uniform path rule: NUL and dot components are Denied, with no created file.
// expect: run invalid_path_denied(dir) = true
fn invalid_path_denied(d: Dir) -> bool waits {
    for name in["bad\0name", "./bad", "x/../bad", ".."] {
        match file.open(d, name, Write) {
            Error(Denied) => {},
            _ => return false
        }
    }
    match file.open(d, "bad", Read) {
        Error(NotFound) => true,
        _ => false
    }
}

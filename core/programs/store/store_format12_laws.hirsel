// A Format 11 MANIFEST (AP1 word 11, AP14 without the `retired` root), hand-encoded
// with its two frame checks from libxxhash. Format 12 refuses it as Unsupported(11).
fn format11_manifest() -> Bytes {
    let words: Inline[u64, 81] =[
        0x0000003800010001,
        0xa892f05217b1151c,
        0x45524f5453524948,
        0x000000010000000b,
        0x0000000000000001,
        0x0000000000000002,
        0x0000000000000000,
        0x0000000000000001,
        0x0000000000000000,
        0x0000022e00010031,
        0x5e228d32731c0a33,
        0x0000000000000001,
        0x0100000000ff0000,
        0x0100004000000400,
        0x0000000000000064,
        0x0000000100000001,
        0x0000000000000032,
        0x0000000000000007,
        0x0000000000000003,
        0x0000000000000025,
        0x0000000000000053,
        0x0000000000000003,
        0x0000000000000050,
        0x0000000c0000006f,
        0x0000002900000000,
        0x0000000400000000,
        0x0000005a00000000,
        0x0000007000000000,
        0x000000000000000d,
        0x000000000000002a,
        0x0000000000000037,
        0x0000000000000042,
        0x0000000000000005,
        0x0000000000000064,
        0x0000000e00000071,
        0x0000002b00000000,
        0x0000004d00000000,
        0x0000005800000000,
        0x0000006300000000,
        0x0000006500000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000001,
        0x00006e69616d0004,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0100000000000000,
        0x0000700102000000,
        0x0000000000090000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x005c000000000000,
        0x0000000000000000,
    ]
    let mut raw: Bytes = list.with_capacity(648)
    for word in words {
        list.put_word_le(mut raw, word)
    }
    list.truncate(mut raw, 646)
    take raw
}


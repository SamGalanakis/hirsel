const KEY_I8_RULE: u32 = 1

pub fn schema_i8(mut s: Schema) {
    schema_atom(mut s, 7, "i8", I8_RULE, "key.i8", KEY_I8_RULE)
}

const I16_RULE: u32 = 1

const KEY_I16_RULE: u32 = 1

pub fn schema_i16(mut s: Schema) {
    schema_atom(mut s, 8, "i16", I16_RULE, "key.i16", KEY_I16_RULE)
}

const I32_RULE: u32 = 1

const KEY_I32_RULE: u32 = 1

pub fn schema_i32(mut s: Schema) {
    schema_atom(mut s, 9, "i32", I32_RULE, "key.i32", KEY_I32_RULE)
}

const I64_RULE: u32 = 1

const KEY_I64_RULE: u32 = 1

pub fn schema_i64(mut s: Schema) {
    schema_atom(mut s, 10, "i64", I64_RULE, "key.i64", KEY_I64_RULE)
}

const F32_RULE: u32 = 1

pub fn schema_f32(mut s: Schema) {
    schema_atom(mut s, 11, "f32", F32_RULE, "", 0)
}

const F64_RULE: u32 = 1

pub fn schema_f64(mut s: Schema) {
    schema_atom(mut s, 12, "f64", F64_RULE, "", 0)
}

const STRING_RULE: u32 = 1

const KEY_STRING_RULE: u32 = 1

pub fn schema_string(mut s: Schema) {
    schema_atom(mut s, 13, "string", STRING_RULE, "key.string", KEY_STRING_RULE)
}

/// The type c writes, in place: a field's, an element's, a type argument's.
pub fn schema_of[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    if storage_mode(s) {
        if !c.structural {
            storage_external(mut s, opaque_fingerprint(c))
            return Ok(())
        }
        let marker: StaticFn[fn(T)] = code.describe(storage_type)
        let Some((i, parent)) = storage_enter(mut s, marker) else {
            return Ok(())
        }
        let saved = replace(mut s.cur, list.new())
        (code.callable(c.describer))(mut s, c)?
        storage_leave(mut s, i, parent, take saved)
        return Ok(())
    }
    (code.callable(c.describer))(mut s, c)
}

const LIST_RULE: u32 = 1

pub fn schema_list[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    schema_atom(mut s, 14, "list", LIST_RULE, "", 0)
    schema_of(mut s, c)
}

const MAP_RULE: u32 = 1

pub fn schema_map[K: key, V](mut s: Schema, ck: Codec[K], cv: Codec[V]) -> Result[(), EncodeError] {
    schema_atom(mut s, 15, "map", MAP_RULE, "", 0)
    schema_of(mut s, ck)?
    schema_of(mut s, cv)
}

const OPTION_RULE: u32 = 1

pub fn schema_option[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    schema_atom(mut s, 16, "option", OPTION_RULE, "", 0)
    schema_of(mut s, c)
}

const RESULT_RULE: u32 = 1

pub fn schema_result[T, E](mut s: Schema, ct: Codec[T], ce: Codec[E]) -> Result[(), EncodeError] {
    schema_atom(mut s, 17, "result", RESULT_RULE, "", 0)
    schema_of(mut s, ct)?
    schema_of(mut s, ce)
}

const TUPLE_RULE: u32 = 1

const KEY_TUPLE_RULE: u32 = 1

/// A tuple of n components; schema_of each follows.
pub fn schema_tuple(mut s: Schema, n: u64) -> Result[(), EncodeError] {
    schema_atom(mut s, 18, "tuple", TUPLE_RULE, "key.tuple", KEY_TUPLE_RULE)
    put_count(n, mut s.cur)
}

/// Starts the definition of a nominal type at its path; then its type arguments
/// (`argument`), then `record`, `sum` or `via`, its entries and `close`.
pub fn define(mut s: Schema, path: String, arguments: u64) -> Result[(), EncodeError] {
    if storage_mode(s) {
        return Ok(())
    }
    let parent = replace(mut s.cur, list.new())
    push_own(mut s.saved, take parent)
    name(mut s, path)?
    put_count(arguments, mut s.cur)
}

/// One type argument of the definition begun by `define`.
pub fn argument[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    if storage_mode(s) {
        return Ok(())
    }
    (code.callable(c.describer))(mut s, c)
}

/// A record of n entries (fields and removed fields). Ok(true) when the definition is
/// already written: its reference is, and the schema function returns at once.
const RECORD_RULE: u32 = 1

pub fn record(mut s: Schema, n: u64) -> Result[bool, EncodeError] {
    if storage_mode(s) {
        storage_nominal(mut s, "record", RECORD_RULE)
        put_count(n, mut s.cur)?
        return Ok(false)
    }
    body(mut s, 0, n)
}

/// A sum of n variants, live and removed, in declared order; as `record`.
const SUM_RULE: u32 = 1

pub fn sum(mut s: Schema, n: u64) -> Result[bool, EncodeError] {
    if storage_mode(s) {
        storage_nominal(mut s, "sum", SUM_RULE)
        put_count(n, mut s.cur)?
        return Ok(false)
    }
    body(mut s, 1, n)
}

/// A `codec via R` type; schema_of R's codec follows, then `close`.
pub fn via(mut s: Schema) -> Result[bool, EncodeError] {
    body(mut s, 2, 1)
}

// The definition's identity is its path and arguments, the bytes `define` began. A known
// one is a reference in the enclosing type; a new one takes the next index, its
// reference goes to the enclosing type and its body follows.
fn body(mut s: Schema, kind: u8, n: u64) -> Result[bool, EncodeError] {
    let count = list.len(s.keys)
    let mut index: u64 = 0
    while index < count && s.keys[index] != s.cur {
        index += 1
    }
    if index < count {
        restore(mut s)
        reference(mut s.cur, index)?
        return Ok(true)
    }
    let mut key: Bytes = list.with_capacity(list.len(s.cur))
    let _ = list.append(mut key, s.cur)
    push_own(mut s.keys, take key)
    push_own(mut s.defs, list.new())
    push_plain(mut s.open, index)
    let mut parent = replace(mut s.cur, list.new())
    let referenced = match list.pop(mut s.saved) {
        Some(p) => {
            let mut q = take p
            let wrote = reference(mut q, index)
            let _ = list.push(mut s.saved, take q)
            wrote
        }
        None => Ok(())
    }
    let _ = replace(mut s.cur, take parent)
    referenced?
    opcode(mut s, kind)
    if kind != 2 {
        put_count(n, mut s.cur)?
    }
    Ok(false)
}

fn reference(mut b: Bytes, index: u64) -> Result[(), EncodeError] {
    put_byte(mut b, 19)
    put_count(index, mut b)
}

// The enclosing type's bytes become current again.
fn restore(mut s: Schema) {
    let parent = match list.pop(mut s.saved) {
        Some(p) => take p,
        None => list.new()
    }
    let _ = replace(mut s.cur, take parent)
}

/// Ends the definition begun by the latest `define` that `record`, `sum` or `via` left open.
pub fn close(mut s: Schema) {
    if storage_mode(s) {
        return
    }
    let index = match list.pop(mut s.open) {
        Some(i) => i,
        None => return
    }
    let parent = match list.pop(mut s.saved) {
        Some(p) => take p,
        None => list.new()
    }
    let done = replace(mut s.cur, take parent)
    let _ = list.set(mut s.defs, index, take done)
}

/// A field of the record being defined, in declaration order; its type follows (a
/// `schema_` call).
pub fn field(mut s: Schema, path: String) -> Result[(), EncodeError] {
    opcode(mut s, 0)
    name(mut s, path)
}

/// A field of type F with a default: the reader's value when the writer's schema lacks
/// the field. Writes the type too.
pub fn field_default[F](mut s: Schema, path: String, c: Codec[F], v: F) -> Result[(), EncodeError] {
    field(mut s, path)?
    schema_of(mut s, c)?
    if storage_mode(s) {
        let mut value: Bytes = list.new()
        (code.callable(c.encoder))(v, mut value)?
        put_byte(mut s.cur, 1)
        put_count(list.len(value), mut s.cur)?
        list.append(mut s.cur, value)
        return Ok(())
    }
    let def = s.open[list.len(s.open) - 1]
    let mut value: Bytes = list.new()
    (code.callable(c.encoder))(v, mut value)?
    let copied = string.from(path)
    list.push(mut s.defaults, SchemaDefault(def, field: take copied, value: take value))
    Ok(())
}

/// A removed field of the record being defined, where the field was; its type follows
/// (a `schema_` call), resolved against a writer's field of that name (SEM-10).
pub fn removed_field(mut s: Schema, path: String) -> Result[(), EncodeError] {
    opcode(mut s, 1)
    name(mut s, path)
}

/// A removed variant of the sum being defined, with n fields; schema_of each follows.
pub fn removed_variant(mut s: Schema, path: String, n: u64) -> Result[(), EncodeError] {
    opcode(mut s, 1)
    name(mut s, path)?
    put_count(n, mut s.cur)
}

/// A live variant of the sum being defined, with n fields; schema_of each follows.
pub fn variant(mut s: Schema, path: String, n: u64) -> Result[(), EncodeError] {
    opcode(mut s, 0)
    name(mut s, path)?
    put_count(n, mut s.cur)
}

fn push_own[T](mut xs: List[T], take x: T) {
    list.push(mut xs, take x)
}

fn push_plain(mut xs: List[u64], x: u64) {
    list.push(mut xs, x)
}

fn builder() -> Schema {
    Schema(cur: list.new(), saved: list.new(), open: list.new(), keys: list.new(), defs: list.new(), defaults: list.new(), storage: None)
}

fn built[T](c: Codec[T]) -> Result[Schema, EncodeError] {
    let mut s = builder()
    (code.callable(c.describer))(mut s, c)?
    Ok(take s)
}

fn finish(s: Schema) -> Result[Bytes, EncodeError] {
    let mut size: u64 = 5 + list.len(s.cur)
    for d in s.defs {
        size += list.len(d)
    }
    let mut out: Bytes = list.with_capacity(size)
    put_byte(mut out, 3)
    put_count(list.len(s.defs), mut out)?
    for d in s.defs {
        list.append(mut out, d)
    }
    list.append(mut out, s.cur)
    Ok(take out)
}

/// The schema c writes: what a store keeps beside the bytes. Ex: `codec.schema(rows)?`
pub fn schema[T](c: Codec[T]) -> Result[Bytes, EncodeError] {
    let s = built(c)?
    finish(s)
}

/// Builds a codec description with its reader defaults. The schema views below
/// borrow the description, which remains valid across value transcodes.
pub fn describe[T](c: Codec[T]) -> Result[Schema, EncodeError] {
    built(c)
}

/// The root type expression of a completed description.
pub fn schema_root(s: Schema) -> View[Bytes] in s {
    view s.cur
}

/// The number of nominal definitions in a completed description.
pub fn schema_definitions(s: Schema) -> u64 {
    list.len(s.defs)
}

/// Definition bytes starting with the kind byte, after the nominal path and arguments.
pub fn schema_definition(s: Schema, index: u64) -> View[Bytes] in s {
    let d = s.defs[index]
    list.slice(d, kind_at(d, 0), list.len(d))
}

/// Reads a u32 count, byte length or definition index from a description.
pub fn schema_word(b: Bytes, offset: u64) -> u64 {
    count_at(b, offset)
}

/// The end offset of the type expression at at in a completed description.
pub fn schema_next(b: Bytes, at: u64) -> u64 {
    skip(b, at)
}

/// A declared field's pre-encoded default, when the description has one.
pub fn schema_default(s: Schema, def: u64, field_name: String) -> Option[View[Bytes]] in s {
    for d in s.defaults {
        if d.def == def && d.field == field_name {
            return Some(view d.value)
        }
    }
    None
}

/// A completed description's encoded reader defaults, separate from its canonical schema.
pub fn schema_defaults(s: Schema) -> View[List[SchemaDefault]] in s {
    view s.defaults
}

/// Restores a description from canonical schema bytes and its separately encoded defaults.
pub fn restore_schema(raw: Bytes, take defaults: List[SchemaDefault]) -> Result[Schema, DecodeError] {
    let mut offsets: List[u64] = list.new()
    let root = scan(raw, 0u64, list.len(raw), mut offsets) ?=> Schema
    let mut defs: List[Bytes] = list.with_capacity(list.len(offsets))
    for i in 0u64 .. list.len(offsets) {
        let start = offsets[i]
        let end = if i + 1u64 < list.len(offsets) {
            offsets[i + 1u64]
        } else {
            root
        }
        let mut row: Bytes = list.with_capacity(end - start)
        list.append(mut row, list.slice(raw, start, end))
        list.push(mut defs, take row)
    }
    for item in defaults {
        if item.def >= list.len(defs) {
            return Error(Schema(0u64))
        }
    }
    let mut expression: Bytes = list.with_capacity(list.len(raw) - root)
    list.append(mut expression, list.slice(raw, root, list.len(raw)))
    Ok(Schema(cur: take expression, saved: list.new(), open: list.new(), keys: list.new(), defs: take defs, defaults: take defaults, storage: None))
}

/// The stable fingerprint of c's schema: CRC-64-AVRO (Rabin) of its bytes, so equal
/// schemas, tombstones and variant order included, have equal fingerprints.
pub fn schema_fingerprint[T](c: Codec[T]) -> Result[u64, EncodeError] {
    let b = schema(c)?
    Ok(fingerprint_of(b))
}

/// CRC-64-AVRO of the canonical schema bytes.
pub fn fingerprint_of(b: Bytes) -> u64 {
    crc64avro.fingerprint(b)
}

// Resolution. `resolve` checks the writer's schema, then compiles a plan from the pair of
// schemas: per type pair a node of `ops`, per pair of definitions one node, shared, so a
// recursive type compiles once. Reading runs the plan over the writer's bytes with an
// explicit work stack: it checks every item as decoding does, offsets in the writer's
// bytes, and writes the reader's layout (fields in the reader's order, removed fields
// dropped, defaults added); the reader's own decode then builds the value. Equal schemas
// skip all of it. Plan nodes: 0 leaf (opcode); 1 List (element); 2 Map (key, value);
// 3 Option (inner); 4 Result (ok, error); 5 tuple (n, components); 6 record (identity,
// writer fields w, w pairs of reader position and node, reader fields r, r sources:
// writer field or 2^63 + default); 7 sum (variants v, v offsets of: live, n, nodes);
// 8 via (inner). The high bit marks a node or a variant with no encodings.
/// A codec ready to read bytes written under one writer's schema.
pub opaque type Reader[T]: shareable + send {
    c: Codec[T],
    same: bool,
    ops: List[u64],
    defaults: List[SchemaDefault]
}

type Plan {
    all: Bytes,
    wlen: u64,
    wdefs: List[u64],
    rdefs: List[u64],
    ops: List[u64],
    memo: Map[(u64, u64), u64],
    tasks: List[(u64, u64, u64)],
    defaults: List[SchemaDefault],
    has_never: bool
}

const SKIP: u64 = 0xffffffffffffffff

const DEFAULT: u64 = 0x8000000000000000

const EMPTY_NODE: u64 = 0x8000000000000000

// Four little-endian bytes in a schema whose enclosing bounds were checked.
fn count_at(b: Bytes, at: u64) -> u64 {
    let a: u64 = int.widen(b[at])
    let c: u64 = int.widen(b[at + 1])
    let d: u64 = int.widen(b[at + 2])
    let e: u64 = int.widen(b[at + 3])
    a | (c << 8) | (d << 16) | (e << 24)
}

// The end of the name at `at`, or None past `end`.
fn name_end(b: Bytes, at: u64, end: u64) -> Option[u64] {
    if end - at < 4 {
        return None
    }
    let n = count_at(b, at)
    if end - at - 4 < n {
        return None
    }
    if let Error(_) = utf8.validate(list.slice(b, at + 4, at + 4 + n)) {
        return None
    }
    Some(at + 4 + n)
}

// The end of the type at `at`, below `end`, every reference below `defs`: a count of the
// types still owed, so no nesting reaches the call stack. Error: the offset at fault.
fn type_end(b: Bytes, at: u64, end: u64, defs: u64) -> Result[u64, u64] {
    let mut i = at
    let mut owed: u64 = 1
    while owed > 0 {
        if i >= end {
            return Error(i)
        }
        let x = b[i]
        owed -= 1
        i += 1
        if x == 14 || x == 16 {
            owed += 1
        } else if x == 15 || x == 17 {
            owed += 2
        } else if x == 18 || x == 19 {
            if end - i < 4 {
                return Error(i - 1)
            }
            let n = count_at(b, i)
            if x == 19 && n >= defs {
                return Error(i - 1)
            }
            if x == 18 {
                if n > end - i {
                    return Error(i - 1)
                }
                owed += n
            }
            i += 4
        } else if x > 13 && x != 20 {
            return Error(i - 1)
        }
    }
    Ok(i)
}

// The end of the definition at `at`; Error: the offset at fault.
fn def_end(b: Bytes, at: u64, end: u64, defs: u64) -> Result[u64, u64] {
    let mut i = match name_end(b, at, end) {
        Some(e) => e,
        None => return Error(at)
    }
    if end - i < 5 {
        return Error(i)
    }
    let args = count_at(b, i)
    i += 4
    let mut k: u64 = 0
    while k < args {
        i = type_end(b, i, end, defs)?
        k += 1
    }
    if i >= end {
        return Error(i)
    }
    let kind = b[i]
    i += 1
    if kind == 2 {
        return type_end(b, i, end, defs)
    }
    if kind > 2 || end - i < 4 {
        return Error(i - 1)
    }
    let n = count_at(b, i)
    i += 4
    k = 0
    while k < n {
        if i >= end || b[i] > 1 {
            return Error(i)
        }
        let Some(after) = name_end(b, i + 1, end) else {
            return Error(i)
        }
        i = after
        if kind == 0 {
            i = type_end(b, i, end, defs)?
        } else {
            if end - i < 4 {
                return Error(i)
            }
            let fields = count_at(b, i)
            i += 4
            let mut f: u64 = 0
            while f < fields {
                i = type_end(b, i, end, defs)?
                f += 1
            }
        }
        k += 1
    }
    Ok(i)
}

// The definitions' offsets in `all` of the schema at `from`, checked; Error: the offset.
fn scan(all: Bytes, from: u64, end: u64, mut defs: List[u64]) -> Result[u64, u64] {
    if end == from || all[from] != 3 {
        return Error(from)
    }
    if end - from < 5 {
        return Error(from + 1)
    }
    let n = count_at(all, from + 1)
    if n > end - from {
        return Error(from + 1)
    }
    list.reserve(mut defs, n)
    let mut i = from + 5
    let mut k: u64 = 0
    while k < n {
        push_plain(mut defs, i)
        i = match def_end(all, i, end, n) {
            Ok(e) => e,
            Error(e) => return Error(e)
        }
        k += 1
    }
    let root = i
    match type_end(all, i, end, n) {
        Ok(e) => if e != end {
            return Error(e)
        },
        Error(e) => return Error(e)
    }
    Ok(root)
}

// The end of the type at `at` in a checked schema.
fn skip(b: Bytes, at: u64) -> u64 {
    match type_end(b, at, list.len(b), SKIP) {
        Ok(e) => e,
        Error(e) => e
    }
}

// The offset of the kind byte of the definition at d.
fn kind_at(b: Bytes, d: u64) -> u64 {
    let mut i = d + 4 + count_at(b, d)
    let args = count_at(b, i)
    i += 4
    let mut k: u64 = 0
    while k < args {
        i = skip(b, i)
        k += 1
    }
    i
}

fn same_name(b: Bytes, x: u64, y: u64) -> bool {
    let n = count_at(b, x)
    n == count_at(b, y) && list.slice(b, x + 4, x + 4 + n) == list.slice(b, y + 4, y + 4 + n)
}

// The entries of the record or sum whose kind byte is at k: (live, name, type or fields).
fn entries(b: Bytes, k: u64, mut out: List[(bool, u64, u64)]) {
    let n = count_at(b, k + 1)
    let mut i = k + 5
    let mut e: u64 = 0
    while e < n {
        let live = b[i] == 0
        let at_name = i + 1
        i = at_name + 4 + count_at(b, at_name)
        list.push(mut out, (live, at_name, i))
        if b[k] == 0 {
            i = skip(b, i)
        } else {
            let fields = count_at(b, i)
            i += 4
            let mut f: u64 = 0
            while f < fields {
                i = skip(b, i)
                f += 1
            }
        }
        e += 1
    }
}

fn find(b: Bytes, es: List[(bool, u64, u64)], name_at: u64) -> u64 {
    let mut i: u64 = 0
    for (_, n, _) in es {
        if same_name(b, n, name_at) {
            return i
        }
        i += 1
    }
    SKIP
}

fn emit(mut p: Plan, x: u64) {
    push_plain(mut p.ops, x)
}

fn task(mut p: Plan, w: u64, r: u64, slot: u64) {
    list.push(mut p.tasks, (w, r, slot))
}

fn def_at(p: Plan, at: u64) -> u64 {
    let index = count_at(p.all, at + 1)
    if at < p.wlen {
        p.wdefs[index]
    } else {
        p.rdefs[index]
    }
}

// The node of the type pair at w (the writer's) and r; Error: the writer offset at fault.
fn type_node(mut p: Plan, w: u64, r: u64) -> Result[u64, u64] {
    let x = p.all[w]
    if x != p.all[r] {
        return Error(w)
    }
    let index = list.len(p.ops)
    if x == 20 {
        p.has_never = true
        emit(mut p, EMPTY_NODE)
        emit(mut p, 20)
    } else if x <= 13 {
        emit(mut p, 0)
        emit(mut p, int.widen(x))
    } else if x == 14 || x == 16 {
        emit(mut p, if x == 14 {
            1
        } else {
            3
        })
        emit(mut p, 0)
        task(mut p, w + 1, r + 1, index + 1)
    } else if x == 15 || x == 17 {
        emit(mut p, if x == 15 {
            2
        } else {
            4
        })
        emit(mut p, 0)
        emit(mut p, 0)
        task(mut p, w + 1, r + 1, index + 1)
        let w2 = skip(p.all, w + 1)
        let r2 = skip(p.all, r + 1)
        task(mut p, w2, r2, index + 2)
    } else if x == 18 {
        let n = count_at(p.all, w + 1)
        if n != count_at(p.all, r + 1) {
            return Error(w)
        }
        emit(mut p, 5)
        emit(mut p, n)
        let mut cw = w + 5
        let mut cr = r + 5
        let mut k: u64 = 0
        while k < n {
            emit(mut p, 0)
            task(mut p, cw, cr, index + 2 + k)
            cw = skip(p.all, cw)
            cr = skip(p.all, cr)
            k += 1
        }
    } else {
        let wd = def_at(p, w)
        let rd = def_at(p, r)
        match map.get(p.memo, (wd, rd)) {
            Some(known) => return Ok(known),
            None => {}
        }
        return definition(mut p, wd, rd)
    }
    Ok(index)
}

// The node of a pair of definitions, entered in the memo before its fields, so a
// recursive type reaches it again as a reference.
fn definition(mut p: Plan, wd: u64, rd: u64) -> Result[u64, u64] {
    if !same_name(p.all, wd, rd) {
        return Error(wd)
    }
    let wk = kind_at(p.all, wd)
    let rk = kind_at(p.all, rd)
    let kind = p.all[wk]
    if kind != p.all[rk] {
        return Error(wk)
    }
    let index = list.len(p.ops)
    map.insert(mut p.memo, (wd, rd), index)
    if kind == 2 {
        emit(mut p, 8)
        emit(mut p, 0)
        task(mut p, wk + 1, rk + 1, index + 1)
        return Ok(index)
    }
    let mut ws: List[(bool, u64, u64)] = list.new()
    let mut rs: List[(bool, u64, u64)] = list.new()
    entries(p.all, wk, mut ws)
    entries(p.all, rk, mut rs)
    if kind == 0 {
        record_node(mut p, wd, rd, ws, rs)
    } else {
        sum_node(mut p, wk, ws, rs)
    }
}

// Writer fields in the writer's order, each to a reader position or dropped (a field the
// reader removed, still checked and resolved against the tombstone's type); a writer's
// tombstone is a field it lacks. Then the reader's fields from the writer or a default.
// Identity (1): the same fields in the same order, copied as they come; otherwise (0)
// the record's fields are relinked in the reader's order when it ends.
fn record_node(mut p: Plan, wd: u64, rd: u64, ws: List[(bool, u64, u64)], rs: List[(bool, u64, u64)]) -> Result[u64, u64] {
    let index = list.len(p.ops)
    let mut wn: u64 = 0
    for (live, _, _) in ws {
        if live {
            wn += 1
        }
    }
    let mut rn: u64 = 0
    for (live, _, _) in rs {
        if live {
            rn += 1
        }
    }
    emit(mut p, 6)
    emit(mut p, 1)
    emit(mut p, wn)
    let mut identity = wn == rn
    let mut j: u64 = 0
    for (live, name_at, type_at) in ws {
        // A writer's tombstone writes nothing and is a field the writer lacks.
        if !live {
            continue
        }
        let q = find(p.all, rs, name_at)
        if q == SKIP {
            return Error(name_at - 1)
        }
        let slot = list.len(p.ops) + 1
        if rs[q].0 {
            let position = live_position(rs, q)
            if position != j {
                identity = false
            }
            emit(mut p, position)
            emit(mut p, 0)
            task(mut p, type_at, rs[q].2, slot)
        } else {
            identity = false
            emit(mut p, SKIP)
            emit(mut p, 0)
            task(mut p, type_at, rs[q].2, slot)
        }
        j += 1
    }
    emit(mut p, rn)
    let reader_def = def_index(p.rdefs, rd)
    for (live, name_at, _) in rs {
        if !live {
            continue
        }
        let k = find(p.all, ws, name_at)
        if k != SKIP && ws[k].0 {
            emit(mut p, live_position(ws, k))
        } else {
            identity = false
            let d = default_of(p, reader_def, name_at)
            if d == SKIP {
                return Error(wd)
            }
            emit(mut p, DEFAULT + d)
        }
    }
    let _ = list.set(mut p.ops, index + 1, if identity {
        1
    } else {
        0
    })
    Ok(index)
}

fn live_position(es: List[(bool, u64, u64)], k: u64) -> u64 {
    let mut n: u64 = 0
    let mut i: u64 = 0
    while i < k {
        if es[i].0 {
            n += 1
        }
        i += 1
    }
    n
}

fn def_index(defs: List[u64], at: u64) -> u64 {
    let mut i: u64 = 0
    for d in defs {
        if d == at {
            return i
        }
        i += 1
    }
    SKIP
}

fn default_of(p: Plan, def: u64, name_at: u64) -> u64 {
    let n = count_at(p.all, name_at)
    let wanted = list.slice(p.all, name_at + 4, name_at + 4 + n)
    let mut i: u64 = 0
    for d in p.defaults {
        if d.def == def && string.as_bytes(d.field) == wanted {
            return i
        }
        i += 1
    }
    SKIP
}

// Variants keep their declared index, so tags pass through. A writer's variant the reader
// removed resolves, and a value holding it is Schema at the writer's entry for it; a
// variant the writer removed resolves whatever the reader has, and a value holding it is
// Invalid at its tag. The reader may append variants.
fn sum_node(mut p: Plan, wk: u64, ws: List[(bool, u64, u64)], rs: List[(bool, u64, u64)]) -> Result[u64, u64] {
    let wn = list.len(ws)
    if wn > list.len(rs) {
        return Error(wk)
    }
    let index = list.len(p.ops)
    emit(mut p, 7)
    emit(mut p, wn)
    let mut t: u64 = 0
    while t < wn {
        emit(mut p, 0)
        t += 1
    }
    t = 0
    for (live, name_at, fields_at) in ws {
        let (rlive, rname, rfields) = rs[t]
        if !same_name(p.all, name_at, rname) {
            return Error(name_at - 1)
        }
        let here = list.len(p.ops)
        let _ = list.set(mut p.ops, index + 2 + t, here)
        if live {
            // Matched by a live variant or a tombstone, its types resolve against the
            // reader's; a value holding a variant the reader removed is Schema at the
            // writer's entry for it.
            let m = count_at(p.all, fields_at)
            if m != count_at(p.all, rfields) {
                return Error(name_at - 1)
            }
            if rlive {
                emit(mut p, 0)
            } else {
                emit(mut p, 1)
                emit(mut p, name_at - 1)
            }
            emit(mut p, m)
            let base = list.len(p.ops)
            let mut cw = fields_at + 4
            let mut cr = rfields + 4
            let mut k: u64 = 0
            while k < m {
                emit(mut p, 0)
                task(mut p, cw, cr, base + k)
                cw = skip(p.all, cw)
                cr = skip(p.all, cr)
                k += 1
            }
        } else {
            // The writer removed it, so no value of the writer's holds it.
            emit(mut p, 2)
            emit(mut p, 0)
        }
        t += 1
    }
    Ok(index)
}

// The plan: the root pair's node first (index 0), then every task until none is left.
fn compile(mut p: Plan, w: u64, r: u64) -> Result[(), u64] {
    let root = type_node(mut p, w, r)
    if let Error(e) = root {
        return Error(e)
    }
    // In the order met, so the error reported is the writer's first, level by level.
    let mut t: u64 = 0
    while t < list.len(p.tasks) {
        let (cw, cr, slot) = p.tasks[t]
        match type_node(mut p, cw, cr) {
            Ok(n) => {
                let _ = list.set(mut p.ops, slot, n)
            }
            Error(e) => return Error(e)
        }
        t += 1
    }
    Ok(())
}

// A product is empty when a required field is empty. Repeat over the compiled
// graph until no flag changes, because a definition can refer to another node
// before or after it. The iteration starts with only Never and removed variants.
fn mark_empty(mut ops: List[u64]) {
    let mut changed = true
    while changed {
        changed = false
        let mut node: u64 = 0
        while node < list.len(ops) {
            let head = ops[node]
            let kind = head & (EMPTY_NODE - 1)
            let (end, empty) = match kind {
                0 => (node + 2, false),
                1 => (node + 2, false),
                3 => (node + 2, false),
                2 => (node + 3, false),
                4 => (node + 3, ops[ops[node + 1]] >= EMPTY_NODE && ops[ops[node + 2]] >= EMPTY_NODE),
                5 => {
                    let n = ops[node + 1]
                    (node + 2 + n, empty_fields(ops, node + 2, n, 1))
                },
                6 => {
                    let n = ops[node + 2]
                    let tail = node + 3 + 2 * n
                    (tail + 1 + ops[tail], empty_fields(ops, node + 4, n, 2))
                },
                7 => {
                    let count = ops[node + 1]
                    let mut tail = node + 2 + count
                    let mut all_empty = true
                    for i in 0u64 .. count {
                        let v = ops[node + 2 + i]
                        let state = ops[v]
                        let live = state & (EMPTY_NODE - 1)
                        let n_at = v + if live == 1 {
                            2u64
                        } else {
                            1u64
                        }
                        let n = ops[n_at]
                        tail = n_at + 1 + n
                        if state < EMPTY_NODE && live != 2 {
                            if empty_fields(ops, n_at + 1, n, 1) {
                                let _ = list.set(mut ops, v, state | EMPTY_NODE)
                                changed = true
                            } else {
                                all_empty = false
                            }
                        }
                    }
                    (tail, all_empty)
                },
                _ => (node + 2, ops[ops[node + 1]] >= EMPTY_NODE),
            }
            if empty && head < EMPTY_NODE {
                let _ = list.set(mut ops, node, head | EMPTY_NODE)
                changed = true
            }
            node = end
        }
    }
}

fn empty_fields(ops: List[u64], start: u64, count: u64, stride: u64) -> bool {
    for i in 0u64 .. count {
        if ops[ops[start + i * stride]] >= EMPTY_NODE {
            return true
        }
    }
    false
}

/// Resolves the writer's schema against c's: Error(Schema(i)) at the writer's part
/// that does not resolve (SEM-10). Equal schemas read with c's own decode.
/// Ex: `let r = codec.resolve(rows, stored)?`
pub fn resolve[T](c: Codec[T], writer: Bytes) -> Result[Reader[T], DecodeError] {
    let mut s = built(c) ?=> |_| Schema(0)
    let mine = finish(s) ?=> |_| Schema(0)
    if mine == writer {
        return Ok(Reader(c, same: true, ops: list.new(), defaults: list.new()))
    }
    let wlen = list.len(writer)
    let mut all: Bytes = list.with_capacity(wlen + list.len(mine))
    list.append(mut all, writer)
    list.append(mut all, mine)
    let mut wdefs: List[u64] = list.new()
    let wroot = match scan(all, 0, wlen, mut wdefs) {
        Ok(root) => root,
        Error(e) => return Error(Schema(e))
    }
    let mut rdefs: List[u64] = list.new()
    let rroot = match scan(all, wlen, list.len(all), mut rdefs) {
        Ok(root) => root,
        Error(e) => return Error(Schema(e))
    }
    let defaults = replace(mut s.defaults, list.new())
    let mut p = Plan(all: take all, wlen, wdefs: take wdefs, rdefs: take rdefs, ops: list.new(), memo: map.new(), tasks: list.new(), defaults: take defaults, has_never: false)
    if let Error(e) = compile(mut p, wroot, rroot) {
        return Error(Schema(e))
    }
    if p.has_never {
        mark_empty(mut p.ops)
    }
    let ops = replace(mut p.ops, list.new())
    let kept = replace(mut p.defaults, list.new())
    Ok(Reader(c, same: false, ops: take ops, defaults: take kept))
}

// A compound item being read: a List's or Map's entries, a tuple's or variant's fields,
// a record's fields (segs: where each writer field starts in out, then the end), a Map's
// keys so far, in the reader's layout.
// The transcoder's output: bytes in the order it checks them (the writer's), and a list
// of chunks of them, (lo, hi, next), linked in the reader's order. A reordered record
// relinks its fields' chunk runs when it ends, so no byte moves twice and nesting costs
// nothing; the reader's bytes are the chunks walked once from chunk 0.
type Out {
    raw: Bytes,
    chunks: List[(u64, u64, u64)],
    last: u64
}

// raw[lo..] was just written: the last chunk grows over it, or a new chunk follows it.
fn grow(mut o: Out, lo: u64) {
    let last = o.last
    let (clo, chi, next) = o.chunks[last]
    if chi == lo {
        let hi = list.len(o.raw)
        let _ = list.set(mut o.chunks, last, (clo, hi, next))
        return
    }
    let c = chunk(mut o, lo)
}

// A new chunk from raw[lo..] to the end of raw, linked after the last; it becomes last.
fn chunk(mut o: Out, lo: u64) -> u64 {
    let c = list.len(o.chunks)
    let hi = list.len(o.raw)
    list.push(mut o.chunks, (lo, hi, SKIP))
    let prev = o.last
    link(mut o, prev, c)
    o.last = c
    c
}

fn link(mut o: Out, from: u64, to: u64) {
    let (lo, hi, _) = o.chunks[from]
    let _ = list.set(mut o.chunks, from, (lo, hi, to))
}

// The reader's bytes of the run of chunks from `first` through `last`, appended to out.
fn run_bytes(o: Out, first: u64, last: u64, mut out: Bytes) {
    let mut c = first
    loop {
        let (lo, hi, next) = o.chunks[c]
        list.append(mut out, list.slice(o.raw, lo, hi))
        if c == last {
            return
        }
        c = next
    }
}

type Frame {
    kind: u64,
    node: u64,
    i: u64,
    n: u64,
    before: u64,
    key_at: u64,
    keyed: bool,
    runs: List[u64],
    keys: Map[Bytes, ()]
}

fn frame(kind: u64, node: u64, n: u64, before: u64) -> Frame {
    Frame(kind, node, i: 0, n, before, key_at: 0, keyed: false, runs: list.new(), keys: map.new())
}

fn push_frame(mut stack: List[Frame], take f: Frame) {
    list.push(mut stack, take f)
}

// One scalar or String at `at`, checked as its take does, copied to out.
fn leaf(code: u64, b: Bytes, mut at: u64, mut out: Bytes) -> Result[(), DecodeError] {
    let start = at
    if code == 0 {
        return Ok(())
    } else if code == 1 {
        let _ = take_bool(b, mut at)?
    } else if code == 2 {
        let _ = take_char(b, mut at)?
    } else if code == 11 {
        let _ = take_f32(b, mut at)?
    } else if code == 12 {
        let _ = take_f64(b, mut at)?
    } else if code == 13 {
        let n: u64 = int.widen(take_u32(b, mut at)?)
        if list.len(b) - at < n {
            return Error(Truncated(start))
        }
        if let Error(e) = utf8.validate(list.slice(b, at, at + n)) {
            return Error(Utf8(at + e.valid_up_to))
        }
        at += n
    } else {
        let width: u64 = if code == 3 || code == 7 {
            1
        } else if code == 4 || code == 8 {
            2
        } else if code == 5 || code == 9 {
            4
        } else {
            8
        }
        need(b, at, width)?
        at += width
    }
    list.append(mut out, list.slice(b, start, at))
    Ok(())
}

fn word(mut o: Out, x: u64, at: u64) -> Result[(), DecodeError] {
    let lo = list.len(o.raw)
    put_count(x, mut o.raw) ?=> |_| Invalid(at)
    grow(mut o, lo)
    Ok(())
}

fn tag_word(mut o: Out, x: u32) {
    let lo = list.len(o.raw)
    put_tag(x, mut o.raw)
    grow(mut o, lo)
}

// Checks the writer's bytes by the plan and writes the reader's layout into o; the
// offset where the value ends. marks: (offset in o.raw, offset in b) of each via value.
fn transcode(ops: List[u64], defaults: List[SchemaDefault], b: Bytes, start: u64, mut o: Out, mut marks: List[(u64, u64)]) -> Result[u64, DecodeError] {
    let mut stack: List[Frame] = list.new()
    let mut at = start
    let mut next: u64 = 0
    let mut starting = true
    loop {
        if starting {
            starting = false
            let k = ops[next]
            if k >= EMPTY_NODE {
                return Error(Invalid(at))
            } else if k == 0 {
                let lo = list.len(o.raw)
                leaf(ops[next + 1], b, mut at, mut o.raw)?
                grow(mut o, lo)
            } else if k == 1 || k == 2 {
                let n: u64 = int.widen(take_u32(b, mut at)?)
                word(mut o, n, at)?
                if n > 0 {
                    push_frame(mut stack, frame(k, next, n, 0))
                }
            } else if k == 3 || k == 4 {
                let tag_at = at
                let small = take_tag(b, mut at, 2)?
                let tag: u64 = int.widen(small)
                if k == 4 || tag == 1 {
                    next = ops[next + 1 + if k == 4 {
                        tag
                    } else {
                        0
                    }]
                    if ops[next] >= EMPTY_NODE {
                        return Error(Invalid(tag_at))
                    }
                    starting = true
                }
                tag_word(mut o, small)
            } else if k == 5 {
                if ops[next + 1] > 0 {
                    push_frame(mut stack, frame(5, next + 2, ops[next + 1], 0))
                }
            } else if k == 6 {
                if ops[next + 2] > 0 || ops[next + 1] != 1 {
                    push_frame(mut stack, frame(6, next, ops[next + 2], o.last))
                }
            } else if k == 7 {
                let tag_at = at
                let small = take_u32(b, mut at)?
                let tag: u64 = int.widen(small)
                if tag >= ops[next + 1] {
                    return Error(Invalid(tag_at))
                }
                let v = ops[next + 2 + tag]
                if ops[v] >= EMPTY_NODE || ops[v] == 2 {
                    return Error(Invalid(tag_at))
                }
                if ops[v] == 1 {
                    return Error(Schema(ops[v + 1]))
                }
                tag_word(mut o, small)
                if ops[v + 1] > 0 {
                    push_frame(mut stack, frame(5, v + 2, ops[v + 1], 0))
                }
            } else {
                list.push(mut marks, (list.len(o.raw), at))
                next = ops[next + 1]
                starting = true
            }
            continue
        }
        let mut f = match list.pop(mut stack) {
            Some(top) => take top,
            None => return Ok(at)
        }
        if f.kind == 1 {
            if f.i < f.n {
                f.i += 1
                next = ops[f.node + 1]
                starting = true
                push_frame(mut stack, take f)
            }
        } else if f.kind == 2 {
            if f.keyed {
                // The key's reader bytes, from its first chunk to the last.
                let mut key: Bytes = list.new()
                run_bytes(o, f.before, o.last, mut key)
                if map.contains(f.keys, key) {
                    return Error(Duplicate(f.key_at))
                }
                map.insert(mut f.keys, take key, ())
                f.keyed = false
                next = ops[f.node + 2]
                starting = true
                push_frame(mut stack, take f)
            } else if f.i < f.n {
                f.i += 1
                f.keyed = true
                f.key_at = at
                let here = list.len(o.raw)
                f.before = chunk(mut o, here)
                next = ops[f.node + 1]
                starting = true
                push_frame(mut stack, take f)
            }
        } else if f.kind == 5 {
            if f.i < f.n {
                next = ops[f.node + f.i]
                f.i += 1
                starting = true
                push_frame(mut stack, take f)
            }
        } else if ops[f.node + 1] == 1 {
            if f.i < f.n {
                next = ops[f.node + 4 + 2 * f.i]
                f.i += 1
                starting = true
                push_frame(mut stack, take f)
            }
        } else {
            // A reordered record: each writer field is a run of its own chunks.
            if f.i > 0 {
                list.push(mut f.runs, o.last)
            }
            if f.i < f.n {
                let here = list.len(o.raw)
                let first = chunk(mut o, here)
                list.push(mut f.runs, first)
                next = ops[f.node + 4 + 2 * f.i]
                f.i += 1
                starting = true
                push_frame(mut stack, take f)
            } else {
                relink(ops, f.node, f.before, f.runs, defaults, mut o)
            }
        }
    }
}

// The record's runs in the reader's order after `before`, each reader field the writer's
// run or a default's new chunk; a removed field's run is left out.
fn relink(ops: List[u64], node: u64, before: u64, runs: List[u64], defaults: List[SchemaDefault], mut o: Out) {
    let wn = ops[node + 2]
    let rn = ops[node + 3 + 2 * wn]
    o.last = before
    let mut q: u64 = 0
    while q < rn {
        let source = ops[node + 4 + 2 * wn + q]
        if source >= DEFAULT {
            let lo = list.len(o.raw)
            list.append(mut o.raw, defaults[source - DEFAULT].value)
            let _ = chunk(mut o, lo)
        } else {
            let prev = o.last
            link(mut o, prev, runs[2 * source])
            o.last = runs[2 * source + 1]
        }
        q += 1
    }
    let end = o.last
    link(mut o, end, SKIP)
}

// The offset in o.raw of the reader's byte i, walking the chunks; SKIP past the end.
fn raw_at(o: Out, i: u64) -> u64 {
    let mut c: u64 = 0
    let mut pos: u64 = 0
    while c != SKIP {
        let (lo, hi, next) = o.chunks[c]
        if i < pos + (hi - lo) {
            return lo + (i - pos)
        }
        pos += hi - lo
        c = next
    }
    SKIP
}

/// Decodes all of b, written under the schema r was resolved against, as decode does;
/// offsets are into b. Ex: `codec.read(r, stored)?`
pub fn read[T](r: Reader[T], b: Bytes) -> Result[T, DecodeError] {
    read_at(r, b, 0)
}

/// Reads b from `start` to its end, as read does; offsets are into b. A stored value
/// behind a header is read in place. Ex: `codec.read_at(r, row, 2)?`
pub fn read_at[T](r: Reader[T], b: Bytes, start: u64) -> Result[T, DecodeError] {
    if r.same {
        return decode_at(r.c, b, start)
    }
    if start > list.len(b) {
        return Error(Truncated(list.len(b)))
    }
    let mut o = Out(raw: list.new(), chunks: list.new(), last: 0)
    let mut marks: List[(u64, u64)] = list.new()
    let mut out: Bytes = list.new()
    list.push(mut o.chunks, (0, 0, SKIP))
    let end = transcode(r.ops, r.defaults, b, start, mut o, mut marks)?
    if end != list.len(b) {
        return Error(Trailing(end))
    }
    run_bytes(o, 0, o.last, mut out)
    let mut at: u64 = 0
    match (code.callable(r.c.decoder))(out, mut at) {
        Ok(x) => Ok(take x),
        Error(Value(i)) => {
            let raw = raw_at(o, i)
            for (mo, w) in marks {
                if mo == raw {
                    return Error(Value(w))
                }
            }
            Error(Value(i))
        }
        Error(e) => Error(e),
    }
}

// Keys. A key's bytes sort, compared bytewise, as its values do, and no key's bytes are
// a proper prefix of another's, so a tuple key is its components' bytes concatenated.
// Unsigned integers big-endian at their width; signed ones the same with the sign bit
// flipped; bool one byte, 0 or 1; String and Bytes their bytes with each 0x00 written
// 0x00 0xff, then 0x00 0x00. A key schema is a schema whose version byte is 4.
/// Reverses the order of its value. Value codecs write the wrapped value.
pub type Desc[T]: codec + key + ordered via T(to: desc_value, from: make_desc) {
    value: T
}

fn desc_value[T](x: Desc[T]) -> View[T] in x {
    view x.value
}

fn make_desc[T](take x: T) -> Result[Desc[T], DecodeError] {
    Ok(Desc(value: take x))
}

/// The key codec of T. Generated key codecs and the built-in ones below are the makers.
pub opaque type Key[T] {
    encoder: StaticFn[fn(T, mut Bytes) -> ()],
    decoder: StaticFn[fn(Bytes, mut u64) -> Result[T, DecodeError]],
    describer: StaticFn[fn(mut Schema) -> Result[(), EncodeError]],
    structural: bool
}

/// The ordered key codec of T. The checker selects the maker per instance.
pub fn key_of[T]() -> Key[T] {
    key_of()
}

fn key_unit() -> Key[()] {
    Key(encoder: code.describe(put_unit), decoder: code.describe(take_unit), describer: code.describe(key_schema_unit), structural: true)
}

fn key_schema_unit(mut s: Schema) -> Result[(), EncodeError] {
    schema_unit(mut s);
    Ok(())
}

fn put_key_desc[T](x: Desc[T], key: Key[T], mut out: Bytes) {
    let mut raw: Bytes = list.new()
    put_key_with(x.value, key, mut raw)
    for byte in raw {
        list.push(mut out, byte ^ 0xff)
    }
}

fn take_key_desc[T](b: Bytes, mut at: u64, key: Key[T]) -> Result[Desc[T], DecodeError] {
    let mut raw: Bytes = clone(b)
    for i in at .. list.len(raw) {
        let byte = raw[i] ^ 0xff
        let _ = list.set(mut raw, i, byte)
    }
    let value = take_key_with(raw, mut at, key)?
    Ok(Desc(value: take value))
}

const KEY_DESC_RULE: u32 = 1

fn schema_desc(mut s: Schema) {
    schema_atom(mut s, 21, "", 0, "key.desc", KEY_DESC_RULE)
}

/// A key codec from its parts. Ex: `codec.key_make(code.describe(id_put), code.describe(id_take), code.describe(id_schema))`
pub fn key_make[T](e: StaticFn[fn(T, mut Bytes) -> ()], d: StaticFn[fn(Bytes, mut u64) -> Result[T, DecodeError]], w: StaticFn[fn(mut Schema) -> Result[(), EncodeError]]) -> Key[T] {
    Key(encoder: e, decoder: d, describer: w, structural: false)
}

/// Appends x's key bytes to out. Fails: Capacity; out then holds a prefix of them.
pub fn encode_key[T](k: Key[T], x: T, mut out: Bytes) {
    (code.callable(k.encoder))(x, mut out)
}

/// Decodes all of b as one key: exactly the bytes encode_key produces, as decode.
pub fn decode_key[T](k: Key[T], b: Bytes) -> Result[T, DecodeError] {
    let mut at: u64 = 0
    match (code.callable(k.decoder))(b, mut at) {
        Ok(x) => {
            if at != list.len(b) {
                return Error(Trailing(at))
            }
            Ok(take x)
        }
        Error(e) => Error(e),
    }
}

/// The key's schema: version 4, then the definitions and the type as `schema` writes them.
pub fn key_schema[T](k: Key[T]) -> Result[Bytes, EncodeError] {
    let mut s = builder()
    (code.callable(k.describer))(mut s)?
    let mut b = finish(s)?
    let _ = list.set(mut b, 0, 4)
    Ok(take b)
}

/// A key component's type in a key schema: a tuple key's schema_tuple, then one per part.
pub fn schema_key[T](mut s: Schema, k: Key[T]) -> Result[(), EncodeError] {
    if storage_mode(s) {
        if !k.structural {
            storage_external(mut s, opaque_key_fingerprint(k))
            return Ok(())
        }
        let marker: StaticFn[fn(T)] = code.describe(storage_type)
        let Some((i, parent)) = storage_enter(mut s, marker) else {
            return Ok(())
        }
        let saved = replace(mut s.cur, list.new())
        (code.callable(k.describer))(mut s)?
        storage_leave(mut s, i, parent, take saved)
        return Ok(())
    }
    (code.callable(k.describer))(mut s)
}

/// A key component: what a generated tuple key calls per part.
pub fn put_key_with[T](x: T, k: Key[T], mut out: Bytes) {
    (code.callable(k.encoder))(x, mut out)
}

pub fn take_key_with[T](b: Bytes, mut at: u64, k: Key[T]) -> Result[T, DecodeError] {
    (code.callable(k.decoder))(b, mut at)
}

pub fn put_key_u8(x: u8, mut out: Bytes) {
    put_byte(mut out, x)
}

pub fn take_key_u8(b: Bytes, mut at: u64) -> Result[u8, DecodeError] {
    take_u8(b, mut at)
}

pub fn put_key_u16(x: u16, mut out: Bytes) {
    list.put_word_be(mut out, x)
}

pub fn take_key_u16(b: Bytes, mut at: u64) -> Result[u16, DecodeError] {
    need(b, at, 2)?
    let x: u16 = list.word_be(b, at)
    at += 2
    Ok(x)
}

pub fn put_key_u32(x: u32, mut out: Bytes) {
    list.put_word_be(mut out, x)
}

pub fn take_key_u32(b: Bytes, mut at: u64) -> Result[u32, DecodeError] {
    need(b, at, 4)?
    let x: u32 = list.word_be(b, at)
    at += 4
    Ok(x)
}

pub fn put_key_u64(x: u64, mut out: Bytes) {
    list.put_word_be(mut out, x)
}

pub fn take_key_u64(b: Bytes, mut at: u64) -> Result[u64, DecodeError] {
    need(b, at, 8)?
    let x: u64 = list.word_be(b, at)
    at += 8
    Ok(x)
}

pub fn put_key_i8(x: i8, mut out: Bytes) {
    let bits: u8 = int.truncate(x)
    put_byte(mut out, bits ^ 0x80)
}

pub fn take_key_i8(b: Bytes, mut at: u64) -> Result[i8, DecodeError] {
    let x = take_u8(b, mut at)?
    Ok(int.truncate(x ^ 0x80))
}

pub fn put_key_i16(x: i16, mut out: Bytes) {
    let bits: u16 = int.truncate(x)
    put_key_u16(bits ^ 0x8000, mut out)
}

pub fn take_key_i16(b: Bytes, mut at: u64) -> Result[i16, DecodeError] {
    let bits = take_key_u16(b, mut at)? ^ 0x8000
    Ok(int.truncate(bits))
}

pub fn put_key_i32(x: i32, mut out: Bytes) {
    let bits: u32 = int.truncate(x)
    put_key_u32(bits ^ 0x80000000, mut out)
}

pub fn take_key_i32(b: Bytes, mut at: u64) -> Result[i32, DecodeError] {
    let bits = take_key_u32(b, mut at)? ^ 0x80000000
    Ok(int.truncate(bits))
}

pub fn put_key_i64(x: i64, mut out: Bytes) {
    let bits: u64 = int.truncate(x)
    put_key_u64(bits ^ 0x8000000000000000, mut out)
}

pub fn take_key_i64(b: Bytes, mut at: u64) -> Result[i64, DecodeError] {
    let x = take_key_u64(b, mut at)?
    Ok(int.truncate(x ^ 0x8000000000000000))
}

pub fn put_key_bool(x: bool, mut out: Bytes) {
    put_bool(x, mut out)
}

pub fn take_key_bool(b: Bytes, mut at: u64) -> Result[bool, DecodeError] {
    take_bool(b, mut at)
}

pub fn put_key_bytes(x: Bytes, mut out: Bytes) {
    list.reserve(mut out, list.len(x) + 2)
    for byte in x {
        put_byte(mut out, byte)
        if byte == 0 {
            put_byte(mut out, 0xff)
        }
    }
    put_byte(mut out, 0)
    put_byte(mut out, 0)
}

// The escaped run at `at`: how many bytes it unescapes to, and where its terminator ends.
fn key_run(b: Bytes, at: u64) -> Result[(u64, u64), DecodeError] {
    let mut i = at
    let mut n: u64 = 0
    loop {
        if i >= list.len(b) {
            return Error(Truncated(at))
        }
        if b[i] == 0 {
            if i + 1 >= list.len(b) {
                return Error(Truncated(at))
            }
            if b[i + 1] == 0 {
                return Ok((n, i + 2))
            }
            if b[i + 1] != 0xff {
                return Error(Invalid(i + 1))
            }
            i += 2
        } else {
            i += 1
        }
        n += 1
    }
}

pub fn take_key_bytes(b: Bytes, mut at: u64) -> Result[Bytes, DecodeError] {
    let (n, end) = key_run(b, at)?
    let mut raw: Bytes = room(n)
    let mut i = at
    while i < end - 2 {
        let _ = list.push(mut raw, b[i])
        i += if b[i] == 0 {
            2
        } else {
            1
        }
    }
    at = end
    Ok(take raw)
}

pub fn put_key_string(x: String, mut out: Bytes) {
    put_key_bytes(string.as_bytes(x), mut out)
}

/// As take_key_bytes, then UTF-8; Utf8 at the encoded byte that stops being UTF-8.
pub fn take_key_string(b: Bytes, mut at: u64) -> Result[String, DecodeError] {
    let start = at
    let raw = take_key_bytes(b, mut at)?
    if let Error(e) = utf8.validate(raw) {
        let mut zeros: u64 = 0
        let mut i: u64 = 0
        while i < e.valid_up_to {
            if raw[i] == 0 {
                zeros += 1
            }
            i += 1
        }
        return Error(Utf8(start + e.valid_up_to + zeros))
    }
    match string.from_utf8(take raw) {
        Ok(s) => Ok(take s),
        Error(_) => Error(Utf8(start))
    }
}

const KEY_BYTES_RULE: u32 = 1

fn schema_bytes_type(mut s: Schema) -> Result[(), EncodeError] {
    if storage_mode(s) {
        storage_family(mut s.cur, "key.bytes", KEY_BYTES_RULE)
        return Ok(())
    }
    opcode(mut s, 14)
    opcode(mut s, 3)
    Ok(())
}

pub fn key_u8() -> Key[u8] {
    Key(encoder: code.describe(put_key_u8), decoder: code.describe(take_key_u8), describer: code.describe(key_schema_u8), structural: true)
}

fn key_schema_u8(mut s: Schema) -> Result[(), EncodeError] {
    schema_u8(mut s);
    Ok(())
}


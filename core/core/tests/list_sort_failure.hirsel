resource type MergeAudit {
    out: Stdout,
    values: List[SortItem],
    count: u64
} drop(t) {
    let mut valid = list.len(t.values) == t.count
    let mut mask: u64 = 0
    for x in t.values {
        if x.id >= t.count || x.key != merge_key(t.count, x.id) {
            valid = false
        } else {
            let bit = 1u64 << x.id
            if (mask & bit) != 0 {
                valid = false
            }
            mask |= bit
        }
    }
    let _ = stdout.write(t.out, if valid && mask == (1u64 << t.count) - 1 {
        "ok"
    } else {
        "bad"
    })
}

// Stable sorted: keys never decrease and ids rise within a key.
fn merge_fail_at(out: Stdout, count: u64, failure: u64) -> bool {
    let mut xs: List[SortItem] = list.new()
    for i in 0u64 .. count {
        result.unwrap(list.push(mut xs, result.unwrap(SortItem(out: out, id: i, key: merge_key(count, i)))))
    }
    let mut audit = result.unwrap(MergeAudit(out: out, values: take xs, count: count))
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut audit.values, fn(a: SortItem, b: SortItem) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a.key < b.key {
            Less
        } else if a.key > b.key {
            Greater
        } else {
            Equal
        }
    }))
    let mut sorted = true
    for i in 1u64 .. count {
        let (ak, ai) = (audit.values[i - 1].key, audit.values[i - 1].id)
        let (bk, bi) = (audit.values[i].key, audit.values[i].id)
        if ak > bk || (ak == bk && ai > bi) {
            sorted = false
        }
    }
    sorted
}

// Host-free twin: the evaluator checks scratch and source live slots on failure.
fn merge_plain_fail_at(count: u64, failure: u64) -> bool {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. count {
        result.unwrap(list.push(mut xs, merge_key(count, i)))
    }
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a < b {
            Less
        } else if a > b {
            Greater
        } else {
            Equal
        }
    }))
    let mut sorted = list.len(xs) == count
    for i in 1u64 .. count {
        if xs[i - 1] > xs[i] {
            sorted = false
        }
    }
    sorted
}

// Keys by count; each list exercises one restore arm (calls from the sort's own
// replay, checked call by call against an independent model of it).
// 36: two ascending runs of 18, evens then odds. Run detection takes calls 1-35;
//     the merge copies the left run to scratch and merges up on calls 36-70.
// 37: an ascending run of 21, then 16 keys sorted by insertion (calls 39-93);
//     the merge copies the right run to scratch and merges down on calls 94-129.
// 44: (7i mod 44) mod 3. Calls 9-51 partition [0, 44) around id 35; the right
//     range inherits it as ancestor, so its next pivot (id 27) is the least key
//     and calls 70-97 are an equal partition of [15, 44), the pivot in scratch
//     from call 82.
// 52: ids 0-31 two ascending blocks, the second preceding the first; ids 32-47
//     odd keys; ids 48-51 even keys. No natural run reaches 26, so the whole list
//     is quicksorted: calls 26-76 partition [0, 52) around id 24, the pivot in
//     scratch from call 50; calls 80-102 partition [28, 52).
fn merge_key(count: u64, id: u64) -> u64 {
    if count == 36 {
        if id < 18 {
            2 * id
        } else {
            2 * (id - 18) + 1
        }
    } else if count == 37 {
        if id < 21 {
            2 * id
        } else {
            (7 * (id - 21)) % 16 * 3 + 1
        }
    } else if count == 44 {
        (id * 7) % 44 % 3
    } else if id < 32 {
        80 - id / 16 * 16 + id % 16
    } else if id < 48 {
        2 * (id - 32) + 1
    } else {
        2 * (id - 48)
    }
}

// expect: stdout "okXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
// expect: run up_complete(out) = true
fn up_complete(out: Stdout) -> bool {
    merge_fail_at(out, 36, 0)
}

// expect: run up_plain_complete() = true
fn up_plain_complete() -> bool {
    merge_plain_fail_at(36, 0)
}


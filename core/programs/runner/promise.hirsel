pub opaque type PromiseId: codec + send {
    park: ParkId
}

pub fn park_id(id: PromiseId) -> ParkId {
    id.park
}

pub type Completion: codec + send = Recorded | AlreadyComplete

/// Persists the waiting state. A deadline, when supplied, will wake it without a payload.
pub fn create[S](mut tx: store.Tx, tables: Tables[S], entries: triggers.Entries, wake: triggers.Entry[ParkId], state: S, deadline: Option[u64]) -> Result[PromiseId, Error] {
    Ok(PromiseId(park: defer(mut tx, tables, entries, wake, state, deadline, true)?))
}

/// Completes a promise once and schedules a fresh wake with its payload.
pub fn complete[S](mut tx: store.Tx, tables: Tables[S], entries: triggers.Entries, promise: PromiseId, take payload: Bytes) -> Result[Completion, Error] {
    let id = promise.park
    let Some(take saved) = store.fetch(tx, tables.signals, id) ?=> Store else {
        return Ok(AlreadyComplete)
    }
    let Some(target) = view saved.completion else {
        return Ok(AlreadyComplete)
    }
    let trigger = triggers.write_saved(mut tx, tables.triggers, entries, target, id, AfterCommit) ?=> Trigger
    stop(mut tx, tables.triggers, saved.trigger)?
    let signal = Signal(due: None, trigger: Some(trigger), payload: Some(take payload), completion: None)
    store.put(mut tx, tables.signals, id, signal) ?=> Store
    Ok(Recorded)
}

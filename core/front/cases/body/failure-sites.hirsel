// expect: accept
// expect: run add(18446744073709551615) = fail Overflow@15:5
// expect: run at(3) = fail Bounds@20:5
// expect: run raise(3) = fail Fail@26:9
// expect: run relay(3) = fail Fail@26:9
// expect: run twice(18446744073709551615) = fail Overflow@36:5
// expect: run first(0) = fail Unwrap@45:5
// expect: run finalize(0) = fail Division@51:13
// expect: run both(0) = fail Overflow@63:18,Division@51:13
// expect: run sites(1) = 0
// SITES.md: a cause's site is the start of its raising op: a checked op, the `fail`, the
// same site through a propagating call or any generic instance, the call into core for
// an op inside core, the finalizer's op in cleanup; a different statement, another Site.
fn add(x: u64) -> u64 {
    x + 1
}

fn at(i: u64) -> u64 {
    let xs =[1u64, 2u64, 3u64]
    xs[i]
}

fn raise(n: u64) -> u64 {
    let msg: String = "big"
    if n > 2 {
        fail(take msg)
    }
    n
}

fn relay(n: u64) -> u64 {
    raise(n)
}

fn inc[T](x: u64, t: T) -> u64 {
    x + 1
}

fn twice(x: u64) -> u64 {
    inc(1, 1u8) + inc(x, 2u32)
}

fn first(n: u64) -> u64 {
    let o: Option[u64] = None
    option.unwrap(take o) + n
}

resource type R {
    d: u64
} drop(t) {
    let _ = 100 / t.d
}

fn finalize(d: u64) -> u64 {
    match R(d: d) {
        Ok(_r) => 1,
        Error(_) => 0,
    }
}

fn both(d: u64) -> u64 {
    match R(d: d) {
        Ok(r) => r.d - 1,
        Error(_) => 0,
    }
}

fn child(take message: String) -> u64 {
    fail(take message)
}

fn other(take message: String) -> u64 {
    fail(take message)
}

fn site_of(cs: Causes) -> Option[Site] {
    let mut site: Option[Site] = None
    for c in cs {
        site = Some(c.site)
    }
    site
}

fn sites(tasks: Tasks) -> u64 waits {
    let a = result.unwrap(task.spawn(tasks, bytes 64, "data", child))
    let b = result.unwrap(task.spawn(tasks, bytes 64, "tail-message", child))
    let c = result.unwrap(task.spawn(tasks, bytes 64, "data", other))
    let sa: Option[Site] = match task.join(take a) {
        Error(Failed(take cs)) => site_of(cs),
        _ => None
    }
    let sb: Option[Site] = match task.join(take b) {
        Error(Failed(take cs)) => site_of(cs),
        _ => None
    }
    let sc: Option[Site] = match task.join(take c) {
        Error(Failed(take cs)) => site_of(cs),
        _ => None
    }
    match (sa, sb, sc) {
        (Some(x), Some(y), Some(z)) => if x != y {
            1
        } else if x == z {
            3
        } else {
            0
        },
        _ => 2
    }
}

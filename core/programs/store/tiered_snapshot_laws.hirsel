fn l62_prepare_snapshot_pages(mut db: Db, d: Dir, collection: u32, pack_seq: u64) -> Result[(), Error] waits {
    let id = prefix(collection)?
    let mut tree = share_page_tree(db.heads[0u64].roots.collections)
    let (take raw, inventory, place, take leaf, take descriptor) = {
        let Some((here, before)) = std.page.collection_entry(tree.root, id) else {
            fail("L62: fixture has no collection")
        }
        let image = std.page.image_of(here)
        let mut draft = begin_tiered_pack(db.store, pack_seq, 3, 4096)?
        let frame = PackFrame(stamp: std.page.stamp(image), size: std.page.sealed_size(image), body: PageBody(arc.share(here)))
        let first_key = logical_key(collection, option.unwrap(std.page.key_at(image, 0)))?
        let Some(place) = add_tiered_pack_frame(mut draft, frame, collection, first_key, scoped fn(stamp: u64) -> std.page.PagePtr {
            fail("L62: the fixture leaf has no owning edge")
        })? else {
            fail("L62: fixture PAGE did not fit")
        }
        let (take raw, inventory) = finish_tiered_pack(take draft)?
        (take raw, inventory, place, arc.share(here), rooted_collection_record(here, before[52u64], 1)?)
    }
    disk_write_synced(d, paged_pack_path(pack_seq)?, raw)?
    let mut draw = stamp_after(db.next_node)?
    let first = draw
    page_result(std.page.insert(mut tree.root, id, descriptor, Some(take leaf), tree.inline, first, mut draw))?
    page_result(std.page.install_tiered_root(mut tree.root, id, ColdPage(place), mut draw))?
    let mut ids = pack_seq * 8
    let initial = match tree.paging {
        Some(previous) => std.omap.snapshot(previous.packs),
        None => std.omap.new(),
    }
    let (take packs, _) = std.omap.insert(mut ids, initial, pack_seq, TieredPagerPack(inventory: inventory, object: None))
    tree.paging = Some(arc.new(TieredReadInventory(packs: take packs, generation: 1, touch_slots: 4)))
    db.heads[0u64].roots.collections = take tree
    db.next_node = draw - 1
    Ok(())
}

fn l62_snapshot_point_reads(db: Db, rows_handle: Table[u64, u32]) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    if get(read_handle, s, rows_handle, 1u64)? != Some(42u32) ||
        get(read_handle, s, rows_handle, 1u64)? != Some(42u32) ||
        get(read_handle, s, rows_handle, 2u64)? != None {
        fail("L62: Reader value changed across cold, warm, and absent point lookups")
    }
    Ok(())
}

@test
fn test_l62_snapshot_get_uses_tiered_pager(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let mut db = test_db(c, 2147483648)
    let _ = create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u32()))?
    let rows_handle = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u32())?
    let Committed(_) = run(mut db, None, copy_env(rows_handle), fn(mut tx: Tx, handle: Table[u64, u32]) -> Result[(), Error] {
        put(mut tx, handle, 1u64, 42u32)
    })? else {
        fail("L62: fixture insert did not commit")
    }
    let table_id = rows_handle.id
    l62_prepare_snapshot_pages(mut db, fixtures, table_id, 8)?
    let funding = TieredPagerFunding(cache_bytes: 32 * 1048576, writer_pin_bytes: 0, pager_task_bytes: 1048576)
    let (take requests, take worker) = start_tiered_pager(tasks, db.store, open_number(db), PagerDirectory(fixtures), funding, 4)?
    db.pager = Some(take requests)
    let answered = l62_snapshot_point_reads(db, rows_handle)
    db.pager = None
    let _ = result.unwrap(task.join(take worker))
    answered
}

fn l62_prepare_scan_overlay(mut db: Db, rows_handle: Table[u64, u32]) -> Result[(), Error] {
    let collection = rows_handle.id
    let mut draw = stamp_after(db.next_node)?
    let mut account = ReplayTieredAccount(total: 258, exact: true, ordinal: 0)
    let mut stored: Bytes = list.with_capacity(6)
    list.put_word_le(mut stored, rows_handle.readers.current)
    list.put_word_le(mut stored, 20u32)
    let inserted = JournalOp(key: log_key(collection, 2)?, value: Some(take stored), prior: 0, trim: None)
    let mut tree = share_page_tree(db.heads[0u64].roots.collections)
    replay_tiered_op("j-1", mut tree, mut draw, mut account, ReplayOrigin(ordinal: 1, branch: 0), ReplayDescriptor(rows: 3, row_bytes: 258, seq_bounds: None), inserted)?
    let deleted = JournalOp(key: log_key(collection, 3)?, value: None, prior: 7, trim: None)
    replay_tiered_op("j-1", mut tree, mut draw, mut account, ReplayOrigin(ordinal: 2, branch: 0), ReplayDescriptor(rows: 4, row_bytes: 344, seq_bounds: None), deleted)?
    db.heads[0u64].roots.collections = take tree
    db.next_node = draw - 1
    Ok(())
}

fn l62_snapshot_scan_reads(db: Db, rows_handle: Table[u64, u32]) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    let mut forward = scan(read_handle, s, rows_handle, Unbounded, Unbounded)?
    if next(read_handle, mut forward)? != Some((1u64, 10u32)) ||
        next(read_handle, mut forward)? != Some((2u64, 20u32)) ||
        next(read_handle, mut forward)? != Some((5u64, 50u32)) ||
        next(read_handle, mut forward)? != None ||
        next(read_handle, mut forward)? != None {
        fail("L62: a forward scan must merge Cold rows with replay puts and deletes")
    }
    let mut backward = scan_reverse(read_handle, s, rows_handle, Included(2u64), Excluded(5u64))?
    if next(read_handle, mut backward)? != Some((2u64, 20u32)) ||
        next(read_handle, mut backward)? != None {
        fail("L62: a reverse scan must resume below its last key within the bounds")
    }
    let mut reverse_all = scan_reverse(read_handle, s, rows_handle, Unbounded, Unbounded)?
    if next(read_handle, mut reverse_all)? != Some((5u64, 50u32)) ||
        next(read_handle, mut reverse_all)? != Some((2u64, 20u32)) ||
        next(read_handle, mut reverse_all)? != Some((1u64, 10u32)) ||
        next(read_handle, mut reverse_all)? != None {
        fail("L62: a reverse scan must include surviving Cold rows on both sides of the overlay")
    }
    Ok(())
}

fn l62_tiered_scan_fixture(d: Dir, c: Clock, tasks: Tasks, read: scoped[view] fn(Db, Table[u64, u32]) -> Result[(), Error] waits) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let mut db = test_db(c, 2147483648)
    let _ = create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u32()))?
    let rows_handle = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u32())?
    let Committed(_) = run(mut db, None, copy_env(rows_handle), fn(mut tx: Tx, handle: Table[u64, u32]) -> Result[(), Error] {
        put(mut tx, handle, 1u64, 10u32)?
        put(mut tx, handle, 3u64, 30u32)?
        put(mut tx, handle, 5u64, 50u32)
    })? else {
        fail("L62: fixture inserts did not commit")
    }
    let collection = rows_handle.id
    l62_prepare_snapshot_pages(mut db, fixtures, collection, 8)?
    l62_prepare_scan_overlay(mut db, rows_handle)?
    let funding = TieredPagerFunding(cache_bytes: 32 * 1048576, writer_pin_bytes: 0, pager_task_bytes: 1048576)
    let (take requests, take worker) = start_tiered_pager(tasks, db.store, open_number(db), PagerDirectory(fixtures), funding, 4)?
    db.pager = Some(take requests)
    let answer = read(db, rows_handle)
    db.pager = None
    let _ = result.unwrap(task.join(take worker))
    answer
}

@test
fn test_l62_snapshot_scan_merges_cold_and_replayed_rows(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    l62_tiered_scan_fixture(d, c, tasks, l62_snapshot_scan_reads)
}

fn l62_snapshot_page_reads(db: Db, rows_handle: Table[u64, u32]) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    let first = scan_page(read_handle, s, rows_handle, Unbounded, Unbounded, Limits(rows: 1, byte_limit: 1))?
    if list.len(first.rows) != 1 || first.rows[0u64] != (1u64, 10u32) || first.byte_count != 18 {
        fail("L62: a one-row page admits the first row even when it exceeds the byte limit")
    }
    let Some(first_resume) = view first.next else {
        fail("L62: first page has more visible rows")
    }
    let limit = Limits(rows: 10, byte_limit: 18)
    let Paged(second) = scan_next(read_handle, s, rows_handle, clone(first_resume), limit)? else {
        fail("L62: a resume belongs to the same snapshot")
    }
    if list.len(second.rows) != 1 || second.rows[0u64] != (2u64, 20u32) || second.byte_count != 18 {
        fail("L62: the next page picks the replay put and respects the byte limit")
    }
    let Some(second_resume) = view second.next else {
        fail("L62: the byte-limited page must keep its resume")
    }
    let Paged(final_page) = scan_next(read_handle, s, rows_handle, clone(second_resume), limit)? else {
        fail("L62: a resume belongs to the same snapshot")
    }
    if list.len(final_page.rows) != 1 || final_page.rows[0u64] != (5u64, 50u32) || final_page.byte_count != 18 {
        fail("L62: resume excludes the replay tombstone and returns the last Cold row")
    }
    if let Some(_) = final_page.next {
        fail("L62: an exhausted page has no resume")
    }
    Ok(())
}

@test
fn test_l62_snapshot_pages_resume_the_tiered_range(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    l62_tiered_scan_fixture(d, c, tasks, l62_snapshot_page_reads)
}

fn l62_index_parity(value: u32) -> Result[u32, Capacity] {
    Ok(value % 2)
}

fn l62_snapshot_index_reads(db: Db, parity: Index[u32, u64, u32, ()]) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    let mut odds = find(read_handle, s, parity, Included(1u32), Included(1u32))?
    if next(read_handle, mut odds)? != Some((1u64, 43u32)) ||
        next(read_handle, mut odds)? != Some((3u64, 39u32)) ||
        next(read_handle, mut odds)? != None {
        fail("L62: a Cold index scan must read the matching primary row for each index entry")
    }
    Ok(())
}

fn l62_replay_index_owner(mut db: Db, rows_handle: Table[u64, u32]) -> Result[(), Error] {
    let mut data = share_page_tree(db.heads[0u64].roots.collections)
    let mut draw = stamp_after(db.next_node)?
    let mut account = ReplayTieredAccount(total: 258, exact: true, ordinal: 0)
    let mut stored: Bytes = list.with_capacity(6)
    list.put_word_le(mut stored, rows_handle.readers.current)
    list.put_word_le(mut stored, 43u32)
    let edited = JournalOp(key: log_key(rows_handle.id, 1)?, value: Some(take stored), prior: 7, trim: None)
    replay_tiered_op("j-1", mut data, mut draw, mut account, ReplayOrigin(ordinal: 1, branch: 0), ReplayDescriptor(rows: 3, row_bytes: 258, seq_bounds: None), edited)?
    db.heads[0u64].roots.collections = take data
    db.next_node = draw - 1
    Ok(())
}

@test
fn test_l62_snapshot_find_reads_cold_index_and_primary(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let mut db = test_db(c, 2147483648)
    let _ = create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u32()))?
    let rows_handle = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u32())?
    let Committed(_) = run(mut db, None, copy_env(rows_handle), fn(mut tx: Tx, handle: Table[u64, u32]) -> Result[(), Error] {
        put(mut tx, handle, 1u64, 41u32)?
        put(mut tx, handle, 2u64, 40u32)?
        put(mut tx, handle, 3u64, 39u32)
    })? else {
        fail("L62: index fixture rows must commit")
    }
    let _ = create_index(mut db, rows_handle, "parity", code.describe(l62_index_parity), std.codec.key_u32())?
    let parity = bind_table_index(mut db, rows_handle, "parity", code.describe(l62_index_parity), std.codec.key_u32())?
    let data_id = rows_handle.id
    let index_id = parity.id
    l62_prepare_snapshot_pages(mut db, fixtures, data_id, 8)?
    l62_prepare_snapshot_pages(mut db, fixtures, index_id, 9)?
    l62_replay_index_owner(mut db, rows_handle)?
    let funding = TieredPagerFunding(cache_bytes: 32 * 1048576, writer_pin_bytes: 0, pager_task_bytes: 1048576)
    let (take requests, take worker) = start_tiered_pager(tasks, db.store, open_number(db), PagerDirectory(fixtures), funding, 4)?
    db.pager = Some(take requests)
    let answer = l62_snapshot_index_reads(db, parity)
    db.pager = None
    let _ = result.unwrap(task.join(take worker))
    answer
}

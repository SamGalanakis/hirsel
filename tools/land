def say(message):
    print(f'land: {message}', flush=True)


class Member:
    """A ticket in a batch: its lane and the commit it lands."""

    def __init__(self, ticket, lane, head, record=None):
        self.ticket, self.lane, self.head, self.record = ticket, lane, head, record

    def __repr__(self):
        return f'{self.lane} (ticket {int(self.ticket)})'


def git(*arguments):
    return subprocess.run(['git', *arguments], cwd=ROOT, capture_output=True, text=True, env=os.environ | ENV)


# Linux's generic ticket lock (include/asm-generic/ticket_spinlock.h:33-49,
# 63-69) allocates increasing tickets and serves only the oldest. Here a
# short flock makes allocation/publication atomic; files allow crash recovery
# and sleeping waiters instead of a CPU spin. See docs/landing.md.
class LandQueue:
    EXPIRES = 15 * 60
    HEARTBEAT = 10

    def __init__(self, lane):
        common = git('rev-parse', '--path-format=absolute', '--git-common-dir')
        if common.returncode or not common.stdout.strip():
            raise ValueError('cannot locate the common git directory')
        self.directory = Path(common.stdout.strip()) / 'land-queue'
        self.directory.mkdir(exist_ok=True)
        self.lane = lane or SOURCE.name
        self.identity = self.process(os.getpid())
        self.ticket = None
        self.record = {}
        # What a batch head delivered to this waiting ticket: its exit code and lines.
        self.result = None
        self.stop = threading.Event()
        self.lost = threading.Event()
        self.worker = None

    @staticmethod
    def process(pid):
        # /proc stat's start ticks distinguish PID reuse; boot_id distinguishes
        # reboots. Never inspect command lines. Zombies count as dead holders.
        try:
            fields = Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()
            if fields[0] in ('Z', 'X'):
                return None
            return (Path('/proc/sys/kernel/random/boot_id').read_text().strip(), fields[19])
        except (OSError, IndexError):
            return None

    @contextmanager
    def locked(self):
        with (self.directory / 'lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(lock, fcntl.LOCK_UN)

    def write(self, path, value):
        # All writers hold locked(); readers see complete files, even at death.
        temporary = self.directory / '.pending'
        temporary.write_text(json.dumps(value) + '\n')
        temporary.replace(path)

    def tickets(self):
        return sorted((p for p in self.directory.iterdir() if p.name.isdecimal()),
                      key=lambda p: int(p.name))

    def withdraw(self):
        """Signal only this checkout's tickets, pinned to their recorded process identity."""
        sent = 0
        with self.locked():
            for path in self.tickets():
                record = json.loads(path.read_text())
                worktree = record.get('worktree')
                # A worktree path is authoritative, even if a lane name was reused.
                if (Path(worktree).resolve() != SOURCE if worktree else
                        record.get('lane') != self.lane):
                    continue
                pid = record['pid']
                if not isinstance(pid, int) or pid <= 0:
                    say(f'refused ticket {path.name}: invalid pid')
                    continue
                try:
                    # Pin the process before checking /proc: PID reuse between
                    # the check and the signal must never target a new process.
                    descriptor = os.pidfd_open(pid)
                except ProcessLookupError:
                    say(f'refused ticket {path.name} pid {pid}: process is gone')
                    continue
                try:
                    identity = self.process(pid)
                    if identity is None or identity != tuple(record['process_start']):
                        say(f'refused ticket {path.name} pid {pid}: process start does not match')
                        continue
                    try:
                        signal.pidfd_send_signal(descriptor, signal.SIGTERM)
                    except ProcessLookupError:
                        continue
                    say(f'withdrew ticket {path.name} pid {pid}')
                    sent += 1
                finally:
                    os.close(descriptor)
        if not sent:
            say('nothing is queued for this checkout')
        return 0

    def stale(self, record):
        if self.process(record['pid']) != tuple(record['process_start']):
            return 'dead process'
        if time.time() - record['heartbeat'] > self.EXPIRES:
            return 'heartbeat older than 15 minutes'
        return None

    def refresh(self):
        if self.ticket is None or not self.ticket.exists():
            self.lost.set()
            return False
        record = json.loads(self.ticket.read_text())
        if (record['pid'] != os.getpid() or tuple(record['process_start']) != self.identity
                or record['worktree'] != str(SOURCE) or self.stale(record)):
            self.lost.set()
            return False
        record['heartbeat'] = time.time()
        self.write(self.ticket, record)
        self.record = record
        return True

    def heartbeat(self):
        while not self.stop.wait(self.HEARTBEAT):
            try:
                with self.locked():
                    if not self.refresh():
                        return
            except (OSError, ValueError, KeyError):
                self.lost.set()
                return

    def owns_head(self):
        with self.locked():
            return (not self.lost.is_set() and self.refresh()
                    and self.tickets()[0] == self.ticket)

    def __enter__(self):
        try:
            with self.locked():
                inherited = os.environ.get('HIRSEL_LAND_TICKET', '')
                if inherited:
                    if not inherited.isdecimal():
                        raise ValueError('invalid inherited queue ticket')
                    self.ticket = self.directory / inherited
                    if not self.refresh():
                        raise ValueError('inherited queue ticket is no longer owned by this process')
                    outcome(lane=self.lane, ticket=self.ticket.name, submitted=self.record['head'])
                else:
                    if self.identity is None:
                        raise ValueError('cannot determine this process start time')
                    for path in self.tickets():
                        record = json.loads(path.read_text())
                        if (record['lane'] == self.lane or record['worktree'] == str(SOURCE)) and not self.stale(record):
                            raise ValueError(f'{self.lane} already has live ticket {path.name}')
                    submitted = revision('HEAD')
                    counter = self.directory / 'sequence'
                    sequence = max(int(counter.read_text()) if counter.exists() else 0,
                                   max((int(p.name) for p in self.tickets()), default=0)) + 1
                    self.write(counter, sequence)
                    self.ticket = self.directory / f'{sequence:020d}'
                    now = time.time()
                    # `head` is the commit a batch head lands for this ticket.
                    self.write(self.ticket, dict(pid=os.getpid(), process_start=self.identity,
                                                started=now, heartbeat=now, lane=self.lane,
                                                worktree=str(SOURCE), head=submitted))
                    outcome(lane=self.lane, ticket=self.ticket.name, submitted=submitted)
                    os.environ['HIRSEL_LAND_TICKET'] = self.ticket.name
                say(f'queued ticket {self.ticket.name} for {self.lane}')
            # Waiting tickets heartbeat too: a long queue never expires a live lane.
            self.worker = threading.Thread(target=self.heartbeat, daemon=True)
            self.worker.start()
            last = None
            announced = 0
            while True:
                with self.locked():
                    if self.lost.is_set() or not self.refresh():
                        raise ValueError('queue ticket expired or was removed; refusing to land')
                    if 'result' in self.record:
                        self.result = self.record['result']
                        return self
                    tickets = self.tickets()
                    while tickets[0] != self.ticket:
                        head = tickets[0]
                        record = json.loads(head.read_text())
                        reason = self.stale(record)
                        if not reason:
                            break
                        head.unlink()
                        say(f'reaped ticket {head.name} for {record["lane"]}: {reason}')
                        tickets.pop(0)
                    position = tickets.index(self.ticket) + 1
                    head_lane = json.loads(tickets[0].read_text())['lane']
                    status = (position, head_lane)
                    if status != last or time.monotonic() - announced >= 30:
                        say(f'queue position {position}; head {head_lane}')
                        last, announced = status, time.monotonic()
                    if position == 1:
                        return self
                self.stop.wait(1)
        except BaseException:
            self.__exit__(None, None, None)
            raise

    def claim(self, limit, branches, skip=()):
        """Up to `limit` live tickets behind this head, oldest first, each with the commit it lands.

        A ticket names its commit; one queued by an older tools/land is taken at
        its worktree's checked-out branch, read from the common git directory
        (`branches`). Dead or expired tickets are dropped; tickets that already
        have a result are skipped. Their worktrees are never touched.
        """
        members = []
        with self.locked():
            for path in self.tickets():
                if len(members) == limit:
                    break
                if int(path.name) <= int(self.ticket.name) or path.name in skip:
                    continue
                try:
                    record = json.loads(path.read_text())
                except (OSError, ValueError):
                    continue
                if 'result' in record:
                    continue
                if reason := self.stale(record):
                    path.unlink()
                    say(f'dropped ticket {path.name} for {record["lane"]} from the batch: {reason}')
                    continue
                head = record.get('head') or branches.get((record['worktree'], record['lane']))
                if head and head not in (m.head for m in members):
                    members.append(Member(path.name, record['lane'], head, record))
        return members

    def owned(self, member, record):
        return (record['pid'], tuple(record['process_start'])) == (member.record['pid'],
                                                                  tuple(member.record['process_start']))

    def live(self, members):
        """The members whose tickets are still queued by the same live process, without a result."""
        with self.locked():
            alive = []
            for member in members:
                try:
                    record = json.loads((self.directory / member.ticket).read_text())
                except (OSError, ValueError):
                    continue
                if (self.owned(member, record) and not self.stale(record) and 'result' not in record
                        and record.get('head', member.head) == member.head):
                    alive.append(member)
            return alive

    def deliver(self, member, result):
        """Hand a waiting ticket its outcome; its own process prints it and exits with its code."""
        with self.locked():
            # A revoked head hands out no verdicts; the ticket's next head decides.
            if self.lost.is_set() or not self.refresh() or self.tickets()[0] != self.ticket:
                return
            path = self.directory / member.ticket
            try:
                record = json.loads(path.read_text())
            except (OSError, ValueError):
                return
            if self.owned(member, record):
                record['result'] = result
                self.write(path, record)

    def __exit__(self, *ignored):
        self.stop.set()
        if self.worker:
            self.worker.join()
        with self.locked():
            if self.ticket and self.ticket.exists():
                record = json.loads(self.ticket.read_text())
                if record['pid'] == os.getpid() and tuple(record['process_start']) == self.identity:
                    self.ticket.unlink()
        os.environ.pop('HIRSEL_LAND_TICKET', None)


def outcome(**fields):
    """Publish wrapper metadata independently of human-readable log lines."""
    if name := os.environ.get('HIRSEL_LAND_RESULT_FILE'):
        path = Path(name)
        record = json.loads(path.read_text()) if path.exists() else {}
        submitted = 'ticket' in fields and 'ticket' not in record
        record.update(fields)
        temporary = path.with_suffix('.pending')
        temporary.write_text(json.dumps(record) + '\n')
        temporary.replace(path)
        if submitted:
            from land_events import append_event
            append_event(os.environ['HIRSEL_LAND_EVENTS'], 'SUBMITTED', record,
                         os.environ['HIRSEL_LAND_LOG'])


@contextmanager
def checkout(queue):
    """The train owns this detached checkout; the submitting lane keeps its branch."""
    global ROOT, BUCK2
    original, buck = ROOT, BUCK2
    directory = queue.directory.parent / 'land-checkouts'
    directory.mkdir(exist_ok=True)
    frozen = directory / queue.ticket.name
    inherited = os.environ.get('HIRSEL_LAND_CHECKOUT')
    if inherited:
        if Path(inherited).resolve() != frozen.resolve() or ROOT.resolve() != frozen.resolve():
            raise ValueError('inherited land checkout does not match its ticket')
    else:
        added = git('worktree', 'add', '--detach', str(frozen), queue.record['head'])
        if added.returncode:
            raise ValueError('cannot create land checkout: ' + added.stderr)
    try:
        ROOT, BUCK2 = frozen, str(frozen / '.buck2/bin/buck2')
        os.environ.update(HIRSEL_LAND_SOURCE=str(SOURCE), HIRSEL_LAND_CHECKOUT=str(frozen),
                          HIRSEL_LAND_BRANCH=queue.lane)
        os.chdir(frozen)
        say(f'frozen {queue.record["head"][:12]} in {frozen}; source checkout stays at {SOURCE}')
        yield
    finally:
        if Path(BUCK2).is_file():
            subprocess.run([BUCK2, 'kill'], cwd=frozen, capture_output=True)
        os.chdir(SOURCE)
        ROOT, BUCK2 = SOURCE, str(SOURCE / '.buck2/bin/buck2')
        removed = git('worktree', 'remove', '--force', str(frozen))
        if removed.returncode:
            say('cannot remove owned land checkout: ' + removed.stderr.strip())
        ROOT, BUCK2 = original, buck
        for key in ('HIRSEL_LAND_SOURCE', 'HIRSEL_LAND_CHECKOUT', 'HIRSEL_LAND_BRANCH'):
            os.environ.pop(key, None)


def revision(name):
    result = git('rev-parse', '--verify', name + '^{commit}')
    value = result.stdout.strip()
    if result.returncode or not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', value):
        raise ValueError(f'cannot resolve commit {name}: {result.stderr.strip()}')
    return value


def first_error(text, count=40):
    """The output from its first error line on (its tail when none is found)."""
    lines = text.splitlines()
    start = next((i for i, line in enumerate(lines) if re.match(r'\s*(error|Error|Diff in|Traceback)', line)),
                 max(0, len(lines) - count))
    return '\n'.join(lines[start:start + count])


def run(command):
    """Run a check in this worktree, in its own session so a withdrawal takes its Buck2 client with it."""
    process = subprocess.Popen(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                               env=rust_environment.environment(ROOT) | ENV, start_new_session=True)
    try:
        stdout, stderr = process.communicate()
    except BaseException:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except OSError:
            pass
        raise
    return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)


def check(name, command):
    """One check: None when it passes, else its report (which a batch hands to the ticket it blames)."""
    started = time.monotonic()
    done = run(command)
    say(f'{"pass" if done.returncode == 0 else "FAIL"}  {name} ({time.monotonic() - started:.3f} s)')
    if done.returncode == 0:
        return None
    error = first_error(done.stderr + done.stdout)
    print(error, flush=True)
    return [f'FAIL  {name}', *error.splitlines()]


def previous_tool_refusal():
    """Why main's tools/land could not check this tree, or None.

    A batch runs its head's tools/land, so every other change in it is checked
    by the tool already on main: a change that renames or removes a target
    that tool asks for would break the whole batch, and must keep the old name
    working in the same commit."""
    if (fetched := git('fetch', '-q', 'origin', 'main')).returncode:
        return 'git fetch failed\n' + fetched.stderr
    shown = git('show', 'origin/main:tools/land')
    names = sorted(set(NAMED.findall(shown.stdout))) if shown.returncode == 0 else []
    if not names:
        return None
    if (synced := run([PY, 'tools/buck2/sync.py', '--if-stale'])).returncode:
        return 'cannot generate build files\n' + first_error(synced.stderr + synced.stdout)
    missing = [name for name in names if run([BUCK2, 'uquery', *CONFIG, '//:' + name]).returncode]
    if missing:
        return ('main\'s tools/land checks this change in a batch and asks for '
                + ', '.join('//:' + name for name in missing) + ', which this tree lacks; keep the old name '
                'working (an alias or a suite) in the same change')
    return None


def move(tree):
    """Check out a tree detached in this worktree, which must stay clean."""
    if git('checkout', '-q', '--detach', tree).returncode or not unchanged(tree):
        raise Refusal(f'cannot check out {tree[:12]} cleanly; refusing to push')


def fast(tree):
    """The checks that take seconds (build files, line lists, fmt, source audits) on one tree: None or the first report."""
    move(tree)
    say(f'screening {tree[:12]} with the fast checks')
    report = (check('screen: prepare.py', [PY, 'tools/buck2/prepare.py'])
              or check('screen: sync.py --if-stale', [PY, 'tools/buck2/sync.py', '--if-stale'])
              or check('screen: independent line lists', [PY, 'tools/check-hot-files'])
              or check('screen: formatting', [PY, 'tools/buck2/fmt.py', '--check'])
              or check('screen: source audits', [BUCK2, 'test', *CONFIG, *SOURCE_AUDITS]))
    if not unchanged(tree):
        raise Refusal('the worktree changed during checks; refusing to push')
    return report


def full(tree, screened=False):
    """The gate on the checked-out tree: None or the first red check's report."""
    if not unchanged(tree):
        raise Refusal('the worktree changed before checks; refusing to push')
    report = None if screened else fast(tree)
    if report is None:
        # Buck2 serves one command at a time when another holds a different
        # state (a running `buck2 test` refuses even a same-config query), so
        # one build compiles everything the checks read: the workspace, the
        # Clippy reports and the manifests check's compiler and std products.
        # Clippy and the manifests run then only read and execute.
        queries = [run([BUCK2, 'uquery', *CONFIG, expression]) for expression in (BUILD_SET, CLIPPY_TWINS, MANIFESTS)]
        if any(query.returncode or not query.stdout.strip() for query in queries):
            failed = next(query for query in queries if query.returncode or not query.stdout.strip())
            report = ['FAIL  the build set query', *first_error(failed.stderr).splitlines()]
            say('\n'.join(report))
        else:
            manifests = queries[2].stdout.split()
            targets = [*queries[0].stdout.split(), *(t + '[clippy.txt]' for t in queries[1].stdout.split()),
                       *(t + '[inputs]' for t in manifests)]
            report = (check('workspace build', [PY, 'tools/buck2/event_logs.py', 'build', *CONFIG,
                                                '--materializations', 'none', *targets])
                      or check('Clippy', [PY, 'tools/buck2/clippy.py'])
                      or check('package and example manifests', [BUCK2, 'test', *CONFIG, *manifests]))
    # fast(tree) checked this exact tree's formatting (now or when screened);
    # fmt reads only tracked sources and the pinned rustfmt, so no rerun.
    if not unchanged(tree):
        raise Refusal('the worktree changed during checks; refusing to push')
    return report


def changed_paths(before, after):
    result = git('diff', '--no-renames', '--name-only', '-z', before, after)
    if result.returncode:
        raise ValueError('cannot compare trees')
    return set(result.stdout.rstrip('\0').split('\0')) - {''}


def row_only_move(before, after):
    """Every incoming commit changes only the failure ledger, including merge sides.

    Inspect history rather than its net diff: a source edit followed by a
    revert still takes the normal retry path. No movement is not a row push.
    """
    if before == after or git('merge-base', '--is-ancestor', before, after).returncode:
        return False
    paths = git('log', '--format=', '--name-only', '-z', '-m', '--no-renames', f'{before}..{after}')
    return paths.returncode == 0 and set(paths.stdout.rstrip('\0').split('\0')) == {'tools/known-failures.tsv'}


def unchanged(head):
    current = git('rev-parse', 'HEAD')
    status = git('status', '--porcelain')
    return current.returncode == status.returncode == 0 and current.stdout.strip() == head and not status.stdout.strip()


def backoff(attempt):
    # aws-samples/aws-arch-backoff-simulator src/backoff_simulator.py:24-25,40-43:
    # Full jitter; base=1 s, cap=30 s, exponent bounded before evaluation.
    # Bounded wait, unbounded attempts. Never reserve a shared resource here.
    delay = random.uniform(0, min(30.0, 2.0 ** min(attempt, 5)))
    say(f'main moved during the checks; rebasing again after {delay:.2f} s jitter')
    time.sleep(delay)


def transient_push(error):
    """Retry only server/connection failures, never a remote policy or client error."""
    error = error.lower()
    if any(marker in error for marker in ('[remote rejected]', 'hook declined', 'hook failed')):
        return False
    statuses = re.findall(r'(?:\bhttp(?:/[\d.]+)?(?: code| error| status)?[ :=]*|returned error:\s*|'
                          r'status(?: code)?[ :=]*)([45]\d\d)\b', error)
    if any(status.startswith('4') for status in statuses):
        return False
    return bool(statuses) or any(marker in error for marker in (
        'could not resolve host', 'could not resolve proxy', 'failed to connect',
        'connection reset', 'connection refused', 'connection timed out', 'operation timed out',
        'remote end hung up unexpectedly', 'unexpected disconnect', 'empty reply from server',
        'recv failure', 'send failure', 'gnutls_recv error', 'ssl_error_syscall',
    )) or bool(re.search(r'\brpc failed; curl (?:6|7|16|18|28|35|52|55|56|92)\b|'
                         r'http/2 stream .*not closed cleanly', error))


def rebase(base, *selection):
    """Replay source commits onto `base`; generated conflicts have no hand-written resolution.

    `selection` is `upstream commit` for a batch ticket: its commits after
    origin/main, replayed onto the batch so far without moving any branch.
    Ignored build inventories are removed from Git and sync.py regenerates
    them before checks. Committed pages keep main's generated version: their
    sole writer, main-runs, regenerates them on main after the push. Never
    create a lane commit containing a guessed or hand-merged generated page.
    """
    result = git('rebase', *(['--onto', base, *selection] if selection else [base]))
    while result.returncode:
        conflicts = git('diff', '--name-only', '--diff-filter=U').stdout.splitlines()
        if not conflicts or any(path not in generated.BUILD_INPUTS + generated.MAIN_WRITTEN
                                for path in conflicts):
            return result
        for path in conflicts:
            if path in generated.BUILD_INPUTS:
                resolved = git('rm', '-f', '--ignore-unmatch', '--', path)
            else:
                resolved = git('restore', f'--source={base}', '--staged', '--worktree', '--', path)
            if resolved.returncode:
                return resolved
            say(f'resolved generated conflict in {path}; its generator owns regeneration')
        result = git('-c', 'core.editor=true', 'rebase', '--continue')
    return result


class Refusal(Exception):
    """A reason to stop without pushing that blames no ticket."""


class Race(Exception):
    """A push rejected because main moved."""


def branches():
    """Each worktree's checked-out branch and its tip, from the common git directory."""
    found = {}
    for block in git('worktree', 'list', '--porcelain').stdout.split('\n\n'):
        fields = dict(line.partition(' ')[::2] for line in block.splitlines())
        if fields.get('branch', '').startswith('refs/heads/') and fields.get('HEAD'):
            found[(fields.get('worktree'), fields['branch'].removeprefix('refs/heads/'))] = fields['HEAD']
    return found


class Batch:
    """One attempt's merge train: the head's commits, then each waiting ticket's, on one origin/main.

    bors-ng batches every waiting change into one build and pushes it in one
    push, then bisects a red batch into halves (lib/worker/batcher.ex:10-22;
    lib/worker/batcher/divider.ex:9-27, 89-94; bors-ng ca725797). Zuul's
    dependent pipeline tests each change on the changes ahead of it, and a
    change that does not merge leaves the queue while the rest move onto the
    nearest non-failing item (zuul/manager/__init__.py:1955-1972; zuul
    3daef6c4). GitHub's merge queue groups up to a maximum number of pull
    requests per merge group and removes only a failing one ("Managing a
    merge queue", merge limits). LUCI CV, the Chromium CQ, gives every
    verdict to one change and retries failed tryjobs before blaming it
    (cv/internal/tryjob/execute/retry.go:43-60; luci-go f46b764f). Here a
    ticket is blamed only by a red check of its own change on a green tree,
    never by elimination, so a red that does not repeat blames no one and the
    batch lands. Every pushed tree is one this attempt checked green, on
    exactly the tip it is pushed onto.
    """

    def __init__(self, queue, main_sha, members, attempt):
        self.queue, self.main, self.attempt = queue, main_sha, attempt
        self.own = members[0]
        # The head's own failure, printed when the batch is done.
        self.verdict = None
        self.checked = 0
        self.screened = set()
        # The members each applied tree holds, and the conflicts against batched changes,
        # which stand only if every change ahead of the ticket lands.
        self.contents = {main_sha: ()}
        self.conflicts = []
        # The tickets pushed so far in this attempt, in push order, with their commits.
        self.landed = []
        self.pushed = main_sha
        # The last green check, kept if its push loses a race: (base, tree, submitted heads).
        self.proof = None

    def fail(self, member, code, message, report=()):
        if member is self.own:
            self.verdict = message
        else:
            say(f'ticket {int(member.ticket)} for {member.lane}: {message}')
            self.queue.deliver(member, dict(code=code, message=message, report=list(report)))

    def apply(self, base, members):
        """Replay each member's commits after origin/main, in order, onto base, without moving a branch."""
        if git('status', '--porcelain').stdout.strip():
            raise Refusal('the worktree changed during checks; refusing to push')
        done = {member for member, _ in self.landed}
        tip, applied = base, []
        for member in members:
            result = rebase(tip, self.main, member.head)
            if result.returncode:
                conflicts = git('diff', '--name-only', '--diff-filter=U').stdout.split()
                git('rebase', '--abort')
                ahead = self.contents[tip]
                message = ('the rebase onto origin/main'
                           + (f' and the batched {", ".join(m.lane for m in ahead)}' if ahead else '')
                           + ' conflicts in: ' + (', '.join(conflicts) or 'see the rebase output above')
                           + '; rebase by hand, resolve, then run tools/land again')
                report = [] if conflicts else (result.stderr + result.stdout).strip().splitlines()[-20:]
                if set(ahead) <= done:
                    self.fail(member, 1, message, report)
                else:
                    say(f'ticket {int(member.ticket)} for {member.lane}: {message}; it stands if the batch'
                        ' ahead of it lands')
                    self.conflicts.append((member, ahead, message, report))
                continue
            new = revision('HEAD')
            diff = git('diff', '--name-only', '--diff-filter=d', tip, new)
            commits = git('rev-list', '--reverse', f'{tip}..{new}').stdout.split()
            if diff.returncode:
                self.fail(member, 1, 'cannot inspect the lane change; refusing to push')
            elif refused := generated.refusal(diff.stdout.splitlines()):
                self.fail(member, 1, refused[-1], refused[:-1])
            elif not commits:
                self.fail(member, 0, 'nothing to land; HEAD is on origin/main')
            else:
                applied.append((member, commits))
                self.contents[new] = self.contents[tip] + (member,)
                tip = new
        if git('checkout', '-q', '--detach', tip).returncode:
            raise Refusal('cannot check out the batch; refusing to push')
        return tip, applied

    def red(self, member, report):
        self.fail(member, 1, 'refusing to push a red tree' + (
            '' if member is self.own else
            f' (checked by itself on origin/main {self.main[:12]} and the green changes batched'
            f' ahead of it, in the batch led by {self.own.lane})'), report)

    def screen(self, base, members):
        """Drop each ticket whose own change fails the fast checks, before any build.

        The combined tree runs them first. When it is red, a binary search
        over the batch's cumulative trees finds the first ticket that turns
        them red, on a tree that passes them without it; that ticket leaves
        with its first error, and the rest are screened again. The fast checks
        are the full checks' own scripts, so the screen is never stricter.
        """
        while True:
            tip, applied = self.apply(base, members)
            members = [member for member, _ in applied]
            if not applied:
                return members
            if not (report := fast(tip)):
                self.screened.add(git('rev-parse', tip + '^{tree}').stdout.strip())
                return members
            if len(applied) == 1:
                self.red(members[0], report)
                return []
            if fast(base):
                say('the base fails the fast checks itself; the screen blames no ticket')
                return members
            # trees[i] holds the first i tickets: trees[low] passes, trees[high] fails.
            trees = [base, *(commits[-1] for _, commits in applied)]
            low, high = 0, len(applied)
            while high - low > 1:
                middle = (low + high) // 2
                if found := fast(trees[middle]):
                    high, report = middle, found
                else:
                    low = middle
            culprit = members[high - 1]
            self.red(culprit, report)
            members.remove(culprit)

    def confirm_push(self, tip):
        """Reconcile a failed push against a fetched remote, never a cached ref."""
        fetched = git('fetch', '-q', 'origin', 'main')
        if fetched.returncode:
            raise Refusal('cannot confirm failed push: git fetch failed\n' + fetched.stderr)
        remote = revision('origin/main')
        contains = git('merge-base', '--is-ancestor', tip, remote)
        if contains.returncode == 0:
            say(f'origin/main contains {tip[:12]}; the failed push completed')
            return True
        if contains.returncode != 1:
            raise Refusal('cannot determine whether origin/main contains the failed push')
        if remote != self.pushed:
            raise Race()
        return False

    def publish(self, tip, landed):
        """Push a green tip at once, and hand each ticket it newly lands its commits."""
        done = {member for member, _ in self.landed}
        fresh = [(member, commits) for member, commits in landed if member not in done]
        if not fresh:
            return
        for attempt in range(2):
            if attempt:
                # The same full-jitter algorithm as backoff(), bounded to one
                # wait of at most 30 s. Fetch again after waiting: main
                # or the result of an ambiguous push may have moved meanwhile.
                delay = random.uniform(0, 30 * 2 ** (attempt - 1))
                say(f'transient push failure; retry {attempt + 1}/2 after {delay:.2f} s jitter')
                time.sleep(delay)
                if self.confirm_push(tip):
                    break
            # Push the checked commit explicitly; HEAD may never select a new tree.
            if not self.queue.owns_head():
                raise Refusal('queue ownership lost; refusing to push')
            if not unchanged(tip):
                raise Refusal('the worktree changed before push; refusing to push')
            left = [member for member, _ in fresh if member is not self.own]
            if set(self.queue.live(left)) != set(left):
                raise Race()
            pushed = git('push', 'origin', f'{tip}:refs/heads/main')
            if not pushed.returncode:
                break
            if any(marker in pushed.stderr for marker in REJECTED):
                raise Race()
            if not transient_push(pushed.stderr):
                raise Refusal('git push failed\n' + pushed.stderr)
            if self.confirm_push(tip):
                break
        else:
            raise Refusal('git push failed after 2 attempts\n' + pushed.stderr)
        common = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir').stdout.strip())
        at = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
        with open(common / LANDINGS, 'a') as log:
            for member, commits in fresh:
                log.write(json.dumps(dict(landed=commits[-1], pushed=tip, base=self.pushed, branch=member.lane,
                                          unchecked_rebase=False, at=at), sort_keys=True) + '\n')
        self.landed += fresh
        self.pushed = tip
        done |= {member for member, _ in fresh}
        for conflict in list(self.conflicts):
            member, ahead, message, report = conflict
            if set(ahead) <= done:
                self.conflicts.remove(conflict)
                self.fail(member, 1, message, report)
        for member, commits in fresh:
            if member is self.own:
                outcome(landed=commits[-1])
            else:
                self.queue.deliver(member, dict(
                    code=0, report=[], commits=commits,
                    message=f'landed {commits[-1][:12]} on main in a batch of {len(fresh)} led by '
                            f'{self.own.lane} ({self.checked} checks): ' + ' '.join(commits)))
        if len(fresh) > 1 or self.checked > 1:
            say(f'pushed {tip[:12]} with {len(fresh)} tickets: ' + ', '.join(str(m) for m, _ in fresh))

    def green(self, tree, applied, base):
        """One full check of the checked-out tree: None when it passed, else its report."""
        if len(applied) == 1:
            tickets = '' if applied[0][0] is self.own else f' with {applied[0][0]}'
        else:
            tickets = f' with {len(applied)} tickets: ' + ', '.join(str(member) for member, _ in applied)
        say(f'attempt {self.attempt}: checking {tree[:12]} on origin/main {base[:12]}' + tickets)
        tree_id = git('rev-parse', tree + '^{tree}')
        return full(tree, tree_id.returncode == 0 and tree_id.stdout.strip() in self.screened)

    def resolve(self, members, previous=None):
        """Check groups of tickets one at a time and push each green one at once.

        A group is checked on the tip pushed so far; a green group is pushed
        at once. A red group splits in halves, checked in ticket order; a red
        ticket alone is a culprit. Returns the pushed tip.
        """
        if previous and row_only_move(previous[0], self.main):
            # Finish the checked cohort. New arrivals get their own batch;
            # they must neither invalidate this pass nor inherit it.
            left = [member for member in members if member is not self.own]
            live = set(self.queue.live(left)) | {self.own}
            members = [member for member in members if member in live
                       and previous[2].get(member.ticket) == member.head]
            submitted = {member.ticket: member.head for member in members}
            if submitted and list(submitted.items()) == list(previous[2].items())[:len(submitted)]:
                tree, applied = self.apply(self.main, members)
                members = [member for member, _ in applied]
                left = [member for member in members if member is not self.own]
                if ({member.ticket: member.head for member in members} == submitted
                        and set(self.queue.live(left)) == set(left)
                        and changed_paths(previous[1], tree) <= {'tools/known-failures.tsv'}):
                    if not unchanged(tree):
                        raise Refusal('the worktree changed after rebase; refusing to push')
                    say('main moved only by known-failures rows; clean rebase reuses all passed checks')
                    self.proof = (self.main, tree, submitted)
                    self.publish(tree, applied)
                    return self.pushed
        members = self.screen(self.main, members)
        pending = [members] if members else []
        while pending:
            group = pending.pop(0)
            # A ticket withdrawn since the batch formed is not built again.
            left = [member for member in group if member is not self.own]
            if gone := set(left) - set(self.queue.live(left)):
                say('withdrawn, so not checked again: ' + ', '.join(map(str, gone)))
                if not (group := [member for member in group if member not in gone]):
                    continue
            base = self.pushed
            tree, applied = self.apply(base, group)
            if not applied:
                continue
            self.checked += 1
            report = self.green(tree, applied, base)
            group = [member for member, _ in applied]
            if not report:
                left = [m for m in group if m is not self.own]
                if gone := set(left) - set(self.queue.live(left)):
                    say('a batched ticket left the queue during the checks; checking again'
                        ' without ' + ', '.join(map(str, gone)))
                    if rest := [m for m in group if m not in gone]:
                        pending.insert(0, rest)
                else:
                    self.proof = (base, tree, {member.ticket: member.head for member in group})
                    self.publish(tree, applied)
            elif len(group) == 1:
                self.red(group[0], report)
            else:
                half = len(group) // 2
                say(f'red batch; bisecting into {", ".join(map(str, group[:half]))} and '
                    f'{", ".join(map(str, group[half:]))}')
                pending[:0] = [group[:half], group[half:]]
        return self.pushed


def delivered(queue):
    """Print the outcome a batch head handed this waiting ticket and exit with its code."""
    result = queue.result
    if result['report']:
        print('\n'.join(result['report']), flush=True)
    say(result['message'])
    if commits := result.get('commits'):
        outcome(landed=commits[-1])
    return result['code']


class Withdrawn(BaseException):
    """SIGTERM unwinds the queue and active checks before the client exits."""


def withdraw_signal(signum, frame):
    # A repeated withdrawal must not interrupt cleanup.
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    raise Withdrawn()


def main():
    if sys.argv[1:] == ['--withdraw']:
        try:
            return LandQueue(git('branch', '--show-current').stdout.strip()).withdraw()
        except (OSError, ValueError, KeyError) as error:
            say(f'withdraw failed: {error}')
            return 1
    if sys.argv[1:]:
        print(__doc__, file=sys.stderr)
        return 2
    status = git('status', '--porcelain')
    if not os.environ.get('HIRSEL_LAND_TICKET') and (status.returncode or status.stdout.strip()):
        say('the worktree has uncommitted changes; commit them first')
        return 1
    try:
        rust_environment.environment(ROOT, validate=True)
    except ValueError as error:
        say(str(error))
        return 1
    merging.install(ROOT)
    if not os.environ.get('HIRSEL_LAND_TICKET') and (refusal := previous_tool_refusal()):
        say(refusal)
        return 1
    branch = os.environ.get('HIRSEL_LAND_BRANCH') or git('branch', '--show-current').stdout.strip()
    previous_signal = signal.signal(signal.SIGTERM, withdraw_signal)
    try:
        with LandQueue(branch) as queue:
            if queue.result:
                return delivered(queue)
            with checkout(queue):
                return land(queue)
    except Withdrawn:
        say('withdrawn; queue ticket released')
        return 128 + signal.SIGTERM
    except (OSError, ValueError) as error:
        say(f'queue failed: {error}')
        return 1
    finally:
        signal.signal(signal.SIGTERM, previous_signal)


def land(queue):
    head = revision('HEAD')
    try:
        return train(queue)
    except BaseException:
        git('rebase', '--abort')
        git('checkout', '-q', '--detach', head)
        raise


def train(queue):
    started = time.monotonic()
    # Kept across the re-exec into a rebased tree's own tools/land.
    first = int(os.environ.get('HIRSEL_LAND_ATTEMPT', '1'))
    # The last green check whose push lost a race, which a row-only main move can reuse.
    previous = None
    for attempt in itertools.count(first):
        if not queue.owns_head():
            say('queue ownership lost; refusing to land')
            return 1
        if (fetched := git('fetch', '-q', 'origin', 'main')).returncode:
            say('git fetch failed\n' + fetched.stderr)
            return 1
        main_sha = revision('origin/main')
        # An edited lane needs checks. Only our own successful rebase may
        # advance its submitted head while carrying a previous batch pass.
        if previous and previous[2].get(queue.ticket.name) != revision('HEAD'):
            previous = None
        if rebase(main_sha).returncode:
            conflicts = git('diff', '--name-only', '--diff-filter=U').stdout.split()
            git('rebase', '--abort')
            say('the rebase onto origin/main conflicts in: ' + (', '.join(conflicts) or 'see git rebase')
                + '; rebase by hand, resolve, then run tools/land again')
            return 1
        diff = git('diff', '--name-only', '--diff-filter=d', f'{main_sha}...HEAD')
        if diff.returncode:
            say('cannot inspect the lane change; refusing to push')
            return 1
        changed = diff.stdout.splitlines()
        if refused := generated.refusal(changed):
            print('\n'.join('land: ' + line for line in refused), flush=True)
            return 1
        head = revision('HEAD')
        if previous:
            previous[2][queue.ticket.name] = head
        if head == main_sha:
            outcome(landed=head)
            say('nothing to land; HEAD is on origin/main')
            return 0
        # Run the rebased tree's own land, so a landed fix to it holds at once.
        if (ROOT / 'tools/land').read_bytes() != SELF:
            say('the rebased tree has another tools/land; running it')
            os.environ.update(HIRSEL_LAND_ATTEMPT=str(attempt))
            os.execv(PY, [PY, str(ROOT / 'tools/land')])
        if not unchanged(head):
            say('the worktree changed before checks; refusing to push')
            return 1
        waiting = [member for member in queue.claim(BATCH - 1, branches())
                   if git('cat-file', '-e', member.head + '^{commit}').returncode == 0]
        members = [Member(queue.ticket.name, queue.lane, head), *waiting]
        if waiting:
            say(f'batch of {len(members)} tickets: ' + ', '.join(map(str, members)))
        batch = Batch(queue, main_sha, members, attempt)

        def restore():
            # Return to the head ticket's rebased submission in the owned checkout.
            git('checkout', '-q', '--detach', head)

        try:
            tip = batch.resolve(members, previous)
            previous = None
        except (Race, Refusal) as error:
            previous = batch.proof
            restore()
            own = [commits for member, commits in batch.landed if member is batch.own]
            if isinstance(error, Refusal):
                say(str(error))
            if own:
                # The tickets not yet pushed keep their places; the next head lands them.
                outcome(landed=own[0][-1])
                say(f'landed {own[0][-1][:12]} on main in {time.monotonic() - started:.0f} s, before the'
                    ' rest of its batch')
                return 0
            if isinstance(error, Refusal):
                return 1
            if batch.verdict:
                say(batch.verdict)
                return 1
            backoff(attempt)
            continue
        if tip == main_sha:
            restore()
            say(batch.verdict or 'refusing to push a red tree')
            return 1
        for member, _, _, _ in batch.conflicts:
            say(f'ticket {int(member.ticket)} for {member.lane} stays queued: it conflicted only with'
                ' a batch that did not land whole')
        landed = batch.landed
        summary = (f' in a batch of {len(landed)} with {batch.checked} checks; main is {tip[:12]}'
                   if len(landed) > 1 or batch.checked > 1 else '')
        if batch.verdict:
            restore()
            say(f'landed the rest of the batch{summary}')
            say(batch.verdict)
            return 1
        [own] = [commits for member, commits in landed if member is batch.own]
        outcome(landed=own[-1])
        say(f'landed {own[-1][:12]} on main in {time.monotonic() - started:.0f} s{summary}')
        return 0


if __name__ == '__main__':
    sys.exit(main())

type StagedPacket {
    number: u64,
    crypto_end: u64,
    ack: bool,
    done: bool,
    close: bool,
    eliciting: bool
}

fn tx_space(mut s: Space, kind: codec.PacketKind, dest: Bytes, source: Bytes, done: bool, closing: Option[CloseFrame], limit: u64, mut out: Bytes) -> Option[StagedPacket] {
    if let None = s.send {
        return None
    }
    let padding = if kind == Initial {
        1200u64
    } else {
        0u64
    }
    let header_bound = 14 + list.len(dest) + list.len(source)
    if limit < padding || limit <= header_bound + 16 {
        return None
    }
    let cap = limit - header_bound - 16
    let mut payload: Bytes = list.with_capacity(cap)
    let mut crypto_end = s.crypto_committed
    let mut ack = false
    let mut done_sent = false
    let mut closed = false
    if let Some(f) = closing {
        let len = order.min(list.len(f.reason), cap - order.min(cap, 27))
        let reason = codec.Span(at: 0, len: len)
        let frame: codec.Frame = if f.application && kind == OneRtt {
            ApplicationClose(code: f.code, reason: reason)
        } else if f.application {
            TransportClose(code: 0x0c, frame_type: 0, reason: codec.Span(at: 0, len: 0))
        } else {
            TransportClose(code: f.code, frame_type: f.frame, reason: reason)
        }
        if let Error(_) = codec.write_frame(frame, f.reason, mut payload) {
            return None
        }
        closed = true
    } else {
        if s.ack_pending {
            let mut count = list.len(s.received)
            while count > 0 {
                let ranges: List[codec.AckRange] = clone(list.slice(s.received, 0, count))
                let f: codec.Frame = Ack(codec.AckFields(delay: 0, ranges: take ranges, ecn: None))
                if let Ok(()) = codec.write_frame(f, b"", mut payload) {
                    ack = true
                    break
                }
                count -= 1
            }
        }
        if done && list.len(payload) < cap {
            if let Ok(()) = codec.write_frame(HandshakeDone, b"", mut payload) {
                done_sent = true
            }
        }
        if list.len(s.crypto_out) > s.crypto_committed && cap - list.len(payload) > 17 {
            let len = order.min(list.len(s.crypto_out) - s.crypto_committed, cap - list.len(payload) - 17)
            let frame: codec.Frame = Crypto(offset: s.crypto_committed, data: codec.Span(at: s.crypto_committed, len: len))
            if let Ok(()) = codec.write_frame(frame, s.crypto_out, mut payload) {
                crypto_end += len
            }
        }
    }
    if list.len(payload) == 0 {
        return None
    }
    let Some(number) = seal_packet(mut s, kind, dest, source, payload, padding, mut out) else {
        return None
    }
    Some(StagedPacket(number: number, crypto_end: crypto_end, ack: ack, done: done_sent, close: closed, eliciting: done_sent || crypto_end > s.crypto_committed))
}

fn commit_space(mut s: Space, p: StagedPacket) {
    record_sent(mut s, p.number)
    s.crypto_committed = p.crypto_end
    s.ack_pending = s.ack_pending && !p.ack
}

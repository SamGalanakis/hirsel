// LANG-6, OWN-8 (Q31): a temporary in a block's tail, a function body's or an inner
// block's, ends at that block's exit before its locals are cleaned, unless the block's
// value reaches it; the view `list.get` returns does not outlive `xs`, since the value is
// a `u64`. (The value reaching it is the Q28 case, own/drop-frozen.)

// expect: gap cleanup of own values is not built
// expect: gap values of this type are not built
fn present(o: Option[View[u64]]) -> u64 { 0 }
fn f() -> u64 { let xs: List[u64] = list.new(); present(list.get(xs, 0)) }
fn g() -> u64 {
    let b = { let xs: List[u64] = list.new(); present(list.get(xs, 0)) }; b
}

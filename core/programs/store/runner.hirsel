// ---- L16 (rows_normalized, RUNNER-SPEC v2.11.1 §3 Rows): a Row's key is the table id
// big-endian ‖ the key codec, and its value is the table's current value codec without the
// stored u16 schema prefix. 257 pad tables take ids 1..257, so "accounts" is 0x00000102,
// whose bytes differ under the two byte orders. Its row 1 is stored under schema 0
// ({balance}); the table is then opened at schema 1 ({balance, bonus = 7}) and row 2 is put.
// The expected bytes are written out by hand: u64 keys are 8 bytes big-endian (codec.md's
// order-preserving key format), u64 values 8 bytes little-endian.
type Old { balance: u64 }

type New { balance: u64, bonus: u64 }

fn old_put(v: Old, mut b: Bytes) -> Result[(), std.codec.EncodeError] {
    std.codec.put_u64(v.balance, mut b)
    Ok(())
}

fn old_take(b: Bytes, mut at: u64) -> Result[Old, std.codec.DecodeError] {
    Ok(Old(balance: std.codec.take_u64(b, mut at)?))
}

fn old_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[Old]) -> Result[(), std.codec.EncodeError] {
    std.codec.define(mut s, "runner.tests.Account", 0)?
    if std.codec.record(mut s, 1)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)
    std.codec.close(mut s)
    Ok(())
}

fn new_put(v: New, mut b: Bytes) -> Result[(), std.codec.EncodeError] {
    std.codec.put_u64(v.balance, mut b)
    std.codec.put_u64(v.bonus, mut b)
    Ok(())
}

fn new_take(b: Bytes, mut at: u64) -> Result[New, std.codec.DecodeError] {
    let balance = std.codec.take_u64(b, mut at)?
    let bonus = std.codec.take_u64(b, mut at)?
    Ok(New(balance: balance, bonus: bonus))
}

fn new_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[New]) -> Result[(), std.codec.EncodeError] {
    std.codec.define(mut s, "runner.tests.Account", 0)?
    if std.codec.record(mut s, 2)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)
    std.codec.field_default(mut s, "bonus", std.codec.of_u64(), 7)?
    std.codec.close(mut s)
    Ok(())
}

type Ah: send { t: store.Shape[u64, New] }

fn accounts_q(tx: store.Tx, h: Ah, take _arg: u32) -> Result[Cover, Capacity] {
    cover(h.t, Included(1u64), Included(2u64))
}

fn accounts_place(mut r: Registry[(), Ah]) -> Result[(), RegisterError] {
    query(mut r, code.describe(accounts_q), 65536u64, DEFAULT_STEPS)
}

fn push_bytes(mut out: Bytes, x: u8, n: u64) {
    for _ in 0u64 .. n {
        list.push(mut out, x)
    }
}

// The tree key of accounts row k (k < 256), by hand.
fn account_key(k: u8) -> Bytes {
    let mut out: Bytes = list.new()
    push_bytes(mut out, 0u8, 2u64)
    push_bytes(mut out, 1u8, 1u64)
    push_bytes(mut out, 2u8, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    push_bytes(mut out, k, 1u64)
    out
}

// A New value by hand: balance then bonus, each 8 bytes little-endian (both < 256).
fn account_value(balance: u8, bonus: u8) -> Bytes {
    let mut out: Bytes = list.new()
    push_bytes(mut out, balance, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    push_bytes(mut out, bonus, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    out
}

fn row_is(r: Row, key: Bytes, value: Bytes) -> bool {
    r.sub == 7u32 && r.key == key && match r.value {
        Some(v) => v == value,
        None => false,
    }
}

pub fn law_rows_normalized(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    for i in 0i64 .. 257i64 {
        let mut name = string.from("pad")
        string.push_i64(mut name, i)
        let _ = result.unwrap(store.create_table(mut db, store.spec(take name, std.codec.key_u64(), std.codec.of_u64())))
    }
    let oc: std.codec.Codec[Old] = std.codec.make(old_put, old_take, old_schema, 8u64)
    let nc: std.codec.Codec[New] = std.codec.make(new_put, new_take, new_schema, 16u64)
    let _ = result.unwrap(store.create_table(mut db, store.spec("accounts", std.codec.key_u64(), oc)))
    let old = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), oc))
    let first = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, old, 1u64, Old(balance: 10u64))
    })
    match take first {
        Ok(Committed(_)) => (),
        _ => return false,
    }
    let current = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), nc))
    let h = Ah(t: store.shape(current))
    let reg = match placed(code.describe(accounts_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let ca: std.codec.Codec[u32] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let (take key, _) = result.unwrap(described(code.identity(code.describe(accounts_q)), None, Query, ca, cr))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    // G3: the initial result, from span_changes, holds row 1 normalized from schema 0.
    let initial = at_base(mut b, 0u64, 7u32, take key, no_arg())
    if list.len(initial.complete) != 1u64 || list.len(initial.rows) != 1u64 || !row_is(initial.rows[0], account_key(1u8), account_value(10u8, 7u8)) {
        return false
    }
    // G2: row 2, put at schema 1, arrives from changes with the same normalization.
    let second = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, current, 2u64, New(balance: 20u64, bonus: 9u64))
    })
    match take second {
        Ok(Committed(_)) => (),
        _ => return false,
    }
    let owes = step(mut b, db)
    list.len(owes) == 1u64 && list.len(owes[0].rows) == 1u64 && row_is(owes[0].rows[0], account_key(2u8), account_value(20u8, 9u8))
}

fn faulting_new_take(b: Bytes, mut at: u64) -> Result[New, std.codec.DecodeError] {
    let value = new_take(b, mut at)?
    if value.balance == 10u64 {
        fail("fixture: old row failed in the current decoder")
    }
    let mut i = 0u64
    while i < 8192u64 {
        i += 1u64
    }
    Ok(value)
}

fn projection_place(mut r: Registry[(), Ah]) -> Result[(), RegisterError] {
    query(mut r, code.describe(accounts_q), 65536u64, 4096u64)
}

fn faulting_projection(c: Clock, r: Random, balance: u64) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let oc: std.codec.Codec[Old] = std.codec.make(old_put, old_take, old_schema, 8u64)
    let nc: std.codec.Codec[New] = std.codec.make(new_put, faulting_new_take, new_schema, 16u64)
    let _ = result.unwrap(store.create_table(mut db, store.spec("accounts", std.codec.key_u64(), oc)))
    let old = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), oc))
    let _ = result.unwrap(store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, old, 1u64, Old(balance: balance))
    }))
    let current = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), nc))
    let h = Ah(t: store.shape(current))
    let reg = result.unwrap(placed(code.describe(projection_place), 1048576u64))
    let ca: std.codec.Codec[u32] = std.codec.of()
    let (take key, _) = result.unwrap(described(code.identity(code.describe(accounts_q)), None, Query, ca, std.codec.of_unit()))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    let o = at_base(mut b, 1u64, 7u32, take key, no_arg())
    !o.reset && list.len(o.rows) == 0u64 && list.len(o.complete) == 0u64
        && list.len(o.ended) == 1u64 && o.ended[0].0 == 7u32 && ended_entry(b.subs, SubId(who: 1u64, sub: 7u32, serial: 0u64))
        && match o.ended[0].2 {
            Failed(Raised(5u32)) => balance == 10u64,
            Failed(OutOfTime(4096u64)) => balance == 11u64,
            _ => false,
        }
}

// The old stored layout takes the reader path and executes application code. The faulted
// first run stays only as an ended entry (v2.19.2).
pub fn law_projection_isolated(c: Clock, r: Random) -> bool waits {
    faulting_projection(c, r, 10u64) && faulting_projection(c, r, 11u64)
}

@test
fn test_projection_isolated(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_projection_isolated(c, r) { Ok(()) } else { Error(()) }
}

@test
fn test_rows_normalized(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_rows_normalized(c, r) {
        Ok(())
    } else {
        Error(())
    }
}

pub const WIRE_OWNER_LIMIT: u64 = 10000u64
pub const WIRE_OWNER_FLOOR: u64 = 65536u64
const WIRE_OWNER_TASK_BYTES: u64 = 320u64
const WIRE_OVERHEAD: u64 = 67108864u64
const WIRE_SESSION_CEILING: u64 = 16777216u64
pub const WIRE_POOL_BYTES: u64 = 384u64 * 1024u64 * 1024u64
pub type WireConfig: send { n_pool: u64, n_granted: u64, max_subs: u64, socket: std.wsock.Config, q: u64, budget: u64, n_service: u64, n_place: u64, site: Option[std.wsock.Site] }

pub fn wire_defaults(n_service: u64, n_place: u64) -> WireConfig {
    WireConfig(n_pool: WIRE_POOL_BYTES, n_granted: 0u64, max_subs: 128u64, socket: std.wsock.defaults(), q: 4, budget: 1048576, n_service: n_service, n_place: n_place, site: None)
}

fn wire_round(n: u64) -> u64 { (n + 7u64) & 0xfffffffffffffff8u64 }

pub fn reader_bytes() -> u64 { 4096u64 }

fn wire_outcome_reserve(c: WireConfig) -> u64 {
    (1u64 + c.q) * (DONE_MAX + 36u64)
}

fn wire_service_job_bytes(c: WireConfig) -> u64 {
    c.n_place + c.n_service + 6u64 * c.socket.max_frame + 32768u64
}

fn wire_variable_peak(c: WireConfig) -> u64 {
    let m = c.socket.max_frame
    let units = 1u64 + c.q
    // Read credits bound typed inbox/deferred values. Head positions retain
    // a key and argument each, both at most one frame, plus stream and caller.
    let input = units * (4u64 * m + 128u64) + units * (2u64 * m + 256u64)
    let transport = wire_round(3u64 * m / 2u64) + 2u64 * wire_round(m + 14u64)
    let retained = c.n_place + 4u64 * m + 2u64 * c.budget + wire_outcome_reserve(c)
    input + transport + retained + wire_service_job_bytes(c) + 32768u64
}

fn wire_configuration(c: WireConfig) -> bool {
    if c.q > 4u64 || c.socket.max_frame > 262144u64 || c.socket.pending_max > 1024u64 || c.budget > 1048576u64 || c.max_subs == 0u64
        || c.n_pool == 0u64 || c.n_pool > WIRE_POOL_BYTES || c.n_service > WIRE_SESSION_CEILING || c.n_place > WIRE_SESSION_CEILING { return false }
    if c.n_granted > WIRE_SESSION_CEILING || wire_variable_peak(c) + c.n_granted > WIRE_SESSION_CEILING { return false }
    // Welcome carries one issuer byte, at most SUBJECT_MAX subject bytes and a 32-byte digest.
    // The launch target belongs to this run, so its size is known at serve.
    let welcome = 69u64 + SUBJECT_MAX + launch_word(3u64, 0u64)
    let mandatory = if welcome > 125u64 { welcome } else { 125u64 }
    c.socket.max_frame >= mandatory && c.budget >= wire_round(mandatory + 14u64)
        && c.socket.max_frame >= wire_outcome_reserve(c) + 28u64
}

fn wire_decode(b: Bytes) -> Result[Frame, u16] {
    if list.len(b) < 4u64 || b[0u64] >= 4u8 || b[1u64] != 0u8 || b[2u64] != 0u8 || b[3u64] != 0u8 {
        return Error(1007u16)
    }
    let codec: std.codec.Codec[Frame] = std.codec.of()
    Ok(std.codec.decode(codec, b) ?=> |_| 1007u16)
}


pub const DONE_MAX: u64 = 8192
const MAX_RETURNED_BYTES: u64 = DONE_MAX - 20u64

// WIRE W3b. The service owns admission, dedup and outcomes.
// Each owner holds the one publisher sender. Another transport calls the same dispatch.
pub type ServiceInput: send = WAttach(Ip, Sender[WireEvent], Sender[PubIn]) | WClient(Frame, u64) | WRunner(Notice) | WGrantedDone(Tick, Outcome) | WPrepared(Box[ServicePlan]) | WDrained | WSent | WDropped | WPoll(bool) | WClose(u64) | WForce

pub type Service[C: send]: send {
    context: C,
    step: fn(mut C, mut WireWork, take ServiceInput) -> Result[Option[Frame], u16],
    ready: fn(C) -> bool,
    allocate: fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16],
    finish: fn(mut C) -> Option[PubIn],
    check: fn(C, Frame) -> Option[u16]
}

pub fn dispatch[C: send](mut service: Service[C], take frame: Frame) -> Result[Option[Frame], u16] {
    let mut work = wire_work()
    (service.step)(mut service.context, mut work, WClient(take frame, 0u64))
}

pub fn writer_bytes() -> u64 { 4096u64 }

// The owner result has charge-v1 size 32. Its 320-byte task
// record is part of the floor, which also covers its child tasks.
pub fn serving_bytes(c: WireConfig, owners: u64) -> Result[u64, Capacity] {
    if c.n_granted > WIRE_SESSION_CEILING { return Error(Capacity(requested: c.n_granted, available: WIRE_SESSION_CEILING)) }
    if owners > WIRE_OWNER_LIMIT { return Error(Capacity(requested: owners, available: WIRE_OWNER_LIMIT)) }
    let floors = owners * (WIRE_OWNER_FLOOR + c.n_granted)
    // Use less supervisor room when a caller deliberately serves fewer owners.
    let metadata = 2097152u64 + owners * 6711u64
    let overhead = if metadata < WIRE_OVERHEAD { metadata } else { WIRE_OVERHEAD }
    let fixed = overhead + floors
    match int.checked_add(fixed, c.n_pool) {
        Some(total) => Ok(total),
        None => Error(Capacity(requested: c.n_pool, available: 0xffffffffffffffffu64 - fixed)),
    }
}

pub opaque type WireEvent: send { e: WireInput }

fn wire_event(take e: WireInput) -> WireEvent { WireEvent(e: take e) }

type WireInput: send = Input(Frame, u64) | FromRunner(Notice) | HelloBound(Option[Caller]) | GrantedDone(Tick, Outcome) | JoinReady | HelloExpired | Published(Frame) | Control(u8, std.websocket.Control) | Sent | Dropped | WriteTimedOut(u64) | ReadClosed(std.websocket.Control, std.wsock.Reader) | WriteClosed(std.wsock.Writer) | Ended(u16) | DrainWake | RetireWire

type WirePacket: send = Fragment | Decoded(Frame, u64) | Pinged(std.websocket.Control) | Ponged | PeerClosed(std.websocket.Control)
type WireParsed: send { reader: std.wsock.Reader, packet: Result[Option[WirePacket], std.wsock.Error] }
type WireAllocation[C: send]: send = Decode(std.wsock.Reader, u64, Sender[WireParsed]) | Encode(Frame, Sender[Result[Bytes, std.wsock.Error]]) | AllocateService(Box[Service[C]], ServiceAllocation, Sender[Option[AllocatedState[C]]])
type WirePool[C: send]: send { inbox: Receiver[WireAllocation[C]], config: std.wsock.Config, clock: Clock, tasks: Tasks, service_bytes: u64 }
pub type ServiceAllocation: send = AcceptHello(Option[Caller]) | PlanCall | ValidateSubscribe(u32, u32, Bytes, Option[Bytes]) | DeliverUpdate(DeliveryJob)
pub opaque type DeliveryJob: send { updates: List[Update], output: List[WireOutput], drain: Option[Latest[Option[DrainWindow]]] }
type AllocatedState[C: send]: send { service: Box[Service[C]], status: Result[Box[ServicePlan], u16] }
type ServiceAllocationJob[C: send]: send { service: Box[Service[C]], plan: ServiceAllocation }

fn wire_allocate_job[C: send](take job: ServiceAllocationJob[C]) -> AllocatedState[C] {
    let ServiceAllocationJob(service: take owned, plan: take plan) = take job
    let mut session = take owned
    let allocate = session.allocate
    let status: Result[Box[ServicePlan], u16] = match allocate(mut session.context, take plan) {
        Ok(take result_plan) => Ok(box.new(take result_plan)),
        Error(code) => Error(code),
    }
    AllocatedState(service: take session, status: status)
}


fn wire_parse(mut reader: std.wsock.Reader, at: u64, clock: Clock) -> Result[Option[WirePacket], std.wsock.Error] {
    match std.wsock.decode_buffered(mut reader)? {
        None => Ok(None),
        Some(Need) => Ok(Some(Fragment)),
        Some(Ping(control)) => Ok(Some(Pinged(control))),
        Some(Pong(_)) => Ok(Some(Ponged)),
        Some(Closed(control)) => Ok(Some(PeerClosed(control))),
        Some(Reject(code)) => Error(Protocol(code)),
        Some(Text(_)) => Error(Protocol(1003u16)),
        Some(Ended) => Error(Eof),
        Some(Message(take payload)) => {
            match wire_decode(payload) {
                Ok(take frame) => {
                    let arrived = match frame { Hello(_, _) => host.mono_ns(clock), _ => at }
                    Ok(Some(Decoded(take frame, arrived)))
                },
                Error(code) => Error(Protocol(code)),
            }
        },
    }
}

fn wire_pool[C: send](take pool: WirePool[C]) -> () waits {
    let WirePool(inbox: take inbox, config: config, clock: clock, tasks: tasks, service_bytes: service_bytes) = take pool
    let encoder = match std.wsock.outbound(Server, config, None) { Ok(out) => out, Error(_) => return }
    while let Ok(take work) = channel.receive(inbox) {
        match take work {
            Decode(take input, at, take to) => {
                let mut reader = take input
                let packet = wire_parse(mut reader, at, clock)
                let _ = channel.try_send(to, WireParsed(reader: take reader, packet: take packet))
            },
            Encode(take frame, take to) => {
                let encoded_frame = wire_encode(encoder, frame)
                let _ = channel.try_send(to, take encoded_frame)
            },
            AllocateService(take owned, take plan, take to) => {
                let run: fn(take ServiceAllocationJob[C]) -> AllocatedState[C] waits = wire_allocate_job
                let job = ServiceAllocationJob(service: take owned, plan: take plan)
                let returned = match task.spawn(tasks, bytes service_bytes, take job, run) {
                    take running => match task.join(take running) {
                        Ok(take completed) => Some(take completed),
                        Error(_) => None,
                    },
                }
                let _ = channel.try_send(to, take returned)
            },
        }
    }
}

/// One whole binary frame for f, its codec bytes written once behind the header.
pub fn wire_encode(out: std.wsock.Outbound, f: Frame) -> Result[Bytes, std.wsock.Error] {
    let codec: std.codec.Codec[Frame] = std.codec.of()
    std.wsock.try_encode_with(out, codec, f, wire_output_size(f))
}

fn start_wire_pool[C: send](tasks: Tasks, c: WireConfig, clock: Clock, n: u64, slots: u64) -> Result[(Sender[WireAllocation[C]], Task[()]), Capacity] {
    let (to, inbox): (Sender[WireAllocation[C]], Receiver[WireAllocation[C]]) = channel.new(slots)
    // Registry construction may reserve n_place. Hello key growth is bounded
    // by the wire payload, rounded identities and the list of Bytes handles.
    let pool = WirePool(inbox: take inbox, config: c.socket, clock: clock, tasks: tasks, service_bytes: wire_service_job_bytes(c))
    let run: fn(take WirePool[C]) -> () waits = wire_pool
    let handle = task.spawn(tasks, bytes n, take pool, run)
    Ok((take to, take handle))
}

fn wire_pack[C: send](pool: Sender[WireAllocation[C]], to: Sender[Result[Bytes, std.wsock.Error]], inbox: Receiver[Result[Bytes, std.wsock.Error]], take frame: Frame) -> Result[Bytes, std.wsock.Error] waits {
    if let Error(_) = channel.try_send(pool, Encode(take frame, channel.sender(to))) { return Error(Protocol(1013u16)) }
    match channel.receive(inbox) {
        Ok(Error(Allocation(_))) => Error(Protocol(1013u16)),
        Ok(take result) => take result,
        Error(_) => Error(Protocol(1013u16)),
    }
}

fn wire_allocate[C: send](pool: Sender[WireAllocation[C]], to: Sender[Option[AllocatedState[C]]], inbox: Receiver[Option[AllocatedState[C]]], take service: Box[Service[C]], take plan: ServiceAllocation) -> Option[AllocatedState[C]] waits {
    match channel.try_send(pool, AllocateService(take service, take plan, channel.sender(to))) {
        Ok(()) => match channel.receive(inbox) { Ok(take returned) => take returned, Error(_) => None },
        Error(Full(AllocateService(take back, _, _))) => Some(AllocatedState(service: take back, status: Error(1013u16))),
        Error(Closed(AllocateService(take back, _, _))) => Some(AllocatedState(service: take back, status: Error(1013u16))),
        _ => None,
    }
}

// Read credits cover the inbox and a reader blocked on handing off a packet.
type WireRead[C: send]: send { reader: std.wsock.Reader, to: Sender[WireEvent], credits: Receiver[()], clock: Clock, config: std.wsock.Config, pool: Sender[WireAllocation[C]] }
type WireWrite: send { writer: std.wsock.Writer, from: Receiver[WireUnit], to: Sender[WireEvent], out: std.wsock.Outbound, clock: Clock, config: std.wsock.Config, first_write: Option[Sender[u64]] }

// One encoded frame for the writer. A content unit carries its version and handles to the
// round register and its session's fence root; the writer applies the release check after
// it takes the unit and before its first byte (§3).
type WireUnit: send { frame: Bytes, check: Option[WireCheck], write_ack: bool }
type WireCheck: send { version: u64, round: Latest[RoundAt], fence: Latest[Fence] }

// A content unit is built only with both handles; the owner has them from the join that let
// the content in, so a missing one is a broken invariant and ends the session, unwritten.
fn wire_unit(work: WireWork, take frame: Bytes, check: Option[u64], report_writes: bool) -> WireUnit {
    let checked = match check {
        Some(version) => match work.round {
            Some(register) => match work.fence {
                Some(fence) => Some(WireCheck(version: version, round: latest.handle(register), fence: latest.handle(fence))),
                None => fail("runner: a content unit without its fence"),
            },
            None => fail("runner: a content unit without the round register"),
        },
        None => None,
    }
    let mut write_ack = false
    if report_writes {
        for mark in work.sending {
            if let WriteUnit(_) = mark { write_ack = true; break }
        }
    }
    WireUnit(frame: take frame, check: take checked, write_ack: write_ack)
}

fn wire_return_reader(to: Sender[WireEvent], control: std.websocket.Control, take input: std.wsock.Reader) -> () waits {
    let mut reader = take input
    std.wsock.finish_read(mut reader)
    let _ = channel.send(to, wire_event(ReadClosed(control, take reader)))
}

fn wire_read[C: send](take x: WireRead[C]) -> () waits {
    let WireRead(reader: take initial, to: take to, credits: take credits, clock: clock, config: config, pool: take pool) = take x
    let (reply, packets): (Sender[WireParsed], Receiver[WireParsed]) = channel.new(1u64)
    let mut r = take initial
    let mut probing = false
    loop {
        if let Error(_) = channel.receive(credits) { return }
        let next: WireInput = loop {
            let end = std.clock.deadline_after_ms(host.mono_ns(clock), config.idle_ms)
            let packet = loop {
                match channel.try_send(pool, Decode(take r, host.mono_ns(clock), channel.sender(reply))) {
                    Ok(()) => {},
                    Error(Full(Decode(take back, _, _))) => { wire_return_reader(to, wire_close_control(1013u16), take back); return },
                    Error(_) => return,
                }
                let WireParsed(reader: take returned, packet: take attempted) = match channel.receive(packets) {
                    Ok(take frame) => take frame,
                    Error(_) => return,
                }
                r = take returned
                match take attempted {
                    Ok(None) => {},
                    take complete => break take complete,
                }
                match std.wsock.refill(mut r, At(clock, end)) {
                    Ok(()) => if host.mono_ns(clock) >= end { break Error(Network(TimedOut)) },
                    Error(e) => break Error(e),
                }
            }
            match take packet {
                Ok(Some(Fragment)) => { probing = false },
                Ok(Some(Ponged)) => { probing = false },
                Ok(Some(Decoded(take frame, at))) => { probing = false; break Input(take frame, at) },
                Ok(Some(Pinged(control))) => { probing = false; break Control(10u8, control) },
                Ok(Some(PeerClosed(control))) => { wire_return_reader(to, control, take r); return },
                Error(Protocol(code)) => { wire_return_reader(to, wire_close_control(code), take r); return },
                Error(Allocation(_)) => { wire_return_reader(to, wire_close_control(1013u16), take r); return },
                Error(Network(TimedOut)) => {
                    if probing { wire_return_reader(to, wire_close_control(1001u16), take r); return }
                    probing = true
                    break Control(9u8, std.websocket.Control(data: [0u8; 125], len: 0u64))
                },
                _ => { wire_return_reader(to, wire_close_control(1001u16), take r); return },
            }
        }
        if let Error(_) = channel.send(to, wire_event(take next)) { return }
    }
}

fn wire_write(take x: WireWrite) -> () waits {
    let WireWrite(writer: take initial, from: take from, to: take to, out: take initial_out, clock: clock, config: config, first_write: take notice) = take x
    let mut writer = take initial
    let mut out = take initial_out
    let mut first_write = take notice
    loop {
        let unit = match channel.receive(from) {
            Ok(take b) => take b,
            Error(_) => return,
        }
        let WireUnit(frame: take frame, check: take check, write_ack: write_ack) = take unit
        if let Some(c) = check {
            if !release_load(c.round, c.fence, c.version) {
                if let Error(_) = channel.send(to, wire_event(Dropped)) { return }
                continue
            }
        }
        let is_close = list.len(frame) != 0u64 && frame[0u64] & 15u8 == 8u8
        let now = host.mono_ns(clock)
        let mut end = if is_close { std.clock.deadline_after_ms(now, config.close_ms) } else { int.saturating_add(now, std.wsock.MESSAGE_NS) }
        let mut can_close = !is_close
        let _ = std.wsock.stage(mut writer, take frame)
        loop {
            let flushed: Result[bool, std.wsock.Error] = if host.mono_ns(clock) >= end {
                Error(Network(TimedOut))
            } else { std.wsock.flush(mut writer, mut out, At(clock, end)) }
            match flushed {
                Ok(true) => break,
                Ok(false) => {},
                Error(Network(TimedOut)) => {
                    if !can_close { let _ = channel.send(to, wire_event(Ended(1001u16))); return }
                    // The Close frame cannot overtake a partial frame. Give the
                    // sole writer the same close deadline as the owner.
                    end = std.clock.deadline_after_ms(end, config.close_ms)
                    can_close = false
                    if let Error(_) = channel.send(to, wire_event(WriteTimedOut(end))) { return }
                },
                Error(_) => { let _ = channel.send(to, wire_event(Ended(1001u16))); return },
            }
        }
        if is_close {
            let _ = channel.send(to, wire_event(WriteClosed(take writer)))
            return
        }
        if write_ack {
            if let Some(take report) = replace(mut first_write, None) {
                let _ = channel.try_send(report, host.mono_ns(clock))
            }
        }
        if let Error(_) = channel.send(to, wire_event(Sent)) { return }
    }
}

// The capacity-one channel is a handoff, not a second queue. busy stays set
// until Sent, so a writer stalled in send cannot retain a queued second frame.
fn wire_ready(busy: bool) -> bool { !busy }

fn wire_offer(to: Sender[WireUnit], mut busy: bool, take u: WireUnit) -> Result[(), WireUnit] {
    match channel.try_send(to, take u) {
        Ok(()) => { busy = true; Ok(()) },
        Error(Full(take full)) => Error(take full),
        Error(Closed(take closed)) => Error(take closed),
    }
}

// Tokio JoinSet::shutdown aborts all before draining. Goose's contained
// workers release on wait, but lack cancellation. Both children are unshielded.
fn wire_join(take first: Task[()], take second: Task[()]) -> () waits {
    let mut reader = take first
    let mut writer = take second
    task.cancel(mut reader)
    task.cancel(mut writer)
    let _ = task.join(take reader)
    let _ = task.join(take writer)
}

pub fn wire_publish(to: Sender[WireEvent], take frame: Frame) -> Result[(), SendError[WireEvent]] {
    channel.try_send(to, wire_event(Published(take frame)))
}

fn wire_close_control(code: u16) -> std.websocket.Control {
    let mut data: Inline[u8, 125] = [0u8; 125]
    data[0u64] = int.narrow(code >> 8u16)
    data[1u64] = int.truncate(code)
    std.websocket.Control(data: data, len: 2u64)
}

fn wire_close_payload(code: u16) -> Bytes {
    let mut b: Bytes = list.with_capacity(2u64)
    let high: u8 = int.narrow(code >> 8u16)
    let low: u8 = int.truncate(code)
    list.push(mut b, high)
    list.push(mut b, low)
    b
}

type WireOwner[C: send]: send { upgraded: std.wsock.Upgraded, service: Box[Service[C]], publisher: Sender[PubIn], config: WireConfig, clock: Clock, tasks: Tasks, managed: Option[OwnerControl] }

fn wire_connection_pool_bytes(c: WireConfig) -> u64 {
    let peak = wire_variable_peak(c)
    if c.n_pool < peak { c.n_pool } else { peak }
}

// Serves an already upgraded connection. W3c constructs the service at Hello;
// its sender joins the one publisher inbox lazily at the first Subscribe.
pub fn serve_connection[C: send](tasks: Tasks, take upgraded: std.wsock.Upgraded, take service: Service[C], to_publisher: Sender[PubIn], c: WireConfig, clock: Clock) -> Result[Task[Result[(), std.wsock.Error]], Capacity] {
    let boxed = box.new(take service)
    let x = WireOwner(upgraded: take upgraded, service: take boxed, publisher: channel.sender(to_publisher), config: c, clock: clock, tasks: tasks, managed: None)
    let run: fn(take WireOwner[C]) -> Result[(), std.wsock.Error] waits = wire_connection_owner
    let allowance = if wire_configuration(c) { WIRE_OWNER_FLOOR - WIRE_OWNER_TASK_BYTES + c.n_granted + wire_connection_pool_bytes(c) + 8192u64 } else { 0u64 }
    Ok(task.spawn(tasks, bytes allowance, take x, run))
}

fn wire_connection_owner[C: send](take x: WireOwner[C]) -> Result[(), std.wsock.Error] waits {
    if !wire_configuration(x.config) { return Error(Configuration) }
    let mut abandoned = 0u64
    let c = x.config
    // The reader and owner each wait for their single allocation request.
    let allocated: Result[(Sender[WireAllocation[C]], Task[()]), Capacity] = start_wire_pool(x.tasks, c, x.clock, wire_connection_pool_bytes(c), 2u64)
    let (to, take holding) = match take allocated {
        Ok(take pair) => take pair, Error(cap) => return Error(Allocation(cap)),
    }
    let served = wire_owner(take x, to, mut abandoned)
    let _ = take holding
    served
}

// The owner's state across its event loop. wire_owner_setup builds it and
// returns, so the setup's temporaries leave the stack before the loop runs, and
// each event kind is handled in a call of its own, so the loop's frame holds
// one event's temporaries rather than every arm's.
type WireLoop[C: send] {
    apply_input: fn(mut C, mut WireWork, take ServiceInput) -> Result[Option[Frame], u16],
    work: WireWork, c: WireConfig, clock: Clock, tasks: Tasks, managed: Option[OwnerControl], pub_to: Sender[PubIn],
    to: Sender[WireEvent], inbox: Receiver[WireEvent], credit: Sender[()], write: Sender[WireUnit],
    encoded_to: Sender[Result[Bytes, std.wsock.Error]], encoded_from: Receiver[Result[Bytes, std.wsock.Error]],
    allocation_to: Sender[Option[AllocatedState[C]]], allocation_from: Receiver[Option[AllocatedState[C]]],
    encoder: std.wsock.Outbound, rh: Task[()], wh: Task[()], lease: Option[std.wsock.Pending],
    hello_at: Option[u64], hello_seen: bool, hello_alarm: Option[Task[()]],
    run: u64, held: Option[WireEvent], held_credit: bool, deferred: List[(Frame, u64)], busy: bool, control: Option[Bytes], closing: bool, alarm: Option[Task[()]],
    read_back: Option[std.wsock.Reader], write_back: Option[std.wsock.Writer], read_closed: bool, write_closed: bool, close_at: Option[u64], expired: bool,
}

// What one step of the owner's loop asks of it: go on with this frame (if
// any), start the next event, or leave the loop with this result.
type WireStep = Go(Option[Frame]) | Again | Stop(Result[(), std.wsock.Error])

fn wire_owner[C: send](take x: WireOwner[C], pool: Sender[WireAllocation[C]], mut abandoned: u64) -> Result[(), std.wsock.Error] waits {
    let (take st, take service) = match wire_owner_setup(take x, pool) {
        Ok(take ready) => take ready,
        Error(take done) => return take done,
    }
    wire_owner_run(take st, take service, pool, mut abandoned)
}

// Error(r) is the owner's result when it ends before its loop.
fn wire_owner_setup[C: send](take x: WireOwner[C], pool: Sender[WireAllocation[C]]) -> Result[(WireLoop[C], Box[Service[C]]), Result[(), std.wsock.Error]] waits {
    let WireOwner(upgraded: take up, service: take initial_service, publisher: take pub_to, config: c, clock: clock, tasks: tasks, managed: take managed) = take x
    let std.wsock.Upgraded(reader: take reader, writer: take writer, source: source, timers: timers, pending: take pending) = take up
    let lease = Some(take pending)
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64 + c.q)
    if let Some(life) = managed {
        let (ready_to, ready_from): (Sender[()], Receiver[()]) = channel.new(1u64)
        if let Error(_) = channel.send(life.to, OwnerReady(life.id, channel.sender(to), take ready_to)) { return Error(Ok(())) }
        if let Error(_) = channel.receive(ready_from) { return Error(Ok(())) }
    }
    let (credit, credits): (Sender[()], Receiver[()]) = channel.new(1u64 + c.q)
    for _ in 0u64 .. 1u64 + c.q { let _ = channel.try_send(credit, ()) }
    let (write, writes): (Sender[WireUnit], Receiver[WireUnit]) = channel.new(1u64)
    let (encoded_to, encoded_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) = channel.new(1u64)
    let (allocation_to, allocation_from): (Sender[Option[AllocatedState[C]]], Receiver[Option[AllocatedState[C]]]) = channel.new(1u64)
    let out = match std.wsock.outbound(Server, c.socket, None) { Ok(o) => o, Error(e) => return Error(Error(e)) }
    let encoder = match std.wsock.outbound(Server, c.socket, None) { Ok(o) => o, Error(e) => return Error(Error(e)) }
    let reading = WireRead(reader: take reader, to: channel.sender(to), credits: take credits, clock: clock, config: c.socket, pool: channel.sender(pool))
    let read_task: fn(take WireRead[C]) -> () waits = wire_read
    let mut rh = task.spawn(tasks, bytes reader_bytes(), take reading, read_task)
    let first_write = match managed { Some(life) => copy_write_notice(life.first_write), None => None }
    let writing = WireWrite(writer: take writer, from: take writes, to: channel.sender(to), out: out, clock: clock, config: c.socket, first_write: take first_write)
    let wh = task.spawn(tasks, bytes writer_bytes(), take writing, wire_write)
    let mut service = take initial_service
    let apply_input = service.step
    let mut work = wire_work()
    if let Some(life) = managed { work.drain = Some(latest.handle(life.drain)) }
    if let Error(code) = apply_input(mut service.context, mut work, WAttach(source, channel.sender(to), channel.sender(pub_to))) { wire_join(take rh, take wh); return Error(Error(Protocol(code))) }
    let hello_at = std.wsock.hello_deadline(timers)
    let mut hello_alarm: Option[Task[()]] = None
    if let Some(at) = hello_at {
        let h = std.clock.alarm(tasks, clock, at, to, wire_event(HelloExpired))
        hello_alarm = Some(take h)
    }
    let st = WireLoop(apply_input: apply_input, work: take work, c: c, clock: clock, tasks: tasks, managed: take managed, pub_to: take pub_to,
        to: take to, inbox: take inbox, credit: take credit, write: take write,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: encoder, rh: take rh, wh: take wh, lease: take lease, hello_at: hello_at, hello_seen: false, hello_alarm: take hello_alarm,
        run: 0u64, held: None, held_credit: false, deferred: list.new(), busy: false, control: None, closing: false, alarm: None,
        read_back: None, write_back: None, read_closed: false, write_closed: false, close_at: None, expired: false)
    Ok((take st, take service))
}

fn wire_owner_run[C: send](take initial: WireLoop[C], take initial_service: Box[Service[C]], pool: Sender[WireAllocation[C]], mut abandoned: u64) -> Result[(), std.wsock.Error] waits {
    let mut st = take initial
    let mut service = take initial_service
    // Every normal exit goes through wire_join, including service refusal and
    // either child's Ended. Cancellation uses CONC-8 on the two owned handles.
    let result: Result[(), std.wsock.Error] = loop {
        wire_owner_join(mut st, mut service)
        if !wire_post(mut st.work) { wire_owner_refuse(mut st, 1011u16) }
        let received = match wire_owner_next(mut st, mut service) {
            Some(take e) => take e,
            None => break Ok(()),
        }
        let frame = match take received {
            Input(take f, at) => {
                if st.closing { let _ = channel.try_send(st.credit, ()); continue }
                match wire_owner_input(mut st, take service, pool, take f, at) {
                    Some((take kept, take outcome)) => {
                        service = take kept
                        match take outcome { Go(take next) => take next, Again => continue, Stop(take r) => break take r }
                    },
                    None => return wire_owner_lost(take st),
                }
            },
            FromRunner(take e) => {
                if st.closing { continue }
                match wire_owner_runner(mut st, take service, pool, take e) {
                    Some((take kept, take next)) => { service = take kept; take next },
                    None => return wire_owner_lost(take st),
                }
            },
            HelloBound(take identity_result) => {
                let _ = replace(mut st.work.asking, None)
                match wire_owner_hello(mut st, take service, pool, take identity_result) {
                    Some(take kept) => { service = take kept; None },
                    None => return wire_owner_lost(take st),
                }
            },
            GrantedDone(take tick, take outcome) => {
                if st.closing { continue }
                match (st.apply_input)(mut service.context, mut st.work, WGrantedDone(take tick, take outcome)) {
                    Ok(take f) => take f, Error(code) => { wire_owner_refuse(mut st, code); None },
                }
            },
            JoinReady => None,
            DrainWake => None,
            HelloExpired => {
                if st.hello_seen { continue }
                wire_owner_refuse(mut st, 1008u16)
                None
            },
            Published(take f) => { if st.closing { continue }; Some(take f) },
            Control(op, payload) => match wire_owner_control(mut st, op, payload) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            Sent => {
                st.busy = false
                let _ = (st.apply_input)(mut service.context, mut st.work, WSent)
                None
            },
            Dropped => {
                st.busy = false
                if let Error(code) = (st.apply_input)(mut service.context, mut st.work, WDropped) { wire_owner_refuse(mut st, code) }
                None
            },
            WriteTimedOut(end) => match wire_owner_write_timeout(mut st, end) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            ReadClosed(payload, take returned) => match wire_owner_read_closed(mut st, payload, take returned) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            WriteClosed(take returned) => {
                st.write_back = Some(take returned)
                st.write_closed = true
                if st.read_closed { break Ok(()) }
                None
            },
            Ended(_) => break Ok(()),
            RetireWire => {
                wire_owner_refuse(mut st, 1012u16)
                None
            },
        }
        let outgoing = match wire_owner_poll(mut st, mut service, take frame) { Go(take next) => take next, Again => continue, Stop(take r) => break take r }
        match wire_owner_send(mut st, mut service, pool, take outgoing) { Stop(take r) => break take r, _ => {} }
    }
    if st.expired { abandoned = st.work.abandoned }
    wire_owner_end(take st, mut service, take result)
}

// v2.22 (§3): the owner's Join goes into PubIn with a waiting send, like connect's. The
// publisher never waits on an owner, so the wait is at most one drain; the owner holds no sub
// and no content of this join until it is admitted. A closed inbox drops the Join, and the
// next poll refuses its first Subscribe.
fn wire_join_send(mut work: WireWork, to: Sender[PubIn]) waits {
    if let Some(take join) = replace(mut work.join, None) { let _ = channel.send(to, take join) }
}

// v2.23: the requests a full head inbox did not take go in with a waiting send, in order. The
// head never waits on an owner (it answers through the publisher, which never waits on one
// either), so the wait ends when the head takes its next message. False when the head is gone.
fn wire_post(mut work: WireWork) -> bool waits {
    if list.len(work.posts) == 0u64 { return true }
    let head = match work.head { Some(lease) => copy_wire_head(lease.head), None => fail("runner: missing head lease") }
    while list.len(work.posts) != 0u64 {
        let req = list.remove(mut work.posts, 0u64)
        let sent = match head {
            LegacyHead(to) => match channel.send(to, take req) { Ok(()) => true, Error(_) => false },
            LifecycleHead(to) => match channel.send(to, RunRequest(take req)) { Ok(()) => true, Error(_) => false },
        }
        if !sent { work.posts = list.new(); return false }
    }
    true
}

fn wire_owner_join[C: send](mut st: WireLoop[C], mut service: Box[Service[C]]) waits {
    if let None = st.work.join { return }
    wire_join_send(mut st.work, st.pub_to)
    let _ = (st.apply_input)(mut service.context, mut st.work, WPoll(false))
}

// The next event, or None when the loop ends: the inbox closed, or the work's
// cut passed (the owner then expires).
fn wire_owner_next[C: send](mut st: WireLoop[C], mut service: Box[Service[C]]) -> Option[WireInput] waits {
    let event = if (service.ready)(service.context) && list.len(st.deferred) != 0u64 {
        let (take pending_frame, at) = list.remove(mut st.deferred, 0u64)
        wire_event(Input(take pending_frame, at))
    } else if let Some(take e) = replace(mut st.held, None) {
        take e
    } else {
        let e = match channel.try_receive(st.inbox) {
            Ok(take e) => take e,
            Error(Empty) => { st.run = 0u64; match channel.receive(st.inbox) { Ok(take e) => take e, Error(_) => return None } },
            _ => return None,
        }
        if wire_taken(mut st.run, 1u64 + st.c.q) { let _ = (st.apply_input)(mut service.context, mut st.work, WDrained) }
        take e
    }
    if wire_owner_cut(mut st, mut service) { return None }
    if let Some(life) = st.managed {
        if let Some(window) = drain_window(latest.read(life.drain)) {
            if host.mono_ns(st.clock) >= window.admission && (match st.work.deadline { None => true, _ => false }) {
                let _ = (st.apply_input)(mut service.context, mut st.work, WClose(window.deadline))
            }
        }
    }
    let WireEvent(e: take received) = take event
    Some(take received)
}

// Whether the work's cut has passed; the service is then forced and the owner
// expires.
fn wire_owner_cut[C: send](mut st: WireLoop[C], mut service: Box[Service[C]]) -> bool {
    if !wire_cut(st.work, st.clock) { return false }
    let _ = (st.apply_input)(mut service.context, mut st.work, WForce)
    st.expired = true
    true
}

// Queues a close with this code and starts closing.
fn wire_owner_refuse[C: send](mut st: WireLoop[C], code: u16) {
    st.control = Some(result.unwrap(std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(code))))
    st.closing = true
}

// The service's answer to a frame from the client. None when the allocation
// pool is gone with the service.
fn wire_owner_input[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take f: Frame, at: u64) -> Option[(Box[Service[C]], WireStep)] waits {
    let mut service = take held
    let mut checked = (service.check)(service.context, f)
    if let Hello(_, _) = f {
        if !st.hello_seen {
            if let Some(end) = st.hello_at { if at >= end { checked = Some(1008u16) } }
            st.hello_seen = true
        }
    }
    if match checked { None => true, _ => false } && !(service.ready)(service.context) {
        list.push(mut st.deferred, (take f, at))
        return Some((take service, Again))
    }
    if let Hello(_, _) = f { let _ = replace(mut st.hello_alarm, None) }
    let handled: Result[Option[Frame], u16] = match checked {
        Some(code) => Error(code),
        None => if let Subscribe(sub, slot, take arg, take resume) = f {
            let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take service, ValidateSubscribe(sub, slot, take arg, take resume)) {
                Some(take returned) => take returned,
                None => return None,
            }
            service = take restored
            match take status {
                Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
                Error(code) => Error(code),
            }
        } else { (st.apply_input)(mut service.context, mut st.work, WClient(take f, at)) },
    }
    if st.work.plan_call {
        st.work.plan_call = false
        match wire_owner_call(mut st, take service, pool) {
            Some((take kept, take next)) => {
                service = take kept
                let _ = channel.try_send(st.credit, ())
                return Some((take service, Go(take next)))
            },
            None => return None,
        }
    }
    if (service.ready)(service.context) { let _ = channel.try_send(st.credit, ()) } else { st.held_credit = true }
    let outcome = match take handled {
        Ok(take next) => Go(take next),
        Error(code) => {
            let payload = wire_close_payload(code)
            match std.wsock.encode(mut st.encoder, true, 8u8, payload) {
                Ok(take refused) => { st.control = Some(take refused) },
                Error(e) => return Some((take service, Stop(Error(e)))),
            }
            st.closing = true
            Go(None)
        },
    }
    Some((take service, take outcome))
}

// The service's answer to a publisher notice. None when the allocation pool is
// gone with the service.
fn wire_owner_runner[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take e: Notice) -> Option[(Box[Service[C]], Option[Frame])] waits {
    let mut service = take held
    let applied = if let Notice(e: Updated(take published)) = e {
        // Content of a fresh join can come before the owner has seen its Admit.
        let _ = (st.apply_input)(mut service.context, mut st.work, WPoll(false))
        let drain: Option[Latest[Option[DrainWindow]]] = match st.work.drain { Some(root) => Some(latest.handle(root)), None => None }
        let output = replace(mut st.work.output, list.new())
        let mut updates: List[Update] = list.new()
        list.push(mut updates, take published)
        wire_take_updates(mut st, mut service, mut updates)
        let job = DeliveryJob(updates: take updates, output: take output, drain: take drain)
        let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take service, DeliverUpdate(take job)) {
            Some(take returned) => take returned,
            None => return None,
        }
        service = take restored
        match take status {
            Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
            Error(code) => Error(code),
        }
    } else {
        (st.apply_input)(mut service.context, mut st.work, WRunner(take e))
    }
    let next = match take applied {
        Ok(take f) => take f, Error(code) => { wire_owner_refuse(mut st, code); None },
    }
    Some((take service, take next))
}

// §3 "Repair": the publisher's Updates already queued behind this one are taken in the same
// run, in inbox order, and staged by one delivery job, so an owner whose staging falls behind
// the publisher's rounds takes its backlog at once instead of one job per round.
fn wire_take_updates[C: send](mut st: WireLoop[C], mut service: Box[Service[C]], mut updates: List[Update]) {
    let wakes = wire_take_queued(st.inbox, mut st.run, 1u64 + st.c.q, mut updates, mut st.held)
    if wakes != 0u64 { let _ = (st.apply_input)(mut service.context, mut st.work, WDrained) }
}

// Takes queued Updates into `updates` until it holds `capacity`, the inbox is empty, or an
// event of another kind comes; that event is kept in `held` and handled next. Each take
// counts toward the drain wake as any take does; returns the wakes due.
fn wire_take_queued(inbox: Receiver[WireEvent], mut run: u64, capacity: u64, mut updates: List[Update], mut held: Option[WireEvent]) -> u64 {
    let mut wakes = 0u64
    while list.len(updates) < capacity {
        let e = match channel.try_receive(inbox) { Ok(take e) => take e, _ => return wakes }
        if wire_taken(mut run, capacity) { wakes += 1u64 }
        match take e {
            WireEvent(e: FromRunner(Notice(e: Updated(take more)))) => list.push(mut updates, take more),
            take other => { held = Some(take other); return wakes },
        }
    }
    wakes
}

fn queued_update(version: u64) -> WireEvent {
    wire_event(FromRunner(Notice(e: Updated(Update(version: version, content: None, outcomes: list.new())))))
}

// Whether `updates` holds Updates 1 to n, in order.
fn queued_versions(updates: List[Update], n: u64) -> bool {
    if list.len(updates) != n { return false }
    for i in 0u64 .. n { if updates[i].version != i + 1u64 { return false } }
    true
}

// §3 "Repair", the owner's take: an owner that takes Update 1 also takes the Updates queued
// behind it, in order, up to its inbox's capacity (1+q = 5) in one delivery job. The first
// other event ends the run and is held, not lost, and every take counts once toward the
// drain wake. Hand-derived: with the run at 3 of 5, taking Updates 2 and 3 and then `Sent`
// is three takes, so the run wraps once (one wake) and ends at 1; Update 4 stays queued. A
// full backlog takes four more Updates and leaves the fifth queued.
pub fn law_owner_takes_queued() -> bool {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(5u64)
    let _ = channel.try_send(to, queued_update(2u64))
    let _ = channel.try_send(to, queued_update(3u64))
    let _ = channel.try_send(to, wire_event(Sent))
    let _ = channel.try_send(to, queued_update(4u64))
    let mut updates: List[Update] = list.new()
    list.push(mut updates, Update(version: 1u64, content: None, outcomes: list.new()))
    let mut held: Option[WireEvent] = None
    let mut run = 3u64
    let wakes = wire_take_queued(inbox, mut run, 5u64, mut updates, mut held)
    let held_sent = match take held { Some(WireEvent(e: Sent)) => true, _ => false }
    let left = match channel.try_receive(inbox) { Ok(WireEvent(e: FromRunner(Notice(e: Updated(take u))))) => u.version == 4u64, _ => false }
    let mixed = wakes == 1u64 && run == 1u64 && held_sent && left && queued_versions(updates, 3u64)

    for v in 2u64 .. 7u64 { let _ = channel.try_send(to, queued_update(v)) }
    let mut full: List[Update] = list.new()
    list.push(mut full, Update(version: 1u64, content: None, outcomes: list.new()))
    let mut kept: Option[WireEvent] = None
    let mut at = 0u64
    let _ = wire_take_queued(inbox, mut at, 5u64, mut full, mut kept)
    let rest = match channel.try_receive(inbox) { Ok(WireEvent(e: FromRunner(Notice(e: Updated(take u))))) => u.version == 6u64, _ => false }
    let capped = at == 4u64 && rest && (match kept { None => true, _ => false }) && queued_versions(full, 5u64)
    mixed && capped
}

// Installs the Hello binding's result through the allocation pool.
fn wire_owner_hello[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take identity_result: Option[Caller]) -> Option[Box[Service[C]]] waits {
    let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take held, AcceptHello(take identity_result)) {
        Some(take returned) => take returned,
        None => return None,
    }
    if let Error(code) = status { wire_owner_refuse(mut st, code) }
    Some(take restored)
}

// Prepares a call under the allocation pool's budget.
fn wire_owner_call[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]]) -> Option[(Box[Service[C]], Option[Frame])] waits {
    let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take held, PlanCall) {
        Some(take returned) => take returned,
        None => return None,
    }
    let mut service = take restored
    let applied = match take status {
        Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
        Error(code) => Error(code),
    }
    let next = match take applied {
        Ok(take f) => take f, Error(code) => { wire_owner_refuse(mut st, code); None },
    }
    Some((take service, take next))
}

fn wire_owner_control[C: send](mut st: WireLoop[C], op: u8, payload: std.websocket.Control) -> WireStep {
    let _ = channel.try_send(st.credit, ())
    if st.closing { return Again }
    let mut b: Bytes = list.with_capacity(125u64)
    for i in 0u64 .. payload.len { let _ = list.push(mut b, payload.data[i]) }
    match std.wsock.encode(mut st.encoder, true, op, b) {
        Ok(take encoded_control) => { st.control = Some(take encoded_control) },
        Error(e) => return Stop(Error(e)),
    }
    if op == 8u8 { st.closing = true }
    Go(None)
}

fn wire_owner_write_timeout[C: send](mut st: WireLoop[C], end: u64) -> WireStep {
    if !st.closing {
        st.close_at = Some(end)
        match std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(1001u16)) {
            Ok(take close_frame) => { st.control = Some(take close_frame) },
            Error(e) => return Stop(Error(e)),
        }
        st.closing = true
    }
    Go(None)
}

fn wire_owner_read_closed[C: send](mut st: WireLoop[C], payload: std.websocket.Control, take returned: std.wsock.Reader) -> WireStep {
    st.read_back = Some(take returned)
    st.read_closed = true
    if st.write_closed { return Stop(Ok(())) }
    if !st.closing {
        let mut b: Bytes = list.with_capacity(125u64)
        for i in 0u64 .. payload.len { list.push(mut b, payload.data[i]) }
        match std.wsock.encode(mut st.encoder, true, 8u8, b) {
            Ok(take close_bytes) => { st.control = Some(take close_bytes) },
            Error(e) => return Stop(Error(e)),
        }
    }
    st.closing = true
    Go(None)
}

// After an event: queues its frame, polls the service, and decides the frame to
// write now, if any.
fn wire_owner_poll[C: send](mut st: WireLoop[C], mut service: Box[Service[C]], take frame: Option[Frame]) -> WireStep {
    if wire_owner_cut(mut st, mut service) { return Stop(Ok(())) }
    let mut outgoing: Option[Frame] = None
    if !st.closing {
        if let Some(take f) = take frame {
            if let Error(e) = wire_queue_external(mut st.work, st.c, take f, None) { return Stop(Error(e)) }
        }
        let writable = wire_ready(st.busy) && !st.write_closed && none(st.control)
            && (list.len(st.work.output) == 0u64 || !st.work.output[0u64].external)
        match (st.apply_input)(mut service.context, mut st.work, WPoll(writable)) {
            Ok(Some(take f)) => {
                if writable { outgoing = Some(take f) }
                else {
                    let held_check = replace(mut st.work.check, None)
                    if let Error(e) = wire_queue_external(mut st.work, st.c, take f, held_check) { return Stop(Error(e)) }
                }
            },
            Ok(None) => {},
            Error(code) => wire_owner_refuse(mut st, code),
        }
    }
    if st.held_credit && (service.ready)(service.context) { let _ = channel.try_send(st.credit, ()); st.held_credit = false }
    if !st.closing && map.len(st.work.timers) == 0u64 && wire_ready(st.busy) && list.len(st.work.output) == 0u64 &&
        (service.ready)(service.context) && list.len(st.deferred) == 0u64 {
        if let Some(_) = st.work.deadline {
            if let None = outgoing { wire_owner_refuse(mut st, 1001u16) }
        }
    }
    Go(take outgoing)
}

// Packs and offers the next data frame or the queued control frame, and arms
// the close alarm once closing.
fn wire_owner_send[C: send](mut st: WireLoop[C], mut service: Box[Service[C]], pool: Sender[WireAllocation[C]], take outgoing: Option[Frame]) -> WireStep waits {
    let mut data_frame: Option[(Bytes, bool, Option[u64])] = None
    if wire_ready(st.busy) && !st.write_closed && !st.closing && none(st.control) {
        let next = match take outgoing {
            Some(take f) => Some(take f),
            None => if list.len(st.work.output) != 0u64 && st.work.output[0u64].external {
                let WireOutput(frame: take f, marks: _, generations: _, external: _, check: held_check) = list.remove(mut st.work.output, 0u64)
                st.work.check = held_check
                Some(take f)
            } else { None },
        }
        if let Some(take f) = take next {
            let welcome = match f { Welcome(_, _, _, _, _, _) => true, _ => false }
            let check = replace(mut st.work.check, None)
            match wire_pack(pool, st.encoded_to, st.encoded_from, take f) {
                Ok(take b) => { data_frame = Some((take b, welcome, check)) },
                Error(Protocol(1013u16)) => {
                    match std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(1013u16)) {
                        Ok(take refused) => { st.control = Some(take refused) },
                        Error(e) => return Stop(Error(e)),
                    }
                    st.closing = true
                },
                Error(e) => return Stop(Error(e)),
            }
            if wire_owner_cut(mut st, mut service) { return Stop(Ok(())) }
        }
    }
    let unarmed = match st.alarm { None => true, _ => false }
    if st.closing && unarmed {
        let own_close = match st.close_at {
            Some(end) => end,
            None => std.clock.deadline_after_ms(host.mono_ns(st.clock), st.c.socket.close_ms),
        }
        let deadline = match st.work.deadline { Some(cut) => if cut < own_close { cut } else { own_close }, None => own_close }
        st.close_at = Some(deadline)
        let h = std.clock.alarm(st.tasks, st.clock, deadline, st.to, wire_event(Ended(1001u16)))
        st.alarm = Some(take h)
    }
    if wire_ready(st.busy) && !st.write_closed {
        if let Some(take b) = replace(mut st.control, None) {
            if let Error(_) = wire_offer(st.write, mut st.busy, WireUnit(frame: take b, check: None, write_ack: false)) { return Stop(Ok(())) }
            return Again
        }
        if let Some((take packed, welcome, check)) = take data_frame {
            // The check version travels with the unit; WSent or WDropped clears the copy.
            st.work.check = check
            let report_writes = match st.managed { Some(life) => !none(life.first_write), None => false }
            if let Error(_) = wire_offer(st.write, mut st.busy, wire_unit(st.work, take packed, check, report_writes)) { return Stop(Ok(())) }
            if welcome {
                if let Some(take accepted) = replace(mut st.lease, None) { std.wsock.hello_accepted(take accepted) }
            }
        }
    }
    Go(None)
}

// The allocation pool went with the service: join both children and refuse.
fn wire_owner_lost[C: send](take st: WireLoop[C]) -> Result[(), std.wsock.Error] waits {
    // Every owned field stays bound, so it drops after the join as it did
    // when the loop was inline.
    let WireLoop(pub_to: take pub_to, managed: take managed, lease: take lease, to: take to, inbox: take inbox, credit: take credit, write: take write,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: take encoder, rh: take rh, wh: take wh, work: take work, hello_alarm: take hello_alarm, deferred: take deferred, held: take held, control: take control,
        alarm: take alarm, read_back: take read_back, write_back: take write_back, clock: clock, close_at: close_at, expired: expired, ..) = take st
    wire_join(take rh, take wh)
    Error(Protocol(1013u16))
}

fn wire_owner_end[C: send](take st: WireLoop[C], mut service: Box[Service[C]], take result: Result[(), std.wsock.Error]) -> Result[(), std.wsock.Error] waits {
    // Every owned field stays bound, so it drops at the end as it did when the
    // loop was inline; only copyable fields are left out.
    let WireLoop(pub_to: take pub_to, managed: take managed, lease: take lease, to: take to, inbox: take inbox, credit: take credit, write: take write,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: take encoder, rh: take rh, wh: take wh, work: take work, hello_alarm: take hello_alarm, deferred: take deferred, held: take held, control: take control,
        alarm: take alarm, read_back: take read_back, write_back: take write_back, clock: clock, close_at: close_at, expired: expired, ..) = take st
    if let Some(take h) = take alarm {
        let mut timing = take h
        task.cancel(mut timing)
        wire_join(take rh, take wh)
        let _ = task.join(take timing)
    } else {
        wire_join(take rh, take wh)
    }
    if !expired && (match managed { None => true, _ => false }) {
        if let Some(take returned_reader) = take read_back {
            if let Some(take returned_writer) = take write_back {
                if let Some(deadline) = close_at {
                    let _ = std.wsock.finish(take returned_writer, take returned_reader, clock, deadline)
                }
            }
        }
    }
    wire_finish_owner(mut service, pub_to)
    result
}

// At most one inbox capacity of uninterrupted takes between publisher wakes.
fn wire_taken(mut run: u64, capacity: u64) -> bool {
    run += 1u64
    if run == capacity { run = 0u64; true } else { false }
}

pub fn law_owner_take_wakes() -> bool {
    let mut run = 0u64
    let mut wakes = 0u64
    for _ in 0u64 .. 129u64 { if wire_taken(mut run, 64u64) { wakes += 1u64 } }
    wakes == 2u64 && run == 1u64
}

fn wire_finish_owner[C: send](mut service: Service[C], pub_to: Sender[PubIn]) {
    if let Some(take left) = (service.finish)(mut service.context) { let _ = channel.try_send(pub_to, take left) }
}

// The accept loop retains at most max_sessions owner handles and reaps completed
// ones on the next acceptance. Upgrade runs in the owner, so a stalled HTTP
// client cannot prevent the listener accepting another connection.
type WireAccept[C: send]: send {
    socket: Socket, peer: Ip, accepted: u64, slot: std.wsock.Pending, proxies: List[std.wsock.Prefix],
    service: Box[Service[C]], publisher: Sender[PubIn], c: WireConfig, clock: Clock, tasks: Tasks,
    control: Option[OwnerControl], completion: OwnerCompletion, allocation: Sender[WireAllocation[C]],
}

fn wire_accepted[C: send](take x: WireAccept[C]) -> Result[(), std.wsock.Error] waits {
    let WireAccept(completion: take completion, socket: take socket, peer: peer, accepted: accepted, slot: take slot, proxies: take proxies,
        service: take service, publisher: take pub_to, c: c, clock: clock, tasks: tasks, control: take control, allocation: take allocation) = take x
    let admission = scoped fn(ip: Ip) -> bool {
        match control { Some(life) => !closing_at(life.drain, clock), None => true }
    }
    let mut abandoned = 0u64
    let raw = scoped fn(path: Bytes) -> Result[Option[(bool, String)], Capacity] {
        if path != string.as_bytes("/hirsel/status") { return Ok(None) }
        match control {
            Some(life) => Ok(Some(status_response(latest.read(life.status))?)),
            None => Ok(None),
        }
    }
    let received = std.wsock.server_with_site(take socket, take slot, peer, proxies, c.socket, clock, accepted, c.site, raw, admission)
    let result: Result[(), std.wsock.Error] = match take received {
        Ok(None) => Ok(()),
        Ok(Some(take up)) => wire_owner(WireOwner(upgraded: take up, service: take service, publisher: take pub_to, config: c, clock: clock, tasks: tasks, managed: take control), allocation, mut abandoned),
        Error(e) => Error(e),
    }
    let mut final_report = take completion
    final_report.abandoned = abandoned
    result
}

type ServeInput: send = AcceptedSocket(Socket, Ip, u64) | AcceptEnded(NetError) | OwnerReady(u64, Sender[WireEvent], Sender[()]) | OwnerEnded(u64, u64) | ServeStart | ServeWake | ServeRetire | CheckServeIdle | AcceptIdle

type OwnerControl: send { id: u64, to: Sender[ServeInput], drain: Latest[Option[DrainWindow]], status: Latest[Status], first_write: Option[Sender[u64]] }

fn copy_write_notice(notice: Option[Sender[u64]]) -> Option[Sender[u64]] {
    match notice { Some(to) => Some(channel.sender(to)), None => None }
}

resource type OwnerCompletion: send { to: Sender[ServeInput], id: u64, abandoned: u64 } drop(completion) {
    let _ = channel.try_send(completion.to, OwnerEnded(completion.id, completion.abandoned))
}

type Acceptor: send { listener: Listener, clock: Clock, to: Sender[ServeInput], permit: Receiver[()], idle: Option[u64] }

fn accept_sockets(take seed: Acceptor) -> () waits {
    let Acceptor(listener: take listener, clock: clock, to: take to, permit: take permit, idle: idle) = take seed
    let mut bound_listener = take listener
    while let Ok(()) = channel.receive(permit) {
        let until: Until = match idle {
            Some(ms) => At(clock, std.clock.deadline_after_ms(host.mono_ns(clock), std.order.max(ms / 2u64, 1u64))),
            None => Never,
        }
        match host.accept(mut bound_listener, until) {
            Ok((take socket, peer)) => if let Error(_) = channel.send(to, AcceptedSocket(take socket, peer.ip, host.mono_ns(clock))) { return },
            Error(TimedOut) if !none(idle) => if let Error(_) = channel.send(to, AcceptIdle) { return },
            Error(problem) => { let _ = channel.send(to, AcceptEnded(problem)); return },
        }
    }
}

type ManagedRefusal: send { socket: Socket, clock: Clock, until: u64, completion: OwnerCompletion }

fn refuse_managed_socket(take seed: ManagedRefusal) -> () waits {
    let ManagedRefusal(socket: take socket, clock: clock, until: until, completion: take completion) = take seed
    let _ = std.wsock.refuse_socket(take socket, 503u16, At(clock, until))
    let _ = take completion
}

type SessionTask { handle: Task[Result[(), std.wsock.Error]], wake: Option[Sender[WireEvent]] }

type ServeTransport {
    listener: Listener, config: WireConfig, tasks: Tasks, clock: Clock,
    limit: u64, proxies: List[std.wsock.Prefix], publisher: Sender[PubIn], inbox: Receiver[ServeInput], to: Sender[ServeInput],
}

type ServeDrain { events: Sender[LifeEvent], window: Latest[Option[DrainWindow]], status: Latest[Status], idle: Option[u64], first_write: Option[Sender[u64]] }

fn serve_closing(lifecycle: Option[ServeDrain], clock: Clock) -> bool {
    match lifecycle { Some(control) => closing_at(control.window, clock), _ => false }
}

type ServePlace[G: send, H: send]: send {
    listener: Listener, config: WireConfig, tasks: Tasks, clock: Clock, random: Random, wire: Option[Wire[G]],
    max_sessions: u64, proxies: List[std.wsock.Prefix], target: String, publisher: Sender[PubIn],
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], head: Sender[HeadInput],
    inbox: Receiver[ServeInput], to: Sender[ServeInput], events: Sender[LifeEvent], drain: Latest[Option[DrainWindow]], status: Latest[Status], idle: Option[u64], first_write: Option[Sender[u64]],
}

fn run_serve_place[G: send, H: send](take seed: ServePlace[G, H]) -> () waits {
    let events = channel.sender(seed.events)
    let serving = supervise_serve(take seed)
    let _ = channel.send(events, ServeEnded(take serving))
}

fn supervise_serve[G: send, H: send](take seed: ServePlace[G, H]) -> Result[u64, StartError] waits {
    let ServePlace(listener: take listener, config: config, tasks: tasks, clock: clock, random: random, wire: take session_wire,
        max_sessions: limit, proxies: take proxies, target: take target, publisher: take pub_to, place: place,
        head: take head_to, inbox: take inbox, to: take to, events: take events, drain: take drain, status: take status, idle: idle, first_write: take first_write) = take seed
    let make: scoped[view] fn() -> Service[WireSession[G, H]] = fn() -> Service[WireSession[G, H]] {
        let initial: Registry[G, H] = registry()
        let mut service = wire_service_with_head(take initial, random, copy_wire(session_wire), LifecycleHead(channel.sender(head_to)), clock, tasks, config, clone(target))
        service.context.place = Some(place)
        take service
    }
    let transport = ServeTransport(listener: take listener, config: config, tasks: tasks, clock: clock,
        limit: limit, proxies: take proxies, publisher: take pub_to, inbox: take inbox, to: take to)
    match serve_sockets(take transport, Some(ServeDrain(events: take events, window: take drain, status: take status, idle: idle, first_write: take first_write)), make) {
        Ok(count) => Ok(count), Error(Allocation(cap)) => Error(Full(cap)), Error(Network(problem)) => Error(Listen(problem)), _ => Error(Missing("socket")),
    }
}

fn serve_sockets[C: send](take seed: ServeTransport, take lifecycle: Option[ServeDrain], make: scoped[view] fn() -> Service[C]) -> Result[u64, std.wsock.Error] waits {
    let ServeTransport(listener: take listener, config: config, tasks: tasks, clock: clock,
        limit: limit, proxies: take proxies, publisher: take pub_to, inbox: take inbox, to: take to) = take seed
    let pool = std.wsock.pending(config.socket)?
    let allocated: Result[(Sender[WireAllocation[C]], Task[()]), Capacity] = start_wire_pool(tasks, config, clock, config.n_pool, 1024u64)
    let (allocation, allocation_task) = match take allocated {
        Ok(take pair) => take pair, Error(cap) => return Error(Allocation(cap)),
    }
    let (permit, permits): (Sender[()], Receiver[()]) = channel.new(1u64)
    let idle_ms = match lifecycle { Some(control) => control.idle, None => None }
    let acceptor = Acceptor(listener: take listener, clock: clock, to: channel.sender(to), permit: take permits, idle: idle_ms)
    let mut accepting: Option[Task[()]] = Some(task.spawn(tasks, bytes 8192u64, take acceptor, accept_sockets))
    if let Some(control) = lifecycle {
        if let Error(_) = channel.send(control.events, ServePrepared) { return Ok(0u64) }
        if let Ok(ServeStart) = channel.receive(inbox) {} else { return Ok(0u64) }
    }
    let _ = channel.try_send(permit, ())
    let mut owners: Map[u64, SessionTask] = map.new()
    let mut refusing: Map[u64, Task[()]] = map.new()
    let mut serial = 0u64
    let mut abandoned = 0u64
    let mut retiring = false
    let mut idle = false
    let mut checking_idle = false
    loop {
        if retiring || serve_closing(lifecycle, clock) {
            if let Some(take accept_task) = replace(mut accepting, None) {
                let mut counted = take accept_task
                task.cancel(mut counted)
                let _ = task.join(take counted)
                let _ = replace(mut refusing, map.new())
                let mut closing_ids: List[u64] = list.new()
                for (id, owner_task) in owners {
                    match owner_task.wake {
                        Some(wake) => {
                            if retiring {
                                let _ = channel.send(wake, wire_event(RetireWire))
                            } else {
                                let _ = channel.try_send(wake, wire_event(DrainWake))
                            }
                        },
                        None => list.push(mut closing_ids, id),
                    }
                }
                for id in closing_ids { let _ = map.remove(mut owners, id) }
            }
            if map.len(owners) == 0u64 { return Ok(abandoned) }
        }
        if let Some(control) = lifecycle {
            if !none(control.idle) {
                let eligible = map.len(owners) == 0u64
                if idle != eligible {
                    idle = eligible
                    let _ = channel.send(control.events, ServeIdle(idle))
                }
            }
        }
        let event = match channel.receive(inbox) { Ok(take event) => take event, Error(_) => return Ok(abandoned) }
        match take event {
            ServeStart => (),
            CheckServeIdle => if let Some(control) = lifecycle {
                if idle && none(drain_window(latest.read(control.window))) {
                    checking_idle = true
                } else {
                    idle_vote(control.events, false, false)
                }
            },
            AcceptIdle => if let Some(control) = lifecycle {
                // The acceptor has returned to its permit channel. Leave it
                // there while the head votes and, on acceptance, through drain.
                if checking_idle {
                    checking_idle = false
                    idle_vote(control.events, false, idle && none(drain_window(latest.read(control.window))))
                }
                if !serve_closing(lifecycle, clock) { let _ = channel.try_send(permit, ()) }
            },
            ServeRetire => { retiring = true },
            ServeWake => for (_, owner_task) in owners { if let Some(wake) = owner_task.wake { let _ = channel.try_send(wake, wire_event(DrainWake)) } },
            AcceptEnded(problem) => if !retiring && !serve_closing(lifecycle, clock) { return Error(Network(problem)) },
            OwnerReady(id, take wake, take acknowledgement) => {
                if !retiring && !serve_closing(lifecycle, clock) {
                    if let Some(take owner_task) = map.remove(mut owners, id) {
                        let mut promoted = take owner_task
                        promoted.wake = Some(take wake)
                        map.insert(mut owners, id, take promoted)
                        let _ = channel.try_send(acknowledgement, ())
                    }
                }
            },
            OwnerEnded(id, count) => {
                abandoned += count
                if let Some(SessionTask(handle: take handle, wake: _)) = map.remove(mut owners, id) { let _ = task.join(take handle) }
                if let Some(take handle) = map.remove(mut refusing, id) { let _ = task.join(take handle) }
            },
            AcceptedSocket(take socket, peer, at) => {
                if checking_idle {
                    checking_idle = false
                    if let Some(control) = lifecycle { idle_vote(control.events, false, false) }
                }
                if retiring || serve_closing(lifecycle, clock) { continue }
                if idle {
                    idle = false
                    if let Some(control) = lifecycle { let _ = channel.send(control.events, ServeIdle(false)) }
                }
                let _ = channel.try_send(permit, ())
                let id = serial
                serial += 1u64
                let pending: Option[std.wsock.Pending] = if map.len(owners) >= limit { None } else { match std.wsock.acquire(pool) { Ok(take slot) => take slot, _ => None } }
                let slot = match take pending {
                    Some(take slot) => take slot,
                    None => { start_socket_refusal(tasks, take socket, clock, at, config, to, id, mut refusing); continue },
                }
                let copied: List[std.wsock.Prefix] = clone(proxies)
                let prefixes = take copied
                let made = bound bytes config.n_service { make() }
                let service = match take made { Ok(take instance) => take instance, Error(_) => { start_socket_refusal(tasks, take socket, clock, at, config, to, id, mut refusing); continue } }
                let boxed = box.new(take service)
                let completion = match OwnerCompletion(to: channel.sender(to), id: id, abandoned: 0u64) { Ok(take completion) => take completion, Error(_) => continue }
                let control: Option[OwnerControl] = match lifecycle {
                    Some(life) => Some(OwnerControl(id: id, to: channel.sender(to), drain: latest.handle(life.window), status: latest.handle(life.status), first_write: copy_write_notice(life.first_write))), _ => None,
                }
                let job = WireAccept(socket: take socket, peer: peer, accepted: at, slot: take slot, proxies: take prefixes,
                    service: take boxed, publisher: channel.sender(pub_to), c: config,
                    clock: clock, tasks: tasks, control: take control, completion: take completion, allocation: channel.sender(allocation))
                let run: fn(take WireAccept[C]) -> Result[(), std.wsock.Error] waits = wire_accepted
                let handle = task.spawn(tasks, bytes (WIRE_OWNER_FLOOR - WIRE_OWNER_TASK_BYTES + config.n_granted), take job, run)
                map.insert(mut owners, id, SessionTask(handle: take handle, wake: None))
            },
        }
    }
}

fn start_socket_refusal(tasks: Tasks, take socket: Socket, clock: Clock, at: u64, config: WireConfig, to: Sender[ServeInput], id: u64, mut refusing: Map[u64, Task[()]]) {
    if map.len(refusing) >= 16u64 { return }
    if let Ok(take completion) = OwnerCompletion(to: channel.sender(to), id: id, abandoned: 0u64) {
        let job = ManagedRefusal(socket: take socket, clock: clock, until: std.clock.deadline_after_ms(at, config.socket.upgrade_ms), completion: take completion)
        let _ = map.insert(mut refusing, id, task.spawn(tasks, bytes 16384u64, take job, refuse_managed_socket))
    }
}

pub fn serve[C: send](take listener: Listener, tasks: Tasks, clock: Clock, to_publisher: Sender[PubIn], c: WireConfig, max_sessions: u64, take proxies: List[std.wsock.Prefix], make: scoped[view] fn() -> Service[C]) -> Result[(), std.wsock.Error] waits {
    if max_sessions == 0u64 || max_sessions > WIRE_OWNER_LIMIT || !wire_configuration(c) { return Error(Configuration) }
    let required = match serving_bytes(c, max_sessions) { Ok(total) => total, Error(cap) => return Error(Allocation(cap)) }
    let served: Result[Result[(), std.wsock.Error], Capacity] = bound bytes required {
        let (to, inbox): (Sender[ServeInput], Receiver[ServeInput]) = channel.new(serve_inbox_capacity(max_sessions))
        let transport = ServeTransport(listener: take listener, config: c, tasks: tasks, clock: clock,
            limit: max_sessions, proxies: take proxies, publisher: channel.sender(to_publisher), inbox: take inbox, to: take to)
        match serve_sockets(take transport, None, make) { Ok(_) => Ok(()), Error(problem) => Error(problem) }
    }
    match take served { Ok(take ended) => take ended, Error(cap) => Error(Allocation(cap)) }
}

fn limited_reply(take b: Bytes) -> Outcome {
    if list.len(b) > MAX_RETURNED_BYTES {
        Failed(OutOfBytes(Room(requested: list.len(b), available: MAX_RETURNED_BYTES)))
    } else { Returned(take b) }
}

fn register_check[G: send, H: send, A](mut r: Registry[G, H], key: Bytes, ca: std.codec.Codec[A], n: u64, steps: u64) -> Result[(), RegisterError] {
    let check = fn(arg: Bytes) -> Option[Refusal] {
        let seen = bound bytes n {
            let validate = scoped fn() -> Result[Option[Refusal], OutOfTime] {
                bound steps steps {
                    match std.codec.decode(ca, arg) {
                        Ok(_) => { let no_refusal: Option[Refusal] = None; no_refusal },
                        Error(e) => Some(Malformed(bad(e))),
                    }
                }
            }
            isolate(validate)
        }
        match take seen {
            Ok(Ok(Ok(Ok(take why)))) => take why,
            Ok(Ok(Ok(Error(_)))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Ok(Error(_))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Error(c)) => Some(Budget(room(c))),
            Error(c) => Some(Budget(room(c))),
        }
    }
    let go = check
    let copied_result: Bytes = clone(key)
    let copied: Bytes = take copied_result
    map.insert(mut r.checks, take copied, take go)
    Ok(())
}

// The composition root supplies previous/current activation keys. A current key
// always wins; retaining a gone key never substitutes a newly registered entry.
pub fn retain_gone[G: send, H: send](mut r: Registry[G, H], take key: Bytes) -> Result[(), RegisterError] {
    map.insert(mut r.gone, take key, ())
    Ok(())
}

pub opaque type Admitted: send {
    caller: Caller, entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64
}

pub fn admitted(take caller: Caller, take entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64) -> Admitted {
    Admitted(caller: take caller, entries: take entries, arrived: arrived, now: now, budget: budget, arg_max: arg_max)
}

pub type CallWant: send { key: Bytes, stream: u32, p: u64, arg: Bytes, deadline_ms: u32 }
pub opaque type Send: send { key: Bytes, stream: Bytes, p: u64, arg: Bytes, digest: store.RequestDigest, deadline: u64, budget: u64 }

pub fn prepare[G: send, H: send](r: Registry[G, H], a: Admitted, take want: CallWant) -> Result[Send, Refusal] {
    let known = map.contains(r.slots, want.key)
    if !known && !map.contains(r.gone, want.key) { return Error(NoEntry) }
    let mut allowed = false
    for key in a.entries { if key == want.key { allowed = true } }
    if !allowed { return Error(NotAllowed) }
    let size = list.len(want.arg)
    if size > a.arg_max { return Error(Budget(Room(requested: size, available: a.arg_max))) }
    if size > a.budget { return Error(Budget(Room(requested: size, available: a.budget))) }
    let relative: u64 = int.widen(want.deadline_ms)
    let end = std.clock.deadline_after_ms(a.arrived, relative)
    if want.deadline_ms == 0u32 || end <= a.now { return Error(Deadline) }
    if let Some(check) = map.get(r.checks, want.key) {
        if let Some(take why) = check(want.arg) { return Error(take why) }
    }
    let digest = store.request_digest(want.key, want.arg)
    let stream = match stream_key(a.caller, want.stream) { Ok(take b) => take b, Error(c) => return Error(Budget(room(c))) }
    let CallWant(key: take key, stream: _, p: p, arg: take arg, deadline_ms: _) = take want
    Ok(Send(key: take key, stream: take stream, p: p, arg: take arg, digest: digest, deadline: end, budget: a.budget))
}

// The wire owner owns this state.
type WireOwed: send { generation: u64, reply: Bytes }

// v2.19: `fence` is the session's fence root, made at join, and `round` the place's round
// register, from the join's answer. `check` and `sending_done` are the unit handed out last:
// its version, and a copy of its Outcome rows, which a Dropped Reset carries (§3).
pub opaque type WireWork { head: Option[HeadLease], asking: Option[Task[()]], plan_call: bool, timers: Map[u64, Task[()]], granted: Map[u64, Task[Outcome]], output: List[WireOutput], sending: List[WireMark], deadline: Option[u64], drain: Option[Latest[Option[DrainWindow]]], abandoned: u64, fence: Option[Latest[Fence]], round: Option[Latest[RoundAt]], check: Option[u64], sending_done: List[Done], join: Option[PubIn], sending_complete: bool, posts: List[Req] }

fn wire_work() -> WireWork { WireWork(head: None, asking: None, plan_call: false, timers: map.new(), granted: map.new(), output: list.new(), sending: list.new(), deadline: None, drain: None, abandoned: 0u64, fence: None, round: None, check: None, sending_done: list.new(), join: None, sending_complete: false, posts: list.new()) }

fn wire_cut(work: WireWork, clock: Clock) -> bool {
    wire_cut_at(work.drain, clock)
}

fn wire_cut_at(drain: Option[Latest[Option[DrainWindow]]], clock: Clock) -> bool {
    if let Some(root) = drain {
        if let Some(window) = drain_window(latest.read(root)) { return host.mono_ns(clock) >= window.deadline }
    }
    false
}

fn wire_admission_closed(work: WireWork, clock: Clock) -> bool {
    match work.drain { Some(root) => closing_at(root, clock), _ => false }
}
type WireHeld: send { stream: u32, p: u64, digest: store.RequestDigest, forwarded: bool, queued: u64, owed: List[WireOwed] }
type WireMark: send = Unit(Bytes) | V1 | WriteUnit(Bytes)

// The service and public transport callbacks share this owner-local queue. An
// external item has no outcome units or subscription generations to retire.
// `check` is a content unit's version, the oldest of its content components' (§3 "The release
// check"); None for a unit that carries no content and passes unchecked.
type WireOutput: send { frame: Frame, marks: List[WireMark], generations: List[(u32, u64)], external: bool, check: Option[u64] }
type WirePending: send { stream: u32, p: u64, slot: u32, deadline: u32, arg: Bytes, at: u64, grows: bool }
fn anonymous_caller(random: Random) -> Option[Caller] {
    let mut nonce: Bytes = list.with_capacity(16u64)
    host.random(random, mut nonce)
    Some(store.Caller(issuer: 1u8, subject: take nonce))
}

type BindingJob[G: send]: send {
    seed: G, bind: StaticFn[fn(G, Bytes) -> Result[Caller, ()] waits], credential: Bytes, steps: u64
}

fn run_binding[G: send](take job: BindingJob[G]) -> Option[Caller] waits {
    let BindingJob(seed: take seed, bind: bind, credential: take credential, steps: steps) = take job
    let invoke = code.callable(bind)
    let result = bound steps steps { invoke(seed, credential) }
    match take result {
        Ok(Ok(take caller)) if caller.issuer != 1u8 => Some(take caller),
        _ => None,
    }
}

type WireHello[G: send]: send {
    binding: Option[(BindingJob[G], u64)], random: Random, tasks: Tasks, to: Sender[WireEvent]
}

fn wire_bind_hello[G: send](take job: WireHello[G]) -> () waits {
    let WireHello(binding: take binding, random: random, tasks: tasks, to: take to) = take job
    let identity_result: Option[Caller] = match take binding {
        Some((take app, allowance)) => {
            let run: fn(take BindingJob[G]) -> Option[Caller] waits = run_binding
            let handle = task.spawn(tasks, bytes allowance, take app, run)
            match task.join(take handle) { Ok(take caller) => take caller, Error(_) => None }
        },
        None => anonymous_caller(random),
    }
    let _ = channel.send(to, wire_event(HelloBound(take identity_result)))
}

fn deadline_notice(take stream: Bytes, p: u64, generation: u64) -> WireEvent {
    wire_event(FromRunner(Notice(e: Expired(Tick(stream: take stream, p, generation)))))
}

type WireHead: send = LegacyHead(Sender[Req]) | LifecycleHead(Sender[HeadInput])
type HeadOffer = Posted | InboxFull(Req) | InboxClosed

fn copy_wire_head(head: WireHead) -> WireHead {
    match head {
        LegacyHead(to) => LegacyHead(channel.sender(to)),
        LifecycleHead(to) => LifecycleHead(channel.sender(to)),
    }
}

fn try_head(head: WireHead, take req: Req) -> HeadOffer {
    match head {
        LegacyHead(to) => match channel.try_send(to, take req) {
            Ok(()) => Posted,
            Error(Full(take back)) => InboxFull(take back),
            Error(Closed(_)) => InboxClosed,
        },
        LifecycleHead(to) => match channel.try_send(to, RunRequest(take req)) {
            Ok(()) => Posted,
            Error(Full(RunRequest(take back))) => InboxFull(take back),
            Error(Full(_)) => fail("runner: the head inbox returned another input"),
            Error(Closed(_)) => InboxClosed,
        },
    }
}

type SubscriptionRoom: send {
    to: Sender[u64], from: Receiver[u64], slots: u64, limit: u64, held: u64, used: u64,
}

fn subscription_room(limit: u64, max_subs: u64) -> Result[SubscriptionRoom, Capacity] {
    let possible = int.saturating_sub(limit, 64u64) / 8u64
    let wanted = int.saturating_add(max_subs, 1u64)
    let slots = if wanted < possible { wanted } else { possible }
    if slots == 0u64 { return Error(Capacity(requested: 72u64, available: limit)) }
    let (to, from): (Sender[u64], Receiver[u64]) = channel.new(slots)
    Ok(SubscriptionRoom(to: take to, from: take from, slots: slots, limit: limit - (64u64 + slots * 8u64), held: 0u64, used: 0u64))
}

fn subscription_hold(mut quota: SubscriptionRoom, take caller: Caller, take key: Bytes, take arg: Bytes) -> Result[SubscriptionInput, Capacity] {
    while let Ok(charge) = channel.try_receive(quota.from) {
        quota.held -= charge
        quota.used -= 1u64
    }
    // Include the lease record. One refund fits for every issued lease.
    let charge = wire_round(list.capacity(key)) + wire_round(list.capacity(arg)) + wire_round(list.capacity(caller.subject)) + 64u64
    let available = quota.limit - quota.held
    if quota.used == quota.slots || charge > available { return Error(Capacity(requested: charge, available: available)) }
    let lease = match SubscriptionLease(refund: channel.sender(quota.to), charge: charge) { Ok(take l) => take l, Error((c, _)) => return Error(c) }
    quota.held += charge
    quota.used += 1u64
    Ok(SubscriptionInput(room: Some(take lease), key: take key, arg: take arg, caller: take caller))
}

// The copier carries the plain bound into sessions that also support
// registries with movable trigger grants.
pub opaque type Wire[G: send]: send {
    seed: G, duplicate: fn(G) -> G, bind: Option[StaticFn[fn(G, Bytes) -> Result[Caller, ()] waits]],
    bind_bytes: u64, bind_steps: u64,
}

fn copy_plain[G: plain](g: G) -> G { g }

pub fn wire[G: plain + send](grant: G, bind: Option[StaticFn[fn(G, Bytes) -> Result[Caller, ()] waits]], bind_bytes: u64, bind_steps: u64) -> Wire[G] {
    let duplicate: fn(G) -> G = copy_plain
    Wire(seed: grant, duplicate: duplicate, bind: bind, bind_bytes: bind_bytes, bind_steps: bind_steps)
}

fn copy_wire[G: send](supplied: Option[Wire[G]]) -> Option[Wire[G]] {
    match supplied {
        Some(w) => Some(Wire(seed: (w.duplicate)(w.seed), duplicate: w.duplicate, bind: w.bind, bind_bytes: w.bind_bytes, bind_steps: w.bind_steps)),
        None => None,
    }
}

pub opaque type WireSession[G: send, H: send]: send {
    registry: Registry[G, H], place: Option[StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]]], random: Random, wire: Option[Wire[G]], head: WireHead, clock: Clock, tasks: Tasks, config: WireConfig, target: String,
    me: Option[Sender[WireEvent]], publisher: Option[Sender[PubIn]], caller: Option[Caller],
    phase: u8, wants: List[Want], entries: List[Bytes], placing: u64,
    pending: Option[WirePending],
    held: Map[Bytes, WireHeld], refusals: u64, last: u64, generation: u64,
    joined: Option[u64], joining: Option[Receiver[Admit]], join_lease: Option[WireJoinLease], marked: bool, mark: Option[Sender[()]], subscription: Option[(u32, u64)], subscription_room: Option[SubscriptionRoom], sub_generation: u64, subs: List[(u32, u64)], pub_subs: List[u32], reset_seen: bool,
    holding: bool, leaving: List[WireJoinLease], resubs: List[WireResub],
    // §3 "Repair": the drain token's sender, made at each join; the publisher holds the receiver.
    progress: Option[Sender[()]],
    // v2.22 (§3 "Repair"): this join's taken register, the `complete`s taken for this join, and
    // the count last published in the register.
    taken: Option[Latest[Taken]], completes: u64, told_taken: u64
}

// v2.19.2 (§3 "The owner asks for removal"): a replacing Subscribed held while the writer
// holds a content unit. The owner already counts the new instance as live.
type WireResub: send { sub: u32, generation: u64, input: SubscriptionInput }

pub fn wire_service[G: send, H: send](take reg: Registry[G, H], random: Random, take session_wire: Option[Wire[G]], head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, a: Args) -> Service[WireSession[G, H]] {
    wire_service_with_head(take reg, random, take session_wire, LegacyHead(channel.sender(head)), clock, tasks, config, launch_target(a))
}

fn wire_service_seed[G: send, H: send](take reg: Registry[G, H], random: Random, take session_wire: Option[Wire[G]], head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, H]] {
    wire_service_with_head(take reg, random, take session_wire, LegacyHead(channel.sender(head)), clock, tasks, config, take target)
}

fn wire_service_with_head[G: send, H: send](take reg: Registry[G, H], random: Random, take session_wire: Option[Wire[G]], take head: WireHead, clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, H]] {
    let context = WireSession(registry: take reg, place: None, random: random, wire: take session_wire, head: take head, clock: clock, tasks: tasks, config: config, target: take target,
        me: None, publisher: None, caller: None, phase: 0u8, wants: list.new(), entries: list.new(), placing: 0u64,
        pending: None, held: map.new(), refusals: 0u64, last: 0u64, generation: 0u64,
        joined: None, joining: None, join_lease: None, marked: false, mark: None, subscription: None, subscription_room: None, sub_generation: 0u64, subs: list.new(), pub_subs: list.new(), reset_seen: false,
        holding: false, leaving: list.new(), resubs: list.new(), progress: None, taken: None, completes: 0u64, told_taken: 0u64)
    Service(context: take context, step: wire_step, ready: wire_can_read, allocate: wire_service_allocate, finish: wire_finish, check: wire_check_live)
}

fn wire_can_read[G: send, H: send](s: WireSession[G, H]) -> bool {
    (s.phase == 0u8 || s.phase == 3u8) && (match s.pending { None => true, _ => false }) && match s.joining { None => true, _ => false }
}

fn entry_key(identity: View[Bytes], args_fp: u64, result_fp: u64) -> Result[Bytes, Capacity] {
    let mut key: Bytes = list.with_capacity(list.len(identity) + 16u64)
    list.append(mut key, identity)
    std.codec.put_u64(args_fp, mut key)
    std.codec.put_u64(result_fp, mut key)
    Ok(take key)
}

fn wire_key(w: Want) -> Result[Bytes, Capacity] { entry_key(view w.identity, w.args_fp, w.result_fp) }

fn answer_want[G: send, H: send](r: Registry[G, H], key: Bytes, slot: u32) -> Entry {
    if map.contains(r.slots, key) { Ready(slot) } else { Gone }
}

fn wire_stream(caller: Caller, number: u32) -> Bytes {
    result.unwrap(stream_key(caller, number))
}

fn wire_units[G: send, H: send](s: WireSession[G, H]) -> u64 {
    let mut units = 0u64
    for (_, h) in s.held {
        let live = list.len(h.owed) + h.queued
        units += if h.forwarded && live == 0u64 { 1u64 } else { live }
    }
    if let Some(p) = s.pending { if p.grows { units += 1u64 } }
    units
}

// std codec: a u32 tag, u32 lengths and integers at their width. A Done is
// stream 4 and p 8, then the Outcome's tag 4 and payload. Every variant is
// named, so a new one cannot fall into another's size.
fn wire_done_size(o: Outcome) -> u64 {
    12u64 + match o {
        Returned(b) => 8u64 + list.len(b),
        Failed(OutOfBytes(_)) => 24u64,
        Failed(OutOfTime(_)) => 16u64,
        Failed(Raised(_)) => 12u64,
        Failed(Gone) => 8u64,
        Refused(Budget(_)) => 24u64,
        Refused(Malformed(_)) => 20u64,
        Refused(NoEntry) => 8u64,
        Refused(Overloaded) => 8u64,
        Refused(Deadline) => 8u64,
        Refused(NotAllowed) => 8u64,
        Refused(RequestMismatch) => 8u64,
        Refused(HistoryUnavailable) => 8u64,
        Abandoned => 4u64,
        InDoubt => 4u64,
    }
}

fn wire_rows_size(rows: List[Row]) -> u64 {
    let mut size = 0u64
    for row in rows {
        size += 12u64 + list.len(row.key)
        if let Some(value) = row.value { size += 4u64 + list.len(value) }
    }
    size
}

fn wire_optional_bytes(b: Option[Bytes]) -> u64 {
    match b { Some(value) => 4u64 + list.len(value), None => 0u64 }
}

fn wire_done_bytes(done: List[Done]) -> u64 {
    let mut size = 0u64
    for d in done { size += wire_done_size(d.outcome) }
    size
}

fn wire_output_size(f: Frame) -> u64 {
    match f {
        Hello(token, wanted) => {
            let mut size = 12u64 + wire_optional_bytes(token)
            for entry in wanted { size += 20u64 + list.len(entry.identity) }
            size
        },
        Call(_, _, _, _, arg) => 28u64 + list.len(arg),
        Subscribe(_, _, arg, resume) => 20u64 + list.len(arg) + wire_optional_bytes(resume),
        Unsubscribe(_) => 8u64,
        Welcome(caller, _, _, digest, target, _) => 37u64 + list.len(caller.subject) + list.len(digest) + string.byte_len(target),
        Placed(Ready(_)) => 12u64,
        Placed(Resolve(_, args)) => 16u64 + list.len(args),
        Placed(Gone) => 8u64,
        Batch(_, complete, rows, done) => 24u64 + 4u64 * list.len(complete) + wire_rows_size(rows) + wire_done_bytes(done),
        Reset(_, done) => 16u64 + wire_done_bytes(done),
        Ended(_, o) => 8u64 + wire_done_size(o) - 12u64,
    }
}

// Retained row storage includes the 60-byte Row records and the rounded
// backing buffers of their key and value lists (WIRE-SPEC F4).
fn wire_rows_retained(rows: List[Row]) -> u64 {
    let mut size = wire_round(60u64 * list.capacity(rows))
    for row in rows {
        size += wire_round(list.capacity(row.key))
        if let Some(value) = row.value { size += wire_round(list.capacity(value)) }
    }
    size
}

fn wire_batch_charge(complete: List[u32], rows: List[Row], done: List[Done], reserved: bool) -> u64 {
    let row_payload = wire_rows_size(rows)
    let retained = wire_rows_retained(rows)
    24u64 + 4u64 * list.len(complete) + (if retained > row_payload { retained } else { row_payload })
        + (if reserved { 0u64 } else { wire_done_bytes(done) })
}

fn wire_output_charge(f: Frame, reserved: bool) -> u64 {
    // Slot and V1 marks already hold the outcome reserve through handoff.
    match f {
        Batch(_, complete, rows, done) => wire_batch_charge(complete, rows, done, reserved),
        Reset(_, _) => if reserved { 16u64 } else { wire_output_size(f) },
        _ => wire_output_size(f),
    }
}

fn wire_queued_bytes(output: List[WireOutput]) -> u64 {
    // WireOutput's charge-v1 size is Frame (88), two Lists (24 each)
    // and the external flag (1).
    let mut size = wire_round(137u64 * list.capacity(output))
    for o in output { size += wire_output_charge(o.frame, list.len(o.marks) != 0u64) }
    size
}

fn wire_queue_external(mut work: WireWork, c: WireConfig, take frame: Frame, check: Option[u64]) -> Result[(), std.wsock.Error] {
    if wire_output_size(frame) > c.socket.max_frame { return Error(Protocol(1009u16)) }
    if list.len(work.output) >= 1u64 + c.q || wire_queued_bytes(work.output) + wire_output_charge(frame, false) > c.budget { return Error(Busy) }
    let item = WireOutput(frame: take frame, marks: list.new(), generations: list.new(), external: true, check: check)
    list.push(mut work.output, take item)
    Ok(())
}

fn wire_queue(mut output: List[WireOutput], take frame: Frame, take marks: List[WireMark], take generations: List[(u32, u64)]) {
    wire_queue_checked(mut output, take frame, take marks, take generations, None)
}

fn wire_queue_checked(mut output: List[WireOutput], take frame: Frame, take marks: List[WireMark], take generations: List[(u32, u64)], check: Option[u64]) {
    list.push(mut output, WireOutput(frame: take frame, marks: take marks, generations: take generations, external: false, check: check))
}

fn wire_refused[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, stream: u32, p: u64, take why: Refusal) -> Result[(), u16] {
    if s.refusals >= 1u64 + s.config.q { return Error(1008u16) }
    s.refusals += 1u64
    let mut done: List[Done] = list.new()
    list.push(mut done, Done(stream: stream, p: p, outcome: Refused(take why)))
    let mut marks: List[WireMark] = list.new()
    list.push(mut marks, V1)
    let version = s.last
    wire_queue(mut work.output, Batch(version, list.new(), list.new(), take done), take marks, list.new())
    Ok(())
}

fn wire_row[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, key: Bytes, stream: u32, p: u64, version: u64, take outcome: Outcome) {
    let mut done: List[Done] = list.new()
    list.push(mut done, Done(stream: stream, p: p, outcome: take outcome))
    let mut marks: List[WireMark] = list.new()
    list.push(mut marks, Unit(clone(key)))
    wire_queue(mut work.output, Batch(version, list.new(), list.new(), take done), take marks, list.new())
}

fn wire_reset[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], version: u64) -> Result[(), u16] {
    if s.reset_seen { return Error(1008u16) }
    s.reset_seen = true
    wire_reset_rows(mut s, mut output, version, list.new(), list.new())
}

fn wire_reset_rows[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], version: u64, take latest_done: List[Done], take latest_marks: List[WireMark]) -> Result[(), u16] {
    let mut done: List[Done] = list.new()
    let mut marks: List[WireMark] = list.new()
    let all = replace(mut output, list.new())
    for take o in take all {
        if o.external {
            list.push(mut output, take o)
            continue
        }
        let WireOutput(frame: take f, marks: take held, generations: _, external: _, check: _) = take o
        for take m in take held { list.push(mut marks, take m) }
        match take f {
            Batch(_, _, _, take ds) => for take d in take ds { list.push(mut done, take d) },
            Reset(_, take ds) => for take d in take ds { list.push(mut done, take d) },
            _ => {},
        }
    }
    for take d in latest_done { list.push(mut done, take d) }
    for take m in latest_marks { list.push(mut marks, take m) }
    let _ = replace(mut s.subs, list.new())
    let _ = replace(mut s.pub_subs, list.new())
    wire_leave(mut s)
    s.joined = None
    let _ = replace(mut s.joining, None)
    let _ = replace(mut s.subscription, None)
    wire_queue(mut output, Reset(version, take done), take marks, list.new())
    Ok(())
}

fn wire_drop_stale(mut generations: List[(u32, u64)], active: List[(u32, u64)]) -> bool {
    let mut index = list.len(generations)
    let mut changed = false
    while index != 0u64 {
        index -= 1u64
        let (sub, generation) = generations[index]
        if sub_generation(active, sub) != Some(generation) {
            let _ = list.remove(mut generations, index)
            changed = true
        }
    }
    changed
}

fn wire_current_output(active: List[(u32, u64)], take output: WireOutput) -> Option[WireOutput] {
    if output.external { return Some(take output) }
    let WireOutput(frame: take f, marks: take marks, generations: take stamps, external: external, check: check) = take output
    let mut generations = take stamps
    if let Ended(sub, _) = f {
        // A terminal frame has no active subscription unless the id was reused.
        if let Some(generation) = sub_generation(active, sub) {
            if sub_generation(generations, sub) != Some(generation) { return None }
        }
    } else {
        if wire_drop_stale(mut generations, active) {
            if let Batch(version, take complete, take rows, take done) = take f {
                let mut live_complete = take complete
                let mut kept = 0u64
                for index in 0u64 .. list.len(live_complete) {
                    if let Some(_) = sub_generation(generations, live_complete[index]) {
                        list.swap(mut live_complete, kept, index)
                        kept += 1u64
                    }
                }
                while list.len(live_complete) > kept { let _ = list.pop(mut live_complete) }
                let mut live_rows = take rows
                kept = 0u64
                for index in 0u64 .. list.len(live_rows) {
                    if let Some(_) = sub_generation(generations, live_rows[index].sub) {
                        list.swap(mut live_rows, kept, index)
                        kept += 1u64
                    }
                }
                while list.len(live_rows) > kept { let _ = list.pop(mut live_rows) }
                if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 && list.len(done) == 0u64 { return None }
                // Content left out of a unit is gone from it; what stays keeps the unit's version.
                let kept_check: Option[u64] = if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 { None } else { check }
                return Some(WireOutput(frame: Batch(version, take live_complete, take live_rows, take done), marks: take marks, generations: take generations, external: external, check: kept_check))
            }
            return None
        }
    }
    Some(WireOutput(frame: take f, marks: take marks, generations: take generations, external: external, check: check))
}

// A `complete` replaces its sub's image from empty (v2.20 item 5), so whatever the owner still
// holds of the same instance ahead of it, rows or an earlier `complete`, is superseded and goes
// before `budget` is checked: the rows a Reset weighs are coalesced (§3). Outcomes, their marks
// and other subs' content stay.
fn wire_supersede(mut output: List[WireOutput], replacing: List[(u32, u64)]) {
    let mut kept = 0u64
    for index in 0u64 .. list.len(output) {
        let empty = WireOutput(frame: Reset(0u64, list.new()), marks: list.new(), generations: list.new(), external: false, check: None)
        let queued = list.set(mut output, index, take empty)
        if let Some(take current) = wire_superseded(take queued, replacing) {
            let _ = list.set(mut output, kept, take current)
            kept += 1u64
        }
    }
    while list.len(output) > kept { let _ = list.pop(mut output) }
}

fn wire_superseded(take output: WireOutput, replacing: List[(u32, u64)]) -> Option[WireOutput] {
    if output.external { return Some(take output) }
    let WireOutput(frame: take f, marks: take marks, generations: take stamps, external: external, check: check) = take output
    let mut generations = take stamps
    let mut gone: List[(u32, u64)] = list.new()
    if let Batch(_, _, _, _) = f {
        let mut index = list.len(generations)
        while index != 0u64 {
            index -= 1u64
            let (sub, generation) = generations[index]
            if sub_generation(replacing, sub) == Some(generation) {
                let _ = list.remove(mut generations, index)
                list.push(mut gone, (sub, generation))
            }
        }
    }
    if list.len(gone) == 0u64 { return Some(WireOutput(frame: take f, marks: take marks, generations: take generations, external: external, check: check)) }
    if let Batch(version, take complete, take rows, take done) = take f {
        let mut live_complete = take complete
        let mut kept = 0u64
        for index in 0u64 .. list.len(live_complete) {
            if let None = sub_generation(gone, live_complete[index]) {
                list.swap(mut live_complete, kept, index)
                kept += 1u64
            }
        }
        while list.len(live_complete) > kept { let _ = list.pop(mut live_complete) }
        let mut live_rows = take rows
        kept = 0u64
        for index in 0u64 .. list.len(live_rows) {
            if let None = sub_generation(gone, live_rows[index].sub) {
                list.swap(mut live_rows, kept, index)
                kept += 1u64
            }
        }
        while list.len(live_rows) > kept { let _ = list.pop(mut live_rows) }
        if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 && list.len(done) == 0u64 { return None }
        let kept_check: Option[u64] = if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 { None } else { check }
        return Some(WireOutput(frame: Batch(version, take live_complete, take live_rows, take done), marks: take marks, generations: take generations, external: external, check: kept_check))
    }
    None
}

fn wire_prune_output[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], retired: Option[u32]) {
    let mut kept = 0u64
    for index in 0u64 .. list.len(output) {
        let empty = WireOutput(frame: Reset(0u64, list.new()), marks: list.new(), generations: list.new(), external: false, check: None)
        let queued = list.set(mut output, index, take empty)
        if !queued.external { if let Ended(sub, _) = queued.frame { if retired == Some(sub) { continue } } }
        if let Some(take current) = wire_current_output(s.subs, take queued) {
            let _ = list.set(mut output, kept, take current)
            kept += 1u64
        }
    }
    while list.len(output) > kept { let _ = list.pop(mut output) }
}

// A content unit's Outcome rows are copied before it is handed out, so a Dropped Reset can
// carry them (§3); a copy that cannot be made closes the session (1013) rather than send the
// unit unchecked or lose the rows.
fn wire_take_output[G: send, H: send](s: WireSession[G, H], mut work: WireWork) -> Result[Option[Frame], u16] {
    let selected = loop {
        if list.len(work.output) == 0u64 { return Ok(None) }
        let next = list.remove(mut work.output, 0u64)
        if let Some(take current) = wire_current_output(s.subs, take next) { break take current }
    }
    let WireOutput(frame: take f, marks: take marks, generations: _, external: _, check: check) = take selected
    work.sending = take marks
    work.check = check
    work.sending_done = list.new()
    work.sending_complete = wire_carries_complete(f)
    if let Some(_) = check {
        if let Batch(_, _, _, done) = f {
            if list.len(done) != 0u64 {
                let copied: List[Done] = clone(done)
                { work.sending_done = take copied }
            }
        }
    }
    Ok(Some(take f))
}

// v2.19 (§3): the writer dropped the content unit it was handed. Every content component
// the owner holds goes; every Outcome row, the dropped unit's included, rides in one Reset
// that never counts toward the protocol-error close.
fn wire_dropped[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork) -> Result[(), u16] {
    let marks = replace(mut work.sending, list.new())
    let done = replace(mut work.sending_done, list.new())
    work.check = None
    work.sending_complete = false
    let version = s.last
    wire_reset_rows(mut s, mut work.output, version, take done, take marks)
}

fn wire_sent[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork) {
    work.check = None
    work.sending_complete = false
    work.sending_done = list.new()
    let marks = replace(mut work.sending, list.new())
    for take mark in take marks {
        let key = match take mark {
            V1 => { s.refusals -= 1u64; continue },
            Unit(take key) => take key,
            WriteUnit(take key) => take key,
        }
        if let Some(take found) = map.remove(mut s.held, key) {
            let mut h = take found
            h.queued -= 1u64
            if h.forwarded || h.queued != 0u64 || list.len(h.owed) != 0u64 { map.insert(mut s.held, take key, take h) }
        }
    }
}

fn wire_begin_hello[G: send, H: send](s: WireSession[G, H], mut work: WireWork, take credential: Option[Bytes]) -> Result[(), u16] {
    let to = match s.me { Some(to) => channel.sender(to), None => return Error(1008u16) }
    let mut binding: Option[(BindingJob[G], u64)] = None
    let mut allowance = 4096u64
    if let Some(w) = s.wire {
        if let Some(bind) = w.bind {
            let raw = match take credential { Some(take payload) => take payload, None => list.new() }
            let app = BindingJob(seed: (w.duplicate)(w.seed), bind: bind, credential: take raw, steps: w.bind_steps)
            allowance = int.saturating_add(allowance, w.bind_bytes)
            binding = Some((take app, w.bind_bytes))
        }
    }
    let job = WireHello(binding: take binding, random: s.random, tasks: s.tasks, to: take to)
    let run: fn(take WireHello[G]) -> () waits = wire_bind_hello
    let h = task.spawn(s.tasks, bytes allowance, take job, run)
 work.asking = Some(take h); Ok(())
}

pub type ServicePlan: send = NoAction | PlanRefusal(u32, u64, Refusal) | PlannedCall(Send, Admitted, u32, Bytes, Option[Outcome]) | PlannedUpdate(List[WireOutput], List[u64]) | PlannedSubscribe(u32, SubscriptionInput) | SubscriptionRefusal(u32, Outcome) | ResumeReset

fn wire_plan_call[G: send, H: send](s: WireSession[G, H], take pending: WirePending) -> Result[ServicePlan, u16] {
    let WirePending(stream: stream, p: p, slot: slot, deadline: deadline_ms, arg: take arg, at: at, grows: _) = take pending
    let index: u64 = int.widen(slot)
    if index >= list.len(s.entries) { return Ok(PlanRefusal(stream, p, NoEntry)) }
    let caller: Caller = match s.caller {
        Some(a) => {
            let copied: Caller = clone(a)
            take copied
        },
        _ => return Error(1008u16),
    }
    let mut entries: List[Bytes] = list.new()
    let copied_key: Bytes = clone(s.entries[index])
    let key = take copied_key
    let copied_entry: Bytes = clone(key)
    let key_copy = take copied_entry
    list.push(mut entries, take key_copy)
    let context = admitted(take caller, take entries, at, host.mono_ns(s.clock), s.config.budget, s.config.socket.max_frame)
    let want = CallWant(key: take key, stream: stream, p: p, arg: take arg, deadline_ms: deadline_ms)
    match prepare(s.registry, context, take want) {
        Ok(take sent) => {
            let backing: Bytes = list.with_capacity(DONE_MAX)
            let computed: Option[Outcome] = match map.get(s.registry.slots, sent.key) {
                Some(Compute(_)) => Some(call(s.registry, sent.key, sent.arg)),
                _ => None,
            }
            Ok(PlannedCall(take sent, take context, stream, take backing, take computed))
        },
        Error(take why) => Ok(PlanRefusal(stream, p, take why)),
    }
}

fn wire_apply_plan[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take plan: ServicePlan) -> Result[(), u16] {
    let (take sent, take context, stream, take reply, take computed) = match take plan {
        NoAction => return Ok(()),
        PlanRefusal(stream, p, take why) => return wire_refused(mut s, mut work, stream, p, take why),
        PlannedUpdate(take output, take completed) => {
            work.output = take output
            for id in completed { let _ = map.remove(mut work.timers, id) }
            return Ok(())
        },
        PlannedSubscribe(sub, take input) => return wire_apply_subscribe(mut s, mut work, sub, take input),
        SubscriptionRefusal(sub, take why) => { wire_end(mut s, mut work.output, sub, take why); return Ok(()) },
        ResumeReset => {
            let version = s.last
            return wire_reset_rows(mut s, mut work.output, version, list.new(), list.new())
        },
        PlannedCall(take prepared, take caller_context, stream, take reply, take computed) =>
            (take prepared, take caller_context, stream, take reply, take computed),
    }
    let p = sent.p
    let k = slot_key(sent.stream, p)
    let (forwarded, queued) = match map.get(s.held, k) {
        Some(h) => {
            if (h.forwarded || list.len(h.owed) != 0u64) && h.digest != sent.digest { return Error(1008u16) }
            (h.forwarded, h.queued)
        },
        None => (false, 0u64),
    }
    if wire_admission_closed(work, s.clock) && !forwarded { return wire_refused(mut s, mut work, stream, p, Overloaded) }
    let uses_grant = match map.get(s.registry.slots, sent.key) { Some(Granted(_)) => true, _ => false }
    if uses_grant {
        let Admitted(caller: take caller, ..) = take context
        return wire_start_granted(mut s, mut work, take caller, take sent, take k, stream, take reply)
    }
    let durable = match map.get(s.registry.slots, sent.key) { Some(Transact(_, _, _, _, _)) => true, None => true, _ => false }
    if !durable {
        let is_compute = match map.get(s.registry.slots, sent.key) { Some(Compute(_)) => true, _ => false }
        if !is_compute { return wire_refused(mut s, mut work, stream, p, NotAllowed) }
        let outcome = match take computed {
            Some(take result) => take result,
            None => return wire_refused(mut s, mut work, stream, p, NotAllowed),
        }
        if wire_cut(work, s.clock) { work.abandoned += 1u64; return Ok(()) }
        let held = WireHeld(stream: stream, p: p, digest: sent.digest, forwarded: false, queued: queued + 1u64, owed: list.new())
        map.insert(mut s.held, clone(k), take held)
        let version = s.last
        wire_row(mut s, mut work, k, stream, p, version, take outcome)
        return Ok(())
    }
    if let None = work.head {
        match head_lease(copy_wire_head(s.head)) {
            Ok(take lease) => { work.head = Some(take lease) },
            Error(_) => return wire_refused(mut s, mut work, stream, p, Overloaded),
        }
    }
    let seed = if !forwarded {
        let made = match work.head { Some(lease) => owner_seed(lease), None => fail("runner: missing head lease") }
        match take made { Ok(take x) => take x, Error(_) => return wire_refused(mut s, mut work, stream, p, Overloaded) }
    } else {
        None
    }
    s.generation += 1u64
    let until = match work.deadline { Some(cut) => if cut < sent.deadline { cut } else { sent.deadline }, None => sent.deadline }
    let h = match s.me {
        Some(to) => std.clock.alarm(s.tasks, s.clock, until, to, deadline_notice(clone(sent.stream), p, s.generation)),
        None => return Error(1008u16),
    }
    map.reserve(mut work.timers, 1u64)
    map.reserve(mut s.held, 1u64)
    let owed = WireOwed(generation: s.generation, reply: take reply)
    if forwarded {
        let mut held = option.unwrap(map.remove(mut s.held, k))
        list.push(mut held.owed, take owed)
        map.insert(mut s.held, take k, take held)
    } else {
        let Send(key: take entry, stream: take named, p: position, arg: take argument, digest: digest, deadline: deadline, budget: _) = take sent
        let (live, identity) = match work.head {
            Some(lease) => (latest.handle(lease.live), latest.handle(lease.identity)),
            None => fail("runner: missing head lease"),
        }
        let Admitted(caller: take principal, ..) = take context
        let request = Request(caller: take principal, stream: take named, p: position, key: take entry, arg: take argument, digest: digest, deadline: deadline, reply_to: wire_me(s), live: take live, identity: take identity, seed: take seed)
        let mut sends: List[WireOwed] = list.new()
        list.push(mut sends, take owed)
        // v2.23: a full head inbox does not refuse. The request waits in `posts`, in order, and
        // the owner loop posts it with a waiting send (wire_post). The slot table still bounds a
        // session to 1 + q requests at the head.
        let req = Req(e: Requested(take request))
        if list.len(work.posts) != 0u64 {
            list.push(mut work.posts, take req)
        } else {
            match try_head(s.head, take req) {
                Posted => (),
                InboxFull(take back) => list.push(mut work.posts, take back),
                InboxClosed => return Error(1011u16),
            }
        }
        map.insert(mut s.held, take k, WireHeld(stream: stream, p: p, digest: digest, forwarded: true, queued: queued, owed: take sends))
    }
    map.insert(mut work.timers, s.generation, take h)
    Ok(())
}

fn wire_start_granted[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take caller: Caller, take sent: Send, take key: Bytes, stream: u32, take reply: Bytes) -> Result[(), u16] {
    let Send(key: take entry, stream: take named, p: p, arg: take argument, digest: digest, deadline: deadline, budget: _) = take sent
    let seed = match s.wire {
        Some(g) => (g.duplicate)(g.seed),
        None => return wire_refused(mut s, mut work, stream, p, NotAllowed),
    }
    if host.mono_ns(s.clock) >= deadline { return wire_refused(mut s, mut work, stream, p, Deadline) }
    map.reserve(mut work.timers, 1u64)
    map.reserve(mut work.granted, 1u64)
    map.reserve(mut s.held, 1u64)
    let mut fresh: List[WireOwed] = list.new()
    let reserved: Result[(), Capacity] = match map.update(mut s.held, key, scoped fn(mut held: WireHeld) -> Result[(), Capacity] {
        list.try_reserve(mut held.owed, 1u64)
    }) {
        Some(outcome) => outcome,
        None => list.try_reserve(mut fresh, 1u64),
    }
    if let Error(cap) = reserved { return wire_refused(mut s, mut work, stream, p, Budget(room(cap))) }
    s.generation += 1u64
    let generation = s.generation
    let until = match work.deadline { Some(cut) => if cut < deadline { cut } else { deadline }, None => deadline }
    let to = wire_me(s)
    let timer = std.clock.alarm(s.tasks, s.clock, until, to, deadline_notice(clone(named), p, generation))
    let report = WireGrantReport(tick: Tick(stream: take named, p: p, generation: generation), to: take to, clock: s.clock, deadline: until)
    let launched: Result[Task[Outcome], Refusal] = match map.get(s.registry.slots, entry) {
        Some(Granted(go)) => match go(s.tasks, Direct(take seed), take caller, take argument, Some(WireGrant(take report))) {
            Ok(take handle) => Ok(take handle),
            Error(cap) => Error(Budget(room(cap))),
        },
        _ => Error(NoEntry),
    }
    let job = match take launched {
        Ok(take handle) => take handle,
        Error(take reason) => return wire_refused(mut s, mut work, stream, p, take reason),
    }
    let mut held = match map.remove(mut s.held, key) {
        Some(take previous) => take previous,
        None => WireHeld(stream: stream, p: p, digest: digest, forwarded: false, queued: 0u64, owed: take fresh),
    }
    list.push(mut held.owed, WireOwed(generation: generation, reply: take reply))
    map.insert(mut s.held, take key, take held)
    map.insert(mut work.timers, generation, take timer)
    map.insert(mut work.granted, generation, take job)
    Ok(())
}

// An Ended the owner makes itself passes unchecked; a publisher-made one is content (§3).
fn wire_end[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], sub: u32, take outcome: Outcome) {
    wire_end_checked(mut s, mut output, sub, take outcome, None)
}

fn wire_end_checked[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], sub: u32, take outcome: Outcome, check: Option[u64]) {
    let mut generations: List[(u32, u64)] = list.new()
    if let Some(generation) = sub_generation(s.subs, sub) { stamp_rows(mut generations, sub, generation) }
    wire_stop_sub(mut s, mut output, sub)
    wire_queue_checked(mut output, Ended(sub, take outcome), list.new(), take generations, check)
}

fn wire_subscribed[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, sub: u32, take input: SubscriptionInput) {
    let who = option.unwrap(s.joined)
    let to_pub = wire_publisher(s)
    s.sub_generation += 1u64
    let generation = s.sub_generation
    let mut index = 0u64
    while index < list.len(s.subs) && s.subs[index].0 != sub { index += 1u64 }
    if index == list.len(s.subs) {
        list.reserve(mut s.subs, 1u64)
    }
    let registered = list.contains(s.pub_subs, sub)
    if !registered {
        list.reserve(mut s.pub_subs, 1u64)
    }
    if registered && s.holding {
        // v2.19.2: this Subscribed removes the publisher's live instance, so it waits for the writer.
        let mut at = 0u64
        while at < list.len(s.resubs) && s.resubs[at].sub != sub { at += 1u64 }
        let held = WireResub(sub: sub, generation: generation, input: take input)
        if at == list.len(s.resubs) {
            list.reserve(mut s.resubs, 1u64)
            list.push(mut s.resubs, take held)
        } else {
            let _ = list.set(mut s.resubs, at, take held)
        }
    } else {
        let sent = channel.try_send(to_pub, PubIn(e: WireSubscribed(who, sub, generation, take input)))
        if let Error(_) = take sent { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return }
    }
    if index == list.len(s.subs) {
        list.push(mut s.subs, (sub, generation))
    } else {
        s.subs[index] = (sub, generation)
    }
    if !registered { list.push(mut s.pub_subs, sub) }
}

fn wire_plan_subscribe[G: send, H: send](mut s: WireSession[G, H], sub: u32, slot: u32, take arg: Bytes, take resume: Option[Bytes]) -> Result[ServicePlan, u16] {
    if s.phase != 3u8 { return Error(1008u16) }
    if let Some(_) = resume { return Ok(ResumeReset) }
    let index: u64 = int.widen(slot)
    if index >= list.len(s.entries) { return Ok(SubscriptionRefusal(sub, Refused(NoEntry))) }
    let cloned: Bytes = clone(s.entries[index])
    let key = take cloned
    if !map.contains(s.registry.slots, key) {
        let outcome: Outcome = if map.contains(s.registry.gone, key) { Failed(Gone) } else { Refused(NoEntry) }
        return Ok(SubscriptionRefusal(sub, take outcome))
    }
    let is_query = match map.get(s.registry.slots, key) { Some(Query(_, _, _)) => true, _ => false }
    if !is_query { return Ok(SubscriptionRefusal(sub, Refused(NoEntry))) }
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if !registered && list.len(s.pub_subs) >= s.config.max_subs { return Ok(SubscriptionRefusal(sub, Refused(NotAllowed))) }
    let refused = match map.get(s.registry.checks, key) { Some(check) => check(arg), _ => { let no_refusal: Option[Refusal] = None; no_refusal } }
    if let Some(take why) = take refused { return Ok(SubscriptionRefusal(sub, Refused(take why))) }
    if let None = s.subscription_room {
        let limit = int.saturating_sub(WIRE_SESSION_CEILING, wire_variable_peak(s.config) + s.config.n_granted)
        match subscription_room(limit, s.config.max_subs) {
            Ok(take quota) => { s.subscription_room = Some(take quota) },
            Error(_) => return Ok(SubscriptionRefusal(sub, Refused(Overloaded))),
        }
    }
    let caller: Caller = match s.caller {
        Some(held) => clone(held),
        None => return Error(1008u16),
    }
    let mut quota = option.unwrap(replace(mut s.subscription_room, None))
    let held = subscription_hold(mut quota, take caller, take key, take arg)
    s.subscription_room = Some(take quota)
    match take held {
        Ok(take input) => Ok(PlannedSubscribe(sub, take input)),
        Error(_) => Ok(SubscriptionRefusal(sub, Refused(Overloaded))),
    }
}

fn wire_apply_subscribe[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, sub: u32, take input: SubscriptionInput) -> Result[(), u16] {
    if wire_admission_closed(work, s.clock) {
        wire_end(mut s, mut work.output, sub, Refused(Overloaded))
        return Ok(())
    }
    if let Some(_) = s.joined { wire_subscribed(mut s, mut work, sub, take input); return Ok(()) }
    let (told, hear): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    // v2.19: the session's fence root, at {0, 0}; the publisher gets a handle in the Join.
    let fence = latest.new(arc.new(Fence(prior: 0u64, latest: 0u64)))
    let (closing, closed): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (token, progress): (Sender[()], Receiver[()]) = channel.new(1u64)
    if let None = work.head {
        match head_lease(copy_wire_head(s.head)) {
            Ok(take h) => { work.head = Some(take h) },
            Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) },
        }
    }
    let identity = match work.head { Some(h) => latest.handle(h.identity), None => fail("runner: missing head lease") }
    // v2.22: the first Subscribe rides in the Join, so its room is reserved now.
    list.reserve(mut s.subs, 1u64)
    list.reserve(mut s.pub_subs, 1u64)
    let taken = latest.new(arc.new(Taken(n: 0u64)))
    s.sub_generation += 1u64
    let generation = s.sub_generation
    let first = Some(JoinSubscribe(sub: sub, generation: generation, input: take input))
    let join = if s.marked {
        s.mark = Some(take closing)
        Join(to: wire_me(s), told: take told, mark: Some(take closed), closed: None, identity: Some(take identity), fence: Some(latest.handle(fence)), progress: Some(take progress), taken: Some(latest.handle(taken)), first: take first)
    } else {
        list.reserve(mut s.leaving, 1u64)
        let lease = match WireJoinLease(closing: take closing, publisher: wire_publisher(s)) { Ok(take l) => take l, Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) } }
        s.join_lease = Some(take lease)
        Join(to: wire_me(s), told: take told, mark: None, closed: Some(take closed), identity: Some(take identity), fence: Some(latest.handle(fence)), progress: Some(take progress), taken: Some(latest.handle(taken)), first: take first)
    }
    // v2.22: the owner's loop sends the Join with a waiting send (§3); it holds no sub yet.
    work.join = Some(PubIn(e: Joined(take join)))
    work.fence = Some(take fence)
    s.progress = Some(take token)
    s.taken = Some(take taken)
    s.completes = 0u64
    s.told_taken = 0u64
    // A fresh join can wait for its id while an old terminal frame is queued.
    wire_prune_output(mut s, mut work.output, Some(sub))
    s.joining = Some(take hear)
    s.subscription = Some((sub, generation))
    Ok(())
}

fn wire_update[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take upd: Update) -> Result[(), u16] {
    let mut completed: List[u64] = list.new()
    let result = wire_stage_update(mut s, mut work.output, mut completed, work.drain, take upd)
    for id in completed { let _ = map.remove(mut work.timers, id) }
    result
}

fn wire_stage_update[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], mut completed: List[u64], drain: Option[Latest[Option[DrainWindow]]], take upd: Update) -> Result[(), u16] {
    let Update(version: at, content: take content, outcomes: take answers) = take upd
    let mut done: List[Done] = list.new()
    let mut marks: List[WireMark] = list.new()
    for answer in answers {
        wire_answer(mut s, mut completed, drain, answer, mut done, mut marks)?
    }
    let current = match content {
        Some(o) => match s.joined { Some(who) => who == o.session, _ => false },
        None => false,
    }
    if !current && list.len(done) == 0u64 { return Ok(()) }
    s.last = if at > s.last { at } else { s.last }
    let version = s.last
    let mut live_rows: List[Row] = list.new()
    let mut live_complete: List[u32] = list.new()
    let mut ended: List[(u32, u64, Outcome)] = list.new()
    let mut generations: List[(u32, u64)] = list.new()
    let mut computed = 0u64
    if current {
        let Owe(session: _, version: content_version, generations: take stamps, complete: take complete, rows: take rows, ended: take stopped, reset: reset) = option.unwrap(take content)
        computed = content_version
        s.completes += list.len(complete)
        if reset {
            if s.reset_seen { return Error(1008u16) }
            s.reset_seen = true
            return wire_reset_rows(mut s, mut output, version, take done, take marks)
        }
        generations = take stamps
        let _ = wire_drop_stale(mut generations, s.subs)
        for take row in rows {
            if let Some(_) = sub_generation(generations, row.sub) { list.push(mut live_rows, take row) }
        }
        for sub in complete {
            if let Some(_) = sub_generation(generations, sub) { list.push(mut live_complete, sub) }
        }
        ended = take stopped
    }
    let reserve = wire_outcome_reserve(s.config)
    let envelope = 24u64 + 4u64 * list.len(live_complete)
    let allowance = int.saturating_sub(s.config.socket.max_frame, reserve + envelope)
    let requested = wire_rows_size(live_rows)
    if requested > allowance {
        if list.len(live_complete) == 0u64 {
            if s.reset_seen { return Error(1008u16) }
            s.reset_seen = true
            return wire_reset_rows(mut s, mut output, version, take done, take marks)
        }
        for sub in live_complete { wire_end(mut s, mut output, sub, Refused(Budget(Room(requested: requested, available: allowance)))) }
        live_complete = list.new()
        live_rows = list.new()
        generations = list.new()
    }
    if list.len(live_complete) != 0u64 {
        let mut replacing: List[(u32, u64)] = list.new()
        for sub in live_complete {
            if let Some(generation) = sub_generation(generations, sub) { list.push(mut replacing, (sub, generation)) }
        }
        wire_supersede(mut output, replacing)
    }
    if list.len(live_rows) != 0u64 || list.len(live_complete) != 0u64 || list.len(done) != 0u64 {
        let charge = wire_batch_charge(live_complete, live_rows, done, list.len(marks) != 0u64)
        if wire_queued_bytes(output) + charge > s.config.budget {
            wire_prune_output(mut s, mut output, None)
            if wire_queued_bytes(output) + charge > s.config.budget {
                if s.reset_seen { return Error(1008u16) }
                s.reset_seen = true
                return wire_reset_rows(mut s, mut output, version, take done, take marks)
            }
        }
        let check = if list.len(live_rows) != 0u64 || list.len(live_complete) != 0u64 { Some(computed) } else { None }
        let frame: Frame = Batch(version, take live_complete, take live_rows, take done)
        wire_queue_checked(mut output, take frame, take marks, take generations, check)
    }
    for take e in ended {
        let (sub, generation, take why) = take e
        if sub_generation(s.subs, sub) == Some(generation) {
            wire_forget_sub(mut s, sub)
            wire_end_checked(mut s, mut output, sub, take why, Some(computed))
        }
    }
    Ok(())
}

fn wire_answer[G: send, H: send](mut s: WireSession[G, H], mut completed: List[u64], drain: Option[Latest[Option[DrainWindow]]], told: KeyedDone, mut done: List[Done], mut marks: List[WireMark]) -> Result[(), u16] {
    if wire_cut_at(drain, s.clock) { return Ok(()) }
    // A pre-W3c stored reply can exceed today's producer bound. Preserve its
    // bytes in the store and fail delivery explicitly before retaining its row.
    if let Returned(b) = told.outcome { if list.len(b) > MAX_RETURNED_BYTES { return Error(1009u16) } }
    let key = slot_key(told.stream, told.p)
    if let Some(take found) = map.remove(mut s.held, key) {
        let mut h = take found
        h.forwarded = false
        let owed = replace(mut h.owed, list.new())
        let count = list.len(owed)
        h.queued += count
        for take owing in owed {
            let WireOwed(generation: generation, reply: take backing) = take owing
            list.push(mut completed, generation)
            let outcome: Outcome = match told.outcome {
                Returned(payload) => {
                    let mut reply = take backing
                    list.append(mut reply, payload)
                    let updated: Outcome = Returned(take reply)
                    take updated
                },
                _ => clone(told.outcome),
            }
            let mark_key: Bytes = clone(key)
            let mark: WireMark = match outcome {
                Returned(_) => WriteUnit(take mark_key),
                Failed(_) => WriteUnit(take mark_key),
                _ => Unit(take mark_key),
            }
            list.push(mut done, Done(stream: h.stream, p: h.p, outcome: take outcome))
            list.push(mut marks, take mark)
        }
        if h.queued != 0u64 { map.insert(mut s.held, take key, take h) }
    }
    Ok(())
}

fn wire_expired[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, tick: Tick) {
    let _ = map.remove(mut work.granted, tick.generation)
    wire_finish_owed(mut s, mut work, tick, Abandoned)
}

fn wire_finish_granted[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, tick: Tick, take outcome: Outcome) {
    if let Some(_) = map.remove(mut work.granted, tick.generation) {
        wire_finish_owed(mut s, mut work, tick, take outcome)
    }
}

fn wire_finish_owed[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, tick: Tick, take outcome: Outcome) {
    let _ = map.remove(mut work.timers, tick.generation)
    let version = s.last
    let key = slot_key(tick.stream, tick.p)
    if let Some(take found) = map.remove(mut s.held, key) {
        let mut h = take found
        let mut index = 0u64
        let mut hit = false
        while index < list.len(h.owed) && !hit {
            if h.owed[index].generation == tick.generation { hit = true } else { index += 1u64 }
        }
        if hit {
            let _ = list.remove(mut h.owed, index)
            h.queued += 1u64
            wire_row(mut s, mut work, key, h.stream, h.p, version, take outcome)
        }
        map.insert(mut s.held, take key, take h)
    }
}

fn wire_service_allocate[G: send, H: send](mut s: WireSession[G, H], take allocation: ServiceAllocation) -> Result[ServicePlan, u16] {
    match take allocation {
        AcceptHello(take identity_result) => { wire_accept_hello(mut s, take identity_result)?; Ok(NoAction) },
        PlanCall => {
            match replace(mut s.pending, None) {
                Some(take pending) => wire_plan_call(s, take pending),
                None => Ok(NoAction),
            }
        },
        ValidateSubscribe(sub, slot, take arg, take resume) => wire_plan_subscribe(mut s, sub, slot, take arg, take resume),
        DeliverUpdate(take delivery) => {
            let DeliveryJob(updates: take published, output: take previous, drain: take drain) = take delivery
            let mut output = take previous
            let mut completed: List[u64] = list.new()
            for take upd in published {
                wire_stage_update(mut s, mut output, mut completed, drain, take upd)?
            }
            Ok(PlannedUpdate(take output, take completed))
        },
    }
}

fn wire_accept_hello[G: send, H: send](mut s: WireSession[G, H], take identity_result: Option[Caller]) -> Result[(), u16] {
    let caller = match take identity_result { Some(take value) => take value, None => return Error(1008u16) }
    if list.len(caller.subject) > SUBJECT_MAX { return Error(1008u16) }
    s.caller = Some(take caller)
    if let Some(place) = s.place {
        s.registry = match placed(place, s.config.n_place) { Ok(take r) => take r, Error(_) => return Error(1013u16) }
    }
    let wanted = replace(mut s.wants, list.new())
    for take want in take wanted {
        let key = match wire_key(want) { Ok(take key) => take key, Error(_) => return Error(1013u16) }
        list.push(mut s.entries, take key)
    }
    s.phase = 2u8
    Ok(())
}

// The publisher's answer to this session's Join. Id 0 (it could not reserve the session's fence
// Arcs) or a Join the publisher never took (its inbox closed) refuses the first Subscribe;
// otherwise that Subscribe, carried in the Join (v2.22), is live at the generation it was sent with.
fn wire_poll_admit[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork) {
    if let Some(_) = work.join { return }
    let received: Option[Option[Admit]] = match s.joining {
        Some(hear) => match channel.try_receive(hear) { Ok(take a) => Some(Some(take a)), Error(Empty) => None, _ => Some(None) },
        _ => None,
    }
    let Some(take answer) = take received else { return }
    let _ = replace(mut s.joining, None)
    match take answer {
        Some(Admit(who: who, round: take register)) if who != 0u64 => {
            s.joined = Some(who)
            work.round = Some(take register)
            if let Some((sub, generation)) = replace(mut s.subscription, None) {
                list.push(mut s.subs, (sub, generation))
                list.push(mut s.pub_subs, sub)
            }
        },
        _ => {
            let _ = replace(mut s.join_lease, None)
            let _ = replace(mut s.mark, None)
            let _ = replace(mut s.taken, None)
            work.fence = None
            if let Some((sub, _)) = replace(mut s.subscription, None) { wire_end(mut s, mut work.output, sub, Refused(Overloaded)) }
        },
    }
}

// v2.22 (§3 "Repair"): once the owner holds no `complete` it took and has not sent, it publishes
// how many it has taken for this join and wakes the publisher, so a due sub held back for an
// unsent repair is repaired without waiting for another drain.
fn wire_offer_taken[G: send, H: send](mut s: WireSession[G, H], work: WireWork) {
    if s.completes == s.told_taken || work.sending_complete { return }
    for o in work.output { if wire_carries_complete(o.frame) { return } }
    let made = arc.new(Taken(n: s.completes))
    let next = take made
    match s.taken { Some(root) => latest.publish(root, take next), None => return }
    s.told_taken = s.completes
    let _ = channel.try_send(wire_publisher(s), PubIn(e: Drained))
}

fn wire_carries_complete(f: Frame) -> bool {
    match f { Batch(_, complete, _, _) => list.len(complete) != 0u64, _ => false }
}

fn wire_step[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take input: ServiceInput) -> Result[Option[Frame], u16] {
    let stepped = wire_step_input(mut s, mut work, take input)
    wire_offer_taken(mut s, work)
    stepped
}

fn wire_step_input[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take input: ServiceInput) -> Result[Option[Frame], u16] {
    s.holding = match work.check { Some(_) => true, None => false }
    match take input {
        WAttach(_, take me, take pub_to) => {
            s.me = Some(take me); s.publisher = Some(take pub_to)
        },
        WClient(take frame, at) => match take frame {
            Hello(take token, take wanted) => {
                if s.phase != 0u8 { return Error(1008u16) }
                s.phase = 1u8
                s.wants = take wanted
                wire_begin_hello(s, mut work, take token)?
            },
            Call(stream, p, slot, deadline, take arg) => {
                if s.phase != 3u8 { return Error(1008u16) }
                let key = match s.caller { Some(caller) => slot_key(wire_stream(caller, stream), p), _ => return Error(1008u16) }
                let grows = match map.get(s.held, key) { Some(h) => !h.forwarded || h.queued != 0u64 || list.len(h.owed) != 0u64, _ => true }
                let held = match map.get(s.held, key) { Some(h) => h.forwarded, _ => false }
                if (wire_admission_closed(work, s.clock) && !held) || (grows && wire_units(s) >= 1u64 + s.config.q) {
                    wire_refused(mut s, mut work, stream, p, Overloaded)?
                } else {
                    s.pending = Some(WirePending(stream: stream, p: p, slot: slot, deadline: deadline, arg: take arg, at: at, grows: grows))
                    work.plan_call = true
                }
            },
            Subscribe(sub, slot, take arg, take resume) => {
                if s.phase != 3u8 { return Error(1008u16) }
                if wire_admission_closed(work, s.clock) {
                    wire_end(mut s, mut work.output, sub, Refused(Overloaded))
                } else {
                    let planned = wire_plan_subscribe(mut s, sub, slot, take arg, take resume)?
                    wire_apply_plan(mut s, mut work, take planned)?
                }
            },
            Unsubscribe(sub) => {
                if s.phase != 3u8 { return Error(1008u16) }
                wire_stop_sub(mut s, mut work.output, sub)
            },
            _ => return Error(1007u16),
        },
        WGrantedDone(take tick, take outcome) => wire_finish_granted(mut s, mut work, tick, take outcome),
        WPrepared(take plan) => wire_apply_plan(mut s, mut work, box.unbox(take plan))?,
        WRunner(take e) => {
            let Notice(e: take received) = take e
            match take received {
                Updated(take upd) => wire_update(mut s, mut work, take upd)?,
                Expired(tick) => wire_expired(mut s, mut work, tick),
                _ => {},
            }
        },
        WSent => { wire_sent(mut s, mut work); wire_flush(mut s, mut work); return Ok(None) },
        WDropped => { wire_dropped(mut s, mut work)?; wire_flush(mut s, mut work); return Ok(None) },
        WDrained => {
            // The token goes first, so the wake it rides on finds it (§3 "Repair").
            if let Some(to) = s.progress { let _ = channel.try_send(to, ()) }
            if let Some(_) = work.head { let _ = channel.try_send(wire_publisher(s), PubIn(e: Drained)) }
        },
        WClose(deadline) => { work.deadline = Some(deadline) },
        WForce => {
            work.abandoned += map.len(work.timers)
            let _ = replace(mut work.granted, map.new())
            let _ = replace(mut s.held, map.new())
            return Ok(None)
        },
        WPoll(writable) => {
            wire_poll_admit(mut s, mut work)
            if !writable { return Ok(None) }
            if s.phase == 4u8 { s.phase = 3u8 }
            if s.phase == 2u8 {
                if s.placing == 0u64 {
                    s.placing += 1u64
                    if list.len(s.entries) == 0u64 { s.phase = 4u8 }
                    let caller: Caller = match s.caller {
                        Some(caller) => clone(caller),
                        None => return Error(1008u16),
                    }
                    let q: u32 = int.narrow(s.config.q)
                    return Ok(Some(Welcome(take caller, q, s.config.budget, result.unwrap(launch_digest()), clone(s.target), launch_word(0u64, 0u64))))
                }
                let index = s.placing - 1u64
                let slot: u32 = int.narrow(index)
                let answer = answer_want(s.registry, s.entries[index], slot)
                s.placing += 1u64
                if index + 1u64 == list.len(s.entries) { s.phase = 4u8 }
                return Ok(Some(Placed(take answer)))
            }
            return wire_take_output(s, mut work)
        },
    }
    let version = s.last
    if wire_queued_bytes(work.output) > s.config.budget {
        wire_prune_output(mut s, mut work.output, None)
        if wire_queued_bytes(work.output) > s.config.budget { wire_reset(mut s, mut work.output, version)? }
    }
    Ok(None)
}


fn wire_me[G: send, H: send](s: WireSession[G, H]) -> Sender[WireEvent] {
    match s.me { Some(to) => channel.sender(to), _ => fail("runner: detached wire service") }
}

fn wire_publisher[G: send, H: send](s: WireSession[G, H]) -> Sender[PubIn] {
    match s.publisher { Some(to) => channel.sender(to), _ => fail("runner: detached wire service") }
}


fn wire_finish[G: send, H: send](mut s: WireSession[G, H]) -> Option[PubIn] {
    s.mark = None
    if s.marked { Some(PubIn(e: Drained)) }
    else { match s.joined { Some(who) => Some(PubIn(e: Left(who))), _ => None } }
}

// Production sessions build place inside the owner, after source admission.
pub fn wire_place_service[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], random: Random, take session_wire: Option[Wire[G]], head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, a: Args) -> Service[WireSession[G, H]] {
    wire_place_target(place, random, take session_wire, head, clock, tasks, config, launch_target(a))
}

// Embedded hosts and socket fixtures supply their launch target directly.
pub fn wire_place_target[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], random: Random, take session_wire: Option[Wire[G]], head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, H]] {
    let initial: Registry[G, H] = registry()
    let mut service = wire_service_with_head(take initial, random, take session_wire, LegacyHead(channel.sender(head)), clock, tasks, config, take target)
    service.context.place = Some(place)
    take service
}

resource type WireJoinLease: send { closing: Sender[()], publisher: Sender[PubIn] } drop(lease) {
    let _ = channel.try_send(lease.closing, ())
    let _ = channel.try_send(lease.publisher, PubIn(e: Drained))
}

fn wire_remove_sub[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], sub: u32) {
    let mut i = 0u64
    while i < list.len(s.subs) { if s.subs[i].0 == sub { let _ = list.remove(mut s.subs, i) } else { i += 1u64 } }
    wire_prune_output(mut s, mut output, Some(sub))
}


fn wire_forget_sub[G: send, H: send](mut s: WireSession[G, H], sub: u32) {
    let mut i = 0u64
    while i < list.len(s.pub_subs) { if s.pub_subs[i] == sub { let _ = list.remove(mut s.pub_subs, i) } else { i += 1u64 } }
}

fn wire_stop_sub[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], sub: u32) {
    wire_remove_sub(mut s, mut output, sub)
    let mut at = 0u64
    while at < list.len(s.resubs) {
        if s.resubs[at].sub == sub { let _ = list.remove(mut s.resubs, at) } else { at += 1u64 }
    }
    if list.len(s.subs) == 0u64 {
        wire_leave(mut s)
        let _ = replace(mut s.joining, None)
        let _ = replace(mut s.subscription, None)
        s.joined = None
        let _ = replace(mut s.pub_subs, list.new())
        return
    }
    if !s.holding { wire_unsubscribe(mut s, sub) }
}

fn wire_unsubscribe[G: send, H: send](mut s: WireSession[G, H], sub: u32) {
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if registered {
        if let Some(who) = s.joined {
            if let Ok(()) = channel.try_send(wire_publisher(s), PubIn(e: Unsubscribed(who, sub))) { wire_forget_sub(mut s, sub) }
        }
    }
}

// v2.19.2 (§3 "The owner asks for removal"): the session leaves by dropping its join lease,
// which tells the publisher to forget it. While the writer holds a content unit the lease
// is parked, so the publisher keeps fencing the read sets that unit was computed from. The
// join that made the lease reserved its parking slot, so parking allocates nothing.
fn wire_leave[G: send, H: send](mut s: WireSession[G, H]) {
    while let Some(_) = list.pop(mut s.resubs) {}
    if let Some(take lease) = replace(mut s.join_lease, None) {
        if s.holding { list.push(mut s.leaving, take lease) }
    }
}

// The writer holds no content unit: the removals held for it go now, in the order the
// publisher must apply them. A replacing Subscribed goes before the Unsubscribeds, and a
// sub the owner no longer has but the publisher may (pub_subs) owes an Unsubscribed.
fn wire_flush[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork) {
    s.holding = false
    while let Some(_) = list.pop(mut s.leaving) {}
    while list.len(s.resubs) != 0u64 {
        let WireResub(sub: sub, generation: generation, input: take input) = list.remove(mut s.resubs, 0u64)
        let who = option.unwrap(s.joined)
        if let Error(_) = channel.try_send(wire_publisher(s), PubIn(e: WireSubscribed(who, sub, generation, take input))) {
            wire_end(mut s, mut work.output, sub, Refused(Overloaded))
        }
    }
    let mut at = 0u64
    while at < list.len(s.pub_subs) {
        let sub = s.pub_subs[at]
        let before = list.len(s.pub_subs)
        if let None = sub_generation(s.subs, sub) { wire_unsubscribe(mut s, sub) }
        if list.len(s.pub_subs) == before { at += 1u64 }
    }
}


// A second digest at a live position closes before preparing another call. Otherwise
// a head answer could reach the writer while that conflicting send is being prepared.
fn wire_check_live[G: send, H: send](s: WireSession[G, H], f: Frame) -> Option[u16] {
    if let Call(stream, p, slot, _, arg) = f {
        let index: u64 = int.widen(slot)
        if index >= list.len(s.entries) { return None }
        let key = s.entries[index]
        if !map.contains(s.registry.slots, key) && !map.contains(s.registry.gone, key) { return None }
        let named: Bytes = match s.caller { Some(caller) => wire_stream(caller, stream), _ => return None }
        let position = slot_key(named, p)
        let prior: Option[store.RequestDigest] = match map.get(s.held, position) { Some(h) => if h.forwarded || list.len(h.owed) != 0u64 { Some(h.digest) } else { None }, _ => None }
        if let Some(digest) = prior {
            if digest != store.request_digest(key, arg) { return Some(1008u16) }
        }
    }
    None
}

// Publisher harness: a joined inbox whose consumer the law can hold still.
// This fixture does not create a session or a second call transport.
// The owner subscribes as `caller`, the Caller a session binds at Hello.
pub type FixtureOwner { inbox: Receiver[WireEvent], out: Sender[Down], from: Receiver[Down], post: Sender[PubIn], who: u64, progress: Sender[()], caller: Caller }

pub fn fixture_owner(pub_in: Sender[PubIn], take caller: Caller) -> FixtureOwner waits {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(64u64)
    let (progressed, progress): (Sender[()], Receiver[()]) = channel.new(1u64)
    let who = join_with(pub_in, take to, None, Some(take progress))
    let (out, from): (Sender[Down], Receiver[Down]) = channel.new(64u64)
    FixtureOwner(inbox: take inbox, out: take out, from: take from, post: channel.sender(pub_in), who: who, progress: take progressed, caller: take caller)
}

pub fn fixture_subscribe(owner: FixtureOwner, sub: u32, take key: Bytes, take arg: Bytes) -> () waits {
    let copied: Caller = clone(owner.caller)
    let _ = channel.send(owner.post, PubIn(e: Subscribed(owner.who, sub, take copied, take key, take arg)))
}

pub fn fixture_unsubscribe(owner: FixtureOwner, sub: u32) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Unsubscribed(owner.who, sub)))
}

fn fixture_content(owner: FixtureOwner, take event: WireEvent) -> () waits {
    let Notice(e: take e) = publisher_notice(take event)
    let mut dropped: List[u32] = list.new()
    if let Updated(Update(version: _, content: Some(take o), outcomes: take outcomes)) = take e {
        hand(owner.out, take o, mut dropped, take outcomes)
    }
    let _ = channel.try_send(owner.progress, ())
    let _ = channel.try_send(owner.post, PubIn(e: Drained))
}

pub fn fixture_receive(owner: FixtureOwner) -> Result[Down, ReceiveError] waits {
    loop {
        if let Ok(take d) = channel.try_receive(owner.from) { return Ok(take d) }
        match channel.receive(owner.inbox) {
            Ok(take e) => fixture_content(owner, take e),
            Error(_) => return Error(Closed),
        }
    }
}

pub fn fixture_try_receive(owner: FixtureOwner) -> Result[Down, ReceiveError] waits {
    if let Ok(take d) = channel.try_receive(owner.from) { return Ok(take d) }
    match channel.try_receive(owner.inbox) {
        Ok(take e) => { fixture_content(owner, take e); channel.try_receive(owner.from) },
        Error(e) => Error(e),
    }
}

pub fn fixture_close(take owner: FixtureOwner) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Left(owner.who)))
}

fn publisher_notice(take event: WireEvent) -> Notice {
    let WireEvent(e: take input) = take event
    match take input { FromRunner(take notice) => take notice, _ => fail("publisher fixture: non-publisher event") }
}

// Development-only trace vocabulary and prefix verdicts (OBSERVERS-SPEC sections 1-2).
pub type Header: codec { has_clock: bool, has_digest: bool, has_ran: bool, complete: bool }

pub type Send: codec + send { conn: u64, stream: Bytes, p: u64, digest: Bytes, deadline: u64, at: u64 }
pub type Refusal: codec + send = ObsNoEntry | ObsMalformed(runner.Bad) | ObsOverloaded | ObsDeadline | ObsBudget(runner.Room) | ObsNotAllowed | ObsRequestMismatch | ObsHistoryUnavailable
pub type Outcome: codec + send = ObsReturned(Bytes) | ObsFailed(runner.Fault) | ObsRefused(Refusal) | ObsAbandoned | ObsInDoubt
pub type Reply: codec + send { conn: u64, stream: Bytes, p: u64, version: u64, outcome: Outcome, at: u64 }
pub type Close: codec + send { conn: u64, code: u64, at: u64 }
pub type Run: codec + send { stream: Bytes, p: u64, digest: Bytes, version: u64 }
pub type Position: codec + send { stream: Bytes, latest: u64, state: u32, digest: Bytes }
pub type TaskEvent: codec + send { kind: u32, task: u64, object: u64, value: u64 }
pub type Wire: codec + send { conn: u64, frame: Bytes }
pub type Obs: codec + send = Sent(Send) | Got(Reply) | Closed(Close) | Ran(Run) | Pos(Position) | Task(TaskEvent) | Tx(Wire) | Rx(Wire) | Opened(u64)

pub type Mode: codec = Safety | Liveness | Coverage
pub type Clause: codec { name: String, mode: Mode, clock: bool, digest: bool, ran: bool }
pub type Failure: codec { clause: String, key: Bytes, from: u64, to: u64 }
pub type Verdict: codec = Held(u64) | Vacuous | Failed(Failure) | Incomplete(u64) | Unavailable(String)
pub type Assessment: codec { conn: u64, verdicts: List[Verdict] }
pub type Count { clause: Clause, hits: u64, pending: u64, failure: Option[Failure] }
pub type Identity { slot: Bytes, key: Bytes, digest: Bytes, version: u64, from: u64, to: u64 }
pub type Runs = Map[Bytes, List[Run]]

pub fn count(take name: String, mode: Mode, clock: bool, digest: bool, ran: bool) -> Count {
    Count(clause: Clause(name: take name, mode: mode, clock: clock, digest: digest, ran: ran), hits: 0u64, pending: 0u64, failure: None)
}

pub fn own[T: codec](x: T) -> T {
    let c: std.codec.Codec[T] = std.codec.of()
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.encode(c, x, mut b))
    result.unwrap(result.unwrap(std.codec.decode(c, b)))
}

pub fn from_runner(x: runner.Outcome) -> Outcome {
    let cr: std.codec.Codec[runner.Outcome] = std.codec.of()
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.encode(cr, x, mut b))
    result.unwrap(result.unwrap(std.codec.decode(co, b)))
}

pub fn remember(mut runs: Runs, r: Run) {
    let k = key(0u64, r.stream, r.p)
    let mut values = match map.remove(mut runs, k) { Some(take old) => take old, None => list.new() }
    list.push(mut values, own(r))
    map.insert(mut runs, take k, take values)
}

pub fn identity(c: Count, answers: List[Identity], runs: Runs, h: Header) -> Verdict {
    let mut v = verdict(c, h)
    if h.has_digest && h.has_ran {
        for a in answers {
            let mut found = false
            let mut latest = 0u64
            let mut digest: Bytes = list.new()
            if let Some(values) = map.get(runs, a.slot) {
                for r in values {
                    if r.version <= a.version && (!found || r.version >= latest) {
                        found = true
                        latest = r.version
                        digest = own(r.digest)
                    }
                }
            }
            if found && digest != a.digest || !found && h.complete {
                v = Failed(Failure(clause: own(c.clause.name), key: own(a.key), from: a.from, to: a.to))
                break
            }
            if !found { v = Incomplete(1u64) }
        }
    }
    v
}

pub fn mismatches(c: Count, answers: List[Identity], bindings: Map[Bytes, Bytes], h: Header) -> Verdict {
    let mut v = verdict(c, h)
    if h.has_digest && h.has_ran {
        for a in answers {
            match map.get(bindings, a.slot) {
                Some(binding) => {
                    if binding == a.digest {
                        v = Failed(Failure(clause: own(c.clause.name), key: own(a.key), from: a.from, to: a.to))
                        break
                    }
                },
                None => {
                    if h.complete {
                        v = Failed(Failure(clause: own(c.clause.name), key: own(a.key), from: a.from, to: a.to))
                    } else { v = Incomplete(1u64) }
                    break
                },
            }
        }
    }
    v
}

pub fn failed(mut c: Count, take k: Bytes, from: u64, to: u64) {
    if let None = c.failure {
        c.failure = Some(Failure(clause: own(c.clause.name), key: take k, from: from, to: to))
    }
}

pub fn verdict(c: Count, h: Header) -> Verdict {
    if c.clause.clock && !h.has_clock { return Unavailable("clock") }
    if c.clause.digest && !h.has_digest { return Unavailable("digest") }
    if c.clause.ran && !h.has_ran { return Unavailable("ran") }
    if let Some(f) = c.failure { return Failed(own(f)) }
    if c.pending > 0u64 {
        if !h.complete { return Incomplete(c.pending) }
        return Failed(Failure(clause: own(c.clause.name), key: list.new(), from: 0u64, to: 0u64))
    }
    if c.hits == 0u64 { Vacuous } else { Held(c.hits) }
}

type Pending { at: u64, deadline: u64, issued: u64, row: u64 }
type Tracked { key: Bytes, at: u64, done: bool, slot: Bytes, digest: Bytes, deadline: u64 }
pub type State {
    pending: Map[Bytes, u64], connections: Map[u64, u64], delivery: Count, index: u64,
    waiting: Map[Bytes, Deque[Pending]], closed: Map[u64, u64],
    identity: Count, once: Count, after_close: Count, deadline: Count, mismatch: Count,
    grace: u64, timing: bool, sends: List[Tracked], by_conn: Map[u64, List[u64]],
    answers: List[Identity], mismatches: List[Identity], runs: Runs, bindings: Map[Bytes, Bytes]
}

pub fn state() -> State {
    State(pending: map.new(), connections: map.new(), delivery: count("J3", Liveness, false, false, false), index: 0u64,
        waiting: map.new(), closed: map.new(),
        identity: count("J1", Safety, false, true, true),
        once: count("J2", Safety, false, false, false),
        after_close: count("J4", Safety, false, false, false),
        deadline: count("J5", Safety, true, false, false),
        mismatch: count("J6", Safety, false, true, true), grace: 1000u64, timing: true, sends: list.new(), by_conn: map.new(),
        answers: list.new(), mismatches: list.new(), runs: map.new(), bindings: map.new())
}

// Real sockets preserve ordering but add transit and scheduler delay. The
// evaluator retains the exact timing check through state().
pub fn wire_state() -> State {
    let mut s = state()
    s.timing = false
    s
}

pub fn key(conn: u64, stream: Bytes, p: u64) -> Bytes {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_u64(conn, mut b))
    result.unwrap(std.codec.put_list(stream, std.codec.of_u8(), mut b))
    result.unwrap(std.codec.put_u64(p, mut b))
    b
}

fn number[K: key](m: Map[K, u64], k: K) -> u64 {
    match map.get(m, k) { Some(n) => n, None => 0u64 }
}

pub fn step(mut s: State, e: Obs) {
    match e {
        Sent(a) => {
            let k = key(a.conn, a.stream, a.p)
            let n = number(s.pending, k)
            let row = list.len(s.sends)
            list.push(mut s.sends, Tracked(key: own(k), at: s.index, done: false, slot: key(0u64, a.stream, a.p), digest: clone(a.digest), deadline: a.deadline))
            let mut rows = match map.remove(mut s.by_conn, a.conn) { Some(take old) => take old, None => list.new() }
            list.push(mut rows, row)
            map.insert(mut s.by_conn, a.conn, take rows)
            let mut q = match map.remove(mut s.waiting, k) { Some(take old) => take old, None => deque.new() }
            deque.push_back(mut q, Pending(at: s.index, deadline: a.deadline, issued: a.at, row: row))
            map.insert(mut s.waiting, own(k), take q)
            map.insert(mut s.pending, take k, n + 1u64)
            let total = number(s.connections, a.conn)
            map.insert(mut s.connections, a.conn, total + 1u64)
            s.delivery.hits += 1u64
            s.delivery.pending += 1u64
        },
        Got(a) => {
            let k = key(a.conn, a.stream, a.p)
            let n = number(s.pending, k)
            s.once.hits += 1u64
            if n == 0u64 { failed(mut s.once, own(k), s.index, s.index) }
            if let Some(closed_at) = map.get(s.closed, a.conn) {
                failed(mut s.after_close, own(k), closed_at, s.index)
            }
            let mut q = match map.remove(mut s.waiting, k) { Some(take old) => take old, None => deque.new() }
            let abandoned = match a.outcome { ObsAbandoned => true, _ => false }
            let immediate = match a.outcome { ObsRefused(_) => true, _ => false }
            match remove_send(mut q, immediate, abandoned) {
                Some(p) => {
                    s.sends[p.row].done = true
                    if !s.timing {
                        // A reply to a send issued after an older deadline is
                        // an ordered witness: that older expiry must precede it.
                        if let Some(take found) = map.remove(mut s.by_conn, a.conn) {
                            let mut rows = take found
                            let mut i = 0u64
                            while i < list.len(rows) {
                                let row = rows[i]
                                if s.sends[row].done {
                                    let _ = list.remove(mut rows, i)
                                } else {
                                    if s.sends[row].deadline <= p.issued {
                                        s.deadline.hits += 1u64
                                        failed(mut s.deadline, own(s.sends[row].key), s.sends[row].at, s.index)
                                    }
                                    i += 1u64
                                }
                            }
                            map.insert(mut s.by_conn, a.conn, take rows)
                        }
                    }
                    let accepted = match a.outcome { ObsReturned(_) => true, _ => false }
                    if accepted {
                        s.identity.hits += 1u64
                        list.push(mut s.answers, Identity(slot: own(s.sends[p.row].slot), key: own(s.sends[p.row].key), digest: own(s.sends[p.row].digest), version: a.version, from: p.at, to: s.index))
                    }
                    let mismatched = match a.outcome { ObsRefused(ObsRequestMismatch) => true, _ => false }
                    if mismatched {
                        s.mismatch.hits += 1u64
                        list.push(mut s.mismatches, Identity(slot: own(s.sends[p.row].slot), key: own(s.sends[p.row].key), digest: own(s.sends[p.row].digest), version: a.version, from: p.at, to: s.index))
                    }
                    if abandoned {
                        s.deadline.hits += 1u64
                        if (!s.timing && a.at < p.deadline) || (s.timing && a.at > p.deadline && a.at - p.deadline > s.grace) {
                            failed(mut s.deadline, own(k), p.at, s.index)
                        }
                    }
                },
                None => (),
            }
            map.insert(mut s.waiting, own(k), take q)
            if n > 0u64 {
                map.insert(mut s.pending, take k, n - 1u64)
                let total = number(s.connections, a.conn)
                if total > 0u64 {
                    map.insert(mut s.connections, a.conn, total - 1u64)
                    s.delivery.pending -= 1u64
                }
            }
        },
        Closed(a) => {
            if a.code == 1008u64 {
                s.after_close.hits += 1u64
                map.insert(mut s.closed, a.conn, s.index)
            }
            let n = number(s.connections, a.conn)
            s.delivery.pending -= n
            map.insert(mut s.connections, a.conn, 0u64)
            if let Some(take rows) = map.remove(mut s.by_conn, a.conn) {
                for row in rows {
                    s.sends[row].done = true
                    let k = s.sends[row].key
                    let _ = map.remove(mut s.pending, k)
                    let _ = map.remove(mut s.waiting, k)
                }
            }
        },
        Ran(r) => {
            remember(mut s.runs, r)
            let k = key(0u64, r.stream, r.p)
            if !map.contains(s.bindings, k) { map.insert(mut s.bindings, take k, own(r.digest)) }
        },
        Pos(p) => {
            let k = key(0u64, p.stream, p.latest)
            if !map.contains(s.bindings, k) { map.insert(mut s.bindings, take k, own(p.digest)) }
        },
        _ => (),
    }
    s.index += 1u64
}

pub fn finish(s: State, h: Header) -> List[Verdict] {
    let mut vs: List[Verdict] = list.new()
    list.push(mut vs, identity(s.identity, s.answers, s.runs, h))
    list.push(mut vs, verdict(s.once, h))
    let mut delivery = verdict(s.delivery, h)
    if h.complete && s.delivery.pending > 0u64 {
        for p in s.sends {
            if !p.done {
                delivery = Failed(Failure(clause: "J3", key: own(p.key), from: p.at, to: s.index - 1u64))
                break
            }
        }
    }
    list.push(mut vs, take delivery)
    list.push(mut vs, verdict(s.after_close, h))
    list.push(mut vs, verdict(s.deadline, h))
    list.push(mut vs, mismatches(s.mismatch, s.mismatches, s.bindings, h))
    vs
}

pub fn law_prefix() -> bool {
    let mut trace: List[Obs] = list.new()
    list.push(mut trace, Sent(Send(conn: 0u64, stream: list.new(), p: 0u64, digest: list.new(), deadline: 10u64, at: 0u64)))
    list.push(mut trace, Got(Reply(conn: 0u64, stream: list.new(), p: 0u64, version: 0u64, outcome: ObsAbandoned, at: 10u64)))
    let mut s = state()
    for i in 0u64 .. list.len(trace) / 2u64 { step(mut s, trace[i]) }
    let h = Header(has_clock: true, has_digest: false, has_ran: false, complete: false)
    match finish(s, h)[2u64] { Incomplete(1u64) => true, _ => false }
}

// The fixture's session has a fixed 1+q bound. Walk only this position's bounded
// queue; immediate refusals belong to the newest send, timers to the earliest deadline.
fn remove_send(mut q: Deque[Pending], newest: bool, earliest: bool) -> Option[Pending] {
    if newest { return deque.pop_back(mut q) }
    if !earliest { return deque.pop_front(mut q) }
    let n = deque.len(q)
    let mut chosen = 0u64
    let mut deadline = 18446744073709551615u64
    for i in 0u64 .. n {
        let p = option.unwrap(deque.pop_front(mut q))
        if p.deadline < deadline { deadline = p.deadline; chosen = i }
        deque.push_back(mut q, take p)
    }
    let mut selected: Option[Pending] = None
    for i in 0u64 .. n {
        let p = option.unwrap(deque.pop_front(mut q))
        if i == chosen { selected = Some(take p) } else { deque.push_back(mut q, take p) }
    }
    selected
}

pub fn write_verdicts(err: Stderr, take events: List[Obs], end: Obs) -> () waits {
    write_assessment(err, take events, end, false)
}

pub fn write_wire_verdicts(err: Stderr, take events: List[Obs], end: Obs) -> () waits {
    write_assessment(err, take events, end, true)
}

fn write_assessment(err: Stderr, take events: List[Obs], end: Obs, wire: bool) -> () waits {
    let mut s = if wire { wire_state() } else { state() }
    for e in events { step(mut s, e) }
    step(mut s, end)
    let h = Header(has_clock: true, has_digest: true, has_ran: false, complete: true)
    let v = finish(s, h)
    let conn = match end { Closed(a) => a.conn, _ => 0u64 }
    let a = Assessment(conn: conn, verdicts: take v)
    let c: std.codec.Codec[Assessment] = std.codec.of()
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.encode(c, a, mut b))
    result.unwrap(stderr.write_bytes(err, b))
}

fn sent(deadline: u64) -> Obs {
    Sent(Send(conn: 1u64, stream: list.new(), p: 0u64, digest: list.new(), deadline: deadline, at: 0u64))
}

fn got(at: u64, take o: Outcome) -> Obs {
    Got(Reply(conn: 1u64, stream: list.new(), p: 0u64, version: 0u64, outcome: take o, at: at))
}

fn header(complete: bool, clock: bool) -> Header {
    Header(has_clock: clock, has_digest: false, has_ran: false, complete: complete)
}

pub fn law_second_reply() -> bool {
    let mut s = state()
    step(mut s, sent(10u64))
    step(mut s, got(10u64, ObsAbandoned))
    step(mut s, got(11u64, ObsAbandoned))
    match finish(s, header(false, true))[1u64] { Failed(_) => true, _ => false }
}

pub fn law_complete_missing() -> bool {
    let mut s = state()
    step(mut s, sent(10u64))
    match finish(s, header(true, true))[2u64] { Failed(_) => true, _ => false }
}

pub fn law_closed() -> bool {
    let mut s = state()
    step(mut s, sent(10u64))
    step(mut s, Closed(Close(conn: 1u64, code: 1008u64, at: 1u64)))
    step(mut s, got(10u64, ObsAbandoned))
    match finish(s, header(false, true))[3u64] { Failed(_) => true, _ => false }
}

pub fn law_deadline_order() -> bool {
    let mut s = state()
    step(mut s, sent(2000u64))
    step(mut s, sent(1000u64))
    step(mut s, got(1001u64, ObsAbandoned))
    step(mut s, got(2001u64, ObsAbandoned))
    match finish(s, header(true, true))[4u64] { Held(2u64) => true, _ => false }
}

pub fn law_refusal_order() -> bool {
    // A wire abandonment before the remaining send's deadline is a violation.
    let mut s = wire_state()
    step(mut s, sent(1000u64))
    step(mut s, sent(2000u64))
    step(mut s, got(1u64, ObsRefused(ObsOverloaded)))
    step(mut s, got(1001u64, ObsAbandoned))
    match finish(s, header(true, true))[4u64] { Held(1u64) => true, _ => false }
}

pub fn law_missing_clock() -> bool {
    let mut s = state()
    step(mut s, sent(10u64))
    step(mut s, got(2000u64, ObsAbandoned))
    match finish(s, header(true, false))[4u64] { Unavailable(_) => true, _ => false }
}

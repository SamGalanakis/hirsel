// httparse parse_uri accepts Unicode only as well-formed UTF-8.
// Mutant: accept_opaque_uri, reject_unicode_uri.
// expect: run uri_utf8() = true
fn uri_utf8() -> bool {
    request_case(result.unwrap(b"GET /\xc3\xa9 HTTP/1.1\r\n\r\n"), Complete, 20, Some(result.unwrap(b"GET")), Some(result.unwrap(b"/\xc3\xa9")), Some(1), list.new(), list.new()) && request_case(result.unwrap(b"GET /\xc3"), Partial, 0, Some(result.unwrap(b"GET")), None, None, list.new(), list.new()) && request_case(result.unwrap(b"GET /\xff HTTP/1.1\r\n\r\n"), Bad, 0, None, None, None, list.new(), list.new())
}


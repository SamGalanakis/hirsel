    event(websocket.next(mut d, unhex("02 00 82 00"), mut at))
}

// Mutant: accept_unmasked.
// expect: run rejects_unmasked_client() = 1002
fn rejects_unmasked_client() -> u16 {
    first(unhex("82 00"), Server, 256)
}

// Mutant: accept_masked_server.
// expect: run rejects_masked_server() = 1002

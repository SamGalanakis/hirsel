// Evan Wallace's ThumbHash, js/thumbhash.js and rust/src/lib.rs. The
// floating-point calculations and rounding follow the published JS encoder.
type HashBand {
    dc: f64,
    scale: f64,
    count: u64,
    ac: Inline[f64, 28]
}

type Lpqa {
    l: f64,
    p: f64,
    q: f64,
    a: f64
}

const THUMB_PI: f64 = 3.141592653589793

pub fn thumbhash(raster: Raster, limits: Limits) -> Result[Bytes, Error] {
    match (bound steps limits.max_steps {
        thumbhash_inner(raster, limits)
    }) {
        Ok(value) => value,
        Error(_) => Error(WorkLimit),
    }
}

fn thumb_unit(byte: u8) -> f64 {
    let f: f64 = float.from_int(byte)
    f / 255.0
}

fn thumb_channel(input: Bytes, at: u64, alpha: f64) -> f64 {
    let value: f64 = float.from_int(input[at])
    alpha / 255.0 * value
}

fn thumb_float(src: List[Lpqa], index: u64, channel: u8) -> f64 {
    let point = src[index]
    match channel {
        0 => point.l,
        1 => point.p,
        2 => point.q,
        _ => point.a,
    }
}

fn thumb_band(src: List[Lpqa], w: u64, h: u64, nx: u64, ny: u64, channel: u8) -> HashBand {
    let fw: f64 = float.from_int(w)
    let fh: f64 = float.from_int(h)
    let mut dc: f64 = 0.0
    let mut count = 0u64
    let mut scale: f64 = 0.0
    let mut ac: Inline[f64, 28] =[0.0; 28]
    let mut fx: Inline[f64, 100] =[0.0; 100]
    for cy in 0u64 .. ny {
        let mut cx = 0u64
        while cx * ny < nx * (ny - cy) {
            let px: f64 = float.from_int(cx)
            let py: f64 = float.from_int(cy)
            let mut coefficient: f64 = 0.0
            for x in 0u64 .. w {
                let p: f64 = float.from_int(x)
                fx[x] = std.float.cos(THUMB_PI / fw * px * (p + 0.5))
            }
            for y in 0u64 .. h {
                let p: f64 = float.from_int(y)
                let fy = std.float.cos(THUMB_PI / fh * py * (p + 0.5))
                for x in 0u64 .. w {
                    coefficient += thumb_float(src, y * w + x, channel) * fx[x] * fy
                }
            }
            coefficient /= fw * fh
            if cx == 0 && cy == 0 {
                dc = coefficient
            } else {
                ac[count] = coefficient
                count += 1
                if float.gt(float.abs(coefficient), scale) {
                    scale = float.abs(coefficient)
                }
            }
            cx += 1
        }
    }
    if float.gt(scale, 0.0f64) {
        for i in 0u64 .. count {
            ac[i] = 0.5 + 0.5 / scale * ac[i]
        }
    }
    HashBand(dc: dc, scale: scale, count: count, ac: ac)
}

fn thumb_int(f: f64) -> u32 {
    result.unwrap(float.to_int(float.floor(f + 0.5)))
}

fn thumbhash_inner(raster: Raster, limits: Limits) -> Result[Bytes, Error] {
    let len = check_raster(raster, limits)?
    if raster.width > 100 || raster.height > 100 {
        return Error(PixelLimit)
    }
    let w: u64 = int.widen(raster.width)
    let h: u64 = int.widen(raster.height)
    let mut r: f64 = 0.0
    let mut g: f64 = 0.0
    let mut b: f64 = 0.0
    let mut total_alpha: f64 = 0.0
    let mut transparent = false
    for index in 0u64 .. len / 4 {
        let at = index * 4
        let alpha = thumb_unit(raster.rgba[at + 3])
        r += thumb_channel(raster.rgba, at, alpha)
        g += thumb_channel(raster.rgba, at + 1, alpha)
        b += thumb_channel(raster.rgba, at + 2, alpha)
        total_alpha += alpha
        transparent = transparent || raster.rgba[at + 3] != 255
    }
    if float.gt(total_alpha, 0.0f64) {
        r /= total_alpha
        g /= total_alpha
        b /= total_alpha
    }
    let maximum: u64 = if transparent {
        5
    } else {
        7
    }
    let dimension = order.max(w, h)
    let lx = order.max(1, (2 * maximum * w + dimension) / (2 * dimension))
    let ly = order.max(1, (2 * maximum * h + dimension) / (2 * dimension))
    let mut src: List[Lpqa] = list.new()
    if let Error(_) = list.try_reserve(mut src, w * h) {
        return Error(ByteLimit)
    }
    for index in 0u64 .. len / 4 {
        let at = index * 4
        let opacity = thumb_unit(raster.rgba[at + 3])
        let red = r * (1.0 - opacity) + thumb_channel(raster.rgba, at, opacity)
        let green = g * (1.0 - opacity) + thumb_channel(raster.rgba, at + 1, opacity)
        let blue = b * (1.0 - opacity) + thumb_channel(raster.rgba, at + 2, opacity)
        list.push(mut src, Lpqa(l: (red + green + blue) / 3.0, p: (red + green) / 2.0 - blue, q: red - green, a: opacity))
    }
    let l = thumb_band(src, w, h, order.max(3, lx), order.max(3, ly), 0)
    let p = thumb_band(src, w, h, 3, 3, 1)
    let q = thumb_band(src, w, h, 3, 3, 2)
    let landscape = w > h
    let short: u32 = int.narrow(if landscape {
        ly
    } else {
        lx
    })
    let header = thumb_int(63.0 * l.dc) | (thumb_int(31.5 + 31.5 * p.dc) << 6) | (thumb_int(31.5 + 31.5 * q.dc) << 12) | (thumb_int(31.0 * l.scale) << 18) | (if transparent {
        0x800000
    } else {
        0
    })
    let extra = short | (thumb_int(63.0 * p.scale) << 3) | (thumb_int(63.0 * q.scale) << 9) | (if landscape {
        0x8000
    } else {
        0
    })
    let mut hash = alloc_bytes(order.min(25, limits.max_bytes))?
    if limits.max_bytes < 5 {
        return Error(ByteLimit)
    }
    list.push(mut hash, int.narrow(header & 255))
    list.push(mut hash, int.narrow((header >> 8) & 255))
    list.push(mut hash, int.narrow(header >> 16))
    let layout: u16 = int.narrow(extra)
    list.put_word_le(mut hash, layout)
    let mut nibble = 0u64
    let a = if transparent {
        let band = thumb_band(src, w, h, 5, 5, 3)
        if limits.max_bytes < 6 {
            return Error(ByteLimit)
        }
        list.push(mut hash, int.narrow(thumb_int(15.0 * band.dc) | (thumb_int(15.0 * band.scale) << 4)))
        band
    } else {
        HashBand(dc: 1.0, scale: 0.0, count: 0, ac:[0.0; 28])
    }
    let count = l.count + p.count + q.count + a.count
    if list.len(hash) + (count + 1) / 2 > limits.max_bytes {
        return Error(ByteLimit)
    }
    thumb_pack(l, mut nibble, mut hash)
    thumb_pack(p, mut nibble, mut hash)
    thumb_pack(q, mut nibble, mut hash)
    thumb_pack(a, mut nibble, mut hash)
    Ok(take hash)
}

fn thumb_pack(band: HashBand, mut nibble: u64, mut hash: Bytes) {
    for i in 0u64 .. band.count {
        let four: u8 = int.narrow(thumb_int(15.0 * band.ac[i]))
        if nibble % 2 == 0 {
            list.push(mut hash, four)
        } else {
            let at = list.len(hash) - 1
            hash[at] |= four << 4
        }
        nibble += 1
    }
}

pub fn dhash(raster: Raster, limits: Limits) -> Result[u64, Error] {
    match (bound steps limits.max_steps {
        dhash_inner(raster, limits)
    }) {
        Ok(value) => value,
        Error(_) => Error(WorkLimit),
    }
}

fn dhash_inner(raster: Raster, limits: Limits) -> Result[u64, Error] {
    let small = resize_inner(raster, 9, 8, Bilinear, limits)?
    let mut code = 0u64
    for y in 0u64 .. 8 {
        let row = y * 9
        let mut left = hash_luma(small.rgba, row * 4)
        for x in 1u64 .. 9 {
            let right = hash_luma(small.rgba, (row + x) * 4)
            code <<= 1
            if left > right {
                code |= 1
            }
            left = right
        }
    }
    Ok(code)
}

fn hash_luma(input: Bytes, at: u64) -> u32 {
    let r: u32 = int.widen(input[at])
    let g: u32 = int.widen(input[at + 1])
    let b: u32 = int.widen(input[at + 2])
    let a: u32 = int.widen(input[at + 3])
    (299 * r + 587 * g + 114 * b) * a
}

// Module `dir`: directories below a Dir, the capability for one directory tree (CAP-1,
// CAP-2, CAP-7). Dir is a core capability type, plain and `send`; copying it copies the
// designation. A run's Dirs come from `main`'s granted parameters (CAP-4) and from
// `create_temp` and `narrow`. Paths are Strings resolved relative to their Dir, which they may not
// leave (core.md); the seed has no Path type. Every operation is library code over one
// host primitive, passes the replay point at issue and at delivery (CAP-8) and, being
// `waits`, is a cancellation point (CONC-7). Field legend: API.md; "Prefix:" says what has
// happened on the host when the operation fails or is cancelled part way.
pub type Entry: send {
    name: String,
    kind: Kind
}

/// Opens an existing directory below d. The final component cannot be a symlink.
pub fn narrow(d: Dir, p: String) -> Result[Dir, IoError] waits {
    host.open_dir(d, p)
}

/// Opens a listing of d's root or the directory at a relative path. Dropping the handle closes it.
pub fn entries(d: Dir, at: Option[String]) -> Result[HostEntries, IoError] waits {
    host.entries(d, at)
}

/// Appends whole records in host order. Fails Bounds with fewer than 258 spare bytes.
pub fn next_entries(mut h: HostEntries, mut buf: Bytes) -> Result[u64, IoError] waits {
    host.next_entries(mut h, mut buf)
}

/// Reports the final component's metadata without following a symbolic link.
pub fn stat(d: Dir, p: String) -> Result[Stat, IoError] waits {
    host.stat(d, p)
}

/// Lists the selected directory's direct entries in bytewise name order. Names must be valid UTF-8.
pub fn list(d: Dir, at: Option[String]) -> Result[List[Entry], file.Error] waits {
    let mut handle = match entries(d, at) {
        Ok(take h) => take h,
        Error(e) => return Error(Io(e)),
    }
    let mut buf: Bytes = list.with_capacity(4096)
    let mut result: List[Entry] = list.new()
    loop {
        match next_entries(mut handle, mut buf) {
            Ok(0) => break,
            Ok(_) => {},
            Error(e) => return Error(Io(e)),
        }
        let mut offset: u64 = 0
        while offset < list.len(buf) {
            let kind: Kind = match buf[offset] {
                0 => File,
                1 => Directory,
                2 => Symlink,
                _ => Other,
            }
            let size: u16 = list.word_le(buf, offset + 1)
            let from = offset + 3
            offset = from + int.widen(size)
            let mut name_bytes: Bytes = list.with_capacity(int.widen(size))
            list.append(mut name_bytes, list.slice(buf, from, offset))
            let name = match string.from_utf8(take name_bytes) {
                Ok(take name) => take name,
                Error(_) => return Error(NotUtf8),
            }
            list.push(mut result, Entry(name: take name, kind: kind))
        }
        list.clear(mut buf)
    }
    list.sort(mut result, fn(a: Entry, b: Entry) -> Order {
        order.compare(a.name, b.name)
    })
    Ok(take result)
}

/// Creates the directory p; its parent must exist. `host.mkdir`.
/// Fails: Error(Exists | NotFound | Denied | Other(_)).
/// Prefix: on failure nothing was created; a cancellation observed at delivery leaves the
/// directory created. Ex: `std.dir.create_dir(d, "tmp")?`
pub fn create_dir(d: Dir, p: String) -> Result[(), IoError] waits {
    host.mkdir(d, p)
}

/// Removes p and everything below it, depth first. `host.remove_tree`.
/// Fails: Error(NotFound | Denied | Other(_)) at the first entry that cannot be removed.
/// Prefix: entries removed before the failure stay removed; not atomic.
/// Ex: `std.dir.remove_all(d, "tmp")?`
pub fn remove_all(d: Dir, p: String) -> Result[(), IoError] waits {
    host.remove_tree(d, p)
}

/// Creates a new empty directory with a fresh name directly below d, appends that name (at
/// most 32 ASCII bytes) to `name` and returns a Dir for it (Go os.MkdirTemp).
/// `host.mkdtemp`: the name lands in capacity the caller already holds, so `name` needs 32
/// bytes of spare capacity. It is not removed automatically: `dir.remove_all(d, name)`
/// removes it and everything below it.
/// Fails: Bounds (failure), checked before issue, when name has less than 32 bytes spare;
/// Error(Denied | Other(_)), name unchanged. Prefix: on failure nothing was created; a
/// cancellation observed at delivery leaves the directory created and name unchanged.
/// Ex: `let mut name = string.with_capacity(32); let tmp = std.dir.create_temp(d, mut name)?; ..; std.dir.remove_all(d, name)?`
pub fn create_temp(d: Dir, mut name: String) -> Result[Dir, IoError] waits {
    host.mkdtemp(d, mut name)
}

type WalkFrame: send {
    base: u64,
    entries: List[Entry],
    next: u64
}

/// The path and pending siblings of a preorder traversal.
pub opaque type Walker: send {
    dir: Dir,
    path: String,
    frames: List[WalkFrame],
    pending: bool,
    root: bool
}

/// Reports a directory whose contents could not be listed.
pub type WalkError {
    path: String,
    error: file.Error
}

/// Starts a walk below at, or below d's root. Listing begins with the first next.
pub fn walk(d: Dir, at: Option[String]) -> Walker {
    let (root, p) = match at {
        None => (true, string.new()),
        Some(p) => (false, string.from(p)),
    }
    Walker(dir: d, path: take p, frames: list.new(), pending: true, root: root)
}

/// Yields one entry in bytewise sibling order and preorder, without following links.
/// A listing error is returned once. The next call continues with the next sibling.
pub fn next(mut w: Walker) -> Result[Option[Entry], WalkError] waits {
    if w.pending {
        w.pending = false
        let at: Option[String] = if w.root {
            None
        } else {
            Some(string.from(w.path))
        }
        w.root = false
        let children = match list(w.dir, at) {
            Ok(take children) => take children,
            Error(e) => return Error(WalkError(path: string.from(w.path), error: e)),
        }
        if list.len(children) > 0 {
            list.push(mut w.frames, WalkFrame(base: string.byte_len(w.path), entries: take children, next: 0))
        }
    }
    while list.len(w.frames) > 0 {
        let top = list.len(w.frames) - 1
        let i = w.frames[top].next
        if i == list.len(w.frames[top].entries) {
            let _ = list.pop(mut w.frames)
            continue
        }
        string.truncate(mut w.path, w.frames[top].base)
        let entry = list.set(mut w.frames[top].entries, i, Entry(name: string.new(), kind: Other))
        w.frames[top].next += 1
        if string.byte_len(w.path) > 0 {
            string.push(mut w.path, "/")
        }
        string.push(mut w.path, entry.name)
        w.pending = match entry.kind {
            Directory => true,
            _ => false
        }
        return Ok(Some(Entry(name: string.from(w.path), kind: entry.kind)))
    }
    Ok(None)
}

/// Skips the children of the directory just returned, before any listing is opened.
pub fn skip(mut w: Walker) {
    if !w.root && list.len(w.frames) > 0 {
        w.pending = false
    }
}

/// A bad pattern or a directory that could not be listed.
pub type GlobError = Pattern(path.PatternError) | Walk(WalkError)

/// Returns matching paths in preorder. Validates before any host call and lists
/// only the literal base and directories whose descendants could match.
pub fn glob(d: Dir, pattern: String) -> Result[List[String], GlobError] waits {
    let compiled = match path_pattern.compile(pattern) {
        Ok(take compiled) => take compiled,
        Error(e) => return Error(Pattern(e)),
    }
    let base = path_pattern.base(compiled)
    let mut paths: List[String] = list.new()
    if base == string.byte_len(pattern) {
        match stat(d, pattern) {
            Ok(_) => list.push(mut paths, string.from(pattern)),
            Error(NotFound) => {},
            Error(e) => return Error(Walk(WalkError(path: string.from(pattern), error: Io(e)))),
        }
        return Ok(take paths)
    }
    let at: Option[String] = if base == 0 {
        None
    } else {
        Some(string.from(string.slice(pattern, 0, base)))
    }
    if let Some(p) = at {
        let (matched, _) = path_pattern.test(compiled, p)
        if matched {
            match stat(d, p) {
                Ok(s) => {
                    list.push(mut paths, string.from(p))
                    match s.kind {
                        Directory => {},
                        _ => return Ok(take paths)
                    }
                }
                Error(NotFound) => return Ok(take paths),
                Error(e) => return Error(Walk(WalkError(path: string.from(p), error: Io(e)))),
            }
        }
    }
    let mut w = walk(d, at)
    let mut first = true
    loop {
        match next(mut w) {
            Ok(Some(take entry)) => {
                let (matched, descend) = path_pattern.test(compiled, entry.name)
                if !descend {
                    skip(mut w)
                }
                if matched {
                    let Entry(name: take p, kind: _) = take entry
                    list.push(mut paths, take p)
                }
            }
            Ok(None) => return Ok(take paths),
            Error(take problem) => {
                if first {
                    if let Io(NotFound) = problem.error {
                        return Ok(take paths)
                    }
                }
                return Error(Walk(take problem))
            }
        }
        first = false
    }
}

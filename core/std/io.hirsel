// Module `io`: the error values of every capability operation (core.md names IoError
// without a shape). Plain types; constructing or returning them admits nothing.

/// Why a host operation failed. Os(code) carries the host's error number for anything
/// not named here; it is recorded at the replay point like every provider result (CAP-8).
pub type IoError = NotFound | Exists | Denied | InvalidPath | InvalidData | NotEmpty
                 | BrokenPipe | Os(i32) | Capacity(Capacity)

/// A write that stopped part way: `written` bytes were committed before `error`.
pub type WriteError { written: u64, error: IoError }

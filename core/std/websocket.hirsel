// RFC 6455. ADAPTED from tungstenite 89576c6 handshake/{server,client}.rs
// and protocol/{mod,frame/mod,frame/frame}.rs. Pure machines over Bytes.
// Deadlines, entropy, idle timers and serialized writes belong to wsock.
pub type Role: key + send = Server | Client

pub type Upgrade = Waiting | Upgraded(u64, Bytes) | Refused(u16)

// Ready carries the consumed head offset and whether hirsel.2 was selected.
pub type Checked = Pending | Ready(u64, bool) | Failed(u16)

fn part(b: Bytes, s: http1.Span) -> View[Bytes] in b {
    list.slice(b, s.start, s.end)
}

fn field(b: Bytes, h: http1.Head, name: String) -> Result[Option[http1.Span], u16] {
    let mut found: Option[http1.Span] = None
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        if http1.equal_ascii(part(b, f.name), string.as_bytes(name)) {
            if found != None {
                return Error(400)
            }
            found = Some(f.value)
        }
    }
    Ok(found)
}

fn is_field(b: Bytes, h: http1.Head, name: String, value: String) -> bool {
    match field(b, h, name) {
        Ok(Some(s)) => http1.equal_ascii(part(b, s), string.as_bytes(value)),
        _ => false
    }
}

fn connection(b: Bytes, h: http1.Head) -> bool {
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        if http1.equal_ascii(part(b, f.name), string.as_bytes("connection")) && http1.contains(part(b, f.value), string.as_bytes("upgrade")) {
            return true
        }
    }
    false
}

fn protocol(b: Bytes) -> bool {
    let n = list.len(b)
    let mut at: u64 = 0
    while at < n {
        while at < n && (b[at] == 44 || b[at] == 32 || b[at] == 9) {
            at += 1
        }
        let start = at
        while at < n && b[at] != 44 && b[at] != 32 && b[at] != 9 {
            at += 1
        }
        if list.slice(b, start, at) == string.as_bytes("hirsel.2") {
            return true
        }
    }
    false
}

/// RFC 6455 section 1.3 accept value. O(key bytes), Capacity on allocation.
/// Ex: `websocket.accept(string.as_bytes("dGhlIHNhbXBsZSBub25jZQ=="))?`.
pub fn accept(key: Bytes) -> Result[Bytes, Capacity] {
    let mut input: Bytes = list.new()
    list.append(mut input, key)?
    list.append(mut input, string.as_bytes("258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))?
    let digest = sha1.hash(input)?
    let mut out: Bytes = list.new()
    base64.encode(digest, mut out)?
    Ok(take out)
}

fn server_checks(b: Bytes, h: http1.Head) -> Result[http1.Span, u16] {
    if part(b, h.method) != string.as_bytes("GET") || h.version != 1 {
        return Error(400)
    }
    if !connection(b, h) || !is_field(b, h, "upgrade", "websocket") {
        return Error(400)
    }
    if !is_field(b, h, "sec-websocket-version", "13") {
        return Error(426)
    }
    let key = match field(b, h, "sec-websocket-key")? {
        Some(s) => s,
        None => return Error(400)
    }
    Ok(key)
}

fn route_checks(b: Bytes, h: http1.Head) -> Result[bool, u16] {
    if part(b, h.target) != string.as_bytes("/hirsel") {
        return Error(404)
    }
    let offered = match field(b, h, "sec-websocket-protocol")? {
        Some(s) => {
            if !protocol(part(b, s)) {
                return Error(400)
            }
            true
        },
        None => false
    }
    // No HTTP body is consumed by an upgrade, so its framing cannot create
    // a second interpretation of the read-ahead as body bytes.
    if field(b, h, "transfer-encoding")? != None {
        return Error(400)
    }
    match field(b, h, "content-length")? {
        Some(s) => if part(b, s) != string.as_bytes("0") {
            return Error(400)
        },
        None => {}
    }
    Ok(offered)
}

/// Server upgrade. Returns the consumed head offset and the 101 response;
/// b[end..] is initial frame input. Refused(status) is terminal; 426 requires
/// `Sec-WebSocket-Version: 13`. O(head), at most 8192 bytes and 64 fields.
/// Ex: `websocket.server(input)?`.
pub fn server(b: Bytes) -> Result[Upgrade, Capacity] {
    let mut h = http1.head()
    match http1.request(b, mut h) {
        Partial => return Ok(Waiting),
        Bad => return Ok(Refused(400)),
        TooLarge => return Ok(Refused(431)),
        Complete => {}
    }
    server_head(b, h)
}

/// Upgrade a request whose complete head has already been parsed.
pub fn server_head(b: Bytes, h: http1.Head) -> Result[Upgrade, Capacity] {
    let key = match server_checks(b, h) {
        Ok(x) => x,
        Error(status) => return Ok(Refused(status))
    }
    match base64.decode(part(b, key))? {
        Some(decoded) => if list.len(decoded) != 16 {
            return Ok(Refused(400))
        },
        None => return Ok(Refused(400))
    }
    let offered = match route_checks(b, h) {
        Ok(value) => value,
        Error(code) => return Ok(Refused(code))
    }
    let accepted = accept(part(b, key))?
    let mut out: Bytes = list.new()
    list.append(mut out, string.as_bytes("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "))?
    list.append(mut out, accepted)?
    list.append(mut out, string.as_bytes("\r\n"))?
    if offered {
        list.append(mut out, string.as_bytes("Sec-WebSocket-Protocol: hirsel.2\r\n"))?
    }
    list.append(mut out, string.as_bytes("\r\n"))?
    Ok(Upgraded(h.end, take out))
}

/// Validates the client's bounded 101 response against its sent key. The
/// only supported offer is hirsel.2; no extensions are offered. Ready also
/// reports selection, so the caller decides whether a protocol is required. O(head).
/// Ex: `websocket.client(input, key, true)?`.
pub fn client(b: Bytes, key: Bytes, offered_protocol: bool) -> Result[Checked, Capacity] {
    let mut h = http1.head()
    match http1.response(b, mut h) {
        Partial => return Ok(Pending),
        Bad => return Ok(Failed(400)),
        TooLarge => return Ok(Failed(431)),
        Complete => {}
    }
    if h.status != 101 || h.version != 1 || !connection(b, h) || !is_field(b, h, "upgrade", "websocket") {
        return Ok(Failed(400))
    }
    let s = match field(b, h, "sec-websocket-accept") {
        Ok(Some(s)) => s,
        _ => return Ok(Failed(400))
    }
    if part(b, s) != accept(key)? {
        return Ok(Failed(400))
    }
    if field(b, h, "sec-websocket-extensions") != Ok(None) {
        return Ok(Failed(400))
    }
    let selected = match field(b, h, "sec-websocket-protocol") {
        Ok(None) => false,
        Ok(Some(p)) => {
            if !offered_protocol || part(b, p) != string.as_bytes("hirsel.2") {
                return Ok(Failed(400))
            }
            true
        },
        Error(_) => return Ok(Failed(400))
    }
    Ok(Ready(h.end, selected))
}

/// Builds a client request from exactly sixteen caller-supplied random bytes.
/// The host is ASCII without whitespace. Error(400) is invalid input; the
/// outer Error is Capacity. O(host bytes). Ex: `websocket.request(host, nonce, true)?`.
pub fn request(host: Bytes, nonce: Bytes, offer_protocol: bool) -> Result[Result[Bytes, u16], Capacity] {
    if list.len(nonce) != 16 || list.len(host) == 0 {
        return Ok(Error(400))
    }
    for x in host {
        if x < 33 || x > 126 {
            return Ok(Error(400))
        }
    }
    let mut out: Bytes = list.new()
    list.append(mut out, string.as_bytes("GET /hirsel HTTP/1.1\r\nHost: "))?
    list.append(mut out, host)?
    list.append(mut out, string.as_bytes("\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: "))?
    base64.encode(nonce, mut out)?
    list.append(mut out, string.as_bytes("\r\n"))?
    if offer_protocol {
        list.append(mut out, string.as_bytes("Sec-WebSocket-Protocol: hirsel.2\r\n"))?
    }
    list.append(mut out, string.as_bytes("\r\n"))?
    if list.len(out) > 8192 {
        return Ok(Error(431))
    }
    Ok(Ok(take out))
}

pub type Control: send {
    data: Inline[u8, 125],
    len: u64
}

pub type Event: send = Need | Text(Bytes) | Message(Bytes) | Ping(Control) | Pong(Control) | Closed(Control) | Reject(u16) | Ended

pub opaque type Decoder: send {
    role: Role,
    max: u64,
    header: Inline[u8, 14],
    have: u64,
    need: u64,
    length_end: u64,
    ready: bool,
    length: u64,
    received: u64,
    opcode: u8,
    fin: bool,
    masked: bool,
    fragmented: bool,
    message: Bytes,
    text: bool,
    utf8: Utf8,
    control: Control,
    frames: u64,
    ended: bool
}

// Configured payload caps are powers of two (WIRE section 2.2). This keeps
// the old-plus-new growth bound independent of arbitrary read boundaries.
fn check_max(max_frame: u64) {
    if max_frame == 0 || max_frame & (max_frame - 1) != 0 {
        fail("websocket: max_frame must be a nonzero power of two")
    }
}

/// Empty frame decoder. max_frame caps each frame and the assembled message.
/// No allocation until payload bytes arrive. Ex: `websocket.decoder(Server, 262144)`.
pub fn decoder(role: Role, max_frame: u64) -> Decoder {
    check_max(max_frame)
    Decoder(role, max: max_frame, header:[0; 14], have: 0, need: 2, length_end: 2, ready: false, length: 0, received: 0, opcode: 0, fin: false, masked: false, fragmented: false, message: list.new(), text: false, utf8: fresh_utf8(), control: Control(data:[0; 125], len: 0), frames: 0, ended: false)
}

/// Completed physical frames, including non-final data fragments. O(1), no
/// allocation. The driver observes progress even when next returns Need.
/// Ex: `websocket.frame_count(d)` to renew a connection's idle timer.
pub fn frame_count(d: Decoder) -> u64 {
    d.frames
}

/// Whether a frame header or a fragmented message is still incomplete.
pub fn incomplete(d: Decoder) -> bool {
    !d.ended && (d.have != 0 || d.fragmented)
}

/// Payload storage held by the decoder, excluding its inline header/control.
/// O(1). Ex: `websocket.buffered(d)` for input-arrival accounting.
pub fn buffered(d: Decoder) -> u64 {
    list.len(d.message)
}

/// Payload capacity, never above max_frame. O(1).
/// Ex: `websocket.capacity(d)` after a partial frame.
pub fn capacity(d: Decoder) -> u64 {
    list.capacity(d.message)
}

// A truncated UTF-8 scalar holds at most three nonzero bytes.
type Utf8: send {
    tail: Inline[u8, 3]
}

fn fresh_utf8() -> Utf8 {
    Utf8(tail:[0; 3])
}

fn validate_fragment(utf: Utf8, b: Bytes) -> Option[Utf8] {
    let n = list.len(b)
    let mut used: u64 = 0
    if utf.tail[0] != 0 {
        let prior: u64 = if utf.tail[2] != 0 {
            3
        } else if utf.tail[1] != 0 {
            2
        } else {
            1
        }
        let head = option.unwrap(string.utf8_head(utf.tail[0]))
        used = order.min(n, head.width - prior)
        match string.utf8_tail(head, prior + used, fn(offset: u64) -> u8 {
            if offset < prior {
                utf.tail[offset]
            } else {
                b[offset - prior]
            }
        }) {
            Ok(()) => {},
            Error(Some(_)) => return None,
            Error(None) => {
                let mut pending = utf
                for i in 0u64 .. used {
                    pending.tail[prior + i] = b[i]
                }
                return Some(pending)
            },
        }
    }
    match utf8.validate(list.slice(b, used, n)) {
        Ok(()) => Some(fresh_utf8()),
        Error(e) => {
            if e.error_len != None {
                return None
            }
            let start = used + e.valid_up_to
            let mut pending = fresh_utf8()
            for i in start .. n {
                pending.tail[i - start] = b[i]
            }
            Some(pending)
        },
    }
}

fn valid_code(code: u16) -> bool {
    code >= 1000 && code <= 1003 || code >= 1007 && code <= 1014 || code >= 3000 && code < 5000
}

fn close_error(c: Control) -> u16 {
    if c.len == 0 {
        return 0
    }
    if c.len == 1 {
        return 1002
    }
    let hi: u16 = int.widen(c.data[0])
    let lo: u16 = int.widen(c.data[1])
    if !valid_code((hi << 8) | lo) {
        return 1002
    }
    let mut i: u64 = 2
    while i < c.len {
        let Some(head) = string.utf8_head(c.data[i]) else {
            return 1007
        }
        if let Error(_) = string.utf8_tail(head, c.len - i, fn(offset: u64) -> u8 {
            c.data[i + offset]
        }) {
            return 1007
        }
        i += head.width
    }
    0
}

/// Releases an incomplete message when its reader stops decoding.
pub fn discard(mut d: Decoder) {
    d.ended = true
    let old = replace(mut d.message, list.new())
}

fn reject(mut d: Decoder, code: u16) -> Event {
    discard(mut d)
    Reject(code)
}

fn header_check(mut d: Decoder) -> u16 {
    let a = d.header[0]
    let b = d.header[1]
    d.opcode = a & 15
    d.fin = a & 128 != 0
    d.masked = b & 128 != 0
    if a & 112 != 0 || (d.role == Server && !d.masked) || (d.role == Client && d.masked) {
        return 1002
    }
    if d.opcode != 0 && d.opcode != 1 && d.opcode != 2 && d.opcode != 8 && d.opcode != 9 && d.opcode != 10 {
        return 1002
    }
    if d.opcode >= 8 && (!d.fin || b & 127 > 125) {
        return 1002
    }
    if d.opcode == 0 && !d.fragmented || (d.opcode == 1 || d.opcode == 2) && d.fragmented {
        return 1002
    }
    if d.opcode == 1 || d.opcode == 2 {
        d.text = d.opcode == 1
        d.utf8 = fresh_utf8()
    }
    d.length_end = if b & 127 == 126 {
        4
    } else if b & 127 == 127 {
        10
    } else {
        2
    }
    d.need = d.length_end + if d.masked {
        4
    } else {
        0
    }
    0
}

fn length_check(mut d: Decoder) -> u16 {
    let tag = d.header[1] & 127
    let mut length: u64 = int.widen(tag)
    if tag >= 126 {
        length = 0
        if tag == 127 && d.header[2] & 128 != 0 {
            return 1002
        }
        for i in 2u64 .. d.length_end {
            let b: u64 = int.widen(d.header[i])
            length = (length << 8) | b
        }
        if tag == 126 && length < 126 || tag == 127 && length < 65536 {
            return 1002
        }
    }
    if length > d.max {
        return 1009
    }
    if d.opcode < 8 && length > d.max - list.len(d.message) {
        return 1009
    }
    d.length = length
    d.received = 0
    d.control.len = 0
    0
}

fn room(mut d: Decoder, arriving: u64) -> Result[(), Capacity] {
    let needed = list.len(d.message) + arriving
    let cap = list.capacity(d.message)
    if needed <= cap {
        return Ok(())
    }
    // Doubling from four keeps growth independent of how reads are split.
    // Each old block is released after copying into the admitted new block.
    let mut chosen: u64 = if cap == 0 {
        if d.max < 4 {
            d.max
        } else {
            4
        }
    } else {
        cap
    }
    while chosen < needed {
        chosen = if chosen > d.max - chosen {
            d.max
        } else {
            chosen * 2
        }
    }
    let mut b: Bytes = list.with_capacity(chosen)?
    list.append(mut b, d.message)?
    let old = replace(mut d.message, take b)
    Ok(())
}

// ADAPTED from tungstenite frame/mask.rs:25-48: checked unaligned u64
// operations replace its unsafe aligned u32 view. phase follows read splits.
fn append_masked(mut out: Bytes, input: Bytes, mask: Inline[u8, 4], phase: u64) -> Result[(), Capacity] {
    let mut word: u64 = 0
    for i in 0u64 .. 8u64 {
        let x: u64 = int.widen(mask[(phase + i) % 4])
        word |= x << (i * 8)
    }
    let n = list.len(input)
    let mut i: u64 = 0
    while n - i >= 8 {
        list.put_word_le(mut out, list.word_le(input, i) ^ word)?
        i += 8
    }
    while i < n {
        let _ = list.push(mut out, input[i] ^ mask[(phase + i) % 4])
        i += 1
    }
    Ok(())
}

fn finish_frame(mut d: Decoder) -> Event {
    d.frames += 1
    d.ready = false
    d.have = 0
    d.need = 2
    if d.opcode == 9 {
        return Ping(d.control)
    }
    if d.opcode == 10 {
        return Pong(d.control)
    }
    if d.opcode == 8 {
        let code = close_error(d.control)
        if code != 0 {
            return reject(mut d, code)
        }
        discard(mut d)
        return Closed(d.control)
    }
    d.fragmented = !d.fin
    if d.fin {
        if d.text && d.utf8.tail[0] != 0 {
            return reject(mut d, 1007)
        }
        let b = replace(mut d.message, list.new())
        if d.text {
            return Text(take b)
        }
        return Message(take b)
    }
    Need
}

/// Consumes input starting at cursor, stopping at one observable event. Need
/// consumes all available bytes; call again on the next arrival. Ping/Pong
/// never disturb fragmentation. Close/Reject make later calls Ended. O(bytes),
/// storage grows from arrival, never the declared length. Capacity preserves
/// the current frame and cursor so the caller can close the connection.
/// Ex: `websocket.next(mut decoder, input, mut cursor)?`.
pub fn next(mut d: Decoder, b: Bytes, mut cursor: u64) -> Result[Event, Capacity] {
    if d.ended {
        return Ok(Ended)
    }
    loop {
        if !d.ready {
            while d.have < d.need {
                if cursor == list.len(b) {
                    return Ok(Need)
                }
                d.header[d.have] = b[cursor]
                d.have += 1
                cursor += 1
                if d.have == 2 {
                    let code = header_check(mut d)
                    if code != 0 {
                        return Ok(reject(mut d, code))
                    }
                }
                if d.have == d.length_end && d.have >= 2 {
                    let code = length_check(mut d)
                    if code != 0 {
                        return Ok(reject(mut d, code))
                    }
                }
            }
            d.ready = true
        }
        let available = list.len(b) - cursor
        let remaining = d.length - d.received
        let count = if available < remaining {
            available
        } else {
            remaining
        }
        if d.opcode >= 8 {
            for i in 0u64 .. count {
                let mask: u8 = if d.masked {
                    d.header[d.length_end + ((d.received + i) % 4)]
                } else {
                    0
                }
                d.control.data[d.received + i] = b[cursor + i] ^ mask
            }
        } else {
            room(mut d, count)?
            let start = list.len(d.message)
            let input = list.slice(b, cursor, cursor + count)
            if d.masked {
                let mut mask: Inline[u8, 4] =[0; 4]
                for i in 0u64 .. 4u64 {
                    mask[i] = d.header[d.length_end + i]
                }
                append_masked(mut d.message, input, mask, d.received % 4)?
            } else {
                list.append(mut d.message, input)?
            }
            if d.text {
                let checked = validate_fragment(d.utf8, list.slice(d.message, start, list.len(d.message)))
                let Some(validated) = checked else {
                    return Ok(reject(mut d, 1007))
                }
                d.utf8 = validated
            }
        }
        d.received += count
        cursor += count
        if d.received != d.length {
            return Ok(Need)
        }
        if d.opcode >= 8 {
            d.control.len = d.length
        }
        let e = finish_frame(mut d)
        match e {
            Need => {},
            _ => return Ok(take e)
        }
    }
}

pub opaque type Encoder: send {
    role: Role,
    max: u64,
    fragmented: bool,
    total: u64,
    text: bool,
    utf8: Utf8,
    closed: bool
}

/// Outgoing frame machine. Client masks are supplied by its entropy owner;
/// each encode call requires a fresh four-byte mask. No allocation.
/// Ex: `websocket.encoder(Client, 262144)`.
pub fn encoder(role: Role, max_frame: u64) -> Encoder {
    check_max(max_frame)
    Encoder(role, max: max_frame, fragmented: false, total: 0, text: false, utf8: fresh_utf8(), closed: false)
}

/// Appends one frame to out; validates the opcode, fragmentation, close and
/// size limits before writing. Inner Error is the close code, outer Error is
/// Capacity. Caller retains out and its send cursor until fully written.
/// O(payload); max_frame + 14 output bytes. Ex: `websocket.encode(mut e, true, 2, payload, mask, mut out)?`.
pub fn encode(mut e: Encoder, fin: bool, opcode: u8, payload: Bytes, mask: Inline[u8, 4], mut out: Bytes) -> Result[Result[(), u16], Capacity] {
    if e.closed {
        return Ok(Error(1002))
    }
    let n = list.len(payload)
    if opcode != 0 && opcode != 1 && opcode != 2 && opcode != 8 && opcode != 9 && opcode != 10 {
        return Ok(Error(1002))
    }
    if opcode >= 8 && (!fin || n > 125) {
        return Ok(Error(1002))
    }
    if opcode == 0 && !e.fragmented || (opcode == 1 || opcode == 2) && e.fragmented {
        return Ok(Error(1002))
    }
    let is_text = opcode == 1 || opcode == 0 && e.text
    let mut utf = if opcode == 1 {
        fresh_utf8()
    } else {
        e.utf8
    }
    if is_text {
        let Some(validated) = validate_fragment(utf, payload) else {
            return Ok(Error(1007))
        }
        utf = validated
        if fin && utf.tail[0] != 0 {
            return Ok(Error(1007))
        }
    }
    if n > e.max || opcode < 8 && n > e.max - e.total {
        return Ok(Error(1009))
    }
    if opcode == 8 {
        let mut c = Control(data:[0; 125], len: n)
        for i in 0u64 .. n {
            c.data[i] = payload[i]
        }
        let code = close_error(c)
        if code != 0 {
            return Ok(Error(code))
        }
    }
    let wide: u64 = if n < 126 {
        0
    } else if n <= 65535 {
        2
    } else {
        8
    }
    let masked = e.role == Client
    let head: u64 = 2 + wide + if masked {
        4
    } else {
        0
    }
    let needed = match int.checked_add(n, head) {
        Some(x) => x,
        None => return Error(Capacity(requested: n, available: 0))
    }
    list.reserve(mut out, needed)?
    let _ = list.push(mut out, opcode | if fin {
        128
    } else {
        0
    })
    let tag: u8 = if wide == 0 {
        int.narrow(n)
    } else if wide == 2 {
        126
    } else {
        127
    }
    let _ = list.push(mut out, tag | if masked {
        128
    } else {
        0
    })
    for i in 0u64 .. wide {
        let x: u8 = int.truncate(n >> ((wide - i - 1) * 8))
        let _ = list.push(mut out, x)
    }
    if masked {
        for i in 0u64 .. 4u64 {
            let _ = list.push(mut out, mask[i])
        }
    }
    if masked {
        append_masked(mut out, payload, mask, 0)?
    } else {
        list.append(mut out, payload)?
    }
    if opcode < 8 {
        e.fragmented = !fin
        e.text = is_text
        e.utf8 = utf
        e.total = if fin {
            0
        } else {
            e.total + n
        }
    }
    if opcode == 8 {
        e.closed = true
    }
    Ok(Ok(()))
}

/// Appends the header of one whole unmasked binary frame of n payload bytes,
/// for a caller that writes those bytes in place behind it. Server role only;
/// the frame must not interrupt a fragmented message. The encoder state is
/// unchanged, as a whole binary frame leaves it. O(1); reserves n + header.
/// Ex: `websocket.binary_head(e, n, mut out)?`.
pub fn binary_head(e: Encoder, n: u64, mut out: Bytes) -> Result[Result[(), u16], Capacity] {
    if e.closed || e.fragmented || e.role == Client {
        return Ok(Error(1002))
    }
    if n > e.max {
        return Ok(Error(1009))
    }
    let wide: u64 = if n < 126 {
        0
    } else if n <= 65535 {
        2
    } else {
        8
    }
    let needed = match int.checked_add(n, 2 + wide) {
        Some(x) => x,
        None => return Error(Capacity(requested: n, available: 0))
    }
    list.reserve(mut out, needed)?
    let _ = list.push(mut out, 130u8)
    let tag: u8 = if wide == 0 {
        int.narrow(n)
    } else if wide == 2 {
        126
    } else {
        127
    }
    let _ = list.push(mut out, tag)
    for i in 0u64 .. wide {
        let x: u8 = int.truncate(n >> ((wide - i - 1) * 8))
        let _ = list.push(mut out, x)
    }
    Ok(Ok(()))
}

/// Appends the inline control payload, for the sole writer to encode as Pong
/// or a Close echo. O(len), at most 125 bytes. Ex: `websocket.control(c, mut out)?`.
pub fn control(c: Control, mut out: Bytes) -> Result[(), Capacity] {
    list.reserve(mut out, c.len)?
    for i in 0u64 .. c.len {
        let _ = list.push(mut out, c.data[i])
    }
    Ok(())
}

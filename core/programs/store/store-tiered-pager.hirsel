pub type TieredPagerSource: send = PagerDirectory(Dir) | PagerBucket(std.object.Opener, u64, Option[ObjectsCache]) | PreviewDirectory(Dir, PreviewRead) | PreviewBucket(std.object.Opener, u64, Option[ObjectsCache], PreviewRead)

pub type TieredPagerInput = PagerLocal(Dir, Option[PreviewRead]) | PagerObjects(std.object.Opener, u64, Option[ObjectsCache], Option[PreviewRead])

pub fn pager_preview(input: TieredPagerInput) -> Option[View[PreviewRead] in input] {
    match input {
        PagerLocal(_, Some(source)) => Some(view source),
        PagerObjects(_, _, _, Some(source)) => Some(view source),
        _ => None,
    }
}

pub type TieredPagerTarget: send {
    edge: format.TieredTarget,
    direction: TieredDirection,
    inventory: pages.PagePack,
    object: Option[pages.HistoryRef],
    next_stamp: u64,
    deadline: u64
}

pub type TieredPageSource {
    pager: Sender[TieredPagerMessage],
    packs: std.omap.OMap[u64, pages.TieredPagerPack],
    next_stamp: u64,
    deadline: u64
}

// A latched miss's batch: the target and its key, the values the read at the
// key goes on to read, `paths` more key paths gathered by `fetch_many`, and a
// scan's read-ahead: `siblings` when the attempt named them, else `ahead`,
// which the pager spends when its descent reads the leaf's parent. `room`
// bounds the bytes of the scan's later values the pager adds: the attempt's
// partition less what it touched.
pub type TieredPointDemand: send {
    target: format.TieredTarget,
    key: Bytes,
    values: TieredValues,
    room: u64,
    direction: TieredDirection,
    paths: List[TieredPath],
    siblings: List[format.TieredTarget],
    ahead: TieredAhead,
    packs: std.omap.OMap[u64, pages.TieredPagerPack],
    next_stamp: u64,
    deadline: u64,
    grant: Option[Arc[TieredReaderGrant]]
}

pub type TieredPointDelivery: send {
    frames: List[Arc[format.TieredFrame]],
    // The path frames that lead `frames`, values read at their keys
    // included; installing a later frame of the delivery never evicts one of
    // these. 0 for a lone path's frames with nothing after them.
    held: u64,
    failure: Option[(format.TieredTarget, types.Failure)],
    grant: Option[Arc[TieredReaderGrant]]
}

// PagerKick only wakes a pager blocked on its inbox so that it looks at the
// writer slot (§13.3a); it carries nothing.
pub type TieredPagerMessage: send = PagerRead(TieredPagerTarget, Sender[Result[Arc[format.TieredFrame], types.Failure]]) | PagerPoint(TieredPointDemand, Sender[Result[TieredPointDelivery, types.Failure]]) | PagerReserve(u64, Sender[Result[Arc[TieredReaderGrant], types.Failure]]) | PagerIndex(TieredIndexRequest, Sender[Result[Arc[Bytes], types.Failure]]) | PagerKick

pub type TieredPagerStart: send {
    store: types.StoreKey,
    opened: u64,
    authority: TieredPagerSource,
    inbox: Receiver[TieredPagerMessage],
    // The one-slot writer channel and the coalescing park notice (§13.3a).
    writer: Receiver[TieredPagerMessage],
    notices: Sender[()],
    shared_bytes: u64
}

// What the Db task keeps of a started pager: the shared inbox, the writer
// slot, the park notices and the task (§13.3a).
pub type TieredPagerLink {
    requests: Sender[TieredPagerMessage],
    writer: Sender[TieredPagerMessage],
    notices: Receiver[()],
    worker: Task[()]
}

pub type TieredPagerFunding {
    cache_bytes: u64,
    writer_pin_bytes: u64,
    pager_task_bytes: u64,
    cut_pins: bool
}

// Demands a store's open pager queues before a sender waits (§13.2).
pub const TIERED_PAGER_QUEUE: u64 = 4

pub fn pager_reader_grant(requests: Sender[TieredPagerMessage], pin_bytes: u64) -> Result[Arc[TieredReaderGrant], types.Failure] waits {
    check_reader_pin_bytes(pin_bytes)?
    let (answer, granted) = manifest.disk_allocation(fn() -> Result[(Sender[Result[Arc[TieredReaderGrant], types.Failure]], Receiver[Result[Arc[TieredReaderGrant], types.Failure]]), types.Failure] {
        Ok(channel.new(1))
    })?
    channel.send(requests, PagerReserve(pin_bytes, take answer)) ?=> |_| Io(Closed)
    channel.receive(granted) ?=> |_| Io(Closed)
}

pub fn tiered_point_delivery(requests: Sender[TieredPagerMessage], take demand: TieredPointDemand) -> Result[TieredPointDelivery, types.Failure] waits {
    let (answer, delivered) = manifest.disk_allocation(fn() -> Result[(Sender[Result[TieredPointDelivery, types.Failure]], Receiver[Result[TieredPointDelivery, types.Failure]]), types.Failure] {
        Ok(channel.new(1))
    })?
    channel.send(requests, PagerPoint(take demand, take answer)) ?=> |_| Io(Closed)
    channel.receive(delivered) ?=> |_| Io(Closed)
}

pub fn tiered_point_continuation(frame: format.TieredFrame, key: Bytes, direction: TieredDirection, expected_level: Option[u8]) -> Result[Option[(format.TieredTarget, u8)], types.Failure] {
    let TieredImage(page) = view frame.payload else {
        return Ok(None)
    }
    let image = std.page.image_of(page)
    let height = std.page.level(image)
    if let Some(expected) = expected_level {
        if height != expected {
            return Error(format.disk_fault(manifest.paged_pack_path(frame.identity.pack)?, frame.identity.offset, Malformed))
        }
    }
    let Some(slot) = tiered_continuation_slot(page, key, direction) else {
        return Ok(None)
    }
    let Some(ColdPage(child)) = std.page.child_slot(page, slot) else {
        fail("store: verified PAGE path has no Cold child")
    }
    Ok(Some((TieredPage(child), height - 1)))
}

// The child slot a demand descends to from a branch page.
fn tiered_continuation_slot(page: Arc[std.page.Page], key: Bytes, direction: TieredDirection) -> Option[u64] {
    let image = std.page.image_of(page)
    let Some(sought) = std.page.descend(image, key) else {
        return None
    }
    if direction != TieredBackward {
        return Some(sought)
    }
    if list.len(key) == 0 {
        return Some(std.page.count(image) - 1)
    }
    let (_, equal) = std.page.search(image, key)
    Some(if equal {
        sought - 1
    } else {
        sought
    })
}

// The leaves a scan's demand reads ahead when the pager's descent reads the
// parent of the leaf it descends to (§13.3): the window beyond that leaf. A
// frame above the leaves' parents, or a demand with no read-ahead, names none.
pub fn tiered_descent_ahead(frame: format.TieredFrame, key: Bytes, direction: TieredDirection, ahead: TieredAhead) -> List[format.TieredTarget] {
    let Ahead(window, reverse) = ahead else {
        return list.new()
    }
    let TieredImage(page) = view frame.payload else {
        return list.new()
    }
    if std.page.level(std.page.image_of(page)) != 1 {
        return list.new()
    }
    let Some(slot) = tiered_continuation_slot(page, key, direction) else {
        return list.new()
    }
    tiered_ahead_siblings(page, slot, window, reverse)
}

// One live key path of a demand: the path's index (0 is the target's), the
// edge it reads next and the level that edge must have.
pub type TieredDescent {
    path: u64,
    edge: format.TieredTarget,
    level: Option[u8]
}

pub fn tiered_demand_key(demand: TieredPointDemand, path: u64) -> View[Bytes] in demand {
    if path == 0 {
        view demand.key
    } else {
        view demand.paths[path - 1].key
    }
}

pub fn tiered_demand_values(demand: TieredPointDemand, path: u64) -> View[TieredValues] in demand {
    if path == 0 {
        view demand.values
    } else {
        view demand.paths[path - 1].values
    }
}

// The Cold BLOB holding a leaf row's value, if the value is a Cold BLOB.
pub fn tiered_cold_value(page: Arc[std.page.Page], slot: u64) -> Option[format.TieredTarget] {
    let Some(BlobEdge(reference)) = std.page.owning_edge(std.page.image_of(page), slot) else {
        return None
    }
    match std.page.blob_slot(page, reference.body) {
        Some(ColdBlob(ptr)) => Some(TieredBlob(clone(ptr))),
        _ => None,
    }
}

// A delivered leaf: its page when the frame is a level-0 PAGE.
pub fn tiered_delivered_leaf(frame: format.TieredFrame) -> Option[View[Arc[std.page.Page]] in frame] {
    let TieredImage(page) = view frame.payload else {
        return None
    }
    if std.page.level(std.page.image_of(page)) != 0 {
        return None
    }
    Some(view page)
}

// Adds a forward scan's later values, rows `from` on of a delivered leaf, to
// `later` while their charges fit in `room`; false once one does not.
pub fn tiered_later_values(page: Arc[std.page.Page], from: u64, mut room: u64, mut later: List[format.TieredTarget]) -> Result[bool, types.Failure] {
    for slot in from .. std.page.count(std.page.image_of(page)) {
        let Some(take value) = tiered_cold_value(page, slot) else {
            continue
        }
        let charge = 16 + format.tiered_frame_id(value).len
        if charge > room {
            return Ok(false)
        }
        room -= charge
        types.capacity(list.try_reserve(mut later, 1))?
        list.push(mut later, take value)
    }
    Ok(true)
}

pub fn tiered_pager_demand_target(demand: TieredPointDemand, edge: format.TieredTarget) -> Result[TieredPagerTarget, types.Failure] {
    tiered_pager_target(demand.packs, demand.next_stamp, demand.deadline, demand.direction, edge)
}

fn tiered_pager_target(packs: std.omap.OMap[u64, pages.TieredPagerPack], next_stamp: u64, deadline: u64, direction: TieredDirection, edge: format.TieredTarget) -> Result[TieredPagerTarget, types.Failure] {
    let facts = format.tiered_frame_id(edge)
    let Some(pack) = std.omap.get(packs, facts.pack) else {
        return Error(format.disk_fault(manifest.paged_pack_path(facts.pack)?, facts.offset, Dangling(facts.stamp)))
    }
    Ok(TieredPagerTarget(edge: clone(edge), direction: direction, inventory: pack.inventory, object: pack.object, next_stamp: next_stamp, deadline: deadline))
}

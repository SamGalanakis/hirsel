// Colour and sanitizing (README.md, "Colour" and "Sanitize").
/// What `--color` asked for.
pub type ColorChoice: key = Auto | Always | Never

/// The 16 named terminal colours.
pub type Color: key = Black | Red | Green | Yellow | Blue | Magenta | Cyan | White | BrightBlack | BrightRed | BrightGreen | BrightYellow | BrightBlue | BrightMagenta | BrightCyan | BrightWhite

/// A text style: a foreground colour and bold, dim and underline.
pub type Style: key {
    fg: Option[Color],
    bold: bool,
    dim: bool,
    underline: bool
}

/// The environment variables the colour decision reads, as an `Env=` grant names them.
pub const COLOR_VARIABLES: String = "NO_COLOR,CLICOLOR,CLICOLOR_FORCE,TERM"

// A variable as the colour decision sees it: unset, set, or not readable under the grant.
type Var = VarUnset | VarSet(String) | VarDenied

fn read_var(source: Option[Env], variable: String) -> Var {
    match source {
        Some(e) => match env.get(e, variable) {
            Ok(Some(v)) => VarSet(string.from(v)),
            Ok(None) => VarUnset,
            Error(Denied) => VarDenied,
            Error(NotUtf8) => VarSet(string.from("\u{fffd}")),
        },
        None => VarDenied,
    }
}

// Set to a non-empty value. An empty or denied variable counts as unset.
fn nonempty(v: Var) -> Option[View[String]] in v {
    match v {
        VarSet(t) => if string.byte_len(t) > 0 {
            Some(t)
        } else {
            None
        },
        _ => None,
    }
}

// The decision itself: --color, then NO_COLOR, then CLICOLOR_FORCE, then CLICOLOR=0, then
// TERM unset or dumb (skipped when TERM is not granted), then whether the stream is a terminal.
fn decide(asked: ColorChoice, no_color: Var, clicolor: Var, force: Var, term: Var, terminal: bool) -> bool {
    match asked {
        Always => return true,
        Never => return false,
        Auto => {}
    }
    if let Some(_) = nonempty(no_color) {
        return false
    }
    if let Some(f) = nonempty(force) {
        if f != "0" {
            return true
        }
    }
    if let Some(c) = nonempty(clicolor) {
        if c == "0" {
            return false
        }
    }
    match term {
        VarDenied => {}
        VarUnset => return false,
        VarSet(t) => if t == "dumb" || string.byte_len(t) == 0 {
            return false
        },
    }
    terminal
}

/// Whether to colour a stream: `asked` from `--color`, the variables in COLOR_VARIABLES read
/// from `source` (without it, as if each were not granted), and whether the stream is a
/// terminal (`stdout.is_terminal(out)` or `stderr.is_terminal(err)`).
pub fn color(asked: ColorChoice, source: Option[Env], terminal: bool) -> bool {
    decide(asked, read_var(source, "NO_COLOR"), read_var(source, "CLICOLOR"), read_var(source, "CLICOLOR_FORCE"), read_var(source, "TERM"), terminal)
}

fn code_of(c: Color) -> u64 {
    match c {
        Black => 30,
        Red => 31,
        Green => 32,
        Yellow => 33,
        Blue => 34,
        Magenta => 35,
        Cyan => 36,
        White => 37,
        BrightBlack => 90,
        BrightRed => 91,
        BrightGreen => 92,
        BrightYellow => 93,
        BrightBlue => 94,
        BrightMagenta => 95,
        BrightCyan => 96,
        BrightWhite => 97,
    }
}

/// `text` in style `st` when `on`, else `text` unchanged. A styled text is one SGR sequence,
/// the text and a reset.
pub fn paint(text: String, st: Style, on: bool) -> String {
    let mut codes: List[u64] = list.new()
    if st.bold {
        list.push(mut codes, 1)
    }
    if st.dim {
        list.push(mut codes, 2)
    }
    if st.underline {
        list.push(mut codes, 4)
    }
    if let Some(c) = st.fg {
        list.push(mut codes, code_of(c))
    }
    if !on || list.len(codes) == 0 {
        return string.from(text)
    }
    let mut out = string.from("\u{1b}[")
    for i in 0 .. list.len(codes) {
        if i > 0 {
            string.push(mut out, ";")
        }
        string.push_u64(mut out, codes[i])
    }
    string.push(mut out, "m")
    string.push(mut out, text)
    string.push(mut out, "\u{1b}[0m")
    out
}

/// `text` with every control a terminal would act on made visible: U+0000 to U+001F except
/// tab and newline, and U+0080 to U+009F, in caret notation (`\r` is `^M`, ESC and U+009B are
/// `^[`), U+007F as `^?`, and the bidirectional controls U+202A to U+202E and U+2066 to U+2069
/// as `<U+202E>`. Write foreign text (file names, response bodies, child output) through it.
pub fn sanitize(text: String) -> String {
    let mut out = string.with_capacity(string.byte_len(text))
    let mut at: u64 = 0
    while let Some((c, next)) = string.next_scalar(text, at) {
        let code = char.to_u32(c)
        if code == 0x09 || code == 0x0a {
            string.push_char(mut out, c)
        } else if code < 0x20 || (code >= 0x80 && code < 0xa0) {
            string.push(mut out, "^")
            string.push_char(mut out, option.unwrap(char.from_u32((code & 0x1f) + 0x40)))
        } else if code == 0x7f {
            string.push(mut out, "^?")
        } else if (code >= 0x202a && code <= 0x202e) || (code >= 0x2066 && code <= 0x2069) {
            string.push(mut out, "<U+")
            let mut shift: u32 = 16
            while shift > 0 {
                shift -= 4
                let digit: u64 = int.widen((code >> shift) & 0xf)
                string.push(mut out, string.slice("0123456789ABCDEF", digit, digit + 1))
            }
            string.push(mut out, ">")
        } else {
            string.push_char(mut out, c)
        }
        at = next
    }
    out
}

fn expect_packet(raw: Bytes, config: u8, stereo: bool, samples: u64, count: u64, variable: bool, start: u64, end: u64) {
    let packet = result.unwrap(opus.parse(raw))
    if packet.config != config || packet.stereo != stereo || packet.samples_per_frame != samples || packet.frames != count || packet.variable_rate != variable || packet.payload_start != start || packet.payload_end != end {
        fail("RFC 6716 packet framing")
    }
}

fn expect_bad(raw: Bytes) {
    if let Ok(_) = opus.parse(raw) {
        fail("malformed Opus packet accepted")
    }
}

/// bug: Misread the TOC, overrun padding or frame lengths, or admit packets longer than 120 ms.
/// oracle: RFC 6716 table 2 and sections 3.2.1 through 3.2.5, plus libopus on the FFmpeg sample.
@test
fn opus_packet_framing() -> Result[(), ()] {
    expect_packet(b"\x04", 0, true, 480, 1, false, 1, 1)
    expect_packet(b"\x19ab", 3, false, 2880, 2, false, 1, 3)
    expect_packet(b"\x6a\x01abc", 13, false, 960, 2, true, 2, 5)
    expect_packet(b"\x63C\x01\x00", 12, false, 480, 3, false, 3, 3)
    expect_packet(b"\x7b\x06abcdef", 15, false, 960, 6, false, 2, 8)
    expect_bad(b"")
    expect_bad(b"\x01a")
    expect_bad(b"\x02\x04abc")
    expect_bad(b"\x03")
    expect_bad(b"\x03\x00")
    expect_bad(b"\x7b\x07abcdefg")
    expect_bad(b"\x63A\x03ab")
    // First and sixth audio packets from https://samples.ffmpeg.org/opus/opus.ts.
    // Expected by libopus opus_packet_parse and opus_packet_get_samples_per_frame.
    expect_packet(b"\xfc\x02\xff\xfe\xfc\x02\xff\xfe\xf8\xff\xfe", 31, true, 960, 1, false, 1, 11)
    expect_packet(b"\xfc\x68\x61\x96\xfd\x34\xce\xf9\xc8\xdf\x9c\xd4\x6b\xca\x39\xe3\xe8\x9a\x37\xdc\xde\x15\xb6\x13\x17\xb9\x90\xae\xd3\xd1\xc2\x0a\xa2\xe1\x65\xaf\x10\xd7\xde\x82\xab\x7e\x35\xb7\xde\x22\x03\x3f\xa9\x95\xc2\xd0\xa6\x35\x15\x0a\xb7\x56\x03\x64\xfd\x79\x6d\x29\xd2\xd0\xbb\xf7\xe0\x71\xf0\xd2\x59\x15\x91\xa1\xd5\x75\xde\x23\xff\x84\x25\x84\x74\x98\x01\x9b\x7d\x05\xe8\x79\xa1\xfe\xe4\xf1\x9c\x38\x48\xe4\x55\x05\xaa\x03\x3f\xf3\xfc\x68\x61\x96\xfd\x35\x0e\xb8\x06\x70\xca\xf3\x98\x6f\xb3\x60\x51\x9c\x61\xfc\x1d\xf3\xfa\x71\xd5\xe8\x07\x65\x03\xe3\x29\xcf\xb5\xc0\xb9\x06\x60\x8f\x59\x2c\x05\x6c\x87\xdc\x0c\xdb\x63\x7d\xb7\x0a\x65\x45\x42\xad\x42\x98\xd6\x6e\xf7\x64\xfd\x79\x6d\x29\xd2\xd7\xbf\x17\x60\x71\xf0\xd2\x59\x15\x91\xa1\xd5\x75\xde\x23\xff\x84\x25\x81\xff\x21\x1c\x6d\xfa\x0b\xd0\xf3\x47\x61\x84\xf1\x9c\x38\x48\xe4\x55\x05\xba\x03\x3f\xb3\x78\x08\xad\xe5\xe6\x5c\x5f\x84\x32\x6b\x72\x0a\x48\x75\x8a\x26\x67\x78\xa8\x3b\x8f\x76\xd7\xa9\xb6\xdd\xf3\x11\x00\xbf\xde\xc9\x9f\xea\xe8\x28\x0c\xb4\x2d\xac\xc1\xb5\x67\x77\xfa\xab", 31, true, 960, 1, false, 1, 258)
    Ok(())
}

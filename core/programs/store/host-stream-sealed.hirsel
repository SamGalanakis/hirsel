// Sealed-tail cursor rewrite (STORE-SPEC §12.11.11 M4/M6).
fn stream_sealed_publish(mut client: std.object.Client, mut register: history.HistoryRegister, authority: Bytes, mut buffers: history.HistoryBuffers, has_entry: bool, take next_attach: Option[format.Attach], deadline: u64) -> Result[SettleOutcome, types.Failure] waits {
    let mut candidate = history.register_head(register)
    if has_entry {
        let next_pos = history.history_next_id(candidate.entry.seq)?
        candidate.entry = history.history_new_ref(next_pos, candidate.pair.epoch, buffers.packet)
        pager.history_fill_key(mut buffers.key, "e-", candidate.entry)
        list.clear(mut buffers.compare)
        types.capacity(list.try_reserve(mut buffers.compare, list.len(buffers.packet)))?
        history.history_create(mut client, buffers.key, mut buffers.packet, mut buffers.compare, deadline)?
    }
    let written = history.publish_register_head(mut client, mut register, candidate, authority, take next_attach, mut buffers, deadline)?
    match take written {
        HistoryApplied(_) => Ok(SettleApplied),
        HistoryConflict(_) => {
            let (take moved, take moved_attach) = history.history_decode_head_attach(buffers.witness)?
            if moved.head.pair.epoch > history.register_head(register).pair.epoch {
                let cutoff = match history.register_attach(register) {
                    Some(a) => match a.live {
                        Some(r) => stream_find_sealed_cutoff(moved_attach, r.sid, r.inc),
                        None => None,
                    },
                    None => None,
                }
                return Ok(SettleFenced(moved.head.pair.epoch, cutoff))
            }
            Ok(SettleNotApplied)
        },
        HistoryRefused(take problem) => Error(Remote(take problem)),
        HistoryUndecided => Error(Undecided),
    }
}

fn stream_sealed_step_attach(base: format.Attach, cursor_seq: u64, cursor_frame: u32, next_pos: u64, drop_first: bool) -> Result[format.Attach, types.Failure] {
    let mut out: List[format.SealedTail] = manifest.disk_allocation(scoped fn() -> Result[List[format.SealedTail], types.Failure] {
        Ok(list.with_capacity(list.len(base.sealed)))
    })?
    let n = list.len(base.sealed)
    for i in 0u64 .. n {
        let st = base.sealed[i]
        if i == 0 {
            if !drop_first {
                let moved = format.StreamRef(sid: st.tail.sid, inc: st.tail.inc, from_seq: cursor_seq, from_frame: cursor_frame)
                list.push(mut out, format.SealedTail(tail: moved, cutoff: st.cutoff, at: next_pos))
            }
        } else {
            list.push(mut out, format.SealedTail(tail: st.tail, cutoff: st.cutoff, at: next_pos))
        }
    }
    Ok(format.Attach(settles: base.settles + 1, live: base.live, sealed: take out))
}

fn stream_sealed_tail_epoch(mut client: std.object.Client, mut buffers: TailBuffers, root: String, st: format.SealedTail, store: types.StoreKey, deadline: u64) -> Result[u64, types.Failure] waits {
    let dir = stream_key(root, stream_dir(st.tail.sid))
    let mut cut_name = string.with_capacity(48)
    format.stream_batch_key(mut cut_name, st.tail.inc, st.cutoff)
    let cut_key = stream_key(dir, cut_name)
    stream_at_root(mut client, scoped fn(mut c: std.object.Client) -> Result[u64, types.Failure] waits {
        if let None = stream_tail_range(mut c, cut_key, 0, format.STREAM_INDEX_PROBE, mut buffers.index, deadline)? {
            return Error(format.disk_fault(cut_key, 0, Absent))
        }
        let mut batch_index = match manifest.stream_batch_head(cut_key, buffers.index, st.tail.sid, st.tail.inc, st.cutoff)? {
            Rows(take found) => take found,
            Term(_, _) => return Error(format.disk_fault(cut_key, 72, Malformed)),
        }
        if list.len(buffers.index) < batch_index.byte_len {
            if let None = stream_tail_range(mut c, cut_key, 0, batch_index.byte_len, mut buffers.index, deadline)? {
                return Error(format.disk_fault(cut_key, 0, Absent))
            }
            batch_index = match manifest.stream_batch_head(cut_key, buffers.index, st.tail.sid, st.tail.inc, st.cutoff)? {
                Rows(take found) => take found,
                Term(_, _) => return Error(format.disk_fault(cut_key, 72, Malformed)),
            }
        }
        for row in batch_index.rows {
            if types.same(row.store.hi, row.store.lo, store.hi, store.lo) {
                return Ok(row.epoch)
            }
        }
        Error(format.disk_fault(cut_key, 0, Malformed))
    })
}

fn stream_sealed_fetch_slice(mut client: std.object.Client, mut buffers: TailBuffers, key: String, sid: types.HostStreamIdRep, inc: u64, seq: u64, store: types.StoreKey, tail_epoch: u64, deadline: u64) -> Result[Option[format.BatchRow], types.Failure] waits {
    stream_at_root(mut client, scoped fn(mut c: std.object.Client) -> Result[Option[format.BatchRow], types.Failure] waits {
        if let None = stream_tail_range(mut c, key, 0, format.STREAM_INDEX_PROBE, mut buffers.index, deadline)? {
            return Error(format.disk_fault(key, 0, Absent))
        }
        let mut batch_index = match manifest.stream_batch_head(key, buffers.index, sid, inc, seq)? {
            Rows(take found) => take found,
            Term(_, _) => return Error(format.disk_fault(key, 72, Malformed)),
        }
        if list.len(buffers.index) < batch_index.byte_len {
            if let None = stream_tail_range(mut c, key, 0, batch_index.byte_len, mut buffers.index, deadline)? {
                return Error(format.disk_fault(key, 0, Absent))
            }
            batch_index = match manifest.stream_batch_head(key, buffers.index, sid, inc, seq)? {
                Rows(take found) => take found,
                Term(_, _) => return Error(format.disk_fault(key, 72, Malformed)),
            }
        }
        for row in batch_index.rows {
            if types.same(row.store.hi, row.store.lo, store.hi, store.lo) && row.epoch == tail_epoch {
                if row.len == 0 {
                    return Error(format.disk_fault(key, row.offset, Malformed))
                }
                if let None = stream_tail_range(mut c, key, row.offset, row.offset + row.len, mut buffers.slice, deadline)? {
                    return Error(format.disk_fault(key, row.offset, Absent))
                }
                format.stream_slice_check(key, row, buffers.slice)?
                return Ok(Some(row))
            }
        }
        Ok(None)
    })
}

// Rewrites every sealed tail in `history.register_attach(register).sealed` in order as GROUP
// entries using the §12.11.11 M4 sealed cursor: each entry's head write moves
// `sealed[0].tail.(from_seq, from_frame)` past the frames the entry holds, sets
// `at` of every remaining sealed entry to the new head position, and drops
// `sealed[0]` with its last frame.
pub fn stream_settle_sealed_core(mut client: std.object.Client, mut register: history.HistoryRegister, authority: Bytes, mut buffers: history.HistoryBuffers, root: String, op_ms: u64, group_bytes: u64, group_commits: u64) -> Result[SettleOutcome, types.Failure] waits {
    let mut tail_bufs = stream_tail_buffers()?
    loop {
        let first_opt: Option[format.SealedTail] = match history.register_attach(register) {
            Some(a) if list.len(a.sealed) != 0 => Some(a.sealed[0u64]),
            _ => None,
        }
        let Some(st) = first_opt else {
            return Ok(SettleApplied)
        }
        let store = history.register_head(register).store
        let due_ep = std.object.deadline_after_ms(client, op_ms)
        let tail_epoch = stream_sealed_tail_epoch(mut client, mut tail_bufs, root, st, store, due_ep)?
        let dir = stream_key(root, stream_dir(st.tail.sid))
        let mut entry_frames = 0u64
        let mut entry_bytes = 0u64
        let mut cursor_seq = st.tail.from_seq
        let mut cursor_frame = st.tail.from_frame
        let mut seq = st.tail.from_seq
        let mut name = string.with_capacity(48)
        while seq <= st.cutoff {
            format.stream_batch_key(mut name, st.tail.inc, seq)
            let key = stream_key(dir, name)
            let due = std.object.deadline_after_ms(client, op_ms)
            let fetched = stream_sealed_fetch_slice(mut client, mut tail_bufs, key, st.tail.sid, st.tail.inc, seq, store, tail_epoch, due)?
            if let Some(row) = fetched {
                let skip: u64 = if seq == st.tail.from_seq {
                    int.widen(st.tail.from_frame)
                } else {
                    0
                }
                let batch_ctx = format.DiskContext(store: store, role: format.ROLE_BATCH, seq)
                let mut at = 0u64
                let mut fidx = 0u64
                while at < list.len(tail_bufs.slice) {
                    let frame = manifest.disk_frame_bytes(key, batch_ctx, tail_bufs.slice, at)?
                    if fidx >= skip {
                        if frame.kind == 0x0040 {
                            if frame.end - frame.payload != 24 || format.read_le(tail_bufs.slice, frame.payload, 8) != tail_epoch {
                                return Error(format.disk_fault(key, row.offset + at, Malformed))
                            }
                        } else if frame.kind == 0x0011 || frame.kind == 0x0013 {
                            let width = frame.end - at
                            if entry_frames > 0 && (entry_frames >= group_commits || entry_bytes + width > group_bytes) {
                                let next_pos = history.history_next_id(history.register_head(register).entry.seq)?
                                let step_attach = match history.register_attach(register) {
                                    Some(cur) => stream_sealed_step_attach(cur, cursor_seq, cursor_frame, next_pos, false)?,
                                    None => return Ok(SettleNotApplied),
                                }
                                let pub_due = std.object.deadline_after_ms(client, op_ms)
                                match stream_sealed_publish(mut client, mut register, authority, mut buffers, true, Some(take step_attach), pub_due)? {
                                    SettleApplied => (),
                                    other => return Ok(other),
                                }
                                entry_frames = 0
                                entry_bytes = 0
                            }
                            if entry_frames == 0 {
                                let group_ctx = history_group_context(history.register_head(register))?
                                history.history_packet_header(mut buffers.packet, group_ctx, history.register_head(register).pair.epoch, history.register_head(register).authority_kind, history.register_head(register).entry)?
                            }
                            let group_ctx = history_group_context(history.register_head(register))?
                            types.capacity(list.try_reserve(mut buffers.packet, width + format.BINDING_BYTES))?
                            history_group_append(mut buffers.packet, group_ctx, list.slice(tail_bufs.slice, at, frame.end))?
                            entry_frames += 1
                            entry_bytes += width
                            if fidx + 1 < row.frames {
                                cursor_seq = seq
                                cursor_frame = int.narrow(fidx + 1)
                            } else {
                                cursor_seq = seq + 1
                                cursor_frame = 0
                            }
                        } else {
                            return Error(format.disk_fault(key, row.offset + at, Kind(int.widen(frame.kind))))
                        }
                    }
                    fidx += 1
                    at = frame.end
                }
                if fidx != row.frames {
                    return Error(format.disk_fault(key, row.offset, Malformed))
                }
            }
            seq += 1
        }
        let next_pos = if entry_frames > 0 {
            history.history_next_id(history.register_head(register).entry.seq)?
        } else {
            history.register_head(register).entry.seq
        }
        let done_attach = match history.register_attach(register) {
            Some(cur) => stream_sealed_step_attach(cur, cursor_seq, cursor_frame, next_pos, true)?,
            None => return Ok(SettleNotApplied),
        }
        let pub_due = std.object.deadline_after_ms(client, op_ms)
        match stream_sealed_publish(mut client, mut register, authority, mut buffers, entry_frames > 0, Some(take done_attach), pub_due)? {
            SettleApplied => (),
            other => return Ok(other),
        }
    }
}

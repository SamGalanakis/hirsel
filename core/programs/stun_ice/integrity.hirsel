fn sha1_initial() -> Inline[u32, 5] {
    [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0]
}

fn write_digest(mut out: Bytes, at: u64, digest: Inline[u32, 5]) {
    for i in 0u64 .. 5 {
        list.set_word_be(mut out, at + 4 * i, digest[i])
    }
}

// RFC 2104 over the STUN prefix with its length field ending at the tag.
fn sha1_prefix(key: Bytes, packet: Bytes, at: u64, mut scratch: Bytes) -> Inline[u32, 5] {
    list.fill_slice(mut scratch, 0, 64, 0)
    if list.len(key) > 64 {
        let mut reduced = sha1_initial()
        sha1.blocks(mut reduced, key)
        write_digest(mut scratch, 0, reduced)
    } else {
        list.copy_from_slice(mut scratch, 0, key)
    }
    for i in 0u64 .. 64 {
        scratch[i] ^= 0x36
    }
    list.copy_from_slice(mut scratch, 64, list.slice(packet, 0, at))
    let length: u16 = int.narrow(at + 4)
    list.set_word_be(mut scratch, 66, length)
    let mut inner = sha1_initial()
    sha1.blocks(mut inner, list.slice(scratch, 0, 64 + at))
    for i in 0u64 .. 64 {
        scratch[i] ^= 0x6a
    }
    write_digest(mut scratch, 64, inner)
    let mut outer = sha1_initial()
    sha1.blocks(mut outer, list.slice(scratch, 0, 84))
    list.fill_slice(mut scratch, 0, 64 + at, 0)
    outer
}

fn sha256_prefix(key: Bytes, packet: Bytes, at: u64) -> Inline[u8, 32] {
    let length = at + 16
    let mut mac = std.hmac.start(key)
    std.hmac.add(mut mac, packet, 0, 2)
    std.hmac.add_byte(mut mac, int.truncate(length >> 8))
    std.hmac.add_byte(mut mac, int.truncate(length))
    std.hmac.add(mut mac, packet, 4, at)
    std.hmac.finish(mac)
}

// A power-of-two ring of uninhabited slots, following Rust's VecDeque.
pub opaque type Deque[T]: shareable + send {
    ring: Slots[T],
    head: u64
} drop(d) {
    // Normalize the live interval before List's resumable element cleanup.
    // The finalizer itself moves only and cannot fail.
    if d.head == 0 { return }
    if !slots_needs_drop(d.ring) {
        let head = d.head
        slots_forget_ring(mut d.ring, head)
        return
    }
    let count = list.len(d.ring.raw)
    let cap = list.capacity(d.ring.raw)
    let tail = int.wrapping_sub(cap, d.head)
    let wrapped: u64 = if count > tail { int.wrapping_sub(count, tail) } else { 0 }
    let moved: u64 = if count > tail { tail } else { count }
    let mut i: u64 = 0
    while count != cap && i < moved {
        slots_shift(mut d.ring, int.wrapping_add(d.head, i), int.wrapping_add(wrapped, i))
        i = int.wrapping_add(i, 1)
    }
    reverse(mut d.ring, 0, wrapped)
    reverse(mut d.ring, wrapped, count)
    reverse(mut d.ring, 0, count)
    d.head = 0
}

pub fn new[T]() -> Deque[T] { Deque(ring: slots_empty(), head: 0) }
pub fn len[T](d: Deque[T]) -> u64 { list.len(d.ring.raw) }
pub fn push_back[T](mut d: Deque[T], take x: T) -> Result[(), (Capacity, T)] {
    if list.len(d.ring.raw) == list.capacity(d.ring.raw) {
        if let Error(c) = grow(mut d) { return Error((c, take x)) }
    }
    // Opaque ring invariants make the masked index arithmetic non-failing.
    let i = int.wrapping_add(d.head, list.len(d.ring.raw)) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
    slots_put(mut d.ring, i, take x)
    Ok(())
}
pub fn push_front[T](mut d: Deque[T], take x: T) -> Result[(), (Capacity, T)] {
    if list.len(d.ring.raw) == list.capacity(d.ring.raw) {
        if let Error(c) = grow(mut d) { return Error((c, take x)) }
    }
    d.head = int.wrapping_sub(d.head, 1) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
    slots_put(mut d.ring, d.head, take x)
    Ok(())
}
pub fn pop_front[T](mut d: Deque[T]) -> Option[T] {
    if list.len(d.ring.raw) == 0 { return None }
    let x = slots_take(mut d.ring, d.head)
    d.head = int.wrapping_add(d.head, 1) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
    Some(take x)
}
pub fn pop_back[T](mut d: Deque[T]) -> Option[T] {
    if list.len(d.ring.raw) == 0 { return None }
    let i = int.wrapping_add(d.head, int.wrapping_sub(list.len(d.ring.raw), 1)) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
    Some(slots_take(mut d.ring, i))
}
fn grow[T](mut d: Deque[T]) -> Result[(), Capacity] {
    let cap = list.capacity(d.ring.raw)
    let count = list.len(d.ring.raw)
    if count < cap { return Ok(()) }
    // The next power of two does not fit. List's counter-overflow admission
    // returns Capacity with the current room and cannot move the full ring.
    if cap > 9223372036854775807 { return list.reserve(mut d.ring.raw, cap) }
    let next: u64 = if cap == 0 { 1 } else { cap * 2 }
    let mut ring: Slots[T] = slots_new(next)?
    let mut i: u64 = 0
    while i < count {
        let at = (d.head + i) & (cap - 1)
        slots_move(mut d.ring, at, mut ring, i)
        i += 1
    }
    let old = replace(mut d.ring, take ring)
    slots_free(take old)
    d.head = 0
    Ok(())
}
fn reverse[T](mut s: Slots[T], lo: u64, hi: u64) {
    let mut a = lo
    let mut b = hi
    while a < b {
        b = int.wrapping_sub(b, 1)
        if a < b {
            let x = slots_take(mut s, a)
            slots_shift(mut s, b, a)
            slots_put(mut s, b, take x)
        }
        a = int.wrapping_add(a, 1)
    }
}

type Slots[T]: shareable + send { raw: List[T] }
fn slots_empty[T]() -> Slots[T]
fn slots_new[T](n: u64) -> Result[Slots[T], Capacity]
fn slots_put[T](mut s: Slots[T], i: u64, take x: T)
fn slots_take[T](mut s: Slots[T], i: u64) -> T
fn slots_move[T](mut src: Slots[T], i: u64, mut dst: Slots[T], j: u64)
fn slots_shift[T](mut s: Slots[T], i: u64, j: u64)
fn slots_free[T](take s: Slots[T])

// Copy the logical live range, independent of the source's holes and head.
// A valid MEM-17 call guarantees the element's resource/scoped/opaque-free holds.
clone[T](d: Deque[T]) {
    let count = list.len(d.ring.raw)
    if count == 0 { return Ok(Deque(ring: slots_empty(), head: 0)) }
    // Least power-of-two capacity not below length, as ruled by the orchestrator.
    let mut capacity: u64 = 1
    while capacity < count { capacity *= 2 }
    let mut built: Deque[T] = Deque(ring: slots_new(capacity)?, head: 0)
    let mask = list.capacity(d.ring.raw) - 1
    let mut i: u64 = 0
    while i < count {
        let index = int.wrapping_add(d.head, i) & mask
        let attempt: Result[T, Capacity] = clone(slots_view(d.ring, index))
        let x: T = match attempt {
            Ok(take x) => take x,
            Error(c) => {
                // T1.5 is reverse construction order. Ordinary Deque cleanup
                // is front-to-back, so explicitly drain backwards on refusal.
                while list.len(built.ring.raw) != 0 {
                    let back = list.len(built.ring.raw) - 1
                    let _ = slots_take(mut built.ring, back)
                }
                return Error(c)
            }
        }
        slots_put(mut built.ring, i, take x)
        i += 1
    }
    Ok(take built)
}

fn slots_view[T](s: Slots[T], i: u64) -> View[T] in s
fn slots_needs_drop[T](s: Slots[T]) -> bool
fn slots_forget_ring[T](mut s: Slots[T], head: u64)

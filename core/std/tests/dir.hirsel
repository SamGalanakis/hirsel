// Contract tests for `dir` (core/std/dir.hirsel), written to run once an engine runs
// library bodies with a host. Each test takes `dir`, a fresh empty directory the runner
// provides, and returns a scalar; the line `// expect: run f(dir) = R` above it gives the
// result derived by hand from the contract.
fn io(r: Result[(), IoError]) -> u64 {
    match r {
        Ok(()) => 0,
        Error(NotFound) => 1,
        Error(Denied) => 2,
        Error(Exists) => 3,
        Error(Closed) => 4,
        Error(Other(_)) => 5,
    }
}

// Created (0), then Exists (3).
// expect: run create_twice(dir) = 3
fn create_twice(d: Dir) -> u64 waits {
    let first = io(dir.create_dir(d, "sub"))
    let second = io(dir.create_dir(d, "sub"))
    first * 10 + second
}

// expect: run create_without_parent(dir) = 1
fn create_without_parent(d: Dir) -> u64 waits {
    io(dir.create_dir(d, "no/sub"))
}

// Removes the tree: the file below it is gone after.
// expect: run remove_all_tree(dir) = 1
fn remove_all_tree(d: Dir) -> u64 waits {
    result.unwrap(dir.create_dir(d, "sub"))
    result.unwrap(dir.create_dir(d, "sub/deeper"))
    result.unwrap(file.write(d, "sub/deeper/x", string.as_bytes("1")))
    result.unwrap(dir.remove_all(d, "sub"))
    io(file.remove(d, "sub/deeper/x"))
}

// expect: run remove_all_missing(dir) = 1
fn remove_all_missing(d: Dir) -> u64 waits {
    io(dir.remove_all(d, "absent"))
}

// The fresh name is appended after the prefix the caller wrote, and the directory exists:
// a file can be written in it through the Dir returned.
// expect: run create_temp_names(dir) = true
fn create_temp_names(d: Dir) -> bool waits {
    let mut name = string.with_capacity(40)
    string.push(mut name, "t-")
    let tmp = result.unwrap(dir.create_temp(d, mut name))
    result.unwrap(file.write(tmp, "x", string.as_bytes("1")))
    let grew = string.byte_len(name) > 2 && string.starts_with(name, "t-")
    result.unwrap(dir.remove_all(d, name))
    grew
}

// Less than 32 bytes of spare capacity in name.
// expect: run create_temp_small_name(dir) = fail Bounds
fn create_temp_small_name(d: Dir) -> bool waits {
    let mut name = string.new()
    let _ = dir.create_temp(d, mut name)
    true
}

// The scripted provider removes only tree/a, then EIO. tree/b is a surviving prefix.
// host: remove_tree_prefix a
// expect: run remove_tree_keeps_completed_prefix(dir) = true
fn remove_tree_keeps_completed_prefix(d: Dir) -> bool waits {
    result.unwrap(dir.create_dir(d, "tree"))
    result.unwrap(file.write(d, "tree/a", string.as_bytes("a")))
    result.unwrap(file.write(d, "tree/b", string.as_bytes("b")))
    match dir.remove_all(d, "tree") {
        Error(Other(5)) => {},
        _ => return false
    }
    match file.open(d, "tree/a", Read) {
        Error(NotFound) => {},
        _ => return false
    }
    let b = result.unwrap(file.read(d, "tree/b"))
    let kept = list.len(b) == 1 && b[0] == b'b'
    result.unwrap(dir.remove_all(d, "tree"))
    kept
}

// Every encoded record fits alone in 258 bytes. No pair fits, so a reader
// must retain a record it fetched at the end of the preceding call.
// expect: run list_small_batches(dir) = true
fn list_small_batches(d: Dir) -> bool waits {
    result.unwrap(dir.create_dir(d, "scan"))
    let scan = result.unwrap(dir.narrow(d, "scan"))
    let b = result.unwrap(string.repeat("b", 255))
    let a = result.unwrap(string.repeat("a", 254))
    let c = result.unwrap(string.repeat("C", 253))
    result.unwrap(dir.create_dir(scan, b))
    result.unwrap(file.write(scan, a, string.as_bytes("a")))
    result.unwrap(file.write(scan, c, string.as_bytes("C")))
    let mut handle = result.unwrap(dir.entries(scan))
    let mut buf: Bytes = list.with_capacity(258)
    let mut seen: u8 = 0
    loop {
        let count = result.unwrap(dir.next_entries(mut handle, mut buf))
        if count == 0 {
            if list.len(buf) != 0 {
                fail("an empty batch appended bytes")
            }
            break
        }
        let size: u16 = list.word_le(buf, 1)
        let name_len: u64 = int.widen(size)
        if count != 1 || list.len(buf) != 3 + name_len {
            fail("a batch did not contain exactly one whole record")
        }
        let first = buf[3]
        let mask: u8 = if first == b'b' && size == 255 && buf[0] == 1 {
            1
        } else if first == b'a' && size == 254 && buf[0] == 0 {
            2
        } else if first == b'C' && size == 253 && buf[0] == 0 {
            4
        } else {
            fail("unexpected listing record")
        }
        if seen & mask != 0 {
            fail("a directory entry was delivered twice")
        }
        seen = seen | mask
        list.clear(mut buf)
    }
    if seen != 7 {
        fail("an entry was lost between batches")
    }
    let sorted = result.unwrap(dir.list(scan))
    list.len(sorted) == 3 && sorted[0].name == c && sorted[1].name == a && sorted[2].name == b
}

// LANG-14 / OWN-21: a closure reads each capture wherever its body uses it, whatever
// construct holds the capture's first use in the source, and whatever its type. Each
// function's first call skips the first use; later calls reach it and a second use.
// guard: f(0) = 1 (guard not run), f(5) = 4 + 5 = 9 (5 > 3), f(2) = 2; 12.
// nested_pattern: f(None) = 30, f(Some((0, 7))) = 7 + 3 = 10, f(Some((2, 9))) = 2 + 4 = 6; 46.
// propagate: g(0) = 100 (nz(0)? leaves f before p.a), g(2) = 2 + 3 + 4 = 9; 109.
// isolated: f(0) = 1 + 4 = 5, f(2) = 3 + 2 + 4 = 9; 14.
// finalized: f(0) = 1, f(1) = 5 + 1 = 6, plus r.d = 2; 9; the finalizer runs once, for id 5.
// for_captured: l = [1, 2, 3]; f(0) = 0, f(2) = 12, f(1) = 6; 18.
// generic: at u64 5: f(0) = 10, f(1) = 5 + 1 = 6; at Pair(3, 4): f(0) = 10, f(1) = 7 + 1 = 8; 34.
// stored: h.f(1) = 4 + 1 = 5, h.f(0) = 3; 8.
// recursion: walk(4) = f(4) + f(3) + f(2) + f(1) = 3 + 4 + 3 + 4; 14.
// string_capture: s = "hello"; f(0) = 1, f(1) = 5 + 1 = 6; 7.
// arc_capture: a = Arc(Pair(3, 4)); f(0) = 1, f(1) = 3 + 4 + 1 = 8; 9.
// region_view: span [1, 2, 3, 4] in r; f(0) = 0, f(1) = 10, f(2) = 20; 30.
// child: an owning closure moved into a child task reads its captures there;
// in the child, g(1) = 4 + 1 = 5, g(0) = 3; 8.
// handle: a closure views the Tasks handle and spawns only off the x == 0 arm;
// f(0) = 1, f(2) = 2 + 1 = 3 (joined), f(5) = 6; 10.
// default arguments: the language has none (labels appear in no other call);
// a record field default (SEM-10) is evaluated at construction, not at a use.
// expect: run guard() = 12
// expect: run nested_pattern() = 46
// expect: run propagate() = 109
// expect: run isolated() = 14
// expect: run finalized() = 9 trace 5
// expect: run for_captured() = 18
// expect: run generic() = 34
// expect: run stored() = 8
// expect: run recursion() = 14
// expect: run string_capture() = 7
// expect: run arc_capture() = 9
// expect: run region_view() = 30
// expect: run child(1) = 8
// expect: run handle(1) = 10
type Pair: shareable + send {
    a: u64,
    b: u64
}

fn guard() -> u64 {
    let p = Pair(a: 3, b: 4)
    let f = scoped fn(x: u64) -> u64 {
        match x {
            0 => 1,
            k if k > p.a => p.b + k,
            k => k
        }
    }
    f(0) + f(5) + f(2)
}

fn nested_pattern() -> u64 {
    let p = Pair(a: 3, b: 4)
    let f = scoped fn(o: Option[(u64, u64)]) -> u64 {
        match o {
            None => 30,
            Some((0, y)) => y + p.a,
            Some((x, _)) => x + p.b
        }
    }
    f(None) + f(Some((0, 7))) + f(Some((2, 9)))
}

fn nz(x: u64) -> Result[u64, u64] {
    if x == 0 {
        Error(100)
    } else {
        Ok(x)
    }
}

fn propagate() -> u64 {
    let p = Pair(a: 3, b: 4)
    let f = scoped fn(x: u64) -> Result[u64, u64] {
        let y = nz(x)?
        Ok(y + p.a)
    }
    let g = scoped fn(x: u64) -> u64 {
        match f(x) {
            Ok(v) => v + p.b,
            Error(e) => e
        }
    }
    g(0) + g(2)
}

fn isolated() -> u64 {
    let p = Pair(a: 3, b: 4)
    let f = scoped fn(x: u64) -> u64 {
        match isolate(fn() -> u64 {
            if x == 0 {
                1
            } else {
                p.a + x
            }
        }) {
            Ok(Ok(n)) => n + p.b,
            _ => 99
        }
    }
    f(0) + f(2)
}

resource type Fin {
    id: u64,
    d: u64
} drop(t) {
    let _ = 100 / t.d
}

fn finalized() -> u64 {
    match Fin(id: 5, d: 2) {
        Ok(r) => {
            let f = scoped fn(x: u64) -> u64 {
                if x == 0 {
                    1
                } else {
                    r.id + x
                }
            }
            f(0) + f(1) + r.d
        },
        Error(_) => 0
    }
}

fn for_captured() -> u64 {
    let mut l: List[u64] = list.with_capacity(3)
    list.push(mut l, 1)
    list.push(mut l, 2)
    list.push(mut l, 3)
    let f = scoped fn(x: u64) -> u64 {
        if x == 0 {
            0
        } else {
            let mut s: u64 = 0
            for v in l {
                s += v * x
            }
            s
        }
    }
    f(0) + f(2) + f(1)
}

fn at[T](v: T, w: u64, size: scoped fn(T) -> u64) -> u64 {
    let f = scoped fn(k: u64) -> u64 {
        if k == 0 {
            w
        } else {
            size(v) + k
        }
    }
    f(0) + f(1)
}

fn generic() -> u64 {
    at(5u64, 10, fn(x: u64) -> u64 {
        x
    }) + at(Pair(a: 3, b: 4), 10, fn(q: Pair) -> u64 {
        q.a + q.b
    })
}

scoped type Holder {
    f: scoped[view] fn(u64) -> u64
}

fn stored() -> u64 {
    let p = Pair(a: 3, b: 4)
    let h = Holder(f: fn(x: u64) -> u64 {
        if x == 0 {
            p.a
        } else {
            p.b + x
        }
    })
    let first = (h.f)(1)
    first + (h.f)(0)
}

fn walk(n: u64, f: scoped fn(u64) -> u64) -> u64 {
    if n == 0 {
        0
    } else {
        f(n) + walk(n - 1, f)
    }
}

fn recursion() -> u64 {
    let p = Pair(a: 3, b: 4)
    let f = scoped fn(x: u64) -> u64 {
        if x % 2 == 0 {
            p.a
        } else {
            p.b
        }
    }
    walk(4, f)
}

fn string_capture() -> u64 {
    let s: String = "hello"
    let f = scoped fn(x: u64) -> u64 {
        if x == 0 {
            1
        } else {
            string.byte_len(s) + x
        }
    }
    f(0) + f(1)
}

fn arc_capture() -> u64 {
    let a = arc.new(Pair(a: 3, b: 4))
    let f = scoped fn(x: u64) -> u64 {
        if x == 0 {
            1
        } else {
            a.a + a.b + x
        }
    }
    f(0) + f(1)
}

fn make(r: Region, c: u64) -> SpanBuilder[u64, in r] {
    span.with_capacity(r, c)
}

fn region_view() -> u64 {
    region r {
        let mut b = make(r, 4)
        let mut i: u64 = 1
        while i <= 4 {
            span.push(mut b, i)
            i += 1
        }
        let s = span.finish(take b)
        let f = scoped fn(x: u64) -> u64 {
            if x == 0 {
                0
            } else {
                let mut t: u64 = 0
                for v in s {
                    t += v * x
                }
                t
            }
        }
        f(0) + f(1) + f(2)
    }
}

fn child(tasks: Tasks) -> u64 waits {
    let a: u64 = 3
    let b: u64 = 4
    let f: own[send] fn(u64) -> u64 = fn(x: u64) -> u64 {
        if x == 0 {
            a
        } else {
            b + x
        }
    }
    let h = task.spawn(tasks, bytes 4096, take f, fn(take g: own[send] fn(u64) -> u64) -> u64 {
        g(1) + g(0)
    })
    result.unwrap(task.join(take h))
}

fn add_one(take x: u64) -> u64 {
    x + 1
}

fn handle(tasks: Tasks) -> u64 waits {
    let f = scoped fn(x: u64) -> u64 waits {
        if x == 0 {
            1
        } else {
            let h = task.spawn(tasks, bytes 64, x, add_one)
            result.unwrap(task.join(take h))
        }
    }
    f(0) + f(2) + f(5)
}

pub fn main(tasks: Tasks) -> Result[(), Exit] waits {
    if child(tasks) == 8 && handle(tasks) == 10 && guard() == 12 && nested_pattern() == 46 && propagate() == 109 && isolated() == 14 && finalized() == 9 && for_captured() == 18 && generic() == 34 && stored() == 8 && recursion() == 14 && string_capture() == 7 && arc_capture() == 9 && region_view() == 30 {
        Ok(())
    } else {
        Error(Exit(status: 1))
    }
}

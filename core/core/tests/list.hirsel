// list.fill laws (core.md): fill appends n copies of x after the existing elements.
// Elements are compared one by one against the spec, not with ==.
// n = 0 appends nothing: one element too many would show as a second element.
// expect: run fill_none() = true
fn fill_none() -> bool {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 5)
    list.fill(mut xs, 0, 9)
    list.len(xs) == 1 && xs[0] == 5
}

// n = 1 after a two-element prefix: [5, 6, 9].
// expect: run fill_one() = true
fn fill_one() -> bool {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 5)
    list.push(mut xs, 6)
    list.fill(mut xs, 1, 9)
    list.len(xs) == 3 && xs[0] == 5 && xs[1] == 6 && xs[2] == 9
}

// Every element after a one-element prefix equals x, for u8 and i32 (u64 is above), with
// a general value and with zero and all-ones (the values a lowering may turn into memset).
// Counts 37 and 13 cross the 16- and 32-byte store widths and leave tails; a stride or
// count mistake in a store loop puts a wrong value or length here.
// expect: run fill_each_width() = true
fn fill_each_width() -> bool {
    let mut b: Bytes = list.new()
    list.push(mut b, 3)
    list.fill(mut b, 37, 0xA5)
    list.fill(mut b, 37, 0)
    list.fill(mut b, 37, 0xFF)
    let mut ok = list.len(b) == 112 && b[0] == 3
    let mut i: u64 = 1
    while i < 112 {
        let want: u8 = if i < 38 {
            0xA5
        } else if i < 75 {
            0
        } else {
            0xFF
        }
        ok = ok && b[i] == want
        i += 1
    }
    let mut w: List[i32] = list.new()
    list.push(mut w, 4)
    list.fill(mut w, 13, -7)
    list.fill(mut w, 13, -1)
    ok = ok && list.len(w) == 27 && w[0] == 4
    i = 1
    while i < 27 {
        let want: i32 = if i < 14 {
            -7
        } else {
            -1
        }
        ok = ok && w[i] == want
        i += 1
    }
    ok
}

fn fill_plain[T: plain](mut xs: List[T], n: u64, x: T) {
    list.fill(mut xs, n, x)
}

// A tuple exercises the generic copy recipe, and a unit list needs no stores.
// expect: run fill_generic_plain() = true
fn fill_generic_plain() -> bool {
    let mut xs: List[(u8, u64)] = list.new()
    fill_plain(mut xs, 3, (7u8, 91u64))
    let mut units: List[()] = list.new()
    fill_plain(mut units, 999, ())
    let mut ok = list.len(xs) == 3 && list.len(units) == 999
    let mut i: u64 = 0
    while i < 3 {
        let (a, b) = xs[i]
        ok = ok && a == 7 && b == 91
        i += 1
    }
    let mut scalars: List[u64] = list.new()
    fill_plain(mut scalars, 2, 42u64)
    ok && scalars[0] == 42 && scalars[1] == 42
}

// The length bound (SEM-4, MEM-22, MEM-24): storage is charged round8(capacity × size(T))
// in exact arithmetic, and a charge past 2^64 − 1 is refused with requested 2^64 − 1. So no
// List[T] of logical size s >= 2 holds more than (2^64 − 8) / s elements, which engines
// may assume (FORM #113).
// A product computed in wrapping u64 arithmetic would admit 2^61 u64s as 0 bytes here.
// 2^61 − 1 u64s charge exactly 2^64 − 8, refused against the 64 bytes of the scope.
// engine-fact: List len and capacity ranges (core-form-883 FORM #113, LLVM !range)
// expect: run length_bound_refused() = true
fn length_bound_refused() -> bool {
    let mut xs: List[u64] = list.new()
    let grown = bound bytes 64 {
        list.try_reserve(mut xs, 18446744073709551615)
    }
    maximal(isolate(fn() -> Result[List[u64], Capacity] {
        bound bytes 64 {
            list.with_capacity(2305843009213693952)
        }
    })) && match refusal(isolate(fn() -> Result[List[u64], Capacity] {
        bound bytes 64 {
            list.with_capacity(2305843009213693951)
        }
    })) {
        Some(c) => c.requested == 18446744073709551608 && c.available == 64,
        None => false,
    } && maximal(isolate(fn() -> Result[List[(u64, u64)], Capacity] {
        bound bytes 64 {
            list.with_capacity(1152921504606846976)
        }
    })) && maximal(isolate(fn() -> Result[u64, Capacity] {
        bound bytes 64 {
            let mut ys: List[u64] = list.new()
            list.fill(mut ys, 2305843009213693952, 0)
            list.len(ys)
        }
    })) && match grown {
        Ok(Error(c)) => c.requested == 18446744073709551615 && c.available == 64,
        _ => false,
    } && list.len(xs) == 0 && list.capacity(xs) == 0
}

fn maximal[R](r: Result[Result[R, Causes], Capacity]) -> bool {
    match refusal(r) {
        Some(c) => c.requested == 18446744073709551615 && c.available == 64,
        None => false,
    }
}

// A tuple stride, a borrowed middle slice, and untouched destination sentinels.
// expect: run copy_from_slice_list() = true
fn copy_from_slice_list() -> bool {
    let mut src: List[(u8, u64)] = list.new()
    list.fill(mut src, 3, (4u8, 67u64))
    src[0] = (8u8, 3u64)
    src[2] = (6u8, 12u64)
    let mut dst: List[(u8, u64)] = list.new()
    list.fill(mut dst, 4, (10u8, 29u64))
    let capacity = list.capacity(dst)
    list.copy_from_slice(mut dst, 1, list.slice(src, 1, 3))
    list.copy_from_slice(mut dst, 4, (list.new() : List[(u8, u64)]))
    list.len(dst) == 4 && list.capacity(dst) == capacity && dst[0] == (10u8, 29u64) && dst[1] == (4u8, 67u64) && dst[2] == (6u8, 12u64) && dst[3] == (10u8, 29u64)
}

// expect: run copy_from_slice_inline_step() = true
fn copy_from_slice_inline_step() -> bool {
    let run = bound steps 1 {
        let mut dst: Inline[i32, 4] =[8, 7, 6, 5]
        let src: Inline[i32, 4] =[1, 2, 3, 4]
        inline.copy_from_slice(mut dst, 1, src, 2)
        dst[0] == 8 && dst[1] == 1 && dst[2] == 2 && dst[3] == 5
    }
    match run {
        Ok(valid) => valid,
        Error(_) => false,
    }
}

// expect: run copy_from_slice_overflow() = fail Bounds
fn copy_from_slice_overflow() -> bool {
    let src: Inline[u64, 2] =[3, 7]
    let mut dst: Inline[u64, 2] =[11, 13]
    inline.copy_from_slice(mut dst, 18446744073709551615, src, 2)
    dst[0] == 11
}

// Even without storage, an overwrite must fit the destination's live elements.
// expect: run copy_from_slice_unit_bounds() = fail Bounds
fn copy_from_slice_unit_bounds() -> bool {
    let mut src: List[()] = list.new()
    let mut dst: List[()] = list.new()
    list.fill(mut src, 2, ())
    list.fill(mut dst, 2, ())
    list.copy_from_slice(mut dst, 1, src)
    list.len(dst) == 2
}

// The words start one byte into the buffer. The reference bytes spell the
// numbers directly so matching read and write mistakes cannot cancel.
// expect: run word_widths_unaligned() = true
fn word_widths_unaligned() -> bool {
    let mut b: Bytes = list.with_capacity(22)
    list.push(mut b, 0xff)
    list.put_word_le(mut b, 0x0201u16)
    list.put_word_be(mut b, 0x0304u16)
    list.put_word_le(mut b, 0x08070605u32)
    list.put_word_be(mut b, 0x090a0b0cu32)
    list.put_word_be(mut b, 0x0d0e0f1011121314u64)
    let little16: u16 = list.word_le(b, 1)
    let big16: u16 = list.word_be(b, 3)
    let little32: u32 = list.word_le(b, 5)
    let big32: u32 = list.word_be(b, 9)
    let big64: u64 = list.word_be(b, 13)
    if list.len(b) != 21 || b[0] != 0xff {
        return false
    }
    for i in 1u64 .. 21 {
        if b[i] != int.truncate(i) {
            return false
        }
    }
    little16 == 0x0201 && big16 == 0x0304 && little32 == 0x08070605 && big32 == 0x090a0b0c && big64 == 0x0d0e0f1011121314
}

// With one byte left only a one-byte read would fit.
// expect: run word_widths_truncated() = fail Bounds
fn word_widths_truncated() -> u16 {
    list.word_be(string.as_bytes("abc"), 2)
}

// The original one-byte list charges eight. A two-byte append needs capacity
// four, also charged as eight, and there are zero bytes left to admit it.
// expect: run word_widths_capacity() = true
fn word_widths_capacity() -> bool {
    match refusal(isolate(fn() -> Result[(), Capacity] {
        bound bytes 8 {
            let mut b: Bytes = list.with_capacity(1)
            list.push(mut b, 0xa5)
            list.put_word_be(mut b, 0x1234u16)
        }
    })) {
        Some(c) => c.requested == 8 && c.available == 0,
        None => false,
    }
}

// Inline reads use the same unaligned byte positions.
// expect: run inline_word_widths() = true
fn inline_word_widths() -> bool {
    let raw: Inline[u8, 5] =[0xff, 1, 2, 3, 4]
    let little: u32 = inline.word_le(raw, 1)
    let big: u32 = inline.word_be(raw, 1)
    little == 0x04030201 && big == 0x01020304
}

// No start offset can fit a word in a zero-length byte array.
// expect: run inline_word_widths_empty() = fail Bounds
fn inline_word_widths_empty() -> u16 {
    let raw: Inline[u8, 0] =[0; 0]
    inline.word_le(raw, 0)
}

// The primary cause of a caught failure, when it is a refused admission.
fn refusal[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

fn refused_request[R](r: Result[Result[R, Causes], Capacity]) -> u64 {
    match refusal(r) {
        Some(c) => c.requested,
        None => 99,
    }
}

// fill_slice (core.md, Bulk overwrite) over a tuple stride: the last two of five
// elements, ending exactly at len, then an empty fill at len. By hand: [a, a, b, x, x]
// with a = (1, 10), b = (3, 30), x = (9, 99); length and capacity unchanged.
// expect: run fill_slice_end() = true
fn fill_slice_end() -> bool {
    let mut xs: List[(u8, u64)] = list.new()
    list.fill(mut xs, 5, (1u8, 10u64))
    xs[2] = (3u8, 30u64)
    let capacity = list.capacity(xs)
    list.fill_slice(mut xs, 3, 2, (9u8, 99u64))
    list.fill_slice(mut xs, 5, 0, (7u8, 77u64))
    list.len(xs) == 5 && list.capacity(xs) == capacity && xs[1] == (1u8, 10u64) && xs[2] == (3u8, 30u64) && xs[3] == (9u8, 99u64) && xs[4] == (9u8, 99u64)
}

// One element past the end: 4 + 2 > 5.
// expect: run fill_slice_past_end() = fail Bounds
fn fill_slice_past_end() -> bool {
    let mut b: Bytes = list.new()
    list.fill(mut b, 5, 0)
    list.fill_slice(mut b, 4, 2, 1)
    b[4] == 1
}

// 1 + (2^64 - 1) wraps to 0, which a wrapping end check would accept.
// expect: run fill_slice_overflow() = fail Bounds
fn fill_slice_overflow() -> bool {
    let mut b: Bytes = list.new()
    list.fill(mut b, 5, 0)
    list.fill_slice(mut b, 1, 18446744073709551615, 1)
    b[1] == 1
}

// set_word (core.md, Words) at an unaligned offset, read back with the matching reads.
// By hand: u32 0x01020304 big-endian at 1 of seven zeros gives [0, 1, 2, 3, 4, 0, 0];
// u16 0xbbaa little-endian at 5, ending at len, gives b[5] = 0xaa and b[6] = 0xbb.
// expect: run set_word_round_trip() = true
fn set_word_round_trip() -> bool {
    let mut b: Bytes = list.new()
    list.fill(mut b, 7, 0)
    let capacity = list.capacity(b)
    list.set_word_be(mut b, 1, 0x01020304u32)
    list.set_word_le(mut b, 5, 0xbbaau16)
    let big: u32 = list.word_be(b, 1)
    let little: u32 = list.word_le(b, 1)
    list.len(b) == 7 && list.capacity(b) == capacity && b[0] == 0 && b[1] == 1 && b[4] == 4 && b[5] == 0xaa && b[6] == 0xbb && big == 0x01020304 && little == 0x04030201
}

// Eight bytes from offset 0 of a seven-byte list end one byte past len.
// expect: run set_word_past_end() = fail Bounds
fn set_word_past_end() -> bool {
    let mut b: Bytes = list.new()
    list.fill(mut b, 7, 0)
    list.set_word_le(mut b, 0, 1u64)
    b[0] == 1
}

// (2^64 - 2) + 4 wraps to 2, which a wrapping end check would accept.
// expect: run set_word_overflow() = fail Bounds
fn set_word_overflow() -> bool {
    let mut b: Bytes = list.new()
    list.fill(mut b, 7, 0)
    list.set_word_be(mut b, 18446744073709551614, 1u32)
    b[0] == 0
}

// Inline set_word at the last full offset: u32 0x0a0b0c0d big-endian at 4 of eight bytes,
// then u16 0x0201 little-endian at 0. By hand: [1, 2, 0, 0, 0x0a, 0x0b, 0x0c, 0x0d].
// expect: run inline_set_word_round_trip() = true
fn inline_set_word_round_trip() -> bool {
    let mut raw: Inline[u8, 8] =[0; 8]
    inline.set_word_be(mut raw, 4, 0x0a0b0c0du32)
    inline.set_word_le(mut raw, 0, 0x0201u16)
    let big: u32 = inline.word_be(raw, 4)
    let low: u64 = inline.word_le(raw, 0)
    big == 0x0a0b0c0d && low == 0x0d0c0b0a00000201
}

// Offset 5 of eight bytes leaves three, one short of a u32.
// expect: run inline_set_word_past_end() = fail Bounds
fn inline_set_word_past_end() -> u8 {
    let mut raw: Inline[u8, 8] =[0; 8]
    inline.set_word_le(mut raw, 5, 1u32)
    raw[5]
}

// compare_bytes (core.md, Words), by hand: "abc" vs "abd" differ at index 2 (c < d);
// "ab" is a proper prefix of "abc" either way round; 0x80 sorts above 0x7f, as an
// unsigned byte; empty vs empty and equal bytes are Equal; empty is before any byte.
// expect: run compare_bytes_orders() = true
fn compare_bytes_orders() -> bool {
    let mut high: Bytes = list.new()
    list.push(mut high, 0x80)
    let mut low: Bytes = list.new()
    list.push(mut low, 0x7f)
    let empty: Bytes = list.new()
    let abc = string.as_bytes("abc")
    list.compare_bytes(abc, string.as_bytes("abd")) == Less && list.compare_bytes(string.as_bytes("abd"), abc) == Greater && list.compare_bytes(string.as_bytes("ab"), abc) == Less && list.compare_bytes(abc, string.as_bytes("ab")) == Greater && list.compare_bytes(high, low) == Greater && list.compare_bytes(low, high) == Less && list.compare_bytes(empty, empty) == Equal && list.compare_bytes(abc, string.as_bytes("abc")) == Equal && list.compare_bytes(empty, low) == Less
}

// Overlap with dst after src: a forward element loop would smear 1 over the range.
// [1, 2, 3, 4, 5] with (src 0, dst 1, count 3) gives [1, 1, 2, 3, 5] by hand. The u16
// stride catches an element offset used as a byte offset.
// expect: run copy_within_overlap_forward() = true
fn copy_within_overlap_forward() -> bool {
    let mut xs: List[u16] = list.new()
    list.fill(mut xs, 5, 0)
    xs[0] = 1
    xs[1] = 2
    xs[2] = 3
    xs[3] = 4
    xs[4] = 5
    let capacity = list.capacity(xs)
    list.copy_within(mut xs, 0, 1, 3)
    list.len(xs) == 5 && list.capacity(xs) == capacity && xs[0] == 1 && xs[1] == 1 && xs[2] == 2 && xs[3] == 3 && xs[4] == 5
}

// Overlap with dst before src: [1, 2, 3, 4, 5] with (src 2, dst 0, count 3) gives
// [3, 4, 5, 4, 5] by hand; a backward element loop would give [5, 4, 5, 4, 5].
// expect: run copy_within_overlap_backward() = true
fn copy_within_overlap_backward() -> bool {
    let mut xs: List[u16] = list.new()
    list.fill(mut xs, 5, 0)
    xs[0] = 1
    xs[1] = 2
    xs[2] = 3
    xs[3] = 4
    xs[4] = 5
    list.copy_within(mut xs, 2, 0, 3)
    xs[0] == 3 && xs[1] == 4 && xs[2] == 5 && xs[3] == 4 && xs[4] == 5
}

// [10, 20, 30, 40] with (src 1, dst 0, count 3) gives [20, 30, 40, 40], then
// (src 0, dst 1, count 3) gives [20, 20, 30, 40]; the whole thing is one Step.
// expect: run inline_copy_within_overlap() = true
fn inline_copy_within_overlap() -> bool {
    let run = bound steps 2 {
        let mut a: Inline[u32, 4] =[10, 20, 30, 40]
        inline.copy_within(mut a, 1, 0, 3)
        let shifted = a[0] == 20 && a[1] == 30 && a[2] == 40 && a[3] == 40
        inline.copy_within(mut a, 0, 1, 3)
        shifted && a[0] == 20 && a[1] == 20 && a[2] == 30 && a[3] == 40
    }
    match run {
        Ok(valid) => valid,
        Error(_) => false,
    }
}

// The source range [3, 6) runs past a length of 5 though the destination fits.
// expect: run copy_within_source_past_end() = fail Bounds
fn copy_within_source_past_end() -> u16 {
    let mut xs: List[u16] = list.new()
    list.fill(mut xs, 5, 7)
    list.copy_within(mut xs, 3, 0, 3)
    xs[0]
}

// An empty copy still checks its destination: dst 6 lies past a length of 5.
// expect: run copy_within_empty_past_end() = fail Bounds
fn copy_within_empty_past_end() -> u16 {
    let mut xs: List[u16] = list.new()
    list.fill(mut xs, 5, 7)
    list.copy_within(mut xs, 0, 6, 0)
    xs[0]
}

// 1 + (2^64 - 1) and 2 + (2^64 - 1) both wrap below 5, which a wrapping end check
// would accept.
// expect: run inline_copy_within_overflow() = fail Bounds
fn inline_copy_within_overflow() -> u32 {
    let mut a: Inline[u32, 5] =[1, 2, 3, 4, 5]
    inline.copy_within(mut a, 1, 2, 18446744073709551615)
    a[0]
}

// Truncating a List[String] to 1 of 3 keeps the first string and the capacity, and a
// second truncate past the length changes nothing.
// expect: run truncate_keeps_prefix() = true
fn truncate_keeps_prefix() -> bool {
    let mut xs: List[String] = list.new()
    list.push(mut xs, string.from("a"))
    list.push(mut xs, string.from("bc"))
    list.push(mut xs, string.from("def"))
    let capacity = list.capacity(xs)
    list.truncate(mut xs, 1)
    list.truncate(mut xs, 5)
    list.len(xs) == 1 && list.capacity(xs) == capacity && xs[0] == "a"
}

// Byte k of a is k. A 16-lane read at 3 holds bytes 3..19, so only lane 15 (byte 18)
// exceeds 17 and the bitmask is 0x8000 by hand. A write of splat(255) at 32 of 48 sets
// bytes 32..48 only, which a 32-lane read at 16 sees as lanes 16..32: 0xffff0000.
// expect: run inline_lanes_offset() = true
fn inline_lanes_offset() -> bool {
    let mut a: Inline[u8, 48] =[0; 48]
    for i in 0u64 .. 48 {
        a[i] = int.truncate(i)
    }
    let v: Simd[u8, 16] = inline.lanes(a, 3)
    let high = simd.bitmask(simd.lt((simd.splat(17) : Simd[u8, 16]), v))
    inline.set_lanes(mut a, 32, (simd.splat(255) : Simd[u8, 16]))
    let wide: Simd[u8, 32] = inline.lanes(a, 16)
    let top = simd.bitmask(simd.eq(wide, (simd.splat(255) : Simd[u8, 32])))
    high == 0x8000 && a[31] == 31 && a[32] == 255 && a[47] == 255 && top == 0xffff0000
}

// A 32-lane read at 17 of 48 bytes needs 49.
// expect: run inline_lanes_past_end() = fail Bounds
fn inline_lanes_past_end() -> bool {
    let a: Inline[u8, 48] =[0; 48]
    let v: Simd[u8, 32] = inline.lanes(a, 17)
    simd.any(v)
}

// 2^64 - 8 plus 16 lanes wraps to 8, which a wrapping end check would accept.
// expect: run inline_set_lanes_overflow() = fail Bounds
fn inline_set_lanes_overflow() -> u8 {
    let mut a: Inline[u8, 16] =[0; 16]
    inline.set_lanes(mut a, 18446744073709551608, (simd.splat(1) : Simd[u8, 16]))
    a[0]
}

type LaneRecord {
    tag: u8,
    raw: Inline[u8, 48]
}

fn record_lanes(r: LaneRecord) -> u64 {
    let v: Simd[u8, 16] = inline.lanes(r.raw, 1)
    simd.bitmask(simd.eq(v, (simd.splat(7) : Simd[u8, 16])))
}

fn record_set_lanes(mut r: LaneRecord) {
    inline.set_lanes(mut r.raw, 32, (simd.splat(9) : Simd[u8, 16]))
}

// A field reached through a view parameter and a mut parameter, the std.check shape.
// Bytes 2 and 16 are 7, so a 16-lane read at 1 has them in lanes 1 and 15: 0x8002 by
// hand. The write through mut r sets bytes 32..48 and leaves byte 31 and the tag.
// expect: run inline_lanes_through_field() = true
fn inline_lanes_through_field() -> bool {
    let mut r = LaneRecord(tag: 5, raw:[0; 48])
    r.raw[2] = 7
    r.raw[16] = 7
    let mask = record_lanes(r)
    record_set_lanes(mut r)
    mask == 0x8002 && r.raw[31] == 0 && r.raw[32] == 9 && r.raw[47] == 9 && r.tag == 5
}

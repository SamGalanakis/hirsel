// Store adapter for the ledger workload. Each group is one transaction, made
// on a store this process opens (local) or by a `db@1` place's head (served).
pub type Error = Grant(GrantError) | Clock(ClockError) | Output(OutputError) | Input(
  InputError
) | Store(store.StoreError) | Tx(store.TxFailure[ledger.Refusal]) | Run(
  RunError[store.TxFailure[ledger.Refusal]]
) | Usage

// Where a mode's transactions commit: the local store, or the place behind a runner.
type Writer = Local(store.Store) | Served(Runner)

@serializable
type Opening {
  account: u64,
  initial: u64,
}

@serializable
type Group {
  first: u64,
  size: u64,
  accounts: u64,
  amount: u64,
}

@serializable
type Expected {
  accounts: u64,
  initial: u64,
  count: u64,
  amount: u64,
}

fn open_account(mut tx: store.Tx, info: store.CallInfo, a: Opening) -> Result[
  u64,
  ledger.Refusal
] {
  ledger.open(mut tx, a.account, a.initial)
}

fn transfers(mut tx: store.Tx, info: store.CallInfo, g: Group) -> Result[
  u64,
  ledger.Refusal
] {
  for offset in 0u64..g.size {
    let op = workload.transfer(g.first + offset, g.accounts, g.amount)
    let _ = ledger.transfer(mut tx, op.from, op.to, op.cents)?
  }
  Ok(g.size)
}

// Independent conservation and exact balance oracle.
fn verify(mut tx: store.Tx, info: store.CallInfo, e: Expected) -> Result[
  u64,
  ledger.Refusal
] {
  let balances: table.Table[u64, u64] = table.named("balances")
  let mut total: u64 = 0
  for account in 0u64..e.accounts {
    let value = table.get(tx, balances, account) ? Table
    let Some(balance) = value else {
      return Error(NoAccount(account))
    }
    let previous = (account + e.accounts - 1) % e.accounts
    let mut expected = e.initial
    let mut index = previous
    while index < e.count {
      expected += e.amount * (1 + index % 3)
      index += e.accounts
    }
    index = account
    while index < e.count {
      expected -= e.amount * (1 + index % 3)
      index += e.accounts
    }
    failure.check(balance == expected, Arithmetic())
    total += balance
  }
  failure.check(total == e.accounts * e.initial, Arithmetic())
  Ok(total)
}

/// The served place's head: one store over the place's `db` authority, with
/// the local mode's configuration, serving the local mode's entries.
pub fn head(rt: Io, a: ()) -> Result[(), store.StoreError] {
  let Ok(authority) = io.authority(rt, "db") else {
    return Error(Corrupt("db"))
  }
  let Ok(inbox) = io.inbox(rt) else {
    return Error(Corrupt("inbox"))
  }
  let mut config = store.default_config()
  config.group_commits = 1
  let mut s = store.open(authority, config)?
  store.serve(
    mut s,
    take inbox,
    [
      store.served_transact(open_account),
      store.served_transact(transfers),
      store.served_transact(verify)
    ]
  )
}

/// One transaction of the entry `f` on `w`; the writer comes back with its outcome.
fn commit[A: serializable](
  take w: Writer,
  f: Entry[
    fn(mut tx: store.Tx, info: store.CallInfo, a: A) -> Result[u64, ledger.Refusal]
  ],
  a: A
) -> (Writer, Result[u64, Error]) {
  match take w {
    Local(db) => {
      let mut s = take db
      let committed = store.transact(mut s, f, a)
      let outcome: Result[u64, Error] = match take committed {
        Ok(n) => Ok(n),
        Error(e) => Error(Tx(take e)),
      }
      (Local(take s), take outcome)
    },
    Served(r) => {
      let called = runner.transact(r, f, a)
      let outcome: Result[u64, Error] = match take called {
        Ok(n) => Ok(n),
        Error(e) => Error(Run(take e)),
      }
      (Served(r), take outcome)
    },
  }
}

type Request {
  first: u64,
  submitted: u64,
  reply: Sender[u64],
}

fn now(c: MonotonicClock) -> u64 {
  match clock.monotonic(c) {
    Ok(t) => instant.ticks(t),
    Error(_) => {
      failure.check(false, Arithmetic())
      0
    },
  }
}

fn number(args: Args, index: u64) -> u64 {
  match arg.text(args, index) {
    Ok(s) => match u64.parse(s) {
      Ok(n) => n,
      Error(_) => 0,
    },
    Error(_) => 0,
  }
}

fn client(
  tasks: Tasks,
  c: MonotonicClock,
  take sender: Sender[Request],
  id: u64,
  stride: u64,
  count: u64,
  group: u64
) {
  let mut tx = take sender
  let (reply, receiver): (Sender[u64], Receiver[u64]) = channel.open(tasks)
  let mut rx = take receiver
  let mut first = id * group
  while first < count {
    let response = sender.dup(tasks, reply)
    let sent = channel.send(
      tasks,
      mut tx,
      Request(first: first, submitted: now(c), reply: take response)
    )
    failure.check(results.is_ok(sent), Arithmetic())
    let received = channel.receive(tasks, mut rx)
    failure.check(results.is_ok(received), Arithmetic())
    first += stride * group
  }
}

fn run(rt: Io, args: Args) -> Result[(), Error] {
  let output = io.stdout(rt) ? Grant
  let input = io.stdin(rt) ? Grant
  let c = io.monotonic_clock(rt) ? Grant
  let tasks = io.tasks(rt) ? Grant
  let accounts = number(args, 0)
  let initial = number(args, 1)
  let count = number(args, 2)
  let amount = number(args, 3)
  let group = number(args, 4)
  let clients = number(args, 5)
  let served = match arg.text(args, 6) {
    Ok(mode) => mode == "served",
    Error(_) => false,
  }
  // A served sample may split its clients over `callers` processes, each with its own
  // runner and so its own call stream; this one is `caller`. Caller 0 opens the
  // accounts and runs the oracle once every caller is done.
  let callers: u64 = if number(args, 7) == 0 {
    1
  } else {
    number(args, 7)
  }
  let caller = number(args, 8)
  if accounts < 2 || group == 0 || clients == 0 || count == 0 || count % group != 0 || count % accounts != 0 || caller >= callers || count % (callers * group) != 0 || callers > 1 && !served {
    return Error(Usage())
  }
  let share = count / callers
  let mut config = store.default_config()
  config.group_commits = 1
  let mut db = if served {
    Served(io.runner(rt, "db") ? Grant)
  } else {
    Local(store.open(io.authority(rt, "db") ? Grant, config) ? Store)
  }
  let opening: u64 = if caller == 0 {
    accounts
  } else {
    0
  }
  for account in 0u64..opening {
    let (next, opened) = commit(
      take db,
      open_account,
      Opening(account: account, initial: initial)
    )
    db = take next
    let _ = take opened?
  }
  // The host enables phase counters before releasing this input gate.
  out.print(output, "READY\n") ? Output
  let _ = input.read_line(input) ? Input
  let (sender, receiver): (Sender[Request], Receiver[Request]) = channel.open(tasks)
  let start = now(c)
  let outcome = task.scope(
    tasks,
    fn(scope: Scope) -> Result[(Writer, List[u64]), Error] {
      let mut writer = take db
      let mut rx = take receiver
      let mut latencies: List[u64] = []
      let mut children: TaskSet[()] of scope = task.set(scope)
      for id in 0u64..clients {
        let outgoing = sender.dup(tasks, sender)
        task.add(
          scope,
          mut children,
          task.async(
            scope,
            fn() {
              client(
                tasks,
                c,
                take outgoing,
                caller * clients + id,
                callers * clients,
                count,
                group
              )
            }
          )
        )
      }
      let mut completed: u64 = 0
      while completed < share {
        let req = match channel.receive(tasks, mut rx) {
          Ok(r) => take r,
          Error(_) => {
            task.cancel_all(scope, take children)
            return Error(Usage())
          },
        }
        let Request(first: first, submitted: submitted, reply: response) = take req
        let (next, committed) = commit(
          take writer,
          transfers,
          Group(first: first, size: group, accounts: accounts, amount: amount)
        )
        writer = take next
        if let Error(e) = take committed {
          task.cancel_all(scope, take children)
          return Error(take e)
        }
        let finished = now(c)
        list.push(mut latencies, finished - submitted)
        let mut reply = take response
        failure.check(
          results.is_ok(channel.send(tasks, mut reply, finished)),
          Arithmetic()
        )
        completed += group
      }
      while let Some(index) = task.await_any(scope, children) {
        task.await_at(scope, mut children, index)
      }
      task.cancel_all(scope, take children)
      Ok((take writer, take latencies))
    }
  )
  let elapsed = now(c) - start
  out.print(output, "DONE\n") ? Output
  let _ = input.read_line(input) ? Input
  let (written, latencies) = take outcome?
  // A local store closes and recovers; a served one stays with its place.
  let reopened = match take written {
    Local(s) => {
      store.close(take s) ? Store
      Local(store.open(io.authority(rt, "db") ? Grant, config) ? Store)
    },
    Served(r) => Served(r),
  }
  // The oracle runs outside the timed phase, after every caller is done.
  let (checked, verified) = if caller == 0 {
    commit(
      take reopened,
      verify,
      Expected(accounts: accounts, initial: initial, count: count, amount: amount)
    )
  } else {
    (take reopened, Ok(0))
  }
  let _ = take verified?
  if let Local(s) = take checked {
    store.close(take s) ? Store
  }
  out.print(output, f"elapsed {elapsed}\n") ? Output
  for latency in latencies {
    out.print(output, f"latency {latency}\n") ? Output
  }
  out.print(output, "verified\n") ? Output
  Ok(())
}

// The native entry result is small; detailed store errors stay inside the adapter.
pub fn main(rt: Io, args: Args) -> Result[(), u64] {
  match run(rt, args) {
    Ok(()) => Ok(()),
    Error(_) => Error(1),
  }
}

fn wire_call_ready[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take pending: WirePending, allowed: bool) -> Result[(), u16] {
    let plan = wire_plan_call(s, take pending, allowed)?
    wire_apply_plan(mut s, mut work, take plan)
}

// WIRE W3c: hand-sized replies and the exact 41,140-byte outcome reserve.
fn w3c_bytes(take count: u32) -> Result[Bytes, Capacity] {
    let mut b: Bytes = list.new()
    let n: u64 = int.widen(count)
    for _ in 0u64 .. n { result.capacity_only(list.push(mut b, 3u8))? }
    Ok(take b)
}

fn w3c_tx(mut tx: store.Tx, h: (), take count: u32) -> Result[Bytes, u32] {
    match w3c_bytes(count) { Ok(take b) => Ok(take b), Error(_) => Error(1u32) }
}

fn w3c_key[A, R](f: View[Bytes], ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Bytes {
    let mut key: Bytes = result.unwrap(clone(f))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(ca)), mut key))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(cr)), mut key))
    key
}

fn transport_receive[G: send, H: send](mut s: WireSession[G, H], mut w: WireWork) -> Option[Frame] {
    let frame = wire_take_output(s, mut w)
    wire_sent(mut s, mut w)
    take frame
}

pub fn law_unread_client(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut reg: Registry[(), ()] = registry()
    result.unwrap(compute(mut reg, code.describe(w3c_bytes), 65536u64, DEFAULT_STEPS))
    result.unwrap(transact(mut reg, code.describe(w3c_tx), 65536u64, DEFAULT_STEPS))
    let carried: std.codec.Codec[Result[Bytes, u32]] = std.codec.of()
    let transact_key = w3c_key(code.identity(code.describe(w3c_tx)), std.codec.of_u32(), carried)
    let codec: std.codec.Codec[Bytes] = std.codec.of()
    let key = w3c_key(code.identity(code.describe(w3c_bytes)), std.codec.of_u32(), codec)
    let (access_gate, take handle) = result.unwrap(ingress.start(tasks, clock, random, ingress.defaults(), 1048576u64))
    let mut policy_handle = take handle
    let principal = option.unwrap(ingress.hello(access_gate, V4(1u32), None))
    let (head, requests): (Sender[Req], Receiver[Req]) = result.unwrap(channel.new(5u64))
    let service = wire_service_seed(take reg, access_gate, head, clock, tasks, wire_defaults(1048576u64, 1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, allocate: _, finish: _, check: _) = take service
    let mut s = take initial
    let mut work = wire_work()
    let (owner, events): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(5u64))
    s.me = Some(take owner)
    let (take caller, _) = ingress.welcome(take principal)
    s.caller = Some(take caller)
    s.phase = 3u8
    result.unwrap(list.push(mut s.entries, take key))
    result.unwrap(list.push(mut s.entries, take transact_key))
    for stream in 0u32 .. 5u32 {
        let mut arg: Bytes = list.new()
        result.unwrap(std.codec.put_u32(8168u32, mut arg))
        let at = host.mono_ns(clock)
        result.unwrap(wire_call_ready(mut s, mut work, WirePending(stream: stream, p: 0u64, slot: 0u32, deadline: 10000u32, arg: take arg, at: at, grows: true), true))
    }
    if wire_units(s) != 5u64 { return false }
    for completed in 0u64 .. 5u64 {
        let selected = result.unwrap(wire_step(mut s, mut work, WPoll(true)))
        if let None = selected { return false }
        if wire_units(s) != 5u64 - completed { return false }
        let _ = result.unwrap(wire_step(mut s, mut work, WPoll(false)))
        if wire_units(s) != 5u64 - completed { return false }
        let _ = result.unwrap(wire_step(mut s, mut work, WSent))
        if wire_units(s) != 4u64 - completed { return false }
    }
    // One durable group retains its units and V1 rows until Sent.
    let mut answers: List[KeyedDone] = list.new()
    for stream in 0u32 .. 5u32 {
        let mut arg: Bytes = list.new()
        result.unwrap(std.codec.put_u32(8164u32, mut arg))
        let at = host.mono_ns(clock)
        result.unwrap(wire_call_ready(mut s, mut work, WirePending(stream: stream, p: 0u64, slot: 1u32, deadline: 10000u32, arg: take arg, at: at, grows: true), true))
        let Req(e: take input) = result.unwrap(channel.try_receive(requests))
        let Requested(Request(caller: _, stream: take named, p: p, key: _, arg: _, digest: _, reply_to: _, live: _, identity: _, seed: _)) = take input else {
            return false
        }
        let mut reply_bytes: Bytes = list.new()
        let body = result.unwrap(w3c_bytes(8164u32))
        let value: Result[Bytes, u32] = Ok(take body)
        result.unwrap(std.codec.encode(carried, value, mut reply_bytes))
        result.unwrap(list.push(mut answers, KeyedDone(stream: take named, p: p, outcome: Returned(take reply_bytes))))
    }
    result.unwrap(wire_update(mut s, mut work, Update(version: 7u64, content: None, outcomes: take answers)))
    if wire_units(s) != 5u64 || list.len(work.output) != 1u64 { return false }
    for stream in 5u32 .. 10u32 { result.unwrap(wire_refused(mut s, mut work, stream, 0u64, Budget(Room(requested: 9u64, available: 8u64)))) }
    if let Error(1008u16) = wire_refused(mut s, mut work, 10u32, 0u64, Overloaded) {} else { return false }
    let mut retained = 0u64
    for o in work.output { if let Batch(_, _, _, ds) = o.frame { for d in ds { retained += wire_done_size(d.outcome) } } }
    if retained != 41140u64 { return false }
    result.unwrap(wire_reset(mut s, mut work.output, 7u64))
    let reset = result.unwrap(wire_step(mut s, mut work, WPoll(true)))
    if wire_units(s) != 5u64 || s.refusals != 5u64 { return false }
    if let Error(1008u16) = wire_refused(mut s, mut work, 10u32, 0u64, Overloaded) {} else { return false }
    let _ = result.unwrap(wire_step(mut s, mut work, WSent))
    let preserved = match take reset {
        Some(Reset(7u64, take ds)) => {
            if list.len(ds) != 10u64 { false } else {
                let mut ok = true
                let mut count = 0u32
                for take d in take ds {
                    if d.stream != count || d.p != 0u64 { ok = false }
                    if count < 5u32 {
                        if let Returned(b) = d.outcome { if list.len(b) != 8172u64 || b[0u64] != 0u8 || b[4u64] != 228u8 || b[5u64] != 31u8 || b[8u64] != 3u8 || b[8171u64] != 3u8 { ok = false } } else { ok = false }
                    } else {
                        if let Refused(Budget(Room(requested: 9u64, available: 8u64))) = d.outcome {} else { ok = false }
                    }
                    count += 1u32
                }
                ok
            }
        },
        _ => false,
    }
    let no_head = match channel.try_receive(requests) { Error(Empty) => true, _ => false }
    let freed = wire_units(s) == 0u64 && s.refusals == 0u64 && list.len(work.output) == 0u64
    let legacy = result.unwrap(w3c_bytes(8173u32))
    let mut unfit: List[KeyedDone] = list.new()
    result.unwrap(list.push(mut unfit, KeyedDone(stream: list.new(), p: 0u64, outcome: Returned(take legacy))))
    let refused_legacy = match wire_update(mut s, mut work, Update(version: 9u64, content: None, outcomes: take unfit)) { Error(1009u16) => true, _ => false }
    let unchanged = s.last == 7u64 && list.len(work.output) == 0u64
    let readmitted = match wire_refused(mut s, mut work, 10u32, 0u64, Overloaded) {
        Ok(()) => s.refusals == 1u64,
        Error(_) => false,
    }
    task.cancel(mut policy_handle)
    let _ = task.join(take policy_handle)
    preserved && freed && no_head && refused_legacy && unchanged && readmitted
}

pub fn law_hello_and_slots(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut reg: Registry[(), ()] = registry()
    result.unwrap(compute(mut reg, code.describe(w3c_bytes), 65536u64, DEFAULT_STEPS))
    result.unwrap(transact(mut reg, code.describe(w3c_tx), 65536u64, DEFAULT_STEPS))
    let (access_gate, take handle) = result.unwrap(ingress.start(tasks, clock, random, ingress.defaults(), 1048576u64))
    let mut policy_handle = take handle
    let principal = option.unwrap(ingress.hello(access_gate, V4(1u32), None))
    let (head, requests): (Sender[Req], Receiver[Req]) = result.unwrap(channel.new(1u64))
    let service = wire_service_seed(take reg, access_gate, head, clock, tasks, wire_defaults(1048576u64, 1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, allocate: _, finish: _, check: _) = take service
    let mut s = take initial
    let mut work = wire_work()
    s.phase = 2u8
    let (take caller, take token) = ingress.welcome(take principal)
    s.caller = Some(take caller)
    s.welcome_token = Some(take token)
    let entry_codec: std.codec.Codec[Result[Bytes, u32]] = std.codec.of()
    let entry = w3c_key(code.identity(code.describe(w3c_tx)), std.codec.of_u32(), entry_codec)
    result.unwrap(list.push(mut s.entries, result.unwrap(clone(entry))))
    let mut unknown: Bytes = list.new()
    result.unwrap(list.append(mut unknown, string.as_bytes("missing")))
    let missing = result.unwrap(wire_key(Want(identity: take unknown, args_fp: 0u64, result_fp: 0u64)))
    result.unwrap(list.push(mut s.entries, take missing))
    result.unwrap(list.push(mut s.entries, result.unwrap(clone(entry))))
    if wire_can_read(s) { return false }
    if let Ok(Some(Welcome(_, 4u32, 1048576u64, _, _, _))) = wire_step(mut s, mut work, WPoll(true)) {} else { return false }
    if wire_can_read(s) { return false }
    if let Ok(Some(Placed(Ready(0u32)))) = wire_step(mut s, mut work, WPoll(true)) {} else { return false }
    if let Ok(Some(Placed(Gone))) = wire_step(mut s, mut work, WPoll(true)) {} else { return false }
    if let Ok(Some(Placed(Ready(2u32)))) = wire_step(mut s, mut work, WPoll(true)) {} else { return false }
    if wire_can_read(s) { return false }
    let _ = wire_step(mut s, mut work, WPoll(true))
    if !wire_can_read(s) { return false }
    if let Error(1008u16) = wire_step(mut s, mut work, WClient(Hello(None, list.new()), 0u64)) {} else { return false }
    let at = host.mono_ns(clock)
    result.unwrap(wire_call_ready(mut s, mut work, WirePending(stream: 1u32, p: 2u64, slot: 0xffffffffu32, deadline: 10u32, arg: list.new(), at: at, grows: true), true))
    let refused = match transport_receive(mut s, mut work) { Some(Batch(0u64, _, _, ds)) => list.len(ds) == 1u64 && match ds[0u64].outcome { Refused(NoEntry) => true, _ => false }, _ => false }
    let empty = match channel.try_receive(requests) { Error(Empty) => true, _ => false }
    let mut old: Bytes = list.new()
    result.unwrap(std.codec.put_u32(0u32, mut old))
    let mut changed: Bytes = list.new()
    result.unwrap(std.codec.put_u32(1u32, mut changed))
    let named: Bytes = match s.caller { Some(who) => wire_stream(who, 1u32), _ => return false }
    let digest = store.request_digest(entry, old)
    result.unwrap(map.insert(mut s.held, slot_key(named, 2u64), WireHeld(stream: 1u32, p: 2u64, digest: digest, forwarded: true, queued: 0u64, owed: list.new())))
    let mismatched = wire_check_live(s, Call(1u32, 2u64, 0u32, 10u32, take changed)) == Some(1008u16)
    let joined = wire_check_live(s, Call(1u32, 2u64, 2u32, 20u32, take old)) == None
    task.cancel(mut policy_handle)
    let _ = task.join(take policy_handle)
    refused && empty && mismatched && joined
}

@test
fn test_wire_admission(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_join_cleanup() && law_unread_client(tasks, clock, random) && law_hello_and_slots(tasks, clock, random) && law_refused_send_releases_timer(tasks, clock, random) { Ok(()) } else { Error(()) }
}


pub fn law_join_cleanup() -> bool {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let (pub_to, from): (Sender[PubIn], Receiver[PubIn]) = result.unwrap(channel.new(1u64))
    result.unwrap(channel.try_send(pub_to, PubIn(e: Drained)))
    let (closing, closed): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let lease = result.unwrap(WireJoinLease(closing: take closing, publisher: channel.sender(pub_to)))
    let mut joined: List[Joiner] = list.new()
    result.unwrap(list.push(mut joined, Joiner(who: 7u64, to: take to, closed: Some(take closed), ended: list.new(), reset: false, mark: None, identity: None)))
    let _ = take lease
    let mut subs: List[Sub] = list.new()
    let mut waiting: List[Replies] = list.new()
    settle(mut subs, mut joined, mut waiting, list.new(), 0u64)
    list.len(joined) == 0u64 && match channel.try_receive(from) { Ok(PubIn(e: Drained)) => true, _ => false }
}

type W3cHandles: send { data: store.Table[u64, u32] }

fn w3c_put(mut tx: store.Tx, h: W3cHandles, take value: u32) -> Result[u64, u32] {
    if let Error(_) = store.put(mut tx, h.data, 0u64, value) { return Error(1u32) }
    Ok(store.info(mut tx).id.version)
}

fn w3c_large(mut tx: store.Tx, h: W3cHandles, take count: u32) -> Result[Bytes, u32] {
    if let Error(_) = store.put(mut tx, h.data, 0u64, 99u32) { return Error(1u32) }
    match w3c_bytes(count) { Ok(take b) => Ok(take b), Error(_) => Error(2u32) }
}

fn w3c_registry() -> Registry[(), W3cHandles] {
    let mut r: Registry[(), W3cHandles] = registry()
    result.unwrap(transact(mut r, code.describe(w3c_put), 65536u64, DEFAULT_STEPS))
    result.unwrap(transact(mut r, code.describe(w3c_large), 65536u64, DEFAULT_STEPS))
    result.unwrap(compute(mut r, code.describe(w3c_bytes), 65536u64, DEFAULT_STEPS))
    result.unwrap(retain_gone(mut r, w3c_retired()))
    r
}

fn w3c_retired() -> Bytes {
    let mut key: Bytes = list.new()
    result.unwrap(list.append(mut key, string.as_bytes("retired")))
    result.unwrap(std.codec.put_u64(0u64, mut key))
    result.unwrap(std.codec.put_u64(0u64, mut key))
    key
}

type W3cRig {
    head: Head[(), W3cHandles], owner: WireSession[(), W3cHandles], work: WireWork,
    requests: Receiver[Req], releases: Receiver[PubIn], inbox: Receiver[WireEvent], policy: Task[()]
}

// The real wire owner, head and publisher delivery path, stepped without sockets.
// One pre-admitted unreplied gone call gives the same version oracle as the socket fixture.
fn w3c_rig(tasks: Tasks, clock: Clock, random: Random) -> W3cRig waits {
    let mut db = store.memory(clock, random, store.defaults())
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), std.codec.of_u32())))
    let data = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), std.codec.of_u32()))
    let (access_gate, take h) = result.unwrap(ingress.start(tasks, clock, random, ingress.defaults(), 1048576u64))
    let principal = option.unwrap(ingress.hello(access_gate, V4(1u32), None))
    let (take caller, _) = ingress.welcome(take principal)
    let stream = wire_stream(caller, 77u32)
    let _ = result.unwrap(store.admit(mut db, stream, 0u64, store.request_digest(w3c_retired(), list.new())))
    let (to_head, requests): (Sender[Req], Receiver[Req]) = result.unwrap(channel.new(5u64))
    let (to_pub, releases): (Sender[PubIn], Receiver[PubIn]) = result.unwrap(channel.new(5u64))
    let (to_owner, inbox): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(5u64))
    let service = wire_service_seed(w3c_registry(), access_gate, to_head, clock, tasks, wire_defaults(1048576u64, 1048576u64), string.new())
    let Service(context: take initial, step: _, ready: _, allocate: _, finish: _, check: _) = take service
    let mut owner = take initial
    owner.phase = 3u8
    owner.caller = Some(take caller)
    owner.me = Some(take to_owner)
    let put_codec: std.codec.Codec[Result[u64, u32]] = std.codec.of()
    let large_codec: std.codec.Codec[Result[Bytes, u32]] = std.codec.of()
    let big_codec: std.codec.Codec[Bytes] = std.codec.of()
    result.unwrap(list.push(mut owner.entries, w3c_key(code.identity(code.describe(w3c_put)), std.codec.of_u32(), put_codec)))
    result.unwrap(list.push(mut owner.entries, w3c_key(code.identity(code.describe(w3c_large)), std.codec.of_u32(), large_codec)))
    result.unwrap(list.push(mut owner.entries, w3c_key(code.identity(code.describe(w3c_bytes)), std.codec.of_u32(), big_codec)))
    result.unwrap(list.push(mut owner.entries, w3c_retired()))
    let head = Head(db: take db, r: w3c_registry(), h: W3cHandles(data: data), out: take to_pub, busy: map.new(), waiting: list.new(), group: list.new(), last: None, minted: 0u64)
    W3cRig(head: take head, owner: take owner, work: wire_work(), requests: take requests, releases: take releases, inbox: take inbox, policy: take h)
}

fn w3c_arg(n: u32) -> Bytes {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_u32(n, mut b))
    b
}

fn w3c_send(mut rig: W3cRig, stream: u32, p: u64, slot: u32, take arg: Bytes) -> Frame waits {
    let at = host.mono_ns(rig.owner.clock)
    result.unwrap(wire_call_ready(mut rig.owner, mut rig.work, WirePending(stream: stream, p: p, slot: slot, deadline: 10000u32, arg: take arg, at: at, grows: true), true))
    if let Some(take out) = transport_receive(mut rig.owner, mut rig.work) { return take out }
    let q = result.unwrap(channel.try_receive(rig.requests))
    result.unwrap(head_arrival(mut rig.head, take q, false))
    if list.len(rig.head.group) != 0u64 { result.unwrap(gate(mut rig.head)) }
    let release = result.unwrap(channel.try_receive(rig.releases))
    let PubIn(e: take released) = take release
    let answers = match take released { Released(Release(version: _, snapshot: _, answers: take a)) => take a, _ => fail("W3c: expected release") }
    let mut waiting: List[Replies] = list.new()
    let mut subs: List[Sub] = list.new()
    let mut joined: List[Joiner] = list.new()
    let version = store.version(store.snapshot(rig.head.db))
    keep_answers(mut waiting, take answers)
    settle(mut subs, mut joined, mut waiting, list.new(), version)
    let WireEvent(e: take event) = result.unwrap(channel.try_receive(rig.inbox))
    let delivered = match take event { FromRunner(take message) => take message, _ => fail("W3c: expected runner event") }
    result.unwrap(wire_step(mut rig.owner, mut rig.work, WRunner(take delivered)))
    option.unwrap(transport_receive(mut rig.owner, mut rig.work))
}

fn w3c_answer(frame: Frame, version: u64, stream: u32, p: u64, expected: Outcome) -> bool {
    match frame {
        Batch(v, complete, rows, done) => {
            if v != version || list.len(complete) != 0u64 || list.len(rows) != 0u64 || list.len(done) != 1u64 { return false }
            let got = done[0u64]
            let codec: std.codec.Codec[Outcome] = std.codec.of()
            let mut a: Bytes = list.new()
            let mut b: Bytes = list.new()
            result.unwrap(std.codec.encode(codec, got.outcome, mut a))
            result.unwrap(std.codec.encode(codec, expected, mut b))
            got.stream == stream && got.p == p && a == b
        },
        _ => false,
    }
}

fn w3c_ok(version: u64) -> Outcome {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_u32(0u32, mut b))
    result.unwrap(std.codec.put_u64(version, mut b))
    Returned(take b)
}

fn w3c_close(take rig: W3cRig) -> () waits {
    let W3cRig(head: take hd, owner: _, work: _, requests: _, releases: _, inbox: _, policy: take access_gate) = take rig
    let mut h = take access_gate
    task.cancel(mut h)
    let _ = task.join(take h)
    let Head(db: take db, r: _, h: _, out: _, busy: _, waiting: _, group: _, last: _, minted: _) = take hd
    result.unwrap(store.close(take db))
}

// RUNNER-SPEC L9: only admitted sends retain deadline tasks.
pub fn law_refused_send_releases_timer(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    // Other sessions can fill the shared head while this owner owes no sends.
    let filling = result.unwrap(head_lease(copy_wire_head(rig.owner.head)))
    for p in 0u64 .. 5u64 {
        let key = w3c_retired()
        let arg: Bytes = list.new()
        let digest = store.request_digest(key, arg)
        let request = Request(caller: None, stream: list.new(), p: p, key: take key, arg: take arg, digest: digest,
            reply_to: wire_me(rig.owner), live: latest.handle(filling.live),
            identity: latest.handle(filling.identity), seed: result.unwrap(owner_seed(filling)))
        if let Posted = try_head(rig.owner.head, Req(e: Requested(take request))) {} else { return false }
    }
    for stream in 0u32 .. 7u32 {
        let at = host.mono_ns(clock)
        let pending = WirePending(stream: stream, p: 0u64, slot: 0u32, deadline: 10000u32, arg: w3c_arg(7u32), at: at, grows: true)
        result.unwrap(wire_call_ready(mut rig.owner, mut rig.work, take pending, true))
        let output = option.unwrap(transport_receive(mut rig.owner, mut rig.work))
        if !w3c_answer(output, 0u64, stream, 0u64, Refused(Overloaded)) || map.len(rig.work.timers) != 0u64 { return false }
    }
    w3c_close(take rig)
    true
}

pub fn law_gone_slot_v5(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let mut ok = true
    for (p, v) in [(0u64, 3u64), (0u64, 3u64), (1u64, 5u64), (1u64, 5u64)] {
        let out = w3c_send(mut rig, 77u32, p, 3u32, list.new())
        ok = w3c_answer(out, v, 77u32, p, Failed(Gone)) && ok
    }
    ok = store.version(store.snapshot(rig.head.db)) == 5u64 && ok
    w3c_close(take rig)
    ok
}

pub fn law_request_mismatch_wire(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let first = w3c_send(mut rig, 0u32, 0u64, 0u32, w3c_arg(7u32))
    let mut ok = w3c_answer(first, 4u64, 0u32, 0u64, w3c_ok(4u64))
    let changed = w3c_send(mut rig, 0u32, 0u64, 0u32, w3c_arg(8u32))
    ok = w3c_answer(changed, 4u64, 0u32, 0u64, Refused(RequestMismatch)) && ok
    ok = store.version(store.snapshot(rig.head.db)) == 4u64 && result.unwrap(store.get(store.snapshot(rig.head.db), store.shape(rig.head.h.data), 0u64)) == Some(7u32) && ok
    w3c_close(take rig)
    ok
}

pub fn law_history_below_latest(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let mut ok = true
    for (p, v) in [(0u64, 4u64), (1u64, 6u64)] {
        let out = w3c_send(mut rig, 0u32, p, 0u32, w3c_arg(7u32))
        ok = w3c_answer(out, v, 0u32, p, w3c_ok(v)) && ok
    }
    let old = w3c_send(mut rig, 0u32, 0u64, 0u32, w3c_arg(9u32))
    ok = w3c_answer(old, 6u64, 0u32, 0u64, Refused(HistoryUnavailable)) && ok
    ok = store.version(store.snapshot(rig.head.db)) == 6u64 && result.unwrap(store.get(store.snapshot(rig.head.db), store.shape(rig.head.h.data), 0u64)) == Some(7u32) && ok
    w3c_close(take rig)
    ok
}

pub fn law_reply_over_done_max(tasks: Tasks, clock: Clock, random: Random) -> bool waits {
    let mut rig = w3c_rig(tasks, clock, random)
    let large = w3c_send(mut rig, 1u32, 0u64, 1u32, w3c_arg(8165u32))
    let mut ok = w3c_answer(large, 4u64, 1u32, 0u64, Failed(OutOfBytes(Room(requested: 8173u64, available: 8172u64))))
    let big = w3c_send(mut rig, 2u32, 0u64, 2u32, w3c_arg(8169u32))
    ok = w3c_answer(big, 4u64, 2u32, 0u64, Failed(OutOfBytes(Room(requested: 8173u64, available: 8172u64)))) && ok
    ok = store.version(store.snapshot(rig.head.db)) == 4u64 && result.unwrap(store.get(store.snapshot(rig.head.db), store.shape(rig.head.h.data), 0u64)) == None && ok
    w3c_close(take rig)
    ok
}

@test
fn test_durable_wire_admission(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_gone_slot_v5(tasks, clock, random) && law_request_mismatch_wire(tasks, clock, random) && law_history_below_latest(tasks, clock, random) && law_reply_over_done_max(tasks, clock, random) { Ok(()) } else { Error(()) }
}

fn wire_deliver_content(mut owner: WireSession[(), Qh], mut work: WireWork, inbox: Receiver[WireEvent]) -> () waits {
    let WireEvent(e: take event) = result.unwrap(channel.receive(inbox))
    match take event {
        FromRunner(take incoming) => { result.unwrap(wire_step(mut owner, mut work, WRunner(take incoming))); },
        _ => fail("expected publisher content"),
    }
}

fn wire_initial_count(frame: Option[Frame], sub: u32, count: u64) -> bool {
    match frame {
        Some(Batch(_, complete, rows, done)) => list.len(complete) == 1u64 && complete[0] == sub && list.len(rows) == count && list.len(done) == 0u64,
        _ => false,
    }
}

// G3 permits replacing a live id. Both the publisher's deliveries and the
// frames waiting for the writer can outlive the query that produced them.
pub fn law_wire_replacement_generation(tasks: Tasks, c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let codec = std.codec.of_u64()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), codec)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), codec))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let Mailbox(to: take to, from: take from) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = result.unwrap(channel.new(1u64))
    let pub_job = Publish(place: code.describe(subs_place), n_place: 1048576u64,
        h: result.unwrap(subs_handles(mut db)), base: take base, from: take from, ready: take ready_to)
    let publishing = result.unwrap(task.spawn(tasks, bytes 8388608u64, take pub_job, publish))
    if let Ok(None) = channel.receive(ready_from) {} else { return false }
    let (access_gate, take policy_task) = result.unwrap(ingress.start(tasks, c, r, ingress.defaults(), 1048576u64))
    let (head, requests): (Sender[Req], Receiver[Req]) = result.unwrap(channel.new(1u64))
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let config = wire_defaults(1048576u64, 1048576u64)
    let service = wire_service_seed(take reg, access_gate, head, c, tasks, config, string.new())
    let Service(context: take initial, step: _, ready: _, allocate: _, finish: _, check: _) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let (events, inbox): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(5u64))
    let (told, who): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(1u64))
    let (closing, closed): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    result.unwrap(channel.send(to, PubIn(e: Joined(Join(to: take events, told: take told, mark: None, closed: Some(take closed), identity: None)))))
    owner.joined = Some(result.unwrap(channel.receive(who)))
    owner.publisher = Some(channel.sender(to))
    if let Ok(WireEvent(e: JoinReady)) = channel.receive(inbox) {} else { return false }

    wire_subscribed(mut owner, mut work, 10u32, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg()))
    wire_deliver_content(mut owner, mut work, inbox)
    let _ = transport_receive(mut owner, mut work)

    let sub = 8u32
    wire_subscribed(mut owner, mut work, sub, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg()))
    wire_deliver_content(mut owner, mut work, inbox)
    wire_subscribed(mut owner, mut work, sub, SubscriptionInput(room: None, key: query_key(code.describe(qf)), arg: no_arg()))
    let old_initial_discarded = match transport_receive(mut owner, mut work) { None => true, _ => false }
    wire_deliver_content(mut owner, mut work, inbox)
    let new_initial = transport_receive(mut owner, mut work)
    let replacement_published = wire_initial_count(new_initial, sub, 1u64)

    set(mut db, t, 2u64, 2u64)
    let snapshot = store.snapshot(db)
    let version = store.version(snapshot)
    result.unwrap(channel.send(to, PubIn(e: Released(Release(version: version, snapshot: Some(take snapshot), answers: list.new())))))
    let stale = result.unwrap(channel.receive(inbox))
    wire_subscribed(mut owner, mut work, sub, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg()))
    if let WireEvent(e: FromRunner(take old_end)) = take stale {
        result.unwrap(wire_step(mut owner, mut work, WRunner(take old_end)))
    } else { return false }
    wire_deliver_content(mut owner, mut work, inbox)
    let after_end = transport_receive(mut owner, mut work)
    let other_sub_kept = match take after_end {
        Some(Batch(_, complete, rows, _)) => list.len(complete) == 0u64 && list.len(rows) == 1u64 && rows[0].sub == 10u32,
        _ => false,
    }
    let renewed = transport_receive(mut owner, mut work)
    let stale_end_discarded = other_sub_kept && wire_initial_count(renewed, sub, 2u64)

    // The old complete can still be in the owner inbox when a replacement arrives.
    wire_subscribed(mut owner, mut work, 3u32, SubscriptionInput(room: None, key: query_key(code.describe(q1)), arg: no_arg()))
    wire_subscribed(mut owner, mut work, 3u32, SubscriptionInput(room: None, key: list.new(), arg: no_arg()))
    wire_deliver_content(mut owner, mut work, inbox)
    wire_deliver_content(mut owner, mut work, inbox)
    let stale_complete_discarded = match transport_receive(mut owner, mut work) {
        Some(Ended(3u32, Refused(NoEntry))) => true,
        _ => false,
    }
    result.unwrap(channel.send(to, PubIn(e: Halt)))
    let _ = task.join(take publishing)
    let mut policy_handle = take policy_task
    task.cancel(mut policy_handle)
    let _ = task.join(take policy_handle)
    let _ = take closing
    let _ = take requests
    result.unwrap(store.close(take db))
    old_initial_discarded && replacement_published && stale_end_discarded && stale_complete_discarded
}

@test
fn test_wire_replacement_generation(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_wire_replacement_generation(tasks, clock, random) { Ok(()) } else { Error(()) }
}

// STORE L60. Little-endian fields and XXH3 frame checks were derived
// independently of the store encoder.
// L60 wire vectors use §2.1, the current-format (12) §2.3 HEADER, §12.2 and libxxhash.
@test
fn bucket_test_m2_head_vectors() -> Result[(), Error] {
    let config = history.object_history_config(std.object.Bucket(endpoint: "https://s3.amazonaws.com", aws_region: "us-east-1", bucket: "bucket", prefix: "", style: Path), "bucket")
    let payload = failure_result_from_rep(history.history_config_bytes(config))?
    let test_id = StoreId(hi: 9, lo: 10)
    let base = pages.HistoryRef(seq: 1, epoch: 1, len: 189, digest: 0x2701)
    let first = history.HistoryHead(authority_kind: 1, store: store_key_to_rep(test_id), pair: history.HistoryPair(epoch: 1, holder: types.StoreKey(hi: 11, lo: 12)), activation: 0, entry: base, checkpoint: base, floor: 1, binding:[0; 32], origin: None)
    let mut raw: Bytes = list.with_capacity(history.HISTORY_HEAD_LIMIT)
    failure_result_from_rep(history.history_encode_head(mut raw, first, payload))?
    let mut attempt2: Bytes = list.with_capacity(16)
    for i in 0u64 .. 16 {
        list.push(mut attempt2, int.narrow(0x20 + i))
    }
    let mut attempt3: Bytes = list.with_capacity(16)
    for i in 0u64 .. 16 {
        list.push(mut attempt3, int.narrow(0x30 + i))
    }
    let mut attempt4: Bytes = list.with_capacity(16)
    for i in 0u64 .. 16 {
        list.push(mut attempt4, int.narrow(0x40 + i))
    }
    let dec1 = failure_result_from_rep(history.history_decode_head(raw))?
    let genesis_has_origin = match dec1.head.origin {
        Some(_) => true,
        None => false,
    }
    if !history.history_pair_matches(dec1.head.pair, first.pair) || genesis_has_origin {
        fail("genesis current-format head did not round-trip with no ORIGIN")
    }
    let second = history_claim_head(first, StoreId(hi: 13, lo: 14), ClaimAuth(expect: Some(claim_from_pair(first.pair)?), attempt: clone(attempt2), class: Permit))?
    failure_result_from_rep(history.history_encode_head(mut raw, second, payload))?
    let dec2 = failure_result_from_rep(history.history_decode_head(raw))?
    let Some(o2) = dec2.head.origin else {
        fail("epoch 2 Permit head missing ORIGIN")
    }
    if o2.epoch != 2 || o2.class != 0 || o2.permit_epoch != 2 || !history.history_origin_same_bytes(o2.attempt, o2.permit_attempt) {
        fail("epoch 2 Permit ORIGIN fields wrong")
    }
    let mut group = second
    group.entry = pages.HistoryRef(seq: 3, epoch: 2, len: 130, digest: 0x2702)
    failure_result_from_rep(history.history_encode_head(mut raw, group, payload))?
    let dec_g = failure_result_from_rep(history.history_decode_head(raw))?
    let Some(og) = dec_g.head.origin else {
        fail("advanced head lost ORIGIN")
    }
    if og.epoch != 2 || og.class != 0 || og.permit_epoch != 2 || !history.history_origin_same_bytes(og.attempt, o2.attempt) || !history.history_origin_same_bytes(og.permit_attempt, o2.permit_attempt) {
        fail("advance modified ORIGIN")
    }
    let third = history_claim_head(group, StoreId(hi: 15, lo: 16), ClaimAuth(expect: Some(claim_from_pair(group.pair)?), attempt: clone(attempt3), class: Continue))?
    failure_result_from_rep(history.history_encode_head(mut raw, third, payload))?
    let dec3 = failure_result_from_rep(history.history_decode_head(raw))?
    let Some(o3) = dec3.head.origin else {
        fail("epoch 3 Continue head missing ORIGIN")
    }
    if o3.epoch != 3 || o3.class != 1 || o3.permit_epoch != 2 || !history.history_origin_same_bytes(o3.permit_attempt, o2.attempt) {
        fail("epoch 3 Continue ORIGIN did not preserve permit_epoch/permit_attempt")
    }
    let fourth = history_claim_head(third, StoreId(hi: 17, lo: 18), ClaimAuth(expect: None, attempt: clone(attempt4), class: Adopt))?
    failure_result_from_rep(history.history_encode_head(mut raw, fourth, payload))?
    let recovered = failure_result_from_rep(history.history_decode_head(raw))?
    let Some(o4) = recovered.head.origin else {
        fail("epoch 4 Adopt head missing ORIGIN")
    }
    if !history.history_pair_matches(recovered.head.pair, fourth.pair) || history.history_key("e-", recovered.head.entry) != "e-00000000000000000003-00000000000000000002-0000000000002702" || o4.epoch != 4 || o4.class != 2 || o4.permit_epoch != 2 || !history.history_origin_same_bytes(o4.permit_attempt, o2.attempt) {
        fail("a claim changed the inherited entry's name or ORIGIN")
    }
    // Format 10 head is refused with Unsupported(10) (no-shims clean cutover).
    let format10 = option.unwrap(std.base64.decode(string.as_bytes("")))
    match failure_result_from_rep(history.history_decode_head(format10)) {
        Error(Unsupported(10)) => (),
        _ => fail("Format 10 head was not refused with Unsupported(10)"),
    }
    // Current-format malformed heads: entry from future epoch, equal positions with
    // different refs, unknown authority style, and retired AUTHORITY kind 0x0050.
    let mut bad_future = first
    bad_future.entry = pages.HistoryRef(seq: 2, epoch: 2, len: 130, digest: 0x2702)
    failure_result_from_rep(history.history_encode_head(mut raw, bad_future, payload))?
    match failure_result_from_rep(history.history_decode_head(raw)) {
        Error(Corrupt(Fault(file: f, offset: 72, why: Malformed))) if f == "head" => (),
        _ => fail("entry from a future epoch"),
    }
    let mut bad_same = first
    bad_same.entry = pages.HistoryRef(seq: 1, epoch: 1, len: 189, digest: 0x2702)
    failure_result_from_rep(history.history_encode_head(mut raw, bad_same, payload))?
    match failure_result_from_rep(history.history_decode_head(raw)) {
        Error(Corrupt(Fault(file: f, offset: 72, why: Malformed))) if f == "head" => (),
        _ => fail("equal positions with different refs"),
    }
    let mut bad_style = failure_result_from_rep(types.copied(payload))?
    bad_style[0] = 2u8
    failure_result_from_rep(history.history_encode_head(mut raw, first, bad_style))?
    match failure_result_from_rep(history.history_decode_head(raw)) {
        Error(Corrupt(Fault(file: f, offset: 224, why: Malformed))) if f == "head" => (),
        _ => fail("unknown authority style"),
    }
    // Unknown MUST=1 frame kind 0x0050 in a current-format head is refused Unsupported(0x0050).
    let ctx1 = format.DiskContext(store: first.store, role: 7, seq: first.entry.seq)
    failure_result_from_rep(history.history_encode_base_head(mut raw, first, payload))?
    let unknown_at = list.len(raw)
    list.fill(mut raw, 16, 0u8)
    list.push(mut raw, 0u8)
    failure_result_from_rep(types.capacity(format.history_seal(mut raw, ctx1, unknown_at, 0x0050)))?
    match failure_result_from_rep(history.history_decode_head(raw)) {
        Error(Unsupported(0x0050)) => Ok(()),
        _ => fail("unknown MUST=1 frame kind was accepted"),
    }
}

fn history_check_malformed(encoded: String, expected_at: u64, take description: String) {
    let raw = option.unwrap(std.base64.decode(string.as_bytes(encoded)))
    match failure_result_from_rep(history.history_decode_head(raw)) {
        Error(Corrupt(Fault(file: bad_file, offset: at, why: Malformed))) if bad_file == "head" && at == expected_at => (),
        _ => fail(take description),
    }
}

fn history_check_vector(raw: Bytes, expected: String) {
    if raw != option.unwrap(std.base64.decode(string.as_bytes(expected))) {
        fail("the HEAD wire bytes differ from the L60 vector")
    }
}

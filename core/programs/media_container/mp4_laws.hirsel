// FFmpeg 6.1.1, H.264 baseline, 32x32, 25 fps, 3 frames, default-base-is-moof.
@test
fn mp4_reference() -> Result[(), ()] {
    let source = avc_fixture()
    let mut pref: Bytes = list.with_capacity(1024)
    let mut defaults = mp4.Defaults(duration: 0, size: 0, flags: 0)
    let moof = result.unwrap(mp4.read_init(source, 0, true, scoped fn(track: mp4.Track, trex: mp4.Defaults, configuration: Bytes) {
        let dimensions = match track.media {
            Video(w, h) => w == 32 && h == 32,
            Audio => false,
        }
        if track.id != 1 || track.timescale != 12800 || !dimensions {
            fail("track metadata differs from ffprobe")
        }
        defaults = trex
        result.unwrap(mp4.write_init(mut pref, track, configuration))
    }))
    let hashes: Inline[String, 3] =[string.from("d696fa39f9af9876fd09518e4c90a8e0c093cb30163c472cd8f20084dc62af5d"), string.from("f54a1162f99b964d7678bc4e0d9debc048fab706440dab9016ca98f35188dcd2"), string.from("21247a05133f00920ed74714cdc8a272d9549ec942bd841fed07fa673edc82b1")]
    let sizes: Inline[u64, 3] =[1226, 9, 9]
    let mut count = 0u64
    let mut samples: List[mp4.Sample] = list.with_capacity(3)
    let mut data: Bytes = list.with_capacity(1244)
    let fragment_end = result.unwrap(mp4.read_fragment(source, moof, true, defaults, scoped fn(timing: mp4.Timing, payload: Bytes) {
        if count >= 3 || timing.track != 1 || timing.decode_time != count * 512 || timing.composition_offset != 0 || timing.duration != 512 || list.len(payload) != sizes[count] || digest(payload) != hashes[count] {
            fail("packet differs from ffprobe")
        }
        list.push(mut samples, mp4.Sample(duration: timing.duration, size: int.narrow(list.len(payload)), flags: timing.flags, composition_offset: 0))
        list.append(mut data, payload)
        count += 1
    }))
    if count != 3 || fragment_end >= list.len(source) {
        fail("FFmpeg packet count or fragment extent")
    }
    let mut fragment: Bytes = list.with_capacity(144)
    result.unwrap(mp4.write_fragment(mut fragment, 1, 1, 0, samples))
    let mut remuxed: Bytes = list.with_capacity(list.len(pref) + list.len(fragment) + list.len(data))
    list.append(mut remuxed, pref)
    list.append(mut remuxed, fragment)
    list.append(mut remuxed, data)
    let mut verified = 0u64
    let payload_end = result.unwrap(mp4.read_fragment(remuxed, list.len(pref), true, defaults, scoped fn(timing: mp4.Timing, payload: Bytes) {
        if verified >= 3 || timing.decode_time != verified * 512 || timing.duration != 512 || timing.flags != samples[verified].flags || digest(payload) != hashes[verified] {
            fail("remuxed sample differs from the FFmpeg fixture")
        }
        verified += 1
    }))
    if verified != 3 || payload_end != list.len(remuxed) {
        fail("remuxed packet count or mdat size")
    }
    if let Error(Truncated) = mp4.read_fragment(list.slice(remuxed, 0, payload_end - 1), list.len(pref), false, defaults, scoped fn(_timing: mp4.Timing, _bytes: Bytes) {
        fail("published a packet from an incomplete mdat")
    }) {} else {
        fail("accepted a truncated mdat")
    }
    // The first run starts at tfhd's moof-relative base when it has no data offset.
    // That base is outside the following mdat, even when its payload would fit.
    let missing_offset = b"\x00\x00\x00\x50\x6d\x6f\x6f\x66\x00\x00\x00\x10\x6d\x66\x68\x64\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x38\x74\x72\x61\x66\x00\x00\x00\x10\x74\x66\x68\x64\x00\x02\x00\x00\x00\x00\x00\x01\x00\x00\x00\x10\x74\x66\x64\x74\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x10\x74\x72\x75\x6e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x09\x6d\x64\x61\x74\x2a"
    let implicit = mp4.Defaults(duration: 1, size: 1, flags: 0)
    if let Error(InvalidFragment) = mp4.read_fragment(missing_offset, 0, true, implicit, scoped fn(_timing: mp4.Timing, _payload: Bytes) {
        fail("used the mdat payload as the first run's implicit data offset")
    }) {} else {
        fail("a run starting outside mdat must be refused")
    }
    Ok(())
}


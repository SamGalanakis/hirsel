pub type FrameBody: send = PageBody(Arc[std.page.Page]) | BlobBody(Arc[Bytes])

pub type PackFrame: send {
    stamp: u64,
    size: u64,
    body: FrameBody
}

pub type PlannedPack: send {
    seq: u64,
    first: u64,
    end: u64,
    size: u64,
    payload_bytes: u64
}

pub type PackRun: send {
    class: u8,
    frames: List[PackFrame],
    packs: List[PlannedPack],
    next_pack: u64
}

pub fn blob_frames(cut: CutFrames) -> List[PackFrame] {
    let mut frames: List[PackFrame] = list.with_capacity(list.len(cut.blobs))
    for item in cut.blobs {
        let frame = PackFrame(stamp: item.stamp, size: 8 + list.len(item.body), body: BlobBody(arc.share(item.body)))
        list.push(mut frames, take frame)
    }
    take frames
}

pub fn page_frames(cut: CutFrames) -> List[PackFrame] {
    let mut frames: List[PackFrame] = list.with_capacity(list.len(cut.pages))
    for item in cut.pages {
        let width = std.page.sealed_size(std.page.image_of(item.body))
        list.push(mut frames, PackFrame(stamp: item.stamp, size: width, body: PageBody(arc.share(item.body))))
    }
    take frames
}

pub fn layout_packs(take frames: List[PackFrame], class: u8, first_pack: u64, cap: u64) -> Result[PackRun, types.Failure] {
    let mut packs: List[PlannedPack] = list.new()
    let mut seq = first_pack
    let mut first = 0u64
    let mut size = 72u64
    let mut payload = 0u64
    for slot in 0u64 .. list.len(frames) {
        let width = frames[slot].size
        if slot != first && (size > cap || 16 + width > cap - size || slot - first == 4294967295) {
            list.push(mut packs, PlannedPack(seq: seq, first: first, end: slot, size: size, payload_bytes: payload))
            let Some(following) = int.checked_add(seq, 1) else {
                return Error(Limit(Ids))
            }
            seq = following
            first = slot
            size = 72
            payload = 0
        }
        size += 16 + width
        payload += width
    }
    let end = list.len(frames)
    if end != first {
        list.push(mut packs, PlannedPack(seq: seq, first: first, end: end, size: size, payload_bytes: payload))
        let Some(following) = int.checked_add(seq, 1) else {
            return Error(Limit(Ids))
        }
        seq = following
    }
    Ok(PackRun(class: class, frames: take frames, packs: take packs, next_pack: seq))
}

pub fn apply_pack_layout(mut known: PageLocations, layout: PackRun) -> Result[(), types.Failure] {
    for pack_plan in layout.packs {
        let mut offset = 72u64
        for slot in pack_plan.first .. pack_plan.end {
            let frame = layout.frames[slot]
            let place = std.page.PagePtr(pack: pack_plan.seq, offset: offset, len: int.truncate(frame.size), checksum: 0, stamp: frame.stamp)
            let old = option.unwrap(types.capacity(disk_index_update(mut known.frames, frame.stamp, frame_edge_charge, fn(mut location: FrameLocation) -> std.page.PagePtr {
                replace(mut location.place, place)
            }))?)
            if old.pack != 0 {
                let _ = types.capacity(disk_index_remove(mut known.members, (old.pack, frame.stamp), member_charge))?
                let _ = types.capacity(disk_index_update(mut known.packs, old.pack, pack_edge_charge, fn(mut pack: pages.PagePack) {
                    let width: u64 = int.widen(old.len)
                    pack.live -= width
                }))?
            }
            types.capacity(disk_index_put(mut known.members, (pack_plan.seq, frame.stamp), (), member_charge))?
            offset += 16 + frame.size
        }
        let frame_count: u32 = int.truncate(pack_plan.end - pack_plan.first)
        let record = pages.PagePack(foreign: None, class: layout.class, frames: frame_count, live: pack_plan.payload_bytes, payload_bytes: pack_plan.payload_bytes, index: 0)
        types.capacity(disk_index_put(mut known.packs, pack_plan.seq, record, pack_edge_charge))?
    }
    Ok(())
}

// The place a parent records for a child. A child written earlier in the same
// pack is installed only after the pack, so its checksum comes from `emitted`,
// the pack's frames so far in offset order.
fn child_place(known: PageLocations, seq: u64, emitted: List[std.page.PagePtr], stamp: u64) -> std.page.PagePtr {
    let Some(location) = disk_index_get(known.frames, stamp) else {
        fail("store: missing emitted child")
    }
    let place = location.place
    if place.pack != seq {
        return place
    }
    let mut low = 0u64
    let mut high = list.len(emitted)
    while low < high {
        let middle = low + (high - low) / 2
        if emitted[middle].offset < place.offset {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low < list.len(emitted) && emitted[low].stamp == stamp {
        emitted[low]
    } else {
        place
    }
}

pub fn emit_located_frame(mut out: Bytes, context: format.DiskContext, frame: PackFrame, locate: scoped[view] fn(u64) -> std.page.PagePtr) -> Result[std.page.PagePtr, types.Failure] {
    let offset = list.len(out)
    let kind: u16 = match frame.body {
        BlobBody(_) => 0x0022,
        PageBody(_) => 0x0021
    }
    list.put_word_le(mut out, kind)
    list.put_word_le(mut out, 1u16)
    let size: u32 = int.truncate(frame.size)
    list.put_word_le(mut out, size)
    list.put_word_le(mut out, 0u64)
    let checksum = match frame.body {
        BlobBody(body) => {
            list.put_word_le(mut out, frame.stamp)
            list.append(mut out, body)
            std.check.xxh3(body, 0, list.len(body))
        },
        PageBody(page) => {
            // The pack buffer already has room for the planned PAGE.
            pages.page_result(std.page.seal_located(mut out, page, frame.size, locate))?
            // The PAGE stamp follows the first eight bytes of its payload.
            list.set_word_le(mut out, offset + 24, frame.stamp)
            std.check.xxh3(out, offset + 16, list.len(out))
        },
    }
    let bound_checksum = disk_allocation(scoped fn() -> Result[u64, types.Failure] {
        types.capacity(format.disk_check(context, offset, list.slice(out, offset, offset + 8), list.slice(out, offset + 16, list.len(out))))
    })?
    list.set_word_le(mut out, offset + 8, bound_checksum)
    Ok(std.page.PagePtr(pack: context.seq, offset: offset, len: size, checksum: checksum, stamp: frame.stamp))
}

// The pack's places are installed together once every frame is emitted, so the
// frame index is shared and its nodes copied once per pack, not once per frame.
pub fn encode_pack(id: types.StoreKey, layout: PackRun, pack: PlannedPack, mut known: PageLocations, mut out: Bytes) -> Result[(), types.Failure] {
    list.clear(mut out)
    let context = format.DiskContext(store: id, role: 3, seq: pack.seq)
    let (take header, take reserved) = disk_allocation(scoped fn() -> Result[(Bytes, List[std.page.PagePtr]), types.Failure] {
        let places: List[std.page.PagePtr] = list.with_capacity(pack.end - pack.first)
        Ok((types.capacity(format.disk_header_bytes(context, 0, 0))?, take places))
    })?
    let mut emitted = take reserved
    list.append(mut out, header)
    for slot in pack.first .. pack.end {
        let located = emit_located_frame(mut out, context, layout.frames[slot], scoped fn(stamp: u64) -> std.page.PagePtr {
            child_place(known, pack.seq, emitted, stamp)
        })?
        list.push(mut emitted, located)
    }
    let updated = disk_allocation(scoped fn() -> Result[DiskIndex[u64, FrameLocation], types.Failure] {
        let mut frames = disk_index_share(known.frames)
        for located in emitted {
            let _ = types.capacity(disk_index_update(mut frames, located.stamp, frame_edge_charge, fn(mut location: FrameLocation) {
                location.place = located
            }))?
        }
        Ok(take frames)
    })?
    known.frames = take updated
    Ok(())
}

pub type PackBuffers {
    out: Bytes,
    destination: String,
    temporary: String
}

pub fn cut_output_buffers(cut: PagedCutLayout, manifest_bytes: u64, limit: u64) -> Result[PackBuffers, types.Failure] {
    let mut width = manifest_bytes
    for pack in cut.blobs.packs {
        width = order.max(width, pack.size)
    }
    for pack in cut.data_pages.packs {
        width = order.max(width, pack.size)
    }
    for pack in cut.lists.run_packs.packs {
        width = order.max(width, pack.size)
    }
    if width > limit {
        return Error(Full(Allocation(Capacity(requested: width, available: limit))))
    }
    disk_allocation(scoped fn() -> Result[PackBuffers, types.Failure] {
        Ok(PackBuffers(out: list.with_capacity(width), destination: string.with_capacity(22), temporary: string.with_capacity(26)))
    })
}

fn write_pack_run(d: Dir, id: types.StoreKey, layout: PackRun, mut known: PageLocations, mut buffers: PackBuffers) -> Result[(), types.Failure] waits {
    for pack in layout.packs {
        encode_pack(id, layout, pack, mut known, mut buffers.out)?
        string.truncate(mut buffers.destination, 0)
        string.push(mut buffers.destination, "p-")
        string.push_u64(mut buffers.destination, pack.seq)
        string.truncate(mut buffers.temporary, 0)
        string.push(mut buffers.temporary, buffers.destination)
        string.push(mut buffers.temporary, ".tmp")
        disk_write_synced(d, buffers.temporary, buffers.out)?
        disk_io(host.rename(d, buffers.temporary, buffers.destination))?
    }
    Ok(())
}

fn sparse_pack(known: pages.PagePack) -> bool {
    known.live != 0 && known.frames > 1 && known.live < known.payload_bytes - known.live
}

pub fn moved_frames(known: PageLocations, lists: bool) -> List[u64] {
    let mut moved: List[u64] = list.new()
    let mut inventory = std.omap.range(known.packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut inventory) {
        if pack.class < 3 && (pack.class == 2) == lists && sparse_pack(pack) {
            let mut members = std.omap.range(known.members.values, Included((seq, 0u64)), Included((seq, 18446744073709551615u64)))
            while let Some(((_, stamp), _)) = std.omap.next(mut members) {
                list.push(mut moved, stamp)
            }
        }
    }
    // The previous stamp-ordered walk seeded the closure in this order.
    list.sort(mut moved, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    take moved
}

pub fn encode_pack_row(pack: pages.PagePack) -> Bytes {
    let width = match pack.foreign {
        None => 30u64,
        Some(_) => 86u64,
    }
    let mut out: Bytes = list.with_capacity(width)
    list.push(mut out, pack.class)
    list.put_word_le(mut out, pack.frames)
    list.put_word_le(mut out, pack.live)
    list.put_word_le(mut out, pack.payload_bytes)
    list.put_word_le(mut out, pack.index)
    match pack.foreign {
        None => list.push(mut out, 0u8),
        Some(ref) => {
            list.push(mut out, 1u8)
            list.put_word_le(mut out, ref.parent.hi)
            list.put_word_le(mut out, ref.parent.lo)
            for i in 0u64 .. 16 {
                list.push(mut out, ref.incarnation[i])
            }
            list.put_word_le(mut out, ref.epoch)
            list.put_word_le(mut out, ref.len)
            list.put_word_le(mut out, ref.digest)
        },
    }
    take out
}

// The batch visitor borrows contiguous keys and values. A key alone is a
// deletion: every Format 15 pack or deferred-free value has a nonempty tag.
type ManifestEdits {
    data: Bytes,
    offsets: List[(u64, Option[u32])]
}

fn add_manifest_edit(mut edits: ManifestEdits, seq: u64, value: Option[Bytes], prior: Option[u32]) {
    list.push(mut edits.offsets, (list.len(edits.data), prior))
    list.put_word_be(mut edits.data, seq)
    if let Some(raw) = value {
        list.append(mut edits.data, raw)
    }
}

fn visit_manifest_edit(edits: ManifestEdits, at: u64, visit: scoped fn(std.page.SourceEdit) -> Result[(), std.page.Error]) -> Result[(), std.page.Error] {
    let (start, prior) = edits.offsets[at]
    let end = if at + 1 < list.len(edits.offsets) {
        edits.offsets[at + 1].0
    } else {
        list.len(edits.data)
    }
    let value: Option[(View[Bytes], Option[View[Arc[Bytes]]])] = if start + 8 == end {
        None
    } else {
        Some((list.slice(edits.data, start + 8, end), None))
    }
    visit(std.page.SourceEdit(key: list.slice(edits.data, start, start + 8), value: value, prior: prior))
}

fn draw_manifest_edits(mut stamp: u64, take batch: (Arc[std.page.Page], ManifestEdits)) -> Result[Arc[std.page.Page], types.Failure] {
    let (take base, take edits) = take batch
    let mut root = take base
    pages.page_result(std.page.apply_sorted_source(mut root, edits, visit_manifest_edit, 0, list.len(edits.offsets), 1024, mut stamp))?
    Ok(take root)
}

fn apply_manifest_edits(mut root: Arc[std.page.Page], take edits: ManifestEdits, issued: core.Cell[u64]) -> Result[(), types.Failure] {
    if list.len(edits.offsets) != 0 {
        root = cell.with(issued, (arc.share(root), take edits), draw_manifest_edits)?
    }
    Ok(())
}

fn next_installed_pack(mut cursor: std.page.Cursor) -> Option[(u64, u64)] {
    let Some((key, slot)) = std.page.cursor_next_key(mut cursor, list.new()) else {
        return None
    }
    Some((list.word_be(key, 0), slot))
}

// Both probe producers return retiring sequences in ascending order. Walk
// them alongside the inventory and the installed rows, staging only changes.
pub fn edit_pack_list(mut root: Arc[std.page.Page], known: PageLocations, retiring: List[u64], issued: core.Cell[u64]) -> Result[List[u64], types.Failure] {
    let mut retired: List[u64] = list.new()
    let mut edits = ManifestEdits(data: list.new(), offsets: list.new())
    let mut cursor = std.page.cursor_open(arc.share(root), None, true, false)
    let mut old = next_installed_pack(mut cursor)
    let mut retire = 0u64
    let mut inventory = std.omap.range(known.packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut inventory) {
        if pack.class == 2 {
            continue
        }
        while retire < list.len(retiring) && retiring[retire] < seq {
            retire += 1
        }
        while let Some((old_seq, _)) = old {
            if old_seq >= seq {
                break
            }
            old = next_installed_pack(mut cursor)
        }
        let listed = match old {
            Some((id, slot)) if id == seq => std.page.cursor_value(cursor, slot),
            _ => None,
        }
        if (pack.class < 3 && pack.live == 0) || (pack.class >= 3 && retire < list.len(retiring) && retiring[retire] == seq) {
            if let Some(_) = listed {
                add_manifest_edit(mut edits, seq, None, None)
            }
            list.push(mut retired, seq)
        } else {
            let raw = encode_pack_row(pack)
            let unchanged = match listed {
                Some(value) => value == raw,
                None => false,
            }
            if !unchanged {
                add_manifest_edit(mut edits, seq, Some(take raw), None)
            }
        }
    }
    apply_manifest_edits(mut root, take edits, issued)?
    Ok(take retired)
}

pub type PagedLists: shareable + send {
    packs: Arc[std.page.Page],
    // The deferred-free queue (§13.6), keyed by its sequence below `deferred_next`.
    deferred: Arc[std.page.Page],
    deferred_next: u64,
    // The `lineage` tree (§13.6) and the rows it holds.
    lineage: Arc[std.page.Page],
    rows: Lineage
}

pub fn empty_paged_lists() -> PagedLists {
    let empty = std.page.empty(0, 0, Unprefixed)
    let deferred = arc.share(empty)
    let lineage = arc.share(empty)
    PagedLists(packs: take empty, deferred: take deferred, deferred_next: 0, lineage: take lineage, rows: empty_lineage())
}

// The rows are rebuilt into a fresh tree only when they change. A bulk
// build of n rows issues fewer than 2n + 2 page stamps.
pub fn plan_lineage_root(installed: PagedLists, rows: Lineage, issued: core.Cell[u64]) -> Result[Arc[std.page.Page], types.Failure] {
    if same_lineage(rows, installed.rows) {
        return Ok(arc.share(installed.lineage))
    }
    let first = cell.get(issued)
    let row_count = map.len(rows.forks) + map.len(rows.cells)
    let Some(end) = int.checked_add(first, 2 * row_count + 2) else {
        return Error(Limit(Ids))
    }
    let _ = cell.replace(issued, end)
    let mut draw = first
    build_lineage_tree(rows, mut draw)
}

pub type ListLayout: send {
    roots: PagedLists,
    run_packs: PackRun,
    removals: List[u64]
}

pub fn empty_cut_frames() -> CutFrames {
    CutFrames(emitted: map.new(), pages: list.new(), blobs: list.new())
}

pub fn retiring_list_packs(known: PageLocations, emission: CutFrames, mut retiring: Map[u64, ()]) {
    let mut moving: Map[u64, u64] = map.new()
    for item in emission.pages {
        let Some(location) = disk_index_get(known.frames, item.stamp) else {
            fail("store: missing planned list frame")
        }
        if location.place.pack != 0 {
            let width: u64 = int.widen(location.place.len)
            map.update_or_insert(mut moving, location.place.pack, 0, fn(mut total: u64) {
                total += width
            })
        }
    }
    let mut inventory = std.omap.range(known.packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut inventory) {
        if pack.class == 2 && pack.live == map.get_or(moving, seq, 0) {
            map.insert(mut retiring, seq, ())
        }
    }
}

pub type PageRetryBase: send {
    locations: PageLocations,
    account: u64
}

pub fn page_retry_base(installed: PageLocations, previous: Map[IncomingEdge, u64], holders: List[HeldPage], roots: List[pages.PageRoots]) -> Result[PageRetryBase, types.Failure] {
    disk_allocation(scoped fn() -> Result[PageRetryBase, types.Failure] {
        let candidate = candidate_page_locations(installed, previous, holders)?
        let account = pages.page_row_account(roots)
        Ok(PageRetryBase(locations: take candidate, account: account))
    })
}

pub type PagedCutLayout: send {
    locations: PageLocations,
    blobs: PackRun,
    data_pages: PackRun,
    lists: ListLayout
}

pub fn write_page_cut(d: Dir, id: types.StoreKey, take cut: PagedCutLayout, mut buffers: PackBuffers) -> Result[PagedCutLayout, types.Failure] waits {
    let PagedCutLayout(locations: take locations, blobs: take blobs, data_pages: take data_pages, lists: take lists) = take cut
    let mut known = take locations
    write_pack_run(d, id, blobs, mut known, mut buffers)?
    write_pack_run(d, id, data_pages, mut known, mut buffers)?
    write_pack_run(d, id, lists.run_packs, mut known, mut buffers)?
    Ok(PagedCutLayout(locations: take known, blobs: take blobs, data_pages: take data_pages, lists: take lists))
}

pub fn prepare_page_cut[T](base: PageLocations, mut next_stamp: u64, attempt: scoped fn(Map[u64, ()], Option[View[core.Log[bool]]], mut u64) -> Result[T, types.Failure] waits) -> Result[T, types.Failure] waits {
    let selected = disk_allocation(scoped fn() -> Result[Map[u64, ()], types.Failure] {
        Ok(relocation_ancestors(base, moved_frames(base, false)))
    })
    let marks = match take selected {
        Ok(take ready) => take ready,
        Error(Full(Allocation(_))) => map.new(),
        Error(take problem) => return Error(take problem),
    }
    let observer = disk_allocation(fn() -> Result[core.Log[bool], types.Failure] {
        Ok(log.new())
    })
    if let Ok(take observed) = take observer {
        let first = attempt(marks, Some(view observed), mut next_stamp)
        let relocated = log.finish(take observed)
        match take first {
            Ok(take cut) => return Ok(take cut),
            Error(Full(Allocation(problem))) => {
                if map.len(marks) == 0 && list.len(relocated) == 0 {
                    return Error(Full(Allocation(problem)))
                }
            },
            Error(take problem) => return Error(take problem),
        }
    }
    let _ = take marks
    attempt(map.new(), None, mut next_stamp)
}

// Called under the Directory writer LOCK after reserving seq. CreateNew
// reserves the final name before rename can replace anything. A crash
// between reservation and rename leaves only an unreferenced empty file.
pub fn install_direct_pack(d: Dir, seq: u64, wire: Bytes) -> Result[(), types.Failure] waits {
    let dest = paged_pack_path(seq)?
    let tmp = types.capacity(disk_path("p-", seq, ".tmp"))?
    if let Error(take problem) = disk_write_synced(d, tmp, wire) {
        let _ = disk_remove_optional(d, tmp)?
        return Error(take problem)
    }
    let reserved = match disk_io(host.open(d, dest, CreateNew)) {
        Ok(take opened) => take opened,
        Error(take problem) => {
            let _ = disk_remove_optional(d, tmp)?
            return Error(take problem)
        },
    }
    let installed = match disk_io(host.close(take reserved)) {
        Ok(()) => match disk_io(host.rename(d, tmp, dest)) {
            Ok(()) => disk_io(host.sync_dir(d)),
            Error(take problem) => Error(take problem),
        },
        Error(take problem) => Error(take problem),
    }
    if let Error(take problem) = take installed {
        let _ = disk_remove_optional(d, tmp)?
        let _ = disk_remove_optional(d, dest)?
        disk_io(host.sync_dir(d))?
        return Error(take problem)
    }
    Ok(())
}

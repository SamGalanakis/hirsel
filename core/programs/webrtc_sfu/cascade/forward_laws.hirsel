// SFU cascade KS2 laws: K3 (`one_copy_per_layer_per_node`),
// K7 (`congested_link_costs_its_rooms`), and K8 (`attach_cost_is_exact`),
// wired through real `router.Router` + `cascade.CascadeAdapter` + `router.Observer`.
const K3_HOME_ADDR: Addr = Addr(ip: V4(0x0a020001), port: 4510)

const K3_EDGE_A_ADDR: Addr = Addr(ip: V4(0x0a020002), port: 4511)

const K3_EDGE_B_ADDR: Addr = Addr(ip: V4(0x0a020003), port: 4512)

const K7_HOME_ADDR: Addr = Addr(ip: V4(0x0a030001), port: 4520)

const K7_SHAPER_HOME_ADDR: Addr = Addr(ip: V4(0x0a030004), port: 4523)

const K7_SHAPER_EDGE_ADDR: Addr = Addr(ip: V4(0x0a030005), port: 4524)

const K7_EDGE_A_ADDR: Addr = Addr(ip: V4(0x0a030002), port: 4521)

const K7_EDGE_B_ADDR: Addr = Addr(ip: V4(0x0a030003), port: 4522)

const K2_END: u64 = 8000 * MS

const K_ROOM: peer.RoomId = RoomId(1)

fn make_canon_rtp(codec: sdp.Codec, seq: u16, ts: u32, ssrc: u32, payload_len: u64) -> Bytes {
    let mut out: Bytes = list.with_capacity(12 + payload_len)
    let w = rtp.ext.writer()
    let _ = result.unwrap(rtp.header.write(rtp.header.Fields(marker: true, pt: cascade.canon_pt(codec), seq: seq, ts: ts, ssrc: ssrc), view w, mut out))
    list.fill(mut out, payload_len, 0x90u8)
    take out
}

fn k_room_limits() -> router.RoomLimits {
    router.RoomLimits(participants: 64, ids: 64, publications: 4, down_tracks: 64, audio_forward: 0, pause_delay_ms: 5000, pause: false)
}

// ---- Shared KNode harness: real `router.Router` (Unit 0) + `cascade.CascadeAdapter` (Unit 1) ----
// Subscribers placed on Unit 2 are tracked solely through `obs2: router.Observer` (unit 2) so
// every control change (`Subscribe`, `Unsubscribe`, `Revoke`, `Close`) and every media/SR
// fan-out flows through `router.Router` with zero parallel routing tables.
type KDelivered {
    room: peer.RoomId,
    subscriber: u64,
    pub_id: router.PublicationId,
    owner: peer.Gen,
    encoding: u8,
    seq: u16,
    ts: u32
}

type KNode {
    r: router.Router,
    a: cascade.CascadeAdapter,
    obs2: router.Observer,
    out: peer.Outbox,
    empty: Shared[Bytes],
    seqs: List[(peer.RoomId, u64)],
    delivered: List[KDelivered],
    sr_seen: List[(peer.RoomId, router.PublicationId, u32, rtp.rtcp.SenderInfo)],
    keys_seen: List[(peer.RoomId, router.PublicationId, u8, rtp.loss.Why)]
}

fn new_knode(seed: u64, nid: cascade.NodeId, lim: cascade.LinkLimits) -> KNode {
    let empty: Bytes = list.new()
    KNode(r: router.on_unit(provide.random(seed), 0), a: cascade.cascade_adapter(1, nid, lim), obs2: router.new_observer(2), out: result.unwrap(peer.outbox(262144, 256)), empty: shared.new(take empty), seqs: list.new(), delivered: list.new(), sr_seen: list.new(), keys_seen: list.new())
}

fn knode_next_seq(mut n: KNode, room: peer.RoomId) -> u64 {
    for i in 0u64 .. list.len(n.seqs) {
        if n.seqs[i].0 == room {
            let s = n.seqs[i].1 + 1
            n.seqs[i] = (room, s)
            return s
        }
    }
    list.push(mut n.seqs, (room, 1))
    1
}

fn knode_apply(mut n: KNode, mut hub: cascade.LinkHub, now_ns: u64, c: router.Change) -> Result[router.Answer, router.RouterError] {
    let ans = router.apply(mut n.r, now_ns, c, mut n.out)?
    let resolved: router.Change = match c {
        PublishRemote(room: room, who: who, section: sec, id: _, shape: sh, via: via) => match ans {
            Shaped(id: assigned, shape: _) => PublishRemote(room: room, who: who, section: sec, id: assigned, shape: sh, via: via),
            _ => c,
        },
        Publish(room: room, who: who, section: sec, id: id, shape: _) => match ans {
            Shaped(id: assigned, shape: sh) => Publish(room: room, who: who, section: sec, id: assigned, shape: Some(sh)),
            _ => c,
        },
        other => other,
    }
    let room = router.change_room(resolved)
    let seq = knode_next_seq(mut n, room)
    let _ = cascade.control(mut n.a, mut hub, now_ns, Order(room: room, seq: seq, change: resolved))
    let _ = router.observer_apply(mut n.obs2, room, seq, resolved)
    Ok(ans)
}

fn knode_sync_unit2_wants(mut n: KNode, room: peer.RoomId, pub_id: router.PublicationId, now_ns: u64) {
    let Some(info) = router.observer_publication(n.obs2, room, pub_id) else {
        return
    }
    let mut mask = 0u8
    for d in router.observer_downs(n.obs2, room) {
        if d.publication == pub_id {
            if let Layer(encoding: e, ..) = d.target {
                let bit: u8 = int.narrow(1u64 << int.widen(e))
                mask = mask | bit
            }
        }
    }
    let carried = router.Carried(carry: Wanted(room: room, publication: pub_id, src: info.owner, unit: 2, mask: mask), packet: shared.share(n.empty))
    let _ = router.accept(mut n.r, now_ns, take carried, mut n.out)
}

fn knode_open_room(mut n: KNode, mut hub: cascade.LinkHub, room: peer.RoomId, lim: router.RoomLimits, now_ns: u64) {
    let _ = result.unwrap(knode_apply(mut n, mut hub, now_ns, Open(room: room, limits: lim)))
}

fn knode_publish_synthetic(mut n: KNode, mut hub: cascade.LinkHub, room: peer.RoomId, who: peer.Gen, section: u8, id: router.PublicationId, codec: sdp.Codec, encodings: u8, now_ns: u64) -> router.PublicationId {
    let _ = knode_apply(mut n, mut hub, now_ns, Admit(who: peer.Participant(gen: who, room: room), home: 2))
    let shape = router.Shape(codec: codec, pli: true, fir: true, encodings: encodings)
    let ans = result.unwrap(knode_apply(mut n, mut hub, now_ns, PublishRemote(room: room, who: who, section: section, id: id, shape: shape, via: 3)))
    match ans {
        Shaped(id: assigned, shape: _) => assigned,
        _ => id,
    }
}

fn knode_subscribe(mut n: KNode, mut hub: cascade.LinkHub, room: peer.RoomId, sub_id: u64, pub_id: router.PublicationId, encoding: u8, now_ns: u64) {
    let sub: peer.Gen = Gen(id: sub_id, epoch: 1)
    let _ = knode_apply(mut n, mut hub, now_ns, Admit(who: peer.Participant(gen: sub, room: room), home: 2))
    let target: router.Target = Layer(encoding: encoding, spatial: 0, temporal: 0)
    let _ = knode_apply(mut n, mut hub, now_ns, Subscribe(room: room, who: sub, p: pub_id, section: 0, target: target))
    knode_sync_unit2_wants(mut n, room, pub_id, now_ns)
}

fn knode_unsubscribe(mut n: KNode, mut hub: cascade.LinkHub, room: peer.RoomId, sub_id: u64, pub_id: router.PublicationId, now_ns: u64) {
    let sub: peer.Gen = Gen(id: sub_id, epoch: 1)
    let _ = knode_apply(mut n, mut hub, now_ns, Unsubscribe(room: room, who: sub, p: pub_id))
    knode_sync_unit2_wants(mut n, room, pub_id, now_ns)
}

fn knode_inject_media(mut n: KNode, mut hub: cascade.LinkHub, room: peer.RoomId, pub_id: router.PublicationId, owner: peer.Gen, encoding: u8, take pkt: Bytes, now_ns: u64) {
    let _ = router.inject_remote_media(mut n.r, now_ns, room, pub_id, owner, encoding, cascade.canon_slice(take pkt), mut n.out)
    knode_pump(mut n, mut hub, now_ns)
}

fn knode_inject_sr(mut n: KNode, mut hub: cascade.LinkHub, room: peer.RoomId, pub_id: router.PublicationId, owner: peer.Gen, encoding: u8, sr: cascade.SrTiming, now_ns: u64) {
    let hi_w: u64 = int.widen(sr.ntp_hi)
    let lo_w: u64 = int.widen(sr.ntp_lo)
    let ntp: u64 = (hi_w << 32u64) | lo_w
    let info = rtp.rtcp.SenderInfo(ssrc: 0, ntp: ntp, rtp: sr.rtp_ts, packets: sr.packets, octets: sr.octets)
    let _ = router.inject_remote_sr(mut n.r, now_ns, room, pub_id, owner, encoding, info)
    knode_pump(mut n, mut hub, now_ns)
}

fn knode_pump(mut n: KNode, mut hub: cascade.LinkHub, now_ns: u64) {
    for _ in 0u64 .. 16 {
        let mut progressed = false
        let changes = cascade.take_changes(mut n.a)
        if list.len(changes) != 0 {
            progressed = true
            for c in changes {
                let _ = knode_apply(mut n, mut hub, now_ns, c)
            }
        }
        let posts_a = cascade.take_posts(mut n.a)
        if list.len(posts_a) != 0 {
            progressed = true
            for take p in take posts_a {
                let router.Post(to: to, carried: take carried) = take p
                if to == 0 {
                    let _ = router.accept(mut n.r, now_ns, take carried, mut n.out)
                }
            }
        }
        let posts_r = router.take_posts(mut n.r)
        if list.len(posts_r) != 0 {
            progressed = true
            for take p in take posts_r {
                let router.Post(to: to, carried: take carried) = take p
                if to == 1 {
                    cascade.carried(mut n.a, mut hub, now_ns, take carried)
                } else if to == 2 {
                    let router.Carried(carry: take carry, packet: _) = take carried
                    match take carry {
                        Media(room: room, publication: pub_id, src: src, m: m, ..) => {
                            let seq: u16 = int.truncate(m.index)
                            for d in router.observer_downs(n.obs2, room) {
                                if d.publication == pub_id {
                                    if let Layer(encoding: e, ..) = d.target {
                                        if e == m.encoding {
                                            let Gen(id: sid, epoch: _) = d.sub
                                            list.push(mut n.delivered, KDelivered(room: room, subscriber: sid, pub_id: pub_id, owner: src, encoding: m.encoding, seq: seq, ts: m.ts))
                                        }
                                    }
                                }
                            }
                        },
                        Sender(room: room, publication: pub_id, owner: _, source: src, info: info) => {
                            list.push(mut n.sr_seen, (room, pub_id, src, info))
                        },
                        Key(room: room, publication: pub_id, encoding: enc, why: why) => {
                            list.push(mut n.keys_seen, (room, pub_id, enc, why))
                        },
                        _ => (),
                    }
                }
            }
        }
        if !progressed {
            break
        }
    }
}

fn knode_step(mut n: KNode, mut hub: cascade.LinkHub, take events: List[cascade.LinkEvent], now_ns: u64) {
    cascade.handle_events(mut n.a, mut hub, take events, now_ns / MS)
    let _ = router.poll(mut n.r, now_ns, mut n.out)
    knode_pump(mut n, mut hub, now_ns)
}

fn knode_take_delivered(mut n: KNode) -> List[KDelivered] {
    replace(mut n.delivered, list.new())
}

// ---- K3: one_copy_per_layer_per_node ----
type K3HomeCfg: send {
    clock: Clock,
    socket: UdpSocket,
    node_id: cascade.NodeId,
    key: Secret,
    cert: Bytes,
    pins: List[cascade.PeerPins]
}

type K3EdgeACfg: send {
    clock: Clock,
    socket: UdpSocket,
    node_id: cascade.NodeId,
    key: Secret,
    cert: Bytes,
    home_id: cascade.NodeId,
    home_addr: Addr,
    home_pin: quic.handshake.Pin
}

type K3EdgeBCfg: send {
    clock: Clock,
    socket: UdpSocket,
    node_id: cascade.NodeId,
    key: Secret,
    cert: Bytes,
    home_id: cascade.NodeId,
    home_addr: Addr,
    home_pin: quic.handshake.Pin
}

type K3HomeStats: send {
    fwd_enc0: u64,
    fwd_enc1: u64,
    fwd_enc2: u64,
    fwd_total: u64,
    reflected_to_b: u64,
    home_local_delivered: u64
}

type K3EdgeAStats: send {
    sub_low_total: u64,
    sub_mid_total: u64,
    sub_high_total: u64,
    pub2_total: u64,
    sr_matched: bool
}

type K3EdgeBStats: send {
    admitted_id: u64,
    sent_enc0: u64,
    sent_enc1: u64,
    sent_enc2: u64,
    sent_total: u64,
    paused_after_delay: bool
}

fn k3_home_task(take cfg: K3HomeCfg) -> K3HomeStats waits {
    let K3HomeCfg(clock: clock, socket: take given, node_id: nid, key: take k, cert: take c, pins: take pins) = take cfg
    let mut sock = take given
    let lim = cascade.default_link_limits()
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(3001), lim, rebuild_id(take k, take c), take pins, 8))
    let mut n = new_knode(3011, nid, lim)
    let mut rlim = k_room_limits()
    rlim.pause_delay_ms = 200
    knode_open_room(mut n, mut hub, K_ROOM, rlim, 0)
    result.unwrap(cascade.open_home_room(mut n.a, K_ROOM, b"room-k3", 1, rlim))
    let b_id = cascade.node_id(b"edge-b-k3")
    let pub1_key = cascade.PubKey(participant: 1, epoch: 1, pub_slot: 1)
    let mut home_subbed = false
    let mut home_unsubbed = false
    let mut stats = K3HomeStats(fwd_enc0: 0, fwd_enc1: 0, fwd_enc2: 0, fwd_total: 0, reflected_to_b: 0, home_local_delivered: 0)
    let mut events: List[cascade.LinkEvent] = list.new()
    let end = 2500 * MS
    while host.mono_ns(clock) < end {
        let now = host.mono_ns(clock)
        result.unwrap(cascade.drive_links(mut hub, clock, mut sock, order.min(now + 10 * MS, end), mut events))
        let cur = host.mono_ns(clock)
        knode_step(mut n, mut hub, take events, cur)
        events = list.new()
        // Review S5 K3 lifecycle: add a local Home subscriber after Edge A already pulled enc 0,
        // then remove it after Edge A drops enc 0 to observe pause_delay_ms turn-off.
        if !home_subbed && cur >= 800 * MS {
            if let Some(pid) = cascade.remote_pub_id(n.a, b"room-k3", pub1_key) {
                knode_subscribe(mut n, mut hub, K_ROOM, 60, pid, 0, cur)
                knode_pump(mut n, mut hub, cur)
                home_subbed = true
            }
        }
        if home_subbed && !home_unsubbed && cur >= 1500 * MS {
            if let Some(pid) = cascade.remote_pub_id(n.a, b"room-k3", pub1_key) {
                knode_unsubscribe(mut n, mut hub, K_ROOM, 60, pid, cur)
                knode_pump(mut n, mut hub, cur)
                home_unsubbed = true
            }
        }
        for d in knode_take_delivered(mut n) {
            if d.subscriber == 60 && d.encoding == 0 {
                stats.home_local_delivered += 1
            }
        }
        let hb_opt = cascade.find_link(hub, b_id)
        for f in cascade.take_forward_logs(mut n.a) {
            if hb_opt == Some(f.handle) {
                stats.reflected_to_b += 1
            }
            stats.fwd_total += 1
            if f.encoding == 0 {
                stats.fwd_enc0 += 1
            } else if f.encoding == 1 {
                stats.fwd_enc1 += 1
            } else if f.encoding == 2 {
                stats.fwd_enc2 += 1
            }
        }
    }
    stats
}

fn k3_edge_a_task(take cfg: K3EdgeACfg) -> K3EdgeAStats waits {
    let K3EdgeACfg(clock: clock, socket: take given, node_id: nid, key: take k, cert: take c, home_id: hid, home_addr: haddr, home_pin: hpin) = take cfg
    let mut sock = take given
    let lim = cascade.default_link_limits()
    let id1 = rebuild_id(secret.share(k), clone(c))
    let id2 = rebuild_id(take k, take c)
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(3002), lim, take id1, node_pins(hid, clone(hpin)), 4))
    let mut n = new_knode(3012, nid, lim)
    let mut rlim = k_room_limits()
    rlim.pause_delay_ms = 100
    knode_open_room(mut n, mut hub, K_ROOM, rlim, 0)
    let h_home = result.unwrap(cascade.dial_addr(mut hub, hid, haddr, single_pin(hpin), 0, take id2))
    let mut attached = false
    let mut subscribed = false
    let mut unsubbed_low = false
    let pub1 = cascade.PubKey(participant: 1, epoch: 1, pub_slot: 1)
    let pub2 = cascade.PubKey(participant: 1, epoch: 1, pub_slot: 2)
    let mut stats = K3EdgeAStats(sub_low_total: 0, sub_mid_total: 0, sub_high_total: 0, pub2_total: 0, sr_matched: false)
    let mut events: List[cascade.LinkEvent] = list.new()
    let end = 2500 * MS
    while host.mono_ns(clock) < end {
        let now = host.mono_ns(clock)
        result.unwrap(cascade.drive_links(mut hub, clock, mut sock, order.min(now + 10 * MS, end), mut events))
        let mut got_up = false
        for ev in events {
            if let LinkUp(handle: h, ..) = ev {
                if h == h_home {
                    got_up = true
                }
            }
        }
        let cur = host.mono_ns(clock)
        knode_step(mut n, mut hub, take events, cur)
        events = list.new()
        if got_up && !attached {
            let _ = result.unwrap(cascade.attach_edge_room(mut n.a, mut hub, K_ROOM, b"room-k3", h_home, 1, rlim))
            knode_pump(mut n, mut hub, cur)
            attached = true
        }
        if attached && !subscribed {
            if let Some(pid1) = cascade.remote_pub_id(n.a, b"room-k3", pub1) {
                // 50 local subscribers wanting low (encoding 0) and 1 wanting high (encoding 2).
                for s in 10u64 .. 60u64 {
                    knode_subscribe(mut n, mut hub, K_ROOM, s, pid1, 0, cur)
                }
                knode_subscribe(mut n, mut hub, K_ROOM, 61, pid1, 2, cur)
                knode_pump(mut n, mut hub, cur)
                subscribed = true
            }
        }
        // After the 10-packet burst finishes (1200 ms), Edge A drops all its enc 0 and enc 2 subs;
        // Home's local sub (1500 ms) keeps enc 0 alive until 1500 ms + pause_delay_ms!
        if subscribed && !unsubbed_low && cur >= 1200 * MS {
            if let Some(pid1) = cascade.remote_pub_id(n.a, b"room-k3", pub1) {
                for s in 10u64 .. 60u64 {
                    knode_unsubscribe(mut n, mut hub, K_ROOM, s, pid1, cur)
                }
                knode_unsubscribe(mut n, mut hub, K_ROOM, 61, pid1, cur)
                knode_pump(mut n, mut hub, cur)
                unsubbed_low = true
            }
        }
        let pid2_opt = cascade.remote_pub_id(n.a, b"room-k3", pub2)
        for d in knode_take_delivered(mut n) {
            if pid2_opt == Some(d.pub_id) {
                stats.pub2_total += 1
            } else if d.encoding == 0 {
                stats.sub_low_total += 1
            } else if d.encoding == 1 {
                stats.sub_mid_total += 1
            } else if d.encoding == 2 {
                stats.sub_high_total += 1
            }
        }
        if let Some(sr) = cascade.remote_sr(n.a, b"room-k3", pub1, 0) {
            if sr.ntp_hi == 0x11223344 && sr.rtp_ts == 90000 {
                stats.sr_matched = true
            }
        }
    }
    stats
}

fn k3_edge_b_task(take cfg: K3EdgeBCfg) -> K3EdgeBStats waits {
    let K3EdgeBCfg(clock: clock, socket: take given, node_id: nid, key: take k, cert: take c, home_id: hid, home_addr: haddr, home_pin: hpin) = take cfg
    let mut sock = take given
    let lim = cascade.default_link_limits()
    let id1 = rebuild_id(secret.share(k), clone(c))
    let id2 = rebuild_id(take k, take c)
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(3003), lim, take id1, node_pins(hid, clone(hpin)), 4))
    let mut n = new_knode(3013, nid, lim)
    let mut rlim = k_room_limits()
    rlim.pause_delay_ms = 100
    knode_open_room(mut n, mut hub, K_ROOM, rlim, 0)
    let h_home = result.unwrap(cascade.dial_addr(mut hub, hid, haddr, single_pin(hpin), 0, take id2))
    let mut attached = false
    let mut admit_asked = false
    let mut published_ok = false
    let mut pub1_id: router.PublicationId = PublicationId(0)
    let mut pub2_id: router.PublicationId = PublicationId(0)
    let mut sent_count = 0u16
    let mut next_send_ns = 700 * MS
    let mut stats = K3EdgeBStats(admitted_id: 0, sent_enc0: 0, sent_enc1: 0, sent_enc2: 0, sent_total: 0, paused_after_delay: false)
    let mut events: List[cascade.LinkEvent] = list.new()
    let end = 2500 * MS
    while host.mono_ns(clock) < end {
        let now = host.mono_ns(clock)
        result.unwrap(cascade.drive_links(mut hub, clock, mut sock, order.min(now + 10 * MS, end), mut events))
        let mut got_up = false
        for ev in events {
            if let LinkUp(handle: h, ..) = ev {
                if h == h_home {
                    got_up = true
                }
            }
        }
        let cur = host.mono_ns(clock)
        knode_step(mut n, mut hub, take events, cur)
        events = list.new()
        if got_up && !attached {
            let _ = result.unwrap(cascade.attach_edge_room(mut n.a, mut hub, K_ROOM, b"room-k3", h_home, 1, rlim))
            knode_pump(mut n, mut hub, cur)
            attached = true
        }
        if attached && !admit_asked && cur >= 150 * MS {
            result.unwrap(cascade.request_edge_admit(mut n.a, mut hub, b"room-k3", 77, 0))
            admit_asked = true
        }
        for adm in cascade.take_admitted(mut n.a) {
            if adm.req_id == 77 && adm.ok {
                stats.admitted_id = adm.participant
                if !published_ok {
                    let who: peer.Gen = Gen(id: adm.participant, epoch: adm.epoch)
                    pub1_id = knode_publish_synthetic(mut n, mut hub, K_ROOM, who, 0, PublicationId(1), Vp8, 3, cur)
                    pub2_id = knode_publish_synthetic(mut n, mut hub, K_ROOM, who, 1, PublicationId(2), Vp8, 1, cur)
                    knode_pump(mut n, mut hub, cur)
                    published_ok = true
                }
            }
        }
        if published_ok && sent_count < 10 && cur >= next_send_ns {
            let who: peer.Gen = Gen(id: stats.admitted_id, epoch: 1)
            let sc_u32: u32 = int.widen(sent_count)
            let ts: u32 = 90000u32 + sc_u32 * 3000u32
            if sent_count == 0 {
                knode_inject_sr(mut n, mut hub, K_ROOM, pub1_id, who, 0, cascade.SrTiming(ntp_hi: 0x11223344, ntp_lo: 0x55667788, rtp_ts: 90000, packets: 1, octets: 200), cur)
            }
            for enc in 0u8 .. 3u8 {
                let enc_u32: u32 = int.widen(enc)
                let pkt = make_canon_rtp(Vp8, sent_count + 1, ts, 0x100u32 + enc_u32, 120)
                knode_inject_media(mut n, mut hub, K_ROOM, pub1_id, who, enc, take pkt, cur)
            }
            // Second publisher: nobody subscribed to it anywhere.
            let pkt2 = make_canon_rtp(Vp8, sent_count + 1, ts, 0x200, 120)
            knode_inject_media(mut n, mut hub, K_ROOM, pub2_id, who, 0, take pkt2, cur)
            sent_count += 1
            next_send_ns = cur + 20 * MS
        }
        // After Home's local sub leaves at 1500 ms + pause_delay_ms (200 ms) + Edge B pause_delay_ms (100 ms),
        // confirm Edge B's router published_mask for pub1 dropped back to 0!
        if published_ok && cur >= 2200 * MS {
            if router.published_mask(n.r, K_ROOM, pub1_id) == Some(0) {
                stats.paused_after_delay = true
            }
        }
        for f in cascade.take_forward_logs(mut n.a) {
            stats.sent_total += 1
            if f.encoding == 0 {
                stats.sent_enc0 += 1
            } else if f.encoding == 1 {
                stats.sent_enc1 += 1
            } else if f.encoding == 2 {
                stats.sent_enc2 += 1
            }
        }
    }
    stats
}

/// bug: an edge sends duplicate copies per subscriber across a link, forwards layers
/// outside the union wanted mask (such as the middle simulcast layer or an unsubscribed
/// publisher), reflects packets back to the source edge, fails to keep remote demand
/// alive while local demand holds or pause after `pause_delay_ms`, fails to assign
/// canonical participant IDs at home, or drops RTCP SRs.
/// oracle: docs/spec/sfu_cascade.md K3 and CAS-3, driven through real `router.Router`
/// + `cascade.CascadeAdapter`.
@test
fn one_copy_per_layer_per_node(tasks: Tasks) -> Result[(), ()] waits {
    let script = std.sim.world.Script(tail_seed: 303, streams: list.new())
    let mut config = std.sim.udp.defaults()
    config.delay_ns = 5 * MS
    let (take sim_world, clock) = std.sim.world.new(303, 0, 0)
    let (vnet, take net_task) = std.sim.udp.start(tasks, config, std.sim.world.plan_from(script, 0), take sim_world, clock, list.new(), 2097152)
    let mut dir = cascade.sim_directory(clock, cascade.DEFAULT_DRIFT_PPM)
    let (take hk, take hc) = result.unwrap(signal.unit_certificate(provide.random(311), clock))
    let home_pin: quic.handshake.Pin = Cert(std.sha256.hash(hc))
    let (take ak, take ac) = result.unwrap(signal.unit_certificate(provide.random(312), clock))
    let a_pin: quic.handshake.Pin = Cert(std.sha256.hash(ac))
    let (take bk, take bc) = result.unwrap(signal.unit_certificate(provide.random(313), clock))
    let b_pin: quic.handshake.Pin = Cert(std.sha256.hash(bc))
    let home_id = cascade.node_id(b"home-k3")
    let a_id = cascade.node_id(b"edge-a-k3")
    let b_id = cascade.node_id(b"edge-b-k3")
    cascade.register_node(mut dir, home_id, K3_HOME_ADDR, single_pin(clone(home_pin)))
    cascade.register_node(mut dir, a_id, K3_EDGE_A_ADDR, single_pin(take a_pin))
    cascade.register_node(mut dir, b_id, K3_EDGE_B_ADDR, single_pin(take b_pin))
    let _ = result.unwrap(cascade.claim(mut dir, b"room-k3", home_id, 0))
    let (take s_home, _) = result.unwrap(host.udp_bind(vnet, K3_HOME_ADDR, K_SOCKET))
    let (take s_a, _) = result.unwrap(host.udp_bind(vnet, K3_EDGE_A_ADDR, K_SOCKET))
    let (take s_b, _) = result.unwrap(host.udp_bind(vnet, K3_EDGE_B_ADDR, K_SOCKET))
    let pins = cascade.peer_pins(dir)
    let t_home = task.spawn(tasks, bytes 16777216, K3HomeCfg(clock: clock, socket: take s_home, node_id: home_id, key: take hk, cert: take hc, pins: take pins), k3_home_task)
    let t_a = task.spawn(tasks, bytes 16777216, K3EdgeACfg(clock: clock, socket: take s_a, node_id: a_id, key: take ak, cert: take ac, home_id: home_id, home_addr: K3_HOME_ADDR, home_pin: clone(home_pin)), k3_edge_a_task)
    let t_b = task.spawn(tasks, bytes 16777216, K3EdgeBCfg(clock: clock, socket: take s_b, node_id: b_id, key: take bk, cert: take bc, home_id: home_id, home_addr: K3_HOME_ADDR, home_pin: take home_pin), k3_edge_b_task)
    let h_s = result.unwrap(task.join(take t_home))
    let a_s = result.unwrap(task.join(take t_a))
    let b_s = result.unwrap(task.join(take t_b))
    result.unwrap(task.join(take net_task))
    if b_s.admitted_id != 1 {
        fail("home did not assign canonical participant id 1 to edge B publisher")
    }
    if b_s.sent_enc0 != 10 || b_s.sent_enc1 != 0 || b_s.sent_enc2 != 10 || b_s.sent_total != 20 {
        fail("edge B->home did not send exactly 1 copy of low and high (and 0 mid / pub2)")
    }
    if h_s.fwd_enc0 != 10 || h_s.fwd_enc1 != 0 || h_s.fwd_enc2 != 10 || h_s.fwd_total != 20 {
        fail("home->edge A did not forward exactly 1 copy of low and high (and 0 mid / pub2)")
    }
    if h_s.reflected_to_b != 0 {
        fail("home reflected remote packets back to source edge B")
    }
    if h_s.home_local_delivered == 0 {
        fail("home local subscriber did not receive edge B's remote publication via router.inject_remote_media")
    }
    if !b_s.paused_after_delay {
        fail("edge B did not pause publication after last subscriber departed and pause_delay_ms elapsed")
    }
    if a_s.sub_low_total != 500 || a_s.sub_mid_total != 0 || a_s.sub_high_total != 10 || a_s.pub2_total != 0 {
        fail("edge A local router fanout did not deliver 50x10 low, 1x10 high, 0 mid, 0 pub2")
    }
    if !a_s.sr_matched {
        fail("forwarded RTCP SR timing did not reach edge A")
    }
    Ok(())
}

// ---- K7: congested_link_costs_its_rooms ----
// Real 1 Mbit/s (125,000 B/s) token-bucket shaper over sim.udp between Home and Edge A.
type ShaperCfg: send {
    clock: Clock,
    sock_home: UdpSocket,
    sock_edge: UdpSocket,
    home_addr: Addr,
    edge_addr: Addr,
    bps: u64,
    burst: u64,
    end_ns: u64
}

fn shaper_task(take cfg: ShaperCfg) -> u64 waits {
    let ShaperCfg(clock: clock, sock_home: take sh, sock_edge: take se, home_addr: haddr, edge_addr: eaddr, bps: bps, burst: burst, end_ns: end_ns) = take cfg
    let mut s_home = take sh
    let mut s_edge = take se
    let mut tokens = burst
    let mut last_ns = host.mono_ns(clock)
    let mut shaped_drops = 0u64
    let mut buf: Bytes = list.with_capacity(65536)
    let mut pkts: List[UdpPacket] = list.with_capacity(64)
    let mut tx: List[UdpTx] = list.with_capacity(64)
    while host.mono_ns(clock) < end_ns {
        let now = host.mono_ns(clock)
        let dt = now - last_ns
        if dt > 0 {
            let add = (dt * (bps / 8)) / (1000 * MS)
            tokens = order.min(burst, tokens + add)
            last_ns = now
        }
        // Forward Home -> Edge A subject to 1 Mbit/s token bucket.
        list.clear(mut buf)
        list.clear(mut pkts)
        if let Ok(n) = host.udp_recv(mut s_home, mut buf, mut pkts, At(clock, order.min(now + 2 * MS, end_ns))) {
            list.clear(mut tx)
            for i in 0u64 .. n {
                let UdpPacket(at: at, len: len, ..) = pkts[i]
                if len <= tokens {
                    tokens -= len
                    list.push(mut tx, UdpTx(to: eaddr, at: at, len: len, ecn: 0))
                } else {
                    shaped_drops += 1
                }
            }
            if list.len(tx) > 0 {
                let _ = host.udp_send(mut s_edge, buf, tx, Never)
            }
        }
        // Forward Edge A -> Home (ACKs / control) without shaping.
        list.clear(mut buf)
        list.clear(mut pkts)
        if let Ok(n) = host.udp_recv(mut s_edge, mut buf, mut pkts, At(clock, order.min(host.mono_ns(clock) + 1 * MS, end_ns))) {
            list.clear(mut tx)
            for i in 0u64 .. n {
                let UdpPacket(at: at, len: len, ..) = pkts[i]
                list.push(mut tx, UdpTx(to: haddr, at: at, len: len, ecn: 0))
            }
            if list.len(tx) > 0 {
                let _ = host.udp_send(mut s_home, buf, tx, Never)
            }
        }
    }
    shaped_drops
}

type K7HomeStats: send {
    shaped_max_enc: u8,
    shaped_shed: u64,
    ceil1_allowed_e0: u64,
    ceil1_allowed_e1: u64,
    ceil1_sent_e2: u64,
    clean_max_enc: u8,
    clean_shed: u64,
    clean_enc0: u64,
    clean_enc1: u64,
    clean_enc2: u64
}

type K7EdgeStats: send {
    enc0: u64,
    enc1: u64,
    enc2: u64
}

fn k7_home_task(take cfg: K3HomeCfg) -> K7HomeStats waits {
    let K3HomeCfg(clock: clock, socket: take given, node_id: nid, key: take k, cert: take c, pins: take pins) = take cfg
    let mut sock = take given
    let mut lim = cascade.default_link_limits()
    lim.link_bytes = 262144
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(7001), lim, rebuild_id(take k, take c), take pins, 8))
    let mut n = new_knode(7011, nid, lim)
    let r_shaped: peer.RoomId = RoomId(1)
    let r_clean: peer.RoomId = RoomId(2)
    knode_open_room(mut n, mut hub, r_shaped, k_room_limits(), 0)
    knode_open_room(mut n, mut hub, r_clean, k_room_limits(), 0)
    result.unwrap(cascade.open_home_room(mut n.a, r_shaped, b"room-shaped", 1, k_room_limits()))
    result.unwrap(cascade.open_home_room(mut n.a, r_clean, b"room-clean", 1, k_room_limits()))
    let owner: peer.Gen = Gen(id: 1, epoch: 1)
    let p_shaped = knode_publish_synthetic(mut n, mut hub, r_shaped, owner, 0, PublicationId(1), Vp8, 3, 0)
    let p_clean = knode_publish_synthetic(mut n, mut hub, r_clean, owner, 0, PublicationId(1), Vp8, 3, 0)
    knode_pump(mut n, mut hub, 0)
    let a_id = cascade.node_id(b"edge-a-k7")
    let b_id = cascade.node_id(b"edge-b-k7")
    let mut seq = 1u16
    let mut next_send = 600 * MS
    let mut clean_e0 = 0u64
    let mut clean_e1 = 0u64
    let mut clean_e2 = 0u64
    let mut ceil1_e0 = 0u64
    let mut ceil1_e1 = 0u64
    let mut ceil1_e2 = 0u64
    let mut events: List[cascade.LinkEvent] = list.new()
    let end = 3600 * MS
    while host.mono_ns(clock) < end {
        let now = host.mono_ns(clock)
        result.unwrap(cascade.drive_links(mut hub, clock, mut sock, order.min(now + 5 * MS, end), mut events))
        let cur = host.mono_ns(clock)
        knode_step(mut n, mut hub, take events, cur)
        events = list.new()
        let ha_opt = cascade.find_link(hub, a_id)
        let a_ceil_before = match ha_opt {
            Some(ha) => cascade.link_max_encoding(n.a, ha),
            None => cascade.MAX_ENC_INDEX,
        }
        if cur >= next_send && cur < 3200 * MS {
            // 3 layers x 1,150 bytes every 15 ms = ~1.84 Mbit/s (> 1 Mbit/s shaped link!).
            let seq_u32: u32 = int.widen(seq)
            let ts: u32 = seq_u32 * 1500u32
            for enc in 0u8 .. 3u8 {
                let enc_u32: u32 = int.widen(enc)
                let pkt = make_canon_rtp(Vp8, seq, ts, 0x700u32 + enc_u32, 1138)
                knode_inject_media(mut n, mut hub, r_shaped, p_shaped, owner, enc, clone(pkt), cur)
                knode_inject_media(mut n, mut hub, r_clean, p_clean, owner, enc, take pkt, cur)
            }
            seq += 1
            next_send = cur + 15 * MS
        }
        let hb_opt = cascade.find_link(hub, b_id)
        for f in cascade.take_forward_logs(mut n.a) {
            if ha_opt == Some(f.handle) && a_ceil_before == 1 {
                if f.encoding == 0 {
                    ceil1_e0 += 1
                } else if f.encoding == 1 {
                    ceil1_e1 += 1
                } else if f.encoding == 2 {
                    ceil1_e2 += 1
                }
            }
            if hb_opt == Some(f.handle) {
                if f.encoding == 0 {
                    clean_e0 += 1
                } else if f.encoding == 1 {
                    clean_e1 += 1
                } else if f.encoding == 2 {
                    clean_e2 += 1
                }
            }
        }
    }
    let ha = option.unwrap(cascade.find_link(hub, a_id))
    let hb = option.unwrap(cascade.find_link(hub, b_id))
    K7HomeStats(shaped_max_enc: cascade.link_max_encoding(n.a, ha), shaped_shed: cascade.link_shed_packets(n.a, ha), ceil1_allowed_e0: ceil1_e0, ceil1_allowed_e1: ceil1_e1, ceil1_sent_e2: ceil1_e2, clean_max_enc: cascade.link_max_encoding(n.a, hb), clean_shed: cascade.link_shed_packets(n.a, hb), clean_enc0: clean_e0, clean_enc1: clean_e1, clean_enc2: clean_e2)
}

type K7EdgeCfg: send {
    clock: Clock,
    socket: UdpSocket,
    node_id: cascade.NodeId,
    key: Secret,
    cert: Bytes,
    home_id: cascade.NodeId,
    dial_addr: Addr,
    home_pin: quic.handshake.Pin,
    room_name: Bytes,
    seed: u64
}

fn k7_edge_task(take cfg: K7EdgeCfg) -> K7EdgeStats waits {
    let K7EdgeCfg(clock: clock, socket: take given, node_id: nid, key: take k, cert: take c, home_id: hid, dial_addr: daddr, home_pin: hpin, room_name: rname, seed: seed) = take cfg
    let mut sock = take given
    let lim = cascade.default_link_limits()
    let id1 = rebuild_id(secret.share(k), clone(c))
    let id2 = rebuild_id(take k, take c)
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(seed), lim, take id1, node_pins(hid, clone(hpin)), 4))
    let mut n = new_knode(seed + 10, nid, lim)
    knode_open_room(mut n, mut hub, K_ROOM, k_room_limits(), 0)
    let h_home = result.unwrap(cascade.dial_addr(mut hub, hid, daddr, single_pin(hpin), 0, take id2))
    let mut attached = false
    let mut subbed = false
    let pub1 = cascade.PubKey(participant: 1, epoch: 1, pub_slot: 1)
    let mut stats = K7EdgeStats(enc0: 0, enc1: 0, enc2: 0)
    let mut events: List[cascade.LinkEvent] = list.new()
    let end = 3600 * MS
    while host.mono_ns(clock) < end {
        let now = host.mono_ns(clock)
        result.unwrap(cascade.drive_links(mut hub, clock, mut sock, order.min(now + 10 * MS, end), mut events))
        let mut got_up = false
        for ev in events {
            if let LinkUp(handle: h, ..) = ev {
                if h == h_home {
                    got_up = true
                }
            }
        }
        let cur = host.mono_ns(clock)
        knode_step(mut n, mut hub, take events, cur)
        events = list.new()
        if got_up && !attached {
            let _ = result.unwrap(cascade.attach_edge_room(mut n.a, mut hub, K_ROOM, clone(rname), h_home, 1, k_room_limits()))
            knode_pump(mut n, mut hub, cur)
            attached = true
        }
        if attached && !subbed {
            if let Some(pid1) = cascade.remote_pub_id(n.a, rname, pub1) {
                knode_subscribe(mut n, mut hub, K_ROOM, 10, pid1, 0, cur)
                knode_subscribe(mut n, mut hub, K_ROOM, 11, pid1, 1, cur)
                knode_subscribe(mut n, mut hub, K_ROOM, 12, pid1, 2, cur)
                knode_pump(mut n, mut hub, cur)
                subbed = true
            }
        }
        for d in knode_take_delivered(mut n) {
            if d.encoding == 0 {
                stats.enc0 += 1
            } else if d.encoding == 1 {
                stats.enc1 += 1
            } else if d.encoding == 2 {
                stats.enc2 += 1
            }
        }
    }
    stats
}

/// bug: congestion on one cascade link either fails to shed higher layers on that link,
/// miscomputes numeric ceiling 1 (blocking encoding 1 instead of allowing 0 and 1 while
/// shedding 2), or penalizes rooms carried on another uncongested link.
/// oracle: docs/spec/sfu_cascade.md K7 and CAS-3: with link A shaped to 1 Mbit/s and
/// link B unshaped, home lowers layers (`max_encoding < 2`, `shed > 0`) on link A while
/// ceiling 1 allows both encoding 0 and encoding 1 and sheds 2, and link B keeps
/// `max_encoding == 3`, `shed == 0`, and delivers every layer (0, 1, 2).
@test
fn congested_link_costs_its_rooms(tasks: Tasks) -> Result[(), ()] waits {
    let script = std.sim.world.Script(tail_seed: 707, streams: list.new())
    let mut config = std.sim.udp.defaults()
    config.delay_ns = 10 * MS
    let (take sim_world, clock) = std.sim.world.new(707, 0, 0)
    let (vnet, take net_task) = std.sim.udp.start(tasks, config, std.sim.world.plan_from(script, 0), take sim_world, clock, list.new(), 2097152)
    let mut dir = cascade.sim_directory(clock, cascade.DEFAULT_DRIFT_PPM)
    let (take hk, take hc) = result.unwrap(signal.unit_certificate(provide.random(711), clock))
    let home_pin: quic.handshake.Pin = Cert(std.sha256.hash(hc))
    let (take ak, take ac) = result.unwrap(signal.unit_certificate(provide.random(712), clock))
    let a_pin: quic.handshake.Pin = Cert(std.sha256.hash(ac))
    let (take bk, take bc) = result.unwrap(signal.unit_certificate(provide.random(713), clock))
    let b_pin: quic.handshake.Pin = Cert(std.sha256.hash(bc))
    let home_id = cascade.node_id(b"home-k7")
    let a_id = cascade.node_id(b"edge-a-k7")
    let b_id = cascade.node_id(b"edge-b-k7")
    cascade.register_node(mut dir, home_id, K7_HOME_ADDR, single_pin(clone(home_pin)))
    cascade.register_node(mut dir, a_id, K7_EDGE_A_ADDR, single_pin(take a_pin))
    cascade.register_node(mut dir, b_id, K7_EDGE_B_ADDR, single_pin(take b_pin))
    let (take s_home, _) = result.unwrap(host.udp_bind(vnet, K7_HOME_ADDR, K_SOCKET))
    let (take s_a, _) = result.unwrap(host.udp_bind(vnet, K7_EDGE_A_ADDR, K_SOCKET))
    let (take s_b, _) = result.unwrap(host.udp_bind(vnet, K7_EDGE_B_ADDR, K_SOCKET))
    let (take s_sh_h, _) = result.unwrap(host.udp_bind(vnet, K7_SHAPER_HOME_ADDR, K_SOCKET))
    let (take s_sh_e, _) = result.unwrap(host.udp_bind(vnet, K7_SHAPER_EDGE_ADDR, K_SOCKET))
    let pins = cascade.peer_pins(dir)
    let t_shaper = task.spawn(tasks, bytes 2097152, ShaperCfg(clock: clock, sock_home: take s_sh_h, sock_edge: take s_sh_e, home_addr: K7_HOME_ADDR, edge_addr: K7_EDGE_A_ADDR, bps: 1000000, burst: 8192, end_ns: 3600 * MS), shaper_task)
    let t_home = task.spawn(tasks, bytes 12582912, K3HomeCfg(clock: clock, socket: take s_home, node_id: home_id, key: take hk, cert: take hc, pins: take pins), k7_home_task)
    let t_a = task.spawn(tasks, bytes 12582912, K7EdgeCfg(clock: clock, socket: take s_a, node_id: a_id, key: take ak, cert: take ac, home_id: home_id, dial_addr: K7_SHAPER_EDGE_ADDR, home_pin: clone(home_pin), room_name: b"room-shaped", seed: 7002), k7_edge_task)
    let t_b = task.spawn(tasks, bytes 12582912, K7EdgeCfg(clock: clock, socket: take s_b, node_id: b_id, key: take bk, cert: take bc, home_id: home_id, dial_addr: K7_HOME_ADDR, home_pin: take home_pin, room_name: b"room-clean", seed: 7003), k7_edge_task)
    let shaped_drops = result.unwrap(task.join(take t_shaper))
    let hs = result.unwrap(task.join(take t_home))
    let ea = result.unwrap(task.join(take t_a))
    let eb = result.unwrap(task.join(take t_b))
    result.unwrap(task.join(take net_task))
    if shaped_drops == 0 {
        fail("the 1 Mbit/s shaper never experienced congestion")
    }
    if hs.shaped_max_enc >= 2 || hs.shaped_shed == 0 {
        fail("home did not lower layers on the 1 Mbit/s shaped link")
    }
    if hs.ceil1_sent_e2 != 0 || (hs.ceil1_allowed_e0 > 0 && hs.ceil1_allowed_e1 == 0) {
        fail("numeric ceiling 1 did not allow both encoding 0 and encoding 1 while shedding encoding 2")
    }
    if hs.clean_max_enc != cascade.MAX_ENC_INDEX || hs.clean_shed != 0 {
        fail("congestion on the shaped link spilled over to the unshaped link")
    }
    if eb.enc0 < 100 || eb.enc1 < 100 || eb.enc2 < 100 {
        fail("rooms on the unshaped link did not keep every layer")
    }
    if ea.enc0 == 0 {
        fail("the shaped link dropped even its base layer")
    }
    Ok(())
}

// ---- K8: attach_cost_is_exact ----
/// bug: attaching a room (either `alloc_room_budget` or a real `CascadeAdapter` + `LinkHub`
/// attach) allocates past `room_cost_cascade().cascade`, fails to charge/refund the exact
/// reservation on the cascade virtual door, or admits a room past `limits.rooms`.
/// oracle: docs/spec/sfu_cascade.md K8 and CAS-6, checked against the runtime MEM
/// ledger (`bound bytes cost.cascade`), `signal.Ledger` with `ledger_cascade`, and `limits.rooms`.
@test
fn attach_cost_is_exact() -> Result[(), ()] {
    let session = peer.PeerLimits(sections: 4, down_tracks: 4, rtx_bytes: 65536, pacer_packets: 16, start_bps: 300000, dtls_transport: peer.DTLS_DEFAULT, repair_profile: peer.DEFAULT_REPAIR)
    let mut link_lim = cascade.default_link_limits()
    link_lim.rooms = 2
    link_lim.layers = 8
    let small = router.RoomLimits(participants: 2, ids: 2, publications: 1, down_tracks: 2, audio_forward: 0, pause_delay_ms: 5000, pause: false)
    let wide = router.RoomLimits(participants: 16, ids: 16, publications: 2, down_tracks: 8, audio_forward: 0, pause_delay_ms: 5000, pause: false)
    let (_, clock) = std.sim.world.new(808, 0, 0)
    let (take hk, take hc) = result.unwrap(signal.unit_certificate(provide.random(811), clock))
    let nid = cascade.node_id(b"home-k8")
    let mut hub = result.unwrap(cascade.link_hub(nid, provide.random(812), link_lim, rebuild_id(take hk, take hc), list.new(), 4))
    let v_casc = option.unwrap(units.virtual_unit(1))
    for lim in[small, wide] {
        let cost = signal.room_cost_cascade(lim, session, link_lim)
        if cost.cascade == 0 {
            fail("room_cost_cascade returned zero cascade cost")
        }
        // 1. Preallocated room budget fits inside `bound bytes cost.cascade`.
        let checked = bound bytes cost.cascade {
            cascade.alloc_room_budget(lim, link_lim)
        }
        let Ok(Ok(take budget)) = checked else {
            fail("attached room allocation exceeded room_cost.cascade")
        }
        if cascade.budget_histories(budget) != cascade.room_layer_cap(lim, link_lim) {
            fail("attached room budget did not preallocate exact RTP-12 histories")
        }
        // 2. Real `CascadeAdapter` room open + lease enable + 1-hop history allocations fit inside `bound bytes cost.cascade`.
        let mut real_a = cascade.cascade_adapter(1, nid, link_lim)
        let _ = cascade.control(mut real_a, mut hub, 0, Order(room: RoomId(1), seq: 1, change: Open(room: RoomId(1), limits: lim)))
        let real_ok = bound bytes cost.cascade {
            let r = cascade.open_home_room(mut real_a, RoomId(1), b"room-real", 1, lim)
            if let Ok(()) = r {
                cascade.enable_leases(mut real_a, b"room-real", 10000, list.new())
                let key = cascade.PubKey(participant: 1, epoch: 1, pub_slot: 1)
                let pkt = cascade.canon_slice(make_canon_rtp(Vp8, 1, 90000, 0x1, 32))
                cascade.repair_record(mut real_a, 0, key, 0, 1, take pkt, 1000)
            }
            r
        }
        let Ok(Ok(())) = real_ok else {
            fail("real CascadeAdapter room attach + history exceeded room_cost.cascade")
        }
        // 3. Exact ledger reserve + detach refund on the cascade virtual unit (unit 1).
        let on0 = cost.replicated + cost.control + cost.per_session
        let projection = router.observer_room_bytes(lim)
        let mut free: List[u64] = list.with_capacity(1)
        list.push(mut free, on0)
        let mut l = signal.ledger(take free, 4, session)
        result.unwrap(signal.ledger_cascade(mut l, v_casc, projection + cost.cascade))
        let room: peer.RoomId = RoomId(1)
        result.unwrap(signal.reserve_room(mut l, room, lim))
        let _ = option.unwrap(signal.reserve_session(mut l, peer.Participant(gen: Gen(id: 1, epoch: 1), room: room)))
        let before_attach = signal.ledger_free(l, 1)
        if before_attach != cost.cascade {
            fail("cascade virtual unit headroom before attach did not equal cost.cascade")
        }
        result.unwrap(signal.reserve_cascade(mut l, room, 1, cost.cascade))
        if signal.ledger_free(l, 1) != 0 {
            fail("reserve_cascade did not charge exactly cost.cascade on the cascade virtual unit")
        }
        let Error(Bytes(unit: 1, need: need, free: had)) = signal.reserve_cascade(mut l, room, 2, cost.cascade) else {
            fail("over-budget cascade attach was not refused Bytes on unit 1")
        }
        if need != cost.cascade || had != 0 {
            fail("over-budget cascade refusal named wrong need or free")
        }
        signal.release_cascade(mut l, room, 1)
        if signal.ledger_free(l, 1) != before_attach {
            fail("detaching cascade link did not refund exact cost.cascade")
        }
    }
    // Verify `limits.rooms` refusal by name (`RoomsLimit`).
    let mut a = cascade.cascade_adapter(1, nid, link_lim)
    result.unwrap(cascade.open_home_room(mut a, RoomId(1), b"r1", 1, small))
    result.unwrap(cascade.open_home_room(mut a, RoomId(2), b"r2", 1, small))
    let Error(RoomsLimit) = cascade.open_home_room(mut a, RoomId(3), b"r3", 1, small) else {
        fail("attach past limits.rooms was not refused with RoomsLimit")
    }
    Ok(())
}

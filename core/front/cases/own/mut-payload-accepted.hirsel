// expect: run counted() = 6
// expect: run texted() = 3
// expect: run beside() = 21
// expect: run indexed() = 5
// expect: run both() = 12
// expect: run guarded() = 5
// expect: run boxed() = 8
// expect: run scalar() = 10
// expect: run nested() = 3
// expect: run swapped() = 37
// OWN-15: `mut x` writes the matched payload in place; the scrutinee keeps it.
// Each value is counted by hand from the writes below.
type Source = Text(String) | Count(u64)

type Lines {
    input: Source,
    buffer: String
}

type Pair = Both(u64, u64) | Neither

type Wrap = Inner(Option[u64]) | Bare

fn bump(mut src: Source) {
    match src {
        Text(mut s) => {
            let _ = string.push(mut s, "!");
        }
        Count(mut n) => {
            n += 1
        }
    }
}

fn size(src: Source) -> u64 {
    match src {
        Text(s) => string.byte_len(s),
        Count(n) => n
    }
}

fn counted() -> u64 {
    let mut src = Count(4)
    bump(mut src)
    bump(mut src)
    size(src)
}

fn texted() -> u64 {
    let mut src = Text(string.from("ab"))
    bump(mut src)
    size(src)
}

// A field beside the lent one stays usable.
fn beside() -> u64 {
    let mut l = Lines(input: Text(string.from("a")), buffer: string.new())
    match l.input {
        Text(mut s) => {
            let _ = string.push(mut l.buffer, "xyz");
            let _ = string.push(mut s, "b");
        }
        Count(_) => {}
    }
    size(l.input) * 10 + string.byte_len(l.buffer) - 2
}

// The scrutinee's index is resolved once, and the element is written in place.
fn indexed() -> u64 {
    let mut xs: List[Source] = list.new()
    list.push(mut xs, Count(1))
    list.push(mut xs, Text(string.from("ab")))
    if let Text(mut s) = xs[1] {
        s = string.from("first")
    }
    size(xs[1])
}

// Two fields of one variant do not overlap (OWN-9).
fn both() -> u64 {
    let mut p = Both(1, 2)
    match p {
        Both(mut a, mut b) => {
            a += 3;
            b += 5
        },
        Neither => {}
    }
    match p {
        Both(a, b) => a + b + 1,
        Neither => 0
    }
}

fn long(src: Source) -> bool {
    match src {
        Text(s) => string.byte_len(s) > 3,
        Count(_) => false
    }
}

// The guard reads the scrutinee: the loan begins only after it holds.
fn guarded() -> u64 {
    let mut src = Text(string.from("abcd"))
    match src {
        Text(mut s) if long(src) => {
            let _ = string.push(mut s, "!");
        }
        _ => {}
    }
    size(src)
}

fn boxed() -> u64 {
    let mut b = box.new(Count(7))
    match b {
        Count(mut n) => {
            n += 1
        },
        Text(_) => {}
    }
    match b {
        Count(n) => n,
        Text(_) => 0
    }
}

fn scalar() -> u64 {
    let mut o: Option[u64] = Some(9)
    match o {
        Some(mut n) => {
            n += 1
        },
        None => {}
    }
    match o {
        Some(n) => n,
        None => 0
    }
}

// A `mut` binding is a writable scrutinee for an inner match.
fn nested() -> u64 {
    let mut w = Inner(Some(2))
    match w {
        Inner(mut o) => match o {
            Some(mut n) => {
                n += 1
            },
            None => {}
        }
        Bare => {}
    }
    match w {
        Inner(Some(n)) => n,
        _ => 0
    }
}

fn install(mut s: String) {
    s = string.from("xyz")
}

// The place holds what was last installed through the binding (OWN-11).
fn swapped() -> u64 {
    let mut src = Text(string.from("a"))
    let old = match src {
        Text(mut s) => {
            install(mut s);
            replace(mut s, string.from("abcdefg"))
        }
        Count(_) => string.new()
    }
    size(src) * 5 + string.byte_len(old) - 1
}

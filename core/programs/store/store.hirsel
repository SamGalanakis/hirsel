// M4 store. The writer owns three persistent byte trees; readers hold Arc roots.
pub type StoreId {
    hi: u64,
    lo: u64
}

pub type Authority = Directory()

pub type Caller: codec + send { issuer: u8, subject: Bytes }

pub type Options {
    create: bool,
    lock_wait_ms: u64,
    group_commits: u32,
    group_bytes: u32,
    checkpoint_bytes: u64,
    checkpoint_task_bytes: u64,
    pack_bytes: u64,
    resident_limit: u64,
    authority: Authority
}

pub fn defaults() -> Options {
    Options(create: true, lock_wait_ms: 0, group_commits: 64, group_bytes: 4194304, checkpoint_bytes: 67108864, checkpoint_task_bytes: 262400276, pack_bytes: 67108864, resident_limit: 1073741824, authority: Directory())
}

pub type Limit = Key | Value | Transaction | Name

pub type Why = Checksum | Truncated | Flags | Kind(u64) | Header | Gap(u64) | Order | Dangling(u64) | Malformed

pub type Fault: send {
    file: String,
    offset: u64,
    why: Why
}

pub type Error: send = Held | NotFound | Corrupt(Fault) | Unsupported(u64) | Io(IoError) | Poisoned(IoError) | Full(Capacity) | Limit(Limit) | Schema(u64) | Stale(u32) | Decode(std.codec.DecodeError) | Exists(String) | Missing(String) | Diverged(u32) | Foreign | MigrationFault | ExportDirectory | OpenLimit(Capacity)

type Roots: shareable + send {
    data: std.omap.OMap[Bytes, Arc[Bytes]],
    streams: std.omap.OMap[Bytes, Arc[Bytes]],
    catalog: std.omap.OMap[Bytes, Arc[Bytes]]
}

fn empty_roots() -> Roots {
    Roots(data: std.omap.new(), streams: std.omap.new(), catalog: std.omap.new())
}

fn share_roots(r: Roots) -> Roots {
    Roots(data: std.omap.snapshot(r.data), streams: std.omap.snapshot(r.streams), catalog: std.omap.snapshot(r.catalog))
}

type Ack: send = Journaled(u64, u64) | Checkpointed(u64, u64) | Broken(IoError)

pub opaque type Db {
    store: StoreId,
    fence: u32,
    disk: List[DiskConnection],
    clock: Clock,
    // Every live branch, main first, the rest ascending by id. A version is
    // compared only with the head of the branch it belongs to (AA1, Z1).
    heads: List[Head],
    pins: List[Pin],
    next_branch: u32,
    next_node: u64,
    next_table: u32,
    file_seq: u64,
    file_end: u64,
    frame_seq: u64,
    resident: u64,
    // Commits and cut-made operations on any branch, so a cut ack can tell
    // whether anything changed after its state was taken.
    changes: u64,
    // The `changes` count at which `resident` was last exact (I4).
    settled: u64,
    ceiling: u64,
    acks: Option[Receiver[Ack]],
    journaled: u64,
    inflight: u64,
    acked_bytes: u64,
    written: Option[Receiver[WriteNotice]],
    written_send: Option[Sender[WriteNotice]],
    checkpointed: u64,
    poison: Option[IoError],
    journal: Option[Sender[JournalMsg]],
    pending: Option[Bytes],
    journal_task: Option[Task[Result[(), Error]]],
    // Stream name to the unreplied Admitted(p) this open committed (§1.8).
    admits: std.omap.OMap[Bytes, OpenAdmit],
    admit_ids: u64
}

pub type Branch {
    store: StoreId,
    id: u32
}

type Head {
    id: u32,
    name: String,
    parent: u32,
    forked_at: u64,
    roots: Roots,
    head: u64,
    at: u64,
    following: Option[Latest[Snapshot]]
}

type Pin: shareable + send {
    name: String,
    branch: u32,
    version: u64,
    roots: Roots
}

fn main_head(take roots: Roots, head: u64, at: u64) -> Head {
    Head(id: 0, name: "main", parent: 0, forked_at: 0, roots: take roots, head: head, at: at, following: None)
}

// I4: while a pin or another branch exists, an old row may stay reachable, so
// commits charge conservatively until the next cut settles the account.
fn retaining(db: Db) -> bool {
    list.len(db.heads) > 1 || list.len(db.pins) != 0
}

// A branch as a cut, open and replay carry it: a Head without the readers'
// handle (section 3.5 step 3).
type Tip: send {
    id: u32,
    name: String,
    parent: u32,
    forked_at: u64,
    roots: Roots,
    head: u64,
    at: u64
}

// Every branch's head and every pin: what one cut makes durable.
type State: send {
    tips: List[Tip],
    pins: List[Pin],
    next_branch: u32
}

// A cut-made operation's heads and pins, built before its cut so that
// installing them after the Checkpointed ack allocates nothing (section 3.5).
type Prospect {
    heads: List[Head],
    pins: List[Pin],
    next_branch: u32
}

fn main_state(take roots: Roots, head: u64, at: u64) -> Result[State, Capacity] {
    let mut tips: List[Tip] = list.new()
    result.capacity_only(list.push(mut tips, Tip(id: 0, name: "main", parent: 0, forked_at: 0, roots: take roots, head: head, at: at)))?
    Ok(State(tips: take tips, pins: list.new(), next_branch: 1))
}

fn share_pin(p: Pin) -> Result[Pin, Capacity] {
    Ok(Pin(name: string.from(p.name)?, branch: p.branch, version: p.version, roots: share_roots(p.roots)))
}

fn state_of(heads: List[Head], pins: List[Pin], next_branch: u32) -> Result[State, Capacity] {
    let mut tips: List[Tip] = list.with_capacity(list.len(heads))?
    for h in heads {
        result.capacity_only(list.push(mut tips, Tip(id: h.id, name: string.from(h.name)?, parent: h.parent, forked_at: h.forked_at, roots: share_roots(h.roots), head: h.head, at: h.at)))?
    }
    let mut kept: List[Pin] = list.with_capacity(list.len(pins))?
    for held in pins {
        result.capacity_only(list.push(mut kept, share_pin(held)?))?
    }
    Ok(State(tips: take tips, pins: take kept, next_branch: next_branch))
}

fn current_state(db: Db) -> Result[State, Capacity] {
    state_of(db.heads, db.pins, db.next_branch)
}

fn prospect(db: Db) -> Result[Prospect, Capacity] {
    prospect_except(db, list.len(db.heads), list.len(db.pins))
}

// The current heads and pins, leaving out head `gone` and pin `unpinned`
// (an index past the end leaves nothing out).
fn prospect_except(db: Db, gone: u64, unpinned: u64) -> Result[Prospect, Capacity] {
    let mut heads: List[Head] = list.with_capacity(list.len(db.heads) + 1)?
    for k in 0u64 .. list.len(db.heads) {
        if k == gone { continue }
        let h = db.heads[k]
        let following: Option[Latest[Snapshot]] = match h.following {
            Some(f) => Some(latest.handle(f)),
            None => None
        }
        result.capacity_only(list.push(mut heads, Head(id: h.id, name: string.from(h.name)?, parent: h.parent, forked_at: h.forked_at, roots: share_roots(h.roots), head: h.head, at: h.at, following: following)))?
    }
    let mut pins: List[Pin] = list.with_capacity(list.len(db.pins) + 1)?
    for k in 0u64 .. list.len(db.pins) {
        if k == unpinned { continue }
        result.capacity_only(list.push(mut pins, share_pin(db.pins[k])?))?
    }
    Ok(Prospect(heads: take heads, pins: take pins, next_branch: db.next_branch))
}

fn prospect_state(p: Prospect) -> Result[State, Capacity] {
    state_of(p.heads, p.pins, p.next_branch)
}

// After the cut's ack: swaps in heads and pins built before it.
fn install_prospect(mut db: Db, take p: Prospect) {
    let Prospect(heads: take heads, pins: take pins, next_branch: next_branch) = take p
    db.heads = take heads
    db.pins = take pins
    db.next_branch = next_branch
    db.changes += 1
    db.settled = db.changes
}

fn state_roots(s: State) -> Result[List[Roots], Capacity] {
    let mut all: List[Roots] = list.with_capacity(list.len(s.tips) + list.len(s.pins))?
    for t in s.tips {
        result.capacity_only(list.push(mut all, share_roots(t.roots)))?
    }
    for held in s.pins {
        result.capacity_only(list.push(mut all, share_roots(held.roots)))?
    }
    Ok(take all)
}

// I4: the exact account of a state. A node that several heads and pins reach
// counts once, as the checkpoint task's reference counts give it.
fn state_account(s: State) -> Result[u64, Capacity] {
    let all = state_roots(s)?
    if list.len(all) == 1 {
        return Ok(journal_account(all[0]))
    }
    let mut graph = disk_graph()
    let _ = disk_track_roots(mut graph, all)?
    Ok(graph.live)
}

// Section 3.5: a cut of `s`. A disk store sends it to the checkpoint task and
// waits for the ack; a memory store counts it inline and writes nothing (I4).
// Either way `resident` is then exact for `s`.
fn cut_state(mut db: Db, take s: State) -> Result[Ticket, Error] waits {
    if list.len(db.disk) != 0 {
        return disk_request_cut(mut db, take s)
    }
    let live = capacity(state_account(s))?
    db.checkpointed += 1
    db.resident = live
    db.settled = db.changes
    Ok(Ticket(store: db.store, open: 0, mark: Cut(db.checkpointed)))
}

fn branch_index(db: Db, b: Branch) -> Result[u64, Error] {
    if !same(b.store, db.store) {
        return Error(Foreign)
    }
    for i in 0u64 .. list.len(db.heads) {
        if db.heads[i].id == b.id {
            return Ok(i)
        }
    }
    Error(Missing("branch"))
}

fn head_snapshot(db: Db, i: u64) -> Snapshot {
    snapshot_from(db, i, db.heads[i].head, db.heads[i].roots)
}

fn snapshot_from(db: Db, i: u64, head: u64, roots: Roots) -> Snapshot {
    Snapshot(store: db.store, open: open_number(db), branch: db.heads[i].id, head: head, roots: share_roots(roots))
}

pub type CallId {
    store: StoreId,
    branch: u32,
    version: u64
}

pub type CallInfo {
    id: CallId,
    at: u64,
    seed: u64
}

pub type Mark = Journal(u64) | Cut(u64)

pub type Ticket {
    store: StoreId,
    open: u64,
    mark: Mark
}

pub type Read = Point(Bytes) | Span(Bytes, Bytes)

pub type Outcome[R, A] = Committed(Done[R]) | Aborted(Undone[A]) | Failed(Causes) | Refused(Capacity) | Stopped(OutOfTime)

pub type Undone[A] {
    value: A,
    ticket: Option[Ticket]
}

pub type Done[R] {
    value: R,
    ticket: Ticket,
    info: CallInfo,
    reads: List[Read]
}

pub type Bound[K] = Unbounded | Included(K) | Excluded(K)

pub type Limits: shareable + send {
    rows: u64,
    byte_limit: u64
}

pub opaque type Resume: send {
    store: StoreId,
    open: u64,
    branch: u32,
    version: u64,
    source: u32,
    high: Bytes,
    last: Bytes
}

pub type Page[K, V]: send {
    rows: List[(K, V)],
    byte_count: u64,
    next: Option[Resume]
}

pub type Resumed[K, V]: send = Paged(Page[K, V]) | Moved(u64)

pub opaque scoped type Tx {
    store: StoreId,
    roots: Roots,
    ids: u64,
    resident: u64,
    retain_old: bool,
    reads: View[Log[Read]],
    issued: View[Log[u64]],
    refusal: Option[Capacity],
    frame_bytes: u64,
    wrote: bool,
    ops: std.omap.OMap[Bytes, Option[Bytes]],
    op_ids: u64,
    info: CallInfo,
    // The streams section's ops (§1.8). `extra_bytes` is that section with
    // its 5-byte head, when it has ops, plus the CALL section's bytes.
    stream_ops: std.omap.OMap[Bytes, Option[Bytes]],
    extra_bytes: u64,
    call: Option[CallSection]
}

pub opaque type Snapshot: shareable + send {
    store: StoreId,
    open: u64,
    branch: u32,
    head: u64,
    roots: Roots
}

pub opaque type ByteRows: send {
    cursor: std.omap.Cursor[Bytes, Arc[Bytes]]
}

/// Mix a SplitMix64 seed after adding the generator stride with wrapping arithmetic.
pub fn splitmix64(x: u64) -> u64 {
    let mut z = int.wrapping_add(x, 0x9E3779B97F4A7C15u64)
    z = int.wrapping_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9u64)
    z = int.wrapping_mul(z ^ (z >> 27), 0x94D049BB133111EBu64)
    z ^ (z >> 31)
}

fn call_info(id: StoreId, b: u32, v: u64, wall: u64, previous: u64) -> CallInfo {
    CallInfo(id: CallId(store: id, branch: b, version: v), at: if wall < previous {
        previous
    } else {
        wall
    }, seed: splitmix64(splitmix64(splitmix64(splitmix64(id.hi) ^ id.lo) ^ int.widen(b)) ^ v))
}

fn same(a: StoreId, b: StoreId) -> bool {
    a.hi == b.hi && a.lo == b.lo
}

fn make_id(r: Random) -> StoreId {
    let mut raw: Bytes = result.unwrap(list.with_capacity(16))
    host.random(r, mut raw)
    StoreId(hi: list.word_le(raw, 0), lo: list.word_le(raw, 8))
}

pub fn memory(c: Clock, r: Random, o: Options) -> Db {
    memory_at(c, make_id(r), o)
}

fn memory_at(c: Clock, id: StoreId, o: Options) -> Db {
    empty_db(c, id, o)
}

fn empty_db(c: Clock, id: StoreId, o: Options) -> Db {
    let mut heads: List[Head] = list.new()
    result.unwrap(list.push(mut heads, main_head(empty_roots(), 0, 0)))
    Db(store: id, fence: 0, disk: list.new(), clock: c, heads: take heads, pins: list.new(), next_branch: 1, next_node: 0, next_table: 1, file_seq: 1, file_end: 72, frame_seq: 0, resident: 0, changes: 0, settled: 0, ceiling: o.resident_limit, acks: None, journaled: 0, inflight: 0, acked_bytes: 0, written: None, written_send: None, checkpointed: 0, poison: None, journal: None, pending: None, journal_task: None, admits: std.omap.new(), admit_ids: 0)
}

pub fn fence_level(db: Db) -> u32 { db.fence }

pub fn is_disk(db: Db) -> bool { list.len(db.disk) != 0 }

pub fn identity(db: Db) -> StoreId {
    db.store
}

pub fn main_branch(db: Db) -> Branch {
    Branch(store: db.store, id: 0)
}

pub fn snapshot(db: Db) -> Snapshot {
    head_snapshot(db, 0)
}

pub fn snapshot_of(db: Db, b: Branch) -> Result[Snapshot, Error] {
    let i = branch_index(db, b)?
    Ok(head_snapshot(db, i))
}

fn same_name(a: String, b: String) -> bool {
    string.as_bytes(a) == string.as_bytes(b)
}

fn checked_name(name: String) -> Result[String, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    named(name)
}

pub fn branch(db: Db, name: String) -> Option[Branch] {
    for h in db.heads {
        if same_name(h.name, name) {
            return Some(Branch(store: db.store, id: h.id))
        }
    }
    None
}

fn pin_index(db: Db, name: String) -> u64 {
    for k in 0u64 .. list.len(db.pins) {
        if same_name(db.pins[k].name, name) {
            return k
        }
    }
    list.len(db.pins)
}

pub fn pinned(db: Db, name: String) -> Option[Snapshot] {
    let k = pin_index(db, name)
    if k == list.len(db.pins) {
        return None
    }
    let p = db.pins[k]
    Some(Snapshot(store: db.store, open: open_number(db), branch: p.branch, head: p.version, roots: share_roots(p.roots)))
}

// Section 1.9 and 1.12: fork and pin take only a Snapshot of this open, whose
// node ids this open issued.
fn this_open(db: Db, s: Snapshot) -> Result[(), Error] {
    if !same(s.store, db.store) || s.open != open_number(db) {
        return Error(Foreign)
    }
    Ok(())
}

// Section 1.9: an operation made by a cut. Nothing is installed unless the
// cut is acked Checkpointed; on Refused the result is Full and the store is
// unchanged (section 3.5).
fn cut_install(mut db: Db, take planned: Prospect) -> Result[Ticket, Error] waits {
    let s = capacity(prospect_state(planned))?
    let commit_ticket = cut_state(mut db, take s)?
    install_prospect(mut db, take planned)
    Ok(commit_ticket)
}

pub fn fork(mut db: Db, name: String, from: Snapshot) -> Result[(Branch, Ticket), Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    this_open(db, from)?
    let owned = checked_name(name)?
    if let Some(_) = branch(db, name) {
        return Error(Exists(take owned))
    }
    // Section 1.11: the new tree's accounted size is admitted before the fork.
    let live = int.saturating_add(db.resident, journal_account(from.roots))
    if live > db.ceiling {
        return Error(Full(Capacity(requested: live, available: db.ceiling)))
    }
    // A Snapshot carries no wall time; the branch it was taken on, if it is
    // still live, gives the at its CallInfo continues from (section 1.7).
    let mut at = db.heads[0].at
    for h in db.heads {
        if h.id == from.branch { at = h.at }
    }
    let id = db.next_branch
    let mut planned = capacity(prospect(db))?
    let head = Head(id: id, name: take owned, parent: from.branch, forked_at: from.head, roots: share_roots(from.roots), head: from.head, at: at, following: None)
    capacity(result.capacity_only(list.push(mut planned.heads, take head)))?
    planned.next_branch = id + 1
    let commit_ticket = cut_install(mut db, take planned)?
    Ok((Branch(store: db.store, id: id), commit_ticket))
}

// AA1: a fast-forward of main to b, exactly when b forked from main at main's
// current version; b is then deleted. Any other case is Diverged(b).
pub fn adopt(mut db: Db, b: Branch) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    // AA1: a branch that is not live (deleted, or adopted and so deleted) is
    // no fork of main at main's version, so it is Diverged like any other.
    let i = match branch_index(db, b) {
        Ok(found) => found,
        Error(Missing(_)) => return Error(Diverged(b.id)),
        Error(take e) => return Error(take e)
    }
    if i == 0 || db.heads[i].parent != 0 || db.heads[0].head != db.heads[i].forked_at {
        return Error(Diverged(b.id))
    }
    let mut planned = capacity(prospect_except(db, i, list.len(db.pins)))?
    planned.heads[0].roots = share_roots(db.heads[i].roots)
    planned.heads[0].head = db.heads[i].head
    planned.heads[0].at = db.heads[i].at
    let publication = capacity(prepare_publication(db, 0, planned.heads[0].head, planned.heads[0].roots))?
    let commit_ticket = cut_install(mut db, take planned)?
    publish(take publication)
    Ok(commit_ticket)
}

// Main is not deletable: it is Missing("branch") like an id that is not live.
pub fn delete_branch(mut db: Db, b: Branch) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, b)?
    if i == 0 {
        return Error(Missing("branch"))
    }
    let planned = capacity(prospect_except(db, i, list.len(db.pins)))?
    cut_install(mut db, take planned)
}

pub fn pin(mut db: Db, name: String, s: Snapshot) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    this_open(db, s)?
    let owned = checked_name(name)?
    if pin_index(db, name) != list.len(db.pins) {
        return Error(Exists(take owned))
    }
    let mut planned = capacity(prospect(db))?
    let kept = Pin(name: take owned, branch: s.branch, version: s.head, roots: share_roots(s.roots))
    capacity(result.capacity_only(list.push(mut planned.pins, take kept)))?
    cut_install(mut db, take planned)
}

pub fn unpin(mut db: Db, name: String) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let k = pin_index(db, name)
    if k == list.len(db.pins) {
        return Error(Missing(named(name)?))
    }
    let planned = capacity(prospect_except(db, list.len(db.heads), k))?
    cut_install(mut db, take planned)
}

pub fn version(s: Snapshot) -> u64 {
    s.head
}

pub fn follow(mut db: Db, b: Branch) -> Result[Latest[Snapshot], Error] {
    healthy(db)?
    let i = branch_index(db, b)?
    if let Some(h) = db.heads[i].following {
        return Ok(latest.handle(h))
    }
    let root = match arc.new(head_snapshot(db, i)) {
        Ok(take root) => take root,
        Error((c, _)) => return Error(Full(c))
    }
    let h = match latest.new(take root) {
        Ok(take h) => take h,
        Error((c, _)) => return Error(Full(c))
    }
    db.heads[i].following = Some(latest.handle(h))
    Ok(take h)
}

type Publication {
    followed: Option[(Latest[Snapshot], Arc[Snapshot])]
}

// The followed snapshot is allocated before the commit, so publishing it
// after the commit cannot fail.
fn prepare_publication(db: Db, i: u64, head: u64, roots: Roots) -> Result[Publication, Capacity] {
    let followed = match db.heads[i].following {
        Some(handle) => Some((latest.handle(handle), result.capacity_only(arc.new(snapshot_from(db, i, head, roots)))?)),
        None => None
    }
    Ok(Publication(followed: take followed))
}

fn publish(take publication: Publication) {
    let Publication(followed: take followed) = take publication
    if let Some((take handle, take root)) = take followed {
        latest.publish(handle, take root)
    }
}

pub type Receipt { ticket: Ticket, reply: Bytes }

pub type Stop = Raised(u32) | OutOfSteps(u64) | OutOfBytes(Capacity)

fn append_be(mut raw: Bytes, value: u64, width: u64) -> Result[(), Capacity] {
    for i in 0u64 .. width {
        result.capacity_only(list.push(mut raw, int.truncate(value >> int.truncate(8 * (width - 1 - i)))))?
    }
    Ok(())
}

pub type Plan { n_e: u64, s_e: u64, reply_max: u64 }
pub type CallReserve { retained: u64, steps: u64 }

// AM5. The body isolate's cause cell is the only allocation outside E.
// A finalized issued ID takes one loop latch, and its log cell is eight bytes.
const CALL_CAUSE_BYTES: u64 = 32
// MEM-30 calls on the longest path outside the body's scope: draft_call (1),
// the isolate (2), and log finish twice plus finish_stage (3).
const CALL_FIXED_STEPS: u64 = 6
const ISSUED_ID_BYTES: u64 = 8

pub fn call_reserves(plan: Plan) -> Option[CallReserve] {
    let Some(retained) = int.checked_add(plan.n_e, CALL_CAUSE_BYTES) else { return None }
    let Some(fixed) = int.checked_add(plan.s_e, CALL_FIXED_STEPS) else { return None }
    let Some(steps) = int.checked_add(fixed, plan.n_e / ISSUED_ID_BYTES) else { return None }
    Some(CallReserve(retained: retained, steps: steps))
}

pub type ServeError = Before(Error) | After(Error)
pub type Reserve = Resident | Claim

pub opaque type Pending {
    completion: Completion,
    record: Option[CallRecord],
    attempted: CallInfo,
    would_reply: Option[Bytes],
}

pub type Served = Committed(Receipt) | Kept(Receipt) | Failed(Pending, Stop) | NoRoom(Pending, Capacity)

type ServeReply = KeptReply(Bytes) | StoreFailure(Error) | BodyStop(Stop)

pub fn next_call_info(db: Db) -> CallInfo {
    call_info(db.store, 0, db.heads[0].head + 1, host.wall_ms(db.clock), db.heads[0].at)
}

pub fn untried(take complete: Completion, take rec: Option[CallRecord], attempted: CallInfo) -> Pending {
    Pending(completion: take complete, record: take rec, attempted: attempted, would_reply: None)
}

fn registered_completion(db: Db, complete: Completion) -> Result[(), ServeError] {
    if !same(db.store, complete.admitted.store) || open_number(db) != complete.admitted.open {
        return Error(Before(Foreign))
    }
    if let Some(raw) = std.omap.get(db.heads[0].roots.streams, complete.stream) {
        let state = serve_before(stream_state(raw))?
        if state.p == complete.p && state.state == 1 && state.digest == complete.request { return Ok(()) }
    }
    Error(Before(Missing("reply")))
}

fn serve_before[R](take result: Result[R, Error]) -> Result[R, ServeError] {
    match take result {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(Before(take problem)),
    }
}

fn serve_after(take result: Result[(), Error]) -> Result[(), ServeError] {
    match take result {
        Ok(()) => Ok(()),
        Error(take problem) => Error(After(take problem)),
    }
}

fn cause_number(causes: Causes) -> u32 {
    for cause in causes {
        return match cause.kind {
            Overflow => 1u32, Bounds => 2u32, Division => 3u32, Unwrap => 4u32,
            Fail(_) => 5u32, Cancelled => 6u32, Capacity => 7u32, OutOfTime => 8u32
        }
    }
    0u32
}

fn save_reply(mut tx: Tx, complete: Completion, output: Bytes, rec: Option[CallRecord], settlement: Option[Settlement]) -> Result[(), Error] {
    let size = match rec {
        Some(value) => {
            call_section_bytes(value, match settlement { Some(_) => true, None => false })
        },
        None => 0u64,
    }
    let (take key, take value) = reply_row(tx, complete.stream, complete.p, output)?
    stream_write(mut tx, take key, take value, size)
}

fn stage_reply(mut tx: Tx, complete: Completion, rec: Option[CallRecord], reply_max: u64,
        body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[Bytes, ServeReply] {
    let returned = body(mut tx)
    if let Some(problem) = tx.refusal {
        tx.refusal = None
        return Error(BodyStop(OutOfBytes(problem)))
    }
    let (success, take output) = match take returned {
        Ok(take payload) => (true, take payload),
        Error(take payload) => (false, take payload),
    }
    if list.len(output) > reply_max {
        return Error(BodyStop(OutOfBytes(Capacity(requested: list.len(output), available: reply_max))))
    }
    match save_reply(mut tx, complete, output, rec, None) {
        Ok(()) => (),
        Error(Full(problem)) => return Error(BodyStop(OutOfBytes(problem))),
        Error(take problem) => return Error(StoreFailure(take problem)),
    }
    if success { Ok(take output) } else { Error(KeptReply(take output)) }
}

pub fn serve(mut db: Db, take complete: Completion, plan: Plan, take rec: Option[CallRecord],
        body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[Served, ServeError] waits {
    serve_before(journal_poll(mut db))?
    serve_before(healthy(db))?
    registered_completion(db, complete)?
    serve_before(check_completion_record(complete, rec))?
    let attempted = next_call_info(db)
    let Some(grant) = call_reserves(plan) else { return Error(Before(Limit(Transaction))) }
    let metered = metered_draft(db, complete, attempted, plan, grant, rec, body)
    let DraftedCall(stage: take draft, next_id: next_id) = match take metered {
        Error(AdmissionBytes(problem)) => return Error(Before(Full(problem))),
        Error(DraftStopped(stop)) => return Ok(Failed(untried(take complete, take rec, attempted), stop)),
        Ok(take draft) => take draft,
    }
    db.next_node = next_id
    let pending_run = Pending(completion: take complete, record: take rec, attempted: attempted, would_reply: None)
    match take draft {
        Ran(take staged) => finish_served(mut db, take pending_run, None, take staged),
        Over(Stopped(limit)) => Ok(Failed(take pending_run, OutOfSteps(limit.steps))),
        Over(Failed(causes)) => Ok(Failed(take pending_run, Raised(cause_number(causes)))),
        Over(Refused(problem)) => Ok(Failed(take pending_run, OutOfBytes(problem))),
        Over(Aborted(Undone(value: BodyStop(stop), ..))) => Ok(Failed(take pending_run, stop)),
        Over(Aborted(Undone(value: StoreFailure(take problem), ..))) => Error(Before(take problem)),
        _ => fail("store: missing staged reply"),
    }
}

fn served_value(take result: Result[Bytes, ServeReply]) -> Bytes {
    match take result {
        Ok(take output) => take output,
        Error(KeptReply(take output)) => take output,
        _ => fail("store: invalid staged reply"),
    }
}

fn finish_served(mut db: Db, take pending_run: Pending, settlement: Option[Settlement], take staged: Ran[Bytes, ServeReply]) -> Result[Served, ServeError] waits {
    let ready = serve_before(settle_draft(mut db, 0, take staged, pending_run.record, settlement))?
    match take ready {
        OverLimit(take rejected, problem) => {
            let Ran(value: take would_be, ..) = take rejected
            let mut held = take pending_run
            held.would_reply = Some(served_value(take would_be))
            Ok(NoRoom(take held, problem))
        },
        Ready(take accepted, take publication) => {
            let committed = commit_prepared(mut db, 0, take accepted, take publication)
            serve_after(handoff(mut db))?
            serve_after(maybe_checkpoint(mut db))?
            match take committed {
                Committed(Done(value: take output, ticket: committed_at, ..)) =>
                    Ok(Committed(Receipt(ticket: committed_at, reply: take output))),
                Aborted(Undone(value: KeptReply(take output), ticket: Some(committed_at))) =>
                    Ok(Kept(Receipt(ticket: committed_at, reply: take output))),
                _ => fail("store: staged reply was lost"),
            }
        },
    }
}

pub fn conclude(mut db: Db, take pending_run: Pending, take output: Bytes, reserve: Reserve) -> Result[Served, ServeError] waits {
    if let Claim = reserve { return Error(Before(Missing("claim"))) }
    serve_before(journal_poll(mut db))?
    serve_before(healthy(db))?
    registered_completion(db, pending_run.completion)?
    serve_before(check_completion_record(pending_run.completion, pending_run.record))?
    let now = host.wall_ms(db.clock)
    let attempted = pending_run.attempted
    let way = match pending_run.would_reply { Some(_) => 2u8, None => 1u8 }
    let settlement: Option[Settlement] = if attempted.id.version == 0 { None } else { Some(Settlement(way: way, base: attempted.id.version - 1, at: attempted.at, seed: attempted.seed)) }
    let keep: Option[fn(ServeReply) -> bool] = None
    let draft = stage_call(mut db, 0, now, None, keep, pending_run.record, settlement, scoped fn(mut tx: Tx) -> Result[Bytes, ServeReply] {
        let held: Result[Bytes, Capacity] = clone(output)
        let moved = match take held {
            Ok(take captured) => take captured,
            Error(problem) => return Error(BodyStop(OutOfBytes(problem))),
        }
        match save_reply(mut tx, pending_run.completion, output, pending_run.record, settlement) {
            Ok(()) => Ok(take moved),
            Error(Full(problem)) => Error(BodyStop(OutOfBytes(problem))),
            Error(take problem) => Error(StoreFailure(take problem)),
        }
    })
    match take draft {
        Ran(take staged) => finish_served(mut db, take pending_run, settlement, take staged),
        Over(Refused(problem)) => Ok(NoRoom(take pending_run, problem)),
        Over(Aborted(Undone(value: BodyStop(OutOfBytes(problem)), ..))) => Ok(NoRoom(take pending_run, problem)),
        Over(Aborted(Undone(value: StoreFailure(take problem), ..))) => Error(Before(take problem)),
        _ => fail("store: invalid conclude draft"),
    }
}

pub fn info(mut tx: Tx) -> CallInfo {
    tx.info
}

// A step records the body's typed error in the outer transaction. Keep the
// issued-id log and read set, and roll back the body's table writes.
pub fn rollback_writes_on_error[R, E](mut tx: Tx, body: scoped[view] fn(mut Tx) -> Result[R, E]) -> Result[R, E] {
    let roots = share_roots(tx.roots)
    let ops = std.omap.snapshot(tx.ops)
    let resident = tx.resident
    let frame_bytes = tx.frame_bytes
    let wrote = tx.wrote
    let result = body(mut tx)
    if let Error(_) = result {
        tx.roots = take roots
        tx.ops = take ops
        tx.resident = resident
        tx.frame_bytes = frame_bytes
        tx.wrote = wrote
    }
    take result
}

pub fn run[R, A](mut db: Db, steps: Option[u64], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let b = main_branch(db)
    run_on(mut db, b, steps, body)
}

pub fn run_on[R, A](mut db: Db, b: Branch, steps: Option[u64], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    run_on_with_reply(mut db, b, steps, None, body)
}

// A runner abort may keep its reply. A runner refusal rolls back the whole Tx.
pub fn run_with_reply[R, A](mut db: Db, steps: Option[u64], keep_reply: fn(A) -> bool, body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let b = main_branch(db)
    run_on_with_reply(mut db, b, steps, Some(keep_reply), body)
}

fn run_on_with_reply[R, A](mut db: Db, b: Branch, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, b)?
    let outcome = append_transaction(mut db, i, steps, keep_reply, body)
    maybe_checkpoint(mut db)?
    take outcome
}

fn append_transaction[R, A](mut db: Db, i: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let wall = host.wall_ms(db.clock)
    let outcome: Result[Outcome[R, A], Error] = match stage(mut db, i, wall, steps, keep_reply, body) {
        Over(take o) => Ok(take o),
        Ran(take ran) => settle_admit(mut db, i, take ran)
    }
    handoff(mut db)?
    take outcome
}

fn handoff(mut db: Db) -> Result[(), Error] waits {
    let frame = replace(mut db.pending, None)
    if let Some(take raw) = frame {
        if let Some(sender) = db.journal {
            if let Error(_) = channel.send(sender, Frame(take raw, db.frame_seq)) {
                db.poison = Some(Closed)
                return Error(Poisoned(Closed))
            }
        }
    }
    Ok(())
}

fn maybe_checkpoint(mut db: Db) -> Result[(), Error] waits {
    if list.len(db.disk) != 0 && db.file_end - 72 >= db.disk[0].options.checkpoint_bytes {
        if let Ok(take s) = current_state(db) {
            match disk_begin_cut(mut db, take s) {
                Error(Full(_)) => {},
                Error(take e) => return Error(take e),
                Ok(_) => {}
            }
        }
    }
    Ok(())
}

// A body whose commit the admission bound decides (section 1.11): one that
// returned Ok, or one that returned Error after a reply, whose commit keeps
// only its streams writes and its CALL section (F2).
type Ran[R, A] {
    value: Result[R, A],
    roots: Roots,
    live: u64,
    wrote: bool,
    frame: Option[Bytes],
    ops: std.omap.OMap[Bytes, Option[Bytes]],
    stream_ops: std.omap.OMap[Bytes, Option[Bytes]],
    call: Option[CallSection],
    info: CallInfo,
    reads: List[Read]
}

type Stage[R, A] = Over(Outcome[R, A]) | Ran(Ran[R, A])

type Finished[R, A] = RolledBack(Outcome[R, A]) | Prepared(Prepared[R, A])

// A successful body or an application error with a reply to commit.
type Prepared[R, A] {
    outcome: Result[R, A],
    roots: Roots,
    live: u64,
    wrote: bool,
    frame: Option[Bytes],
    ops: std.omap.OMap[Bytes, Option[Bytes]],
    stream_ops: std.omap.OMap[Bytes, Option[Bytes]],
    call: Option[CallSection]
}

// Runs the body on branch `i` inside isolate. Everything but a body that
// returned Ok, or Error after a reply, is final here.
fn stage[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    let no_record: Option[CallRecord] = None
    stage_call(mut db, i, wall, steps, keep_reply, no_record, None, body)
}

// The caller keeps owning the record so a refused publication can return it.
fn stage_call[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool],
        rec: Option[CallRecord], settlement: Option[Settlement], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    let read_log: Result[Log[Read], Capacity] = log.new()
    let reads: Log[Read] = match take read_log {
        Ok(take x) => take x,
        Error(c) => return Over(Refused(c))
    }
    let issue_log: Result[Log[u64], Capacity] = log.new()
    let issued: Log[u64] = match take issue_log {
        Ok(take x) => take x,
        Error(c) => return Over(Refused(c))
    }
    let ci = call_info(db.store, db.heads[i].id, db.heads[i].head + 1, wall, db.heads[i].at)
    let caught = isolate(fn() -> Result[Finished[R, A], OutOfTime] {
        let perform = scoped fn() -> Finished[R, A] {
            let prepared = draft_body(db, i, ci, keep_reply, reads, issued, body)
            match frame_draft(db, ci, rec, settlement, take prepared) {
                Ok(take framed) => take framed,
                Error(problem) => RolledBack(Refused(problem)),
            }
        }
        match steps {
            Some(s) => bound steps s { perform() },
            None => Ok(perform()),
        }
    })
    let consumed = log.finish(take issued)
    for n in consumed { db.next_node = n }
    let seen = log.finish(take reads)
    match take caught {
        Error(c) => Over(Refused(c)),
        Ok(Error(take cs)) => Over(Failed(take cs)),
        Ok(Ok(Error(e))) => Over(Stopped(e)),
        Ok(Ok(Ok(take f))) => finish_stage(ci, take f, take seen),
    }
}

fn draft_body[R, A](db: Db, i: u64, ci: CallInfo, keep_reply: Option[fn(A) -> bool], reads: Log[Read], issued: Log[u64],
        body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Finished[R, A] {
    let mut tx = Tx(store: db.store, roots: share_roots(db.heads[i].roots), ids: db.next_node, resident: db.resident, retain_old: retaining(db), reads: view reads, issued: view issued, refusal: None, frame_bytes: 42, wrote: false, ops: std.omap.new(), op_ids: 0, info: ci, stream_ops: std.omap.new(), extra_bytes: 0, call: None)
    let outcome = body(mut tx)
    if let Some(c) = tx.refusal { return RolledBack(Refused(c)) }
    let value: Result[R, A] = match take outcome {
        Ok(take v) => Ok(take v),
        Error(take a) => {
            let keep = match keep_reply { Some(decide) => decide(a), None => true }
            if !keep || std.omap.len(tx.stream_ops) == 0 {
                return RolledBack(Aborted(Undone(value: take a, ticket: None)))
            }
            // F2 keeps the streams and CALL writes with the old data roots.
            let live = match stream_live(db, i, tx.stream_ops) {
                Ok(n) => n,
                Error(c) => return RolledBack(Refused(c))
            }
            tx.resident = live
            tx.roots.data = std.omap.snapshot(db.heads[i].roots.data)
            tx.roots.catalog = std.omap.snapshot(db.heads[i].roots.catalog)
            tx.ops = std.omap.new()
            Error(take a)
        }
    }
    let Tx(store: _, roots: take roots, ids: _, resident: live, retain_old: _, reads: _, issued: _, refusal: _, frame_bytes: _, wrote: wrote, ops: take ops, op_ids: _, info: _, stream_ops: take stream_ops, extra_bytes: _, call: take call) = take tx
    Prepared(Prepared(outcome: take value, roots: take roots, live: live, wrote: wrote, frame: None, ops: take ops, stream_ops: take stream_ops, call: take call))
}

fn frame_draft[R, A](db: Db, ci: CallInfo, rec: Option[CallRecord], settlement: Option[Settlement], take finished: Finished[R, A]) -> Result[Finished[R, A], Capacity] {
    match take finished {
        RolledBack(take outcome) => Ok(RolledBack(take outcome)),
        Prepared(take ready) => {
            let mut prepared = take ready
            if let Some(_) = db.journal {
                prepared.frame = Some(encode_staged(ci, prepared.ops, prepared.stream_ops, prepared.call, rec, settlement, db.file_seq, db.file_end)?)
            }
            Ok(Prepared(take prepared))
        },
    }
}

fn finish_stage[R, A](ci: CallInfo, take finished: Finished[R, A], take seen: List[Read]) -> Stage[R, A] {
    let prepared = match take finished {
        RolledBack(take o) => return Over(take o),
        Prepared(take tx) => take tx,
    }
    let Prepared(outcome: take outcome, roots: take roots, live: live, wrote: wrote, frame: take frame, ops: take ops, stream_ops: take stream_ops, call: take call) = take prepared
    Ran(Ran(value: take outcome, roots: take roots, live: live, wrote: wrote, frame: take frame, ops: take ops, stream_ops: take stream_ops, call: take call, info: ci, reads: take seen))
}

type CallDraft {
    finished: Finished[Bytes, ServeReply],
    reads: Log[Read],
    issued: Log[u64]
}

type DraftedCall {
    stage: Stage[Bytes, ServeReply],
    next_id: u64
}

type DraftRefusal = AdmissionBytes(Capacity) | DraftStopped(Stop)

fn metered_draft(db: Db, complete: Completion, ci: CallInfo, plan: Plan, grant: CallReserve, rec: Option[CallRecord],
        body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[DraftedCall, DraftRefusal] {
    // These synchronous scopes cannot lose task room between admission and use.
    // Refund the admission before encoding, so frame bytes come from the head.
    let admitted = bound bytes grant.retained { () }
    if let Error(problem) = admitted { return Error(AdmissionBytes(problem)) }
    let metered = bound steps grant.steps { draft_call(db, complete, ci, plan, rec, body) }
    match take metered {
        Error(limit) => Error(DraftStopped(OutOfSteps(limit.steps))),
        Ok(take drafted) => Ok(take drafted),
    }
}

fn draft_call(db: Db, complete: Completion, ci: CallInfo, plan: Plan, rec: Option[CallRecord],
        body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> DraftedCall {
    let caught = isolate(fn() -> Result[Result[CallDraft, Capacity], OutOfTime] {
        let perform = scoped fn() -> Result[CallDraft, Capacity] {
            let keep: Option[fn(ServeReply) -> bool] = None
            let draft = bound bytes plan.n_e {
                let reads: Log[Read] = log.new()?
                let issued: Log[u64] = log.new()?
                let finished = draft_body(db, 0, ci, keep, reads, issued, scoped fn(mut tx: Tx) -> Result[Bytes, ServeReply] {
                    stage_reply(mut tx, complete, rec, plan.reply_max, body)
                })
                CallDraft(finished: take finished, reads: take reads, issued: take issued)
            }
            let CallDraft(finished: take result, reads: take reads, issued: take issued) = (take draft)?
            // Encoding spends the call's steps and the head's frame bytes.
            let framed = match frame_draft(db, ci, rec, None, take result) {
                Ok(take finished) => take finished,
                Error(problem) => RolledBack(Aborted(Undone(value: StoreFailure(Full(problem)), ticket: None))),
            }
            Ok(CallDraft(finished: take framed, reads: take reads, issued: take issued))
        }
        bound steps plan.s_e { perform() }
    })
    let mut next_id = db.next_node
    let staged: Stage[Bytes, ServeReply] = match take caught {
        Error(problem) => Over(Refused(problem)),
        Ok(Error(take causes)) => Over(Failed(take causes)),
        Ok(Ok(Error(limit))) => Over(Stopped(limit)),
        Ok(Ok(Ok(Error(problem)))) => Over(Refused(problem)),
        Ok(Ok(Ok(Ok(take draft)))) => {
            let CallDraft(finished: take result, reads: take reads, issued: take issued) = take draft
            let consumed = log.finish(take issued)
            for n in consumed { next_id = n }
            finish_stage(ci, take result, log.finish(take reads))
        },
    }
    // A fault or step stop drops the private roots, so none of their IDs escape.
    DraftedCall(stage: take staged, next_id: next_id)
}

// F2: the account after only the reply writes `ops`, against branch `i`.
fn stream_live(db: Db, i: u64, ops: std.omap.OMap[Bytes, Option[Bytes]]) -> Result[u64, Capacity] {
    let retained = retaining(db)
    let mut live = db.resident
    let mut cursor = result.capacity_only(std.omap.range(ops, Unbounded, Unbounded))?
    while let Some((k, v)) = std.omap.next(mut cursor)? {
        if let Some(raw) = v {
            if !retained {
                if let Some(old) = std.omap.get(db.heads[i].roots.streams, k) {
                    live = int.saturating_sub(live, entry(k, old))
                }
            }
            live = int.saturating_add(live, entry(k, raw))
        }
    }
    Ok(live)
}

fn commit_cost[R, A](db: Db, ran: Ran[R, A]) -> u64 {
    let frame_size = match ran.frame { Some(raw) => list.len(raw), None => 0u64 }
    int.saturating_add(ran.live, int.saturating_add(db.inflight, frame_size))
}

fn over_bound[R, A](db: Db, ran: Ran[R, A]) -> bool {
    let has_frame = match ran.frame { Some(_) => true, None => false }
    commit_cost(db, ran) > db.ceiling && (ran.wrote || has_frame)
}

// The admission bound, then the commit on branch `i` (section 1.11, run step 4).
type AdmittedDraft[R, A] = Ready(Ran[R, A], Publication) | OverLimit(Ran[R, A], Capacity)

fn prepare_run_commit[R, A](db: Db, i: u64, take ran: Ran[R, A]) -> AdmittedDraft[R, A] {
    if over_bound(db, ran) {
        let needed = commit_cost(db, ran)
        return OverLimit(take ran, Capacity(requested: needed, available: db.ceiling))
    }
    let publication = match prepare_publication(db, i, db.heads[i].head + 1, ran.roots) {
        Ok(take plan) => take plan,
        Error(c) => return OverLimit(take ran, c)
    }
    Ready(take ran, take publication)
}

fn commit_ran[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Outcome[R, A] {
    let checked = prepare_run_commit(db, i, take ran)
    match take checked {
        Ready(take draft, take publication) => commit_prepared(mut db, i, take draft, take publication),
        OverLimit(_, c) => Refused(c)
    }
}

fn commit_prepared[R, A](mut db: Db, i: u64, take ran: Ran[R, A], take publication: Publication) -> Outcome[R, A] {
    let Ran(value: take value, roots: take roots, live: live, wrote: _, frame: take frame, ops: _, stream_ops: _, call: _, info: ci, reads: take seen) = take ran
    if let Some(_) = db.journal {
        let frame_size = match frame { Some(raw) => list.len(raw), None => 0u64 }
        db.file_end += frame_size
        db.pending = take frame
        db.inflight += frame_size
        db.frame_seq += 1
    }
    db.heads[i].roots = take roots
    db.resident = live
    db.heads[i].head += 1
    db.heads[i].at = ci.at
    db.changes += 1
    publish(take publication)
    let sent_sequence = if list.len(db.disk) == 0 {
        db.changes
    } else {
        db.frame_seq
    }
    let commit_ticket = Ticket(store: db.store, open: open_number(db), mark: Journal(sent_sequence))
    match take value {
        Ok(take v) => Committed(Done(value: take v, ticket: commit_ticket, info: ci, reads: take seen)),
        Error(take a) => Aborted(Undone(value: take a, ticket: Some(commit_ticket)))
    }
}

// I4: past the bound with charges made since the last cut under a pin or a
// branch, settle them by a cut and check again, so a refusal rests on the
// exact figure. The cut rotates the segment, so the frame is encoded again,
// with every section it had.
fn settle_draft[R, A](mut db: Db, i: u64, take ran: Ran[R, A], rec: Option[CallRecord], settlement: Option[Settlement]) -> Result[AdmittedDraft[R, A], Error] waits {
    if !over_bound(db, ran) || !retaining(db) || db.settled == db.changes {
        return Ok(prepare_run_commit(db, i, take ran))
    }
    let publication = match prepare_publication(db, i, db.heads[i].head + 1, ran.roots) {
        Ok(take plan) => take plan,
        Error(c) => return Ok(OverLimit(take ran, c))
    }
    let added = int.saturating_sub(ran.live, db.resident)
    let s = match current_state(db) {
        Ok(take s) => take s,
        Error(c) => return Ok(OverLimit(take ran, c))
    }
    match cut_state(mut db, take s) {
        Ok(_) => {},
        Error(Full(c)) => return Ok(OverLimit(take ran, c)),
        Error(take e) => return Error(take e)
    }
    let mut settled = take ran
    settled.live = int.saturating_add(db.resident, added)
    if let Some(_) = settled.frame {
        match encode_staged(settled.info, settled.ops, settled.stream_ops, settled.call, rec, settlement, db.file_seq, db.file_end) {
            Ok(take raw) => { settled.frame = Some(take raw) },
            Error(c) => return Ok(OverLimit(take settled, c))
        }
    }
    if over_bound(db, settled) {
        let needed = commit_cost(db, settled)
        return Ok(OverLimit(take settled, Capacity(requested: needed, available: db.ceiling)))
    }
    Ok(Ready(take settled, take publication))
}

fn settle_admit[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[Outcome[R, A], Error] waits {
    let no_record: Option[CallRecord] = None
    let checked = settle_draft(mut db, i, take ran, no_record, None)?
    match take checked {
        Ready(take draft, take publication) => Ok(commit_prepared(mut db, i, take draft, take publication)),
        OverLimit(_, c) => Ok(Refused(c)),
    }
}

// Runs and commits without the I4 settle: the S1 laws' direct entry.
fn execute[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] {
    let keep_reply: Option[fn(A) -> bool] = None
    match stage(mut db, i, wall, steps, keep_reply, body) {
        Over(take o) => Ok(take o),
        Ran(take ran) => Ok(commit_ran(mut db, i, take ran))
    }
}

pub fn durable(mut db: Db, t: Ticket) -> Result[(), Error] waits {
    if !same(db.store, t.store) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if let Some(e) = db.poison {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if list.len(db.disk) != 0 {
            return disk_wait_cut(mut db, generation)
        }
    }
    journal_poll(mut db)?
    let has_journal = match db.acks { Some(_) => true, None => false }
    if has_journal {
        while !covered(db, t.mark) {
            let ack = journal_receive(db)
            journal_ack(mut db, take ack)?
        }
    }
    Ok(())
}

fn covered(db: Db, mark: Mark) -> bool {
    match mark {
        Journal(n) => db.journaled >= n,
        Cut(n) => db.checkpointed >= n
    }
}

type PlaceReply[Q, R, A] {
    request: Q,
    outcome: Result[Outcome[R, A], Error],
    ticket: Option[Ticket]
}

fn place_ticket[R, A](outcome: Result[Outcome[R, A], Error]) -> Option[Ticket] {
    match outcome {
        Ok(Committed(done)) => Some(done.ticket),
        Ok(Aborted(undone)) => undone.ticket,
        _ => None
    }
}

// `receive` blocks for the first request and probes for subsequent ready
// requests. One transaction runs per request. Delivery owns the request and
// outcome, so a disconnected client can drop its reply locally.
pub fn write_place[S, Q, R, A](mut db: Db, mut source: S,
    receive: fn(Db, mut S, bool) -> Option[Q] waits,
    body: fn(mut Tx, S, Q) -> Result[R, A],
    deliver: fn(mut S, take Q, take Result[Outcome[R, A], Error]) waits
) -> Result[(), Error] waits {
    let disk = list.len(db.disk) != 0
    let max_frames: u64 = if disk { int.widen(db.disk[0].options.group_commits) } else { 1 }
    let max_bytes: u64 = if disk { int.widen(db.disk[0].options.group_bytes) } else { 0 }
    let mut replies: List[Option[PlaceReply[Q, R, A]]] = capacity(list.with_capacity(max_frames))?
    while let Some(take first) = receive(db, mut source, true) {
        let mut pending_request = Some(take first)
        let mut last: Option[Ticket] = None
        let start = db.acked_bytes + db.inflight
        let mut cut: Result[(), Error] = Ok(())
        while let Some(take request) = replace(mut pending_request, None) {
            let polled = journal_poll(mut db)
            let outcome: Result[Outcome[R, A], Error] = match take polled {
                Error(take e) => Error(take e),
                Ok(()) => append_transaction(mut db, 0, None, None, scoped fn(mut tx: Tx) -> Result[R, A] {
                    body(mut tx, source, request)
                })
            }
            let commit_ticket = place_ticket(outcome)
            if let Some(t) = commit_ticket { last = Some(t) }
            result.unwrap(list.push(mut replies, Some(PlaceReply(request: take request, outcome: take outcome, ticket: commit_ticket))))
            cut = maybe_checkpoint(mut db)
            if let Error(_) = cut { break }
            if let Some(_) = db.poison { break }
            // The journal separates a frame that crosses the byte bound
            // from the preceding group before writing either group.
            if list.len(replies) == max_frames || db.acked_bytes + db.inflight - start >= max_bytes { break }
            pending_request = receive(db, mut source, false)
        }
        let settled = match last { Some(t) => durable(mut db, t), None => healthy(db) }
        if let Error(Poisoned(_)) = settled {
            // A cut can latch poison before durable takes journal acks.
            // Apply any already queued prefix without retrying an I/O.
            let _ = journal_poll(mut db)
        }
        let acked_sequence = db.journaled
        for i in 0u64 .. list.len(replies) {
            let pending = option.unwrap(list.set(mut replies, i, None))
            let PlaceReply(request: take request, outcome: take outcome, ticket: commit_ticket) = take pending
            if let Some(Ticket(store: _, open: _, mark: Journal(sequence))) = commit_ticket {
                if disk && sequence > acked_sequence {
                    deliver(mut source, take request, Error(Poisoned(option.unwrap(db.poison))))
                    continue
                }
            }
            deliver(mut source, take request, take outcome)
        }
        list.clear(mut replies)
        settled?
        cut?
    }
    Ok(())
}

pub fn close(take db: Db) -> Result[(), Error] waits {
    let mut owned = take db
    let mut failure: Option[Error] = None
    if let None = owned.poison {
        if let Some(_) = owned.journal {
            let last_frame = Ticket(store: owned.store, open: open_number(owned), mark: Journal(owned.frame_seq))
            if let Error(take e) = durable(mut owned, last_frame) {
                failure = Some(take e)
            }
        }
        if let Some(p) = disk_pending(owned) {
            match disk_wait_cut(mut owned, p.generation) {
                Error(Full(_)) => {},
                Error(take e) => {
                    failure = Some(take e)
                },
                Ok(()) => {}
            }
        }
    }
    let _ = replace(mut owned.journal, None)
    let writer = replace(mut owned.journal_task, None)
    if let Some(_) = owned.poison { let _ = replace(mut owned.acks, None) }
    if let Some(take worker) = writer {
        match task.join(take worker) {
            Ok(Error(Io(e))) => if let None = owned.poison { owned.poison = Some(e) },
            Ok(Error(take e)) => if let None = failure { failure = Some(take e) },
            Ok(Ok(())) => {},
            // A writer cancelled before its last ack is terminal, as in journal_receive.
            Error(_) => if let None = owned.poison { owned.poison = Some(Closed) }
        }
    }
    while let Some(ack) = close_ack(owned) {
        match ack {
            Broken(e) => if let None = owned.poison {
                owned.poison = Some(e)
            },
            Journaled(n, bytes_out) => {
                owned.journaled = n
                owned.inflight -= bytes_out - owned.acked_bytes
                owned.acked_bytes = bytes_out
            },
            Checkpointed(n, _) => {
                owned.checkpointed = n
            }
        }
    }
    let connections = replace(mut owned.disk, list.new())
    for take link in connections {
        match disk_close_connection(take link) {
            Error(Io(e)) => if let None = owned.poison {
                owned.poison = Some(e)
            },
            Error(take e) => if let None = failure {
                failure = Some(take e)
            },
            Ok(()) => {}
        }
    }
    match owned.poison {
        Some(e) => Error(Poisoned(e)),
        None => match take failure {
            Some(take e) => Error(take e),
            None => Ok(())
        }
    }
}

fn close_ack(db: Db) -> Option[Ack] {
    if let Some(receiver) = db.acks {
        match channel.try_receive(receiver) {
            Ok(ack) => Some(ack),
            Error(_) => None
        }
    } else {
        None
    }
}

fn capacity[T](take r: Result[T, Capacity]) -> Result[T, Error] {
    match take r {
        Ok(take value) => Ok(take value),
        Error(c) => Error(Full(c))
    }
}

fn copied(raw: Bytes) -> Result[Bytes, Error] {
    let c: Result[Bytes, Capacity] = clone(raw)
    capacity(take c)
}

fn prefix(id: u32) -> Result[Bytes, Error] {
    prefixed(id, 0)
}

// The 4-byte big-endian id, in a buffer with room for `rest` more bytes.
fn prefixed(id: u32, rest: u64) -> Result[Bytes, Error] {
    let mut p: Bytes = capacity(list.with_capacity(4 + rest))?
    for i in 0u64 .. 4 {
        let byte: u8 = int.truncate(id >> int.truncate((3 - i) * 8))
        capacity(result.capacity_only(list.push(mut p, byte)))?
    }
    Ok(take p)
}

// One allocation: the key is appended into the prefix's spare capacity.
fn physical(id: u32, key: Bytes) -> Result[Bytes, Error] {
    let mut p = prefixed(id, list.len(key))?
    capacity(list.append(mut p, key))?
    Ok(take p)
}

fn round8(n: u64) -> u64 {
    ((n + 7) / 8) * 8
}

fn entry(key: Bytes, val: Bytes) -> u64 {
    62 + round8(list.len(key)) + round8(list.len(val))
}

pub fn body_capacity(mut tx: Tx, problem: Capacity) {
    tx.refusal = Some(problem)
}

fn refused(mut tx: Tx, c: Capacity) -> Error {
    tx.refusal = Some(c);
    Full(c)
}

// `h` is the height of the tree being written.
fn reserve_ids(mut tx: Tx, h: u64) -> Result[u64, Error] {
    // Record a range before the map can issue an id. Logging after the map
    // would lose its high-water mark if the log append itself were refused.
    // Insert uses <= 2h+1 ids. Remove uses <= 3h, including discarded merge
    // intermediates. Gaps are permitted; 4h+1 covers both operations.
    let start = tx.ids
    let end = start + 4 * h + 1
    match log.append(tx.issued, end) {
        Ok(()) => {
            tx.ids = end;
            Ok(start)
        },
        Error((c, _)) => Error(refused(mut tx, c))
    }
}

fn note_read(tx: Tx, take read: Read) -> Result[(), Error] {
    match log.append(tx.reads, take read) {
        Ok(()) => Ok(()),
        Error((c, _)) => Error(Full(c))
    }
}

fn fetch_bytes(tx: Tx, id: u32, key: Bytes) -> Result[Option[Bytes], Error] {
    let p = physical(id, key)?
    note_read(tx, Point(copied(p)?))?
    match std.omap.get(tx.roots.data, p) {
        Some(v) => Ok(Some(copied(v)?)),
        None => Ok(None)
    }
}

fn put_bytes(mut tx: Tx, id: u32, key: Bytes, val: Bytes) -> Result[(), Error] {
    put_physical(mut tx, physical(id, key)?, copied(val)?)
}

fn put_physical(mut tx: Tx, take p: Bytes, take val: Bytes) -> Result[(), Error] {
    let _ = replace_physical(mut tx, take p, take val)?
    Ok(())
}

fn replace_physical(mut tx: Tx, take p: Bytes, take val: Bytes) -> Result[Option[std.omap.Replaced[Bytes, Arc[Bytes]]], Error] {
    if list.len(p) > 4096 {
        return Error(Limit(Key))
    }
    if list.len(val) > 1048576 {
        return Error(Limit(Value))
    }
    let charge = entry(p, val)
    let frame = int.saturating_add(tx.frame_bytes - old_op_size(tx.ops, p), 9 + list.len(p) + list.len(val))
    let saved_key = copied(p)?
    if int.saturating_add(frame, tx.extra_bytes) - 16 > 16777280 {
        return Error(Limit(Transaction))
    }
    let h = tree_height(tx.roots.data)
    let mut ids = reserve_ids(mut tx, h)?
    let saved_value = copied(val)?
    let shared_value = capacity(result.capacity_only(arc.new(take val)))?
    let updated = std.omap.insert(mut ids, tx.roots.data, take p, take shared_value)
    match take updated {
        Error((c, _)) => Error(refused(mut tx, c)),
        Ok((take data, take replaced)) => {
            let old_charge = if tx.retain_old { 0u64 } else {
                match replaced {
                    Some(old) => entry(saved_key, std.omap.replaced_value(old)),
                    None => 0
                }
            }
            record_op(mut tx, take saved_key, Some(take saved_value))?
            tx.roots.data = take data
            // Main without a retained durable root subtracts the replaced entry (I4).
            tx.resident = int.saturating_add(int.saturating_sub(tx.resident, old_charge), charge)
            tx.frame_bytes = frame
            tx.wrote = true
            Ok(take replaced)
        }
    }
}

fn delete_bytes(mut tx: Tx, id: u32, key: Bytes) -> Result[bool, Error] {
    let p = physical(id, key)?
    let refund = match std.omap.get(tx.roots.data, p) {
        Some(v) => if tx.retain_old { 0u64 } else { entry(p, v) },
        None => return Ok(false)
    }
    let frame = int.saturating_add(tx.frame_bytes - old_op_size(tx.ops, p), 5 + list.len(p))
    if int.saturating_add(frame, tx.extra_bytes) - 16 > 16777280 {
        return Error(Limit(Transaction))
    }
    let h = tree_height(tx.roots.data)
    let mut ids = reserve_ids(mut tx, h)?
    let updated = std.omap.remove(mut ids, tx.roots.data, p)
    match take updated {
        Error(c) => Error(refused(mut tx, c)),
        Ok(take data) => {
            record_op(mut tx, copied(p)?, None)?
            tx.roots.data = take data
            tx.resident = int.saturating_sub(tx.resident, refund)
            tx.frame_bytes = frame
            Ok(true)
        }
    }
}

// The COMMIT frame this Tx encodes (section 2.4). A frame with stream ops and
// no data ops has no data head.
fn tx_frame(tx: Tx) -> u64 {
    let total = int.saturating_add(tx.frame_bytes, tx.extra_bytes)
    if std.omap.len(tx.ops) == 0 && std.omap.len(tx.stream_ops) != 0 { total - 5 } else { total }
}

fn tree_height(m: std.omap.OMap[Bytes, Arc[Bytes]]) -> u64 {
    match std.omap.root(m) {
        None => 0u64,
        Some(n) => std.omap.node_level(n) + 1
    }
}

// Stream value (section 1.8): position u64 LE, state u8 (1 Admitted,
// 2 Replied), then the reply when Replied.
// A request's identity at a stream position (STORE-SPEC v2.24 §1.8, AH1).
// Made only by request_digest or read from a streams value.
pub opaque type RequestDigest: key + shareable + send {
    b: Inline[u8, 32]
}

/// SHA-256 of u8 17 ‖ "hirsel.request.v1" ‖ u32 LE len(key) ‖ key ‖ u32 LE
/// len(args) ‖ args (§1.8): versioned, domain-separated, length-delimited.
/// Alloc: none. Cost: O(key + args).
pub fn request_digest(key: Bytes, args: Bytes) -> RequestDigest {
    let mut h = std.sha256.start()
    let tag = string.as_bytes("hirsel.request.v1")
    std.sha256.add_byte(mut h, int.truncate(list.len(tag)))
    std.sha256.add(mut h, tag, 0, list.len(tag))
    digest_part(mut h, key)
    digest_part(mut h, args)
    RequestDigest(b: std.sha256.finish(h))
}

fn digest_part(mut h: std.sha256.Sha256, part: Bytes) {
    let n = list.len(part)
    for i in 0u64 .. 4 {
        std.sha256.add_byte(mut h, int.truncate(n >> int.truncate(i * 8)))
    }
    std.sha256.add(mut h, part, 0, n)
}

// STORE AL2/AN2. An admit is 41 B, and a reply is followed by the exact
// reply bytes.
pub type Stored { reply: Bytes }

fn stream_bytes(p: u64, request: RequestDigest, replied: bool, answer: Bytes) -> Result[Bytes, Error] {
    let size = if replied { list.len(answer) } else { 0u64 }
    let mut value: Bytes = capacity(list.with_capacity(41 + size))?
    capacity(le(mut value, p, 8))?
    for byte in request.b { capacity(result.capacity_only(list.push(mut value, byte)))? }
    if replied {
        capacity(le(mut value, 2, 1))?
        capacity(list.append(mut value, answer))?
    } else {
        capacity(le(mut value, 1, 1))?
    }
    Ok(take value)
}

fn word_be(raw: Bytes, offset: u64) -> u64 {
    let mut value = 0u64
    for i in 0u64 .. 8 { value = (value << 8) | int.widen(raw[offset + i]) }
    value
}

fn stored_reply(raw: Bytes) -> Result[Stored, Error] {
    Ok(Stored(reply: copied(list.slice(raw, 41, list.len(raw)))?))
}

type StreamState {
    p: u64,
    digest: RequestDigest,
    state: u8
}

fn stream_state(raw: Bytes) -> Result[StreamState, Error] {
    if list.len(raw) < 41 || (raw[40] != 1 && raw[40] != 2) || (raw[40] == 1 && list.len(raw) != 41) {
        return Error(malformed(0))
    }
    let mut b: Inline[u8, 32] = [0u8; 32]
    for i in 0u64 .. 32 {
        b[i] = raw[8 + i]
    }
    Ok(StreamState(p: read_le(raw, 0, 8), digest: RequestDigest(b: b), state: raw[40]))
}

// One write to the streams tree, charged and sized like a data write.
fn stream_write(mut tx: Tx, take key: Bytes, take value: Bytes, call_size: u64) -> Result[(), Error] {
    if list.len(key) > 4096 {
        return Error(Limit(Key))
    }
    if list.len(value) > 1048576 {
        return Error(Limit(Value))
    }
    let head = if std.omap.len(tx.stream_ops) == 0 { 5u64 } else { 0u64 }
    let extra = int.saturating_add(tx.extra_bytes - old_op_size(tx.stream_ops, key), head + 9 + list.len(key) + list.len(value) + call_size)
    let data_head = if std.omap.len(tx.ops) == 0 { 5u64 } else { 0u64 }
    if int.saturating_add(tx.frame_bytes, extra) - data_head - 16 > 16777280 {
        return Error(Limit(Transaction))
    }
    let charge = entry(key, value)
    let h = tree_height(tx.roots.streams)
    let mut ids = reserve_ids(mut tx, h)?
    let saved_key = copied(key)?
    let saved_value = copied(value)?
    let shared_value = capacity(result.capacity_only(arc.new(take value)))?
    let updated = std.omap.insert(mut ids, tx.roots.streams, take key, take shared_value)
    match take updated {
        Error((c, _)) => Error(refused(mut tx, c)),
        Ok((take streams, take replaced)) => {
            let old_charge = if tx.retain_old { 0u64 } else {
                match replaced {
                    Some(old) => entry(saved_key, std.omap.replaced_value(old)),
                    None => 0
                }
            }
            let ops = std.omap.insert(mut tx.op_ids, tx.stream_ops, take saved_key, Some(take saved_value))
            match take ops {
                Ok((take grown, _)) => { tx.stream_ops = take grown },
                Error((c, _)) => return Error(refused(mut tx, c))
            }
            tx.roots.streams = take streams
            tx.resident = int.saturating_add(int.saturating_sub(tx.resident, old_charge), charge)
            tx.extra_bytes = extra
            tx.wrote = true
            Ok(())
        }
    }
}

fn reply_row(tx: Tx, stream: Bytes, p: u64, output: Bytes) -> Result[(Bytes, Bytes), Error] {
    // The reply keeps the digest bound at p (AH1).
    let held = match std.omap.get(tx.roots.streams, stream) {
        Some(raw) => {
            let at = stream_state(raw)?
            if at.p == p && at.state == 1 { Some(at.digest) } else { None }
        },
        None => None
    }
    let d = match held {
        Some(d) => d,
        None => return Error(Missing("reply"))
    }
    let value = stream_bytes(p, d, true, output)?
    Ok((copied(stream)?, take value))
}

fn reply(mut tx: Tx, stream: Bytes, p: u64, take r: Bytes) -> Result[(), Error] {
    let (take key, take value) = reply_row(tx, stream, p, r)?
    stream_write(mut tx, take key, take value, 0)
}

// G1: admit the entire frame before staging either the reply or the CALL.
fn reply_recorded(mut tx: Tx, p: u64, take r: Bytes, take c: CallRecord) -> Result[(), Error] {
    if let Some(_) = tx.call {
        return Error(Exists("call"))
    }
    let (take key, take value) = reply_row(tx, c.stream, p, r)?
    call_checked(c)?
    let size = call_section_bytes(c, false)
    stream_write(mut tx, take key, take value, size)?
    tx.call = Some(CallSection(record: take c, settlement: None))
    Ok(())
}

pub opaque type Completion {
    admitted: Ticket,
    stream: Bytes,
    p: u64,
    request: RequestDigest
}

pub fn ticket(c: Completion) -> Ticket { c.admitted }

pub type Admission = Admitted(Completion) | Duplicate(Stored) | Rejected(u64) | Abandoned(Completion)
    | RequestMismatch | HistoryUnavailable

// An Admitted(p) this open committed on main: a later admit of p while it is
// still unreplied answers Abandoned with this commit_ticket and commits nothing.
// `ticket` is None while the entry is only reserved (admit_commit), and a None
// entry answers nothing.
type OpenAdmit: shareable + send {
    p: u64,
    ticket: Option[Ticket]
}

pub fn admit(mut db: Db, stream: Bytes, p: u64, d: RequestDigest) -> Result[Admission, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let state = match std.omap.get(db.heads[0].roots.streams, stream) {
        Some(raw) => Some(stream_state(raw)?),
        None => None
    }
    let at = match take state {
        Some(x) => x,
        // AE1: a new stream admits position 0 only.
        None => return if p == 0 { admit_commit(mut db, stream, 0, d, false) } else { Ok(Rejected(0)) }
    }
    let latest = at.p
    if p < latest {
        // AH2: one state per stream keeps no digest below latest.
        return Ok(HistoryUnavailable)
    }
    if p > latest {
        // S7: latest + 1 only after latest has its reply.
        return if p == latest + 1 && at.state == 2 { admit_commit(mut db, stream, p, d, false) } else { Ok(Rejected(latest)) }
    }
    // AH1: at latest the digest is compared before any other answer.
    if at.digest != d {
        return Ok(RequestMismatch)
    }
    if at.state == 2 {
        let r = match std.omap.get(db.heads[0].roots.streams, stream) {
            Some(raw) => stored_reply(raw)?,
            None => return Error(malformed(0))
        }
        return Ok(Duplicate(take r))
    }
    let mine = match std.omap.get(db.admits, stream) {
        Some(a) => if a.p == p { a.ticket } else { None },
        None => None
    }
    if let Some(t) = mine {
        return Ok(Abandoned(Completion(admitted: t, stream: copied(stream)?, p: p, request: d)))
    }
    // An earlier open's admit: re-commit, keeping the digest bound at p.
    admit_commit(mut db, stream, p, at.digest, true)
}

fn admit_commit(mut db: Db, stream: Bytes, p: u64, d: RequestDigest, abandoned: bool) -> Result[Admission, Error] waits {
    let held_stream = copied(stream)?
    let key = copied(stream)?
    // §1.8: a later admit of p in this open commits nothing, so the entry that
    // remembers this one is reserved before the commit. Without room the admit
    // is Full and commits nothing; the map is kept as it was.
    let reserved = match std.omap.insert(mut db.admit_ids, db.admits, copied(stream)?, OpenAdmit(p: p, ticket: None)) {
        Ok((take admits, _)) => take admits,
        Error((c, _)) => return Error(Full(c))
    }
    // Dropping the old version leaves every node of the map unshared, so the
    // edit below replaces the reserved entry in place and allocates nothing.
    db.admits = take reserved
    let b = main_branch(db)
    let outcome = run_on(mut db, b, None, fn(mut tx: Tx) -> Result[(), Error] {
        let value = stream_bytes(p, d, false, list.new())?
        stream_write(mut tx, copied(stream)?, take value, 0)
    })?
    let admitted = match take outcome {
        Committed(done) => done.ticket,
        // Ruling 3: an admit over resident_limit is Full.
        Refused(c) => return Error(Full(c)),
        Aborted(Undone(value: take e, ticket: _)) => return Error(take e),
        // The body is the store's own, runs unbounded and does not fault.
        Failed(_) => return Error(Missing("admit")),
        Stopped(_) => return Error(Missing("admit"))
    }
    let filled = std.omap.insert_owned(mut db.admit_ids, replace(mut db.admits, std.omap.new()), take key, OpenAdmit(p: p, ticket: Some(admitted)))
    db.admits = match take filled {
        Ok((take admits, _)) => take admits,
        // The reserved key sits on unshared nodes, so insert_owned edits it in
        // place and cannot fail here.
        Error(_) => fail("admit: reserved entry was shared")
    }
    let completion = Completion(admitted: admitted, stream: take held_stream, p: p, request: d)
    Ok(if abandoned { Abandoned(take completion) } else { Admitted(take completion) })
}

fn lower_bytes(id: u32, limit: Bound[Bytes], high: bool) -> Result[Bytes, Error] {
    match limit {
        Unbounded => prefix(if high {
            id + 1
        } else {
            id
        }),
        Included(k) => {
            let mut p = physical(id, k)?
            if high {
                capacity(result.capacity_only(list.push(mut p, 0u8)))?
            }
            Ok(take p)
        },
        Excluded(k) => {
            let mut p = physical(id, k)?
            if !high {
                capacity(result.capacity_only(list.push(mut p, 0u8)))?
            }
            Ok(take p)
        }
    }
}

fn range_bytes(tx: Tx, id: u32, lo: Bound[Bytes], hi: Bound[Bytes]) -> Result[ByteRows, Error] {
    let low = lower_bytes(id, lo, false)?
    let high = lower_bytes(id, hi, true)?
    note_read(tx, Span(copied(low)?, copied(high)?))?
    byte_cursor(tx.roots.data, Included(take low), high)
}

fn byte_cursor(data: std.omap.OMap[Bytes, Arc[Bytes]], take low: std.omap.Bound[Bytes], high: Bytes) -> Result[ByteRows, Error] {
    match std.omap.range(data, take low, Excluded(copied(high)?)) {
        Ok(take cursor) => Ok(ByteRows(cursor: take cursor)),
        Error((c, _)) => Error(Full(c))
    }
}

fn next_bytes(mut rows: ByteRows) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
    capacity(std.omap.next(mut rows.cursor))
}

fn get_bytes(s: Snapshot, id: u32, key: Bytes) -> Result[Option[Bytes], Error] {
    let p = physical(id, key)?
    match std.omap.get(s.roots.data, p) {
        Some(v) => Ok(Some(copied(v)?)),
        None => Ok(None)
    }
}

fn scan_bytes(s: Snapshot, id: u32, lo: Bound[Bytes], hi: Bound[Bytes]) -> Result[ByteRows, Error] {
    byte_cursor(s.roots.data, Included(lower_bytes(id, lo, false)?), lower_bytes(id, hi, true)?)
}

// Codec-independent S1 law fixtures. Byte keys are fixed-width big endian.
fn key_word(n: u64) -> Bytes {
    let mut b: Bytes = result.unwrap(list.with_capacity(8))
    for i in 0u64 .. 8 {
        result.unwrap(list.push(mut b, int.truncate(n >> int.truncate((7 - i) * 8))))
    }
    b
}

fn decode_word(b: Bytes) -> u64 {
    let mut n: u64 = 0
    for byte in b {
        n = (n << 8) | int.widen(byte)
    }
    n
}

fn test_db(c: Clock, cap: u64) -> Db {
    let mut opts = defaults()
    opts.resident_limit = cap
    memory_at(c, StoreId(hi: 1, lo: 2), opts)
}

fn put_one(mut db: Db, k: u64, v: u64) -> bool {
    let outcome = execute(mut db, 0, 20, None, fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(k), key_word(v))
    })
    match take outcome {
        Ok(Committed(_)) => true,
        _ => false
    }
}

fn value_at(s: Snapshot, k: u64) -> u64 {
    match result.unwrap(get_bytes(s, 1, key_word(k))) {
        Some(raw) => decode_word(raw),
        None => 0
    }
}

// L1: sorted slot model, own writes, abort and fault never change published roots.
// Wrong implementation caught: publish before body success; omit old-root lookup.
pub fn law_model(c: Clock) -> bool {
    for seed in 0u64 .. 2 {
        let mut db = test_db(c, 1073741824)
        let mut model: List[u64] = result.unwrap(list.with_capacity(24))
        result.unwrap(list.fill(mut model, 24, 0u64))
        for step in 0u64 .. 64 {
            let wall = seed * 64 + step
            let state = splitmix64(wall)
            let k = state % 24
            let choice = (state >> 8) % 5
            let v = wall + 1
            let ok = model_step(mut db, wall)
            if !ok {
                return false
            }
            if choice < 3 {
                let _ = list.set(mut model, k, if choice == 0 {
                    0u64
                } else {
                    v
                })
            }
            let held = snapshot(db)
            for at in 0u64 .. 24 {
                if value_at(held, at) != model[at] {
                    return false
                }
            }
        }
    }
    true
}

// L2: an escaped cursor and snapshot retain exactly the transaction's frozen tree.
// Wrong implementation caught: cursor over the current head or in-place mutation.
pub fn law_snapshots(c: Clock) -> bool {
    let mut db = test_db(c, 1073741824)
    for k in 0u64 .. 24 {
        if !put_one(mut db, k, k + 1) {
            return false
        }
    }
    let held = snapshot(db)
    let before = version(held)
    let rows_result = execute(mut db, 0, 30, None, fn(mut tx: Tx) -> Result[ByteRows, Error] {
        let rows = range_bytes(tx, 1, Unbounded, Unbounded)?
        put_bytes(mut tx, 1, key_word(0), key_word(9999))?
        Ok(take rows)
    })
    let mut rows = match take rows_result {
        Ok(Committed(take done)) => {
            let Done(value: take cursor, ticket: _, info: _, reads: _) = take done;
            take cursor
        },
        _ => return false
    }
    for k in 0u64 .. 1000 {
        if !put_one(mut db, k % 24, 10000 + k) {
            return false
        }
    }
    for k in 0u64 .. 24 {
        if value_at(held, k) != k + 1 {
            return false
        }
        match result.unwrap(next_bytes(mut rows)) {
            Some((_, v)) => if decode_word(v) != k + 1 {
                return false
            },
            None => return false
        }
    }
    version(held) == before && result.unwrap(next_bytes(mut rows)) == None
}

// L15: point reads of own writes and the full requested half-open span, in order.
// Wrong implementation caught: missing range record or own-write read record.
pub fn law_reads_ranges(c: Clock) -> bool waits {
    if !range_boundary_points(c) {
        return false
    }
    let mut db = test_db(c, 1073741824)
    for k in 0u64 .. 6 {
        if !put_one(mut db, k, k + 1) {
            return false
        }
    }
    let outcome = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[u64, Error] {
        let _ = fetch_bytes(tx, 1, key_word(1))?
        put_bytes(mut tx, 1, key_word(2), key_word(42))?
        let own = option.unwrap(fetch_bytes(tx, 1, key_word(2))?)
        if decode_word(own) != 42 {
            return Error(Foreign)
        }
        let mut rows = range_bytes(tx, 1, Excluded(key_word(1)), Included(key_word(3)))?
        let mut sum: u64 = 0
        while let Some((_, val)) = next_bytes(mut rows)? {
            sum += decode_word(val)
        }
        Ok(sum)
    })
    match take outcome {
        Ok(Committed(done)) => {
            if done.value != 46 || list.len(done.reads) != 3 {
                return false
            }
            let a = match done.reads[0] {
                Point(k) => k == result.unwrap(physical(1, key_word(1))),
                _ => false
            }
            let b = match done.reads[1] {
                Point(k) => k == result.unwrap(physical(1, key_word(2))),
                _ => false
            }
            let lo = result.unwrap(lower_bytes(1, Excluded(key_word(1)), false))
            let hi = result.unwrap(lower_bytes(1, Included(key_word(3)), true))
            let span = match done.reads[2] {
                Span(l, h) => l == lo && h == hi,
                _ => false
            }
            a && b && span
        },
        _ => false
    }
}

// L18a,b,d: published SplitMix64 vector, backward wall clock, branch in id/seed.
// Wrong implementation caught: seed=0, raw clock, branch omitted from the id.
pub fn law_call_info(c: Clock) -> bool {
    if !seed_boundary_points() {
        return false
    }
    if splitmix64(0) != 0xE220A8397B1DCDAFu64 {
        return false
    }
    let id = StoreId(hi: 1, lo: 2)
    let a = call_info(id, 0, 1, 30, 0)
    let b = call_info(id, 1, 1, 20, 0)
    if a.seed != 0xC817A9BF84F9A191u64 || a.id.branch == b.id.branch || a.seed == b.seed {
        return false
    }
    let mut db = test_db(c, 1073741824)
    for wall in 0u64 .. 4 {
        let outcome = execute(mut db, 0, 30 - wall, None, fn(mut tx: Tx) -> Result[u64, ()] {
            Ok(info(mut tx).at)
        })
        match take outcome {
            Ok(Committed(done)) => if done.value != 30 || done.info.at != 30 {
                return false
            },
            _ => return false
        }
    }
    true
}

// Resident: exact entry arithmetic, ignored operation failure still refuses a commit.
// Wrong implementation caught: charge payload alone or publish beyond the ceiling.
pub fn law_resident(c: Clock) -> bool {
    if !resident_rounding_points() {
        return false
    }
    let mut db = test_db(c, 86)
    if !put_one(mut db, 1, 10) || db.resident != 86 {
        return false
    }
    let refused_write = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(2), key_word(20))
    })
    match take refused_write {
        Ok(Refused(cap)) => if cap.requested != 172 || cap.available != 86 {
            return false
        },
        _ => return false
    }
    if value_at(snapshot(db), 2) != 0 || db.heads[0].head != 1 {
        return false
    }
    let removed = execute(mut db, 0, 2, None, fn(mut tx: Tx) -> Result[bool, Error] {
        delete_bytes(mut tx, 1, key_word(1))
    })
    match take removed {
        Ok(Committed(done)) => if !done.value {
            return false
        },
        _ => return false
    }
    db.resident == 0 && value_at(snapshot(db), 1) == 0
}

// L20's byte-core handle boundary; typed handles await S0's reader ruling.
pub fn law_foreign(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let stores: Inline[StoreId, 3] =[StoreId(hi: 9, lo: 2), StoreId(hi: 1, lo: 9), StoreId(hi: 9, lo: 9)]
    for i in 0u64 .. 3 {
        let foreign = Branch(store: stores[i], id: 0)
        let outcome = run_on(mut db, foreign, None, fn(mut tx: Tx) -> Result[(), ()] {
            fail("foreign body must not run")
        })
        match take outcome {
            Error(Foreign) => if db.heads[0].head != 0 {
                return false
            },
            _ => return false
        }
    }
    true
}

fn model_step(mut db: Db, wall: u64) -> bool {
    let outer_choice = (splitmix64(wall) >> 8) % 5
    let outcome = execute(mut db, 0, wall, None, fn(mut tx: Tx) -> Result[u64, Error] {
        let at = info(mut tx).at
        let state = splitmix64(at)
        let choice = (state >> 8) % 5
        let k = state % 24
        let v = at + 1
        if choice == 0 {
            let _ = delete_bytes(mut tx, 1, key_word(k))?
        } else {
            put_bytes(mut tx, 1, key_word(k), key_word(v))?
            let raw = option.unwrap(fetch_bytes(tx, 1, key_word(k))?)
            if decode_word(raw) != v {
                return Error(Missing("law"))
            }
        }
        if choice == 3 {
            return Error(Foreign)
        }
        if choice == 4 {
            fail("L1 injected fault")
        }
        Ok(1)
    })
    match take outcome {
        Ok(Committed(_)) => outer_choice < 3,
        Ok(Aborted(Undone(value: Foreign, ticket: None))) => outer_choice == 3,
        Ok(Failed(_)) => outer_choice == 4,
        _ => false
    }
}


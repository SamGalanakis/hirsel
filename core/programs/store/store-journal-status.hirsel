type Backend = DirBackend(journal.DirJournalState) | ObjectBackend(ObjectJournalQueue)

type ObjectJournalQueue {
    file_seq: u64,
    file_end: u64,
    journal: Sender[JournalMsg],
    acks: Receiver[journal.Ack],
    accounting: journal.QueueAccounting,
    written: Receiver[journal.WriteNotice],
    written_send: Sender[journal.WriteNotice],
    synced: Option[Receiver[()]],
    writer: Task[Result[(), Error]],
    timer: Option[Task[()]]
}

type JournalSender = Dir(Sender[journal.DirJournalMsg]) | Object(Sender[JournalMsg])

fn journal_sender(state: DiskState) -> JournalSender {
    match state.backend {
        DirBackend(directory) => Dir(channel.sender(journal.dir_sender(directory))),
        ObjectBackend(queue) => Object(channel.sender(queue.journal)),
    }
}

fn dir_state(state: DiskState) -> View[journal.DirJournalState] in state {
    match state.backend {
        DirBackend(directory) => view directory,
        ObjectBackend(_) => fail("store: a Directory journal is required"),
    }
}

fn object_sender(state: DiskState) -> View[Sender[JournalMsg]] in state {
    match state.backend {
        ObjectBackend(queue) => view queue.journal,
        DirBackend(_) => fail("store: an Object journal is required"),
    }
}

fn disk_directory(state: DiskState) -> Option[Dir] {
    match state.backend {
        DirBackend(directory) => Some(journal.directory(directory)),
        ObjectBackend(_) => None,
    }
}

fn file_seq(db: Db) -> u64 {
    match db.disk {
        Some(state) => match state.backend {
            DirBackend(directory) => journal.segment_seq(directory),
            ObjectBackend(queue) => queue.file_seq,
        },
        None => 1,
    }
}

fn file_end(db: Db) -> u64 {
    match db.disk {
        Some(state) => match state.backend {
            DirBackend(directory) => journal.segment_end(directory),
            ObjectBackend(queue) => queue.file_end,
        },
        None => 72,
    }
}

fn stage_disk_frame(mut state: DiskState, size: u64, take frame: Option[Bytes]) {
    match state.backend {
        DirBackend(mut directory) => {
            journal.advance_offset(mut directory, size)
            journal.stash_frame(mut directory, take frame)
        },
        ObjectBackend(mut queue) => {
            queue.file_end += size
            queue.accounting.pending = take frame
        },
    }
}

fn queue_accounting(state: DiskState) -> View[journal.QueueAccounting] in state {
    match state.backend {
        DirBackend(directory) => journal.dir_accounting(directory),
        ObjectBackend(queue) => view queue.accounting,
    }
}

fn edit_accounting[R](mut state: DiskState, edit: scoped fn(mut journal.QueueAccounting) -> R) -> R {
    match state.backend {
        DirBackend(mut directory) => journal.edit_accounting(mut directory, edit),
        ObjectBackend(mut queue) => edit(mut queue.accounting),
    }
}

fn journal_barrier(state: DiskState) waits {
    match journal_sender(state) {
        Dir(take sender) => {
            let _ = channel.send(sender, Barrier)
        },
        Object(take sender) => {
            let _ = channel.send(sender, Barrier)
        },
    }
}

fn journal_written(state: DiskState) -> View[Receiver[journal.WriteNotice]] in state {
    match state.backend {
        DirBackend(directory) => journal.dir_written(directory),
        ObjectBackend(queue) => view queue.written,
    }
}

fn journal_written_send(state: DiskState) -> View[Sender[journal.WriteNotice]] in state {
    match state.backend {
        DirBackend(directory) => journal.dir_written_send(directory),
        ObjectBackend(queue) => view queue.written_send,
    }
}

fn dir_ack(ack: journal.DirAck) -> journal.Ack {
    match ack {
        DirJournaled(seq, written) => Journaled(seq, written),
        DirBroken(e) => Broken(e),
    }
}

fn try_journal_receive(state: DiskState) -> Result[journal.Ack, ReceiveError] {
    match state.backend {
        DirBackend(directory) => match channel.try_receive(journal.dir_acks(directory)) {
            Ok(ack) => Ok(dir_ack(ack)),
            Error(e) => Error(e),
        },
        ObjectBackend(queue) => channel.try_receive(queue.acks),
    }
}

// Under §12.11.10 ("Tickets at the latch"), every outstanding ticket of an
// attached Db ends `Undecided` when its stream latches (even under Superseded).
fn durable_latch_error(take e: Error) -> Error {
    match take e {
        Latched(_) => Undecided,
        other => other,
    }
}

// A writer that ended without its ack (cancelled before it could send
// Broken) is a terminal failure: the place stops, unacked sequences unanswered.
fn journal_receive(db: Db) -> journal.Ack waits {
    match disk_state(db).backend {
        DirBackend(directory) => match channel.receive(journal.dir_acks(directory)) {
            Ok(ack) => dir_ack(ack),
            Error(_) => Broken(Closed),
        },
        ObjectBackend(queue) => match channel.receive(queue.acks) {
            Ok(ack) => ack,
            Error(_) => Broken(Closed),
        },
    }
}

fn journal_flush(db: Db) waits {
    if let DirBackend(directory) = disk_state(db).backend {
        journal.flush_directory(directory)
    }
}

/// Asks a Directory journal to end its open group now instead of at its gather
/// deadline (L94), without waiting for the sync. A caller that waits on
/// `sync_notices` for a commit `durable_now` found unsynced calls this before it
/// parks: no other arrival may come to end the group (RUNNER-SPEC H3). Other
/// stores do nothing: their syncs never wait on a deadline.
pub fn request_sync(db: Db) waits {
    if is_disk(db) {
        journal_flush(db)
    }
}

fn wait_for_frame_room(mut db: Db, frame: Option[Bytes]) -> Result[(), Error] waits {
    if let Some(raw) = frame {
        let size = list.len(raw)
        if queue_accounting(disk_state(db)).inflight > db.limits.frame - size {
            journal_flush(db)
        }
        while queue_accounting(disk_state(db)).inflight > db.limits.frame - size {
            let acknowledged = journal_receive(db)
            journal_ack(mut db, take acknowledged)?
        }
    }
    Ok(())
}

// The worker sends one Journaled ack after each successful group sync.
fn durable_groups(mut db: Db, t: Ticket) -> Result[u64, Error] waits {
    if !types.same(db.store.hi, db.store.lo, t.store.hi, t.store.lo) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(0)
    }
    if let Some(e) = journal_poison(db) {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if is_disk(db) {
            disk_wait_cut(db, generation)?
            return Ok(0)
        }
    }
    let drained = journal_poll_groups(mut db)
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(match drained {
            Ok(groups) => groups,
            Error(_) => 0u64
        })
    }
    let mut groups = drained ?=> durable_latch_error
    if is_disk(db) {
        if !covered(db, t.mark) {
            journal_flush(db)
        }
        while !covered(db, t.mark) {
            let ack = journal_receive(db)
            journal_ack(mut db, take ack) ?=> durable_latch_error
            groups += 1
        }
    }
    Ok(groups)
}

fn journal_ack(mut db: Db, take ack: journal.Ack) -> Result[(), Error] {
    write_disk(mut db.disk, take ack, scoped fn(mut state: DiskState, take incoming: journal.Ack) -> Result[(), Error] {
        match take incoming {
            Journaled(n, bytes_out) => {
                edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) {
                    queue.journaled = n
                    queue.inflight -= bytes_out - queue.acked_bytes
                    queue.acked_bytes = bytes_out
                })
                Ok(())
            },
            ObjectJournaled(n, bytes_out, journal_entries) => {
                edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) {
                    queue.journaled = n
                    queue.inflight -= bytes_out - queue.acked_bytes
                    queue.acked_bytes = bytes_out
                })
                if let Some(mut object_writer) = state.object {
                    object_writer.entries = journal_entries
                }
                Ok(())
            },
            ObjectBroken(take reported) => {
                let problem = failure_from_rep(take reported)
                let terminal: Error = clone(problem)
                if let Some(mut object_writer) = state.object {
                    object_writer.failed = Some(take terminal)
                }
                Error(take problem)
            },
            Broken(e) => {
                edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) -> Result[(), Error] {
                    if let None = queue.poison {
                        queue.poison = Some(e)
                    }
                    Error(Poisoned(option.unwrap(queue.poison)))
                })
            },
        }
    })
}

fn journal_poll(mut db: Db) -> Result[(), Error] {
    let _ = journal_poll_groups(mut db)?
    Ok(())
}

fn journal_poll_groups(mut db: Db) -> Result[u64, Error] {
    let mut groups = 0u64
    while let Some(take ack) = close_ack(db) {
        journal_ack(mut db, take ack)?
        groups += 1
    }
    healthy(db)?
    Ok(groups)
}

fn open_directory(tasks: Tasks, d: Dir, c: Clock, r: Random, options: Options, cadence_spec: journal.JournalCadence) -> Result[Db, Error] waits {
    if let Bucket(_) = options.authority {
        return Error(Unsupported(1))
    }
    open_checks(options)?
    let session = disk_session(d, c, r, options)?
    open_started(tasks, d, c, options, cadence_spec, take session)
}

fn journal_poison(db: Db) -> Option[IoError] {
    match db.disk {
        Some(state) => queue_accounting(state).poison,
        None => None,
    }
}

fn drain_close_journal(mut db: Db) -> Result[(), Error] waits {
    if let Some(_) = journal_poison(db) {
        return Ok(())
    }
    let last_frame = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    durable(mut db, last_frame)
}

pub fn close(take db: Db) -> Result[(), Error] waits {
    let mut owned = take db
    if !is_disk(owned) {
        return Ok(())
    }
    let mut failure: Option[Error] = None
    if let Error(take e) = drain_close_journal(mut owned) {
        failure = Some(take e)
    }
    if let None = failure {
        let (attached, has_sealed) = match owned.disk {
            Some(state) => match state.object {
                Some(w) => (w.attached, w.has_sealed),
                None => (false, false),
            },
            None => (false, false),
        }
        if attached {
            let settled = if has_sealed {
                object_cut_close(mut owned)
            } else {
                object_stream_close(mut owned)
            }
            if let Error(take e) = settled {
                failure = Some(take e)
            }
        }
    }
    teardown_hook(owned)
    let connection = replace(mut owned.disk, None)
    pages.release_heads(mut owned.holders)
    list.clear(mut owned.followers)
    let DiskState(backend: take backend, tiered: take tiered, object: take object_writer, ..) = option.unwrap(take connection)
    // A Reader may still hold the pager's requests, so the pager is cancelled
    // rather than waited for once the store's sender is dropped.
    clear_parked(mut owned)
    pager.close_requests(mut owned.pager)
    let mut closing_tiered = take tiered
    let pager_task = pager.take_worker(mut closing_tiered)
    if let Some(take running) = take pager_task {
        let mut pager_link = take running
        task.cancel(mut pager_link)
        let _ = task.join(take pager_link)
    }
    let queue = match take backend {
        ObjectBackend(take queue) => take queue,
        DirBackend(take directory) => {
            let prior: Option[types.Failure] = match take failure {
                Some(take e) => Some(failure_to_rep(take e)),
                None => None,
            }
            return failure_result_from_rep(journal.close_directory(take directory, take prior))
        },
    }
    let ObjectJournalQueue(journal: take frames, acks: take acknowledgements, writer: take writer, timer: take timer, written: take notices, written_send: take notice_to, accounting: take accounting, ..) = take queue
    if let Some(take running) = take timer {
        let mut t = take running
        task.cancel(mut t)
        let _ = task.join(take t)
    }
    let _ = take frames
    let mut poison = accounting.poison
    let remaining: Option[Receiver[journal.Ack]] = if let Some(_) = poison {
        let _ = take acknowledgements
        None
    } else {
        Some(take acknowledgements)
    }
    match task.join(take writer) {
        Ok(Error(Io(e))) => if let None = poison {
            poison = Some(e)
        },
        Ok(Error(take e)) => if let None = failure {
            failure = Some(take e)
        },
        Ok(Ok(())) => (),
        Error(_) => if let None = poison {
            poison = Some(Closed)
        },
    }
    if let Some(receiver) = remaining {
        while let Ok(ack) = channel.try_receive(receiver) {
            if let Broken(e) = ack {
                if let None = poison {
                    poison = Some(e)
                }
            }
        }
    }
    let _ = take notices
    let _ = take notice_to
    if let Some(ObjectWriterState(terminal: take terminal, watch: take watch, ..)) = take object_writer {
        let _ = take terminal
        if let Some(take live_watch) = take watch {
            let _ = task.join(take live_watch)
        }
    }
    match poison {
        Some(e) => Error(Poisoned(e)),
        None => match take failure {
            Some(take e) => Error(take e),
            None => Ok(()),
        },
    }
}

fn close_ack(db: Db) -> Option[journal.Ack] {
    let Some(state) = view db.disk else {
        return None
    }
    match try_journal_receive(state) {
        Ok(ack) => Some(ack),
        Error(_) => None,
    }
}

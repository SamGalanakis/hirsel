pub type TieredTarget: shareable + send = TieredPage(std.page.PagePtr) | TieredBlob(std.page.BlobRef)

pub type TieredFrameId: key {
    pack: u64,
    offset: u64,
    kind: u16,
    len: u64,
    checksum: u64,
    stamp: u64
}

pub type TieredPayload: shareable + send = TieredImage(Arc[std.page.Page]) | TieredValue(Arc[Bytes])

pub type TieredFrame: shareable + send {
    identity: TieredFrameId,
    payload: TieredPayload
}

pub fn tiered_frame_id(target: TieredTarget) -> TieredFrameId {
    match target {
        TieredPage(ptr) => TieredFrameId(pack: ptr.pack, offset: ptr.offset, kind: 0x0021, len: int.widen(ptr.len), checksum: ptr.checksum, stamp: ptr.stamp),
        TieredBlob(reference) => TieredFrameId(pack: reference.pack, offset: reference.offset, kind: 0x0022, len: 8 + reference.len, checksum: reference.checksum, stamp: reference.stamp),
    }
}

pub fn verify_tiered_edge(path: String, target: TieredTarget, found: TieredFrameId) -> Result[(), types.Failure] {
    let expected = tiered_frame_id(target)
    if found != expected {
        return Error(disk_fault(path, expected.offset, Checksum))
    }
    Ok(())
}

// OpenSSL built the TBSCertificate. The signature comes from an independent
// RFC 6979 HMAC-SHA256 calculation under A.2.5's private key.
// expect: run self_signed_der_matches_reference() = true
fn self_signed_der_matches_reference() -> bool {
    let seed = option.unwrap(hex.decode(b"c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721"))
    let r = provide.random_tape(take seed)
    let mut point: Bytes = list.with_capacity(65)
    let key = result.unwrap(secret.p256_key(r, "sign(p256)", mut point))
    let start = option.unwrap(time.from_unix(1704067200, 0))
    let end = option.unwrap(time.from_unix(2524608000, 0))
    let der = result.unwrap(x509_build.self_signed_p256(key, r, point, 128, "media.test", start, end))
    der == option.unwrap(hex.decode(b""))
}

@test
fn fl20_error_buffer() -> Result[(), ()] {
    let mut e = error_buffer()
    e[0] = 1
    for i in 4u64 .. 260u64 {
        e[i] = b'a'
    }
    let full = read_error(e)
    if full.code != 1 || string.byte_len(full.message) != 256 {
        return Error(())
    }
    for byte in string.as_bytes(full.message) {
        if byte != b'a' {
            return Error(())
        }
    }
    e[0] = 0x0a
    e[1] = 0x04
    if read_error(e).code != 1034 {
        return Error(())
    }
    for i in 0u64 .. 4u64 {
        e[i] = 0xff
    }
    if read_error(e).code != -1 {
        return Error(())
    }
    e[4] = 0xc3
    e[5] = 0x28
    e[6] = 0
    if read_error(e).message != "sqlite: error text is not UTF-8" {
        return Error(())
    }
    e[4] = 0
    if read_error(e).message != "sqlite: no error text" {
        return Error(())
    }
    Ok(())
}

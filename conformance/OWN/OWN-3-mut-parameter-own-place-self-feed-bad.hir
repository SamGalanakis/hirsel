// rule: OWN-3
// expect: reject OWN-3 at line 8
// twin: MODE/MODE-1-mut-parameter-own-place-ok.hir
// Dropping the access loan on a `mut` argument's own place does not let it be lent
// while it is iterated.
fn grow(xs: List[Bytes], mut out: List[Bytes] in xs) -> () uses {} {
  for x in out {
    list.push(mut out, copy x)
  }
}

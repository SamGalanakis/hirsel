sig g3 = (u64, ptr) -> (u64, u8, u32, u64)
sig g4 = (u64) -> (u8, u64, u64, u64)
sig g5 = (u64, ptr, u8) -> (u64, u8, u32, u64)
sig g6 = (u64) -> (u64, u8, u32, u64)
sig g7 = (u64, u64) -> (u64, u8)
inst n0 = samples@0/providers/echo [] []
inst n1 = samples@0/providers/files [] []
inst n2 = samples@0/providers/temp [] []

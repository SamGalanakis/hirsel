fn sparse_webm_tracks() waits {
    let bytes_before_cluster = sparse_webm_fixture()
    let limits = probe.Limits(metadata_bytes: 4096, top_elements: 6, tracks: 2)
    let parsed = result.unwrap(probe.video_probe(1085, limits, scoped fn(at: u64, n: u64) -> Result[Bytes, probe.Error] {
        if at + n > list.len(bytes_before_cluster) {
            fail("WebM probe fetched a Cluster body")
        }
        let mut raw: Bytes = list.with_capacity(n)
        list.append(mut raw, list.slice(bytes_before_cluster, at, at + n))
        Ok(take raw)
    }))
    let WebmVod(take stream) = take parsed else {
        fail("WebM was not recognized")
    }
    let info = webm.probe_info(stream)
    if info.file_size != 1085 || info.timestamp_scale != 1000000 || webm.probe_tracks(stream) != 1 || !float.eq(option.unwrap(info.duration_ticks), 260.0) {
        fail("WebM duration or track count")
    }
    result.unwrap(webm.probe_track(stream, 0, scoped fn(format: webm.WebmFormat, codec: Bytes, _config: Bytes) {
        if codec != b"A_OPUS" || format.channels != 1 || !float.eq(option.unwrap(format.sample_rate), 48000.0) {
            fail("WebM audio format")
        }
    }))
}

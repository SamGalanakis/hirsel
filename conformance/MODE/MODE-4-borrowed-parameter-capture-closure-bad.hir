// rule: MODE-4
// expect: reject MODE-4 at line 12
// twin: MODE/MODE-4-borrowed-parameter-capture-closure-ok.hir
// A closure borrowing a parameter is received with the parameter's own row,
// but the closure's sendability still comes from what it captures: borrowing
// a counted value that is not unique keeps it from crossing.
fn run(k: u64, f: sendable fn() -> u64) -> u64 {
  k + f()
}

fn probe(xs: List[u64]) -> u64 {
  run(
    1u64,
    fn() -> u64 {
      list.len(xs)
    }
  )
}

// R5's entry: it replies with row 9 as its base holds it and with its
// CallInfo, and writes the CallInfo. `forced` replaces info(mut tx);
// `extra` adds one more write.
fn info_entry(mut tx: Tx, t: Table[u64, u64], forced: Option[CallInfo], extra: bool) -> Result[Bytes, Bytes] {
    let ci = match forced {
        Some(given) => given,
        None => info(mut tx),
    }
    let before = match result.unwrap(fetch(tx, shape(t), 9)) {
        Some(n) => n,
        None => 0u64,
    }
    result.unwrap(put(mut tx, t, 1, ci.at))
    result.unwrap(put(mut tx, t, 2, ci.seed))
    result.unwrap(put(mut tx, t, 3, ci.id.version))
    if extra {
        result.unwrap(put(mut tx, t, 4, 1))
    }
    let mut output: Bytes = list.new()
    for word in [before, ci.at, ci.seed, ci.id.version] {
        result.unwrap(le(mut output, word, 8))
    }
    Ok(take output)
}

fn set_row(mut db: Db, t: Table[u64, u64], k: u64, v: u64) -> bool waits {
    match result.unwrap(run(mut db, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, k, v)
    })) {
        Committed(_) => true,
        _ => false,
    }
}

fn verdict_is(got: Verdict, want: Verdict) -> bool {
    verdict_code(got) == verdict_code(want)
}

fn verdict_code(v: Verdict) -> u8 {
    match v {
        Same => 0u8,
        Different(Reply) => 1u8,
        Different(Writes) => 2u8,
        Unknown(StateGone) => 3u8,
        _ => 9u8,
    }
}

fn reexecute_admit(mut db: Db, stream: u64) -> (Completion, CallRecord) waits {
    let key = key_word(stream)
    let record = call_for(key, 32)
    let admitted = result.unwrap(admit(mut db, key, 0, request_digest(record.key, record.args)))
    let Admitted(take complete) = take admitted else {
        fail("re-execution law: expected an admitted call")
    }
    result.unwrap(durable(mut db, ticket(complete)))
    (take complete, take record)
}

fn reexecute_error_entry(mut tx: Tx, t: Table[u64, u64]) -> Result[Bytes, Bytes] {
    result.unwrap(put(mut tx, t, 9, 99))
    Error(key_word(17))
}

// §7 Kept: the error reply survives with its CALL, and the staged row does not.
fn reexecute_kept(mut db: Db, t: Table[u64, u64], plan: Plan) -> bool waits {
    let (take complete, take record) = reexecute_admit(mut db, 56)
    let served = serve(mut db, take complete, plan, Some(take record), scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
        reexecute_error_entry(mut tx, t)
    })
    let Ok(Kept(receipt)) = take served else {
        return false
    }
    result.unwrap(durable(mut db, receipt.ticket))
    if result.unwrap(get(snapshot(db), shape(t), 9)) != Some(8u64) {
        return false
    }
    let v = version(snapshot(db))
    let line = main_branch(db)
    let failed = scoped fn(_stop: Stop) -> Bytes {
        key_word(0)
    }
    let kept = result.unwrap(reexecute(db, line, v, plan, failed, scoped fn(_call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        reexecute_error_entry(mut tx, t)
    }))
    let same_without_writes = result.unwrap(reexecute(db, line, v, plan, failed, scoped fn(_call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        Ok(key_word(17))
    }))
    let changed = result.unwrap(reexecute(db, line, v, plan, failed, scoped fn(_call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        Error(key_word(18))
    }))
    verdict_is(kept, Same) && verdict_is(same_without_writes, Same) && verdict_is(changed, Different(Reply))
}

fn reexecute_fault_bytes(stop: Stop) -> Bytes {
    match stop {
        Raised(kind) => key_word(int.widen(kind)),
        _ => key_word(0),
    }
}

fn reexecute_fault_entry(mut tx: Tx, t: Table[u64, u64]) -> Result[Bytes, Bytes] {
    if result.unwrap(fetch(tx, shape(t), 9)) == Some(8u64) {
        result.unwrap(put(mut tx, t, 10, 1))
        fail("re-execution law: raised from the attempted base")
    }
    Ok(key_word(5))
}

// §7 Failed: two commits intervene between the attempt's base and conclude.
// The re-run must use that base and CallInfo, and must raise the same fault.
fn reexecute_failed(mut db: Db, t: Table[u64, u64], plan: Plan) -> bool waits {
    let (take complete, take record) = reexecute_admit(mut db, 57)
    let served = serve(mut db, take complete, plan, Some(take record), scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
        reexecute_fault_entry(mut tx, t)
    })
    // RUNNER-SPEC §1.1 assigns 5 to Fail.
    let Ok(Failed(take pending_run, Raised(5))) = take served else {
        return false
    }
    let attempted = pending_run.attempted
    if result.unwrap(get(snapshot(db), shape(t), 10)) != None {
        return false
    }
    if !set_row(mut db, t, 9, 10) || !set_row(mut db, t, 9, 11) {
        return false
    }
    let concluded = conclude(mut db, take pending_run, key_word(5), Resident)
    let Ok(Committed(receipt)) = take concluded else {
        return false
    }
    result.unwrap(durable(mut db, receipt.ticket))
    let v = version(snapshot(db))
    let line = main_branch(db)
    let fault = result.unwrap(reexecute(db, line, v, plan, reexecute_fault_bytes, scoped fn(_call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        let ci = info(mut tx)
        let same_id = same(ci.id.store, attempted.id.store) && ci.id.branch == attempted.id.branch && ci.id.version == attempted.id.version
        if !same_id || ci.at != attempted.at || ci.seed != attempted.seed {
            return Error(key_word(1))
        }
        reexecute_fault_entry(mut tx, t)
    }))
    let different_fault = result.unwrap(reexecute(db, line, v, plan, reexecute_fault_bytes, scoped fn(_call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        let absent: Option[Bytes] = None
        Ok(option.unwrap(take absent))
    }))
    let returned = result.unwrap(reexecute(db, line, v, plan, reexecute_fault_bytes, scoped fn(_call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        Ok(key_word(5))
    }))
    verdict_is(fault, Same) && verdict_is(different_fault, Different(Reply)) && verdict_is(returned, Different(Reply))
}

// R5: an entry whose reply and writes are its info(mut tx) fields, re-executed
// after later commits changed its input row, compares Same live and after a
// journal-replay reopen; under the fork's CallInfo it compares Different(Reply),
// and with one more write Different(Writes). Once a cut covers it, StateGone.
// Oracle: the recorded run's own reply and frame.
pub fn disk_law_reexecute_info(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = disk_test_directory(d)
    let mut db = result.unwrap(open(tasks, dir, c, r, result.unwrap(sized(Directory, 2147483648u64))))
    result.unwrap(create_table(mut db, spec("info", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "info", std.codec.key_u64(), std.codec.of_u64()))
    if !set_row(mut db, t, 9, 7) {
        return false
    }
    let (take complete, take rec) = reexecute_admit(mut db, 55)
    let plan = Plan(n_e: 65536, s_e: 65536, reply_max: 4096)
    let served = serve(mut db, take complete, plan, Some(take rec), scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
        info_entry(mut tx, t, None, false)
    })
    let Ok(Committed(receipt)) = take served else {
        return false
    }
    result.unwrap(durable(mut db, receipt.ticket))
    let v = version(snapshot(db))
    if !set_row(mut db, t, 9, 8) || !set_row(mut db, t, 1, 0) {
        return false
    }
    let head = snapshot(db)
    let (probe, _) = result.unwrap(fork(mut db, "probe", head))
    let forked = call_info(db.store, probe.id, version(snapshot(db)) + 1, 0, 0)
    let failed = scoped fn(_stop: Stop) -> Bytes {
        key_word(0)
    }
    let line = main_branch(db)
    let honest = result.unwrap(reexecute(db, line, v, plan, failed, scoped fn(call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        info_entry(mut tx, t, None, false)
    }))
    let moved = result.unwrap(reexecute(db, line, v, plan, failed, scoped fn(call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        info_entry(mut tx, t, Some(forked), false)
    }))
    let wider = result.unwrap(reexecute(db, line, v, plan, failed, scoped fn(call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        info_entry(mut tx, t, None, true)
    }))
    if !verdict_is(honest, Same) || !verdict_is(moved, Different(Reply)) || !verdict_is(wider, Different(Writes)) {
        return false
    }
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, dir, c, r, result.unwrap(sized(Directory, 2147483648u64))))
    let again = result.unwrap(reexecute(reopened, main_branch(reopened), v, plan, failed, scoped fn(call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        info_entry(mut tx, t, None, false)
    }))
    let _ = result.unwrap(checkpoint(mut reopened))
    let gone = result.unwrap(reexecute(reopened, main_branch(reopened), v, plan, failed, scoped fn(call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        info_entry(mut tx, t, None, false)
    }))
    let replayed = verdict_is(again, Same) && verdict_is(gone, Unknown(StateGone))
    let cases = replayed && reexecute_kept(mut reopened, t, plan) && reexecute_failed(mut reopened, t, plan)
    result.unwrap(close(take reopened))
    cases
}

@test
fn disk_test_reexecute_info(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_reexecute_info(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

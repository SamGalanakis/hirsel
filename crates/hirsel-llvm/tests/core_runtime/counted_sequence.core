; A chain of counted nodes, each owning a List of its predecessor.
core v1
type t0 = own "Node" { kids: seq rc t0 }
sig g0 = (u64) -> (u64)
inst n0 = llvm@1/counts/sequence_chain [] []
fn f0 = n0 g0 {
  addr a0 = v4 byte v2 : ptr
  addr a1 = v4 byte v3 : u64
  addr a2 = v4 byte v6 : u64
  addr a3 = v12 : ptr
  addr a4 = v14 byte v2 : ptr
  addr a5 = v14 byte v3 : u64
  addr a6 = v14 byte v6 : u64
b0(v0: u64):
  v1: u64 = const 32
  v2: u64 = const 8
  v3: u64 = const 16
  v4: ptr, v5: u64 = alloc for rc t0 v1 align 8 charge v1
  v6: u64 = const 24
  v7: u64 = const 0
  v8: ptr = const 0x0
  address a0
  address a1
  address a2
  store a0, v8
  store a1, v7
  store a2, v7
  jump b1(v7, v4)
b1(v9: u64, v10: ptr):
  v11: bool = lt v9, v0
  branch v11, b2, b3
b2:
  v12: ptr, v13: u64 = alloc for seq rc t0 v2 align 8 charge v2
  address a3
  store a3, v10
  v14: ptr, v15: u64 = alloc for rc t0 v1 align 8 charge v1
  address a4
  address a5
  address a6
  v16: u64 = const 1
  store a4, v12
  store a5, v16
  store a6, v16
  v17: u64 = wrapping_add v9, v16
  jump b1(v17, v14)
b3:
  release v10 rc t0
  return v9
}

/// bug: Reads mdat during probe, applies the first chunk offset to the wrong track, or loses composition time and AAC priming.
/// oracle: FFmpeg HEVC/AAC VOD mux and ffprobe stream, packet and edit metadata.
@test
fn sparse_vod_sample_tables() -> Result[(), ()] waits {
    let movie = vod_fixture()
    let moov_at = 2147483648u64
    let size = moov_at + list.len(movie)
    let limits = mp4.VodLimits(metadata_bytes: 8192, top_boxes: 4, tracks: 2)
    let mut reads = 0u64
    let vod = result.unwrap(mp4.video_probe(size, limits, scoped fn(at: u64, n: u64) -> Result[Bytes, mp4.VodError] {
        reads += 1
        let mut raw: Bytes = list.with_capacity(n)
        if at == 0 && n == 8 {
            list.append(mut raw, b"\x00\x00\x00\x1cftyp")
        } else if at == 28 && n == 8 {
            list.append(mut raw, b"\x00\x00\x00\x08free")
        } else if at == 36 && n == 8 {
            list.put_word_be(mut raw, 2147483612u32)
            list.append(mut raw, b"mdat")
        } else if at == moov_at && n == 8 {
            list.append(mut raw, list.slice(movie, 0, 8))
        } else if at == moov_at && n == list.len(movie) {
            list.append(mut raw, movie)
        } else {
            fail("probe requested media or out-of-range bytes")
        }
        Ok(take raw)
    }))
    let info = mp4.vod_info(vod)
    if reads != 5 || mp4.vod_tracks(vod) != 2 || info.timescale != 1000 || info.duration != 1000 || info.file_size != size {
        fail("sparse movie metadata")
    }
    let (video, _) = result.unwrap(mp4.vod_track(vod, 0))
    let (audio, _) = result.unwrap(mp4.vod_track(vod, 1))
    if video.codec != 0x68657631 || video.width != 170 || video.height != 98 || video.timescale != 12288 || video.sample_count != 12 || video.movie_duration != 1000 {
        fail("HEVC probe disagrees with ffprobe")
    }
    if audio.codec != 0x6d703461 || audio.sample_rate != 48000 || audio.channels != 1 || audio.sample_count != 48 || audio.movie_duration != 1000 {
        fail("AAC probe disagrees with ffprobe")
    }
    let mut sample_count = 0u64
    let mut keys = 0u64
    result.unwrap(mp4.vod_samples(vod, 0, 12, scoped fn(sample: mp4.VodSample) -> Result[(), mp4.VodError] {
        if sample_count == 0 && (sample.offset != 44 || sample.size != 2071 || sample.decode_time != 0 || sample.composition_offset != 2048 || !sample.sync) {
            fail("first HEVC packet")
        }
        if sample_count == 1 && (sample.offset != 2115 || sample.size != 1991 || sample.decode_time != 1024 || sample.composition_offset != 6144 || sample.sync) {
            fail("second HEVC packet")
        }
        if sample.sync {
            keys += 1
        }
        sample_count += 1
        Ok(())
    }))
    if sample_count != 12 || keys != 1 {
        fail("sample and sync counts")
    }
    let mut audio_count = 0u64
    result.unwrap(mp4.vod_samples(vod, 1, 48, scoped fn(sample: mp4.VodSample) -> Result[(), mp4.VodError] {
        if audio_count == 0 && (sample.offset != 4106 || sample.size != 207 || sample.duration != 1024 || !sample.sync) {
            fail("first AAC packet in the interleaved mdat")
        }
        audio_count += 1
        Ok(())
    }))
    if audio_count != 48 {
        fail("AAC sample count")
    }
    result.unwrap(mp4.vod_edits(vod, 1, scoped fn(edit: mp4.Edit) {
        if edit.duration != 1000 || edit.media_time != 1024 || edit.rate_integer != 1 || edit.rate_fraction != 0 {
            fail("AAC priming edit")
        }
    }))
    sparse_webm_tracks()
    Ok(())
}

fn sparse_webm_fixture() -> Bytes {
    let mut prefix: Bytes = list.with_capacity(477)

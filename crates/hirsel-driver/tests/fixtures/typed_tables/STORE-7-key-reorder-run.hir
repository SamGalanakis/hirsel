// rule: STORE-7
// expect: run
fn write_keys(mut tx: store.Tx, info: store.CallInfo, none: ()) -> Result[
  (),
  store.TxError
] {
  let keyed: table.Table[table_models@1/model.Row, u32] = table.named("keys")
  let b: table.Table[table_models@2/model.Row, u32] = table.named("keys")
  table.create(mut tx, keyed)?
  table.put(mut tx, keyed, table_models@1/model.Row(label: "a", count: 9), 1)?
  table.put(mut tx, keyed, table_models@1/model.Row(label: "b", count: 1), 2)?
  Ok(())
}

fn read_reordered(mut tx: store.Tx, info: store.CallInfo, none: ()) -> Result[
  bool,
  store.TxError
] {
  let keyed: table.Table[table_models@1/model.Row, u32] = table.named("keys")
  let b: table.Table[table_models@2/model.Row, u32] = table.named("keys")
  if table.get(tx, b, table_models@2/model.Row(count: 9, label: "a")) != Error(
    Schema(KeyMismatch())
  ) {
    return Ok(false)
  }
  if table.range(tx, b, Unbounded(), Unbounded(), 2, Ascending()) != Error(
    Schema(KeyMismatch())
  ) {
    return Ok(false)
  }
  if table.put(mut tx, b, table_models@2/model.Row(count: 1, label: "c"), 3) != Error(
    Schema(KeyMismatch())
  ) {
    return Ok(false)
  }
  Ok(table.get(tx, keyed, table_models@1/model.Row(label: "a", count: 9))? == Some(1))
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  let wrote = store.transact(mut s, write_keys, ())
  check(wrote == Ok(()))?
  // A table has one key order, its byte order: a reordered key record is a
  // key change, refused on every access until a migration.
  let read = store.transact(mut s, read_reordered, ())
  check(read == Ok(true))?
  Ok(())
}

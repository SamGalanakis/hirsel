// Module `list`, extended (LANG-7): library members of the core module `list` (SEM-4). The
// core members (new, with_capacity, len, capacity, reserve, get, slice, push, pop, set,
// clear, fill, append, sum) are declared in core/core/list.hirsel; a call names both sets
// the same way, `list.push` and `list.sort`. `Bytes` is `List[u8]` (SEM-3), so every
// operation here applies to Bytes. Field legend, GROWTH and FREEZE: API.md, "Reading a
// contract".
//
// Representation (MEM-13, MEM-24, MEM-26): own; a 24-byte header inline in its owner; one
// block of capacity x size(T), rounded up to 8, charged to the limit current where the list
// was made. GROWTH: max(needed, 4, 2 x capacity), admitted before the old block is
// refunded. Removing never allocates or shrinks; storage is refunded when the list is
// cleaned.
/// A view of the first element, or None when empty: `list.get(xs, 0)`, returned under
/// OWN-20. View: anchored to xs; FREEZE xs. Cost: O(1).
/// Ex: `let Some(h) = list.first(lines) else { return Error(Empty) }`
pub fn first[T](xs: List[T]) -> Option[View[T]] in xs {
    list.get(xs, 0)
}

/// xs[i] copied out, or x when i >= len, as map.get_or and pool.get_or. Cost: O(1).
/// Ex: `let b = list.get_or(bytes, i, 0)`
pub fn get_or[T: plain](xs: List[T], i: u64, x: T) -> T {
    match list.get(xs, i) {
        Some(v) => v,
        None => x,
    }
}

// ADAPTED from memchr 2.8.3 src/arch/generic/memchr.rs:143-230.
// Long-span SIMD search: check the first 32-byte vector, scan 128-byte
// four-vector groups, finish remaining 32-byte vectors, and guard the tail
// with one in-range overlapping 32-byte load. Requires len(hay) - from >= 32.
fn find_byte_lanes(hay: Bytes, from: u64, byte: u8) -> Option[u64] {
    let end = list.len(hay)
    let needle: Simd[u8, 32] = simd.splat(byte)
    let head: Simd[u8, 32] = list.lanes(hay, from)
    let first_mask = simd.bitmask(simd.eq(head, needle))
    if first_mask != 0 {
        let offset: u64 = int.widen(int.trailing_zeros(first_mask))
        return Some(from + offset)
    }
    let mut i = from + 32
    if end - i >= 128 {
        let last_group = end - 128
        while i <= last_group {
            let block = list.slice(hay, i, i + 128)
            let a: Simd[u8, 32] = list.lanes(block, 0)
            let b: Simd[u8, 32] = list.lanes(block, 32)
            let c: Simd[u8, 32] = list.lanes(block, 64)
            let d: Simd[u8, 32] = list.lanes(block, 96)
            let ma = simd.eq(a, needle)
            let mb = simd.eq(b, needle)
            let mc = simd.eq(c, needle)
            let md = simd.eq(d, needle)
            if simd.any((ma | mb) | (mc | md)) {
                let low = simd.bitmask(ma) | (simd.bitmask(mb) << 32)
                if low != 0 {
                    let offset: u64 = int.widen(int.trailing_zeros(low))
                    return Some(i + offset)
                }
                let high = simd.bitmask(mc) | (simd.bitmask(md) << 32)
                let offset: u64 = int.widen(int.trailing_zeros(high))
                return Some(i + 64 + offset)
            }
            i += 128
        }
    }
    while end - i >= 32 {
        let block: Simd[u8, 32] = list.lanes(hay, i)
        let mask = simd.bitmask(simd.eq(block, needle))
        if mask != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(mask))
            return Some(i + offset)
        }
        i += 32
    }
    if i < end {
        let at = end - 32
        let tail: Simd[u8, 32] = list.lanes(hay, at)
        let mask = simd.bitmask(simd.eq(tail, needle))
        if mask != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(mask))
            return Some(at + offset)
        }
    }
    None
}

// ADAPTED from memchr 2.8.3 src/arch/generic/memchr.rs:143-230.
// Shared long-span vector search for two to four delimiter bytes.
// Requires len(hay) - from >= 32.
fn find_byte4_lanes(hay: Bytes, from: u64, n0: u8, n1: u8, n2: u8, n3: u8) -> Option[u64] {
    let end = list.len(hay)
    let v0: Simd[u8, 32] = simd.splat(n0)
    let v1: Simd[u8, 32] = simd.splat(n1)
    let v2: Simd[u8, 32] = simd.splat(n2)
    let v3: Simd[u8, 32] = simd.splat(n3)
    let head: Simd[u8, 32] = list.lanes(hay, from)
    let first_mask = simd.bitmask((simd.eq(head, v0) | simd.eq(head, v1)) | (simd.eq(head, v2) | simd.eq(head, v3)))
    if first_mask != 0 {
        let offset: u64 = int.widen(int.trailing_zeros(first_mask))
        return Some(from + offset)
    }
    let mut i = from + 32
    if end - i >= 128 {
        let last_group = end - 128
        while i <= last_group {
            let block = list.slice(hay, i, i + 128)
            let a: Simd[u8, 32] = list.lanes(block, 0)
            let b: Simd[u8, 32] = list.lanes(block, 32)
            let c: Simd[u8, 32] = list.lanes(block, 64)
            let d: Simd[u8, 32] = list.lanes(block, 96)
            let ma = (simd.eq(a, v0) | simd.eq(a, v1)) | (simd.eq(a, v2) | simd.eq(a, v3))
            let mb = (simd.eq(b, v0) | simd.eq(b, v1)) | (simd.eq(b, v2) | simd.eq(b, v3))
            let mc = (simd.eq(c, v0) | simd.eq(c, v1)) | (simd.eq(c, v2) | simd.eq(c, v3))
            let md = (simd.eq(d, v0) | simd.eq(d, v1)) | (simd.eq(d, v2) | simd.eq(d, v3))
            if simd.any((ma | mb) | (mc | md)) {
                let low = simd.bitmask(ma) | (simd.bitmask(mb) << 32)
                if low != 0 {
                    let offset: u64 = int.widen(int.trailing_zeros(low))
                    return Some(i + offset)
                }
                let high = simd.bitmask(mc) | (simd.bitmask(md) << 32)
                let offset: u64 = int.widen(int.trailing_zeros(high))
                return Some(i + 64 + offset)
            }
            i += 128
        }
    }
    while end - i >= 32 {
        let block: Simd[u8, 32] = list.lanes(hay, i)
        let mask = simd.bitmask((simd.eq(block, v0) | simd.eq(block, v1)) | (simd.eq(block, v2) | simd.eq(block, v3)))
        if mask != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(mask))
            return Some(i + offset)
        }
        i += 32
    }
    if i < end {
        let at = end - 32
        let tail: Simd[u8, 32] = list.lanes(hay, at)
        let mask = simd.bitmask((simd.eq(tail, v0) | simd.eq(tail, v1)) | (simd.eq(tail, v2) | simd.eq(tail, v3)))
        if mask != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(mask))
            return Some(at + offset)
        }
    }
    None
}

// Short-span 16-byte SIMD search for two to four delimiter bytes (16 <= len < 32).
fn find_byte4_lanes16(hay: Bytes, n0: u8, n1: u8, n2: u8, n3: u8) -> Option[u64] {
    let n = list.len(hay)
    let v0: Simd[u8, 16] = simd.splat(n0)
    let v1: Simd[u8, 16] = simd.splat(n1)
    let v2: Simd[u8, 16] = simd.splat(n2)
    let v3: Simd[u8, 16] = simd.splat(n3)
    let head: Simd[u8, 16] = list.lanes(hay, 0)
    let mask = simd.bitmask((simd.eq(head, v0) | simd.eq(head, v1)) | (simd.eq(head, v2) | simd.eq(head, v3)))
    if mask != 0 {
        let offset: u64 = int.widen(int.trailing_zeros(mask))
        return Some(offset)
    }
    if n > 16 {
        let at = n - 16
        let tail: Simd[u8, 16] = list.lanes(hay, at)
        let tail_mask = simd.bitmask((simd.eq(tail, v0) | simd.eq(tail, v1)) | (simd.eq(tail, v2) | simd.eq(tail, v3)))
        if tail_mask != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(tail_mask))
            return Some(at + offset)
        }
    }
    None
}

/// The first absolute index of byte in xs[start..end], or None (Rust memchr).
/// Fails: Bounds for an invalid range. Alloc: nothing. Cost: O(end - start).
pub fn find_byte(xs: Bytes, start: u64, end: u64, byte: u8) -> Option[u64] {
    let b = list.slice(xs, start, end)
    let n = list.len(b)
    let one: u64 = int.widen(byte)
    let spread = one * 0x0101010101010101
    let mut at: u64 = 0
    if n >= 160 {
        // Check the first 32 bytes with scalar words so nearby matches avoid SIMD dispatch.
        while at < 32 {
            let low = int.zero_byte_marks(list.word_le(b, at) ^ spread)
            let high = int.zero_byte_marks(list.word_le(b, at + 8) ^ spread)
            if low | high != 0 {
                let low_bit: u64 = int.widen(int.trailing_zeros(low))
                let high_bit: u64 = int.widen(int.trailing_zeros(high))
                return Some(if low != 0 {
                    start + at + (low_bit >> 3)
                } else {
                    start + at + 8 + (high_bit >> 3)
                })
            }
            at += 16
        }
        return match find_byte_lanes(b, 32, byte) {
            Some(found) => Some(start + found),
            None => None,
        }
    }
    if n >= 16 {
        let last_block = n - 16
        while at <= last_block {
            let low = int.zero_byte_marks(list.word_le(b, at) ^ spread)
            let high = int.zero_byte_marks(list.word_le(b, at + 8) ^ spread)
            if low | high != 0 {
                let low_bit: u64 = int.widen(int.trailing_zeros(low))
                let high_bit: u64 = int.widen(int.trailing_zeros(high))
                return Some(if low != 0 {
                    start + at + (low_bit >> 3)
                } else {
                    start + at + 8 + (high_bit >> 3)
                })
            }
            at += 16
        }
    }
    if n - at >= 8 {
        let marks = int.zero_byte_marks(list.word_le(b, at) ^ spread)
        if marks != 0 {
            let bit: u64 = int.widen(int.trailing_zeros(marks))
            return Some(start + at + (bit >> 3))
        }
        at += 8
    }
    while at < n {
        if b[at] == byte {
            return Some(start + at)
        }
        at += 1
    }
    None
}

/// As find_byte, matching either byte. Rust memchr2.
pub fn find_byte2(xs: Bytes, start: u64, end: u64, a: u8, b: u8) -> Option[u64] {
    find_byte4(xs, start, end, a, b, a, b)
}

/// As find_byte, matching any of three bytes. Rust memchr3.
pub fn find_byte3(xs: Bytes, start: u64, end: u64, a: u8, b: u8, c: u8) -> Option[u64] {
    find_byte4(xs, start, end, a, b, c, c)
}

/// As find_byte, matching any of four bytes. Repeated needles are equivalent to one.
pub fn find_byte4(xs: Bytes, start: u64, end: u64, a: u8, b: u8, c: u8, d: u8) -> Option[u64] {
    let hay = list.slice(xs, start, end)
    let n = list.len(hay)
    if n >= 32 {
        return match find_byte4_lanes(hay, 0, a, b, c, d) {
            Some(found) => Some(start + found),
            None => None,
        }
    }
    if n >= 16 {
        return match find_byte4_lanes16(hay, a, b, c, d) {
            Some(found) => Some(start + found),
            None => None,
        }
    }
    let mut i: u64 = 0
    while i < n {
        let byte = hay[i]
        if byte == a || byte == b || byte == c || byte == d {
            return Some(start + i)
        }
        i += 1
    }
    None
}

/// Whether xs begins with prefix. Alloc: nothing. Cost: O(len(prefix)).
pub fn starts_with[T: key](xs: List[T], prefix: List[T]) -> bool {
    starts_with_at(xs, 0, prefix)
}

/// Whether prefix matches xs at the element offset at. Returns false when at
/// is past the end or the prefix does not fit. An empty prefix matches at len(xs).
/// Alloc: nothing. Cost: O(len(prefix)).
/// Ex: `list.starts_with_at(xs, offset, prefix)`.
pub fn starts_with_at[T: key](xs: List[T], at: u64, prefix: List[T]) -> bool {
    let len = list.len(xs)
    let n = list.len(prefix)
    if at > len || n > len - at {
        return false
    }
    let window = list.slice(xs, at, at + n)
    if n > 7 {
        return window == prefix
    }
    for i in 0 .. n {
        if window[i] != prefix[i] {
            return false
        }
    }
    true
}

/// A view of the last element, or None when empty. View: anchored to xs; FREEZE xs.
/// Cost: O(1). Ex: `if let Some(top) = list.last(stack) { .. }`
pub fn last[T](xs: List[T]) -> Option[View[T]] in xs {
    let n = list.len(xs)
    if n == 0 {
        None
    } else {
        list.get(xs, n - 1)
    }
}

/// Removes and returns element i, shifting i+1.. down; order kept. Library code: a chain
/// of `list.set` from the end after a `list.pop`.
/// Fails: Bounds (failure) when i >= len. Alloc: nothing. Cost: O(len - i) moves.
/// Ex: `let oldest = list.remove(mut undo, 0)`
pub fn remove[T](mut xs: List[T], i: u64) -> T {
    check_index(xs, i)
    let mut x = option.unwrap(list.pop(mut xs))
    let mut j = list.len(xs)
    while j > i {
        j -= 1
        let y = list.set(mut xs, j, take x)
        x = y
    }
    x
}

/// Inserts x at i, shifting i.. up by one.
/// Fails: Bounds (failure) when i > len, checked before growth; a refused GROWTH raises
/// Capacity before xs changes. Alloc: GROWTH. Cost: O(len - i) moves.
/// Ex: `list.insert(mut xs, 0, take s)`
pub fn insert[T](mut xs: List[T], i: u64, take x: T) {
    let n = list.len(xs)
    if i != n {
        check_index(xs, i)
    }
    list.reserve(mut xs, 1)
    let mut cur = x
    for j in i .. n {
        let y = list.set(mut xs, j, take cur)
        cur = y
    }
    list.push(mut xs, take cur)
}

/// Removes and returns element i, moving the last element into its place; order not kept.
/// Fails: Bounds (failure) when i >= len. Alloc: nothing. Cost: O(1).
/// Ex: `let x = list.swap_remove(mut xs, i)`
pub fn swap_remove[T](mut xs: List[T], i: u64) -> T {
    check_index(xs, i)
    let tail = option.unwrap(list.pop(mut xs))
    if i == list.len(xs) {
        tail
    } else {
        list.set(mut xs, i, take tail)
    }
}

/// Reverses the elements in place. Alloc: nothing. Cost: O(len). Ex: `list.reverse(mut path)`
pub fn reverse[T](mut xs: List[T]) {
    let mut i: u64 = 0
    let mut j = list.len(xs)
    while i + 1 < j {
        j -= 1
        list.swap(mut xs, i, j)
        i += 1
    }
}

/// Sorts in place; `before(a, b)` returns Less when a goes first. Not stable.
/// Introsort detects ordered runs and partitions out equal keys. It uses a median-of-three
/// pivot, insertion sort below 17 elements and heapsort past 2 log2(len) partition levels.
/// `before` is a `scoped fn` (OWN-21): it may view the caller's locals and does not wait;
/// it does not escape the call. If it is not a total order, xs still holds each element exactly once, in an unspecified
/// order. A failure inside `before` propagates with the same guarantee.
/// Alloc: nothing. Cost: O(len) on ordered inputs, O(len log len) worst case.
/// Ex: `list.sort(mut xs, fn(a: u64, b: u64) -> Order { std.order.compare(a, b) })`
pub fn sort[T](mut xs: List[T], before: scoped fn(T, T) -> Order) {
    let n = list.len(xs)
    if n <= 16 {
        insertion_sort(mut xs, 0, n, before)
        return
    }
    let descending = less(xs, 1, 0, before)
    let mut run: u64 = 2
    while run < n && less(xs, run, run - 1, before) == descending {
        run += 1
    }
    if run == n {
        if descending {
            reverse(mut xs)
        }
        return
    }
    let mut limit: u64 = 0
    let mut m = n
    while m > 1 {
        limit += 2
        m = m / 2
    }
    sort_range(mut xs, 0, n, limit, before)
}

/// Sum of the bytes of b in u64: the corpus checksum. `list.sum` sums in u8 and would fail
/// with Overflow; there is no generic widening sum (no numeric bound, OWN-4). Cannot
/// overflow below 2^56 bytes. Alloc: nothing. Cost: O(len).
/// Ex: `let s = list.sum_bytes(string.as_bytes(out))`
pub fn sum_bytes(b: Bytes) -> u64 {
    let n = list.len(b)
    if n < 72057594037927936 {
        let mut a: u64 = 0
        let mut c: u64 = 0
        let mut d: u64 = 0
        let mut e: u64 = 0
        let mut i: u64 = 0
        while n - i >= 4 {
            a = int.wrapping_add(a, int.widen(b[i]))
            c = int.wrapping_add(c, int.widen(b[i + 1]))
            d = int.wrapping_add(d, int.widen(b[i + 2]))
            e = int.wrapping_add(e, int.widen(b[i + 3]))
            i += 4
        }
        let mut total = int.wrapping_add(int.wrapping_add(a, c), int.wrapping_add(d, e))
        while i < n {
            total = int.wrapping_add(total, int.widen(b[i]))
            i += 1
        }
        total
    } else {
        let mut total: u64 = 0
        for x in b {
            total += int.widen(x)
        }
        total
    }
}

// Private helpers. Moving elements uses only `list.pop`, `list.set` and `list.push`:
// `list.set` returns the element it replaces, so no placeholder value is needed.
/// Fails with Bounds when i >= len, at the index.
fn check_index[T](xs: List[T], i: u64) {
    let _ = view xs[i]
}

fn less[T](xs: List[T], i: u64, j: u64, before: scoped fn(T, T) -> Order) -> bool {
    match before(xs[i], xs[j]) {
        Less => true,
        _ => false,
    }
}

/// Sorts xs[start..end]; recurses into the smaller part and loops on the larger, so the
/// depth is at most log2(len).
fn sort_range[T](mut xs: List[T], start: u64, end: u64, limit: u64, before: scoped fn(T, T) -> Order) {
    let mut a = start
    let mut b = end
    let mut depth = limit
    while b - a > 16 {
        if depth == 0 {
            heapsort(mut xs, a, b, before)
            return
        }
        depth -= 1
        let (p, grouped_equals) = partition(mut xs, a, b, before)
        if grouped_equals {
            a = p + 1
            continue
        }
        if p - a < b - p {
            sort_range(mut xs, a, p, depth, before)
            a = p + 1
        } else {
            sort_range(mut xs, p + 1, b, depth, before)
            b = p
        }
    }
    insertion_sort(mut xs, a, b, before)
}

// Median-of-three Lomuto partition. Returns the pivot's final index and
// whether the elements to its left are already done.
fn partition[T](mut xs: List[T], a: u64, b: u64, before: scoped fn(T, T) -> Order) -> (u64, bool) {
    let mid = a + (b - a) / 2
    let hi = b - 1
    if less(xs, mid, a, before) {
        list.swap(mut xs, mid, a)
    }
    if less(xs, hi, a, before) {
        list.swap(mut xs, hi, a)
    }
    if less(xs, mid, hi, before) {
        list.swap(mut xs, mid, hi)
    }
    // As in ipnsort, the preceding partition leaves xs[a - 1] as a
    // lower bound for this range. If the pivot equals it, finish all
    // equal keys in one pass.
    if a > 0 && equal_at(xs, a - 1, hi, before) {
        return (partition_equal(mut xs, a, hi, before), true)
    }
    let mut store = a
    for i in a .. hi {
        if less(xs, i, hi, before) {
            list.swap(mut xs, i, store)
            store += 1
        }
    }
    list.swap(mut xs, store, hi)
    (store, false)
}

fn equal_at[T](xs: List[T], i: u64, j: u64, before: scoped fn(T, T) -> Order) -> bool {
    match before(xs[i], xs[j]) {
        Equal => true,
        _ => false,
    }
}

// The pivot is a lower bound for the range. Move its equals to the front.
fn partition_equal[T](mut xs: List[T], a: u64, hi: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let mut store = a
    for i in a .. hi {
        if equal_at(xs, i, hi, before) {
            list.swap(mut xs, i, store)
            store += 1
        }
    }
    list.swap(mut xs, store, hi)
    store
}

fn insertion_sort[T](mut xs: List[T], a: u64, b: u64, before: scoped fn(T, T) -> Order) {
    if b - a < 2 {
        return
    }
    for i in (a + 1) .. b {
        let mut j = i
        while j > a && less(xs, j, j - 1, before) {
            list.swap(mut xs, j, j - 1)
            j -= 1
        }
    }
}

fn heapsort[T](mut xs: List[T], a: u64, b: u64, before: scoped fn(T, T) -> Order) {
    heap_sort_by_index(mut xs, a, b, scoped fn(items: List[T], i: u64, j: u64) -> Order {
        before(items[i], items[j])
    }, fn(mut items: List[T], i: u64, j: u64) {
        list.swap(mut items, i, j)
    })
}

/// Sorts entries at start .. end in place, without preserving the order of equal entries.
/// compare_at orders two positions in storage. swap_at exchanges their entries.
/// Both callbacks must accept every position in the range and cannot escape the call.
/// Fails: Overflow if end is below start, or a failure from a callback.
/// Alloc: nothing outside the callbacks. Cost: O(n log n) for n = end - start.
pub fn heap_sort_by_index[C](mut storage: C, start: u64, end: u64, compare_at: scoped fn(C, u64, u64) -> Order, swap_at: scoped fn(mut C, u64, u64)) {
    let n = end - start
    let mut i = n / 2
    while i > 0 {
        i -= 1
        sift_down_by_index(mut storage, start, i, n, compare_at, swap_at)
    }
    let mut remaining = n
    while remaining > 1 {
        remaining -= 1
        swap_at(mut storage, start, start + remaining)
        sift_down_by_index(mut storage, start, 0, remaining, compare_at, swap_at)
    }
}

/// Restores the max-heap below root relative to base.
fn sift_down_by_index[C](mut storage: C, base: u64, root: u64, n: u64, compare_at: scoped fn(C, u64, u64) -> Order, swap_at: scoped fn(mut C, u64, u64)) {
    let mut r = root
    while r < n / 2 {
        let mut child = 2 * r + 1
        if child + 1 < n && compare_at(storage, base + child, base + child + 1) == Less {
            child += 1
        }
        if compare_at(storage, base + r, base + child) != Less {
            break
        }
        swap_at(mut storage, base + r, base + child)
        r = child
    }
}

/// Whether x occurs, using structural equality. Alloc: nothing. Cost: O(len).
pub fn contains[T: key](xs: List[T], x: T) -> bool {
    for y in xs {
        if y == x {
            return true
        }
    }
    false
}

/// First equal index, or Error(insertion index), in an ascending sorted list.
/// Alloc: nothing. Cost: O(log len) comparisons. Ex: `list.binary_search(ids, id)`
pub fn binary_search[T: ordered](xs: List[T], x: T) -> Result[u64, u64] {
    binary_search_by(xs, scoped fn(item: T) -> Order {
        order.compare(item, x)
    })
}

/// Keeps the first of each consecutive run of equal elements, preserving order.
/// Alloc: nothing. Cost: O(len) comparisons and moves; removed values are cleaned.
pub fn dedup[T: key](mut xs: List[T]) {
    let n = list.len(xs)
    if n < 2 {
        return
    }
    let mut write: u64 = 1
    let mut read: u64 = 1
    while read < n {
        if !(xs[read] == xs[write - 1]) {
            list.swap(mut xs, read, write)
            write += 1
        }
        read += 1
    }
    list.truncate(mut xs, write)
}

/// Calls f on each element in order and collects the results. Reserves exactly
/// len(xs) slots before calling f. A refused reservation raises Capacity.
/// U cannot be a view (OWN-19). A scoped fn cannot wait. Use a for loop for waiting calls.
pub fn map[T, U](xs: List[T], f: scoped fn(T) -> U) -> List[U] {
    let mut out: List[U] = list.with_capacity(list.len(xs))
    for x in xs {
        list.push(mut out, f(x))
    }
    take out
}

/// Calls f in order and collects its Ok values or returns the first Error.
/// Reserves exactly len(xs) slots before calling f. A refused reservation raises Capacity.
/// A scoped fn cannot wait. A ? in f exits only f (LANG-18).
pub fn try_map[T, U, E](xs: List[T], f: scoped fn(T) -> Result[U, E]) -> Result[List[U], E] {
    let mut out: List[U] = list.with_capacity(list.len(xs))
    for x in xs {
        let value = f(x)?
        list.push(mut out, take value)
    }
    Ok(take out)
}

/// Keeps elements for which keep returns true, preserving their order.
/// Alloc: nothing. Cleans removed elements after the last keep call.
/// If keep fails, xs still holds each element exactly once, in an unspecified order.
/// The closure cannot capture xs (OWN-11).
pub fn retain[T](mut xs: List[T], keep: scoped fn(T) -> bool) {
    let n = list.len(xs)
    let mut write: u64 = 0
    for read in 0u64 .. n {
        if keep(xs[read]) {
            list.swap(mut xs, read, write)
            write += 1
        }
    }
    list.truncate(mut xs, write)
}

/// A view of the first element that satisfies pred, or None.
/// The returned view freezes xs (OWN-10). Use position to find an element for mutation.
pub fn find[T](xs: List[T], pred: scoped fn(T) -> bool) -> Option[View[T]] in xs {
    let i = position(xs, pred)?
    list.get(xs, i)
}

/// The index of the first element that satisfies pred, or None.
/// Use this index to mutate a found element. Views do not allow mutation (OWN-8).
pub fn position[T](xs: List[T], pred: scoped fn(T) -> bool) -> Option[u64] {
    for i in 0u64 .. list.len(xs) {
        if pred(xs[i]) {
            return Some(i)
        }
    }
    None
}

/// True at the first element that satisfies pred. False for an empty list.
pub fn any[T](xs: List[T], pred: scoped fn(T) -> bool) -> bool {
    for x in xs {
        if pred(x) {
            return true
        }
    }
    false
}

/// False at the first element that does not satisfy pred. True for an empty list.
pub fn all[T](xs: List[T], pred: scoped fn(T) -> bool) -> bool {
    for x in xs {
        if !pred(x) {
            return false
        }
    }
    true
}

/// Appends copies of ys. Fails: Capacity leaves xs unchanged.
/// Alloc: one list GROWTH. Cost: O(len ys), plus growth copies.
pub fn extend[T: plain](mut xs: List[T], ys: List[T]) {
    list.append(mut xs, ys)
}

// sort_stable is core.list, with one uninhabited scratch block.
/// First equal index, or Error(insertion index), in a list sorted by compare.
/// compare(element) orders that element relative to the sought key, as Rust's
/// slice::binary_search_by. Equal keys use the first index, including duplicates.
/// The scoped comparator may borrow its target and never escapes.
/// Alloc: nothing. Cost: O(log len) calls; one comparison per search step.
pub fn binary_search_by[T](xs: List[T], compare: scoped fn(T) -> Order) -> Result[u64, u64] {
    let mut lo: u64 = 0
    let mut hi = list.len(xs)
    let mut found = false
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        match compare(xs[mid]) {
            Less => {
                lo = mid + 1
            },
            Equal => {
                found = true;
                hi = mid
            },
            Greater => {
                hi = mid
            },
        }
    }
    if found {
        Ok(lo)
    } else {
        Error(lo)
    }
}

/// Removes the first n elements in place, retaining the suffix in order and
/// keeping the original capacity. Fails: Bounds when n > len.
/// Alloc: nothing. Cost: one bulk move of the len - n suffix.
/// Ex: `list.drop_prefix(mut buffer, written)`.
pub fn drop_prefix[T: plain](mut xs: List[T], n: u64) {
    if n == 0 {
        return
    }
    let len = list.len(xs)
    let keep = if n <= len {
        len - n
    } else {
        0
    }
    // copy_within checks src <= len even for an empty copy, so n > len fails here.
    list.copy_within(mut xs, n, 0, keep)
    list.truncate(mut xs, keep)
}

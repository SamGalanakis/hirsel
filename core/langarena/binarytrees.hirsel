// kostya/LangArena 3c9f84d benchmarks/binarytrees.rs.
type Node {
    left: Option[Box[Node]],
    right: Option[Box[Node]],
    item: i32
}

fn tree(item: i32, depth: i32) -> Result[Box[Node], helper.Error] {
    let mut node = match box.new(Node(left: None, right: None, item: item)) {
        Ok(take n) => take n,
        Error((c, take unused)) => return Error(Capacity(c))
    }
    if depth > 0 {
        let shift: i32 = int.narrow(depth - 1)
        let offset = 1i32 << shift
        node.left = Some(tree(item - offset, depth - 1)?)
        node.right = Some(tree(item + offset, depth - 1)?)
    }
    Ok(take node)
}

fn sum(node: Box[Node]) -> u32 {
    let item: u32 = int.truncate(node.item)
    let mut total = int.wrapping_add(item, 1u32)
    if let Some(left) = node.left {
        total = int.wrapping_add(total, sum(left))
    }
    if let Some(right) = node.right {
        total = int.wrapping_add(total, sum(right))
    }
    total
}

// Upstream's arena: one Vec of 12-byte nodes, i32 child indices, -1 for none.
type ArenaNode {
    item: i32,
    left: i32,
    right: i32
}

fn build_arena(mut arena: List[ArenaNode], item: i32, depth: i32) -> Result[i32, helper.Error] {
    let at = list.len(arena)
    let idx: i32 = int.narrow(at)
    if let Error((c, _)) = list.push(mut arena, ArenaNode(item: item, left: -1, right: -1)) {
        return Error(Capacity(c))
    }
    if depth > 0 {
        let offset = 1i32 << (depth - 1)
        let left = build_arena(mut arena, item - offset, depth - 1)?
        let right = build_arena(mut arena, item + offset, depth - 1)?
        arena[at].left = left
        arena[at].right = right
    }
    Ok(idx)
}

fn sum_arena(arena: List[ArenaNode], idx: i32) -> u32 {
    let node = arena[int.narrow(idx)]
    let item: u32 = int.truncate(node.item)
    let mut total = int.wrapping_add(item, 1u32)
    if node.left >= 0 {
        total = int.wrapping_add(total, sum_arena(arena, node.left))
    }
    if node.right >= 0 {
        total = int.wrapping_add(total, sum_arena(arena, node.right))
    }
    total
}

pub fn dispatch(config: helper.Settings, name: String, warmup: u64, iterations: u64) -> Result[u32, helper.Error] {
    if name != "Binarytrees::Obj" && name != "Binarytrees::Arena" {
        return Error(UnknownTask)
    }
    let depth = helper.config_i64(config, "depth")?
    if depth < 0 {
        return Error(Config)
    }
    let mut total: u32 = 0
    for _ in 0 .. warmup + iterations {
        if name == "Binarytrees::Arena" {
            let mut arena: List[ArenaNode] = list.new()
            let root = build_arena(mut arena, 0, int.narrow(depth))?
            total = int.wrapping_add(total, sum_arena(arena, root))
        } else {
            let root = tree(0, int.narrow(depth))?
            total = int.wrapping_add(total, sum(root))
        }
    }
    Ok(total)
}

pub fn main(out: Stdout, d: Dir, argv: Args) -> Result[(), Exit] waits {
    harness.main(out, d, argv, fn(c: helper.Settings, n: String, w: u64, i: u64) -> Result[u32, helper.Error] {
        dispatch(c, n, w, i)
    })
}

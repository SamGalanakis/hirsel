fn dev_vector_bytes(byte: u8) -> Bytes {
    let mut raw: Bytes = list.with_capacity(32u64)
    for _ in 0u64 .. 32u64 {
        list.push(mut raw, byte)
    }
    take raw
}

fn dev_vector_description(which: u64) -> Describe {
    let entry_shape = Described(kind: Query, identity: b"example/query", args: b"request", result: b"answer")
    let mut schemas: List[SlotSchema] = list.new()
    list.push(mut schemas, SlotSchema(name: "rows", kind: Table(), key: b"key", key_json: b"json", value: if which == 3u64 {
        b"u32"
    } else {
        b"u64"
    }))
    let mut exported: List[Exported] = list.new()
    list.push(mut exported, Exported(described: take entry_shape, args_fp: 11u64, result_fp: 23u64, revision: dev_vector_bytes(3u8), slots: take schemas, value: b"value schema"))
    let route = HttpBinding(op: "read", method: Get, path: if which == 2u64 {
        "/changed"
    } else {
        "/read"
    }, entry: b"example/query", fields: list.new(), mode: Read, ok_status: 200u16, error_status: 422u16, body_max: 0u64, arg_max: 4096u64, deadline_ms: 1000u64, steps: DEFAULT_STEPS)
    let mut bindings: List[HttpDescribe] = list.new()
    list.push(mut bindings, HttpDescribe(binding: take route, defaults: list.new()))
    let (image, target) = if which == 4u64 {
        (2u8, "llvm")
    } else {
        (1u8, "cranelift")
    }
    Describe(digest: dev_vector_bytes(image), target: target, n_place: if which == 1u64 {
        8388608u64
    } else {
        16777216u64
    }, revision: dev_vector_bytes(7u8), exported: take exported, tables: list.new(), bindings: take bindings)
}

@test
fn dev_identity_vectors(out: Stdout) -> Result[(), ()] waits {
    for which in 0u64 .. 5u64 {
        let description = dev_vector_description(which)
        let digest = identity_digest(description) ?=> |_| ()
        let vector_payload = encode_describe(description) ?=> |_| ()
        stdout.write(out, std.hex.encode(vector_payload)) ?=> |_| ()
        stdout.write(out, " ") ?=> |_| ()
        stdout.write(out, std.hex.encode(digest)) ?=> |_| ()
        stdout.write(out, "\n") ?=> |_| ()
    }
    Ok(())
}

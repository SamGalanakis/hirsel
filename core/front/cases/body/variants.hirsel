// Variants are written bare and selected by the expected type (LANG-7), built with
// their case set and payload stored at the case's field (FORM v1b); `main`'s
// `Result[(), Exit]` goes through its destination. Checked here as well formed; the
// M1 runner runs the exit status natively.
// expect: accept
pub fn main() -> Result[(), Exit] {
    pick(false)
}

fn pick(c: bool) -> Result[(), Exit] {
    if c {
        Ok(())
    } else {
        Error(Exit(status: 7))
    }
}

fn maybe(c: bool) -> Option[u64] {
    if c {
        Some(3)
    } else {
        None
    }
}

type Job = Done | Running

fn local() -> Job {
    let j = Done
    j
}

fn reply() -> DirReply {
    let r: DirReply = Done
    r
}

fn ended(r: DirReply) -> bool {
    match r {
        Done => true,
        _ => false
    }
}

fn env_error() -> env.EnvError {
    let e: env.EnvError = NotUtf8
    e
}

fn is_not_utf8(e: env.EnvError) -> bool {
    match e {
        NotUtf8 => true,
        _ => false
    }
}

fn locked() -> DirReply {
    let r = Locked(true)
    r
}

fn prelude_stat() -> Stat {
    let s = Stat(kind: Directory, size: 2, modified_ns: 0)
    s
}

// NET-7 graceful TCP end, composed from existing ownership and host.recv.
pub type FinishError: send = Allocation(Capacity) | Network(NetError)

fn release_write(take w: WriteHalf) {}

/// Shut down output, drain raw input to EOF under one absolute deadline, then
/// release the read owner. O(received bytes), fixed 8192-byte scratch. Reset,
/// cancellation and deadline are reported; allocation refusal still releases
/// both halves. No new provider operation. Ex: `net.finish(take w, take r, c, end)?`.
pub fn finish(take w: WriteHalf, take r: ReadHalf, c: Clock, deadline_ns: u64) -> Result[(), FinishError] waits {
    release_write(take w)
    let allocation: Result[Bytes, Capacity] = list.with_capacity(8192)
    let mut scratch = match allocation {
        Ok(take b) => take b,
        Error(capacity) => return Error(Allocation(capacity))
    }
    let mut input = take r
    loop {
        if host.mono_ns(c) >= deadline_ns {
            return Error(Network(TimedOut))
        }
        list.clear(mut scratch)
        match host.recv(mut input, mut scratch, At(c, deadline_ns)) {
            Ok(0) => return Ok(()),
            Ok(_) => {},
            Error(error) => return Error(Network(error))
        }
    }
}

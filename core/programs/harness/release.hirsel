// Module release (package harness): an agent that edits its own harness (fable-design 4.4).
// The agent edits source rows and files a proposal through Inside tools; it holds no deploy
// authority. The host place, which alone does, reads the filed proposals with `pending` and
// `source`, publishes the source, previews and decides the deploy (launch.md "Deploy
// preview"), and then calls the app's settle entry, which calls `settle` here to give the
// proposal's parked tool call its result.
//
// The app lists the tools with `add_tools` from its `agent()`, so every entry reaches them,
// creates the tables with `migrate` beside `harness.migrate`, and forwards the query and
// settle entries after checking the host's Caller. The host uses release_publish.

pub type File: codec + send {
    path: String,
    text: String
}

// Filed until the host settles it: Published with the host's text naming the release, or
// Rejected with why (the checker's refusal, a refused grant diff, a moved tree).
pub type State: codec + send = Filed | Published(String) | Rejected(String)

// A proposal: the parked call it settles, the hash of the source tree when it was filed,
// and the agent's summary.
pub type Build: codec + send {
    package: String,
    grants: List[String],
    dirs: List[String]
}

pub type Proposal: codec + send {
    call: harness.EffectKey,
    tree: Bytes,
    summary: String,
    build: Build,
    state: State
}

pub type Tables: shareable + send {
    files: store.Table[String, String],
    proposals: store.Table[Bytes, Proposal]
}

fn files_name() -> String {
    "release.files"
}

fn proposals_name() -> String {
    "release.proposals"
}

pub fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    let c_text: std.codec.Codec[String] = std.codec.of()
    let c_proposal: std.codec.Codec[Proposal] = std.codec.of()
    match store.migration_create_table(mut phase, store.spec(files_name(), std.codec.key_string(), c_text)) {
        Error(Exists(_)) => (),
        Error(take e) => return Error(take e),
        Ok(()) => (),
    }
    match store.migration_create_table(mut phase, store.spec(proposals_name(), std.codec.key_bytes(), c_proposal)) {
        Error(Exists(_)) => Ok(()),
        other => take other,
    }
}

pub fn tables(schema: store.Schema) -> Result[Tables, store.Error] {
    let c_text: std.codec.Codec[String] = std.codec.of()
    let c_proposal: std.codec.Codec[Proposal] = std.codec.of()
    Ok(Tables(
        files: store.schema_table(schema, files_name(), std.codec.key_string(), c_text)?,
        proposals: store.schema_table(schema, proposals_name(), std.codec.key_bytes(), c_proposal)?,
    ))
}

// The four Inside tools.
pub fn add_tools[G: send](mut a: harness.Agent[G]) {
    list.push(mut a.tools, harness.inside("read_source", "Reads one source file of this harness.", "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}", code.describe(read_source)))
    list.push(mut a.tools, harness.inside("write_source", "Writes one source file of this harness; empty text deletes it.", "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"path\",\"text\"]}", code.describe(write_source)))
    list.push(mut a.tools, harness.inside("list_source", "Lists this harness's source files, one path per line.", "{\"type\":\"object\"}", code.describe(list_source)))
    list.push(mut a.tools, harness.inside("propose_release", "Proposes the current source as this harness's next release; the result arrives when the host has decided.", "{\"type\":\"object\",\"properties\":{\"summary\":{\"type\":\"string\"},\"package\":{\"type\":\"string\"},\"grants\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"dirs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"summary\"]}", code.describe(propose_release)))
}

fn opened(tx: store.Tx) -> Result[Tables, harness.Fault] {
    match tables(store.tx_schema(tx)) {
        Ok(take t) => Ok(take t),
        Error(_) => Error(Unavailable),
    }
}

fn arguments(args: Bytes) -> Result[mcp.rpc.Fields, harness.Fault] {
    let Ok(raw) = string.from_utf8(clone(args)) else {
        return Error(BadArgs("arguments are not UTF-8"))
    }
    let Ok(fields) = mcp.rpc.object(raw) else {
        return Error(BadArgs("arguments are not a JSON object"))
    }
    Ok(take fields)
}

fn text_arg(fields: mcp.rpc.Fields, key: String) -> Result[String, harness.Fault] {
    match mcp.rpc.field_text(fields, key) {
        Some(take v) => Ok(take v),
        None => {
            let mut why = string.into_bytes(clone(key))
            list.extend(mut why, string.into_bytes(" must be a string"))
            Error(BadArgs(result.unwrap(string.from_utf8(take why))))
        },
    }
}

fn arg(args: Bytes, key: String) -> Result[String, harness.Fault] {
    text_arg(arguments(args)?, key)
}

fn strings_arg(fields: mcp.rpc.Fields, key: String) -> Result[List[String], harness.Fault] {
    let Some(raw) = map.get(fields, key) else { return Ok(list.new()) }
    let values = mcp.rpc.array(raw) ?=> |_| BadArgs("grants and dirs must be arrays of strings")
    let mut out: List[String] = list.with_capacity(list.len(values))
    for value in values {
        let Some(take text) = mcp.rpc.text(value) else { return Error(BadArgs("grants and dirs must be arrays of strings")) }
        list.push(mut out, take text)
    }
    Ok(take out)
}

fn path_arg(args: Bytes) -> Result[String, harness.Fault] {
    let path = arg(args, "path")?
    if string.byte_len(path) == 0u64 {
        return Error(BadArgs("path is empty"))
    }
    Ok(path)
}

fn read_source(mut tx: store.Tx, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    let t = opened(tx)?
    let path = path_arg(inv.args)?
    match store.fetch(tx, t.files, path) {
        Ok(Some(take text)) => Ok(Now(string.into_bytes(take text))),
        Ok(None) => Error(Refused("no such source file")),
        Error(_) => Error(Unavailable),
    }
}

fn write_source(mut tx: store.Tx, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    let t = opened(tx)?
    let path = path_arg(inv.args)?
    let text = arg(inv.args, "text")?
    let wrote: Result[(), store.Error] = if string.byte_len(text) == 0u64 {
        match store.delete(mut tx, t.files, path) {
            Ok(_) => Ok(()),
            Error(take e) => Error(take e),
        }
    } else {
        store.put(mut tx, t.files, path, text)
    }
    match wrote {
        Ok(_) => Ok(Now(string.into_bytes("written"))),
        Error(_) => Error(Unavailable),
    }
}

fn list_source(mut tx: store.Tx, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    let t = opened(tx)?
    let Ok(take cursor) = store.range(tx, t.files, Unbounded, Unbounded) else {
        return Error(Unavailable)
    }
    let mut rows = take cursor
    let mut out: Bytes = list.new()
    loop {
        match store.next_in(tx, mut rows) {
            Ok(Some((path, _))) => {
                list.extend(mut out, string.as_bytes(path))
                list.push(mut out, b'\n')
            },
            Ok(None) => break,
            Error(_) => return Error(Unavailable),
        }
    }
    Ok(Now(take out))
}

// The tree hash: SHA-256 over every (path, text) in path order, each key-encoded, so two
// trees hash alike exactly when they hold the same files.
fn tree_of(tx: store.Tx, t: Tables) -> Result[(Bytes, u64), store.Error] {
    let mut rows = store.range(tx, t.files, Unbounded, Unbounded)?
    let mut hash = std.sha256.start()
    let mut n = 0u64
    let mut size = 4u64
    while let Some((path, text)) = store.next_in(tx, mut rows)? {
        size += 8u64 + string.byte_len(path) + string.byte_len(text)
        if size > platform.launcher.TREE_BYTES {
            return Error(Limit(Value))
        }
        hash_file(mut hash, path, text)
        n += 1u64
    }
    Ok((tree_hash(take hash), n))
}

fn hash_file(mut hash: std.sha256.Sha256, path: String, text: String) {
    let mut raw: Bytes = list.new()
    std.codec.put_key_string(path, mut raw)
    std.codec.put_key_string(text, mut raw)
    std.sha256.add(mut hash, raw, 0u64, list.len(raw))
}

fn tree_hash(take hash: std.sha256.Sha256) -> Bytes {
    let d = std.sha256.finish(take hash)
    let mut out: Bytes = list.with_capacity(32u64)
    for i in 0u64 .. 32u64 {
        list.push(mut out, d[i])
    }
    take out
}

fn call_id(key: harness.EffectKey) -> Bytes {
    let mut out: Bytes = list.new()
    std.codec.put_key_u64(key.run, mut out)
    std.codec.put_key_u64(key.round, mut out)
    std.codec.put_key_u8(key.kind, mut out)
    std.codec.put_key_u64(key.ordinal, mut out)
    take out
}

// Files the current tree as a proposal and parks the call until the host settles it.
fn propose_release(mut tx: store.Tx, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    let t = opened(tx)?
    let fields = arguments(inv.args)?
    let summary = text_arg(fields, "summary")?
    let package = if mcp.rpc.contains(fields, "package") { text_arg(fields, "package")? } else { "." }
    let build = Build(package: take package, grants: strings_arg(fields, "grants")?, dirs: strings_arg(fields, "dirs")?)
    let (tree, n) = match tree_of(tx, t) {
        Ok(take named) => take named,
        Error(Limit(Value)) => return Error(Refused("the source tree exceeds the launcher's byte limit")),
        Error(_) => return Error(Unavailable),
    }
    if n == 0u64 {
        return Error(Refused("there is no source to propose"))
    }
    let p = Proposal(call: clone(inv.key), tree: take tree, summary: take summary, build: take build, state: Filed)
    match store.put(mut tx, t.proposals, call_id(inv.key), p) {
        Ok(_) => Ok(Later),
        Error(_) => Error(Unavailable),
    }
}

// The host's read: every filed proposal, by its ID.
pub fn pending(read_handle: store.Reader, snap: store.Snapshot, t: Tables) -> Result[List[(Bytes, Proposal)], store.Error] waits {
    let mut rows = store.scan(read_handle, snap, t.proposals, Unbounded, Unbounded)?
    let mut out: List[(Bytes, Proposal)] = list.new()
    while let Some((take id, take p)) = store.next(read_handle, mut rows)? {
        if let Filed = p.state {
            list.push(mut out, (take id, take p))
        }
    }
    Ok(take out)
}

// The source a proposal names, in path order, or None when the tree has changed since it
// was filed: the host never publishes source the proposal did not name.
pub fn source(read_handle: store.Reader, snap: store.Snapshot, t: Tables, tree: Bytes) -> Result[Option[List[File]], store.Error] waits {
    let mut rows = store.scan(read_handle, snap, t.files, Unbounded, Unbounded)?
    let mut hash = std.sha256.start()
    let mut files: List[File] = list.new()
    while let Some((take path, take text)) = store.next(read_handle, mut rows)? {
        hash_file(mut hash, path, text)
        list.push(mut files, File(path: take path, text: take text))
    }
    if tree_hash(take hash) != tree {
        return Ok(None)
    }
    Ok(Some(take files))
}

pub fn names_files(tree: Bytes, files: List[File]) -> bool {
    let mut hash = std.sha256.start()
    for file in files {
        hash_file(mut hash, file.path, file.text)
    }
    tree_hash(take hash) == tree
}

pub type Settlement: codec + send { id: Bytes, state: State }

pub type DevDecision: codec + send = Publish | Reject(String)
pub type DevSettlement: codec + send { id: Bytes, decision: DevDecision }
pub type FiledProposal: codec + send { id: Bytes, proposal: Proposal }

// The development gateway delegates release decisions to the session's readers.
pub fn dev_proposals(tx: store.Tx, h: harness.Handles, caller: store.Caller, take unused: ()) -> Result[runner.Cover, Capacity] {
    let t = tables(store.tx_schema(tx)) ?=> |_| read_failed()
    let shape = view t.proposals
    if harness.reader_allowed(tx, h, caller)? {
        return runner.cover(shape, Unbounded, Unbounded)
    }
    runner.cover(shape, Included(list.new()), Excluded(list.new()))
}

pub fn dev_settle[G: send](mut tx: store.Tx, h: harness.Handles, caller: store.Caller, a: harness.Agent[G], w: harness.Wiring, take ask: DevSettlement) -> Result[harness.Filed, harness.Refused] {
    if !(harness.reader_allowed(tx, h, caller) ?=> |_| Storage) {
        return Error(NotAllowed)
    }
    let t = tables(store.tx_schema(tx)) ?=> |_| Storage
    let DevSettlement(id: take id, decision: take decision) = take ask
    let state = match take decision {
        Publish => Published("approved, not deployed"),
        Reject(take why) => Rejected(take why),
    }
    settle(mut tx, h, t, a, w, id, take state)
}

// WIRE query bodies. An app's query_as entries authorize the Caller before forwarding.
// Each Cover is published against the same transaction snapshot as the scan that chose it.
pub fn pending_cover(tx: store.Tx, t: Tables) -> Result[runner.Cover, Capacity] {
    let shape = view t.proposals
    let mut rows = store.range(tx, shape, Unbounded, Unbounded) ?=> |_| read_failed()
    while let Some((id, proposal)) = store.next_in(tx, mut rows) ?=> |_| read_failed() {
        if let Filed = proposal.state {
            return runner.cover(shape, Included(clone(id)), Included(clone(id)))
        }
    }
    runner.cover(shape, Included(list.new()), Excluded(list.new()))
}

// Publish one source row per WIRE query, so a full tree need not fit in one batch.
pub fn source_cover(tx: store.Tx, t: Tables, after: Option[String]) -> Result[runner.Cover, Capacity] {
    let shape = view t.files
    let low: store.Bound[String] = match after {
        Some(path) => Excluded(string.from(path)),
        None => Unbounded,
    }
    let mut rows = store.range(tx, shape, low, Unbounded) ?=> |_| read_failed()
    if let Some((path, _)) = store.next_in(tx, mut rows) ?=> |_| read_failed() {
        return runner.cover(shape, Included(string.from(path)), Included(string.from(path)))
    }
    runner.cover(shape, Included(""), Excluded(""))
}

fn read_failed() -> Capacity { Capacity(requested: 1u64, available: 0u64) }

// The host's decision on proposal `id`, given to its parked call. The app's settle entry
// calls this after authorizing its caller as the host. A proposal already settled, or
// unknown, is Ignored; the proposal row records the decision even when the call has since
// timed out.
pub fn settle[G: send](mut tx: store.Tx, h: harness.Handles, t: Tables, a: harness.Agent[G], w: harness.Wiring, id: Bytes, take decided: State) -> Result[harness.Filed, harness.Refused] {
    let Ok(found) = store.fetch(tx, t.proposals, id) else {
        return Error(Storage)
    }
    let Some(take p) = found else {
        return Ok(Ignored)
    }
    let mut row = take p
    match row.state {
        Filed => (),
        _ => return Ok(Ignored),
    }
    let outcome: harness.Outcome = match decided {
        Filed => return Error(Malformed("a settlement must decide the proposal")),
        Published(text) => Returned(Inline(string.into_bytes(clone(text)))),
        Rejected(why) => Failed(clone(why)),
    }
    row.state = take decided
    let call: harness.EffectKey = clone(row.call)
    let Ok(_) = store.put(mut tx, t.proposals, id, row) else {
        return Error(Storage)
    }
    harness.resume(mut tx, h, a, w, call, take outcome)
}

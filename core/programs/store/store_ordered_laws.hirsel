fn ordered_law_owners(_key: u64, value: Bytes) -> Result[List[u64], Capacity] {
    let mut found: List[u64] = list.new()
    if list.len(value) > 0 {
        list.push(mut found, int.widen(value[0]))
    }
    Ok(take found)
}

fn ordered_law_pairs(first: u64, end_at: u64, mark: u8) -> List[(u64, Bytes)] {
    let mut input: List[(u64, Bytes)] = list.with_capacity(end_at - first)
    for i in first .. end_at {
        let mut raw: Bytes = list.with_capacity(1)
        list.push(mut raw, mark)
        list.push(mut input, (i, take raw))
    }
    take input
}

fn ordered_law_parts(_key: u64, amount: u64) -> Result[List[(u64, u64)], Capacity] {
    let mut parts: List[(u64, u64)] = list.new()
    if amount != 0 {
        list.push(mut parts, (0u64, amount))
    }
    Ok(take parts)
}

fn ordered_law_unique(c: Clock) -> Result[(), Error] waits {
    let mut db = test_db(c, 1048576)
    let mut schema = declare(db, Migrate)?
    let mut declared = declare_table(mut schema, "orders", std.codec.key_u64(), std.codec.of_bytes())?
    let _ = index(mut schema, mut declared, "owner", Unique, code.describe(ordered_law_owners), std.codec.key_u64())?
    let subject = finish(mut schema, take declared)?
    let _ = seal(mut db, take schema)?
    let Committed(_) = execute(mut db, 0, 0, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        let mut inverted = ordered_law_pairs(1, 6, 1)
        inverted[0].1 = prior_fixture_value(128)
        inverted[4].0 = 2
        tx.limits.value = 64
        match put_ordered(mut tx, subject, inverted) {
            Error(OutOfOrder) => (),
            _ => return Error(Missing("late OutOfOrder did not beat value limit")),
        }
        let mut mixed = ordered_law_pairs(1, 3, 1)
        mixed[1].1 = prior_fixture_value(128)
        let seed_owner = ordered_law_pairs(0, 1, 1)
        put(mut tx, subject, 0u64, seed_owner[0].1)?
        match put_ordered(mut tx, subject, mixed) {
            Error(Limit(Value)) => (),
            _ => return Error(Missing("value limit did not beat a Unique conflict")),
        }
        if let Some(_) = tx.index_conflict {
            return Error(Missing("row limit recorded a conflict"))
        }
        if data_row_count(tx.ops.rows) != 2 {
            return Error(Missing("validation staged rows or recorded a conflict"))
        }
        Ok(())
    })? else {
        return Error(Missing("ordered refusal fixture"))
    }
    let Committed(_) = execute(mut db, 0, 0, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        put_ordered(mut tx, subject, ordered_law_pairs(1, 2, 7))
    })? else {
        return Error(Missing("Unique seed"))
    }
    let Committed(_) = execute(mut db, 0, 0, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        let mut released = ordered_law_pairs(1, 4, 7)
        released[0].1 = list.new()
        released[1].1 = list.new()
        put_ordered(mut tx, subject, released)
    })? else {
        return Error(Missing("released Unique key could not be acquired"))
    }
    let Failed(Conflict(owner_name)) = execute(mut db, 0, 0, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        let prior_ids = tx.ids
        let prior_frame = tx.frame_bytes
        match put_ordered(mut tx, subject, ordered_law_pairs(4, 6, 8)) {
            Error(Conflict(found_name)) => {
                if found_name != "owner" {
                    return Error(Missing("wrong Unique conflict"))
                }
            },
            _ => return Error(Missing("same Unique key acquired twice")),
        }
        if tx.ids != prior_ids || tx.frame_bytes != prior_frame || data_row_count(tx.ops.rows) != 0 {
            return Error(Missing("conflict staged a prefix"))
        }
        Ok(())
    })? else {
        return Error(Missing("conflict did not make the draft abort-only"))
    }
    if owner_name != "owner" {
        return Error(Missing("wrong latched index name"))
    }
    Ok(())
}

fn ordered_numbers(one: (u64, u64), two: Option[(u64, u64)]) -> List[(u64, u64)] {
    let mut input: List[(u64, u64)] = list.new()
    list.push(mut input, one)
    if let Some(pair) = two {
        list.push(mut input, pair)
    }
    take input
}

fn ordered_law_sums(c: Clock) -> Result[(), Error] waits {
    let mut db = test_db(c, 1048576)
    let mut schema = declare(db, Migrate)?
    let mut declared = declare_table(mut schema, "orders", std.codec.key_u64(), std.codec.of_u64())?
    let held = aggregate(mut schema, mut declared, "amount", code.describe(ordered_law_parts), std.codec.key_u64())?
    let subject = finish(mut schema, take declared)?
    let _ = seal(mut db, take schema)?
    let Committed(_) = execute(mut db, 0, 0, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        put_ordered(mut tx, subject, ordered_numbers((1u64, 2u64), Some((2u64, 3u64))))
    })? else {
        return Error(Missing("initial Sums batch"))
    }
    let Committed(_) = execute(mut db, 0, 0, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        let initial = totals(tx, held, 0u64)?
        if initial.count != 2 || initial.sum != 5 {
            return Error(Missing("second aggregate row ignored first"))
        }
        tx.frame_bytes = Some(42u64)
        put(mut tx, subject, 1u64, 0u64)?
        let old_frame = option.unwrap(tx.frame_bytes)
        // Primary key 12, value 10, put overhead 13. The second write
        // replaces a 16-byte aggregate put with a tombstone, saving 20.
        tx.limits.frame = old_frame + 34
        match put_ordered(mut tx, subject, ordered_numbers((2u64, 0u64), None)) {
            Error(Limit(Transaction)) => (),
            _ => return Error(Missing("intermediate frame cap did not refuse")),
        }
        if tx.frame_bytes != Some(old_frame) {
            return Error(Missing("frame refusal changed draft"))
        }
        tx.limits.frame = old_frame + 50
        put_ordered(mut tx, subject, ordered_numbers((2u64, 0u64), Some((3u64, 0u64))))?
        if tx.frame_bytes != Some(old_frame + 50) {
            return Error(Missing("Sums tombstone did not refund 20 wire bytes"))
        }
        Ok(())
    })? else {
        return Error(Missing("exact frame law aborted"))
    }
    let Committed(_) = execute(mut db, 0, 0, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, subject, 5u64, 18446744073709551615u64)?
        match put_ordered(mut tx, subject, ordered_numbers((6u64, 1u64), None)) {
            Error(Limit(Value)) => (),
            _ => return Error(Missing("state-dependent Sums overflow did not refuse")),
        }
        Ok(())
    })? else {
        return Error(Missing("Sums overflow law aborted"))
    }
    Ok(())
}

@test
fn ordered_batch_contract(c: Clock) -> Result[(), Error] waits {
    ordered_law_unique(c)?
    ordered_law_sums(c)
}

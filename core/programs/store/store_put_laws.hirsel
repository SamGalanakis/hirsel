type FollowingReader: send {
    current: Latest[Snapshot],
    done: Receiver[()]
}

fn read_following(take read_source: FollowingReader) -> bool waits {
    let mut previous: u64 = 0
    for _ in 0u64 .. 64 {
        result.unwrap(channel.receive(read_source.done))
        let s = latest.read(read_source.current)
        let v = version(s)
        if v < previous || value_at(s, 1) != v {
            return false
        }
        previous = v
    }
    let final_root = latest.read(read_source.current)
    version(final_root) == 64 && value_at(final_root, 1) == 64
}

// L2 under W4: every read is an admitted version; after the writer's completion
// event the reader sees its last publish. Wrong implementation: missed publication.
@test
fn follow_schedules(c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    let mut db = raw_test_db(c, 1073741824)
    let h = result.unwrap(follow(mut db, Branch(store: StoreId(hi: 1, lo: 2), id: 0)))
    let (send, receive): (Sender[()], Receiver[()]) = channel.new(1)
    let (send2, receive2): (Sender[()], Receiver[()]) = channel.new(1)
    let payload = FollowingReader(current: latest.handle(h), done: take receive)
    let payload2 = FollowingReader(current: take h, done: take receive2)
    let read_source = task.spawn(tasks, bytes 1048576, take payload, read_following)
    let reader2 = task.spawn(tasks, bytes 1048576, take payload2, read_following)
    for v in 1u64 .. 65 {
        if !put_one(mut db, 1, v) {
            return Error(())
        }
        result.unwrap(channel.send(send, ()))
        result.unwrap(channel.send(send2, ()))
    }
    let a = result.unwrap(task.join(take read_source))
    let b = result.unwrap(task.join(take reader2))
    if a && b {
        Ok(())
    } else {
        Error(())
    }
}

// Capacity after reserving ids and a body fault both consume their id ranges.
// Wrong implementation caught: returning the writer counter to its old value.
pub fn law_node_ids(c: Clock) -> bool {
    let mut db = raw_test_db(c, 1073741824)
    let failed = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(1), key_word(10))?
        fail("node id fault")
    })
    match take failed {
        Ok(Failed(_)) => {},
        _ => return false
    }
    let after_fault = db.next_node
    if after_fault == 0 || db.heads[0].head != 0 {
        return false
    }
    let capacity_result = result.unwrap(bound bytes 512 {
        execute(mut db, 0, 2, None, fn(mut tx: Tx) -> Result[(), Error] {
            for k in 0u64 .. 100 {
                put_bytes(mut tx, 1, key_word(k), key_word(k))?
            }
            Ok(())
        })
    })
    match take capacity_result {
        Ok(Refused(_)) => {},
        _ => return false
    }
    let after_capacity = db.next_node
    if after_capacity <= after_fault || db.heads[0].head != 0 {
        return false
    }
    if !put_one(mut db, 2, 20) {
        return false
    }
    tree_stamp(db.heads[0].roots.collections) > after_capacity
}

@test
fn test_node_ids(c: Clock) -> Result[(), ()] {
    if law_node_ids(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn catalog_entry(db: Db, k: Bytes) -> Result[Catalog, Error] {
    healthy(db)?
    catalog_entry_in(db.heads[0].roots.catalog, k)
}

fn catalog_put(mut db: Db, roots: Roots, k: Bytes, v: Bytes) -> Result[Roots, Error] {
    catalog_insert(mut db.next_node, roots, k, v)
}

fn index_catalog(db: Db, id: u32) -> Result[List[Catalog], Error] {
    index_catalog_in(db.heads[0].roots.catalog, id)
}

fn quotient(v: u64) -> Result[u64, Capacity] {
    Ok(v / 4)
}

fn typed_value(s: Snapshot, t: Table[u64, u64], k: u64) -> u64 waits {
    match result.unwrap(get(law_reader(s), s, t, k)) {
        None => 0,
        Some(v) => v
    }
}

// ADVICE 5: a callback copies none of the rows staged before it. Oracle: 64
// staged rows of 1,000-byte values are 64,000 bytes, so a callback that
// copied them could not start under a 32 KiB byte bound; one that shares
// them needs only its own empty overlay. Then the merge rules, by hand:
// nested callbacks replace row 1, delete row 2 and add rows 100 and 101; a
// typed error drops its write of row 3; an overrun drops its write of row 4;
// rollback_writes_on_error keeps its write of row 5. Every other row keeps
// its value. A body reads through the frozen layers below its overlay: after
// the inner callback returns, and after the overrun, a fetch and a range see
// row 1 as "one", row 2 gone, rows 3, 4 and 64 as staged, row 101 present,
// and 65 rows in all (64 staged, less row 2, plus rows 100 and 101). The inner callback's bound is below what its enclosing bound has
// left, since a nested bound cannot grant steps its parent no longer holds.
fn layered_reads(tx: Tx, sh: Table[u64, String], big: String) -> Result[bool, Error] {
    let mut rows = range(tx, sh, Included(1), Included(200))?
    let mut seen = 0u64
    while let Some(_) = next_in(tx, mut rows)? {
        seen += 1
    }
    let one = fetch(tx, sh, 1)? == Some(string.from("one"))
    let gone = fetch(tx, sh, 2)? == None
    let kept = fetch(tx, sh, 3)? == Some(clone(big)) && fetch(tx, sh, 4)? == Some(clone(big)) && fetch(tx, sh, 64)? == Some(clone(big))
    let added = fetch(tx, sh, 101)? == Some(string.from("hundred one"))
    Ok(seen == 65 && one && gone && kept && added)
}

pub fn law_callback_shares_staged(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_string())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_string()))
    let mut raw: Bytes = list.with_capacity(1000)
    list.fill(mut raw, 1000, 97u8)
    let big = result.unwrap(string.from_utf8(take raw))
    let sh = view t
    let out = run(mut db, None, (copy_env(t), copy_env(big), copy_env(sh)), fn(mut tx, call_env) -> Result[bool, Error] {
        for k in 1u64 .. 65 {
            put(mut tx, call_env.0, k, call_env.1)?
        }
        let shared = bound bytes 32768 {
            rollback_writes_on_overrun(mut tx, 100000, scoped fn(mut w: Tx) -> Result[(), Error] {
                put(mut w, call_env.0, 1, "one")
            })
        }
        let fits = match shared {
            Ok(Ok(Ok(()))) => true,
            _ => false,
        }
        let nested = rollback_writes_on_overrun(mut tx, 100000, scoped fn(mut w: Tx) -> Result[(), Error] {
            put(mut w, call_env.0, 100, "hundred")?
            let inner = rollback_writes_on_overrun(mut w, 50000, scoped fn(mut v: Tx) -> Result[(), Error] {
                let _ = delete(mut v, call_env.0, 2)?
                put(mut v, call_env.0, 101, "hundred one")
            })
            match inner {
                Ok(Ok(())) => {},
                _ => return Error(Missing("inner")),
            }
            if layered_reads(w, call_env.2, call_env.1)? {
                Ok(())
            } else {
                Error(Missing("reads"))
            }
        })
        let typed = rollback_writes_on_overrun(mut tx, 100000, scoped fn(mut w: Tx) -> Result[(), Error] {
            put(mut w, call_env.0, 3, "three")?
            Error(Missing("typed"))
        })
        let over = rollback_writes_on_overrun(mut tx, 1000, scoped fn(mut w: Tx) -> Result[(), Error] {
            put(mut w, call_env.0, 4, "four")?
            loop {}
        })
        let kept = rollback_writes_on_error(mut tx, scoped fn(mut w: Tx) -> Result[(), Error] {
            if !layered_reads(w, call_env.2, call_env.1)? {
                return Error(Missing("reads after overrun"))
            }
            put(mut w, call_env.0, 5, "five")
        })
        let shapes = match (nested, typed, over, kept) {
            (Ok(Ok(())), Ok(Error(_)), Error(_), Ok(())) => true,
            _ => false,
        }
        Ok(fits && shapes)
    })
    let shaped = match take out {
        Ok(Committed(done)) => done.value,
        _ => false,
    }
    let s = snapshot(db)
    let mut good = shaped
    for k in 1u64 .. 65 {
        let want = if k == 1 {
            Some(string.from("one"))
        } else if k == 2 {
            None
        } else if k == 5 {
            Some(string.from("five"))
        } else {
            Some(string.from(big))
        }
        if result.unwrap(get(result.unwrap(reader(db, 0u64)), s, sh, k)) != want {
            good = false
        }
    }
    good && result.unwrap(get(result.unwrap(reader(db, 0u64)), s, sh, 100)) == Some(string.from("hundred")) && result.unwrap(get(result.unwrap(reader(db, 0u64)), s, sh, 101)) == Some(string.from("hundred one"))
}

@test
fn test_callback_shares_staged(c: Clock) -> Result[(), ()] waits {
    if law_callback_shares_staged(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn retention_returned(mut db: Db, t: Table[u64, u64], steps: u64) -> bool waits {
    let ran = result.unwrap(run(mut db, None, (copy_env(steps), copy_env(t)), fn(mut tx, call_env) -> Result[(), Error] {
        let bounded = rollback_writes_on_overrun(mut tx, call_env.0, scoped fn(mut w: Tx) -> Result[(), Error] {
            let _ = delete(mut w, call_env.1, 2)?
            put(mut w, call_env.1, 3, 30)?
            put(mut w, call_env.1, 5, 50)
        })
        let status = match bounded {
            Ok(Ok(())) => "returned",
            Error(_) => "overran",
            _ => fail("retention body refused"),
        }
        // Abort so every bound starts from the same rows.
        Error(Missing(status))
    }))
    match take ran {
        Aborted(Undone(value: Missing(why), ..)) => why == "returned",
        _ => fail("retention run"),
    }
}

fn retention_threshold(c: Clock, retained: bool) -> u64 waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let seeded = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        for k in 1u64 .. 65 {
            put(mut tx, call_env, k, k)?
        }
        Ok(())
    }))
    match take seeded {
        Committed(_) => (),
        _ => fail("retention seed"),
    }
    if retained {
        let held = snapshot(db)
        let _ = result.unwrap(pin(mut db, "held", held))
    }
    let mut low = 0u64
    let mut high = 1u64
    while !retention_returned(mut db, t, high) {
        if high > 9223372036854775807 {
            fail("retention body never returned")
        }
        high *= 2
    }
    while low < high {
        let mid = low + (high - low) / 2
        if retention_returned(mut db, t, mid) {
            high = mid
        } else {
            low = mid + 1
        }
    }
    low
}

// A replay fork retains old rows even when the live run does not. The body
// must return at the same step threshold under either retention policy.
pub fn law_retention_keeps_steps(c: Clock) -> bool waits {
    retention_threshold(c, false) == retention_threshold(c, true)
}

@test
fn test_retention_keeps_steps(c: Clock) -> Result[(), ()] waits {
    if law_retention_keeps_steps(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn tail_body(mut w: Tx, t: Table[u64, u64]) -> Result[(), Error] {
    let _ = delete(mut w, t, 1)?
    let _ = delete(mut w, t, 2)?
    put(mut w, t, 3, 30)?
    Error(Missing("typed"))
}

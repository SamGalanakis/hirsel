pub opaque type Sqlite {}

pub opaque type DbHandle {}

pub opaque type StmtHandle {}

pub type SqliteError {
    code: i32,
    message: String
}

pub type Step = Row | Done

pub type Kind = Integer | Float | Text | Blob | Null

pub opaque resource type Db: send {
    f: Foreign[Sqlite],
    p: foreign.Ptr[DbHandle]
} drop(d) {
    let _ = native.close(d.f, d.p)
}

pub opaque resource type Stmt: send {
    f: Foreign[Sqlite],
    p: foreign.Ptr[StmtHandle],
    columns: u32,
    row: bool
} drop(s) {
    let _ = native.finalize(s.f, s.p)
}

fn error_buffer() -> Bytes {
    let mut e: Bytes = list.with_capacity(260)
    list.fill(mut e, 260, 0)
    e
}

fn read_error(e: Bytes) -> SqliteError {
    let code: u32 = list.word_le(e, 0)
    let mut end = 4u64
    while end < 260 && e[end] != 0 {
        end += 1
    }
    let message = if end == 4 {
        "sqlite: no error text"
    } else {
        let mut message_bytes: Bytes = list.with_capacity(end - 4)
        list.append(mut message_bytes, list.slice(e, 4, end))
        match string.from_utf8(take message_bytes) {
            Ok(take text) => take text,
            Error(_) => "sqlite: error text is not UTF-8"
        }
    }
    SqliteError(code: int.truncate(code), message: take message)
}

fn status(rc: i32, e: Bytes) -> Result[(), SqliteError] {
    if rc == 0 {
        Ok(())
    } else {
        Error(read_error(e))
    }
}

fn release_error(f: Foreign[Sqlite], rc: i32) -> SqliteError {
    let mut e = error_buffer()
    native.errstr(f, rc, mut e)
    read_error(e)
}

fn handle_capacity() -> SqliteError {
    SqliteError(code: 7, message: "sqlite: no capacity for the handle")
}

fn check_sql(sql: Bytes) -> Result[(), SqliteError] {
    if list.len(sql) > 2147483647 {
        return Error(SqliteError(code: 18, message: "sqlite: SQL is too long"))
    }
    for byte in sql {
        if byte == 0 {
            return Error(SqliteError(code: 1, message: "sqlite: SQL holds a zero byte"))
        }
    }
    Ok(())
}

pub fn open_memory(f: Foreign[Sqlite]) -> Result[Db, SqliteError] waits {
    let mut e = error_buffer()
    match native.open_memory(f, mut e) {
        None => Error(read_error(e)),
        Some(p) => match Db(f: f, p: p) {
            Ok(take db) => Ok(take db),
            Error((_, (grant, handle))) => {
                let _ = native.close(grant, handle)
                Error(handle_capacity())
            },
        },
    }
}

pub fn exec(mut db: Db, sql: String) -> Result[(), SqliteError] waits {
    let text = string.as_bytes(sql)
    check_sql(text)?
    let mut e = error_buffer()
    let rc = native.exec(db.f, db.p, text, mut e)
    status(rc, e)
}

pub fn prepare(mut db: Db, sql: String) -> Result[Stmt, SqliteError] waits {
    let text = string.as_bytes(sql)
    check_sql(text)?
    let mut e = error_buffer()
    match native.prepare(db.f, db.p, text, mut e) {
        None => Error(read_error(e)),
        Some(p) => match Stmt(f: db.f, p: p, columns: 0, row: false) {
            Ok(take stmt) => {
                let mut ready = take stmt
                ready.columns = native.column_count(ready.f, ready.p)
                Ok(take ready)
            },
            Error((_, (grant, handle, _, _))) => {
                let _ = native.finalize(grant, handle)
                Error(handle_capacity())
            },
        },
    }
}

fn check_bind(i: u32) -> Result[(), SqliteError] {
    if i == 0 || i > 2147483647 {
        Error(SqliteError(code: 25, message: "sqlite: parameter index out of range"))
    } else {
        Ok(())
    }
}

pub fn bind_i64(mut s: Stmt, i: u32, v: i64) -> Result[(), SqliteError] waits {
    check_bind(i)?
    let mut e = error_buffer()
    let rc = native.bind_i64(s.f, s.p, i, v, mut e)
    status(rc, e)
}

pub fn bind_f64(mut s: Stmt, i: u32, v: f64) -> Result[(), SqliteError] waits {
    check_bind(i)?
    let mut e = error_buffer()
    let rc = native.bind_f64(s.f, s.p, i, v, mut e)
    status(rc, e)
}

pub fn bind_bytes(mut s: Stmt, i: u32, v: Bytes) -> Result[(), SqliteError] waits {
    check_bind(i)?
    let mut e = error_buffer()
    let rc = native.bind_blob(s.f, s.p, i, v, mut e)
    status(rc, e)
}

pub fn bind_text(mut s: Stmt, i: u32, v: String) -> Result[(), SqliteError] waits {
    check_bind(i)?
    let mut e = error_buffer()
    let rc = native.bind_text(s.f, s.p, i, string.as_bytes(v), mut e)
    status(rc, e)
}

pub fn bind_null(mut s: Stmt, i: u32) -> Result[(), SqliteError] waits {
    check_bind(i)?
    let mut e = error_buffer()
    let rc = native.bind_null(s.f, s.p, i, mut e)
    status(rc, e)
}

pub fn step(mut s: Stmt) -> Result[Step, SqliteError] waits {
    let mut e = error_buffer()
    let rc = native.step(s.f, s.p, mut e)
    s.row = rc == 100
    if s.row {
        Ok(Row)
    } else if rc == 101 {
        Ok(Done)
    } else {
        Error(read_error(e))
    }
}

fn check_column(s: Stmt, i: u32) {
    if !s.row {
        fail("sqlite: no current row")
    }
    if i >= s.columns {
        fail("sqlite: column index out of range")
    }
}

pub fn column_kind(mut s: Stmt, i: u32) -> Kind waits {
    check_column(s, i)
    match native.column_kind(s.f, s.p, i) {
        1 => Integer,
        2 => Float,
        3 => Text,
        4 => Blob,
        _ => Null,
    }
}

pub fn column_i64(mut s: Stmt, i: u32) -> i64 waits {
    check_column(s, i)
    native.column_i64(s.f, s.p, i)
}

pub fn column_f64(mut s: Stmt, i: u32) -> f64 waits {
    check_column(s, i)
    native.column_f64(s.f, s.p, i)
}

pub fn column_bytes(mut s: Stmt, i: u32, mut out: Bytes) -> Result[(), SqliteError] waits {
    check_column(s, i)
    let mut e = error_buffer()
    let count = native.column_len(s.f, s.p, i, mut e)
    if count < 0 {
        return Error(read_error(e))
    }
    let start = list.len(out)
    list.fill(mut out, int.narrow(count), 0)
    let rc = native.column_copy(s.f, s.p, i, mut out, start, mut e)
    status(rc, e)
}

pub fn reset(mut s: Stmt) -> Result[(), SqliteError] waits {
    let mut e = error_buffer()
    let rc = native.reset(s.f, s.p, mut e)
    s.row = false
    status(rc, e)
}

pub fn close(take db: Db) -> Result[(), SqliteError] waits {
    let Db(f: f, p: p) = take db
    let rc = native.close(f, p)
    if rc == 0 {
        Ok(())
    } else {
        Error(release_error(f, rc))
    }
}

pub fn finalize(take s: Stmt) -> Result[(), SqliteError] waits {
    let Stmt(f: f, p: p, columns: _, row: _) = take s
    let rc = native.finalize(f, p)
    if rc == 0 {
        Ok(())
    } else {
        Error(release_error(f, rc))
    }
}

fn leaf_ends_with(name: Bytes, suffix: Bytes) -> bool {
    let n = list.len(name)
    let m = list.len(suffix)
    if n < m {
        return false
    }
    for i in 0u64 .. m {
        if name[n - m + i] != suffix[i] {
            return false
        }
    }
    true
}

fn valid_leaf(name: Bytes) -> bool {
    let n = list.len(name)
    if n == 0 || n > 200 || name[0] == b'.' {
        return false
    }
    for byte in name {
        let alpha = (b'A' <= byte && byte <= b'Z') || (b'a' <= byte && byte <= b'z')
        let digit = b'0' <= byte && byte <= b'9'
        if !(alpha || digit || byte == b'.' || byte == b'_' || byte == b'-') {
            return false
        }
    }
    !leaf_ends_with(name, b"-journal") && !leaf_ends_with(name, b"-wal") && !leaf_ends_with(name, b"-shm")
}

pub fn open(f: Foreign[Sqlite], d: Dir, name: String) -> Result[Db, SqliteError] waits {
    let leaf = string.as_bytes(name)
    if !valid_leaf(leaf) {
        return Error(SqliteError(code: 14, message: "sqlite: name is not one leaf in the directory"))
    }
    let mut e = error_buffer()
    match native.open(f, d, leaf, mut e) {
        None => Error(read_error(e)),
        Some(p) => match Db(f: f, p: p) {
            Ok(take db) => Ok(take db),
            Error((_, (grant, handle))) => {
                let _ = native.close(grant, handle)
                Error(handle_capacity())
            },
        },
    }
}

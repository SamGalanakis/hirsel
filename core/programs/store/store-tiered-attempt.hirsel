type TieredAttemptStop: send = AttemptMiss(TieredTarget) | AttemptFold(u32) | AttemptPinLimit(Capacity) | AttemptAllocation(Capacity)

type TieredTouchSet: send {
    stamps: Map[u64, ()],
    touched_bytes: u64,
    slots: u64,
    partition: u64,
    frames: List[Arc[TieredFrame]],
    upper_bound: bool,
    seek_key: Option[Bytes],
    stopped: Option[TieredAttemptStop]
}

fn tiered_touch_set(partition: u64, initial: u64) -> Result[TieredTouchSet, Capacity] {
    let mut stamps: Map[u64, ()] = map.new()
    let mut frames: List[Arc[TieredFrame]] = list.new()
    map.try_reserve(mut stamps, initial)?
    list.try_reserve(mut frames, initial)?
    Ok(TieredTouchSet(stamps: take stamps, touched_bytes: 0, slots: initial, partition: partition, frames: take frames, upper_bound: false, seek_key: None, stopped: None))
}

fn tiered_touch_grow(mut attempt: TieredTouchSet) -> Result[(), Capacity] {
    let growth = order.max(attempt.slots, 1u64)
    map.try_reserve(mut attempt.stamps, growth)?
    list.try_reserve(mut attempt.frames, growth)?
    attempt.slots = int.saturating_add(attempt.slots, growth)
    Ok(())
}

// Hot and Cold payloads use one first-touch counter. A Hot PAGE passes the
// image length, a Hot BLOB passes 8 + value length, and Cold uses the edge.
fn tiered_touch(mut attempt: TieredTouchSet, stamp: u64, payload: u64) -> bool {
    if let Some(_) = attempt.stopped {
        return false
    }
    if map.contains(attempt.stamps, stamp) {
        return true
    }
    if map.len(attempt.stamps) == attempt.slots {
        if let Error(problem) = tiered_touch_grow(mut attempt) {
            attempt.stopped = Some(AttemptAllocation(problem))
            return false
        }
    }
    map.insert(mut attempt.stamps, stamp, ())
    attempt.touched_bytes = int.saturating_add(attempt.touched_bytes, 16 + payload)
    if attempt.touched_bytes > attempt.partition {
        attempt.stopped = Some(AttemptPinLimit(Capacity(requested: attempt.touched_bytes, available: attempt.partition)))
        return false
    }
    true
}

fn tiered_resolve_cold(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], target: TieredTarget) -> Result[Option[Arc[TieredFrame]], Error] {
    if let Some(_) = attempt.stopped {
        return Ok(None)
    }
    let facts = tiered_frame_id(target)
    let was_touched = map.contains(attempt.stamps, facts.stamp)
    if !tiered_touch(mut attempt, facts.stamp, facts.len) {
        return Ok(None)
    }
    let Some(frame) = map.get(visible, tiered_cache_key(facts)) else {
        attempt.stopped = Some(AttemptMiss(clone(target)))
        return Ok(None)
    }
    if frame.identity != facts {
        verify_tiered_edge(paged_pack_path(facts.pack)?, target, frame.identity)?
    }
    if !was_touched {
        list.push(mut attempt.frames, arc.share(frame))
    }
    Ok(Some(arc.share(frame)))
}

fn tiered_point_page(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], edge: std.page.Slot, expected_level: Option[u8]) -> Result[Arc[std.page.Page], Error] {
    if let Some(_) = attempt.stopped {
        return Error(Missed)
    }
    match edge {
        HotPage(page) => {
            let image = std.page.image_of(page)
            let id = std.page.stamp(image)
            if id != 0 && !tiered_touch(mut attempt, id, list.len(std.page.payload(image))) {
                return Error(Missed)
            }
            Ok(arc.share(page))
        },
        ColdPage(ptr) => {
            let Some(frame) = tiered_resolve_cold(mut attempt, visible, TieredPage(ptr))? else {
                return Error(Missed)
            }
            let TieredImage(page) = view frame.payload else {
                fail("store: verified PAGE has no image")
            }
            if let Some(wanted) = expected_level {
                if std.page.level(std.page.image_of(page)) != wanted {
                    return Error(disk_fault(paged_pack_path(ptr.pack)?, ptr.offset, Malformed))
                }
            }
            Ok(arc.share(page))
        },
    }
}

fn tiered_point_value(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], page: Arc[std.page.Page], slot: u64) -> Result[Arc[Bytes], Error] {
    let Some(BlobEdge(reference)) = std.page.owning_edge(std.page.image_of(page), slot) else {
        let Some(value) = std.page.value_at(page, slot) else {
            fail("store: missing selected inline value")
        }
        return Ok(arc.new(copied(value)?))
    }
    let Some(edge) = std.page.blob_slot(page, reference.body) else {
        fail("store: missing attached BLOB")
    }
    match edge {
        HotBlob(contents) => {
            if !tiered_touch(mut attempt, reference.stamp, 8 + list.len(contents)) {
                return Error(Missed)
            }
            Ok(arc.share(contents))
        },
        ColdBlob(ptr) => {
            let Some(frame) = tiered_resolve_cold(mut attempt, visible, TieredBlob(ptr))? else {
                return Error(Missed)
            }
            let TieredValue(contents) = view frame.payload else {
                fail("store: verified BLOB has no value")
            }
            Ok(arc.share(contents))
        },
    }
}

fn tiered_point_path(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], edge: std.page.Slot, expected_level: Option[u8], key: Bytes) -> Result[Option[Arc[Bytes]], Error] {
    let page = tiered_point_page(mut attempt, visible, edge, expected_level)?
    let image = std.page.image_of(page)
    if let Some(slot) = std.page.descend(image, key) {
        let Some(child_edge) = std.page.child_slot(page, slot) else {
            fail("store: missing attached PAGE")
        }
        return tiered_point_path(mut attempt, visible, child_edge, Some(std.page.level(image) - 1), key)
    }
    let (slot, hit) = std.page.search(image, key)
    if !hit {
        return Ok(None)
    }
    Ok(Some(tiered_point_value(mut attempt, visible, page, slot)?))
}

fn tiered_leaf_prior(leaf: Arc[std.page.Page], key: Bytes) -> u32 {
    let image = std.page.image_of(leaf)
    let (slot, hit) = std.page.search(image, key)
    if !hit {
        return 0
    }
    if let Some(BlobEdge(reference)) = std.page.owning_edge(image, slot) {
        return int.truncate(1 + reference.len)
    }
    let stored = option.unwrap(std.page.value_at(leaf, slot))
    int.truncate(1 + list.len(stored))
}

fn tiered_plan_path(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], page: Arc[std.page.Page], key: Bytes) -> Result[Arc[std.page.Page], Error] {
    let image = std.page.image_of(page)
    let Some(slot) = std.page.descend(image, key) else {
        return Ok(arc.share(page))
    }
    let child_level = Some(std.page.level(image) - 1)
    let edge = option.unwrap(std.page.child_slot(page, slot))
    let child = tiered_point_page(mut attempt, visible, edge, child_level)?
    if slot != 0 {
        let left = option.unwrap(std.page.child_slot(page, slot - 1))
        let _ = tiered_point_page(mut attempt, visible, left, child_level)?
    }
    if let Some(right) = std.page.child_slot(page, slot + 1) {
        let _ = tiered_point_page(mut attempt, visible, right, child_level)?
    }
    tiered_plan_path(mut attempt, visible, child, key)
}

// The leaf and any siblings that apply can need are resolved before encoding.
// Reading the old width never resolves the old BLOB.
fn tiered_plan_prior(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], tree: PageTree, logical: Bytes) -> Result[u32, Error] {
    if let Some(_) = attempt.stopped {
        return Error(Missed)
    }
    let collection: u32 = list.word_be(logical, 0)
    if let Some(overlays) = view tree.replay {
        if let Some(_) = std.omap.get(overlays.collections, collection) {
            attempt.stopped = Some(AttemptFold(collection))
            return Error(Missed)
        }
    }
    let Some((edge, descriptor)) = std.page.collection_slot(tree.root, list.slice(logical, 0, 4)) else {
        return Error(Stale(collection))
    }
    let key = list.slice(logical, 4, list.len(logical))
    let origin = tiered_point_page(mut attempt, visible, edge, None)?
    let leaf = tiered_plan_path(mut attempt, visible, origin, key)?
    if descriptor[52u64] == 4 {
        return Ok(0u32)
    }
    Ok(tiered_leaf_prior(leaf, key))
}

fn tiered_edit_page(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], ptr: std.page.PagePtr, mut failure: Option[Error]) -> Result[Arc[std.page.Page], std.page.Error] {
    match tiered_point_page(mut attempt, visible, ColdPage(ptr), None) {
        Ok(take loaded) => Ok(take loaded),
        Error(take problem) => {
            failure = Some(take problem)
            Error(MalformedPage)
        },
    }
}

fn stage_tiered_row(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], base: std.page.Slot, empty_root: Arc[std.page.Page], key: Bytes, value: ReplayValue, inline: u64, rightmost: bool, private_from: u64, mut next_stamp: u64) -> Result[Arc[std.page.Page], Error] {
    if let Some(_) = attempt.stopped {
        return Error(Missed)
    }
    // Pages made by this plan are paid for as dirty images. Only pages
    // inherited from its deciding root spend the attempt's pin partition.
    let mut working = match base {
        HotPage(page) if std.page.stamp(std.page.image_of(page)) >= private_from => arc.share(page),
        _ => tiered_point_page(mut attempt, visible, base, None)?,
    }
    let mut following_stamp = next_stamp
    let mut failure: Option[Error] = None
    let edited: Result[(), std.page.Error] = {
        let load = scoped fn(ptr: std.page.PagePtr) -> Result[Arc[std.page.Page], std.page.Error] {
            tiered_edit_page(mut attempt, visible, ptr, mut failure)
        }
        match value {
            ReplayPut(raw) => std.page.insert_shared_resolved(mut working, key, raw, inline, private_from, rightmost, mut following_stamp, load),
            ReplayAbsent => {
                match std.page.remove_resolved(mut working, key, empty_root, private_from, mut following_stamp, load) {
                    Ok(_) => Ok(()),
                    Error(problem) => Error(problem),
                }
            },
        }
    }
    if let Some(take problem) = take failure {
        return Error(take problem)
    }
    page_result(take edited)?
    next_stamp = following_stamp
    Ok(take working)
}

fn stage_tiered_trim(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], base: std.page.Slot, empty_root: Arc[std.page.Page], limits: LogBounds, before: u64, floor: u64, mut next_stamp: u64) -> Result[(Arc[std.page.Page], u64), Error] {
    if let Some(_) = attempt.stopped {
        return Error(Missed)
    }
    if floor < limits.first {
        return Error(malformed(0))
    }
    if floor >= limits.next {
        return Ok((arc.share(empty_root), before))
    }
    let working = tiered_point_page(mut attempt, visible, base, None)?
    let mut following_stamp = next_stamp
    let mut failure: Option[Error] = None
    let clipped = std.page.cut_before_resolved(working, key_word(floor), mut following_stamp, scoped fn(ptr: std.page.PagePtr) -> Result[Arc[std.page.Page], std.page.Error] {
        tiered_edit_page(mut attempt, visible, ptr, mut failure)
    })
    if let Some(take problem) = take failure {
        return Error(take problem)
    }
    let kept = page_result(take clipped)?
    let (rows, occupied) = std.page.totals(kept)
    let Some(dropped) = int.checked_sub(before, occupied) else {
        return Error(malformed(0))
    }
    if rows != limits.next - floor {
        return Error(malformed(0))
    }
    next_stamp = following_stamp
    Ok((take kept, dropped))
}

// ctf: class capability-forgery
// ctf: about A host operation called with its capability argument left out, as if the
// ctf: about clock were ambient. CAP-1: the world is reached only through an operation's
// ctf: about capability argument.
// ctf: expect refused:CAP-1
pub fn attack(seed: u64) -> Bytes {
    let now = host.mono_ns()
    let mut out: Bytes = list.new()
    list.put_word_le(mut out, now)
    out
}

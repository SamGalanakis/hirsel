#!/usr/bin/env python3
"""Run one registered archival or host qualification test.

tools/ignored-tests --list shows exact identities and required environment inputs.
Supply the original retained inputs named there, then select one identity. Missing
inputs fail closed; paths typed in the registry must exist and be nonempty.
This command never records replacement archival fixtures.
"""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
REGISTRY = json.loads((ROOT / 'tools/ignored-tests.json').read_text())


def validate_retained_paths(case, home, environment):
    for variable, kind in home.get('input_types', {}).items():
        if kind not in ('directory', 'file'):
            raise ValueError(f'{case}: {variable}: unknown retained input type {kind}')
        path = Path(environment[variable])
        expected = f'nonempty retained {kind}'
        try:
            valid = (path.is_dir() and next(path.iterdir(), None) is not None) if kind == 'directory' else (path.is_file() and path.stat().st_size > 0)
        except OSError as error:
            raise ValueError(f'{case}: {variable}: cannot read {expected} {path}: {error}') from error
        if not valid:
            raise ValueError(f'{case}: {variable}: expected {expected}, got missing, empty or wrong-kind path {path}')


def command(case, environment):
    home = REGISTRY[case]
    missing = [key for key in home['inputs'] if not environment.get(key)]
    if missing:
        raise ValueError(f'{case}: required retained inputs: ' + ', '.join(missing))
    validate_retained_paths(case, home, environment)
    if 'cpu_overlap' in home:
        return [str(ROOT / 'tools/cpu-overlap'),
                '--run', environment['HIRSEL_CPU_OVERLAP_COMMANDS'],
                '--cpus', environment['HIRSEL_CPU_OVERLAP_CPUS'],
                '--slice', environment['HIRSEL_CPU_OVERLAP_SLICE'],
                '--uid', environment['HIRSEL_CPU_OVERLAP_UID'],
                '--only', home['cpu_overlap']]
    return [str(ROOT / 'tools/test-filter'), '-c', 'hirsel.tests=host',
            re.sub(r'(?:-cpus-\d+)?-shard-\d+$', '', home.get('target', '//:hirsel-cli-test-cli')),
            *[argument for value in home.get('config', []) for argument in ['-c', value]],
            *[argument for key in home['inputs']
              for argument in ['--env', f'{key}={environment[key]}']], '--',
            '--exact', case, '--ignored', '--test-threads=1', '--nocapture']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('case', nargs='?', choices=sorted(REGISTRY))
    parser.add_argument('--list', action='store_true')
    args = parser.parse_args()
    if args.list:
        for case, home in REGISTRY.items():
            print(case + '\t' + ','.join(home['inputs']))
        return 0
    if args.case is None:
        parser.error('select one identity (or --list)')
    try:
        selected = command(args.case, os.environ)
    except ValueError as error:
        parser.error(str(error))
    result = subprocess.run(selected, cwd=ROOT, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True)
    print(result.stdout, end='')
    if result.returncode:
        return result.returncode
    counts = re.findall(r'test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored;',
                        result.stdout)
    if counts != [('1', '0', '0')]:
        print('ignored-tests: expected exactly one executed passing test', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
